# YAML, read and written in iyi alone: a parser and an emitter for the
# YAML 1.2 core schema over the bytes of a `String`, with no library under
# them.
#
# What it reads:
#   * Block mappings and block sequences, nested by indentation; a sequence
#     may sit at the same indentation as the key it belongs to; `- key: v`
#     opens a mapping inside a sequence entry.
#   * Flow collections `[a, b]` and `{a: b}`, nested, across lines, with a
#     trailing comma allowed and `[k: v]` as a one-pair mapping.
#   * Plain scalars, folded across lines; single-quoted scalars with `''`;
#     double-quoted scalars with every escape the format names (`\n`, `\t`,
#     `\"`, `\\`, `\/`, `\0`, `\a`, `\b`, `\e`, `\f`, `\r`, `\v`, `\ `,
#     `\N`, `\_`, `\L`, `\P`, `\xXX`, `\uXXXX`, `\UXXXXXXXX`, an escaped line
#     break), both quoted styles folded across lines.
#   * Block scalars `|` and `>` with `-`, `+` and an explicit indentation
#     digit, chomped as the header says.
#   * Anchors `&a`, aliases `*a`, merge keys `<<: *a` and `<<: [*a, *b]`.
#     A key the mapping spells itself wins over a merged one, wherever it is
#     spelled; among merged mappings the first wins.
#   * The core-schema tags `!!str`, `!!int`, `!!float`, `!!bool`, `!!null`,
#     `!!seq` and `!!map`; any other tag is refused.
#   * Streams: `%YAML` and `%TAG` directives are skipped, `---` opens a
#     document and `...` ends one. `parse_all` answers every document;
#     `parse` answers the first (nil for an empty stream) after checking the
#     whole stream.
#   * Plain scalars resolve as the 1.2 core schema says: `null`, `Null`,
#     `NULL`, `~` and the empty scalar are nil; `true`/`false` in the three
#     spellings are booleans; decimal, `0o` octal and `0x` hexadecimal are
#     `Int64`; `1.5`, `.5`, `7.`, `1e3`, `1.0e+20`, `.inf`, `-.inf`, `.nan`
#     are `Float64`; a decimal integer past the `Int64` range is read as a
#     `Float64`; everything else is a `String`. So `yes`, `no`, `on`,
#     `off`, `0777`, `1_000`, `1.2.3`, `22:30` and `2001-12-14` are strings
#     here, where a 1.1 reader would make some of them booleans, octal
#     numbers, or a timestamp. Keys resolve the same way: `1: one` has the
#     `Int64` key 1, `true: x` the `Bool` key true.
#
# What it refuses, each with a sentence that says where:
#   a tab in indentation, a control character, a quoted string that does
#   not close, a flow collection that does not close, an unknown escape or
#   an escape that names a surrogate, a mapping entry or sequence entry at
#   an indentation that belongs to nothing, text after a value on its
#   line, a value whose text is not a node, a duplicate key (the second
#   spelling of a key is a mistake, not an override), an alias to an
#   anchor that is not defined or is still being built (a cycle), aliases
#   that together expand to more than ALIAS_NODE_LIMIT nodes (the
#   "billion laughs" stream), a merge whose value is not a mapping or a
#   sequence of mappings, an explicit `?` key, an anchor on a key, a tag it
#   does not know (the verbatim `!<tag:yaml.org,2002:str>` spellings of
#   the core tags are known), a directive not followed by `---`, and
#   nesting past DEPTH_LIMIT levels.
#
# `YAML.parse?` answers nil for any of these; `YAML.parse` panics with the
# sentence. `YAML.dump` writes a value back as block YAML that this parser
# reads to an equal value: numbers, booleans and nil stay what they are as
# values and as keys, and a string that would read as something else is
# quoted. A collection cannot be written as a key.
#
# `Any` holds a document: `raw` is the union, `as_x`/`as_x?` are the
# pairs, `[]`/`[]?`/`dig`/`dig?` walk it, `==` is structural and `hash`
# agrees with it.
#
# The type tests on `Any#raw` are ordered with the reference types first.
# A chain that tests `Nil` and `Bool` before `Array`/`Hash` over this union
# sends an array down the hash arm today (a compiler defect being fixed);
# every dispatch here goes through `Any#kind`, which is written in the
# order that works, and nothing else in the file tests the union.

module std/yaml

import std/text

# The value a document holds.
pub struct Any
  alias Type = Nil | Bool | Int64 | Float64 | String | Array(Any) | Hash(Any, Any)

  KIND_NIL    = 0
  KIND_BOOL   = 1
  KIND_INT    = 2
  KIND_FLOAT  = 3
  KIND_STRING = 4
  KIND_ARRAY  = 5
  KIND_HASH   = 6

  getter raw : Type

  def initialize(@raw : Type)
  end

  def initialize(value : Int32)
    @raw = value.to_i64
  end

  # Which member of the union `raw` is, as one of the KIND_ constants.
  # Reference types are tested first on purpose (see the header).
  def kind : Int32
    r = @raw
    if r.is_a?(Array(Any))
      KIND_ARRAY
    elsif r.is_a?(Hash(Any, Any))
      KIND_HASH
    elsif r.is_a?(String)
      KIND_STRING
    elsif r.is_a?(Int64)
      KIND_INT
    elsif r.is_a?(Float64)
      KIND_FLOAT
    elsif r.is_a?(Bool)
      KIND_BOOL
    else
      KIND_NIL
    end
  end

  # The name of the kind, for the sentences below.
  def kind_name : String
    k = kind
    if k == KIND_ARRAY
      "a sequence"
    elsif k == KIND_HASH
      "a mapping"
    elsif k == KIND_STRING
      "a string"
    elsif k == KIND_INT
      "an integer"
    elsif k == KIND_FLOAT
      "a float"
    elsif k == KIND_BOOL
      "a boolean"
    else
      "null"
    end
  end

  def null? : Bool
    kind == KIND_NIL
  end

  def as_nil : Nil
    raise "expected null, not #{kind_name}" unless null?
    nil
  end

  def as_nil? : Nil
    nil
  end

  def as_bool : Bool
    raise "expected a boolean, not #{kind_name}" unless kind == KIND_BOOL
    @raw.as(Bool)
  end

  def as_bool? : Bool?
    kind == KIND_BOOL ? @raw.as(Bool) : nil
  end

  def as_i : Int64
    raise "expected an integer, not #{kind_name}" unless kind == KIND_INT
    @raw.as(Int64)
  end

  def as_i? : Int64?
    kind == KIND_INT ? @raw.as(Int64) : nil
  end

  # A float, or an integer widened to one.
  def as_f : Float64
    k = kind
    return @raw.as(Float64) if k == KIND_FLOAT
    return @raw.as(Int64).to_f64 if k == KIND_INT
    raise "expected a float, not #{kind_name}"
  end

  def as_f? : Float64?
    k = kind
    return @raw.as(Float64) if k == KIND_FLOAT
    return @raw.as(Int64).to_f64 if k == KIND_INT
    nil
  end

  def as_s : String
    raise "expected a string, not #{kind_name}" unless kind == KIND_STRING
    @raw.as(String)
  end

  def as_s? : String?
    kind == KIND_STRING ? @raw.as(String) : nil
  end

  def as_a : Array(Any)
    raise "expected a sequence, not #{kind_name}" unless kind == KIND_ARRAY
    @raw.as(Array(Any))
  end

  def as_a? : Array(Any)?
    kind == KIND_ARRAY ? @raw.as(Array(Any)) : nil
  end

  def as_h : Hash(Any, Any)
    raise "expected a mapping, not #{kind_name}" unless kind == KIND_HASH
    @raw.as(Hash(Any, Any))
  end

  def as_h? : Hash(Any, Any)?
    kind == KIND_HASH ? @raw.as(Hash(Any, Any)) : nil
  end

  # Elements of a sequence, pairs of a mapping, characters of a string.
  def size : Int32
    k = kind
    return @raw.as(Array(Any)).size if k == KIND_ARRAY
    return @raw.as(Hash(Any, Any)).size if k == KIND_HASH
    return @raw.as(String).size if k == KIND_STRING
    raise "size of #{kind_name}"
  end

  def [](key : Any) : Any
    h = as_h
    raise "no such key #{key.inspect}" unless h.has_key?(key)
    h[key]
  end

  def []?(key : Any) : Any?
    h = as_h?
    return nil if h.nil?
    h[key]?
  end

  def [](key : String) : Any
    self[Any.new(key)]
  end

  def []?(key : String) : Any?
    self[Any.new(key)]?
  end

  def [](index : Int32) : Any
    as_a[index]
  end

  def []?(index : Int32) : Any?
    a = as_a?
    return nil if a.nil?
    a[index]?
  end

  def dig?(key : String | Int32) : Any?
    step?(key)
  end

  def dig?(key : String | Int32, *rest : String | Int32) : Any?
    v = step?(key)
    return nil if v.nil?
    v.dig?(*rest)
  end

  def dig(key : String | Int32) : Any
    step(key)
  end

  def dig(key : String | Int32, *rest : String | Int32) : Any
    step(key).dig(*rest)
  end

  private def step?(key : String | Int32) : Any?
    if key.is_a?(String)
      self[key]?
    else
      self[key]?
    end
  end

  private def step(key : String | Int32) : Any
    if key.is_a?(String)
      self[key]
    else
      self[key]
    end
  end

  # Structural: same kind, same value; a mapping equals a mapping with the
  # same pairs in any order. `1` and `1.0` are different values.
  def ==(other : Any) : Bool
    k = kind
    return false unless k == other.kind
    if k == KIND_ARRAY
      @raw.as(Array(Any)) == other.raw.as(Array(Any))
    elsif k == KIND_HASH
      a = @raw.as(Hash(Any, Any))
      b = other.raw.as(Hash(Any, Any))
      return false unless a.size == b.size
      a.each do |key, value|
        found = b[key]?
        return false if found.nil?
        return false unless found == value
      end
      true
    elsif k == KIND_STRING
      @raw.as(String) == other.raw.as(String)
    elsif k == KIND_INT
      @raw.as(Int64) == other.raw.as(Int64)
    elsif k == KIND_FLOAT
      @raw.as(Float64) == other.raw.as(Float64)
    elsif k == KIND_BOOL
      @raw.as(Bool) == other.raw.as(Bool)
    else
      true
    end
  end

  def !=(other : Any) : Bool
    !(self == other)
  end

  # Agrees with `==`: the same kind and value hash the same, a mapping's
  # hash does not depend on its order, and `0.0`/`-0.0` share one.
  def hash : Int32
    k = kind
    if k == KIND_ARRAY
      value = 7
      @raw.as(Array(Any)).each { |item| value = (value &* 31) &+ item.hash }
      value
    elsif k == KIND_HASH
      value = 11
      @raw.as(Hash(Any, Any)).each { |key, item| value = value &+ ((key.hash &* 31) &+ item.hash) }
      value
    elsif k == KIND_STRING
      @raw.as(String).hash
    elsif k == KIND_INT
      v = @raw.as(Int64)
      ((v ^ (v >> 32)) & 0x7FFFFFFF_i64).to_i32
    elsif k == KIND_FLOAT
      f = @raw.as(Float64)
      return 3 if f == 0.0
      bits = IyiFloatText.bits_of(f)
      ((bits ^ bits.unsafe_shr(32_u64)) & 0x7FFFFFFF_u64).to_i32
    elsif k == KIND_BOOL
      @raw.as(Bool) ? 1 : 2
    else
      0
    end
  end

  # A string as itself, a number or boolean as written, nil as nothing,
  # a collection the way the prelude prints an array or a hash.
  def to_s : String
    k = kind
    if k == KIND_STRING
      @raw.as(String)
    elsif k == KIND_NIL
      ""
    else
      inspect
    end
  end

  def inspect : String
    k = kind
    if k == KIND_ARRAY
      parts = [] of String
      @raw.as(Array(Any)).each { |item| parts << item.inspect }
      "[" + parts.join(", ") + "]"
    elsif k == KIND_HASH
      parts = [] of String
      @raw.as(Hash(Any, Any)).each { |key, item| parts << key.inspect + " => " + item.inspect }
      "{" + parts.join(", ") + "}"
    elsif k == KIND_STRING
      @raw.as(String).inspect
    elsif k == KIND_INT
      @raw.as(Int64).to_s
    elsif k == KIND_FLOAT
      @raw.as(Float64).to_s
    elsif k == KIND_BOOL
      @raw.as(Bool) ? "true" : "false"
    else
      "nil"
    end
  end
end

# A growable byte buffer for the strings the parser and the emitter build.
class ByteBuffer
  @bytes : Pointer(UInt8)
  @capacity : Int32
  @size : Int32

  def initialize
    @capacity = 64
    @bytes = Pointer(UInt8).malloc(64_u64)
    @size = 0
  end

  def size : Int32
    @size
  end

  def clear : Nil
    @size = 0
  end

  def <<(byte : UInt8) : Nil
    room(@size + 1)
    @bytes[@size] = byte
    @size = @size + 1
  end

  def <<(text : String) : Nil
    count = text.bytesize
    return if count == 0
    room(@size + count)
    (@bytes + @size).copy_from(text.to_unsafe, count)
    @size = @size + count
  end

  # `count` bytes from `source`, as they are.
  def append(source : Pointer(UInt8), count : Int32) : Nil
    return if count <= 0
    room(@size + count)
    (@bytes + @size).copy_from(source, count)
    @size = @size + count
  end

  def spaces(count : Int32) : Nil
    while count > 0
      self << 32_u8
      count = count - 1
    end
  end

  def codepoint(point : Int32) : Nil
    if point < 0x80
      self << point.to_u8
    elsif point < 0x800
      self << (0xC0 | (point >> 6)).to_u8
      self << (0x80 | (point & 0x3F)).to_u8
    elsif point < 0x10000
      self << (0xE0 | (point >> 12)).to_u8
      self << (0x80 | ((point >> 6) & 0x3F)).to_u8
      self << (0x80 | (point & 0x3F)).to_u8
    else
      self << (0xF0 | (point >> 18)).to_u8
      self << (0x80 | ((point >> 12) & 0x3F)).to_u8
      self << (0x80 | ((point >> 6) & 0x3F)).to_u8
      self << (0x80 | (point & 0x3F)).to_u8
    end
  end

  def to_s : String
    count = @size
    source = @bytes
    String.new(count) { |target| target.copy_from(source, count) }
  end

  private def room(needed : Int32) : Nil
    return if needed <= @capacity
    while @capacity < needed
      @capacity = @capacity * 2
    end
    @bytes = @bytes.realloc(@capacity.to_u64)
  end
end

# The core schema's reading of a plain scalar, shared by the parser (to
# resolve) and the emitter (to know what must be quoted).
module Scalar
  def self.resolve(text : String) : Any
    size = text.bytesize
    return Any.new(nil) if size == 0
    bytes = text.to_unsafe
    first = bytes[0]
    if first == 126_u8 # ~
      return Any.new(nil) if size == 1
    elsif first == 110_u8 || first == 78_u8 # n N
      return Any.new(nil) if text == "null" || text == "Null" || text == "NULL"
    elsif first == 116_u8 || first == 84_u8 # t T
      return Any.new(true) if text == "true" || text == "True" || text == "TRUE"
    elsif first == 102_u8 || first == 70_u8 # f F
      return Any.new(false) if text == "false" || text == "False" || text == "FALSE"
    end

    if first == 48_u8 && size > 2 # 0x.. 0o..
      if bytes[1] == 120_u8
        v = text[2, size - 2].to_i64?(16)
        return Any.new(v) if !v.nil? && hex_digits?(bytes + 2, size - 2)
      elsif bytes[1] == 111_u8
        v = text[2, size - 2].to_i64?(8)
        return Any.new(v) if !v.nil? && octal_digits?(bytes + 2, size - 2)
      end
    end

    at = 0
    at = 1 if first == 45_u8 || first == 43_u8 # - +
    return Any.new(text) if at >= size

    if bytes[at] == 46_u8 # .
      rest = text[at, size - at]
      if rest == ".inf" || rest == ".Inf" || rest == ".INF"
        return Any.new(first == 45_u8 ? "-Infinity".to_f : "Infinity".to_f)
      end
      return Any.new("NaN".to_f) if at == 0 && (rest == ".nan" || rest == ".NaN" || rest == ".NAN")
    end

    if decimal_digits?(bytes + at, size - at)
      v = text.to_i64?(10)
      return Any.new(v) unless v.nil?
      return Any.new(text.to_f)
    end
    return Any.new(text.to_f) if float_text?(bytes + at, size - at)
    Any.new(text)
  end

  def self.decimal_digits?(bytes : Pointer(UInt8), count : Int32) : Bool
    return false if count == 0
    i = 0
    while i < count
      return false if bytes[i] < 48_u8 || bytes[i] > 57_u8
      i = i + 1
    end
    true
  end

  def self.octal_digits?(bytes : Pointer(UInt8), count : Int32) : Bool
    return false if count == 0
    i = 0
    while i < count
      return false if bytes[i] < 48_u8 || bytes[i] > 55_u8
      i = i + 1
    end
    true
  end

  def self.hex_digits?(bytes : Pointer(UInt8), count : Int32) : Bool
    return false if count == 0
    i = 0
    while i < count
      b = bytes[i]
      digit = (b >= 48_u8 && b <= 57_u8) || (b >= 97_u8 && b <= 102_u8) || (b >= 65_u8 && b <= 70_u8)
      return false unless digit
      i = i + 1
    end
    true
  end

  # `.5`, `7.`, `1.5`, `1e3`, `1.5E-3`: digits with at most one point,
  # at least one digit, an optional exponent with at least one digit.
  def self.float_text?(bytes : Pointer(UInt8), count : Int32) : Bool
    i = 0
    digits = 0
    while i < count && bytes[i] >= 48_u8 && bytes[i] <= 57_u8
      i = i + 1
      digits = digits + 1
    end
    if i < count && bytes[i] == 46_u8
      i = i + 1
      while i < count && bytes[i] >= 48_u8 && bytes[i] <= 57_u8
        i = i + 1
        digits = digits + 1
      end
    end
    return false if digits == 0
    return true if i == count
    return false unless bytes[i] == 101_u8 || bytes[i] == 69_u8
    i = i + 1
    i = i + 1 if i < count && (bytes[i] == 45_u8 || bytes[i] == 43_u8)
    return false if i >= count
    while i < count
      return false if bytes[i] < 48_u8 || bytes[i] > 57_u8
      i = i + 1
    end
    true
  end
end

# Reads one stream. Every failure is recorded once in `@error` and every
# loop returns as soon as one is recorded; nothing is raised inside.
pub class Parser
  DEPTH_LIMIT = 256
  # How many nodes aliases may add to a stream, counted as they are
  # expanded; the sentence below spells the same number.
  ALIAS_NODE_LIMIT = 1_000_000_i64

  @bytes : Pointer(UInt8)
  @size : Int32
  # Per line: where it starts, where its text ends (before the line
  # break), where its content starts (after the indentation; moved past a
  # `- ` when a sequence entry is entered), whether a tab was in the
  # indentation.
  @starts : Array(Int32)
  @ends : Array(Int32)
  @heads : Array(Int32)
  @tabbed : Array(Bool)
  @line : Int32
  @error : String?
  @anchors : Hash(String, Any)
  @open_anchors : Array(String)
  # Nodes read so far, and per anchor how many nodes its value holds
  # (measured between opening and closing it); an alias adds that many
  # to `@nodes` and to `@expanded`, which is what ALIAS_NODE_LIMIT bounds.
  @nodes : Int64
  @expanded : Int64
  @anchor_sizes : Hash(String, Int64)
  @open_sizes : Array(Int64)
  @depth : Int32
  @buffer : ByteBuffer

  def initialize(text : String)
    @bytes = text.to_unsafe
    @size = text.bytesize
    @starts = [] of Int32
    @ends = [] of Int32
    @heads = [] of Int32
    @tabbed = [] of Bool
    @line = 0
    @error = nil
    @anchors = Hash(String, Any).new
    @open_anchors = [] of String
    @nodes = 0_i64
    @expanded = 0_i64
    @anchor_sizes = Hash(String, Int64).new
    @open_sizes = [] of Int64
    @depth = 0
    @buffer = ByteBuffer.new
    split_lines
  end

  def error : String?
    @error
  end

  # Every document in the stream, or nil with `error` set.
  def parse_all : Array(Any)?
    docs = [] of Any
    implicit_allowed = true
    while true
      skip_directives_and_blank
      return nil if @error
      break if @line >= @starts.size
      explicit = false
      node = Any.new(nil)
      if marker?(@line, 45_u8) # ---
        explicit = true
        pos = skip_blank(@starts[@line] + 3)
        if pos < @ends[@line] && @bytes[pos] != 35_u8
          @heads[@line] = pos
          node = parse_block_node(-1, false)
        else
          @line = @line + 1
          node = parse_block_node(-1, false)
        end
      elsif marker?(@line, 46_u8) # ... with nothing before it
        fail("a document end marker with no document", @starts[@line])
        return nil
      else
        unless implicit_allowed
          fail("expected '---' before another document", @heads[@line])
          return nil
        end
        node = parse_block_node(-1, false)
      end
      return nil if @error
      # Every node leaves `@line` on the first line after it, so the next
      # document starts here or on a later blank-free line.
      @anchors = Hash(String, Any).new
      @anchor_sizes = Hash(String, Int64).new
      docs << node
      implicit_allowed = false
      skip_blank_lines
      break if @line >= @starts.size
      if marker?(@line, 46_u8)
        pos = skip_blank(@starts[@line] + 3)
        expect_line_end(pos)
        return nil if @error
        @line = @line + 1
        implicit_allowed = true
      elsif !marker?(@line, 45_u8)
        refuse_stray(@line)
        return nil
      end
    end
    docs
  end

  # ------------------------------------------------------------------
  # Lines

  # The first control character is remembered and refused once every
  # line is known, since the sentence needs the line table to say where.
  private def split_lines : Nil
    at = 0
    at = 3 if @size >= 3 && @bytes[0] == 0xEF_u8 && @bytes[1] == 0xBB_u8 && @bytes[2] == 0xBF_u8
    control = -1
    while at <= @size
      start = at
      while at < @size && @bytes[at] != 10_u8 && @bytes[at] != 13_u8
        b = @bytes[at]
        if control < 0 && ((b < 32_u8 && b != 9_u8) || b == 127_u8)
          control = at
        end
        at = at + 1
      end
      finish = at
      head = start
      tabbed = false
      while head < finish && @bytes[head] == 32_u8
        head = head + 1
      end
      tabbed = head < finish && @bytes[head] == 9_u8
      @starts << start
      @ends << finish
      @heads << head
      @tabbed << tabbed
      if at < @size
        if @bytes[at] == 13_u8 && at + 1 < @size && @bytes[at + 1] == 10_u8
          at = at + 2
        else
          at = at + 1
        end
      else
        break
      end
    end
    if control >= 0
      b = @bytes[control].to_i32
      digits = "0123456789ABCDEF"
      name = String.new(4) do |t|
        t[0] = 48_u8
        t[1] = 48_u8
        t[2] = digits.to_unsafe[b >> 4]
        t[3] = digits.to_unsafe[b & 15]
      end
      fail("control character U+#{name} is not allowed", control)
    end
  end

  private def indent_of(line : Int32) : Int32
    @heads[line] - @starts[line]
  end

  # Nothing but whitespace, or a comment.
  private def blank_line?(line : Int32) : Bool
    pos = skip_blank(@heads[line])
    pos >= @ends[line] || @bytes[pos] == 35_u8
  end

  # `---` or `...` at the first column, alone or followed by a space.
  private def marker?(line : Int32, byte : UInt8) : Bool
    start = @starts[line]
    return false unless @heads[line] == start
    return false if @ends[line] - start < 3
    return false unless @bytes[start] == byte && @bytes[start + 1] == byte && @bytes[start + 2] == byte
    @ends[line] - start == 3 || @bytes[start + 3] == 32_u8 || @bytes[start + 3] == 9_u8
  end

  private def document_marker?(line : Int32) : Bool
    marker?(line, 45_u8) || marker?(line, 46_u8)
  end

  private def skip_blank_lines : Nil
    while @line < @starts.size && blank_line?(@line)
      @line = @line + 1
    end
  end

  private def skip_directives_and_blank : Nil
    while @line < @starts.size
      if blank_line?(@line)
        @line = @line + 1
      elsif @heads[@line] == @starts[@line] && @bytes[@starts[@line]] == 37_u8 # %
        @line = @line + 1
        skip_blank_lines
        if @line >= @starts.size || !marker?(@line, 45_u8)
          at = @line < @starts.size ? @heads[@line] : @size
          fail("expected '---' after a directive", at)
          return
        end
      else
        return
      end
    end
  end

  # The next non-blank line has no tab in its indentation, or the error
  # says so.
  private def refuse_tab(line : Int32) : Nil
    fail("tab used for indentation", @heads[line]) if @tabbed[line]
  end

  # A line at an indentation that belongs to nothing: a sequence entry or
  # mapping entry, named as such, or plain text.
  private def refuse_stray(line : Int32) : Nil
    if sequence_entry?(line)
      fail("bad indentation of a sequence entry", @heads[line])
    elsif key_colon(line) >= 0
      fail("bad indentation of a mapping entry", @heads[line])
    else
      fail("unexpected content", @heads[line])
    end
  end

  # ------------------------------------------------------------------
  # Positions and errors

  private def fail(message : String, pos : Int32) : Nil
    return unless @error.nil?
    line = 0
    lo = 0
    hi = @starts.size - 1
    while lo <= hi
      mid = (lo + hi) // 2
      if @starts[mid] <= pos
        line = mid
        lo = mid + 1
      else
        hi = mid - 1
      end
    end
    column = 1
    at = @starts[line]
    while at < pos && at < @size
      column = column + 1 if (@bytes[at] & 192_u8) != 128_u8
      at = at + 1
    end
    @error = "#{message} at line #{line + 1}, column #{column}"
  end

  private def skip_blank(pos : Int32) : Int32
    while pos < @size && (@bytes[pos] == 32_u8 || @bytes[pos] == 9_u8)
      pos = pos + 1
    end
    pos
  end

  private def blank_byte?(b : UInt8) : Bool
    b == 32_u8 || b == 9_u8
  end

  # `pos` is the end of its line, or a comment starts there.
  private def line_end?(pos : Int32) : Bool
    pos = skip_blank(pos)
    pos >= @ends[@line] || @bytes[pos] == 35_u8
  end

  private def expect_line_end(pos : Int32) : Nil
    return if @error
    at = skip_blank(pos)
    return if at >= @ends[@line] || (@bytes[at] == 35_u8 && (at == pos || at > @heads[@line]))
    if @bytes[at] == 58_u8 && value_indicator?(at, false, @ends[@line])
      fail("a mapping value is not allowed here", at)
    else
      fail("unexpected content", at)
    end
  end

  # A `:` that ends a key: followed by blank or line end, or in flow
  # context by a flow indicator.
  private def value_indicator?(pos : Int32, flow : Bool, finish : Int32) : Bool
    return false unless @bytes[pos] == 58_u8
    return true if pos + 1 >= finish
    n = @bytes[pos + 1]
    return true if blank_byte?(n)
    flow && (n == 44_u8 || n == 93_u8 || n == 125_u8 || n == 91_u8 || n == 123_u8)
  end

  # ------------------------------------------------------------------
  # Line shapes

  private def sequence_entry?(line : Int32) : Bool
    pos = @heads[line]
    return false if pos >= @ends[line] || @bytes[pos] != 45_u8
    pos + 1 >= @ends[line] || blank_byte?(@bytes[pos + 1])
  end

  # Where the key's `:` is on this line, or -1. Anchors and tags in front
  # are skipped (whether they are properties of the key or of a flow
  # collection is settled by what follows them). Quoted keys close on the
  # same line; a plain key runs to the first `: ` that is not inside a
  # comment.
  private def key_colon(line : Int32) : Int32
    pos = @heads[line]
    finish = @ends[line]
    while pos < finish && (@bytes[pos] == 38_u8 || @bytes[pos] == 33_u8)
      pos = skip_blank(@bytes[pos] == 38_u8 ? name_end(pos + 1, finish) : tag_end(pos, finish))
    end
    return -1 if pos >= finish
    b = @bytes[pos]
    if b == 34_u8 || b == 39_u8
      close = closing_quote_on_line(pos, finish)
      return -1 if close < 0
      at = skip_blank(close + 1)
      return -1 if at >= finish
      return value_indicator?(at, false, finish) ? at : -1
    end
    return -1 if b == 91_u8 || b == 123_u8 || b == 35_u8 || b == 124_u8 || b == 62_u8
    return -1 if b == 45_u8 && (pos + 1 >= finish || blank_byte?(@bytes[pos + 1]))
    at = pos
    while at < finish
      c = @bytes[at]
      return -1 if c == 35_u8 && at > pos && blank_byte?(@bytes[at - 1])
      return at if c == 58_u8 && value_indicator?(at, false, finish)
      at = at + 1
    end
    -1
  end

  private def closing_quote_on_line(pos : Int32, finish : Int32) : Int32
    quote = @bytes[pos]
    at = pos + 1
    while at < finish
      c = @bytes[at]
      if quote == 34_u8 && c == 92_u8
        at = at + 2
        next
      end
      if c == quote
        if quote == 39_u8 && at + 1 < finish && @bytes[at + 1] == 39_u8
          at = at + 2
          next
        end
        return at
      end
      at = at + 1
    end
    -1
  end

  # ------------------------------------------------------------------
  # Block nodes

  # The node that starts on the next non-blank line, which must be
  # indented past `parent`; a sequence at `parent`'s own indentation is
  # taken when `sequence_at_parent` says so (the value of a mapping key).
  # A line that is not indented past `parent` is left where it is and the
  # node is null. Every node, scalar or collection, leaves `@line` on the
  # first line after it, so a caller never guesses whether the line it is
  # on was consumed.
  private def parse_block_node(parent : Int32, sequence_at_parent : Bool) : Any
    skip_blank_lines
    return Any.new(nil) if @error
    return Any.new(nil) if @line >= @starts.size || document_marker?(@line)
    refuse_tab(@line)
    return Any.new(nil) if @error
    indent = indent_of(@line)
    if indent <= parent
      if sequence_at_parent && indent == parent && sequence_entry?(@line)
        return parse_block_sequence(indent)
      end
      return Any.new(nil)
    end
    if sequence_entry?(@line)
      parse_block_sequence(indent)
    elsif key_colon(@line) >= 0
      parse_block_mapping(indent)
    else
      value = parse_inline_node(@heads[@line], parent, sequence_at_parent)
      value
    end
  end

  # A node whose first token is at `pos` on the current line: properties,
  # then an alias, a quoted or plain scalar, a flow collection, a block
  # scalar, or (after properties alone) the block node on the lines below.
  # Requires the rest of the value's last line to be empty and steps past
  # it.
  private def parse_inline_node(pos : Int32, parent : Int32, sequence_at_parent : Bool) : Any
    anchor = nil.as(String?)
    tag = nil.as(String?)
    anchor_pos = pos
    while true
      b = pos < @ends[@line] ? @bytes[pos] : 0_u8
      if b == 38_u8 # &
        fail("a second anchor", pos) unless anchor.nil?
        return Any.new(nil) if @error
        anchor_pos = pos
        finish = name_end(pos + 1, @ends[@line])
        anchor = String.new(finish - pos - 1) { |t| t.copy_from(@bytes + pos + 1, finish - pos - 1) }
        fail("an anchor with no name", pos) if !anchor.nil? && anchor.empty?
        return Any.new(nil) if @error
        pos = skip_blank(finish)
      elsif b == 33_u8 # !
        finish = tag_end(pos, @ends[@line])
        tag = tag_text(pos, finish)
        fail("unknown tag #{tag}", pos) unless tag.nil? || known_tag?(tag)
        return Any.new(nil) if @error
        pos = skip_blank(finish)
      else
        break
      end
    end
    open_anchor(anchor)
    value = Any.new(nil)
    if line_end?(pos)
      # Properties alone on the line: the node is below.
      @line = @line + 1
      value = parse_block_node(parent, sequence_at_parent)
      value = apply_tag(tag, value, anchor_pos)
    else
      if pos != anchor_pos
        # Properties in front of what would otherwise be a key: `&a k: v`.
        # key_colon looks from the line's head; look from the properties.
        saved = @heads[@line]
        @heads[@line] = anchor_pos
        is_key = key_colon(@line) >= 0
        @heads[@line] = saved
        if is_key
          fail("an anchor or tag on a mapping key is not supported", anchor_pos)
          return Any.new(nil)
        end
      end
      value = parse_inline_value(pos, parent, tag)
      @line = @line + 1 unless @error
    end
    close_anchor(anchor, value)
    value
  end

  private def parse_inline_value(pos : Int32, parent : Int32, tag : String?) : Any
    @nodes = @nodes + 1
    b = @bytes[pos]
    if b == 42_u8 # *
      finish = name_end(pos + 1, @ends[@line])
      name = String.new(finish - pos - 1) { |t| t.copy_from(@bytes + pos + 1, finish - pos - 1) }
      value = resolve_alias(name, pos)
      expect_line_end(finish)
      return value
    end
    if b == 91_u8 || b == 123_u8
      finish = 0
      value = Any.new(nil)
      if b == 91_u8
        value = parse_flow_sequence(pos)
      else
        value = parse_flow_mapping(pos)
      end
      return Any.new(nil) if @error
      expect_line_end(@flow_end)
      return apply_tag(tag, value, pos)
    end
    if b == 124_u8 || b == 62_u8 # | >
      value = parse_block_scalar(pos, parent)
      return apply_tag(tag, value, pos)
    end
    if b == 34_u8 || b == 39_u8
      text = parse_quoted(pos, parent, false)
      return Any.new(nil) if @error
      expect_line_end(@flow_end)
      return apply_tag(tag, Any.new(text), pos)
    end
    if b == 64_u8 || b == 96_u8 || b == 37_u8 || b == 93_u8 || b == 125_u8 || b == 44_u8 || b == 63_u8
      fail("a scalar cannot start with '#{b.unsafe_chr}'", pos)
      return Any.new(nil)
    end
    text = parse_plain_block(pos, parent)
    return Any.new(nil) if @error
    expect_line_end(@flow_end)
    if tag.nil?
      Scalar.resolve(text)
    else
      apply_tag(tag, Any.new(text), pos)
    end
  end

  private def parse_block_sequence(indent : Int32) : Any
    @nodes = @nodes + 1
    items = [] of Any
    result = Any.new(items)
    enter(@heads[@line])
    return result if @error
    while true
      skip_blank_lines
      break if @line >= @starts.size || document_marker?(@line)
      refuse_tab(@line)
      break if @error
      at = indent_of(@line)
      break if at < indent
      if at > indent
        refuse_stray(@line)
        break
      end
      break unless sequence_entry?(@line)
      dash = @heads[@line]
      pos = skip_blank(dash + 1)
      if pos >= @ends[@line] || @bytes[pos] == 35_u8
        @line = @line + 1
        items << parse_block_node(indent, false)
      else
        dash_line = @line
        @heads[@line] = pos
        items << parse_block_node(indent, false)
        @heads[dash_line] = dash
      end
      break if @error
    end
    leave
    result
  end

  private def parse_block_mapping(indent : Int32) : Any
    @nodes = @nodes + 1
    pairs = Hash(Any, Any).new
    spelled = Hash(Any, Bool).new
    result = Any.new(pairs)
    enter(@heads[@line])
    return result if @error
    while true
      skip_blank_lines
      break if @line >= @starts.size || document_marker?(@line)
      refuse_tab(@line)
      break if @error
      at = indent_of(@line)
      break if at < indent
      if at > indent
        refuse_stray(@line)
        break
      end
      key_pos = @heads[@line]
      if @bytes[key_pos] == 63_u8 && (key_pos + 1 >= @ends[@line] || blank_byte?(@bytes[key_pos + 1]))
        fail("an explicit '?' key is not supported", key_pos)
        break
      end
      colon = key_colon(@line)
      if colon < 0
        if @bytes[key_pos] == 38_u8 || @bytes[key_pos] == 33_u8
          fail("an anchor or tag on a mapping key is not supported", key_pos)
        else
          fail("expected a mapping key", key_pos)
        end
        break
      end
      merge = false
      key = Any.new(nil)
      b = @bytes[key_pos]
      if b == 34_u8 || b == 39_u8
        key = Any.new(parse_quoted(key_pos, indent, false))
      elsif b == 42_u8 || b == 38_u8 || b == 33_u8
        fail("an alias, anchor or tag as a mapping key is not supported", key_pos)
      else
        finish = colon
        while finish > key_pos && blank_byte?(@bytes[finish - 1])
          finish = finish - 1
        end
        text = String.new(finish - key_pos) { |t| t.copy_from(@bytes + key_pos, finish - key_pos) }
        merge = text == "<<"
        key = Scalar.resolve(text)
      end
      break if @error
      if !merge && spelled.has_key?(key)
        fail("duplicate key #{key.inspect}", key_pos)
        break
      end
      spelled[key] = true unless merge
      pos = skip_blank(colon + 1)
      value = Any.new(nil)
      if pos >= @ends[@line] || @bytes[pos] == 35_u8
        @line = @line + 1
        value = parse_block_node(indent, true)
      else
        value = parse_inline_node(pos, indent, true)
      end
      break if @error
      if merge
        merge_into(pairs, value, key_pos)
      else
        pairs[key] = value
      end
      break if @error
    end
    leave
    result
  end

  # The merged mappings' pairs go in where the `<<` is; a key already in
  # the mapping keeps its value, and a key spelled later in the mapping
  # replaces the merged one (a later `pairs[key] = value` does that).
  private def merge_into(pairs : Hash(Any, Any), value : Any, pos : Int32) : Nil
    k = value.kind
    if k == Any::KIND_HASH
      value.as_h.each do |key, item|
        pairs[key] = item unless pairs.has_key?(key)
      end
    elsif k == Any::KIND_ARRAY
      value.as_a.each do |element|
        unless element.kind == Any::KIND_HASH
          fail("a merge value must be a mapping or a sequence of mappings", pos)
          return
        end
        element.as_h.each do |key, item|
          pairs[key] = item unless pairs.has_key?(key)
        end
      end
    else
      fail("a merge value must be a mapping or a sequence of mappings", pos)
    end
  end

  # ------------------------------------------------------------------
  # Scalars

  # The end of an anchor, alias or tag name on a line ending at `finish`:
  # blank, line end, or a flow indicator.
  private def name_end(pos : Int32, finish : Int32) : Int32
    while pos < finish
      b = @bytes[pos]
      break if blank_byte?(b) || b == 44_u8 || b == 91_u8 || b == 93_u8 || b == 123_u8 || b == 125_u8
      pos = pos + 1
    end
    pos
  end

  # The end of the tag at `pos` (a `!`): a verbatim `!<...>` runs to its
  # `>`, whatever is inside; any other tag is a name.
  private def tag_end(pos : Int32, finish : Int32) : Int32
    return name_end(pos, finish) unless pos + 1 < finish && @bytes[pos + 1] == 60_u8
    at = pos + 2
    while at < finish
      return at + 1 if @bytes[at] == 62_u8
      at = at + 1
    end
    finish
  end

  # The tag's text; the verbatim spelling of a core tag,
  # `!<tag:yaml.org,2002:str>`, is read as its `!!str` shorthand. Any
  # other tag keeps its spelling, so the refusal echoes it whole.
  private def tag_text(pos : Int32, finish : Int32) : String
    text = String.new(finish - pos) { |t| t.copy_from(@bytes + pos, finish - pos) }
    prefix = "!<tag:yaml.org,2002:"
    if text.starts_with?(prefix) && text.ends_with?(">") && text.bytesize > prefix.bytesize + 1
      short = "!!" + text[prefix.bytesize, text.bytesize - prefix.bytesize - 1]
      return short if known_tag?(short)
    end
    text
  end

  private def known_tag?(tag : String) : Bool
    tag == "!!str" || tag == "!!int" || tag == "!!float" || tag == "!!bool" || tag == "!!null" ||
      tag == "!!seq" || tag == "!!map"
  end

  # A tagged scalar must read as what the tag says; `!!seq`/`!!map` only
  # confirm the shape.
  private def apply_tag(tag : String?, value : Any, pos : Int32) : Any
    return value if tag.nil? || @error
    k = value.kind
    if tag == "!!seq"
      fail("!!seq on #{value.kind_name}", pos) unless k == Any::KIND_ARRAY
      return value
    elsif tag == "!!map"
      fail("!!map on #{value.kind_name}", pos) unless k == Any::KIND_HASH
      return value
    end
    unless k == Any::KIND_STRING
      fail("#{tag} on #{value.kind_name}", pos)
      return value
    end
    text = value.as_s
    return value if tag == "!!str"
    resolved = Scalar.resolve(text)
    rk = resolved.kind
    if tag == "!!int"
      return resolved if rk == Any::KIND_INT
      fail("not an integer: #{text.inspect}", pos)
    elsif tag == "!!float"
      return resolved if rk == Any::KIND_FLOAT
      return Any.new(resolved.as_i.to_f64) if rk == Any::KIND_INT
      fail("not a float: #{text.inspect}", pos)
    elsif tag == "!!bool"
      return resolved if rk == Any::KIND_BOOL
      fail("not a boolean: #{text.inspect}", pos)
    else
      return resolved if rk == Any::KIND_NIL
      fail("not null: #{text.inspect}", pos)
    end
    value
  end

  # After a scalar or flow collection: where it stopped on the line it
  # stopped on.
  @flow_end : Int32 = 0

  # A plain scalar in block context, folded across the lines below that
  # are indented past `parent`.
  private def parse_plain_block(pos : Int32, parent : Int32) : String
    @buffer.clear
    stop = plain_piece_end(pos, false)
    @buffer.append(@bytes + pos, stop - pos)
    @flow_end = stop
    return @buffer.to_s if stop < @ends[@line] && @bytes[stop] == 58_u8
    blanks = 0
    look = @line + 1
    while look < @starts.size
      break if document_marker?(look)
      if blank_line?(look)
        # A comment line ends the scalar; whitespace-only lines fold.
        at = skip_blank(@heads[look])
        break if at < @ends[look]
        blanks = blanks + 1
        look = look + 1
        next
      end
      break if indent_of(look) <= parent
      if @tabbed[look]
        fail("tab used for indentation", @heads[look])
        break
      end
      if sequence_entry?(look)
        fail("bad indentation of a sequence entry", @heads[look])
        break
      end
      if key_colon(look) >= 0
        fail("bad indentation of a mapping entry", @heads[look])
        break
      end
      @line = look
      start = @heads[look]
      stop = plain_piece_end(start, false)
      if stop < @ends[look] && @bytes[stop] == 58_u8
        fail("a mapping value is not allowed here", stop)
        break
      end
      if blanks == 0
        @buffer << 32_u8
      else
        while blanks > 0
          @buffer << 10_u8
          blanks = blanks - 1
        end
      end
      @buffer.append(@bytes + start, stop - start)
      @flow_end = stop
      look = look + 1
    end
    @buffer.to_s
  end

  # Where the plain text on this line ends: before ` #`, at a value
  # indicator, at a flow indicator in flow context, or at the line end,
  # trailing blanks dropped.
  private def plain_piece_end(pos : Int32, flow : Bool) : Int32
    at = pos
    finish = @ends[@line]
    while at < finish
      b = @bytes[at]
      break if b == 35_u8 && at > pos && blank_byte?(@bytes[at - 1])
      break if b == 58_u8 && value_indicator?(at, flow, finish)
      break if flow && (b == 44_u8 || b == 91_u8 || b == 93_u8 || b == 123_u8 || b == 125_u8)
      at = at + 1
    end
    while at > pos && blank_byte?(@bytes[at - 1])
      at = at - 1
    end
    at
  end

  # A quoted scalar starting at `pos`; folded across lines, which in block
  # context must be indented past `parent`. Leaves `@flow_end` after the
  # closing quote.
  private def parse_quoted(pos : Int32, parent : Int32, flow : Bool) : String
    quote = @bytes[pos]
    opener = pos
    @buffer.clear
    at = pos + 1
    blanks = 0
    pending_space = false
    while true
      if at >= @ends[@line]
        # The line ended inside the string: fold onto the next line.
        trim_trailing_blanks
        look = @line + 1
        while look < @starts.size && !document_marker?(look) && skip_blank(@starts[look]) >= @ends[look]
          blanks = blanks + 1
          look = look + 1
        end
        if look >= @starts.size || document_marker?(look) || (!flow && indent_of(look) <= parent)
          fail("unterminated quoted string", opener)
          return ""
        end
        if blanks == 0
          @buffer << 32_u8 unless pending_space == false && false
        else
          while blanks > 0
            @buffer << 10_u8
            blanks = blanks - 1
          end
        end
        pending_space = false
        @line = look
        at = skip_blank(@starts[look])
        next
      end
      b = @bytes[at]
      if b == quote
        if quote == 39_u8 && at + 1 < @ends[@line] && @bytes[at + 1] == 39_u8
          @buffer << 39_u8
          at = at + 2
          next
        end
        @flow_end = at + 1
        return @buffer.to_s
      end
      if quote == 34_u8 && b == 92_u8
        if at + 1 >= @ends[@line]
          # Escaped line break: join with nothing.
          trim_trailing_blanks
          look = @line + 1
          if look >= @starts.size || document_marker?(look) || (!flow && indent_of(look) <= parent)
            fail("unterminated quoted string", opener)
            return ""
          end
          @line = look
          at = skip_blank(@starts[look])
          next
        end
        at = escape(at)
        return "" if @error
        next
      end
      @buffer << b
      at = at + 1
    end
    ""
  end

  private def trim_trailing_blanks : Nil
    # The buffer has no pop; rebuild without trailing blanks.
    text = @buffer.to_s
    count = text.bytesize
    while count > 0 && blank_byte?(text.to_unsafe[count - 1])
      count = count - 1
    end
    return if count == text.bytesize
    @buffer.clear
    @buffer.append(text.to_unsafe, count)
  end

  # `at` is the backslash; appends the escape and answers where it ends.
  private def escape(at : Int32) : Int32
    e = @bytes[at + 1]
    decoded = -1
    if e == 110_u8
      decoded = 10 # n
    elsif e == 116_u8
      decoded = 9 # t
    elsif e == 114_u8
      decoded = 13 # r
    elsif e == 34_u8
      decoded = 34 # "
    elsif e == 92_u8
      decoded = 92 # backslash
    elsif e == 47_u8
      decoded = 47 # /
    elsif e == 48_u8
      decoded = 0 # 0
    elsif e == 97_u8
      decoded = 7 # a
    elsif e == 98_u8
      decoded = 8 # b
    elsif e == 101_u8
      decoded = 27 # e
    elsif e == 102_u8
      decoded = 12 # f
    elsif e == 118_u8
      decoded = 11 # v
    elsif e == 32_u8
      decoded = 32 # space
    elsif e == 9_u8
      decoded = 9 # tab
    elsif e == 78_u8
      decoded = 0x85 # N
    elsif e == 95_u8
      decoded = 0xA0 # _
    elsif e == 76_u8
      decoded = 0x2028 # L
    elsif e == 80_u8
      decoded = 0x2029 # P
    end
    if decoded >= 0
      @buffer.codepoint(decoded)
      return at + 2
    end
    digits = 0
    if e == 120_u8
      digits = 2
    elsif e == 117_u8
      digits = 4
    elsif e == 85_u8
      digits = 8
    else
      fail("unknown escape '\\#{e.unsafe_chr}'", at)
      return at + 2
    end
    point = 0
    i = 0
    while i < digits
      p = at + 2 + i
      if p >= @ends[@line]
        fail("unknown escape '\\#{e.unsafe_chr}'", at)
        return at + 2
      end
      d = @bytes[p].unsafe_chr.to_i?(16)
      if d.nil?
        fail("unknown escape '\\#{e.unsafe_chr}'", at)
        return at + 2
      end
      point = point * 16 + d
      i = i + 1
    end
    if point > 0x10FFFF
      fail("escape past the last code point", at)
      return at + 2
    end
    if point >= 0xD800 && point <= 0xDFFF
      written = String.new(2 + digits) { |t| t.copy_from(@bytes + at, 2 + digits) }
      fail("surrogate code point #{written} in escape", at)
      return at + 2
    end
    @buffer.codepoint(point)
    at + 2 + digits
  end

  # `|` or `>` at `pos`: the header, then the lines below.
  private def parse_block_scalar(pos : Int32, parent : Int32) : Any
    literal = @bytes[pos] == 124_u8
    chomp = 0 # clip
    explicit = 0
    at = pos + 1
    finish = @ends[@line]
    while at < finish
      b = @bytes[at]
      if b == 45_u8 && chomp == 0
        chomp = -1
      elsif b == 43_u8 && chomp == 0
        chomp = 1
      elsif b >= 49_u8 && b <= 57_u8 && explicit == 0
        explicit = (b - 48_u8).to_i32
      else
        break
      end
      at = at + 1
    end
    expect_line_end(at)
    return Any.new(nil) if @error
    indent = 0
    if explicit > 0
      indent = parent < 0 ? explicit : parent + explicit
    else
      look = @line + 1
      while look < @starts.size
        content = skip_blank(@starts[look])
        if content < @ends[look]
          indent = content - @starts[look]
          break
        end
        look = look + 1
      end
      floor = parent + 1
      floor = 1 if floor < 1
      indent = floor if indent < floor
    end
    lines = [] of String
    look = @line + 1
    last_content = @line
    while look < @starts.size
      start = @starts[look]
      finish = @ends[look]
      spaces = 0
      while start + spaces < finish && @bytes[start + spaces] == 32_u8
        spaces = spaces + 1
      end
      if start + spaces >= finish
        lines << ""
        look = look + 1
        next
      end
      break if spaces < indent
      from = start + indent
      lines << String.new(finish - from) { |t| t.copy_from(@bytes + from, finish - from) }
      last_content = look
      look = look + 1
    end
    # Lines after the last content line are trailing breaks.
    @line = look - 1
    @flow_end = @ends[@line]
    trailing = 0
    while lines.size > 0 && lines.last.empty?
      lines.pop
      trailing = trailing + 1
    end
    @buffer.clear
    if literal
      i = 0
      while i < lines.size
        @buffer << 10_u8 if i > 0
        @buffer << lines[i]
        i = i + 1
      end
    else
      i = 0
      blanks = 0
      previous_more = false
      first = true
      while i < lines.size
        text = lines[i]
        i = i + 1
        if text.empty?
          blanks = blanks + 1
          next
        end
        more = blank_byte?(text.to_unsafe[0])
        if first
          first = false
        elsif previous_more || more
          @buffer << 10_u8
          while blanks > 0
            @buffer << 10_u8
            blanks = blanks - 1
          end
        elsif blanks > 0
          while blanks > 0
            @buffer << 10_u8
            blanks = blanks - 1
          end
        else
          @buffer << 32_u8
        end
        blanks = 0
        previous_more = more
        @buffer << text
      end
    end
    if chomp == 1
      @buffer << 10_u8 if lines.size > 0
      while trailing > 0
        @buffer << 10_u8
        trailing = trailing - 1
      end
    elsif chomp == 0
      @buffer << 10_u8 if lines.size > 0
    end
    Any.new(@buffer.to_s)
  end

  # ------------------------------------------------------------------
  # Flow collections

  # Past blanks, comments and line breaks; -1 when the stream or the
  # document ends first.
  private def skip_flow_space(pos : Int32) : Int32
    while true
      finish = @ends[@line]
      while pos < finish && blank_byte?(@bytes[pos])
        pos = pos + 1
      end
      if pos < finish && @bytes[pos] == 35_u8 && (pos == @heads[@line] || blank_byte?(@bytes[pos - 1]))
        pos = finish
      end
      return pos if pos < finish
      return -1 if @line + 1 >= @starts.size || document_marker?(@line + 1)
      @line = @line + 1
      pos = @starts[@line]
    end
    -1
  end

  private def parse_flow_sequence(opener : Int32) : Any
    items = [] of Any
    result = Any.new(items)
    enter(opener)
    return result if @error
    pos = opener + 1
    while true
      pos = skip_flow_space(pos)
      if pos < 0
        fail("unterminated flow sequence", opener)
        break
      end
      b = @bytes[pos]
      if b == 93_u8
        @flow_end = pos + 1
        break
      end
      if b == 44_u8
        fail("expected a value before ','", pos)
        break
      end
      item_pos = pos
      item = parse_flow_node(pos)
      break if @error
      pos = skip_flow_space(@flow_end)
      if pos >= 0 && @bytes[pos] == 58_u8 && value_indicator?(pos, true, @ends[@line])
        # `[key: value]`: a one-pair mapping.
        pair = Hash(Any, Any).new
        pos = skip_flow_space(pos + 1)
        if pos < 0
          fail("unterminated flow sequence", opener)
          break
        end
        if @bytes[pos] == 44_u8 || @bytes[pos] == 93_u8
          pair[item] = Any.new(nil)
        else
          pair[item] = parse_flow_node(pos)
          break if @error
          pos = skip_flow_space(@flow_end)
        end
        item = Any.new(pair)
      end
      items << item
      if pos < 0
        fail("unterminated flow sequence", opener)
        break
      end
      b = @bytes[pos]
      if b == 44_u8
        pos = pos + 1
      elsif b == 93_u8
        @flow_end = pos + 1
        break
      else
        fail("expected ',' or ']'", pos)
        break
      end
    end
    leave
    result
  end

  private def parse_flow_mapping(opener : Int32) : Any
    pairs = Hash(Any, Any).new
    spelled = Hash(Any, Bool).new
    result = Any.new(pairs)
    enter(opener)
    return result if @error
    pos = opener + 1
    while true
      pos = skip_flow_space(pos)
      if pos < 0
        fail("unterminated flow mapping", opener)
        break
      end
      b = @bytes[pos]
      if b == 125_u8
        @flow_end = pos + 1
        break
      end
      if b == 44_u8
        fail("expected a key before ','", pos)
        break
      end
      key_pos = pos
      if b == 63_u8 && (pos + 1 >= @ends[@line] || blank_byte?(@bytes[pos + 1]))
        fail("an explicit '?' key is not supported", pos)
        break
      end
      merge = b == 60_u8 && pos + 2 < @ends[@line] && @bytes[pos + 1] == 60_u8 && value_indicator?(pos + 2, true, @ends[@line])
      key = parse_flow_node(pos)
      break if @error
      kk = key.kind
      if kk == Any::KIND_ARRAY || kk == Any::KIND_HASH
        fail("a collection cannot be a mapping key", key_pos)
        break
      end
      if !merge && spelled.has_key?(key)
        fail("duplicate key #{key.inspect}", key_pos)
        break
      end
      spelled[key] = true unless merge
      pos = skip_flow_space(@flow_end)
      if pos < 0
        fail("unterminated flow mapping", opener)
        break
      end
      value = Any.new(nil)
      if @bytes[pos] == 58_u8 && (value_indicator?(pos, true, @ends[@line]) || @bytes[key_pos] == 34_u8 || @bytes[key_pos] == 39_u8)
        pos = skip_flow_space(pos + 1)
        if pos < 0
          fail("unterminated flow mapping", opener)
          break
        end
        unless @bytes[pos] == 44_u8 || @bytes[pos] == 125_u8
          value = parse_flow_node(pos)
          break if @error
          pos = skip_flow_space(@flow_end)
          if pos < 0
            fail("unterminated flow mapping", opener)
            break
          end
        end
      end
      if merge
        merge_into(pairs, value, key_pos)
        break if @error
      else
        pairs[key] = value
      end
      b = @bytes[pos]
      if b == 44_u8
        pos = pos + 1
      elsif b == 125_u8
        @flow_end = pos + 1
        break
      else
        fail("expected ',' or '}'", pos)
        break
      end
    end
    leave
    result
  end

  # One node inside a flow collection, starting at `pos` (not blank).
  private def parse_flow_node(pos : Int32) : Any
    anchor = nil.as(String?)
    tag = nil.as(String?)
    anchor_pos = pos
    while true
      b = @bytes[pos]
      if b == 38_u8
        anchor_pos = pos
        finish = name_end(pos + 1, @ends[@line])
        anchor = String.new(finish - pos - 1) { |t| t.copy_from(@bytes + pos + 1, finish - pos - 1) }
        fail("an anchor with no name", pos) if !anchor.nil? && anchor.empty?
        return Any.new(nil) if @error
        pos = skip_flow_space(finish)
      elsif b == 33_u8
        finish = tag_end(pos, @ends[@line])
        tag = tag_text(pos, finish)
        fail("unknown tag #{tag}", pos) unless tag.nil? || known_tag?(tag)
        return Any.new(nil) if @error
        pos = skip_flow_space(finish)
      else
        break
      end
      if pos < 0
        fail("a value was expected after the properties", anchor_pos)
        return Any.new(nil)
      end
    end
    open_anchor(anchor)
    @nodes = @nodes + 1
    b = @bytes[pos]
    value = Any.new(nil)
    if b == 91_u8
      value = parse_flow_sequence(pos)
    elsif b == 123_u8
      value = parse_flow_mapping(pos)
    elsif b == 34_u8 || b == 39_u8
      value = Any.new(parse_quoted(pos, -1, true))
    elsif b == 42_u8
      finish = name_end(pos + 1, @ends[@line])
      name = String.new(finish - pos - 1) { |t| t.copy_from(@bytes + pos + 1, finish - pos - 1) }
      value = resolve_alias(name, pos)
      @flow_end = finish
    elsif b == 44_u8 || b == 93_u8 || b == 125_u8 || b == 64_u8 || b == 96_u8 || b == 37_u8 || b == 124_u8 || b == 62_u8
      fail("a value was expected", pos)
    else
      stop = plain_piece_end(pos, true)
      if stop == pos
        fail("a value was expected", pos)
      else
        text = String.new(stop - pos) { |t| t.copy_from(@bytes + pos, stop - pos) }
        value = tag.nil? ? Scalar.resolve(text) : Any.new(text)
        @flow_end = stop
      end
    end
    return Any.new(nil) if @error
    value = apply_tag(tag, value, anchor_pos)
    close_anchor(anchor, value)
    value
  end

  # ------------------------------------------------------------------
  # Anchors and depth

  private def open_anchor(name : String?) : Nil
    return if name.nil?
    @open_anchors << name
    @open_sizes << @nodes
  end

  private def close_anchor(name : String?, value : Any) : Nil
    return if name.nil?
    started = @nodes
    if @open_anchors.size > 0
      @open_anchors.pop
      started = @open_sizes.pop
    end
    return if @error
    @anchors[name] = value
    @anchor_sizes[name] = @nodes - started
  end

  # The anchored value, shared; the nodes it holds count as read again,
  # and once aliases have added ALIAS_NODE_LIMIT nodes the stream is
  # refused rather than built.
  private def resolve_alias(name : String, pos : Int32) : Any
    if name.empty?
      fail("an alias with no name", pos)
      return Any.new(nil)
    end
    if @open_anchors.includes?(name)
      fail("cyclic alias *#{name}", pos)
      return Any.new(nil)
    end
    found = @anchors[name]?
    if found.nil?
      fail("unknown anchor *#{name}", pos)
      return Any.new(nil)
    end
    size = @anchor_sizes[name]
    @nodes = @nodes + size
    @expanded = @expanded + size
    if @expanded > ALIAS_NODE_LIMIT
      fail("alias expansion past 1,000,000 nodes", pos)
      return Any.new(nil)
    end
    found
  end

  private def enter(pos : Int32) : Nil
    @depth = @depth + 1
    fail("nesting deeper than #{DEPTH_LIMIT} levels", pos) if @depth > DEPTH_LIMIT
  end

  private def leave : Nil
    @depth = @depth - 1
  end
end

# Writes a value as block YAML the parser reads back.
class Emitter
  @out : ByteBuffer

  def initialize
    @out = ByteBuffer.new
  end

  def dump(value : Any) : String
    k = value.kind
    if (k == Any::KIND_ARRAY || k == Any::KIND_HASH) && value.size > 0
      block(value, 0, false)
    else
      @out << scalar_text(value)
      @out << 10_u8
    end
    @out.to_s
  end

  # A non-empty collection, one entry per line at `indent`; when `inline`
  # the first entry continues the current line.
  private def block(value : Any, indent : Int32, inline : Bool) : Nil
    if value.kind == Any::KIND_ARRAY
      first = true
      value.as_a.each do |item|
        @out.spaces(indent) unless first && inline
        first = false
        @out << "- "
        entry(item, indent + 2)
      end
    else
      first = true
      value.as_h.each do |key, item|
        @out.spaces(indent) unless first && inline
        first = false
        kk = key.kind
        raise "cannot dump #{key.kind_name} as a mapping key" if kk == Any::KIND_ARRAY || kk == Any::KIND_HASH
        @out << scalar_text(key)
        @out << ":"
        if collection?(item)
          @out << 10_u8
          block(item, indent + 2, false)
        else
          @out << " "
          entry(item, indent + 2)
        end
      end
    end
  end

  # After `- ` or `key: `: a scalar or empty collection on the line, a
  # collection continuing it.
  private def entry(item : Any, indent : Int32) : Nil
    if collection?(item)
      block(item, indent, true)
    else
      @out << scalar_text(item)
      @out << 10_u8
    end
  end

  private def collection?(value : Any) : Bool
    k = value.kind
    (k == Any::KIND_ARRAY || k == Any::KIND_HASH) && value.size > 0
  end

  private def scalar_text(value : Any) : String
    k = value.kind
    if k == Any::KIND_NIL
      "null"
    elsif k == Any::KIND_BOOL
      value.as_bool ? "true" : "false"
    elsif k == Any::KIND_INT
      value.as_i.to_s
    elsif k == Any::KIND_FLOAT
      f = value.as_f
      if f != f
        ".nan"
      elsif f == "Infinity".to_f
        ".inf"
      elsif f == "-Infinity".to_f
        "-.inf"
      else
        f.to_s
      end
    elsif k == Any::KIND_STRING
      string_text(value.as_s)
    elsif k == Any::KIND_ARRAY
      "[]"
    else
      "{}"
    end
  end

  # Plain when the parser would read it back as the same string, quoted
  # otherwise.
  private def string_text(text : String) : String
    return quoted(text) unless plain_safe?(text)
    text
  end

  # Plain when the parser would read it back as the same string: not an
  # indicator, not `- `/`? ` (an entry), not `<<` (a merge as a key), not
  # a document marker, no `: ` or ` #` inside, and not a value of another
  # kind.
  private def plain_safe?(text : String) : Bool
    size = text.bytesize
    return false if size == 0
    bytes = text.to_unsafe
    first = bytes[0]
    return false if blank_byte?(first) || blank_byte?(bytes[size - 1])
    if first == 45_u8 || first == 63_u8 || first == 58_u8
      return false if size == 1 || blank_byte?(bytes[1])
    elsif indicator?(first)
      return false
    end
    return false if text == "<<"
    return false if text.starts_with?("---") || text.starts_with?("...")
    i = 0
    while i < size
      b = bytes[i]
      return false if b < 32_u8 || b == 127_u8
      if b == 58_u8 && (i + 1 == size || blank_byte?(bytes[i + 1]))
        return false
      end
      return false if b == 35_u8 && i > 0 && blank_byte?(bytes[i - 1])
      i = i + 1
    end
    Scalar.resolve(text).kind == Any::KIND_STRING
  end

  private def indicator?(b : UInt8) : Bool
    b == 44_u8 || b == 91_u8 || b == 93_u8 || b == 123_u8 || b == 125_u8 || b == 35_u8 ||
      b == 38_u8 || b == 42_u8 || b == 33_u8 || b == 124_u8 || b == 62_u8 || b == 39_u8 ||
      b == 34_u8 || b == 37_u8 || b == 64_u8 || b == 96_u8
  end

  private def blank_byte?(b : UInt8) : Bool
    b == 32_u8 || b == 9_u8
  end

  private def quoted(text : String) : String
    buffer = ByteBuffer.new
    buffer << 34_u8
    bytes = text.to_unsafe
    i = 0
    while i < text.bytesize
      b = bytes[i]
      if b == 34_u8
        buffer << "\\\""
      elsif b == 92_u8
        buffer << "\\\\"
      elsif b == 10_u8
        buffer << "\\n"
      elsif b == 9_u8
        buffer << "\\t"
      elsif b == 13_u8
        buffer << "\\r"
      elsif b < 32_u8 || b == 127_u8
        buffer << "\\x"
        buffer << hex_digit(b.to_i32 >> 4)
        buffer << hex_digit(b.to_i32 & 15)
      else
        buffer << b
      end
      i = i + 1
    end
    buffer << 34_u8
    buffer.to_s
  end

  private def hex_digit(value : Int32) : UInt8
    value < 10 ? (48 + value).to_u8 : (87 + value).to_u8
  end
end

pub struct YAML
  # The first document of `text`, or nil when the stream is not YAML this
  # module reads (the whole stream is checked, not just the first
  # document). An empty stream is a null document.
  def self.parse?(text : String) : Any?
    docs = parse_all?(text)
    return nil if docs.nil?
    docs.size == 0 ? Any.new(nil) : docs[0]
  end

  def self.parse(text : String) : Any
    parser = Parser.new(text)
    docs = parser.parse_all
    if docs.nil?
      raise parser.error || "invalid YAML"
    end
    docs.size == 0 ? Any.new(nil) : docs[0]
  end

  def self.parse_all?(text : String) : Array(Any)?
    Parser.new(text).parse_all
  end

  def self.parse_all(text : String) : Array(Any)
    parser = Parser.new(text)
    docs = parser.parse_all
    if docs.nil?
      raise parser.error || "invalid YAML"
    end
    docs
  end

  # Block YAML for `value`, ending in a line break.
  def self.dump(value : Any) : String
    Emitter.new.dump(value)
  end
end
