  private BESSEL_Q1_R3 = [
    -5.07831226461766561369e-09,
    -1.02537829820837089745e-01,
    -4.61011581139473403113e+00,
    -5.78472216562783643212e+01,
    -2.28244540737631695038e+02,
    -2.19210128478909325622e+02,
  ]
  private BESSEL_Q1_S3 = [
    4.76651550323729509273e+01,
    6.73865112676699709482e+02,
    3.38015286679526343505e+03,
    5.54772909720722782367e+03,
    1.90311919338810798763e+03,
    -1.35201191444307340817e+02,
  ]
  private BESSEL_Q1_R2 = [
    -1.78381727510958865572e-07,
    -1.02517042607985553460e-01,
    -2.75220568278187460720e+00,
    -1.96636162643703720221e+01,
    -4.23253133372830490089e+01,
    -2.13719211703704061733e+01,
  ]
  private BESSEL_Q1_S2 = [
    2.95333629060523854548e+01,
    2.52981549982190529136e+02,
    7.57502834868645436472e+02,
    7.39393205320467245656e+02,
    1.55949003336666123687e+02,
    -4.95949898822628210127e+00,
  ]

  # The high word of |x| (the sign cleared) and the low word, as fdlibm's
  # `ix` and `lx`.
  private def self.bessel_ix(x : Float64) : Int64
    high_word(x) & 0x7fffffff_i64
  end

  private def self.bessel_lx(x : Float64) : Int64
    (IyiFloatText.bits_of(x) & 0xffffffff_u64).unsafe_to_i64
  end

  private def self.bessel_negative(x : Float64) : Bool
    IyiFloatText.bits_of(x).unsafe_shr(63_u64) != 0_u64
  end

  # pzero/pone's rational function: 1 + r(z)/s(z), z = 1/x^2.
  private def self.bessel_p_rational(x : Float64, p : Pointer(Float64), q : Pointer(Float64)) : Float64
    z = 1.0 / (x * x)
    r1 = p[0] + z * p[1]
    z2 = z * z
    r2 = p[2] + z * p[3]
    z4 = z2 * z2
    r3 = p[4] + z * p[5]
    r = r1 + z2 * r2 + z4 * r3
    s1 = 1.0 + z * q[0]
    s2 = q[1] + z * q[2]
    s3 = q[3] + z * q[4]
    s = s1 + z2 * s2 + z4 * s3
    1.0 + r / s
  end

  # qzero/qone's rational function r(z)/s(z), z = 1/x^2.
  private def self.bessel_q_rational(x : Float64, p : Pointer(Float64), q : Pointer(Float64)) : Float64
    z = 1.0 / (x * x)
    r1 = p[0] + z * p[1]
    z2 = z * z
    r2 = p[2] + z * p[3]
    z4 = z2 * z2
    r3 = p[4] + z * p[5]
    z6 = z4 * z2
    r = r1 + z2 * r2 + z4 * r3
    s1 = 1.0 + z * q[0]
    s2 = q[1] + z * q[2]
    s3 = q[3] + z * q[4]
    s = s1 + z2 * s2 + z4 * s3 + z6 * q[5]
    r / s
  end

  # P(0, x) for x >= 2.
  private def self.bessel_pzero(x : Float64) : Float64
    ix = bessel_ix(x)
    return 1.0 if ix >= 0x41b00000_i64
    return bessel_p_rational(x, BESSEL_P0_R8.to_unsafe, BESSEL_P0_S8.to_unsafe) if ix >= 0x40200000_i64
    return bessel_p_rational(x, BESSEL_P0_R5.to_unsafe, BESSEL_P0_S5.to_unsafe) if ix >= 0x40122E8B_i64
    return bessel_p_rational(x, BESSEL_P0_R3.to_unsafe, BESSEL_P0_S3.to_unsafe) if ix >= 0x4006DB6D_i64
    bessel_p_rational(x, BESSEL_P0_R2.to_unsafe, BESSEL_P0_S2.to_unsafe)
  end

  # Q(0, x) for x >= 2.
  private def self.bessel_qzero(x : Float64) : Float64
    ix = bessel_ix(x)
    return -0.125 / x if ix >= 0x41b00000_i64
    if ix >= 0x40200000_i64
      r = bessel_q_rational(x, BESSEL_Q0_R8.to_unsafe, BESSEL_Q0_S8.to_unsafe)
    elsif ix >= 0x40122E8B_i64
      r = bessel_q_rational(x, BESSEL_Q0_R5.to_unsafe, BESSEL_Q0_S5.to_unsafe)
    elsif ix >= 0x4006DB6D_i64
      r = bessel_q_rational(x, BESSEL_Q0_R3.to_unsafe, BESSEL_Q0_S3.to_unsafe)
    else
      r = bessel_q_rational(x, BESSEL_Q0_R2.to_unsafe, BESSEL_Q0_S2.to_unsafe)
    end
    (-0.125 + r) / x
  end

  # P(1, x) for x >= 2.
  private def self.bessel_pone(x : Float64) : Float64
    ix = bessel_ix(x)
    return 1.0 if ix >= 0x41b00000_i64
    return bessel_p_rational(x, BESSEL_P1_R8.to_unsafe, BESSEL_P1_S8.to_unsafe) if ix >= 0x40200000_i64
    return bessel_p_rational(x, BESSEL_P1_R5.to_unsafe, BESSEL_P1_S5.to_unsafe) if ix >= 0x40122E8B_i64
    return bessel_p_rational(x, BESSEL_P1_R3.to_unsafe, BESSEL_P1_S3.to_unsafe) if ix >= 0x4006DB6D_i64
    bessel_p_rational(x, BESSEL_P1_R2.to_unsafe, BESSEL_P1_S2.to_unsafe)
  end

  # Q(1, x) for x >= 2.
  private def self.bessel_qone(x : Float64) : Float64
    ix = bessel_ix(x)
    return 0.375 / x if ix >= 0x41b00000_i64
    if ix >= 0x40200000_i64
      r = bessel_q_rational(x, BESSEL_Q1_R8.to_unsafe, BESSEL_Q1_S8.to_unsafe)
    elsif ix >= 0x40122E8B_i64
      r = bessel_q_rational(x, BESSEL_Q1_R5.to_unsafe, BESSEL_Q1_S5.to_unsafe)
    elsif ix >= 0x4006DB6D_i64
      r = bessel_q_rational(x, BESSEL_Q1_R3.to_unsafe, BESSEL_Q1_S3.to_unsafe)
    else
      r = bessel_q_rational(x, BESSEL_Q1_R2.to_unsafe, BESSEL_Q1_S2.to_unsafe)
    end
    (0.375 + r) / x
  end

  # Order 0 for x >= 2: {sin x - cos x, sin x + cos x}, the one that cancels
  # recomputed as -cos(2x) over the other (x + x finite).
  private def self.bessel_phase0(x : Float64, ix : Int64) : {Float64, Float64}
    s = sin(x)
    c = cos(x)
    ss = s - c
    cc = s + c
    if ix < 0x7fe00000_i64
      z = cos(x + x) * -1.0
      if s * c < 0.0
        cc = z / ss
      else
        ss = z / cc
      end
    end
    {ss, cc}
  end

  # Order 1 for x >= 2: {-sin x - cos x, sin x - cos x}, likewise.
  private def self.bessel_phase1(x : Float64, ix : Int64) : {Float64, Float64}
    s = sin(x)
    c = cos(x)
    ss = s * -1.0 - c
    cc = s - c
    if ix < 0x7fe00000_i64
      z = cos(x + x)
      if s * c > 0.0
        cc = z / ss
      else
        ss = z / cc
      end
    end
    {ss, cc}
  end

  # jn and yn for x > 2^302: invsqrtpi * (the sin/cos combination n & 3
  # picks) / sqrt(x), `jn` choosing J's column and otherwise Y's.
  private def self.bessel_huge(n : Int32, x : Float64, jn : Bool) : Float64
    s = sin(x)
    c = cos(x)
    case n & 3
    when 0
      temp = jn ? c + s : s - c
    when 1
      temp = jn ? c * -1.0 + s : s * -1.0 - c
    when 2
      temp = jn ? c * -1.0 - s : s * -1.0 + c
    else
      temp = jn ? c - s : s + c
    end
    BESSEL_INVSQRTPI * temp / sqrt(x)
  end

  # __ieee754_jn for x < n, x not tiny: backward recurrence from the
  # continued fraction for J(n, x)/J(n - 1, x), normalised by j0 or j1.
  private def self.bessel_jn_backward(n : Int32, x : Float64) : Float64
    w = (n &+ n).to_f64 / x
    h = 2.0 / x
    q0 = w
    z = w + h
    q1 = w * z - 1.0
    k = 1
    while q1 < 1.0e9
      k &+= 1
      z += h
      tmp = z * q1 - q0
      q0 = q1
      q1 = tmp
    end
    m = n &+ n
    t = 0.0
    i = 2 &* (n &+ k)
    while i >= m
      t = 1.0 / (i.to_f64 / x - t)
      i &-= 2
    end
    a = t
    b = 1.0
    tmp = n.to_f64
    v = 2.0 / x
    tmp = tmp * log((v * tmp).abs)
    scale = !(tmp < 7.09782712893383973096e+02)
    i = n &- 1
    di = (i &+ i).to_f64
    while i > 0
      temp = b
      b *= di
      b = b / x - a
      a = temp
      di -= 2.0
      if scale && b > 1e100
        a /= b
        t /= b
        b = 1.0
      end
      i &-= 1
    end
    z = besselj0(x)
    w = besselj1(x)
    if z.abs >= w.abs
      t * z / b
    else
      t * w / a
    end
  end

  # The Bessel function of the first kind of order 0, J0(*value*), as glibc
  # computes it.
  def self.besselj0(value : Float64) : Float64
    ix = bessel_ix(value)
    return 1.0 / (value * value) if ix >= 0x7ff00000_i64
    x = value.abs
    if ix >= 0x40000000_i64
      ss, cc = bessel_phase0(x, ix)
      return (BESSEL_INVSQRTPI * cc) / sqrt(x) if ix > 0x48000000_i64
      u = bessel_pzero(x)
      v = bessel_qzero(x)
      return BESSEL_INVSQRTPI * (u * cc - v * ss) / sqrt(x)
    end
    if ix < 0x3f200000_i64
      return 1.0 if ix < 0x3e400000_i64
      return 1.0 - 0.25 * x * x
    end
    r = BESSEL_J0_R.to_unsafe
    s = BESSEL_J0_S.to_unsafe
    z = x * x
    r1 = z * r[2]
    z2 = z * z
    r2 = r[3] + z * r[4]
    z4 = z2 * z2
    rr = r1 + z2 * r2 + z4 * r[5]
    s1 = 1.0 + z * s[1]
    s2 = s[2] + z * s[3]
    ss = s1 + z2 * s2 + z4 * s[4]
    return 1.0 + z * (-0.25 + (rr / ss)) if ix < 0x3FF00000_i64
    u = 0.5 * x
    (1.0 + u) * (1.0 - u) + z * (rr / ss)
  end

  # :ditto:
  def self.besselj0(value : Float32) : Float32
    besselj0(value.to_f64).to_f32
  end

  # :ditto:
  def self.besselj0(value : T) : Float64 forall T
    besselj0(value.to_f64)
  end

  # The Bessel function of the first kind of order 1, J1(*value*), as glibc
  # computes it.
  def self.besselj1(value : Float64) : Float64
    ix = bessel_ix(value)
    return 1.0 / value if ix >= 0x7ff00000_i64
    y = value.abs
    if ix >= 0x40000000_i64
      ss, cc = bessel_phase1(y, ix)
      if ix > 0x48000000_i64
        z = (BESSEL_INVSQRTPI * cc) / sqrt(y)
      else
        u = bessel_pone(y)
        v = bessel_qone(y)
        z = BESSEL_INVSQRTPI * (u * cc - v * ss) / sqrt(y)
      end
      return bessel_negative(value) ? z * -1.0 : z
    end
    return 0.5 * value if ix < 0x3e400000_i64
    x = value
    rc = BESSEL_J1_R.to_unsafe
    sc = BESSEL_J1_S.to_unsafe
    z = x * x
    r1 = z * rc[0]
    z2 = z * z
    r2 = rc[1] + z * rc[2]
    z4 = z2 * z2
    r = r1 + z2 * r2 + z4 * rc[3]
    r *= x
    s1 = 1.0 + z * sc[1]
    s2 = sc[2] + z * sc[3]
    s3 = sc[4] + z * sc[5]
    s = s1 + z2 * s2 + z4 * s3
    x * 0.5 + r / s
  end

  # :ditto:
  def self.besselj1(value : Float32) : Float32
    besselj1(value.to_f64).to_f32
  end

  # :ditto:
  def self.besselj1(value : T) : Float64 forall T
    besselj1(value.to_f64)
  end

  # The Bessel function of the second kind of order 0, Y0(*value*), as glibc
  # computes it: NaN for negative *value*, -infinity at zero.
  def self.bessely0(value : Float64) : Float64
    return IyiFloatText.from_bits(0x7ff8000000000000_u64) if value < 0.0
    ix = bessel_ix(value)
    return 1.0 / (value + value * value) if ix >= 0x7ff00000_i64
    return IyiFloatText.from_bits(0xfff0000000000000_u64) if value == 0.0
    x = value
    if ix >= 0x40000000_i64
      ss, cc = bessel_phase0(x, ix)
      return (BESSEL_INVSQRTPI * ss) / sqrt(x) if ix > 0x48000000_i64
      u = bessel_pzero(x)
      v = bessel_qzero(x)
      return BESSEL_INVSQRTPI * (u * ss + v * cc) / sqrt(x)
    end
    return BESSEL_Y0_U[0] + BESSEL_TPI * log(x) if ix <= 0x3e400000_i64
    uc = BESSEL_Y0_U.to_unsafe
    vc = BESSEL_Y0_V.to_unsafe
    z = x * x
    u1 = uc[0] + z * uc[1]
    z2 = z * z
    u2 = uc[2] + z * uc[3]
    z4 = z2 * z2
    u3 = uc[4] + z * uc[5]
    z6 = z4 * z2
    u = u1 + z2 * u2 + z4 * u3 + z6 * uc[6]
    v1 = 1.0 + z * vc[0]
    v2 = vc[1] + z * vc[2]
    v = v1 + z2 * v2 + z4 * vc[3]
    u / v + BESSEL_TPI * (besselj0(x) * log(x))
  end

  # :ditto:
  def self.bessely0(value : Float32) : Float32
    bessely0(value.to_f64).to_f32
  end

  # :ditto:
  def self.bessely0(value : T) : Float64 forall T
    bessely0(value.to_f64)
  end

  # The Bessel function of the second kind of order 1, Y1(*value*), as glibc
  # computes it: NaN for negative *value*, -infinity at zero.
  def self.bessely1(value : Float64) : Float64
    return IyiFloatText.from_bits(0x7ff8000000000000_u64) if value < 0.0
    ix = bessel_ix(value)
    return 1.0 / (value + value * value) if ix >= 0x7ff00000_i64
    return IyiFloatText.from_bits(0xfff0000000000000_u64) if value == 0.0
    x = value
    if ix >= 0x40000000_i64
      ss, cc = bessel_phase1(x, ix)
      return (BESSEL_INVSQRTPI * ss) / sqrt(x) if ix > 0x48000000_i64
      u = bessel_pone(x)
      v = bessel_qone(x)
      return BESSEL_INVSQRTPI * (u * ss + v * cc) / sqrt(x)
    end
    return (BESSEL_TPI * -1.0) / x if ix <= 0x3c900000_i64
    uc = BESSEL_Y1_U.to_unsafe
    vc = BESSEL_Y1_V.to_unsafe
    z = x * x
    u1 = uc[0] + z * uc[1]
    z2 = z * z
    u2 = uc[2] + z * uc[3]
    z4 = z2 * z2
    u = u1 + z2 * u2 + z4 * uc[4]
    v1 = 1.0 + z * vc[0]
    v2 = vc[1] + z * vc[2]
    v3 = vc[3] + z * vc[4]
    v = v1 + z2 * v2 + z4 * v3
    x * (u / v) + BESSEL_TPI * (besselj1(x) * log(x) - 1.0 / x)
  end

  # :ditto:
  def self.bessely1(value : Float32) : Float32
    bessely1(value.to_f64).to_f32
  end

  # :ditto:
  def self.bessely1(value : T) : Float64 forall T
    bessely1(value.to_f64)
  end

  # The Bessel function of the first kind of the given *order*,
  # Jn(*value*), as glibc computes it.
  def self.besselj(order : Int32, value : Float64) : Float64
    return value + value if value != value
    n = order
    x = value
    neg = bessel_negative(value)
    if n < 0
      n = 0 &- n
      x = x * -1.0
      neg = !neg
    end
    return besselj0(x) if n == 0
    return besselj1(x) if n == 1
    sgn = (n & 1) == 1 && neg
    x = x.abs
    ix = bessel_ix(x)
    return sgn ? -0.0 : 0.0 if (ix | bessel_lx(x)) == 0_i64 || ix >= 0x7ff00000_i64
    if n.to_f64 <= x
      if ix >= 0x52D00000_i64
        b = bessel_huge(n, x, true)
      else
        a = besselj0(x)
        b = besselj1(x)
        i = 1
        while i < n
          temp = b
          b = b * ((i &+ i).to_f64 / x) - a
          a = temp
          i &+= 1
        end
      end
    elsif ix < 0x3e100000_i64
      if n > 33
        b = 0.0
      else
        temp = x * 0.5
        b = temp
        a = 1.0
        i = 2
        while i <= n
          a *= i.to_f64
          b *= temp
          i &+= 1
        end
        b = b / a
      end
    else
      b = bessel_jn_backward(n, x)
    end
    sgn ? b * -1.0 : b
  end

  # :ditto:
  def self.besselj(order : Int32, value : Float32) : Float32
    besselj(order, value.to_f64).to_f32
  end

  # :ditto:
  def self.besselj(order : Int32, value : T) : Float64 forall T
    besselj(order, value.to_f64)
  end

  # The Bessel function of the second kind of the given *order*,
  # Yn(*value*), as glibc computes it: NaN for negative *value*, -infinity
  # at zero (+infinity for odd negative *order*).
  def self.bessely(order : Int32, value : Float64) : Float64
    return value + value if value != value
    return IyiFloatText.from_bits(0x7ff8000000000000_u64) if value < 0.0
    n = order
    sign = 1
    if n < 0
      n = 0 &- n
      sign = 1 &- ((n & 1) << 1)
    end
    # -inf, and +inf for an odd negative order (k_standard's case 12 tests
    # the order, which the wrapper passes as its x).
    return IyiFloatText.from_bits(sign > 0 ? 0xfff0000000000000_u64 : 0x7ff0000000000000_u64) if value == 0.0
    return bessely0(value) if n == 0
    return sign.to_f64 * bessely1(value) if n == 1
    x = value
    ix = bessel_ix(x)
    return 0.0 if ix == 0x7ff00000_i64
    if ix >= 0x52D00000_i64
      b = bessel_huge(n, x, false)
    else
      a = bessely0(x)
      b = bessely1(x)
      high = high_word(b)
      i = 1
      while i < n && high != 0xfff00000_i64
        temp = b
        b = ((i &+ i).to_f64 / x) * b - a
        high = high_word(b)
        a = temp
        i &+= 1
      end
    end
    sign > 0 ? b : b * -1.0
  end

  # :ditto:
  def self.bessely(order : Int32, value : Float32) : Float32
    bessely(order, value.to_f64).to_f32
  end

  # :ditto:
  def self.bessely(order : Int32, value : T) : Float64 forall T
    bessely(order, value.to_f64)
  end

  # Euclid on the non-positive side, where every magnitude fits, the
  # type's minimum included: gcd(-2147483648, 6) is 2. Only gcd(minimum,
  # 0), whose answer does not fit, overflows.
  def self.gcd(a : ::Int, b : ::Int) : ::Int
    x = a > 0 ? -a : a
    y = b > 0 ? -b : b
    while y != 0
      t = y
      y = x % y
      x = t
    end
    -x
  end

  def self.lcm(a : ::Int, b : ::Int) : ::Int
    return (a - a) if a == 0 || b == 0
    (a.abs // gcd(a, b)) * b.abs
  end

  # The largest r with r * r <= value, in the value's own type, by the
  # other library's bit-at-a-time method. A negative value panics, where
  # that library raises.
  def self.isqrt(value : ::Int) : ::Int
    raise "Input must be non-negative integer" if value < 0
    return value if value < 2
    res = value - value
    bit = (res + 1) << (res.leading_zeros_count - 2)
    bit = bit >> (value.leading_zeros_count & ~0x3)
    while bit != 0
      if value >= res + bit
        value = value - (res + bit)
        res = (res >> 1) + bit
      else
        res = res >> 1
      end
      bit = bit >> 2
    end
    res
  end

  # The least power of two not below v, 1 for v <= 1, in v's type; one
  # the type cannot hold panics "arithmetic overflow".
  def self.pw2ceil(v : ::Int) : ::Int
    one = v - v + 1
    return one if v <= 1
    power = one << ((v - v).leading_zeros_count - (v - 1).leading_zeros_count)
    raise "arithmetic overflow" if power < v
    power
  end

  # The exponent of value as an integer, as C's ilogb and glibc answer it:
  # a subnormal's true exponent, -2147483648 for zero and NaN, 2147483647
  # for an infinity.
  def self.ilogb(value : Float64) : Int32
    return -2147483648 if value == 0.0 || value != value
    return 2147483647 if value == 2.0 * value
    frexp(value)[1] - 1
  end

  def self.ilogb(value : Float32) : Int32
    ilogb(value.to_f64)
  end

  def self.ilogb(value : T) : Int32 forall T
    ilogb(value.to_f64)
  end

  # The exponent of value as a double: -inf for zero, +inf for an
  # infinity, NaN for NaN, as C's logb.
  def self.logb(value : Float64) : Float64
    return -1.0 / 0.0 if value == 0.0
    return value * value if value != value || value == 2.0 * value
    ilogb(value).to_f64
  end

  def self.logb(value : Float32) : Float32
    logb(value.to_f64).to_f32
  end

  def self.logb(value : T) : Float64 forall T
    logb(value.to_f64)
  end

  # value * 2^exp, rounded once: `ldexp` under C's other name.
  def self.scalbn(value : Float64, exp : Int32) : Float64
    ldexp(value, exp)
  end

  def self.scalbn(value : Float32, exp : Int32) : Float32
    ldexp(value.to_f64, exp).to_f32
  end

  def self.scalbn(value : T, exp : U) : Float64 forall T, U
    ldexp(value.to_f64, exp.to_i32)
  end

  # scalbn with an Int64 exponent: past the range an Int32 holds every
  # answer is zero or an infinity already, so the exponent is clamped.
  def self.scalbln(value : Float64, exp : Int64) : Float64
    ldexp(value, exp > 100000_i64 ? 100000 : (exp < -100000_i64 ? -100000 : exp.to_i32))
  end

  def self.scalbln(value : Float32, exp : Int64) : Float32
    scalbln(value.to_f64, exp).to_f32
  end

  def self.scalbln(value : T, exp : U) : Float64 forall T, U
    scalbln(value.to_f64, exp.to_i64)
  end
end
