# Regular expressions, RE2's contract, written in iyi.
#
# Linear time: a Thompson NFA run as a Pike VM, one pass over the text
# with a thread list in priority order, so a search costs the text's
# length times the pattern's and never more. Lookaround, backreferences,
# recursion, possessive quantifiers, inline flags and `\p{..}` classes
# are refused with a sentence — the first four are not regular, and the
# last two this engine does not have.
#
# Matches are leftmost-first, as RE2's and Python's are: `a|ab` on `ab`
# answers `a`, a greedy `*` takes what it can and a lazy `*?` what it
# must. The surface: `.` (any byte but newline), `^` `$` `\A` `\z`, `\b`
# `\B`, `\d` `\w` `\s` and their negations (ASCII), classes `[a-z]`
# `[^0-9\s]`, `\xHH`, `?` `*` `+` `{n}` `{n,}` `{n,m}` and their lazy
# forms, groups `( )` `(?: )` `(?<name> )` (none capture: a match is the
# whole of it). Bytes, not code points: a class holding a byte past
# ASCII is refused, while a literal `é` outside one matches its own
# bytes. `match?` is the whole string; `find` is the first match; `scan`
# every non-overlapping one; `split` and `replace` read those, and an
# empty match costs no text.

module std/regex

pub struct Regex
  @nfa : RxNfa

  def initialize(@nfa : RxNfa)
  end

  def self.compile(pattern : String) : Regex
    new(RxCompiler.new(pattern).compile)
  end

  def match?(text : String) : Bool
    !@nfa.full(text).nil?
  end

  def find(text : String) : String?
    span = @nfa.search_from(text, 0)
    return nil unless span
    text[span[0], span[1] - span[0]]
  end

  def scan(text : String) : Array(String)
    out = [] of String
    each_match(text) { |a, b| out << text[a, b - a] }
    out
  end

  def split(text : String) : Array(String)
    out = [] of String
    last = 0
    each_match(text) do |a, b|
      out << text[last, a - last]
      last = b
    end
    out << text[last, text.bytesize - last]
    out
  end

  # Every match replaced, into one buffer: `out = out + ...` copied all of
  # the text so far at each match, and eleven substitutions over a 60 MB
  # sequence with a million matches each did not finish.
  def replace(text : String, replacement : String) : String
    replace(text) { |match| replacement }
  end

  # Every match replaced by what the block answers for it — the per-match
  # substitution (`gsub(pattern, hash)` in the other library) that a fixed
  # replacement cannot say.
  def replace(text : String, & : String -> String) : String
    last = 0
    String.build(text.bytesize) do |io|
      each_match(text) do |a, b|
        io.write(text.to_unsafe + last, a - last)
        io << yield text[a, b - a]
        last = b
      end
      io.write(text.to_unsafe + last, text.bytesize - last)
    end
  end

  # Every non-overlapping match, leftmost first. After a full match the
  # search moves to its end; after an empty one it stays where it is but
  # may not answer empty there again, so a lazy pattern still gets to
  # take the byte — Python's rule, and the byte is never lost.
  private def each_match(text : String, & : Int32, Int32 -> Nil) : Nil
    pos = 0
    forbid = -1
    n = text.bytesize
    while pos <= n
      span = @nfa.search_from(text, pos, forbid)
      break unless span
      a = span[0]
      b = span[1]
      yield a, b
      if b > a
        pos = b
        forbid = -1
      else
        pos = a
        forbid = a
      end
    end
  end
end

# States: 0 a byte, 1 any but newline, 2 a class, 3 a split (out1 before
# out2), 4 the match, 5 `^`, 6 `$`, 7 `\b`, 8 `\B`.
class RxNfa
  getter kind : Array(Int32)
  getter ch : Array(UInt8)
  getter out1 : Array(Int32)
  getter out2 : Array(Int32)
  getter mask : Array(UInt8)
  property start : Int32
  getter count : Int32

  def initialize
    @kind = [] of Int32
    @ch = [] of UInt8
    @out1 = [] of Int32
    @out2 = [] of Int32
    @mask = [] of UInt8
    @start = 0
    @count = 0
  end

  def add(kind : Int32, ch : UInt8 = 0_u8) : Int32
    id = @count
    @kind << kind
    @ch << ch
    @out1 << -1
    @out2 << -1
    i = 0
    while i < 32
      @mask << 0_u8
      i = i + 1
    end
    @count = @count + 1
    id
  end

  def set_class(id : Int32, bits : Array(UInt8)) : Nil
    i = 0
    while i < 32
      @mask[id * 32 + i] = bits[i]
      i = i + 1
    end
  end

  def class_has?(id : Int32, b : UInt8) : Bool
    byte = @mask[id * 32 + (b.to_i32 >> 3)].to_i32
    (byte & (1 << (b.to_i32 & 7))) != 0
  end

  def patch(id : Int32, out1 : Int32, out2 : Int32 = -1) : Nil
    @out1[id] = out1
    @out2[id] = out2
  end

  # The leftmost-first match at or after `from`; an empty match at
  # `forbid` does not count.
  def search_from(text : String, from : Int32, forbid : Int32 = -1) : {Int32, Int32}?
    RxRun.new(self, text).search(from, false, forbid)
  end

  # A match of the whole text, or nil.
  def full(text : String) : {Int32, Int32}?
    RxRun.new(self, text).search(0, true, -1)
  end
end

# One pass of the Pike VM over one text. Two thread lists, each a state
# and the position its match began; a state joins a list once per step,
# and the first to reach it is the higher-priority thread, which is what
# makes the answer leftmost-first.
class RxRun
  @nfa : RxNfa
  @src : Pointer(UInt8)
  @n : Int32
  @cur_state : Pointer(Int32)
  @cur_start : Pointer(Int32)
  @cur_size : Int32
  @nxt_state : Pointer(Int32)
  @nxt_start : Pointer(Int32)
  @nxt_size : Int32
  @seen : Pointer(Int32)
  @gen : Int32

  def initialize(@nfa : RxNfa, text : String)
    @src = text.to_unsafe
    @n = text.bytesize
    count = @nfa.count.to_u64 + 1_u64
    @cur_state = Pointer(Int32).malloc(count)
    @cur_start = Pointer(Int32).malloc(count)
    @cur_size = 0
    @nxt_state = Pointer(Int32).malloc(count)
    @nxt_start = Pointer(Int32).malloc(count)
    @nxt_size = 0
    @seen = Pointer(Int32).malloc(count)
    i = 0
    while i < @nfa.count
      @seen[i] = 0
      i = i + 1
    end
    @gen = 0
  end

  # `whole`: anchored at `from`, and only a match reaching the text's end
  # counts. Otherwise a fresh thread starts at every position until some
  # thread has matched, after which only the threads ahead of it in
  # priority may still change the answer.
  def search(from : Int32, whole : Bool, forbid : Int32) : {Int32, Int32}?
    match_start = -1
    match_end = -1
    pos = from
    @gen = @gen + 1
    @cur_size = 0
    add(false, @nfa.start, pos, pos)
    while true
      @nxt_size = 0
      @gen = @gen + 1
      i = 0
      while i < @cur_size
        s = @cur_state[i]
        k = @nfa.kind[s]
        if k == 4
          if whole ? pos == @n : !(pos == forbid && @cur_start[i] == forbid)
            match_start = @cur_start[i]
            match_end = pos
            break
          end
        elsif pos < @n
          b = @src[pos]
          ok = if k == 0
                 @nfa.ch[s] == b
               elsif k == 1
                 b != 10_u8
               elsif k == 2
                 @nfa.class_has?(s, b)
               else
                 false
               end
          add(true, @nfa.out1[s], @cur_start[i], pos + 1) if ok
        end
        i = i + 1
      end
      break if pos >= @n
      pos = pos + 1
      add(true, @nfa.start, pos, pos) if match_start < 0 && !whole
      break if @nxt_size == 0 && (whole || match_start >= 0)
      tmp_state = @cur_state
      @cur_state = @nxt_state
      @nxt_state = tmp_state
      tmp_start = @cur_start
      @cur_start = @nxt_start
      @nxt_start = tmp_start
      @cur_size = @nxt_size
    end
    return nil if match_start < 0
    {match_start, match_end}
  end

  # The epsilon closure of `s`, in priority order: out1 before out2. Into
  # the next list when `nxt`, else the current one.
  private def add(nxt : Bool, s : Int32, start : Int32, pos : Int32) : Nil
    return if s < 0 || @seen[s] == @gen
    @seen[s] = @gen
    k = @nfa.kind[s]
    if k == 3
      add(nxt, @nfa.out1[s], start, pos)
      add(nxt, @nfa.out2[s], start, pos)
    elsif k == 5
      add(nxt, @nfa.out1[s], start, pos) if pos == 0
    elsif k == 6
      add(nxt, @nfa.out1[s], start, pos) if pos == @n
    elsif k == 7
      add(nxt, @nfa.out1[s], start, pos) if boundary?(pos)
    elsif k == 8
      add(nxt, @nfa.out1[s], start, pos) unless boundary?(pos)
    elsif nxt
      @nxt_state[@nxt_size] = s
      @nxt_start[@nxt_size] = start
      @nxt_size = @nxt_size + 1
    else
      @cur_state[@cur_size] = s
      @cur_start[@cur_size] = start
      @cur_size = @cur_size + 1
    end
  end

  private def boundary?(pos : Int32) : Bool
    before = pos > 0 && RxCompiler.word?(@src[pos - 1])
    after = pos < @n && RxCompiler.word?(@src[pos])
    before != after
  end
end

class RxCompiler
  @pat : String
  @src : Pointer(UInt8)
  @n : Int32
  @i : Int32
  @nfa : RxNfa
  @depth : Int32

  def initialize(pattern : String)
    @pat = pattern
    @src = pattern.to_unsafe
    @n = pattern.bytesize
    @i = 0
    @nfa = RxNfa.new
    @depth = 0
  end

  def compile : RxNfa
    frag = parse_alt
    raise "regex: unmatched ')' in /#{@pat}/" if @i < @n && peek == 41_u8
    raise "regex: unexpected byte in /#{@pat}/" if @i < @n
    match = @nfa.add(4)
    patch_outs(frag, match)
    @nfa.start = frag[0]
    @nfa
  end

  # A fragment: its first state, and the states whose next out is still
  # to be patched.
  private def parse_alt : {Int32, Array(Int32)}
    left = parse_concat
    while @i < @n && peek == 124_u8 # |
      @i = @i + 1
      right = parse_concat
      split = @nfa.add(3)
      @nfa.patch(split, left[0], right[0])
      outs = left[1]
      right[1].each { |o| outs << o }
      left = {split, outs}
    end
    left
  end

  private def parse_concat : {Int32, Array(Int32)}
    return empty_fragment if @i >= @n || peek == 124_u8 || peek == 41_u8
    left = parse_repeat
    while @i < @n && peek != 124_u8 && peek != 41_u8
      right = parse_repeat
      patch_outs(left, right[0])
      left = {left[0], right[1]}
    end
    left
  end

  # An empty alternative or group matches nothing at all, which is legal.
  private def empty_fragment : {Int32, Array(Int32)}
    s = @nfa.add(3)
    {s, [s]}
  end

  private def parse_repeat : {Int32, Array(Int32)}
    atom_at = @i
    atom = parse_atom
    atom_end = @i
    return atom if @i >= @n
    q = peek
    if q == 42_u8 || q == 43_u8 || q == 63_u8
      @i = @i + 1
      lazy = lazy_mark
      if q == 42_u8 # *
        star(atom, lazy)
      elsif q == 43_u8 # +
        plus(atom, lazy)
      else # ?
        optional(atom, lazy)
      end
    elsif q == 123_u8 # {
      counted(atom, atom_at, atom_end)
    else
      atom
    end
  end

  # `?` after a quantifier makes it lazy; `+` would make it possessive,
  # which is a backtracker's control and refused.
  private def lazy_mark : Bool
    if @i < @n && peek == 63_u8
      @i = @i + 1
      true
    elsif @i < @n && peek == 43_u8
      raise "regex: possessive quantifiers are refused in /#{@pat}/"
    else
      false
    end
  end

  private def star(atom : {Int32, Array(Int32)}, lazy : Bool) : {Int32, Array(Int32)}
    split = @nfa.add(3)
    if lazy
      @nfa.patch(split, -1, atom[0])
    else
      @nfa.patch(split, atom[0], -1)
    end
    patch_outs(atom, split)
    {split, [split]}
  end

  private def plus(atom : {Int32, Array(Int32)}, lazy : Bool) : {Int32, Array(Int32)}
    split = @nfa.add(3)
    if lazy
      @nfa.patch(split, -1, atom[0])
    else
      @nfa.patch(split, atom[0], -1)
    end
    patch_outs(atom, split)
    {atom[0], [split]}
  end

  private def optional(atom : {Int32, Array(Int32)}, lazy : Bool) : {Int32, Array(Int32)}
    split = @nfa.add(3)
    if lazy
      @nfa.patch(split, -1, atom[0])
    else
      @nfa.patch(split, atom[0], -1)
    end
    outs = atom[1]
    outs << split
    {split, outs}
  end

  # `{n}`, `{n,}`, `{n,m}`: the atom is parsed again for every copy, so
  # each copy has states of its own. A `{` that is not one of those three
  # shapes is the literal byte, as RE2 and Python read it.
  private def counted(atom : {Int32, Array(Int32)}, atom_at : Int32, atom_end : Int32) : {Int32, Array(Int32)}
    save = @i
    @i = @i + 1
    lo = digits
    hi = lo
    unbounded = false
    if lo >= 0 && @i < @n && peek == 44_u8 # ,
      @i = @i + 1
      hi = digits
      unbounded = hi < 0
    end
    unless lo >= 0 && @i < @n && peek == 125_u8 # }
      @i = save
      return atom
    end
    @i = @i + 1
    raise "regex: repeat range out of order in /#{@pat}/" if !unbounded && hi < lo
    raise "regex: repeat count past 1000 in /#{@pat}/" if lo > 1000 || hi > 1000
    lazy = lazy_mark
    after = @i
    copies = unbounded ? lo + 1 : hi
    frag = empty_fragment
    c = 0
    while c < copies
      @i = atom_at
      piece = parse_atom
      @i = after
      if c >= lo
        if unbounded
          piece = star(piece, lazy)
        else
          piece = optional(piece, lazy)
        end
      end
      patch_outs(frag, piece[0])
      frag = {frag[0], piece[1]}
      c = c + 1
    end
    @i = after
    frag
  end

  private def digits : Int32
    return -1 unless @i < @n && peek >= 48_u8 && peek <= 57_u8
    value = 0
    while @i < @n && peek >= 48_u8 && peek <= 57_u8
      value = value * 10 + (peek - 48_u8).to_i32
      value = 100000 if value > 100000
      @i = @i + 1
    end
    value
  end

  private def parse_atom : {Int32, Array(Int32)}
    raise "regex: unexpected end of /#{@pat}/" if @i >= @n
    b = peek
    if b == 46_u8 # .
      @i = @i + 1
      single(@nfa.add(1))
    elsif b == 94_u8 # ^
      @i = @i + 1
      single(@nfa.add(5))
    elsif b == 36_u8 # $
      @i = @i + 1
      single(@nfa.add(6))
    elsif b == 40_u8 # (
      parse_group
    elsif b == 41_u8
      raise "regex: unmatched ')' in /#{@pat}/"
    elsif b == 91_u8 # [
      parse_class
    elsif b == 92_u8
      parse_escape
    elsif b == 42_u8 || b == 43_u8 || b == 63_u8
      raise "regex: nothing to repeat in /#{@pat}/"
    else
      @i = @i + 1
      single(@nfa.add(0, b))
    end
  end

  private def parse_group : {Int32, Array(Int32)}
    @i = @i + 1
    raise "regex: unmatched '(' in /#{@pat}/" if @i >= @n
    if peek == 63_u8 # (?
      @i = @i + 1
      raise "regex: unmatched '(' in /#{@pat}/" if @i >= @n
      m = peek
      if m == 58_u8 # (?:
        @i = @i + 1
      elsif m == 61_u8 || m == 33_u8 # (?= (?!
        raise "regex: lookaround is refused in /#{@pat}/"
      elsif m == 60_u8 || m == 80_u8 # (?< (?P
        @i = @i + 1
        if m == 80_u8
          raise "regex: unmatched '(' in /#{@pat}/" if @i >= @n
          raise "regex: not a group name in /#{@pat}/" unless peek == 60_u8
          @i = @i + 1
        end
        raise "regex: unmatched '(' in /#{@pat}/" if @i >= @n
        if peek == 61_u8 || peek == 33_u8
          raise "regex: lookaround is refused in /#{@pat}/"
        end
        while @i < @n && peek != 62_u8
          raise "regex: not a group name in /#{@pat}/" unless RxCompiler.word?(peek)
          @i = @i + 1
        end
        raise "regex: unterminated group name in /#{@pat}/" if @i >= @n
        @i = @i + 1
      elsif m == 82_u8 || m == 40_u8 # (?R (?(
        raise "regex: recursion is refused in /#{@pat}/"
      elsif m == 62_u8 # (?>
        raise "regex: atomic groups are refused in /#{@pat}/"
      else
        raise "regex: inline flags are refused in /#{@pat}/"
      end
    end
    @depth = @depth + 1
    raise "regex: groups nested past 1000 in /#{@pat}/" if @depth > 1000
    inner = parse_alt
    @depth = @depth - 1
    raise "regex: unmatched '(' in /#{@pat}/" unless @i < @n && peek == 41_u8
    @i = @i + 1
    inner
  end

  private def parse_escape : {Int32, Array(Int32)}
    @i = @i + 1
    raise "regex: trailing '\\' in /#{@pat}/" if @i >= @n
    b = peek
    @i = @i + 1
    if b >= 49_u8 && b <= 57_u8
      raise "regex: backreferences are refused in /#{@pat}/"
    elsif b == 100_u8 # \d
      class_from(false) { |c| RxCompiler.digit?(c) }
    elsif b == 68_u8
      class_from(true) { |c| RxCompiler.digit?(c) }
    elsif b == 119_u8 # \w
      class_from(false) { |c| RxCompiler.word?(c) }
    elsif b == 87_u8
      class_from(true) { |c| RxCompiler.word?(c) }
    elsif b == 115_u8 # \s
      class_from(false) { |c| RxCompiler.space?(c) }
    elsif b == 83_u8
      class_from(true) { |c| RxCompiler.space?(c) }
    elsif b == 98_u8 # \b
      single(@nfa.add(7))
    elsif b == 66_u8 # \B
      single(@nfa.add(8))
    elsif b == 65_u8 # \A
      single(@nfa.add(5))
    elsif b == 122_u8 || b == 90_u8 # \z \Z
      single(@nfa.add(6))
    elsif b == 112_u8 || b == 80_u8 # \p \P
      raise "regex: \\p classes are refused in /#{@pat}/ (this engine matches bytes)"
    else
      single(@nfa.add(0, escaped_byte(b)))
    end
  end

  # The byte an escape stands for, outside `\d\w\s\b` and their kin: the
  # C escapes, `\xHH`, and any punctuation as itself. A letter or digit
  # with no meaning is refused rather than read as the letter.
  private def escaped_byte(b : UInt8) : UInt8
    return 10_u8 if b == 110_u8 # \n
    return 9_u8 if b == 116_u8  # \t
    return 13_u8 if b == 114_u8 # \r
    return 12_u8 if b == 102_u8 # \f
    return 11_u8 if b == 118_u8 # \v
    return 0_u8 if b == 48_u8   # \0
    return 27_u8 if b == 101_u8 # \e
    return 7_u8 if b == 97_u8   # \a
    if b == 120_u8              # \xHH
      hi = hex_digit
      lo = hex_digit
      return (hi * 16 + lo).to_u8
    end
    if RxCompiler.word?(b)
      raise "regex: unknown escape '\\#{b.unsafe_chr}' in /#{@pat}/"
    end
    b
  end

  private def hex_digit : Int32
    raise "regex: \\x needs two hex digits in /#{@pat}/" if @i >= @n
    c = peek
    @i = @i + 1
    return (c - 48_u8).to_i32 if c >= 48_u8 && c <= 57_u8
    return (c - 87_u8).to_i32 if c >= 97_u8 && c <= 102_u8
    return (c - 55_u8).to_i32 if c >= 65_u8 && c <= 70_u8
    raise "regex: \\x needs two hex digits in /#{@pat}/"
  end

  private def parse_class : {Int32, Array(Int32)}
    @i = @i + 1
    raise "regex: unterminated class in /#{@pat}/" if @i >= @n
    neg = false
    if peek == 94_u8
      neg = true
      @i = @i + 1
    end
    bits = Array(UInt8).new(32) { 0_u8 }
    first = true
    while @i < @n && (peek != 93_u8 || first)
      first = false
      lo = class_atom(bits)
      if lo >= 0 && @i + 1 < @n && peek == 45_u8 && @src[@i + 1] != 93_u8
        @i = @i + 1
        hi = class_atom(bits)
        raise "regex: a class cannot end a range in /#{@pat}/" if hi < 0
        raise "regex: range out of order in /#{@pat}/" if hi < lo
        c = lo
        while c <= hi
          set_bit(bits, c.to_u8)
          c = c + 1
        end
      elsif lo < 0 && @i + 1 < @n && peek == 45_u8 && @src[@i + 1] != 93_u8
        raise "regex: a class cannot start a range in /#{@pat}/"
      elsif lo >= 0
        set_bit(bits, lo.to_u8)
      end
    end
    raise "regex: unterminated class in /#{@pat}/" unless @i < @n && peek == 93_u8
    @i = @i + 1
    if neg
      i = 0
      while i < 32
        bits[i] = bits[i] ^ 255_u8
        i = i + 1
      end
    end
    s = @nfa.add(2)
    @nfa.set_class(s, bits)
    single(s)
  end

  # One member of a class: a byte, answered; or `\d` `\w` `\s` and their
  # negations, merged into `bits` and answered as -1, so a range cannot
  # be made of them.
  private def class_atom(bits : Array(UInt8)) : Int32
    if peek == 92_u8
      @i = @i + 1
      raise "regex: trailing '\\' in /#{@pat}/" if @i >= @n
      b = peek
      @i = @i + 1
      if b == 100_u8 || b == 68_u8 || b == 119_u8 || b == 87_u8 || b == 115_u8 || b == 83_u8
        neg = b == 68_u8 || b == 87_u8 || b == 83_u8
        c = 0
        while c < 256
          u = c.to_u8
          hit = if b == 100_u8 || b == 68_u8
                  RxCompiler.digit?(u)
                elsif b == 119_u8 || b == 87_u8
                  RxCompiler.word?(u)
                else
                  RxCompiler.space?(u)
                end
          hit = !hit if neg
          set_bit(bits, u) if hit
          c = c + 1
        end
        return -1
      end
      if b == 112_u8 || b == 80_u8
        raise "regex: \\p classes are refused in /#{@pat}/ (this engine matches bytes)"
      end
      if b == 98_u8
        return 8 # \b in a class is backspace, as in Python
      end
      return escaped_byte(b).to_i32
    end
    b = peek
    @i = @i + 1
    raise "regex: a class holding a byte past ASCII is refused in /#{@pat}/ (classes are bytes; a literal outside one matches its own)" if b >= 128_u8
    b.to_i32
  end

  private def class_from(neg : Bool, & : UInt8 -> Bool) : {Int32, Array(Int32)}
    bits = Array(UInt8).new(32) { 0_u8 }
    c = 0
    while c < 256
      u = c.to_u8
      hit = yield u
      hit = !hit if neg
      set_bit(bits, u) if hit
      c = c + 1
    end
    s = @nfa.add(2)
    @nfa.set_class(s, bits)
    single(s)
  end

  private def single(s : Int32) : {Int32, Array(Int32)}
    {s, [s]}
  end

  private def set_bit(bits : Array(UInt8), b : UInt8) : Nil
    i = b.to_i32 >> 3
    bits[i] = (bits[i].to_i32 | (1 << (b.to_i32 & 7))).to_u8
  end

  def self.digit?(c : UInt8) : Bool
    c >= 48_u8 && c <= 57_u8
  end

  def self.word?(c : UInt8) : Bool
    (c >= 48_u8 && c <= 57_u8) || (c >= 65_u8 && c <= 90_u8) || (c >= 97_u8 && c <= 122_u8) || c == 95_u8
  end

  def self.space?(c : UInt8) : Bool
    c == 32_u8 || c == 9_u8 || c == 10_u8 || c == 13_u8 || c == 12_u8 || c == 11_u8
  end

  private def peek : UInt8
    @src[@i]
  end

  private def patch_outs(frag : {Int32, Array(Int32)}, target : Int32) : Nil
    frag[1].each do |s|
      if @nfa.out1[s] < 0
        @nfa.out1[s] = target
      elsif @nfa.out2[s] < 0
        @nfa.out2[s] = target
      end
    end
  end
end
