module std/enum

import std/traits
using std/traits::{Cmp}

# Enum is the base type of all enums.
struct ::Enum
  def to_i : Int32
    value.to_i32
  end

  def to_i8 : Int8
    value.to_i8
  end

  def to_i16 : Int16
    value.to_i16
  end

  def to_i32 : Int32
    value.to_i32
  end

  def to_i64 : Int64
    value.to_i64
  end

  def to_u8 : UInt8
    value.to_u8
  end

  def to_u16 : UInt16
    value.to_u16
  end

  def to_u32 : UInt32
    value.to_u32
  end

  def to_u64 : UInt64
    value.to_u64
  end

  def to_f32 : Float32
    value.to_f32
  end

  def to_f64 : Float64
    value.to_f64
  end

  def +(other : Int) : self
    self.class.new(value + other)
  end

  def -(other : Int) : self
    self.class.new(value - other)
  end

  def ^(other : self) : self
    self.class.new(value ^ other.value)
  end

  def ~ : self
    self.class.new(~value)
  end

  def <=>(other : self) : Int32
    v1 = value
    v2 = other.value
    v1 < v2 ? -1 : (v1 > v2 ? 1 : 0)
  end

  def clone : self
    self
  end

  def to_s(io : IyiIO) : ::Nil
    io.print(to_s)
  end

  def inspect(io : IyiIO) : ::Nil
    io.print(inspect)
  end

  def self.from_value(val : Int) : self
    from_value?(val.to_i) || raise "Unknown enum value: #{val}"
  end

  def self.valid?(val : self) : ::Bool
    !from_value?(val.value.to_i).nil?
  end

  def self.parse(string : String) : self
    parse?(string) || raise "Unknown enum name: #{string}"
  end

  def self.each(& : self -> ::Nil) : ::Nil
    {% for member in @type.constants %}
      yield new({{@type.constant(member)}})
    {% end %}
  end
end
