; iyi-ir 1
source_filename = "escape_headed_bytes"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @headed_bytes(i64 %tid) {
entry:
  %0 = alloca [16 x i8], align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 16, i1 false)
  %1 = getelementptr i8, ptr %0, i64 8
  %2 = shl i64 %tid, 32
  store i64 %2, ptr %0, align 8
  %value = load i64, ptr %1, align 8
  ret i64 %value
}
