# The hosted compiler copies this non-generic ancestor's default into a late
# generic instance and executes it twice. The port deliberately executes it
# once per allocation, as in ivar_initializer_early.iyi.
class Count
  @@n : Int32 = 0

  def self.tick : Int32
    @@n = @@n + 1
  end

  def self.value : Int32
    @@n
  end
end

class Base
  @value : Int32 = Count.tick
  getter value
end

class Child(T) < Base
  @marker : T? = nil
end

child = Child(Int32).new
puts "value=#{child.value},count=#{Count.value}"
raise "initializer did not run once per allocation" unless child.value == 1 && Count.value == 1
