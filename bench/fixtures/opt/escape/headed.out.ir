; iyi-ir 1
source_filename = "escape_headed"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Point = type { i64, ptr }
@"__iyi_gc_layouts:table" = internal constant [7 x i64] [ i64 1, i64 7, i64 16, i64 16, i64 1, i64 0, i64 8 ]
@__iyi_gc_layouts = internal constant ptr @"__iyi_gc_layouts:table"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i32 @headed(i64 %tid, ptr %heap) {
entry:
  %0 = alloca { i64, %Point }, align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 24, i1 false)
  %1 = getelementptr { i64, %Point }, ptr %0, i64 0, i32 0
  %2 = getelementptr { i64, %Point }, ptr %0, i64 0, i32 1
  %3 = shl i64 7, 32
  store i64 %3, ptr %1, align 8
  %field = getelementptr %Point, ptr %2, i64 0, i32 1
  store ptr %heap, ptr %field, align 8
  %type_address = getelementptr i8, ptr %2, i64 -4
  %type_id = load i32, ptr %type_address, align 4
  ret i32 %type_id
}
