; iyi-ir 1
source_filename = "overflow_edge_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @overflow_edge_keep(i32 %n, ptr %out) {
entry:
  br label %head
head:
  %i = phi i32 [ 0, label %entry ], [ %next, label %latch ]
  %more = icmp slt i32 %i, %n
  br i1 %more, label %body, label %done
body:
  %negative = icmp slt i32 %i, 0
  store i1 %negative, ptr %out, align 1
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %i, i32 2)
  %next = extractvalue { i32, i1 } %pair, 0
  %overflow = extractvalue { i32, i1 } %pair, 1
  br i1 %overflow, label %latch, label %done
latch:
  br label %head
done:
  ret void
}
