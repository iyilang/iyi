pub class StringInterpolation < ASTNode
  property expressions : Array(ASTNode)
  property heredoc_indent : Int32

  def initialize(@expressions : Array(ASTNode) = [] of ASTNode, @heredoc_indent : Int32 = 0)
  end

  def clone_without_location : self
    StringInterpolation.new(clone_nodes(@expressions), @heredoc_indent)
  end

  def accept_children(visitor) : Nil
    @expressions.each { |e| e.accept(visitor) }
  end

  def ==(other : self) : Bool
    (@expressions == other.expressions) && (@heredoc_indent == other.heredoc_indent)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@expressions)
    h = 31 &* h &+ hash_val(@heredoc_indent)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << '"'
    @expressions.each do |e|
      if e.is_a?(StringLiteral)
        sb << e.value
      else
        sb << "#{"
        e.to_s(sb)
        sb << "}"
      end
    end
    sb << '"'
  end
end

