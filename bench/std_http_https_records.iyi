# One check's line, *label* and what was found; and when it is not
# *wanted*, a FAIL line naming the check, what was found and what should
# have been.
def check(label : String, got : String, wanted : String, failures : Array(String)) : Nil
  puts "#{label}: #{got}"
  return if got == wanted
  puts "FAIL #{label}: #{got}, not #{wanted}"
  failures << label
end

# *text* with every *from* in it written *to*.
def replaced(text : String, from : String, to : String) : String
  buf = String::Builder.new
  at = 0
  while at < text.bytesize
    if at + from.bytesize <= text.bytesize && text[at, from.bytesize] == from
      buf << to
      at = at + from.bytesize
    else
      buf.write_byte(text.to_unsafe[at])
      at = at + 1
    end
  end
  buf.to_s
end

# A name as the wire writes it.
def wire_name(name : String) : Array(UInt8)
  buf = [] of UInt8
  name.split('.').each do |label|
    next if label.empty?
    buf << label.bytesize.to_u8
    index = 0
    while index < label.bytesize
      buf << label.to_unsafe[index]
      index = index + 1
    end
  end
  buf << 0_u8
  buf
end

def push16(buf : Array(UInt8), value : Int32) : Nil
  buf << ((value >> 8) & 255).to_u8
  buf << (value & 255).to_u8
end

# An HTTPS record's data: *priority*, *target* ("." for the root), and
# *params*, each a key and its value, in increasing order of key.
def https_data(priority : Int32, target : String, params : Array({Int32, Array(UInt8)}) = [] of {Int32, Array(UInt8)}) : Array(UInt8)
  buf = [] of UInt8
  push16(buf, priority)
  (target == "." ? [0_u8] : wire_name(target)).each { |byte| buf << byte }
  params.each do |param|
    push16(buf, param[0])
    push16(buf, param[1].size)
    param[1].each { |byte| buf << byte }
  end
  buf
end

def port_param(port : Int32) : {Int32, Array(UInt8)}
  value = [] of UInt8
  push16(value, port)
  {3, value}
end

def alpn_param(ids : Array(String)) : {Int32, Array(UInt8)}
  value = [] of UInt8
  ids.each do |id|
    value << id.bytesize.to_u8
    index = 0
    while index < id.bytesize
      value << id.to_unsafe[index]
      index = index + 1
    end
  end
  {1, value}
end

def ech_param(list : Array(UInt8)) : {Int32, Array(UInt8)}
  {5, list}
end

NO_DEFAULT_ALPN = {2, [] of UInt8}

# The zone this program serves, which each check sets: the HTTPS records
# of a name, the names with an A record (127.0.0.1), the names whose HTTPS
# question is answered SERVFAIL; and every question asked, "name/TYPE".
class Zone
  getter https = {} of String => Array(Array(UInt8))
  getter addressed = [] of String
  getter failing = [] of String
  getter asked = [] of String

  # The answer to *query*: its header and question, and the records -
  # nothing past them, though an encrypted resolver's query carries an
  # OPT record. Nil for one that does not read.
  def answer(query : Bytes) : Bytes?
    parsed = DnsMessage.parse(query)
    return nil unless parsed.is_a?(DnsMessage)
    question = DnsMessage.read_name(query, 12)
    return nil if question.nil?
    name = parsed.question_name.downcase
    type = parsed.question_type
    @asked << "#{name}/#{type == DnsRecord::A ? "A" : (type == DnsRecord::AAAA ? "AAAA" : (type == DnsRecord::HTTPS ? "HTTPS" : type.to_s))}"
    records = [] of Array(UInt8)
    rcode = 0
    if type == DnsRecord::HTTPS
      rcode = 2 if @failing.includes?(name)
      records = @https[name]? || records
    elsif type == DnsRecord::A && @addressed.includes?(name)
      records = [[127_u8, 0_u8, 0_u8, 1_u8]]
    end
    records = [] of Array(UInt8) unless rcode == 0
    buf = [] of UInt8
    buf << query[0]
    buf << query[1]
    push16(buf, 0x8180 | rcode)
    push16(buf, 1)
    push16(buf, records.size)
    push16(buf, 0)
    push16(buf, 0)
    index = 12
    while index < question[1] + 4
      buf << query[index]
      index = index + 1
    end
    records.each do |data|
      buf << 0xC0_u8
      buf << 12_u8
      push16(buf, type)
      push16(buf, 1)
      push16(buf, 0)
      push16(buf, 60)
      push16(buf, data.size)
      data.each { |byte| buf << byte }
    end
    bytes = Bytes.new(buf.size)
    buf.each_with_index { |byte, at| bytes[at] = byte }
    bytes
  end
end

# The zone's answers as an encrypted upstream brings them: what
# std/secure_dns's DNS over TLS and over HTTPS hand the resolver.
class LocalUpstream
  def initialize(@zone : Zone)
  end

  def label : String
    "this program's upstream"
  end

  def zero_id? : Bool
    false
  end

  def exchange(queries : Array(Bytes), timeout_ms : Int32) : Array(Bytes) | DnsError | Cancelled
    queries.map { |query| @zone.answer(query) || Bytes.new(0) }
  end

  def close : Nil
  end
end

impl DnsUpstream for LocalUpstream
end

# What the TLS server saw, and how it is to answer: the configurations the
# next connections are made under, in turn, before its own; the protocols
# the last ClientHello offered; and how many connections it took.
class Seen
  property plans = [] of TlsServerConfig
  property offered = "-"
  property connections = 0
end

# One connection to the TLS server listening as *id*: the handshake under
# the next of *seen*'s plans, or *config*, then each request answered with
# what the server saw, until the client closes.
def serve_one(socket : IyiSocket, id : Int32, config : TlsServerConfig, seen : Seen) : Nil
  seen.connections = seen.connections + 1
  under = seen.plans.shift? || config
  conn = TlsServer.over(socket, under, 5000, early_data: false)
  if conn.is_a?(TlsError)
    socket.close
    return
  end
  # This connection's ClientHello's, read before the next one's.
  offered = seen.offered
  held = ""
  while true
    got = conn.read
    break if got.is_a?(TlsError) || got.empty?
    held = held + got
    next unless held.includes?("\r\n\r\n")
    held = ""
    body = "server=#{id} ech=#{conn.ech_accepted?} name=#{conn.server_name || "-"} outer=#{conn.outer_server_name || "-"} " +
           "alpn=#{conn.alpn_protocol || "-"} resumed=#{conn.resumed?} offered=#{offered}"
    conn.write("HTTP/1.1 200 OK\r\nContent-Length: #{body.bytesize}\r\n\r\n" + body)
  end
  conn.close
end

# `serve_one` in a task of its own in *g*: a kept connection waits on its
# client while the next one is served.
def serve_later(g : IyiGroup, socket : IyiSocket, id : Int32, config : TlsServerConfig, seen : Seen) : Nil
  g.spawn do
    serve_one(socket, id, config, seen)
    0
  end
end

# What a request came to: the server's line, or the failure with the
# ports this program listens on written as names.
def said(got : Response | HTTPError | SocketError | Cancelled, ports : Array({Int32, String})) : String
  text = case got
         in Response
           got.body
         in HTTPError
           "error: #{got.message}"
         in SocketError
           "error: #{got.message}"
         in Cancelled
           "cancelled"
         end
  ports.each { |port| text = replaced(text, port[0].to_s, port[1]) }
  text
end

def server_config(keys : Array(TlsEchKey), offered : Seen) : TlsServerConfig
  config = TlsServerConfig.from_pem(INNER_CERT_PEM + ROOT_PEM, INNER_KEY_PEM).or_panic
  config.add_identity(TlsIdentity.from_pem(PUBLIC_CERT_PEM + ROOT_PEM, PUBLIC_KEY_PEM).or_panic)
  config.alpn = ["http/1.1"]
  config.ech_keys = keys
  config.identity_source = ->(name : String?, protocols : Array(String)?, left : Int32?) {
    offered.offered = protocols ? protocols.join(",") : "-"
    nil.as(TlsIdentity | TlsError | Nil)
  }
  config
end

key = TlsEchKey.generate("public.test", 1).or_panic
list = TlsEchKey.config_list([key])
stale = TlsEchKey.config_list([TlsEchKey.generate("public.test", 1).or_panic])
seen = Seen.new
main = server_config([key], seen)
# Two servers behind one address that disagree: each turns down the
# other's config, and sends its own.
first_of_two = server_config([TlsEchKey.generate("public.test", 2).or_panic], seen)
second_of_two = server_config([TlsEchKey.generate("public.test", 3).or_panic], seen)
# A server that holds no ECH keys: it turns every encrypted ClientHello
# down and sends no configs to retry with.
keyless = server_config([] of TlsEchKey, seen)

listener = IyiSocket.listen("127.0.0.1", 0)
port = listener.local_port
# A second server, which a record the client cannot use names.
other_listener = IyiSocket.listen("127.0.0.1", 0)
other_port = other_listener.local_port
# A port nothing listens on.
nobody = IyiSocket.listen("127.0.0.1", 0)
dead_port = nobody.local_port
nobody.close
dns = UdpSocket.bind("127.0.0.1", 0)
zone = Zone.new
zone.addressed << "inner.test"
zone.addressed << "svc.test"
ports = [{other_port, "OTHER"}, {dead_port, "DEAD"}, {port, "PORT"}, {dns.local_port, "DNS"}]
plain = Resolver.new(["127.0.0.1:#{dns.local_port}"], timeout_ms: 2000, attempts: 1)
encrypted = Resolver.new([] of String, timeout_ms: 2000, attempts: 1).encrypted(LocalUpstream.new(zone).as(DnsUpstream))
base = TlsConfig.new
base.roots = Certificate.from_pem(ROOT_PEM).or_panic
base.alpn = ["http/1.1", "h2"]
origin = "https://inner.test:#{port}/"
# The origin's port is not 443, so its records are asked for at
# `_port._https.inner.test` (RFC 9460 section 9.1). Their target is
# inner.test, written out: "." would be that prefixed owner (section
# 2.5.2), whose addresses a client then asks for (section 10.3).
TARGET = "inner.test"
asked = "_#{port}._https.inner.test"
failures = [] of String

group do |g|
  g.spawn do
    while true
      got = dns.receive_from(65536)
      break if got.is_a?(Cancelled)
      packet, host, peer = got
      answer = zone.answer(packet)
      dns.send_to(answer, host, peer) if answer
    end
    0
  end
  [{listener, 1}, {other_listener, 2}].each do |served|
    g.spawn do
      while true
        socket = served[0].accept
        break unless socket.is_a?(IyiSocket)
        serve_later(g, socket, served[1], main, seen)
      end
      0
    end
  end
  g.spawn do
    # Not asked for: no HTTPS question goes out, and the connection is the
    # one made without records, a GREASE encrypted_client_hello in it.
    zone.https[asked] = [https_data(1, TARGET, [alpn_param(["h2"]), ech_param(list)])]
    zone.asked.clear
    off = HTTPClient.new(tls: base, resolver: plain)
    check("off by default", "#{said(off.get(origin), ports)}, HTTPS asked #{zone.asked.count(&.ends_with?("/HTTPS"))} times",
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2, HTTPS asked 0 times", failures)

    # Asked for: the record's ech encrypts the ClientHello, the server
    # opens it and answers for the name inside; its alpn goes first in the
    # ClientHello's list, which still holds the client's other protocol.
    client = HTTPClient.new(tls: base, resolver: plain)
    client.use_https_records = true
    zone.asked.clear
    check("ech", "#{said(client.get(origin), ports)}; asked #{replaced(zone.asked.join(" "), port.to_s, "PORT")}",
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=h2,http/1.1; asked _PORT._https.inner.test/HTTPS inner.test/A inner.test/AAAA", failures)

    # The origin on 443, aliased to svc.test, whose record names the port:
    # the connection goes to svc.test's address and the record's port,
    # and is still for inner.test.
    zone.https["inner.test"] = [https_data(0, "svc.test")]
    zone.https["svc.test"] = [https_data(1, ".", [port_param(port), ech_param(list)])]
    zone.asked.clear
    aliased = HTTPClient.new(tls: base, resolver: plain)
    aliased.use_https_records = true
    check("alias, target and port", "#{said(aliased.get("https://inner.test/"), ports)}; asked #{zone.asked.join(" ")}",
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=http/1.1,h2; asked inner.test/HTTPS svc.test/HTTPS svc.test/A svc.test/AAAA", failures)

    # A config the server no longer holds: turned down, its certificate
    # checked for public.test, with the server's own configs to retry
    # with - and the retry, on a new connection, is taken.
    zone.https[asked] = [https_data(1, TARGET, [ech_param(stale)])]
    retrying = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    retrying.use_https_records = true
    check("retry", "#{said(retrying.get(origin), ports)}, #{retrying.connections_made} connections",
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=http/1.1,h2, 2 connections", failures)

    # Two servers behind the address that each turn down the other's
    # configs: the retry is turned down too, and that is the failure - no
    # third connection (RFC 9849 section 6.1.6).
    seen.plans = [first_of_two, second_of_two]
    twice = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    twice.use_https_records = true
    turned = said(twice.get(origin), ports)
    seen.plans.clear
    refused = turned.includes?("did not take the encrypted ClientHello") && turned.ends_with?("(ech_required)")
    check("retried once", "#{refused ? "ech_required" : turned}, #{twice.connections_made} connections", "ech_required, 2 connections", failures)

    # A server with no keys sends no configs to retry with, which turns
    # ECH off there: the retry goes without it.
    zone.https[asked] = [https_data(1, TARGET, [ech_param(list)])]
    seen.plans = [keyless]
    disabled = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    disabled.use_https_records = true
    check("ech turned off", "#{said(disabled.get(origin), ports)}, #{disabled.connections_made} connections",
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2, 2 connections", failures)
    seen.plans.clear

    # A record whose protocols the client has none of is passed over: the
    # first names the other server, for h3 alone.
    zone.https[asked] = [https_data(1, TARGET, [alpn_param(["h3"]), NO_DEFAULT_ALPN, port_param(other_port), ech_param(list)]),
                         https_data(2, TARGET, [alpn_param(["h2"]), ech_param(list)])]
    passing = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    passing.use_https_records = true
    check("an endpoint of no protocol the client has", said(passing.get(origin), ports),
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=h2,http/1.1", failures)

    # Every endpoint encrypted: one that does not connect is the request's
    # failure, not a fall back to the origin in the clear (RFC 9848 5.1);
    # without ech the origin is tried after it.
    zone.https[asked] = [https_data(1, TARGET, [port_param(dead_port), ech_param(list)])]
    reliant = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    reliant.use_https_records = true
    stopped = said(reliant.get(origin), ports)
    check("no fallback past ech", stopped.includes?("connection refused") ? "connection refused" : stopped, "connection refused", failures)
    zone.https[asked] = [https_data(1, TARGET, [port_param(dead_port)])]
    optional = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    optional.use_https_records = true
    check("fallback without ech", said(optional.get(origin), ports),
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2", failures)

    # No records, and a server that failed over plaintext: as without
    # records - the no-records connection resuming by the ticket the one
    # that fell back to the origin was sent, both made under the client's
    # own configuration.
    zone.https[asked] = [] of Array(UInt8)
    check("no records", said(optional.get(origin), ports),
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=true offered=http/1.1,h2", failures)
    zone.failing << asked
    fallen = HTTPClient.new(tls: base, resolver: plain)
    fallen.use_https_records = true
    check("SERVFAIL in the clear", said(fallen.get(origin), ports),
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2", failures)

    # Over an encrypted upstream: the records come as they do in the
    # clear, and a failure is the request's (RFC 9460 section 3.1).
    secured = HTTPClient.new(tls: base, resolver: encrypted)
    secured.use_https_records = true
    failed = said(secured.get(origin), ports)
    check("SERVFAIL over an encrypted upstream", failed.includes?("SERVFAIL") && failed.includes?("not passed over") ? "refused" : failed, "refused", failures)
    zone.failing.clear
    zone.https[asked] = [https_data(1, TARGET, [alpn_param(["h2"]), ech_param(list)])]
    check("ech over an encrypted upstream", said(secured.get(origin), ports),
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=h2,http/1.1", failures)

    # The record's configuration is made once: a kept connection carries
    # the next request, and a new one resumes by the ticket the first was
    # sent.
    kept = HTTPClient.new(tls: base, resolver: plain)
    kept.use_https_records = true
    kept.get(origin)
    again = said(kept.get(origin), ports)
    check("kept", "#{again}, #{kept.connections_made} made, #{kept.connections_reused} reused",
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=h2,http/1.1, 1 made, 1 reused", failures)
    resuming = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    resuming.use_https_records = true
    resuming.get(origin)
    check("resumed", said(resuming.get(origin), ports),
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=true offered=h2,http/1.1", failures)

    # A connection made in the clear is not taken under the record's ech,
    # and one made under it is not taken once records are off: the one
    # made in the clear is again.
    turning = HTTPClient.new(tls: base, resolver: plain)
    clear = said(turning.get(origin), ports)
    turning.use_https_records = true
    hidden = said(turning.get(origin), ports)
    turning.use_https_records = false
    shown = said(turning.get(origin), ports)
    check("records turned on and off", "#{clear} / #{hidden} / #{shown}, #{turning.connections_made} made, #{turning.connections_reused} reused",
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2 / " +
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=h2,http/1.1 / " +
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2, 2 made, 1 reused", failures)
    # Nor a ticket: the one sent in the clear is not offered inside ECH,
    # nor the one sent inside it in a ClientHello that names the server in
    # the clear.
    ticketed = HTTPClient.new(tls: base, resolver: plain, idle: 0)
    first = said(ticketed.get(origin), ports)
    ticketed.use_https_records = true
    inside = said(ticketed.get(origin), ports)
    ticketed.use_https_records = false
    outside = said(ticketed.get(origin), ports)
    check("tickets with records turned on and off", "#{first} / #{inside} / #{outside}, #{ticketed.connections_resumed} resumed",
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2 / " +
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=h2,http/1.1 / " +
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1,h2, 0 resumed", failures)

    # ech_configs assigned in place, in a configuration of the client's
    # own (`TlsMadeUnder`): the connection kept from before, made in the
    # clear, does not carry the request that asks for ECH.
    own = TlsConfig.new
    own.roots = base.roots
    own.alpn = ["http/1.1"]
    mine = HTTPClient.new(tls: own, resolver: plain)
    before = said(mine.get(origin), ports)
    own.ech_configs = list
    after = said(mine.get(origin), ports)
    check("ech_configs assigned in place", "#{before} / #{after}, #{mine.connections_made} made",
      "server=1 ech=false name=inner.test outer=- alpn=http/1.1 resumed=false offered=http/1.1 / " +
      "server=1 ech=true name=inner.test outer=public.test alpn=http/1.1 resumed=false offered=http/1.1, 2 made", failures)

    [off, client, aliased, retrying, twice, disabled, passing, reliant, optional, fallen, secured, kept, resuming, turning, ticketed, mine].each(&.close)
    listener.close
    other_listener.close
    dns.close
    0
  end
end
exit 1 unless failures.empty?
puts "ALL CHECKS PASSED"
