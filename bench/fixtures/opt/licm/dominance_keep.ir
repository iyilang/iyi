; iyi-ir 1
source_filename = "dominance_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @dominance_keep(i1 %run, ptr %source, ptr %out) {
entry:
  br label %head
head:
  %iv = phi i64 [ 0, label %entry ], [ %next, label %body ]
  br i1 %run, label %body, label %done
body:
  %loaded = load i64, ptr %source, align 8
  %derived = mul i64 %loaded, 3
  %next = add i64 %iv, %derived
  store i64 %next, ptr %out, align 8
  br label %head
done:
  ret void
}
