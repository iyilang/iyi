@[Unsafe("observes collector colours while capturing self")]
class SelfCapturePayload
  def initialize(@value : Int32)
  end

  def reader : Proc(Int32)
    -> { @value }
  end
end

class SelfCaptureChain
  getter next : SelfCaptureChain?

  def initialize(@next : SelfCaptureChain?)
  end
end

def check_self_capture_under_mark : Int32
  payload = SelfCapturePayload.new(42)
  chain = SelfCaptureChain.new(nil)
  n = 0
  while n < 200000
    chain = SelfCaptureChain.new(chain)
    n += 1
  end
  IyiMark.workers = 15_u64
  IyiMark.auto = true
  limit = IyiMark.budget &* 2_u64
  burned = 0_u64
  while burned < limit && !IyiMark.marking?
    bytes = Pointer(UInt8).malloc(64_u64)
    bytes.value = 1_u8
    burned += 64_u64
  end
  under_mark = IyiMark.marking?
  white = false
  shaded = false
  still_marking = false
  result = 0
  if under_mark
    address = payload.object_id.to_u64
    IyiMark.recolour(address, IyiMark::WHITE)
    white = IyiMark.colour(address) == IyiMark::WHITE
    reader = payload.reader
    still_marking = IyiMark.marking?
    shaded = IyiMark.colour(address) != IyiMark::WHITE
    result = reader.call
  end
  IyiMark.settle
  return 2 unless under_mark
  return 3 unless white
  return 4 unless still_marking
  return 5 unless shaded
  return 6 unless result == 42 && chain.object_id != 0_u64
  0
end

IyiMark.auto = false
result = check_self_capture_under_mark
if result == 0
  puts "MARKING WHITE SHADED 42"
elsif result == 5
  puts "MARKING WHITE UNSHADED"
  __iyi_exit(1)
else
  puts "MARKING PROOF INVALID #{result}"
  __iyi_exit(1)
end
