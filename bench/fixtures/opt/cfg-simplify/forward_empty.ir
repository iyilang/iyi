; iyi-ir 1
source_filename = "forward_empty"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @forward_empty(i1 %c, i32 %x) {
entry:
  br i1 %c, label %left, label %right
left:
  %a = add i32 %x, 1
  br label %middle
middle:
  br label %join
right:
  %b = add i32 %x, 2
  br label %join
join:
  %p = phi i32 [ %a, label %middle ], [ %b, label %right ]
  ret i32 %p
}
