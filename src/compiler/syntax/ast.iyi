pub class When < ASTNode
  property conds : Array(ASTNode)
  property body : ASTNode
  property exhaustive : Bool

  def initialize(@conds : Array(ASTNode) = [] of ASTNode, body : ASTNode? = nil, @exhaustive : Bool = false)
    @body = body || Nop.new
  end

  def clone_without_location : self
