ES256_RFC6979 = "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJrYXQiLCJuIjoxfQ.jhCinpcDLQthmoDW4nEF94pCFijRuT2OrUgS1qcQLk6ZoAIPHHMG7OBVAcAxW7QnoMTp0PGBXziKeErzby-kkw"

HS         = [JWTAlgorithm::HS256]
RS         = [JWTAlgorithm::RS256]
A1_CLAIMS  = "{\"iss\":\"joe\",\"exp\":1300819380,\"http://example.com/is_root\":true}"
A1_PAYLOAD = "{\"iss\":\"joe\",\r\n \"exp\":1300819380,\r\n \"http://example.com/is_root\":true}"
A1_NOW     = 1300819379_i64

puts "== RFC 7515 appendix A.1, HS256"
a1 = key(A1_JWK)
assert_str A1_CLAIMS, said(JWT.decode(A1_TOKEN, a1, HS, now: A1_NOW)), "A.1 decodes"
assert_str "JWT", JWT.decode(A1_TOKEN, a1, HS, now: A1_NOW).as(JWT).header["typ"].as_s, "A.1's typ"
# The header is written with a CRLF and a space, as the appendix says.
assert_str A1_TOKEN, JWS.sign("{\"typ\":\"JWT\",\r\n \"alg\":\"HS256\"}", A1_PAYLOAD, a1, JWTAlgorithm::HS256), "A.1 signed again"
assert_str "error: jwt: the token has expired (exp 1300819380, now 1300819380)", said(JWT.decode(A1_TOKEN, a1, HS, now: A1_NOW + 1)), "A.1 at its exp"
assert_str "error: jwt: alg HS256, which is not among the algorithms accepted (RS256, ES256)",
  said(JWT.decode(A1_TOKEN, a1, [JWTAlgorithm::RS256, JWTAlgorithm::ES256], now: A1_NOW)), "A.1 where HS256 is not accepted"
puts "  the token checked and signed again byte for byte, refused at its exp and where HS256 is not named"

puts "\n== RFC 7515 appendix A.2, RS256"
a2 = key(A2_JWK)
assert_true a2.private?, "A.2's key is private"
assert_str A1_CLAIMS, said(JWT.decode(A2_TOKEN, a2.public, RS, now: A1_NOW)), "A.2 decodes under the public key"
assert_str A1_CLAIMS, said(JWT.decode(A2_TOKEN, a2, RS, now: A1_NOW)), "A.2 decodes under the private key"
assert_str A2_TOKEN, JWS.sign("{\"alg\":\"RS256\"}", A1_PAYLOAD, a2, JWTAlgorithm::RS256), "A.2 signed again"
assert_str "error: jwt: the signature does not verify",
  said(JWT.decode(A2_TOKEN, key(COOKBOOK_RSA_PUBLIC), RS, now: A1_NOW)), "A.2 under another RSA key"
puts "  the token checked, and signed again byte for byte: PKCS #1 v1.5 is deterministic"

puts "\n== RFC 7515 appendix A.3, ES256"
a3 = key(A3_JWK)
assert_str A1_CLAIMS, said(JWT.decode(A3_TOKEN, a3.public, [JWTAlgorithm::ES256], now: A1_NOW)), "A.3 decodes"
a3_bent = A3_TOKEN[0, A3_TOKEN.size - 2] + (A3_TOKEN.ends_with?("1Q") ? "1A" : "1Q")
assert_str "error: jwt: the signature does not verify", said(JWT.decode(a3_bent, a3.public, [JWTAlgorithm::ES256], now: A1_NOW)), "A.3 with s changed"
assert_str "error: jwt: an ES256 token, and the key is an EC key on P-384",
  said(JWT.decode(A3_TOKEN, pem(P384_SPKI), [JWTAlgorithm::ES256], now: A1_NOW)), "A.3 under a P-384 key"
puts "  the token checked; s changed and a key on another curve refused"

puts "\n== RFC 7515 appendix A.4, ES512, checked and not signed"
assert_str "Payload", said(JWS.verify(A4_TOKEN, key(A4_PUBLIC_JWK), [JWTAlgorithm::ES512])), "A.4 verifies"
assert_str "error: jwt: the payload is not JSON: bare identifier 'Payload' at line 1, column 1",
  said(JWT.decode(A4_TOKEN, key(A4_PUBLIC_JWK), [JWTAlgorithm::ES512], now: 0_i64)), "A.4's payload is no claims set"
puts "  a P-521 signature over a payload that is not JSON: JWS.verify takes it, JWT.decode does not"

puts "\n== RFC 7515 appendix A.5, the unsecured JWS refused"
every = JWTAlgorithm.values
assert_str "error: jwt: the token is unsecured (alg none), which is never accepted", said(JWT.decode(A5_TOKEN, a1, every, now: A1_NOW)), "A.5 refused"
assert_str "error: jwt: the token is unsecured (alg none), which is never accepted", said(JWS.verify(A5_TOKEN, a2, every)), "A.5 refused by JWS.verify"
none_sig = forge("{\"alg\":\"none\"}", A1_CLAIMS, "")
assert_str "error: jwt: the token is unsecured (alg none), which is never accepted", said(JWT.decode(none_sig, a1, every, now: A1_NOW)), "alg none with a signature"
assert_str "error: jwt: alg \"None\", which is not among the algorithms accepted (HS256)",
  said(JWT.decode(forge("{\"alg\":\"None\"}", A1_CLAIMS, ""), a1, HS, now: A1_NOW)), "alg None"
assert_str "error: jwt: alg \"hs256\", which is not among the algorithms accepted (HS256)",
  said(JWT.decode(forge("{\"alg\":\"hs256\"}", A1_CLAIMS, A1_JWK), a1, HS, now: A1_NOW)), "alg hs256"
puts "  alg none refused with every algorithm accepted, and None and hs256 are no algorithm"

puts "\n== RFC 7520 section 4, the JOSE cookbook's signatures"
rsa_private = key(COOKBOOK_RSA_PRIVATE)
rsa_public = key(COOKBOOK_RSA_PUBLIC)
assert_str COOKBOOK_RS256, JWS.sign("{\"alg\":\"RS256\",\"kid\":\"bilbo.baggins@hobbiton.example\"}", COOKBOOK_PAYLOAD, rsa_private, JWTAlgorithm::RS256), "4.1 signed again"
assert_str COOKBOOK_PAYLOAD, said(JWS.verify(COOKBOOK_RS256, rsa_public, RS)), "4.1 verifies"
assert_str COOKBOOK_PAYLOAD, said(JWS.verify(COOKBOOK_PS384, rsa_public, [JWTAlgorithm::PS384])), "4.2 PS384 verifies"
assert_str COOKBOOK_PAYLOAD, said(JWS.verify(COOKBOOK_ES512, key(COOKBOOK_EC_PUBLIC), [JWTAlgorithm::ES512])), "4.3 ES512 verifies"
oct = key(COOKBOOK_OCT)
assert_str COOKBOOK_HS256, JWS.sign("{\"alg\":\"HS256\",\"kid\":\"018c0ae5-4d9b-471b-bfd6-eef314bc7037\"}", COOKBOOK_PAYLOAD, oct, JWTAlgorithm::HS256), "4.4 signed again"
assert_str COOKBOOK_PAYLOAD, said(JWS.verify(COOKBOOK_HS256, oct, HS)), "4.4 verifies"
assert_str "error: jwt: a PS256 token, and the key is a shared secret (oct)", said(JWS.verify(forge("{\"alg\":\"PS256\"}", "{}", ""), oct, [JWTAlgorithm::PS256])), "an oct key for PS256"
assert_str "error: jwt: a P-521 private key, and std signs on P-256 alone", said(JWK.parse(COOKBOOK_EC_PRIVATE)), "the P-521 private key"
puts "  RS256 and HS256 signed again byte for byte; PS384 and ES512, whose signatures are random, checked"

puts "\n== RFC 8037 appendix A, Ed25519"
ed_private = key(ED_PRIVATE_JWK)
ed_public = key(ED_PUBLIC_JWK)
assert_str ED_PUBLIC_JWK, ed_private.public.to_json, "A.2 is A.1 without d"
assert_str "kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k", ed_private.thumbprint, "A.3 thumbprint of the private key"
assert_str "kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k", ed_public.thumbprint, "A.3 thumbprint of the public key"
assert_str ED_TOKEN, JWS.sign("{\"alg\":\"EdDSA\"}", "Example of Ed25519 signing", ed_private, JWTAlgorithm::EdDSA), "A.4 signed"
assert_str "Example of Ed25519 signing", said(JWS.verify(ED_TOKEN, ed_public, [JWTAlgorithm::EdDSA])), "A.5 verifies"
assert_str "error: jwt: an OKP JWK whose d is not the private key of its x",
  said(JWK.parse(replace(ED_PRIVATE_JWK, "nWGx", "nWGy"))), "an Ed25519 d that is not x's"
assert_str "error: jwt: an OKP JWK on \"X25519\", not Ed25519", said(JWK.parse(replace(ED_PUBLIC_JWK, "Ed25519", "X25519"))), "an X25519 key"
puts "  the key, its thumbprint, the signature byte for byte and its check"

puts "\n== RFC 7638 section 3.1, a thumbprint"
assert_str "NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs", key(THUMBPRINT_JWK).thumbprint, "RFC 7638 thumbprint"
assert_str "RS256", key(THUMBPRINT_JWK).alg.to_s, "the alg member kept"
assert_str "2011-04-29", key(THUMBPRINT_JWK).kid.to_s, "the kid member kept"
puts "  the RSA key's thumbprint, its alg and kid read"

puts "\n== RFC 7517 appendix A, JWK Sets"
public_set = JWK.parse_set(SET_PUBLIC).or_panic
private_set = JWK.parse_set(SET_PRIVATE).or_panic
symmetric_set = JWK.parse_set(SET_SYMMETRIC).or_panic
assert_str "EC P-256 enc 1, RSA RS256 2011-04-29", public_set.map { |k| "#{k.kty} #{k.crv || k.alg} #{k.usage || ""}#{k.usage ? " " : ""}#{k.kid}" }.join(", "), "A.1's keys"
assert_true private_set.all?(&.private?) && !public_set.any?(&.private?), "A.2's keys are private, A.1's are not"
signed = JWT.encode({"sub" => "set"}, private_set[1], JWTAlgorithm::RS256)
assert_str "2011-04-29", JWT.unverified(signed).as(JWT).header["kid"]?.to_s, "the key's kid written in the header"
assert_str "{\"sub\":\"set\"}", said(JWT.decode(signed, public_set, RS, now: 0_i64)), "decoded against the set by kid"
enc_key = forge("{\"alg\":\"ES256\",\"kid\":\"1\"}", "{}", "")
assert_str "error: jwt: the key's use is enc, not sig", said(JWT.decode(enc_key, public_set, [JWTAlgorithm::ES256], now: 0_i64)), "a key for encryption"
assert_str "error: jwt: no key has the kid \"3\" the header names",
  said(JWT.decode(forge("{\"alg\":\"RS256\",\"kid\":\"3\"}", "{}", ""), public_set, RS, now: 0_i64)), "a kid no key has"
# A.3's first key wraps keys (A128KW) and is passed over; the second is
# A.1's, under its kid.
assert_str A1_CLAIMS, said(JWT.decode(A1_TOKEN, symmetric_set, HS, now: A1_NOW)), "A.1 against the symmetric set"
assert_str "HMAC key used in JWS spec Appendix A.1 example", symmetric_set[1].kid.to_s, "a kid with spaces"
assert_str "1", JWK.parse_set("{\"keys\":[{\"kty\":\"XYZ\"},{\"kty\":\"OKP\",\"crv\":\"X448\",\"x\":\"AA\"}," + ED_PUBLIC_JWK + "]}").or_panic.size.to_s, "unknown keys passed over"
assert_str "error: jwt: key 0 of the JWK Set: an RSA JWK with no e", said_set(JWK.parse_set("{\"keys\":[{\"kty\":\"RSA\",\"n\":\"AQAB\"}]}")), "a known key not well formed"
puts "  three sets read; a key chosen by kid, one for encryption and one for key wrapping passed over"

puts "\n== keys from PEM"
cookbook_kid = "bilbo.baggins@hobbiton.example"
[RSA_PKCS8, RSA_PKCS1].each_with_index do |text, i|
  k = JWK.from_pem(text, cookbook_kid).or_panic
  assert_str COOKBOOK_RS256, JWS.sign("{\"alg\":\"RS256\",\"kid\":\"bilbo.baggins@hobbiton.example\"}", COOKBOOK_PAYLOAD, k, JWTAlgorithm::RS256), "RSA private key PEM #{i} signs as the cookbook's"
  assert_str rsa_private.thumbprint, k.thumbprint, "RSA private key PEM #{i}'s thumbprint"
end
[RSA_SPKI, RSA_PKCS1_PUBLIC].each_with_index do |text, i|
  assert_str COOKBOOK_PAYLOAD, said(JWS.verify(COOKBOOK_RS256, pem(text), RS)), "RSA public key PEM #{i} verifies"
  assert_true !pem(text).private?, "RSA public key PEM #{i} is public"
end
a3_bare = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU\",\"y\":\"x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0\""
assert_str A3_JWK, pem(EC_PKCS8).to_json, "the P-256 PKCS #8 key is A.3's"
assert_str A3_JWK, pem(EC_SEC1).to_json, "the P-256 SEC 1 key is A.3's"
assert_str a3_bare + "}", pem(EC_SPKI).to_json, "the P-256 public key is A.3's"
assert_str a3_bare + "}", pem(EC_CERT).to_json, "the certificate's key is A.3's"
cert = Certificate.parse(X509.pem(EC_CERT, "CERTIFICATE").or_panic[0]).or_panic
assert_str a3_bare + "}", JWK.from_key(cert.public_key).or_panic.to_json, "std/x509's key taken as a JWK"
assert_str A3_JWK, JWK.p256(member(A3_JWK, "d")).or_panic.to_json, "A.3's d alone makes A.3's key"
assert_str "error: jwt: ecdsa: a P-256 private key is a number from 1 to n - 1", said(JWK.p256(Array(UInt8).new(32, 0_u8))), "a P-256 d of zero"
assert_str ED_PUBLIC_JWK, pem(ED_SPKI).to_json, "the Ed25519 public key is RFC 8037's"
assert_str ED_TOKEN, JWS.sign("{\"alg\":\"EdDSA\"}", "Example of Ed25519 signing", pem(ED_PKCS8), JWTAlgorithm::EdDSA), "the Ed25519 PKCS #8 key signs as RFC 8037's"
assert_str "{\"sub\":\"p384\",\"exp\":4102444800}", said(JWT.decode(P384_TOKEN, pem(P384_SPKI), [JWTAlgorithm::ES384], now: 0_i64)), "a P-384 key checks ES384"
assert_str "error: jwt: a P-384 private key, and std signs on P-256 alone", said(JWK.from_pem(P384_PKCS8)), "a P-384 private key"
assert_str "error: jwt: an RSA key of 1024 bits, under the 2048 RFC 7518 section 3.3 asks", said(JWK.from_pem(RSA1024_SPKI)), "a 1024-bit RSA key"
assert_str "error: jwt: a public key for 1.3.101.110, which no algorithm here signs with", said(JWK.from_pem(X25519_SPKI)), "an X25519 key"
assert_str "error: jwt: an encrypted private key, which this cannot open", said(JWK.from_pem(RSA_ENCRYPTED)), "an encrypted key"
assert_str "error: jwt: a PEM text with more than one key in it", said(JWK.from_pem(EC_SPKI + RSA_SPKI)), "two keys in one text"
assert_str "error: jwt: a PEM text with no key in it (PUBLIC KEY, PRIVATE KEY, RSA PUBLIC KEY, RSA PRIVATE KEY, EC PRIVATE KEY, CERTIFICATE)", said(JWK.from_pem("no key here")), "no key"
puts "  PKCS #8, PKCS #1, SEC 1, SubjectPublicKeyInfo and a certificate, each the RFC key it was written from"

puts "\n== tokens PyJWT wrote"
SECRET = Array(UInt8).new(64) { |i| (i + 1).to_u8 }
signers = {
  "HS" => JWK.secret(SECRET), "RS" => pem(RSA_PKCS8), "PS" => pem(RSA_PKCS8), "ES256" => pem(EC_PKCS8),
  "ES384" => pem(P384_SPKI), "ES512" => key(COOKBOOK_EC_PUBLIC), "Ed" => ed_private,
}
PYJWT_TOKENS.each do |pair|
  algorithm = JWTAlgorithm.named(pair[0]).as(JWTAlgorithm)
  k = signers[pair[0]]? || signers[algorithm.family]
  assert_str "{\"sub\":\"kat\",\"n\":1}", said(JWT.decode(pair[1], k, [algorithm], now: 0_i64)), "PyJWT's #{pair[0]} token decodes"
  if algorithm.family == "HS" || algorithm.family == "RS" || algorithm.family == "Ed"
    assert_str pair[1], JWT.encode({"sub" => Any.new("kat"), "n" => Any.new(1)}, k, algorithm), "#{pair[0]} written as PyJWT writes it"
  end
end
assert_str ES256_RFC6979, JWT.encode({"sub" => Any.new("kat"), "n" => Any.new(1)}, signers["ES256"], JWTAlgorithm::ES256), "ES256 written as cryptography's RFC 6979 signer writes it"
# The secret as bytes and as a String, and what the decoded token holds.
secret_text = text(SECRET)
kat = JWT.decode(PYJWT_TOKENS[0][1], SECRET, HS, now: 0_i64).as(JWT)
assert_str "kat 1 HS256 JWT", "#{kat["sub"].as_s} #{kat["n"]?.to_s} #{kat.algorithm} #{kat.header["typ"].as_s}", "the decoded token's claims and header"
assert_true kat["exp"]?.nil?, "a claim the token does not carry"
assert_str "{\"sub\":\"kat\",\"n\":1}", said(JWT.decode(PYJWT_TOKENS[0][1], secret_text, HS, now: 0_i64)), "the secret as a String"
assert_str PYJWT_TOKENS[0][1], JWT.encode({"sub" => Any.new("kat"), "n" => Any.new(1)}, secret_text, JWTAlgorithm::HS256), "signed with the secret as a String"
puts "  all thirteen decoded; HS, RS and EdDSA written byte for byte as PyJWT writes them, ES256 as RFC 6979 does"

puts "\n== every algorithm, signed and checked"
claims_in = {"sub" => Any.new("alice"), "exp" => Any.new(2000000000_i64), "tags" => Any.new([Any.new("a"), Any.new(1_i64)])}
JWTAlgorithm.values.each do |algorithm|
  next if algorithm == JWTAlgorithm::ES384 || algorithm == JWTAlgorithm::ES512
  k = signers[algorithm.to_s]? || signers[algorithm.family]
  token = JWT.encode(claims_in, k, algorithm)
  verifier = algorithm.family == "HS" ? k : k.public
  assert_str JSON.to_json(claims_in), said(JWT.decode(token, verifier, [algorithm], now: 1000_i64)), "#{algorithm} round trip"
  assert_str token, JWT.encode(claims_in, k, algorithm), "#{algorithm} signs the same claims alike"
  other = algorithm == JWTAlgorithm::HS256 ? JWTAlgorithm::HS384 : JWTAlgorithm::HS256
  assert_str "error: jwt: alg #{algorithm}, which is not among the algorithms accepted (#{other})", said(JWT.decode(token, verifier, [other], now: 1000_i64)), "#{algorithm} where it is not accepted"
end
puts "  eleven algorithms signed and checked (ES384 and ES512 are checked only), each deterministic"

puts "\n== the attacks"
rsa_pem_secret = RSA_SPKI
confused = forge("{\"alg\":\"HS256\",\"typ\":\"JWT\"}", "{\"sub\":\"admin\"}", rsa_pem_secret)
assert_str "error: jwt: alg HS256, which is not among the algorithms accepted (RS256)", said(JWT.decode(confused, pem(RSA_SPKI), RS, now: 0_i64)), "an HS256 token where RS256 alone is accepted"
assert_str "error: jwt: an HS256 token, and the key is an RSA key",
  said(JWT.decode(confused, pem(RSA_SPKI), [JWTAlgorithm::RS256, JWTAlgorithm::HS256], now: 0_i64)), "the RS/HS confusion with both algorithms accepted"
good = JWT.encode({"sub" => "alice", "admin" => "no"}, a1, JWTAlgorithm::HS256)
parts = good.split('.')
tampered = "#{parts[0]}.#{b64("{\"sub\":\"alice\",\"admin\":\"yes\"}")}.#{parts[2]}"
assert_str "error: jwt: the signature does not verify", said(JWT.decode(tampered, a1, HS, now: 0_i64)), "a tampered payload"
assert_str "error: jwt: the signature is padded with =, which base64url in a JWS leaves out (RFC 7515 section 2)", said(JWT.decode(good + "=", a1, HS, now: 0_i64)), "a padded signature"
assert_str "error: jwt: the payload is padded with =, which base64url in a JWS leaves out (RFC 7515 section 2)",
  said(JWT.decode("#{parts[0]}.#{parts[1]}=.#{parts[2]}", a1, HS, now: 0_i64)), "a padded payload"
# 32 bytes are 43 characters, the last carrying four bits and two spare:
# the next character up has the same four bits and a spare one set.
# (bend writes that character.)
bent = bend(parts[2])
assert_str "error: jwt: the signature's last base64url character carries bits past its bytes, so it is not the one spelling of them",
  said(JWT.decode("#{parts[0]}.#{parts[1]}.#{bent}", a1, HS, now: 0_i64)), "a second spelling of the signature"
assert_str "error: jwt: the signature holds byte 43 at 0, which is not base64url", said(JWT.decode("#{parts[0]}.#{parts[1]}.+#{parts[2]}", a1, HS, now: 0_i64)), "the other alphabet"
assert_str "error: jwt: the signature is 45 base64url characters, one more than a multiple of four, which no bytes are",
  said(JWT.decode("#{good}AA", a1, HS, now: 0_i64)), "a length no bytes have"
a1_secret = text(member(A1_JWK, "k"))
duplicated = forge("{\"alg\":\"HS256\"}", "{\"sub\":\"alice\",\"sub\":\"admin\"}", a1_secret)
assert_str "error: jwt: the payload is not JSON: duplicate key 'sub' at line 1, column 16", said(JWT.decode(duplicated, a1, HS, now: 0_i64)), "a claim written twice"
assert_str "error: jwt: the header is not JSON: duplicate key 'alg' at line 1, column 16",
  said(JWT.decode(forge("{\"alg\":\"HS256\",\"alg\":\"none\"}", "{}", ""), a1, HS, now: 0_i64)), "alg written twice"
critical = forge("{\"alg\":\"HS256\",\"crit\":[\"exp\"],\"exp\":1}", "{}", a1_secret)
assert_str "error: jwt: the header lists critical extensions (crit), and none is understood here", said(JWT.decode(critical, a1, HS, now: 0_i64)), "a crit header"
assert_str "error: jwt: a token of five parts is a JWE, an encrypted token, which this does not open", said(JWT.decode("a.b.c.d.e", a1, HS, now: 0_i64)), "a JWE"
assert_str "error: jwt: a JWS is three base64url parts joined by dots, and this token has 2", said(JWT.decode("#{parts[0]}.#{parts[1]}", a1, HS, now: 0_i64)), "two parts"
assert_str "error: jwt: the header is a JSON array, not an object", said(JWT.decode(forge("[]", "{}", ""), a1, HS, now: 0_i64)), "a header that is an array"
assert_str "error: jwt: the header names no alg", said(JWT.decode(forge("{}", "{}", ""), a1, HS, now: 0_i64)), "no alg"
assert_str "error: jwt: the header's alg is a JSON integer, not a string", said(JWT.decode(forge("{\"alg\":256}", "{}", ""), a1, HS, now: 0_i64)), "an alg that is a number"
assert_str "error: jwt: the header's kid is a JSON array, not a string", said(JWT.decode(forge("{\"alg\":\"HS256\",\"kid\":[]}", "{}", ""), a1, HS, now: 0_i64)), "a kid that is an array"
assert_str "error: jwt: the payload is a JSON string, not an object",
  said(JWT.decode(forge("{\"alg\":\"HS256\"}", "\"alice\"", a1_secret), a1, HS, now: 0_i64)), "claims that are a string"
der_signature = A3_TOKEN.split('.')
assert_str "error: jwt: the signature does not verify",
  said(JWT.decode("#{der_signature[0]}.#{der_signature[1]}.#{b64(Array(UInt8).new(72, 48_u8))}", a3.public, [JWTAlgorithm::ES256], now: 0_i64)), "an ES256 signature of the wrong length"
# A jwk header naming the attacker's own key is not the key.
injected = JWS.sign("{\"alg\":\"EdDSA\",\"jwk\":" + ED_PUBLIC_JWK + "}", "{}", ed_private, JWTAlgorithm::EdDSA)
assert_str "error: jwt: the signature does not verify", said(JWT.decode(injected, JWK.ed25519(SECRET[0, 32]).public, [JWTAlgorithm::EdDSA], now: 0_i64)), "a jwk header ignored"
puts "  alg confusion, tampering, padding, second spellings, duplicates, crit, JWE and malformed headers refused"

puts "\n== claims at their edges"
now = 1000_i64
assert_str "error: jwt: the token has expired (exp 1000, now 1000)", at("{\"exp\":1000}", now), "exp equal to now"
assert_str "{\"exp\":1001}", at("{\"exp\":1001}", now), "exp a second after now"
assert_str "{\"exp\":1000}", at("{\"exp\":1000}", now, 1_i64), "exp within the leeway"
assert_str "error: jwt: the token has expired (exp 999, now 1000)", at("{\"exp\":999}", now, 1_i64), "exp past the leeway"
assert_str "{\"exp\":1000.5}", at("{\"exp\":1000.5}", now), "a fractional exp half a second ahead"
assert_str "error: jwt: the token has expired (exp 999.5, now 1000)", at("{\"exp\":999.5}", now), "a fractional exp half a second behind"
assert_str "{\"nbf\":1000}", at("{\"nbf\":1000}", now), "nbf equal to now"
assert_str "error: jwt: the token is not valid yet (nbf 1001, now 1000)", at("{\"nbf\":1001}", now), "nbf a second ahead"
assert_str "{\"nbf\":1001}", at("{\"nbf\":1001}", now, 1_i64), "nbf within the leeway"
assert_str "error: jwt: the token was issued in the future (iat 1001, now 1000)", at("{\"iat\":1001}", now), "iat in the future"
assert_str "{\"iat\":1000}", at("{\"iat\":1000}", now), "iat now"
assert_str "error: jwt: the exp claim is a JSON string, not a NumericDate", at("{\"exp\":\"2000\"}", now), "exp as a string"
assert_str "error: jwt: the nbf claim is a JSON bool, not a NumericDate", at("{\"nbf\":true}", now), "nbf as a bool"
assert_str "{\"aud\":\"api\"}", at("{\"aud\":\"api\"}", now, audience: "api"), "aud as a string"
assert_str "{\"aud\":[\"web\",\"api\"]}", at("{\"aud\":[\"web\",\"api\"]}", now, audience: "api"), "aud as an array"
assert_str "{\"aud\":\"api\"}", at("{\"aud\":\"api\"}", now, audience: ["web", "api"]), "one of several audiences"
assert_str "error: jwt: the token is not for this audience", at("{\"aud\":\"web\"}", now, audience: "api"), "the wrong aud"
assert_str "error: jwt: the token names an audience (aud), and none is expected", at("{\"aud\":\"web\"}", now), "an aud when none is expected"
assert_str "error: jwt: the token carries no aud claim, and an audience is expected", at("{}", now, audience: "api"), "no aud when one is expected"
assert_str "error: jwt: the aud claim is neither a string nor an array of strings", at("{\"aud\":[\"api\",1]}", now, audience: "api"), "an aud with a number in it"
assert_str "{\"iss\":\"https://a.example\"}", at("{\"iss\":\"https://a.example\"}", now, issuer: "https://a.example"), "the issuer"
assert_str "error: jwt: the token's issuer is \"https://b.example\", not one expected", at("{\"iss\":\"https://b.example\"}", now, issuer: "https://a.example"), "the wrong iss"
assert_str "{\"iss\":\"b\"}", at("{\"iss\":\"b\"}", now, issuer: ["a", "b"]), "one of several issuers"
assert_str "error: jwt: the token carries no iss claim, and an issuer is expected", at("{}", now, issuer: "a"), "no iss when one is expected"
assert_str "{\"iss\":\"anyone\"}", at("{\"iss\":\"anyone\"}", now), "an iss when none is expected"
assert_str "error: jwt: the iss claim is a JSON integer, not a string", at("{\"iss\":7}", now, issuer: "7"), "an iss that is a number"
assert_str "error: jwt: the token's subject is \"bob\", not the one expected", at("{\"sub\":\"bob\"}", now, subject: "alice"), "the wrong sub"
assert_str "error: jwt: the sub claim is a JSON integer, not a string", at("{\"sub\":42}", now), "a sub that is a number"
assert_str "error: jwt: the jti claim is a JSON object, not a string", at("{\"jti\":{}}", now), "a jti that is an object"
assert_str "error: jwt: the token carries no exp claim, which is required", at("{\"sub\":\"a\"}", now, required: ["sub", "exp"]), "a required claim missing"
assert_str "error: jwt: the token carries no exp claim, which is required", at("{\"exp\":null}", now, required: ["exp"]), "a required claim null"
puts "  exp, nbf and iat at the second and with leeway, fractions, aud, iss, sub, jti and required claims"

puts "\n== JWK read and written"
[rsa_private, a3, ed_private, oct, public_set[0]].each_with_index do |k, i|
  assert_str k.to_json, key(k.to_json).to_json, "JWK #{i} read back as it was written"
  assert_str k.thumbprint, key(k.to_json).thumbprint, "JWK #{i}'s thumbprint read back"
end
assert_true !rsa_private.public.to_json.includes?("\"d\""), "the RSA key's public half has no d"
assert_str rsa_public.to_json, rsa_private.public.to_json, "the cookbook's private key's public half is its public key"
assert_str "{\"kty\":\"oct\",\"k\":\"AQID\",\"kid\":\"k1\",\"alg\":\"HS256\",\"use\":\"sig\",\"key_ops\":[\"sign\",\"verify\"]}",
  key("{\"key_ops\":[\"sign\",\"verify\"],\"use\":\"sig\",\"alg\":\"HS256\",\"kid\":\"k1\",\"k\":\"AQID\",\"kty\":\"oct\",\"x-other\":1}").to_json, "members kept, the unknown passed over"
leading = with_member(COOKBOOK_RSA_PUBLIC, "n", [0_u8] + member(COOKBOOK_RSA_PUBLIC, "n"))
assert_str "error: jwt: the JWK member n has a leading zero byte, which RFC 7518 section 6.3 rules out", said(JWK.parse(leading)), "an RSA n with a leading zero byte"
short_x = member(A3_JWK, "x")
assert_str "error: jwt: the JWK member x is 31 bytes, not the curve's 32", said(JWK.parse(with_member(A3_JWK, "x", short_x[1, 31]))), "an EC x short of its width"
assert_str "error: jwt: ecdsa: a point that is not on P256", said(JWK.parse(replace(A3_JWK, "f83OJ", "f83OK"))), "an EC point off the curve"
qi = member(COOKBOOK_RSA_PRIVATE, "qi")
qi_bent = with_member(COOKBOOK_RSA_PRIVATE, "qi", qi[0, qi.size - 1] + [qi[qi.size - 1] ^ 2_u8])
assert_str "error: jwt: an RSA private key whose qi is not the inverse of q mod p", said(JWK.parse(qi_bent)), "a qi that is not q's inverse"
dp = member(COOKBOOK_RSA_PRIVATE, "dp")
assert_str "error: jwt: an RSA private key whose dp is not d mod (p - 1)", said(JWK.parse(with_member(COOKBOOK_RSA_PRIVATE, "dp", dp[0, dp.size - 1] + [dp[dp.size - 1] ^ 2_u8]))), "a dp that is not d's"
assert_str "error: jwt: an RSA private JWK without all of p, q, dp, dq and qi, which this signs with",
  said(JWK.parse(before(COOKBOOK_RSA_PRIVATE, ",\"p\":") + "}")), "an RSA d alone"
assert_str "error: jwt: an RSA JWK with oth, the primes past two, which this does not take", said(JWK.parse(replace(COOKBOOK_RSA_PRIVATE, "{", "{\"oth\":[],"))), "oth"
assert_str "error: jwt: a JWK of kty \"DSA\", which is not oct, RSA, EC or OKP", said(JWK.parse("{\"kty\":\"DSA\"}")), "an unknown kty"
assert_str "error: jwt: the JWK member k is padded with =, which base64url in a JWS leaves out (RFC 7515 section 2)", said(JWK.parse("{\"kty\":\"oct\",\"k\":\"AQ==\"}")), "a padded k"
assert_str "error: jwt: the JWK is a JSON array, not an object", said(JWK.parse("[]")), "a JWK that is an array"
ops_verify = key("{\"kty\":\"oct\",\"k\":\"#{b64(SECRET)}\",\"key_ops\":[\"sign\"]}")
assert_str "error: jwt: the key's key_ops do not include verify", said(JWT.decode(JWT.encode({"a" => 1}, ops_verify, JWTAlgorithm::HS256), ops_verify, HS, now: 0_i64)), "key_ops without verify"
signing_only = key(replace(ED_PRIVATE_JWK, "{", "{\"key_ops\":[\"sign\"],"))
assert_str "{\"a\":1}", said(JWT.decode(JWT.encode({"a" => 1}, signing_only, JWTAlgorithm::EdDSA), signing_only.public, [JWTAlgorithm::EdDSA], now: 0_i64)), "a signing key's public half verifies"
alg_bound = key(THUMBPRINT_JWK)
assert_str "error: jwt: a PS256 token, and the key is for RS256", said(JWT.decode(JWT.encode({"a" => 1}, rsa_private, JWTAlgorithm::PS256), alg_bound, [JWTAlgorithm::PS256], now: 0_i64)), "a key bound to RS256"
puts "  four kinds of key read back as written; the public half, members kept, and eleven malformed keys refused"

puts "\n== the clock is the caller's"
far = JWT.encode({"exp" => Any.new(4102444800_i64)}, a1, JWTAlgorithm::HS256)
assert_str "{\"exp\":4102444800}", said(JWT.decode(far, a1, HS, now: Time.utc.to_unix)), "a token good until 2100 at the present"
assert_str "error: jwt: the token has expired", before(said(JWT.decode(JWT.encode({"exp" => Any.new(1_i64)}, a1, JWTAlgorithm::HS256), a1, HS, now: Time.utc.to_unix)), " ("), "a token of 1970 at the present"
puts "  decoded at Time.utc.to_unix, which the program reads and the module does not"

puts "\nALL CHECKS PASSED"
