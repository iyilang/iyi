# `Tuple` and `NamedTuple` standard extensions for iyi — SPEC.md III.
#
# Architectural finding on Tuple and NamedTuple in iyi's type system:
#
# 1. Heterogeneous Sequences vs. Collection Traits:
#    Crystal's stdlib defines `struct Tuple(*T)` (789 lines) and `struct NamedTuple(**T)`
#    (736 lines), including `Indexable(Union(*T))` and `Comparable(Tuple)`. In iyi:
#    - Collection traits (`Indexable`, `Enumerable`) require a single associated type
#      `type Elem`. A heterogeneous tuple cannot satisfy this without forcing every
#      element access through a runtime union (`Union(*T)`), which destroys unboxed
#      static typing and defeats the primary purpose of tuples.
#    - iyi's trait system does not support variadic type parameters in `impl`
#      declarations (`forall *T` is rejected by the compiler).
#    - The orphan rule (R-3, SPEC.md IV.4) forbids implementing `Indexable` or
#      `Enumerable` for `Tuple` outside the module that defines the trait or the
#      module that defines the type.
#
# 2. What the Compiler Provides:
#    - Syntax, parsing, and LLVM struct layout for tuple literals `{a, b}` and
#      named tuple literals `{k: v}`.
#    - Compile-time type indexing: `tuple[0]` returns `T0`, `tuple[1]` returns `T1`.
#    - Out-of-bounds indexing checked at compile time for integer literal indices.
#    - Macro reflection on tuple types via `T.size` and named tuple types via `T.keys`.
#
# 3. What is Missing for Full Library Expression:
#    - Variadic generic parameters in trait declarations and trait implementations.
#    - Dependent / indexed return types in method signatures (`def [](i : Int32)`
#      returning the i-th type of a type list).
#    - Compiler support for NamedTuple in the prelude: prior to this module,
#      NamedTuple had no `size`, `empty?`, `==`, `each`, or string representation.
#
# 4. What is Implemented Here:
#    - `Tuple`: `self.new(*args : *T)`, `size`, `empty?`, `first`, `first?`, `last`,
#      `last?`, `==`, `same?`, `each`, `each_with_index`, `map`, `to_a`, `to_s`, `inspect`.
#    - `NamedTuple`: `size`, `empty?`, `has_key?`, `==`, `same?`, `each`, `each_value`,
#      `keys`, `values`, `to_s`, `inspect`.

module std/tuple

struct ::Tuple
  # Creates a new Tuple containing the given arguments.
  def self.new(*args : *T)
    args
  end

  # Returns true when the tuple contains zero elements.
  def empty? : Bool
    {{ T.size == 0 }}
  end

  # Returns the first element. Raises if empty.
  def first
    {% if T.size == 0 %}
      raise "first of an empty tuple"
    {% else %}
      self[0]
    {% end %}
  end

  # Returns the first element, or nil if empty.
  def first?
    {% if T.size == 0 %}
      nil
    {% else %}
      self[0]
    {% end %}
  end

  # Returns the last element. Raises if empty.
  def last
    {% if T.size == 0 %}
      raise "last of an empty tuple"
    {% else %}
      self[{{ T.size - 1 }}]
    {% end %}
  end

  # Returns the last element, or nil if empty.
  def last?
    {% if T.size == 0 %}
      nil
    {% else %}
      self[{{ T.size - 1 }}]
    {% end %}
  end

  # Value identity.
  def same?(other : self) : Bool
    self == other
  end

  # Yields each element sequentially.
  def each(&) : Nil
    {% for i in 0...T.size %}
      yield self[{{i}}]
    {% end %}
  end

  # Yields each element alongside its index.
  def each_with_index(&) : Nil
    {% for i in 0...T.size %}
      yield self[{{i}}], {{i}}
    {% end %}
  end

  # Converts the tuple into an Array typed as the union of all element types.
  def to_a
    {% begin %}
      arr = [] of typeof(
        {% for i in 0...T.size %}
          self[{{i}}],
        {% end %}
      )
      {% for i in 0...T.size %}
        arr << self[{{i}}]
      {% end %}
      arr
    {% end %}
  end

  # Returns a new Tuple with each element mapped through the block.
  def map(&)
    {% begin %}
      {
        {% for i in 0...T.size %}
          yield(self[{{i}}]),
        {% end %}
      }
    {% end %}
  end

  # Concatenates two tuples.
  def +(other : Tuple(*U)) forall U
    {% begin %}
      {
        {% for i in 0...T.size %}
          self[{{i}}],
        {% end %}
        {% for i in 0...U.size %}
          other[{{i}}],
        {% end %}
      }
    {% end %}
  end

  # Reverses elements in tuple.
  def reverse
    {% begin %}
      {
        {% for i in 1..T.size %}
          self[{{T.size - i}}],
        {% end %}
      }
    {% end %}
  end
end

struct ::NamedTuple
  # Number of key-value pairs in the named tuple.
  def size : Int32
    {{ T.keys.size }}
  end

  # Returns true when the named tuple contains zero entries.
  def empty? : Bool
    {{ T.keys.size == 0 }}
  end

  # Returns true if the named tuple contains the given key symbol.
  def has_key?(key : Symbol) : Bool
    {% for k in T.keys %}
      return true if key == :{{k.id}}
    {% end %}
    false
  end

  # Compares corresponding values for equality.
  def ==(other : self) : Bool
    {% for key in T.keys %}
      return false unless self[:{{key.id}}] == other[:{{key.id}}]
    {% end %}
    true
  end

  # Value identity.
  def same?(other : self) : Bool
    self == other
  end

  # Yields each key symbol and corresponding value.
  def each(&) : Nil
    {% for key in T.keys %}
      yield :{{key.id}}, self[:{{key.id}}]
    {% end %}
  end

  # Yields each value in order.
  def each_value(&) : Nil
    {% for key in T.keys %}
      yield self[:{{key.id}}]
    {% end %}
  end

  # Returns a Tuple containing the key symbols in order.
  def keys
    {% begin %}
      {
        {% for key in T.keys %}
          :{{key.id}},
        {% end %}
      }
    {% end %}
  end

  # Returns a Tuple containing the values in order.
  def values
    {% begin %}
      {
        {% for key in T.keys %}
          self[:{{key.id}}],
        {% end %}
      }
    {% end %}
  end

  # String representation: `{name: "Alice", age: 30}`.
  def to_s : String
    parts = [] of String
    {% for key in T.keys %}
      parts << "{{key.id}}: " + self[:{{key.id}}].inspect
    {% end %}
    "{" + parts.join(", ") + "}"
  end

  def inspect : String
    to_s
  end
end
