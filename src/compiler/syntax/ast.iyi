      v.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@value == other.value)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
