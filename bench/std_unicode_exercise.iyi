# Exercises `std/unicode`: Unicode general categories, case mapping and
# UTF-8 validity.
#
# Run via:
#     ./bin/iyi run bench/std_unicode_exercise.iyi

module bench/std_unicode_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/unicode::{Unicode}

puts "== letter"
assert_true Unicode.letter?('A'), "A"
assert_true Unicode.letter?('é'), "é"
assert_true !Unicode.letter?('1'), "digit"
assert_true Unicode.number?('3'), "3 is a number"
# Tangut: a `First>`..`Last>` range the table generator joined to the stride
# before it, so only its two ends were letters.
assert_true Unicode.letter?('\u{17001}'), "a Tangut ideograph inside its range"
assert_true Unicode.letter?('\u{18D01}'), "a Tangut supplement ideograph inside its range"
puts "  letter? and number?"

puts "\n== valid"
assert_true Unicode.valid?("café"), "utf-8"
assert_true Unicode.ascii?('A'), "ascii"
puts "  valid UTF-8 and ascii?"

puts "\n== case"
# The Turkic rule is a question about `i` itself, so an ASCII-only string
# gets the same answer as one with a non-ASCII character in it.
turkic = Unicode::CaseOptions::Turkic
assert_str "İ", Unicode.upcase("i", turkic), "turkic upcase of an ascii string"
assert_str "ı", Unicode.downcase("I", turkic), "turkic downcase of an ascii string"
# The Turkic `I` with a combining dot above is the dotted `i`, the dot
# taken in; one character at a time it was `ı` with the dot over it.
assert_str "i", Unicode.downcase("I\u0307", turkic), "turkic downcase of I with a combining dot"
assert_str "ix", Unicode.downcase("I\u0307X", turkic), "and what follows it is lowered as before"
assert_str "İÜ", Unicode.upcase("iü", turkic), "turkic upcase beside a non-ascii letter"
assert_str "I", Unicode.upcase("i"), "plain upcase of i"
# The titlecase digraphs have no row in the upcase table; their uppercase
# is the capital digraph before them, and their titlecase is themselves.
assert_str "Ǆ", Unicode.upcase("ǅ"), "upcase of the Dž digraph"
assert_str "ǇǊǱ", Unicode.upcase("ǈǋǲ"), "upcase of the Lj, Nj and Dz digraphs"
assert_true Unicode.upcase('ǅ') == 'Ǆ', "char upcase of the Dž digraph"
assert_true Unicode.titlecase('ǅ') == 'ǅ', "titlecase of the Dž digraph is itself"
assert_str "ǆ", Unicode.downcase("ǅ"), "downcase of the Dž digraph"
puts "  turkic i on ascii, and the titlecase digraphs"
# The iota-subscript letters titlecase to one code point, which is not
# their two-letter uppercase: `ᾀ` upcases to `ἈΙ` and titlecases to `ᾈ`.
assert_str "ᾈ", Unicode.capitalize("ᾀ"), "titlecase of alpha with psili and ypogegrammeni"
assert_str "ᾼ", Unicode.capitalize("ᾳ"), "titlecase of alpha with ypogegrammeni"
# The first letter is still before the rest when the final sigma is decided.
assert_str "Ας", Unicode.capitalize("ΑΣ"), "final sigma after the capitalized letter"
# And a letter whose titlecase is its multi-point uppercase keeps it.
assert_str "\u02BCN", Unicode.capitalize("\u0149"), "capitalize of n preceded by apostrophe is its uppercase"
assert_str "\u0399\u0308\u0301", Unicode.capitalize("\u0390"), "capitalize of iota with dialytika and tonos is its uppercase"
puts "  one-code-point titlecase and the final sigma after the first letter"

puts "\nALL CHECKS PASSED"
