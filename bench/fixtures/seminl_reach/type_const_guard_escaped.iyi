lib LibC
  fun putchar(value : Int32) : Int32
  fun exit(status : Int32) : NoReturn
end

fun __crystal_personality(version : Int32, actions : Int32, exception_class : UInt64, exception_object : Void*, context : Void*) : Int32
  0
end

fun __crystal_get_exception(ex : Void*) : UInt64
  0_u64
end

fun __crystal_raise(ex : Void*) : NoReturn
  LibC.exit(1)
end

REC_HEAP        = 1376_u64
CLASSES         =       67
PARTITION_BYTES = 2048_u64
TAKEN           =        1

macro emit_escaped_guard
  class EscapedGuard
    REC_HEAP        = 1376_u64
    CLASSES         =       67
    PARTITION_BYTES = 2048_u64
    TAKEN           =      176

    \{% if TAKEN * 8 < REC_HEAP || (TAKEN + CLASSES) * 8 > PARTITION_BYTES %}
      \{% raise "escaped guard must not raise" %}
    \{% end %}

    def self.value : Int32
      TAKEN &- 110
    end
  end
end

emit_escaped_guard
LibC.putchar(EscapedGuard.value)
