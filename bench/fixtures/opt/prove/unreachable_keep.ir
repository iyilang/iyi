; iyi-ir 1
source_filename = "unreachable_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @unreachable_keep(i32 %x) {
entry:
  ret i1 false
dead:
  %value = and i32 %x, 7
  %test = icmp slt i32 %value, 8
  ret i1 %test
}
