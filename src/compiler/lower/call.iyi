module compiler/lower/call

# The port of `visit(Call)` (src/compiler/iyi/codegen/call.cr) for a call to one target def: the
# receiver, if any, is lowered first and is the callee's `self`; the arguments are then lowered in
# order; the callee is found or emitted by `target_def_fun` (fun.iyi), and the call is an ordinary
# call. The specification has no exception tables, so a call is always a plain call and no landing
# pad is made (hosted `codegen_call_or_invoke` without a rescue block).
#
# Ported:
#   - a call to a def in the program, with no receiver: inside an instance method it passes the frame's
#     self (`implicit_owner`, `implicit_self_value`), at the top level it passes none (`codegen_call_node`);
#   - a call on a receiver whose type is a class or a struct or a builtin (`receiver_owner`): the
#     receiver is the callee's `self` (by value for a struct, the object for a class, the value of a
#     builtin), the callee is the method `*Owner#name`, and `self` is a variable of its frame;
#   - a call with a block to a def, with or without a receiver and with no `&block` parameter: the
#     def's body is inlined where the call stands, and each `yield` in it runs the block
#     (`codegen_call_with_block`, hosted call.cr:356, with block.iyi for the yield and the block body).
#     The block's variables are made first, then the def's, and the def's value is the call's value,
#     merged by a phi; a block call whose type is NoReturn ends in `unreachable` (a `NoReturnPhi`);
#   - a body that is a literal, or `self`, is inlined at the call (hosted `try_inline_call`);
#   - an argument that never returns (a NoReturn block call) ends the block before the call, and the
#     call is not emitted (hosted `prepare_call_args`, `return false if @builder.end`);
#   - a call through a `lib`, `LibC.exit(42)`: the fun is declared in the module under the name the
#     lib gives it (`real_name`), with the C calling convention, and called with the arguments the
#     analysis recorded for the call (`MainVisitor#lib_call_target`); a NoReturn call is followed by
#     `unreachable` (hosted `codegen_extern_call` and `codegen_call_or_invoke`).
#   - a lib fun whose C name starts with `llvm.` emits the IR's typed intrinsic, with no
#     declaration or library import (hosted `llvm_intrinsic?`, codegen_lib_intrinsic).
#   - external lib-variable getters and setters load and store the declared C global.
#   - receiverless super uses the dynamic instance self and the recorded defining owner.
# The argument types are the analysed types of the argument nodes, which is how the
# analysed program instantiates a def (main_visitor.iyi, type_method_body). A restriction
# is honoured only when it names the argument's own type.
#
# Refused by name, at the call that reaches them (pending.iyi): previous_def, a call with no receiver inside a class
# method, a call to a method inherited by an implicit self (hosted target_def.owner), a receiver that is a union, a
# virtual type, nil or a metaclass, a method inherited from a superclass (the hosted owner is the
# defining type, and the port does not record it), a getter whose body reads an instance variable
# (hosted `read_instance_var`, waiting on `instance_var_pointer`), default arguments and splats, a
# restriction that converts an argument, a NoReturn def of the program (its `unreachable` is
# with the lib calls' path only), a lib fun or a primitive with a block, a def with a `&block` parameter
# (the hosted fun literal, closures), and a block call that returns void.
#
# The AST node is named `Compiler::Syntax::Ast::Call` because this module is itself
# `compiler/lower/call`, and inside it the name `Call` means this module.

import compiler/syntax/ast::{ASTNode, Block, BoolLiteral, CharLiteral, Def, Generic, InstanceVar, Nop, NilLiteral, NumberLiteral, Out, Path, RespondsTo, SymbolLiteral, Var}
import compiler/ir/function::{Function, Global, TlsModel}
import compiler/ir/inst::{CallConv, Inst}
import compiler/ir/intrinsics::{IntrinsicMatch, intrinsic_match, intrinsic_signature}
import compiler/ir/types::{IrType}
import compiler/ir/values::{Value}
import compiler/lower/block::{NoReturnPhi, alloca_local, join_pointer}
import compiler/lower/locals::{LocalOrder, reset_nil_slot, reset_nilable_locals}
import compiler/lower/closure::{allocate_closure}
import compiler/lower/context::{Lowerer, LowerContext, LowerVar}
import compiler/lower/cast::{assign, to_rhs, type_id_value, upcast, downcast, pointer_of_value, type_id_of_value, mixed_type_id_of_pointer, match_type_id}
import compiler/lower/ensure::{set_ensure_exception_handler}
import compiler/semantic/closures::{ClosureFacts}
import compiler/lower/fun::{block_ended?, def_context_type, target_def_fun, visit_node}
import compiler/lower/helpers::{llvm_nil, load_aligned, store_aligned}
import compiler/lower/pending::{pending_visit_node, refuse_port}
import compiler/lower/phi::{LowerPhi}
import compiler/lower/proc::{make_fun}
import compiler/lower/typer::{passed_by_value?, primitive_kind}
import compiler/lower/helpers::{int1}
import compiler/semantic/top_level::{ClassType, EnumType, GenericClassType, LibType, LibFun, MetaclassType, ModuleType, NilType, NoReturnType, NonGenericClassType, NonGenericModuleType, SemanticProgram, TraitType, Type, UnionType, VoidType}
import compiler/lower/instance_var::{self_argument, self_as_value, self_by_pointer?, read_instance_var}
import compiler/lower/primitives::{primitive_name, lower_primitive_call, lower_primitive_with_values, primitive_allocate}
import compiler/lower/abi/aarch64::{check_lib_aggregate}
import compiler/types/types::{MixedUnionType, NilableType, NilableReferenceUnionType, NilableProcType, ProcInstanceType, VirtualType, VirtualMetaclassType, GenericClassInstanceType, GenericClassInstanceMetaclassType, IntegerType, FloatType}
import compiler/syntax/token::{NumberKind}
import compiler/semantic/lib_call::{LibCallTarget}
import compiler/semantic/main_visitor::{DispatchTarget}
import compiler/types/indirection::{TypeIndirection}
import compiler/types/types::{TypeQueries}

# A body that is a literal or nothing (`Nop`, an empty def), which the hosted call inlines (`try_inline_call`:
# `when Nop, NilLiteral, BoolLiteral, CharLiteral, StringLiteral, NumberLiteral, SymbolLiteral`).
pub def literal_body?(body : ASTNode) : Bool
  body.is_a?(Nop) || body.is_a?(NilLiteral) || body.is_a?(BoolLiteral) || body.is_a?(NumberLiteral) || body.is_a?(CharLiteral)
end

def call_args(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Array(ASTNode)
  low.analysed.call_arguments[node]? || node.args
end

def never_made_call?(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Bool
  if obj = node.obj
    return true if low.analysed.type_of?(obj).is_a?(NoReturnType)
  end
  return true if node.args.any? { |arg| low.analysed.type_of?(arg).is_a?(NoReturnType) }
  if named = node.named_args
    return true if named.any? { |arg| low.analysed.type_of?(arg.value).is_a?(NoReturnType) }
  end
  false
end

def lower_never_made_operand(low : Lowerer, operand : ASTNode) : Bool
  wants = low.needs_value
  low.needs_value = true
  visit_node(low, operand)
  low.needs_value = wants
  return false unless block_ended?(low) || low.analysed.type_of?(operand).is_a?(NoReturnType)
  low.builder.unreachable unless block_ended?(low)
  low.last = llvm_nil(low)
  true
end

# Hosted cleanup_transformer.cr:700-718 retains only the operands evaluated
# before the first NoReturn one. Such a call has no target definition.
def lower_never_made_call(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Nil
  if obj = node.obj
    return if lower_never_made_operand(low, obj)
  end
  node.args.each do |arg|
    return if lower_never_made_operand(low, arg)
  end
  if named = node.named_args
    named.each do |arg|
      return if lower_never_made_operand(low, arg.value)
    end
  end
  raise "BUG: a never-made call has no NoReturn operand"
end

pub def codegen_call_node(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Nil
  ret_type = low.analysed.type_of?(node)
  if ret_type.nil?
    refuse_untyped_call_probe(low, node)
    raise "BUG: the analysed program has no type for the call to #{node.name} (hosted call.cr: visit(Call))" if ret_type.nil?
  end
  ret = ret_type.as(Type)

  # A call on a lib takes its target from the lib call record, not from a def: the fun has no body to
  # target (hosted `target_def` of an External). The record is read by codegen_lib_call.
  unless low.analysed.lib_call_target(node).nil?
    unless node.block.nil?
      pending_visit_node("a block passed to a lib fun (hosted call.cr: codegen_extern_call)")
    end
    codegen_lib_call(low, node, ret)
    return
  end
  if never_made_call?(low, node)
    lower_never_made_call(low, node)
    return
  end

  dispatch = low.analysed.dispatch_targets?(node)
  if dispatch && dispatch.size > 1
    codegen_dispatch(low, node, ret, dispatch)
    return
  end
  single_dispatch : DispatchTarget? = nil
  if dispatch && dispatch.size == 1
    single_dispatch = dispatch[0]
  end

  target = low.analysed.target_def?(node)
  raise "BUG: the call to #{node.name} has no target def (hosted call.cr: visit(Call))" if target.nil?
  def_node = single_dispatch ? single_dispatch.as(DispatchTarget).definition : target.as(Def)

  # Only an implementer answers an abstract call; its Nop body must never inline nil.
  if def_node.abstract
    pending_visit_node("a call to the abstract def #{def_node.name}, which only an implementer answers (hosted call.cr: trait dispatch)")
  end

  # Proc#call's splat is the primitive's argument list, validated against the
  # Proc type by codegen_primitive_proc_call. Other unexpanded calls still refuse.
  primitive = primitive_name(def_node.body)
  if node.obj.nil? && node.super? && !primitive.nil?
    pending_visit_node("super to the primitive #{primitive} (hosted call.cr: codegen_primitive with the scope as owner)")
  end
  if single_dispatch && !primitive.nil? && !single_dispatch.as(DispatchTarget).receiver.is_a?(VirtualType) && !single_dispatch.as(DispatchTarget).receiver.is_a?(VirtualMetaclassType)
    pending_visit_node("a primitive dispatched on trait receiver #{single_dispatch.as(DispatchTarget).receiver.full_name} (hosted call.cr: trait dispatch)")
  end
  if primitive && low.analysed.call_arguments[node]?
    pending_visit_node("a primitive called with named arguments or an omitted magic default (hosted cleanup_transformer.cr:776-783)")
  end
  if (call_args(low, node).size != def_node.args.size || def_node.splat_index != nil) && primitive != "proc_call"
    pending_visit_node("a call with default arguments or a splat (hosted call.cr)")
  end
  unless primitive.nil?
    unless node.block.nil?
      pending_visit_node("a block passed to a primitive (hosted call.cr: codegen_call, Primitive body)")
    end
    if node.obj.nil? && primitive == "allocate"
      # `_ = allocate` in a class method (the generated `new`): the instance type is the class method's context
      # type (fun.iyi class_owner). The pointer to the zeroed instance is loaded as the struct value, which is
      # what `_` holds (hosted allocate returns the value; primitive_allocate returns the pointer).
      owner = low.current_context.type
      if owner.nil?
        pending_visit_node("allocate outside a class method (hosted codegen_primitive_allocate, the instance type)")
      end
      inst = owner.as(Type)
      # Hosted prepare_call_args reads the generic metaclass self before dispatching
      # the allocate primitive, even though allocation itself does not use it.
      type_id_value(low, inst) if inst.is_a?(GenericClassInstanceMetaclassType)
      ptr = primitive_allocate(low, inst)
      if block_ended?(low)
        low.last = nil
        return
      end
      allocated_type = inst.is_a?(MetaclassType) ? inst.as(MetaclassType).instance_type : inst
      # A class's `_` holds the pointer itself (hosted allocate of a reference type); a struct's holds the value
      # loaded from the zeroed instance.
      if passed_by_value?(allocated_type)
        low.last = load_aligned(low, low.typer.llvm_type(allocated_type), ptr, "")
      else
        low.last = ptr
      end
      return
    end
    lower_primitive_call(low, node, def_node)
    return
  end

  if node.previous_def?
    pending_visit_node("previous_def (hosted call.cr: lookup_previous_def_matches)")
  end
  if node.obj.nil? && node.super? && low.current_context.vars["self"]?.nil?
    pending_visit_node("super with no instance self (hosted call.cr:30: a super call's owner is the scope)")
  end

  # The receiver is evaluated before the arguments (hosted `prepare_call_args`), and is the callee's self.
  # A non-generic metaclass receiver (`Sched.go`) passes no self and is not evaluated (hosted `passed_as_self?`
  # is false and the path is not a target const); its method is named after the class (`class_owner`).
  self_type : Type? = nil
  self_value : Value? = nil
  class_owner : Type? = nil
  program_target = false
  unless node.obj.nil?
    recv_type = single_dispatch ? single_dispatch.as(DispatchTarget).receiver : receiver_owner(low, node)
    if single_dispatch && !recv_type.is_a?(VirtualType)
      recv_type = checked_dispatch_receiver(low, node, recv_type, single_dispatch.as(DispatchTarget).definition)
    end
    if recv_type.is_a?(GenericClassInstanceMetaclassType)
      self_type = recv_type
      inferred_receiver = low.analysed.call_receiver?(node)
      if inferred_receiver || node.obj.as(ASTNode).is_a?(Generic)
        if inferred_receiver && !node.obj.as(ASTNode).is_a?(Path)
          lower_receiver(low, node)
          return if block_ended?(low)
        end
        self_value = type_id_value(low, recv_type)
      else
        self_value = lower_receiver(low, node)
        return if block_ended?(low)
      end
    elsif recv_type.is_a?(MetaclassType)
      class_owner = recv_type.as(MetaclassType).instance_type
      # A computed metaclass receiver is evaluated even when its value is not
      # passed as self (hosted prepare_call_args, call.cr:69-82).
      unless node.obj.as(ASTNode).is_a?(Path)
        lower_receiver(low, node)
        return if block_ended?(low)
      end
    else
      self_type = recv_type
      # Hosted prepare_call_args visits the receiver before try_inline_call: an inlined literal body reads the receiver
      # (the hosted module loads it) and never uses self, so only the receiver is evaluated and no self value is made.
      # A block call still needs self for its frame, so it takes the self path.
      if literal_body?(def_node.body) && node.block.nil?
        discard_receiver(low, node)
      else
        if recv_type.is_a?(NilType)
          lower_receiver(low, node)
          return if block_ended?(low)
          self_value = low.builder.const_zero(low.typer.nil_type)
        elsif storage = receiver_storage(low, node, self_type.as(Type))
          self_value = storage.as(Value)
        else
          recv = lower_receiver(low, node)
          self_value = self_argument(low, node.obj.as(ASTNode), recv, self_type.as(Type))
        end
      end
    end
  end
  if node.obj.nil? && !node.super?
    if defining = low.analysed.program.def_owner(def_node)
      if defining.is_a?(ModuleType) && defining.as(ModuleType).iyi_unit
        class_owner = defining
      elsif defining.object_id == low.analysed.program.object_id
        program_target = true
      end
    end
  end
  if node.obj.nil? && !program_target && class_owner.nil? && !low.current_context.type.nil?
    ct = low.current_context.type.as(Type)
    if low.current_context.vars["self"]?.nil?
      # A non-generic class method has no self argument. An unqualified call to
      # another method on its own metaclass uses the same class owner.
      if (ct.is_a?(NonGenericClassType) || ct.is_a?(NonGenericModuleType) || ct.is_a?(EnumType)) && !ct.is_a?(NilType)
        if ct.as(ModuleType).metaclass.defs[node.name]?
          class_owner = ct
        elsif target = low.analysed.target_def?(node)
          if class_defining = low.analysed.program.def_owner(target)
            class_owner = ct if class_defining
          end
        end
        if class_owner.nil? && !low.analysed.program.defs[node.name]?
          pending_visit_node("a class method #{node.name} inherited from a superclass of #{ct.full_name} (hosted call.cr: target_def.owner is the defining type)")
        end
      elsif class_meta = receiverless_class_metaclass(ct)
        # Hosted call.cr:85-95: a generic metaclass is passed as self. The frame
        # has no runtime self, so llvm_self synthesizes the type id of the
        # metaclass context (codegen.cr:2491-2496, fun.cr:289).
        if defines_method?(class_meta, node.name) || receiverless_class_target?(low, node)
          self_type = class_meta
          self_value = type_id_value(low, class_meta)
        elsif !low.analysed.program.defs[node.name]?
          pending_visit_node("a class method #{node.name} inherited from a superclass of #{class_meta.full_name} (hosted call.cr: target_def.owner is the defining type)")
        end
      else
        pending_visit_node("a call to #{node.name} with no receiver inside a generic or builtin class method (hosted call.cr: prepare_call_args, the metaclass owner)")
      end
    else
      owner = implicit_owner(low, node)
      self_type = owner
      self_value = implicit_self_value(low) unless owner.nil?
    end
  end

  if block = node.block
    arg_types, values = lower_args(low, node, def_node)
    # Hosted `visit(Call)`: an argument that never returns leaves the block ended, and the call is not made.
    if block_ended?(low)
      low.last = llvm_nil(low)
      return
    end
    if (literal = block.fun_literal) && def_node.uses_block_arg?
      wants = low.needs_value
      low.needs_value = true
      visit_node(low, literal)
      low.needs_value = wants
      if block_ended?(low)
        low.last = llvm_nil(low)
        return
      end
      value = low.last
      raise "BUG: captured block literal produced no value" if value.nil?
      values << value.as(Value)
      func = target_def_fun(low, def_node, self_type, arg_types, ret, class_owner)
      emit_def_call(low, node, func, self_value, values, ret)
    else
      codegen_call_with_block(low, node, block.as(Block), def_node, ret, self_type, self_value, arg_types, values, class_owner)
    end
    return
  end

  arg_types, values = lower_args(low, node, def_node)
  if block_ended?(low)
    low.last = llvm_nil(low)
    return
  end
  emit_single_call(low, node, def_node, ret, self_type, self_value, class_owner, arg_types, values)
end

# Emit one already-prepared arm, sharing the hosted inline cases with ordinary calls.
def emit_single_call(low : Lowerer, node : Compiler::Syntax::Ast::Call, def_node : Def, ret : Type, self_type : Type?, self_value : Value?, class_owner : Type?, arg_types : Array(Type), values : Array(Value)) : Nil
  body = def_node.body
  if literal_body?(body)
    if ret.is_a?(NilType)
      low.last = llvm_nil(low)
    elsif low.needs_value
      visit_node(low, body)
    end
    return
  end
  if body.is_a?(Var) && body.as(Var).name == "self" && (!self_type.nil? || !class_owner.nil?)
    if st = self_type
      if ret.full_name != st.full_name
        pending_visit_node("a call to #{node.name} whose body is self and whose type is #{ret.full_name} (hosted upcast of self)")
      end
      if low.needs_value
        if sv = self_value
          low.last = self_as_value(low, sv.as(Value), st)
        end
      end
    elsif co = class_owner
      unless co.is_a?(ModuleType)
        pending_visit_node("a class method #{node.name} whose body is self on #{co.full_name} (hosted type_id of the metaclass)")
      end
      meta = co.as(ModuleType).metaclass
      if ret.full_name != meta.full_name
        pending_visit_node("a class method #{node.name} whose body is self and whose type is #{ret.full_name} (hosted type_id of the metaclass)")
      end
      if low.needs_value
        low.last = type_id_value(low, meta)
      end
    end
    return
  end
  if body.is_a?(InstanceVar)
    st = self_type
    sv = self_value
    if st.nil? || sv.nil?
      pending_visit_node("a getter #{node.name} with no receiver (hosted call.cr: try_inline_call, read_instance_var)")
    end
    if low.needs_value
      node_t = low.analysed.type_of?(body)
      raise "BUG: the analysed program has no type for instance variable #{body.name} (hosted call.cr: try_inline_call)" if node_t.nil?
      if ret.full_name != node_t.as(Type).full_name
        pending_visit_node("a getter #{node.name} whose variable is #{node_t.as(Type).full_name} and whose call is #{ret.full_name} (hosted upcast, inline_call_return_value)")
      end
      low.last = read_instance_var(low, node_t.as(Type), st.as(Type), body.name, sv.as(Value))
    else
      low.last = llvm_nil(low)
    end
    return
  end
  func = target_def_fun(low, def_node, self_type, arg_types, ret, class_owner)
  emit_def_call(low, node, func, self_value, values, ret)
end

def codegen_dispatch(low : Lowerer, node : Compiler::Syntax::Ast::Call, ret : Type, targets : Array(DispatchTarget)) : Nil
  obj = node.obj
  runtime_type : Type = low.analysed.program
  if receiver_node = obj
    obj_type = low.analysed.type_of?(receiver_node)
    raise "BUG: dispatched receiver has no type" if obj_type.nil?
    runtime_type = TypeIndirection.remove_indirection(obj_type.as(Type))
  elsif context_type = low.current_context.type
    runtime_type = TypeIndirection.remove_indirection(context_type)
  end
  unless node.block.nil?
    pending_visit_node("a call dispatched over #{runtime_type.full_name} with a block (hosted call.cr: codegen_dispatch)")
  end
  if node.super? || node.previous_def?
    pending_visit_node("super or previous_def dispatched over #{runtime_type.full_name}")
  end
  arguments = call_args(low, node)
  receiver_dynamic = runtime_type.is_a?(UnionType) || runtime_type.is_a?(VirtualType)
  arg_types = [] of Type
  arguments.each do |arg|
    t = low.analysed.type_of?(arg)
    raise "BUG: dispatched argument has no type" if t.nil?
    at = t.as(Type)
    arg_types << at
  end
  targets.each do |arm|
    global_arm = node.obj.nil? && arm.receiver.is_a?(SemanticProgram)
    checked_dispatch_receiver(low, node, arm.receiver, arm.definition) if receiver_dynamic && !arm.receiver.is_a?(VirtualType) && !global_arm
    if arm.definition.abstract
      pending_visit_node("a dispatched abstract def #{arm.definition.name} on #{arm.receiver.full_name}")
    end
    if prim = primitive_name(arm.definition.body)
      if low.analysed.call_arguments[node]?
        pending_visit_node("a primitive called with named arguments or an omitted magic default (hosted cleanup_transformer.cr:776-783)")
      end
      if prim.starts_with?("pointer_") || prim == "load_atomic" || prim == "store_atomic" || prim == "atomicrmw" || prim == "cmpxchg" || prim == "tuple_indexer_known_index" || prim == "enum_new"
        pending_visit_node("a dispatched primitive def #{arm.definition.name} on #{arm.receiver.full_name} requires AST operands")
      end
    end
    if arguments.size != arm.definition.args.size || !arm.definition.splat_index.nil?
      pending_visit_node("a dispatched call with default arguments or a splat")
    end
  end
  wants = low.needs_value
  receiver : Value? = nil
  class_owner : Type? = nil
  if receiver_node = obj
    if runtime_type.is_a?(MetaclassType) && !runtime_type.is_a?(GenericClassInstanceMetaclassType)
      class_owner = runtime_type.as(MetaclassType).instance_type
      unless receiver_node.is_a?(Path)
        lower_receiver(low, node)
        return if block_ended?(low)
      end
    elsif runtime_type.is_a?(GenericClassInstanceMetaclassType)
      receiver = type_id_value(low, runtime_type)
    elsif receiver_dynamic
      slot = dispatch_receiver_storage(low, receiver_node, runtime_type)
      if storage = slot
        receiver = storage
      else
        receiver = lower_receiver(low, node)
        if block_ended?(low)
          low.last = llvm_nil(low)
          return
        end
        if passed_by_value?(runtime_type)
          receiver = pointer_of_value(low, receiver_node, receiver.as(Value), runtime_type)
        end
      end
    else
      value = lower_receiver(low, node)
      return if block_ended?(low)
      receiver = runtime_type.is_a?(NilType) ? low.builder.const_zero(low.typer.nil_type).as(Value) : self_argument(low, receiver_node, value, runtime_type)
    end
  elsif low.current_context.vars["self"]?
    receiver = implicit_self_value(low)
  elsif context_type = low.current_context.type
    if class_meta = receiverless_class_metaclass(context_type)
      runtime_type = class_meta
      receiver = type_id_value(low, class_meta)
    else
      class_owner = context_type
    end
  end
  tid : Value
  if value = receiver
    source_node = obj || node
    tid = runtime_type.is_a?(MixedUnionType) ? mixed_type_id_of_pointer(low, value, runtime_type) : type_id_of_value(low, source_node, value, runtime_type)
  else
    raise "BUG: dispatched self has no value" if receiver_dynamic
    type_id_value(low, runtime_type) if obj.nil?
    tid = type_id_value(low, runtime_type)
  end
  values = [] of Value
  arg_tids = [] of Value
  arguments.each_with_index do |arg, i|
    low.needs_value = true
    visit_node(low, arg)
    if block_ended?(low)
      low.needs_value = wants
      low.last = llvm_nil(low)
      return
    end
    value = low.last
    raise "BUG: dispatched argument left no value" if value.nil?
    raw = value.as(Value)
    if arg_types[i].is_a?(MixedUnionType)
      raw = pointer_of_value(low, arg, raw, arg_types[i])
    end
    arg_tids << type_id_of_value(low, arg, raw, arg_types[i])
    values << (arg_types[i].is_a?(NilType) ? low.builder.const_zero(low.typer.nil_type).as(Value) : raw)
  end
  phi_wants = wants && !ret.is_a?(NilType) && !ret.is_a?(VoidType) && !ret.is_a?(NoReturnType)
  phi_type : IrType? = nil
  phi_type = passed_by_value?(ret) ? low.module.types.ptr(0) : low.typer.llvm_type(ret) if phi_wants
  phi = LowerPhi.new(phi_wants, phi_type)
  targets.each do |arm|
    matches = int1(low, 1_i64)
    unit_call = false
    if node.obj.nil?
      if defining = low.analysed.program.def_owner(arm.definition)
        unit_call = defining.is_a?(ModuleType) && defining.as(ModuleType).iyi_unit
      end
    end
    unless unit_call || arm.receiver.is_a?(SemanticProgram)
      matches = match_type_id(low, runtime_type, arm.receiver, tid)
    end
    params = arm.arg_types || arg_types
    i = 0
    while i < arg_types.size
      unless dispatch_autocast?(arguments[i], arg_types[i])
        matches = low.builder.bitwise_and(matches, match_type_id(low, arg_types[i], params[i], arg_tids[i]))
      end
      i += 1
    end
    blocks = low.new_blocks(["current_def", "next_def"])
    low.builder.cond_br(matches, blocks[0], blocks[1])
    low.builder.position_at_end(blocks[0])
    self_value = receiver
    if arm.receiver.is_a?(SemanticProgram) && node.obj.nil?
      self_value = nil
    elsif receiver_dynamic
      concrete = downcast(low, receiver.as(Value), arm.receiver, runtime_type, true)
      if arm.receiver.is_a?(NilType)
        self_value = low.builder.const_zero(low.typer.nil_type)
      elsif receiver_node = obj
        self_value = self_argument(low, receiver_node, concrete, arm.receiver)
      else
        self_value = concrete
      end
    end
    arm_class_owner = class_owner
    if node.obj.nil?
      if defining = low.analysed.program.def_owner(arm.definition)
        if defining.is_a?(ModuleType) && defining.as(ModuleType).iyi_unit
          arm_class_owner = defining
          self_value = nil
        end
      end
    end
    arm_values = [] of Value
    i = 0
    while i < values.size
      passed = values[i]
      if arg_types[i].full_name != params[i].full_name
        if numeric_literal_autocast?(arguments[i], arg_types[i], params[i])
          passed = lib_number_value(low, arguments[i].as(NumberLiteral), params[i])
        else
          passed = downcast(low, passed, params[i], arg_types[i], true)
        end
      end
      passed = to_rhs(low, passed, params[i]) if passed_by_value?(params[i]) && passed.type.pointer?
      arm_values << passed
      i += 1
    end
    low.needs_value = phi_wants
    if prim = primitive_name(arm.definition.body)
      raise "BUG: dispatched primitive has no self" if self_value.nil?
      prim_values = [self_value.as(Value)] of Value
      arm_values.each do |value|
        prim_values << value
      end
      lower_primitive_with_values(low, node, arm.definition, prim, self_value.as(Value), arm.receiver, prim_values, params)
    else
      self_type : Type? = self_value.nil? ? nil : arm.receiver
      emit_single_call(low, node, arm.definition, arm.return_type, self_type, self_value, arm_class_owner, params, arm_values)
    end
    unless block_ended?(low)
      if phi_wants
        value = low.last
        raise "BUG: dispatched arm left no value" if value.nil?
        low.last = passed_by_value?(ret) ? join_pointer(low, value.as(Value), arm.return_type, ret) : upcast(low, value.as(Value), arm.return_type, ret)
      end
      phi.add(low, low.last, false)
    end
    low.builder.position_at_end(blocks[1])
  end
  low.builder.unreachable
  phi.close(low)
  low.needs_value = wants
end

def numeric_literal_autocast?(node : ASTNode, from : Type, to : Type) : Bool
  from_kind = primitive_kind(from)
  to_kind = primitive_kind(to)
  node.is_a?(NumberLiteral) && (from_kind == "int" || from_kind == "float") && (to_kind == "int" || to_kind == "float")
end

# Hosted supports_autocast? with number autocasting enabled. The hosted
# IntegerType test compares bytesize to 64, so its 128-bit integers qualify too.
def dispatch_autocast?(node : ASTNode, type : Type) : Bool
  return true if node.is_a?(NumberLiteral) || node.is_a?(SymbolLiteral)
  return type.as(IntegerType).bytes <= 64 if type.is_a?(IntegerType)
  return type.as(FloatType).bytes == 4 if type.is_a?(FloatType)
  kind = primitive_kind(type)
  kind == "int" || (kind == "float" && type.full_name == "Float32")
end

# Hosted reads an aggregate local as its storage, rather than loading it.
def dispatch_receiver_storage(low : Lowerer, obj : ASTNode, runtime_type : Type) : Value?
  return nil unless passed_by_value?(runtime_type) && obj.is_a?(Var)
  slot = low.current_context.vars[obj.as(Var).name]?
  return nil if slot.nil?
  lv = slot.as(LowerVar)
  return nil if lv.already_loaded
  return nil if TypeIndirection.trait_value_type(lv.type).full_name != runtime_type.full_name
  lv.pointer
end

# Emit the call after its receiver, arguments and optional captured block are evaluated.
pub def emit_def_call(low : Lowerer, node : Compiler::Syntax::Ast::Call, func : Function, self_value : Value?, values : Array(Value), ret : Type) : Nil
  inst = low.builder.call(func.fn_type, func, call_arguments(self_value, values), "")
  # Hosted codegen_call_or_invoke: a NoReturn call ends its block with `unreachable`, and its value is nil.
  if ret.is_a?(NoReturnType)
    low.builder.unreachable
    low.last = llvm_nil(low)
  elsif ret.is_a?(NilType)
    low.last = llvm_nil(low)
  elsif passed_by_value?(ret)
    # Hosted codegen_call (call.cr:707-713): a wanted by-value result is the address of its spill.
    if low.needs_value
      ir = low.typer.llvm_type(ret)
      temp = low.alloca(ir, "")
      store_aligned(low, inst, temp)
      low.spill_node = node.object_id
      low.spill_slot = temp
      if low.receiver_unused == node.object_id
        low.last = llvm_nil(low)
      else
        low.last = temp
      end
    else
      low.last = llvm_nil(low)
    end
  else
    low.last = inst
  end
end

# Hosted fun.cr:289 keeps a class method's context as the metaclass. A generic
# metaclass is passed as self (types.cr passed_as_self?); a frame with no runtime
# self still calls through that owner (codegen.cr:2496). A non-generic class
# method keeps the instance context the existing fixtures lower.
def receiverless_class_metaclass(ct : Type) : Type?
  if ct.is_a?(GenericClassInstanceMetaclassType)
    return ct
  end
  nil
end

# The analysed target's defining owner, when the metaclass's own defs do not
# name the method (hosted target_def.owner is the defining type).
def receiverless_class_target?(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Bool
  if target = low.analysed.target_def?(node)
    return !low.analysed.program.def_owner(target).nil?
  end
  false
end

# An implicit method uses the caller's self even when the def was inherited.
# A program-level def takes no self. The analysed target's defining scope
# distinguishes them without guessing from methods sharing the same name.
pub def implicit_owner(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Type?
  ct = low.current_context.type.as(Type)
  if low.current_context.vars["self"]?.nil?
    pending_visit_node("a call to #{node.name} with no receiver inside a class method (hosted call.cr: prepare_call_args, the metaclass owner)")
  end
  if target = low.analysed.target_def?(node)
    if defining = low.analysed.program.def_owner(target)
      return ct unless defining.object_id == low.analysed.program.object_id
      return nil
    end
  end
  if defines_method?(ct, node.name)
    return ct
  end
  if low.analysed.program.defs[node.name]?
    return nil
  end
  pending_visit_node("a call to #{node.name} inherited from a superclass of #{ct.full_name} (hosted call.cr: target_def.owner is the defining type)")
  nil
end

# Whether a type's own defs name a method. A generic instance's defs are its generic class's.
pub def defines_method?(t : Type, name : String) : Bool
  if t.is_a?(GenericClassInstanceType)
    return !t.as(GenericClassInstanceType).generic_type.as(ModuleType).defs[name]?.nil?
  end
  if t.is_a?(ModuleType)
    return !t.as(ModuleType).defs[name]?.nil?
  end
  false
end

# The self of an implicit-self call: the frame's self as the callee takes it, a struct's address or a class's object.
pub def implicit_self_value(low : Lowerer) : Value
  sv = low.current_context.vars["self"]?
  raise "BUG: an implicit self call with no self variable (hosted llvm_self)" if sv.nil?
  sv.as(LowerVar).pointer
end

# The receiver's type is the method's owner (hosted `target_def.owner`).
# Class, module and enum metaclasses use their class-method owner; instance
# receivers are checked against the analysed target below.
pub def receiver_owner(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Type
  if recorded = low.analysed.call_receiver?(node)
    return recorded
  end
  obj = node.obj
  raise "BUG: receiver_owner on a call with no receiver (hosted call.cr: prepare_call_args)" if obj.nil?
  t = low.analysed.type_of?(obj.as(ASTNode))
  raise "BUG: the analysed program has no type for the receiver of #{node.name} (hosted call.cr: prepare_call_args)" if t.nil?
  owner = t.as(Type)
  if owner.is_a?(MetaclassType)
    if owner.is_a?(GenericClassInstanceMetaclassType)
      return owner
    end
    # A class method of a non-generic class, module or enum passes no self.
    # The analysed target can also name a def inherited by the metaclass.
    inst = owner.as(MetaclassType).instance_type
    if inst.is_a?(GenericClassType)
      pending_visit_node("the receiver of #{node.name} is the uninstantiated generic #{owner.full_name}: typing has not instantiated the owner")
    end
    unless (inst.is_a?(NonGenericClassType) || inst.is_a?(NonGenericModuleType) || inst.is_a?(EnumType)) && !inst.is_a?(NilType)
      pending_visit_node("a class method call on #{owner.full_name} (hosted call.cr: prepare_call_args, a generic or builtin metaclass)")
    end
    if owner.as(MetaclassType).defs[node.name]?.nil?
      if target = low.analysed.target_def?(node)
        if class_defining = low.analysed.program.def_owner(target)
          return owner if class_defining
        end
      end
      pending_visit_node("a class method #{node.name} inherited from a superclass of #{owner.full_name} (hosted call.cr: target_def.owner is the defining type)")
    end
    return owner
  end
  return checked_receiver(low, node, owner, low.analysed.target_def?(node))
end

def checked_dispatch_receiver(low : Lowerer, node : Compiler::Syntax::Ast::Call, owner : Type, target : Def?) : Type
  if owner.is_a?(MetaclassType) || (owner.is_a?(ModuleType) && !owner.is_a?(ClassType) && !owner.is_a?(EnumType))
    pending_visit_node("a dispatched call on unsupported receiver #{owner.full_name}")
  end
  checked_receiver(low, node, owner, target)
end

def checked_receiver(low : Lowerer, node : Compiler::Syntax::Ast::Call, owner : Type, target : Def?) : Type
  return owner if owner.is_a?(NilType)
  if owner.is_a?(TraitType)
    pending_visit_node("a call on trait #{owner.full_name} (hosted call.cr: trait dispatch)")
  end
  if owner.is_a?(UnionType) || owner.is_a?(MixedUnionType) || owner.is_a?(VirtualType) || owner.is_a?(NilableType) || owner.is_a?(NilableReferenceUnionType) || owner.is_a?(NilableProcType)
    pending_visit_node("a call on a receiver of type #{owner.full_name} (hosted call.cr: prepare_call_args, owner is not a class or struct)")
  end
  if owner.is_a?(ModuleType)
    if owner.as(ModuleType).defs[node.name]?.nil?
      if target
        return owner if low.analysed.program.def_owner(target)
      end
      pending_visit_node("a call to #{node.name} inherited from a superclass of #{owner.full_name} (hosted call.cr: target_def.owner is the defining type)")
    end
  end
  owner
end

# The receiver's value, evaluated as the hosted `request_value(obj)` does: the value the receiver
# expression left, with its value wanted.
pub def lower_receiver(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Value
  obj = node.obj
  raise "BUG: lower_receiver on a call with no receiver (hosted call.cr: prepare_call_args)" if obj.nil?
  wants = low.needs_value
  low.needs_value = true
  low.spill_node = 0_u64
  prev_receiver = low.receiver_node
  low.receiver_node = obj.object_id
  visit_node(low, obj.as(ASTNode))
  low.receiver_node = prev_receiver
  low.needs_value = wants
  v = low.last
  raise "BUG: the receiver of #{node.name} left no value (hosted call.cr: prepare_call_args)" if v.nil?
  v.as(Value)
end

# The receiver of a call whose body is an inlined literal: the hosted prepare_call_args visits the receiver, and the
# literal never reads self. The receiver's call is made and its struct result is spilled, but no value is read back.
pub def discard_receiver(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Nil
  obj = node.obj
  raise "BUG: discard_receiver on a call with no receiver (hosted call.cr: prepare_call_args)" if obj.nil?
  o = obj.as(ASTNode)
  # The hosted receiver of an inlined literal is requested as a value (prepare_call_args), but a by-value struct variable
  # is not read where the value is unused (lowprim_alloc_struct: the empty struct's receiver loads nothing). A class
  # variable is read (lowprim_alloc_class).
  if o.is_a?(Var)
    vt = low.analysed.type_of?(o)
    raise "BUG: the analysed program has no type for receiver variable #{o.name} (hosted call.cr: prepare_call_args)" if vt.nil?
    if passed_by_value?(vt.as(Type))
      if slot = low.current_context.vars[o.as(Var).name]?
        # A narrowed local still needs the hosted downcast, even when the
        # inlined body ignores self: it emits the union payload address.
        return if slot.type.full_name == vt.as(Type).full_name
      end
    end
  end
  wants = low.needs_value
  prev_unused = low.receiver_unused
  low.needs_value = true
  low.spill_node = 0_u64
  low.receiver_unused = o.object_id
  visit_node(low, o)
  low.receiver_unused = prev_unused
  low.needs_value = wants
end

# The values a call passes to its function: the receiver first, when there is one, then the arguments.
pub def call_arguments(self_value : Value?, values : Array(Value)) : Array(Value)
  out = [] of Value
  if sv = self_value
    out << sv.as(Value)
  end
  values.each do |v|
    out << v
  end
  out
end

# Hosted Phi#add emits unreachable for a NoReturn body or call result. Its
# builder makes that a no-op when the current block already has a terminator.
pub def finish_block_call_body(low : Lowerer, phi : LowerPhi, body_t : Type, ret : Type) : Nil
  if ret.is_a?(NoReturnType) || body_t.is_a?(NoReturnType)
    low.builder.unreachable unless block_ended?(low)
    return
  end
  value = low.last
  if !block_ended?(low) && !value.nil? && !ret.is_a?(NilType)
    if passed_by_value?(ret)
      low.last = join_pointer(low, value.as(Value), body_t, ret)
    else
      low.last = upcast(low, value.as(Value), body_t, ret)
    end
  end
  phi.add(low, low.last, true)
end

# The hosted `codegen_call_with_block` (call.cr:356) for a def that does not use its block argument.
# It may still name or annotate that argument. The arguments and receiver are already evaluated.
# The block sees the caller variables visible where it was written, plus self.
# Its arguments and local declarations get fresh slots, as hosted undef_vars and
# alloca_non_closured_vars require. The def's body is inlined in its own frame: self, arguments and
# locals are bound there, and each `yield` in the body runs the block (block.iyi). The value of the
# body is the call's value, merged by a phi (hosted `Phi.open(self, node)`, which always wants a value).
# Passed-by-value results are merged by address.
# A call whose type is NoReturn merges nothing: its body ends in `unreachable` (`NoReturnPhi`).
pub def codegen_call_with_block(low : Lowerer, node : Compiler::Syntax::Ast::Call, block : Block, def_node : Def, ret : Type, self_type : Type?, self_value : Value?, arg_types : Array(Type), values : Array(Value), class_owner : Type?) : Nil
  set_ensure_exception_handler(low, node)
  if def_node.uses_block_arg?
    pending_visit_node("a call to a def with a &block parameter (hosted call.cr: codegen_call_with_block_as_fun_literal, closures)")
  end
  if ret.is_a?(VoidType)
    pending_visit_node("a block call of type void (hosted codegen_call_with_block, the void result)")
  end
  body_t = low.analysed.type_of?(def_node.body)
  raise "BUG: the analysed program has no type for the body of #{node.name} (hosted call.cr: codegen_call_with_block)" if body_t.nil?

  wants = low.needs_value
  caller = low.current_context
  noreturn = ret.is_a?(NoReturnType)

  # Only names visible where the block was written belong to its caller.
  # A later local may already have an alloca, but it cannot own a block local.
  writer_vars = if owner = low.analysed.block_owners[block]?
                  owner.var_owners
                else
                  nil
                end
  block_vars = Hash(String, LowerVar).new
  if writer_vars
    caller.vars.each do |name, var|
      block_vars[name] = var if name == "self" || writer_vars.has_key?(name)
    end
  else
    place = if location = block.location
              location.to_s
            else
              "<no source location>"
            end
    raise "BUG: block passed to #{def_node.name} at #{place} has no recorded writer variables"
  end
  block_ctx = LowerContext.new(caller.fun, caller.fun_type, caller.type, block_vars)
  block_ctx.top_level = caller.top_level
  if owner = low.analysed.block_owners[block]?
    block_ctx.var_unions = owner.local_storage.unions
    block_ctx.nil_resets = owner.local_storage.nil_resets
  end
  block_ctx.return_type = caller.return_type
  block_ctx.return_phi = caller.return_phi
  block_ctx.return_target = caller.return_target
  block_ctx.block_node = caller.block_node
  block_ctx.block_context = caller.block_context
  block_ctx.copy_closure_from(caller)
  block_ctx.macro_origin = caller.macro_origin
  captured = [] of String
  facts = caller.closure_facts
  block_frame = facts.nil? ? nil : facts.frame?(block.as(ASTNode))
  if bf = block_frame
    bf.closured.each do |var|
      captured << var.name
      block_ctx.vars.delete(var.name)
    end
  end
  allocate_block_vars(low, block, block_ctx.vars, captured)

  # The inlined def's frame (hosted `with_cloned_context`): the block it yields to, the block's
  # context, and the phi the value and the `break`s of the call go to. Passed-by-value results merge
  # addresses, with each value converted by `join_pointer`.
  merge : IrType? = nil
  join : Type? = nil
  unless noreturn
    merge = passed_by_value?(ret) ? low.module.types.ptr(0) : low.typer.llvm_type(ret)
    join = ret
  end
  phi = LowerPhi.new(true, merge, join)
  frame = LowerContext.new(caller.fun, caller.fun_type, def_context_type(self_type, class_owner), Hash(String, LowerVar).new)
  frame.block_node = block
  frame.block_context = block_ctx
  frame.return_target = node
  frame.var_unions = low.analysed.def_var_unions[def_node]?
  frame.nil_resets = low.analysed.def_nil_resets[def_node]?
  if noreturn
    frame.return_phi = NoReturnPhi.new
  else
    frame.return_phi = phi
  end
  low.context = frame
  if st = self_type
    if sv = self_value
      # Hosted create_local_copy_of_block_self: `self` is the receiver, already loaded.
      frame.vars["self"] = LowerVar.new(sv.as(Value), st, !self_by_pointer?(st))
    end
  end
  def_facts = ClosureFacts.new(low.analysed)
  def_closure = def_facts.analyse_def(def_node, self_type)
  frame.closure_facts = def_facts
  def_captured = [] of String
  def_closure.closured.each { |var| def_captured << var.name }
  allocate_def_vars(low, def_node, arg_types, frame.vars, def_captured)
  allocate_closure(low, def_closure)
  copy_args(low, def_node, arg_types, values, frame.vars)
  if bf = block_frame
    low.context = block_ctx
    allocate_closure(low, bf, caller)
    low.context = frame
  end

  reset_nilable_locals(low)
  low.needs_value = true
  visit_node(low, def_node.body)
  finish_block_call_body(low, phi, body_t.as(Type), ret)
  low.context = caller
  low.needs_value = wants
  if noreturn
    low.last = llvm_nil(low)
  else
    phi.close(low)
  end
end

# The block's arguments, then its own locals, as the hosted `alloca_non_closured_vars(block.vars)`
# makes them: an alloca for each, named by the variable, in the alloca block. An argument shadows a
# caller variable of the same name (hosted `undef_vars`). A block argument never yielded to has the nil
# type, as the hosted `var.type? || @program.nil`.
pub def allocate_block_vars(low : Lowerer, block : Block, vars : Hash(String, LowerVar), captured : Array(String) = [] of String) : Nil
  owner = low.analysed.block_owners[block]?
  storage_types = owner.nil? ? nil : owner.local_storage.unions
  i = 0
  while i < block.args.size
    arg = block.args[i]
    if arg.name != "_" && !captured.includes?(arg.name)
      t = low.analysed.type_of?(arg.as(ASTNode))
      if table = storage_types
        t = table[arg.name]? || t
      end
      nil_t = low.analysed.program.nil_type
      alloca_local(low, vars, arg.name, t.nil? ? nil_t : t.as(Type))
    end
    i += 1
  end
  collector = LocalOrder.new(low.analysed)
  block.body.accept(collector)
  collector.vars.each do |var|
    name = var.name
    next if captured.includes?(name)
    # Hosted codegen.cr:2562 allocates block.vars at their merged storage type,
    # not the flow type of the first assignment encountered in the block.
    t = collector.types[name]?
    # Hosted alloca_non_closured_vars gives untyped, unreachable locals Nil storage.
    storage = t.nil? ? low.analysed.program.nil_type : t.as(Type)
    if table = storage_types
      if written = table[name]?
        storage = low.analysed.program.type_merge(storage, written)
      end
    end
    next if storage.is_a?(NoReturnType)
    # A retained slot belongs to an outer variable the block writes.
    unless vars[name]?
      alloca_local(low, vars, name, storage)
      if owner && owner.local_storage.nil_resets.includes?(name) && storage.nilable?
        reset_nil_slot(low, vars[name].pointer, storage)
      end
    end
  end
end

# The def's arguments, then its locals, as the hosted `alloca_vars(target_def.vars)` makes them before
# the arguments are copied: every argument gets an alloca (the inlined def's arguments are not read in
# place), and each local assigned in the body gets one, in the order its first assignment is met.
pub def allocate_def_vars(low : Lowerer, def_node : Def, arg_types : Array(Type), vars : Hash(String, LowerVar), captured : Array(String) = [] of String) : Nil
  storage_types = low.analysed.def_var_unions[def_node]?
  i = 0
  while i < def_node.args.size
    arg = def_node.args[i]
    if arg.name == "_"
      pending_visit_node("an argument named _ in an inlined def (hosted create_local_copy_of_arg)")
    end
    unless captured.includes?(arg.name)
      storage = arg_types[i]
      if table = storage_types
        if written = table[arg.name]?
          storage = low.analysed.program.type_merge(storage, written)
        end
      end
      alloca_local(low, vars, arg.name, storage)
    end
    i += 1
  end
  collector = LocalOrder.new(low.analysed)
  def_node.body.accept(collector)
  collector.vars.each do |var|
    name = var.name
    next if captured.includes?(name)
    t = collector.types[name]?
    # A narrowed-out branch may declare a local without ever typing its value.
    storage = t.nil? ? low.analysed.program.nil_type : t.as(Type)
    if table = storage_types
      if written = table[name]?
        storage = low.analysed.program.type_merge(storage, written)
      end
    end
    next if storage.is_a?(NoReturnType)
    unless vars[name]?
      alloca_local(low, vars, name, storage)
    end
  end
end

# The hosted `create_local_copy_of_arg` for an argument of an inlined def: the value is stored into the
# argument's alloca. A value passed by value goes through an alloca of its own first (hosted
# `pointer2`, then `assign`), which the loaded value is read from.
pub def copy_args(low : Lowerer, def_node : Def, arg_types : Array(Type), values : Array(Value), vars : Hash(String, LowerVar)) : Nil
  i = 0
  while i < def_node.args.size
    arg = def_node.args[i]
    var = vars[arg.name]?
    raise "BUG: argument #{arg.name} of an inlined def has no variable (hosted fun.cr: create_local_copy_of_arg)" if var.nil?
    v = var.as(LowerVar)
    t = arg_types[i]
    ir = low.typer.llvm_type(t)
    if passed_by_value?(t)
      temp = low.alloca(ir, "")
      value = values[i]
      stored = value.type.pointer? ? to_rhs(low, value, t) : value
      store_aligned(low, stored, temp)
      if v.closure_slot || v.type.full_name != t.full_name
        assign(low, v.pointer, v.type, t, temp)
      else
        loaded = load_aligned(low, ir, temp, "")
        store_aligned(low, loaded, v.pointer)
      end
    else
      if v.closure_slot || v.type.full_name != t.full_name
        assign(low, v.pointer, v.type, t, values[i])
      elsif !t.nil_type?
        store_aligned(low, values[i], v.pointer)
      end
    end
    i += 1
  end
end

# Contract 6b (hosted `import_library`): the library a fun of this lib is imported from. It is the framework
# the lib's first `@[Link]` names, else its library, else nil for a lib with no `@[Link]`. A lib with several
# annotations takes the first that names one. Its `ldflags:`, `pkg_config:`, `dll:` and `static:` arguments
# are refused by name: the hosted link line is not ported.
pub def lib_import_library(low : Lowerer, node : Compiler::Syntax::Ast::Call) : String?
  recv = node.obj
  # No receiver: the lib call record names a top-level fun with a body (`__iyi_main` and the like, the hosted External
  # def), which belongs to no lib, so there is nothing to import.
  return nil if recv.nil?
  t = low.analysed.type_of?(recv.as(ASTNode))
  raise "BUG: the analysed program has no type for the lib of #{node.name} (hosted call.cr: codegen_extern_call)" if t.nil?
  owner_lib = t.as(Type)
  raise "BUG: the receiver of #{node.name} is not a lib (hosted call.cr: codegen_extern_call)" unless owner_lib.is_a?(LibType)
  name : String? = nil
  owner_lib.as(LibType).link_annotations.each do |ann|
    if !ann.ldflags.nil? || !ann.pkg_config.nil? || !ann.dll.nil? || ann.is_static
      pending_visit_node("a lib with a link argument ldflags, pkg_config, dll or static (hosted lib.cr, the link line)")
    end
    if name.nil?
      name = ann.framework || ann.library
    end
  end
  name
end

# Declare the C storage shared by a lib variable's getter, setter and pointerof.
pub def declare_lib_var(low : Lowerer, lib_fun : LibFun, node : Compiler::Syntax::Ast::Call) : Global
  found = lib_fun.resolved_return
  raise "BUG: external variable #{lib_fun.real_name} has no resolved type" if found.nil?
  var_type = found.as(Type)
  storage = low.typer.llvm_c_return_type(var_type)
  loaded = low.typer.llvm_embedded_c_type(var_type)
  if storage.void? || loaded.key != storage.key || storage.key == low.typer.proc_struct.key
    pending_visit_node("external variable #{lib_fun.real_name} of type #{var_type.full_name}, declared as #{storage} and read as #{loaded} (hosted declare_lib_var, extern_to_lhs; NEEDS.md row 4)")
  end
  global = low.module.get_global?(lib_fun.real_name)
  return global.as(Global) unless global.nil?
  made = low.module.add_global(lib_fun.real_name, storage)
  made.tls = TlsModel::GeneralDynamic if lib_fun.thread_local
  made.import_library = lib_import_library(low, node)
  made
end

# The hosted external variable primitives load or store C storage, not a function.
pub def codegen_lib_var(low : Lowerer, node : Compiler::Syntax::Ast::Call, lib_fun : LibFun, values : Array(Value)) : Nil
  primitive = lib_fun.primitive
  unless primitive == "external_var_get" || primitive == "external_var_set"
    raise "BUG: external variable #{lib_fun.real_name} has an unexpected primitive"
  end
  found = lib_fun.resolved_return
  raise "BUG: external variable #{lib_fun.real_name} has no resolved type" if found.nil?
  var_type = found.as(Type)
  check_lib_aggregate(var_type, "external variable")
  if primitive == "external_var_set" && var_type.is_a?(ProcInstanceType)
    pending_visit_node("a proc stored to the external variable #{lib_fun.real_name} (hosted prepare_call_args_external, check_proc_is_not_closure)")
  end
  global = declare_lib_var(low, lib_fun, node)
  ir = low.typer.llvm_embedded_c_type(var_type)
  if primitive == "external_var_get"
    value = load_aligned(low, ir, global)
    if var_type.is_a?(ProcInstanceType)
      low.last = make_fun(low, var_type, value, low.builder.const_null(low.module.types.ptr(0)).as(Value))
    else
      low.last = value
    end
  else
    raise "BUG: external variable #{lib_fun.real_name} setter expects one value" unless values.size == 1
    raise "BUG: external variable #{lib_fun.real_name} setter has a mismatched value type" unless values[0].type.key == ir.key
    store_aligned(low, values[0], global)
    low.last = values[0]
  end
end

# The hosted `codegen_extern_call` for a call on a fun of a lib, through the lib call record the analysis
# made for the call (`MainVisitor#lib_call_target`, the port of Call#recalculate_lib_call). The fun's C
# name is `real_name`, its parameters have their declared types, and the arguments are in the order the C
# fun takes them: named arguments are already at their parameter's place. A number literal takes the type
# the record gives it, an `out` argument passes the address of its variable (declared here when the body
# has none), and nil passed to a pointer passes its null (hosted prepare_call_args_external). The fun is
# declared with the C calling convention and imported from the library its lib's `@[Link]` names,
# unless its C name starts with `llvm.`: that fun emits a typed intrinsic. A NoReturn fun ends the block
# with `unreachable`, and its value is nil. An argument that never returns ends the block, and the call is not made. Refused by
# name: an argument converted by its to_unsafe method, nil to a proc or a variadic argument, an `out`
# argument that is not a variable, and a number argument that is not a literal.
# External variables use the same evaluated arguments but load or store their C global.
pub def codegen_lib_call(low : Lowerer, node : Compiler::Syntax::Ast::Call, ret : Type) : Nil
  record = low.analysed.lib_call_target(node)
  raise "BUG: the call to #{node.name} on a lib has no lib call record (hosted call.cr: codegen_extern_call)" if record.nil?
  target = record.as(LibCallTarget)
  fun_opt = target.lib_fun
  raise "BUG: the lib call record of #{node.name} has no fun (hosted call.cr: codegen_extern_call)" if fun_opt.nil?
  lib_fun = fun_opt.as(LibFun)
  if target.to_unsafe_index.size > 0
    pending_visit_node("a lib argument converted by its to_unsafe method (hosted lib.cr, to_unsafe rewrite)")
  end

  params = [] of IrType
  values = [] of Value
  wants = low.needs_value
  ended = false
  i = 0
  while i < target.arg_nodes.size && !ended
    arg_node = target.arg_nodes[i]
    fixed = i < lib_fun.args.size
    out_at = lib_index_of(target.out_index, i)
    literal_at = lib_index_of(target.literal_index, i)
    if out_at >= 0
      unless arg_node.is_a?(Out) && arg_node.as(Out).exp.is_a?(Var)
        pending_visit_node("an out argument that is not a variable (hosted lib.cr, pointerof the argument)")
      end
      name = arg_node.as(Out).exp.as(Var).name
      vars = low.current_context.vars
      unless vars[name]?
        alloca_local(low, vars, name, target.out_type[out_at])
      end
      var = vars[name].as(LowerVar)
      check_lib_aggregate(lib_fun.arg_types[i], "argument")
      params << low.typer.llvm_type(lib_fun.arg_types[i])
      values << var.pointer
    elsif literal_at >= 0
      lit_t = target.literal_type[literal_at]
      unless arg_node.is_a?(NumberLiteral)
        pending_visit_node("a number argument that is not a literal (hosted Conversions.numeric_argument)")
      end
      check_lib_aggregate(lit_t, "argument")
      params << low.typer.llvm_type(lit_t)
      values << lib_number_value(low, arg_node.as(NumberLiteral), lit_t)
    else
      low.needs_value = true
      visit_node(low, arg_node)
      if block_ended?(low)
        ended = true
      else
        v = low.last
        raise "BUG: argument #{i} of #{node.name} left no value (hosted call.cr: prepare_call_args_external)" if v.nil?
        at = low.analysed.type_of?(arg_node)
        raise "BUG: the analysed program has no type for argument #{i} of #{node.name} (hosted call.cr: prepare_call_args_external)" if at.nil?
        arg_t = at.as(Type)
        if arg_t.is_a?(NilType)
          unless fixed
            pending_visit_node("nil passed to a variadic argument of #{node.name} (hosted prepare_call_args_external, void pointer null)")
          end
          declared = lib_fun.arg_types[i]
          if declared.is_a?(ProcInstanceType)
            pending_visit_node("nil passed to a proc parameter of #{node.name} (hosted prepare_call_args_external, proc null)")
          end
          check_lib_aggregate(declared, "argument")
          params << low.typer.llvm_type(declared)
          values << low.builder.const_null(low.typer.llvm_type(declared)).as(Value)
        else
          pt = arg_t
          if fixed
            pt = lib_fun.arg_types[i]
          end
          check_lib_aggregate(pt, "argument")
          # Extra arguments stay variadic at the call site, outside the declared signature.
          params << low.typer.llvm_type(pt) if fixed
          values << v.as(Value)
        end
      end
    end
    i += 1
  end
  low.needs_value = wants
  if ended
    low.last = llvm_nil(low)
    return
  end
  if lib_fun.external_var
    codegen_lib_var(low, node, lib_fun, values)
    return
  end

  real = lib_fun.real_name
  if real.starts_with?("llvm.")
    inst = codegen_lib_intrinsic(low, lib_fun, params, values, ret)
  else
    check_lib_aggregate(ret, "result")
    fn_type = low.module.types.func(params, low.typer.llvm_return_type(ret), lib_fun.varargs?)
    import_from = lib_import_library(low, node)
    func = low.module.get_function?(real)
    if func.nil?
      made = low.module.add_function(real, fn_type, CallConv::C)
      made.import_library = import_from
      func = made
    end
    inst = low.builder.call(fn_type, func.as(Function), values, "")
  end
  if ret.is_a?(NoReturnType)
    low.builder.unreachable
    low.last = llvm_nil(low)
  elsif ret.is_a?(NilType)
    low.last = llvm_nil(low)
  else
    low.last = inst
  end
end

# Match the hosted llvm_intrinsic? boundary before creating a C declaration. The argument loop supplies
# declared parameter types; both those and the result must match the IR's canonical intrinsic signature.
# Aggregate results need the hosted llvm_intrinsic_return_type spill, which this path does not yet emit.
def codegen_lib_intrinsic(low : Lowerer, lib_fun : LibFun, params : Array(IrType), values : Array(Value), ret : Type) : Inst
  real = lib_fun.real_name
  found = intrinsic_match(real, low.module.types)
  if found.nil?
    refuse_port("lower: the lib fun #{lib_fun.name} binds #{real}, which is not an intrinsic the IR accepts (ir/intrinsics.iyi intrinsic_match; hosted codegen/ast.cr llvm_intrinsic?)")
  end
  match = found.as(IntrinsicMatch)
  if lib_fun.varargs?
    refuse_port("lower: the lib fun #{lib_fun.name} binds the LLVM intrinsic #{real} with variadic arguments, which no intrinsic takes")
  end
  if passed_by_value?(ret)
    refuse_port("lower: the lib fun #{lib_fun.name} binds the LLVM intrinsic #{real} with the aggregate result #{ret.full_name}, whose hosted spill (codegen/call.cr codegen_call_or_invoke, fun.cr llvm_intrinsic_return_type) is not ported yet")
  end
  signature = intrinsic_signature(match.id, match.overload, low.module.types)
  result = low.typer.llvm_return_type(ret)
  unless params == signature[1] && result == signature[0]
    declared = "#{result} (#{params.map { |t| t.to_s }.join(", ")})"
    wanted = "#{signature[0]} (#{signature[1].map { |t| t.to_s }.join(", ")})"
    refuse_port("lower: the lib fun #{lib_fun.name} declares the LLVM intrinsic #{real} as #{declared}, and the intrinsic is #{wanted} (ir/intrinsics.iyi intrinsic_signature)")
  end
  low.builder.intrinsic(match.id, match.overload, values)
end

# The position of argument *i* in one of the lib call record's index lists (`out_index`, `literal_index`), or -1.
pub def lib_index_of(indexes : Array(Int32), i : Int32) : Int32
  j = 0
  while j < indexes.size
    return j if indexes[j] == i
    j += 1
  end
  -1
end

# A number literal passed to a lib fun: a constant of the type the record gives it (the C parameter's type),
# as the hosted pass rewrites the literal's type.
pub def lib_number_value(low : Lowerer, node : NumberLiteral, t : Type) : Value
  ir = low.typer.llvm_type(t)
  if primitive_kind(t) == "float"
    return low.builder.const_float(ir, node.value.to_f).as(Value)
  end
  if node.kind == NumberKind::U64
    value = node.value.to_u64
    half = 1_u64.unsafe_shl(63_u64)
    bits = value >= half ? (value - half).to_i64 + (0_i64 - 9223372036854775807_i64 - 1_i64) : value.to_i64
    return low.builder.const_int(ir, bits).as(Value)
  end
  low.builder.const_int(ir, node.value.to_i64).as(Value)
end

# The instantiated def's parameter types, not its written restrictions, are the
# types the hosted prepare_call_args converts to and uses in the callee name.
pub def lower_args(low : Lowerer, node : Compiler::Syntax::Ast::Call, def_node : Def) : {Array(Type), Array(Value)}
  arg_types = [] of Type
  values = [] of Value
  wants = low.needs_value
  arguments = call_args(low, node)
  i = 0
  while i < arguments.size
    arg_node = arguments[i]
    at_type = low.analysed.type_of?(arg_node)
    raise "BUG: the analysed program has no type for argument #{i} of #{node.name} (hosted call.cr: prepare_call_args)" if at_type.nil?
    at = at_type.as(Type)
    param_type = low.analysed.type_of?(def_node.args[i])
    if param_type.nil?
      pending_visit_node("an untyped instantiated parameter #{i} of #{node.name} (hosted call.cr: prepare_call_args)")
    end
    target_type = param_type.as(Type)
    low.needs_value = true
    visit_node(low, arg_node)
    value = low.last
    raise "BUG: argument #{i} of #{node.name} left no value (hosted call.cr: prepare_call_args)" if value.nil?
    # Hosted prepare_call_args_non_external: a nil argument is the nil value, the zero constant of the nil type
    # (zeroinitializer); the helper `llvm_nil` is an undef constant in this port, so it is not used here.
    passed = at.is_a?(NilType) ? low.builder.const_zero(low.typer.nil_type).as(Value) : value.as(Value)
    converted : Value
    if at.full_name != target_type.full_name && numeric_literal_autocast?(arg_node, at, target_type)
      converted = lib_number_value(low, arg_node.as(NumberLiteral), target_type)
    elsif at.full_name != target_type.full_name && !at.is_a?(NoReturnType) && at.implements?(target_type)
      converted = upcast(low, passed, at, target_type)
    else
      passed = pointer_of_value(low, arg_node, passed, at) if at.is_a?(MixedUnionType) && at.full_name != target_type.full_name
      converted = downcast(low, passed, target_type, at, true)
    end
    if passed_by_value?(target_type) && converted.type.pointer?
      converted = to_rhs(low, converted, target_type)
    end
    values << converted
    arg_types << target_type
    i += 1
  end
  low.needs_value = wants
  {arg_types, values}
end

# The hosted `responds_to?` (RespondsTo, expanded by the hosted typer to a Bool literal): true when the
# receiver's type, or a superclass of it, defines a method of that name. The analysis types the node Bool and
# leaves the value here (semantic/main_visitor.iyi, visit(RespondsTo)). The value is a constant i1.
pub def codegen_responds_to(low : Lowerer, node : RespondsTo) : Nil
  low.last = int1(low, responds_to_value(low, node) ? 1_i64 : 0_i64)
end

# The value of a responds_to? node (the hosted expanded literal): the receiver's type, or a superclass, defines
# the method. Used by the value path and by the `if` fold (lower.iyi codegen_branch), as the hosted folds a literal.
pub def responds_to_value(low : Lowerer, node : RespondsTo) : Bool
  t = low.analysed.type_of?(node.obj)
  raise "BUG: the analysed program has no type for the receiver of responds_to? (hosted codegen: RespondsTo)" if t.nil?
  responds_to_name?(t.as(Type), node.name)
end

# Whether a type, or a superclass of it, defines a method of this name (the hosted lookup for responds_to?).
pub def responds_to_name?(t : Type, name : String) : Bool
  if t.is_a?(ModuleType)
    return true unless t.as(ModuleType).defs[name]?.nil?
  end
  if t.is_a?(ClassType)
    sup = t.as(ClassType).superclass
    if s = sup
      return responds_to_name?(s.as(Type), name)
    end
  end
  false
end

# The address of a receiver that is a stored struct variable, which a method takes as its self without a load
# (the hosted self is the variable's storage: no value is read). Nil for any other receiver, a parameter read where
# it arrives, a class (its self is the object pointer), or a variable of another type.
pub def receiver_storage(low : Lowerer, node : Compiler::Syntax::Ast::Call, st : Type) : Value?
  obj = node.obj
  return nil if obj.nil?
  o = obj.as(ASTNode)
  return nil unless o.is_a?(Var)
  return nil unless self_by_pointer?(st)
  var = low.current_context.vars[o.as(Var).name]?
  return nil if var.nil?
  lv = var.as(LowerVar)
  return nil if lv.already_loaded
  return nil if TypeIndirection.trait_value_type(lv.type).full_name != st.full_name
  lv.pointer
end

# This cold path is reached only after the ordinary call type lookup failed.
# A total-mode probe may name a refusal recorded for this exact call; absence
# of such a record remains the strict compiler BUG below the call site.
def refuse_untyped_call_probe(low : Lowerer, node : Compiler::Syntax::Ast::Call) : Nil
  return unless low.probe_untyped_refusals
  low.analysed.refusals.each do |refusal|
    next unless refusal.node.node_id == node.node_id
    site = "no location"
    if file = refusal.file
      site = "#{file}:#{refusal.line}:#{refusal.column}"
    end
    reason = refusal.reason.split("\n")[0]
    raise "body typing refused call #{node.name} at #{site}: #{reason}"
  end
  nil
end
