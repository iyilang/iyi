; iyi-ir 1
source_filename = "irreducible_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @irreducible_keep(i1 %run, i1 %choose, i1 %again, i32 %a, i32 %b, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %dispatch
body:
  %value = mul i32 %a, %b
  store i32 %value, ptr %out, align 4
  br label %head
dispatch:
  br i1 %choose, label %left, label %right
left:
  br label %right
right:
  br i1 %again, label %left, label %done
done:
  ret void
}
