# What every value can do — SPEC.md, "0.1.0", item 3.
#
# Small on purpose. `to_s` returns a `String` rather than taking an `IO`, which
# is the single biggest saving against Crystal's core: an `IO` here would bring
# buffering, encodings and a class hierarchy for the sake of `puts`.
class Object
  # The type's own name, which is what a value that has said nothing about
  # itself can honestly print. A type that wants better defines its own.
  def to_s : String
    {{ @type.name.stringify }}
  end

  # What a value looks like written down rather than printed. The two differ
  # for `nil` and for strings, which is the whole reason a sample reaches for
  # it: `#{value.inspect}` is how it shows that a value is absent.
  def inspect : String
    to_s
  end

  # Every type is usable as a `Hash` key, and one that has not said how it
  # hashes hashes to its type. That is correct and useless — every value of
  # such a type lands in one slot — which is the honest default: a type that
  # is used as a key defines `hash`.
  def hash : Int32
    crystal_type_id
  end

  # `value.in?(a, b)` — the Kemal port's way of writing an alternation. On
  # `Object` because it is about the value, not about any one type of it.
  def in?(*values : *T) : Bool forall T
    {% for index in 0...T.size %}
      return true if self == values[{{ index }}]
    {% end %}
    false
  end

  def ==(other) : Bool
    false
  end

  def !=(other) : Bool
    !(self == other)
  end

  # Case equality, what a `when` asks of each arm: equality, unless a type
  # answers with something stronger - a range, a class, a tuple.
  def ===(other) : Bool
    self == other
  end
end

# The absence of a value, and the only value of its type.
struct Nil
  def to_s : String
    ""
  end

  def inspect : String
    "nil"
  end

  def ==(other : Nil) : Bool
    true
  end
end

struct Symbol
  def hash : Int32
    to_i
  end
end

struct Bool
  def to_s : String
    self ? "true" : "false"
  end
end

# A tuple written the way it is written: `{1, "a"}`. The compiler lays a
# tuple out and answers `[]`; what it looks like printed is the prelude's,
# one element per position, each inspected.
struct Tuple
  # How many, which is the type's own arithmetic rather than anything a
  # caller counts. It arrived inside `format.iyi` because `sprintf` walks
  # its arguments, so `std/indexable` - which asks a tuple of indexes how
  # long it is - only compiled while a formatter was in every program.
  def size : Int32
    {{ T.size }}
  end

  # Indexed by a *value* rather than by a literal, which is what walking a
  # tuple at runtime needs: `std/indexable`'s `values_at(*indexes)` asks a
  # tuple of indexes for its members one by one, and `sprintf` walks its
  # arguments the same way. Both were reading it out of `format.iyi`, so
  # either one only compiled while a formatter was in the program.
  def [](index : Int32)
    {% for i in 0...T.size %}
      return self[{{i}}] if index == {{i}}
    {% end %}
    raise "index out of range"
  end

  # Two tuples are the same value when their members are. `Object#==` is
  # identity, so `{1, 2} == {1, 2}` was false, a tuple key was never found
  # in a `Hash`, and `uniq` over `zip`'s own result kept duplicates. Member
  # by member where one type holds the other, so `case {1, y} when {1, 2}`
  # (y : Int32?) matches; `{-1}` and `{-1_i64}` hash apart: unequal.
  def ==(other : Tuple(*U)) : Bool forall U
    {% for i in 0...(T.size == U.size ? T.size : 0) %}
      return false unless {{ T[i] <= U[i] || U[i] <= T[i] }} && self[{{i}}] == other[{{i}}]
    {% end %}
    {{ T.size == U.size }}
  end

  # Each member's own `===`: `when {Nil, Bool}` holds for `{nil, false}`,
  # which `==` - a class against a value - never did.
  def ===(other : Tuple(*U)) : Bool forall U
    {{ (T.size == U.size ? (0...T.size).map { |i| "self[#{i}] === other[#{i}]" } + ["true"] : ["false"]).join(" && ").id }}
  end

  # And hashing follows equality, or the agreement above buys nothing: a key
  # is found by its slot first and compared second. `Object#hash` put every
  # tuple in one slot, correct and useless in the way that comment says.
  #
  # Each member multiplied through and its high bits folded back down: `a *
  # 31 + b` gave a 1,000 by 1,000 grid of points 32,000 hashes between a
  # million keys, and a table probing a slot at a time turned those runs
  # into one - it had not filled in ten minutes.
  def hash : Int32
    value = 0x9E3779B97F4A7C15_u64
    {% for i in 0...T.size %}
      value = (value ^ self[{{i}}].hash.to_i64.unsafe_to_u64) &* 0x100000001B3_u64
      value = value ^ value.unsafe_shr(29_u64)
    {% end %}
    value.hash
  end

  # A first member in braces of its own is spaced off, `{ {1, 2}, 3 }`, as the other library's is.
  def to_s : String
    pad = {% if T.size > 0 %} self[0].is_a?(Tuple) || self[0].is_a?(NamedTuple) || self[0].is_a?(Hash) ? " " : "" {% else %} "" {% end %}
    result = "{" + pad
    {% for i in 0...T.size %}
      result = result + ", " if {{i}} > 0
      result = result + self[{{i}}].inspect
    {% end %}
    result + pad + "}"
  end

  def inspect : String
    to_s
  end
end
