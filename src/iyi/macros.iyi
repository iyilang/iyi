# The macros a declaration cannot be written without — SPEC.md, "0.1.0",
# item 3.
#
# `getter` is here because every sample declares a field with it, and a field
# reader written by hand five times in a row is what a macro is for. The
# variants Crystal's `object.cr` carries — lazy, nilable, `?`, raise-on-nil —
# are not here, because no sample writes one. An untyped default, `getter n =
# 3`, is the field's initialiser `@n = 3`; it expanded to `def n = 3`.
class Object
  macro getter(*names)
    {% for name in names %}
      {% if name.is_a?(TypeDeclaration) %}
        @{{ name }}

        def {{ name.var.id }} : {{ name.type }}
          @{{ name.var.id }}
        end
      {% else %}
        {% if name.is_a?(Assign) %} @{{ name }} {% name = name.target %} {% end %}
        def {{ name.id }}
          @{{ name.id }}
        end
      {% end %}
    {% end %}
  end

  # `record Point, x : Int32, y : Int32` — a struct whose fields are its
  # constructor. Crystal's version also generates `copy_with` and `clone` and
  # takes default values; this one takes a name, a list of typed fields, and
  # — as Crystal's does — a block whose body is the struct's own:
  # `record Vec, x : Float64 do def norm ... end end`. Without the `yield`
  # the block compiled and its methods were nowhere, and the error landed
  # at the first call instead of at the `record`.
  macro record(name, *fields)
    struct {{ name.id }}
      {% for field in fields %}
        getter {{ field }}
      {% end %}

      def initialize({{ fields.map { |field| "@#{field}".id }.splat }})
      end

      {{ yield }}
    end
  end

  macro property(*names)
    {% for name in names %}
      {% if name.is_a?(TypeDeclaration) %}
        @{{ name }}

        def {{ name.var.id }} : {{ name.type }}
          @{{ name.var.id }}
        end

        def {{ name.var.id }}=(value : {{ name.type }}) : {{ name.type }}
          @{{ name.var.id }} = value
        end
      {% else %}
        getter {{ name }}
        {% name = name.target if name.is_a?(Assign) %}
        def {{ name.id }}=(value)
          @{{ name.id }} = value
        end
      {% end %}
    {% end %}
  end
end
