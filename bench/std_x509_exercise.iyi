# Exercises std/x509: certificates read, hosts matched and chains checked.
#
# With no argument: chains Python's cryptography made, each scenario's
# verdict the one Python's own verifier gives - chains that hold (EC and
# RSA, RSASSA-PSS, two intermediates, a decoy and a cross-signed
# intermediate beside the right one, wildcards, IP addresses, name
# constraints) and chains broken one way each (a host it does not name,
# a certificate out of its time, an intermediate that is not a CA or may
# not sign, a pathLenConstraint, extKeyUsage, a leaf that is a CA, an
# unknown critical extension, a signature by another key, a missing
# intermediate or root, SHA-1, a name outside a constraint), each refusal
# saying why. Then certificates that are not certificates, PEM, and
# Ed25519 keys and signatures (RFC 8410), held and refused. The modes
# the gate script drives:
#   verify FILE   each line `host leaf intermediates roots`, certificates
#                 in hex and lists joined by `,` (`-` for none), checked
#                 at 2026-06-01: `true` or `false: <why>`;
#   roots FILE    a PEM bundle, each certificate read and written out:
#                 `index version ca pathlen keyusage eku dns self`.

import std/x509::{Certificate, X509, X509Error, X509Purpose}
import std/time::{Time}
import std/file::{File}
import std/curve25519::{Ed25519, Ed25519PublicKey, CurveError}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def cert(hex : String) : Certificate
  Certificate.parse(b(hex)).or_panic
end

def certs(list : String) : Array(Certificate)
  return [] of Certificate if list == "-"
  list.split(',').map { |hex| cert(hex) }
end

def refused(der : String, phrase : String, label : String) : Nil
  answer = Certificate.parse(b(der))
  raise "ASSERTION FAILED: #{label}: accepted" unless answer.is_a?(X509Error)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

NOW = Time.utc(2026, 6, 1)

# The leaf of the scenario named *what*.
def leaf_of(what : String) : Certificate
  SCENARIOS.each { |s| return cert(CERTS[s[1]]) if s[0] == what }
  raise "no scenario #{what}"
end

CERTS = [
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
]

# what, leaf, intermediates, roots, host, verdict, the refusal's phrase
SCENARIOS = [
  {"an EC chain through one intermediate", 0, [1], [2], "www.example.com", true, ""},
  {"an RSA root and intermediate over an EC leaf", 3, [4], [5], "www.example.com", true, ""},
  {"an intermediate signed with RSASSA-PSS", 6, [7], [5], "www.example.com", true, ""},
  {"a leaf straight under the root", 8, [] of Int32, [2], "www.example.com", true, ""},
  {"SHA-384 and SHA-512 signatures", 9, [10], [2], "www.example.com", true, ""},
  {"another host", 0, [1], [2], "mail.example.com", false, "is not valid for mail.example.com"},
  {"a wildcard for one label", 11, [1], [2], "a.example.com", true, ""},
  {"a wildcard for the name it stands under", 11, [1], [2], "example.com", false, "is not valid for"},
  {"a wildcard for two labels", 11, [1], [2], "a.b.example.com", false, "is not valid for"},
  {"a host in capitals", 12, [1], [2], "www.EXAMPLE.com", true, ""},
  {"an IPv4 address", 13, [1], [2], "192.0.2.1", true, ""},
  {"another IPv4 address", 13, [1], [2], "192.0.2.2", false, "is not valid for 192.0.2.2"},
  {"an IPv6 address", 13, [1], [2], "2001:db8::1", true, ""},
  {"an IPv6 address written longer", 13, [1], [2], "2001:0db8:0:0:0:0:0:1", true, ""},
  {"an address named as a DNS name", 14, [1], [2], "192.0.2.1", false, "is not valid for"},
  {"a leaf past its end", 15, [1], [2], "www.example.com", false, "is not valid at"},
  {"a leaf before its start", 16, [1], [2], "www.example.com", false, "is not valid at"},
  {"an intermediate past its end", 0, [17], [2], "www.example.com", false, "CN=Inter A is not valid at"},
  {"a root past its end", 0, [1], [18], "www.example.com", false, "CN=Root A is not valid at"},
  {"an intermediate that is not a CA", 0, [19], [2], "www.example.com", false, "CN=Inter A is not a CA"},
  {"an intermediate without basicConstraints", 0, [20], [2], "www.example.com", false, "CN=Inter A is not a CA"},
  {"an intermediate not allowed keyCertSign", 0, [21], [2], "www.example.com", false, "not allowed to sign certificates"},
  {"two intermediates", 22, [23, 1], [2], "www.example.com", true, ""},
  {"a pathLenConstraint of 0 over another CA", 22, [23, 24], [2], "www.example.com", false, "allows 0 CA certificates under it"},
  {"a pathLenConstraint of 0 over the leaf alone", 0, [25], [2], "www.example.com", true, ""},
  {"a leaf for serverAuth", 26, [1], [2], "www.example.com", true, ""},
  {"a leaf for clientAuth only", 27, [1], [2], "www.example.com", false, "not allowed serverAuth"},
  {"an intermediate for clientAuth only", 0, [28], [2], "www.example.com", false, "CN=Inter A is not allowed serverAuth"},
  {"a leaf that is a CA", 29, [1], [2], "www.example.com", false, "is a CA certificate"},
  {"a leaf with an unknown critical extension", 30, [1], [2], "www.example.com", false, "carries critical extension 1.3.6.1.4.1.55555.1"},
  {"an intermediate with an unknown critical extension", 0, [31], [2], "www.example.com", false, "CN=Inter A carries critical extension"},
  {"a leaf signed by another key under the same name", 32, [1], [2], "www.example.com", false, "signature is not"},
  {"a root not in the store", 0, [1], [5], "www.example.com", false, "no certificate here issued"},
  {"an intermediate not given", 0, [] of Int32, [2], "www.example.com", false, "no certificate here issued"},
  {"a decoy intermediate under the same name, tried first", 0, [33, 1], [2], "www.example.com", true, ""},
  {"a cross-signed intermediate whose root is not trusted, beside one whose root is", 0, [34, 1], [2], "www.example.com", true, ""},
  {"only the cross-signed intermediate", 0, [34], [2], "www.example.com", false, "no certificate here issued"},
  {"a leaf signed under SHA-1", 35, [4], [5], "www.example.com", false, "under SHA-1"},
  {"a name inside the permitted subtree", 0, [36], [2], "www.example.com", true, ""},
  {"a name outside the permitted subtree", 37, [38], [2], "www.example.org", false, "outside the names CN=Inter A permits"},
  {"a name that only ends like the permitted one", 39, [40], [2], "www.badexample.com", false, "outside the names"},
  {"a name in the excluded subtree", 41, [42], [2], "bad.example.com", false, "among the names CN=Inter A excludes"},
  {"an address inside the permitted range", 43, [44], [2], "192.0.2.9", true, ""},
  {"an address outside the permitted range", 45, [46], [2], "198.51.100.9", false, "outside the addresses CN=Inter A permits"},
]
ALG_MISMATCH = ""
DUP_EXT      = ""
ROOT_PEM     = "-----BEGIN CERTIFICATE-----\nMIIBZjCCAQygAwIBAgIUVATEneV3F0/7dwXAwQSFEQTviTgwCgYIKoZIzj0EAwIw\nETEPMA0GA1UEAwwGUm9vdCBBMB4XDTI2MDUwMjAwMDAwMFoXDTI3MDMyODAwMDAw\nMFowETEPMA0GA1UEAwwGUm9vdCBBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE\nDZNnmklZsKc9QkTNL7WxorAWCaTu2ibBijaBkAArAFu2QiK2JTM4s0u5amTS+oGn\nBRJnfMxdQOmLbuyzRl8QkKNCMEAwDwYDVR0TAQH/BAUwAwEB/zAOBgNVHQ8BAf8E\nBAMCAQYwHQYDVR0OBBYEFP8YaD1C92iDQlJCqINyFnqufv/+MAoGCCqGSM49BAMC\nA0gAMEUCIEWTrKbrjqdN6IJjZCZIG9TAOi5VimwmwkPeiwAg8QlhAiEA5daDFxZU\nvc/JMOMvRU2FkArOBEhi9jRNYsdndbcNX/o=\n-----END CERTIFICATE-----\n"
ROOT_INDEX   = 2

args = Program.args

if args.size > 0 && args[0] == "verify"
  File.read(args[1]).lines.each do |line|
    next if line.empty?
    f = line.split(' ')
    answer = X509.verify(cert(f[1]), certs(f[2]), certs(f[3]), f[0], NOW)
    puts answer.is_a?(X509Error) ? "false: #{answer.message}" : "true"
  end
  exit 0
end

if args.size > 0 && args[0] == "roots"
  Certificate.pem_blocks(File.read(args[1])).or_panic.each_with_index do |der, i|
    c = Certificate.parse(der)
    if c.is_a?(X509Error)
      puts "#{i} refused #{c.message}"
      next
    end
    self_signed = c.signature_error(c)
    verdict = self_signed.nil? ? "true" : (self_signed.includes?("SHA-1") ? "sha1" : "false")
    usages = c.extended_key_usage
    puts "#{i} #{c.version} #{c.ca} #{c.path_length || "-"} #{c.key_usage || "-"} #{usages ? usages.join(",") : "-"} #{c.dns_names.empty? ? "-" : c.dns_names.join(",")} #{verdict}"
  end
  exit 0
end

puts "== chains Python's cryptography made, as its verifier judges them"
held = 0
refusals = 0
SCENARIOS.each do |s|
  leaf = cert(CERTS[s[1]])
  intermediates = s[2].map { |i| cert(CERTS[i]) }
  roots = s[3].map { |i| cert(CERTS[i]) }
  answer = X509.verify(leaf, intermediates, roots, s[4], NOW)
  if s[5]
    check !answer.is_a?(X509Error), "#{s[0]}: refused: #{answer.is_a?(X509Error) ? answer.message : ""}"
    if answer.is_a?(Array(Certificate))
      check answer[0].raw == leaf.raw && roots.any? { |r| r.raw == answer[answer.size - 1].raw }, "#{s[0]}: a chain that is not leaf to root"
    end
    held = held + 1
  else
    check answer.is_a?(X509Error), "#{s[0]}: expected a refusal, got a chain"
    if answer.is_a?(X509Error)
      check answer.message.includes?(s[6]), "#{s[0]}: refused with #{answer.message.inspect}, not #{s[6].inspect}"
    end
    refusals = refusals + 1
  end
end
puts "  #{held} chains held and #{refusals} refused, each for its reason"

puts "== hosts matched"
ips = leaf_of("an IPv4 address")
check ips.matches_host?("[2001:db8::1]"), "an IPv6 address in brackets"
check ips.matches_host?("2001:DB8:0::1"), "an IPv6 address in capitals with :: inside"
check !ips.matches_host?("2001:db8::1::1"), "two :: refused"
check !ips.matches_host?("192.0.2.01"), "an IPv4 octet with a leading zero refused"
check !ips.matches_host?("192.0.2"), "three IPv4 octets refused"
www = cert(CERTS[SCENARIOS[0][1]])
check www.matches_host?("www.example.com."), "a final dot"
check !www.matches_host?(""), "an empty host"
check !www.matches_host?("www.example.com.."), "two final dots"
check www.dns_names == ["www.example.com"], "dNSName read: #{www.dns_names}"
wild = leaf_of("a wildcard for one label")
check !wild.matches_host?(".example.com"), "a wildcard for an empty label"

puts "== certificates that are not certificates"
refused ALG_MISMATCH, "the signature algorithm signed differs", "an outer algorithm that is not the inner one refused"
refused DUP_EXT, "extension 2.5.29.17 appears twice", "an extension written twice refused"
refused "020101", "expected a SEQUENCE", "an INTEGER where a certificate goes refused"
refused "3003020101", "a Certificate of 1 values", "a SEQUENCE of one value refused"
read = Certificate.from_pem("comment\n" + ROOT_PEM + "more\n" + ROOT_PEM).or_panic
check read.size == 2 && read[0].raw == b(CERTS[ROOT_INDEX]), "two PEM blocks among other text"
check Certificate.from_pem(ROOT_PEM.lines.reject { |l| l.starts_with?("-----END") }.join("\n")).is_a?(X509Error), "a PEM block with no END refused"
check Certificate.from_pem(ROOT_PEM.lines.map { |l| l.starts_with?("MII") ? "M*" + l[2, l.size - 2] : l }.join("\n")).is_a?(X509Error), "a PEM block that is not base64 refused, not a panic"
check Certificate.from_pem("no certificates").or_panic.empty?, "a text with no blocks reads as none"

puts "== Ed25519 (RFC 8410)"
# Made by Python's cryptography; the malformed ones assembled by hand and
# signed again, so each is refused for its one defect. Python's Web PKI
# verifier refuses an Ed25519 issuer outright, as the CA/Browser Forum's
# rules do; OpenSSL and Go take one, and so does this, since a private CA
# is where Ed25519 certificates are found.
ED_ROOT             = ""
ED_LEAF             = ""
ED_LEAF_BY_OTHER    = ""
EC_ROOT_FOR_ED      = ""
ED_LEAF_UNDER_EC    = ""
EC_LEAF_UNDER_ED    = ""
ECDSA_NAMING_ED     = ""
ED_KEY_PARAMS       = ""
ED_KEY_OFF_CURVE    = ""
ED_KEY_SHORT        = ""
ED_SIGNATURE_PARAMS = ""
ED_LEAF_KEY         = "b2e691185bf34ea3b25d04d40ee19fbedc6f75ba2177323a5c55f781906530d0"
ed_root = cert(ED_ROOT)
ed_leaf = cert(ED_LEAF)
ed_key = ed_leaf.public_key
check ed_key.is_a?(Ed25519PublicKey) && ed_key.bytes == b(ED_LEAF_KEY), "an Ed25519 leaf's key read as its 32 bytes"
check ed_root.signature_algorithm == "1.3.101.112", "an Ed25519 signature's algorithm: #{ed_root.signature_algorithm}"
held_ed = X509.verify(ed_leaf, [] of Certificate, [ed_root], "ed.example", NOW)
check held_ed.is_a?(Array(Certificate)) && held_ed.size == 2, "an Ed25519 leaf under an Ed25519 root: #{held_ed.is_a?(X509Error) ? held_ed.message : ""}"
mixed = X509.verify(cert(ED_LEAF_UNDER_EC), [] of Certificate, [cert(EC_ROOT_FOR_ED)], "mixed.example", NOW)
check mixed.is_a?(Array(Certificate)), "an Ed25519 leaf under an ECDSA root: #{mixed.is_a?(X509Error) ? mixed.message : ""}"
mixed = X509.verify(cert(EC_LEAF_UNDER_ED), [] of Certificate, [ed_root], "ec.example", NOW)
check mixed.is_a?(Array(Certificate)), "an ECDSA leaf under an Ed25519 root: #{mixed.is_a?(X509Error) ? mixed.message : ""}"

def ed_refused(answer : Array(Certificate) | X509Error, phrase : String, label : String) : Nil
  raise "ASSERTION FAILED: #{label}: expected a refusal, got a chain" unless answer.is_a?(X509Error)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

ed_refused X509.verify(cert(ED_LEAF_BY_OTHER), [] of Certificate, [ed_root], "ed.example", NOW),
  "CN=ed leaf's signature is not CN=Ed Root's", "an Ed25519 leaf signed by another key under the root's name"
ed_refused X509.verify(cert(ECDSA_NAMING_ED), [] of Certificate, [ed_root], "odd.example", NOW),
  "an ECDSA signature under CN=Ed Root's Ed25519 key", "an ECDSA signature naming an Ed25519 issuer"
ed_refused X509.verify(cert(ED_SIGNATURE_PARAMS), [] of Certificate, [ed_root], "ec.example", NOW),
  "1.3.101.112 with parameters", "an Ed25519 signature whose algorithm carries parameters"
refused ED_KEY_PARAMS, "an Ed25519 key with parameters", "an Ed25519 key whose algorithm carries parameters refused"
refused ED_KEY_OFF_CURVE, "not a point on the curve", "an Ed25519 key off the curve refused"
refused ED_KEY_SHORT, "a public key is 32 bytes, not 31", "an Ed25519 key of 31 bytes refused"
# The key on its own: y = p is the one non-canonical spelling of y = 0,
# which is on the curve; it is refused as RFC 8032 section 5.1.3 says.
check Ed25519PublicKey.from_bytes(b("edffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f")).is_a?(CurveError), "y = p refused as a key"
seed = Array(UInt8).new(32) { |i| (i * 7 + 1).to_u8 }
own = Ed25519PublicKey.from_bytes(Ed25519.public_key(seed))
check own.is_a?(Ed25519PublicKey) && own.verify("signed", Ed25519.sign(seed, "signed")) && !own.verify("signed!", Ed25519.sign(seed, "signed")), "a key read from its bytes verifies what its seed signed, and nothing else"
puts "  Ed25519 keys and signatures in certificates: three chains held, three refused, three keys refused"

puts "== a client's certificate (X509Purpose::Client)"

# The same chains as above, checked for clientAuth: what is for clientAuth
# alone holds, and a leaf for serverAuth alone does not.
def for_client(leaf : Int32, intermediates : Array(Int32)) : Array(Certificate) | X509Error
  X509.verify(cert(CERTS[leaf]), intermediates.map { |i| cert(CERTS[i]) }, [cert(CERTS[2])], nil, NOW, X509Purpose::Client)
end

[{27, [1], "a leaf for clientAuth only"}, {0, [28], "an intermediate for clientAuth only"}, {0, [1], "a chain with no extKeyUsage"}].each do |c|
  answer = for_client(c[0], c[1])
  check answer.is_a?(Array(Certificate)), "#{c[2]}, as a client's: #{answer.is_a?(X509Error) ? answer.message : ""}"
end
[{26, [1], "CN=leaf is not allowed clientAuth", "a leaf for serverAuth only"}, {29, [1], "is a CA certificate, not a client's", "a CA leaf"}].each do |c|
  answer = for_client(c[0], c[1])
  raise "ASSERTION FAILED: #{c[3]}, as a client's: expected a refusal, got a chain" unless answer.is_a?(X509Error)
  check answer.message.includes?(c[2]), "#{c[3]}, as a client's: refused with #{answer.message.inspect}, not #{c[2].inspect}"
end
puts "  clientAuth leaves and issuers held, a serverAuth-only leaf and a CA leaf refused"

puts "\nALL CHECKS PASSED"
