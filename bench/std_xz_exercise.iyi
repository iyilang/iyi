# Exercises `std/xz`.
#
# Run via:
#     ./bin/iyi run bench/std_xz_exercise.iyi
#     ./bin/iyi run bench/std_xz_exercise.iyi <fixtures>
#
# Alone, it reads XZ Utils' own test files that are small enough to carry
# here (the `tests/files` of XZ Utils 5.8.1, 0BSD): the four check types,
# every kind of LZMA2 chunk, three delta filters, empty streams joined and
# padded, the three ways a .lzma file may end; whole, a byte to seven
# bytes a piece and a read; and the bad ones refused by name. With a
# directory, the streams Python's `lzma` and `xz` wrote there are read
# back and compared, every file of XZ Utils' suite is read or refused,
# and 64 MiB is streamed in bounded memory;
# `bench/std_xz_exercise.sh` is the other half of that conversation.

module bench/std_xz_exercise

import std/xz::{Xz, XzReader, XzFormat, XzError}
import std/digest::{CRC32}
import std/gc::{GC}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def unhex(s : String) : String
  digits = s.to_unsafe
  String.new(s.bytesize // 2) do |dst|
    i = 0
    while i < s.bytesize // 2
      dst[i] = (nibble(digits[2 * i]) * 16 + nibble(digits[2 * i + 1])).to_u8
      i = i + 1
    end
  end
end

def nibble(c : UInt8) : Int32
  c <= 57_u8 ? c.to_i32 - 48 : c.to_i32 - 87
end

# A source that gives *stream* in pieces whose sizes go round *sizes*,
# and counts what it has been asked for.
class Feed
  getter calls : Int32
  getter at : Int32

  def initialize(@stream : String, @sizes : Array(Int32))
    @at = 0
    @calls = 0
  end

  def next : String?
    n = @sizes[@calls % @sizes.size]
    @calls = @calls + 1
    return nil if @at >= @stream.bytesize
    n = @stream.bytesize - @at if n > @stream.bytesize - @at
    src = @stream.to_unsafe + @at.to_i64
    @at = @at + n
    String.new(n) { |dst| dst.copy_from(src, n) }
  end
end

# Every byte a reader gives, reads of a size that goes round *reads*, or
# the error it answers instead.
def drain(z : XzReader, reads : Array(Int32)) : String | XzError
  all = String::Builder.new
  k = 0
  while true
    max = reads[k % reads.size]
    k = k + 1
    piece = z.read(max)
    case piece
    when XzError
      return piece
    else
      assert_true piece.bytesize <= max, "a read of #{max} answered #{piece.bytesize} bytes"
      break if piece.bytesize == 0
      all << piece
    end
  end
  assert_true z.finished?, "a reader that answered \"\" is finished"
  all.to_s
end

def stream_through(format : XzFormat, stream : String, pieces : Array(Int32), reads : Array(Int32), limit : Int64 = XzReader::DICT_LIMIT) : String | XzError
  feed = Feed.new(stream, pieces)
  z = XzReader.new(format, limit) { feed.next }
  drain(z, reads)
end

def streamed(format : XzFormat, stream : String, pieces : Array(Int32), reads : Array(Int32), label : String) : String
  got = stream_through(format, stream, pieces, reads)
  case got
  when XzError
    raise "ASSERTION FAILED: #{label}, pieces of #{pieces} and reads of #{reads}: refused with #{got.message.inspect}"
  else
    got
  end
end

def refused(format : XzFormat, stream : String, pieces : Array(Int32), phrase : String, label : String, limit : Int64 = XzReader::DICT_LIMIT) : XzError
  got = stream_through(format, stream, pieces, [65536], limit)
  case got
  when XzError
    assert_true got.message.includes?(phrase), "#{label}: refused with #{got.message.inspect}, which does not say #{phrase.inspect}"
    got
  else
    raise "ASSERTION FAILED: #{label}: read #{got.bytesize} bytes instead of refusing"
  end
end

def whole(format : XzFormat, stream : String, label : String) : String
  got = Xz.decompress(stream, format)
  case got
  when XzError
    raise "ASSERTION FAILED: #{label}, whole: refused with #{got.message.inspect}"
  else
    got
  end
end

ONE_TO_SEVEN = [1, 2, 3, 4, 5, 6, 7]

# The stream whole, then fed a byte, seven bytes, one to seven bytes and
# all at once, each read back 64 KiB and one to seven bytes at a time.
def every_feed(format : XzFormat, stream : String, plain : String, label : String) : Nil
  assert_true whole(format, stream, label) == plain, "#{label}, whole"
  all = stream.bytesize > 0 ? stream.bytesize : 1
  [[1], [7], ONE_TO_SEVEN, [all]].each do |pieces|
    [[65536], ONE_TO_SEVEN].each do |reads|
      assert_true streamed(format, stream, pieces, reads, label) == plain, "#{label}, pieces of #{pieces} and reads of #{reads}"
    end
  end
end

def flip(s : String, at : Int32, mask : UInt8) : String
  String.new(s.bytesize) do |dst|
    dst.copy_from(s.to_unsafe, s.bytesize)
    dst[at] = dst[at] ^ mask
  end
end

def piece_of(s : String, from : Int32, n : Int32) : String
  src = s.to_unsafe + from.to_i64
  String.new(n) { |dst| dst.copy_from(src, n) }
end

hello = "Hello\nWorld!\n"
# Each line of it ends in a space, as the file's own text does.
lorem = "Lorem ipsum dolor sit amet, consectetur adipisicing \nelit, sed do eiusmod tempor incididunt ut \nlabore et dolore magna aliqua. Ut enim \n" +
        "ad minim veniam, quis nostrud exercitation ullamco \nlaboris nisi ut aliquip ex ea commodo \nconsequat. Duis aute irure dolor in reprehenderit \n" +
        "in voluptate velit esse cillum dolore eu \nfugiat nulla pariatur. Excepteur sint occaecat cupidatat \nnon proident, sunt in culpa qui officia \n" +
        "deserunt mollit anim id est laborum. \n"

# XZ Utils' `tests/files`, the ones under 600 bytes: what each holds is
# in that directory's README.
good = [
  {"good-1-check-none.xz", XzFormat::Xz, "fd377a585a000000ff12d9410200210108000000d80f231301000548656c6c6f0a020006576f726c64210a000001200d34edb3cb06729e7a010000000000595a", hello},
  {"good-1-check-crc32.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a020006576f726c64210a0043a3a2150001240d3028dfaf9042990d010000000001595a", hello},
  {"good-1-check-crc64.xz", XzFormat::Xz, "fd377a585a000004e6d6b4460200210108000000d80f231301000548656c6c6f0a020006576f726c64210a00ef2e88119d3f96ca0001280d3c676a031fb6f37d010000000004595a", hello},
  {"good-1-check-sha256.xz", XzFormat::Xz, "fd377a585a00000ae1fb0ca10200210108000000d80f231301000548656c6c6f0a020006576f726c64210a008e5935e7e13368cd9688fe8f48a0955293676a021562582c7e848dafe13fb0460001400d93864eae189b4b9a01000000000a595a", hello},
  {"good-0-empty.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d010000000001595a", ""},
  {"good-0cat-empty.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d010000000001595afd377a585a0000016922de36000000001cdf44219042990d010000000001595a", ""},
  {"good-0catpad-empty.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d010000000001595a00000000fd377a585a0000016922de36000000001cdf44219042990d010000000001595a", ""},
  {"good-2-lzma2.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a000000163596310200210108000000d80f2313010006576f726c64210a0000ddd1ca5300021a061b07000006dce75d3e300d8b020000000001595a", hello},
  {"good-1-block_header-1.xz", XzFormat::Xz, "fd377a585a0000016922de3603c0110d21010800000000007fde39eb01000c48656c6c6f0a576f726c64210a0000000043a3a2150001250d7119c4b69042990d010000000001595a", hello},
  {"good-1-block_header-2.xz", XzFormat::Xz, "fd377a585a0000016922de3602401121010800003a4c88e101000c48656c6c6f0a576f726c64210a0000000043a3a2150001210d75dca8d29042990d010000000001595a", hello},
  {"good-1-block_header-3.xz", XzFormat::Xz, "fd377a585a0000016922de3602800d21010800005111815901000c48656c6c6f0a576f726c64210a0000000043a3a2150001210d75dca8d29042990d010000000001595a", hello},
  {"good-1-lzma2-1.xz", XzFormat::Xz, "", lorem},
  {"good-1-lzma2-2.xz", XzFormat::Xz, "", lorem},
  {"good-1-lzma2-3.xz", XzFormat::Xz, "", lorem},
  {"good-1-lzma2-4.xz", XzFormat::Xz, "", lorem},
  {"good-1-lzma2-5.xz", XzFormat::Xz, "fd377a585a0000016922de360200210110000000a8708e860000000000000000000111003b965f739042990d010000000001595a", ""},
  {"good-1-3delta-lzma2.xz", XzFormat::Xz, "", lorem},
  {"good-known_size-with_eopm.lzma", XzFormat::Lzma, "5d001000000d0000000000000000241949986f051527270d7678d02a681715ffff75f80000", hello},
  {"good-known_size-without_eopm.lzma", XzFormat::Lzma, "5d001000000d0000000000000000241949986f051527270d7678d0291d2000", hello},
  {"good-unknown_size-with_eopm.lzma", XzFormat::Lzma, "5d00100000ffffffffffffffff00241949986f051527270d7678d02a681715ffff75f80000", hello},
]

bad = [
  {"bad-0-backward_size.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44213591c5c6000000000001595a", "xz: the stream footer's index size does not match the index"},
  {"bad-0-footer_magic.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d0100000000015958", "xz: the stream footer's magic bytes are not YZ"},
  {"bad-0-header_magic.xz", XzFormat::Xz, "fd377a58590000016922de36000000001cdf44219042990d010000000001595a", "xz: not an xz stream (the magic bytes are not FD 37 7A 58 5A 00)"},
  {"bad-0-nonempty_index.xz", XzFormat::Xz, "fd377a585a0000016922de36000100002bb586209042990d010000000001595a", "xz: the index lists 1 blocks where the stream has 0"},
  {"bad-0-empty-truncated.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d01000000000159", "xz: the stream ends inside its footer"},
  {"bad-0pad-empty.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d010000000001595a0000000000", "xz: the stream padding is not a multiple of four bytes"},
  {"bad-0cat-alone.xz", XzFormat::Xz, "fd377a585a0000016922de36000000001cdf44219042990d010000000001595a5d00000100ffffffffffffffff0083fffbffffc0000000", "xz: what follows the stream is neither padding nor another stream"},
  {"bad-1-block_header-3.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f233301000548656c6c6f0a020006576f726c64210a0043a3a2150001240d3028dfaf9042990d010000000001595a", "xz: a block header's CRC32 does not match"},
  {"bad-1-block_header-5.xz", XzFormat::Xz, "fd377a585a0000016922de3603c0000d2101080000000000a934552301000c48656c6c6f0a576f726c64210a0000000043a3a2150001250d7119c4b69042990d010000000001595a", "xz: a block header gives a compressed size of zero"},
  {"bad-1-check-crc32.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a020006576f726c64210a0043a3a2140001240d3028dfaf9042990d010000000001595a", "xz: a block's CRC32 does not match (15a2a343, stream says 14a2a343)"},
  {"bad-1-check-crc64.xz", XzFormat::Xz, "fd377a585a000004e6d6b4460200210108000000d80f231301000548656c6c6f0a020006576f726c64210a00ef2e88119d3f96cb0001280d3c676a031fb6f37d010000000004595a", "xz: a block's CRC64 does not match (ca963f9d11882eef, stream says cb963f9d11882eef)"},
  {"bad-1-check-sha256.xz", XzFormat::Xz, "fd377a585a00000ae1fb0ca10200210108000000d80f231301000548656c6c6f0a020006576f726c64210a008e5935e7e13368cd9688fe8f48a0955293676a021562582c7e848dafe13fb0470001400d93864eae189b4b9a01000000000a595a", "xz: a block's SHA-256 does not match"},
  {"bad-1-lzma2-1.xz", XzFormat::Xz, "fd377a585a000000ff12d9410200210108000000d80f231302000548656c6c6f0a020006576f726c64210a000001200d34edb3cb06729e7a010000000000595a", "LZMA2: the first chunk does not reset the dictionary"},
  {"bad-1-lzma2-2.xz", XzFormat::Xz, "", "LZMA2: a distance reaches before the output began"},
  {"bad-1-lzma2-6.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a030006576f726c64210a0043a3a2150001240d3028dfaf9042990d010000000001595a", "LZMA2: control byte 0x03 is not one LZMA2 defines"},
  {"bad-1-lzma2-7.xz", XzFormat::Xz, "", "LZMA2: a chunk's data ends before its compressed size"},
  {"bad-1-stream_flags-1.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a020006576f726c64210a0043a3a2150001240d3028dfaf2a139094010000000002595a", "xz: the stream footer's flags do not match its header"},
  {"bad-1-stream_flags-2.xz", XzFormat::Xz, "fd377a585a0000016922de760200210108000000d80f231301000548656c6c6f0a020006576f726c64210a0043a3a2150001240d3028dfaf9042990d010000000001595a", "xz: the stream header's CRC32 does not match"},
  {"bad-2-compressed_data_padding.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a000001163596310200210108000000d80f2313010006576f726c64210a0000ddd1ca5300021a061b07000006dce75d3e300d8b020000000001595a", "xz: a block's padding is not zero"},
  {"bad-2-index-1.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a000000163596310200210108000000d80f2313010006576f726c64210a0000ddd1ca5300021b061a070000c668072e3e300d8b020000000001595a", "xz: the index does not match the blocks"},
  {"bad-2-index-3.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a000000163596310200210108000000d80f2313010006576f726c64210a0000ddd1ca5300021a061b07000190ece02a3e300d8b020000000001595a", "xz: the index's padding is not zero"},
  {"bad-2-index-4.xz", XzFormat::Xz, "fd377a585a0000016922de360200210108000000d80f231301000548656c6c6f0a000000163596310200210108000000d80f2313010006576f726c64210a0000ddd1ca5300021a061b07000006dce75c3e300d8b020000000001595a", "xz: the index's CRC32 does not match"},
  {"unsupported-check.xz", XzFormat::Xz, "fd377a585a000002d373d7af0200210108000000d80f231301000548656c6c6f0a020006576f726c64210a0043a3a2150001240d3028dfaf2a139094010000000002595a", "xz: check type 2 is not one this reader verifies (none, CRC32, CRC64 or SHA-256)"},
  {"unsupported-filter_flags-1.xz", XzFormat::Xz, "fd377a585a0000016922de3602007f0000000000006773dd01000548656c6c6f0a020006576f726c64210a0043a3a2150001240d3028dfaf9042990d010000000001595a", "xz: the last filter is not LZMA2"},
  {"bad-too_big_size-with_eopm.lzma", XzFormat::Lzma, "5d001000000e0000000000000000241949986f051527270d7678d02a681715ffff75f80000", "lzma: the end marker comes before the uncompressed size its header gives"},
  {"bad-too_small_size-without_eopm-1.lzma", XzFormat::Lzma, "5d001000000c0000000000000000241949986f051527270d7678d0291d2000", "lzma: the data goes on past the uncompressed size its header gives"},
  {"bad-unknown_size-without_eopm.lzma", XzFormat::Lzma, "5d00100000ffffffffffffffff00241949986f051527270d7678d0291d2000", "lzma: the stream ends inside the LZMA data"},
]

puts "== the format's own words"
good.each do |v|
  assert_true whole(v[1], unhex(v[2]), v[0]) == v[3], "#{v[0]} reads back"
end
puts "  #{good.size} of XZ Utils' good files: every check type, every LZMA2 chunk kind, three delta filters, joined and padded empty streams, three .lzma endings"
nothing = Xz.decompress("")
assert_true nothing.is_a?(XzError) && nothing.message == "xz: the stream is shorter than its header", "nothing at all is not an xz stream"
# Python's `lzma.compress(b"hello")`: one uncompressed chunk, an 8 MiB
# dictionary, CRC64.
py_hello = unhex("fd377a585a000004e6d6b4460200210116000000742fe5a301000468656c6c6f00000000b137b9dbe5da1e9b00011d05b82d80af1fb6f37d010000000004595a")
assert_true whole(XzFormat::Xz, py_hello, "python's hello") == "hello", "python's hello"
py_alone = unhex("5d00008000ffffffffffffffff00341949ee8e6821ffffffb9e00000")
assert_true whole(XzFormat::Lzma, py_alone, "python's .lzma hello") == "hello", "python's .lzma hello"
puts "  and Python's hello, in .xz and in .lzma"

puts "\n== streaming"
good.each do |v|
  every_feed(v[1], unhex(v[2]), v[3], v[0])
end
every_feed(XzFormat::Xz, py_hello, "hello", "python's hello")
every_feed(XzFormat::Lzma, py_alone, "hello", "python's .lzma hello")
puts "  each fed a byte, seven bytes, one to seven bytes and whole, read 64 KiB and one to seven bytes at a time"
# A read answers as soon as it has bytes and going on would ask the
# source for more: the first bytes of a stream come out long before the
# stream has all been fed.
kilobyte = unhex("")
feed = Feed.new(kilobyte, [1])
early = XzReader.new { feed.next }
first = early.read
case first
when XzError
  raise "ASSERTION FAILED: the first read refused with #{first.message}"
else
  assert_true first.bytesize > 0 && feed.at < kilobyte.bytesize // 2, "the first read answered #{first.bytesize} bytes after #{feed.at} of #{kilobyte.bytesize} fed"
end
assert_true !early.finished?, "a reader part way is not finished"
puts "  the first read answers after #{feed.at} of #{kilobyte.bytesize} bytes fed a byte at a time"

puts "\n== refused as a value"
bad.each do |v|
  stream = unhex(v[2])
  got = Xz.decompress(stream, v[1])
  case got
  when XzError
    assert_true got.message == v[3], "#{v[0]} refused with #{got.message.inspect}, not #{v[3].inspect}"
  else
    raise "ASSERTION FAILED: #{v[0]} read #{got.bytesize} bytes instead of refusing"
  end
  [[1], ONE_TO_SEVEN, [stream.bytesize]].each do |pieces|
    refused(v[1], stream, pieces, v[3], "#{v[0]}, pieces of #{pieces}")
  end
end
puts "  #{bad.size} of XZ Utils' bad and unsupported files, each by the sentence for what is wrong, whole and a piece at a time"
# Every proper prefix of a stream ends early, and every byte of one whose
# block carries a CRC64 changed is refused: the header CRCs, the check,
# the index's CRC32 and the footer's leave nothing that can change
# unseen.
[{"good-1-check-crc64.xz", XzFormat::Xz}, {"good-1-lzma2-4.xz", XzFormat::Xz}, {"good-1-3delta-lzma2.xz", XzFormat::Xz},
 {"good-unknown_size-with_eopm.lzma", XzFormat::Lzma}].each do |pair|
  v = good.find { |g| g[0] == pair[0] }
  next unless v
  stream = unhex(v[2])
  cut = 0
  while cut < stream.bytesize
    got = Xz.decompress(piece_of(stream, 0, cut), pair[1])
    assert_true got.is_a?(XzError), "#{pair[0]} cut at #{cut} read back"
    if got.is_a?(XzError)
      said = got.message
      assert_true said.includes?(" ends ") || said.includes?(" shorter "),
        "#{pair[0]} cut at #{cut}: #{said.inspect} does not say the stream ended"
    end
    cut = cut + 1
  end
  next if pair[1] == XzFormat::Lzma
  at = 0
  while at < stream.bytesize
    got = stream_through(pair[1], flip(stream, at, 0x55_u8), [5], [65536])
    assert_true got.is_a?(XzError), "#{pair[0]} with byte #{at} flipped read back"
    at = at + 1
  end
end
# A .lzma file has no check: its range coder ending at zero after the end
# marker is what says the last bytes are the ones written, as liblzma has
# it.
[py_alone, unhex(good[good.size - 1][2])].each do |stream|
  k = 1
  while k <= 4
    got = Xz.decompress(flip(stream, stream.bytesize - k, 1_u8), XzFormat::Lzma)
    assert_true got.is_a?(XzError), "a .lzma whose last byte but #{k - 1} changed is refused"
    k = k + 1
  end
end
puts "  every prefix of four streams ends early, and every byte of three changed is refused"
# Once refused, refused for good.
crc_bad = bad.find { |b| b[0] == "bad-1-check-crc64.xz" }
if crc_bad
  feed = Feed.new(unhex(crc_bad[2]), [64])
  broken = XzReader.new { feed.next }
  said = drain(broken, [65536])
  again = broken.read
  assert_true said.is_a?(XzError) && again.is_a?(XzError) && again.message == said.message, "a second read after the error answers it again"
  assert_true !broken.finished?, "a refused stream is not finished"
end
# The dictionary limit: Python's hello names 8 MiB, its .lzma header the
# same; under a limit of 4 MiB both are refused before anything else.
refused(XzFormat::Xz, py_hello, [1], "xz: the block's dictionary is 8 MiB, past the limit of 4 MiB", "an 8 MiB dictionary under a 4 MiB limit", 4194304_i64)
limited = Xz.decompress(py_alone, XzFormat::Lzma, 4194304_i64)
assert_true limited.is_a?(XzError) && limited.message == "lzma: the dictionary is 8 MiB, past the limit of 4 MiB", "a .lzma 8 MiB dictionary under a 4 MiB limit"
assert_true Xz.decompress(py_hello, XzFormat::Xz, 8388608_i64) == "hello", "an 8 MiB dictionary under a limit of exactly 8 MiB"
assert_true Xz.decompress(kilobyte).is_a?(String) && Xz.decompress(kilobyte, XzFormat::Xz, 33554432_i64).is_a?(XzError), "xz -9e's 64 MiB, read under the default and refused under 32 MiB"
puts "  a refused stream stays refused, and a dictionary past the limit is refused by its size"

puts "\n== memory"
# The dictionary grows with the output: a kilobyte written with xz -9e's
# 64 MiB dictionary costs what a kilobyte does, not 64 MiB.
GC.collect
GC.disable
before = GC.stats.bytes_since_collection
small = Xz.decompress(kilobyte)
spent = GC.stats.bytes_since_collection - before
GC.enable
assert_true small.is_a?(String) && small.bytesize == 1062, "the kilobyte reads back"
assert_true spent < 524288_u64, "a kilobyte with a 64 MiB dictionary allocated #{spent} bytes, under 512 KiB"
puts "  a kilobyte written with a 64 MiB dictionary allocates under 512 KiB"

args = Program.args
if args.size > 0
  dir = args[0]

  puts "\n== against python's lzma"
  File.read("#{dir}/manifest.txt").split('\n').each do |line|
    next if line.empty?
    parts = line.split(' ')
    name = parts[0]
    format = parts[1] == "lzma" ? XzFormat::Lzma : XzFormat::Xz
    plain = File.read("#{dir}/#{parts[2]}")
    stream = File.read("#{dir}/#{name}")
    assert_true whole(format, stream, name) == plain, "#{name}, whole"
    if parts[3] == "pieces"
      assert_true streamed(format, stream, ONE_TO_SEVEN, ONE_TO_SEVEN, name) == plain, "#{name}, one to seven bytes a piece and a read"
      assert_true streamed(format, stream, [1], [65536], name) == plain, "#{name}, a byte a piece"
    else
      assert_true streamed(format, stream, ONE_TO_SEVEN, [65536], name) == plain, "#{name}, one to seven bytes a piece"
    end
    puts "  #{name}: #{plain.bytesize} bytes"
  end

  puts "\n== xz utils' own files"
  File.read("#{dir}/suite.txt").split('\n').each do |line|
    next if line.empty?
    tab = line.index('\t') || line.bytesize
    name = line[0, tab]
    phrase = tab < line.bytesize ? line[tab + 1, line.bytesize - tab - 1] : ""
    format = name.ends_with?(".lzma") ? XzFormat::Lzma : XzFormat::Xz
    stream = File.read("#{dir}/suite/#{name}")
    got = Xz.decompress(stream, format)
    if phrase.empty?
      want = File.read("#{dir}/suite/#{name}.out")
      assert_true got == want, "#{name} reads back what xz reads (#{got.is_a?(XzError) ? got.message : "different bytes"})"
      assert_true streamed(format, stream, ONE_TO_SEVEN, ONE_TO_SEVEN, name) == want, "#{name}, a piece at a time"
    else
      assert_true got.is_a?(XzError) && got.message.includes?(phrase), "#{name} refused with #{got.is_a?(XzError) ? got.message.inspect : "nothing"}, not #{phrase.inspect}"
      refused(format, stream, ONE_TO_SEVEN, phrase, "#{name}, a piece at a time")
    end
  end
  puts "  every file of XZ Utils' suite read as xz reads it or refused by name"

  puts "\n== 64 MiB in bounded memory"
  # A 64 MiB stream with an 8 MiB dictionary, read 64 KiB at a time and
  # each piece dropped: what the collector keeps is the dictionary and
  # the input buffer, measured across the read, not the output.
  big = File.read("#{dir}/big.xz")
  want_crc = File.read("#{dir}/big.crc").strip
  feed = Feed.new(big, [65536])
  GC.collect
  base = GC.stats.bytes_kept_by_last_sweep
  most = 0_u64
  reader = XzReader.new { feed.next }
  total = 0_i64
  crc = 0_u32
  reads = 0
  t0 = IyiMark.now_ns
  while true
    piece = reader.read(65536)
    case piece
    when XzError
      raise "ASSERTION FAILED: 64 MiB refused with #{piece.message}"
    else
      break if piece.empty?
      total = total + piece.bytesize.to_i64
      crc = CRC32.update(crc, piece.to_unsafe, piece.bytesize)
    end
    reads = reads + 1
    if reads % 128 == 0
      GC.collect
      kept = GC.stats.bytes_kept_by_last_sweep
      most = kept - base if kept > base && kept - base > most
    end
  end
  t1 = IyiMark.now_ns
  assert_true total == 67108864_i64 && crc.to_s == want_crc, "64 MiB read back (#{total} bytes, CRC-32 #{crc} against #{want_crc})"
  assert_true most < 12582912_u64, "streaming 64 MiB through an 8 MiB dictionary kept #{most} bytes, under 12 MiB"
  puts "  64 MiB read 64 KiB at a time, the collector keeping under 12 MiB"
  STDERR.puts "  iyi: 64 MiB streamed in #{(t1 - t0) // 1000000} ms"
  prose = File.read("#{dir}/prose.p6.xz")
  t2 = IyiMark.now_ns
  inflated = Xz.decompress(prose)
  t3 = IyiMark.now_ns
  assert_true inflated.is_a?(String), "the prose reads back"
  STDERR.puts "  iyi: Xz.decompress of #{prose.bytesize} bytes to #{inflated.is_a?(String) ? inflated.bytesize : 0} in #{(t3 - t2) // 1000000} ms"
end

puts "\nALL CHECKS PASSED"
