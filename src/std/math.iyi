  ] of UInt64

  def self.log2(value : Float64) : Float64
    ix = IyiFloatText.bits_of(value)
    # 1 - 0x1.5b51p-5 <= x < 1 + 0x1.6ab2p-5: the polynomial in x - 1.
    if ix &- 0x3feea4af00000000_u64 < 0x3ff0b55900000000_u64 &- 0x3feea4af00000000_u64
      return 0.0 if ix == 0x3ff0000000000000_u64
      r = value - 1.0
      rhi = IyiFloatText.from_bits(IyiFloatText.bits_of(r) & 0xffffffff00000000_u64)
      rlo = r - rhi
      hi = rhi * LOG2_INVLN2HI
      lo = rlo * LOG2_INVLN2HI + r * LOG2_INVLN2LO
      r2 = r * r
      r4 = r2 * r2
      p = r2 * (LOG2_B0 + r * LOG2_B1)
      y = hi + p
      lo = lo + (hi - y + p)
      lo = lo + r4 * (LOG2_B2 + r * LOG2_B3 + r2 * (LOG2_B4 + r * LOG2_B5) + r4 * (LOG2_B6 + r * LOG2_B7 + r2 * (LOG2_B8 + r * LOG2_B9)))
      return y + lo
    end
    top = ix.unsafe_shr(48_u64).to_i64
    if top < 0x10_i64 || top >= 0x7ff0_i64
      return (1.0 / 0.0) * -1.0 if ix &* 2_u64 == 0_u64
      return value if ix == 0x7ff0000000000000_u64
      return (value - value) / (value - value) if top & 0x8000_i64 != 0_i64 || top & 0x7ff0_i64 == 0x7ff0_i64
      ix = IyiFloatText.bits_of(value * 4503599627370496.0) &- 0x0340000000000000_u64
    end
    tmp = ix &- 0x3fe6000000000000_u64
    i = (tmp.unsafe_shr(46_u64) & 63_u64).to_i32
    k = tmp.unsafe_to_i64 >> 52
    iz = ix &- (tmp & 0xfff0000000000000_u64)
    table = LOG2_TAB.to_unsafe
    invc = IyiFloatText.from_bits(table[i * 4])
    logc = IyiFloatText.from_bits(table[i * 4 + 1])
    z = IyiFloatText.from_bits(iz)
    kd = k.to_f64
    r = (z - IyiFloatText.from_bits(table[i * 4 + 2]) - IyiFloatText.from_bits(table[i * 4 + 3])) * invc
    rhi = IyiFloatText.from_bits(IyiFloatText.bits_of(r) & 0xffffffff00000000_u64)
    rlo = r - rhi
    t1 = rhi * LOG2_INVLN2HI
    t2 = rlo * LOG2_INVLN2HI + r * LOG2_INVLN2LO
    t3 = kd + logc
    hi = t3 + t1
    lo = t3 - hi + t1 + t2
    r2 = r * r
    r4 = r2 * r2
    p = LOG2_A0 + r * LOG2_A1 + r2 * (LOG2_A2 + r * LOG2_A3) + r4 * (LOG2_A4 + r * LOG2_A5)
    lo + r2 * p + hi
  end

  def self.log2(value : Float32) : Float32
    log2(value.to_f64).to_f32
  end

  def self.log2(value : T) : Float64 forall T
    log2(value.to_f64)
  end

  # log10 as glibc computes it - fdlibm's `e_log10.c`, which glibc still
  # carries, on the `log` above: x = 2^n m with n rounded toward the one
  # that keeps m's logarithm small, then n log10(2) in a 40-bit part and
  # the rest, plus log(m) / ln 10. A power of ten is its exponent exactly.
  # `log(x) / ln 10` with a whole-number check, which this replaces,
  # answered differently from glibc's for more than half of 100,000
  # arguments. Sun's notice, which the file carries and asks to be kept:
  #
  #   Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
  #
  #   Developed at SunPro, a Sun Microsystems, Inc. business.
  #   Permission to use, copy, modify, and distribute this
  #   software is freely granted, provided that this notice
  #   is preserved.
  private LOG10_TWO54  = 1.80143985094819840000e+16
  private LOG10_IVLN10 = 4.34294481903251816668e-01
  private LOG10_2HI    = 3.01029995663611771306e-01
  private LOG10_2LO    = 3.69423907715893078616e-13

  def self.log10(value : Float64) : Float64
    x = value
    hx = IyiFloatText.bits_of(x).unsafe_to_i64
    k = 0_i64
    if hx < 0x0010000000000000_i64
      # Below 2^-1022: zero, negative or subnormal.
      return LOG10_TWO54 * -1.0 / x.abs if hx & 0x7fffffffffffffff_i64 == 0_i64
      return (x - x) / (x - x) if hx < 0_i64
      k = k - 54_i64
      x = x * LOG10_TWO54
      hx = IyiFloatText.bits_of(x).unsafe_to_i64
    end
    return x + x if hx >= 0x7ff0000000000000_i64
    k = k + (hx >> 52) - 1023_i64
    i = k < 0_i64 ? 1_i64 : 0_i64
    hx = (hx & 0x000fffffffffffff_i64) | ((0x3ff_i64 - i) << 52)
    y = (k + i).to_f64
    x = IyiFloatText.from_bits(hx.unsafe_to_u64)
    z = y * LOG10_2LO + LOG10_IVLN10 * log(x)
    z + y * LOG10_2HI
  end

  def self.log10(value : Float32) : Float32
    log10(value.to_f64).to_f32
  end

  def self.log10(value : T) : Float64 forall T
    log10(value.to_f64)
  end

  # log1p as glibc computes it - fdlibm's `s_log1p.c` (Sun's notice at
  # `log10`): 1 + x = 2^k (1 + f) with a correction c for the rounding of
  # 1 + x, then log(1 + f) by the series in s = f / (2 + f). The series and
  # Kahan's log(u) x / (u - 1) this replaces answered differently from
  # glibc's for about one argument in seven.
  private LOG1P_LN2_HI = 6.93147180369123816490e-01
  private LOG1P_LN2_LO = 1.90821492927058770002e-10
  private LOG1P_TWO54  = 1.80143985094819840000e+16
  private LOG1P_LP1    =   6.666666666666735130e-01
  private LOG1P_LP2    =   3.999999999940941908e-01
  private LOG1P_LP3    =   2.857142874366239149e-01
  private LOG1P_LP4    =   2.222219843214978396e-01
  private LOG1P_LP5    =   1.818357216161805012e-01
  private LOG1P_LP6    =   1.531383769920937332e-01
  private LOG1P_LP7    =   1.479819860511658591e-01

  def self.log1p(value : Float64) : Float64
    x = value
    # The high word as a signed 32-bit number, as fdlibm reads it.
    hx = high_word(x)
    hx = hx - 0x100000000_i64 if hx >= 0x80000000_i64
    ax = hx & 0x7fffffff_i64
    k = 1
    f = 0.0
    c = 0.0
    hu = 0_i64
    if hx < 0x3fda827a_i64
      # x < 0.41422.
      if ax >= 0x3ff00000_i64
        return LOG1P_TWO54 * -1.0 / 0.0 if x == -1.0
        return (x - x) / (x - x)
      end
      if ax < 0x3e200000_i64
        # |x| < 2^-29.
        return x if ax < 0x3c900000_i64
        return x - x * x * 0.5
      end
      if hx > 0_i64 || hx <= -1076707645_i64
        # -0.2929 < x < 0.41422: no reduction.
        k = 0
        f = x
        hu = 1_i64
      end
    elsif hx >= 0x7ff00000_i64
      return x + x
    end
    if k != 0
      u = 0.0
      if hx < 0x43400000_i64
        u = 1.0 + x
        hu = high_word(u)
        k = ((hu >> 20) - 1023_i64).to_i32
        c = k > 0 ? 1.0 - (u - x) : x - (u - 1.0)
        c = c / u
      else
        u = x
        hu = high_word(u)
        k = ((hu >> 20) - 1023_i64).to_i32
        c = 0.0
      end
      hu = hu & 0x000fffff_i64
      if hu < 0x6a09e_i64
        u = with_high_word(u, hu | 0x3ff00000_i64)
      else
        k = k + 1
        u = with_high_word(u, hu | 0x3fe00000_i64)
        hu = (0x00100000_i64 - hu) >> 2
      end
      f = u - 1.0
    end
    hfsq = 0.5 * f * f
    kd = k.to_f64
    if hu == 0_i64
      # |f| < 2^-20.
      if f == 0.0
        return 0.0 if k == 0
        c = c + kd * LOG1P_LN2_LO
        return kd * LOG1P_LN2_HI + c
      end
      rr = hfsq * (1.0 - 0.66666666666666666 * f)
      return f - rr if k == 0
      return kd * LOG1P_LN2_HI - ((rr - (kd * LOG1P_LN2_LO + c)) - f)
    end
    s = f / (2.0 + f)
    z = s * s
    r1 = z * LOG1P_LP1
    z2 = z * z
    r2 = LOG1P_LP2 + z * LOG1P_LP3
    z4 = z2 * z2
    r3 = LOG1P_LP4 + z * LOG1P_LP5
    z6 = z4 * z2
    r4 = LOG1P_LP6 + z * LOG1P_LP7
    rr = r1 + z2 * r2 + z4 * r3 + z6 * r4
    return f - (hfsq - s * (hfsq + rr)) if k == 0
    kd * LOG1P_LN2_HI - ((hfsq - (s * (hfsq + rr) + (kd * LOG1P_LN2_LO + c))) - f)
  end

  def self.log1p(value : Float32) : Float32
    log1p(value.to_f64).to_f32
  end

  def self.log1p(value : T) : Float64 forall T
    log1p(value.to_f64)
  end

  # pow as glibc computes it - Arm's optimized-routines pow, which glibc
  # has carried since 2.28, sharing `exp`'s table: log(x) to about 68 bits
  # as a double and a tail, the product with y split so that it is exact,
  # and exp of that with the tail folded in. Under 0.54 ulp. The pow this
  # replaces answered differently from glibc's for more than half of
  # 300,000 arguments; as with `exp`, this is glibc's build without FMA,
  # unfused on every target. Arm's notice is at `exp`; the table and the
  # coefficients are `math/pow_log_data.c`'s for N = 128, order 8.
  private POW_LN2HI =    0.6931471805598903
  private POW_LN2LO = 5.497923018708371e-14
  private POW_A0    =                  -0.5
  private POW_A1    =   -0.6666666666666679
  private POW_A2    =    0.5000000000000007
  private POW_A3    =    0.7999999995323976
  private POW_A4    =   -0.6666666663487739
  private POW_A5    =    -1.142909628459501
  private POW_A6    =    1.0000415263675542

