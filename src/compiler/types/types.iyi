end

pub abstract class PrimitiveType < ClassType
  getter bytes : Int32

  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?, @bytes : Int32)
    super(program, namespace, name, superclass)
    @struct = true
  end

  def primitive? : Bool
    true
  end

  def struct? : Bool
    true
  end
end

pub class IntegerType < PrimitiveType
  getter rank : Int32
  getter kind : NumberKind
  getter signed : Bool

  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?, bytes : Int32, @rank : Int32, @kind : NumberKind, @signed : Bool)
    super(program, namespace, name, superclass, bytes)
  end
end

pub class FloatType < PrimitiveType
  getter rank : Int32

  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?, bytes : Int32, @rank : Int32)
    super(program, namespace, name, superclass, bytes)
  end
end

pub class CharType < PrimitiveType
  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?)
    super(program, namespace, name, superclass, 4)
  end
end

pub class BoolType < PrimitiveType
  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?)
    super(program, namespace, name, superclass, 1)
  end
end

pub class SymbolType < PrimitiveType
  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?)
