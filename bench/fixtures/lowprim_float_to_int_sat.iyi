  end

  @[Primitive(:unchecked_convert)]
  def sat_u32 : UInt32
  end

  @[Primitive(:unchecked_convert)]
  def sat_u64 : UInt64
  end

  @[Primitive(:unchecked_convert)]
  def sat_u128 : UInt128
  end
end

def f32_sat_i8(x : Float32) : Int8
  x.sat_i8
end

def f32_sat_i16(x : Float32) : Int16
  x.sat_i16
end

def f32_sat_i32(x : Float32) : Int32
  x.sat_i32
end

