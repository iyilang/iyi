; iyi-ir 1
source_filename = "identities"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @add_zero(i32 %x) {
entry:
  %v = add i32 %x, 0
  ret i32 %v
}

define internal i32 @mul_one(i32 %x) {
entry:
  %v = mul i32 %x, 1
  ret i32 %v
}

define internal i32 @mul_zero(i32 %x) {
entry:
  %v = mul i32 %x, 0
  ret i32 %v
}

define internal i32 @and_zero(i32 %x) {
entry:
  %v = and i32 %x, 0
  ret i32 %v
}

define internal i32 @and_all(i32 %x) {
entry:
  %v = and i32 %x, -1
  ret i32 %v
}

define internal i32 @or_zero(i32 %x) {
entry:
  %v = or i32 %x, 0
  ret i32 %v
}

define internal i32 @or_all(i32 %x) {
entry:
  %v = or i32 %x, -1
  ret i32 %v
}

define internal i32 @xor_zero(i32 %x) {
entry:
  %v = xor i32 %x, 0
  ret i32 %v
}

define internal i32 @shl_zero(i32 %x) {
entry:
  %v = shl i32 %x, 0
  ret i32 %v
}

define internal i32 @lshr_zero(i32 %x) {
entry:
  %v = lshr i32 %x, 0
  ret i32 %v
}

define internal i32 @ashr_zero(i32 %x) {
entry:
  %v = ashr i32 %x, 0
  ret i32 %v
}

define internal i32 @sub_self(i32 %x) {
entry:
  %v = sub i32 %x, %x
  ret i32 %v
}

define internal i32 @xor_self(i32 %x) {
entry:
  %v = xor i32 %x, %x
  ret i32 %v
}

define internal i32 @and_self(i32 %x) {
entry:
  %v = and i32 %x, %x
  ret i32 %v
}

define internal i32 @or_self(i32 %x) {
entry:
  %v = or i32 %x, %x
  ret i32 %v
}

define internal i1 @eq_self(i32 %x) {
entry:
  %v = icmp eq i32 %x, %x
  ret i1 %v
}

define internal i1 @ne_self(i32 %x) {
entry:
  %v = icmp ne i32 %x, %x
  ret i1 %v
}

define internal i1 @slt_self(i32 %x) {
entry:
  %v = icmp slt i32 %x, %x
  ret i1 %v
}

define internal i1 @sle_self(i32 %x) {
entry:
  %v = icmp sle i32 %x, %x
  ret i1 %v
}

define internal i32 @select_same(i1 %c, i32 %x) {
entry:
  %v = select i1 %c, i32 %x, i32 %x
  ret i32 %v
}
