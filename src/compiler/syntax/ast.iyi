  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @name.hash
    h = 31 &* h &+ @body.hash
    h = 31 &* h &+ (@union ? 1 : 0)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << (@union ? "union " : "struct ") << @name << "
  "
    @body.to_s(sb)
    sb << "
end"
  end
end

pub class EnumDef < ASTNode
  property name : Path
  property members : Array(ASTNode)
  property base_type : ASTNode?

  def initialize(@name : Path = Path.new(""), @members : Array(ASTNode) = [] of ASTNode, @base_type : ASTNode? = nil)
  end

  def clone_without_location : self
    EnumDef.new(@name.clone.as(Path), clone_nodes(@members), clone_node(@base_type))
  end

  def accept_children(visitor) : Nil
    @name.accept(visitor)
    if bt = @base_type
      bt.accept(visitor)
    end
    @members.each { |m| m.accept(visitor) }
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@members == other.members) && (@base_type == other.base_type)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@members)
    h = 31 &* h &+ hash_val(@base_type)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "enum "
    @name.to_s(sb)
    if bt = @base_type
      sb << " : "
      bt.to_s(sb)
    end
    sb << "
"
    @members.each do |m|
      sb << "  "
      m.to_s(sb)
      sb << "
"
    end
    sb << "end"
  end
end

