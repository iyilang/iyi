# Resumption scenarios: a first connection through a TlsSession, which
# must hold one ticket after it; then a second, which comes to "resumed",
# "full" (a full handshake, the ticket declined), or the refusal named.
RESUMPTIONS = [
  {"resume", "resumed"},
  {"resume-declined", "full"},
  {"resume-identity", "a ServerHello choosing PSK identity 1, of one offered (illegal_parameter)"},
  {"resume-hash", "a ServerHello resuming under TLS_AES_256_GCM_SHA384, whose hash is not the ticket's (illegal_parameter)"},
  {"resume-no-share", "a ServerHello with no key share (missing_extension)"},
  {"resume-cert", "Certificate where Finished belongs, in a resumed handshake (unexpected_message)"},
]

# One connection, its echo read through a session: the scenario, the
# tickets the session must then hold, and what the read must end with
# ("" for the echo).
TICKET_SCENARIOS = [
  {"ticket-many", 8, ""},
  {"ticket-huge", 0, ""},
  {"ticket-bad", 0, "a NewSessionTicket cut short (decode_error)"},
]

# A connection to the scripted server for *name*, through *session*, or
# why there is none.
def scripted(dir : String, name : String, config : TlsConfig, session : TlsSession, early : String? = nil) : TlsClient | TlsError
  socket = IyiSocket.connect("127.0.0.1", File.read(dir + "/port").to_i)
  return TlsError.new("no connection to the scripted server") unless socket.is_a?(IyiSocket)
  TlsClient.over(socket, name + ".tls.test", config, 3000, session, early)
end

