; iyi-ir 1
source_filename = "opaque_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8

define internal void @opaque_keep(i1 %run, ptr %source, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %volatile_value = volatile load i64, ptr %source, align 8
  %atomic_value = load i64, ptr %source, align 8 atomic acquire
  %marking = load i8, ptr @__iyi_marking, align 1
  volatile store i64 %volatile_value, ptr %out, align 8
  store i64 %atomic_value, ptr %out, align 8 atomic release
  fence seq_cst
  br label %head
done:
  ret void
}
