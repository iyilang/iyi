# The end-to-end self-host compiler tool.
#
# Thin CLI wrapper around the Compiler pipeline orchestrator (compiler/compiler).
# Produces an executable binary linking only the platform libc.

module compiler/tools/compile

import compiler/compiler

using compiler/compiler::{Compiler, CompilerConfig}

lib LibC
  fun exit(status : Int32) : NoReturn
end

module CompileTool
  def self.print_usage : Nil
    puts "Usage: iyi-compile [options] <source-file.iyi>"
    puts ""
    puts "Options:"
    puts "    -o <filename>       Output executable filename (default: a.out)"
    puts "    --emit-obj <file>   Emit object file only without linking"
    puts "    --probe-phase       Probe and print compilation phases reached"
    puts "    -v, --verbose       Print linker command"
    puts "    -h, --help          Show this help message"
  end

  def self.run : Nil
    args = Program.args
    if args.empty?
      print_usage
      LibC.exit(1)
      return
    end

    input_file : String? = nil
    output_file = "a.out"
    emit_obj_only = false
    obj_output_file : String? = nil
    verbose = false
    probe_phase = false
    i = 0
    while i < args.size
      arg = args[i]
      case arg
      when "-h", "--help"
        print_usage
        LibC.exit(0)
        return
      when "-v", "--verbose"
        verbose = true
      when "--probe-phase"
        probe_phase = true
      when "--emit-obj"
        i = i + 1
        if i < args.size
          obj_output_file = args[i]
        else
          STDERR.puts "Error: --emit-obj requires a filename"
          LibC.exit(1)
          return
        end
      when "-o"
        i = i + 1
        if i < args.size
          output_file = args[i]
        else
          STDERR.puts "Error: -o requires a filename"
          LibC.exit(1)
          return
        end
      else
        if arg.starts_with?("-")
          STDERR.puts "Error: unknown option: #{arg}"
          LibC.exit(1)
          return
        else
          input_file = arg
        end
      end
      i = i + 1
    end

    unless in_file = input_file
      STDERR.puts "Error: no input file specified"
      LibC.exit(1)
      return
    end

    unless File.exists?(in_file)
      STDERR.puts "Error: input file does not exist: #{in_file}"
      LibC.exit(1)
      return
    end

    config = CompilerConfig.new(output_file, emit_obj_only, obj_output_file, verbose, nil, probe_phase)
    compiler = Compiler.new(config)
    compiler.compile(in_file)
  end
end

CompileTool.run
