; iyi-ir 1
source_filename = "escape_fallback_padding"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Record = type <{ ptr, i8 }>
declare external ptr @__iyi_new(i64, i64, i64)
define internal i8 @fallback_padding(ptr %heap, i8 %byte) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%Record, ptr null, i32 1) to i64), i64 0, i64 0)
  store ptr %heap, ptr %p, align 8
  %tail = getelementptr i8, ptr %p, i64 8
  store i8 %byte, ptr %tail, align 1
  %v = load i8, ptr %tail, align 1
  ret i8 %v
}
