; iyi-ir 1
module "asm_clobber"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

; The first ten parameters occupy pin homes; the live result spills under pin.
; Linear must also preserve it across the clobber and preserve its caller.
define internal i64 @clobbered(i64 %d0, i64 %d1, i64 %d2, i64 %d3, i64 %d4, i64 %d5, i64 %d6, i64 %d7, i64 %d8, i64 %d9, i64 %seed) {
entry:
  %a = add i64 %seed, 1
  call void () asm sideeffect "mov x19, #99; mov x20, #99; mov x21, #99; mov x22, #99; mov x23, #99; mov x24, #99; mov x25, #99; mov x26, #99; mov x27, #99; mov x28, #99", "~{x19},~{x20},~{x21},~{x22},~{x23},~{x24},~{x25},~{x26},~{x27},~{x28}"()
  ret i64 %a
}

; The template overwrites x0, x1 and x2 with 99. The value %a is live across it and must not sit in one of them.
; Its input is a parameter, so no fold can move the addition past the template.
define internal i64 @scratched(i64 %seed) {
entry:
  %a = add i64 %seed, 1
  call void () asm sideeffect "mov x0, #99; mov x1, #99; mov x2, #99", "~{x0},~{x1},~{x2}"()
  ret i64 %a
}

define i32 @main() {
entry:
  %a = add i64 1, 100
  %v = call i64 (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) @clobbered(i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 8, i64 9, i64 100)
  %w = call i64 (i64) @scratched(i64 100)
  %sum = add i64 %a, %v
  %both = add i64 %sum, %w
  %result = sub i64 %both, 202
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i64 %result)
  ret i32 0
}
