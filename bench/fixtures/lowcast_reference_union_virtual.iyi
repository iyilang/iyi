lib LibC
  fun exit(status : Int32) : NoReturn
end

module Mark
end

abstract class Node
end

class A < Node
  include Mark
end

class B < Node
  include Mark
end

class C < Node
end

def choose(flag : Bool)
  if flag
    A.new
  else
    B.new
  end
end

def use(flag : Bool)
  item = choose(flag)
  if item.is_a?(Mark)
    x = item
  else
    x = C.new
  end
  x
end

use(true)
LibC.exit(9)
