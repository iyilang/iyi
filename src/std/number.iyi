module std/number

pub enum RoundingMode
  TiesEven
  TiesAway
  ToZero
  ToPositive
  ToNegative
end

struct ::Number
  def self.zero : self
    new(0)
  end

  def self.additive_identity : self
    zero
  end

  def self.multiplicative_identity : self
    new(1)
  end

  def + : self
    self
  end

  def abs : self
    self < 0 ? -self : self
  end

  def abs2 : self
    self * self
  end

  def sign : Int32
    self < 0 ? -1 : (self == 0 ? 0 : 1)
  end

  def zero? : ::Bool
    self == 0
  end

  def positive? : ::Bool
    self > 0
  end

  def negative? : ::Bool
    self < 0
  end

  def divmod(number)
    q = (self // number)
    r = self % number
    {q, r}
  end

  # An integer is already whole: every mode answers self. `Float64` names
  # the mode below; `round` with no arguments is the prelude's, a tie to
  # the even one, which is `TiesEven`.
  def round(mode : Std::Number::RoundingMode = Std::Number::RoundingMode.new(0)) : self
    self
  end
end

struct ::Float64
  def round(mode : Std::Number::RoundingMode) : Float64
    return self if self != self || abs >= 9007199254740992.0
    if mode == Std::Number::RoundingMode::ToZero
      self < 0.0 ? ceil : floor
    elsif mode == Std::Number::RoundingMode::ToPositive
      ceil
    elsif mode == Std::Number::RoundingMode::ToNegative
      floor
    else
      # The magnitude is rounded, then the sign put back. Its fraction is
      # the magnitude less its floor, exact for every double under 2^53
      # (under 1 the floor is zero; above it the two are within a factor of
      # two), and the fraction decides: under a half the floor, over it the
      # next integer, and at a half the mode. Adding 0.5 first rounds the
      # sum itself: 0.49999999999999994 + 0.5 is 1.0, and 4503599627370497.0
      # + 0.5 is 4503599627370498.0; the prelude's `round` did, once.
      a = abs
      f = a.floor
      d = a - f
      r = if d < 0.5
            f
          elsif d > 0.5
            f + 1.0
          elsif mode == Std::Number::RoundingMode::TiesAway
            f + 1.0
          else
            even = (f / 2.0).floor * 2.0
            even == f ? f : f + 1.0
          end
      self < 0.0 ? r * -1.0 : r
    end
  end

  # To `digits` places in the mode asked for — Crystal's
  # `round(digits, mode: ...)`: `2.675.round(2, :ties_away)` spelled
  # `2.675.round(2, RoundingMode::TiesAway)`. A negative `digits` rounds to
  # tens, hundreds, ..., dividing by the scale first as the prelude's
  # `round(digits)` does.
  def round(digits : Int32, mode : Std::Number::RoundingMode) : Float64
    return round(mode) if digits == 0
    if digits < 0
      scale = 10.0 ** (0 - digits)
      (self / scale).round(mode) * scale
    else
      scale = 10.0 ** digits
      (self * scale).round(mode) / scale
    end
  end
end
