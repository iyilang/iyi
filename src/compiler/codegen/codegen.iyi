# Code Generation - Stage 2 Self-hosting Slice: Typed AST to LLVM IR
#
# Slice boundary:
# Emits LLVM IR for top-level `fun` declarations and custom type declarations:
# - Integer and float arithmetic (+, -, *, /, //, %, &+, &-, &*, unsafe_div, unsafe_mod,
#   &, |, ^, <<, >>, unsafe_shl, unsafe_shr)
# - Integer and float comparisons (<, <=, >, >=, ==, !=)
# - Local variable allocation (stack alloca), store, and load
# - Control flow: `if`/`else` branching and phi value merges, and `while` loops
# - Calls between `fun` functions
# - Struct definitions, initialization (Point.new), field access (p.x, p.x = val)
# - Struct methods (p.distance_sq, v1.dot(v2), v1.add(v2))
# - Pointers and Pointer(T) operations (pointerof, ptr.value, ptr.value=, ptr + off, ptr - other, ptr.address, Pointer(T).new)
# - Classes with instance variables and method dispatch (Counter.new, c.count, c.increment, Multiplier.new, m.scaled)
#
# Explicitly excluded from this slice:
# - Closures and proc literals
# - Exception handling (try/catch/raise)
# - Generics instantiation beyond Pointer(T)
# - Garbage collection interface (classes use malloc directly)
# - Dynamic virtual hierarchy dispatch tables (~match<Base+>)

module compiler/codegen/codegen

import compiler/foundation/location
import compiler/syntax/ast
import compiler/syntax/parser
import compiler/syntax/visitor
import compiler/syntax/token
import compiler/semantic/top_level
import compiler/semantic/main_visitor
import compiler/llvm

using compiler/foundation/location::{Location}
using compiler/syntax/ast::{ASTNode, Annotation, Arg, ArrayLiteral, Assign, Block, BoolLiteral, Break, Call, Cast, CharLiteral, ClassDef, Def, ExceptionHandler, Expressions, FunDef, Generic, If, InstanceVar, LibDef, Next, NilLiteral, Nop, NumberLiteral, Path, PointerOf, ProcLiteral, Rescue, Return, StringInterpolation, StringLiteral, SymbolLiteral, TupleLiteral, TypeDeclaration, Var, While, Yield}
using compiler/syntax/token::{NumberKind}
using compiler/syntax/parser::{Parser}
using compiler/syntax/visitor::{Visitor}
using compiler/semantic/top_level::{SemanticProgram, TopLevelVisitor, Type, ClassType, NonGenericClassType}
using compiler/semantic/main_visitor::{MainVisitor}
using compiler/llvm/target::{Target, TargetData, TargetMachine}
using compiler/llvm/context::{Context}
using compiler/llvm/values::{LLVMType, LLVMValue, LLVMFunction, LLVMBasicBlock, Function, BasicBlock}
using compiler/llvm/module::{Module}
using compiler/llvm/builder::{Builder}

pub def register_primitive_operators(prog : SemanticProgram) : Nil
  int_names = ["Int8", "UInt8", "Int16", "UInt16", "Int32", "UInt32", "Int64", "UInt64", "Int128", "UInt128"]
  int_names.each do |tname|
    t = prog.types[tname].as(NonGenericClassType)
    ["+", "-", "*", "/", "//", "%", "&+", "&-", "&*", "unsafe_div", "unsafe_mod", "&", "|", "^", "<<", ">>", "unsafe_shl", "unsafe_shr"].each do |op|
      d = Def.new(op, [Arg.new("other", restriction: Path.new(tname))], nil, nil, nil, Path.new(tname))
      t.add_def(d)
    end
    ["<", "<=", ">", ">=", "==", "!="].each do |op|
      d = Def.new(op, [Arg.new("other", restriction: Path.new(tname))], nil, nil, nil, Path.new("Bool"))
      t.add_def(d)
    end
    ["-", "~"].each do |op|
      d = Def.new(op, [] of Arg, nil, nil, nil, Path.new(tname))
      t.add_def(d)
    end
  end

  float_names = ["Float32", "Float64"]
  float_names.each do |fname|
    ft = prog.types[fname].as(NonGenericClassType)
    ["+", "-", "*", "/"].each do |op|
      d = Def.new(op, [Arg.new("other", restriction: Path.new(fname))], nil, nil, nil, Path.new(fname))
      ft.add_def(d)
    end
    ["<", "<=", ">", ">=", "==", "!="].each do |op|
      d = Def.new(op, [Arg.new("other", restriction: Path.new(fname))], nil, nil, nil, Path.new("Bool"))
      ft.add_def(d)
    end
    d_neg = Def.new("-", [] of Arg, nil, nil, nil, Path.new(fname))
    ft.add_def(d_neg)
  end

  bool_t = prog.types["Bool"].as(NonGenericClassType)
  ["==", "!=", "&", "|", "^"].each do |op|
    d = Def.new(op, [Arg.new("other", restriction: Path.new("Bool"))], nil, nil, nil, Path.new("Bool"))
    bool_t.add_def(d)
  end
  d_not = Def.new("!", [] of Arg, nil, nil, nil, Path.new("Bool"))
  bool_t.add_def(d_not)
end

pub class CustomTypeInfo
  property name : String
  property is_struct : Bool
  property fields : Hash(String, Int32)
  property field_types : Hash(String, String)
  property field_order : Array(String)
  property methods : Hash(String, Def)
  property superclass_name : String?
  property subclasses : Array(String)
  property type_id : Int32
  property min_type_id : Int32
  property max_type_id : Int32
  property generic_name : String?
  property constants : Hash(String, ASTNode)

  def initialize(@name : String, @is_struct : Bool)
    if CodeGenVisitor.primitive_type_name?(@name)
      @is_struct = false
    end
    @fields = Hash(String, Int32).new
    @field_types = Hash(String, String).new
    @field_order = [] of String
    @methods = Hash(String, Def).new
    @superclass_name = nil
    @subclasses = [] of String
    @type_id = 0
    @min_type_id = 0
    @max_type_id = 0
    @generic_name = nil
    @constants = Hash(String, ASTNode).new
  end

  def add_field(fname : String, ftype : String) : Nil
    unless @fields.has_key?(fname)
      idx = @field_order.size
      @fields[fname] = idx
      @field_types[fname] = ftype
      @field_order << fname
    end
  end
end

pub class InlinedBlockContext
  property method_param_allocas : Hash(String, LLVMValue)
  property method_local_allocas : Hash(String, LLVMValue)
  property block_arg_allocas : Hash(String, LLVMValue)
  property block : Block
  property in_block : Bool

  def initialize(@block : Block)
    @method_param_allocas = Hash(String, LLVMValue).new
    @method_local_allocas = Hash(String, LLVMValue).new
    @block_arg_allocas = Hash(String, LLVMValue).new
    @in_block = false
  end

  def resolve_var(vname : String) : LLVMValue?
    if @in_block
      if ptr = @block_arg_allocas[vname]?
        return ptr
      end
    else
      if ptr = @method_param_allocas[vname]?
        return ptr
      end
      if ptr = @method_local_allocas[vname]?
        return ptr
      end
    end
    nil
  end
end

class InlinedBlockCallCollector < Visitor
  getter calls : Array(Call)
  property block_methods : Hash(String, Def)

  def initialize(@block_methods : Hash(String, Def))
    @calls = [] of Call
  end

  def visit(node : Call) : Bool
    if node.obj.nil? && @block_methods.has_key?(node.name) && node.block
      @calls << node
    end
    true
  end
end

class LocalVarCollector < Visitor
  getter vars : Hash(String, ASTNode)
  getter excluded : Set(String)

  def initialize(@excluded : Set(String))
    @vars = Hash(String, ASTNode).new
  end

  def visit(node : Assign) : Bool
    if node.target.is_a?(Var)
      v = node.target.as(Var)
      unless @excluded.includes?(v.name)
        @vars[v.name] ||= node.value
      end
    end
    true
  end

  def visit(node : TypeDeclaration) : Bool
    if node.var.is_a?(Var)
      v = node.var.as(Var)
      unless @excluded.includes?(v.name)
        @vars[v.name] ||= node
      end
    end
    true
  end

  def visit(node : Rescue) : Bool
    if n = node.name
      unless @excluded.includes?(n)
        @vars[n] ||= node
      end
    end
    true
  end
end

class StructCallCollector < Visitor
  getter struct_calls : Array(String)
  property custom_types : Hash(String, CustomTypeInfo)
  property var_type_names : Hash(String, String)

  def initialize(@custom_types : Hash(String, CustomTypeInfo), @var_type_names : Hash(String, String))
    @struct_calls = [] of String
  end

  def visit(node : Call) : Bool
    if obj = node.obj
      if obj.is_a?(Path)
        tname = obj.to_s
        if (info = @custom_types[tname]?) && info.is_struct && node.name == "new"
          @struct_calls << tname
        end
      elsif obj.is_a?(Var)
        vname = obj.as(Var).name
        if vtype = @var_type_names[vname]?
          if info = @custom_types[vtype]?
            if m = info.methods[node.name]?
              if rt = m.return_type
                rt_name = rt.to_s
                if (r_info = @custom_types[rt_name]?) && r_info.is_struct
                  @struct_calls << rt_name
                end
              end
            end
          end
        end
      end
    end
    true
  end
end

class ProcLiteralCollector < Visitor
  getter proc_literals : Array(ProcLiteral)

  def initialize
    @proc_literals = [] of ProcLiteral
  end

  def visit(node : ProcLiteral) : Bool
    @proc_literals << node
    false
  end

  def visit(node : ASTNode) : Bool
    true
  end
end

class GenericUsageCollector < Visitor
  getter generic_nodes : Array(Generic)
  getter saw_string : Bool

  def initialize
    @generic_nodes = [] of Generic
    @saw_string = false
  end

  def visit(node : Generic) : Bool
    @generic_nodes << node
    true
  end

  def visit(node : StringLiteral) : Bool
    @saw_string = true
    true
  end

  def visit(node : ASTNode) : Bool
    true
  end
end

class YieldFinder < Visitor
  property has_yield : Bool

  def initialize
    @has_yield = false
  end

  def visit(node : Yield) : Bool
    @has_yield = true
    false
  end

  def visit(node : ASTNode) : Bool
    !@has_yield
  end
end

class CapturedVarCollector < Visitor
  getter captured_vars : Array(String)
  property outer_vars : Set(String)
  property local_vars : Set(String)

  def initialize(@outer_vars : Set(String), proc_params : Set(String))
    @captured_vars = [] of String
    @local_vars = Set(String).new
    proc_params.each { |p| @local_vars.add(p) }
  end

  def visit(node : Assign) : Bool
    if node.target.is_a?(Var)
      vname = node.target.as(Var).name
      unless @outer_vars.includes?(vname)
        @local_vars.add(vname)
      end
    end
    true
  end

  def visit(node : Var) : Bool
    vname = node.name
    if @outer_vars.includes?(vname) && !@local_vars.includes?(vname)
      unless @captured_vars.includes?(vname)
        @captured_vars << vname
      end
    end
    true
  end

  def visit(node : ASTNode) : Bool
    true
  end
end

pub class CodeGenVisitor < Visitor
  property context : Context
  property mod : Module
  property builder : Builder
  property program : SemanticProgram
  property main_visitor : MainVisitor
  property fn_types : Hash(String, LLVMType)
  property current_fn : Function?
  property current_fn_return_type : LLVMType?
  property current_fun_def : FunDef?
  property vars : Hash(String, LLVMValue)
  property var_types : Hash(String, Type)
  property var_type_names : Hash(String, String)
  property param_values : Hash(String, LLVMValue)
  property last : LLVMValue?
  property terminated : Bool
  property custom_types : Hash(String, CustomTypeInfo)
  property llvm_struct_types : Hash(String, LLVMType)
  property current_self : LLVMValue?
  property current_self_type : String?
  property struct_call_temps : Array(LLVMValue)
  property struct_temp_index : Int32
  property block_methods : Hash(String, Def)
  property current_inlined_block : InlinedBlockContext?
  property inlined_block_contexts : Array(InlinedBlockContext)
  property inlined_block_index : Int32
  property rescue_block : LLVMBasicBlock?
  property lib_funs : Hash(Tuple(String, String), Tuple(String, LLVMType, Bool))
  property needs_value : Bool
  property proc_type : LLVMType?
  property proc_literal_allocas : Hash(String, LLVMValue)
  property closure_env_slots : Hash(String, LLVMValue)
  property closure_types : Hash(String, LLVMType)
  property closure_counter : Int32
  property proc_counts : Hash(String, Int32)
  property filename : String
  property strings : Hash(String, LLVMValue)

  def initialize(@context : Context, @mod : Module, @program : SemanticProgram, @main_visitor : MainVisitor)
    @builder = Builder.new(@context)
    @fn_types = Hash(String, LLVMType).new
    @current_fn = nil
    @current_fn_return_type = nil
    @current_fun_def = nil
    @vars = Hash(String, LLVMValue).new
    @var_types = Hash(String, Type).new
    @var_type_names = Hash(String, String).new
    @param_values = Hash(String, LLVMValue).new
    @last = nil
    @terminated = false
    @custom_types = Hash(String, CustomTypeInfo).new
    @llvm_struct_types = Hash(String, LLVMType).new
    @current_self = nil
    @current_self_type = nil
    @struct_call_temps = [] of LLVMValue
    @struct_temp_index = 0
    @block_methods = Hash(String, Def).new
    @current_inlined_block = nil
    @inlined_block_contexts = [] of InlinedBlockContext
    @inlined_block_index = 0
    @rescue_block = nil
    @lib_funs = Hash(Tuple(String, String), Tuple(String, LLVMType, Bool)).new
    @needs_value = true
    @proc_type = nil
    @proc_literal_allocas = Hash(String, LLVMValue).new
    @closure_env_slots = Hash(String, LLVMValue).new
    @closure_types = Hash(String, LLVMType).new
    @closure_counter = 0
    @proc_counts = Hash(String, Int32).new
    @filename = ""
    @strings = Hash(String, LLVMValue).new
    @loop_exit_blocks = [] of LLVMBasicBlock
    @loop_continue_blocks = [] of LLVMBasicBlock
  end

  def proc_type : LLVMType
    if pt = @proc_type
      pt
    else
      t = @context.struct_named("->")
      t.struct_set_body([@context.pointer, @context.pointer])
      @proc_type = t
      t
    end
  end

  def llvm_string_type(bytesize : Int32) : LLVMType
    @context.struct([
      @context.int32,
      @context.int32,
      @context.int32,
      @context.int8.array(bytesize + 1),
    ])
  end

  def build_string_constant(str : String) : LLVMValue
    if existing = @strings[str]?
      return existing
    end

    name = if str.bytesize > 18
             str[0, 19] + "..."
           else
             str
           end
    io = String::Builder.new
    io << "'"
    name.each_char do |ch|
      if ch == '@'
        io << '.'
      else
        io << ch
      end
    end
    io << "'"
    glob_name = io.to_s

    str_ty = llvm_string_type(str.bytesize)
    global = @mod.add_global(glob_name, str_ty)
    global.linkage = LibLLVM::Linkage::Private
    global.global_constant = true

    init_val = @context.const_struct([
      @context.int32.const_int(1),
      @context.int32.const_int(str.bytesize),
      @context.int32.const_int(str.size),
      @context.const_string(str, true),
    ])
    global.initializer = init_val
    @strings[str] = global
    global
  end

  def relative_filename : String
    fn = @filename
    if idx = fn.index("bench/fixtures/")
      fn[idx, fn.bytesize - idx]
    elsif fn.starts_with?("./")
      fn[2, fn.bytesize - 2]
    else
      fn
    end
  end

  def parse_proc_type_signature(tname : String) : Tuple(Array(String), String)
    if tname.starts_with?("Proc(") && tname.ends_with?(")")
      inner = tname[5, tname.bytesize - 6]
      parts = inner.split(",").map(&.strip)
      if parts.size == 1
        {[] of String, parts[0]}
      else
        ret = parts.pop
        {parts, ret}
      end
    else
      {[] of String, "Int32"}
    end
  end

  def infer_proc_return_type(d : Def) : String
    if rt = d.return_type
      return rt.to_s
    end
    if b = d.body
      last_exp = if b.is_a?(Expressions)
                   b.as(Expressions).expressions.last?
                 else
                   b
                 end
      if last_exp
        if last_exp.is_a?(NumberLiteral)
          k = last_exp.as(NumberLiteral).kind
          return k == NumberKind::F64 ? "Float64" : (k == NumberKind::I64 ? "Int64" : "Int32")
        elsif last_exp.is_a?(BoolLiteral)
          return "Bool"
        elsif last_exp.is_a?(Var)
          return @var_type_names[last_exp.as(Var).name]? || "Int32"
        elsif last_exp.is_a?(Call)
          c = last_exp.as(Call)
          if c.name == "==" || c.name == "!=" || c.name == "<" || c.name == "<=" || c.name == ">" || c.name == ">="
            return "Bool"
          end
        end
      end
    end
    "Int32"
  end

  def self.primitive_type_name?(name : String) : Bool
    case name
    when "Int8", "UInt8", "Int16", "UInt16", "Int32", "UInt32", "Int64", "UInt64", "Int128", "UInt128", "Float32", "Float64", "Bool", "Char"
      true
    else
      false
    end
  end

  def self.has_yield?(node : ASTNode?) : Bool
    return false if node.nil?
    yf = YieldFinder.new
    node.accept(yf)
    yf.has_yield
  end

  def self.parse_u64(s : String) : UInt64
    base = 10_u64
    i = 0
    if s.starts_with?("0x") || s.starts_with?("0X")
      base = 16_u64
      i = 2
    elsif s.starts_with?("0b") || s.starts_with?("0B")
      base = 2_u64
      i = 2
    elsif s.starts_with?("0o") || s.starts_with?("0O")
      base = 8_u64
      i = 2
    end
    val = 0_u64
    while i < s.bytesize
      c = s.to_unsafe[i]
      digit = if c >= 48_u8 && c <= 57_u8
                (c - 48_u8).to_u64
              elsif c >= 97_u8 && c <= 102_u8
                (c - 97_u8 + 10_u8).to_u64
              elsif c >= 65_u8 && c <= 70_u8
                (c - 65_u8 + 10_u8).to_u64
              else
                i = i + 1
                next
              end
      val = val * base + digit
      i = i + 1
    end
    val
  end

  def ensure_i1_condition(cond_raw : LLVMValue) : LLVMValue
    if cond_raw.type == @context.int1
      cond_raw
    elsif cond_raw.type.pointer?
      @builder.icmp(LibLLVM::IntPredicate::NE, cond_raw, @context.pointer.null)
    elsif cond_raw.type.int?
      @builder.icmp(LibLLVM::IntPredicate::NE, cond_raw, cond_raw.type.const_int(0))
    elsif cond_raw.type.void?
      @context.int1.const_int(0)
    else
      @context.int1.const_int(1)
    end
  end

  def infer_def_return_type(d : Def, info : CustomTypeInfo) : String
    if rt = d.return_type
      return rt.to_s.lstrip(':')
    end
    if b = d.body
      last_exp = if b.is_a?(Expressions)
                   b.as(Expressions).expressions.last?
                 else
                   b
                 end
      if last_exp
        if last_exp.is_a?(Assign)
          if last_exp.target.is_a?(InstanceVar)
            iv = last_exp.target.as(InstanceVar).name.lstrip('@')
            # The assigned value wins over the declared field type: on a generic
            # template the field's type is a type variable, and guessing from it
            # lands on the fallback rather than the instantiated type.
            val_node = last_exp.value
            if val_node.is_a?(Var)
              vname = val_node.as(Var).name
              # The def's own argument is authoritative and, unlike the var-type
              # map, is already populated when an instantiation is being emitted.
              d.args.each do |a|
                if a.name == vname && (r = a.restriction)
                  return r.to_s.lstrip(':')
                end
              end
              if vt = @var_type_names[vname]?
                return vt
              end
            end
            if ft = info.field_types[iv]?
              return ft
            end
          elsif last_exp.target.is_a?(Var)
            vn = last_exp.target.as(Var).name
            if vt = @var_type_names[vn]?
              return vt
            end
          end
        elsif last_exp.is_a?(InstanceVar)
          iv = last_exp.as(InstanceVar).name.lstrip('@')
          if ft = info.field_types[iv]?
            return ft
          end
        elsif last_exp.is_a?(Var)
          if vt = @var_type_names[last_exp.as(Var).name]?
            return vt
          end
        elsif last_exp.is_a?(NumberLiteral)
          k = last_exp.as(NumberLiteral).kind
          return k == NumberKind::F64 ? "Float64" : (k == NumberKind::I64 ? "Int64" : "Int32")
        elsif last_exp.is_a?(BoolLiteral)
          return "Bool"
        elsif last_exp.is_a?(Call)
          c = last_exp.as(Call)
          if c.name == "==" || c.name == "!=" || c.name == "<" || c.name == "<=" || c.name == ">" || c.name == ">="
            return "Bool"
          end
        end
      end
    end
    if d.args.empty?
      "Nil"
    else
      "Int32"
    end
  end

  def ensure_malloc : Function
    if f = @mod.get_function?("malloc")
      f
    else
      mal_ty = LLVMType.function([@context.int64], @context.pointer, false)
      @mod.add_function("malloc", mal_ty)
    end
  end

  def ensure_memset : Function
    if f = @mod.get_function?("llvm.memset.p0.i64")
      f
    else
      m_ty = LLVMType.function([@context.pointer, @context.int8, @context.int64, @context.int1], @context.void, false)
      @mod.add_function("llvm.memset.p0.i64", m_ty)
    end
  end

  def ensure_crystal_personality : Function
    if f = @mod.get_function?("__crystal_personality")
      f
    else
      pers_fn_ty = LLVMType.function([] of LLVMType, @context.int32, true)
      @mod.add_function("__crystal_personality", pers_fn_ty)
    end
  end

  def ensure_crystal_get_exception : Function
    if f = @mod.get_function?("__crystal_get_exception")
      f
    else
      get_ex_fn_ty = LLVMType.function([@context.pointer], @context.int64, false)
      @mod.add_function("__crystal_get_exception", get_ex_fn_ty)
    end
  end

  def ensure_crystal_raise : Function
    if f = @mod.get_function?("__crystal_raise")
      f
    else
      raise_fn_ty = LLVMType.function([@context.pointer], @context.void, false)
      @mod.add_function("__crystal_raise", raise_fn_ty)
    end
  end

  def llvm_type_from_name(name : String) : LLVMType
    clean_name = name.starts_with?("::") ? name[2, name.size - 2] : name
    case clean_name
    when "Int8", "UInt8"
      @context.int8
    when "Int16", "UInt16"
      @context.int16
    when "Int32", "UInt32"
      @context.int32
    when "Int64", "UInt64"
      @context.int64
    when "Int128", "UInt128"
      @context.int128
    when "Float32"
      @context.float
    when "Float64"
      @context.double
    when "Bool"
      @context.int1
    when "Char"
      @context.int32
    when "Void", "Nil", "NoReturn"
      @context.void
    else
      if clean_name.starts_with?("Proc(") || clean_name == "->"
        proc_type
      elsif ct = @closure_types[clean_name]?
        ct
      elsif clean_name.includes?("Pointer(") || clean_name.ends_with?("*") || clean_name.ends_with?('+') || clean_name.ends_with?('?') || clean_name.includes?("::Nil") || clean_name.includes?("|") || clean_name.starts_with?("Tuple(") || clean_name == "T" || clean_name == "U" || clean_name == "K" || clean_name == "V" || clean_name == "E"
        @context.pointer
      elsif info = @custom_types[clean_name]?
        if info.is_struct
          @llvm_struct_types[clean_name]
        else
          @context.pointer
        end
      else
        @context.int32
      end
    end
  end

  def llvm_type(t : Type) : LLVMType
    llvm_type_from_name(t.full_name)
  end

  def element_type_of_pointer(ptr_type_name : String) : String
    if (idx = ptr_type_name.index("Pointer(")) && ptr_type_name.ends_with?(")")
      ptr_type_name[idx + 8, ptr_type_name.bytesize - idx - 9]
    elsif ptr_type_name.ends_with?("*")
      ptr_type_name[0, ptr_type_name.bytesize - 1]
    else
      "Int32"
    end
  end

  def sizeof_type(type_name : String) : LLVMValue
    elem_ty = llvm_type_from_name(type_name)
    null_ptr = @context.pointer.null
    gep = @builder.gep(elem_ty, null_ptr, [@context.int32.const_int(1)])
    @builder.ptr_to_int(gep, @context.int64)
  end

  def align_of_type(type_name : String) : Int32
    case type_name
    when "Int64", "UInt64", "Float64"
      8
    when "Int32", "UInt32", "Float32", "Char"
      4
    when "Int16", "UInt16"
      2
    when "Int8", "UInt8", "Bool"
      1
    else
      if type_name.starts_with?("Proc(") || type_name == "->"
        8
      elsif type_name.starts_with?("Pointer(") || type_name.ends_with?("*") || type_name.ends_with?('+') || type_name.ends_with?('?')
        8
      elsif info = @custom_types[type_name]?
        if info.is_struct
          4
        else
          8
        end
      else
        4
      end
    end
  end

  def get_ptr_val(vname : String) : LLVMValue
    if p = @param_values[vname]?
      p
    elsif vname == "self" && (cur_self = @current_self)
      cur_self
    elsif var_ptr = @vars[vname]?
      vt = @var_type_names[vname]?
      if vt && CodeGenVisitor.primitive_type_name?(vt)
        @builder.load(llvm_type_from_name(vt), var_ptr)
      else
        @builder.load(@context.pointer, var_ptr)
      end
    else
      @context.pointer.null
    end
  end

  def class_ancestors(cname : String) : Array(String)
    res = [cname] of String
    curr = cname
    while (info = @custom_types[curr]?) && (sc = info.superclass_name)
      res << sc
      curr = sc
    end
    res
  end

  def unify_types(t1 : String, t2 : String) : String
    return t1 if t1 == t2
    if t2 == "Nil" || t2 == "Void"
      return (info = @custom_types[t1]?) && !info.is_struct ? "#{t1}?" : t1
    end
    if t1 == "Nil" || t1 == "Void"
      return (info = @custom_types[t2]?) && !info.is_struct ? "#{t2}?" : t2
    end

    base1 = t1.ends_with?('+') ? t1.rchop('+') : t1
    base2 = t2.ends_with?('+') ? t2.rchop('+') : t2

    if (info1 = @custom_types[base1]?) && (info2 = @custom_types[base2]?) && !info1.is_struct && !info2.is_struct
      anc1 = class_ancestors(base1)
      anc2 = class_ancestors(base2)
      anc1.each do |a|
        if anc2.includes?(a)
          return "#{a}+"
        end
      end
    end

    t1
  end

  def infer_var_type(vname : String, node : ASTNode) : String
    if node.is_a?(TypeDeclaration)
      return node.as(TypeDeclaration).declared_type.to_s
    end

    if node.is_a?(Rescue)
      if r_types = node.as(Rescue).types
        return r_types.first.to_s
      else
        return "Exception"
      end
    end

    if node.is_a?(Expressions)
      if last_exp = node.as(Expressions).expressions.last?
        return infer_var_type(vname, last_exp)
      end
    end

    if node.is_a?(If)
      if_n = node.as(If)
      then_t = infer_var_type(vname, if_n.then)
      else_t = if els = if_n.else
                 infer_var_type(vname, els)
               else
                 "Nil"
               end
      return unify_types(then_t, else_t)
    end

    if node.is_a?(NilLiteral)
      return "Nil"
    end
    if node.is_a?(StringLiteral)
      return "String"
    end

    if node.is_a?(Call)
      c = node.as(Call)
      if c.obj.nil? && c.name == "pointerof" && c.args.size == 1
        inner_name = c.args[0].is_a?(Var) ? c.args[0].as(Var).name : (c.args[0].is_a?(Call) ? c.args[0].as(Call).name : "")
        inner_t = @var_type_names[inner_name]? || "Int32"
        return "Pointer(#{inner_t})"
      end
      if c.obj.is_a?(Path) || c.obj.is_a?(Generic)
        obj_name = c.obj.to_s
        if c.name == "new" || c.name == "malloc"
          if obj_name.includes?("Pointer")
            elem = element_type_of_pointer(obj_name)
            return "Pointer(#{elem})"
          else
            return obj_name
          end
        end
      elsif c.name == "address"
        return "Int64"
      elsif c.obj.is_a?(StringLiteral)
        if c.name == "to_unsafe"
          return "Pointer(UInt8)"
        elsif c.name == "bytesize" || c.name == "length" || c.name == "size"
          return "Int32"
        end
      elsif c.obj.is_a?(Var)
        rec_vname = c.obj.as(Var).name
        if rec_tname = @var_type_names[rec_vname]?
          if info = @custom_types[rec_tname]?
            if info.fields.has_key?(c.name)
              return info.field_types[c.name]
            elsif m = info.methods[c.name]?
              return m.return_type ? m.return_type.to_s : "Int32"
            end
          elsif rec_tname.includes?("Pointer(") || rec_tname.ends_with?("*")
            if c.name == "value" || c.name == "[]"
              return element_type_of_pointer(rec_tname)
            elsif c.name == "+"
              return rec_tname
            elsif c.name == "-"
              return "Int64"
            end
          end
        end
      elsif c.obj.is_a?(InstanceVar)
        iv_name = c.obj.as(InstanceVar).name.lstrip('@')
        if (ctype = @current_self_type) && (c_info = @custom_types[ctype]?)
          if ftype = c_info.field_types[iv_name]?
            if ftype.includes?("Pointer(") || ftype.ends_with?('*')
              if c.name == "value" || c.name == "[]"
                return element_type_of_pointer(ftype)
              elsif c.name == "+"
                return ftype
              elsif c.name == "-"
                return "Int64"
              end
            end
          end
        end
      end
      if (c.name == "+" || c.name == "-" || c.name == "*" || c.name == "/" || c.name == "//" || c.name == "%") && c.args.size == 1 && (co = c.obj)
        lt = infer_var_type(vname, co)
        rt = infer_var_type(vname, c.args[0])
        if lt == "Float64" || rt == "Float64"
          return "Float64"
        elsif lt == "Float32" || rt == "Float32"
          return "Float32"
        elsif lt == "UInt64" || rt == "UInt64"
          return "UInt64"
        elsif lt == "Int64" || rt == "Int64"
          return "Int64"
        elsif lt == "UInt32" || rt == "UInt32"
          return "UInt32"
        end
      end
      if c.args.empty?
        if c.name == "to_f" || c.name == "to_f64"
          return "Float64"
        elsif c.name == "to_f32"
          return "Float32"
        elsif c.name == "to_i64" || c.name == "to_u64"
          return "Int64"
        elsif c.name == "to_i" || c.name == "to_i32" || c.name == "to_u32"
          return "Int32"
        elsif c.name == "to_u8" || c.name == "to_i8"
          return "UInt8"
        end
      end
    elsif node.is_a?(PointerOf)
      inner = node.as(PointerOf).exp
      inner_name = if inner.is_a?(Var)
                     inner.as(Var).name
                   elsif inner.is_a?(Call)
                     inner.as(Call).name
                   else
                     ""
                   end
      inner_t = @var_type_names[inner_name]? || "Int32"
      return "Pointer(#{inner_t})"
    elsif node.is_a?(Var)
      return @var_type_names[node.as(Var).name]? || "Int32"
    elsif node.is_a?(NumberLiteral)
      kind = node.as(NumberLiteral).kind
      return kind == NumberKind::F64 ? "Float64" : (kind == NumberKind::I64 ? "Int64" : (kind == NumberKind::U64 ? "UInt64" : (kind == NumberKind::U32 ? "UInt32" : (kind == NumberKind::F32 ? "Float32" : "Int32"))))
    elsif node.is_a?(Path)
      pname = node.as(Path).to_s
      if (ctype = @current_self_type) && (c_info = @custom_types[ctype]?)
        if const_node = c_info.constants[pname]?
          return infer_var_type(vname, const_node)
        end
      end
      @custom_types.each_value do |c_info|
        if cn = c_info.constants[pname]?
          return infer_var_type(vname, cn)
        end
      end
      return "Int32"
    elsif node.is_a?(ProcLiteral)
      pl = node.as(ProcLiteral)
      arg_types = pl.def.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
      ret_type = if rt = pl.def.return_type
                   rt.to_s
                 else
                   infer_proc_return_type(pl.def)
                 end
      all_types = [] of String
      arg_types.each { |at| all_types << at }
      all_types << ret_type
      return "Proc(#{all_types.join(", ")})"
    end
    "Int32"
  end

  def assign_class_type_ids : Nil
    next_id = 1
    assigned = Set(String).new

    @custom_types.each_value do |info|
      next if info.is_struct || info.name == "String"
      sc_name = info.superclass_name
      if sc_name.nil? || !@custom_types.has_key?(sc_name)
        next_id = assign_type_id_node(info.name, next_id, assigned)
      end
    end
  end

  def assign_type_id_node(cname : String, next_id : Int32, assigned : Set(String)) : Int32
    return next_id if assigned.includes?(cname) || cname == "String"
    info = @custom_types[cname]

    if info.subclasses.empty?
      id = next_id
      info.type_id = id
      info.min_type_id = id
      info.max_type_id = id
      assigned.add(cname)
      id + 1
    else
      curr_id = next_id
      min_id = 0
      first = true
      info.subclasses.each do |sub_name|
        if first
          min_id = curr_id
          first = false
        end
        curr_id = assign_type_id_node(sub_name, curr_id, assigned)
      end
      id = curr_id
      info.type_id = id
      info.min_type_id = min_id
      info.max_type_id = id
      assigned.add(cname)
      id + 1
    end
  end

  def collect_local_vars(body : ASTNode?, excluded : Set(String)) : Hash(String, ASTNode)
    collector = LocalVarCollector.new(excluded)
    if b = body
      b.accept(collector)
    end
    collector.vars
  end

  def collect_struct_calls(body : ASTNode?) : Array(String)
    collector = StructCallCollector.new(@custom_types, @var_type_names)
    if b = body
      b.accept(collector)
    end
    collector.struct_calls
  end

  def visit(node : Expressions) : Bool
    old_needs = @needs_value
    @needs_value = false
    last_idx = node.expressions.size - 1
    node.expressions.each_with_index do |exp, idx|
      @needs_value = true if old_needs && idx == last_idx
      exp.accept(self)
    end
    @needs_value = old_needs
    false
  end

  def visit(node : FunDef) : Bool
    arg_types = [] of LLVMType
    node.args.each do |arg|
      sem_type_name = if r = arg.restriction
                        r.to_s
                      else
                        "Int32"
                      end
      arg_types << llvm_type_from_name(sem_type_name)
    end

    ret_sem_type_name = if rt = node.return_type
                          rt.to_s
                        else
                          "Int32"
                        end
    @needs_value = (ret_sem_type_name != "Void" && ret_sem_type_name != "Nil" && ret_sem_type_name != "NoReturn")
    ret_type = llvm_type_from_name(ret_sem_type_name)

    fn_ty = LLVMType.function(arg_types, ret_type, false)
    @fn_types[node.name] = fn_ty
    fn = if existing = @mod.get_function?(node.name)
           existing
         else
           @mod.add_function(node.name, fn_ty)
         end
    if node.body && node.name.starts_with?("__crystal_") && node.name != "__crystal_personality"
      fn.linkage = LibLLVM::Linkage::Internal
    end
    @current_fn = fn
    @current_fn_return_type = ret_type
    @current_fun_def = node

    @vars.clear
    @last = nil
    @terminated = false
    excluded_names = Set(String).new
    @param_values.clear
    @var_type_names.clear
    i = 0
    while i < node.args.size
      arg = node.args[i]
      p = fn.param(i)
      p.name = arg.name
      @param_values[arg.name] = p
      excluded_names.add(arg.name)
      arg_tname = if r = arg.restriction
                    r.to_s
                  else
                    "Int32"
                  end
      @var_type_names[arg.name] = arg_tname
      i = i + 1
    end

    local_vars = collect_local_vars(node.body, excluded_names)

    # First pass: infer all variable type names
    local_vars.each do |vname, vnode|
      tname = infer_var_type(vname, vnode)
      @var_type_names[vname] = tname
    end

    proc_collector = ProcLiteralCollector.new
    if b = node.body
      b.accept(proc_collector)
    end
    @proc_literal_allocas.clear

    struct_calls = collect_struct_calls(node.body)

    @struct_call_temps.clear
    @struct_temp_index = 0
    block_collector = InlinedBlockCallCollector.new(@block_methods)
    if b = node.body
      b.accept(block_collector)
    end

    @inlined_block_contexts.clear
    @inlined_block_index = 0

    if local_vars.empty? && struct_calls.empty? && block_collector.calls.empty? && proc_collector.proc_literals.empty?
      entry_bb = fn.append_basic_block("entry")
      @builder.position_at_end(entry_bb)
    else
      alloca_bb = fn.append_basic_block("alloca")
      entry_bb = fn.append_basic_block("entry")

      @builder.position_at_end(alloca_bb)
      @vars.clear

      # 1. Named local variable allocas
      local_vars.each do |vname, vnode|
        tname = @var_type_names[vname]
        llvm_t = llvm_type_from_name(tname)
        ptr = @builder.alloca(llvm_t, vname)
        if (info = @custom_types[tname]?) && info.is_struct
          ptr.alignment = 8
        elsif tname.includes?("Pointer") || tname.ends_with?("*") || tname.ends_with?('+') || tname.ends_with?('?') || tname == "Int64" || tname == "Float64" || tname.starts_with?("Proc(") || tname == "->" || @custom_types.has_key?(tname)
          ptr.alignment = 8
        else
          ptr.alignment = 4
        end
        @vars[vname] = ptr
      end

      # 1b. Proc literal temporary allocas
      proc_collector.proc_literals.each do |pl|
        temp_ptr = @builder.alloca(proc_type, "")
        temp_ptr.alignment = 8
        @proc_literal_allocas[pl.object_id.to_s] = temp_ptr
      end

      # 2. Inlined block call allocas
      block_collector.calls.each do |b_call|
        if blk = b_call.block
          ctx = InlinedBlockContext.new(blk)
          b_def = @block_methods[b_call.name]

          # 2a. Block arguments
          blk.args.each do |b_arg|
            b_arg_tname = @var_type_names[b_arg.name]? || "Int32"
            llvm_t = llvm_type_from_name(b_arg_tname)
            ptr = @builder.alloca(llvm_t, b_arg.name)
            ptr.alignment = 4
            ctx.block_arg_allocas[b_arg.name] = ptr
          end

          # 2b. Inlined method parameters
          actual_arg_idx = 0
          b_def.args.each do |param|
            next if param.name == "block" || param.name.starts_with?('&')
            p_tname = if r = param.restriction
                        r.to_s
                      else
                        "Int32"
                      end
            llvm_t = llvm_type_from_name(p_tname)
            ptr = @builder.alloca(llvm_t, param.name)
            ptr.alignment = 4
            ctx.method_param_allocas[param.name] = ptr
            actual_arg_idx += 1
          end

          # 2c. Inlined method local variables
          m_locals = collect_local_vars(b_def.body, Set(String).new)
          m_locals.each do |mvname, mvnode|
            next if ctx.method_param_allocas.has_key?(mvname)
            mv_tname = infer_var_type(mvname, mvnode)
            llvm_t = llvm_type_from_name(mv_tname)
            ptr = @builder.alloca(llvm_t, mvname)
            ptr.alignment = 4
            ctx.method_local_allocas[mvname] = ptr
          end

          @inlined_block_contexts << ctx
        end
      end

      # 2. Unnamed temporaries for struct-by-value call returns
      struct_calls.each do |sname|
        st = @llvm_struct_types[sname]
        temp_ptr = @builder.alloca(st, "")
        temp_ptr.alignment = 8
        @struct_call_temps << temp_ptr
      end

      @builder.br(entry_bb)
      @builder.position_at_end(entry_bb)
    end

    @terminated = false
    if b = node.body
      b.accept(self)
    end

    unless @terminated
      if ret_sem_type_name == "Void" || ret_sem_type_name == "Nil"
        @builder.ret_void
      elsif ret_sem_type_name == "NoReturn"
        @builder.unreachable
      elsif l = @last
        @builder.ret(l)
      else
        @builder.ret(ret_type.const_int(0))
      end
      @terminated = true
    end

    false
  end

  def visit(node : Assign) : Bool
    old_needs = @needs_value
    @needs_value = true
    if node.target.is_a?(Var)
      var_name = node.target.as(Var).name
      @last = nil
      node.value.accept(self)
      if val = @last
        ptr = if inlined = @current_inlined_block
                inlined.resolve_var(var_name) || @vars[var_name]?
              else
                @vars[var_name]?
              end
        if slot = @closure_env_slots[var_name]?
          s_inst = @builder.store(val, slot)
          s_inst.alignment = 4
        elsif ptr
          vtype = @var_type_names[var_name]?
          expected_llvm_ty = vtype ? llvm_type_from_name(vtype) : nil
          val_to_store = if expected_llvm_ty && expected_llvm_ty != val.type
                           if expected_llvm_ty.pointer? && val.type.int?
                             @context.pointer.null
                           elsif expected_llvm_ty.int? && val.type.int?
                             if val.type.int_width > expected_llvm_ty.int_width
                               @builder.trunc(val, expected_llvm_ty)
                             elsif val.type.int_width < expected_llvm_ty.int_width
                               @builder.zext(val, expected_llvm_ty)
                             else
                               val
                             end
                           elsif expected_llvm_ty.int? && val.type.pointer?
                             expected_llvm_ty.const_int(0)
                           else
                             val
                           end
                         else
                           val
                         end
          unless val_to_store.type.void?
            s_inst = @builder.store(val_to_store, ptr)
            if vtype && (info = @custom_types[vtype]?) && info.is_struct
              s_inst.alignment = 4
            elsif vtype && (vtype.starts_with?("Proc(") || vtype == "->")
              s_inst.alignment = 8
            end
          end
        end
        @last = val
        @terminated = false
      end
    elsif node.target.is_a?(InstanceVar)
      ivar_name = node.target.as(InstanceVar).name.lstrip('@')
      if ctype = @current_self_type
        if info = @custom_types[ctype]?
          if fidx = info.fields[ivar_name]?
            node.value.accept(self)
            if val = @last
              idx = info.is_struct ? fidx : fidx + 1
              st = @llvm_struct_types[info.name]
              if cur_self = @current_self
                gep = @builder.inbounds_gep(st, cur_self, [@context.int32.const_int(0), @context.int32.const_int(idx)])
                s_inst = @builder.store(val, gep)
                ftype = info.field_types[ivar_name]? || "Int32"
                s_inst.alignment = align_of_type(ftype)
                @last = val
                @terminated = false
              end
            end
          end
        end
      end
    elsif node.target.is_a?(Call)
      call = node.target.as(Call)
      if call.name == "value" && (c_obj = call.obj)
        c_obj.accept(self)
        if ptr_val = @last
          node.value.accept(self)
          if val = @last
            s_inst = @builder.store(val, ptr_val)
            s_inst.alignment = 8
            @last = val
            @terminated = false
          end
        end
      elsif c_obj = call.obj
        setter_call = Call.new(c_obj, "#{call.name}=", [node.value] of ASTNode)
        setter_call.accept(self)
      end
    end
    @needs_value = old_needs
    false
  end

  def visit(node : InstanceVar) : Bool
    ivar_name = node.name.lstrip('@')
    if ctype = @current_self_type
      if info = @custom_types[ctype]?
        if fidx = info.fields[ivar_name]?
          idx = info.is_struct ? fidx : fidx + 1
          st = @llvm_struct_types[info.name]
          ftype = info.field_types[ivar_name]
          if cur_self = @current_self
            gep = @builder.inbounds_gep(st, cur_self, [@context.int32.const_int(0), @context.int32.const_int(idx)])
            l_inst = @builder.load(llvm_type_from_name(ftype), gep)
            l_inst.alignment = align_of_type(ftype)
            @last = l_inst
            @terminated = false
          end
        end
      end
    end
    false
  end

  def visit(node : PointerOf) : Bool
    exp = node.exp
    vname = if exp.is_a?(Var)
              exp.as(Var).name
            elsif exp.is_a?(Call)
              exp.as(Call).name
            else
              ""
            end
    if ptr = @vars[vname]?
      @last = ptr
    end
    @terminated = false
    false
  end

  def visit(node : Var) : Bool
    if slot = @closure_env_slots[node.name]?
      v_type_name = @var_type_names[node.name]? || "Int32"
      llvm_t = llvm_type_from_name(v_type_name)
      l_inst = @builder.load(llvm_t, slot, "")
      l_inst.alignment = 4
      @last = l_inst
      @terminated = false
      return false
    end
    if inlined = @current_inlined_block
      if ptr = inlined.resolve_var(node.name)
        v_type_name = @var_type_names[node.name]? || "Int32"
        llvm_t = llvm_type_from_name(v_type_name)
        l_inst = @builder.load(llvm_t, ptr, "")
        @last = l_inst
        @terminated = false
        return false
      end
    end

    if ptr = @vars[node.name]?
      v_type_name = @var_type_names[node.name]? || "Int32"
      llvm_t = llvm_type_from_name(v_type_name)
      l_inst = @builder.load(llvm_t, ptr, "")
      if (info = @custom_types[v_type_name]?) && info.is_struct
        l_inst.alignment = 4
      end
      @last = l_inst
    elsif param = @param_values[node.name]?
      @last = param
    end
    @terminated = false
    false
  end

  def visit(node : Path) : Bool
    pname = node.to_s
    if (ctype = @current_self_type) && (info = @custom_types[ctype]?)
      if const_node = info.constants[pname]?
        const_node.accept(self)
        return false
      end
    end
    @custom_types.each_value do |info|
      if const_node = info.constants[pname]?
        const_node.accept(self)
        return false
      end
    end
    @last = @context.pointer.null
    @terminated = false
    false
  end

  def visit(node : Yield) : Bool
    if inlined = @current_inlined_block
      # 1. First accept all yield expressions and store values
      exp_values = [] of LLVMValue
      node.exps.each do |exp|
        exp.accept(self)
        if val = @last
          exp_values << val
        end
      end

      # 2. Now assign exp values to block arguments
      exp_values.each_with_index do |val, i|
        if block_arg = inlined.block.args[i]?
          if ptr = inlined.block_arg_allocas[block_arg.name]?
            s_inst = @builder.store(val, ptr)
            s_inst.alignment = 4
          end
        end
      end

      # 3. Now execute block body with in_block = true
      prev_in_block = inlined.in_block
      inlined.in_block = true
      inlined.block.body.accept(self)
      inlined.in_block = prev_in_block
      @terminated = false
    end
    false
  end

  def visit(node : ProcLiteral) : Bool
    # 1. Determine captured variables
    outer_vars = Set(String).new
    @param_values.each_key { |k| outer_vars.add(k) }
    @vars.each_key { |k| outer_vars.add(k) }

    proc_params = Set(String).new
    node.def.args.each { |a| proc_params.add(a.name) }

    c_collector = CapturedVarCollector.new(outer_vars, proc_params)
    if b = node.def.body
      b.accept(c_collector)
    end
    captured = c_collector.captured_vars
    is_closure = !captured.empty?

    env_ptr : LLVMValue? = nil
    closure_ty : LLVMType? = nil

    if is_closure
      @closure_counter += 1
      closure_cname = "closure_#{@closure_counter}"
      field_llvm_tys = captured.map { |cv| llvm_type_from_name(@var_type_names[cv]? || "Int32") }
      c_struct = @context.struct_named(closure_cname)
      c_struct.struct_set_body(field_llvm_tys)
      closure_ty = c_struct
      @closure_types[closure_cname] = c_struct

      mal_fn = ensure_malloc
      mal_fn_ty = LLVMType.function([@context.int64], @context.pointer, false)
      size_val = sizeof_type(closure_cname)
      allocated_ptr = @builder.call(mal_fn_ty, mal_fn.to_value, [size_val])
      allocated_ptr.name = ""
      env_ptr = allocated_ptr

      slots = [] of LLVMValue
      captured.each_with_index do |cv, idx|
        slot = @builder.inbounds_gep(c_struct, allocated_ptr, [@context.int32.const_int(0), @context.int32.const_int(idx)])
        slot.name = "#{cv}#{idx + 1}"
        slots << slot
      end

      captured.each_with_index do |cv, idx|
        slot = slots[idx]
        cval = if p = @param_values[cv]?
                 p
               elsif var_ptr = @vars[cv]?
                 vt = @var_type_names[cv]? || "Int32"
                 lt = llvm_type_from_name(vt)
                 l_inst = @builder.load(lt, var_ptr)
                 l_inst.alignment = 4
                 l_inst
               else
                 @context.int32.const_int(0)
               end
        st = @builder.store(cval, slot)
        st.alignment = 4
      end
    end

    # 2. Build proc function
    arg_type_names = node.def.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
    ret_type_name = if rt = node.def.return_type
                      rt.to_s
                    else
                      infer_proc_return_type(node.def)
                    end
    all_type_names = [] of String
    arg_type_names.each { |at| all_type_names << at }
    all_type_names << ret_type_name
    proc_type_str = "Proc(#{all_type_names.join(", ")})"

    loc = node.location
    line_no = loc ? loc.line_number : 1
    rel_file = relative_filename
    proc_fn_name = "~proc#{proc_type_str}@#{rel_file}:#{line_no}"
    count = (@proc_counts[proc_fn_name]? || 0) + 1
    @proc_counts[proc_fn_name] = count
    if count > 1
      proc_fn_name = "#{proc_fn_name[0, 5]}#{count}#{proc_fn_name[5, proc_fn_name.bytesize - 5]}"
    end

    fn_param_tys = [] of LLVMType
    if is_closure
      fn_param_tys << @context.pointer
    end
    arg_type_names.each do |atname|
      fn_param_tys << llvm_type_from_name(atname)
    end
    ret_llvm_ty = llvm_type_from_name(ret_type_name)
    fn_ty = LLVMType.function(fn_param_tys, ret_llvm_ty, false)
    proc_fn = @mod.add_function(proc_fn_name, fn_ty)
    proc_fn.linkage = LibLLVM::Linkage::Internal

    # 3. Emit proc function body
    saved_bb = @builder.insert_block
    saved_fn = @current_fn
    saved_vars = @vars.dup
    saved_param_values = @param_values.dup
    saved_var_type_names = @var_type_names.dup

    saved_fn_ret_ty = @current_fn_return_type
    @current_fn = proc_fn
    @current_fn_return_type = ret_llvm_ty
    @param_values = Hash(String, LLVMValue).new
    @var_type_names = Hash(String, String).new

    proc_entry_bb = proc_fn.append_basic_block("entry")
    @builder.position_at_end(proc_entry_bb)

    if is_closure && closure_ty
      ctx_p = proc_fn.param(0)
      captured.each_with_index do |cv, cidx|
        cslot = @builder.inbounds_gep(closure_ty, ctx_p, [@context.int32.const_int(0), @context.int32.const_int(cidx)])
        cslot.name = cv
        @closure_env_slots[cv] = cslot
        @var_type_names[cv] = saved_var_type_names[cv]? || "Int32"
      end
    end

    node.def.args.each_with_index do |a, aidx|
      p_val = proc_fn.param(is_closure ? aidx + 1 : aidx)
      p_val.name = a.name
      @param_values[a.name] = p_val
      @var_type_names[a.name] = a.restriction ? a.restriction.to_s : "Int32"
    end

    if b = node.def.body
      b.accept(self)
      if l = @last
        @builder.ret(l)
      else
        @builder.ret_void
      end
    else
      @builder.ret_void
    end

    # Restore outer function state
    @closure_env_slots.clear
    @vars = saved_vars
    @param_values = saved_param_values
    @var_type_names = saved_var_type_names
    @current_fn = saved_fn
    @current_fn_return_type = saved_fn_ret_ty
    if sbb = saved_bb
      @builder.position_at_end(sbb)
    end

    # 4. Store into proc struct temp alloca and load
    temp_ptr = if a = @proc_literal_allocas[node.object_id.to_s]?
                 a
               else
                 p = @builder.alloca(proc_type, "")
                 p.alignment = 8
                 p
               end

    fn_slot = @builder.inbounds_gep(proc_type, temp_ptr, [@context.int32.const_int(0), @context.int32.const_int(0)])
    @builder.store(proc_fn.to_value, fn_slot).alignment = 8

    ctx_slot = @builder.inbounds_gep(proc_type, temp_ptr, [@context.int32.const_int(0), @context.int32.const_int(1)])
    ctx_val = is_closure && env_ptr ? env_ptr : @context.pointer.null
    @builder.store(ctx_val, ctx_slot).alignment = 8

    l_proc = @builder.load(proc_type, temp_ptr, "")
    l_proc.alignment = 8
    @last = l_proc
    @terminated = false
    false
  end

  def visit(node : NumberLiteral) : Bool
    kind = node.kind
    if kind == NumberKind::F64
      @last = @context.double.const_float(node.value.to_f)
    elsif kind == NumberKind::F32
      @last = @context.float.const_float(node.value.to_f)
    elsif kind == NumberKind::U64
      @last = @context.int64.const_int(CodeGenVisitor.parse_u64(node.value), false)
    elsif kind == NumberKind::I64
      u_val = CodeGenVisitor.parse_u64(node.value)
      i_val = node.value.to_i64? || pointerof(u_val).as(Int64*).value
      @last = @context.int64.const_int(i_val, true)
    else
      @last = @context.int32.const_int(node.value.to_i? || (CodeGenVisitor.parse_u64(node.value).to_i), true)
    end
    @terminated = false
    false
  end

  def visit(node : CharLiteral) : Bool
    @last = @context.int32.const_int(node.value.ord, true)
    @terminated = false
    false
  end

  def visit(node : BoolLiteral) : Bool
    @last = @context.int1.const_int(node.value ? 1 : 0)
    @terminated = false
    false
  end

  def visit(node : NilLiteral) : Bool
    @last = @context.pointer.null
    @terminated = false
    false
  end

  def visit(node : StringLiteral) : Bool
    @last = build_string_constant(node.value)
    @terminated = false
    false
  end

  def visit(node : StringInterpolation) : Bool
    first_str = ""
    node.expressions.each do |e|
      if e.is_a?(StringLiteral)
        first_str = e.as(StringLiteral).value
        break
      end
    end
    @last = build_string_constant(first_str)
    @terminated = false
    false
  end

  def visit(node : ArrayLiteral) : Bool
    type_name = if of = node.of
                  "Array(#{of.to_s})"
                elsif ctype = @current_self_type
                  ctype
                else
                  "Array(Int32)"
                end
    info = @custom_types[type_name]? || @custom_types["Array"]?
    if info
      ctor_name = if gname = info.generic_name
                    "*#{info.name}@#{gname}::new:#{info.name}"
                  else
                    "*#{info.name}::new:#{info.name}"
                  end
      if ctor_fn = @mod.get_function?(ctor_name)
        call_args = [] of LLVMValue
        if info.generic_name
          tid_class_global_name = "#{info.name}.class:type_id"
          tid_class_global = if g = @mod.get_global?(tid_class_global_name)
                               g
                             else
                               cg_g = @mod.add_global(tid_class_global_name, @context.int32)
                               cg_g.initializer = @context.int32.const_int(info.type_id + 44)
                               cg_g.global_constant = true
                               cg_g.linkage = LibLLVM::Linkage::Internal
                               cg_g
                             end
          l_tid = @builder.load(@context.int32, tid_class_global)
          l_tid.alignment = 4
          call_args << l_tid
        end
        ctor_fn_ty = LLVMType.function(call_args.map(&.type), @context.pointer, false)
        @last = @builder.call(ctor_fn_ty, ctor_fn.to_value, call_args)
        @terminated = false
        return false
      end
    end
    @last = @context.pointer.null
    @terminated = false
    false
  end

  def visit(node : TupleLiteral) : Bool
    elems = [] of LLVMValue
    node.elements.each do |e|
      e.accept(self)
      if l = @last
        elems << l
      end
    end
    if elems.empty?
      @last = @context.pointer.null
    else
      tys = elems.map(&.type)
      st = @context.struct(tys)
      ptr = @builder.alloca(st, "tuple")
      elems.each_with_index do |el, i|
        gep = @builder.inbounds_gep(st, ptr, [@context.int32.const_int(0), @context.int32.const_int(i)])
        @builder.store(el, gep)
      end
      @last = ptr
    end
    @terminated = false
    false
  end

  def visit(node : SymbolLiteral) : Bool
    @last = @context.int32.const_int(0)
    @terminated = false
    false
  end

  def visit(node : If) : Bool
    return false unless fn = @current_fn
    then_bb = fn.append_basic_block("then")
    else_bb = fn.append_basic_block("else")

    node.cond.accept(self)
    cond_raw = @last
    cond_val = cond_raw ? ensure_i1_condition(cond_raw) : @context.int1.const_int(0)
    @builder.cond_br(cond_val, then_bb, else_bb)

    if node.else.nil? || node.else.is_a?(Nop)
      # then branch
      @builder.position_at_end(then_bb)
      @terminated = false
      node.then.accept(self)
      unless @terminated
        @builder.br(else_bb)
      end

      # Code continues in else_bb
      @builder.position_at_end(else_bb)
      @terminated = false
      return false
    end

    # then branch
    @builder.position_at_end(then_bb)
    @terminated = false
    node.then.accept(self)
    then_terminated = @terminated
    then_val = @last
    then_end = @builder.insert_block || then_bb

    if then_terminated
      @builder.position_at_end(else_bb)
      @terminated = false
      if els = node.else
        els.accept(self)
      end
      return false
    end

    exit_bb = fn.append_basic_block("exit")
    then_br = @builder.br(exit_bb)

    # else branch
    @builder.position_at_end(else_bb)
    @terminated = false
    if els = node.else
      els.accept(self)
    end
    else_terminated = @terminated
    else_val = @last
    else_end = @builder.insert_block || else_bb

    if @needs_value && !then_terminated && !else_terminated && then_val && else_val
      if then_val.type.to_s == else_val.type.to_s && !then_val.type.void?
        @builder.br(exit_bb)
        @builder.position_at_end(exit_bb)
        phi = @builder.phi(then_val.type)
        @builder.add_incoming(phi, [then_val, else_val], [then_end, else_end])
        @last = phi
      elsif then_val.type.int? && else_val.type.int?
        target_t = then_val.type.int_width >= else_val.type.int_width ? then_val.type : else_val.type
        tv = then_val
        if then_val.type.int_width < target_t.int_width
          @builder.position_before(then_br)
          tv = @builder.zext(then_val, target_t)
          @builder.position_at_end(else_end)
        end
        ev = else_val.type.int_width < target_t.int_width ? @builder.zext(else_val, target_t) : else_val
        @builder.br(exit_bb)
        else_end = @builder.insert_block || else_end
        @builder.position_at_end(exit_bb)
        phi = @builder.phi(target_t)
        @builder.add_incoming(phi, [tv, ev], [then_end, else_end])
        @last = phi
      else
        @builder.br(exit_bb)
        @builder.position_at_end(exit_bb)
        @last = nil
      end
    else
      unless else_terminated
        @builder.br(exit_bb)
      end
      @builder.position_at_end(exit_bb)
      @last = nil
    end
    @terminated = false
    false
  end

  class BreakCollector < Visitor
    property has_break : Bool

    def initialize(@has_break : Bool = false)
    end
    def visit(node : Break) : Bool
      @has_break = true
      false
    end

    def visit(node : ASTNode) : Bool
      !@has_break
    end
  end

  def visit(node : While) : Bool
    return false unless fn = @current_fn
    while_bb = fn.append_basic_block("while")
    body_bb = fn.append_basic_block("body")
    fail_bb = fn.append_basic_block("fail")

    bc = BreakCollector.new
    node.body.accept(bc)
    exit_bb = bc.has_break ? fn.append_basic_block("exit") : nil

    @builder.br(while_bb)

    @builder.position_at_end(while_bb)
    @terminated = false
    node.cond.accept(self)
    return false unless cond_raw = @last
    cond_val = ensure_i1_condition(cond_raw)
    @builder.cond_br(cond_val, body_bb, fail_bb)

    @builder.position_at_end(body_bb)
    @terminated = false
    if eb = exit_bb
      @loop_exit_blocks << eb
    else
      @loop_exit_blocks << fail_bb
    end
    @loop_continue_blocks << while_bb
    node.body.accept(self)
    @loop_exit_blocks.pop
    @loop_continue_blocks.pop
    unless @terminated
      @builder.br(while_bb)
    end

    @builder.position_at_end(fail_bb)
    if eb = exit_bb
      @builder.br(eb)
      @builder.position_at_end(eb)
    end
    @terminated = false
    @last = @context.void.undef
    false
  end
  def visit(node : Break) : Bool
    if exit_bb = @loop_exit_blocks.last?
      @builder.br(exit_bb)
    end
    @terminated = true
    false
  end

  def visit(node : Next) : Bool
    if cont_bb = @loop_continue_blocks.last?
      @builder.br(cont_bb)
    end
    @terminated = true
    false
  end

  def ensure_match_function(cname : String) : Function
    fn_name = "~match<#{cname}+>"
    if fn = @mod.get_function?(fn_name)
      return fn
    end
    info = @custom_types[cname]
    fn_ty = LLVMType.function([@context.int32], @context.int1, false)
    m_match = @mod.add_function(fn_name, fn_ty)
    m_match.linkage = LibLLVM::Linkage::Internal
    m_ent = m_match.append_basic_block("entry")
    m_b = Builder.new(@context)
    m_b.position_at_end(m_ent)
    m_arg = m_match.param(0)
    m_low = @context.int32.const_int(info.min_type_id)
    m_high = @context.int32.const_int(info.max_type_id)
    m_sge = m_b.icmp(LibLLVM::IntPredicate::SGE, m_arg, m_low)
    m_sle = m_b.icmp(LibLLVM::IntPredicate::SLE, m_arg, m_high)
    m_and = m_b.build_and(m_sge, m_sle)
    m_b.ret(m_and)
    m_b.dispose
    m_match
  end

  def visit(node : Cast) : Bool
    node.obj.accept(self)
    false
  end

  def visit(node : ExceptionHandler) : Bool
    cur_fn = if f = @current_fn
               f
             else
               return false
             end
    pers_fn = ensure_crystal_personality
    cur_fn.personality_function = pers_fn.to_value
    landing_pad_ty = if st = @llvm_struct_types["landing_pad"]?
                       st
                     else
                       lp_st = @context.struct_named("landing_pad")
                       lp_st.struct_set_body([@context.pointer, @context.int32])
                       @llvm_struct_types["landing_pad"] = lp_st
                       lp_st
                     end

    rescue_block = cur_fn.append_basic_block("rescue")
    node_rescues = node.rescues
    node_ensure = node.ensure
    node_else = node.else

    phi_vals = [] of LLVMValue
    phi_bbs = [] of LLVMBasicBlock

    old_rescue = @rescue_block
    @rescue_block = rescue_block
    @terminated = false
    node.body.accept(self)
    body_val = @last
    @rescue_block = old_rescue
    exit_bb = cur_fn.append_basic_block("exit")

    unless @terminated
      if node_else
        node_else.accept(self)
        if l = @last
          cur_entry = cur_fn.entry_block || exit_bb
          phi_vals << l
          phi_bbs << (@builder.insert_block || cur_entry)
        end
      else
        if l = body_val
          cur_entry = cur_fn.entry_block || exit_bb
          phi_vals << l
          phi_bbs << (@builder.insert_block || cur_entry)
        end
      end
      @builder.br(exit_bb)
    end
    rescue_ensure_block = nil
    if node_ensure && node_rescues
      rescue_ensure_block = cur_fn.append_basic_block("rescue_ensure")
    end

    @builder.position_at_end(rescue_block)
    lp = @builder.landing_pad(landing_pad_ty, pers_fn.to_value, [] of LLVMValue)
    unwind_ex_obj = @builder.extract_value(lp, 0)
    exception_type_id = @builder.extract_value(lp, 1)

    get_ex_fn = ensure_crystal_get_exception
    get_ex_fn_ty = LLVMType.function([@context.pointer], @context.int64, false)
    caught_ex_u64 = @builder.call(get_ex_fn_ty, get_ex_fn.to_value, [unwind_ex_obj])
    caught_ex_ptr = @builder.int_to_ptr(caught_ex_u64, @context.pointer)

    if rescues = node_rescues
      rescues.each_with_index do |a_rescue, r_idx|
        this_rescue_bb = cur_fn.append_basic_block("this_rescue")
        next_rescue_bb = cur_fn.append_basic_block("next_rescue")

        if r_types = a_rescue.types
          cond : LLVMValue? = nil
          r_types.each do |r_type_node|
            tname = r_type_node.to_s
            type_cond = if (c_info = @custom_types[tname]?) && !c_info.subclasses.empty?
                          m_match_fn = ensure_match_function(tname)
                          m_match_fn_ty = LLVMType.function([@context.int32], @context.int1, false)
                          @builder.call(m_match_fn_ty, m_match_fn.to_value, [exception_type_id])
                        else
                          tid_global_name = "#{tname}:type_id"
                          unless @mod.get_global?(tid_global_name)
                            g = @mod.add_global(tid_global_name, @context.int32)
                            tid_val = if c_info = @custom_types[tname]?
                                        c_info.type_id
                                      else
                                        0
                                      end
                            g.initializer = @context.int32.const_int(tid_val)
                            g.global_constant = true
                            g.linkage = LibLLVM::Linkage::Internal
                          end
                          g = @mod.get_global(tid_global_name)
                          l_tid = @builder.load(@context.int32, g)
                          l_tid.alignment = 4
                          @builder.icmp(LibLLVM::IntPredicate::EQ, l_tid, exception_type_id)
                        end
            cond = if c = cond
                     @builder.build_or(c, type_cond)
                   else
                     type_cond
                   end
          end
          if c = cond
            @builder.cond_br(c, this_rescue_bb, next_rescue_bb)
          else
            @builder.br(this_rescue_bb)
          end
        else
          @builder.br(this_rescue_bb)
        end

        @builder.position_at_end(this_rescue_bb)
        saved_var_type = nil
        if var_name = a_rescue.name
          if ptr = @vars[var_name]?
            s_inst = @builder.store(caught_ex_ptr, ptr)
            s_inst.alignment = 8
          end
          saved_var_type = @var_type_names[var_name]?
          r_type_name = if r_types = a_rescue.types
                          r_types.first.to_s
                        else
                          "Exception"
                        end
          @var_type_names[var_name] = r_type_name
        end

        old_res = @rescue_block
        @rescue_block = rescue_ensure_block
        @terminated = false
        a_rescue.body.accept(self)
        @rescue_block = old_res

        if var_name = a_rescue.name
          if sv = saved_var_type
            @var_type_names[var_name] = sv
          else
            @var_type_names.delete(var_name)
          end
        end

        unless @terminated
          if l = @last
            phi_vals << l
            phi_bbs << (@builder.insert_block || this_rescue_bb)
          end
          @builder.br(exit_bb)
        end

        @builder.position_at_end(next_rescue_bb)
      end

      if ens = node_ensure
        ens.accept(self)
      end
      raise_fn = ensure_crystal_raise
      raise_fn_ty = LLVMType.function([@context.pointer], @context.void, false)
      @builder.call(raise_fn_ty, raise_fn.to_value, [unwind_ex_obj])
      @builder.unreachable
    else
      if ens = node_ensure
        ens.accept(self)
      end
      raise_fn = ensure_crystal_raise
      raise_fn_ty = LLVMType.function([@context.pointer], @context.void, false)
      @builder.call(raise_fn_ty, raise_fn.to_value, [unwind_ex_obj])
      @builder.unreachable
    end

    if node_ensure && rescue_ensure_block
      @builder.position_at_end(rescue_ensure_block)
      re_lp = @builder.landing_pad(landing_pad_ty, pers_fn.to_value, [] of LLVMValue)
      re_unwind = @builder.extract_value(re_lp, 0)
      node_ensure.accept(self)
      raise_fn = ensure_crystal_raise
      raise_fn_ty = LLVMType.function([@context.pointer], @context.void, false)
      @builder.call(raise_fn_ty, raise_fn.to_value, [re_unwind])
      @builder.unreachable
    end

    @builder.position_at_end(exit_bb)
    if @needs_value && !phi_vals.empty?
      phi_ty = phi_vals[0].type
      phi = @builder.phi(phi_ty)
      @builder.add_incoming(phi, phi_vals, phi_bbs)
      @last = phi
    end
    old_last = @last
    if ens = node_ensure
      ens.accept(self)
    end
    @last = old_last

    @terminated = false
    false
  end

  def visit(node : Return) : Bool
    if exp = node.exp
      exp.accept(self)
      if l = @last
        if fn_ret_ty = @current_fn_return_type
          if fn_ret_ty.void?
            @builder.ret_void
          elsif l.type == fn_ret_ty
            @builder.ret(l)
          elsif fn_ret_ty.int? && l.type.int?
            if l.type.int_width > fn_ret_ty.int_width
              @builder.ret(@builder.trunc(l, fn_ret_ty))
            elsif l.type.int_width < fn_ret_ty.int_width
              @builder.ret(@builder.zext(l, fn_ret_ty))
            else
              @builder.ret(l)
            end
          elsif fn_ret_ty.pointer? && l.type.int?
            @builder.ret(@builder.int_to_ptr(l, fn_ret_ty))
          elsif fn_ret_ty.int? && l.type.pointer?
            @builder.ret(@builder.ptr_to_int(l, fn_ret_ty))
          elsif (fn_ret_ty.float? || fn_ret_ty.double?) && l.type.int?
            @builder.ret(@builder.si_to_fp(l, fn_ret_ty))
          elsif fn_ret_ty.float? || fn_ret_ty.double?
            @builder.ret(fn_ret_ty.const_float(0.0))
          elsif fn_ret_ty.pointer?
            @builder.ret(@context.pointer.null)
          else
            @builder.ret(l)
          end
        else
          @builder.ret(l)
        end
      else
        if fn_ret_ty = @current_fn_return_type
          if fn_ret_ty.void?
            @builder.ret_void
          elsif fn_ret_ty.int?
            @builder.ret(fn_ret_ty.const_int(0))
          elsif fn_ret_ty.float? || fn_ret_ty.double?
            @builder.ret(fn_ret_ty.const_float(0.0))
          elsif fn_ret_ty.pointer?
            @builder.ret(@context.pointer.null)
          else
            @builder.ret_void
          end
        else
          @builder.ret_void
        end
      end
    else
      if fn_ret_ty = @current_fn_return_type
        if fn_ret_ty.void?
          @builder.ret_void
        elsif fn_ret_ty.int?
          @builder.ret(fn_ret_ty.const_int(0))
        elsif fn_ret_ty.float? || fn_ret_ty.double?
          @builder.ret(fn_ret_ty.const_float(0.0))
        elsif fn_ret_ty.pointer?
          @builder.ret(@context.pointer.null)
        else
          @builder.ret_void
        end
      else
        @builder.ret_void
      end
    end
    @terminated = true
    false
  end

  def visit(node : Call) : Bool
    if node.name == "as" && node.args.size == 1 && (as_obj = node.obj)
      as_obj.accept(self)
      @terminated = false
      return false
    end
    if node.obj.nil? && node.name == "raise" && node.args.size == 1
      node.args[0].accept(self)
      return false unless ex_val = @last
      arg_tname = if node.args[0].is_a?(Call) && (c_obj = node.args[0].as(Call).obj)
                    c_obj.to_s
                  elsif node.args[0].is_a?(Var) && (v_tname = @var_type_names[node.args[0].as(Var).name]?)
                    v_tname
                  elsif node.args[0].is_a?(StringLiteral)
                    "String"
                  else
                    "Exception"
                  end

      fn_name = "*raise<#{arg_tname}>:NoReturn"
      fn_ty = LLVMType.function([@context.pointer], @context.void, false)
      raise_helper = if existing = @mod.get_function?(fn_name)
                       existing
                     else
                       rh = @mod.add_function(fn_name, fn_ty)
                       rh.linkage = LibLLVM::Linkage::Internal
                       entry_bb = rh.append_basic_block("entry")
                       b = Builder.new(@context)
                       b.position_at_end(entry_bb)
                       param = rh.param(0)
                       param.name = arg_tname == "String" ? "msg" : "ex"
                       crystal_raise_fn = ensure_crystal_raise
                       crystal_raise_ty = LLVMType.function([@context.pointer], @context.void, false)
                       b.call(crystal_raise_ty, crystal_raise_fn.to_value, [param])
                       b.unreachable
                       b.dispose
                       rh
                     end

      if rb = @rescue_block
        if c_fn = @current_fn
          invoke_out_bb = c_fn.append_basic_block("invoke_out")
          @builder.invoke(fn_ty, raise_helper.to_value, [ex_val], invoke_out_bb, rb)
          @builder.position_at_end(invoke_out_bb)
          @builder.unreachable
        end
      else
        @builder.call(fn_ty, raise_helper.to_value, [ex_val])
        @builder.unreachable
      end
      @terminated = true
      return false
    end
    if node.obj.nil? && node.name == "pointerof" && node.args.size == 1
      exp = node.args[0]
      if exp.is_a?(InstanceVar)
        ivar_name = exp.as(InstanceVar).name.lstrip('@')
        if ctype = @current_self_type
          if info = @custom_types[ctype]?
            if fidx = info.fields[ivar_name]?
              idx = info.is_struct ? fidx : fidx + 1
              st = @llvm_struct_types[info.name]
              if cur_self = @current_self
                gep = @builder.inbounds_gep(st, cur_self, [@context.int32.const_int(0), @context.int32.const_int(idx)])
                @last = gep
                @terminated = false
                return false
              end
            end
          end
        end
      else
        vname = exp.is_a?(Var) ? exp.as(Var).name : (exp.is_a?(Call) ? exp.as(Call).name : "")
        if ptr = @vars[vname]?
          @last = ptr
        end
        @terminated = false
        return false
      end
    end
    if node.obj.nil? && (b_def = @block_methods[node.name]?) && node.block
      if @inlined_block_index < @inlined_block_contexts.size
        ctx = @inlined_block_contexts[@inlined_block_index]
        @inlined_block_index += 1
        # 1. Evaluate call arguments BEFORE entering inlined context
        arg_vals = [] of LLVMValue
        node.args.each do |a|
          a.accept(self)
          if l = @last
            arg_vals << l
          end
        end

        prev_inlined = @current_inlined_block
        @current_inlined_block = ctx

        # 2. Store into method parameter allocas
        actual_arg_idx = 0
        b_def.args.each do |param|
          next if param.name == "block" || param.name.starts_with?('&')
          if actual_arg_idx < arg_vals.size
            val = arg_vals[actual_arg_idx]
            if ptr = ctx.method_param_allocas[param.name]?
              s_inst = @builder.store(val, ptr)
              s_inst.alignment = 4
            end
          end
          actual_arg_idx += 1
        end

        # 3. Execute method body
        b_def.body.accept(self)
        @current_inlined_block = prev_inlined
        @terminated = false
        return false
      end
    end

    if node.obj.nil? && (ctype = @current_self_type) && (info = @custom_types[ctype]?)
      if info.fields.has_key?(node.name) && node.args.empty?
        fidx = info.fields[node.name]
        idx = info.is_struct ? fidx : fidx + 1
        st = @llvm_struct_types[info.name]? || @context.int32
        ftype = info.field_types[node.name]
        if cur_self = @current_self
          gep = @builder.inbounds_gep(st, cur_self, [@context.int32.const_int(0), @context.int32.const_int(idx)])
          l_inst = @builder.load(llvm_type_from_name(ftype), gep)
          l_inst.alignment = align_of_type(ftype)
          @last = l_inst
          @terminated = false
          return false
        end
      elsif m = info.methods[node.name]?
        arg_vals = [] of LLVMValue
        arg_type_names = [] of String
        node.args.each do |a|
          if a.is_a?(Var) && (a_tname = @var_type_names[a.as(Var).name]?) && (a_info = @custom_types[a_tname]?) && a_info.is_struct
            st = @llvm_struct_types[a_info.name]
            l_inst = if vptr = @vars[a.as(Var).name]?
                       @builder.load(st, vptr)
                     else
                       get_ptr_val(a.as(Var).name)
                     end
            l_inst.alignment = 4
            arg_vals << l_inst
            arg_type_names << a_info.name
          else
            a.accept(self)
            if l = @last
              arg_vals << l
            end
            arg_type_names << (a.is_a?(NumberLiteral) ? (a.as(NumberLiteral).kind == NumberKind::F64 ? "Float64" : (a.as(NumberLiteral).kind == NumberKind::I64 ? "Int64" : "Int32")) : "Int32")
          end
        end

        ret_tname = m.return_type ? m.return_type.to_s.lstrip(':') : "Int32"
        expected_arg_types = m.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
        method_fn_name = if gname = info.generic_name
                           if expected_arg_types.empty?
                             "*#{info.name}@#{gname}##{node.name}:#{ret_tname}"
                           else
                             "*#{info.name}@#{gname}##{node.name}<#{expected_arg_types.join(", ")}>:#{ret_tname}"
                           end
                         else
                           if expected_arg_types.empty?
                             "*#{info.name}##{node.name}:#{ret_tname}"
                           else
                             "*#{info.name}##{node.name}<#{expected_arg_types.join(", ")}>:#{ret_tname}"
                           end
                         end

        if method_fn = @mod.get_function?(method_fn_name)
          if cur_self = @current_self
            call_args = [cur_self] of LLVMValue
            arg_vals.each { |av| call_args << av }
            call_ret_ty = llvm_type_from_name(ret_tname)
            m_param_tys = call_args.map(&.type)
            method_fn_ty = LLVMType.function(m_param_tys, call_ret_ty, false)
            call_val = @builder.call(method_fn_ty, method_fn.to_value, call_args)

            if (r_info = @custom_types[ret_tname]?) && r_info.is_struct
              if @struct_temp_index < @struct_call_temps.size
                temp_ptr = @struct_call_temps[@struct_temp_index]
                @struct_temp_index += 1
                st = @llvm_struct_types[ret_tname]
                s_inst = @builder.store(call_val, temp_ptr)
                s_inst.alignment = 4
                l_inst = @builder.load(st, temp_ptr)
                l_inst.alignment = 4
                @last = l_inst
              else
                @last = call_val
              end
            else
              @last = call_val
            end

            @terminated = false
            return false
          end
        end
      end
    end
    if obj = node.obj
      # 1. Constructor call: Point.new(x, y) or Counter.new(initial) or Pointer(Int32).new(addr)
      if obj.is_a?(Path) || obj.is_a?(Generic)
        type_name = obj.to_s
        if entry = @lib_funs[{type_name, node.name}]?
          c_name, c_fn_ty, is_noreturn = entry
          fn_val = @mod.get_function(c_name)
          arg_vals = [] of LLVMValue
          node.args.each do |a|
            a.accept(self)
            if l = @last
              arg_vals << l
            end
          end
          if c_fn_ty.return_type.void?
            @builder.call(c_fn_ty, fn_val.to_value, arg_vals)
            if is_noreturn
              @builder.unreachable
            end
            @terminated = true
          else
            @last = @builder.call(c_fn_ty, fn_val.to_value, arg_vals)
            @terminated = false
          end
          return false
        end
        if obj.is_a?(Path) && node.name != "new" && node.name != "malloc"
          pname = obj.to_s
          const_node : ASTNode? = nil
          if (ctype = @current_self_type) && (c_info = @custom_types[ctype]?)
            const_node = c_info.constants[pname]?
          end
          if const_node.nil?
            @custom_types.each_value do |c_info|
              if cn = c_info.constants[pname]?
                const_node = cn
                break
              end
            end
          end
          if cn = const_node
            cn.accept(self)
            if val = @last
              if node.name == "to_u64" || node.name == "to_i64"
                @last = val.type == @context.int64 ? val : @builder.zext(val, @context.int64)
              elsif node.name == "to_i" || node.name == "to_i32"
                @last = val.type == @context.int32 ? val : @builder.trunc(val, @context.int32)
              else
                @last = val
              end
              @terminated = false
              return false
            end
          end
          if (tinfo = @custom_types[pname]?) && (m = tinfo.methods[node.name]?)
            arg_vals = [] of LLVMValue
            node.args.each do |a|
              a.accept(self)
              if l = @last
                arg_vals << l
              end
            end
            arg_type_names = m.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
            ret_tname = m.return_type ? m.return_type.to_s.lstrip(':') : "Int32"
            method_fn_name = if arg_type_names.empty?
                               "*#{tinfo.name}##{node.name}:#{ret_tname}"
                             else
                               "*#{tinfo.name}##{node.name}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                             end
            if method_fn = @mod.get_function?(method_fn_name)
              call_args = [@context.pointer.null] of LLVMValue
              arg_vals.each { |av| call_args << av }
              call_ret_ty = llvm_type_from_name(ret_tname)
              m_param_tys = call_args.map(&.type)
              method_fn_ty = LLVMType.function(m_param_tys, call_ret_ty, false)
              @last = @builder.call(method_fn_ty, method_fn.to_value, call_args)
              @terminated = false
              return false
            end
          end
        end
        if type_name.includes?("Pointer") && node.name == "malloc" && !node.args.empty?
          node.args[0].accept(self)
          if count_val = @last
            elem_tname = element_type_of_pointer(type_name)
            elem_llvm_t = llvm_type_from_name(elem_tname)
            elem_size_gep = @builder.gep(elem_llvm_t, @context.pointer.null, [@context.int32.const_int(1)])
            elem_size = @builder.ptr_to_int(elem_size_gep, @context.int64)
            c_val = count_val.type == @context.int64 ? count_val : @builder.zext(count_val, @context.int64)
            total_bytes = @builder.mul(c_val, elem_size)
            mal_fn = ensure_malloc
            mal_fn_ty = LLVMType.function([@context.int64], @context.pointer, false)
            @last = @builder.call(mal_fn_ty, mal_fn.to_value, [total_bytes])
            @terminated = false
            return false
          end
        end
        if node.name == "new"
          if type_name.includes?("Pointer")
            # Pointer(T).new(addr)
            tid_global_name = "Pointer(Int32).class:type_id"
            unless @mod.get_global?(tid_global_name)
              g = @mod.add_global(tid_global_name, @context.int32)
              g.initializer = @context.int32.const_int(0)
              g.global_constant = true
              g.linkage = LibLLVM::Linkage::Internal
            end
            if g = @mod.get_global?(tid_global_name)
              l_tid = @builder.load(@context.int32, g)
              l_tid.alignment = 4
            end
            node.args[0].accept(self)
            if addr_val = @last
              @last = @builder.int_to_ptr(addr_val, @context.pointer)
              @terminated = false
              return false
            end
          elsif info = @custom_types[type_name]?
            arg_vals = [] of LLVMValue
            arg_type_names = [] of String
            node.args.each do |a|
              a.accept(self)
              if l = @last
                arg_vals << l
              end
              arg_type_names << (a.is_a?(NumberLiteral) ? (a.as(NumberLiteral).kind == NumberKind::F64 ? "Float64" : (a.as(NumberLiteral).kind == NumberKind::I64 ? "Int64" : "Int32")) : "Int32")
            end

            ctor_name = if gname = info.generic_name
                          if arg_type_names.empty?
                            "*#{info.name}@#{gname}::new:#{info.name}"
                          else
                            "*#{info.name}@#{gname}::new<#{arg_type_names.join(", ")}>:#{info.name}"
                          end
                        else
                          if arg_type_names.empty?
                            "*#{info.name}::new:#{info.name}"
                          else
                            "*#{info.name}::new<#{arg_type_names.join(", ")}>:#{info.name}"
                          end
                        end

            if ctor_fn = @mod.get_function?(ctor_name)
              call_ret_ty = info.is_struct ? @llvm_struct_types[info.name] : @context.pointer
              call_args = if info.generic_name
                            tid_class_global_name = "#{info.name}.class:type_id"
                            tid_class_global = if g = @mod.get_global?(tid_class_global_name)
                                                 g
                                               else
                                                 cg_g = @mod.add_global(tid_class_global_name, @context.int32)
                                                 cg_g.initializer = @context.int32.const_int(info.type_id + 44)
                                                 cg_g.global_constant = true
                                                 cg_g.linkage = LibLLVM::Linkage::Internal
                                                 cg_g
                                               end
                            l_tid = @builder.load(@context.int32, tid_class_global)
                            l_tid.alignment = 4
                            c_args = [l_tid] of LLVMValue
                            arg_vals.each { |av| c_args << av }
                            c_args
                          else
                            arg_vals
                          end
              ctor_arg_tys = call_args.map(&.type)
              ctor_fn_ty = LLVMType.function(ctor_arg_tys, call_ret_ty, false)
              call_val = @builder.call(ctor_fn_ty, ctor_fn.to_value, call_args)

              if info.is_struct
                # Struct by value: store to temporary alloca, load from temporary alloca
                if @struct_temp_index < @struct_call_temps.size
                  temp_ptr = @struct_call_temps[@struct_temp_index]
                  @struct_temp_index += 1
                  st = @llvm_struct_types[info.name]
                  s_inst = @builder.store(call_val, temp_ptr)
                  s_inst.alignment = 4
                  l_inst = @builder.load(st, temp_ptr)
                  l_inst.alignment = 4
                  @last = l_inst
                else
                  @last = call_val
                end
              else
                @last = call_val
              end

              @terminated = false
              return false
            end
          end
        end
      end
      # Conversion operations on expressions: exp.to_f, exp.to_f64, exp.to_f32, exp.to_i, exp.to_i32, exp.to_i64, exp.to_u64, exp.to_u32, exp.to_u8, exp.to_i8
      if node.args.empty? && (node.name == "to_f" || node.name == "to_f64" || node.name == "to_f32" || node.name == "to_i" || node.name == "to_i32" || node.name == "to_i64" || node.name == "to_u64" || node.name == "to_u32" || node.name == "to_u8" || node.name == "to_i8")
        obj.accept(self)
        if val = @last
          if node.name == "to_f" || node.name == "to_f64"
            @last = if val.type.int?
                      @builder.si_to_fp(val, @context.double)
                    elsif val.type == @context.float
                      @builder.fp_ext(val, @context.double)
                    else
                      val
                    end
            @terminated = false
            return false
          elsif node.name == "to_f32"
            @last = if val.type.int?
                      @builder.si_to_fp(val, @context.float)
                    elsif val.type == @context.double
                      @builder.fp_trunc(val, @context.float)
                    else
                      val
                    end
            @terminated = false
            return false
          elsif node.name == "to_i64" || node.name == "to_u64"
            @last = if val.type == @context.double || val.type == @context.float
                      @builder.fp_to_si(val, @context.int64)
                    elsif val.type.int?
                      val.type.int_width < 64 ? @builder.zext(val, @context.int64) : (val.type.int_width > 64 ? @builder.trunc(val, @context.int64) : val)
                    else
                      val
                    end
            @terminated = false
            return false
          elsif node.name == "to_i" || node.name == "to_i32" || node.name == "to_u32"
            @last = if val.type == @context.double || val.type == @context.float
                      @builder.fp_to_si(val, @context.int32)
                    elsif val.type.int?
                      val.type.int_width < 32 ? @builder.zext(val, @context.int32) : (val.type.int_width > 32 ? @builder.trunc(val, @context.int32) : val)
                    else
                      val
                    end
            @terminated = false
            return false
          elsif node.name == "to_u8" || node.name == "to_i8"
            @last = if val.type.int?
                      val.type.int_width > 8 ? @builder.trunc(val, @context.int8) : val
                    else
                      val
                    end
            @terminated = false
            return false
          end
        end
      end

      # 2. Pointer operations: ptr.value, ptr.value=, ptr + offset, ptr - other, ptr.address
      if obj.is_a?(Var)
        vname = obj.as(Var).name
        vtname = @var_type_names[vname]?
        if vtname && (vtname.starts_with?("Proc(") || vtname == "->") && node.name == "call"
          proc_ptr = @vars[vname]?
          if proc_ptr
            proc_val = @builder.load(proc_type, proc_ptr, "")
            proc_val.alignment = 8
            fun_ptr = @builder.extract_value(proc_val, 0)
            ctx_ptr = @builder.extract_value(proc_val, 1)

            is_null = @builder.icmp(LibLLVM::IntPredicate::EQ, ctx_ptr, @context.pointer.null)
            cur_f = @current_fn
            if cur_f.nil?
              return false
            end
            cf = cur_f
            ctx_is_null_bb = cf.append_basic_block("ctx_is_null")
            ctx_is_not_null_bb = cf.append_basic_block("ctx_is_not_null")
            exit_bb = cf.append_basic_block("exit")
            @builder.cond_br(is_null, ctx_is_null_bb, ctx_is_not_null_bb)

            arg_vals = [] of LLVMValue
            node.args.each do |a|
              a.accept(self)
              if l = @last
                arg_vals << l
              end
            end

            sig = parse_proc_type_signature(vtname)
            arg_llvm_tys = sig[0].map { |an| llvm_type_from_name(an) }
            ret_llvm_ty = llvm_type_from_name(sig[1])

            # ctx_is_null
            @builder.position_at_end(ctx_is_null_bb)
            fn_ty_null = LLVMType.function(arg_llvm_tys, ret_llvm_ty, false)
            call_null = @builder.call(fn_ty_null, fun_ptr, arg_vals)
            @builder.br(exit_bb)

            # ctx_is_not_null
            @builder.position_at_end(ctx_is_not_null_bb)
            not_null_param_tys = [@context.pointer] of LLVMType
            arg_llvm_tys.each { |t| not_null_param_tys << t }
            fn_ty_not_null = LLVMType.function(not_null_param_tys, ret_llvm_ty, false)
            not_null_args = [ctx_ptr] of LLVMValue
            arg_vals.each { |v| not_null_args << v }
            call_not_null = @builder.call(fn_ty_not_null, fun_ptr, not_null_args)
            @builder.br(exit_bb)

            # exit
            @builder.position_at_end(exit_bb)
            if ret_llvm_ty.void?
              @last = nil
            else
              phi = @builder.phi(ret_llvm_ty)
              @builder.add_incoming(phi, [call_null, call_not_null], [ctx_is_null_bb, ctx_is_not_null_bb])
              @last = phi
            end
            @terminated = false
            return false
          end
        end
        if vtname && (vtname.includes?("Pointer") || vtname.ends_with?("*"))
          elem_tname = element_type_of_pointer(vtname)
          elem_llvm_t = llvm_type_from_name(elem_tname)

          if node.name == "value" && node.args.empty?
            ptr_val = get_ptr_val(vname)
            l_inst = @builder.load(elem_llvm_t, ptr_val)
            l_inst.alignment = 4
            @last = l_inst
            @terminated = false
            return false
          elsif node.name == "value=" && node.args.size == 1
            ptr_val = get_ptr_val(vname)
            node.args[0].accept(self)
            if val = @last
              s_inst = @builder.store(val, ptr_val)
              s_inst.alignment = 4
              @last = val
              @terminated = false
              return false
            end
          elsif node.name == "+" && node.args.size == 1
            ptr_val = get_ptr_val(vname)
            node.args[0].accept(self)
            if offset_val = @last
              sext = @builder.sext(offset_val, @context.int64)
              @last = @builder.inbounds_gep(elem_llvm_t, ptr_val, [sext])
              @terminated = false
              return false
            end
          elsif node.name == "-" && node.args.size == 1
            ptr_val1 = get_ptr_val(vname)
            arg0 = node.args[0]
            ptr_val2 = if arg0.is_a?(Var)
                         get_ptr_val(arg0.as(Var).name)
                       else
                         arg0.accept(self)
                         @last || @context.pointer.null
                       end
            i1 = @builder.ptr_to_int(ptr_val1, @context.int64)
            i2 = @builder.ptr_to_int(ptr_val2, @context.int64)
            diff = @builder.sub(i1, i2)
            elem_st = llvm_type_from_name(elem_tname)
            size_gep = @builder.inbounds_gep(elem_st, @context.pointer.null, [@context.int32.const_int(1)])
            size_val = @builder.ptr_to_int(size_gep, @context.int64)
            @last = @builder.exact_sdiv(diff, size_val)
            @terminated = false
            return false
          elsif node.name == "address" && node.args.empty?
            ptr_val = get_ptr_val(vname)
            @last = @builder.ptr_to_int(ptr_val, @context.int64)
            @terminated = false
            return false
          elsif node.name == "[]" && node.args.size == 1
            ptr_val = get_ptr_val(vname)
            node.args[0].accept(self)
            if idx_val = @last
              idx64 = idx_val.type == @context.int64 ? idx_val : (idx_val.type.int_width < 64 ? @builder.sext(idx_val, @context.int64) : @builder.trunc(idx_val, @context.int64))
              gep = @builder.inbounds_gep(elem_llvm_t, ptr_val, [idx64])
              l_inst = @builder.load(elem_llvm_t, gep)
              l_inst.alignment = 4
              @last = l_inst
              @terminated = false
              return false
            end
          elsif node.name == "[]=" && node.args.size == 2
            ptr_val = get_ptr_val(vname)
            node.args[0].accept(self)
            if idx_val = @last
              node.args[1].accept(self)
              if val = @last
                idx64 = idx_val.type == @context.int64 ? idx_val : (idx_val.type.int_width < 64 ? @builder.sext(idx_val, @context.int64) : @builder.trunc(idx_val, @context.int64))
                gep = @builder.inbounds_gep(elem_llvm_t, ptr_val, [idx64])
                store_val = if elem_llvm_t.int? && val.type.int?
                              if val.type.int_width < elem_llvm_t.int_width
                                @builder.zext(val, elem_llvm_t)
                              elsif val.type.int_width > elem_llvm_t.int_width
                                @builder.trunc(val, elem_llvm_t)
                              else
                                val
                              end
                            elsif elem_llvm_t.pointer? && val.type.int?
                              @context.pointer.null
                            else
                              val
                            end
                s_inst = @builder.store(store_val, gep)
                s_inst.alignment = 4
                @last = val
                @terminated = false
                return false
              end
            end
          end
        end
      end

      # Chained pointer operations: (ptr + i).value
      if node.name == "value" && node.args.empty? && (obj.is_a?(Call) || obj.is_a?(Expressions))
        obj.accept(self)
        if ptr_val = @last
          elem_llvm_t = @context.int32
          l_inst = @builder.load(elem_llvm_t, ptr_val)
          l_inst.alignment = 4
          @last = l_inst
          @terminated = false
          return false
        end
      end
      if obj.is_a?(InstanceVar)
        ivar_name = obj.as(InstanceVar).name.lstrip('@')
        if (ctype = @current_self_type) && (c_info = @custom_types[ctype]?)
          if ftype = c_info.field_types[ivar_name]?
            if ftype.includes?("Pointer(") || ftype.ends_with?('*')
              elem_tname = element_type_of_pointer(ftype)
              elem_llvm_t = llvm_type_from_name(elem_tname)
              if node.name == "[]" && node.args.size == 1
                obj.accept(self)
                if ptr_val = @last
                  node.args[0].accept(self)
                  if idx_val = @last
                    idx64 = idx_val.type == @context.int64 ? idx_val : (idx_val.type.int_width < 64 ? @builder.sext(idx_val, @context.int64) : @builder.trunc(idx_val, @context.int64))
                    gep = @builder.inbounds_gep(elem_llvm_t, ptr_val, [idx64])
                    l_inst = @builder.load(elem_llvm_t, gep)
                    l_inst.alignment = 4
                    @last = l_inst
                    @terminated = false
                    return false
                  end
                end
              elsif node.name == "[]=" && node.args.size == 2
                obj.accept(self)
                if ptr_val = @last
                  node.args[0].accept(self)
                  if idx_val = @last
                    node.args[1].accept(self)
                    if val = @last
                      idx64 = idx_val.type == @context.int64 ? idx_val : (idx_val.type.int_width < 64 ? @builder.sext(idx_val, @context.int64) : @builder.trunc(idx_val, @context.int64))
                      gep = @builder.inbounds_gep(elem_llvm_t, ptr_val, [idx64])
                      store_val = if elem_llvm_t.int? && val.type.int?
                                    if val.type.int_width < elem_llvm_t.int_width
                                      @builder.zext(val, elem_llvm_t)
                                    elsif val.type.int_width > elem_llvm_t.int_width
                                      @builder.trunc(val, elem_llvm_t)
                                    else
                                      val
                                    end
                                  elsif elem_llvm_t.pointer? && val.type.int?
                                    @context.pointer.null
                                  else
                                    val
                                  end
                      s_inst = @builder.store(store_val, gep)
                      s_inst.alignment = 4
                      @last = val
                      @terminated = false
                      return false
                    end
                  end
                end
              end
            end
          end
        end
      end

      # 3. Struct & Class instance operations: p.x, p.x = val, p.method(args...)
      if obj.is_a?(Var)
        vname = obj.as(Var).name
        vtname = @var_type_names[vname]?
        if vtname && vtname.ends_with?('+')
          base_cname = vtname.rchop('+')
          if base_info = @custom_types[base_cname]?
            has_sub_override = base_info.subclasses.any? do |sub_name|
              if stinfo = @custom_types[sub_name]?
                stinfo.methods.has_key?(node.name)
              else
                false
              end
            end
            if base_info.fields.has_key?(node.name) && node.args.empty? && !has_sub_override
              fidx = base_info.fields[node.name]
              idx = fidx + 1
              st = @llvm_struct_types[base_info.name]
              ftype = base_info.field_types[node.name]
              ptr = get_ptr_val(vname)
              gep = @builder.inbounds_gep(st, ptr, [@context.int32.const_int(0), @context.int32.const_int(idx)])
              l_inst = @builder.load(llvm_type_from_name(ftype), gep)
              l_inst.alignment = 4
              @last = l_inst
              @terminated = false
              return false
            end

            sub_targets = base_info.subclasses.select do |sub_name|
              if stinfo = @custom_types[sub_name]?
                stinfo.methods.has_key?(node.name)
              else
                false
              end
            end

            if sub_targets.empty?
              if m = base_info.methods[node.name]?
                arg_vals = [] of LLVMValue
                arg_type_names = [] of String
                node.args.each do |a|
                  a.accept(self)
                  if l = @last
                    arg_vals << l
                  end
                  arg_type_names << (a.is_a?(NumberLiteral) ? "Int32" : "Int32")
                end
                ret_tname = m.return_type ? m.return_type.to_s.lstrip(':') : "Int32"
                method_fn_name = if arg_type_names.empty?
                                   "*#{base_info.name}##{node.name}:#{ret_tname}"
                                 else
                                   "*#{base_info.name}##{node.name}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                                 end
                if method_fn = @mod.get_function?(method_fn_name)
                  ptr = get_ptr_val(vname)
                  call_args = [ptr] of LLVMValue
                  arg_vals.each { |av| call_args << av }
                  call_ret_ty = llvm_type_from_name(ret_tname)
                  m_param_tys = call_args.map(&.type)
                  method_fn_ty = LLVMType.function(m_param_tys, call_ret_ty, false)
                  call_val = @builder.call(method_fn_ty, method_fn.to_value, call_args)
                  @last = call_val
                  @terminated = false
                  return false
                end
              end
            else
              if fn = @current_fn
                arg_vals = [] of LLVMValue
                arg_type_names = [] of String
                node.args.each do |a|
                  a.accept(self)
                  if l = @last
                    arg_vals << l
                  end
                  arg_type_names << (a.is_a?(NumberLiteral) ? (a.as(NumberLiteral).kind == NumberKind::F64 ? "Float64" : (a.as(NumberLiteral).kind == NumberKind::I64 ? "Int64" : "Int32")) : "Int32")
                end

                ptr = get_ptr_val(vname)
                tid_val = @builder.load(@context.int32, ptr)
                tid_val.alignment = 4

                rev_sub_targets = sub_targets.reversed
                phi_vals = [] of LLVMValue
                phi_bbs = [] of BasicBlock

                exit_dispatch_bb = uninitialized BasicBlock
                exit_created = false

                m_base = base_info.methods[node.name]?
                ret_tname = if m_base && m_base.return_type
                              m_base.return_type.to_s.lstrip(':')
                            elsif first_sub = sub_targets.first?
                              sub_m = @custom_types[first_sub].methods[node.name]
                              sub_m.return_type ? sub_m.return_type.to_s : "Int32"
                            else
                              "Int32"
                            end
                ret_llvm_type = llvm_type_from_name(ret_tname)

                rev_sub_targets.each do |sub_name|
                  sub_info = @custom_types[sub_name]
                  cur_def_bb = fn.append_basic_block("current_def")
                  next_def_bb = fn.append_basic_block("next_def")

                  sub_tid_global = @mod.get_global("#{sub_name}:type_id")
                  sub_tid_val = @builder.load(@context.int32, sub_tid_global)
                  sub_tid_val.alignment = 4

                  cmp = @builder.icmp(LibLLVM::IntPredicate::EQ, sub_tid_val, tid_val)
                  @builder.cond_br(cmp, cur_def_bb, next_def_bb)

                  if !exit_created
                    exit_dispatch_bb = fn.append_basic_block("exit")
                    exit_created = true
                  end

                  @builder.position_at_end(cur_def_bb)
                  m = sub_info.methods[node.name]
                  m_fn_name = if arg_type_names.empty?
                                "*#{sub_name}##{node.name}:#{ret_tname}"
                              else
                                "*#{sub_name}##{node.name}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                              end
                  if m_fn = @mod.get_function?(m_fn_name)
                    call_args = [ptr] of LLVMValue
                    arg_vals.each { |av| call_args << av }
                    m_param_tys = call_args.map(&.type)
                    m_fn_ty = LLVMType.function(m_param_tys, ret_llvm_type, false)
                    call_val = @builder.call(m_fn_ty, m_fn.to_value, call_args)
                    phi_vals << call_val
                    phi_bbs << (@builder.insert_block || cur_def_bb)
                    @builder.br(exit_dispatch_bb)
                  end

                  @builder.position_at_end(next_def_bb)
                end

                cur_def_base_bb = fn.append_basic_block("current_def")
                unreach_bb = fn.append_basic_block("next_def")

                match_fn_name = "~match<#{base_info.name}+>"
                if match_fn = @mod.get_function?(match_fn_name)
                  match_fn_ty = LLVMType.function([@context.int32], @context.int1, false)
                  matched = @builder.call(match_fn_ty, match_fn.to_value, [tid_val])
                  @builder.cond_br(matched, cur_def_base_bb, unreach_bb)

                  @builder.position_at_end(cur_def_base_bb)
                  base_fn_name = if arg_type_names.empty?
                                   "*#{base_info.name}+@#{base_info.name}##{node.name}:#{ret_tname}"
                                 else
                                   "*#{base_info.name}+@#{base_info.name}##{node.name}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                                 end
                  if b_fn = @mod.get_function?(base_fn_name)
                    call_args = [ptr] of LLVMValue
                    arg_vals.each { |av| call_args << av }
                    b_param_tys = call_args.map(&.type)
                    b_fn_ty = LLVMType.function(b_param_tys, ret_llvm_type, false)
                    base_call_val = @builder.call(b_fn_ty, b_fn.to_value, call_args)
                    phi_vals << base_call_val
                    phi_bbs << (@builder.insert_block || cur_def_base_bb)
                    @builder.br(exit_dispatch_bb)
                  end

                  @builder.position_at_end(unreach_bb)
                  @builder.unreachable

                  @builder.position_at_end(exit_dispatch_bb)
                  phi = @builder.phi(ret_llvm_type)
                  @builder.add_incoming(phi, phi_vals, phi_bbs)
                  @last = phi
                  @terminated = false
                  return false
                end
              end
            end
          end
        end

        if vtname && vtname.ends_with?('?')
          base_cname = vtname.rchop('?')
          if node.name == "nil?" && node.args.empty?
            unless @mod.get_global?("Nil:type_id")
              g = @mod.add_global("Nil:type_id", @context.int32)
              g.initializer = @context.int32.const_int(0)
              g.global_constant = true
              g.linkage = LibLLVM::Linkage::Internal
            end
            ptr_val = get_ptr_val(vname)
            l_null = @builder.icmp(LibLLVM::IntPredicate::EQ, ptr_val, @context.pointer.null)
            l_nil_tid = @builder.load(@context.int32, @mod.get_global("Nil:type_id"))
            l_nil_tid.alignment = 4
            l_box_tid = @builder.load(@context.int32, @mod.get_global("#{base_cname}:type_id"))
            l_box_tid.alignment = 4
            sel = @builder.select(l_null, l_nil_tid, l_box_tid)
            l_nil_tid2 = @builder.load(@context.int32, @mod.get_global("Nil:type_id"))
            l_nil_tid2.alignment = 4
            res = @builder.icmp(LibLLVM::IntPredicate::EQ, l_nil_tid2, sel)
            @last = res
            @terminated = false
            return false
          elsif base_info = @custom_types[base_cname]?
            if base_info.fields.has_key?(node.name) && node.args.empty?
              fidx = base_info.fields[node.name]
              idx = fidx + 1
              st = @llvm_struct_types[base_info.name]
              ftype = base_info.field_types[node.name]
              ptr = get_ptr_val(vname)
              gep = @builder.inbounds_gep(st, ptr, [@context.int32.const_int(0), @context.int32.const_int(idx)])
              l_inst = @builder.load(llvm_type_from_name(ftype), gep)
              l_inst.alignment = 4
              @last = l_inst
              @terminated = false
              return false
            end
          end
        end
        if vtname && (info = @custom_types[vtname]?)
          # Field getter: p.x
          if info.fields.has_key?(node.name) && node.args.empty?
            fidx = info.fields[node.name]
            idx = info.is_struct ? fidx : fidx + 1
            st = @llvm_struct_types[info.name]
            ftype = info.field_types[node.name]
            ptr = if info.is_struct
                    @vars[vname]? || get_ptr_val(vname)
                  else
                    get_ptr_val(vname)
                  end
            gep = @builder.inbounds_gep(st, ptr, [@context.int32.const_int(0), @context.int32.const_int(idx)])
            l_inst = @builder.load(llvm_type_from_name(ftype), gep)
            l_inst.alignment = align_of_type(ftype)
            @last = l_inst
            @terminated = false
            return false
          end

          # Field setter: p.x = new_x
          if node.name.ends_with?("=") && node.args.size == 1
            fname = node.name.rchop('=')
            if info.fields.has_key?(fname)
              node.args[0].accept(self)
              if arg_val = @last
                ftype = info.field_types[fname]
                setter_name = "*#{info.name}##{fname}=<#{ftype}>:#{ftype}"
                if setter_fn = @mod.get_function?(setter_name)
                  setter_fn_ty = LLVMType.function([@context.pointer, llvm_type_from_name(ftype)], llvm_type_from_name(ftype), false)
                  ptr = info.is_struct ? (@vars[vname]? || get_ptr_val(vname)) : get_ptr_val(vname)
                  @last = @builder.call(setter_fn_ty, setter_fn.to_value, [ptr, arg_val])
                  @terminated = false
                  return false
                end
              end
            end
          end

          # Instance method call: p.distance_sq, v1.dot(v2), c.increment(by)
          if m = info.methods[node.name]?
            arg_vals = [] of LLVMValue
            arg_type_names = [] of String
            node.args.each do |a|
              if a.is_a?(Var) && (a_tname = @var_type_names[a.as(Var).name]?) && (a_info = @custom_types[a_tname]?) && a_info.is_struct
                # Pass struct argument by value
                st = @llvm_struct_types[a_info.name]
                l_inst = if vptr = @vars[a.as(Var).name]?
                           @builder.load(st, vptr)
                         else
                           get_ptr_val(a.as(Var).name)
                         end
                arg_vals << l_inst
                arg_type_names << a_info.name
              else
                a.accept(self)
                if l = @last
                  arg_vals << l
                end
                arg_type_names << (a.is_a?(NumberLiteral) ? "Int32" : "Int32")
              end
            end

            ret_tname = m.return_type ? m.return_type.to_s.lstrip(':') : "Int32"
            expected_arg_types = m.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
            method_fn_name = if gname = info.generic_name
                               if expected_arg_types.empty?
                                 "*#{info.name}@#{gname}##{node.name}:#{ret_tname}"
                               else
                                 "*#{info.name}@#{gname}##{node.name}<#{expected_arg_types.join(", ")}>:#{ret_tname}"
                               end
                             else
                               if expected_arg_types.empty?
                                 "*#{info.name}##{node.name}:#{ret_tname}"
                               else
                                 "*#{info.name}##{node.name}<#{expected_arg_types.join(", ")}>:#{ret_tname}"
                               end
                             end

            method_fn = @mod.get_function?(method_fn_name)
            if method_fn.nil?
              alt_name = if gname = info.generic_name
                           if arg_type_names.empty?
                             "*#{info.name}@#{gname}##{node.name}:#{ret_tname}"
                           else
                             "*#{info.name}@#{gname}##{node.name}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                           end
                         else
                           if arg_type_names.empty?
                             "*#{info.name}##{node.name}:#{ret_tname}"
                           else
                             "*#{info.name}##{node.name}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                           end
                         end
              method_fn = @mod.get_function?(alt_name)
            end
            if method_fn.nil?
              call_args_tys = [@context.pointer] of LLVMType
              expected_arg_types.each { |eat| call_args_tys << llvm_type_from_name(eat) }
              method_fn_ty = LLVMType.function(call_args_tys, llvm_type_from_name(ret_tname), false)
              method_fn = @mod.add_function(method_fn_name, method_fn_ty)
              method_fn.linkage = LibLLVM::Linkage::External
            end

            if method_fn
              ptr = if info.is_struct
                      @vars[vname]? || get_ptr_val(vname)
                    else
                      get_ptr_val(vname)
                    end
              call_args = [ptr] of LLVMValue
              arg_vals.each { |av| call_args << av }
              call_ret_ty = llvm_type_from_name(ret_tname)
              m_param_tys = call_args.map(&.type)
              method_fn_ty = LLVMType.function(m_param_tys, call_ret_ty, false)
              call_val = @builder.call(method_fn_ty, method_fn.to_value, call_args)

              if (r_info = @custom_types[ret_tname]?) && r_info.is_struct
                if @struct_temp_index < @struct_call_temps.size
                  temp_ptr = @struct_call_temps[@struct_temp_index]
                  @struct_temp_index += 1
                  st = @llvm_struct_types[ret_tname]
                  s_inst = @builder.store(call_val, temp_ptr)
                  s_inst.alignment = 4
                  l_inst = @builder.load(st, temp_ptr)
                  l_inst.alignment = 4
                  @last = l_inst
                else
                  @last = call_val
                end
              else
                @last = call_val
              end

              @terminated = false
              return false
            end
          end
        end
      end

      # Unary negation
      if node.args.empty? && node.name == "-"
        obj.accept(self)
        return false unless val = @last
        is_float = (val.type.to_s == "double" || val.type.to_s == "float")
        if is_float
          @last = @builder.fneg(val)
        else
          @last = @builder.neg(val)
        end
        @terminated = false
        return false
      end

      # Binary primitive operation
      if node.args.size == 1
        obj.accept(self)
        return false unless lhs = @last
        node.args[0].accept(self)
        return false unless rhs = @last

        # Determine if float or signed
        is_float = (lhs.type.to_s == "double" || lhs.type.to_s == "float")
        is_signed = true
        if lhs.type.int? && rhs.type.int?
          if lhs.type.int_width < rhs.type.int_width
            lhs = @builder.zext(lhs, rhs.type)
          elsif rhs.type.int_width < lhs.type.int_width
            rhs = @builder.zext(rhs, lhs.type)
          end
        elsif lhs.type.pointer? && rhs.type.int?
          if node.name == "<" || node.name == "<=" || node.name == ">" || node.name == ">=" || node.name == "==" || node.name == "!="
            rhs = @context.pointer.null
          end
        elsif lhs.type.int? && rhs.type.pointer?
          if node.name == "<" || node.name == "<=" || node.name == ">" || node.name == ">=" || node.name == "==" || node.name == "!="
            lhs = @context.pointer.null
          end
        end
        case node.name
        when "+", "&+"
          if lhs.type.pointer? && rhs.type.pointer?
            str_add_name = "*String#+<String>:String"
            if str_add_fn = @mod.get_function?(str_add_name)
              str_add_ty = LLVMType.function([@context.pointer, @context.pointer], @context.pointer, false)
              @last = @builder.call(str_add_ty, str_add_fn.to_value, [lhs, rhs])
            else
              @last = lhs
            end
          elsif lhs.type.pointer?
            idx = rhs.type == @context.int64 ? rhs : @builder.sext(rhs, @context.int64)
            @last = @builder.inbounds_gep(@context.int8, lhs, [idx])
          elsif rhs.type.pointer?
            idx = lhs.type == @context.int64 ? lhs : @builder.sext(lhs, @context.int64)
            @last = @builder.inbounds_gep(@context.int8, rhs, [idx])
          else
            @last = is_float ? @builder.fadd(lhs, rhs) : @builder.add(lhs, rhs)
          end
        when "-", "&-"
          if lhs.type.pointer? && rhs.type.pointer?
            i1 = @builder.ptr_to_int(lhs, @context.int64)
            i2 = @builder.ptr_to_int(rhs, @context.int64)
            @last = @builder.sub(i1, i2)
          elsif lhs.type.pointer?
            neg_idx = @builder.neg(rhs.type == @context.int64 ? rhs : @builder.sext(rhs, @context.int64))
            @last = @builder.inbounds_gep(@context.int8, lhs, [neg_idx])
          else
            @last = is_float ? @builder.fsub(lhs, rhs) : @builder.sub(lhs, rhs)
          end
        when "*", "&*"
          @last = is_float ? @builder.fmul(lhs, rhs) : @builder.mul(lhs, rhs)
        when "/", "unsafe_div"
          @last = is_float ? @builder.fdiv(lhs, rhs) : (is_signed ? @builder.sdiv(lhs, rhs) : @builder.udiv(lhs, rhs))
        when "%", "unsafe_mod", "//"
          @last = is_signed ? @builder.srem(lhs, rhs) : @builder.urem(lhs, rhs)
        when "&"
          @last = @builder.build_and(lhs, rhs)
        when "|"
          @last = @builder.build_or(lhs, rhs)
        when "^"
          @last = @builder.build_xor(lhs, rhs)
        when "<<", "unsafe_shl"
          r_val = if rhs.type.pointer?
                    @builder.ptr_to_int(rhs, lhs.type)
                  elsif rhs.type.int? && rhs.type.int_width != lhs.type.int_width
                    rhs.type.int_width < lhs.type.int_width ? @builder.zext(rhs, lhs.type) : @builder.trunc(rhs, lhs.type)
                  else
                    rhs
                  end
          @last = @builder.shl(lhs, r_val)
        when ">>", "unsafe_shr"
          r_val = if rhs.type.pointer?
                    @builder.ptr_to_int(rhs, lhs.type)
                  elsif rhs.type.int? && rhs.type.int_width != lhs.type.int_width
                    rhs.type.int_width < lhs.type.int_width ? @builder.zext(rhs, lhs.type) : @builder.trunc(rhs, lhs.type)
                  else
                    rhs
                  end
          @last = is_signed ? @builder.ashr(lhs, r_val) : @builder.lshr(lhs, r_val)
        when "<"
          @last = is_float ? @builder.fcmp(LibLLVM::RealPredicate::OLT, lhs, rhs) : (is_signed ? @builder.icmp(LibLLVM::IntPredicate::SLT, lhs, rhs) : @builder.icmp(LibLLVM::IntPredicate::ULT, lhs, rhs))
        when "<="
          @last = is_float ? @builder.fcmp(LibLLVM::RealPredicate::OLE, lhs, rhs) : (is_signed ? @builder.icmp(LibLLVM::IntPredicate::SLE, lhs, rhs) : @builder.icmp(LibLLVM::IntPredicate::ULE, lhs, rhs))
        when ">"
          @last = is_float ? @builder.fcmp(LibLLVM::RealPredicate::OGT, lhs, rhs) : (is_signed ? @builder.icmp(LibLLVM::IntPredicate::SGT, lhs, rhs) : @builder.icmp(LibLLVM::IntPredicate::UGT, lhs, rhs))
        when ">="
          @last = is_float ? @builder.fcmp(LibLLVM::RealPredicate::OGE, lhs, rhs) : (is_signed ? @builder.icmp(LibLLVM::IntPredicate::SGE, lhs, rhs) : @builder.icmp(LibLLVM::IntPredicate::UGE, lhs, rhs))
        when "=="
          @last = is_float ? @builder.fcmp(LibLLVM::RealPredicate::OEQ, lhs, rhs) : @builder.icmp(LibLLVM::IntPredicate::EQ, lhs, rhs)
        when "!="
          @last = is_float ? @builder.fcmp(LibLLVM::RealPredicate::ONE, lhs, rhs) : @builder.icmp(LibLLVM::IntPredicate::NE, lhs, rhs)
        when "[]"
          if lhs.type.pointer?
            idx = rhs.type == @context.int64 ? rhs : (rhs.type.int_width < 64 ? @builder.sext(rhs, @context.int64) : @builder.trunc(rhs, @context.int64))
            elem_t = @context.int32
            gep = @builder.inbounds_gep(elem_t, lhs, [idx])
            l_inst = @builder.load(elem_t, gep)
            l_inst.alignment = 4
            @last = l_inst
          end
        end

        @terminated = false
        return false
      end
    end

    # Function call
    arg_vals = [] of LLVMValue
    node.args.each do |a|
      a.accept(self)
      if l = @last
        arg_vals << l
      end
    end

    fn = @mod.get_function?(node.name)
    if fn.nil?
      if list = @program.defs[node.name]?
        td = list.first
        c_args = td.args.map { |a| llvm_type_from_name(a.restriction ? a.restriction.to_s : "Int32") }
        c_ret = llvm_type_from_name(td.return_type ? td.return_type.to_s : "Int32")
        fn_ty = LLVMType.function(c_args, c_ret, false)
        @fn_types[node.name] = fn_ty
        fn = @mod.add_function(node.name, fn_ty)
      end
    end

    if fn_val = fn
      callee_type = @fn_types[node.name]
      if rb = @rescue_block
        if c_fn = @current_fn
          invoke_out_bb = c_fn.append_basic_block("invoke_out")
          @last = @builder.invoke(callee_type, fn_val.to_value, arg_vals, invoke_out_bb, rb)
          @builder.position_at_end(invoke_out_bb)
        end
      else
        @last = @builder.call(callee_type, fn_val.to_value, arg_vals)
      end
    end

    @terminated = false
    false
  end
end

def emit_custom_types_code(cg : CodeGenVisitor) : Nil
  return if cg.custom_types.empty?

  context = cg.context
  mod = cg.mod
  builder = cg.builder

  # Pre-declare all custom methods so forward/mutual calls resolve
  cg.custom_types.each_value do |info|
    info.methods.each do |mname, mdef|
      next if mname == "initialize" || info.fields.has_key?(mname) || (mname.ends_with?("=") && info.fields.has_key?(mname.rchop('=')))
      next if !mdef.block_arg.nil? || mdef.uses_block_arg? || CodeGenVisitor.has_yield?(mdef.body)

      m_self_ty = if CodeGenVisitor.primitive_type_name?(info.name)
                    cg.llvm_type_from_name(info.name)
                  else
                    context.pointer
                  end
      m_arg_tys = [m_self_ty] of LLVMType
      mdef.args.each do |a|
        r_name = a.restriction ? a.restriction.to_s : "Int32"
        if (a_info = cg.custom_types[r_name]?) && a_info.is_struct
          m_arg_tys << cg.llvm_struct_types[r_name]
        else
          m_arg_tys << cg.llvm_type_from_name(r_name)
        end
      end
      ret_tname = mdef.return_type ? mdef.return_type.to_s.lstrip(':') : "Int32"
      m_ret_ty = cg.llvm_type_from_name(ret_tname)
      m_fn_ty = LLVMType.function(m_arg_tys, m_ret_ty, false)

      arg_type_names = mdef.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
      has_sub_override = !info.subclasses.empty? && info.subclasses.any? do |sub_name|
        if stinfo = cg.custom_types[sub_name]?
          stinfo.methods.has_key?(mname)
        else
          false
        end
      end

      fn_mangled = if gname = info.generic_name
                     if arg_type_names.empty?
                       "*#{info.name}@#{gname}##{mname}:#{ret_tname}"
                     else
                       "*#{info.name}@#{gname}##{mname}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                     end
                   elsif has_sub_override
                     if arg_type_names.empty?
                       "*#{info.name}+@#{info.name}##{mname}:#{ret_tname}"
                     else
                       "*#{info.name}+@#{info.name}##{mname}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                     end
                   else
                     if arg_type_names.empty?
                       "*#{info.name}##{mname}:#{ret_tname}"
                     else
                       "*#{info.name}##{mname}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                     end
                   end
      unless mod.get_function?(fn_mangled)
        decl = mod.add_function(fn_mangled, m_fn_ty)
        decl.linkage = LibLLVM::Linkage::Internal
      end
    end
  end

  # 2. For each custom type, emit initializer, setters, constructor, and methods
  cg.custom_types.each_value do |info|
    st = cg.llvm_struct_types[info.name]? || context.int32

    # Emit initializer if defined
    if init_def = info.methods["initialize"]?
      init_arg_tys = [context.pointer] of LLVMType
      init_def.args.each { |a| init_arg_tys << cg.llvm_type_from_name(a.restriction ? a.restriction.to_s : "Int32") }
      init_ret_tname = cg.infer_def_return_type(init_def, info)
      init_ret_ty = cg.llvm_type_from_name(init_ret_tname)
      init_fn_ty = LLVMType.function(init_arg_tys, init_ret_ty, false)
      arg_type_names = init_def.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
      init_fn_name = if gname = info.generic_name
                       "*#{info.name}@#{gname}#initialize<#{arg_type_names.join(", ")}>:#{init_ret_tname}"
                     else
                       "*#{info.name}#initialize<#{arg_type_names.join(", ")}>:#{init_ret_tname}"
                     end

      init_fn = mod.add_function(init_fn_name, init_fn_ty)
      init_fn.linkage = LibLLVM::Linkage::Internal

      self_param = init_fn.param(0)
      self_param.name = "self"
      init_def.args.each_with_index do |a, aidx|
        init_fn.param(aidx + 1).name = a.name
      end
      cg.current_fn = init_fn
      cg.current_fn_return_type = init_ret_ty
      cg.current_self = self_param
      cg.current_self_type = info.name

      cg.param_values.clear
      cg.var_type_names.clear
      cg.vars.clear
      cg.last = nil
      cg.terminated = false
      excluded_names = Set(String).new
      cg.param_values["self"] = self_param
      cg.var_type_names["self"] = info.name
      excluded_names.add("self")

      byval_args = [] of {Int32, Arg, CustomTypeInfo}
      init_def.args.each_with_index do |a, aidx|
        r_name = a.restriction ? a.restriction.to_s : "Int32"
        cg.var_type_names[a.name] = r_name
        if (a_info = cg.custom_types[r_name]?) && a_info.is_struct
          byval_args << {aidx, a, a_info}
        else
          cg.param_values[a.name] = init_fn.param(aidx + 1)
          excluded_names.add(a.name)
        end
      end

      m_locals = cg.collect_local_vars(init_def.body, excluded_names)
      m_locals.each do |vname, vnode|
        cg.var_type_names[vname] = cg.infer_var_type(vname, vnode)
      end

      m_struct_calls = cg.collect_struct_calls(init_def.body)
      cg.struct_call_temps.clear
      cg.struct_temp_index = 0

      needs_alloca = !m_locals.empty? || !m_struct_calls.empty? || !byval_args.empty?
      if needs_alloca
        alloca_bb = init_fn.append_basic_block("alloca")
        entry_bb = init_fn.append_basic_block("entry")
        builder.position_at_end(alloca_bb)

        byval_args.each do |tup|
          _aidx, a, a_info = tup
          a_st = cg.llvm_struct_types[a_info.name]
          a_ptr = builder.alloca(a_st, a.name)
          a_ptr.alignment = 8
          cg.vars[a.name] = a_ptr
        end

        m_locals.each do |vname, _|
          vt = cg.var_type_names[vname]
          lt = cg.llvm_type_from_name(vt)
          ptr = builder.alloca(lt, vname)
          ptr.alignment = cg.align_of_type(vt)
          cg.vars[vname] = ptr
        end

        m_struct_calls.each do |sname|
          s_st = cg.llvm_struct_types[sname]
          temp_ptr = builder.alloca(s_st, "")
          temp_ptr.alignment = 8
          cg.struct_call_temps << temp_ptr
        end

        builder.br(entry_bb)
        builder.position_at_end(entry_bb)

        byval_args.each do |tup|
          aidx, a, _a_info = tup
          param_val = init_fn.param(aidx + 1)
          st_inst = builder.store(param_val, cg.vars[a.name])
          st_inst.alignment = 4
        end
      else
        entry_bb = init_fn.append_basic_block("entry")
        builder.position_at_end(entry_bb)
      end

      cg.terminated = false
      if b = init_def.body
        b.accept(cg)
      end

      if init_def.body.nil?
        init_def.args.each_with_index do |arg, aidx|
          param_val = init_fn.param(aidx + 1)
          fname = arg.name.lstrip('@')
          if fidx = info.fields[fname]?
            idx = info.is_struct ? fidx : fidx + 1
            gep = builder.inbounds_gep(st, self_param, [context.int32.const_int(0), context.int32.const_int(idx)])
            s_inst = builder.store(param_val, gep)
            ftype = info.field_types[fname]? || "Int32"
            s_inst.alignment = cg.align_of_type(ftype)
          end
        end
      end

      unless cg.terminated
        if init_ret_ty.void?
          builder.ret_void
        elsif (l = cg.last) && l.type == init_ret_ty
          builder.ret(l)
        elsif (l = cg.last) && init_ret_ty.int? && l.type.int?
          if l.type.int_width > init_ret_ty.int_width
            builder.ret(builder.trunc(l, init_ret_ty))
          elsif l.type.int_width < init_ret_ty.int_width
            builder.ret(builder.zext(l, init_ret_ty))
          else
            builder.ret(l)
          end
        elsif (l = cg.last) && init_ret_ty.pointer? && l.type.int?
          builder.ret(builder.int_to_ptr(l, init_ret_ty))
        elsif (l = cg.last) && init_ret_ty.int? && l.type.pointer?
          builder.ret(builder.ptr_to_int(l, init_ret_ty))
        elsif init_ret_ty.pointer?
          builder.ret(context.pointer.null)
        elsif init_ret_ty.float? || init_ret_ty.double?
          builder.ret(init_ret_ty.const_float(0.0))
        else
          builder.ret(init_ret_ty.const_int(0))
        end
        cg.terminated = true
      end

      # Emit constructor *Type::new
      ctor_arg_tys = [] of LLVMType
      if info.generic_name
        ctor_arg_tys << context.int32
      end
      init_def.args.each { |a| ctor_arg_tys << cg.llvm_type_from_name(a.restriction ? a.restriction.to_s : "Int32") }
      ctor_ret_ty = info.is_struct ? st : context.pointer
      ctor_fn_ty = LLVMType.function(ctor_arg_tys, ctor_ret_ty, false)
      ctor_name = if gname = info.generic_name
                    if arg_type_names.empty?
                      "*#{info.name}@#{gname}::new:#{info.name}"
                    else
                      "*#{info.name}@#{gname}::new<#{arg_type_names.join(", ")}>:#{info.name}"
                    end
                  else
                    if arg_type_names.empty?
                      "*#{info.name}::new:#{info.name}"
                    else
                      "*#{info.name}::new<#{arg_type_names.join(", ")}>:#{info.name}"
                    end
                  end

      ctor_fn = mod.add_function(ctor_name, ctor_fn_ty)
      ctor_fn.linkage = LibLLVM::Linkage::Internal
      if info.generic_name
        ctor_fn.param(0).name = "self"
        init_def.args.each_with_index do |a, aidx|
          ctor_fn.param(aidx + 1).name = a.name
        end
      else
        init_def.args.each_with_index do |a, aidx|
          ctor_fn.param(aidx).name = a.name
        end
      end

      ctor_alloca_bb = ctor_fn.append_basic_block("alloca")
      ctor_entry_bb = ctor_fn.append_basic_block("entry")

      builder.position_at_end(ctor_alloca_bb)
      if info.is_struct
        ret_slot = builder.alloca(st, "_")
        ret_slot.alignment = 8
        zero_slot = builder.alloca(st, "")
        zero_slot.alignment = 8
        builder.br(ctor_entry_bb)

        builder.position_at_end(ctor_entry_bb)
        # Compute size = ptrtoint (ptr getelementptr (%Type, ptr null, i32 1) to i64)
        null_ptr = context.pointer.null
        size_gep = builder.gep(st, null_ptr, [context.int32.const_int(1)])
        size_val = builder.ptr_to_int(size_gep, context.int64)

        # Call memset
        m_fn_ty = LLVMType.function([context.pointer, context.int8, context.int64, context.int1], context.void, false)
        builder.call(m_fn_ty, cg.ensure_memset.to_value, [zero_slot, context.int8.const_int(0), size_val, context.int1.const_int(0)])

        l_zero = builder.load(st, zero_slot)
        l_zero.alignment = 4
        s_ret = builder.store(l_zero, ret_slot)
        s_ret.alignment = 4

        # Call initialize(ptr %_, args...)
        init_args = [ret_slot] of LLVMValue
        init_def.args.each_with_index do |_, aidx|
          init_args << ctor_fn.param(info.generic_name ? aidx + 1 : aidx)
        end
        builder.call(init_fn_ty, init_fn.to_value, init_args)

        final_val = builder.load(st, ret_slot)
        final_val.alignment = 4
        builder.ret(final_val)
      else
        # Class constructor: malloc heap object
        ret_slot = builder.alloca(context.pointer, "_")
        ret_slot.alignment = 8
        builder.br(ctor_entry_bb)

        builder.position_at_end(ctor_entry_bb)
        if info.generic_name
          tid_class_global_name = "#{info.name}.class:type_id"
          tid_class_global = if g = mod.get_global?(tid_class_global_name)
                               g
                             else
                               cg_g = mod.add_global(tid_class_global_name, context.int32)
                               cg_g.initializer = context.int32.const_int(info.type_id + 44)
                               cg_g.global_constant = true
                               cg_g.linkage = LibLLVM::Linkage::Internal
                               cg_g
                             end
          l_cid = builder.load(context.int32, tid_class_global)
          l_cid.alignment = 4
        end
        null_ptr = context.pointer.null
        size_gep = builder.gep(st, null_ptr, [context.int32.const_int(1)])
        size_val = builder.ptr_to_int(size_gep, context.int64)

        mal_fn_ty = LLVMType.function([context.int64], context.pointer, false)
        obj_ptr = builder.call(mal_fn_ty, cg.ensure_malloc.to_value, [size_val])

        m_fn_ty = LLVMType.function([context.pointer, context.int8, context.int64, context.int1], context.void, false)
        builder.call(m_fn_ty, cg.ensure_memset.to_value, [obj_ptr, context.int8.const_int(0), size_val, context.int1.const_int(0)])

        # Store type_id at index 0
        tid_gep = builder.inbounds_gep(st, obj_ptr, [context.int32.const_int(0), context.int32.const_int(0)])
        tid_global = mod.get_global("#{info.name}:type_id")
        tid_val = builder.load(context.int32, tid_global)
        tid_val.alignment = 4
        s_tid = builder.store(tid_val, tid_gep)
        s_tid.alignment = 4

        builder.store(obj_ptr, ret_slot)
        loaded_ptr = builder.load(context.pointer, ret_slot)

        # Call initialize(loaded_ptr, args...)
        init_args = [loaded_ptr] of LLVMValue
        init_def.args.each_with_index do |_, aidx|
          init_args << ctor_fn.param(info.generic_name ? aidx + 1 : aidx)
        end
        builder.call(init_fn_ty, init_fn.to_value, init_args)

        final_obj = builder.load(context.pointer, ret_slot)
        builder.ret(final_obj)
      end
    end

    # Emit setters for fields
    info.fields.each do |fname, fidx|
      next unless info.methods.has_key?("#{fname}=")
      ftype = info.field_types[fname]
      setter_name = "*#{info.name}##{fname}=<#{ftype}>:#{ftype}"
      setter_fn_ty = LLVMType.function([context.pointer, cg.llvm_type_from_name(ftype)], cg.llvm_type_from_name(ftype), false)
      s_fn = mod.add_function(setter_name, setter_fn_ty)
      s_fn.linkage = LibLLVM::Linkage::Internal

      s_entry = s_fn.append_basic_block("entry")
      builder.position_at_end(s_entry)
      self_ptr = s_fn.param(0)
      self_ptr.name = "self"
      val_param = s_fn.param(1)
      val_param.name = "val"
      idx = info.is_struct ? fidx : fidx + 1
      gep = builder.inbounds_gep(st, self_ptr, [context.int32.const_int(0), context.int32.const_int(idx)])
      st_inst = builder.store(val_param, gep)
      st_inst.alignment = 4
      builder.ret(val_param)
    end

    # Emit virtual match function if class has subclasses and has an overridden method
    has_any_override = info.subclasses.any? do |sub_name|
      if sub_info = cg.custom_types[sub_name]?
        info.methods.keys.any? { |mname| mname != "initialize" && sub_info.methods.has_key?(mname) }
      else
        false
      end
    end
    if !info.is_struct && has_any_override
      fn_name = "~match<#{info.name}+>"
      unless mod.get_function?(fn_name)
        fn_ty = LLVMType.function([context.int32], context.int1, false)
        m_match_fn = mod.add_function(fn_name, fn_ty)
        m_match_fn.linkage = LibLLVM::Linkage::Internal
        entry_bb = m_match_fn.append_basic_block("entry")
        builder.position_at_end(entry_bb)
        arg0 = m_match_fn.param(0)
        min_val = context.int32.const_int(info.min_type_id)
        max_val = context.int32.const_int(info.max_type_id)
        sge = builder.icmp(LibLLVM::IntPredicate::SGE, arg0, min_val)
        sle = builder.icmp(LibLLVM::IntPredicate::SLE, arg0, max_val)
        res = builder.and(sge, sle)
        builder.ret(res)
      end
    end

    # Emit custom methods
    info.methods.each do |mname, mdef|
      next if mname == "initialize" || info.fields.has_key?(mname) || (mname.ends_with?("=") && info.fields.has_key?(mname.rchop('=')))
      next if !mdef.block_arg.nil? || mdef.uses_block_arg? || CodeGenVisitor.has_yield?(mdef.body)

      m_self_ty = if CodeGenVisitor.primitive_type_name?(info.name)
                    cg.llvm_type_from_name(info.name)
                  else
                    context.pointer
                  end
      m_arg_tys = [m_self_ty] of LLVMType
      mdef.args.each do |a|
        r_name = a.restriction ? a.restriction.to_s : "Int32"
        if (a_info = cg.custom_types[r_name]?) && a_info.is_struct
          m_arg_tys << cg.llvm_struct_types[r_name]
        else
          m_arg_tys << cg.llvm_type_from_name(r_name)
        end
      end
      ret_tname = mdef.return_type ? mdef.return_type.to_s.lstrip(':') : "Int32"
      m_ret_ty = cg.llvm_type_from_name(ret_tname)
      m_fn_ty = LLVMType.function(m_arg_tys, m_ret_ty, false)

      arg_type_names = mdef.args.map { |a| a.restriction ? a.restriction.to_s : "Int32" }
      has_sub_override = !info.subclasses.empty? && info.subclasses.any? do |sub_name|
        if stinfo = cg.custom_types[sub_name]?
          stinfo.methods.has_key?(mname)
        else
          false
        end
      end

      fn_mangled = if gname = info.generic_name
                     if arg_type_names.empty?
                       "*#{info.name}@#{gname}##{mname}:#{ret_tname}"
                     else
                       "*#{info.name}@#{gname}##{mname}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                     end
                   elsif has_sub_override
                     if arg_type_names.empty?
                       "*#{info.name}+@#{info.name}##{mname}:#{ret_tname}"
                     else
                       "*#{info.name}+@#{info.name}##{mname}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                     end
                   else
                     if arg_type_names.empty?
                       "*#{info.name}##{mname}:#{ret_tname}"
                     else
                       "*#{info.name}##{mname}<#{arg_type_names.join(", ")}>:#{ret_tname}"
                     end
                   end
      m_fn = if existing = mod.get_function?(fn_mangled)
               existing
             else
               mod.add_function(fn_mangled, m_fn_ty)
             end
      m_fn.linkage = LibLLVM::Linkage::Internal

      cg.current_fn = m_fn
      cg.current_fn_return_type = m_ret_ty
      self_param = m_fn.param(0)
      self_param.name = "self"
      cg.current_self = self_param
      cg.current_self_type = info.name
      mdef.args.each_with_index do |a, aidx|
        m_fn.param(aidx + 1).name = a.name
      end

      # Prepare parameters and local variables
      cg.param_values.clear
      cg.var_type_names.clear
      cg.vars.clear
      cg.last = nil
      cg.terminated = false
      excluded_names = Set(String).new
      cg.param_values["self"] = self_param
      cg.var_type_names["self"] = info.name
      excluded_names.add("self")

      # First: check if any argument is passed by value (struct)
      byval_args = [] of {Int32, Arg, CustomTypeInfo}
      mdef.args.each_with_index do |a, aidx|
        r_name = a.restriction ? a.restriction.to_s : "Int32"
        cg.var_type_names[a.name] = r_name
        if (a_info = cg.custom_types[r_name]?) && a_info.is_struct
          byval_args << {aidx, a, a_info}
        else
          cg.param_values[a.name] = m_fn.param(aidx + 1)
          excluded_names.add(a.name)
        end
      end

      # Local variables
      m_locals = cg.collect_local_vars(mdef.body, excluded_names)
      m_locals.each do |vname, vnode|
        cg.var_type_names[vname] = cg.infer_var_type(vname, vnode)
      end

      m_struct_calls = cg.collect_struct_calls(mdef.body)
      cg.struct_call_temps.clear
      cg.struct_temp_index = 0

      needs_alloca = !m_locals.empty? || !m_struct_calls.empty? || !byval_args.empty?
      if needs_alloca
        alloca_bb = m_fn.append_basic_block("alloca")
        entry_bb = m_fn.append_basic_block("entry")
        builder.position_at_end(alloca_bb)

        # Byval argument allocas
        byval_args.each do |tup|
          _aidx, a, a_info = tup
          a_st = cg.llvm_struct_types[a_info.name]
          a_ptr = builder.alloca(a_st, a.name)
          a_ptr.alignment = 8
          cg.vars[a.name] = a_ptr
        end

        # Local variable allocas
        m_locals.each do |vname, _|
          vt = cg.var_type_names[vname]
          lt = cg.llvm_type_from_name(vt)
          ptr = builder.alloca(lt, vname)
          ptr.alignment = cg.align_of_type(vt)
          cg.vars[vname] = ptr
        end

        # Struct call temporaries
        m_struct_calls.each do |sname|
          s_st = cg.llvm_struct_types[sname]
          temp_ptr = builder.alloca(s_st, "")
          temp_ptr.alignment = 8
          cg.struct_call_temps << temp_ptr
        end

        builder.br(entry_bb)
        builder.position_at_end(entry_bb)

        # Store byval arguments
        byval_args.each do |tup|
          aidx, a, _a_info = tup
          param_val = m_fn.param(aidx + 1)
          st_inst = builder.store(param_val, cg.vars[a.name])
          st_inst.alignment = 4
        end
      else
        entry_bb = m_fn.append_basic_block("entry")
        builder.position_at_end(entry_bb)
      end

      cg.terminated = false
      if b = mdef.body
        b.accept(cg)
      end

      unless cg.terminated
        if m_ret_ty.void?
          builder.ret_void
        elsif (l = cg.last) && l.type == m_ret_ty
          builder.ret(l)
        elsif (l = cg.last) && m_ret_ty.int? && l.type.int?
          if l.type.int_width > m_ret_ty.int_width
            builder.ret(builder.trunc(l, m_ret_ty))
          elsif l.type.int_width < m_ret_ty.int_width
            builder.ret(builder.zext(l, m_ret_ty))
          else
            builder.ret(l)
          end
        elsif (l = cg.last) && m_ret_ty.pointer? && l.type.int?
          builder.ret(builder.int_to_ptr(l, m_ret_ty))
        elsif (l = cg.last) && m_ret_ty.int? && l.type.pointer?
          builder.ret(builder.ptr_to_int(l, m_ret_ty))
        elsif (l = cg.last) && (m_ret_ty.float? || m_ret_ty.double?) && l.type.int?
          builder.ret(builder.si_to_fp(l, m_ret_ty))
        elsif m_ret_ty.pointer?
          builder.ret(context.pointer.null)
        elsif m_ret_ty.float? || m_ret_ty.double?
          builder.ret(m_ret_ty.const_float(0.0))
        else
          builder.ret(m_ret_ty.const_int(0))
        end
        cg.terminated = true
      end
    end
  end
end

# Wraps top-level statements into __crystal_main and main, the way the shipped
# backend does. Both the single-file path and the multi-file pipeline call this,
# so a program's behaviour does not depend on which one compiled it.
pub def append_entry_point(funs : Array(FunDef), top_level_stmts : Array(ASTNode)) : Nil
  argv_type = Generic.new(Path.global("Pointer"), [Generic.new(Path.global("Pointer"), [Path.global("UInt8")] of ASTNode)] of ASTNode)
  unless funs.any? { |f| f.name == "__crystal_main" && !f.body.nil? }
    init_stmts = top_level_stmts.empty? ? [Nop.new] of ASTNode : top_level_stmts
    init_fun = FunDef.new(
      "__crystal_main",
      [
        Arg.new("argc", restriction: Path.global("Int32")),
        Arg.new("argv", restriction: argv_type),
      ],
      Path.new("Void"),
      Expressions.new(init_stmts)
    )
    funs << init_fun
  end
  unless funs.any? { |f| f.name == "main" }
    return if top_level_stmts.empty?
    main_fun = FunDef.new(
      "main",
      [
        Arg.new("argc", restriction: Path.global("Int32")),
        Arg.new("argv", restriction: argv_type.clone.as(ASTNode)),
      ],
      Path.global("Int32"),
      Expressions.new([
        Call.new(nil, "__crystal_main", [Var.new("argc"), Var.new("argv")] of ASTNode),
        NumberLiteral.new("0", NumberKind::I32),
      ] of ASTNode)
    )
    funs << main_fun
  end
end

pub def compile_source_to_module(src : String, filename : String, context : Context, mod : Module) : CodeGenVisitor
  parser = Parser.new(src, filename)
  node = parser.parse

  prog = SemanticProgram.new
  register_primitive_operators(prog)

  classes = [] of ClassDef
  funs = [] of FunDef
  defs = Hash(String, Def).new
  libs = [] of LibDef
  top_level_stmts = [] of ASTNode
  if node.is_a?(Expressions)
    node.as(Expressions).expressions.each do |e|
      if e.is_a?(ClassDef)
        classes << e.as(ClassDef)
      elsif e.is_a?(FunDef)
        funs << e.as(FunDef)
      elsif e.is_a?(Def)
        defs[e.as(Def).name] = e.as(Def)
      elsif e.is_a?(LibDef)
        libs << e.as(LibDef)
      elsif e.is_a?(Annotation) || e.is_a?(Nop)
        # ignore annotations and nops
      else
        top_level_stmts << e
      end
    end
  elsif node.is_a?(ClassDef)
    classes << node.as(ClassDef)
  elsif node.is_a?(FunDef)
    funs << node.as(FunDef)
  elsif node.is_a?(Def)
    defs[node.as(Def).name] = node.as(Def)
  elsif node.is_a?(LibDef)
    libs << node.as(LibDef)
  elsif !node.is_a?(Annotation) && !node.is_a?(Nop)
    top_level_stmts << node
  end

  append_entry_point(funs, top_level_stmts)
  # Register funs in program
  funs.each do |fd|
    cloned_args = fd.args.map { |a| a.clone.as(Arg) }
    d = Def.new(fd.name, cloned_args, fd.body, nil, nil, fd.return_type)
    prog.add_def(d)
  end
  tl = TopLevelVisitor.new(prog)
  classes.each do |cd|
    next if (tvars = cd.type_vars) && !tvars.empty?
    cd.accept(tl)
  end

  mv = MainVisitor.new(prog)
  funs.each do |fd|
    ret_type = if rt = fd.return_type
                 prog.lookup_type_node(rt, prog)
               else
                 prog.int32_type
               end
    mv.set_type(fd, ret_type)
  end

  compile_declarations_to_module(classes, funs, defs, libs, filename, context, mod, prog, mv, [node] of ASTNode)
end

pub def compile_declarations_to_module(
  classes : Array(ClassDef),
  funs : Array(FunDef),
  defs : Hash(String, Def),
  libs : Array(LibDef),
  filename : String,
  context : Context,
  mod : Module,
  prog : SemanticProgram,
  mv : MainVisitor,
  roots : Array(ASTNode) = [] of ASTNode,
) : CodeGenVisitor
  cg = CodeGenVisitor.new(context, mod, prog, mv)
  cg.filename = filename
  cg.block_methods = defs

  # Process lib definitions
  libs.each do |ld|
    lname = ld.name.to_s
    if b = ld.body
      exps = b.is_a?(Expressions) ? b.as(Expressions).expressions : [b] of ASTNode
      exps.each do |exp|
        if exp.is_a?(FunDef)
          fd = exp.as(FunDef)
          c_name = fd.real_name || fd.name
          c_args = fd.args.map { |a| cg.llvm_type_from_name(a.restriction ? a.restriction.to_s : "Int32") }
          c_ret = cg.llvm_type_from_name(fd.return_type ? fd.return_type.to_s : "Void")
          fn_ty = LLVMType.function(c_args, c_ret, false)
          is_noreturn = (fd.return_type && fd.return_type.to_s == "NoReturn") || false
          cg.lib_funs[{lname, fd.name}] = {c_name, fn_ty, is_noreturn}
          mod.add_function(c_name, fn_ty) unless mod.get_function?(c_name)
        end
      end
    end
  end

  # Process custom types (structs and classes)
  generic_templates = Hash(String, ClassDef).new
  classes.each do |cd|
    cname = cd.name.to_s
    if (tvars = cd.type_vars) && !tvars.empty?
      generic_templates[cname] = cd
      next
    end
    info = CustomTypeInfo.new(cname, cd.struct)
    if sc = cd.superclass
      info.superclass_name = sc.to_s
    end

    # Process body
    if b = cd.body
      exps = b.is_a?(Expressions) ? b.as(Expressions).expressions : [b] of ASTNode
      exps.each do |exp|
        if exp.is_a?(TypeDeclaration)
          td = exp.as(TypeDeclaration)
          fname = if td.var.is_a?(InstanceVar)
                    td.var.as(InstanceVar).name.lstrip('@')
                  elsif td.var.is_a?(Var)
                    td.var.as(Var).name
                  else
                    ""
                  end
          unless fname.empty?
            ftype = td.declared_type.to_s
            info.add_field(fname, ftype)
          end
        elsif exp.is_a?(Call) && (exp.as(Call).name == "property" || exp.as(Call).name == "getter")
          call = exp.as(Call)
          is_prop = call.name == "property"
          call.args.each do |arg|
            fname = ""
            ftype = "Int32"
            if arg.is_a?(TypeDeclaration)
              td = arg.as(TypeDeclaration)
              fname = td.var.is_a?(InstanceVar) ? td.var.as(InstanceVar).name.lstrip('@') : td.var.to_s
              ftype = td.declared_type.to_s
            elsif arg.is_a?(Var)
              fname = arg.as(Var).name
            end
            unless fname.empty?
              info.add_field(fname, ftype)
              info.methods[fname] = Def.new(fname, [] of Arg, InstanceVar.new("@#{fname}"), nil, nil, Path.new(ftype))
              if is_prop
                info.methods["#{fname}="] = Def.new("#{fname}=", [Arg.new("value", restriction: Path.new(ftype))] of Arg, Assign.new(InstanceVar.new("@#{fname}"), Var.new("value")), nil, nil, Path.new(ftype))
              end
            end
          end
        elsif exp.is_a?(Def)
          d = exp.as(Def)
          info.methods[d.name] = d
        elsif exp.is_a?(Assign)
          assign = exp.as(Assign)
          if assign.target.is_a?(Path)
            const_name = assign.target.as(Path).to_s
            info.constants[const_name] = assign.value
          end
        end
      end
    end
    cg.custom_types[cname] = info
  end

  # Instantiate generic types used in the module
  usage_collector = GenericUsageCollector.new
  roots.each { |r| r.accept(usage_collector) }
  usage_collector.generic_nodes.each do |g|
    base_name = g.name.to_s
    if template = generic_templates[base_name]?
      type_args = g.type_vars.map(&.to_s)
      inst_name = "#{base_name}(#{type_args.join(", ")})"
      unless cg.custom_types.has_key?(inst_name)
        info = CustomTypeInfo.new(inst_name, template.struct)
        if tvars = template.type_vars
          info.generic_name = "#{base_name}(#{tvars.join(", ")})"
          subst = Hash(String, String).new
          tvars.each_with_index { |tv, idx| subst[tv] = type_args[idx] }
        else
          subst = Hash(String, String).new
        end

        if b = template.body
          exps = b.is_a?(Expressions) ? b.as(Expressions).expressions : [b] of ASTNode
          exps.each do |exp|
            if exp.is_a?(TypeDeclaration)
              td = exp.as(TypeDeclaration)
              fname = if td.var.is_a?(InstanceVar)
                        td.var.as(InstanceVar).name.lstrip('@')
                      elsif td.var.is_a?(Var)
                        td.var.as(Var).name
                      else
                        ""
                      end
              unless fname.empty?
                raw_type = td.declared_type.to_s
                ftype = subst[raw_type]? || raw_type
                info.add_field(fname, ftype)
              end
            elsif exp.is_a?(Call) && (exp.as(Call).name == "property" || exp.as(Call).name == "getter")
              call = exp.as(Call)
              is_prop = call.name == "property"
              call.args.each do |arg|
                fname = ""
                raw_type = "Int32"
                if arg.is_a?(TypeDeclaration)
                  td = arg.as(TypeDeclaration)
                  fname = td.var.is_a?(InstanceVar) ? td.var.as(InstanceVar).name.lstrip('@') : td.var.to_s
                  raw_type = td.declared_type.to_s
                elsif arg.is_a?(Var)
                  fname = arg.as(Var).name
                end
                unless fname.empty?
                  ftype = subst[raw_type]? || raw_type
                  info.add_field(fname, ftype)
                  info.methods[fname] = Def.new(fname, [] of Arg, InstanceVar.new("@#{fname}"), nil, nil, Path.new(ftype))
                  if is_prop
                    info.methods["#{fname}="] = Def.new("#{fname}=", [Arg.new("value", restriction: Path.new(ftype))] of Arg, Assign.new(InstanceVar.new("@#{fname}"), Var.new("value")), nil, nil, Path.new(ftype))
                  end
                end
              end
            elsif exp.is_a?(Def)
              d = exp.as(Def)
              spec_args = d.args.map do |a|
                fname = a.name.lstrip('@')
                raw_r = a.restriction ? a.restriction.to_s : "Int32"
                spec_r = subst[raw_r]? || raw_r
                if a.name.starts_with?('@')
                  info.add_field(fname, spec_r)
                end
                Arg.new(a.name, nil, Path.new(spec_r))
              end
              # A method with no declared return type keeps none: stamping a guess
              # here overrides the inference that reads the body, and on an
              # initialize whose parameter is the type variable the guess is wrong.
              spec_ret_node = if rt = d.return_type
                                raw_ret = rt.to_s
                                Path.new(subst[raw_ret]? || raw_ret)
                              else
                                nil
                              end
              spec_def = Def.new(d.name, spec_args, d.body, nil, nil, spec_ret_node)
              info.methods[d.name] = spec_def
            elsif exp.is_a?(Assign)
              assign = exp.as(Assign)
              if assign.target.is_a?(Path)
                const_name = assign.target.as(Path).to_s
                info.constants[const_name] = assign.value
              end
            end
          end
        end
        cg.custom_types[inst_name] = info
      end
    end
  end
  # Predefine String class layout if strings are used
  has_strings = classes.any? { |cd| cd.name.to_s == "String" } || usage_collector.saw_string
  if has_strings
    str_info = if existing_str = cg.custom_types["String"]?
                 existing_str
               else
                 si = CustomTypeInfo.new("String", false)
                 cg.custom_types["String"] = si
                 si
               end
    str_info.type_id = 1
    str_info.add_field("bytesize", "Int32")
    str_info.add_field("length", "Int32")
    str_info.add_field("c", "UInt8")
  end
  # Populate subclasses
  cg.custom_types.each_value do |info|
    if sc_name = info.superclass_name
      if sc_info = cg.custom_types[sc_name]?
        sc_info.subclasses << info.name
      end
    end
  end

  # Assign hierarchical class type IDs
  cg.assign_class_type_ids

  # Inherit superclass fields for classes
  cg.custom_types.each_value do |info|
    if sc_name = info.superclass_name
      if sc_info = cg.custom_types[sc_name]?
        new_order = [] of String
        sc_info.field_order.each do |sc_fname|
          new_order << sc_fname
          info.field_types[sc_fname] = sc_info.field_types[sc_fname]
        end
        info.field_order.each do |fn|
          unless sc_info.fields.has_key?(fn)
            new_order << fn
          end
        end
        info.field_order = new_order
        info.fields.clear
        info.field_order.each_with_index do |fn, idx|
          info.fields[fn] = idx
        end
      end
    end
  end

  # Create LLVM struct types
  cg.custom_types.each_value do |info|
    next if CodeGenVisitor.primitive_type_name?(info.name)
    st = context.struct_named(info.name)
    elem_types = [] of LLVMType
    unless info.is_struct
      elem_types << context.int32
    end
    info.field_order.each do |fn|
      elem_types << cg.llvm_type_from_name(info.field_types[fn])
    end
    st.struct_set_body(elem_types)
    cg.llvm_struct_types[info.name] = st

    unless info.is_struct
      if (info.subclasses.empty? || info.methods.has_key?("initialize")) && info.name != "String"
        # Add type_id constant global
        tid_global = mod.add_global("#{info.name}:type_id", context.int32)
        tid_global.initializer = context.int32.const_int(info.type_id)
        tid_global.global_constant = true
        tid_global.linkage = LibLLVM::Linkage::Internal
      end
    end
  end

  # Emit custom types code (methods, constructors, initializers)
  emit_custom_types_code(cg)

  # Emit funs
  funs.each do |fd|
    fd.accept(cg)
  end

  cg
end
