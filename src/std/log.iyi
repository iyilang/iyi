# Levelled logging with named sources.
#
# `Log.info "started"` writes an `Entry` — source, severity, message and
# the UTC instant it was made — through the root logger's backend.
# `Log.for("db.pool")` answers the logger for that source: a child of
# `db`, which is a child of the root, and the same object every time the
# name is asked for. A logger with no level or backend of its own uses
# its parent's, so `Log.setup(level, backend)` reconfigures the root in
# place and every logger already handed out follows it; a child given
# its own `level=` or `backend=` keeps that until it is set back to nil.
#
# Severities in order: Trace, Debug, Info, Notice, Warn, Error, Fatal, and
# None to silence a logger. An entry below the logger's level is dropped
# before its message is built, so `log.debug { expensive }` costs nothing
# when Debug is off. The default level is Info.
#
# Backends: `IOBackend` writes each entry to an IO through a `Formatter`
# (`DefaultFormatter`: `2024-02-29T15:30:45.123456Z INFO - source: message`,
# and `... INFO - message` at the root, the source and its `: ` left
# off); `MemoryBackend` keeps the entries for a test to read back. A
# `Backend` of your own is a class with `write(entry)` and `close`.
#
# Logging is synchronous: the entry is written before the call returns,
# in the calling thread, with no queue between.
#
# **Threads.** A logger is `Share` (SPEC.md III.4.4), so `LOG =
# Log.for("app")` may be reached from a parallel block, a server's
# handler or a route, and every worker logs through it at once. Its level
# is an `Atomic`, so a call below it costs one load per logger up to the
# one that has a level; its backend and its children are behind locks;
# and each backend writes behind its own, a line at a time, so the lines
# of twelve workers never cut into one another. A backend or formatter
# of your own is held to the same: it must be Share - a class with no
# fields, or its state behind a `Mutex` (std/mutex) - and one that is
# not is refused where std/log hands a backend to its lock, naming the
# field.
#
# **Data.** An entry carries keys and values besides its message, from
# three places, each over the one before:
#
#     Log.with_context(request_id: id) do      # every entry in this task
#       db = Log.for("db").bind(pool: "main")  # every entry of a logger
#       db.info("query", rows: 3)              # one entry
#     end
#
# `with_context` holds for the block, in the task that runs it and in the
# tasks it starts, which find their starter's context while it is open -
# where the other library's new fiber starts with none. `DefaultFormatter`
# writes the data after the message, `... - db: query -- request_id=7
# pool=main rows=3`, a value with a space, quote or `=` in it quoted.
#
# `Log.setup_from_env` sets the root's level from `LOG_LEVEL`.

module std/log

import std/time::{Time}
import std/tuple
import std/mutex::{Mutex}
import std/list::{List}

pub enum Severity
  Trace  = 0
  Debug  = 1
  Info   = 2
  Notice = 3
  Warn   = 4
  Error  = 5
  Fatal  = 6
  None   = 7

  def label : String
    case value
    when 0 then "TRACE"
    when 1 then "DEBUG"
    when 2 then "INFO"
    when 3 then "NOTICE"
    when 4 then "WARN"
    when 5 then "ERROR"
    when 6 then "FATAL"
    else        "NONE"
    end
  end

  # The severity named by *name*, case-insensitively, or nil: what a
  # `LOG_LEVEL` variable holds.
  def self.parse?(name : String) : Severity?
    case name.downcase
    when "trace"  then Trace
    when "debug"  then Debug
    when "info"   then Info
    when "notice" then Notice
    when "warn"   then Warn
    when "error"  then Error
    when "fatal"  then Fatal
    when "none"   then None
    else               nil
    end
  end

  def self.parse(name : String) : Severity
    parse?(name) || raise "not a severity: #{name.inspect}"
  end

  def to_s : String
    label
  end

  def <(other : Severity) : Bool
    value < other.value
  end

  def <=(other : Severity) : Bool
    value <= other.value
  end

  def >=(other : Severity) : Bool
    value >= other.value
  end

  def >(other : Severity) : Bool
    value > other.value
  end
end

pub struct Entry
  getter source : String
  getter severity : Severity
  getter message : String
  getter timestamp : Time
  # The task's context, the logger's bound data and the call's own, in
  # that order, a later key's value over an earlier's in the earlier's
  # place, as a `Hash` keeps them. Kept as pairs, which nothing writes once
  # the entry is made, so an entry is `Share` and goes into a
  # `MemoryBackend`'s lock from any thread; `data` is a hash of them.
  getter pairs : List({String, String})

  NO_PAIRS = List({String, String}).new([] of {String, String})

  def initialize(@source : String, @severity : Severity, @message : String, @timestamp : Time = Time.utc, data : Hash(String, String) = {} of String => String)
    @pairs = data.empty? ? NO_PAIRS : Entry.pairs_of(data)
  end

  # The data, as a hash of the caller's own.
  def data : Hash(String, String)
    found = {} of String => String
    i = 0
    while i < @pairs.size
      pair = @pairs[i]
      found[pair[0]] = pair[1]
      i = i + 1
    end
    found
  end

  protected def self.pairs_of(data : Hash(String, String)) : List({String, String})
    pairs = Array({String, String}).new(data.size)
    data.each { |key, value| pairs << {key, value} }
    List({String, String}).new(pairs)
  end
end

# Keys and values, the newest first: immutable, so a task's context can sit
# in the table every thread reads.
pub class Metadata
  getter key : String
  getter value : String
  getter rest : Metadata?

  def initialize(@key : String, @value : String, @rest : Metadata?)
  end

  # Into *into*, the oldest first, so a later key's value replaces an
  # earlier one's.
  def merge_into(into : Hash(String, String)) : Nil
    if older = @rest
      older.merge_into(into)
    end
    into[@key] = @value
  end

  def to_h : Hash(String, String)
    found = {} of String => String
    merge_into(found)
    found
  end
end

pub abstract class Formatter
  abstract def format(entry : Entry) : String
end

pub class DefaultFormatter < Formatter
  def format(entry : Entry) : String
    head = "#{entry.timestamp.to_rfc3339(6)} #{entry.severity.label}"
    text = entry.source.empty? ? "#{head} - #{entry.message}" : "#{head} - #{entry.source}: #{entry.message}"
    return text if entry.pairs.empty?
    written = Array(String).new(entry.pairs.size)
    entry.pairs.each { |pair| written << "#{pair[0]}=#{quoted(pair[1])}" }
    "#{text} -- #{written.join(" ")}"
  end

  # A value as it is, unless a reader could not tell where it ends.
  private def quoted(value : String) : String
    plain = !value.empty? && !value.includes?(" ") && !value.includes?("\"") && !value.includes?("=") && !value.includes?("\n")
    plain ? value : value.inspect
  end
end

pub abstract class Backend
  abstract def write(entry : Entry) : Nil
  abstract def close : Nil
end

# Each entry as one line to an IO: formatted in the calling thread, then
# written with its newline holding the backend's lock, so the lines of
# workers logging at once come out whole, never one inside another.
# Twelve workers writing 100,000 lines each to one file through it as it
# was, writing to the IO itself with no lock, left 2,563 to 4,378 of the
# 1.2 million torn or lost in five runs, at 1,008 ns a line between them;
# through it locked none, at 864 (--release, x86_64 Linux, 12 cores).
#
# The `IO` handed to `new` is not Share - its buffer is written in place,
# and two threads writing one tear what they write - so the backend keeps
# a handle of its own on the IO's descriptor behind its `Mutex`, as
# `AsyncBackend`'s thread does, and flushes it after every line. What the
# program writes to that IO itself goes out when the IO flushes, which
# STDOUT and STDERR do at every write.
pub class IOBackend < Backend
  getter formatter : Formatter
  @out : Mutex(IyiIO)

  def initialize(io : IO, @formatter : Formatter = DefaultFormatter.new)
    handle = io.handle
    raise "IOBackend: the IO has no descriptor to write to" if handle < 0_i64
    @out = Mutex.new { IyiIO.new(handle) }
  end

  def write(entry : Entry) : Nil
    line = @formatter.format(entry)
    while true
      return unless @out.lock { |io| IOBackend.put(io, line) }.is_a?(Cancelled)
    end
  end

  # The line and its end into the buffer, then out in one write.
  protected def self.put(io : IyiIO, line : String) : Nil
    io.write(line)
    io.write("\n")
    io.flush
  end

  # Nothing is held back: each line was written as it came.
  def close : Nil
  end
end

# The entries, kept for a test to read back, behind a lock: the workers of
# a parallel test may all log to one.
pub class MemoryBackend < Backend
  getter formatter : Formatter
  @store : Mutex(Array(Entry))

  def initialize(@formatter : Formatter = DefaultFormatter.new)
    @store = Mutex.new { [] of Entry }
  end

  def write(entry : Entry) : Nil
    while true
      done = @store.lock do |entries|
        entries << entry
      end
      return unless done.is_a?(Cancelled)
    end
  end

  def close : Nil
  end

  # The entries written so far, oldest first: a copy, since the backend's
  # own are behind its lock, where another thread may be adding one.
  def entries : Array(Entry)
    while true
      held = @store.get { |entries| List(Entry).new(entries) }
      return held.to_a unless held.is_a?(Cancelled)
    end
  end

  # The entries as the formatter would have written them.
  def output : Array(String)
    entries.map { |e| @formatter.format(e) }
  end

  def clear : Nil
    while true
      return unless @store.update { |_| [] of Entry }.is_a?(Cancelled)
    end
  end
end

# Entries written by a thread of their own, so a call that logs does not
# wait for the write: the entry is formatted where it is logged and
# queued, and a writer thread writes what has queued up since its last
# write, in order, in one write, to *io*'s descriptor.
#
#     AsyncBackend.open do |backend|   # closed, and drained, at the end
#       Log.setup(Severity::Info, backend)
#       ...
#     end
#
# `close` waits for every queued entry to be written and the thread to
# end; an entry written after it is refused. Entries queued when a program
# ends without `close` are lost, which the block form rules out. Any
# thread may write to the backend, and close it: it is Share, as every
# backend is.
#
# A thread needs the collector and a target with threads: under
# `-Dgc_none` or `-Dgc_boehm`, or on another target, `new` refuses.
pub class AsyncBackend < Backend
  getter formatter : Formatter
  @queue : Mutex(AsyncQueue)
  # 1 once `close` has begun.
  @closed : Atomic(UInt8)

  def initialize(io : IO = STDOUT, @formatter : Formatter = DefaultFormatter.new)
    @queue = Mutex.new { AsyncQueue.new }
    @closed = Atomic(UInt8).new(0_u8)
    handle = io.handle
    raise "AsyncBackend: the IO has no descriptor to write to" if handle < 0_i64
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
      # The writer is kept in the queue, behind the lock, where `close`
      # joins it: an `IyiThread` is not Share, and the field that held it
      # made this backend, and every logger it was set on, not Share.
      queue = @queue
      while true
        break unless queue.lock { |q| q.writer = AsyncBackend.writer(queue, handle) }.is_a?(Cancelled)
      end
    {% else %}
      raise "AsyncBackend: this build has no threads to write with (the collector's threads, on Linux, darwin arm64 and Windows x86_64)"
    {% end %}
  end

  {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
    # The thread writing what *queue* holds to *handle* until the queue is
    # closed and drained; marking the queue finished is the last it does
    # under the lock.
    protected def self.writer(queue : Mutex(AsyncQueue), handle : Int64) : IyiThread
      IyiThread.start do
        out = IyiIO.new(handle)
        while true
          batch = queue.wait_for { |q| q.take }
          # A thread is no task, and nothing cancels it.
          raise "AsyncBackend: the writer thread was cancelled" if batch.is_a?(Cancelled)
          out.write(batch[0])
          out.flush
          if batch[1]
            queue.lock { |q| q.finish }
            break
          end
        end
        nil
      end
    end
  {% end %}

  # A backend for the block, closed and drained when the block ends.
  def self.open(io : IO = STDOUT, formatter : Formatter = DefaultFormatter.new, &block : AsyncBackend -> R) : R forall R
    backend = new(io, formatter)
    defer backend.close
    block.call(backend)
  end

  def write(entry : Entry) : Nil
    raise "AsyncBackend: an entry written after close" if @closed.get != 0_u8
    line = @formatter.format(entry) + "\n"
    while true
      return unless @queue.lock { |q| q.push(line) }.is_a?(Cancelled)
    end
  end

  def close : Nil
    return if @closed.swap(1_u8) != 0_u8
    while true
      break unless @queue.lock { |q| q.close }.is_a?(Cancelled)
    end
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
      while true
        break unless @queue.wait_for { |q| q.join_once_finished }.is_a?(Cancelled)
      end
    {% end %}
  end
end

# The lines an `AsyncBackend` has queued, and its writer, behind its Mutex.
class AsyncQueue
  @lines : Array(String)
  @closed : Bool
  # Set by the writer once the last batch is written; it takes the lock
  # no more after that.
  @finished : Bool
  {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
    property writer : IyiThread? = nil
  {% end %}

  def initialize
    @lines = [] of String
    @closed = false
    @finished = false
  end

  def push(line : String) : Nil
    @lines << line
  end

  def close : Nil
    @closed = true
  end

  # Every line queued, as one string, and whether the queue is closed:
  # nil while it is empty and open, which the writer waits through.
  def take : {String, Bool}?
    return nil if @lines.empty? && !@closed
    text = @lines.join
    @lines = [] of String
    {text, @closed}
  end

  def finish : Nil
    @finished = true
  end

  # True once the writer has finished, and joined here, with the lock
  # held: it takes the lock no more, so the join waits only for it to
  # end. Nil before, which `close` waits through.
  def join_once_finished : Bool?
    return nil unless @finished
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
      if writer = @writer
        writer.join
      end
    {% end %}
    true
  end
end

pub class Logger
  getter source : String
  # This logger's own level, a severity's value, or `INHERIT` to hand the
  # decision to its parent: an atomic, so `level=` on one thread and a
  # call on another read one whole word, and a call below the level costs
  # a load for each logger up to the one that has a level - 2.0 ns a
  # `debug` to a child of the root at Info, where the plain field it was
  # took 1.7 (the median of five runs of 50 million, --release, x86_64
  # Linux).
  @own_level : Atomic(Int32)
  # This logger's own backend, nil for its parent's, behind a lock, since
  # a reference has no atomic; and whether it has one, so a call takes
  # only the lock of the logger whose backend it writes to. That lock and
  # the backend's are what an entry written costs more: 652 ns a line to
  # a file through an `IOBackend` on one thread, where the fields and the
  # IO without a lock took 569 (the medians of five runs of 400,000).
  @own_backend : Mutex(Backend?)
  @has_backend : Atomic(UInt8)
  @parent : Logger?
  # The children `for` has made, by name, behind a lock, so two workers
  # asking for one name at once are answered the one logger.
  @children : Mutex(Hash(String, Logger))
  # What `bind` gave this logger, on every entry it and its children write.
  @bound : Metadata?

  INHERIT = -1

  def initialize(@source : String, level : Severity? = nil, backend : Backend? = nil, parent : Logger? = nil, bound : Metadata? = nil)
    @own_level = Atomic(Int32).new(level ? level.value : INHERIT)
    # Upcast, or the Mutex is one of the argument's own class.
    held = backend.as(Backend?)
    @own_backend = Mutex.new { held }
    @has_backend = Atomic(UInt8).new(backend ? 1_u8 : 0_u8)
    @parent = parent
    @children = Mutex.new { {} of String => Logger }
    @bound = bound
  end

  # A logger for the same source, its level and backend this one's, whose
  # entries all carry *data*: a request's id, a connection's peer.
  def bind(**data) : Logger
    node = @bound
    data.each { |key, value| node = Metadata.new(key.to_s, value.to_s, node) }
    Logger.new(@source, nil, nil, self, node)
  end

  # This logger's own level, or the nearest ancestor's; Info at a root
  # never given one.
  def level : Severity
    Severity.new(level_value)
  end

  protected def level_value : Int32
    logger = self
    while true
      own = logger.own_level_value
      return own if own != INHERIT
      parent = logger.parent
      return Severity::Info.value unless parent
      logger = parent
    end
  end

  protected def own_level_value : Int32
    @own_level.get
  end

  protected def parent : Logger?
    @parent
  end

  # nil hands the decision back to the parent.
  def level=(lvl : Severity?) : Nil
    @own_level.set(lvl ? lvl.value : INHERIT)
  end

  def own_level : Severity?
    own = @own_level.get
    own == INHERIT ? nil : Severity.new(own)
  end

  # This logger's own backend, or the nearest ancestor's; nil silences.
  def backend : Backend?
    logger = self
    while true
      if found = logger.own_backend
        return found
      end
      parent = logger.parent
      return nil unless parent
      logger = parent
    end
  end

  def backend=(b : Backend?) : Nil
    held = b.as(Backend?)
    while true
      done = @own_backend.update do |_|
        @has_backend.set(held ? 1_u8 : 0_u8)
        held
      end
      return unless done.is_a?(Cancelled)
    end
  end

  def own_backend : Backend?
    return nil if @has_backend.get == 0_u8
    while true
      found = @own_backend.get { |b| b }
      return found unless found.is_a?(Cancelled)
    end
  end

  # The logger for *child_name* under this one, created on first ask;
  # `"a.b"` is the child `b` of the child `a`.
  def for(child_name : String) : Logger
    return self if child_name.empty?

    parts = child_name.split('.')
    current = self
    parts.each do |part|
      current = current.get_or_create_child(part)
    end
    current
  end

  protected def get_or_create_child(name : String) : Logger
    while true
      found = @children.get { |children| children[name]? || (children[name] = Logger.new(child_source(name), nil, nil, self)) }
      return found unless found.is_a?(Cancelled)
    end
  end

  # Only the root drops the dot: a child named "" under it has an empty
  # source too, and `Log.for(".a")` answered "a", the source of another
  # logger.
  private def child_source(name : String) : String
    @parent.nil? && @source.empty? ? name : "#{@source}.#{name}"
  end

  # None is a level and not a severity: an entry logged at None was
  # written by a logger set to None, the one level meant to write nothing.
  def log(severity : Severity, message : String, **data) : Nil
    return if severity.value < level_value || severity == Severity::None
    if b = backend
      b.write(Entry.new(@source, severity, message, Time.utc, entry_data(data)))
    end
  end

  def log(severity : Severity, **data, &block : -> String) : Nil
    return if severity.value < level_value || severity == Severity::None
    if b = backend
      b.write(Entry.new(@source, severity, block.call, Time.utc, entry_data(data)))
    end
  end

  private def entry_data(data) : Hash(String, String)
    found = Log.context
    bound_into(found)
    data.each { |key, value| found[key.to_s] = value.to_s }
    found
  end

  # The data `bind` gave this logger and its parents, the root's first.
  protected def bound_into(found : Hash(String, String)) : Nil
    if parent = @parent
      parent.bound_into(found)
    end
    if node = @bound
      node.merge_into(found)
    end
  end

  def trace(message : String, **data) : Nil
    log(Severity::Trace, message, **data)
  end

  def trace(**data, &b : -> String) : Nil
    log(Severity::Trace, **data, &b)
  end

  def debug(message : String, **data) : Nil
    log(Severity::Debug, message, **data)
  end

  def debug(**data, &b : -> String) : Nil
    log(Severity::Debug, **data, &b)
  end

  def info(message : String, **data) : Nil
    log(Severity::Info, message, **data)
  end

  def info(**data, &b : -> String) : Nil
    log(Severity::Info, **data, &b)
  end

  def notice(message : String, **data) : Nil
    log(Severity::Notice, message, **data)
  end

  def notice(**data, &b : -> String) : Nil
    log(Severity::Notice, **data, &b)
  end

  def warn(message : String, **data) : Nil
    log(Severity::Warn, message, **data)
  end

  def warn(**data, &b : -> String) : Nil
    log(Severity::Warn, **data, &b)
  end

  def error(message : String, **data) : Nil
    log(Severity::Error, message, **data)
  end

  def error(**data, &b : -> String) : Nil
    log(Severity::Error, **data, &b)
  end

  def fatal(message : String, **data) : Nil
    log(Severity::Fatal, message, **data)
  end

  def fatal(**data, &b : -> String) : Nil
    log(Severity::Fatal, **data, &b)
  end

  def trace? : Bool
    level <= Severity::Trace
  end

  def debug? : Bool
    level <= Severity::Debug
  end

  def info? : Bool
    level <= Severity::Info
  end

  def notice? : Bool
    level <= Severity::Notice
  end

  def warn? : Bool
    level <= Severity::Warn
  end

  def error? : Bool
    level <= Severity::Error
  end

  def fatal? : Bool
    level <= Severity::Fatal
  end
end

# The root logger and the calls that go straight to it.
pub class Log
  # Made by the first read, whichever thread makes it: a class variable's
  # initialiser runs once (`__iyi_once`). A nil checked and then filled
  # could make a root for each of two workers logging first, and the
  # loggers made under the one that lost would follow no `setup`.
  @@root : Logger = Logger.new("", Severity::Info, IOBackend.new(STDOUT))

  def self.root : Logger
    @@root
  end

  # Reconfigures the root in place, so loggers obtained earlier follow.
  def self.setup(level : Severity = Severity::Info, backend : Backend = IOBackend.new(STDOUT)) : Logger
    r = root
    r.level = level
    r.backend = backend
    r
  end

  # `setup`, the level read from *variable* - a severity's name, any case
  # - or *default_level* when it is unset or empty. A name that is no
  # severity is refused, the severities named.
  def self.setup_from_env(default_level : Severity = Severity::Info, backend : Backend = IOBackend.new(STDOUT), variable : String = "LOG_LEVEL") : Logger
    level = default_level
    if name = Program.env(variable)
      unless name.strip.empty?
        level = Severity.parse?(name.strip) || raise "Log.setup_from_env: #{variable}=#{name} is no severity (trace, debug, info, notice, warn, error, fatal or none)"
      end
    end
    setup(level, backend)
  end

  def self.for(source : String) : Logger
    root.for(source)
  end

  # Every task's open contexts, by the task's fiber; how many are open, so
  # a program that opens none never looks.
  @@contexts : Mutex(Hash(UInt64, Metadata)) = Mutex.new { {} of UInt64 => Metadata }
  @@open : Atomic(UInt64) = Atomic(UInt64).new(0_u64)

  # Runs the block with *data* on every entry logged in this task and in
  # the tasks it starts, over the context already open, and answers the
  # block's answer. The context before it is back when the block ends,
  # panic or not.
  def self.with_context(**data, &block : -> R) : R forall R
    id = task_key
    own = context_of(id)
    node = context_node
    data.each { |key, value| node = Metadata.new(key.to_s, value.to_s, node) }
    @@open.add(1_u64)
    store(id, node)
    defer restore(id, own)
    block.call
  end

  # The data this task's open contexts give an entry, the outermost first.
  def self.context : Hash(String, String)
    found = {} of String => String
    return found if @@open.get == 0_u64
    if node = context_node
      node.merge_into(found)
    end
    found
  end

  # This task's key in the table, its fiber's id; 0 on wasm32, which has
  # no tasks, its one program the one task.
  private def self.task_key : UInt64
    {% if flag?(:wasm32) %}
      0_u64
    {% else %}
      IyiScheduler.current.object_id
    {% end %}
  end

  # The innermost context open for this task: its own, or the nearest
  # starter's, up the groups that started it.
  private def self.context_node : Metadata?
    {% if flag?(:wasm32) %}
      context_of(0_u64)
    {% else %}
      fiber = IyiScheduler.current
      while true
        if node = context_of(fiber.object_id)
          return node
        end
        group = fiber.group
        return nil unless group
        fiber = group.owner
      end
    {% end %}
  end

  # The table's blocks never park, so a wait for it is another thread's
  # moment, and a cancelled task, which a wait answers Cancelled, asks
  # again.
  private def self.context_of(id : UInt64) : Metadata?
    while true
      found = @@contexts.get { |table| table[id]? }
      return found unless found.is_a?(Cancelled)
    end
  end

  private def self.store(id : UInt64, node : Metadata?) : Nil
    while true
      done = @@contexts.lock do |table|
        if node
          table[id] = node
        else
          table.delete(id)
        end
      end
      return unless done.is_a?(Cancelled)
    end
  end

  private def self.restore(id : UInt64, own : Metadata?) : Nil
    store(id, own)
    @@open.sub(1_u64)
  end

  def self.level : Severity
    root.level
  end

  def self.level=(level : Severity) : Nil
    root.level = level
  end

  def self.backend : Backend?
    root.backend
  end

  def self.backend=(backend : Backend?) : Nil
    root.backend = backend
  end

  def self.trace(msg : String, **data) : Nil
    root.trace(msg, **data)
  end

  def self.trace(**data, &b : -> String) : Nil
    root.trace(**data, &b)
  end

  def self.debug(msg : String, **data) : Nil
    root.debug(msg, **data)
  end

  def self.debug(**data, &b : -> String) : Nil
    root.debug(**data, &b)
  end

  def self.info(msg : String, **data) : Nil
    root.info(msg, **data)
  end

  def self.info(**data, &b : -> String) : Nil
    root.info(**data, &b)
  end

  def self.notice(msg : String, **data) : Nil
    root.notice(msg, **data)
  end

  def self.notice(**data, &b : -> String) : Nil
    root.notice(**data, &b)
  end

  def self.warn(msg : String, **data) : Nil
    root.warn(msg, **data)
  end

  def self.warn(**data, &b : -> String) : Nil
    root.warn(**data, &b)
  end

  def self.error(msg : String, **data) : Nil
    root.error(msg, **data)
  end

  def self.error(**data, &b : -> String) : Nil
    root.error(**data, &b)
  end

  def self.fatal(msg : String, **data) : Nil
    root.fatal(msg, **data)
  end

  def self.fatal(**data, &b : -> String) : Nil
    root.fatal(**data, &b)
  end
end
