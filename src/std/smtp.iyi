# An SMTP client (RFC 5321) over std/socket and std/tls, written in iyi:
# it hands a mail server what std/mail builds.
#
#     import std/smtp::{SmtpClient, SmtpError, SmtpSecurity}
#     import std/mail::{Mail}
#
#     smtp = SmtpClient.connect("mail.example.com", 587).or_panic   # STARTTLS
#     smtp.auth("ann@example.com", password).or_panic
#     smtp.send(msg).or_panic                                       # a Mail::Message
#     smtp.quit
#
# **Connecting.** `connect` opens the connection, reads the server's 220,
# and says EHLO - HELO when the server does not know EHLO (a 500, 502 or
# 504), and then no extension is taken to be offered. With
# `SmtpSecurity::StartTls`, the default, the server must offer STARTTLS
# (RFC 3207): the client asks for it, makes the TLS handshake through
# std/tls, the certificate checked for the host against `config`, and says
# EHLO again, forgetting what the server said before (section 4.2). A
# server that does not offer it, or that sends anything after its 220 to
# STARTTLS - bytes that would be read as though they had come under TLS,
# the injection of CVE-2011-0411 - is refused. `SmtpSecurity::Tls` is TLS
# from the first byte, as port 465 speaks it (RFC 8314), and
# `SmtpSecurity::Cleartext` none. The name said with EHLO is the caller's,
# or the connection's own address as an address literal (`[192.0.2.1]`,
# section 4.1.3), which needs no name lookup.
#
# **Authenticating.** `auth` sends AUTH PLAIN (RFC 4616), LOGIN or
# CRAM-MD5 (RFC 2195), the first of these the server offers unless the
# caller names one. Over a connection without TLS it refuses to send the
# password unless `cleartext_auth` is set: a password in the clear is the
# one thing a mistaken configuration should not do quietly.
#
# **Sending.** `send` takes a `Mail::Message` - its From as the sender,
# its To, Cc and Bcc as the recipients, its text with Bcc left out - or a
# sender, recipients and the message's bytes. The message must have a
# From and a Date, as `Mail::Message#to_s` asks (`msg.date =
# Mail.date(...)`): `send` panics as `to_s` does for a message `to_s`
# refuses, since that is the caller's mistake; every other failure is an
# `SmtpError`. MAIL FROM carries SIZE when
# the server offers it (RFC 1870), and a message larger than the size it
# names is refused before it is sent; BODY=8BITMIME (RFC 6152) when the
# message has bytes past ASCII, which a server that does not offer
# 8BITMIME is not sent; SMTPUTF8 (RFC 6531) when an address or the
# message is RFC 6532's UTF-8 and the server offers it, and the message
# is refused when it does not. Each RCPT TO must be taken - one that is
# not ends the transaction with RSET and is the error, so a message goes
# to all its recipients or to none. DATA sends the message with its line
# breaks made CRLF and each line that begins with a dot given another
# (section 4.5.2), then the lone dot.
#
# **Replies** are read whole, continuation lines and all (section 4.2.1):
# lines whose codes disagree, a line that is not a reply, a line longer
# than 4096 bytes or a reply of more than 100 lines is refused, the
# connection closed. A reply that is not the one a command wants is an
# `SmtpError` whose `code` is its code and `reply` its text; an error
# below SMTP - the socket's, TLS's, a server gone - has code 0 and closes
# the connection. Every read and write waits at most `timeout_ms` (five
# minutes unless the caller says otherwise: section 4.5.3.2 asks for
# that much or more of the client at each step), and a wait that runs
# out is an error whose `timed_out?` is true.
#
# Not here: PIPELINING, CHUNKING, DSN, and a password that std/tls has not
# kept from the wire because the caller set `cleartext_auth`.
# bench/std_smtp_exercise.sh holds it to a server written in Python for
# the purpose, over plain TCP, STARTTLS and TLS.

module std/smtp

import std/socket::{IyiSocket, SocketError}
import std/tls::{TlsClient, TlsConfig, TlsError}
import std/mail::{Mail}
import std/base64::{Base64}
import std/crypto::{HMAC}
import std/digest::{MD5}

# What a session answered that it should not have, or could not do, as a
# value. `code` is the reply's code, 0 when there was no reply to have
# one; `reply` the reply's text, its lines joined with newlines.
pub struct SmtpError
  getter reason : String
  getter code : Int32
  getter reply : String
  @timed_out : Bool
  @cancelled : Bool

  def initialize(@reason : String, @code : Int32 = 0, @reply : String = "", @timed_out : Bool = false, @cancelled : Bool = false)
  end

  # Whether a read or a write waited `timeout_ms` and nothing came.
  def timed_out? : Bool
    @timed_out
  end

  def cancelled? : Bool
    @cancelled
  end

  def to_s : String
    message
  end
end

impl Error for SmtpError
  def message : String
    return "SMTP: " + @reason if @code == 0
    "SMTP: #{@reason}: #{@code} #{@reply.gsub("\n", " / ")}"
  end
end

# How the connection is kept from the wire.
pub enum SmtpSecurity
  # Plain TCP, then STARTTLS, which the server must offer (RFC 3207).
  StartTls
  # TLS from the first byte, as port 465 has it (RFC 8314).
  Tls
  # Neither.
  Cleartext
end

pub enum SmtpAuth
  Plain
  Login
  CramMd5
end

# One reply: its code and its lines' text, the code and separator taken
# off each.
pub struct SmtpReply
  getter code : Int32
  getter lines : Array(String)

  def initialize(@code : Int32, @lines : Array(String))
  end

  def text : String
    @lines.join("\n")
  end
end

# A session with a mail server.
pub class SmtpClient
  # The longest reply line taken, and the most lines a reply may have.
  MAX_LINE  = 4096
  MAX_LINES =  100
  # Section 4.5.3.2's floor for the client's waits.
  TIMEOUT_MS = 300000

  # The server's 220.
  getter greeting : SmtpReply
  # What EHLO named, by its keyword in upper case: each extension's
  # parameters ("" when none). Empty after HELO.
  getter extensions : Hash(String, String) = {} of String => String
  # Whether a password may go over a connection without TLS.
  property cleartext_auth : Bool = false
  @socket : IyiSocket
  @tls : TlsClient?
  @host : String
  @helo : String
  @timeout_ms : Int32
  @held : String = ""
  @closed : Bool = false

  def initialize(@socket : IyiSocket, @host : String, @helo : String, @timeout_ms : Int32)
    @greeting = SmtpReply.new(0, [] of String)
  end

  # A session with *host* on *port*: connected, greeted, EHLO said, and
  # under TLS as *security* asks.
  def self.connect(host : String, port : Int32, security : SmtpSecurity = SmtpSecurity::StartTls, config : TlsConfig = TlsConfig.new,
                   helo : String? = nil, timeout_ms : Int32 = TIMEOUT_MS) : SmtpClient | SmtpError
    raise "SMTP: a timeout is a count of milliseconds, at least 1, not #{timeout_ms}" if timeout_ms < 1
    if name = helo
      raise "SMTP: the EHLO name #{name.inspect} is not a name" if name.empty? || SmtpClient.unsafe?(name) || name.includes?(" ")
    end
    socket = IyiSocket.connect(host, port, timeout_ms)
    return SmtpError.new("the connection to #{host}:#{port} was cancelled", cancelled: true) if socket.is_a?(Cancelled)
    return SmtpError.new("could not connect to #{host}:#{port}: #{socket.message}", timed_out: socket.timed_out?) if socket.is_a?(SocketError)
    socket.read_timeout_ms = timeout_ms
    socket.write_timeout_ms = timeout_ms
    client = SmtpClient.new(socket, host, helo || SmtpClient.literal(socket.local_address), timeout_ms)
    problem = client.open(security, config)
    if problem
      client.close
      return problem
    end
    client
  end

  # `[192.0.2.1]`, or `[IPv6:2001:db8::1]` (section 4.1.3).
  def self.literal(address : String) : String
    address.includes?(":") ? "[IPv6:#{address}]" : "[#{address}]"
  end

  def self.unsafe?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      return true if p[i] == 13_u8 || p[i] == 10_u8 || p[i] == 0_u8
      i = i + 1
    end
    false
  end

  protected def open(security : SmtpSecurity, config : TlsConfig) : SmtpError?
    if security == SmtpSecurity::Tls
      problem = secure(config)
      return problem if problem
    end
    greeting = reply
    return greeting if greeting.is_a?(SmtpError)
    @greeting = greeting
    return SmtpError.new("the server did not greet with 220", greeting.code, greeting.text) unless greeting.code == 220
    problem = hello
    return problem if problem
    if security == SmtpSecurity::StartTls
      return SmtpError.new("the server does not offer STARTTLS") unless @extensions.has_key?("STARTTLS")
      answer = command("STARTTLS")
      return answer if answer.is_a?(SmtpError)
      return SmtpError.new("STARTTLS was refused", answer.code, answer.text) unless answer.code == 220
      return fail("the server sent more after its 220 to STARTTLS, which would be read as though it came under TLS") unless @held.empty?
      problem = secure(config)
      return problem if problem
      problem = hello
      return problem if problem
    end
    nil
  end

  private def secure(config : TlsConfig) : SmtpError?
    conn = TlsClient.over(@socket, @host, config, @timeout_ms)
    return fail("the TLS handshake with #{@host} failed: #{conn.message}", conn.timed_out?) if conn.is_a?(TlsError)
    @tls = conn
    nil
  end

  # EHLO, and HELO where the server does not know EHLO; the extensions
  # read afresh either way.
  private def hello : SmtpError?
    @extensions = {} of String => String
    answer = command("EHLO " + @helo)
    return answer if answer.is_a?(SmtpError)
    if answer.code == 500 || answer.code == 502 || answer.code == 504
      answer = command("HELO " + @helo)
      return answer if answer.is_a?(SmtpError)
      return SmtpError.new("HELO was refused", answer.code, answer.text) unless answer.code == 250
      return nil
    end
    return SmtpError.new("EHLO was refused", answer.code, answer.text) unless answer.code == 250
    answer.lines.each_with_index do |line, i|
      if i > 0
        space = line.index(' ')
        keyword = (space ? line[0, space] : line).upcase
        @extensions[keyword] = space ? line[space + 1, line.bytesize - space - 1] : ""
      end
    end
    nil
  end

  # Whether the session is under TLS.
  def tls? : Bool
    !@tls.nil?
  end

  def closed? : Bool
    @closed
  end

  # AUTH as *user* with *password*, by *mechanism*, or by the first the
  # server offers of PLAIN, LOGIN and CRAM-MD5.
  def auth(user : String, password : String, mechanism : SmtpAuth? = nil) : SmtpError?
    raise "SMTP: a user name or password holds a line break" if SmtpClient.unsafe?(user) || SmtpClient.unsafe?(password)
    return SmtpError.new("the connection is closed") if @closed
    unless tls? || @cleartext_auth
      return SmtpError.new("AUTH without TLS is refused: the password would cross the network in the clear (set cleartext_auth to send it so)")
    end
    offered = (@extensions["AUTH"]? || "").upcase.split(' ')
    return SmtpError.new("the server offers no AUTH") if offered == [""]
    chosen = mechanism
    unless chosen
      chosen = SmtpAuth::Plain if offered.includes?("PLAIN")
      chosen = SmtpAuth::Login if chosen.nil? && offered.includes?("LOGIN")
      chosen = SmtpAuth::CramMd5 if chosen.nil? && offered.includes?("CRAM-MD5")
      return SmtpError.new("the server offers none of PLAIN, LOGIN and CRAM-MD5, only #{offered.join(" ")}") unless chosen
    end
    name = SmtpClient.mechanism_name(chosen)
    return SmtpError.new("the server does not offer AUTH #{name}") unless offered.includes?(name)
    answer = nil.as(SmtpReply | SmtpError | Nil)
    case chosen
    when SmtpAuth::Plain
      answer = command("AUTH PLAIN " + Base64.encode("\u0000" + user + "\u0000" + password))
    when SmtpAuth::Login
      answer = step("AUTH LOGIN", 334)
      answer = step(Base64.encode(user), 334) unless answer.is_a?(SmtpError)
      answer = command(Base64.encode(password)) unless answer.is_a?(SmtpError)
    when SmtpAuth::CramMd5
      answer = step("AUTH CRAM-MD5", 334)
      if answer.is_a?(SmtpReply)
        challenge = Base64.decode(answer.text.strip)
        answer = command(Base64.encode(user + " " + HMAC.hexdigest(MD5, password, challenge)))
      end
    end
    return answer if answer.is_a?(SmtpError)
    return SmtpError.new("AUTH #{name} was refused", answer.code, answer.text) if answer.is_a?(SmtpReply) && answer.code != 235
    nil
  end

  def self.mechanism_name(mechanism : SmtpAuth) : String
    case mechanism
    when SmtpAuth::Plain then "PLAIN"
    when SmtpAuth::Login then "LOGIN"
    else                      "CRAM-MD5"
    end
  end

  # *line*, whose reply must be *code*.
  private def step(line : String, code : Int32) : SmtpReply | SmtpError
    answer = command(line)
    return answer if answer.is_a?(SmtpError)
    return SmtpError.new("the server answered #{line.split(' ')[0]} with #{answer.code}, not #{code}", answer.code, answer.text) unless answer.code == code
    answer
  end

  # *message* to its recipients - To, Cc and Bcc - from its From. The
  # message must have a From and a Date, as `Mail::Message#to_s` asks
  # (`msg.date = Mail.date(...)`), and at least one recipient. A message
  # without them is the caller's mistake and panics: `SMTP: a message has
  # no From`, then `to_s`'s `mail: a message has no Date`, then `SMTP: a
  # message with no recipients`. Every other failure - the connection, the
  # server's replies, a size or extension the server refuses - is the
  # `SmtpError` returned.
  def send(message : Mail::Message) : SmtpError?
    sender = message.from
    raise "SMTP: a message has no From" unless sender
    send(sender.address, message.recipients, message.to_s, message.utf8?)
  end

  # *data*, a whole message, from *sender* to *recipients*; *utf8* when
  # the message is RFC 6532's, as SMTPUTF8 carries. *data* is sent as it
  # is, so a message written with `Mail::Message#to_s` must have had its
  # Date to get here. No recipients, or an address that holds a line break
  # or an angle bracket, panics (`SMTP: a message with no recipients`,
  # `SMTP: ... is not an address to put in angle brackets`); every other
  # failure is the `SmtpError` returned.
  def send(sender : String, recipients : Array(String), data : String, utf8 : Bool = false) : SmtpError?
    raise "SMTP: a message with no recipients" if recipients.empty?
    ([sender] + recipients).each do |a|
      raise "SMTP: #{a.inspect} is not an address to put in angle brackets" if SmtpClient.unsafe?(a) || a.includes?("<") || a.includes?(">")
    end
    return SmtpError.new("the connection is closed") if @closed
    wide = utf8 || !SmtpClient.ascii?(sender) || recipients.any? { |r| !SmtpClient.ascii?(r) }
    eight = !SmtpClient.ascii?(data)
    params = ""
    if wide
      return SmtpError.new("the message needs SMTPUTF8, which the server does not offer") unless @extensions.has_key?("SMTPUTF8")
      params = params + " SMTPUTF8"
    end
    if eight
      if @extensions.has_key?("8BITMIME")
        params = params + " BODY=8BITMIME"
      elsif !wide
        return SmtpError.new("the message has bytes past ASCII, and the server offers neither 8BITMIME nor SMTPUTF8")
      end
    end
    wire = SmtpClient.stuffed(data)
    if size = @extensions["SIZE"]?
      limit = size.strip.to_i64?
      if limit && limit > 0 && wire.bytesize.to_i64 > limit
        return SmtpError.new("the message is #{wire.bytesize} bytes, more than the server's SIZE of #{limit}")
      end
      params = " SIZE=#{wire.bytesize}" + params
    end
    answer = command("MAIL FROM:<#{sender}>" + params)
    return answer if answer.is_a?(SmtpError)
    return SmtpError.new("MAIL FROM:<#{sender}> was refused", answer.code, answer.text) unless answer.code == 250
    recipients.each do |r|
      answer = command("RCPT TO:<#{r}>")
      return answer if answer.is_a?(SmtpError)
      unless answer.code == 250 || answer.code == 251
        refused = SmtpError.new("RCPT TO:<#{r}> was refused", answer.code, answer.text)
        reset = command("RSET")
        return reset if reset.is_a?(SmtpError)
        return refused
      end
    end
    answer = command("DATA")
    return answer if answer.is_a?(SmtpError)
    return SmtpError.new("DATA was refused", answer.code, answer.text) unless answer.code == 354
    problem = write(wire)
    return problem if problem
    answer = reply
    return answer if answer.is_a?(SmtpError)
    return SmtpError.new("the message was refused", answer.code, answer.text) unless answer.code == 250
    nil
  end

  def self.ascii?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      return false if p[i] >= 128_u8
      i = i + 1
    end
    true
  end

  # *data* as DATA sends it (section 4.5.2): line breaks CRLF, a dot
  # doubled at a line's start, a CRLF at the end if it had none, and the
  # lone dot after.
  def self.stuffed(data : String) : String
    p = data.to_unsafe
    n = data.bytesize
    io = String::Builder.new(n + n // 32 + 8)
    start = true
    i = 0
    while i < n
      b = p[i]
      io.write_byte(46_u8) if start && b == 46_u8
      start = false
      if b == 13_u8 || b == 10_u8
        io << "\r\n"
        i = i + 1 if b == 13_u8 && i + 1 < n && p[i + 1] == 10_u8
        start = true
      else
        io.write_byte(b)
      end
      i = i + 1
    end
    io << "\r\n" unless start
    io << ".\r\n"
    io.to_s
  end

  # QUIT, its 221 read, and the connection closed.
  def quit : SmtpError?
    return nil if @closed
    answer = command("QUIT")
    close
    return answer if answer.is_a?(SmtpError)
    return SmtpError.new("QUIT was not answered 221", answer.code, answer.text) unless answer.code == 221
    nil
  end

  # The connection closed, without QUIT.
  def close : Nil
    return if @closed
    @closed = true
    if conn = @tls
      conn.close
    else
      @socket.close
    end
  end

  # *line* sent, and its reply.
  def command(line : String) : SmtpReply | SmtpError
    raise "SMTP: a command holds a line break" if SmtpClient.unsafe?(line)
    return SmtpError.new("the connection is closed") if @closed
    problem = write(line + "\r\n")
    return problem if problem
    reply
  end

  private def write(data : String) : SmtpError?
    if conn = @tls
      sent = conn.write(data)
      return fail("writing to #{@host} failed: #{sent.message}", sent.timed_out?) if sent.is_a?(TlsError)
    else
      sent = @socket.write(data)
      return fail("writing to #{@host} was cancelled", false, true) if sent.is_a?(Cancelled)
      return fail("writing to #{@host} failed: #{sent.message}", sent.timed_out?) if sent.is_a?(SocketError)
    end
    nil
  end

  # The closed connection and the error that closed it.
  private def fail(reason : String, timed_out : Bool = false, cancelled : Bool = false) : SmtpError
    close
    SmtpError.new(reason, timed_out: timed_out, cancelled: cancelled)
  end

  # The next reply, every line of it.
  def reply : SmtpReply | SmtpError
    lines = [] of String
    code = 0
    while true
      line = read_line
      return line if line.is_a?(SmtpError)
      p = line.to_unsafe
      ok = line.bytesize >= 3 && p[0] >= 50_u8 && p[0] <= 53_u8 && SmtpClient.digit?(p[1]) && SmtpClient.digit?(p[2])
      ok = false if ok && line.bytesize > 3 && p[3] != 32_u8 && p[3] != 45_u8
      return fail("the server's reply line #{line[0, line.bytesize > 40 ? 40 : line.bytesize].inspect} is not a reply") unless ok
      this = line[0, 3].to_i
      return fail("a reply's lines have the codes #{code} and #{this}") if code != 0 && this != code
      code = this
      lines << (line.bytesize > 4 ? line[4, line.bytesize - 4] : "")
      return SmtpReply.new(code, lines) unless line.bytesize > 3 && p[3] == 45_u8
      return fail("a reply of more than #{MAX_LINES} lines") if lines.size >= MAX_LINES
    end
    SmtpReply.new(code, lines)
  end

  def self.digit?(b : UInt8) : Bool
    b >= 48_u8 && b <= 57_u8
  end

  # One line without its CRLF (a bare LF ends one too).
  private def read_line : String | SmtpError
    while true
      nl = @held.index('\n')
      return fail("a reply line longer than #{MAX_LINE} bytes") if (nl || @held.bytesize) > MAX_LINE + 1
      if nl
        line = @held[0, nl]
        @held = @held[nl + 1, @held.bytesize - nl - 1]
        return line.ends_with?("\r") ? line[0, line.bytesize - 1] : line
      end
      more = pull
      return more if more.is_a?(SmtpError)
      return fail("the server closed the connection") if more.empty?
      @held = @held + more
    end
    ""
  end

  private def pull : String | SmtpError
    if conn = @tls
      got = conn.read(4096)
      return fail("reading from #{@host} failed: #{got.message}", got.timed_out?) if got.is_a?(TlsError)
      got
    else
      got = @socket.read(4096)
      return fail("reading from #{@host} was cancelled", false, true) if got.is_a?(Cancelled)
      return fail("reading from #{@host} failed: #{got.message}", got.timed_out?) if got.is_a?(SocketError)
      got
    end
  end
end
