  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@exps)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "%" << @name
    if e = @exps
      sb << "{"
      i = 0
      while i < e.size
        sb << ", " if i > 0
        e[i].to_s(sb)
        i = i + 1
      end
      sb << "}"
    end
  end
end

