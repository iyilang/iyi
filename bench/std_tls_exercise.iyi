# A root and a leaf for fuzz.test it issued (Ed25519, valid 2025-01-01 to
# 2045-01-01), and the leaf's seed: bench/std_fuzz_exercise.iyi's, for the
# connections this run makes to a server of its own.
BINDING_ROOT = ""
BINDING_LEAF = ""
BINDING_SEED = "3c9cb8fdef08086c92abb13f615fcbd54466dac12a3a363db6fb289ef88bc7a2"

args = Program.args

if args.size > 0 && args[0] == "scenarios"
  port = File.read(args[1] + "/port").to_i
  config = TlsConfig.new
  config.roots = Certificate.from_pem(File.read(args[1] + "/roots.pem")).or_panic
  config.alpn = ["h2", "http/1.1"]
  # Presented where a request names ed25519, and only there.
  config.identity = TlsIdentity.from_pem(File.read(args[1] + "/client.pem"), File.read(args[1] + "/client.key")).or_panic
  # The same, told to speak TLS 1.2: for the tls12-* scenarios alone, so
  # every other one meets the default.
  config12 = TlsConfig.new
  config12.roots = config.roots
  config12.alpn = config.alpn
  config12.identity = config.identity
  config12.min_version = TlsVersion::TLS12
  held = 0
  refused = 0
  skipped = 0
  SCENARIOS.each do |s|
    # A hybrid handshake needs ML-KEM at the scripted server too.
    if s[0] == "hybrid" && !File.file?(args[1] + "/mlkem")
      skipped = skipped + 1
      next
    end
    socket = IyiSocket.connect("127.0.0.1", port)
    check socket.is_a?(IyiSocket), "#{s[0]}: no connection to the scripted server"
    next unless socket.is_a?(IyiSocket)
    # Three seconds for a handshake: the slow server is cut off within it.
    conn = TlsClient.over(socket, s[0] + ".tls.test", s[0].starts_with?("tls12-") ? config12 : config, 3000)
    if s[1]
      check !conn.is_a?(TlsError), "#{s[0]}: refused: #{conn.is_a?(TlsError) ? conn.message : ""}"
      next unless conn.is_a?(TlsClient)
      want = GROUPS[s[0]]? || "X25519"
      check conn.named_group == want, "#{s[0]}: the group agreed is #{conn.named_group.inspect}, not #{want}"
      if s[0] == "keyupdate"
        # The server's keys move before its echo; this side's KeyUpdate goes
        # with its next write, never from a read.
        conn.write("hello")
        first = conn.read
        check first == "echo:hello", "keyupdate: the first echo came back as #{first.is_a?(TlsError) ? first.message : first.inspect}"
        conn.write("again")
        got = drain(conn)
        check got == "echo:again", "keyupdate: the second echo came back as #{got.inspect}"
        held = held + 1
        next
      end
      if s[0] == "slow-echo"
        # A read past its timeout says so and leaves the connection open.
        conn.write("hello")
        conn.read_timeout_ms = 300
        first = conn.read
        check first.is_a?(TlsError) && first.timed_out?, "slow-echo: a read past its timeout answered #{first.is_a?(TlsError) ? first.message : first.inspect}"
        conn.read_timeout_ms = 5000
        got = drain(conn)
        check got == "echo:hello", "slow-echo: after the timeout the echo came back as #{got.inspect}"
        held = held + 1
        next
      end
      if s[0] == "client-rekey"
        # Two records a key: the third and fifth writes move to new keys
        # first; then a KeyUpdate asking for the server's.
        conn.key_limit = 2_u64
        conn.write("hello")
        ["b", "c", "d", "e"].each { |x| conn.write(x) }
        asked = conn.key_update(true)
        check asked.nil?, "client-rekey: key_update answered #{asked.is_a?(TlsError) ? asked.message : ""}"
        got = drain(conn)
        check got == "echo:hellobcde keyupdates=2 asked=1", "client-rekey: the echo came back as #{got.inspect}"
        held = held + 1
        next
      end
      conn.write("hello")
      got = drain(conn)
      if s[2].starts_with?("read: ")
        # Refused after the handshake: what the read says.
        check got.includes?(s[2][6, s[2].size - 6]), "#{s[0]}: read #{got[0, 120].inspect}"
      else
        check conn.cipher_suite.includes?(s[2]) || conn.alpn_protocol == s[2] || s[2].empty?, "#{s[0]}: #{conn.cipher_suite}, alpn #{conn.alpn_protocol.inspect}"
        expected = s[0] == "big" ? 40000 : 10
        check got.starts_with?("echo:hello") && got.size == expected, "#{s[0]}: the echo came back as #{got[0, 60].inspect} (#{got.size} bytes)"
      end
      held = held + 1
    else
      check conn.is_a?(TlsError), "#{s[0]}: expected a refusal, got a connection"
      if conn.is_a?(TlsError)
        check conn.message.includes?(s[2]), "#{s[0]}: refused with #{conn.message.inspect}, not #{s[2].inspect}"
      end
      refused = refused + 1
    end
  end
  puts "  #{held} handshakes held and echoed, #{refused} refused, each for its reason"
  puts "  the hybrid handshake not asked: the scripted server's cryptography has no ML-KEM (it has from 48, on an OpenSSL with it)" if skipped > 0
  resumed = 0
  RESUMPTIONS.each do |r|
    session = TlsSession.new
    first = scripted(args[1], r[0], config, session)
    check first.is_a?(TlsClient), "#{r[0]}: the first connection: #{first.is_a?(TlsError) ? first.message : ""}"
    next unless first.is_a?(TlsClient)
    first.write("hello")
    got = drain(first)
    check got == "echo:hello" && session.size == 1 && !first.resumed?, "#{r[0]}: the first connection read #{got.inspect}, #{session.size} tickets held"
    second = scripted(args[1], r[0], config, session)
    if r[1] == "resumed" || r[1] == "full"
      check second.is_a?(TlsClient), "#{r[0]}: refused: #{second.is_a?(TlsError) ? second.message : ""}"
      next unless second.is_a?(TlsClient)
      check second.resumed? == (r[1] == "resumed"), "#{r[0]}: resumed? is #{second.resumed?}"
      # The server's certificate goes with the session, checked as the first
      # connection checked it.
      check !second.peer_certificates.empty? && second.peer_certificates[0].subject_name == first.peer_certificates[0].subject_name, "#{r[0]}: no peer certificate"
      second.write("again")
      got = drain(second)
      check got == "echo:again", "#{r[0]}: the second echo came back as #{got.inspect}"
    else
      check second.is_a?(TlsError) && second.message.includes?(r[1]), "#{r[0]}: #{second.is_a?(TlsError) ? "refused with " + second.message.inspect : "held"}, not #{r[1].inspect}"
    end
    resumed = resumed + 1
  end
  TICKET_SCENARIOS.each do |t|
    session = TlsSession.new
    conn = scripted(args[1], t[0], config, session)
    check conn.is_a?(TlsClient), "#{t[0]}: refused: #{conn.is_a?(TlsError) ? conn.message : ""}"
    next unless conn.is_a?(TlsClient)
    conn.write("hello")
    got = drain(conn)
    check (t[2].empty? ? got == "echo:hello" : got.includes?(t[2])), "#{t[0]}: read #{got[0, 120].inspect}"
    check session.size == t[1], "#{t[0]}: #{session.size} tickets held, not #{t[1]}"
    resumed = resumed + 1
  end
  puts "  #{resumed} resumptions and ticket scenarios, each as it should be"
  # Early data through a session: the first connection keeps a ticket; the
  # second is given the data to send early, and comes to the state named,
  # the scripted server's echo after it, or the refusal named.
  early_held = 0
  EARLY_SCENARIOS.each do |e|
    session = TlsSession.new
    first = scripted(args[1], e[0], config, session)
    check first.is_a?(TlsClient), "#{e[0]}: the first connection: #{first.is_a?(TlsError) ? first.message : ""}"
    next unless first.is_a?(TlsClient)
    first.write("hello")
    got = drain(first)
    check got == "echo:hello" && session.size == 1, "#{e[0]}: the first connection read #{got.inspect}, #{session.size} tickets held"
    second = scripted(args[1], e[0], config, session, "hello")
    if e[1].starts_with?("refused: ")
      check second.is_a?(TlsError) && second.message.includes?(e[1][9, e[1].size - 9]), "#{e[0]}: #{second.is_a?(TlsError) ? "refused with " + second.message.inspect : "held"}, not #{e[1].inspect}"
    else
      check second.is_a?(TlsClient), "#{e[0]}: refused: #{second.is_a?(TlsError) ? second.message : ""}"
      next unless second.is_a?(TlsClient)
      check second.early_data.to_s == e[1], "#{e[0]}: the early data came to #{second.early_data}, not #{e[1]}"
      second.write("again")
      got = drain(second)
      check got == e[2], "#{e[0]}: read #{got.inspect}, not #{e[2].inspect}"
    end
    early_held = early_held + 1
  end
  puts "  #{early_held} early-data scenarios, each as it should be"
  exit 0
end

if args.size > 0 && args[0] == "get"
  config = TlsConfig.new
  config.roots = Certificate.from_pem(File.read(args[2])).or_panic
  config.alpn = [args[4]] if args.size > 4 && args[4] != "-"
  config.identity = TlsIdentity.from_pem(File.read(args[5]), File.read(args[6])).or_panic if args.size > 6
  config.min_version = TlsVersion::TLS12 if ENV["TLS_MIN_VERSION"]? == "1.2"
  config.post_quantum = false if ENV["TLS_POST_QUANTUM"]? == "0"
  config.require_staple = true if ENV["TLS_REQUIRE_STAPLE"]? == "1"
  socket = IyiSocket.connect("127.0.0.1", args[1].to_i)
  unless socket.is_a?(IyiSocket)
    puts "no connection"
    exit 0
  end
  conn = TlsClient.over(socket, args[3], config)
  if conn.is_a?(TlsError)
    puts "refused: #{conn.message}"
    exit 0
  end
  conn.write("GET / HTTP/1.0\r\n\r\n")
  # With TLS_EXPORT, what this end exports for that label, 16 bytes.
  label = ENV["TLS_EXPORT"]?
  exported = label ? " exported=#{hex_of(conn.export_keying_material(label, [] of UInt8, 16))}" : ""
  got = drain(conn)
  # The stapled OCSP response's status, when one came.
  stapled = (status = conn.ocsp_status) ? " staple=#{status.word}" : ""
  puts "#{got.lines.first? || got} #{conn.cipher_suite} alpn=#{conn.alpn_protocol || "-"}#{exported} #{conn.version} group=#{conn.named_group}#{stapled}"
  conn.close
  exit 0
end

# renegotiate PORT ROOTS HOST: TLS 1.2 to a server that sends a
# HelloRequest after "first" reaches it; the read that takes it times out,
# and the next write carries the no_renegotiation warning before "second".
if args.size > 0 && args[0] == "renegotiate"
  config = TlsConfig.new
  config.roots = Certificate.from_pem(File.read(args[2])).or_panic
  config.min_version = TlsVersion::TLS12
  socket = IyiSocket.connect("127.0.0.1", args[1].to_i)
  unless socket.is_a?(IyiSocket)
    puts "no connection"
    exit 0
  end
  conn = TlsClient.over(socket, args[3], config).or_panic
  conn.write("first\n")
  conn.read_timeout_ms = 3000
  first = conn.read
  puts "#{conn.version}: the read after first: #{first.is_a?(TlsError) ? first.message : first.inspect}"
  conn.read_timeout_ms = 3000
  sent = conn.write("second\n")
  puts "the write after it: #{sent.is_a?(TlsError) ? sent.message : sent}"
  after = conn.read
  puts "then: #{after.is_a?(TlsError) ? after.message : after.inspect}"
  exit 0
end

# resume PORT ROOTS HOST [ALPN|-] [COUNT]: COUNT connections (two unless
# given) through one TlsSession, each GET / with its answer read to the
# end; a line each: the answer's first line, whether it resumed, the
# suite, the protocol, the server's certificate, what OpenSSL's s_server
# -www says of the session ("Reused, TLSv1.3, ..." or "New, ..."), or the
# exercise's server ("resumed=..."), and the tickets the session holds.
if args.size > 0 && args[0] == "resume"
  config = TlsConfig.new
  config.roots = Certificate.from_pem(File.read(args[2])).or_panic
  config.alpn = [args[4]] if args.size > 4 && args[4] != "-"
  count = args.size > 5 ? args[5].to_i : 2
  # EARLY: given to each connection to send early; "get" is GET / itself.
  early = args.size > 6 ? (args[6] == "get" ? "GET / HTTP/1.0\r\n\r\n" : args[6]) : nil
  session = TlsSession.new
  count.times do |i|
    socket = IyiSocket.connect("127.0.0.1", args[1].to_i)
    unless socket.is_a?(IyiSocket)
      puts "#{i + 1}: no connection"
      next
    end
    conn = TlsClient.over(socket, args[3], config, session: session, early_data: early)
    if conn.is_a?(TlsError)
      puts "#{i + 1}: refused: #{conn.message}"
      next
    end
    if early && !early.starts_with?("GET")
      # Early data that is no request: the tickets read, and no more.
      conn.read_timeout_ms = 1000
      conn.read
      puts "#{i + 1}: early=#{conn.early_data} resumed=#{conn.resumed? ? "yes" : "no"} held=#{session.size}"
      conn.close
      next
    end
    conn.write("GET / HTTP/1.0\r\n\r\n") unless early
    got = drain(conn)
    said = got.lines.find { |line| line.starts_with?("Reused, ") || line.starts_with?("New, ") || line.includes?(" resumed=") } || "-"
    peer = conn.peer_certificates.empty? ? "-" : conn.peer_certificates[0].subject_name
    puts "#{i + 1}: #{got.lines.first? || got} resumed=#{conn.resumed? ? "yes" : "no"} early=#{conn.early_data} #{conn.cipher_suite} alpn=#{conn.alpn_protocol || "-"} peer=#{peer} said=#{said.strip} held=#{session.size}"
    conn.close
  end
  exit 0
end

if args.size > 0 && args[0] == "config"
  answer = TlsServerConfig.from_pem(File.read(args[1]), File.read(args[2]))
  if answer.is_a?(TlsError)
    puts "refused: #{answer.message}"
  else
    puts "config: #{answer.chain.size} certificates, leaf #{answer.leaf.subject_name}"
  end
  exit 0
end

# What one connection to the server mode says it agreed, for a reply.
def hex_of(bytes : Array(UInt8)) : String
  bytes.map { |x| (x < 16_u8 ? "0" : "") + x.to_s(16) }.join("")
end

# What the server says of a connection: the name asked for, the protocol,
# the suite, the client's certificate, the certificate it was shown under,
# 16 bytes exported for "EXPERIMENTAL iyi" (RFC 8446 section 7.5; RFC 5705
# in TLS 1.2), the version, the key exchange group, whether it resumed a
# session, and what came early.
def agreed(conn : TlsServer, early : String = "") : String
  peer = conn.peer_certificates.empty? ? "-" : conn.peer_certificates[0].subject_name
  exported = hex_of(conn.export_keying_material("EXPERIMENTAL iyi", [] of UInt8, 16))
  stapled = (status = conn.ocsp_status) ? " stapled=#{status.word}" : ""
  "name=#{conn.server_name || "-"} alpn=#{conn.alpn_protocol || "-"} #{conn.cipher_suite} peer=#{peer} shown=#{conn.identity.leaf.subject_name} exported=#{exported} #{conn.version} group=#{conn.named_group} early=#{early.inspect} resumed=#{conn.resumed? ? "yes" : "no"}#{stapled}"
end

# Early data, read apart from the rest as far as a whole request, which is
# answered at once - before the client's Finished (0.5-RTT) - and the
# handshake finished before the close; any other bytes echoed.
def serve_one(conn : TlsServer) : String
  early = ""
  if conn.early_data?
    until early.includes?("\r\n\r\n")
      chunk = conn.read_early
      return "held #{agreed(conn)}, then #{chunk.message}" if chunk.is_a?(TlsError)
      break if chunk.empty?
      early = early + chunk
    end
  end
  received = early
  while true
    if received.includes?("\r\n\r\n") || received.includes?("\n\n")
      conn.write("HTTP/1.0 200 ok\r\n\r\n#{agreed(conn, early)}\n")
      finished = conn.finish
      return "held #{agreed(conn, early)}, then #{finished.message}" if finished
      conn.close
      return "held #{agreed(conn, early)}, answered"
    end
    chunk = conn.read
    return "held #{agreed(conn, early)}, then #{chunk.message}" if chunk.is_a?(TlsError)
    if chunk.empty?
      # The client's close_notify ends its writing alone in TLS 1.3, and
      # this side writes on (RFC 8446 section 6.1); in TLS 1.2 it ends
      # the connection, and the write is refused (RFC 5246 section 7.2.1).
      after = conn.write("HTTP/1.0 200 ok\r\n\r\nwritten after the client's close_notify\n")
      conn.close
      return "held #{agreed(conn, early)}, closed by the client after #{received.bytesize} bytes, then #{after.is_a?(TlsError) ? "a write refused: #{after.message}" : "written to"}"
    end
    received = received + chunk
    conn.write("echo:" + chunk) unless received.includes?("\r\n\r\n") || received.includes?("\n\n")
  end
  ""
end

if args.size > 0 && args[0] == "serve"
  config = TlsServerConfig.from_pem(File.read(args[1] + "/chain.pem"), File.read(args[1] + "/key.pem")).or_panic
  config.alpn = ["h2", "http/1.1"]
  config.min_version = TlsVersion::TLS12 if ENV["TLS_MIN_VERSION"]? == "1.2"
  # Early data taken, up to 16 KiB, unless DIR/no-early says not.
  config.max_early_data = 16384 unless File.file?(args[1] + "/no-early")
  # A second identity, for other.test, shown to a client that asks for it.
  if File.file?(args[1] + "/other-chain.pem")
    config.add_identity(TlsIdentity.from_pem(File.read(args[1] + "/other-chain.pem"), File.read(args[1] + "/other-key.pem")).or_panic)
  end
  if File.file?(args[1] + "/client-roots.pem")
    config.client_roots = Certificate.from_pem(File.read(args[1] + "/client-roots.pem")).or_panic
    config.client_required = !File.file?(args[1] + "/client-optional")
  end
  # DIR/sourced: the identity shown is the one `identity_source` answers,
  # read from the same files into a TlsIdentity of its own - as
  # std/autocert's manager answers what it got - and DIR/staple.der is
  # stapled to that identity alone, not to the config's.
  sourced = nil.as(TlsIdentity?)
  if File.file?(args[1] + "/sourced")
    own = TlsIdentity.from_pem(File.read(args[1] + "/chain.pem"), File.read(args[1] + "/key.pem")).or_panic
    sourced = own
    config.identity_source = ->(name : String?, offered : Array(String)?) { own.as(TlsIdentity | TlsError | Nil) }
  end
  # DIR/staple.der: an OCSP response stapled for a client that asks.
  if File.file?(args[1] + "/staple.der")
    held = File.read(args[1] + "/staple.der")
    der = Array(UInt8).new(held.bytesize) { |i| held.to_unsafe[i] }
    problem = (chosen = sourced) ? config.staple(der, chosen) : config.staple(der)
    if problem
      puts "staple refused: #{problem.message}"
      STDOUT.flush
    end
  end
  listener = IyiSocket.listen("127.0.0.1", 0)
  File.write(args[1] + "/port", listener.local_port.to_s)
  args[2].to_i.times do
    socket = listener.accept
    unless socket.is_a?(IyiSocket)
      puts "no connection"
      next
    end
    socket.read_timeout_ms = 15000
    # Five seconds to finish a handshake, so a peer that drips one in is
    # cut off while the gate waits. The first Python ssl client on a
    # Windows runner once took longer than three, and once longer than
    # five: its own first certificate check, reading its TLS library from
    # disk. The gate now has Python read that library in before any
    # server here times it (bench/std_tls_exercise.sh says what was
    # measured).
    conn = TlsServer.over(socket, config, 5000)
    if conn.is_a?(TlsError)
      puts "refused: #{conn.message}"
    else
      puts serve_one(conn)
    end
    STDOUT.flush
  end
  exit 0
end

puts "== RFC 8448's simple 1-RTT handshake, through the key schedule"
schedule = TlsKeySchedule.new(false)
hello = b(CLIENT_HELLO) + b(SERVER_HELLO)
check schedule.early_secret == b(EARLY_SECRET), "the early secret"
handshake = schedule.handshake_secret(b(SHARED))
check handshake == b(HANDSHAKE_SECRET), "the handshake secret"
c_hs = schedule.derive_secret(handshake, "c hs traffic", hello)
s_hs = schedule.derive_secret(handshake, "s hs traffic", hello)
check c_hs == b(C_HS), "client_handshake_traffic_secret"
check s_hs == b(S_HS), "server_handshake_traffic_secret"
master = schedule.master_secret(handshake)
check master == b(MASTER), "the master secret"
flight = b(SERVER_FLIGHT)
before_finished = hello + flight[0, flight.size - 36]
check schedule.finished(s_hs, before_finished) == b(SERVER_FINISHED), "the server's Finished"
check flight[flight.size - 32, 32] == b(SERVER_FINISHED), "the trace's Finished is the one computed"
whole = hello + flight
check schedule.finished(c_hs, whole) == b(CLIENT_FINISHED), "the client's Finished"
check schedule.derive_secret(master, "c ap traffic", whole) == b(C_AP), "client_application_traffic_secret_0"
check schedule.derive_secret(master, "s ap traffic", whole) == b(S_AP), "server_application_traffic_secret_0"
check schedule.derive_secret(master, "exp master", whole) == b(EXP_MASTER), "exporter_master_secret"
check schedule.next_secret(b(S_AP)) != b(S_AP), "a KeyUpdate's next secret is another"
puts "  early, handshake and master secrets, both handshake and application traffic secrets, the exporter's, both Finished"

puts "== the trace's records, sealed and opened"
reader = TlsRecordCipher.new(0x1301, schedule, s_hs)
check reader.key_iv == b(S_HS_IV), "the server's handshake iv"
record = b(SERVER_FLIGHT_RECORD)
opened = reader.open(record[0, 5], record[5, record.size - 5])
check !opened.is_a?(TlsError), "the server's flight opens: #{opened.is_a?(TlsError) ? opened.message : ""}"
if opened.is_a?(Tuple(UInt8, Array(UInt8)))
  check opened[0] == 22_u8 && opened[1] == flight, "the server's flight is EncryptedExtensions to Finished, as the trace has it"
end
tampered = record.dup
tampered[record.size - 1] = tampered[record.size - 1] ^ 1_u8
check TlsRecordCipher.new(0x1301, schedule, s_hs).open(tampered[0, 5], tampered[5, tampered.size - 5]).is_a?(TlsError), "a record one bit off refused"
writer = TlsRecordCipher.new(0x1301, schedule, c_hs)
sealed = writer.seal(22_u8, [20_u8, 0_u8, 0_u8, 32_u8] + b(CLIENT_FINISHED))
check sealed == b(CLIENT_FINISHED_RECORD), "the client's Finished sealed as the trace's record"
server_app = TlsRecordCipher.new(0x1301, schedule, b(S_AP))
ticket = b(TICKET_RECORD)
opened = server_app.open(ticket[0, 5], ticket[5, ticket.size - 5])
if opened.is_a?(Tuple(UInt8, Array(UInt8)))
  check opened[0] == 22_u8 && opened[1] == b(TICKET), "the NewSessionTicket opened"
else
  check false, "the NewSessionTicket opened: #{opened.message}"
end
data = b(SERVER_DATA_RECORD)
opened = server_app.open(data[0, 5], data[5, data.size - 5])
if opened.is_a?(Tuple(UInt8, Array(UInt8)))
  check opened[0] == 23_u8 && opened[1] == b(SERVER_DATA), "the server's data opened, second in sequence"
else
  check false, "the server's data opened: #{opened.message}"
end
client_app = TlsRecordCipher.new(0x1301, schedule, b(C_AP))
check client_app.seal(23_u8, b(CLIENT_DATA)) == b(CLIENT_DATA_RECORD), "the client's data sealed as the trace's record"
puts "  the server's flight and data opened, the client's Finished and data sealed byte for byte"

puts "== RFC 8448's resumed handshake, through the key schedule"
# Section 3's handshake ends with a ticket whose nonce is 00 00; section 4
# resumes by it, PSK and X25519 both.
res_master = schedule.derive_secret(master, "res master", whole + [20_u8, 0_u8, 0_u8, 32_u8] + b(CLIENT_FINISHED))
check res_master == b(RES_MASTER), "resumption_master_secret, over the handshake to the client's Finished"
psk = schedule.resumption_psk(res_master, b("0000"))
check psk == b(RESUMPTION_PSK), "the ticket's PSK, from its nonce"
check schedule.early_secret(psk) == b(PSK_EARLY_SECRET), "the early secret, from the PSK"
resumed_hello = b(RESUMED_HELLO)
# The binder is over the ClientHello short of its binders list: two bytes
# of length, one of the binder's, and the binder.
check schedule.binder(psk, resumed_hello[0, resumed_hello.size - 35]) == b(BINDER), "the PSK binder, over the ClientHello to its binders"
check resumed_hello[resumed_hello.size - 32, 32] == b(BINDER), "the trace's binder is the one computed"
psk_handshake = schedule.handshake_secret(b(RESUMED_SHARED), psk)
check psk_handshake == b(PSK_HANDSHAKE_SECRET), "the handshake secret, over the PSK's early secret and the share"
hellos = resumed_hello + b(RESUMED_SERVER_HELLO)
psk_s_hs = schedule.derive_secret(psk_handshake, "s hs traffic", hellos)
check schedule.derive_secret(psk_handshake, "c hs traffic", hellos) == b(PSK_C_HS), "a resumption's client_handshake_traffic_secret"
check psk_s_hs == b(PSK_S_HS), "a resumption's server_handshake_traffic_secret"
psk_master = schedule.master_secret(psk_handshake)
check psk_master == b(PSK_MASTER), "a resumption's master secret"
resumed_flight = b(RESUMED_FLIGHT)
check schedule.finished(psk_s_hs, hellos + resumed_flight[0, resumed_flight.size - 36]) == b(PSK_SERVER_FINISHED), "the resumed server's Finished, after EncryptedExtensions alone"
check resumed_flight[resumed_flight.size - 32, 32] == b(PSK_SERVER_FINISHED), "the trace's resumed Finished is the one computed"
check schedule.derive_secret(psk_master, "c ap traffic", hellos + resumed_flight) == b(PSK_C_AP), "a resumption's client_application_traffic_secret_0"
check schedule.derive_secret(psk_master, "s ap traffic", hellos + resumed_flight) == b(PSK_S_AP), "a resumption's server_application_traffic_secret_0"
record = b(RESUMED_FLIGHT_RECORD)
opened = TlsRecordCipher.new(0x1301, schedule, psk_s_hs).open(record[0, 5], record[5, record.size - 5])
if opened.is_a?(Tuple(UInt8, Array(UInt8)))
  check opened[0] == 22_u8 && opened[1] == resumed_flight, "the resumed server's flight opened"
else
  check false, "the resumed server's flight opened: #{opened.message}"
end
puts "  the resumption master secret, the ticket's PSK, its early secret and binder, the resumed handshake's secrets and Finished"

puts "== RFC 8448's early data, through the key schedule and the records"
early_traffic = schedule.early_traffic(psk, resumed_hello)
check early_traffic == b(EARLY_TRAFFIC), "client_early_traffic_secret, over the ClientHello alone"
early_writer = TlsRecordCipher.new(0x1301, schedule, early_traffic)
check early_writer.seal(23_u8, b("414243444546")) == b(EARLY_DATA_RECORD), "the early data sealed as the trace's record"
check early_writer.seal(22_u8, [5_u8, 0_u8, 0_u8, 0_u8]) == b(EOED_RECORD), "EndOfEarlyData sealed as the trace's record, second under the early keys"
early_reader = TlsRecordCipher.new(0x1301, schedule, early_traffic)
record = b(EARLY_DATA_RECORD)
opened = early_reader.open(record[0, 5], record[5, record.size - 5])
if opened.is_a?(Tuple(UInt8, Array(UInt8)))
  check opened[0] == 23_u8 && opened[1] == b("414243444546"), "the early data opened"
else
  check false, "the early data opened: #{opened.message}"
end
with_ended = hellos + resumed_flight + [5_u8, 0_u8, 0_u8, 0_u8]
psk_c_hs = schedule.derive_secret(psk_handshake, "c hs traffic", hellos)
client_finished = schedule.finished(psk_c_hs, with_ended)
check client_finished == b(PSK_CLIENT_FINISHED), "the client's Finished, over EndOfEarlyData too"
finished_message = [20_u8, 0_u8, 0_u8, 32_u8] + client_finished
check TlsRecordCipher.new(0x1301, schedule, psk_c_hs).seal(22_u8, finished_message) == b(PSK_CLIENT_FINISHED_RECORD), "the client's Finished sealed as the trace's record"
check schedule.derive_secret(psk_master, "res master", with_ended + finished_message) == b(PSK_RES_MASTER), "the resumed handshake's resumption master secret"
puts "  the client's early traffic secret, its data and EndOfEarlyData sealed and opened, the Finished after them"

puts "== the replay guard"
guard = TlsReplayGuard.new(2)
check guard.admit([1_u8], 0_i64), "a binder first seen is taken"
check !guard.admit([1_u8], 5000_i64), "the same binder again is refused"
check guard.admit([2_u8], 5000_i64) && !guard.admit([3_u8], 5000_i64), "past its capacity the guard refuses"
check guard.admit([1_u8], 20001_i64), "a binder is dropped two windows after it came"
check TlsReplayGuard.fresh?(1000_i64, 11000_i64) && !TlsReplayGuard.fresh?(1000_i64, 11001_i64), "fresh within 10 s and not past"
puts "  a binder taken once, a full guard refusing, a binder dropped after two windows, the freshness window"

puts "== tickets: their keys, their lifetimes, and the session that holds them"
# By a clock given, not the machine's: a period of 10 s for each key.
period = 10000_i64
state = TlsTicket.new(0x1301, 0_i64, 30_i64, 7_i64, Array(UInt8).new(32, 1_u8), "localhost", "h2", 1, [[2_u8, 3_u8]], 0_i64)
keys = TlsTicketKeys.new(0_i64)
sealed = keys.seal(state.encode, 0_i64, period)
back = TlsTicket.open(keys, sealed, 9000_i64, period)
check !back.nil? && back.psk == state.psk && back.server_name == "localhost" && back.alpn == "h2" && back.age_add == 7_i64 &&
      back.identity == 1 && back.chain == [[2_u8, 3_u8]] && back.lifetime == 30_i64, "a ticket opens to the session it sealed"
tampered = sealed.dup
tampered[tampered.size - 1] = tampered[tampered.size - 1] ^ 1_u8
check TlsTicket.open(keys, tampered, 9000_i64, period).nil?, "a ticket one bit off does not open"
# The key moves on at 10 s and still opens what it sealed; at 20 s it moves
# again and the first key is gone, though the ticket's 30 s are not over.
check !TlsTicket.open(keys, sealed, 15000_i64, period).nil?, "a ticket opens under the key before the current one"
check TlsTicket.open(keys, sealed, 26000_i64, period).nil?, "a ticket under the key two before does not open"
short = TlsTicket.new(0x1301, 0_i64, 5_i64, 7_i64, Array(UInt8).new(32, 1_u8), nil, nil, 0, [] of Array(UInt8), 0_i64)
keys = TlsTicketKeys.new(0_i64)
sealed = keys.seal(short.encode, 0_i64, period)
check !TlsTicket.open(keys, sealed, 5000_i64, period).nil?, "a ticket opens at the end of its lifetime"
check TlsTicket.open(keys, sealed, 5001_i64, period).nil?, "a ticket past its lifetime by this server's count does not open"
keys = TlsTicketKeys.new(0_i64)
sealed = keys.seal(state.encode, 0_i64, period)
check TlsTicket.open(keys, sealed, 21000_i64, period).nil?, "a key idle past two periods opens nothing"
keys = TlsTicketKeys.new(0_i64)
sealed = keys.seal(state.encode, 0_i64, period)
keys.rotate(1_i64)
check !TlsTicket.open(keys, sealed, 2_i64, period).nil?, "rotated once by hand, a ticket still opens"
keys.rotate(3_i64)
check TlsTicket.open(keys, sealed, 4_i64, period).nil?, "rotated twice by hand, it does not"

# A ticket held, for localhost on *port*, under *under*, received at
# *received_ms* for two hours, its full handshake at *authenticated_ms*.
def held_for(port : Int32, under : TlsMadeUnder, certificates : Array(Certificate) = [] of Certificate,
             authenticated_ms : Int64 = 0_i64, received_ms : Int64 = 0_i64) : TlsHeldTicket
  TlsHeldTicket.new([1_u8], [] of UInt8, 0x1301, received_ms, 7200000_i64, 0_i64, "localhost", port, under, nil, certificates, authenticated_ms)
end

held_under = TlsConfig.new
under = TlsMadeUnder.new(held_under)
session = TlsSession.new
# Tickets 0 to 9, the sixth for other.test: the first two go past the
# limit, and other.test's is not the newest left.
10.times { |i| session.keep(TlsHeldTicket.new([i.to_u8], [] of UInt8, 0x1301, i.to_i64, 1000_i64, 0_i64, i == 5 ? "other.test" : "localhost", 443, under, nil, [] of Certificate, 0_i64)) }
check session.size == TlsSession::MAX_TICKETS, "a session holds #{TlsSession::MAX_TICKETS} tickets, not #{session.size}"
newest = session.take("localhost", 443, held_under, 500_i64)
check !newest.nil? && newest.ticket == [9_u8] && session.size == 7, "the newest ticket for the host is taken out"
other = session.take("other.test", 443, held_under, 500_i64)
check !other.nil? && other.ticket == [5_u8], "a ticket is for the host it came from"
check session.take("other.test", 443, held_under, 500_i64).nil?, "a ticket goes out once"
check session.take("localhost", 443, held_under, 1010_i64).nil? && session.size == 0, "a ticket past its lifetime is not offered, and goes"
# The port it came from, and the configuration it came under: another
# object, or the same with a part that decides trust assigned in place.
session.keep(held_for(443, under))
check session.take("localhost", 8443, held_under, 10_i64).nil?, "a ticket is not offered to another port"
check !session.take("localhost", 443, held_under, 10_i64).nil?, "a ticket is offered to the port it came from"
session.keep(held_for(443, under))
check session.take("localhost", 443, TlsConfig.new, 10_i64).nil?, "a ticket is not offered under another configuration"
# Each starts set, and is replaced by an equal one - roots and an
# identity as new objects, which is all `TlsMadeUnder` tells apart.
binding_root = Certificate.parse(b(BINDING_ROOT)).or_panic
binding_identity = TlsIdentity.from_der([b(BINDING_LEAF), b(BINDING_ROOT)], b(BINDING_SEED)).or_panic
[
  {"roots", ->(c : TlsConfig) { c.roots = [binding_root]; nil }},
  {"identity", ->(c : TlsConfig) { c.identity = TlsIdentity.from_der([b(BINDING_LEAF), b(BINDING_ROOT)], b(BINDING_SEED)).or_panic; nil }},
  {"now", ->(c : TlsConfig) { c.now = Time.utc(2030, 1, 1); nil }},
  {"min_version", ->(c : TlsConfig) { c.min_version = TlsVersion::TLS12; nil }},
  {"require_staple", ->(c : TlsConfig) { c.require_staple = true; nil }},
].each do |part|
  changed = TlsConfig.new
  changed.roots = [binding_root]
  changed.identity = binding_identity
  changed.now = Time.utc(2026, 6, 1)
  bound = TlsSession.new
  bound.keep(held_for(443, TlsMadeUnder.new(changed)))
  check !bound.take("localhost", 443, changed, 10_i64).nil?, "a ticket is offered under the configuration it came under, #{part[0]} unchanged"
  bound.keep(held_for(443, TlsMadeUnder.new(changed)))
  part[1].call(changed)
  check bound.take("localhost", 443, changed, 10_i64).nil?, "a ticket is not offered after #{part[0]} is assigned in place"
end
# The server's certificate valid at the configuration's `now`: the
# binding leaf is good until 2045-01-01.
binding_leaf = Certificate.parse(b(BINDING_LEAF)).or_panic
expiring = TlsConfig.new
expiring.now = Time.utc(2044, 12, 31)
session = TlsSession.new
session.keep(held_for(443, TlsMadeUnder.new(expiring), [binding_leaf]))
check !session.take("localhost", 443, expiring, 10_i64).nil?, "a ticket whose server certificate is valid is offered"
expired = TlsConfig.new
expired.now = Time.utc(2045, 1, 2)
session.keep(held_for(443, TlsMadeUnder.new(expired), [binding_leaf]))
check session.take("localhost", 443, expired, 10_i64).nil? && session.size == 0, "a ticket whose server certificate has expired is not offered, and goes"
# Seven days from the full handshake, whatever lifetime a ticket a
# resumption received was given.
week = 604800000_i64
session.keep(held_for(443, under, authenticated_ms: 1_i64, received_ms: week - 1000_i64))
check !session.take("localhost", 443, held_under, week).nil?, "a ticket short of seven days from its full handshake is offered"
session.keep(held_for(443, under, authenticated_ms: 0_i64, received_ms: week - 1000_i64))
check session.take("localhost", 443, held_under, week).nil?, "a ticket seven days from its full handshake is not offered, though its own lifetime is not over"
# A server's ticket state: a name past 255 bytes and an identity's place
# past 255 come back whole.
wide = TlsTicket.new(0x1301, 0_i64, 30_i64, 7_i64, Array(UInt8).new(32, 1_u8), "a" * 300, nil, 300, [[2_u8, 3_u8]], 0_i64)
keys = TlsTicketKeys.new(0_i64)
opened = TlsTicket.open(keys, keys.seal(wide.encode, 0_i64, period), 1_i64, period)
check !opened.nil? && opened.server_name == "a" * 300, "a ticket's name past 255 bytes comes back whole"
check !opened.nil? && opened.identity == 300, "a ticket's identity past 255 comes back whole"
puts "  a ticket sealed and opened, one bit off, past its lifetime, its key rotated out, its name and identity past a byte;"
puts "  a session's limit, hosts, ports, configurations, expired certificates, seven days and single use"

puts "== TLS 1.2's PRF, through the key schedule"
# The P_SHA256 and P_SHA384 vectors that circulate for TLS 1.2 (Python's
# hmac computes the same): secret, seed and "test label", 100 and 148 bytes.
prf256 = TlsKeySchedule.new(false).prf(b("9bbe436ba940f017b17652849a71db35"), "test label", b("a0ba9f936cda311827a6f796ffd5198c"), 100)
check prf256 == b(PRF_SHA256), "P_SHA256's 100 bytes"
prf384 = TlsKeySchedule.new(true).prf(b("b80b733d6ceefcdc71566ea48e5567df"), "test label", b("cd665cf6a8447dd6ff8b27555edb7465"), 148)
check prf384 == b(PRF_SHA384), "P_SHA384's 148 bytes"
puts "  P_SHA256 and P_SHA384, 100 and 148 bytes"

puts "== server_name's form (RFC 6066 section 3)"
# What the client sends and checks the certificate for; the gate's OpenSSL
# section reads the name off the wire as s_server's `-servername` sees it.
check TlsClient.server_name_for("bücher.example.") == "xn--bcher-kva.example", "a Unicode host with a final dot goes as its A-labels without it"
check TlsClient.server_name_for("Bücher.Example") == "xn--bcher-kva.example", "a Unicode host's ASCII labels go in lower case, as IDNA writes them"
check TlsClient.server_name_for("localhost.") == "localhost", "an ASCII host's final dot is dropped"
check TlsClient.server_name_for("Example.COM") == "Example.COM", "an ASCII host goes as written"
check TlsClient.server_name_for(".").is_a?(TlsError), "a dot alone names no host"
check TlsClient.server_name_for("bücher..example").is_a?(TlsError), "a Unicode host IDNA refuses is an error before anything is sent"
puts "  A-labels, no final dot, ASCII as written, and what names no host refused"

puts "== a session's tickets, between this run's own client and server"

# One connection to *listener* for *host* under *config* through
# *session*, *early* sent with it, met by a `TlsServer` under *served*:
# "client <what it came to>; server <what it came to>". The client writes
# "hi" and reads to the end - the server's tickets with it - and the
# server reads any early data, then "hi", and answers.
def binding_round(listener : IyiSocket, served : TlsServerConfig, host : String, config : TlsConfig, session : TlsSession, early : String? = nil) : String
  port = listener.local_port
  ends = ["", ""]
  group do |g|
    server = g.spawn do
      accepted = listener.accept
      if accepted.is_a?(IyiSocket)
        conn = TlsServer.over(accepted, served, 5000)
        if conn.is_a?(TlsError)
          accepted.close
          conn.message
        else
          heard = ""
          refused = nil.as(String?)
          if conn.early_data?
            while true
              chunk = conn.read_early
              if chunk.is_a?(TlsError)
                refused = chunk.message
                break
              end
              break if chunk.empty?
              heard = heard + chunk
            end
          end
          if why = refused
            accepted.close
            why
          else
            got = conn.read
            conn.write("echo") unless got.is_a?(TlsError)
            conn.close
            "resumed=#{conn.resumed? ? "yes" : "no"} early=#{heard.bytesize}"
          end
        end
      else
        "no connection"
      end
    end
    client = g.spawn do
      socket = IyiSocket.connect("127.0.0.1", port)
      if socket.is_a?(IyiSocket)
        conn = TlsClient.over(socket, host, config, 5000, session, early)
        if conn.is_a?(TlsError)
          socket.close
          conn.message
        else
          conn.write("hi")
          drain(conn)
          # Its close_notify ends the server's close: without it the server
          # waited out `DRAIN_GAP_MS` and each round here took 1005-1008 ms.
          conn.close
          "resumed=#{conn.resumed? ? "yes" : "no"} early=#{conn.early_data}"
        end
      else
        "no connection"
      end
    end
    said = client.value
    ends[0] = said.is_a?(String) ? said : "PANIC: #{said.message}"
    heard = server.value
    ends[1] = heard.is_a?(String) ? heard : "PANIC: #{heard.message}"
    0
  end
  "client #{ends[0]}; server #{ends[1]}"
end

# The client's configuration: the binding root, at a time its leaf is good.
def binding_config : TlsConfig
  config = TlsConfig.new
  config.roots = [Certificate.parse(b(BINDING_ROOT)).or_panic]
  config.now = Time.utc(2026, 6, 1)
  config
end

def now_ms : Int64
  Time.monotonic_nanoseconds.to_i64 // 1000000_i64
end

# The newest ticket *session* holds for fuzz.test on *port* under
# *config*, taken out.
def newest_held(session : TlsSession, port : Int32, config : TlsConfig) : TlsHeldTicket
  held = session.take("fuzz.test", port, config, now_ms)
  raise "ASSERTION FAILED: no ticket held for port #{port}" unless held
  held
end

FULL    = "client resumed=no early=Unused; server resumed=no early=0"
RESUMED = "client resumed=yes early=Unused; server resumed=yes early=0"
served = TlsServerConfig.from_der([b(BINDING_LEAF), b(BINDING_ROOT)], b(BINDING_SEED)).or_panic
first_listener = IyiSocket.listen("127.0.0.1", 0)
second_listener = IyiSocket.listen("127.0.0.1", 0)
trusting = binding_config
session = TlsSession.new
check binding_round(first_listener, served, "fuzz.test", trusting, session) == FULL, "the first connection is a full handshake"
# Both servers open the same tickets: a ticket offered to the second port
# was taken there.
check binding_round(second_listener, served, "fuzz.test", trusting, session) == FULL, "a ticket from one port is not offered to another"
check binding_round(first_listener, served, "fuzz.test", trusting, session) == RESUMED, "a ticket is offered to the port it came from"
check binding_round(first_listener, served, "fuzz.test", binding_config, session) == FULL, "a ticket from one configuration is not offered under another"
# A resumed connection's tickets keep the time of the full handshake it
# resumed: the newest held after it is one of them.
chained = TlsSession.new
binding_round(first_listener, served, "fuzz.test", trusting, chained)
first_ticket = newest_held(chained, first_listener.local_port, trusting)
chained.keep(first_ticket)
sleep(20)
check binding_round(first_listener, served, "fuzz.test", trusting, chained) == RESUMED, "a ticket kept by hand resumes"
renewed = newest_held(chained, first_listener.local_port, trusting)
check renewed.received_ms > first_ticket.received_ms && renewed.authenticated_ms == first_ticket.authenticated_ms,
  "a ticket a resumed connection receives keeps its full handshake's time"
# Early data on a ticket issued under 16 KiB: taken while the server's
# limit is unchanged; once it has come down to 100 bytes, declined - the
# client sends it again after the handshake - rather than taken and cut
# off past the 100.
eager = TlsServerConfig.from_der([b(BINDING_LEAF), b(BINDING_ROOT)], b(BINDING_SEED)).or_panic
eager.max_early_data = 16384
early_session = TlsSession.new
check binding_round(first_listener, eager, "fuzz.test", trusting, early_session) == FULL, "the first connection to a server taking early data"
check binding_round(first_listener, eager, "fuzz.test", trusting, early_session, "x" * 1000) == "client resumed=yes early=Accepted; server resumed=yes early=1000",
  "early data within an unchanged limit is taken"
eager.max_early_data = 100
check binding_round(first_listener, eager, "fuzz.test", trusting, early_session, "x" * 1000) == "client resumed=yes early=Resent; server resumed=yes early=0",
  "early data a ticket allows past a lowered limit is declined, and sent again"
# A server_name of 254 bytes is refused before anything is sealed with it;
# one of 253 is taken, and the client then refuses the certificate.
long_name = "a" * 63 + "." + "b" * 63 + "." + "c" * 63 + "." + "d" * 62
said_long = binding_round(first_listener, served, long_name, trusting, TlsSession.new)
check said_long.includes?("server tls: a server_name of 254 bytes, past the 253 a host name has (decode_error)"), "a server_name past 253 bytes is refused"
said_most = binding_round(first_listener, served, long_name[0, 253], trusting, TlsSession.new)
check said_most.ends_with?("server tls: the client sent alert bad_certificate (42)"), "a server_name of 253 bytes is taken"
first_listener.close
second_listener.close
puts "  tickets held to their port and configuration, a resumption's to its full handshake's time, early data past a"
puts "  lowered limit declined, and a server_name past 253 bytes refused"

puts "\nALL CHECKS PASSED"
