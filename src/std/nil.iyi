class ::NilAssertionError
  getter message : String

  def initialize(@message : String = "Nil assertion failed")
  end
end

def raise(error : ::NilAssertionError) : NoReturn
  raise error.message
end

struct ::Nil
  # Returns 0_u64.
  def object_id : UInt64
    0_u64
  end

  # Returns true: Nil has only one singleton value: nil.
  def same?(other : ::Nil) : ::Bool
    true
  end

  # Returns false.
  def same?(other : Reference) : ::Bool
    false
  end

  def hash : Int32
    0
  end

  # Doesn't write anything to the given IO.
  def to_s(io : IyiIO) : ::Nil
  end

  # Writes "nil" to the given IO.
  def inspect(io : IyiIO) : ::Nil
    io.print("nil")
  end

  # Doesn't yield to the block.
  def try(&)
    self
  end

  # Raises NilAssertionError.
  def not_nil(message : String? = nil) : NoReturn
    msg = message
    raise msg.nil? ? "Nil assertion failed" : msg
  end

  # Returns self.
  def presence : ::Nil
    self
  end

  def clone : ::Nil
    self
  end
end
