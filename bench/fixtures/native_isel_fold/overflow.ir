; iyi-ir 1
module "overflow"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @sadd64(i64 %a, i64 %b) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i64(i64 %a, i64 %b)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  %hint = intrinsic llvm.expect.i1(i1 %flag, i1 false)
  br i1 %hint, label %overflow, label %ok
overflow:
  ret i64 -111
ok:
  ret i64 %value
}

define internal i64 @ssub64(i64 %a, i64 %b) {
entry:
  %pair = intrinsic llvm.ssub.with.overflow.i64(i64 %a, i64 %b)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -112
ok:
  ret i64 %value
}

define internal i64 @uadd64(i64 %a, i64 %b) {
entry:
  %pair = intrinsic llvm.uadd.with.overflow.i64(i64 %a, i64 %b)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -113
ok:
  ret i64 %value
}

define internal i64 @usub64(i64 %a, i64 %b) {
entry:
  %pair = intrinsic llvm.usub.with.overflow.i64(i64 %a, i64 %b)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -114
ok:
  ret i64 %value
}

define internal i64 @smul64(i64 %a, i64 %b) {
entry:
  %pair = intrinsic llvm.smul.with.overflow.i64(i64 %a, i64 %b)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -115
ok:
  ret i64 %value
