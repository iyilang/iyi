  # bits of 1/c, of log(c) rounded to 2^-43, and of the rest of log(c).
  private POW_LOG_TAB = [
    0x3ff6a00000000000_u64, 0xbfd62c82f2b9c800_u64, 0x3cfab42428375680_u64,
    0x3ff6800000000000_u64, 0xbfd5d1bdbf580800_u64, 0xbd1ca508d8e0f720_u64,
