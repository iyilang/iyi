# Exercises `std/option_parser`.
#
# Run via:
#     ./bin/iyi run bench/std_option_parser_exercise.iyi

module bench/std_option_parser_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/option_parser::{OptionParser}

puts "== flags"
op = OptionParser.new
name = ""
verbose = false
op.on("--name VALUE", "the name") { |v| name = v }
op.on("-v", "verbose") { |v| verbose = true }
rest = op.parse(["--name", "ada", "-v", "x"])
assert_str "ada", name, "long value"
assert_true verbose, "short flag"
assert_str "x", rest[0], "operand"
assert_true op.help.includes?("--name VALUE"), "help lists it"
puts "  long, short, leftover"

puts "\n== what the person typed wrong"
handled = OptionParser.new
seen = [] of String
port = ""
handled.on("--port PORT", "the port") { |v| port = v }
handled.on("-q", "quiet") { |v| seen << "quiet" }
handled.invalid_option { |flag| seen << "invalid " + flag }
handled.missing_option { |flag| seen << "missing " + flag }
left = handled.parse(["--nope", "-z", "-q=1", "--port=8080", "keep", "-q", "--port"])
assert_str "8080", port, "a good flag after bad ones is still read"
assert_str "invalid --nope,invalid -z,quiet,quiet,missing --port", seen.join(","), "each mistake reaches its handler, in order"
assert_str "keep", left.join(","), "operands survive"
bare = OptionParser.new
bare.on("--flag", "a switch") { |v| }
bare.invalid_option { |flag| seen << "no value for " + flag }
bare.parse(["--flag=x"])
assert_str "no value for --flag", seen.last, "a value for a switch is an invalid option"
puts "  invalid_option and missing_option answer instead of a panic"

puts "\nALL CHECKS PASSED"
