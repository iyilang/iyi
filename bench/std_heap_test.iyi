# Tests `std/heap`.
#
# Run via:
#     ./bin/iyi test bench/std_heap_test.iyi

module bench/std_heap_test

import std/heap::{Heap}

test "min-heap pop order" do
  h = Heap(Int32).new
  h.push(3)
  h.push(1)
  h.push(2)
  assert_eq 3, h.size, "size"
  assert_eq 1, h.peek, "peek min"
  assert_eq 1, h.pop, "pop 1"
  assert_eq 2, h.pop, "pop 2"
  assert_eq 3, h.pop, "pop 3"
  assert_eq true, h.empty?, "empty after"
end
