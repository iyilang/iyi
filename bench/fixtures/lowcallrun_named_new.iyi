lib LibC
  fun putchar(value : Int32) : Int32
  fun exit(status : Int32) : NoReturn
end

def mark(value : Int32) : Int32
  LibC.putchar(value)
  value
end

class Point
  def initialize(@x : Int32, @y : Int32 = 9)
  end

  def code : Int32
    @x &* 10 &+ @y
  end
end

LibC.exit(Point.new(y: mark(50), x: mark(49)).code &+ Point.new(x: mark(51)).code)
