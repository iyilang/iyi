# INI configuration text: `[section]` headers, `key = value` lines,
# comments opened by `#` or `;`, and keys before the first header filed
# under the section named `""`.
#
# `INI.parse` reads a String or an IO into `Hash(String, Hash(String, String))`
# and panics with a located sentence for what it refuses: a `[` with no
# `]` (`unterminated section at line 3, column 6`), anything after the
# `]` including a trailing space (`data after section at line 3, column 7`),
# and a line that is neither header, comment nor assignment (`expected
# declaration at line 4, column 4`). The column counts characters, so a
# section named `[café]` is a section and not an error. A line of nothing
# but whitespace is skipped like an empty one. Repeating a header
# continues the earlier section; a value keeps every `=` after its first.
#
# `INI.build(ini, space)` and `INI.build(io, ini, space)` write the same
# text: top-level keys first, then each section as `[name]`, its keys and
# one blank line. `space` chooses `key = value` over `key=value` and is
# false unless asked, so `parse(build(x))` and `build(parse(text))` round
# trip for text written the compact way. What `parse` would read back as
# something else is refused rather than written: a line break in a name
# or a value, a `]` in a section's name, a key that is empty, holds `=`
# or opens with `#`, `;`, `[` or U+FEFF (read as a byte order mark), and
# blanks at either end of a key or a value. INI has no escapes, so the
# one honest answer is the panic. The IO form takes the IO first, the
# way `io.write` reads, and calls only `write`.

module std/ini

pub struct INI
  # Past a byte order mark, which Windows PowerShell 5.1's `Set-Content
  # -Encoding UTF8` and older Notepad write: it panicked "expected
  # declaration at line 1, column 8" at a `[section]` behind one, and the
  # first key of a file without a section kept it and never matched.
  def self.parse(string : String) : Hash(String, Hash(String, String))
    parse_lines(string.lchop('\uFEFF').lines)
  end

  def self.parse(io : IO) : Hash(String, Hash(String, String))
    parse(io.read_all)
  end

  private def self.parse_lines(lines : Array(String)) : Hash(String, Hash(String, String))
    ini = Hash(String, Hash(String, String)).new
    current_section = Hash(String, String).new
    ini[""] = current_section
    lineno = 0

    lines.each do |line|
      lineno += 1
      raw = line.to_unsafe
      len = line.bytesize
      len -= 1 if len > 0 && raw[len - 1] == 13_u8 # a CRLF file's '\r'

      # Leading whitespace is ASCII whitespace, as the other library skips
      # it: only space and tab were, so `\v[s]` was refused as a key with no
      # `=` and a line of just `\f` was not the blank line it is.
      offset = 0
      while offset < len && (raw[offset] == 32_u8 || (raw[offset] >= 9_u8 && raw[offset] <= 13_u8))
        offset += 1
      end
      next if offset >= len

      first_byte = raw[offset]
      next if first_byte == 35_u8 || first_byte == 59_u8 # '#' or ';'

      if first_byte == 91_u8 # '['
        end_idx = -1
        i = offset + 1
        while i < len
          if raw[i] == 93_u8 # ']'
            end_idx = i
            break
          end
          i += 1
        end

        raise "unterminated section at line #{lineno}, column #{column(line, len)}" if end_idx < 0
        raise "data after section at line #{lineno}, column #{column(line, end_idx + 1)}" unless end_idx == len - 1

        name = line[offset + 1, end_idx - offset - 1]
        if existing = ini[name]?
          current_section = existing
        else
          current_section = Hash(String, String).new
          ini[name] = current_section
        end
      else
        eq_idx = -1
        i = offset
        while i < len
          if raw[i] == 61_u8 # '='
            eq_idx = i
            break
          end
          i += 1
        end

        raise "expected declaration at line #{lineno}, column #{column(line, len)}" if eq_idx < 0

        key = line[offset, eq_idx - offset].strip
        value = line[eq_idx + 1, len - eq_idx - 1].strip
        current_section[key] = value
      end
    end

    if top = ini[""]?
      ini.delete("") if top.empty?
    end
    ini
  end

  # The 1-based character column of byte *index* in *line*: every byte
  # that is not a UTF-8 continuation byte begins a character.
  private def self.column(line : String, index : Int32) : Int32
    raw = line.to_unsafe
    count = 0
    i = 0
    while i < index
      count += 1 if (raw[i] & 0xC0_u8) != 0x80_u8
      i += 1
    end
    count + 1
  end

  def self.build(ini : Hash(String, Hash(String, String)), space : Bool = false) : String
    parts = [] of String
    delim = space ? " = " : "="
    # Written verbatim, a value holding a line break wrote lines of its
    # own: `"hello\r\n[admin]\r\nrole=root"` read back as a section
    # `admin` with a key `role`, and a padded value came back unpadded.
    ini.each do |section, properties|
      if why = unwritable_section(section)
        raise "INI.build: section #{section.inspect} cannot be written: #{why}"
      end
      properties.each do |key, value|
        if why = unwritable_key(key)
          raise "INI.build: key #{key.inspect} in section #{section.inspect} cannot be written: #{why}"
        end
        if why = unwritable_value(value)
          raise "INI.build: the value of #{key.inspect} in section #{section.inspect} cannot be written: #{why}"
        end
      end
    end

    if top = ini[""]?
      top.each do |key, value|
        parts << key
        parts << delim
        parts << value
        parts << "\n"
      end
    end

    ini.each do |section, properties|
      next if section.empty?
      parts << "["
      parts << section
      parts << "]\n"
      properties.each do |key, value|
        parts << key
        parts << delim
        parts << value
        parts << "\n"
      end
      parts << "\n"
    end
    parts.join("")
  end

  def self.build(io : IO, ini : Hash(String, Hash(String, String)), space : Bool = false) : Nil
    io.write(build(ini, space))
  end

  private def self.unwritable_section(name : String) : String?
    return "it holds a line break" if line_break?(name)
    return "it holds `]`" if name.includes?("]")
    nil
  end

  # `parse` reads past a U+FEFF at the front of the text as a byte order
  # mark, so a top-level key opening with one, written first, came back
  # without it: `{"" => {"\uFEFFkey" => "v"}}` read back as `key`. Which
  # key is first is the hash's order, so it is refused wherever it is.
  private def self.unwritable_key(key : String) : String?
    return "it is empty" if key.empty?
    return "it holds a line break" if line_break?(key)
    return "it holds `=`" if key.includes?("=")
    return "it opens with #{key[0].inspect}, which starts a comment or a section" if key.starts_with?("#") || key.starts_with?(";") || key.starts_with?("[")
    return "it opens with U+FEFF, which is read as a byte order mark" if key.starts_with?('\uFEFF')
    return "blanks at either end are not read back" if key != key.strip
    nil
  end

  private def self.unwritable_value(value : String) : String?
    return "it holds a line break" if line_break?(value)
    return "blanks at either end are not read back" if value != value.strip
    nil
  end

  private def self.line_break?(text : String) : Bool
    text.includes?("\n") || text.includes?("\r")
  end
end
