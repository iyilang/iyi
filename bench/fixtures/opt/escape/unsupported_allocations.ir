; iyi-ir 1
source_filename = "escape_unsupported_allocations"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
; Both calls ask for an atomic object, which needs no layout hint, so only the bound each one breaks keeps it on the heap.
define internal void @zero_size() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 0, i64 1, i64 2)
  ret void
}
define internal i64 @unknown_flag() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 1, i64 6)
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
