; iyi-ir 1
source_filename = "variable_gep_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external void @variable_gep_keep(ptr %p, i64 %index, ptr %out) {
entry:
  %a = getelementptr [8 x i64], ptr %p, i64 0, i64 %index
  store ptr %a, ptr %out, align 8
  store ptr %a, ptr %out, align 8
  ret void
}
