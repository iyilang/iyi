; iyi-ir 1
source_filename = "integer_param"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @integer_param(i1 %run, i64 %bits, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %offset = add i64 %bits, 8
  %part = lshr i64 %bits, 8
  %low_bit = trunc i64 %bits to i1
  %same = icmp eq i64 %bits, 0
  store i64 %offset, ptr %out, align 8
  store i64 %part, ptr %out, align 8
  store i1 %low_bit, ptr %out, align 1
  store i1 %same, ptr %out, align 1
  br label %head
done:
  ret void
}
