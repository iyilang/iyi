# iyi's prelude — SPEC.md, "0.1.0", item 3.
#
#   ./bin/crystal build --prelude=iyi/prelude program.iyi
#
# Not a standard library. The prelude an iyi program gets is deliberately the
# smallest thing that runs the samples, because while an iyi program requires
# Crystal's 107,719-line prelude the benchmark measures a workaround rather
# than the thesis: the front end spends 886 ms of its 901 ms analysing it, and
# `.iyimod` saves 15 ms of the remainder (SPEC.md IV.1f).
#
# **What is in here is decided by what a sample calls.** A method enters
# because an existing program needs it, never because it belongs in a standard
# library. The ceiling is 3,734 lines — Crystal's own 0.1.0 core with its concurrency,
# measured in the same language family and for the same purpose.
#
# `primitives.iyi` under it is the list of machine operations iyi admits —
# arithmetic, conversions, comparisons and `Pointer`. It is iyi's own rather
# than Crystal's, and the reason is measured there.
require "./primitives"

require "./macros"
require "./object"
require "./number"
require "./float"
require "./string"
require "./array"
# `Enum` after `array` and `string`, which are what its `values`, `names` and
# `to_s` answer with. The type itself is predefined — every `enum` a program
# writes inherits it — so this file is the surface rather than the type.
require "./enum"
require "./range"
require "./hash"
require "./set"
# `Atomic(T)`, on every target: LLVM's instructions lower to plain loads
# and stores where a target has one thread (wasm32), so no gate here.
require "./atomic"

# iyi: the concurrency runtime — a cooperative scheduler, cancellable
# blocking primitives, `group`/`spawn` and `Channel`, in III.4.8's order.
# Required here rather than gated inside itself, because iyi-only syntax
# (`!`, `defer`, `impl`) does not survive a macro expansion's re-parse;
# platforms that cannot carry the model are given nothing, not a
# sequential imitation (III.4.8). darwin rides the aarch64 arm through
# libSystem — its branch below says why — and Linux keeps raw syscalls.
{% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
  require "./concurrency"
  # Kernel threads and the stop-the-world over them (GC_DESIGN.md Stage 4).
  require "./thread"
{% elsif flag?(:win32) %}
  # Windows on anything but x86-64. The runtime's Windows arm is x86-64
  # throughout — the fiber switch is Win64 assembly, the stack bounds and
  # the TEB are read through `gs`, and `GetThreadContext` is unpacked at
  # x86-64's CONTEXT offsets — so an arm64 Windows build used to compile
  # with no scheduler and no threads and then die at its first collection
  # in `discover_stack_base`. It is refused here instead, by name, and the
  # x86-64 build runs on those machines under emulation.
  {% raise "iyi's runtime on Windows is x86-64 only: the fiber switch, the stack bounds and the thread context are x86-64's. Build for x86_64-windows-msvc; an arm64 Windows machine runs that build under emulation (SPEC.md III.4.8)" %}
{% elsif flag?(:wasm32) %}
  # wasm32-wasi has no concurrency runtime (SPEC.md III.4): no
  # stack-switching instruction, no wasi-threads, asyncify needs a host
  # loop. The compile error names the refusal.
  macro group(*args, **kwargs)
    \{% raise "group is not available on wasm32-wasi: WebAssembly cannot switch stacks, wasmtime 48 disables the stack-switching proposal, wasi-threads is unsupported, and asyncify cannot run without a host event loop (SPEC.md III.4)" %}
  end

  # `sleep` parks a task on the scheduler, so it is the runtime's too.
  macro sleep(*args, **kwargs)
    \{% raise "sleep is not available on wasm32-wasi: it parks a task on the scheduler, and wasm32-wasi has no runtime to park it on (SPEC.md III.4)" %}
  end
{% end %}

# The runtime's one lock: what the allocator's centre, the scheduler's
# registries and the thread list are behind, and what a collection takes
# before it stops anything, so no stopped thread can be holding it. A spin
# on one `compare_and_set` — uncontended it is one instruction, and one
# thread never contends. A spinner holds nothing, so where threads exist
# the spin is also where a thread asked to stop for a collection parks.
class IyiRuntimeLock
  @@word : UInt64 = 0_u64

  def self.word : Pointer(Atomic(UInt64))
    Pointer(Atomic(UInt64)).new(pointerof(@@word).address)
  end

  def self.lock : Nil
    word = self.word
    # Read before the CAS: a failed CAS still takes the line for writing,
    # and fifteen helpers spinning on one while a collection held it
    # slowed the holder; a read spins on a shared line.
    while word.value.get != 0_u64 || !word.value.compare_and_set(0_u64, 1_u64)[1]
      {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
        IyiThread.park_if_requested
      {% end %}
      {% if flag?(:x86_64) %}
        asm("pause" :::: "volatile")
      {% elsif flag?(:aarch64) %}
        asm("yield" :::: "volatile")
      {% end %}
    end
  end

  # One try, no wait and no park: for a walk that must not park where it
  # stands and has somewhere else to be.
  def self.try_lock : Bool
    word = self.word
    word.value.get == 0_u64 && word.value.compare_and_set(0_u64, 1_u64)[1]
  end

  def self.unlock : Nil
    word.value.set(0_u64)
  end
end

{% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
  # iyi: On Linux, libc is not bound at all. The dependency floor (SPEC.md
  # III.9) named seven undefined symbols in a default program and five of them
  # were libc's; the kernel's syscall ABI is a stable contract, so `write` and
  # `exit` are one `syscall` instruction each rather than a PLT hop. Same move
  # Go makes with CGO_ENABLED=0. The numbers and register conventions are the
  # ones `src/syscall/x86_64-linux.cr` and `src/syscall/aarch64-linux.cr`
  # carry for the compiler's own runtime, written out here rather than
  # required because the prelude is iyi's own world ("0.1.0", item 3) and
  # requiring compiler source into a program would be a dependency of exactly
  # the kind this removes.
  #
  # `exit_group` rather than `exit`: the kernel's `exit` retires one thread,
  # `exit_group` retires the process. 0.1.0 has one thread, so the difference
  # is unobservable, and exit_group is what a program that grows threads
  # wants its panic path to mean.
  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(1_i64), "{rdi}"(fd.to_i64), "{rsi}"(buffer), "{rdx}"(count)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(64_i64), "{x0}"(fd.to_i64), "{x1}"(buffer), "{x2}"(count)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # `read`, for `read_input` below: 0 on x86_64, 63 on aarch64. Binding
  # libc's for one call would put the whole library back on the link line.
  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(0_i64), "{rdi}"(fd.to_i64), "{rsi}"(buffer), "{rdx}"(count)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(63_i64), "{x0}"(fd.to_i64), "{x1}"(buffer), "{x2}"(count)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # `openat`/`close` for `File`. Syscall 257/3 on x86_64, 56/57 on aarch64.
  # `AT_FDCWD` (-100) so a relative path does not need a directory fd.
  # The fourth syscall argument on x86_64 is `r10`, not `rcx`.
  def __iyi_open_read(path : UInt8*) : Int64
    __iyi_openat(path, 0, 0)
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # O_WRONLY|O_CREAT|O_TRUNC = 1|64|512, mode 0644.
    __iyi_openat(path, 577, 420)
  end

  def __iyi_openat(path : UInt8*, flags : Int32, mode : Int32) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(257_i64), "{rdi}"(-100_i64), "{rsi}"(path),
                      "{rdx}"(flags.to_i64), "{r10}"(mode.to_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(56_i64), "{x0}"(-100_i64), "{x1}"(path),
                     "{x2}"(flags.to_i64), "{x3}"(mode.to_i64)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # The kernel writes its answer into the number register; an asm with no
  # output let LLVM keep "3" there, and a second close in a row became `read`.
  def __iyi_close(fd : Int64) : Nil
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result) : "{rax}"(3_i64), "{rdi}"(fd) : "rcx", "r11", "memory" : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result) : "{x8}"(57_i64), "{x0}"(fd) : "memory" : "volatile")
    {% end %}
  end

  # `unlinkat`, with AT_FDCWD and no flags: 263 on x86_64, 35 on aarch64.
  def __iyi_unlink(path : UInt8*) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(263_i64), "{rdi}"(-100_i64), "{rsi}"(path), "{rdx}"(0_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(35_i64), "{x0}"(-100_i64), "{x1}"(path), "{x2}"(0_i64)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_read(fd.to_i32, buffer, count)
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_write(fd.to_i32, buffer, count)
  end
  def __iyi_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_write(fd.to_i32, buffer, count)
  end

  def __iyi_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_read(fd.to_i32, buffer, count)
  end

  # Whether a descriptor is a terminal. There is no `isatty` syscall: the
  # question is asked by making a terminal-only `ioctl` and seeing whether
  # the kernel refuses it, which is what libc's `isatty` does too (TCGETS,
  # 0x5401; `ioctl` is 16 on x86_64 and 29 on aarch64). The buffer is a
  # `termios` the answer is written into and nothing reads: 60 bytes is
  # larger than the struct on both architectures.
  def __iyi_isatty(fd : Int32) : Bool
    termios = uninitialized UInt8[60]
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(16_i64), "{rdi}"(fd.to_i64), "{rsi}"(0x5401_i64),
                      "{rdx}"(pointerof(termios).as(Void*))
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(29_i64), "{x0}"(fd.to_i64), "{x1}"(0x5401_i64),
                     "{x2}"(pointerof(termios).as(Void*))
                   : "memory"
                   : "volatile")
    {% end %}
    result >= 0_i64
  end

  # The process's own working directory, for `Program.cwd`: `getcwd` is
  # 79 on x86_64 and 17 on aarch64, and answers the length it wrote with
  # the terminator in it, or a negative errno. The length this returns
  # does not count the terminator, which is what a String wants.
  def __iyi_getcwd(buffer : UInt8*, size : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(79_i64), "{rdi}"(buffer), "{rsi}"(size)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(17_i64), "{x0}"(buffer), "{x1}"(size)
                   : "memory"
                   : "volatile")
    {% end %}
    result <= 0_i64 ? -1_i64 : result - 1_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    {% if flag?(:x86_64) %}
      asm("syscall" :: "{rax}"(231_i64), "{rdi}"(status.to_i64) : "rcx", "r11", "memory" : "volatile")
    {% else %}
      asm("svc #0" :: "{x8}"(94_i64), "{x0}"(status.to_i64) : "memory" : "volatile")
    {% end %}
    while true
    end
  end
{% elsif flag?(:darwin) %}
  # iyi: macOS is not a fallback that happened to work; it is a chosen branch because it is the development workstation machine.
  # Apple documents libSystem as the only supported interface and raw syscalls as explicitly not a stable ABI on Darwin.
  # Binding write, exit, backtrace and backtrace_symbols_fd here is Apple's platform rule rather than a compromise settled for.
  # libSystem ships with macOS, it is not something a person installs, and Go links it on darwin for the exact same reason.
  lib LibC
    fun write(fd : Int32, buf : Void*, count : UInt64) : Int64
    fun read(fd : Int32, buf : Void*, count : UInt64) : Int64
    fun open(path : UInt8*, oflag : Int32, ...) : Int32
    fun chmod(path : UInt8*, mode : Int32) : Int32
    fun close(fd : Int32) : Int32
    fun unlink(path : UInt8*) : Int32
    fun exit(status : Int32) : NoReturn
    fun backtrace(buffer : Void**, size : Int32) : Int32
    fun backtrace_symbols_fd(buffer : Void**, size : Int32, fd : Int32) : Void
    # `std/colorize` asks whether standard output is a terminal before it
    # writes an escape. Apple's answer is libSystem's, the same as every
    # other call in this block; the Linux arm above makes the `ioctl` by
    # hand because there is no libc there to ask.
    fun isatty(fd : Int32) : Int32
    # The process's own working directory, for `Program.cwd`. Apple's
    # `getcwd` fills the buffer and answers it, or null when the
    # directory does not fit or has been removed.
    fun getcwd(buf : UInt8*, size : UInt64) : UInt8*
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd, buffer, count)
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd, buffer, count)
  end

  def __iyi_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd.to_i32, buffer, count)
  end

  def __iyi_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd.to_i32, buffer, count)
  end

  def __iyi_isatty(fd : Int32) : Bool
    LibC.isatty(fd) != 0
  end

  def __iyi_getcwd(buffer : UInt8*, size : UInt64) : Int64
    return -1_i64 if LibC.getcwd(buffer, size).address == 0_u64
    length = 0
    while buffer[length] != 0_u8
      length = length + 1
    end
    length.to_i64
  end

  def __iyi_open_read(path : UInt8*) : Int64
    LibC.open(path, 0).to_i64
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # O_WRONLY|O_CREAT|O_TRUNC = 1|0x0200|0x0400. `open` is variadic for the
    # mode, and `chmod` sets 0644 afterwards because a missing mode on create
    # has produced an unreadable file (execute-only) on this machine.
    fd = LibC.open(path, 1537, 420).to_i64
    LibC.chmod(path, 420) if fd >= 0
    fd
  end

  def __iyi_close(fd : Int64) : Nil
    LibC.close(fd.to_i32)
  end

  def __iyi_unlink(path : UInt8*) : Int64
    LibC.unlink(path).to_i64
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd.to_i32, buffer, count)
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd.to_i32, buffer, count)
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibC.exit(status)
  end
{% elsif flag?(:win32) %}
  # iyi: On Windows the platform's own interface is the Win32 API in
  # kernel32, which ships with the machine; Go links kernel32 for the same
  # set of operations. There is no libc `write` to fall back to: the C
  # runtime's POSIX shims are a person-installed choice of CRT, not the
  # platform's contract, so stdout is `WriteFile` on the standard handle and
  # exit is `ExitProcess`. The names and signatures are the ones
  # `src/lib_c/x86_64-windows-msvc/c/` carries for the compiler's own
  # runtime, declared locally rather than required for the same reason as the
  # Linux syscalls above: the prelude is iyi's own world.
  # iyi primitives carry arithmetic on Int32/Int64/UInt8/UInt64 only, so the
  # DWORD-width parameters are declared Int32: same 32 bits at the ABI, and
  # no UInt32 value ever exists in this file to convert.
  #
  # The link is named here because an object LLVM emits carries no
  # `/DEFAULTLIB` directives, which an MSVC-compiled one would: without this,
  # `--cross-compile` prints a command that cannot link what it just produced,
  # and every one of these six functions comes back as an unresolved external.
  #
  # `msvcrt`, `ucrt` and `vcruntime` are the *dynamic* CRT, and they are here
  # for one symbol: this program's entry point is `main`, so something has to
  # supply `mainCRTStartup` to call it. The static CRT (`libcmt`) links just as
  # cleanly and the binary then exits `0xC0000005` before `main` runs, which is
  # why the choice is written down rather than left to whoever links. Emitting
  # an entry point of iyi's own would remove all three, and would be the honest
  # form of "kernel32 and nothing else".
  @[Link("kernel32")]
  @[Link(ldflags: "msvcrt.lib ucrt.lib vcruntime.lib")]
  lib LibC
    fun GetStdHandle(n_std_handle : Int32) : Void*
    fun WriteFile(handle : Void*, buffer : Void*, number_of_bytes_to_write : Int32,
                  number_of_bytes_written : Int32*, overlapped : Void*) : Int32
    fun ReadFile(handle : Void*, buffer : Void*, number_of_bytes_to_read : Int32,
                 number_of_bytes_read : Int32*, overlapped : Void*) : Int32
    fun CreateFileW(name : UInt16*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
    fun DeleteFileW(name : UInt16*) : Int32
    fun GetFileAttributesW(name : UInt16*) : Int32
    fun MultiByteToWideChar(code_page : Int32, flags : Int32, bytes : UInt8*,
                            byte_count : Int32, wide : UInt16*, wide_count : Int32) : Int32
    fun WideCharToMultiByte(code_page : Int32, flags : Int32, wide : UInt16*,
                            wide_count : Int32, bytes : UInt8*, byte_count : Int32,
                            default_char : UInt8*, used_default : Int32*) : Int32
    fun GetFullPathNameW(name : UInt16*, buffer_count : Int32, buffer : UInt16*,
                         file_part : UInt16**) : Int32
    # The process's own working directory, in UTF-16. `Path#expand` asked
    # `PWD` for it and Windows' shells do not set that variable: measured
    # from cmd, expanding a relative name panicked with "no base given and
    # PWD is not set", and every program that expands a path it was handed
    # went down with it.
    fun GetCurrentDirectoryW(buffer_count : Int32, buffer : UInt16*) : Int32
    fun CloseHandle(handle : Void*) : Int32
    fun ExitProcess(exit_code : Int32) : NoReturn
  end

  # The rest of the kernel32 surface this runtime names: virtual memory,
  # threads and their contexts, the performance counter, and the I/O
  # completion port. It sits here, beside the floor, rather than inside the
  # collector's arm below, because the scheduler and the threads are chosen
  # by the target (`concurrency.iyi`, required at the top of this file) and
  # not by which allocator a build asked for. Declared there, a
  # `-Dgc_none` or `-Dgc_boehm` build on Windows got as far as codegen and
  # stopped at `undefined fun 'CancelIoEx' for LibC`, since the fiber that
  # cancels an IO exists in every build.
  lib LibC
    fun VirtualAlloc(lpAddress : Void*, dwSize : UInt64, flAllocationType : Int32, flProtect : Int32) : Void*
    fun VirtualFree(lpAddress : Void*, dwSize : UInt64, dwFreeType : Int32) : Int32
    # A page's protection, changed after it was committed: the fiber
    # stack's guard page is committed like the rest of the stack and then
    # given PAGE_GUARD, because a page that is not committed cannot carry
    # the attribute and a page that is not there raises an access
    # violation with nowhere for the handler to stand
    # (`IyiFiber#map_stack`).
    fun VirtualProtect(lpAddress : Void*, dwSize : UInt64, flNewProtect : Int32, lpflOldProtect : Int32*) : Int32
    fun GetModuleHandleA(lpModuleName : UInt8*) : Void*
    fun GetCurrentThread : Void*
    fun SuspendThread(hThread : Void*) : Int32
    fun ResumeThread(hThread : Void*) : Int32
    fun GetThreadContext(hThread : Void*, lpContext : Void*) : Int32
    fun QueryPerformanceCounter(lpPerformanceCount : Int64*) : Int32
    fun QueryPerformanceFrequency(lpFrequency : Int64*) : Int32
    fun CreateThread(lpThreadAttributes : Void*, dwStackSize : UInt64, lpStartAddress : Void*, lpParameter : Void*, dwCreationFlags : Int32, lpThreadId : Int32*) : Void*
    fun GetLastError : Int32
    fun CreateIoCompletionPort(file_handle : Void*, existing_completion_port : Void*, completion_key : UInt64, number_of_concurrent_threads : Int32) : Void*
    fun GetQueuedCompletionStatus(completion_port : Void*, lp_number_of_bytes_transferred : Int32*, lp_completion_key : UInt64*, lp_overlapped : Void**, dw_milliseconds : Int32) : Int32
    fun PostQueuedCompletionStatus(completion_port : Void*, dw_number_of_bytes_transferred : Int32, dw_completion_key : UInt64, lp_overlapped : Void*) : Int32
    fun CancelIoEx(h_file : Void*, lp_overlapped : Void*) : Int32
    fun SetFileCompletionNotificationModes(file_handle : Void*, flags : UInt8) : Int32
    fun WaitForSingleObject(h_handle : Void*, dw_milliseconds : Int32) : Int32
    fun WaitForMultipleObjects(n_count : Int32, lp_handles : Void*, b_wait_all : Int32,
                               dw_milliseconds : Int32) : Int32
    # The timer the poller's deadline needs. A millisecond timeout given to
    # `GetQueuedCompletionStatus` is rounded up to the system timer tick,
    # which is 15.6 ms unless something on the machine raised it: measured
    # here, fifty one-millisecond waits took 15,707 us each and a hundred
    # `sleep 1` calls took 1,577 ms instead of 100. A waitable timer made
    # with CREATE_WAITABLE_TIMER_HIGH_RESOLUTION (0x2) takes 1,513 us for
    # that millisecond and 10,393 for ten; the same object without the flag
    # takes 15,879, so it is the flag that does the work.
    fun CreateWaitableTimerExW(lp_timer_attributes : Void*, lp_timer_name : UInt16*,
                               dw_flags : Int32, dw_desired_access : Int32) : Void*
    fun SetWaitableTimer(h_timer : Void*, lp_due_time : Int64*, l_period : Int32,
                         pfn_completion_routine : Void*, lp_arg_to_completion_routine : Void*,
                         f_resume : Int32) : Int32
    fun CancelWaitableTimer(h_timer : Void*) : Int32
    fun DuplicateHandle(h_source_process_handle : Void*, h_source_handle : Void*, h_target_process_handle : Void*, lp_target_handle : Void**, dw_desired_access : Int32, b_inherit_handle : Int32, dw_options : Int32) : Int32
    fun SwitchToThread : Int32
    fun GetActiveProcessorCount(group_number : UInt16) : Int32
    fun CreateNamedPipeA(lp_name : UInt8*, dw_open_mode : Int32, dw_pipe_mode : Int32, n_max_instances : Int32, n_out_buffer_size : Int32, n_in_buffer_size : Int32, n_default_time_out : Int32, lp_security_attributes : Void*) : Void*
    fun ConnectNamedPipe(h_named_pipe : Void*, lp_overlapped : Void*) : Int32
    # The console's own three: whether a handle is one, its mode, and the
    # wide write. `GetConsoleMode` failing is how a pipe is told apart from
    # a terminal here.
    fun GetConsoleMode(handle : Void*, mode : Int32*) : Int32
    fun SetConsoleMode(handle : Void*, mode : Int32) : Int32
    fun WriteConsoleW(handle : Void*, buffer : Void*, count : Int32,
                      written : Int32*, reserved : Void*) : Int32
    fun ReadConsoleW(handle : Void*, buffer : Void*, count : Int32,
                     read : Int32*, control : Void*) : Int32
    # The stack, walked by the kernel's own unwinder. x86-64 Windows has no
    # frame pointer to chase — a frame is described by the unwind data in
    # `.pdata`, which is what `RtlCaptureStackBackTrace` reads — so a panic
    # that wants to name its callers asks for them here rather than walking
    # anything itself.
    # It answers a USHORT, which returns in AX with the rest of the
    # register unpromised, so the declaration takes the Int32 this file
    # spells a machine word with and the caller masks the low sixteen
    # bits rather than trusting them to be zero.
    fun RtlCaptureStackBackTrace(frames_to_skip : Int32, frames_to_capture : Int32,
                                 back_trace : Void**, back_trace_hash : Int32*) : Int32
    # The command line the kernel kept, in UTF-16. The C runtime's `argv`
    # is the same line put through the active code page, which is lossy
    # for every character the page has no letter for (`Program.args`).
    fun GetCommandLineW : UInt16*
    # The crash path's three, and the only thing a program of this shape
    # asks Windows for at startup: no error dialog, room reserved for the
    # overflow handler, and the handler itself.
    fun SetErrorMode(mode : Int32) : Int32
    fun SetThreadStackGuarantee(size : Int32*) : Int32
    fun SetUnhandledExceptionFilter(filter : Void*) : Void*
    fun AddVectoredExceptionHandler(first : Int32, handler : Void*) : Void*
  end

  # GetStdHandle's constants, by their Win32 names: STD_INPUT_HANDLE (-10),
  # STD_OUTPUT_HANDLE (-11), STD_ERROR_HANDLE (-12). They are negative
  # identifiers reinterpreted as DWORD; as Int32 they spell themselves.
  def __iyi_std_handle(fd : Int64) : Void*
    return LibC.GetStdHandle(-11) if fd == 1_i64
    return LibC.GetStdHandle(-12) if fd == 2_i64
    return LibC.GetStdHandle(-10) if fd == 0_i64
    Pointer(Void).new(fd.to_u64)
  end

  # The console, which is not a file even though Windows hands it out as a
  # handle. Three things follow from that and all three were wrong:
  #
  #   * A console renders the bytes `WriteFile` gives it in the console's
  #     *output code page*, which is 437 on an ordinary machine: `puts "çay"`
  #     printed `‡ay`. `WriteConsoleW` takes UTF-16 and renders what the
  #     program meant, so console output is converted and file output is not
  #     — a redirected stream must stay the program's own bytes.
  #   * VT sequences are off unless a program asks. Windows Terminal turns
  #     them on for its own session and `conhost.exe` does not, which is why
  #     `std/colorize` looked fine in one terminal and printed `←[31m` in the
  #     other. ENABLE_VIRTUAL_TERMINAL_PROCESSING is 0x4, asked once.
  #   * "Is this a terminal?" has no `isatty` here, and `GetConsoleMode`
  #     answering at all *is* the test: it fails for a pipe and for a file.
  #
  # A write may end inside a UTF-8 sequence, because `IyiIO` flushes a full
  # buffer wherever it fills. The tail is carried here, packed into a word,
  # and goes out in front of the next write; the whole count is reported
  # written because the caller's loop retries a short write with the same
  # incomplete bytes and would never make progress.
  module IyiConsole
    @@probed : UInt64 = 0_u64
    @@console : UInt64 = 0_u64
    @@vt : UInt64 = 0_u64
    # A carry per stream, not one for the module: stdout and stderr are
    # separate console handles and separate byte streams, and a single pair
    # here put a tail held back from one of them in front of the next write
    # to the *other* — measured, a character whose lead byte went to stdout
    # and whose continuation byte went to stderr came out whole, on stderr.
    # Two pairs rather than an array indexed by the descriptor, because the
    # prelude's `StaticArray` has no `[]=` and a heap slot for two words
    # would be a mapping to keep alive for nothing.
    @@carry_out : UInt64 = 0_u64
    @@carry_out_length : Int32 = 0
    @@carry_err : UInt64 = 0_u64
    @@carry_err_length : Int32 = 0

    def self.console?(fd : Int64, handle : Void*) : Bool
      return false if fd < 0_i64 || fd > 2_i64
      bit = 1_u64.unsafe_shl(fd.to_u64)
      if @@probed & bit == 0_u64
        mode = uninitialized Int32
        @@console = @@console | bit if LibC.GetConsoleMode(handle, pointerof(mode)) != 0
        @@probed = @@probed | bit
      end
      @@console & bit != 0_u64
    end

    def self.enable_vt(fd : Int64, handle : Void*) : Nil
      bit = 1_u64.unsafe_shl(fd.to_u64)
      return if @@vt & bit != 0_u64
      @@vt = @@vt | bit
      mode = uninitialized Int32
      return if LibC.GetConsoleMode(handle, pointerof(mode)) == 0
      LibC.SetConsoleMode(handle, mode | 4)
      nil
    end

    # How many of *count* bytes at *bytes* end a UTF-8 sequence. A lead byte
    # says how many follow: 0xC0 two, 0xE0 three, 0xF0 four.
    private def self.complete_length(bytes : UInt8*, count : Int32) : Int32
      back = 1
      while back <= 3 && back <= count
        lead = bytes[count - back]
        if lead >= 0xC0_u8
          needed = lead >= 0xF0_u8 ? 4 : (lead >= 0xE0_u8 ? 3 : 2)
          return count - back if needed > back
          return count
        end
        return count if lead < 0x80_u8
        back = back + 1
      end
      count
    end

    def self.write(fd : Int64, handle : Void*, buffer : Void*, count : UInt64) : Int64
      enable_vt(fd, handle)
      # Anything that is not the error stream carries as the output one:
      # `console?` has already refused every descriptor outside 0..2, and 0
      # is read from rather than written to.
      on_error = fd == 2_i64
      staged = buffer.as(UInt8*)
      total = count.to_i32
      held = on_error ? @@carry_err_length : @@carry_out_length
      if held > 0
        packed = on_error ? @@carry_err : @@carry_out
        joined = Pointer(UInt8).malloc((held + total).to_u64)
        index = 0
        while index < held
          joined[index] = (packed.unsafe_shr(index.to_u64 * 8_u64) & 0xFF_u64).to_u8
          index = index + 1
        end
        (joined + held).copy_from(staged, total)
        staged = joined
        total = total + held
        if on_error
          @@carry_err = 0_u64
          @@carry_err_length = 0
        else
          @@carry_out = 0_u64
          @@carry_out_length = 0
        end
      end
      whole = complete_length(staged, total)
      tail = total - whole
      if tail > 0
        packed = 0_u64
        index = 0
        while index < tail
          packed = packed | staged[whole + index].to_u64.unsafe_shl(index.to_u64 * 8_u64)
          index = index + 1
        end
        if on_error
          @@carry_err = packed
          @@carry_err_length = tail
        else
          @@carry_out = packed
          @@carry_out_length = tail
        end
      end
      return count.to_i64 if whole == 0
      wide_count = LibC.MultiByteToWideChar(65001, 0, staged, whole, Pointer(UInt16).new(0_u64), 0)
      # Not UTF-8 after all: the bytes are the program's and go out as they
      # are, which is what every other platform does with them.
      return __iyi_win_write_file(handle, staged.as(Void*), whole.to_u64) if wide_count <= 0
      wide = Pointer(UInt16).malloc(wide_count.to_u64)
      return __iyi_win_write_file(handle, staged.as(Void*), whole.to_u64) if LibC.MultiByteToWideChar(65001, 0, staged, whole, wide, wide_count) <= 0
      written = uninitialized Int32
      return -1_i64 if LibC.WriteConsoleW(handle, wide.as(Void*), wide_count, pointerof(written), Pointer(Void).new(0_u64)) == 0
      count.to_i64
    end

    # The other direction, and the last leg of it. `ReadFile` on a console
    # handle answers the *active code page*, so a line typed as
    # `Türkçe-日本` — fifteen bytes of UTF-8 — was read as eleven bytes
    # under code page 437, with `ü` and `ç` folded to one byte each and
    # `日本` gone as `??`. `ReadConsoleW` reads what was typed, and the
    # conversion back to UTF-8 is Windows' own.
    #
    # The wide buffer is a third of the caller's, which is the bound that
    # cannot overflow it: a character of the basic plane is at most three
    # UTF-8 bytes, and a surrogate pair is two wide characters for four.
    # A line longer than that is read in pieces, which is what a reader
    # of a stream does anyway.
    def self.read(handle : Void*, buffer : Void*, count : UInt64) : Int64
      room = count // 3_u64
      room = 1_u64 if room == 0_u64
      wide = Pointer(UInt16).malloc(room + 1_u64)
      read = uninitialized Int32
      return 0_i64 if LibC.ReadConsoleW(handle, wide.as(Void*), room.to_i32, pointerof(read), Pointer(Void).new(0_u64)) == 0
      return 0_i64 if read <= 0
      wide[read] = 0_u16
      size = __iyi_utf8_size_from_wide(wide)
      return 0_i64 if size <= 1
      bytes = size - 1
      return 0_i64 if bytes.to_u64 > count
      __iyi_utf8_bytes_from_wide(wide, buffer.as(UInt8*), size)
      bytes.to_i64
    end
  end

  def __iyi_win_write_file(handle : Void*, buffer : Void*, count : UInt64) : Int64
    written = uninitialized Int32
    if LibC.WriteFile(handle, buffer, count.to_i32, pointerof(written), nil) == 0
      return -1_i64
    end
    written.to_i64
  end

  # Whether a descriptor is a terminal, which only the console answers yes to.
  def __iyi_isatty(fd : Int32) : Bool
    IyiConsole.console?(fd.to_i64, __iyi_std_handle(fd.to_i64))
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    __iyi_write(fd.to_i64, buffer, count)
  end

  def __iyi_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    handle = __iyi_std_handle(fd)
    return IyiConsole.write(fd, handle, buffer, count) if IyiConsole.console?(fd, handle)
    __iyi_win_write_file(handle, buffer, count)
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    __iyi_read(fd.to_i64, buffer, count)
  end

  def __iyi_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    if fd == 0_i64
      handle = LibC.GetStdHandle(-10)
    else
      handle = Pointer(Void).new(fd.to_u64)
    end
    # A console is read wide, for the reason `IyiConsole.read` gives; a
    # pipe or a file is bytes and stays bytes.
    return IyiConsole.read(handle, buffer, count) if IyiConsole.console?(fd, handle)
    read = uninitialized Int32
    if LibC.ReadFile(handle, buffer,
         count.to_i32, pointerof(read), nil) == 0
      return 0_i64
    end
    read.to_i64
  end

  # A path is UTF-16 on Windows, and this is where iyi's UTF-8 becomes it.
  #
  # The `*A` entry points read a path in the process's *active code page*,
  # so the UTF-8 bytes an iyi string carries arrived as whatever those bytes
  # spell in that page: `File.write("ünïcode-ü.txt", …)` created a file
  # Explorer shows as `Ã¼nÃ¯code-Ã¼.txt`, and reading it back worked only
  # because both directions were wrong in the same way. `MultiByteToWideChar`
  # with CP_UTF8 (65001) is the conversion Windows itself offers, so no
  # decoder is written here.
  #
  # Long paths come with it. A `*W` call still stops at MAX_PATH unless the
  # path carries the `\\?\` prefix, and that prefix turns off all path
  # normalisation: `.`, `..` and `/` are no longer understood, so it may only
  # be put on a full path. The rule is therefore: convert, and if the result
  # is long, ask `GetFullPathNameW` for the absolute form and prefix that —
  # `\\?\` for a drive path, `\\?\UNC\` for a share, which is the one shape
  # where the leading `\\` is replaced rather than kept.
  #
  # 248 rather than 260 is deliberate: MAX_PATH is the limit for a *file*,
  # and a directory a file is later created in has to leave room for a name,
  # which is the number `CreateDirectoryW` documents.
  IYI_WIN_PATH_LIMIT = 248

  def __iyi_wide_path(path : UInt8*) : UInt16*
    needed = LibC.MultiByteToWideChar(65001, 0, path, -1, Pointer(UInt16).new(0_u64), 0)
    return Pointer(UInt16).new(0_u64) if needed <= 0
    wide = Pointer(UInt16).malloc(needed.to_u64)
    return Pointer(UInt16).new(0_u64) if LibC.MultiByteToWideChar(65001, 0, path, -1, wide, needed) <= 0
    # `needed` counts the terminator; the length does not.
    # The limit is on the path Windows resolves, not on the text handed in:
    # `needed` measures a relative name without the current directory in
    # front of it, and a short name in a deep directory is a long path.
    # Measured before this line said so: a 215-byte relative name in a
    # 48-byte directory is 264 bytes absolute — past MAX_PATH, under this
    # threshold, so no prefix went on and the call failed, while the same
    # path written absolutely worked. A rooted path is its own absolute
    # form, so there its own length is the answer and nothing is asked.
    return wide if needed - 1 < IYI_WIN_PATH_LIMIT && __iyi_wide_rooted?(wide)
    __iyi_wide_long_path(wide)
  end

  # `\\server\share` and `\\?\…` are rooted, and so is `C:\`. `C:x` is
  # relative to that drive's own current directory and `\x` to the current
  # drive, and neither one's length says what the absolute one is.
  private def __iyi_wide_rooted?(wide : UInt16*) : Bool
    return false if wide[0] == 0_u16
    return true if wide[0] == 92_u16 && wide[1] == 92_u16
    return false if wide[1] != 58_u16 # ':'
    wide[2] == 92_u16 || wide[2] == 47_u16
  end

  private def __iyi_wide_long_path(wide : UInt16*) : UInt16*
    full_needed = LibC.GetFullPathNameW(wide, 0, Pointer(UInt16).new(0_u64), Pointer(Pointer(UInt16)).new(0_u64))
    return wide if full_needed <= 0
    full = Pointer(UInt16).malloc(full_needed.to_u64)
    written = LibC.GetFullPathNameW(wide, full_needed, full, Pointer(Pointer(UInt16)).new(0_u64))
    return wide if written <= 0
    # Resolved short: the path was relative and shallow, so the plain
    # relative form is the one to keep — a `\\?\` prefix may only sit on a
    # full path, and putting one on a short path costs a resolution nothing
    # asked for.
    return wide if written < IYI_WIN_PATH_LIMIT
    # Already prefixed: `\\?\` in the source survives GetFullPathNameW.
    return full if full[0] == 92_u16 && full[1] == 92_u16 && full[2] == 63_u16
    unc = full[0] == 92_u16 && full[1] == 92_u16
    # `\\?\` is four characters, `\\?\UNC\` eight, and a share drops the two
    # leading separators it replaces.
    prefix_length = unc ? 8 : 4
    body = unc ? full + 2 : full
    body_length = written - (unc ? 2 : 0)
    prefixed = Pointer(UInt16).malloc((prefix_length + body_length + 1).to_u64)
    prefixed[0] = 92_u16 # '\'
    prefixed[1] = 92_u16
    prefixed[2] = 63_u16 # '?'
    prefixed[3] = 92_u16
    if unc
      prefixed[4] = 85_u16 # 'U'
      prefixed[5] = 78_u16 # 'N'
      prefixed[6] = 67_u16 # 'C'
      prefixed[7] = 92_u16
    end
    index = 0
    while index < body_length
      prefixed[prefix_length + index] = body[index]
      index = index + 1
    end
    prefixed[prefix_length + body_length] = 0_u16
    prefixed
  end

  # The way back, for every Windows call that *answers* with UTF-16: a
  # directory entry's name, the current directory, a resolved path. The
  # library asks for it here rather than each module writing a decoder, and
  # `String` is the right answer rather than a byte buffer because every
  # caller wants one. The bytes are UTF-8 (CP_UTF8, 65001), which is what an
  # iyi string is.
  def __iyi_utf8_bytes_from_wide(wide : UInt16*, buffer : UInt8*, limit : Int32) : Int32
    LibC.WideCharToMultiByte(65001, 0, wide, -1, buffer, limit,
      Pointer(UInt8).new(0_u64), Pointer(Int32).new(0_u64))
  end

  # How many bytes the UTF-8 of *wide* needs, terminator included, or 0 when
  # Windows refuses the conversion.
  def __iyi_utf8_size_from_wide(wide : UInt16*) : Int32
    needed = LibC.WideCharToMultiByte(65001, 0, wide, -1, Pointer(UInt8).new(0_u64), 0,
      Pointer(UInt8).new(0_u64), Pointer(Int32).new(0_u64))
    needed > 0 ? needed : 0
  end

  # The attributes of a path, or -1 (INVALID_FILE_ATTRIBUTES) when there is
  # nothing there. `File` asks this rather than opening, because
  # `CreateFileW` without FILE_FLAG_BACKUP_SEMANTICS refuses a directory.
  def __iyi_path_attributes(path : UInt8*) : Int32
    wide = __iyi_wide_path(path)
    return -1 if wide.address == 0_u64
    LibC.GetFileAttributesW(wide)
  end

  # HANDLE is pointer-sized; File carries it as Int64. INVALID_HANDLE_VALUE
  # is all bits set, which as an unsigned address plus one wraps to zero.
  #
  # Both opens name every share right there is — FILE_SHARE_READ |
  # FILE_SHARE_WRITE | FILE_SHARE_DELETE — because POSIX `open` grants no
  # exclusivity and this prelude's `File` is POSIX's. A read handle asked
  # for FILE_SHARE_READ alone, so a later write to the same path failed,
  # and a write handle asked for nothing, so reading a file while it was
  # still open came back as ERROR_SHARING_VIOLATION: that is what
  # `bench/io_exercise.iyi`'s flush check read as "cannot read".
  def __iyi_open_read(path : UInt8*) : Int64
    wide = __iyi_wide_path(path)
    return -1_i64 if wide.address == 0_u64
    # GENERIC_READ, every share right, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL.
    handle = LibC.CreateFileW(wide, -2147483648, 7, nil, 3, 128, Pointer(Void).new(0_u64))
    return -1_i64 if handle.address &+ 1_u64 == 0_u64
    handle.address.to_i64
  end

  def __iyi_open_write(path : UInt8*) : Int64
    wide = __iyi_wide_path(path)
    return -1_i64 if wide.address == 0_u64
    # GENERIC_WRITE, every share right, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL.
    handle = LibC.CreateFileW(wide, 1073741824, 7, nil, 2, 128, Pointer(Void).new(0_u64))
    return -1_i64 if handle.address &+ 1_u64 == 0_u64
    handle.address.to_i64
  end

  def __iyi_close(fd : Int64) : Nil
    LibC.CloseHandle(Pointer(Void).new(fd.to_u64))
  end

  def __iyi_unlink(path : UInt8*) : Int64
    wide = __iyi_wide_path(path)
    return -1_i64 if wide.address == 0_u64
    return 0_i64 if LibC.DeleteFileW(wide) != 0
    -1_i64
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    read = uninitialized Int32
    if LibC.ReadFile(Pointer(Void).new(fd.to_u64), buffer,
         count.to_i32, pointerof(read), nil) == 0
      return 0_i64
    end
    read.to_i64
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    written = uninitialized Int32
    if LibC.WriteFile(Pointer(Void).new(fd.to_u64), buffer,
         count.to_i32, pointerof(written), nil) == 0
      return -1_i64
    end
    written.to_i64
  end

  # The directory in UTF-8, the way every other platform answers it.
  # `GetCurrentDirectoryW` writes the character count, or, when the
  # buffer is too small, the count it needs with the terminator in it:
  # anything over what was offered is a refusal here and the caller
  # comes back with room.
  def __iyi_getcwd(buffer : UInt8*, size : UInt64) : Int64
    wide = Pointer(UInt16).malloc(4096_u64)
    chars = LibC.GetCurrentDirectoryW(4096, wide)
    if chars > 4096
      wide = Pointer(UInt16).malloc(chars.to_u64)
      chars = LibC.GetCurrentDirectoryW(chars, wide)
    end
    return -1_i64 if chars <= 0
    needed = __iyi_utf8_size_from_wide(wide)
    return -1_i64 if needed <= 0 || needed.to_u64 > size
    written = __iyi_utf8_bytes_from_wide(wide, buffer, needed)
    return -1_i64 if written <= 0
    # The conversion counts the terminator it wrote; a String does not.
    (written - 1).to_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibC.ExitProcess(status)
  end
{% elsif flag?(:wasm32) %}
  # iyi: On wasm32-wasi the platform's own interface is the WASI import set,
  # which the runtime (wasmtime, wasmer, a browser shim) provides; that is
  # the same standing libSystem and kernel32 have on the other platforms, and
  # the reason the imports are bound by their `__wasi_` names rather than
  # through wasi-libc's POSIX shims. `fd_write` takes an iovec, so one call
  # covers the whole buffer; `proc_exit` is NoReturn the same way `exit`
  # elsewhere is. The declarations mirror `src/crystal/system/wasi/lib_wasi.cr`,
  # which binds `proc_exit` this way too.
  # WASI's own types are fd/size/errno as u32; iyi's primitives carry
  # arithmetic on Int32/Int64/UInt8/UInt64 only, so the u32-width parameters
  # are declared Int32, which is the same 32 bits at the ABI, and no UInt32
  # value ever exists in this file to convert.
  lib LibWasi
    struct Ciovec
      buf : UInt8*
      buf_len : Int32
    end

    fun fd_write = __wasi_fd_write(fd : Int32, iovs : Ciovec*,
                                   iovs_len : Int32, nwritten : Int32*) : Int32
    fun fd_read = __wasi_fd_read(fd : Int32, iovs : Ciovec*,
                                 iovs_len : Int32, nread : Int32*) : Int32
    fun proc_exit = __wasi_proc_exit(code : Int32) : NoReturn
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    iov = LibWasi::Ciovec.new(buf: buffer.as(UInt8*), buf_len: count.to_i32)
    written = uninitialized Int32
    if LibWasi.fd_write(fd, pointerof(iov), 1, pointerof(written)) != 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    iov = LibWasi::Ciovec.new(buf: buffer.as(UInt8*), buf_len: count.to_i32)
    read = uninitialized Int32
    if LibWasi.fd_read(fd, pointerof(iov), 1, pointerof(read)) != 0
      return 0_i64
    end
    read.to_i64
  end

  # path_open needs a preopened directory fd this prelude does not have.
  def __iyi_open_read(path : UInt8*) : Int64
    raise "File is not available on wasm32-wasi: path_open needs a preopened directory fd"
  end

  def __iyi_open_write(path : UInt8*) : Int64
    raise "File is not available on wasm32-wasi: path_open needs a preopened directory fd"
  end

  def __iyi_close(fd : Int64) : Nil
  end

  # Like path_open, path_unlink_file needs a preopened directory fd and a path
  # relative to it. This prelude has no directory capability to pass.
  def __iyi_unlink(path : UInt8*) : Int64
    raise "File.delete is not available on wasm32-wasi: path_unlink_file needs a preopened directory fd"
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    0_i64
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    -1_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibWasi.proc_exit(status)
  end

  # WASI has `fd_fdstat_get` and a character-device filetype, which is as
  # close to a terminal as the sandbox gets. Nothing here asks yet, and a
  # guess would be the wrong kind of answer: no terminal, so no escapes.
  def __iyi_isatty(fd : Int32) : Bool
    false
  end

  # WASI has no working directory: a path is resolved against a
  # preopened directory capability, and the sandbox never names one to
  # the program. `Program.cwd` answers nil here.
  def __iyi_getcwd(buffer : UInt8*, size : UInt64) : Int64
    -1_i64
  end
{% else %}
  {% raise "iyi: this target is not one iyi's prelude has platform bindings for. " \
           "iyi supports Linux (x86_64, aarch64) via raw syscalls, macOS via " \
           "libSystem, Windows via the Win32 API and wasm32-wasi via the WASI " \
           "imports. Teach src/iyi/prelude.iyi a branch for this platform rather " \
           "than linking something absent." %}
{% end %}

require "./io"
require "./file"

# ── The memory layer ────────────────────────────────────────────────────
#
# From here to the matching mark below is what Crystal's 0.1.0 prelude got
# from Boehm's libgc and never counted: the allocator and the collector.
# `bench/doc_numbers.py` counts these lines out of the library figure the
# SPEC holds to its ceiling, by these two marks.
#
# The allocator, selected rather than declared, because the selection has to be
# a real seam a different allocator is swapped in at. The seam has carried
# three defaults: Boehm (0.1.0), then nothing — allocate and never collect —
# after the dependency floor measured libgc as the last library a default
# build could not refuse (SPEC.md III.9), and now the owned collector, once
# GC_DESIGN.md's stages were built, gated, and measured against both
# predecessors (`bench/gc_default.py`). `-Dgc_boehm` still buys libgc and its
# collection; `-Dgc_none` still buys the bump pointer and its unbounded
# floor-clean speed; a plain build gets the collector that pays for itself.
#
# Written out in full rather than put behind a `GC` module the way the standard
# library has it. There are four call sites and all of them are in this file,
# so the module would buy nothing but a frame on every allocation of a build
# that is not optimised.
{% if flag?(:gc_boehm) %}
  # `pkg_config: "bdw-gc"` is how Crystal's own `gc/boehm.cr` names the
  # library, and it is what lets a homebrew-installed collector link on
  # darwin, where `-lgc` alone has no search path that finds it.
  @[Link("gc", pkg_config: "bdw-gc")]
  lib LibGC
    fun init = GC_init
    fun malloc = GC_malloc(size : UInt64) : Void*
    fun malloc_atomic = GC_malloc_atomic(size : UInt64) : Void*
    fun realloc = GC_realloc(pointer : Void*, size : UInt64) : Void*
  end

  # Codegen emits calls to these by name for every allocation under the
  # __iyi_* ABI.
  #
  # Every mode leaves one
  # word under the pointer it answers: codegen stores an object's type id in
  # its high half - the only place the id lives, so an object is its fields
  # and nothing else (GC_DESIGN.md Stage 5) - and an object's layout is one
  # thing under any allocator, which is what lets a module's object code
  # link under any of them. Here the word is the first eight bytes of a
  # block libgc handed out; the program's pointer is an interior one, which
  # libgc follows by default.
  fun __iyi_malloc64(size : UInt64) : Void*
    LibGC.malloc(size + 8_u64) + 8_i64
  end

  fun __iyi_malloc_atomic64(size : UInt64) : Void*
    LibGC.malloc_atomic(size + 8_u64) + 8_i64
  end

  fun __iyi_realloc64(pointer : Void*, size : UInt64) : Void*
    return __iyi_malloc64(size) if pointer.address == 0
    LibGC.realloc(Pointer(Void).new(pointer.address - 8_u64), size + 8_u64) + 8_i64
  end
{% else %}
  {% if !flag?(:gc_none) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin) || flag?(:win32)) %}
    # iyi: **the default allocator on POSIX is the owned collector.** The
    # size-class arena of GC_DESIGN.md's Stage 2, the roots, the marker,
    # the sweep and the allocation-pressure trigger — a plain `iyi build`
    # gets all of it, and the flip was a measurement before it was a
    # decision (`bench/gc_default.py`, the table in GC_DESIGN.md): the
    # collector wins or ties every time column against the bump pointer
    # and Boehm alike, and holds RSS at the live set where a heap that
    # never frees holds it at the garbage.
    #
    # The doors out: `-Dgc_none` selects the bump pointer below —
    # allocate, never free, the old default, still the right tool for a
    # short-lived program that wants the last nanosecond — and
    # `-Dgc_boehm` selects libgc above. `-Dgc_iyi` still names this
    # branch and is now the default spelled out loud, kept so nothing
    # that passes it changes meaning.
    #
    # **This condition has a twin in the compiler** —
    # `Program#iyi_gc_arena?` in `src/compiler/iyi/codegen/gc_layouts.cr`
    # — which decides whether codegen stores type ids into the header and
    # embeds the layout table. The two must agree: a prelude that scans
    # precisely against a compiler that never wrote an id is merely
    # conservative, but a compiler that writes ids into a header this
    # branch did not allocate is memory corruption. Change both or
    # neither.
    #
    # POSIX and no further, which is deliberate rather than unfinished.
    # Linux binds the arena over raw syscalls and darwin over libSystem,
    # the two interfaces this file already calls the platform's own. win32
    # and wasm32 keep the allocators they have: win32's diagnosis for
    # printing memory it was never given has a fixed suspect — the memset
    # stride defect recorded at that definition below — and the watch in
    # CI is what retires it; wasm32 has no mmap, and its watermark arena
    # is a separate design.
    #
    # Requests are rounded to size classes: eight-byte steps to 128, then
    # four to each doubling up to 1 MiB, 67 classes. A small fixed set is
    # what keeps allocation and free O(1) list operations; the waste
    # against the request is eight bytes below 128 and a fifth above, the
    # standing trade for never splitting or coalescing. A request over
    # 1 MiB is large and gets a mapping of its own.
    #
    # An object is its fields. A class whose type id something reads off
    # the object - a virtual type over an ancestor, a reference union -
    # carries the id in a word ahead of it, at `P-8`, its high half; the
    # program that links decides which (`gc_layouts.cr`), and codegen
    # allocates an instance through `__iyi_new` with the decision and
    # the id. Every other object's id, and every object's collector bits,
    # are tables at its arena's head (`IyiHeap`, "An object is its
    # fields"); untyped memory - a `Pointer(T).malloc` buffer, a closure's
    # environment - has no id and is word-scanned conservatively, or,
    # atomic, never opened. A large object always has the word, its bits
    # in the low half. The stages below were written against the header
    # every object once had, and say so where it matters.
    #
    # One arena is one contiguous 16 MiB mmap region holding chunks of a
    # single class. Sixteen rather than thirty-two because address space is
    # the cheap half of a mapping (pages commit when touched, on Linux and
    # darwin alike) and a small program pays one arena per class it uses. The
    # first 64 bytes of an arena are its header: the next arena in the heap's
    # list, the mapped length, the chunk size, and the fill cursor with the
    # count of chunks never handed out. Everything that varies per class
    # lives in one mapped page holding seventeen free-list heads and
    # seventeen fill-arena pointers — the thread's cache, since the split
    # the class's own comment describes; the centre's page is seventeen
    # heads and the lock: the language has no array class variable, so
    # seventeen scalars would mean a seventeen-way branch on every
    # allocation, and one zeroed page is the whole table.
    #
    # Allocation pops the class's free list in the thread's cache, refills
    # it from the centre when it is empty, and with both empty carves the
    # next fresh chunk from the cache's fill arena, and with the arena
    # spent it maps another and links it in. Free reads the class back out of
    # the size the header carries and pushes the chunk onto that class's
    # list. Neither walks the arena list: the list exists to be
    # traversed, not to serve the hot path.
    #
    # The clearing contract is the stage's correctness point, because reuse
    # is what is new here. `__iyi_malloc64` is documented to allocate
    # *and clear*, and until now the clear was free: every byte any path
    # handed out came from a fresh mapping, zero-filled by the kernel, and
    # nothing was handed out twice. A free list hands memory back out, so a
    # reused chunk is dirty, and a dirty chunk returned as cleared is the
    # exact shape of the defect that has a win32 binary printing memory it
    # was never given. A chunk popped from a free list is therefore cleared
    # before it is returned; a chunk carved fresh from an arena is not,
    # because the kernel already zeroed it and no second pass is owed. What
    # is cleared is the whole class payload, not the requested size: the
    # class rounds up, and the bytes past the request go to the caller with
    # the chunk, reachable through the size header the next time a realloc
    # grows into them. Zeroed slack keeps a reused chunk indistinguishable
    # from a fresh mapping, the invariant every path in this file provided
    # for free until now. `__iyi_malloc_atomic64` does not clear,
    # matching `GC_malloc_atomic`: atomic means the collector never scans
    # those bytes, so their initial value is no one's contract, and a reused
    # chunk may come back dirty on that path on purpose.
    #
    # The header's own two words are the exception, and they are cleared on
    # every reuse whichever path asked. They are not the caller's bytes, they
    # are the collector's: a stale type id names the layout of whoever held
    # the chunk last, which is a map read over an object that does not have
    # that shape, and a stale mark word hands out an object that is already
    # black and will never be scanned again. Both are false negatives, which
    # is the one class of error this collector cannot tolerate, so the clear
    # is unconditional there.
    #
    # `realloc` keeps the size-header contract: within one class, growing or
    # shrinking, it returns the same chunk with the header rewritten; across
    # classes it allocates, copies the smaller of the two requested sizes,
    # and frees the old chunk. A null pointer still means allocate, through
    # the clearing path, which is what `GC_realloc`'s null means.
    #
    # Large objects, over the top class, get one mmap region each and a node
    # on a separate list: the list's next pointer and the mapped length in
    # the sixteen bytes under the object header, so the forty bytes below a
    # large object's user pointer are next, mapped, then the same
    # size/type_id/mark_word header a class chunk carries. `realloc` and
    # `free` therefore read one layout for both.
    # Free unlinks the node and releases the mapping with `munmap`, checked
    # the way `__iyi_mmap` is checked, because a release that failed quietly
    # would leak the mapping with the node that named it already gone.
    #
    # Addressability is a question Stage 3's root scanning asks of every
    # word, and it is a requirement now: `IyiHeap.containing(pointer)` walks
    # the arena list and answers the containing arena's header address, or 0
    # for a pointer in no arena, and the header's chunk field then names the
    # size class. `IyiHeap.containing_large(pointer)` asks the same of the
    # large-object list. A large object answers 0 from `containing`, because
    # it is in no arena and the answer must never be a wrong arena; 0 from
    # both is how a pointer that is not the heap's is reported. The walk is
    # linear in arenas of 16 MiB each, so it is short; a page directory is
    # Stage 3's optimization if profiles say so, not a Stage 2 requirement.
    # Traversability is the same shape: `first_arena` and `arena_next`
    # enumerate the arenas for Stage 6's sweep, `first_large` and
    # `large_next` the large objects, and a list nothing can enumerate would
    # fail the next stage.
    #
    # The state is five class variables with literal zero initializers plus
    # the cache and centre pages, under the bump branch's rule: `$` globals are
    # refused, a `fun` body cannot reach `@@` state, and literal initializers
    # fold into the LLVM global's static zero, so zero means "not yet mapped"
    # rather than a value startup installs. The entry points below stay
    # `fun`s forwarding one frame into the class, the price of the only
    # state-carrying construct the language offers.
    {% if flag?(:darwin) %}
      # `mmap` and `munmap` are libSystem's here, the same standing `write`
      # has at the top of this file: Apple documents libSystem as the
      # platform's interface and raw syscalls as not a stable ABI.
      # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x1002 on
      # darwin, and a failed `mmap` answers MAP_FAILED rather than -errno.
      lib LibC
        fun mmap(addr : Void*, len : UInt64, prot : Int32, flags : Int32, fd : Int32, offset : Int64) : Void*
        fun munmap(address : Void*, length : UInt64) : Int32
        # The sweep hands a run of dead pages back with `MADV_FREE_REUSABLE`
        # (7), the advice under which darwin's accounting stops counting
        # them; `MADV_DONTNEED` there keeps the pages on the books.
        fun madvise(address : Void*, length : UInt64, advice : Int32) : Int32
        # The pause clock (IyiMark), the same call the scheduler's clock
        # uses on the concurrency targets and the same declaration, so the
        # two `lib` reopenings agree the way `mmap`'s do.
        fun clock_gettime_nsec_np(clock_id : Int32) : UInt64
      end

      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = LibC.mmap(Pointer(Void).new(0_u64), length, 3, 0x1002, -1, 0_i64)
        if result.address == 0xFFFFFFFFFFFFFFFF_u64
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        result
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        if LibC.munmap(Pointer(Void).new(address), length) != 0
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end

      fun __iyi_release_pages(address : UInt64, length : UInt64) : Nil
        LibC.madvise(Pointer(Void).new(address), length, 7_i32)
      end
    {% elsif flag?(:win32) %}
      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = LibC.VirtualAlloc(nil, length, 0x3000_i32, 4_i32)
        if result.address == 0_u64
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        Pointer(Void).new(result.address)
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        if LibC.VirtualFree(Pointer(Void).new(address), 0_u64, 0x8000_i32) == 0
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end

      fun __iyi_release_pages(address : UInt64, length : UInt64) : Nil
        # On Windows, MEM_RESET (0x80000) advises the kernel that the pages can
        # be discarded under memory pressure without decommitting the virtual address.
        # Uncommitting with MEM_DECOMMIT causes 0xC0000005 on next access.
        LibC.VirtualAlloc(Pointer(Void).new(address), length, 0x80000_i32, 4_i32)
      end

      fun __iyi_madvise(address : UInt64, length : UInt64, advice : Int64) : Nil
      end

      fun __iyi_madvise_nohuge(address : UInt64, length : UInt64) : Nil
      end
    {% else %}
      # `mmap` the way the bump branch binds it, a raw syscall with the
      # numbers `src/syscall/x86_64-linux.cr` and `aarch64-linux.cr` carry.
      # `munmap` joins it here because large objects are released in this
      # stage: syscall 11 on x86_64 and 215 on aarch64, checked rather than
      # assumed for `__iyi_mmap`'s reason, a failure answered with -errno in
      # the result register rather than a flag.
      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22.
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(9_i64), "{rdi}"(0_i64), "{rsi}"(length), "{rdx}"(3_i64),
                          "{r10}"(34_i64), "{r8}"(-1_i64), "{r9}"(0_i64)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(222_i64), "{x0}"(0_i64), "{x1}"(length), "{x2}"(3_i64),
                         "{x3}"(34_i64), "{x4}"(-1_i64), "{x5}"(0_i64)
                       : "memory"
                       : "volatile")
        {% end %}
        # A failed raw syscall answers with -errno in the result register
        # rather than a flag: -4095..-1 is errno's whole range.
        if result < 0 && result >= -4095
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        Pointer(Void).new(result.to_u64)
      end

      # `madvise`, syscall 28 on x86_64 and 233 on aarch64. Two pieces of
      # advice are given: `MADV_NOHUGEPAGE` (15) on a mapping that is large
      # and touched only at one end - a mark worker's stack, a helper
      # thread's - which would otherwise be given a transparent huge page
      # at its first touch, two megabytes resident for four kilobytes
      # used, sixteen workers and 34 MB of it; and `MADV_DONTNEED` (4) on
      # a run of pages the sweep found nothing alive in, which hands them
      # back to the kernel while the mapping stays, so the heap's resident
      # size follows the live set and not its high-water mark.
      fun __iyi_madvise(address : UInt64, length : UInt64, advice : Int64) : Nil
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(28_i64), "{rdi}"(address), "{rsi}"(length), "{rdx}"(advice)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(233_i64), "{x0}"(address), "{x1}"(length), "{x2}"(advice)
                       : "memory"
                       : "volatile")
        {% end %}
        # Advice refused (a kernel without THP) is no failure.
      end

      fun __iyi_madvise_nohuge(address : UInt64, length : UInt64) : Nil
        __iyi_madvise(address, length, 15_i64)
      end

      # Pages back to the kernel, the mapping kept: they read as zero when
      # touched again, and the touch is what makes them resident again.
      fun __iyi_release_pages(address : UInt64, length : UInt64) : Nil
        __iyi_madvise(address, length, 4_i64)
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(11_i64), "{rdi}"(address), "{rsi}"(length)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(215_i64), "{x0}"(address), "{x1}"(length)
                       : "memory"
                       : "volatile")
        {% end %}
        if result < 0 && result >= -4095
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end
    {% end %}

    class IyiHeap
      MAP = 16777216_u64
      TOP = 1048576_u64
      # The arena's first four kilobytes are its header: the words below,
      # and a bit per page of the mapping saying whether the sweep handed
      # it back; the chunks' byte and layout tables follow it (`META`),
      # and the chunk grid begins on the page after them (`OFF_FIRST`).
      # The page is the kernel's: darwin arm64's is 16 KB, and an
      # `madvise` of a four-kilobyte run there is refused.
      HEAD = 4096_u64
      {% if flag?(:darwin) %}
        PAGE = 16384_u64
        PAGE_SHIFT = 14_u64
      {% else %}
        PAGE = 4096_u64
        PAGE_SHIFT = 12_u64
      {% end %}
      DIR_LEN = 4096_u64
      # Size classes: eight-byte steps from 16 to 128, then four to each
      # doubling up to the top class, 67 in all; `FILL` is where a cache's
      # fill arenas start in its table, past the free-list heads.
      CLASSES = 67
      FILL = 80

      # An object is its fields, and a header word ahead of them only when
      # something reads its type id from the object - a virtual type over
      # an ancestor, a reference union it is a member of (GC_DESIGN.md,
      # "The last eight bytes"). A *headed* chunk is `HEADER` bytes of
      # word - the type id in its high half, `object_header.cr` says the
      # bits, nothing in its low half - and then the object; a *headless*
      # chunk is the object. Which a chunk is, is a bit in its byte
      # (`HEADED_FLAG`), and the collector's bits are that byte, one per
      # chunk in a table at the arena's head (`META`), never the word: the
      # mark shades and blackens the byte, the sweep reads and restamps
      # the byte, neither touches a live object's line. A headless object
      # of a class the mark needs the layout of carries the class's type
      # id in a second table, sixteen bits a chunk (`LAYOUTS`); an untyped
      # one carries 0 there, and is word-scanned or, atomic, not opened.
      # A 16-byte object costs 16 bytes of chunk, 1 of byte and 2 of
      # layout, 19 where it cost 24 and the three-word header of old 40.
      # A free chunk's link and its batch's chain ride in the chunk, which
      # is nobody's while it is free. `LARGE_USER` is the distance from a
      # large object's node to its user pointer: the node's next and
      # mapped words, then a header, always - a large object has no arena
      # and no byte, and keeps the collector's bits in its word.
      HEADER = 8_u64
      OFF_MARK = 0_u64
      OFF_LINK = 0_u64
      # A free chunk's second word: its index on the grid, written by
      # whoever linked it - the sweep, `thread_warm`, `free` - so the pop
      # stamps its entry and its colour by one load off the line it just
      # read the link from, rather than the grid arithmetic (a multiply,
      # and the arena's header) on every allocation: churn 66 ms to 55.
      # A batch head on the centre keeps its batch's chain here instead
      # (`BATCH_NEXT`), and the refill writes the index back when it
      # takes the batch.
      OFF_INDEX = 8_u64
      TYPE_SHIFT = 32_u64
      # Bit 2: this chunk is on a free list, or idle. Set by the sweep and
      # by `free`, cleared when `take` hands the chunk back out, and what
      # makes "is this chunk free?" one load instead of a walk of the
      # class's list — the O(1) form the root walk's comment said Stage 6
      # could add when a profile asked. The trigger's steady state asked:
      # a sweep over a heap with a long free list was quadratic, seconds
      # per collection where the arithmetic says microseconds.
      FREE_FLAG = 4_u64
      # Bit 3: this allocation is atomic — the caller promised it holds no
      # pointers, which is what `__iyi_malloc_atomic64` means on every
      # allocator. The mark loop honours it the way Boehm honours
      # `GC_malloc_atomic`: an atomic object with no layout is blackened
      # and never word-scanned, because scanning it is where a 32 MiB
      # `Array(Int32)` buffer turned every triggered collection into 20 ms
      # of `base_of` on integers.
      ATOMIC_FLAG = 8_u64
      # Bit 4: the parity of the epoch this chunk was handed out in. What
      # makes the lazy sweep sound: a white chunk stamped with the current
      # epoch's parity was allocated after the mark that this sweep is for,
      # and is alive by construction; one stamped with the last epoch's was
      # unmarked by it and is dead. A surviving object is restamped when the
      # sweep repaints it, so it is the current epoch's from then on.
      EPOCH_FLAG = 16_u64
      # Bit 5: the chunk begins with a header word, the object after it.
      HEADED_FLAG = 32_u64
      # Bit 6: untyped memory - `Pointer.malloc`'s - with no id anywhere,
      # word-scanned by the mark unless atomic. The bit rather than a
      # zero in the layout slot because a slot is two stores on the
      # allocation's path and the bit is in the byte it writes anyway.
      UNTYPED_FLAG = 64_u64
      # Bit 7: the chunk was handed out at least once. Set with every
      # stamp and never cleared, so an entry of zero is a chunk above the
      # frontier - what the mark's inner loop refuses by the entry it
      # reads anyway, rather than by the frontier and the idle bitmap,
      # two words the carve writes beside (`shade_word`).
      CARVED_FLAG = 128_u64
      LARGE_USER = 24_u64
      # The tables at the arena's head, after its header page: three
      # bytes per chunk the mapping could hold (`META`, `META_ENTRY`) -
      # the allocator's flags, then the sixteen-bit type id of a headless
      # object - then a byte per chunk for the mark's colour
      # (`OFF_MARKS`), then the chunk grid on the next page. The flags
      # and the id are one entry because the mark reads both for every
      # object it scans, and a tree's objects are anywhere: one line
      # each, not two. The colour is a table of its own because the
      # allocator writes the entry and the mark's helpers write the
      # colour, and with the two in one byte the carve and the marker
      # fought over a line twenty-one chunks wide for the whole of every
      # concurrent mark (binary trees on eight cores, 152 ms to 172). A
      # chunk's index is `(head - first) / chunk`, done as a multiply by the
      # reciprocal of the chunk size in eights (`MAGIC_SHIFT`): the
      # product fits a word and the quotient is exact for every class,
      # where a divide is thirty cycles on every pop. The grid's origin
      # and the reciprocal are one word of the header's first line
      # (`OFF_GRID`: the origin's offset in the high 24 bits, the
      # reciprocal below) - the line every pop and carve reads anyway;
      # two words further down the page were two more lines on the
      # allocation's path, measured at churn 50 ms to 63.
      META = 4096_u64
      META_ENTRY = 3_u64
      MAGIC_SHIFT = 40_u64
      GRID_SHIFT = 40_u64

      OFF_NEXT = 0_u64
      # At 8 in a large object's node too (`take_large`).
      OFF_MAP = 8_u64
      OFF_CURSOR = 24_u64
      OFF_LEFT = 32_u64
      # Objects the last mark blackened in this arena: zero means nothing
      # in it is reachable, and the pause that marked can hand the mapping
      # back with every thread stopped.
      OFF_LIVE = 48_u64
      # The words set when the arena is mapped and never written again -
      # its chunk, the grid's origin and reciprocal, the mark table's
      # address - on a line of their own: the mark's helpers read them
      # for every pointer they shade, and beside the cursor the carve
      # moves they were fetched again from the carving core's cache at
      # every shade. `OFF_MARKS` is the mark table's address, a byte per
      # chunk, `WHITE` or the mark's colour, after the entries.
      OFF_CHUNK = 1736_u64
      OFF_GRID = 1744_u64
      OFF_MARKS = 1752_u64
      # The carve frontier: no chunk above it was ever handed out, and the
      # sweep walks up to it. The cursor bumps within a region that ends at
      # `OFF_BUMP_END` - the frontier's is the mapping's end; a run of pages
      # the sweep handed back and the carve took up again is a region too.
      # Chunks between the cursor and the region's end are not carved yet.
      OFF_HIGH = 56_u64
      # Idle pages: whole pages of dead chunks on no list, counted, and a
      # bit each at `OFF_PAGES`. A chunk whose head is on such a page is
      # nobody's - not free-listed, not an object - until a run of the
      # pages is taken up again. An idle page is warm (kept resident, its
      # stale bytes still there; the refill threads a run of them into a
      # list) or cold (handed back to the kernel, reads as zero and
      # faults on touch; the carve takes a run of them as its bump
      # region): a bit each at `OFF_COLD`, and the warm ones counted at
      # `OFF_WARM`.
      OFF_IDLE = 72_u64
      # REGION_SLAB while the bump region is a slab of the frontier,
      # REGION_COLD while it is a run of cold pages taken up again,
      # REGION_SLAB_STAY a slab to be carved to its end before the class's
      # warm pages are looked for again (`reopen_pages`).
      OFF_REGION_REOPENED = 80_u64
      # The cache whose fill arena this is, or 0: a bump region is one
      # thread's, carved without a lock, so an arena is one cache's at a
      # time, claimed under the lock when a region is set in it and let
      # go when the cache moves to another.
      OFF_OWNER = 88_u64
      # 1 while an allocator's sweep walks this arena outside the runtime
      # lock: no region is set in it until the walk is over, because the
      # walk reads the region's bounds as two words and a pair from two
      # regions could name an uncarved chunk as carved.
      OFF_SWEEPING = 96_u64
      # Where this epoch's sweep of the arena got to: the next chunk head
      # to look at, SWEEP_DONE once it reached the high water, accurate
      # whenever no slice of the arena is in flight.
      OFF_SWEEP_CURSOR = 104_u64
      SWEEP_DONE = 0xFFFFFFFFFFFFFFFF_u64
      # The epoch whose finished sweep of this arena has been counted out.
      # The entry of the chunk at the bump cursor: set with the region,
      # moved with the cursor, so the carve stamps by one load off the
      # line it reads the cursor from (`OFF_INDEX` says why not the grid
      # arithmetic).
      OFF_CURSOR_BYTE = 112_u64
      OFF_WARM = 120_u64
      # A bit per page of the mapping, `MAP / PAGE / 8` bytes - 512 on a
      # 4 KB page - for idle, and the same again for cold.
      OFF_PAGES = 128_u64
      OFF_COLD = 640_u64
      # Listed pages: whole pages of dead chunks this epoch's sweep kept
      # warm and left on its batch, the batch being the fast way to hand
      # them out. Counted here and a bit each at `OFF_LISTED_PAGES`. A
      # refill that takes a batch unlists the batch's pages - their chunks
      # are being allocated - and the pause, which drops every list, turns
      # what is still listed into idle warm pages (`idle_listed`): the
      # kept pages the program did not get to survive the pause that way,
      # where a list does not.
      OFF_LISTED = 1160_u64
      OFF_LISTED_PAGES = 1168_u64
      OFF_SWEEP_COUNTED = 1688_u64
      OFF_BUMP_END = 1696_u64
      # The first chunk head, page-aligned past the tables; the layout
      # table's address; the reciprocal of the chunk size in eights.
      # The collection this arena was last swept for (`IyiMark.epoch`): an
      # arena behind the current epoch still holds the last mark's colours
      # and is sweep debt, paid by the allocator that needs its chunks.
      OFF_EPOCH = 1152_u64
      # The frontier is carved a slab at a time, so that a run of pages
      # handed back below it is taken up before the slab after it: the
      # heap fills from its low addresses and the frontier stays cold. A
      # class whose chunk is bigger than a slab carves one chunk at a time.
      SLAB = 65536_u64

      def self.slab_for(chunk : UInt64) : UInt64
        chunk > SLAB ? chunk : SLAB
      end

      # The chunk grid's first head, past the header page and the tables.
      def self.arena_first(arena : UInt64) : UInt64
        arena + read64(arena + OFF_GRID).unsafe_shr(GRID_SHIFT)
      end

      # A chunk's index on the grid, by the arena's reciprocal: exact for
      # `head - first` below the mapping's size and every class's chunk.
      def self.chunk_index(arena : UInt64, address : UInt64) : UInt64
        grid = read64(arena + OFF_GRID)
        ((address - arena - grid.unsafe_shr(GRID_SHIFT)).unsafe_shr(3_u64) * (grid & (1_u64.unsafe_shl(GRID_SHIFT) - 1_u64))).unsafe_shr(MAGIC_SHIFT)
      end

      # The chunk head an address falls in.
      def self.head_of(arena : UInt64, address : UInt64) : UInt64
        arena_first(arena) + chunk_index(arena, address) * read64(arena + OFF_CHUNK)
      end

      # A chunk's entry byte, and its layout slot - the two bytes after
      # it - from any address in it; and its colour byte.
      def self.meta(arena : UInt64, address : UInt64) : UInt64
        arena + META + chunk_index(arena, address) * META_ENTRY
      end

      def self.mark_byte(arena : UInt64, address : UInt64) : UInt64
        read64(arena + OFF_MARKS) + chunk_index(arena, address)
      end

      def self.layout_slot(arena : UInt64, address : UInt64) : UInt64
        meta(arena, address) + 1_u64
      end

      # An object's entry byte, or 0 for one no arena holds - a large
      # object's bits are in its header word; and its colour byte.
      def self.meta_of(base : UInt64) : UInt64
        arena = arena_of(base)
        return 0_u64 if arena == 0
        meta(arena, base)
      end

      def self.mark_byte_of(base : UInt64) : UInt64
        arena = arena_of(base)
        return 0_u64 if arena == 0
        mark_byte(arena, base)
      end

      def self.read8(address : UInt64) : UInt64
        Pointer(UInt8).new(address).value.to_u64
      end

      def self.write8(address : UInt64, value : UInt64) : Nil
        Pointer(UInt8).new(address).value = value.to_u8!
      end

      # Sixteen bits as two bytes: the prelude's integers stop at
      # `UInt8` below the word (`primitives.iyi`), and a slot is written
      # once and read by the mark.
      def self.read16(address : UInt64) : UInt64
        read8(address) | read8(address + 1_u64).unsafe_shl(8_u64)
      end

      def self.write16(address : UInt64, value : UInt64) : Nil
        write8(address, value & 0xFF_u64)
        write8(address + 1_u64, value.unsafe_shr(8_u64) & 0xFF_u64)
      end

      # ── Whose state is whose ──────────────────────────────────────────
      #
      # The allocator was one thread's class variables — the directory
      # page of free-list heads and fill arenas — and the thread floor named
      # that as the first cost of a second thread (GC_DESIGN.md). It is two
      # things now, and the split is Go's: a **cache per thread** and a
      # **centre** everything else shares.
      #
      # The cache is one page a `@[ThreadLocal]` address names — `Tls.line`
      # in the probe, the scheduler's state pointer here — laid out as the
      # directory was: a free-list head per class at `[index]`, the class's
      # fill arena at `[FILL + index]`, and word `CACHE_NEXT` linking every
      # cache ever made from `@@caches`, so the sweep's scavenge can strip
      # all of them and a stopped thread's cache is reachable by the thread
      # that stops it. The fast path — pop the cache's list, or carve the
      # cache's own arena — takes no lock and touches no shared word; what
      # it costs is one thread-local read per allocation, and
      # `bench/arena_exercise.sh` prints the number.
      #
      # The centre is the class free lists the sweep fills, the arena list
      # and the large list, behind one spin lock (`CENTRAL_LOCK`, a word on
      # the centre's page, taken with the prelude's `Atomic`). A cache that
      # runs dry takes the lock and takes the class's whole central list —
      # one pointer swap, the same cost as today with one thread; a bounded
      # batch is the fairness a profile with two threads may ask for, and
      # it is not guessed here. `map_arena` and `take_large` push under the
      # lock; `free` pushes to the centre under it, and the sweep frees an
      # arena's chunks as one batch under one take of it.
      #
      # What this decides for Stage 4, said now: a thread stopped while it
      # holds `CENTRAL_LOCK` — inside a refill, a carve that maps, a free —
      # deadlocks a sweep that needs the lock. So the stop handler must not
      # park a thread that holds it: the lock word is the thread's own to
      # check, and a held lock defers the park to the release, which is
      # Go's "no preemption inside mallocgc". One thread never contends,
      # and the lock is one uncontended `compare_and_set` per refill.
      # The cache page past its two tables: the link, the pressure slice
      # (bytes this cache allocated since it last told the trigger), and
      # the two words the stop reads and writes — set while the thread is
      # inside `take`, and the request a handler leaves when it finds it
      # there. The centre's page past its table: the allocated-since count
      # every cache folds its slice into, an atomic, and the trigger's.
      CACHE_NEXT    = 1280_u64
      CACHE_SLICE   = 1288_u64
      CACHE_INSIDE  = 1296_u64
      CACHE_REQUEST = 1304_u64
      SLICE         = 65536_u64
      CENTRAL_ALLOCATED = 1280_u64

      @[ThreadLocal]
      @@cache : UInt64 = 0_u64
      @@caches : UInt64 = 0_u64
      @@central : UInt64 = 0_u64
      @@arenas : UInt64 = 0_u64
      @@large : UInt64 = 0_u64

      def self.read64(address : UInt64) : UInt64
        Pointer(UInt64).new(address).value
      end

      def self.write64(address : UInt64, value : UInt64) : Nil
        Pointer(UInt64).new(address).value = value
      end

      # This thread's cache, mapped on first touch and linked for the
      # scavenge before the thread-local names it.
      def self.cache : Pointer(UInt64)
        page = @@cache
        if page == 0
          page = __iyi_mmap(DIR_LEN).address
          lock
          # The shared pages, made under the same lock the first time any
          # thread reaches the heap: two threads' first allocations would
          # otherwise each map a centre of their own.
          @@central = __iyi_mmap(DIR_LEN).address if @@central == 0
          arena_dir
          write64(page + CACHE_NEXT, @@caches)
          @@caches = page
          unlock
          @@cache = page
        end
        Pointer(UInt64).new(page)
      end

      def self.first_cache : UInt64
        @@caches
      end

      def self.cache_next(page : UInt64) : UInt64
        read64(page + CACHE_NEXT)
      end

      # A thread's last act with the heap: its cache's lists go to the
      # centre as batches, its fill arenas are let go (they stay on the
      # heap's list and are the scavenge's from now on, no longer anyone's
      # warm cushion), the page leaves the caches list, and the thread
      # allocates nothing after. A cache left behind pinned an arena per
      # class forever and cost every later sweep a walk of it.
      def self.retire_cache : Nil
        page = @@cache
        return if page == 0
        table = Pointer(UInt64).new(page)
        lock
        index = 0
        while index < FILL
          head = table[index]
          if head != 0
            free_batch(index, head)
            table[index] = 0_u64
          end
          fill = table[FILL + index]
          write64(fill + OFF_OWNER, 0_u64) if fill != 0 && read64(fill + OFF_OWNER) == page
          table[FILL + index] = 0_u64
          index = index + 1
        end
        previous = 0_u64
        cursor = @@caches
        while cursor != 0
          following = read64(cursor + CACHE_NEXT)
          if cursor == page
            if previous == 0
              @@caches = following
            else
              write64(previous + CACHE_NEXT, following)
            end
            break
          end
          previous = cursor
          cursor = following
        end
        unlock
        @@cache = 0_u64
        __iyi_munmap(page, DIR_LEN)
      end

      # The stop's view of this thread, read from a signal handler: a
      # thread with no cache yet has never been inside the allocator.
      def self.in_allocator? : Bool
        page = @@cache
        page != 0 && read64(page + CACHE_INSIDE) != 0
      end

      # The same two questions, asked about a named cache rather than this
      # thread's, which is what Windows needs: a stop there is
      # `SuspendThread` and not a handler running on the thread itself, so
      # a suspended thread cannot answer for itself. The thread that
      # stopped it reads the cache the stopped thread published on its line
      # and, finding a `take` half done, leaves the request there and lets
      # it run on — a chunk live in a register the scan has no name for, or
      # the centre's lock held against the sweep, is the same hazard the
      # POSIX handler refuses to park into. The park happens at `leave`,
      # where a deferred stop is always paid.
      def self.cache_inside?(page : UInt64) : Bool
        page != 0 && read64(page + CACHE_INSIDE) != 0
      end

      def self.request_stop_at(page : UInt64) : Nil
        write64(page + CACHE_REQUEST, 1_u64)
      end

      # This thread's cache page, for a thread that wants to publish it
      # where another thread can find it.
      def self.cache_page : UInt64
        cache.address
      end

      def self.request_stop : Nil
        write64(@@cache + CACHE_REQUEST, 1_u64)
      end

      def self.stop_requested? : Bool
        page = @@cache
        page != 0 && read64(page + CACHE_REQUEST) != 0
      end

      def self.clear_request : Nil
        write64(@@cache + CACHE_REQUEST, 0_u64)
      end

      def self.central : Pointer(UInt64)
        if @@central == 0
          @@central = __iyi_mmap(DIR_LEN).address
        end
        Pointer(UInt64).new(@@central)
      end

      # How many arenas of a class have sweeping left this epoch, on the
      # centre's page past the lists: the allocator's answer without the
      # lock to whether a slice of the class is worth taking. Written
      # under the lock, read without it - a stale nonzero takes the lock
      # and finds nothing, a stale zero carves a chunk a sweep would have
      # handed back later.
      SWEEP_LEFT_AT = 256

      def self.sweep_left_of(index : Int32) : UInt64
        central[SWEEP_LEFT_AT + index]
      end

      def self.sweep_left_add(index : Int32, delta : Int64) : Nil
        centre = central
        centre[SWEEP_LEFT_AT + index] = (centre[SWEEP_LEFT_AT + index].to_i64 + delta).to_u64
      end

      # How many warm idle pages the class's arenas hold, past the sweep
      # counts: a refill that finds the centre empty reads it without the
      # lock and, finding some, carves rather than sweeps - the pages are
      # what the sweep already produced, and a slice taken for them would
      # hand back their edges and nothing else. Added by the sweep outside
      # the lock, so an atomic; a stale zero sweeps a slice it need not
      # have, a stale nonzero finds the run gone and moves on.
      WARM_AT = 384

      def self.warm_word(index : Int32) : Pointer(Atomic(UInt64))
        Pointer(Atomic(UInt64)).new(central.address + (WARM_AT + index).to_u64 * 8_u64)
      end

      def self.warm_of(index : Int32) : UInt64
        warm_word(index).value.get
      end

      def self.allocated_word : Pointer(Atomic(UInt64))
        Pointer(Atomic(UInt64)).new(central.address + CENTRAL_ALLOCATED)
      end

      def self.lock : Nil
        IyiRuntimeLock.lock
      end

      def self.unlock : Nil
        IyiRuntimeLock.unlock
      end

      # The class a request lands in. Eight-byte steps to 128 are a shift;
      # above, the doubling is found by a loop and the quarter within it
      # by a division. Power-of-two classes wasted up to half a chunk on
      # every object between two of them - a 24-byte object, two pointers
      # behind its type id, the commonest shape a program has, in a
      # 32-byte class - and these cap the waste at eight bytes below 128
      # and a fifth above.
      def self.class_index(size : UInt64) : Int32
        return ((size + 7_u64).unsafe_shr(3_u64).to_i64 - 2_i64).to_i32 if size > 16_u64 && size <= 128_u64
        return 0 if size <= 16_u64
        base = 128_u64
        index = 15
        while base + base < size
          base = base + base
          index = index + 4
        end
        step = base.unsafe_shr(2_u64)
        index + ((size - base + step - 1_u64).unsafe_div(step)).to_i64.to_i32 - 1
      end

      # A class's chunk: sixteen bytes and eight-byte steps to 128, then
      # four to each doubling. A headed object of `size` bytes takes the
      # class of `size + HEADER`, a headless one the class of `size`.
      def self.chunk_of(index : Int32) : UInt64
        return (index.to_i64 + 2_i64).to_u64 * 8_u64 if index < 15
        above = (index - 15).to_i64.to_u64
        base = 128_u64.unsafe_shl(above.unsafe_shr(2_u64))
        base + ((above & 3_u64) + 1_u64) * base.unsafe_shr(2_u64)
      end

      # Untyped memory, `Pointer.malloc`'s and the like: headless and
      # flagged untyped, so the mark word-scans it, or, atomic, never
      # opens it. A 4096-byte buffer is a 4096-byte chunk. Past the top
      # class it is a mapping and headed, the word its bits' home.
      def self.alloc(size : UInt64) : Void*
        Pointer(Void).new(take(size, true, UNTYPED_FLAG, 0_u64))
      end

      def self.alloc_atomic(size : UInt64) : Void*
        Pointer(Void).new(take(size, false, UNTYPED_FLAG | ATOMIC_FLAG, 0_u64))
      end

      # A class's instance: headed when the class's `:headed` byte says so
      # - the program that links decides, `gc_layouts.cr` - and its type
      # id stored under it then; headless otherwise, the id in the arena's
      # layout table for the mark. Atomic when the class has no pointer
      # field: not cleared here, codegen zeroes what it does not
      # initialise, and never opened by the mark. Answers the object.
      def self.new_object(size : UInt64, type_id : UInt64, headed : Bool, atomic : Bool) : Void*
        # Past the top class the object is a mapping of its own, and
        # headed whatever the class said: no arena, no table.
        headed = true if size > TOP - HEADER
        base = take(size, !atomic, (headed ? HEADED_FLAG : 0_u64) | (atomic ? ATOMIC_FLAG : 0_u64), type_id)
        # A headless object's id went into its entry with the stamp
        # (`take_inside`); a headed one's goes in the word's high half,
        # the low half kept: a large object's bits live there.
        write64(base - HEADER, (read64(base - HEADER) & 0xFFFFFFFF_u64) | type_id.unsafe_shl(TYPE_SHIFT)) if headed
        Pointer(Void).new(base)
      end

      # The one funnel. The cache page's INSIDE word is set for the whole
      # of it, so a stop that lands in here is deferred to the exit rather
      # than taken between reading a list's head and popping it, and the
      # exit is where a deferred stop is paid. The pressure report is a
      # slice: this cache's bytes since it last told the trigger, folded
      # into the centre's atomic count every SLICE bytes, so a thread's
      # allocations cost no shared write until then.
      # `bits` are the chunk's entry less its parity: headed, untyped,
      # atomic (`clear` false is the same promise, worn the other way: the
      # path that does not clear is the path that holds no pointers);
      # `type_id` goes into the entry beside them for a headless typed
      # object, and is the caller's to store for a headed one.
      def self.take(size : UInt64, clear : Bool, bits : UInt64, type_id : UInt64) : UInt64
        table = cache
        # The arithmetic on the way in and out is wrapping: a counter on
        # a page cannot overflow, and a checked add is a branch each on
        # the path every allocation takes.
        write64(table.address + CACHE_INSIDE, read64(table.address + CACHE_INSIDE) &+ 1_u64)
        slice = read64(table.address + CACHE_SLICE) &+ size
        if slice >= SLICE
          write64(table.address + CACHE_SLICE, 0_u64)
          # Before the carve: a collection triggered here cannot sweep the
          # object about to be born, because it does not exist yet, and
          # everything already born is reachable or fair game. Under a
          # mark, a slice's worth of allocation buys a slice's worth of
          # marking on this thread first - the assist.
          if LibIyiGCTable.__iyi_marking != 0_u8
            IyiMark.assist
          else
            IyiMark.pressure(slice)
          end
        else
          write64(table.address + CACHE_SLICE, slice)
        end
        base = take_inside(table, bits & HEADED_FLAG != 0 ? size &+ HEADER : size, clear, bits, type_id)
        # Born while a mark runs beside the program: black, and counted
        # alive in its arena, by the bytes asked for - the chunk's waste
        # is a second lookup of the entry on every allocation under a
        # mark, for a budget that is a floor and a ratio.
        IyiMark.born_during_mark(base, size) if LibIyiGCTable.__iyi_marking != 0_u8
        leave(table)
        base
      end

      # Out of the allocator, or the barrier: the depth counter down, and
      # a stop that was deferred while it was up is paid now.
      def self.leave(table : Pointer(UInt64)) : Nil
        write64(table.address + CACHE_INSIDE, read64(table.address + CACHE_INSIDE) &- 1_u64)
        {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
          if read64(table.address + CACHE_INSIDE) == 0_u64 && read64(table.address + CACHE_REQUEST) != 0
            IyiThread.park_if_requested
          end
        {% end %}
      end

      # The write barrier's bracket (GC_DESIGN.md Stage 9), the same depth
      # counter the allocator uses: a thread between a pointer store and
      # the barrier that shades it is not parked where it stands, or the
      # final stop's rescan could miss what the store just put into a
      # black object.
      def self.enter_barrier : Nil
        table = cache
        write64(table.address + CACHE_INSIDE, read64(table.address + CACHE_INSIDE) + 1_u64)
      end

      def self.leave_barrier : Nil
        leave(cache)
      end

      # `bytes` is the chunk asked for - the object and its header word
      # when it has one. Answers the object: the chunk's head, or the word
      # after it. A large object is always headed, its bits in that word.
      def self.take_inside(table : Pointer(UInt64), bytes : UInt64, clear : Bool, bits : UInt64, type_id : UInt64) : UInt64
        headed = bits & HEADED_FLAG != 0
        # Past the top class: a mapping of its own, headed either way -
        # no arena, no byte, no slot - and `size_of` reads the node.
        return take_large(headed ? bytes - HEADER : bytes, clear) + HEADER if bytes > TOP
        # The small classes' index inline: `class_index` has a loop for
        # the large ones and is a call, and a call is what most
        # allocations would pay for a shift.
        index = bytes <= 128_u64 ? (bytes <= 16_u64 ? 0 : ((bytes &+ 7_u64).unsafe_shr(3_u64).to_i64 &- 2_i64).to_i32) : class_index(bytes)
        head = table[index]
        head = refill(table, index) if head == 0
        if head != 0
          table[index] = read64(head &+ OFF_LINK)
          # The chunk's byte: this epoch's, white, atomic when the caller
          # promised no pointers - `clear` is the atomic question worn the
          # other way - and headed when it has a word. The epoch's parity
          # is read here, after the refill: a refill takes the lock, and
          # the lock's spin parks for a pause, whose sweep turns the
          # epoch - a parity read before it stamped the chunk as the last
          # epoch's, and the next sweep freed it under its owner. A list
          # chunk is in an arena by construction, the mask names it. The
          # clearing path clears the whole chunk, header word and all: a
          # stale type id in the word is a layout the mark would trust;
          # an atomic chunk is never opened, and its word is left until
          # codegen stores.
          arena = head & (0_u64 &- MAP)
          slot = read64(head &+ OFF_INDEX)
          byte = arena + META + slot * META_ENTRY
          write8(byte, bits | CARVED_FLAG | IyiMark.epoch_flag)
          write16(byte + 1_u64, type_id) if bits & (UNTYPED_FLAG | HEADED_FLAG) == 0
          clear_block(head, chunk_of(index)) if clear
          return headed ? head &+ HEADER : head
        end
        head = carve(table, index, bits, type_id)
        headed ? head &+ HEADER : head
      end

      # The cache's list for this class is empty: take the centre's top
      # batch for it, under the lock — one arena's sweep, `free_batch`
      # says why one. Answers the new head, 0 if the centre had nothing
      # and the carve is next.
      def self.refill(table : Pointer(UInt64), index : Int32) : UInt64
        centre = central
        if centre[index] == 0
          # Nothing swept for this class yet. A bump region of cold pages
          # in hand, or a slab to be carved to its end, is carved. Warm
          # idle pages of the class are the sweep's produce already,
          # resident and nobody's: with any in reach, a run of them is
          # threaded into the cache's list, no slice waited for. Otherwise
          # a slice of an arena of the class, and another, until a batch
          # of the class appears, warm pages come into reach, or the
          # class has nothing left to sweep - the sweep's cost lands on
          # the allocations that need its chunks rather than inside the
          # pause (GC_DESIGN.md), and a chunk swept is cheaper than one
          # carved, a page faulted in costing what a hundred sweep. A
          # helper inside a slice of the only arena of the class answers
          # busy: its batch is microseconds away, and the wait is for
          # that. With helpers at a round the class is named for them.
          arena = table[FILL + index]
          region = arena == 0 || read64(arena + OFF_LEFT) == 0 ? REGION_SLAB : read64(arena + OFF_REGION_REOPENED)
          return 0_u64 if region != REGION_SLAB
          if warm_of(index) != 0_u64
            head = thread_warm_of(index)
            if head != 0
              table[index] = head
              return head
            end
            # Warm pages out of reach - inside a slice, or none below its
            # window - with a slab in hand: the slab is carved to its end
            # before they are asked for again, or every allocation would
            # take the lock to find them out of reach.
            write64(arena + OFF_REGION_REOPENED, REGION_SLAB_STAY) if arena != 0 && read64(arena + OFF_LEFT) != 0
          end
          IyiMark.sweep_wanted(index) if IyiMark.helpers_sweeping?
          chunk = chunk_of(index)
          while centre[index] == 0 && sweep_left_of(index) != 0_u64
            answer = IyiMark.sweep_one(chunk)
            break if answer == 0_u64
            if answer == 2_u64
              # Every arena of the class is inside another thread's
              # slice: its batch lands within the slice, microseconds,
              # and the wait for it is off the lock. Carving instead was
              # tried and costs: a fresh page is a fault where a swept
              # chunk is free, and churn - whose every refill meets a
              # helper mid-slice - ran 40 ms to 59.
              spins = 0
              while centre[index] == 0 && spins < 256
                IyiMark.spin_pause
                spins = spins + 1
              end
            end
            # A slice of this thread's or another's may have left warm
            # pages in reach.
            if centre[index] == 0 && warm_of(index) != 0_u64
              head = thread_warm_of(index)
              if head != 0
                table[index] = head
                return head
              end
            end
          end
          return 0_u64 if centre[index] == 0
        end
        lock
        head = centre[index]
        # The batch's whole pages are being allocated from now: unlisted,
        # or the pause would turn them idle with objects on them.
        if head != 0
          # The batch's page range off its head's two words, then the
          # words as the pop and the byte stamp want them.
          arena = head & (0_u64 &- MAP)
          link = read64(head + OFF_LINK)
          chain = read64(head + BATCH_NEXT)
          unlist_batch(arena, link.unsafe_shr(RANGE_SHIFT), chain.unsafe_shr(RANGE_SHIFT))
          centre[index] = chain & LOW48
          write64(head + OFF_LINK, link & LOW48)
          write64(head + OFF_INDEX, chunk_index(arena, head))
        end
        unlock
        table[index] = head
        head
      end

      # The class's first warm run in reach, as a list: the arenas of the
      # class walked under the lock, any of them - a list is the cache's
      # and needs no claim on the arena. Answers the list's head, 0 for
      # none in reach.
      def self.thread_warm_of(index : Int32) : UInt64
        chunk = chunk_of(index)
        head = 0_u64
        lock
        candidate = @@arenas
        while candidate != 0 && head == 0
          head = thread_warm(candidate) if read64(candidate + OFF_CHUNK) == chunk && read64(candidate + OFF_WARM) != 0
          candidate = read64(candidate + OFF_NEXT)
        end
        unlock
        head
      end

      def self.carve(table : Pointer(UInt64), index : Int32, bits : UInt64, type_id : UInt64) : UInt64
        arena = table[FILL + index]
        if arena == 0 || read64(arena + OFF_LEFT) == 0 ||
           (read64(arena + OFF_REGION_REOPENED) == REGION_SLAB && read64(arena + OFF_IDLE) != read64(arena + OFF_WARM))
          # The region ran out, or it is a frontier slab and pages below
          # it went cold: the lowest run of cold pages in this arena or
          # another of the class, then the frontier's next slab, then a
          # fresh mapping. Warm pages are the refill's, as a list.
          arena = reopen_pages(table, arena, index)
          table[FILL + index] = arena
        end
        cursor = read64(arena + OFF_CURSOR)
        # The chunk's byte before the cursor moves past it, and the cursor
        # as an ordered store: a lazy sweeper on another thread reads the
        # cursor and then the chunks below it, and a chunk it can see must
        # already wear this epoch's parity or it would read as last
        # epoch's dead — freed under the thread about to hand it out. The
        # parity is read here, past `reopen_pages` and its lock (the
        # refill's comment). The chunk's memory is the kernel's zero: a
        # region is a frontier slab or a cold run, warm runs being lists.
        byte = read64(arena + OFF_CURSOR_BYTE)
        write8(byte, bits | CARVED_FLAG | IyiMark.epoch_flag)
        write64(arena + OFF_CURSOR_BYTE, byte &+ META_ENTRY)
        write16(byte + 1_u64, type_id) if bits & (UNTYPED_FLAG | HEADED_FLAG) == 0
        following = cursor &+ read64(arena + OFF_CHUNK)
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.set(following)
        write64(arena + OFF_LEFT, read64(arena + OFF_LEFT) &- 1_u64)
        write64(arena + OFF_HIGH, following) if following > read64(arena + OFF_HIGH)
        cursor
      end

      # ── Pages gone idle, and taken up again ────────────────────────────
      #
      # A collector that frees chunks but never pages has a resident size
      # that is its high-water mark: binary trees held 6 MB live in 55 MB
      # resident. The sweep finds runs of whole dead pages (`sweep_slice`
      # below): a budget's worth stay warm - on the sweep's batch, the
      # allocator's fast path, their pages listed - and the rest go back
      # to the kernel cold, idle. A pause drops every list, and what was
      # listed and not taken becomes idle too, warm: the refill threads a
      # warm run into the cache's list before it sweeps a slice or carves
      # a slab (`thread_warm`), and the carve takes a cold run up as its
      # bump region before it touches the frontier (`reopen_in`). A chunk
      # is on an idle page when its head is: such a chunk is on no list
      # and is no object - a cold page reads as zero, a warm one still
      # wears the free flag the sweep set - and the mark, the sweep and
      # the root walk all refuse it by the bit.
      #
      # Idle rather than list chunks across the pause because the lists
      # do not survive one and the bits do: a budget's worth of warm
      # chunks kept on the lists was gone at the next collection, and the
      # program carved the frontier while it waited for the sweep to hand
      # the same pages back a second time. Kept as bump regions instead
      # of lists within an epoch, the warm pages cost the carve's ordered
      # cursor store and a refill's loads per allocation, and threading
      # them into a list on the spot was a pass over memory the sweep had
      # just made: churn ran 48 ms to 73 and to 67. The batch is the
      # sweep's pass and the list's pop, and the bits are the pause's.
      def self.page_bit?(arena : UInt64, table : UInt64, address : UInt64) : Bool
        page = (address - arena).unsafe_shr(PAGE_SHIFT)
        word = read64(arena + table + page.unsafe_shr(6_u64) * 8_u64)
        word & 1_u64.unsafe_shl(page & 63_u64) != 0
      end

      def self.page_idle?(arena : UInt64, address : UInt64) : Bool
        page_bit?(arena, OFF_PAGES, address)
      end

      def self.page_cold?(arena : UInt64, address : UInt64) : Bool
        page_bit?(arena, OFF_COLD, address)
      end

      # The bits of `[low, high)` in the table at `table`, set or cleared,
      # a word at a time. The sweep sets bits of pages at and above its
      # slice's cursor while the carve clears bits of pages below the
      # sixty-four-page word that cursor is in (`reopen_in`), so the two
      # never share a word and neither needs the other's lock.
      def self.set_page_bits(arena : UInt64, table : UInt64, low : UInt64, high : UInt64, on : Bool) : Nil
        page = (low - arena).unsafe_shr(PAGE_SHIFT)
        stop = (high - arena).unsafe_shr(PAGE_SHIFT)
        while page < stop
          slot = arena + table + page.unsafe_shr(6_u64) * 8_u64
          upto = (page | 63_u64) + 1_u64
          upto = stop if upto > stop
          # The bits from `page & 63` to `upto - 1 - (page & ~63)`, inclusive.
          mask = upto - (page & 0xFFFFFFFFFFFFFFC0_u64) == 64_u64 ? 0xFFFFFFFFFFFFFFFF_u64 : 1_u64.unsafe_shl(upto & 63_u64) - 1_u64
          mask = mask - (1_u64.unsafe_shl(page & 63_u64) - 1_u64)
          if on
            write64(slot, read64(slot) | mask)
          else
            write64(slot, read64(slot) & (0xFFFFFFFFFFFFFFFF_u64 - mask))
          end
          page = upto
        end
      end

      def self.set_idle(arena : UInt64, low : UInt64, high : UInt64, on : Bool) : Nil
        set_page_bits(arena, OFF_PAGES, low, high, on)
      end

      def self.set_cold(arena : UInt64, low : UInt64, high : UInt64, on : Bool) : Nil
        set_page_bits(arena, OFF_COLD, low, high, on)
      end

      # The arena's idle and warm counts, and the class's warm count on
      # the centre, moved together: the sweep adds outside the lock and
      # the carve subtracts under it, so all three are atomic.
      def self.idle_add(arena : UInt64, pages : UInt64, warm : Bool) : Nil
        Pointer(Atomic(UInt64)).new(arena + OFF_IDLE).value.add(pages)
        if warm
          Pointer(Atomic(UInt64)).new(arena + OFF_WARM).value.add(pages)
          warm_word(class_index(read64(arena + OFF_CHUNK))).value.add(pages)
        end
      end

      def self.idle_sub(arena : UInt64, pages : UInt64, warm : Bool) : Nil
        Pointer(Atomic(UInt64)).new(arena + OFF_IDLE).value.sub(pages)
        warm_sub(arena, pages) if warm
      end

      def self.warm_sub(arena : UInt64, pages : UInt64) : Nil
        Pointer(Atomic(UInt64)).new(arena + OFF_WARM).value.sub(pages)
        warm_word(class_index(read64(arena + OFF_CHUNK))).value.sub(pages)
      end

      def self.page_listed?(arena : UInt64, address : UInt64) : Bool
        page_bit?(arena, OFF_LISTED_PAGES, address)
      end

      # The listed bitmap's words are shared: a slice lists pages of one
      # run while a refill unlists a batch of the slice before it, and
      # two adjacent slices' pages sit in one sixty-four-page word. So
      # the bits are set and cleared with a compare-and-set.
      def self.set_listed(arena : UInt64, low : UInt64, high : UInt64, on : Bool) : Nil
        page = (low - arena).unsafe_shr(PAGE_SHIFT)
        stop = (high - arena).unsafe_shr(PAGE_SHIFT)
        while page < stop
          slot = Pointer(Atomic(UInt64)).new(arena + OFF_LISTED_PAGES + page.unsafe_shr(6_u64) * 8_u64)
          upto = (page | 63_u64) + 1_u64
          upto = stop if upto > stop
          mask = upto - (page & 0xFFFFFFFFFFFFFFC0_u64) == 64_u64 ? 0xFFFFFFFFFFFFFFFF_u64 : 1_u64.unsafe_shl(upto & 63_u64) - 1_u64
          mask = mask - (1_u64.unsafe_shl(page & 63_u64) - 1_u64)
          while true
            seen = slot.value.get
            want = on ? seen | mask : seen & (0xFFFFFFFFFFFFFFFF_u64 - mask)
            break if seen == want || slot.value.compare_and_set(seen, want)[1]
          end
          page = upto
        end
      end

      # A run of whole pages of dead chunks kept warm on the sweep's batch:
      # listed, its count up.
      def self.list_pages(arena : UInt64, low : UInt64, high : UInt64) : Nil
        set_listed(arena, low, high, true)
        Pointer(Atomic(UInt64)).new(arena + OFF_LISTED).value.add((high - low).unsafe_shr(PAGE_SHIFT))
      end

      # A batch's page range, stashed in the high sixteen bits of its
      # head's two words - the link and the chain are addresses, and an
      # address has 48 - because a 16-byte chunk has no third word and a
      # walk of the batch for its pages was a pass over memory the
      # allocation is about to touch, measured at churn 50 ms to 62. The
      # refill reads the range back and cleans both words.
      LOW48 = 0xFFFFFFFFFFFF_u64
      RANGE_SHIFT = 48_u64

      def self.stash_batch_range(head : UInt64, arena : UInt64, low : UInt64, high : UInt64) : Nil
        low_page = (low - arena).unsafe_shr(PAGE_SHIFT)
        high_page = (high - arena).unsafe_shr(PAGE_SHIFT)
        write64(head + OFF_LINK, (read64(head + OFF_LINK) & LOW48) | low_page.unsafe_shl(RANGE_SHIFT))
        write64(head + BATCH_NEXT, (read64(head + BATCH_NEXT) & LOW48) | high_page.unsafe_shl(RANGE_SHIFT))
      end

      # A batch taken by a cache, under the lock: its pages are being
      # allocated from and are nobody's whole pages any more - unlisted,
      # so the pause does not turn them idle with objects on them.
      def self.unlist_batch(arena : UInt64, page : UInt64, last : UInt64) : Nil
        return if read64(arena + OFF_LISTED) == 0
        count = 0_u64
        while page <= last
          if page_listed?(arena, arena + page * PAGE)
            set_listed(arena, arena + page * PAGE, arena + (page + 1_u64) * PAGE, false)
            count = count + 1_u64
          end
          page = page + 1_u64
        end
        Pointer(Atomic(UInt64)).new(arena + OFF_LISTED).value.sub(count) if count != 0
      end

      # In the pause, every list dropped: what the sweep listed and no
      # cache took is idle and warm from here - the bits moved, the
      # counts with them - and the carve's refill threads it into a list
      # again when the class needs it (`thread_warm`).
      def self.idle_listed(arena : UInt64) : Nil
        count = read64(arena + OFF_LISTED)
        return if count == 0
        words = read64(arena + OFF_MAP).unsafe_shr(PAGE_SHIFT + 6_u64)
        slot = 0_u64
        while slot < words
          listed = read64(arena + OFF_LISTED_PAGES + slot * 8_u64)
          if listed != 0
            write64(arena + OFF_PAGES + slot * 8_u64, read64(arena + OFF_PAGES + slot * 8_u64) | listed)
            write64(arena + OFF_LISTED_PAGES + slot * 8_u64, 0_u64)
          end
          slot = slot + 1_u64
        end
        write64(arena + OFF_LISTED, 0_u64)
        idle_add(arena, count, true)
      end

      # `arena`'s own cold runs first, then its frontier's next slab, then
      # any other arena of the class with cold runs or frontier left, then
      # a fresh mapping. Answers the arena whose region the carve now
      # bumps in. Warm runs are not the carve's: the refill threads them
      # into the cache's list (`thread_warm`).
      # The whole choice is one take of the lock: the lock's spin parks
      # for a pause, whose scavenge hands arenas back, so an arena read
      # off the list outside the lock is not an arena to trust across a
      # take of it - the first cut walked the list between takes and
      # crashed reading an arena the pause had unmapped.
      # A warm run inside a sweep's slice is out of reach for the slice,
      # some ten microseconds: a slab taken with warm pages still out of
      # reach is carved to its end before the class's warm pages are
      # looked for again (`REGION_SLAB_STAY`), or every allocation would
      # take the lock to find them out of reach again. The refill is
      # where the waiting is done, by sweeping a slice of its own or
      # spinning for a helper's, and it looks for warm pages after each.
      REGION_SLAB = 0_u64
      REGION_COLD = 1_u64
      REGION_SLAB_STAY = 2_u64

      def self.reopen_pages(table : Pointer(UInt64), arena : UInt64, index : Int32) : UInt64
        owner = table.address
        chunk = chunk_of(index)
        lock
        chosen = 0_u64
        if arena != 0
          chosen = arena if read64(arena + OFF_IDLE) != read64(arena + OFF_WARM) && reopen_in(arena, owner)
          chosen = arena if chosen == 0 && next_slab(arena, owner)
        end
        candidate = @@arenas
        while candidate != 0 && chosen == 0
          if candidate != arena && read64(candidate + OFF_CHUNK) == chunk && read64(candidate + OFF_OWNER) == 0
            if read64(candidate + OFF_IDLE) != read64(candidate + OFF_WARM) && reopen_in(candidate, owner)
              chosen = candidate
            elsif next_slab(candidate, owner)
              chosen = candidate
            end
          end
          candidate = read64(candidate + OFF_NEXT)
        end
        # A slab taken while the class has warm pages: they were out of
        # reach, and the slab is carved to its end before they are asked
        # for again.
        write64(chosen + OFF_REGION_REOPENED, REGION_SLAB_STAY) if chosen != 0 && read64(chosen + OFF_REGION_REOPENED) == REGION_SLAB && warm_of(index) != 0_u64
        # The old arena is nobody's from here, whatever was chosen: a
        # fresh mapping claims itself as it is made.
        write64(arena + OFF_OWNER, 0_u64) if arena != 0 && chosen != arena && read64(arena + OFF_OWNER) == owner
        unlock
        if chosen == 0
          chosen = map_arena(index, owner)
          write64(chosen + OFF_REGION_REOPENED, REGION_SLAB_STAY) if warm_of(index) != 0_u64
        end
        chosen
      end

      # Whether the arena is still an arena, under the lock: the directory
      # byte is cleared before the unmap, under the same lock.
      def self.mapped?(arena : UInt64) : Bool
        Pointer(UInt8).new(arena_dir + arena.unsafe_shr(24_u64)).value != 0_u8
      end

      # Under the lock: whether `owner` may set a region in `arena`, which
      # it may when nobody's fill arena it is, or its own. The claim is
      # written when a region is set, not here: a candidate tried and
      # found spent stayed claimed by the cache that tried it, and the
      # scavenge, which leaves a claimed arena alone, kept the spike's
      # twenty mappings for a cache that had moved on from all of them.
      def self.claimable?(arena : UInt64, owner : UInt64) : Bool
        current = read64(arena + OFF_OWNER)
        current == 0 || current == owner
      end

      # The frontier's next slab as the bump region: from the high-water
      # mark, `SLAB` bytes or what the mapping has left. False when the
      # mapping is carved to its end. Under the lock.
      def self.next_slab(arena : UInt64, owner : UInt64) : Bool
        return false if read64(arena + OFF_SWEEPING) != 0 || !claimable?(arena, owner)
        high = read64(arena + OFF_HIGH)
        top = arena + read64(arena + OFF_MAP)
        chunk = read64(arena + OFF_CHUNK)
        # The frontier stays on the chunk grid: a tail shorter than a
        # chunk is the mapping spent, and `high` is left where the last
        # chunk ended, because the sweep walks to it and would take a
        # tail it was moved over for a chunk.
        return false if high + chunk > top
        stop = high + slab_for(chunk)
        stop = top if stop > top
        count = (stop - high).unsafe_div(chunk)
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.set(high)
        write64(arena + OFF_CURSOR_BYTE, meta(arena, high))
        write64(arena + OFF_BUMP_END, high + count * chunk)
        write64(arena + OFF_LEFT, count)
        write64(arena + OFF_REGION_REOPENED, REGION_SLAB)
        write64(arena + OFF_OWNER, owner)
        true
      end

      # The first run of idle pages in `arena` - warm ones when `warm`,
      # cold ones otherwise - taken: its bits cleared, its counts down,
      # and its bounds answered as `{low, high}`, page-aligned, or
      # `{0, 0}` for none. Under the lock.
      # With a sweep's slice in flight on the arena the run is looked for
      # below the slice only: the slice walks up from the arena's sweep
      # cursor and sets bits at and above it, and this clears bits below
      # the sixty-four-page word that cursor is in, so the two never
      # share a bitmap word.
      def self.take_run(arena : UInt64, warm : Bool) : Tuple(UInt64, UInt64)
        pages = read64(arena + OFF_MAP).unsafe_shr(PAGE_SHIFT)
        if read64(arena + OFF_SWEEPING) != 0
          cursor = read64(arena + OFF_SWEEP_CURSOR)
          return {0_u64, 0_u64} if cursor == SWEEP_DONE || cursor < arena || cursor >= arena + read64(arena + OFF_MAP)
          # Below the sixty-four-page word the slice's cursor is in, less
          # one page more: a run's last chunk reaches into the page after
          # it, and that page must be one the slice will not `madvise` -
          # it releases pages from its cursor up, so a page below the
          # cursor's is safe, and the word's first page is not below the
          # cursor when the cursor begins it.
          pages = (cursor - arena).unsafe_shr(PAGE_SHIFT) & 0xFFFFFFFFFFFFFFC0_u64
          return {0_u64, 0_u64} if pages < 2_u64
          pages = pages - 1_u64
        end
        # Word by word: an idle bit whose cold bit is what `warm` asks.
        slot = 0_u64
        page = 0_u64
        while slot * 64_u64 < pages
          word = read64(arena + OFF_PAGES + slot * 8_u64)
          cold = read64(arena + OFF_COLD + slot * 8_u64)
          word = warm ? word & (0xFFFFFFFFFFFFFFFF_u64 - cold) : word & cold
          if word != 0
            page = slot * 64_u64
            while word & 1_u64 == 0
              word = word.unsafe_shr(1_u64)
              page = page + 1_u64
            end
            break
          end
          slot = slot + 1_u64
        end
        return {0_u64, 0_u64} if slot * 64_u64 >= pages || page >= pages
        stop = page + 1_u64
        while stop < pages && page_idle?(arena, arena + stop * PAGE) && page_cold?(arena, arena + stop * PAGE) != warm
          stop = stop + 1_u64
        end
        low = arena + page * PAGE
        high = arena + stop * PAGE
        set_idle(arena, low, high, false)
        set_cold(arena, low, high, false) unless warm
        idle_sub(arena, stop - page, warm)
        @@pages_reopened = @@pages_reopened + (stop - page)
        @@pages_rewarmed = @@pages_rewarmed + (stop - page) if warm
        {low, high}
      end

      # The first run of cold pages in `arena` becomes its bump region,
      # under the lock. The region's chunks are the grid chunks whose
      # head is on its pages; the one straddling its start belongs to the
      # page before - a list's, or an idle run's own - and the one
      # straddling its end is the region's, its tail on a page nobody
      # released. The slice read its region's bounds once, at its start;
      # a region set here is below everything the slice walks, and the
      # old region was either carved to its end or a frontier slab whose
      # uncarved chunks are above the high water the slice read - a stale
      # pair of bounds can only skip chunks the slice would otherwise
      # have freed or repainted, and a chunk skipped is one the next
      # epoch's sweep frees, one epoch late.
      def self.reopen_in(arena : UInt64, owner : UInt64) : Bool
        return false unless claimable?(arena, owner)
        chunk = read64(arena + OFF_CHUNK)
        run = take_run(arena, false)
        low = run[0]
        high = run[1]
        return false if high == 0
        first = arena_first(arena)
        head = first + (low - first + chunk - 1_u64).unsafe_div(chunk) * chunk
        count = head < high ? (high - head + chunk - 1_u64).unsafe_div(chunk) : 0_u64
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.set(head)
        write64(arena + OFF_CURSOR_BYTE, meta(arena, head))
        write64(arena + OFF_BUMP_END, high)
        write64(arena + OFF_LEFT, count)
        write64(arena + OFF_REGION_REOPENED, REGION_COLD)
        write64(arena + OFF_OWNER, owner) if count != 0
        count != 0
      end

      # The first run of warm idle pages in `arena` becomes a free list,
      # under the lock: its chunks linked head to tail, each stamped free
      # and this epoch's, and the head answered - 0 for no run. A list
      # rather than a bump region because the list's pop is the
      # allocator's fast path and the carve is not: carving every warm
      # chunk cost an ordered store of the cursor and a refill's worth of
      # loads per allocation, and churn ran 48 ms to 73. Two stores per
      # chunk here, on pages the last epoch's sweep listed and no cache
      # took before the pause - the pass the sweep would otherwise make
      # over them again, since the sweep steps over idle pages. The stamp
      # is what tells the sweep the chunks are a list's: a free chunk of
      # this epoch's parity is left where it is, one of the last epoch's
      # is dead (`sweep_slice`). Whose list needs no claim on the arena -
      # a list is the cache's, not the arena's - so a warm run is in
      # reach from any thread.
      def self.thread_warm(arena : UInt64) : UInt64
        chunk = read64(arena + OFF_CHUNK)
        run = take_run(arena, true)
        low = run[0]
        high = run[1]
        return 0_u64 if high == 0
        first = arena_first(arena)
        cursor = first + (low - first + chunk - 1_u64).unsafe_div(chunk) * chunk
        return 0_u64 if cursor >= high
        stamp = CARVED_FLAG | FREE_FLAG | IyiMark.epoch_flag
        head = cursor
        slot = chunk_index(arena, cursor)
        byte = arena + META + slot * META_ENTRY
        following = cursor + chunk
        while following < high
          write8(byte, stamp)
          write64(cursor + OFF_LINK, following)
          write64(cursor + OFF_INDEX, slot)
          cursor = following
          following = cursor + chunk
          byte = byte + META_ENTRY
          slot = slot + 1_u64
        end
        write8(byte, stamp)
        write64(cursor + OFF_LINK, 0_u64)
        write64(cursor + OFF_INDEX, slot)
        head
      end

      @@pages_released : UInt64 = 0_u64
      @@pages_retained : UInt64 = 0_u64
      @@pages_reopened : UInt64 = 0_u64
      @@pages_rewarmed : UInt64 = 0_u64

      # Pages the sweep handed back cold, pages it kept warm, pages the
      # carve took up again and how many of those were warm, in all: the
      # exercises and `bench/resident_probe.iyi` read them.
      def self.pages_released : UInt64
        @@pages_released
      end

      def self.pages_retained : UInt64
        @@pages_retained
      end

      def self.pages_reopened : UInt64
        @@pages_reopened
      end

      def self.pages_rewarmed : UInt64
        @@pages_rewarmed
      end

      def self.pages_released_add(count : UInt64) : Nil
        Pointer(Atomic(UInt64)).new(pointerof(@@pages_released).address).value.add(count)
      end

      def self.pages_retained_add(count : UInt64) : Nil
        Pointer(Atomic(UInt64)).new(pointerof(@@pages_retained).address).value.add(count)
      end

      # A chunk nobody was handed, as a reader without the lock may ask -
      # the mark, from any thread, while a carve runs: above the frontier,
      # or on an idle page. The uncarved part of a taken-up region is
      # not named here, because its bounds are two words a carve moves and
      # a reader could pair a new cursor with the old end and refuse a
      # live object above the region; a chunk of that part read as carved
      # instead is a zero header the mark shades and scans as nothing (a
      # cold run's), or a free-flagged one it refuses (a warm run's),
      # which the carve's own stamp then overwrites. Wrong in the safe
      # direction, and only for a stale word that happens to land there.
      def self.uncarved?(arena : UInt64, head : UInt64) : Bool
        head >= read64(arena + OFF_HIGH) || page_idle?(arena, head)
      end

      # The same question under the lock, which the sweep holds and a
      # region change takes: the uncarved part of the bump region is
      # exact here, and the sweep must not free it.
      def self.uncarved_held?(arena : UInt64, head : UInt64) : Bool
        return true if head >= read64(arena + OFF_HIGH)
        return true if head >= arena_cursor(arena) && head < read64(arena + OFF_BUMP_END)
        page_idle?(arena, head)
      end

      # Every arena is MAP-aligned, and a byte per MAP-sized slot of the
      # address space says whether the slot is an arena: `arena_of` is an
      # AND, a shift and a load, where it was a walk of the arena list per
      # pointer the marker met — the walk was most of a mark. The
      # directory is a mapping of 2^24 bytes for a 48-bit space, reserved
      # once and committed a page at a time as arenas land in it; the
      # kernel charges nothing for the untouched rest.
      DIR_SLOTS = 16777216_u64

      @@arena_dir : UInt64 = 0_u64

      def self.arena_dir : UInt64
        if @@arena_dir == 0
          @@arena_dir = __iyi_mmap(DIR_SLOTS).address
          {% if flag?(:linux) %}
            # A byte touched in it is a page committed, not a huge page:
            # the directory was 2 MB resident of every program's set.
            __iyi_madvise_nohuge(@@arena_dir, DIR_SLOTS)
          {% end %}
        end
        @@arena_dir
      end

      # The arena holding `address`, or 0. One load past the arithmetic; a
      # pointer into an arena's header or past its fill cursor is the
      # caller's to refuse.
      def self.arena_of(address : UInt64) : UInt64
        slot = address.unsafe_shr(24_u64)
        return 0_u64 if slot >= DIR_SLOTS
        return 0_u64 if Pointer(UInt8).new(arena_dir + slot).value == 0_u8
        address & (0_u64 &- MAP)
      end

      # A MAP-aligned mapping of MAP bytes: ask for twice, keep the aligned
      # middle, give the ends back.
      def self.map_aligned : UInt64
        {% if flag?(:win32) %}
          loop do
            raw = LibC.VirtualAlloc(nil, MAP * 2_u64, 0x2000_i32, 4_i32).address
            if raw == 0_u64
              __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
              __iyi_exit(1)
            end
            base = (raw + MAP - 1_u64) & (0_u64 &- MAP)
            LibC.VirtualFree(Pointer(Void).new(raw), 0_u64, 0x8000_i32)
            committed = LibC.VirtualAlloc(Pointer(Void).new(base), MAP, 0x3000_i32, 4_i32).address
            return base if committed == base
          end
        {% else %}
          raw = __iyi_mmap(MAP * 2_u64).address
          base = (raw + MAP - 1_u64) & (0_u64 &- MAP)
          __iyi_munmap(raw, base - raw) if base > raw
          tail = raw + MAP * 2_u64 - (base + MAP)
          __iyi_munmap(base + MAP, tail) if tail > 0
          base
        {% end %}
      end

      # An arena's first HUGE_AT bytes refuse transparent huge pages and
      # the rest of it is left to the kernel's default: a huge page given
      # to an arena's first touch is two megabytes resident for a class
      # with ten objects in it, and the rule before this one - refuse the
      # first eight arenas, take them from the ninth - left binary trees
      # with five arenas of a few objects each at 2 MB apiece, 10 MB of a
      # 33 MB resident set, because the ninth arena is not the large one,
      # the large one is. An arena carved past four megabytes is large,
      # and its tail faults in huge where the kernel's THP is `always`,
      # which is where the page walk a large heap pays is saved: live
      # churn, 48 MB live, ran 17% faster on huge pages. Left to the
      # default rather than asked for with MADV_HUGEPAGE, which was
      # built and measured out: an asked-for region is compacted for on
      # the fault path under the common `defer+madvise` defrag setting,
      # and a mutator stalled in a fault answers a stop late - live
      # churn's longest pause read 4 to 10 ms in three runs of twelve
      # where it reads 0.1 to 0.35. Linux only; darwin has no such advice.
      HUGE_AT = 4194304_u64
      @@arenas_mapped : UInt64 = 0_u64

      # Mappings made, in all: with `IyiMark.arenas_released` the churn
      # of arenas a program's classes went through.
      def self.arenas_mapped : UInt64
        @@arenas_mapped
      end

      def self.map_arena(index : Int32, owner : UInt64) : UInt64
        base = map_aligned
        {% if flag?(:linux) %}
          __iyi_madvise_nohuge(base, HUGE_AT)
        {% end %}
        @@arenas_mapped = @@arenas_mapped &+ 1_u64
        chunk = chunk_of(index)
        write64(base + OFF_MAP, MAP)
        write64(base + OFF_CHUNK, chunk)
        # The tables: a byte and then sixteen bits for every chunk the
        # mapping could hold past the header page, and the grid on the
        # page after them.
        magic = (1_u64.unsafe_shl(MAGIC_SHIFT) + chunk.unsafe_shr(3_u64) - 1_u64).unsafe_div(chunk.unsafe_shr(3_u64))
        chunks = (MAP - HEAD).unsafe_div(chunk)
        first_offset = (META + chunks * (META_ENTRY + 1_u64) + PAGE - 1_u64) & (0_u64 &- PAGE)
        write64(base + OFF_GRID, first_offset.unsafe_shl(GRID_SHIFT) | magic)
        write64(base + OFF_MARKS, base + META + chunks * META_ENTRY)
        first = base + first_offset
        stop = first + slab_for(chunk)
        stop = base + MAP if stop > base + MAP
        count = (stop - first).unsafe_div(chunk)
        write64(base + OFF_CURSOR, first)
        write64(base + OFF_CURSOR_BYTE, base + META)
        write64(base + OFF_LEFT, count)
        write64(base + OFF_HIGH, first)
        write64(base + OFF_BUMP_END, first + count * chunk)
        write64(base + OFF_OWNER, owner)
        lock
        # Fresh chunks are white and nobody's: swept for the current epoch
        # by construction — the epoch read under the lock, because a thread
        # that read it before parking in this very spin, through a pause
        # that turned it, would link an arena that looked like debt and was
        # not counted as any: the next pause's debt loop swept it in place
        # of a real one, a real one kept the last mark's black, and the mark
        # that followed counted nothing alive in it. The scavenge then
        # handed a mapping full of live objects back to the kernel.
        write64(base + OFF_EPOCH, IyiMark.epoch)
        # And nothing of it left to sweep: everything carved from it
        # wears the epoch's parity.
        write64(base + OFF_SWEEP_CURSOR, SWEEP_DONE)
        write64(base + OFF_NEXT, @@arenas)
        @@arenas = base
        # The directory byte last, after the header and the link: a reader
        # that finds the byte finds an arena that is whole.
        Pointer(UInt8).new(arena_dir + base.unsafe_shr(24_u64)).value = 1_u8
        unlock
        base
      end

      def self.take_large(size : UInt64, clear : Bool) : UInt64
        mapped = size + LARGE_USER
        base = __iyi_mmap(mapped).address
        write64(base + OFF_MAP, mapped)
        write64(base + 16 + OFF_MARK, (clear ? 0_u64 : ATOMIC_FLAG) | IyiMark.epoch_flag)
        lock
        write64(base + OFF_NEXT, @@large)
        @@large = base
        unlock
        base + 16
      end

      # One chunk back, to the calling thread's own cache and no lock:
      # `realloc`'s old chunk, and the exercises' hand-frees, come from the
      # thread that will allocate next, and a grow-by-doubling loop that
      # paid two lock cycles per step measured 61 ns an alloc+free pair
      # against 27 with the chunk kept local. The sweep does not come
      # through here; it has `free_batch`, to the centre.
      def self.free(pointer : Void*) : Nil
        return if pointer.address == 0
        arena = arena_of(pointer.address)
        if arena != 0
          head = head_of(arena, pointer.address)
          index = class_index(read64(arena + OFF_CHUNK))
          table = cache
          # Free, white, and this epoch's: on the cache's list until the
          # next pause drops it, and the sweep of its arena leaves a free
          # chunk of the current parity alone (`sweep_slice`).
          # A free chunk's colour is white (`shade_word` refuses it by
          # its entry): an object freed black under a mark would be
          # black again when the chunk came back, and read as marked by
          # the sweep after the next mark.
          slot = chunk_index(arena, head)
          write8(arena + META + slot * META_ENTRY, CARVED_FLAG | FREE_FLAG | IyiMark.epoch_flag)
          write8(read64(arena + OFF_MARKS) + slot, IyiMark::WHITE)
          write64(head + OFF_LINK, table[index])
          write64(head + OFF_INDEX, slot)
          table[index] = head
        else
          lock
          free_large(pointer.address - HEADER)
          unlock
        end
      end

      # Every free list emptied, under the lock with every thread stopped:
      # the sweep's `begin_sweep` says why.
      def self.drop_free_lists : Nil
        centre = central
        index = 0
        while index < CLASSES
          centre[index] = 0_u64
          index = index + 1
        end
        page = @@caches
        while page != 0
          table = Pointer(UInt64).new(page)
          index = 0
          while index < CLASSES
            table[index] = 0_u64
            index = index + 1
          end
          page = read64(page + CACHE_NEXT)
        end
      end

      # The bytes under a pointer: its chunk's payload, or its mapping's.
      # What the header used to carry as a third word, answered from the
      # arena or the large node instead.
      def self.size_of(base : UInt64) : UInt64
        arena = arena_of(base)
        if arena != 0
          chunk = read64(arena + OFF_CHUNK)
          return read8(meta(arena, base)) & HEADED_FLAG != 0 ? chunk - HEADER : chunk
        end
        read64(base - LARGE_USER + OFF_MAP) - LARGE_USER
      end

      # An arena's worth of swept chunks, already flagged and linked head to
      # tail by the sweep, pushed onto the centre as one batch: the centre
      # keeps a class's chunks as a stack of batches, each one arena's
      # sweep, chained through the second word of each batch's head - the
      # first is its link, the second every other free chunk's byte
      # address (`OFF_INDEX`), and a 16-byte chunk has no third. A refill
      # takes one batch, which is how the
      # centre is shared rather than hoarded — the whole-list refill let
      # one of eight threads take every chunk and the other seven carve,
      # and the heap and every sweep grew with it. The sweep runs under
      # the collector's own take of the lock, with every other thread
      # stopped, so nothing here takes it again.
      BATCH_NEXT = 8_u64

      def self.free_batch(index : Int32, head : UInt64) : Nil
        centre = central
        # The chain below the stashed range (`stash_batch_range`).
        write64(head + BATCH_NEXT, (read64(head + BATCH_NEXT) & (0_u64 &- LOW48 &- 1_u64)) | centre[index])
        centre[index] = head
      end

      # Under the lock, whoever holds it: `free` takes it for a mutator's
      # large chunk, the sweep already has it.
      def self.free_large(head : UInt64) : Nil
        base = head - 16
        previous = 0_u64
        node = @@large
        while node != 0
          if node == base
            if previous == 0
              @@large = read64(node)
            else
              write64(previous, read64(node))
            end
            break
          end
          previous = node
          node = read64(node)
        end
        __iyi_munmap(base, read64(base + 8))
      end

      # Hand one empty arena's mapping back to the kernel — the sweep's
      # scavenge, kept here because every word it touches is this class's
      # own state. Any cache's current fill arena answers false: one warm
      # arena per class per thread is the cushion that keeps spike-then-idle
      # from paying an mmap on its next allocation. Every free list was
      # dropped before the scavenge began, so no list holds a chunk of
      # this mapping (stripping them here, when they held the last
      # epoch's chunks, was 7 ms of a stop); the arena leaves the heap's
      # own list so `containing` never walks into a hole, and only then
      # does the mapping go back.
      def self.release_arena(previous : UInt64, arena : UInt64) : Bool
        # A walk in flight on a stopped thread holds chunks of this arena
        # in a batch it has yet to hand over; a cache that claimed it has
        # yet to write it into its table - it parked in the lock spin of
        # letting its old arena go, this arena's address in a register.
        return false if read64(arena + OFF_SWEEPING) != 0 || read64(arena + OFF_OWNER) != 0
        chunk = read64(arena + OFF_CHUNK)
        index = class_index(chunk)
        page = @@caches
        while page != 0
          return false if Pointer(UInt64).new(page)[FILL + index] == arena
          page = read64(page + CACHE_NEXT)
        end
        if previous == 0
          @@arenas = read64(arena + OFF_NEXT)
        else
          write64(previous + OFF_NEXT, read64(arena + OFF_NEXT))
        end
        # Its warm pages leave the class's count with it, or a refill
        # would carve for pages no arena has.
        warm_sub(arena, read64(arena + OFF_WARM)) if read64(arena + OFF_WARM) != 0
        Pointer(UInt8).new(arena_dir + arena.unsafe_shr(24_u64)).value = 0_u8
        # Off the heap's list and out of the directory inside the stop,
        # so nothing finds it; the unmap itself waits for the program to
        # be running again - the kernel frees a resident mapping's four
        # thousand pages in half a millisecond, ten of them were the
        # whole of a 5 ms stop, and a released arena is nobody's to touch.
        write64(arena + OFF_NEXT, @@to_unmap)
        @@to_unmap = arena
        true
      end

      @@to_unmap : UInt64 = 0_u64

      # The mappings the last scavenge let go, handed back: the collector's
      # own time after it resumed the program.
      def self.unmap_released : Nil
        arena = @@to_unmap
        @@to_unmap = 0_u64
        while arena != 0
          following = read64(arena + OFF_NEXT)
          __iyi_munmap(arena, read64(arena + OFF_MAP))
          arena = following
        end
      end

      def self.arena_live(arena : UInt64) : UInt64
        read64(arena + OFF_LIVE)
      end

      def self.arena_live_reset(arena : UInt64) : Nil
        write64(arena + OFF_LIVE, 0_u64)
      end


      # Same-chunk growth within a class, allocate-and-copy across one,
      # because the old size rides under the object header, which is the only
      # place that knows it. The new chunk's type id stays zero, which is
      # right: a reallocated buffer is raw memory whose old map, if it had
      # one, described a different number of bytes, and zero means the mark
      # loop word-scans it conservatively instead. The ATOMIC promise does
      # travel: the caller's "no pointers in here" is about the data, and
      # the data is what the copy carries — dropping the flag on growth is
      # how an `Array(Int32)` buffer got word-scanned at every doubling.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        old_size = size_of(pointer.address)
        byte = meta_of(pointer.address)
        atomic = (byte == 0 ? read64(pointer.address - HEADER) : read8(byte)) & ATOMIC_FLAG != 0
        return pointer if size <= old_size && (size > TOP) == (old_size > TOP)
        new_pointer = Pointer(Void).new(take(size, !atomic, UNTYPED_FLAG | (atomic ? ATOMIC_FLAG : 0_u64), 0_u64))
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        # The copy was bytes, invisible to the barrier the compiler puts on
        # pointer stores; what the new block now holds is shaded here, so a
        # buffer of references grown under a running mark keeps them.
        IyiMark.barrier(new_pointer.address, limit.unsafe_div(8_u64)) if LibIyiGCTable.__iyi_marking != 0_u8
        free(pointer)
        new_pointer
      end

      def self.clear_block(start : UInt64, count : UInt64) : Nil
        words = Pointer(UInt64).new(start)
        filled = 0_u64
        while filled &+ 8_u64 <= count
          words.value = 0_u64
          words = words + 1_i64
          filled = filled &+ 8_u64
        end
        bytes = Pointer(UInt8).new(start &+ filled)
        while filled < count
          bytes.value = 0_u8
          bytes = bytes + 1_i64
          filled = filled &+ 1_u64
        end
      end

      def self.containing(pointer : Void*) : UInt64
        address = pointer.address
        arena = arena_of(address)
        return 0_u64 if arena == 0
        return 0_u64 if address < arena_first(arena)
        arena
      end

      def self.containing_large(pointer : Void*) : UInt64
        address = pointer.address
        node = @@large
        while node != 0
          if address >= node + LARGE_USER && address < node + read64(node + OFF_MAP)
            return node
          end
          node = read64(node)
        end
        0_u64
      end

      def self.first_arena : UInt64
        @@arenas
      end

      def self.arena_next(arena : UInt64) : UInt64
        read64(arena + OFF_NEXT)
      end

      def self.arena_map(arena : UInt64) : UInt64
        read64(arena + OFF_MAP)
      end

      def self.arena_chunk(arena : UInt64) : UInt64
        read64(arena + OFF_CHUNK)
      end

      # The fill cursor names where carving stopped, which is what tells a
      # chunk that was handed out from the untouched tail of an arena. Stage 3
      # asks it of every candidate pointer and Stage 6's sweep will ask it of
      # every arena, so it is an accessor beside the others rather than a
      # thing either stage reaches into the header for.
      def self.arena_cursor(arena : UInt64) : UInt64
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.get
      end

      # The carve frontier, the sweep's stop.
      def self.arena_high(arena : UInt64) : UInt64
        read64(arena + OFF_HIGH)
      end

      def self.arena_epoch(arena : UInt64) : UInt64
        read64(arena + OFF_EPOCH)
      end

      def self.arena_epoch_set(arena : UInt64, epoch : UInt64) : Nil
        write64(arena + OFF_EPOCH, epoch)
      end

      def self.first_large : UInt64
        @@large
      end

      def self.large_next(node : UInt64) : UInt64
        read64(node)
      end

      def self.large_mapped(node : UInt64) : UInt64
        read64(node + 8)
      end
    end

    # Codegen emits calls to these by name for every allocation under the
    # __iyi_* ABI.
    fun __iyi_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __iyi_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc_atomic(size)
    end

    # A class instance, `allocate_aggregate`'s call under the arena: the
    # class's size and type id, and its flags - bit 0 headed, bit 1 atomic
    # (`IyiHeap.new_object`).
    fun __iyi_new(size : UInt64, type_id : UInt64, flags : UInt64) : Void*
      IyiHeap.new_object(size, type_id, flags & 1_u64 != 0, flags & 2_u64 != 0)
    end

    fun __iyi_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is defined locally for the bump branch's reason: codegen itself
    # reaches for the name (`pre_initialize_aggregate` and
    # `generic_array_malloc` lower to the LLVM `llvm.memset` intrinsic, which
    # becomes a C `memset` call once the size is not a constant), and a
    # definition with the same name, types and return is the only thing that
    # can intercept that. The bulk goes eight bytes at a time, and the word
    # store advances one word per store, because pointer arithmetic here
    # counts elements: eight bytes is one step, not eight. The byte loop
    # carries the tail, and the pattern word is the byte tiled eight wide.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!

      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end

    {% if flag?(:darwin) %}
      # `bzero` is defined for the same reason on darwin: the aarch64 back end
      # lowers a zeroing `llvm.memset` it will not inline — every
      # `Pointer.malloc` clears with one, and a --release build keeps the
      # allocator's variable-length ones — to a `bzero` call rather than a
      # `memset` call, so without this every darwin release binary asked
      # libSystem for one more name (bench/thread_floor.sh was the gate that
      # first read it; bench/dependency_floor.sh builds plain and never saw
      # it). The stores are inline asm, not a loop the compiler can read:
      # the loop-idiom pass turns a zeroing store loop into the very
      # `llvm.memset` this exists to catch, and it spares only functions
      # named `memset` and `memcpy` — the first version of this, written as
      # `memset`'s loop, came back as a tail call to itself on its own byte
      # tail. A call to `memset` would fold the same way. A word per store,
      # the shape `memset` above has, and the byte tail is at most seven.
      fun bzero(destination : Void*, count : UInt64) : Nil
        address = destination.address
        filled = 0_u64
        while filled + 8_u64 <= count
          {% if flag?(:aarch64) %}
            asm("str xzr, [$0]" :: "r"(address + filled) : "memory" : "volatile")
          {% else %}
            asm("movq $$0, ($0)" :: "r"(address + filled) : "memory" : "volatile")
          {% end %}
          filled = filled + 8_u64
        end
        while filled < count
          {% if flag?(:aarch64) %}
            asm("strb wzr, [$0]" :: "r"(address + filled) : "memory" : "volatile")
          {% else %}
            asm("movb $$0, ($0)" :: "r"(address + filled) : "memory" : "volatile")
          {% end %}
          filled = filled + 1_u64
        end
      end
    {% end %}

    # GC_DESIGN.md's Stage 3: the root set, made enumerable. Nothing marks and
    # nothing collects here. What lands is the answer to "where could a
    # pointer to a live object be", asked of the one thread this language has,
    # and the answer to "is this word one", asked of the heap Stage 2 built.
    # Stage 5 passes a marking function to `IyiRoots.each_root` and that is
    # the whole interface it needs; `bench/root_exercise.iyi` is the only
    # caller until then, and it is what says the mechanism works.
    #
    # Conservative, and deliberately biased toward retaining. A word that is
    # not a pointer but lands inside an allocated chunk keeps that chunk alive
    # for one cycle, which costs memory. A word that IS a pointer and is not
    # reported frees a live object, which costs correctness. Every decision
    # below is made in that direction: when in doubt, retain.
    #
    # Three places a root can be, and the second is the one that gets missed:
    #
    # 1. The stack, word by word between the current stack pointer and the
    #    base. Both targets grow the stack downward, so the stack pointer is
    #    the low end and the base is the high one, and the scan runs upward
    #    from the first 8-aligned address. Only aligned words are candidates:
    #    a pointer the compiler stored is 8-aligned on both targets, so an
    #    unaligned word is a coincidence of neighbouring bytes and not a
    #    reference anything can follow.
    #
    # 2. The registers. A root can sit in a callee-saved register and appear
    #    nowhere on the stack, so a collector that scans only the stack frees
    #    a live object. This is the part of GC_DESIGN.md's Stage 4 that is
    #    real without threads: there is no thread to suspend and no register
    #    state to read out of one, but the register file of the thread that
    #    is running still holds references. They are spilled to memory before
    #    the scan and that memory is a root range of its own.
    #
    # 3. The globals, whose ranges come from the platform rather than from a
    #    guess. A range that cannot be obtained is fatal rather than empty,
    #    because a missing root range is a collector that frees live objects
    #    and an empty range looks exactly like a clean scan.
    #
    # 4. Every suspended fiber's stack (Stage 3's fourth task, closed).
    #    The scheduler keeps an all-fibers registry precisely because its
    #    wait queues cannot serve this walk — a channel-parked fiber lives
    #    in the channel's own nodes — and `each_fiber_root` scans each
    #    suspended fiber from its saved stack pointer to its stack top.
    #    This was a recorded gap between 0.4.0's scheduler landing and
    #    this walk: an object reachable only from a parked fiber's stack
    #    would have been freed live — latent then because only the
    #    exercises collected, and closed before the allocation-pressure
    #    trigger made any allocation a collection point.
    #
    # What is NOT here, for the same reason: nothing suspends a thread. Stage
    # 4's `SIGSTOP` on Linux and Mach `thread_suspend` on darwin stop threads
    # this runtime cannot create, and code that stops nothing cannot be
    # tested for stopping the right things.
    {% if flag?(:darwin) %}
      # The stack base and the global segments, from libSystem, which has the
      # same standing here that `write` and `mmap` do: Apple documents it as
      # the platform's interface and raw syscalls as not a stable ABI.
      # `pthread_get_stackaddr_np` is the sanctioned answer for the highest
      # address of a thread's stack, and dyld's image list is the sanctioned
      # answer for where a Mach-O image's segments landed after sliding.
      lib LibC
        fun pthread_self : Void*
        fun pthread_get_stackaddr_np(thread : Void*) : Void*
        fun _dyld_get_image_header(index : Int32) : Void*
        fun _dyld_get_image_vmaddr_slide(index : Int32) : Int64
      end
    {% else %}
      # The static data span on Linux, from symbols the link already
      # defines. On glibc, `__data_start` at the front of `.data` comes from
      # the C runtime object every link template adds, and `_end` past the
      # back of `.bss` from the linker itself — GC_DESIGN.md's
      # "`__data_start` to `__bss_end`" written the way the linker spells
      # it. musl's crt defines no `__data_start` (CI's Alpine arm failed at
      # the link, which is this comment's provenance), so there the range is
      # `__bss_start`.._end`, both linker-synthesized on every ELF: narrower
      # by `.data`, and honest about it — this prelude's globals fold their
      # literal initializers to static zero, so a global that ever holds a
      # heap pointer lives in `.bss`, which is exactly the half kept.
      # Declaring them costs no library; a binary whose link provides
      # neither fails at the link rather than scanning nothing at run time.
      {% if flag?(:musl) %}
        lib LibIyiImage
          $__bss_start : UInt8
          $_end : UInt8
        end
      {% else %}
        lib LibIyiImage
          $__data_start : UInt8
          $_end : UInt8
        end
      {% end %}
    {% end %}

    class IyiRoots
      # Six callee-saved registers on x86_64 and twelve on aarch64, named
      # where they are spilled.
      {% if flag?(:x86_64) %}
        {% if flag?(:win32) %}
          SPILL = 64_u64
        {% else %}
          SPILL = 48_u64
        {% end %}
      {% else %}
        SPILL = 96_u64
      {% end %}
      PAGE = 4096_u64
      MAPS = 65536_u64

      # The same rule the allocator's state lives under: `$` globals are
      # refused, a `fun` body cannot reach `@@` state, and a literal
      # initializer folds into the LLVM global's static zero, so zero means
      # "not discovered yet" rather than a value startup code installs. There
      # is no array class variable either, which is why the register spill
      # buffer is a mapped page named by one of these rather than a field.
      @@spill : UInt64 = 0_u64
      @@stack_base : UInt64 = 0_u64
      @@data_low : UInt64 = 0_u64
      @@data_high : UInt64 = 0_u64
      @@const_low : UInt64 = 0_u64
      @@const_high : UInt64 = 0_u64
      @@found_globals : UInt64 = 0_u64
      @@bss_low : UInt64 = 0_u64
      @@bss_high : UInt64 = 0_u64

      # A root range that cannot be obtained ends the program. The whole
      # point of the range is that missing it frees live objects, so a
      # diagnosis now is cheaper than a corrupted heap later.
      def self.fatal(message : String) : NoReturn
        __iyi_write(1, message.to_unsafe.as(Void*), message.bytesize.to_u64)
        __iyi_exit(1)
      end

      # One page of its own for the register spill, mapped on first use the
      # way the allocator's directory is. It is deliberately not heap memory:
      # a spill buffer taken from `IyiHeap` would be a chunk the scan then
      # reports as a live object, and a chunk holding a raw pointer to
      # everything every register held.
      def self.spill : UInt64
        @@spill = __iyi_mmap(PAGE).address if @@spill == 0
        @@spill
      end

      # The callee-saved registers, stored where the scan can see them.
      # x86_64 System V preserves rbx, rbp and r12 through r15 across a call;
      # aarch64 AAPCS64 preserves x19 through x28, x29 the frame pointer and
      # x30 the link register. The caller-saved registers are not captured
      # and do not need to be: their convention is that a caller keeps
      # nothing live in them across a call, so any value still wanted was
      # written to the frame that the stack scan already covers. The
      # floating-point callee-saved registers (d8 to d15, xmm on Windows) are
      # not captured either, because nothing in this language puts an object
      # pointer in one.
      #
      # The destination is pinned to a caller-saved register, rdi or x0, so
      # that the register holding it can never be one of the registers being
      # captured. Slots left over from an earlier spill stay as they were,
      # which retains a little more than it must and never less.
      def self.spill_registers : Nil
        buffer = spill
        {% if flag?(:win32) && flag?(:x86_64) %}
          asm("movq %rbx, 0($0)
               movq %rbp, 8($0)
               movq %rdi, 16($0)
               movq %rsi, 24($0)
               movq %r12, 32($0)
               movq %r13, 40($0)
               movq %r14, 48($0)
               movq %r15, 56($0)" :: "{rcx}"(buffer) : "memory" : "volatile")
        {% elsif flag?(:x86_64) %}
          asm("movq %rbx, 0($0)
               movq %rbp, 8($0)
               movq %r12, 16($0)
               movq %r13, 24($0)
               movq %r14, 32($0)
               movq %r15, 40($0)" :: "{rdi}"(buffer) : "memory" : "volatile")
        {% else %}
          asm("stp x19, x20, [$0, #0]
               stp x21, x22, [$0, #16]
               stp x23, x24, [$0, #32]
               stp x25, x26, [$0, #48]
               stp x27, x28, [$0, #64]
               stp x29, x30, [$0, #80]" :: "{x0}"(buffer) : "memory" : "volatile")
        {% end %}
      end

      # The low end of the stack, read out of the register that names it.
      # Taken here rather than from the address of a local because a local's
      # address is above whatever the current frame has already pushed, and
      # the difference is exactly the words a compiler spills a pointer into.
      def self.stack_pointer : UInt64
        value = uninitialized UInt64
        {% if flag?(:x86_64) %}
          asm("movq %rsp, $0" : "=r"(value) :: : "volatile")
        {% else %}
          asm("mov $0, sp" : "=r"(value) :: : "volatile")
        {% end %}
        value
      end

      # The high end, discovered once. The main thread's stack grows down
      # from a fixed top on both targets, so the number does not change over
      # a run and reading it lazily is the same answer as recording it at
      # startup, without the startup cost for a program that never collects.
      #
      # Except on Windows, where it is not one number: the fiber switch
      # rewrites the TEB's StackBase and StackLimit so that a Windows API
      # called on a fiber's stack sees that stack (concurrency.iyi's
      # `switch_stack`), which means this answers *the current stack's*
      # base and memoizing it stores whichever stack asked first. A run
      # that first collected inside a spawned fiber then walked the main
      # fiber's stack from its saved sp to that fiber's top — two
      # unrelated mappings, gigabytes apart — and died of a memory fault
      # in the scan. The read is two instructions, so Windows re-reads.
      def self.stack_base : UInt64
        {% if flag?(:win32) %}
          discover_stack_base
        {% else %}
          @@stack_base = discover_stack_base if @@stack_base == 0
          @@stack_base
        {% end %}
      end

      {% if flag?(:darwin) %}
        # What this number is: the address one past the highest byte of the
        # main thread's stack, which is what `pthread_get_stackaddr_np`
        # returns and is the true base rather than an approximation of it.
        def self.discover_stack_base : UInt64
          base = LibC.pthread_get_stackaddr_np(LibC.pthread_self).address
          fatal("iyi: stack base unavailable\n") if base == 0
          base
        end
      {% elsif flag?(:win32) %}
        def self.discover_stack_base : UInt64
          base = uninitialized UInt64
          {% if flag?(:x86_64) %}
            asm("movq %gs:0x08, $0" : "=r"(base) :: : "volatile")
          {% else %}
            base = 0_u64
          {% end %}
          fatal("iyi: stack base unavailable\n") if base == 0
          base
        end

        def self.stack_limit : UInt64
          limit = uninitialized UInt64
          {% if flag?(:x86_64) %}
            asm("movq %gs:0x10, $0" : "=r"(limit) :: : "volatile")
          {% else %}
            limit = 0_u64
          {% end %}
          limit
        end

        def self.current_teb : UInt64
          teb = uninitialized UInt64
          {% if flag?(:x86_64) %}
            asm("movq %gs:0x30, $0" : "=r"(teb) :: : "volatile")
          {% else %}
            teb = 0_u64
          {% end %}
          teb
        end

        # Every general register a suspended thread holds, onto its line.
        # Eight of them were spilled here once — the callee-saved set — on
        # the reasoning that a call's caller-saved registers are already on
        # the stack. That reasoning belongs to a *voluntary* stop, which
        # `stop_here` is: a thread suspended by another one stopped at an
        # instruction nobody chose, and an object whose only reference sits
        # in `rax` between an allocation and its store is live. The POSIX
        # handler copies all sixteen the kernel saved for the same reason
        # (`IYI_UC_COUNT`), and the line has room for thirty-two.
        #
        # The offsets are CONTEXT's on x86-64: ContextFlags at 48, and the
        # integer registers from Rax at 120 through Rip at 248. Rsp is not
        # spilled — it is the answer, and the range above it is the stack
        # the collector walks.
        def self.capture_thread_registers(thread_handle : Void*, out_spill : UInt64) : UInt64
          ctx_buf = uninitialized UInt8[1280]
          addr = pointerof(ctx_buf).address + 15_u64
          ctx_addr = addr - (addr & 15_u64)
          ctx_ptr = Pointer(Void).new(ctx_addr)
          Pointer(UInt32).new(ctx_addr + 48_u64).value = 0x100003_u32
          if LibC.GetThreadContext(thread_handle, ctx_ptr) == 0
            return 0_u64
          end
          IyiHeap.write64(out_spill + 0_u64, IyiHeap.read64(ctx_addr + 120_u64))   # Rax
          IyiHeap.write64(out_spill + 8_u64, IyiHeap.read64(ctx_addr + 128_u64))   # Rcx
          IyiHeap.write64(out_spill + 16_u64, IyiHeap.read64(ctx_addr + 136_u64))  # Rdx
          IyiHeap.write64(out_spill + 24_u64, IyiHeap.read64(ctx_addr + 144_u64))  # Rbx
          IyiHeap.write64(out_spill + 32_u64, IyiHeap.read64(ctx_addr + 160_u64))  # Rbp
          IyiHeap.write64(out_spill + 40_u64, IyiHeap.read64(ctx_addr + 168_u64))  # Rsi
          IyiHeap.write64(out_spill + 48_u64, IyiHeap.read64(ctx_addr + 176_u64))  # Rdi
          IyiHeap.write64(out_spill + 56_u64, IyiHeap.read64(ctx_addr + 184_u64))  # R8
          IyiHeap.write64(out_spill + 64_u64, IyiHeap.read64(ctx_addr + 192_u64))  # R9
          IyiHeap.write64(out_spill + 72_u64, IyiHeap.read64(ctx_addr + 200_u64))  # R10
          IyiHeap.write64(out_spill + 80_u64, IyiHeap.read64(ctx_addr + 208_u64))  # R11
          IyiHeap.write64(out_spill + 88_u64, IyiHeap.read64(ctx_addr + 216_u64))  # R12
          IyiHeap.write64(out_spill + 96_u64, IyiHeap.read64(ctx_addr + 224_u64))  # R13
          IyiHeap.write64(out_spill + 104_u64, IyiHeap.read64(ctx_addr + 232_u64)) # R14
          IyiHeap.write64(out_spill + 112_u64, IyiHeap.read64(ctx_addr + 240_u64)) # R15
          IyiHeap.write64(out_spill + 120_u64, IyiHeap.read64(ctx_addr + 248_u64)) # Rip
          IyiHeap.read64(ctx_addr + 152_u64) # Rsp
        end
      {% else %}
        # What this number is: the end address of the kernel's `[stack]`
        # mapping for this process, read out of `/proc/self/maps`, which is
        # the true base and not an approximation. The address of a local in
        # `main` was the alternative and it is not the same number: it sits
        # below argv, envp and the auxiliary vector, which the kernel places
        # at the top of that mapping, so a base taken there is too low and a
        # base that is too low silently loses roots.
        #
        # Reading a file is three syscalls this file already issues. The
        # buffer is a mapping of its own rather than a heap chunk, because
        # the heap is the thing being described and a scratch chunk in it
        # would be one more object every later scan has to reason about.
        def self.discover_stack_base : UInt64
          buffer = __iyi_mmap(MAPS).address
          handle = __iyi_open_read("/proc/self/maps".to_unsafe)
          fatal("iyi: /proc/self/maps unreadable\n") if handle < 0
          filled = 0_u64
          while filled < MAPS
            count = __iyi_read(handle.to_i32, Pointer(Void).new(buffer + filled), MAPS - filled)
            break if count <= 0
            filled = filled + count.to_u64
          end
          __iyi_close(handle)
          base = stack_end_in_maps(buffer, filled)
          __iyi_munmap(buffer, MAPS)
          # The `[stack]` line is near the end of the file, so a read that
          # filled the buffer and stopped short reports no line rather than a
          # wrong one, and this is where that becomes a diagnosis.
          fatal("iyi: no [stack] line in /proc/self/maps\n") if base == 0
          base
        end
      {% end %}

      # `/proc/self/maps` is a line per mapping, "low-high perms ..." in hex,
      # with the region's name last. The line whose name is `[stack]` is the
      # main thread's, and the number after the dash is its end. Kept off the
      # platform branch and reachable on both, because parsing text is the
      # half of this that a test can exercise anywhere and the syscalls are
      # the half that cannot leave Linux.
      def self.stack_end_in_maps(buffer : UInt64, length : UInt64) : UInt64
        bytes = Pointer(UInt8).new(buffer)
        start = 0_u64
        index = 0_u64
        while index <= length
          if index == length || (bytes + index.to_i64).value == 10_u8
            return line_stack_end(bytes, start, index) if line_names_stack?(bytes, start, index)
            start = index + 1
          end
          index = index + 1
        end
        0_u64
      end

      def self.line_names_stack?(bytes : Pointer(UInt8), start : UInt64, stop : UInt64) : Bool
        return false if stop < start + 7
        name = "[stack]".to_unsafe
        cursor = stop - 7
        index = 0
        while index < 7
          return false if (bytes + (cursor + index.to_u64).to_i64).value != name[index]
          index = index + 1
        end
        true
      end

      def self.line_stack_end(bytes : Pointer(UInt8), start : UInt64, stop : UInt64) : UInt64
        cursor = start
        # 45 is '-', which separates the two addresses.
        while cursor < stop && (bytes + cursor.to_i64).value != 45_u8
          cursor = cursor + 1
        end
        return 0_u64 if cursor >= stop
        cursor = cursor + 1
        value = 0_u64
        digits = 0
        while cursor < stop
          digit = hex_digit((bytes + cursor.to_i64).value)
          break if digit > 15
          value = value * 16_u64 + digit
          digits = digits + 1
          cursor = cursor + 1
        end
        return 0_u64 if digits == 0
        value
      end

      # 16 for anything that is not a hex digit, which is the terminator the
      # caller reads rather than a second return value it has nowhere to put.
      def self.hex_digit(byte : UInt8) : UInt64
        return (byte - 48_u8).to_u64 if byte >= 48_u8 && byte <= 57_u8
        return (byte - 97_u8).to_u64 + 10_u64 if byte >= 97_u8 && byte <= 102_u8
        return (byte - 65_u8).to_u64 + 10_u64 if byte >= 65_u8 && byte <= 70_u8
        16_u64
      end

      {% if flag?(:darwin) %}
        # The main executable's `__DATA` and `__DATA_CONST`, walked out of its
        # Mach header. Image 0 is the main executable, and it is the only
        # image asked: nothing outside this program allocates from this heap,
        # so no other image's data segment can hold a pointer into it. The
        # segment addresses in the file are unslid, so the slide is added.
        # `__DATA_CONST` is optional because a binary may genuinely have none;
        # `__DATA` is not, because every binary has one and its absence means
        # the walk is wrong rather than the binary unusual.
        def self.discover_globals : Nil
          header = LibC._dyld_get_image_header(0).address
          fatal("iyi: no Mach header for the main image\n") if header == 0
          fatal("iyi: main image is not 64-bit Mach-O\n") if IyiHeap.read64(header) & 0xFFFFFFFF_u64 != 0xFEEDFACF_u64
          slide = LibC._dyld_get_image_vmaddr_slide(0).to_u64
          count = IyiHeap.read64(header + 16) & 0xFFFFFFFF_u64
          cursor = header + 32_u64
          seen = 0_u64
          while seen < count
            word = IyiHeap.read64(cursor)
            size = word.unsafe_shr(32)
            fatal("iyi: zero-length Mach load command\n") if size == 0
            # LC_SEGMENT_64. The name is sixteen bytes at offset 8, compared
            # as two words rather than a loop: "__DATA" padded with zeros,
            # and "__DATA_CONST" the same.
            if word & 0xFFFFFFFF_u64 == 0x19_u64
              first = IyiHeap.read64(cursor + 8)
              second = IyiHeap.read64(cursor + 16)
              if first == 0x415441445F5F_u64 && second == 0_u64
                @@data_low = IyiHeap.read64(cursor + 24) &+ slide
                @@data_high = @@data_low &+ IyiHeap.read64(cursor + 32)
              elsif first == 0x435F415441445F5F_u64 && second == 0x54534E4F_u64
                @@const_low = IyiHeap.read64(cursor + 24) &+ slide
                @@const_high = @@const_low &+ IyiHeap.read64(cursor + 32)
              end
            end
            cursor = cursor + size
            seen = seen + 1_u64
          end
          fatal("iyi: no __DATA segment in the main image\n") if @@data_high <= @@data_low
          @@found_globals = 1_u64
        end
      {% elsif flag?(:win32) %}
        def self.discover_globals : Nil
          dos_header = LibC.GetModuleHandleA(nil).address
          fatal("iyi: no module handle for main image\n") if dos_header == 0
          fatal("iyi: main image is not PE\n") if (IyiHeap.read64(dos_header) & 0xFFFF_u64) != 0x5A4D_u64
          e_lfanew = IyiHeap.read64(dos_header + 0x3C_u64) & 0xFFFFFFFF_u64
          nt_headers = dos_header + e_lfanew
          fatal("iyi: main image is not PE\n") if (IyiHeap.read64(nt_headers) & 0xFFFFFFFF_u64) != 0x4550_u64
          file_header = nt_headers + 4_u64
          num_sections = (IyiHeap.read64(file_header).unsafe_shr(16_u64)) & 0xFFFF_u64
          size_opt_header = (IyiHeap.read64(file_header + 16_u64)) & 0xFFFF_u64
          section_header = file_header + 20_u64 + size_opt_header

          seen = 0_u64
          while seen < num_sections
            name = IyiHeap.read64(section_header)
            word8 = IyiHeap.read64(section_header + 8_u64)
            vsize = word8 & 0xFFFFFFFF_u64
            vaddr = word8.unsafe_shr(32_u64)
            if name == 0x000000617461642E_u64 # .data
              @@data_low = dos_header + vaddr
              @@data_high = @@data_low + vsize
            elsif name == 0x000000007373622E_u64 # .bss
              @@bss_low = dos_header + vaddr
              @@bss_high = @@bss_low + vsize
            end
            section_header = section_header + 40_u64
            seen = seen + 1_u64
          end
          fatal("iyi: no data/bss segments in PE image\n") if @@data_high <= @@data_low && @@bss_high <= @@bss_low
          @@found_globals = 1_u64
        end
      {% else %}
        # `.data` and `.bss`, which are contiguous in every ELF layout the
        # link templates produce, so the two symbols bound one range rather
        # than two. There is no second range on this target, which is why
        # `@@const_low` and `@@const_high` stay zero here and the scan skips
        # an empty range rather than needing a flag to tell it to.
        def self.discover_globals : Nil
          {% if flag?(:musl) %}
            low = pointerof(LibIyiImage.__bss_start).address
          {% else %}
            low = pointerof(LibIyiImage.__data_start).address
          {% end %}
          high = pointerof(LibIyiImage._end).address
          fatal("iyi: the static data span is not a range\n") if high <= low
          @@data_low = low
          @@data_high = high
          @@found_globals = 1_u64
        end
      {% end %}

      def self.globals : Nil
        discover_globals if @@found_globals == 0
      end

      def self.data_low : UInt64
        globals
        @@data_low
      end

      def self.data_high : UInt64
        globals
        @@data_high
      end

      def self.const_low : UInt64
        globals
        @@const_low
      end

      def self.const_high : UInt64
        globals
        @@const_high
      end
      def self.bss_low : UInt64
        globals
        @@bss_low
      end

      def self.bss_high : UInt64
        globals
        @@bss_high
      end

      # Is this word a pointer to a live object, and if so where does that
      # object start? One answer for both questions, because a root usually
      # points into the middle of an object and the marker needs the base.
      # Zero means "not a heap pointer", which is also the answer for a null
      # word, for a word in no arena, for a word in the part of an arena that
      # was never carved, and for a word in a chunk that has been freed.
      #
      # Stage 2 answers the first half already: `containing` names the arena
      # a pointer is in, and the arena's header names its chunk size, so the
      # chunk a word falls in is arithmetic rather than a search. The rest is
      # the part Stage 2 had no reason to answer. A chunk at or past the fill
      # cursor was never handed out, which is also how the tail of an arena
      # too short for one more chunk is rejected. A chunk on its class's free
      # list was handed out and given back, and reporting it live would keep
      # a dead object alive forever, since nothing would ever free it twice.
      #
      # The freed check is one load — the FREE flag in the chunk's own mark
      # word. It began as a walk of the class's free list, which the comment
      # here called fine "before a profile asks": the trigger's steady state
      # asked, a long free list made every sweep quadratic, and the flag is
      # the per-chunk bit the same comment predicted.
      def self.base_of(word : UInt64) : UInt64
        return 0_u64 if word == 0
        candidate = Pointer(Void).new(word)
        arena = IyiHeap.containing(candidate)
        if arena != 0
          head = IyiHeap.head_of(arena, word)
          return 0_u64 if IyiHeap.uncarved?(arena, head)
          bits = IyiHeap.read8(IyiHeap.meta(arena, head))
          return 0_u64 if bits & IyiHeap::FREE_FLAG != 0
          return bits & IyiHeap::HEADED_FLAG != 0 ? head + IyiHeap::HEADER : head
        end
        node = IyiHeap.containing_large(candidate)
        return node + IyiHeap::LARGE_USER if node != 0
        0_u64
      end

      # One load of the chunk's byte: the sweep and `IyiHeap.free` set the
      # flag when the chunk went on a list or idle, and `take` clears it
      # when the chunk comes back out. The list walk this used to be was
      # linear in the chunks freed for the class, which made the sweep
      # over them quadratic once the trigger gave every steady-state heap
      # a long free list.
      def self.free_listed?(arena : UInt64, head : UInt64) : Bool
        IyiHeap.read8(IyiHeap.meta(arena, head)) & IyiHeap::FREE_FLAG != 0
      end

      # Every 8-aligned word in [low, high), with the ones that validate
      # handed to the callback as the base of the object they reach. The same
      # base can be reported more than once, because more than one root can
      # reach one object; marking is idempotent, so deduplicating is the
      # caller's business and not worth a set here.
      def self.scan_range(low : UInt64, high : UInt64, visit : Proc(UInt64, Nil)) : Nil
        return if high <= low
        cursor = low
        remainder = cursor.unsafe_mod(8_u64)
        cursor = cursor + (8_u64 - remainder) if remainder != 0
        while cursor + 8_u64 <= high
          base = base_of(IyiHeap.read64(cursor))
          visit.call(base) if base != 0
          cursor = cursor + 8_u64
        end
      end

      # The running stack. Its high end is the thread's own top — the main
      # thread's base, or a started thread's own mapping — unless a spawned
      # fiber is executing, in which case it is that fiber's mmap'd top:
      # scanning up to the thread base from a fiber stack would walk the
      # unmapped gap between the two mappings and fault.
      def self.each_stack_root(visit : Proc(UInt64, Nil)) : Nil
        top = 0_u64
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
          top = IyiScheduler.current_stack_top
          top = IyiThread.current_stack_top if top == 0
        {% end %}
        top = stack_base if top == 0
        scan_range(stack_pointer, top, visit)
      end

      # Every other thread's registers and stack, each stopped where it
      # was by the collection that asks (thread.iyi); on one thread, an
      # empty walk.
      def self.each_thread_root(visit : Proc(UInt64, Nil)) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
          IyiThread.each_stopped_root(visit)
        {% end %}
      end

      # Every suspended fiber's stack, from its saved stack pointer to its
      # top (GC_DESIGN.md Stage 3's fourth task, closed). The registry is
      # the scheduler's all-fibers list, because the wait queues cannot
      # serve this walk: a channel-parked fiber lives in the channel's own
      # nodes. Skipped by state: the running fiber is `each_stack_root`'s
      # business, a done fiber's stack holds nothing live, and a fiber that
      # never suspended has no saved pointer to scan from. The main fiber's
      # top is 0 in the registry, standing for the thread base this module
      # discovered. On the targets with no scheduler there is nothing to
      # walk and this is the empty walk it looks like.
      def self.each_fiber_root(visit : Proc(UInt64, Nil)) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
          fiber = IyiScheduler.first_fiber
          while fiber.is_a?(IyiFiber)
            if fiber.state != IyiFiberState::Running && fiber.state != IyiFiberState::Done && fiber.saved_sp != 0
              top = fiber.stack_top
              top = stack_base if top == 0
              scan_range(fiber.saved_sp, top, visit)
            end
            fiber = fiber.next_fiber
          end
        {% end %}
      end

      # The spill buffer as a root range. Writing the registers somewhere the
      # scan does not reach would be the same as not capturing them.
      def self.each_register_root(visit : Proc(UInt64, Nil)) : Nil
        buffer = spill
        scan_range(buffer, buffer + SPILL, visit)
      end

      def self.each_global_root(visit : Proc(UInt64, Nil)) : Nil
        scan_range(data_low, data_high, visit)
        scan_range(const_low, const_high, visit)
        {% if flag?(:win32) %}
          scan_range(bss_low, bss_high, visit)
        {% end %}
      end

      # The whole root set: the running stack, the spilled registers, the
      # globals, and every suspended fiber's stack — the gap the block
      # above used to record, closed by the scheduler's registry. The
      # spill happens first and before anything calls back into user code,
      # because the callback is user code and user code uses registers.
      def self.each_root(visit : Proc(UInt64, Nil)) : Nil
        spill_registers
        each_register_root(visit)
        each_stack_root(visit)
        each_thread_root(visit)
        each_fiber_root(visit)
        each_global_root(visit)
      end

      # The root set as a helper sees it at the mark's second stop: every
      # stopped thread's registers and stack, the fibers, the globals — and
      # not the helper's own stack, which holds no object of the program's
      # and sits in a mapping no thread base bounds.
      def self.each_root_of_others(visit : Proc(UInt64, Nil)) : Nil
        each_thread_root(visit)
        each_fiber_root(visit)
        each_global_root(visit)
      end
    end

    # iyi: GC_DESIGN.md Stage 5, the mark phase. Roots go gray, the queue
    # drains, and what is still white when it stops is unreachable. Nothing
    # sweeps yet: this stage decides what is garbage, Stage 6 reclaims it.
    #
    # Colour is a byte per chunk in the arena's mark table - 0 white, 1
    # gray, 2 black, matching `Iyi::Collector::ObjectHeader` in the
    # compiler - and bits 0 and 1 of the word at `base - 8` for a large
    # object; a fresh chunk's byte is zero, so a newly allocated object is
    # white without anyone writing anything (`IyiHeap::OFF_MARKS`).
    #
    # **Precise where the header says a type, conservative everywhere else.**
    # Codegen stores an object's `type_id` at `P-16` at the allocation site
    # (`allocate_aggregate`), and this loop looks the id up in the layout
    # table the same compiler embedded (`__iyi_gc_layouts`,
    # `codegen/gc_layouts.cr`): a hit scans exactly the pointer offsets the
    # `TypeLayout` names, so an integer that happens to hold an address no
    # longer retains a dead object through a typed field. An id of zero — a
    # `Pointer(T).malloc` buffer, a closure environment, anything not
    # allocated as an instance of a type — word-scans between the user
    # pointer and the size the header carries, which is what Boehm does in
    # production and is safe in the direction that matters: a false positive
    # retains a dead object, only a false negative frees a live one. A
    # missing table entry falls back the same way, never a crash.
    #
    # Plain loads and stores rather than compare-and-swap: one mutator
    # thread, and the scheduler's fibers yield only at suspension points,
    # never inside the marker. `ObjectHeader`'s CAS helpers exist and are
    # tested for when Stage 7 has threads to contend, and with a single
    # mutator a CAS and a load-store pair decide the same thing.

    # The compiler's embedded layout table. The symbol is a pointer-sized
    # global whose value is the table's address (`gc_layouts.cr` gives it
    # its one real definition, an empty table included, so referencing it
    # can never cost a link). Declared the way `__data_start` is: an
    # external the link already owes, no library.
    lib LibIyiGCTable
      $__iyi_gc_layouts : Void*
      # Non-zero while a mark runs beside the program: what every
      # pointer-bearing store the compiler emits checks before it calls
      # the barrier. Codegen defines the byte; only the marker writes it.
      $__iyi_marking : UInt8
    end

    # The barrier's two entry points, called by name from the code the
    # compiler emits around a store (SPEC.md II.5, GC_DESIGN.md Stage 9).
    fun __iyi_write_barrier_begin : Nil
      IyiHeap.enter_barrier
    end

    fun __iyi_write_barrier(address : Void*, words : UInt64) : Nil
      IyiMark.barrier(address.address, words)
      IyiHeap.leave_barrier
    end

    class IyiMark
      WHITE = 0_u64
      GRAY  = 1_u64
      BLACK = 2_u64
      COLOUR = 3_u64

      # ── The parallel marker's memory ───────────────────────────────────
      #
      # Nothing here is the heap being marked: a mark phase that allocated
      # from that heap could carve a chunk, or hand back one it is about to
      # decide the liveness of, which is a collector reasoning about memory
      # it is mutating. Every worker — the collecting thread and the helpers
      # `IyiThread.start_helper` gave the collector — has a stack of its
      # own, a mapping named by a `@[ThreadLocal]`; gray objects go there
      # first, and only a full stack spills. What is shared is a pool of
      # batches (GC_DESIGN.md Stage 7's work distribution): a worker whose
      # stack passes SPILL_AT moves a batch of BATCH entries to the pool
      # under the pool's own lock, a worker whose stack runs dry takes a
      # batch from it, and the mark is over when the pool is empty and no
      # worker holds work. A batch taken is a batch's words free again
      # (`take_batch`, `free_batch`): batches come from a free list first
      # and from a bump region in POOL_PIECE-byte pieces after it, so what
      # the pool holds resident is the most batches ever in it at once,
      # not every batch a mark ever published - 64 MB was reserved for
      # those and the first touch of it was a transparent huge page, 2 MB
      # resident for binary trees' 425 KB of batches and for the
      # resident-set probe's 12 KB. The pieces refuse huge pages and are
      # never given back: the free list is the pool's memory across
      # marks, and it never touches the heap and never leaks.
      # A worker's stack begins STACK_START entries long and doubles as a
      # mark needs it (`grow_stack`): the 32 MB each was reserved with
      # was address space and overcommit, 272 MB of it for eight
      # workers, for a mark whose deepest stack was thirty entries.
      SPILL_AT = 512_u64
      BATCH = 128_u64
      BATCH_WORDS = 130_u64
      STACK_START = 8192_u64
      POOL_PIECE = 65536_u64

      # A worker's state is one page, and one `@[ThreadLocal]` names the
      # thread's page: read once when a drain begins and passed down as
      # `w`, because every thread-local read is a `noinline` call (the
      # compiler's rule, so a fiber that changes threads never reads a
      # cached address), and fifteen of them per object doubled the mark.
      #   +0   the stack's mapping     +8   its length in entries
      #   +16  bytes this worker blackened
      #   +24  the arena its pending live count is for   +32  the count
      #   +40  the type id whose layout entry is cached   +48  the entry
      #   +88  the stack's capacity in entries
      @[ThreadLocal]
      @@worker : UInt64 = 0_u64
      @@collector_worker : UInt64 = 0_u64
      W_STACK = 0_u64
      W_LEN = 8_u64
      W_BYTES = 16_u64
      W_LIVE_ARENA = 24_u64
      W_LIVE_PENDING = 32_u64
      W_LAST_TYPE = 40_u64
      W_LAST_ENTRY = 48_u64
      W_BLACK = 56_u64
      W_SINCE = 64_u64

      # The pool: a lock word, the batch list's head, the bump piece and
      # its cursor and end, the free batches, the count of workers holding
      # work, and the generation the helpers wake on — each on a line of
      # its own in one mapping.
      @@pool : UInt64 = 0_u64
      POOL_LOCK = 0_u64
      POOL_HEAD = 64_u64
      POOL_CURSOR = 192_u64
      POOL_ACTIVE = 256_u64
      POOL_GENERATION = 320_u64
      POOL_HELPERS_DONE = 384_u64
      # Helpers that took a permit for the mark in flight: reset to zero
      # wherever permits are set, counted up by each taker, and the
      # taker's slot is the count it found. `take_mark_permit` says why
      # it is a count and not a difference.
      POOL_MARK_TAKEN = 448_u64
      POOL_READY = 512_u64
      # The sweep round (GC_DESIGN.md Stage 8): open after a collection
      # while helpers may claim arenas, closed by the next collection
      # before it stops anything; and how many helper walks are in flight.
      POOL_SWEEP = 576_u64
      POOL_SWEEPERS = 640_u64
      POOL_SWEEP_PERMITS = 704_u64
      # The class an allocating thread is waiting on, plus one; 0 is none.
      # A helper's claim takes an arena of that class first.
      POOL_SWEEP_WANTED = 768_u64
      # A mark's permits: as many as it asks helpers, taken one each by
      # whichever helpers wake first, and the first taker is the one that
      # finishes a concurrent mark. Every helper is woken and one that
      # finds no permit parks again, so a mark over a small heap asks one
      # helper and fifteen do not contend for its pool - churn's 122
      # marks are 40 ms of wall time with permits and 52 without.
      #
      # The count they are waited for is the count *taken*, never the
      # count asked: a helper can miss a generation altogether - it spends
      # its wake on the sweep round, and by the time it looks again the
      # mark's generation is the one it has already seen - and a wait for
      # a headcount that never arrives is a hang, which is what three
      # cores found one run in three.
      #
      # Taken is a word of its own, POOL_MARK_TAKEN, counted up by each
      # taker. It was a difference - the count asked less the permits
      # left - and a difference of two words that are set one after the
      # other is a race: a helper whose CAS on the permits landed just
      # before a round reset both words read the new asked, 0, less its
      # old permit and underflowed, and the thread exercise panicked on
      # arithmetic overflow once in eighty runs on eight threads.
      POOL_MARK_PERMITS = 832_u64
      POOL_FINISH = 896_u64
      # The free batches, pushed without the lock and popped under it
      # (`free_batch`, `new_batch`); the end of the bump piece; and the
      # pieces mapped, which is what the pool holds resident in units of
      # POOL_PIECE - the exercises read it.
      POOL_FREE = 960_u64
      POOL_PIECE_END = 1024_u64
      POOL_PIECES = 1088_u64
      NO_PERMIT = 0xFFFFFFFFFFFFFFFF_u64

      # A mark's permit, or NO_PERMIT: the slot is the order of taking,
      # 0 for the first, and it is the count of takers before this one.
      def self.take_mark_permit : UInt64
        word = pool_word(POOL_MARK_PERMITS)
        while true
          left = word.value.get
          return NO_PERMIT if left == 0_u64
          return pool_word(POOL_MARK_TAKEN).value.add(1_u64) if word.value.compare_and_set(left, left - 1_u64)[1]
        end
      end

      # How many helpers took a permit for the mark in flight.
      def self.mark_takers : UInt64
        pool_word(POOL_MARK_TAKEN).value.get
      end


      # Helpers: how many the collector may use besides itself, how many
      # exist, and the threshold under which a mark runs alone — waking
      # fifteen threads to mark a hundred kilobytes costs more than the
      # marking, and the last mark's live bytes are the estimate.
      @@workers : UInt64 = 0_u64
      @@helpers : UInt64 = 0_u64
      @@helpers_wanted : UInt64 = 0_u64
      @@helpers_decided : Bool = false
      @@workers_set : Bool = false
      @@last_marked : UInt64 = 0_u64
      PARALLEL_FROM = 1048576_u64

      # What the last sweep reclaimed and kept, and how many collections have
      # run. Literal initializers, so codegen folds them to a static zero the
      # way every other piece of state in this file does.
      @@swept : UInt64 = 0_u64
      @@kept : UInt64 = 0_u64
      @@bytes_freed : UInt64 = 0_u64
      @@bytes_kept : UInt64 = 0_u64
      # What the sweep walked: every carved byte of every arena, live or
      # not, which is what a sweep costs and what the budget is floored by.
      @@bytes_walked : UInt64 = 0_u64
      @@collections : UInt64 = 0_u64
      @@arenas_released : UInt64 = 0_u64
      @@pause_last : UInt64 = 0_u64
      @@pause_max : UInt64 = 0_u64
      @@pause_total : UInt64 = 0_u64

      # The pause clock. Linux asks the kernel directly — clock_gettime,
      # CLOCK_MONOTONIC — writing the timespec into the caller's frame,
      # because a collector must not allocate from the heap it is
      # collecting, not even sixteen bytes for a stamp, and a page shared
      # between callers is a stamp two threads tear: the runtime's own
      # calls are all under its lock, but a probe that read the clock from
      # an allocation while helper 0 read it under the lock saw time go
      # backwards. darwin asks libSystem's clock_gettime_nsec_np for
      # CLOCK_MONOTONIC_RAW, the scheduler's own clock and for its reason:
      # a pause is microseconds, and 6 would report it in whole ones.
      {% if flag?(:linux) %}
        lib LibIyiClock
          struct Timespec
            sec : Int64
            nsec : Int64
          end
        end
      {% end %}

      def self.now_ns : UInt64
        {% if flag?(:linux) %}
          stamp = uninitialized LibIyiClock::Timespec
          result = uninitialized Int64
          {% if flag?(:x86_64) %}
            asm("syscall" : "={rax}"(result)
                          : "{rax}"(228_i64), "{rdi}"(1_i64), "{rsi}"(pointerof(stamp))
                          : "rcx", "r11", "memory"
                          : "volatile")
          {% else %}
            asm("svc #0" : "={x0}"(result)
                         : "{x8}"(113_i64), "{x0}"(1_i64), "{x1}"(pointerof(stamp))
                         : "memory"
                         : "volatile")
          {% end %}
          stamp.sec.to_u64 * 1000000000_u64 + stamp.nsec.to_u64
        {% elsif flag?(:win32) %}
          counts = uninitialized Int64
          freq = uninitialized Int64
          LibC.QueryPerformanceCounter(pointerof(counts))
          LibC.QueryPerformanceFrequency(pointerof(freq))
          return 0_u64 if freq <= 0_i64
          c = counts.to_u64
          f = freq.to_u64
          (c.unsafe_div(f) * 1000000000_u64) + (c.unsafe_mod(f) * 1000000000_u64).unsafe_div(f)
        {% else %}
          LibC.clock_gettime_nsec_np(4)
        {% end %}
      end

      # An object's collector bits: the chunk's entry byte and its colour
      # byte in its arena's tables, or a large object's header word
      # (`IyiHeap::META`). Read and written through these, so the two
      # homes are one question here.
      def self.flags(base : UInt64) : UInt64
        arena = IyiHeap.arena_of(base)
        return IyiHeap.read64(base - 8_u64) & 0xFFFFFFFF_u64 if arena == 0
        (IyiHeap.read8(IyiHeap.meta(arena, base)) & (IyiHeap::CARVED_FLAG - 1_u64)) | IyiHeap.read8(IyiHeap.mark_byte(arena, base))
      end

      def self.colour(base : UInt64) : UInt64
        byte = IyiHeap.mark_byte_of(base)
        byte == 0 ? IyiHeap.read64(base - 8_u64) & COLOUR : IyiHeap.read8(byte)
      end

      # An object's type id: under it when it is headed or large, in its
      # arena's layout table when headless - 0 for untyped memory.
      def self.type_id_of(base : UInt64) : UInt64
        arena = IyiHeap.arena_of(base)
        return IyiHeap.read64(base - 8_u64).unsafe_shr(IyiHeap::TYPE_SHIFT) if arena == 0
        bits = IyiHeap.read8(IyiHeap.meta(arena, base))
        return 0_u64 if bits & IyiHeap::UNTYPED_FLAG != 0
        return IyiHeap.read64(base - 8_u64).unsafe_shr(IyiHeap::TYPE_SHIFT) if bits & IyiHeap::HEADED_FLAG != 0
        IyiHeap.read16(IyiHeap.layout_slot(arena, base))
      end

      # Set the colour and leave every other bit as it was.
      #
      # `word - (word & COLOUR)` is how the low two bits get cleared, and the
      # shape is dictated by what this prelude actually defines on `UInt64`.
      # Neither `~` nor `>>` is there, and the literal 2^64-4 as a mask invited
      # a question about whether a literal that large round-trips exactly, which
      # is not a question worth carrying in the one line that decides an
      # object's colour. Subtracting the low bits from the word needs only `&`
      # and `-`, both of which this file already relies on everywhere.
      def self.recolour(base : UInt64, colour : UInt64) : Nil
        byte = IyiHeap.mark_byte_of(base)
        if byte == 0
          word = IyiHeap.read64(base - 8_u64)
          IyiHeap.write64(base - 8_u64, (word - (word & COLOUR)) | colour)
        else
          IyiHeap.write8(byte, colour)
        end
      end

      # White to gray, atomically where another worker may be at the same
      # object: true when this call was the one that grayed it. A byte's
      # compare-and-set for a chunk, the word's for a large object.
      def self.gray!(base : UInt64) : Bool
        byte = IyiHeap.mark_byte_of(base)
        if byte == 0
          word_pointer = Pointer(Atomic(UInt64)).new(base - 8_u64)
          word = word_pointer.value.get
          while word & COLOUR == WHITE
            return true if word_pointer.value.compare_and_set(word, word | GRAY)[1]
            word = word_pointer.value.get
          end
          false
        else
          # A plain read first: the barrier's usual object is one born
          # black under this mark, and a compare-and-set that fails is
          # still a locked write of the line.
          return false if IyiHeap.read8(byte) != WHITE
          Pointer(Atomic(UInt8)).new(byte).value.compare_and_set(WHITE.to_u8!, GRAY.to_u8!)[1]
        end
      end

      # The pool's page, made by the first collection before any helper
      # exists: `start_helpers` makes it, under the runtime lock, and a
      # helper's first `pool_word` finds it made. Two threads reaching
      # here at once would each map a page and count on different ones -
      # the first concurrent collection hung that way, its helpers ready
      # on a page the collector never read.
      def self.pool : UInt64
        @@pool = __iyi_mmap(4096_u64).address if @@pool == 0
        @@pool
      end

      def self.pool_word(offset : UInt64) : Pointer(Atomic(UInt64))
        Pointer(Atomic(UInt64)).new(pool + offset)
      end

      def self.pool_lock : Nil
        word = pool_word(POOL_LOCK)
        while !word.value.compare_and_set(0_u64, 1_u64)[1]
        end
      end

      def self.pool_unlock : Nil
        pool_word(POOL_LOCK).value.set(0_u64)
      end

      # A batch's words: off the free list, or from the bump piece, or
      # from a fresh piece. Under the pool lock, the only popper; the
      # pushers are lock-free (`free_batch`), so the pop is a
      # compare-and-set too.
      def self.new_batch : UInt64
        free = pool_word(POOL_FREE)
        while true
          head = free.value.get
          break if head == 0
          return head if free.value.compare_and_set(head, IyiHeap.read64(head))[1]
        end
        cursor = IyiHeap.read64(pool + POOL_CURSOR)
        if cursor + BATCH_WORDS * 8_u64 > IyiHeap.read64(pool + POOL_PIECE_END)
          cursor = __iyi_mmap(POOL_PIECE).address
          {% if flag?(:linux) %}
            __iyi_madvise_nohuge(cursor, POOL_PIECE)
          {% end %}
          IyiHeap.write64(pool + POOL_PIECE_END, cursor + POOL_PIECE)
          IyiHeap.write64(pool + POOL_PIECES, IyiHeap.read64(pool + POOL_PIECES) + 1_u64)
        end
        IyiHeap.write64(pool + POOL_CURSOR, cursor + BATCH_WORDS * 8_u64)
        cursor
      end

      # A batch's words back on the free list, from any thread, no lock:
      # a push is one compare-and-set on the head, and the head is only
      # ever popped under the lock, so no batch is popped and pushed
      # again under a pusher's feet.
      def self.free_batch(batch : UInt64) : Nil
        free = pool_word(POOL_FREE)
        while true
          head = free.value.get
          IyiHeap.write64(batch, head)
          break if free.value.compare_and_set(head, batch)[1]
        end
      end

      # Bytes the pool holds mapped for batches: the exercises read it.
      def self.pool_bytes : UInt64
        IyiHeap.read64(pool + POOL_PIECES) * POOL_PIECE
      end

      # This thread's worker page and stack, mapped on first use.
      # Every page ever made, linked for the final stop, which flushes what
      # every mutator's barrier left on its stack.
      W_NEXT = 72_u64
      # Bytes this thread allocated while a mark ran beside it: born gray,
      # so counted marked, but not survivors of anything - the budget is
      # set from the marked bytes less these.
      W_BORN = 80_u64
      W_CAP = 88_u64
      @@worker_pages : UInt64 = 0_u64

      def self.worker : UInt64
        w = @@worker
        if w == 0
          w = __iyi_mmap(4096_u64).address
          IyiHeap.write64(w + W_STACK, __iyi_mmap(STACK_START * 8_u64).address)
          IyiHeap.write64(w + W_CAP, STACK_START)
          pool_lock
          IyiHeap.write64(w + W_NEXT, @@worker_pages)
          @@worker_pages = w
          pool_unlock
          @@worker = w
        end
        w
      end

      # The stack made long enough for `need` entries: doubled until it
      # is, the entries copied over, the old mapping given back. Rare - a
      # mark of a tree keeps a stack as deep as the tree, and a stack of
      # any depth spills past SPILL_AT with helpers - so a copy is what
      # it costs, once per doubling. Answers the mapping.
      def self.grow_stack(w : UInt64, need : UInt64) : UInt64
        cap = IyiHeap.read64(w + W_CAP)
        return IyiHeap.read64(w + W_STACK) if need <= cap
        grown = cap
        while grown < need
          grown = grown * 2_u64
        end
        old = IyiHeap.read64(w + W_STACK)
        stack = __iyi_mmap(grown * 8_u64).address
        {% if flag?(:linux) %}
          # A stack big enough to hold a huge page refuses one: touched at
          # one end, it would be 2 MB resident for a few entries.
          __iyi_madvise_nohuge(stack, grown * 8_u64) if grown * 8_u64 >= 2097152_u64
        {% end %}
        len = IyiHeap.read64(w + W_LEN)
        index = 0_u64
        while index < len
          IyiHeap.write64(stack + index * 8_u64, IyiHeap.read64(old + index * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(w + W_STACK, stack)
        IyiHeap.write64(w + W_CAP, grown)
        __iyi_munmap(old, cap * 8_u64)
        @@stacks_grown = @@stacks_grown + 1_u64
        stack
      end

      @@stacks_grown : UInt64 = 0_u64

      # Times a worker's stack doubled, in all: the exercises read it.
      def self.stacks_grown : UInt64
        @@stacks_grown
      end

      # ── The write barrier's half ────────────────────────────────────────
      #
      # A mutator that stored a pointer-bearing value while a mark runs
      # calls in with the destination's words; each heap pointer among them
      # is grayed and queued on this thread's own stack, which is handed to
      # the pool in batches so the helpers marking beside the program find
      # it. An object born during the mark comes the same way.
      MUTATOR_BATCH = 64_u64

      def self.barrier(address : UInt64, words : UInt64) : Nil
        w = worker
        index = 0_u64
        while index < words
          base = IyiRoots.base_of(IyiHeap.read64(address + index * 8_u64))
          mutator_shade(w, base) if base != 0
          index = index + 1_u64
        end
      end

      # The assist, GC_DESIGN.md Stage 9: a mutator that allocated a slice
      # under a running mark scans ASSIST_OBJECTS of the pool's before it
      # goes on, so that a program allocating faster than the helpers mark
      # cannot outrun them - thirty-two threads allocating through a mark
      # bore 13 MB beside a 4 MB budget, and every collection's end was
      # the next one's trigger. Go's mutator assist is the same bargain,
      # scan work bought per byte allocated. The mutator counts itself
      # active on the pool while it holds a batch, so the helpers' end of
      # mark waits for it, and what it has not scanned it publishes back.
      ASSIST_OBJECTS = 1024_u64

      def self.assist : Nil
        return if LibIyiGCTable.__iyi_marking == 0_u8
        w = worker
        active = pool_word(POOL_ACTIVE)
        active.value.add(1_u64)
        scanned = 0_u64
        while scanned < ASSIST_OBJECTS
          # An assist runs inside the allocator, where a stop is deferred
          # until the thread leaves: a thousand objects were a hundred
          # microseconds a second stop waited for. A stop asked for ends
          # the assist where it stands; what is left stays on the stack.
          break if IyiHeap.stop_requested?
          len = IyiHeap.read64(w + W_LEN)
          if len == 0_u64
            break unless take_batch(w)
            len = IyiHeap.read64(w + W_LEN)
          end
          len = len - 1_u64
          IyiHeap.write64(w + W_LEN, len)
          # The stack read each time: a push inside `scan` may have grown
          # and moved it (`grow_stack`).
          scan(w, IyiHeap.read64(IyiHeap.read64(w + W_STACK) + len * 8_u64))
          scanned = scanned + 1_u64
        end
        flush_mutator(w)
        flush_live(w)
        active.value.sub(1_u64)
      end

      # An object born under the mark is born black - Go's allocate-black:
      # its fields are empty now and every store into them goes through
      # the barrier, so there is nothing for a worker to scan, and the
      # first cut, which grayed it onto the barrier stack, fed the pool a
      # batch per sixty-four allocations from every thread and the mark
      # could not find the pool empty to end. Born white instead, alive
      # to the sweep by its parity, was tried when the colour left the
      # header: every store of a fresh object into a fresh parent then
      # grayed and pushed it, and the helpers marked the whole of what
      # the program built under the mark - binary trees on eight cores
      # 169 ms to 175, against 151 for the tree before. The black byte
      # is one store on the mark table's line for this run of chunks,
      # which the next sixty-three allocations share. Counted live in
      # its arena here, as a scan would have: the scavenge reads that
      # count.
      def self.born_during_mark(base : UInt64, size : UInt64) : Nil
        w = worker
        IyiHeap.write64(w + W_BORN, IyiHeap.read64(w + W_BORN) + size)
        recolour(base, BLACK)
        count_live(w, IyiHeap.arena_of(base))
      end

      def self.mutator_shade(w : UInt64, base : UInt64) : Nil
        mutator_push(w, base) if gray!(base)
      end

      def self.mutator_push(w : UInt64, base : UInt64) : Nil
        len = IyiHeap.read64(w + W_LEN)
        IyiHeap.write64(grow_stack(w, len + 1_u64) + len * 8_u64, base)
        len = len + 1_u64
        IyiHeap.write64(w + W_LEN, len)
        flush_mutator(w) if len >= MUTATOR_BATCH
      end

      # A mutator's stack to the pool, whole.
      def self.flush_mutator(w : UInt64) : Nil
        len = IyiHeap.read64(w + W_LEN)
        return if len == 0_u64
        stack = IyiHeap.read64(w + W_STACK)
        given = 0_u64
        while given < len
          count = len - given
          count = BATCH if count > BATCH
          publish(stack + given * 8_u64, count)
          given = given + count
        end
        IyiHeap.write64(w + W_LEN, 0_u64)
      end

      # Onto this worker's stack — and, with helpers, work shared where it
      # helps: a stack past SPILL_AT spills its top; a stack of any depth
      # donates its *bottom* half when the pool is empty and a worker is
      # idle, because a depth-first mark of a tree keeps a stack as deep
      # as the tree and no deeper (the oldest entries are the widest
      # subtrees), and a marker that only spilled a full stack never
      # shared a tree at all — measured, fifteen helpers idle through
      # binary trees.
      def self.push(w : UInt64, base : UInt64) : Nil
        len = IyiHeap.read64(w + W_LEN)
        if @@workers > 1_u64
          if len >= SPILL_AT
            spill(w)
            len = IyiHeap.read64(w + W_LEN)
          else
            # A donation at most every DONATE_EVERY pushes: the first cut
            # of this gave half of an eight-entry stack on every push to
            # fifteen idle helpers, a million nodes in eight-entry batches
            # through one lock, and the mark took twice as long as alone.
            since = IyiHeap.read64(w + W_SINCE) + 1_u64
            if since >= DONATE_EVERY && len >= 2_u64 && IyiHeap.read64(pool + POOL_HEAD) == 0 && pool_word(POOL_ACTIVE).value.get < @@workers
              donate(w)
              len = IyiHeap.read64(w + W_LEN)
              since = 0_u64
            end
            IyiHeap.write64(w + W_SINCE, since)
          end
        end
        IyiHeap.write64(grow_stack(w, len + 1_u64) + len * 8_u64, base)
        IyiHeap.write64(w + W_LEN, len + 1_u64)
      end

      DONATE_EVERY = 256_u64

      # BATCH entries off the top of this stack into the pool.
      def self.spill(w : UInt64) : Nil
        stack = IyiHeap.read64(w + W_STACK)
        len = IyiHeap.read64(w + W_LEN) - BATCH
        publish(stack + len * 8_u64, BATCH)
        IyiHeap.write64(w + W_LEN, len)
      end

      # The bottom half of this stack into the pool, the rest shifted down.
      def self.donate(w : UInt64) : Nil
        stack = IyiHeap.read64(w + W_STACK)
        len = IyiHeap.read64(w + W_LEN)
        give = len.unsafe_div(2_u64)
        give = BATCH if give > BATCH
        publish(stack, give)
        rest = len - give
        index = 0_u64
        while index < rest
          IyiHeap.write64(stack + index * 8_u64, IyiHeap.read64(stack + (give + index) * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(w + W_LEN, rest)
      end

      # `count` entries from `from` as one batch on the pool. A batch's
      # first word links it, its second says how many it holds.
      def self.publish(from : UInt64, count : UInt64) : Nil
        pool_lock
        batch = new_batch
        IyiHeap.write64(batch + 8_u64, count)
        index = 0_u64
        while index < count
          IyiHeap.write64(batch + 16_u64 + index * 8_u64, IyiHeap.read64(from + index * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(batch, IyiHeap.read64(pool + POOL_HEAD))
        IyiHeap.write64(pool + POOL_HEAD, batch)
        pool_unlock
      end

      # A batch from the pool onto this stack; false when the pool is empty.
      def self.take_batch(w : UInt64) : Bool
        return false if IyiHeap.read64(pool + POOL_HEAD) == 0
        pool_lock
        batch = IyiHeap.read64(pool + POOL_HEAD)
        if batch == 0
          pool_unlock
          return false
        end
        IyiHeap.write64(pool + POOL_HEAD, IyiHeap.read64(batch))
        pool_unlock
        len = IyiHeap.read64(w + W_LEN)
        count = IyiHeap.read64(batch + 8_u64)
        stack = grow_stack(w, len + count)
        index = 0_u64
        while index < count
          IyiHeap.write64(stack + (len + index) * 8_u64, IyiHeap.read64(batch + 16_u64 + index * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(w + W_LEN, len + count)
        # The batch's words are free again: the entries are this stack's.
        free_batch(batch)
        true
      end

      # Gray, if it was white, and onto this worker's stack. Alone, a plain
      # store; with helpers, one compare-and-swap on the colour bits so two
      # workers that reach an object from two parents agree on who queues
      # it. Everything above the colour rides along unchanged.
      # A word that may point into the heap, shaded: `IyiRoots.base_of`
      # and `shade` in one pass for the mark's inner loop, because the
      # two apart resolved the arena and the chunk's index three times
      # over per pointer, and the grid arithmetic is a multiply each.
      # The chunk's byte is read once - free, or not white, and the
      # word is done with - and grayed by a compare-and-swap where
      # another worker may be at the same object.
      def self.shade_word(w : UInt64, word : UInt64) : Nil
        return if word == 0
        arena = IyiHeap.arena_of(word)
        if arena == 0
          shade(w, IyiRoots.base_of(word))
          return
        end
        grid = IyiHeap.read64(arena + IyiHeap::OFF_GRID)
        first = arena + grid.unsafe_shr(IyiHeap::GRID_SHIFT)
        return if word < first
        index = ((word - first).unsafe_shr(3_u64) * (grid & (1_u64.unsafe_shl(IyiHeap::GRID_SHIFT) - 1_u64))).unsafe_shr(IyiHeap::MAGIC_SHIFT)
        # The entry for carved, free and headed, the colour byte for
        # white. An uncarved chunk's entry is zero (`CARVED_FLAG`), a
        # free chunk's colour is white too, so the entry is the refusal
        # (`IyiHeap.free`, `sweep_slice`); neither the frontier nor the
        # idle bitmap is read, both being the carve's to write.
        bits = IyiHeap.read8(arena + IyiHeap::META + index * IyiHeap::META_ENTRY)
        return if bits & IyiHeap::CARVED_FLAG == 0 || bits & IyiHeap::FREE_FLAG != 0
        mark = IyiHeap.read64(arena + IyiHeap::OFF_MARKS) + index
        return if IyiHeap.read8(mark) != WHITE
        head = first + index * IyiHeap.read64(arena + IyiHeap::OFF_CHUNK)
        base = bits & IyiHeap::HEADED_FLAG != 0 ? head + IyiHeap::HEADER : head
        if @@workers > 1_u64
          push(w, base) if Pointer(Atomic(UInt8)).new(mark).value.compare_and_set(WHITE.to_u8!, GRAY.to_u8!)[1]
        else
          IyiHeap.write8(mark, GRAY)
          push(w, base)
        end
      end

      def self.shade(w : UInt64, base : UInt64) : Nil
        return if base == 0
        if @@workers > 1_u64
          push(w, base) if gray!(base)
        else
          byte = IyiHeap.mark_byte_of(base)
          if byte == 0
            word = IyiHeap.read64(base - 8_u64)
            return if word & COLOUR != WHITE
            IyiHeap.write64(base - 8_u64, word | GRAY)
          else
            return if IyiHeap.read8(byte) != WHITE
            IyiHeap.write8(byte, GRAY)
          end
          push(w, base)
        end
      end

      # The root visitor's shade: onto the collecting thread's stack.
      def self.shade(base : UInt64) : Nil
        shade(@@collector_worker, base)
      end

      # The table's address, read from the symbol once. Zero after the read
      # means an image with no table, which no build emits (`gc_layouts.cr`
      # writes an empty one), so it is treated as "no entry for anything"
      # rather than trusted.
      @@layouts : UInt64 = 0_u64

      def self.layouts_table : UInt64
        @@layouts = IyiHeap.read64(pointerof(LibIyiGCTable.__iyi_gc_layouts).address) if @@layouts == 0
        @@layouts
      end

      # Five words per entry, sorted by type id (`gc_layouts.cr` names the
      # word layout beside its writer): +0 id, +8 alloc size, +16 scan cap,
      # +24 offset count, +32 index into the offset words after the entries.
      ENTRY = 40_u64

      # The entry's address for a type id, or zero: zero id, no table, and
      # an id the table does not carry all answer zero, and every zero means
      # the same thing to `scan` — word-scan conservatively.
      def self.layout_entry(w : UInt64, type_id : UInt64) : UInt64
        return 0_u64 if type_id == 0
        return IyiHeap.read64(w + W_LAST_ENTRY) if type_id == IyiHeap.read64(w + W_LAST_TYPE)
        entry = layout_search(type_id)
        IyiHeap.write64(w + W_LAST_TYPE, type_id)
        IyiHeap.write64(w + W_LAST_ENTRY, entry)
        entry
      end

      def self.layout_search(type_id : UInt64) : UInt64
        table = layouts_table
        return 0_u64 if table == 0
        low = 0_u64
        high = IyiHeap.read64(table)
        while low < high
          mid = (low + high).unsafe_div(2_u64)
          entry = table + 8_u64 + mid * ENTRY
          entry_id = IyiHeap.read64(entry)
          return entry if entry_id == type_id
          if entry_id < type_id
            low = mid + 1_u64
          else
            high = mid
          end
        end
        0_u64
      end

      # Scan one object's payload and blacken it. With a layout, the scan is
      # exactly the pointer offsets the compiler wrote down — an integer
      # field holding something address-shaped retains nothing. An atomic
      # allocation with no layout is blackened and never opened: its caller
      # promised it holds no pointers, and honouring that promise is where
      # a 32 MiB `Array(Int32)` buffer stopped costing 20 ms of `base_of`
      # per collection. Everything else without a layout (a pointer-bearing
      # buffer, a closure environment, an id the table does not carry)
      # word-scans to the chunk's payload: the bytes past the request are
      # the allocator's zeros, or the last owner's, cleared at reuse.
      def self.scan(w : UInt64, base : UInt64) : Nil
        # The arena once, for the chunk's entry, its layout, the
        # blackening and the live count; 0 for a large object, whose bits
        # are its word's and whose type id is under it.
        arena = IyiHeap.arena_of(base)
        byte = arena == 0 ? 0_u64 : IyiHeap.meta(arena, base)
        bits = byte == 0 ? IyiHeap.read64(base - 8_u64) : IyiHeap.read8(byte)
        # Atomic first, before any id is trusted: an atomic chunk's word is
        # whatever its last owner left, and the id in it is nobody's layout.
        if bits & IyiHeap::ATOMIC_FLAG != 0
          entry = 0_u64
          size = 0_u64
        else
          # A headed object's id is under it; a headless one's is in the
          # arena's layout table; untyped memory has none, and word-scans.
          if bits & IyiHeap::UNTYPED_FLAG != 0
            entry = 0_u64
          else
            type_id = bits & IyiHeap::HEADED_FLAG != 0 || byte == 0 ? IyiHeap.read64(base - 8_u64).unsafe_shr(IyiHeap::TYPE_SHIFT) : IyiHeap.read16(byte + 1_u64)
            entry = layout_entry(w, type_id)
          end
          size = byte == 0 ? IyiHeap.size_of(base) : (bits & IyiHeap::HEADED_FLAG != 0 ? IyiHeap.arena_chunk(arena) - IyiHeap::HEADER : IyiHeap.arena_chunk(arena))
          if entry == 0
            cursor = base
            limit = base + size
            while cursor + 8_u64 <= limit
              shade_word(w, IyiHeap.read64(cursor))
              cursor = cursor + 8_u64
            end
          end
        end
        if entry != 0
          table = layouts_table
          offsets = table + 8_u64 + IyiHeap.read64(table) * ENTRY + IyiHeap.read64(entry + 32_u64) * 8_u64
          remaining = IyiHeap.read64(entry + 24_u64)
          index = 0_u64
          while index < remaining
            offset = IyiHeap.read64(offsets + index * 8_u64)
            shade_word(w, IyiHeap.read64(base + offset))
            index = index + 1_u64
          end
        end
        # Black, by a plain store: only the worker that grayed it holds it,
        # and every other worker's write to these bits is a compare-and-swap
        # that fails on anything but white.
        if byte == 0
          word = IyiHeap.read64(base - 8_u64)
          IyiHeap.write64(base - 8_u64, (word - (word & COLOUR)) | BLACK)
          size = IyiHeap.size_of(base) if size == 0
        else
          IyiHeap.write8(IyiHeap.mark_byte(arena, base), BLACK)
          size = (bits & IyiHeap::HEADED_FLAG != 0 ? IyiHeap.arena_chunk(arena) - IyiHeap::HEADER : IyiHeap.arena_chunk(arena)) if size == 0
        end
        IyiHeap.write64(w + W_BYTES, IyiHeap.read64(w + W_BYTES) + size)
        count_live(w, arena)
      end

      # One more live object in its arena, folded per worker: consecutive
      # objects are mostly one arena's, so the shared add happens on the
      # arena change rather than per object.
      def self.count_live(w : UInt64, arena : UInt64) : Nil
        return if arena == 0
        if arena != IyiHeap.read64(w + W_LIVE_ARENA)
          flush_live(w)
          IyiHeap.write64(w + W_LIVE_ARENA, arena)
        end
        IyiHeap.write64(w + W_LIVE_PENDING, IyiHeap.read64(w + W_LIVE_PENDING) + 1_u64)
      end

      def self.flush_live(w : UInt64) : Nil
        arena = IyiHeap.read64(w + W_LIVE_ARENA)
        pending = IyiHeap.read64(w + W_LIVE_PENDING)
        if arena != 0 && pending != 0
          Pointer(Atomic(UInt64)).new(arena + IyiHeap::OFF_LIVE).value.add(pending)
        end
        IyiHeap.write64(w + W_LIVE_PENDING, 0_u64)
        IyiHeap.write64(w + W_LIVE_ARENA, 0_u64)
      end

      # One mark phase. Returns how many objects came out black, which is the
      # live count the exercise checks and the number Stage 6 will sweep
      # against.
      # One mark phase, on the collecting thread and, when the last mark
      # found more than PARALLEL_FROM live, on the helpers too. Roots go
      # gray on this thread's stack; the drain is every worker's. Returns
      # how many objects this thread blackened, the number the exercises
      # check when they run alone.
      def self.mark : UInt64
        w = worker
        @@collector_worker = w
        IyiHeap.write64(w + W_LEN, 0_u64)
        IyiHeap.write64(w + W_BYTES, 0_u64)
        @@bytes_marked = 0_u64
        arena = IyiHeap.first_arena
        while arena != 0
          IyiHeap.arena_live_reset(arena)
          arena = IyiHeap.arena_next(arena)
        end
        IyiHeap.write64(pool + POOL_HEAD, 0_u64)
        # Helpers by the work: one per MiB the last mark found live, up to
        # the number wanted — fifteen helpers on a three-MiB heap spent
        # the mark waking, contending for the pool and detecting the end
        # (94 ms across binary trees against 47 with three), and a large
        # live set is where they pay.
        helpers = @@last_marked.unsafe_div(PARALLEL_FROM)
        helpers = @@helpers_wanted if helpers > @@helpers_wanted
        if helpers > 0_u64
          start_helpers(helpers)
          helpers = @@helpers if @@helpers < helpers
        end
        @@workers = helpers + 1_u64
        pool_word(POOL_MARK_TAKEN).value.set(0_u64)
        pool_word(POOL_MARK_PERMITS).value.set(helpers)
        pool_word(POOL_FINISH).value.set(0_u64)
        @@helper_black = 0_u64
        pool_word(POOL_ACTIVE).value.set(0_u64)
        pool_word(POOL_HELPERS_DONE).value.set(0_u64)
        IyiRoots.each_root(->(base : UInt64) { shade(base) })
        # The helpers wake on the generation; from here every worker runs
        # the same drain, this thread included.
        if helpers > 0_u64
          pool_word(POOL_GENERATION).value.add(1_u64)
          wake_helpers
        end
        black = drain(w)
        # Every helper asked has answered - left the drain and folded its
        # accounts - before this thread reads them or turns the
        # generation again.
        while pool_word(POOL_HELPERS_DONE).value.get < mark_takers
          spin_pause
        end
        @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
        @@last_marked = @@bytes_marked
        @@workers = 0_u64
        black
      end

      # The drain: pop and scan until this stack and the pool are both empty
      # and no worker holds work. A worker counts itself out of ACTIVE when
      # it has nothing, back in when the pool has something, and the mark
      # is over at zero with an empty pool — a batch is always published
      # before its publisher could count out, so a spinner that sees zero
      # and an empty pool has seen every batch there will be.
      #
      # The count is of workers that took work, and every worker counts
      # itself *in* here rather than being counted by whoever asked for
      # it. Pre-setting it to the number asked is a hang: a mark's
      # permits let a helper skip a generation, and the helpers that did
      # take one then spun forever waiting for a count that nobody would
      # ever pay - the collector's own gate on a two-core runner, and the
      # thread exercise on three.
      def self.drain(w : UInt64) : UInt64
        black = 0_u64
        active = pool_word(POOL_ACTIVE)
        active.value.add(1_u64)
        while true
          while (len = IyiHeap.read64(w + W_LEN)) > 0_u64
            len = len - 1_u64
            IyiHeap.write64(w + W_LEN, len)
            # The stack read each time: a push inside `scan` may have
            # grown and moved it (`grow_stack`).
            scan(w, IyiHeap.read64(IyiHeap.read64(w + W_STACK) + len * 8_u64))
            black = black + 1_u64
          end
          next if take_batch(w)
          active.value.sub(1_u64)
          while true
            if IyiHeap.read64(pool + POOL_HEAD) != 0
              active.value.add(1_u64)
              break
            end
            if active.value.get == 0_u64
              flush_live(w)
              return black
            end
            spin_pause
          end
        end
      end

      # This worker's own stack and then the pool, up to `limit` objects:
      # true when both are empty within the bound. The second stop's
      # probe of what the roots and the mutators' stacks found, with the
      # helpers parked: what does not finish within the bound is the
      # retreat's case, whatever it hangs off - a register, or a batch a
      # mutator published after the helpers found the pool empty.
      def self.drain_bounded(w : UInt64, limit : UInt64) : Bool
        scanned = 0_u64
        while true
          len = IyiHeap.read64(w + W_LEN)
          if len == 0_u64
            return true unless take_batch(w)
            len = IyiHeap.read64(w + W_LEN)
          end
          return false if scanned >= limit
          len = len - 1_u64
          IyiHeap.write64(w + W_LEN, len)
          scan(w, IyiHeap.read64(IyiHeap.read64(w + W_STACK) + len * 8_u64))
          scanned = scanned + 1_u64
        end
      end

      # ── Helpers ─────────────────────────────────────────────────────────

      # How many helpers a mark may use. Set before the first collection;
      # the default is the core count less one, capped at fifteen, and 0
      # marks alone. A count past the cores is the cores less one: a
      # helper past the cores has no core to run on, and on darwin, where
      # a parked helper spins, fifteen of them on three cores held the
      # parallel mark's exercise past its five minutes.
      def self.workers=(count : UInt64) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          cap = default_helpers
          count = cap if count > cap
        {% end %}
        @@helpers_wanted = count
        @@workers_set = true
      end

      def self.workers : UInt64
        @@helpers_wanted
      end

      # A spin's breath: the CPU's pause hint, no syscall.
      def self.spin_pause : Nil
        {% if flag?(:x86_64) %}
          asm("pause" :::: "volatile")
        {% else %}
          asm("yield" :::: "volatile")
        {% end %}
      end

      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
      def self.default_helpers : UInt64
        cores = IyiThread.core_count
        cores = 16_u64 if cores > 16_u64
        cores > 1_u64 ? cores - 1_u64 : 0_u64
      end

      # Helpers up to `count`, and every one of them at its park before
      # this returns: a helper that read the generation after it turned
      # would sleep through the mark, and the collector waits for every
      # helper to answer a generation it turned.
      def self.start_helpers(count : UInt64) : Nil
        pool
        while @@helpers < count
          IyiThread.start_helper(helper_entry, @@helpers)
          @@helpers = @@helpers + 1_u64
        end
        while pool_word(POOL_READY).value.get < @@helpers
          spin_pause
        end
      end

      def self.helper_entry : UInt64
        proc = ->(index : UInt64) { IyiMark.helper_main(index) }
        Pointer(UInt64).new(pointerof(proc).address).value
      end

      # A helper's whole life: park on the generation, drain, fold its
      # accounts, count itself done, park again.
      def self.helper_main(index : UInt64) : Nil
        w = worker
        seen = pool_word(POOL_GENERATION).value.get
        pool_word(POOL_READY).value.add(1_u64)
        while true
          seen = wait_generation(seen)
          # A permit or nothing: a helper the mark did not ask for parks
          # again without counting itself in, and is not waited for.
          slot = take_mark_permit
          if slot != NO_PERMIT
            IyiHeap.write64(w + W_LEN, 0_u64)
            IyiHeap.write64(w + W_BYTES, 0_u64)
            IyiHeap.write64(w + W_BLACK, drain(w))
            fold_helper(w)
            pool_word(POOL_HELPERS_DONE).value.add(1_u64)
            # Beside the program, the drain's end is not the mark's: the
            # first taker waits for the rest - for the count taken, which
            # rises if another helper is still arriving and is never a
            # promise a missing helper has to keep - and takes the second
            # stop.
            if slot == 0_u64 && pool_word(POOL_FINISH).value.get != 0_u64
              pool_word(POOL_FINISH).value.set(0_u64)
              while pool_word(POOL_HELPERS_DONE).value.get < mark_takers
                spin_pause
              end
              # The finish turns the generation once more, for the
              # remainder, and again for the sweep round; that is the one
              # this helper waits past next.
              seen = finish_concurrent
            end
          end
          # The round, if one is open and a permit is left: arenas until
          # none is left or a collection closes it.
          if take_sweep_permit
            while sweep_one_helper
            end
          end
        end
      end

      # A spin before the park, and the reason is the stop rather than the
      # wake: a sleeping thread has to be scheduled before it can answer a
      # stop-the-world signal, and on a machine with fewer cores than
      # threads that is milliseconds - darwin's CI runner has three cores,
      # and its every-collection stop went from tens of microseconds to
      # milliseconds when the helpers stopped spinning. Collections come
      # in bursts, so a helper that spins for the length of one stays hot
      # through the burst and sleeps between them; SPIN_BEFORE_PARK is
      # about fifty microseconds of the pause hint.
      SPIN_BEFORE_PARK = 20000_u64

      def self.spin_for_generation(word : Pointer(Atomic(UInt64)), seen : UInt64) : UInt64
        spins = 0_u64
        while spins < SPIN_BEFORE_PARK
          now = word.value.get
          return now if now != seen
          spin_pause
          spins = spins + 1_u64
        end
        seen
      end

      # A round's permits are SWEEP_HELPERS; on Linux that many helpers
      # are woken and each takes one, on darwin every helper spins awake
      # and the first that many do.
      def self.take_sweep_permit : Bool
        word = pool_word(POOL_SWEEP_PERMITS)
        while true
          left = word.value.get
          return false if left == 0_u64
          return true if word.value.compare_and_set(left, left - 1_u64)[1]
        end
      end

      # A helper's bytes into the collection's, under the pool lock; its
      # per-arena counts were flushed by the drain.
      def self.fold_helper(w : UInt64) : Nil
        pool_lock
        @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
        @@helper_black = @@helper_black + IyiHeap.read64(w + W_BLACK)
        pool_unlock
        # Folded once: the second stop folds every worker page's bytes
        # for the mutators' assists, and a helper's page is on that list
        # too - live churn's 40 MB read as 76 with helpers counted twice.
        IyiHeap.write64(w + W_BYTES, 0_u64)
      end

      # Objects the helpers blackened in the last mark: zero means the
      # helpers were woken and found nothing to share, which
      # `bench/parallel_mark.sh` refuses.
      def self.helper_black : UInt64
        @@helper_black
      end

      @@helper_black : UInt64 = 0_u64

      {% if flag?(:linux) %}
        # The generation is one word and every helper sleeps on it: a
        # futex wake of fifteen threads is microseconds, and a per-helper
        # park that woke only the helpers a mark asked let a helper miss a
        # generation and the mark wait forever (`helper_main` says how).
        def self.wait_generation(seen : UInt64) : UInt64
          word = pool_word(POOL_GENERATION)
          spun = spin_for_generation(word, seen)
          return spun if spun != seen
          while (now = word.value.get) == seen
            __iyi_conc_syscall6(IYI_SYS_FUTEX, (pool + POOL_GENERATION).to_i64, IYI_FUTEX_WAIT, seen.to_i64, 0_i64, 0_i64, 0_i64)
          end
          now
        end

        def self.wake_helpers : Nil
          __iyi_conc_syscall6(IYI_SYS_FUTEX, (pool + POOL_GENERATION).to_i64, IYI_FUTEX_WAKE, 1000000_i64, 0_i64, 0_i64, 0_i64)
        end

        def self.wake_some_helpers(count : UInt64) : Nil
          wake_helpers
        end
      {% else %}
        # darwin has no futex: a helper spins on the generation with a
        # yield between reads, which costs no name on the floor.
        # darwin's helpers spin on the generation, and it is a hot spin -
        # `yield` there is the ARM hint, not a syscall. Measured and kept:
        # a park was built for them, a pipe per helper (there is no futex
        # on darwin, and a signal handler may call `read` but not
        # `os_unfair_lock_lock`), and on CI's three-core runner it cost
        # binary trees 1.07 s against the spin's 0.23 and churn 0.19
        # against 0.075. A parked helper has to be woken and then
        # scheduled before it marks, and on a machine with three cores
        # that is the mark's latency; a spinning helper is at the pool the
        # instant the generation turns, and the core it burns while idle
        # is worth less than the mark it delays. Linux's futex park costs
        # microseconds and keeps its cores, which is why the platforms
        # differ here at all.
        def self.wait_generation(seen : UInt64) : UInt64
          word = pool_word(POOL_GENERATION)
          while (now = word.value.get) == seen
            IyiThread.yield_cpu
          end
          now
        end

        # Nothing to wake: a darwin helper is spinning on the generation,
        # which the caller has already turned.
        def self.wake_helpers : Nil
        end

        def self.wake_some_helpers(count : UInt64) : Nil
        end
      {% end %}
      {% else %}
        # No kernel thread on this target (x86_64 darwin): the mark runs
        # alone and asks for no helper.
        def self.default_helpers : UInt64
          0_u64
        end

        def self.start_helpers(count : UInt64) : Nil
        end

        def self.wake_helpers : Nil
        end

        def self.wake_some_helpers(count : UInt64) : Nil
        end
      {% end %}

      # Put every live object back to white, so a second phase starts from
      # where the first one did. Stage 6 does this as it sweeps, one walk
      # instead of two; until then the exercise needs a way to run the phase
      # more than once.
      def self.unmark : Nil
        arena = IyiHeap.first_arena
        while arena != 0
          chunk = IyiHeap.arena_chunk(arena)
          cursor = IyiHeap.arena_first(arena)
          stop = IyiHeap.arena_high(arena)
          while cursor < stop
            IyiHeap.write8(IyiHeap.mark_byte(arena, cursor), WHITE) unless IyiHeap.uncarved_held?(arena, cursor)
            cursor = cursor + chunk
          end
          arena = IyiHeap.arena_next(arena)
        end
        node = IyiHeap.first_large
        while node != 0
          recolour(node + IyiHeap::LARGE_USER, WHITE)
          node = IyiHeap.large_next(node)
        end
      end

      # iyi: GC_DESIGN.md Stage 6, the sweep. Stage 5 decided what is garbage;
      # this is where the memory comes back. One walk over every chunk that has
      # been carved: a white object is unreachable, so its chunk goes on its
      # class's free list, and a black one survives and is repainted white for
      # the next cycle. Repainting as it goes is why sweep does not need a
      # second pass, and why `unmark` above is only the exercise's tool.
      #
      # A chunk already on a free list is skipped rather than freed again. It is
      # white, because nothing marked it and nothing owns it, and freeing it
      # twice would put one chunk on the list twice, which is the same memory
      # handed to two callers. `free_listed?` is that check, and it is why this
      # loop cannot simply trust the colour.
      #
      # A large object's `next` is read before the node is released, because
      # releasing it unmaps the memory the link lives in.
      #
      # What is not here, and why. **Finalizers**: nothing in this language
      # defines one. There is no `def finalize` anywhere in `src/iyi` or
      # `samples/iyi`, so a finalizer queue would be a mechanism no program
      # could put an entry in, which is the shape SPEC.md III.4.8 refused for a
      # concurrency marker and the shape this collector has refused twice
      # already. **Weak references**: the same answer. They are registration
      # based and the standard library's `WeakRef` lives on the `--crystal`
      # side, so there is no table here to walk and null out. Both wait on the
      # language having the feature rather than on the collector.
      # The sweep is lazy since the thread cutover, the way Go's is: a
      # collection marks, stamps a new epoch, and returns; every arena behind
      # the epoch is sweep debt, and the debt is paid one arena at a time by
      # the allocator that runs out of swept chunks (`IyiHeap.refill`) — so
      # the sweep's cost lands on the allocations that need its memory, in
      # proportion to them, and never inside the pause. What a pause is now
      # is the mark, and the mark alone. The next collection pays whatever
      # debt is left before it marks, because an unswept arena still wears
      # the last mark's colours; under steady allocation that is little or
      # nothing, and the exercise reports it. `sweep` here is the eager verb:
      # every arena and the large list at once, what `IyiMark.collect` runs
      # for a program that asked for its memory back now.
      def self.sweep : Nil
        # `sweep_one` takes the size class the caller wants and answers 0
        # when there is nothing left, 1 for a slice swept and 2 for a
        # slice a helper is inside. This loop called it with no argument
        # at all, so `IyiMark.sweep` — a public verb — did not compile on
        # any target: a program that asked for its memory back was told
        # "wrong number of arguments for 'IyiMark.sweep_one'". The class
        # asked for is the smallest, because a class with nothing left
        # sweeps any other, and 2 is a slice that is microseconds away, so
        # only 0 ends the loop.
        while sweep_one(0_u64) != 0_u64
        end
        sweep_large
      end

      # ── The sweep, in slices, and beside the program — GC_DESIGN.md
      # Stage 8 ──────────────────────────────────────────────────────────
      #
      # An arena is swept in slices of SWEEP_SPAN bytes, from a cursor it
      # carries, by whoever needs its chunks or has time: an allocating
      # thread that finds nothing swept for its class takes one slice of
      # an arena of that class and goes on allocating from it, some
      # microseconds; the helpers, after a collection, take whole arenas
      # slice after slice and hand each slice's batch over as they go.
      # The sweep is a walk of every chunk header in the heap - binary
      # trees paid a fifth of its wall time walking, on the thread that
      # allocates - and the slices are what let it leave that thread
      # without a wait: a helper mid-arena is mid-slice for microseconds,
      # and the thread that wants the arena's next slice waits for that,
      # not for the arena.
      #
      # The words: an arena's epoch says whether its sweep for this
      # epoch has begun; its cursor says how far it got, accurate whenever
      # nobody is inside a slice of it, because a slicer writes it back
      # before it lets anything stop it; and OFF_SWEEPING is the walk
      # claim, held across one slice, so two walkers never share one. A
      # pause takes no claim: every thread is stopped where no slice is,
      # and it finishes every arena from its cursor - and so does the
      # thread that triggers a collection, before it stops anything and
      # on its own clock, the way the concurrent mark's first stop
      # already paid the debt: a half-swept arena wears two epochs'
      # colours, and the mark reads one.
      #
      # A round is open from a collection's end to the next collection's
      # start. SWEEP_HELPERS helpers take it - a sweep walks at memory's
      # speed, one helper outruns an allocating thread's consumption
      # tenfold, and fifteen of them beside binary trees cost it its
      # core's other half. The next collection closes the round, so no
      # slice starts after, and waits out the slices in flight - a
      # half-swept slice wears two epochs' colours, and the mark reads
      # one - with the lock released, since a slice's end wants it.
      SWEEP_SPAN = 65536_u64
      SWEEP_HELPERS = 3_u64
      # What a helper waits, in pause hints, before it looks for a claim
      # again: `SWEEP_SPAN` bytes of walking is some ten microseconds,
      # and `spin_pause` is about 2.5 nanoseconds of one, so this is a
      # slice. `sweep_one_helper` says what a shorter wait cost.
      SWEEP_BUSY_SPINS = 4096_u64

      # A slice of an arena of `wanted`'s class, or any if the class has
      # none left, by an allocating thread. Answers 1 for a slice swept,
      # 2 for a slice of the class that a helper is inside - the caller
      # spins, its batch is microseconds away - and 0 for nothing left.
      def self.sweep_one(wanted : UInt64) : UInt64
        # No debt, no lock: with every list dropped at the pause, a thread
        # carving fresh chunks refills on every allocation, and each refill
        # came here - a lock and a walk of the arena list, 39 ns of a
        # release build's allocation on Linux and a microsecond on
        # darwin, for nothing to sweep. The count is read without the
        # lock; a stale nonzero takes the lock and finds nothing, a stale
        # zero carves a chunk that a sweep would have handed back later.
        IyiRuntimeLock.lock
        arena = claim_slice(wanted, false)
        IyiRuntimeLock.unlock
        return arena if arena < 4_u64
        epoch = @@epoch
        batch = sweep_slice(arena, SWEEP_SPAN)
        IyiRuntimeLock.lock
        release_claim(arena, epoch)
        arena_done(arena, epoch)
        # A collection may have come and gone while this thread waited
        # for the lock - it was inside the allocator, so it was stopped
        # after its slice and after the cursor was written, and the pause
        # went on from there - and the pause dropped every list. A batch
        # from the old epoch is left to the new one's sweep, which finds
        # its chunks by their flag; handed over, the same chunk would be
        # on two lists.
        IyiHeap.free_batch(IyiHeap.class_index(IyiHeap.arena_chunk(arena)), batch) if batch != 0 && @@epoch == epoch
        IyiRuntimeLock.unlock
        1_u64
      end

      # Under the lock: an arena with sweeping left, its walk claim taken.
      # An arena not yet begun this epoch is begun here: its cursor set
      # to its first chunk, the count of unbegun arenas down by one.
      #
      # `wanted` names a class to take first, 0 any; `helper` says a
      # helper asks, which takes any class when the wanted one has none
      # left, where an allocating thread answers 2 (busy) if the wanted
      # class has arenas but every one is inside another walker's slice,
      # and 0 only when the class has nothing left to sweep at all.
      def self.claim_slice(wanted : UInt64, helper : Bool) : UInt64
        epoch = @@epoch
        busy = false
        pass = 0
        while pass < 2
          chunk = pass == 0 ? wanted : 0_u64
          if chunk != 0 || pass == 1
            arena = IyiHeap.first_arena
            while arena != 0
              if (chunk == 0 || IyiHeap.arena_chunk(arena) == chunk) && sweep_left?(arena, epoch)
                if IyiHeap.read64(arena + IyiHeap::OFF_SWEEPING) == epoch
                  busy = true
                else
                  begin_arena(arena, epoch, helper ? 2 : 1) if IyiHeap.arena_epoch(arena) != epoch
                  IyiHeap.write64(arena + IyiHeap::OFF_SWEEPING, epoch)
                  return arena
                end
              end
              arena = IyiHeap.arena_next(arena)
            end
          end
          # An allocating thread wants its class: busy is an answer, and
          # so is nothing of the class; a helper goes on to any, and busy
          # is its answer too once every arena with work is inside
          # another's slice - a helper that took that for nothing left
          # went back to its park with the round barely begun, and the
          # allocating thread swept the heap itself, slice after slice.
          return 2_u64 if !helper && busy
          return 0_u64 if !helper && wanted != 0
          pass = pass + 1
        end
        busy ? 2_u64 : 0_u64
      end

      def self.sweep_left?(arena : UInt64, epoch : UInt64) : Bool
        IyiHeap.arena_epoch(arena) != epoch || IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_CURSOR) != IyiHeap::SWEEP_DONE
      end

      # Under the lock: an arena's sweep for this epoch begun, by a
      # helper (2), an allocating thread (1) or a pause (0).
      def self.begin_arena(arena : UInt64, epoch : UInt64, who : Int32) : Nil
        IyiHeap.arena_epoch_set(arena, epoch)
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_CURSOR, IyiHeap.arena_first(arena))
        @@unswept = @@unswept - 1_u64 if @@unswept > 0_u64
        @@swept_by_helpers = @@swept_by_helpers + 1_u64 if who == 2
        @@swept_by_allocator = @@swept_by_allocator + 1_u64 if who == 1
      end

      # Under the lock, after a slice: the arena counted out if the slice
      # reached its end, in the epoch the slice ran in - a slice parked
      # through a pause finished an arena of an epoch that is gone, and
      # the new epoch's count is the new epoch's.
      def self.arena_done(arena : UInt64, epoch : UInt64) : Nil
        return unless @@epoch == epoch && IyiHeap.mapped?(arena)
        return unless IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_CURSOR) == IyiHeap::SWEEP_DONE
        # Once: a walker parked through a pause that finished its arena
        # comes here after the pause did.
        return if IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_COUNTED) == epoch
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_COUNTED, epoch)
        @@sweep_left = @@sweep_left - 1_u64 if @@sweep_left > 0_u64
        IyiHeap.sweep_left_add(IyiHeap.class_index(IyiHeap.arena_chunk(arena)), -1_i64)
      end

      # Under the lock: the walk claim let go, if it is still this walk's
      # - a claim of an older epoch stands until its walker clears it,
      # and a newer walker's claim on the same arena is not this one's -
      # and only if the arena is still an arena: a pause's scavenge may
      # have handed the mapping back while this thread waited at the lock.
      def self.release_claim(arena : UInt64, epoch : UInt64) : Nil
        if IyiHeap.mapped?(arena) && IyiHeap.read64(arena + IyiHeap::OFF_SWEEPING) == epoch
          IyiHeap.write64(arena + IyiHeap::OFF_SWEEPING, 0_u64)
        end
      end

      # The pause's own sweep, the lock held and every thread stopped: one
      # arena with sweeping left finished from its cursor, whoever's
      # claim stands on it - a claim stands for a walker parked at the
      # lock after its slice, whose batch that walker will discard.
      # Answers whether there was one.
      def self.sweep_one_held : Bool
        epoch = @@epoch
        arena = IyiHeap.first_arena
        while arena != 0 && !sweep_left?(arena, epoch)
          arena = IyiHeap.arena_next(arena)
        end
        return false if arena == 0
        begin_arena(arena, epoch, 0) if IyiHeap.arena_epoch(arena) != epoch
        index = IyiHeap.class_index(IyiHeap.arena_chunk(arena))
        batch = sweep_slice(arena, IyiHeap::SWEEP_DONE)
        IyiHeap.free_batch(index, batch) if batch != 0
        arena_done(arena, epoch)
        true
      end

      # The triggering thread's sweep before the stop, the lock held on
      # entry and on exit and released for the walk: one arena with
      # sweeping left and no slice in flight, claimed and finished from
      # its cursor while every other thread runs. An arena a thread is
      # inside a slice of is left to the pause. Answers whether there was
      # one.
      def self.sweep_one_before_stop : Bool
        epoch = @@epoch
        arena = IyiHeap.first_arena
        while arena != 0 && !(sweep_left?(arena, epoch) && IyiHeap.read64(arena + IyiHeap::OFF_SWEEPING) != epoch)
          arena = IyiHeap.arena_next(arena)
        end
        return false if arena == 0
        begin_arena(arena, epoch, 0) if IyiHeap.arena_epoch(arena) != epoch
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEPING, epoch)
        IyiRuntimeLock.unlock
        batch = sweep_slice(arena, IyiHeap::SWEEP_DONE)
        IyiRuntimeLock.lock
        release_claim(arena, epoch)
        arena_done(arena, epoch)
        IyiHeap.free_batch(IyiHeap.class_index(IyiHeap.arena_chunk(arena)), batch) if batch != 0
        true
      end

      # Whether helpers are at a round right now: the allocating thread
      # spins on a class's batch only while one is coming.
      def self.helpers_sweeping? : Bool
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          @@helpers > 0_u64 && @@sweep_left != 0_u64 && pool_word(POOL_SWEEP).value.get != 0_u64
        {% else %}
          false
        {% end %}
      end

      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
        # A helper's turn of the round: one slice, the way an allocating
        # thread takes one - so three helpers are on one arena at once,
        # and the arena a program churns through is swept three times
        # faster - its batch handed over under the lock; or false when
        # the round is closed or nothing is left. The slice is counted in
        # while it runs, so the collection that closes the round can wait
        # it out; a helper parked at the lock after its slice may wait
        # through a whole collection, and its batch is then an old
        # epoch's, discarded.
        def self.sweep_one_helper : Bool
          return false if pool_word(POOL_SWEEP).value.get == 0_u64
          IyiRuntimeLock.lock
          arena = 0_u64
          if pool_word(POOL_SWEEP).value.get != 0_u64
            wanted = pool_word(POOL_SWEEP_WANTED).value.get
            arena = claim_slice(wanted == 0_u64 ? 0_u64 : IyiHeap.chunk_of(wanted.to_i32 - 1), true)
            # Counted in under the lock that closes the round: closed, no
            # slice starts; open, a slice begun is counted before the
            # closer looks.
            pool_word(POOL_SWEEPERS).value.add(1_u64) if arena > 2_u64
          end
          IyiRuntimeLock.unlock
          return false if arena == 0
          if arena == 2_u64
            # Every arena with work is inside another's slice. The wait
            # is a slice long, because a slice is what it waits for: the
            # claim this helper wants is let go at some walker's slice
            # end, and POOL_SWEEPERS falls when a helper's does. Looking
            # again sooner buys nothing and costs the runtime lock, which
            # every refill takes: 64 spins between looks had a helper
            # take that lock a hundred times a slice, and on three cores
            # the allocating thread's own claim went with it - darwin's
            # binary trees 1.36 s against 0.33, churn 0.27 against 0.085,
            # with the mark and the sweep otherwise unchanged.
            watch = pool_word(POOL_SWEEPERS)
            seen = watch.value.get
            spins = 0_u64
            while spins < SWEEP_BUSY_SPINS && watch.value.get == seen
              spin_pause
              spins = spins + 1_u64
            end
            return true
          end
          epoch = @@epoch
          batch = sweep_slice(arena, SWEEP_SPAN)
          pool_word(POOL_SWEEPERS).value.sub(1_u64)
          IyiRuntimeLock.lock
          release_claim(arena, epoch)
          arena_done(arena, epoch)
          IyiHeap.free_batch(IyiHeap.class_index(IyiHeap.arena_chunk(arena)), batch) if batch != 0 && @@epoch == epoch
          IyiRuntimeLock.unlock
          true
        end

        # At a collection's end, with helpers, before the threads it
        # stopped are released: the round opened, so the first refill
        # after the release finds helpers coming rather than sweep alone.
        # The wake itself comes after the lock is released - a thread
        # woken may preempt the waker, and seven helpers woken inside the
        # stop made a 90 us pause 1.6 ms. SWEEP_HELPERS of the parked
        # helpers are woken, and each takes a permit; on darwin every
        # helper spins awake and the first SWEEP_HELPERS take one.
        def self.open_sweep_round : Nil
          return if @@helpers == 0_u64 || @@sweep_left == 0_u64
          pool_word(POOL_MARK_PERMITS).value.set(0_u64)
          pool_word(POOL_MARK_TAKEN).value.set(0_u64)
          pool_word(POOL_HELPERS_DONE).value.set(0_u64)
          pool_word(POOL_SWEEP_PERMITS).value.set(@@helpers < SWEEP_HELPERS ? @@helpers : SWEEP_HELPERS)
          pool_word(POOL_SWEEP).value.set(1_u64)
          pool_word(POOL_GENERATION).value.add(1_u64)
          @@round_to_wake = true
        end

        @@round_to_wake : Bool = false

        def self.wake_sweep_round : Nil
          return unless @@round_to_wake
          @@round_to_wake = false
          wake_some_helpers(SWEEP_HELPERS)
        end

        # Before a collection stops anything, under the lock: the round
        # closed, and the slices in flight waited out with the lock
        # released, since a slice's end wants it.
        def self.close_sweep_round : Nil
          return if @@helpers == 0_u64
          pool_word(POOL_SWEEP).value.set(0_u64)
          pool_word(POOL_SWEEP_PERMITS).value.set(0_u64)
          while pool_word(POOL_SWEEPERS).value.get != 0_u64
            IyiRuntimeLock.unlock
            spin_pause
            IyiRuntimeLock.lock
          end
        end
      {% end %}

      # An allocating thread about to wait on a class names it for the
      # helpers; the last to name one is the one they read.
      def self.sweep_wanted(index : Int32) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          pool_word(POOL_SWEEP_WANTED).value.set(index.to_u64 + 1_u64)
        {% end %}
      end

      # Dead chunks go on the class's list in one batch. A run of them long
      # enough to cover whole pages, RELEASE_PAGES or more, is more than a
      # batch's: the first budget's worth of such pages in an epoch stay
      # warm - on the batch as they are, and listed, so that what no cache
      # takes before the pause outlives it as idle pages
      # (`IyiHeap.idle_listed`); the rest go cold - cut off the batch,
      # handed back to the kernel, idle, to be carved again when the carve
      # takes the run up as its region (`IyiHeap.reopen_in`). The run's
      # chunks straddling its edges are the list's. Runs are found as the
      # walk goes and closed as they end, one `madvise` per cold one. A
      # warm run an earlier epoch left idle is met again by this epoch's
      # walk and aged the same way: within the budget it stays, past it
      # it goes cold - so a class the program stopped allocating keeps a
      # budget's worth of its pages at most.
      #
      # The retention is the point. Released on sight, every page the
      # program churns through went back and came back each cycle - a
      # syscall per run and a fault per page - and a 64-byte allocation
      # cost 220 ns where it had cost 21. What the program will allocate
      # before the next collection is the budget, and that much of the
      # free pages is kept warm; what is free beyond it is what a smaller
      # program would never have touched, and it goes back. Kept as list
      # chunks alone, the warm pages the program had not got to were
      # dropped with the lists at the next pause, and the sweep found and
      # linked the same pages a second time while the program carved the
      # frontier or waited (GC_DESIGN.md, the footprint section).
      RELEASE_PAGES = 2_u64
      @@kept_warm : UInt64 = 0_u64

      # One slice: from the arena's cursor, `span` bytes or to its high
      # water, whichever is first; the cursor written back at the end,
      # before anything can stop this thread. Answers the batch of dead
      # chunks for the centre; the caller hands it over under the lock.
      def self.sweep_slice(arena : UInt64, span : UInt64) : UInt64
        chunk = IyiHeap.arena_chunk(arena)
        first = IyiHeap.arena_first(arena)
        batch_head = 0_u64
        cursor = IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_CURSOR)
        slice_low = cursor
        high = IyiHeap.arena_high(arena)
        if cursor >= high
          IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_CURSOR, IyiHeap::SWEEP_DONE)
          return 0_u64
        end
        stop = high
        stop = cursor + span if stop - cursor > span
        @@bytes_walked = @@bytes_walked + (stop - cursor)
        # The uncarved part of the bump region, read once. The cursor
        # rises within a region, and a chunk carved past the value read
        # here wears this epoch's parity and is left alone either way; a
        # region set while the slice walks is below the slice
        # (`IyiHeap.reopen_in`), and the stale pair can only skip chunks.
        region_low = IyiHeap.arena_cursor(arena)
        region_high = IyiHeap.read64(arena + IyiHeap::OFF_BUMP_END)
        # The run of dead chunks in progress: its first head, and what the
        # batch's head was before it, so that a run whose pages go back
        # can be taken off the batch again in one assignment - every dead
        # chunk is linked as the walk meets it, and a released run's
        # chunks are the batch's newest prefix.
        run_low = 0_u64
        run_batch = 0_u64
        # The chunk's entry, its colour and its index, each one past the
        # last chunk's: the grid arithmetic once per jump, not per chunk.
        byte = 0_u64
        mark = 0_u64
        slot = 0_u64
        while cursor < stop
          if cursor >= region_low && cursor < region_high
            # Uncarved: past the region in one step, the run closed.
            if run_low != 0
              batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch)
              run_low = 0_u64
            end
            cursor = first + (region_high - first + chunk - 1_u64).unsafe_div(chunk) * chunk
            byte = 0_u64
            next
          end
          if IyiHeap.page_idle?(arena, cursor)
            # On an idle page: past the run of them in one step, likewise,
            # the warm ones aged against this epoch's budget on the way.
            if run_low != 0
              batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch)
              run_low = 0_u64
            end
            page_low = cursor & (0_u64 &- IyiHeap::PAGE)
            page_end = page_low + IyiHeap::PAGE
            while page_end < high && IyiHeap.page_idle?(arena, page_end)
              page_end = page_end + IyiHeap::PAGE
            end
            age_idle(arena, page_low, page_end)
            cursor = first + (page_end - first + chunk - 1_u64).unsafe_div(chunk) * chunk
            byte = 0_u64
            next
          end
          # The chunk's entry and colour, not its line: a slice reads the
          # tables and touches a live object's memory not at all.
          if byte == 0
            slot = IyiHeap.chunk_index(arena, cursor)
            byte = arena + IyiHeap::META + slot * IyiHeap::META_ENTRY
            mark = IyiHeap.read64(arena + IyiHeap::OFF_MARKS) + slot
          end
          word = IyiHeap.read8(byte)
          colour = IyiHeap.read8(mark)
          if word & IyiHeap::EPOCH_FLAG != @@epoch_flag && (colour == WHITE || word & IyiHeap::FREE_FLAG != 0)
            # Unmarked and allocated before the mark, or free already on
            # a list the pause dropped: dead, and the run's. A free chunk
            # of this epoch's parity is on a live list - a warm run the
            # refill threaded (`IyiHeap.thread_warm`), or a chunk the
            # program handed back this epoch - and is left where it is.
            if word & IyiHeap::FREE_FLAG == 0
              @@bytes_freed = @@bytes_freed + (word & IyiHeap::HEADED_FLAG != 0 ? chunk - IyiHeap::HEADER : chunk)
              @@swept = @@swept + 1_u64
              IyiHeap.write8(byte, word | IyiHeap::FREE_FLAG)
            end
            if run_low == 0
              run_low = cursor
              run_batch = batch_head
            end
            IyiHeap.write64(cursor + IyiHeap::OFF_LINK, batch_head)
            IyiHeap.write64(cursor + IyiHeap::OFF_INDEX, slot)
            batch_head = cursor
          else
            if colour != WHITE
              # Marked: survives, white again and this epoch's. A white
              # chunk of this epoch's parity was allocated after the mark,
              # alive by construction, and is left as it is.
              @@bytes_kept = @@bytes_kept + (word & IyiHeap::HEADED_FLAG != 0 ? chunk - IyiHeap::HEADER : chunk)
              IyiHeap.write8(byte, (word - (word & IyiHeap::EPOCH_FLAG)) | @@epoch_flag)
              IyiHeap.write8(mark, WHITE)
              @@kept = @@kept + 1_u64
            end
            if run_low != 0
              batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch)
              run_low = 0_u64
            end
          end
          cursor = cursor + chunk
          byte = byte + IyiHeap::META_ENTRY
          mark = mark + 1_u64
          slot = slot + 1_u64
        end
        # The run in progress closes at the slice's end and the next slice
        # begins one of its own: a run cut back for a page release is the
        # batch's newest prefix, and a batch handed over is nobody's to
        # cut. A run split at a slice's edge may keep a page it would
        # have released; the slices are sixteen pages, the edge one.
        batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch) if run_low != 0
        # The slice's pages, for the refill that takes the batch to
        # unlist (`IyiHeap.unlist_batch`): the listed pages in them are
        # this batch's, a page straddling two slices being in neither's
        # run whole.
        IyiHeap.stash_batch_range(batch_head, arena, slice_low, cursor - 1_u64) if batch_head != 0
        # Past the high water the arena is done: what is carved after
        # this wears the epoch's parity and is alive by construction.
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_CURSOR, cursor >= high ? IyiHeap::SWEEP_DONE : cursor)
        batch_head
      end

      # A closed run of dead chunks, `[low, high)` in chunk heads, all of
      # them linked onto the batch already as its newest prefix, above
      # `batch_before`. The whole pages inside the run, when there are
      # enough of them: the first of them stay warm while the epoch's
      # sweeps have kept less than a budget's worth - on the batch as they
      # are, and listed, so that what no cache takes before the pause
      # survives it as idle pages; the rest go cold - the batch cut back
      # to the chunk below them, and the run's chunks above them, at its
      # high edge, linked again. Answers the batch's head.
      # The run's first page is the page its first chunk begins on when
      # the chunk before it lies on an idle or a listed page - the run
      # continues one a slice's end or an idle step cut, and the chunk
      # straddling the page boundary is that run's, dead - and the page
      # after otherwise, the straddler being live or a list's. Cut at
      # every slice's end, the page a slice ended in was neither run's:
      # one page in sixteen lost, and every warm run a slice long.
      def self.close_run(arena : UInt64, chunk : UInt64, low : UInt64, high : UInt64, batch_head : UInt64, batch_before : UInt64) : UInt64
        first = IyiHeap.arena_first(arena)
        page_low = (low + IyiHeap::PAGE - 1_u64) & (0_u64 &- IyiHeap::PAGE)
        continuing = low > first && (IyiHeap.page_idle?(arena, low - chunk) || IyiHeap.page_listed?(arena, low - chunk))
        page_low = low & (0_u64 &- IyiHeap::PAGE) if continuing
        page_high = high & (0_u64 &- IyiHeap::PAGE)
        return batch_head unless page_low < page_high && (continuing || page_high - page_low >= RELEASE_PAGES * IyiHeap::PAGE)
        pages = (page_high - page_low).unsafe_shr(IyiHeap::PAGE_SHIFT)
        # The run's first pages warm up to the budget, the rest cold: a
        # run is an arena at a time when the arena is all dead, and a run
        # kept or released whole overshot the budget by the run - 13 MB
        # warm for a 4 MB budget.
        warm = warm_pages(chunk, pages)
        if continuing && warm == 0
          # The straddler into the first page is a run's the carve may
          # hand out before a cold page's release lands, and the release
          # would zero its tail: the page stays the list's.
          page_low = page_low + IyiHeap::PAGE
          pages = pages - 1_u64
          return batch_head if pages == 0
        end
        if warm != 0
          IyiHeap.list_pages(arena, page_low, page_low + warm * IyiHeap::PAGE)
          IyiHeap.pages_retained_add(warm)
        end
        if warm < pages
          cold_low = page_low + warm * IyiHeap::PAGE
          # The run's chunks are linked in address order, the newest the
          # highest: the batch cut back to the chunk below the cold pages
          # keeps the low edge and the warm pages, and the high edge is
          # linked again on top.
          head_cold = first + (cold_low - first + chunk - 1_u64).unsafe_div(chunk) * chunk
          batch_head = head_cold > low ? head_cold - chunk : batch_before
          cursor = first + (page_high - first + chunk - 1_u64).unsafe_div(chunk) * chunk
          slot = IyiHeap.chunk_index(arena, cursor)
          while cursor < high
            IyiHeap.write64(cursor + IyiHeap::OFF_LINK, batch_head)
            IyiHeap.write64(cursor + IyiHeap::OFF_INDEX, slot)
            batch_head = cursor
            cursor = cursor + chunk
            slot = slot + 1_u64
          end
          IyiHeap.set_idle(arena, cold_low, page_high, true)
          IyiHeap.set_cold(arena, cold_low, page_high, true)
          # After the links: a released page written to would be resident
          # again, and none is written to above.
          __iyi_release_pages(cold_low, page_high - cold_low)
          IyiHeap.pages_released_add(pages - warm)
          # The counts last: a carve that reads an idle count takes the
          # lock and looks for the run, and finds it whole.
          IyiHeap.idle_add(arena, pages - warm, false)
        end
        batch_head
      end

      # How many of a run of `pages` pages of `chunk`-byte chunks stay
      # warm: as many as the epoch's warm pages have room for under a
      # budget's worth of payload. A page's share of the payload is
      # `PAGE * (chunk - HEADER) / chunk` - a class larger than a page has
      # less than one chunk to a page; the budget is what the program will
      # ask for, and headers are not what it asks for - counted in pages
      # against the budget's bytes, the warm pages of a 64-byte class held
      # an eighth less than the epoch's demand and the carve took the
      # difference from the frontier every epoch.
      def self.warm_pages(chunk : UInt64, pages : UInt64) : UInt64
        kept = Pointer(Atomic(UInt64)).new(pointerof(@@kept_warm).address)
        seen = kept.value.get
        return 0_u64 if seen >= budget
        per_page = (IyiHeap::PAGE * (chunk - IyiHeap::HEADER)).unsafe_div(chunk)
        room = (budget - seen + per_page - 1_u64).unsafe_div(per_page)
        take = pages < room ? pages : room
        kept.value.add(take * per_page)
        take
      end

      # A run of idle pages `[low, high)` the slice met, left by an earlier
      # epoch: each warm page counts against this epoch's budget as a run
      # closed today would, and past the budget it goes cold - the runs of
      # them released in one `madvise` each. Cold pages stay as they are.
      # The run's first page stays warm whatever the budget when a chunk
      # of the page before reaches into it: that chunk was a list's when
      # the run closed, or an idle run's own that the carve may take up
      # at any moment, and may be an object by the time the `madvise`
      # lands - which would zero its tail. A run closed today releases
      # before its edge chunks can be handed out and its own straddlers
      # are below every carve's reach (`close_run`, `IyiHeap.reopen_in`);
      # a page aged later has no such order to lean on, so it leans on
      # nothing.
      def self.age_idle(arena : UInt64, low : UInt64, high : UInt64) : Nil
        return if IyiHeap.read64(arena + IyiHeap::OFF_WARM) == 0
        chunk = IyiHeap.arena_chunk(arena)
        first = IyiHeap.arena_first(arena)
        cold_low = 0_u64
        page = low
        page = page + IyiHeap::PAGE if (low - first).unsafe_mod(chunk) != 0
        while page <= high
          # A warm page within the budget stays; past it, it is a cold
          # run's from here.
          cool = page < high && !IyiHeap.page_cold?(arena, page) && warm_pages(chunk, 1_u64) == 0
          if cool
            cold_low = page if cold_low == 0
          elsif cold_low != 0
            pages = (page - cold_low).unsafe_shr(IyiHeap::PAGE_SHIFT)
            IyiHeap.set_cold(arena, cold_low, page, true)
            __iyi_release_pages(cold_low, page - cold_low)
            IyiHeap.pages_released_add(pages)
            IyiHeap.warm_sub(arena, pages)
            cold_low = 0_u64
          end
          page = page + IyiHeap::PAGE
        end
      end

      # The scavenge, in the pause with every thread stopped: an arena the
      # mark found nothing alive in goes back to the kernel (a collector
      # that reclaims chunks but never mappings has a high-water heap, not
      # a heap) — every free list, the centre's and each stopped thread's
      # cache's, stripped of its chunks first, which is why this is the
      # pause's and not the lazy sweeper's: a sweeper on one thread cannot
      # edit another running thread's cache. Some cache's warm fill arena
      # is exempt, the cushion that keeps spike-then-idle from paying an
      # mmap on its next allocation. Nothing else is: sparing an all-dead
      # arena the epoch had allocated from, or one holding pages the sweep
      # kept warm, was built and measured in 0.11.0's first cycle and
      # bought nothing the probe could see - the resident-set probe read
      # 140 MB median against 129 without the first, on two cores, the
      # race table the same either way - because a churning class's dead
      # arena is what the kernel should have back, and the pages it faults
      # in again are a budget's worth an epoch (GC_DESIGN.md, the
      # footprint section). Runs after the mark and before the epoch
      # turns, so a released arena is never debt.
      def self.scavenge : Nil
        # Every free list dropped first - the centre's and each stopped
        # thread's cache's - which is what lets a mapping go back without
        # a walk of the lists for its chunks, and what `begin_sweep` says
        # the sweep needs anyway.
        IyiHeap.drop_free_lists
        previous = 0_u64
        arena = IyiHeap.first_arena
        while arena != 0
          following = IyiHeap.arena_next(arena)
          # What the sweep listed and no cache took: idle and warm from
          # here, the lists being gone.
          IyiHeap.idle_listed(arena)
          if IyiHeap.arena_live(arena) == 0 && IyiHeap.release_arena(previous, arena)
            @@arenas_released = @@arenas_released + 1_u64
          else
            previous = arena
          end
          arena = following
        end
      end

      # The large list is short and its sweep is a walk of nodes, not of
      # memory: eager, under the collection's own lock.
      def self.sweep_large : Nil
        node = IyiHeap.first_large
        while node != 0
          following = IyiHeap.large_next(node)
          base = node + IyiHeap::LARGE_USER
          word = IyiHeap.read64(base - 8_u64)
          if word & COLOUR == WHITE && word & IyiHeap::EPOCH_FLAG != @@epoch_flag
            @@bytes_freed = @@bytes_freed + IyiHeap.read64(node + IyiHeap::OFF_MAP) - IyiHeap::LARGE_USER
            @@swept = @@swept + 1_u64
            IyiHeap.free_large(node + 16_u64)
          elsif word & COLOUR != WHITE
            @@bytes_kept = @@bytes_kept + IyiHeap.read64(node + IyiHeap::OFF_MAP) - IyiHeap::LARGE_USER
            IyiHeap.write64(base - 8_u64, (word - (word & COLOUR) - (word & IyiHeap::EPOCH_FLAG)) | @@epoch_flag)
            @@kept = @@kept + 1_u64
          end
          node = following
        end
      end

      # A new epoch: every arena is debt, the counters this epoch's sweep
      # fills start again. Called with the lock held, after a mark.
      # The epoch turns. Every free list was dropped at the scavenge, so
      # the sweep is the only source of free chunks: a chunk left on a
      # list from the last sweep, sitting between two dead ones, broke the
      # run they would have made and kept its page resident - with the
      # lists carried across, an arena of 40-byte chunks holding 1.5 MB
      # live kept 12 MB of pages. The chunks keep their free flag, so the
      # sweep of their arena finds them where it finds the dead, and they
      # join whatever run they lie in.
      def self.begin_sweep : Nil
        @@kept_warm = 0_u64
        @@epoch = @@epoch + 1_u64
        @@epoch_flag = (@@epoch & 1_u64) * IyiHeap::EPOCH_FLAG
        @@swept = 0_u64
        @@kept = 0_u64
        @@bytes_freed = 0_u64
        @@bytes_kept = 0_u64
        @@bytes_walked = 0_u64
        debt = 0_u64
        index = 0
        while index < IyiHeap::CLASSES
          IyiHeap.central[IyiHeap::SWEEP_LEFT_AT + index] = 0_u64
          index = index + 1
        end
        arena = IyiHeap.first_arena
        while arena != 0
          debt = debt + 1_u64
          IyiHeap.sweep_left_add(IyiHeap.class_index(IyiHeap.arena_chunk(arena)), 1_i64)
          arena = IyiHeap.arena_next(arena)
        end
        @@unswept = debt
        @@sweep_left = debt
        @@collections = @@collections + 1_u64
      end

      @@epoch : UInt64 = 1_u64
      # `EPOCH_FLAG` or 0: the parity the allocator stamps on a chunk it
      # hands out, and the sweep compares against.
      @@epoch_flag : UInt64 = 16_u64
      # Arenas whose sweep for this epoch has not begun, and arenas with
      # any of it left - the second is the allocator's fast answer.
      @@unswept : UInt64 = 0_u64
      @@sweep_left : UInt64 = 0_u64
      @@debt_paid_in_pause : UInt64 = 0_u64
      @@debt_paid_before_stop : UInt64 = 0_u64
      @@swept_by_allocator : UInt64 = 0_u64
      @@swept_by_helpers : UInt64 = 0_u64
      @@bytes_marked : UInt64 = 0_u64

      def self.epoch : UInt64
        @@epoch
      end

      def self.epoch_flag : UInt64
        @@epoch_flag
      end

      # Arenas whose sweep this epoch has not begun: what the next pause
      # would have to sweep first, less the ones begun and unfinished.
      def self.debt : UInt64
        @@unswept
      end

      # Arenas the pauses swept before marking, in all — the lazy sweep's
      # honest failure count, printed by the exercise.
      # Arenas a concurrent collection's triggering thread swept before its
      # first stop: paid by the program, but by nobody else's clock.
      def self.debt_paid_before_stop : UInt64
        @@debt_paid_before_stop
      end

      def self.debt_paid_in_pause : UInt64
        @@debt_paid_in_pause
      end

      # Arenas the allocator began sweeping on its own time, outside any
      # pause; and the ones the helpers began.
      def self.swept_by_allocator : UInt64
        @@swept_by_allocator
      end

      def self.swept_by_helpers : UInt64
        @@swept_by_helpers
      end

      def self.bytes_marked : UInt64
        @@bytes_marked
      end

      # The allocation-pressure trigger — what makes this a collector rather
      # than a verb the exercises call. `IyiHeap.take` reports every
      # allocation's requested size here, and when the bytes allocated since
      # the last collection cross the budget, one collection runs — *before*
      # the carve, so the object about to be born cannot be swept while it
      # has no root. The budget after a collection is twice what survived
      # it, floored at a MiB: a program whose live set is L pays one
      # collection per L bytes of garbage, which is the amortised O(1) every
      # tracing collector prices at, and a program that never crosses a MiB
      # never pays at all. The guard is against re-entry: nothing in mark or
      # sweep allocates from this heap (the queue is its own mapping), and
      # the flag is what keeps that a fact the trigger does not depend on.
      #
      # `auto = false` is the phase exercises' door: a test choreographing
      # colours across explicit collections cannot have a string
      # interpolation's allocation running one in the middle. It is the same
      # switch Boehm spells GC_disable, and a program that turns it off owns
      # its own memory until it turns it back on.
      MIN_BUDGET = 4194304_u64

      @@budget : UInt64 = 0_u64
      @@collecting : Bool = false
      @@auto : Bool = true

      # The next budget as a percentage of what survived - Go's GOGC,
      # with the same meaning: what the program may allocate before the
      # next collection, in hundredths of the live set. Go's default is
      # 100, a heap twice the live set at its peak; iyi's is 200, a heap
      # three times it, because its collections are concurrent and its
      # allocation path is where it pays - at 100, binary trees was 35 MB
      # resident to 30 for a fifth more wall time. A program sets it
      # once, the way it sets `workers`.
      @@growth : UInt64 = 200_u64

      def self.growth=(percent : UInt64) : Nil
        @@growth = percent
      end

      def self.growth : UInt64
        @@growth
      end

      # The survivors grown by the percentage, floored at MIN_BUDGET so a
      # small program pays nothing.
      def self.next_budget(survived : UInt64) : UInt64
        grown = survived.unsafe_div(100_u64) * @@growth
        grown < MIN_BUDGET ? MIN_BUDGET : grown
      end

      def self.auto=(value : Bool) : Nil
        @@auto = value
      end

      # Bytes allocated since the last collection: the centre's atomic
      # word, which every cache folds a slice into (`IyiHeap.take`).
      def self.allocated_since : UInt64
        IyiHeap.allocated_word.value.get
      end

      # A slice of one cache's allocation arrives; the collection it may
      # trigger is decided twice — here on the count as seen, and again
      # under the lock, because two threads can cross the budget in the
      # same instant and the second must not collect a heap the first just
      # swept.
      def self.pressure(size : UInt64) : Nil
        total = IyiHeap.allocated_word.value.add(size) + size
        return if @@collecting
        return unless @@auto
        return if total < budget
        collect_if_due
      end

      def self.collect_if_due : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          # Helper 0 takes a concurrent mark's second stop, and a stop
          # names registered threads only: a program that never started a
          # thread has a main thread with no line until here, and the
          # helper would have stopped nobody and swept beside it. Before
          # the lock, because registering takes it.
          decide_helpers
          if concurrent_possible?
            IyiThread.register_current
            IyiThread.install_handler
          end
        {% end %}
        IyiRuntimeLock.lock
        if allocated_since < budget || @@collecting
          IyiRuntimeLock.unlock
          return
        end
        @@collecting = true
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          start_helpers(@@helpers_wanted)
          close_sweep_round
          if concurrent_possible?
            # The mark starts stopped and goes beside the program if the
            # live set turns out past the bound: then this thread goes
            # back to its allocation and helper 0 finishes the collection
            # and clears `@@collecting`. Inside the bound the mark is
            # over already and this thread owns the rest.
            if start_concurrent
              IyiRuntimeLock.unlock
              return
            end
            @@collecting = false
            IyiRuntimeLock.unlock
            wake_sweep_round
            return
          end
        {% end %}
        collect_locked(false)
        @@collecting = false
        IyiRuntimeLock.unlock
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          wake_sweep_round
        {% end %}
      end

      # One collection: decide, reclaim, and set the next budget. Explicit
      # calls reset the pressure clock too — a collection is a collection,
      # whoever asked for it. The lock is taken before anything stops, so
      # no stopped thread holds it (thread.iyi says why that matters), and
      # released after every stopped thread has counted itself out.
      # The verb: a program that calls this wants its memory back now, so
      # the sweep is eager here — every arena, the large list — where the
      # trigger's collections leave the sweep to the allocator.
      def self.collect : Nil
        IyiRuntimeLock.lock
        # A collection already running beside the program is finished by
        # its helper; this one waits for it rather than racing it.
        while @@collecting
          IyiRuntimeLock.unlock
          spin_pause
          IyiRuntimeLock.lock
        end
        @@collecting = true
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          close_sweep_round
        {% end %}
        collect_locked(true)
        @@collecting = false
        IyiRuntimeLock.unlock
      end

      # Wait out a collection running beside the program, if one is. The
      # count below is of finished collections — a mark in flight has not
      # swept, so it is not one yet — and a program that reads the count
      # after churn wants the one it triggered included.
      def self.settle : Nil
        while @@collecting
          spin_pause
        end
      end

      # How many helpers a mark may use, decided once, at the first
      # collection: what the program set, or the core count's default.
      def self.decide_helpers : Nil
        return if @@helpers_decided
        @@helpers_decided = true
        @@helpers_wanted = default_helpers unless @@workers_set
      end

      def self.collect_locked(eager : Bool) : Nil
        decide_helpers
        # Debt left from the last epoch: an unswept arena wears the last
        # mark's colours, and a mark over them would call last cycle's
        # black this cycle's live — and, worse, never re-count it, so an
        # arena of live objects would read as empty to the scavenge. Paid
        # here, every arena behind the epoch and not a counted number of
        # them, and counted, because a pause that sweeps is the thing the
        # lazy sweep exists to end. Paid before the stop, arena by arena
        # under a claim, the lock released for the walk: the triggering
        # thread's time, as an allocation's sweep is, and no other
        # thread's. What a thread was inside a slice of is finished under
        # the stop, where no slice is in flight.
        while sweep_one_before_stop
          @@debt_paid_before_stop = @@debt_paid_before_stop + 1_u64
        end
        started = now_ns
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
          others = IyiThread.stop_others
        {% end %}
        while sweep_one_held
          @@debt_paid_in_pause = @@debt_paid_in_pause + 1_u64
        end
        mark
        scavenge
        begin_sweep
        sweep_large
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          while eager && sweep_one_held
          end
        {% else %}
          while sweep_one_held
          end
        {% end %}
        IyiHeap.allocated_word.value.set(0_u64)
        # The next budget: twice what the mark found live (Go's GOGC=100),
        # floored at MIN_BUDGET so a small program pays nothing. The mark
        # knows the live bytes — it added each object's size as it
        # blackened it — which is what lets the sweep be lazy: the budget
        # no longer waits on a sweep to count.
        @@budget = next_budget(@@bytes_marked)
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          open_sweep_round
          IyiThread.resume_others(others)
        {% elsif flag?(:win32) && flag?(:x86_64) %}
          IyiThread.resume_others(others)
        {% end %}
        pause = now_ns - started
        IyiHeap.unmap_released
        @@pause_last = pause
        @@pause_max = pause if pause > @@pause_max
        @@pause_total = @@pause_total + pause
      end

      def self.budget : UInt64
        budget = @@budget
        budget == 0 ? MIN_BUDGET : budget
      end

      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
        # ── The mark beside the program — GC_DESIGN.md Stage 9 ──────────────
        #
        # Two stops instead of one. The first is the roots: every thread
        # stopped, the debt paid, the roots grayed onto the pool, the
        # marking flag raised, the helpers woken, and the program resumed
        # — while it runs, every pointer-bearing store it makes goes through
        # the write barrier the compiler emitted, which grays what the
        # store put where it put it (Dijkstra's insertion barrier), and
        # every object it allocates is born gray. The helpers drain the
        # pool beside it. When helper 0 finds the pool empty and every
        # worker idle, it takes the second stop: the roots again (a pointer
        # a thread loaded from the heap since the first stop may sit in a
        # register that no store ever wrote), every mutator's barrier
        # stack flushed, the remainder drained, the flag lowered, and the
        # epoch turned. Both stops are proportional to roots and to what
        # the program changed under the mark, never to the live set — the
        # live set is walked between them, by the helpers, while the
        # program runs.
        @@concurrent : Bool = false
        @@stw_first_ns : UInt64 = 0_u64

        # Concurrent needs a thread to finish on: at least one helper.
        # Whether a mark *uses* one is not decided here and not from an
        # estimate: every collection starts stopped and marks up to
        # STW_MARK_BOUND objects on the triggering thread, and a mark
        # that ends inside the bound was the whole mark - one stop, no
        # helper woken, tens of microseconds (churn's 122 collections are
        # all of them). One that does not is a large live set, and it
        # goes beside the program from there.
        #
        # The estimate is what this replaces. It was the last mark's live
        # bytes against PARALLEL_FROM, and it was wrong in both
        # directions: binary trees' second mark read sixteen bytes - the
        # stretch tree was gone - and marked a three-megabyte tree
        # stopped, a 2 ms pause in a table of tens of microseconds; and
        # churn's tiny live set read as tiny for a mark that had four
        # megabytes of fresh allocation to walk. What the program did
        # since the last mark is not in any estimate, and the bounded
        # mark does not need one: it measures.
        #
        # Both platforms measure, and darwin's turn came late. It kept the
        # estimate for a cycle on a measurement of a rule without its
        # drain - `concurrent_possible?` opened to every collection while
        # the bounded mark below stayed Linux's, so every collection went
        # beside the program whatever it found, and churn's 122 of them
        # cost 0.49 s against 0.075. With the drain there too, churn's
        # 122 marks all end inside the bound: one stop each, 18 µs at
        # their longest, none beside the program. What the estimate cost
        # darwin is what it cost Linux - binary trees' one mispredicted
        # collection read 16 bytes, marked 2,097,568 stopped and paused
        # 2.1 ms, where every other stop in the run is under 230 µs.
        STW_MARK_BOUND = 1024_u64

        def self.concurrent_possible? : Bool
          @@helpers_wanted > 0_u64
        end

        # The first stop, on the triggering thread, under the runtime lock.
        # The helpers are started before it: their first spawn is half a
        # millisecond, which is no part of a stop. Answers whether the
        # mark went beside the program; false means it finished inside
        # this stop and the caller owns the rest of the collection.
        def self.start_concurrent : Bool
          # The last epoch's debt — an unswept arena wears the last mark's
          # colours, which this mark cannot read — is paid here, under the
          # lock the allocator's own sweep takes, before the world stops:
          # the triggering thread's time, as an allocation's sweep is, and
          # no other thread's. It was the first stop's largest part (500 us
          # of sweeping against 20 us of roots), and it is what Stage 8's
          # sweep beside the program is for.
          while sweep_one_before_stop
            @@debt_paid_before_stop = @@debt_paid_before_stop + 1_u64
          end
          started = now_ns
          others = IyiThread.stop_others
          while sweep_one_held
            @@debt_paid_in_pause = @@debt_paid_in_pause + 1_u64
          end
          w = worker
          @@collector_worker = w
          IyiHeap.write64(w + W_LEN, 0_u64)
          IyiHeap.write64(w + W_BYTES, 0_u64)
          @@bytes_marked = 0_u64
          @@helper_black = 0_u64
          arena = IyiHeap.first_arena
          while arena != 0
            IyiHeap.arena_live_reset(arena)
            arena = IyiHeap.arena_next(arena)
          end
          IyiHeap.write64(pool + POOL_HEAD, 0_u64)
          # The roots, and then the mark up to the bound on this thread
          # with the world still stopped: no barrier is needed for it,
          # nothing is running.
          @@workers = 1_u64
          pool_word(POOL_MARK_PERMITS).value.set(0_u64)
          pool_word(POOL_MARK_TAKEN).value.set(0_u64)
          pool_word(POOL_FINISH).value.set(0_u64)
          pool_word(POOL_ACTIVE).value.set(0_u64)
          pool_word(POOL_HELPERS_DONE).value.set(0_u64)
          IyiRoots.each_root(->(base : UInt64) { shade(base) })
          flush_mutator(w)
          # The mark, up to the bound, on both platforms: what it finds
          # inside the bound is the whole live set and this stop is the
          # collection.
          bounded = drain_bounded(w, STW_MARK_BOUND)
          if bounded
            # The whole live set, inside the bound: this stop is the
            # collection. The tail is `collect_locked`'s, and the caller
            # is told so.
            @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
            @@last_marked = @@bytes_marked
            @@workers = 0_u64
            pool_word(POOL_ACTIVE).value.set(0_u64)
            # The live counts this thread was holding into their arenas
            # before the scavenge reads them: `drain` flushes them where
            # it ends, and a bounded drain does not end there. An arena
            # whose only live objects sat in this page's pending count
            # read as empty and was unmapped under them.
            flush_live(w)
            finish_stopped(started, others)
            return false
          end
          # A large live set. Every helper there is, and the reason is the
          # opposite of the stop's: a mark inside a pause pays for waking
          # and for detecting its end on the critical path, so fifteen
          # helpers over a three-megabyte heap cost twice what three did;
          # beside the program the mark's length is what the mutator pays
          # for - in barrier work, in assists and in a budget it cannot
          # reset - and the cores are otherwise idle. Sized by the last
          # mark's live bytes here, binary trees ran a tenth slower than
          # with all of them.
          helpers = @@helpers
          @@workers = helpers + 1_u64
          pool_word(POOL_MARK_TAKEN).value.set(0_u64)
          pool_word(POOL_MARK_PERMITS).value.set(helpers)
          pool_word(POOL_FINISH).value.set(1_u64)
          # Every helper counts itself in when it starts draining; the
          # triggering thread is not a worker after this.
          pool_word(POOL_ACTIVE).value.set(0_u64)
          # What the bounded mark left on this thread's stack goes to the
          # pool: from here this thread is a mutator, and its stack is
          # only its barrier's.
          donate_all(w)
          @@concurrent = true
          LibIyiGCTable.__iyi_marking = 1_u8
          pool_word(POOL_GENERATION).value.add(1_u64)
          IyiThread.resume_others(others)
          @@stw_first_ns = now_ns - started
          # The wake after the release: threads woken inside the stop were
          # the stop's largest part under load, and a helper's first
          # microseconds are the futex's either way.
          wake_helpers
          true
        end

        # Every entry on this stack into the pool, in batches: a stack
        # this thread will not drain, whose objects are gray and have to
        # be somebody's.
        def self.donate_all(w : UInt64) : Nil
          stack = IyiHeap.read64(w + W_STACK)
          left = IyiHeap.read64(w + W_LEN)
          while left > 0_u64
            count = left < BATCH ? left : BATCH
            left = left - count
            publish(stack + left * 8_u64, count)
          end
          IyiHeap.write64(w + W_LEN, 0_u64)
        end

        # A collection whose mark ended inside the first stop: the tail of
        # `collect_locked`, with the threads released and the pause
        # recorded. The caller holds the lock and clears `@@collecting`.
        def self.finish_stopped(started : UInt64, others : Int64) : Nil
          scavenge
          begin_sweep
          sweep_large
          IyiHeap.allocated_word.value.set(0_u64)
          @@budget = next_budget(@@bytes_marked)
          open_sweep_round
          IyiThread.resume_others(others)
          pause = now_ns - started
          IyiHeap.unmap_released
          @@stw_first_ns = pause
          @@stop_second_ns = 0_u64
          @@pause_last = pause
          @@pause_max = pause if pause > @@pause_max
          @@pause_total = @@pause_total + pause
        end

        # The second stop, on helper 0, once every helper found nothing.
        # Answers the generation helper 0 waits past next.
        #
        # The stop rescans the roots and flushes every mutator's barrier
        # stack, and what that finds is not always small: a pointer a
        # thread loaded from a white object into a register is a whole
        # structure the marker never reached — 200 000 nodes of a chain,
        # 2 ms walked inside the stop, longer than the mark it was meant to
        # hide — and what the program published between the helpers
        # finding the pool empty and the stop can be as large (a batch
        # holding the old head of a million-item list, 5 ms). So the stop
        # scans what it found for FINISH_SCAN objects and no more: a
        # thread walking a list holds one white node whose children are
        # black, and that finishes in one; what does not finish is a
        # structure, and the stop resumes the program, marks beside it
        # once more, and stops again, up to FINISH_RETRIES times - Go's
        # mark termination makes the same check and the same retreat.
        # Only when the retries are spent is the rest drained inside the
        # stop, with the helpers.
        FINISH_RETRIES = 8_u64
        FINISH_SCAN = 256_u64

        def self.finish_concurrent : UInt64
          attempts = 0_u64
          retries_ns = 0_u64
          longest_retry = 0_u64
          while true
            IyiRuntimeLock.lock
            started = now_ns
            others = IyiThread.stop_others
            w = worker
            @@collector_worker = w
            IyiHeap.write64(w + W_LEN, 0_u64)
            @@workers = @@helpers
            page = @@worker_pages
            while page != 0
              if page != w
                flush_mutator(page)
                # What the assists blackened on this mutator: its bytes
                # into the collection's, its live counts into the arenas.
                flush_live(page)
                @@bytes_marked = @@bytes_marked + IyiHeap.read64(page + W_BYTES)
                IyiHeap.write64(page + W_BYTES, 0_u64)
              end
              page = IyiHeap.read64(page + W_NEXT)
            end
            IyiRoots.each_root_of_others(->(base : UInt64) { shade(base) })
            # What the roots found white is tried inside the stop first,
            # for a bounded number of objects: a thread walking a list
            # holds one white node at every stop, whose children are
            # black already, and that is a scan, not a retreat - thirty-two
            # such threads made every second stop eight. What does not
            # finish within the bound is a structure hanging off a
            # register, and that is the retreat's case.
            @@workers = 1_u64
            pool_word(POOL_ACTIVE).value.set(1_u64)
            unfinished = !drain_bounded(w, FINISH_SCAN)
            # The probe's live counts into their arenas before the
            # scavenge reads them: an arena whose only live objects sat in
            # this page's pending count read as empty and was unmapped
            # under them.
            flush_live(w)
            if attempts < FINISH_RETRIES && unfinished
              IyiThread.resume_others(others)
              IyiRuntimeLock.unlock
              retry = now_ns - started
              retries_ns = retries_ns + retry
              longest_retry = retry if retry > longest_retry
              remainder_round(w)
              attempts = attempts + 1_u64
              next
            end
            # The retreats are spent and work remains: with the helpers,
            # inside the stop, the one case the stop is not bounded.
            remainder_round(w) if unfinished
            @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
            @@last_marked = @@bytes_marked
            LibIyiGCTable.__iyi_marking = 0_u8
            @@concurrent = false
            @@workers = 0_u64
            scavenge
            begin_sweep
            sweep_large
            # What the program allocated under the mark was born black and
            # not scanned, so it is not in the marked bytes; it survived
            # nothing, and those bytes are the first of the next budget's,
            # allocated after the survivors were measured. Counted as
            # survivors, a program allocating through every mark doubled
            # its heap each cycle (churn: 16 MB resident stopped, 70 MB
            # beside).
            born = 0_u64
            page = @@worker_pages
            while page != 0
              born = born + IyiHeap.read64(page + W_BORN)
              IyiHeap.write64(page + W_BORN, 0_u64)
              page = IyiHeap.read64(page + W_NEXT)
            end
            survived = @@bytes_marked
            IyiHeap.allocated_word.value.set(born)
            @@budget = next_budget(survived)
            # The round opened before the threads are released: a thread
            # that refilled first found no round and swept the arena it
            # wanted - the largest - itself, a millisecond on the
            # allocating thread the round exists to spare.
            open_sweep_round
            IyiThread.resume_others(others)
            pause = now_ns - started
            IyiHeap.unmap_released
            @@stop_second_ns = pause
            @@finish_retries = @@finish_retries + attempts
            # Every stop is the collection's pause: the longest of them is
            # the number a program feels, and the sum is what it paid.
            total = pause + @@stw_first_ns + retries_ns
            longest = pause > @@stw_first_ns ? pause : @@stw_first_ns
            longest = longest_retry if longest_retry > longest
            @@pause_last = longest
            @@pause_max = longest if longest > @@pause_max
            @@pause_total = @@pause_total + total
            @@concurrent_collections = @@concurrent_collections + 1_u64
            @@collecting = false
            IyiRuntimeLock.unlock
            wake_sweep_round
            # Helper 0 takes its own turn at the round before it parks.
            # The generation as it stands - turned for the remainder and
            # again for the round - is the one it waits past.
            return pool_word(POOL_GENERATION).value.get
          end
        end

        # The pool's remainder and helper 0's own stack, drained by helper
        # 0 and the helpers together — inside the stop or beside the
        # program, the caller's choice. Answers the generation it turned.
        def self.remainder_round(w : UInt64) : UInt64
          helpers = @@helpers
          @@workers = helpers
          # This helper is inside the finish and drains below without a
          # permit; every other may take one.
          pool_word(POOL_MARK_TAKEN).value.set(0_u64)
          pool_word(POOL_MARK_PERMITS).value.set(helpers - 1_u64)
          pool_word(POOL_FINISH).value.set(0_u64)
          pool_word(POOL_ACTIVE).value.set(0_u64)
          pool_word(POOL_HELPERS_DONE).value.set(0_u64)
          generation = pool_word(POOL_GENERATION).value.add(1_u64) + 1_u64
          wake_helpers
          drain(w)
          while pool_word(POOL_HELPERS_DONE).value.get < mark_takers
            spin_pause
          end
          generation
        end

        @@finish_retries : UInt64 = 0_u64

        # How many times a second stop found the pool full and retreated,
        # across every collection, for the exercises.
        def self.finish_retries : UInt64
          @@finish_retries
        end

        @@concurrent_collections : UInt64 = 0_u64

        # The last concurrent collection's two stops, for the exercises:
        # the roots stop on the triggering thread, and helper 0's finish.
        @@stop_second_ns : UInt64 = 0_u64

        def self.stop_first_ns : UInt64
          @@stw_first_ns
        end

        def self.stop_second_ns : UInt64
          @@stop_second_ns
        end

        # Whether a mark is running beside the program right now: the byte
        # the barrier checks, for an exercise that wants to act under one.
        def self.marking? : Bool
          LibIyiGCTable.__iyi_marking != 0_u8
        end

        # Collections that ran beside the program, for the exercises.
        def self.concurrent_collections : UInt64
          @@concurrent_collections
        end
      {% end %}

      # What the last sweep did. GC_DESIGN.md Stage 6 asks for statistics and
      # this is the honest subset: counted as the walk went rather than sampled
      # afterwards. Pause time and a cumulative allocation total want a clock
      # and a hook in the hot path, and neither is worth adding before there is
      # something that reads them.
      def self.swept : UInt64
        @@swept
      end

      def self.kept : UInt64
        @@kept
      end

      def self.bytes_freed : UInt64
        @@bytes_freed
      end

      def self.bytes_kept : UInt64
        @@bytes_kept
      end

      def self.collections : UInt64
        @@collections
      end

      def self.arenas_released : UInt64
        @@arenas_released
      end

      def self.pause_last_ns : UInt64
        @@pause_last
      end

      def self.pause_max_ns : UInt64
        @@pause_max
      end

      def self.pause_total_ns : UInt64
        @@pause_total
      end
    end
  {% elsif flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    # iyi: The default heap on Linux is a bump pointer over `mmap` regions:
    # allocate, never free, which is the contract the libc path below already
    # has (`free` is not bound there for the same reason, and a program that
    # outlives its memory is what allocating without collecting asks for).
    # MAP_ANONYMOUS guarantees zero-fill, so `__iyi_malloc64`'s
    # documented clear comes from the mapping itself rather than a second pass
    # over the bytes: nothing is handed out twice, so nothing can be dirtier
    # than the kernel left it, and the atomic variant is therefore the same
    # memory on this path too. Each pointer carries its size in the eight
    # bytes under it, because `realloc` has no other way to know how much to
    # copy, and the eight bytes also keep every user pointer 8-aligned.
    #
    # One MiB a chunk, and an allocation bigger than that gets a chunk of its
    # own. The kernel rounds `length` up to a page, so the chunk size is not
    # rounded here.
    #
    # The cursor and what is left of the chunk are the allocator's whole
    # state, held as class variables on `IyiHeap` because the language has
    # nothing else to hold them in: `$` globals are refused outright, and a
    # `fun` body cannot reach `@@` state. Both are `UInt64` with literal
    # initializers, which codegen folds into the LLVM global's static zero
    # rather than a runtime init call, so what a plain global would have
    # meant is kept: both start at zero, which means "mmap on the first
    # allocation", not a value any startup code has to install. The
    # allocation entry points below must stay `fun`s because codegen calls
    # them by C name, so they forward one frame deep into class methods;
    # that frame is the price of the only state-carrying construct the
    # language offers.
    class IyiHeap
      @@cursor : UInt64 = 0_u64
      @@left : UInt64 = 0_u64

      def self.alloc(size : UInt64) : Void*
        bytes = size.to_i64
        remainder = bytes % 8
        bytes = bytes + (8 - remainder) if remainder > 0
        # Two words under the pointer: the size for `realloc` at P-16, and
        # at P-8 the object header word every mode leaves, whose high half
        # codegen fills with the type id.
        bytes = bytes + 16

        if @@left < bytes.to_u64
          chunk = 1048576_i64
          chunk = bytes if bytes > chunk
          @@cursor = __iyi_mmap(chunk.to_u64).address
          @@left = chunk.to_u64
        end

        block = Pointer(Void).new(@@cursor)
        @@cursor = @@cursor + bytes.to_u64
        @@left = @@left - bytes.to_u64
        block.as(Pointer(UInt64)).value = size
        block + 16_i64
      end

      # Allocate-and-copy rather than growth in place, because nothing frees
      # and the old size rides in the sixteen bytes under the pointer, which
      # is the only place that knows it.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        old_size = Pointer(UInt64).new(pointer.address - 16).value
        new_pointer = alloc(size)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        new_pointer
      end
    end

    fun __iyi_mmap(length : UInt64) : Pointer(Void)
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22.
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(9_i64), "{rdi}"(0_i64), "{rsi}"(length), "{rdx}"(3_i64),
                        "{r10}"(34_i64), "{r8}"(-1_i64), "{r9}"(0_i64)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(222_i64), "{x0}"(0_i64), "{x1}"(length), "{x2}"(3_i64),
                       "{x3}"(34_i64), "{x4}"(-1_i64), "{x5}"(0_i64)
                     : "memory"
                     : "volatile")
      {% end %}
      # A failed raw syscall answers with -errno in the result register rather
      # than a flag: -4095..-1 is errno's whole range.
      if result < 0 && result >= -4095
        __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
        __iyi_exit(1)
      end
      Pointer(Void).new(result.to_u64)
    end

    # Codegen emits calls to these by name for every allocation under the
    # __iyi_* ABI.
    fun __iyi_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __iyi_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __iyi_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is libc's on the other paths, and here it is the one libc name
    # left that codegen itself reaches for: `pre_initialize_aggregate` and
    # `generic_array_malloc` lower to the LLVM `llvm.memset` intrinsic, which
    # LLVM expands inline only while the size is a constant it can see; with
    # a runtime size it emits a call to C `memset` anyway. A definition with
    # the same name and signature is the only thing that can intercept that,
    # so the name, the types and the return are libc's rather than ours. The
    # bulk goes eight bytes at a time because every cleared allocation
    # funnels through here; the byte loop carries only the tail, and the
    # pattern word is the byte tiled eight wide.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!
      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% elsif flag?(:darwin) %}
    # iyi: The allocator on macOS is libSystem's `malloc` and `realloc`, which
    # is the explicit choice rather than a fallback: Apple documents libSystem
    # as the platform's only supported interface, it ships with the machine,
    # and its allocator is the best one available here by any measure. No
    # collection at all, which is what `src/gc/none.cr` is: the entry points
    # below carry `malloc`/`realloc` and none of the parts 0.1.0 has nothing
    # to say to (threads, finalizers, statistics).
    #
    # The clear after `malloc` is the entry point's contract rather than a fix
    # for something seen: `GC.malloc` is documented as allocating *and clearing*,
    # libc's `malloc` does not clear, and `gc/none.cr` clears for exactly that
    # reason (crystal-lang/crystal#14678). Nothing here would notice it missing
    # today, because codegen clears what it routes through this name anyway
    # (`pre_initialize_aggregate` and `generic_array_malloc` both memset), so the
    # clear is a second pass over the same bytes. It stays because the name is
    # reachable from any `.iyi` file and a swapped allocator that quietly weakens
    # the contract is the failure this default is being watched for, in miniature.
    #
    # `malloc_atomic` is that call without the clear, which is what the atomic
    # variant means on both sides: `GC_malloc_atomic` does not clear either, so
    # this is the same memory the collector's build hands back. `free` is not
    # bound because nothing frees, and a program that outlives its memory is
    # what allocating without collecting asks for.
    lib LibC
      fun malloc(size : UInt64) : Void*
      fun realloc(pointer : Void*, size : UInt64) : Void*
      fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
    end

    # Codegen emits calls to these by name for every allocation under the
    # __iyi_* ABI.
    # Every mode leaves the object header word under the pointer, for the
    # type id codegen stores in its high half.
    fun __iyi_malloc64(size : UInt64) : Void*
      pointer = LibC.malloc(size + 8_u64)
      LibC.memset(pointer, 0, size + 8_u64)
      pointer + 8_i64
    end

    fun __iyi_malloc_atomic64(size : UInt64) : Void*
      LibC.malloc(size + 8_u64) + 8_i64
    end

    fun __iyi_realloc64(pointer : Void*, size : UInt64) : Void*
      return __iyi_malloc64(size) if pointer.address == 0
      LibC.realloc(Pointer(Void).new(pointer.address - 8_u64), size + 8_u64) + 8_i64
    end
  {% elsif flag?(:win32) %}
    # iyi: The allocator on Windows is the Win32 process heap: `HeapAlloc` and
    # `HeapReAlloc` on `GetProcessHeap`'s handle, all kernel32, which is the
    # platform's own interface and ships with the machine. No CRT is involved,
    # because a C runtime is a person-installed choice rather than the
    # platform's contract. The names and signatures are the ones
    # `src/lib_c/x86_64-windows-msvc/c/heapapi.cr` carries for the compiler's
    # own runtime.
    #
    # `HEAP_ZERO_MEMORY` (0x8) gives `__iyi_malloc64` its documented clear
    # in the allocator itself rather than a second pass over the bytes, and the
    # atomic variant passes 0 because not clearing is exactly what atomic
    # means (`GC_malloc_atomic` does not clear either). `HeapReAlloc` keeps
    # the old contents and grows in place where it can, which is the same
    # contract libc's `realloc` has on the other paths; a null pointer cannot
    # be handed to it, so it routes to a plain `HeapAlloc`. `free` is not
    # bound because nothing frees, and a program that outlives its memory is
    # what allocating without collecting asks for. `-Dgc_iyi` does not reach
    # this branch, deliberately rather than unfinished: the size-class arena
    # allocator is POSIX-only in its stage. This target once printed memory
    # it was never given: the memset below strode eight elements per eight
    # bytes, trampling `HeapAlloc`'s packed neighbours and clearing at
    # one-eighth coverage. Fixed, and CI's twenty-run watch retired the
    # diagnosis after thirty-six clean builds; it is a gate now.
    # Same reason as the block above: an LLVM-emitted object names no library
    # for itself, so the three heap functions have to name theirs.
    @[Link("kernel32")]
    lib LibC
      fun GetProcessHeap : Void*
      fun HeapAlloc(heap : Void*, flags : UInt32, bytes : UInt64) : Void*
      fun HeapReAlloc(heap : Void*, flags : UInt32, memory : Void*, bytes : UInt64) : Void*
    end

    # Codegen emits calls to these by name for every allocation under the
    # __iyi_* ABI.
    # Every mode leaves the object header word under the pointer, for the
    # type id codegen stores in its high half.
    fun __iyi_malloc64(size : UInt64) : Void*
      LibC.HeapAlloc(LibC.GetProcessHeap, 0x8_u32, size + 8_u64) + 8_i64
    end

    fun __iyi_malloc_atomic64(size : UInt64) : Void*
      LibC.HeapAlloc(LibC.GetProcessHeap, 0_u32, size + 8_u64) + 8_i64
    end

    fun __iyi_realloc64(pointer : Void*, size : UInt64) : Void*
      if pointer.address == 0
        LibC.HeapAlloc(LibC.GetProcessHeap, 0x8_u32, size + 8_u64) + 8_i64
      else
        LibC.HeapReAlloc(LibC.GetProcessHeap, 0_u32, Pointer(Void).new(pointer.address - 8_u64), size + 8_u64) + 8_i64
      end
    end

    # `memset` is defined locally rather than bound because the C runtime is
    # not this platform's interface, and codegen itself reaches for the name:
    # `pre_initialize_aggregate` and `generic_array_malloc` lower to the LLVM
    # `llvm.memset` intrinsic, which LLVM expands inline only while the size is
    # a constant it can see; with a runtime size it emits a call to C `memset`
    # anyway, and on win64 that call carries a 64-bit size_t. A definition
    # with the same name, types and return is the only thing that can intercept
    # it. The bulk goes eight bytes at a time; the byte loop carries the tail.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!
      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% elsif flag?(:wasm32) %}
    # iyi: The default heap on wasm32-wasi is a bump pointer over
    # `memory.grow` pages, the same arena shape as the Linux branch, and it
    # closes the dependency floor's last finding on this target (SPEC.md
    # III.9): `malloc` and `realloc` were the two undefined names in a wasm32
    # object that are not the platform's own imports, and they came from
    # wasi-libc, which is a libc a toolchain brings rather than an interface
    # the platform guarantees. The linear memory is the platform's allocator
    # here, so the arena grows it the same way the Linux branch mmaps.
    # Allocate, never free; `free` is bound nowhere on any path, and a
    # program that outlives its memory is what allocating without collecting
    # asks for.
    #
    # Reaching `memory.grow` needed one binding, written below rather than in
    # `src/intrinsics.cr` for two measured reasons. `LibIntrinsics` there
    # proves a plain `fun` whose external name is an `llvm.` name reaches a
    # real LLVM intrinsic (`llvm.debugtrap`, `llvm.memcpy` and
    # `llvm.x86.sse2.pause` all bind exactly that way), but this prelude
    # requires nothing outside `src/iyi/` ("0.1.0", item 3), so a binding in
    # compiler source would be unreachable from here. The signature is the
    # other finding, measured against this tree's LLVM with hand-written IR:
    # the intrinsic registers as `i32 (i32, i32)`, memory index then page
    # delta, and the one-argument form the earlier probe tried is an arity
    # error the verifier words as "Callsite was not defined with variable
    # arguments!", which that probe recorded as a `fun` being unable to bind
    # an LLVM intrinsic at all. It can, with both arguments. An
    # `@[Primitive]` is the rejected alternative: a compiler rebuild and a
    # declaration in `primitives.iyi`, a language-surface file, for what this
    # C-shaped binding reaches. `memory.size` is not bound because
    # `memory.grow` answers the only fact it carries: its result is the
    # previous size in pages, which is exactly where the grown region
    # starts. The index argument is 0 because a wasm32-wasi module has
    # exactly one linear memory and 0 names it; the backend turns it into
    # the instruction's memarg immediate, so it is not even a runtime
    # operand.
    lib LibWasmMem
      fun memory_grow = "llvm.wasm.memory.grow.i32"(memory_index : Int32, delta_pages : Int32) : Int32
    end

    lib LibSymbols
      $__data_end : UInt8
      $__heap_base : UInt8
    end

    lib LibWasmIntrinsics
      fun stacksave = "llvm.stacksave.p0" : Void*
      fun frameaddress = "llvm.frameaddress.p0"(level : Int32) : Void*
    end

    lib LibIyiGCTable
      $__iyi_gc_layouts : Void*
      $__iyi_marking : UInt8
    end

    fun __iyi_write_barrier_begin : Nil
    end

    fun __iyi_write_barrier(address : Void*, words : Int32) : Nil
    end

    {% if !flag?(:gc_none) %}
      class IyiHeap
        PAGE = 65536_u64
        CLASSES = 67
        IYI_ARENA = 0x4959495F4152454E_u64
        IYI_LARGE = 0x4959495F4C415247_u64

        HEADER = 8_u64
        LARGE_USER = 24_u64

        FREE_FLAG    = 4_u64
        ATOMIC_FLAG  = 8_u64
        HEADED_FLAG  = 32_u64
        UNTYPED_FLAG = 64_u64
        CARVED_FLAG  = 128_u64
        TYPE_SHIFT   = 32_u64

        @@heap_start : UInt64 = 0_u64
        @@heap_limit : UInt64 = 0_u64
        @@all_arenas : UInt64 = 0_u64

        def self.free_lists : Pointer(UInt64)
          Pointer(UInt64).new(@@heap_start)
        end

        def self.active_arenas : Pointer(UInt64)
          Pointer(UInt64).new(@@heap_start + 1024_u64)
        end

        def self.heap_start : UInt64
          init_if_needed
          @@heap_start
        end
        @@large_objects : UInt64 = 0_u64
        @@allocated_bytes : UInt64 = 0_u64
        @@budget : UInt64 = 1048576_u64

        def self.read64(address : UInt64) : UInt64
          Pointer(UInt64).new(address).value
        end

        def self.write64(address : UInt64, value : UInt64) : Nil
          Pointer(UInt64).new(address).value = value
        end

        def self.read8(address : UInt64) : UInt8
          Pointer(UInt8).new(address).value
        end

        def self.write8(address : UInt64, value : UInt8) : Nil
          Pointer(UInt8).new(address).value = value
        end

        def self.class_index(size : UInt64) : Int32
          return ((size + 7_u64).unsafe_shr(3_u64).to_i64 - 2_i64).to_i32 if size > 16_u64 && size <= 128_u64
          return 0 if size <= 16_u64
          base = 128_u64
          index = 15
          while base + base < size
            base = base + base
            index = index + 4
          end
          step = base.unsafe_shr(2_u64)
          index + ((size - base + step - 1_u64).unsafe_div(step)).to_i64.to_i32 - 1
        end

        def self.chunk_of(index : Int32) : UInt64
          return (index.to_i64 + 2_i64).to_u64 * 8_u64 if index < 15
          above = (index - 15).to_i64.to_u64
          base = 128_u64.unsafe_shl(above.unsafe_shr(2_u64))
          base + ((above & 3_u64) + 1_u64) * base.unsafe_shr(2_u64)
        end

        def self.update_heap_limits(page : UInt64, pages : UInt64) : Nil
          top = page + pages * PAGE
          @@heap_limit = top if top > @@heap_limit
          @@heap_start = page if @@heap_start == 0_u64 || page < @@heap_start
        end

        def self.init_if_needed : Nil
          return if @@heap_start != 0_u64
          prev = LibWasmMem.memory_grow(0, 1)
          if prev < 0
            __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
            __iyi_exit(1)
          end
          page = prev.to_u64.unsafe_shl(16_u64)
          @@heap_start = page
          @@heap_limit = page + PAGE
          write64(page + 40_u64, 0_u64)
          ptr = Pointer(UInt64).new(page)
          idx = 0_u64
          while idx < 8192_u64
            (ptr + idx.to_i64).value = 0_u64
            idx = idx + 1_u64
          end
          IyiMark.init_queue(page + 2048_u64, 63488_u64)
        end

        def self.clear_bytes(destination : UInt64, count : UInt64) : Nil
          wcount = count.unsafe_div(8_u64)
          ptr = Pointer(UInt64).new(destination)
          idx = 0_u64
          while idx < wcount
            (ptr + idx.to_i64).value = 0_u64
            idx = idx + 1_u64
          end
          tail = wcount * 8_u64
          bptr = Pointer(UInt8).new(destination + tail)
          bidx = 0_u64
          while tail + bidx < count
            (bptr + bidx.to_i64).value = 0_u8
            bidx = bidx + 1_u64
          end
        end

        def self.take(size : UInt64, clear : Bool, bits : UInt64, type_id : UInt64) : UInt64
          init_if_needed
          size = 8_u64 if size == 0_u64
          remainder = size.to_i64 % 8_i64
          size = size + (8_u64 - remainder.to_u64) if remainder > 0_i64

          total = size + 24_u64
          if total > 16384_u64
            return take_large(size, clear, bits, type_id)
          end

          idx = class_index(total)
          chunk_size = chunk_of(idx)
          payload_cap = chunk_size - 24_u64

          head = (free_lists + idx.to_i64).value
          if head != 0_u64
            (free_lists + idx.to_i64).value = read64(head)
            p_obj = head
            new_mark = bits | CARVED_FLAG | type_id.unsafe_shl(TYPE_SHIFT)
            write64(p_obj - 8_u64, new_mark)
            write64(p_obj - 16_u64, type_id)
            write64(p_obj - 24_u64, payload_cap)
            if clear
              clear_bytes(p_obj, size)
            end
            @@allocated_bytes = @@allocated_bytes + chunk_size
            IyiMark.collect_if_due
            return p_obj
          end

          arena = (active_arenas + idx.to_i64).value
          if arena == 0_u64 || read64(arena + 24_u64) + chunk_size > PAGE
            prev = LibWasmMem.memory_grow(0, 1)
            if prev < 0
              __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
              __iyi_exit(1)
            end
            arena = prev.to_u64.unsafe_shl(16_u64)
            update_heap_limits(arena, 1_u64)
            write64(arena + 0_u64, @@all_arenas)
            @@all_arenas = arena
            write64(arena + 8_u64, chunk_size)
            write64(arena + 16_u64, idx.to_u64)
            write64(arena + 24_u64, 64_u64)
            write64(arena + 40_u64, IYI_ARENA)
            (active_arenas + idx.to_i64).value = arena
          end

          cursor = read64(arena + 24_u64)
          chunk_head = arena + cursor
          write64(arena + 24_u64, cursor + chunk_size)

          p_obj = chunk_head + 24_u64
          write64(p_obj - 24_u64, payload_cap)
          write64(p_obj - 16_u64, type_id)
          write64(p_obj - 8_u64, bits | CARVED_FLAG | type_id.unsafe_shl(TYPE_SHIFT))

          if clear
            clear_bytes(p_obj, size)
          end

          @@allocated_bytes = @@allocated_bytes + chunk_size
          IyiMark.collect_if_due
          p_obj
        end

        def self.take_large(size : UInt64, clear : Bool, bits : UInt64, type_id : UInt64) : UInt64
          total = size + 64_u64
          pages = (total + PAGE - 1_u64).unsafe_div(PAGE)
          prev = LibWasmMem.memory_grow(0, pages.to_i32)
          if prev < 0
            __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
            __iyi_exit(1)
          end
          arena = prev.to_u64.unsafe_shl(16_u64)
          total_bytes = pages * PAGE
          update_heap_limits(arena, pages)

          write64(arena + 0_u64, @@large_objects)
          @@large_objects = arena
          write64(arena + 8_u64, size)
          write64(arena + 16_u64, pages)
          write64(arena + 40_u64, IYI_LARGE)

          p_obj = arena + 24_u64
          write64(p_obj - 24_u64, size)
          write64(p_obj - 16_u64, type_id)
          write64(p_obj - 8_u64, bits | CARVED_FLAG | type_id.unsafe_shl(TYPE_SHIFT))

          if clear
            clear_bytes(p_obj, size)
          end

          @@allocated_bytes = @@allocated_bytes + total_bytes
          IyiMark.collect_if_due
          p_obj
        end

        def self.alloc(size : UInt64) : Void*
          Pointer(Void).new(take(size, true, UNTYPED_FLAG, 0_u64))
        end

        def self.alloc_atomic(size : UInt64) : Void*
          Pointer(Void).new(take(size, false, UNTYPED_FLAG | ATOMIC_FLAG, 0_u64))
        end

        def self.new_object(size : UInt64, type_id : UInt64, headed : Bool, atomic : Bool) : Void*
          flags = (headed ? HEADED_FLAG : 0_u64) | (atomic ? ATOMIC_FLAG : 0_u64)
          Pointer(Void).new(take(size, !atomic, flags, type_id))
        end

        def self.realloc(pointer : Void*, size : UInt64) : Void*
          return alloc(size) if pointer.address == 0_u64
          old_size = read64(pointer.address - 24_u64)
          new_ptr = alloc(size)
          src = pointer.as(Pointer(UInt8))
          dst = new_ptr.as(Pointer(UInt8))
          limit = old_size < size ? old_size : size
          idx = 0_u64
          while idx < limit
            (dst + idx.to_i64).value = (src + idx.to_i64).value
            idx = idx + 1_u64
          end
          new_ptr
        end

        def self.base_of(word : UInt64) : UInt64
          return 0_u64 if word < @@heap_start || word >= @@heap_limit
          page = word - (word & 65535_u64)
          magic = read64(page + 40_u64)
          if magic == IYI_ARENA
            chunk_size = read64(page + 8_u64)
            return 0_u64 if chunk_size == 0_u64
            cursor = read64(page + 24_u64)
            first = page + 64_u64
            return 0_u64 if word < first || word >= page + cursor
            chunk_idx = (word - first).unsafe_div(chunk_size)
            head = first + chunk_idx * chunk_size
            p_obj = head + 24_u64
            mark = read64(p_obj - 8_u64)
            return 0_u64 if mark & FREE_FLAG != 0_u64
            return p_obj
          elsif magic == IYI_LARGE
            p_obj = page + 24_u64
            size = read64(p_obj - 24_u64)
            return 0_u64 if word < page || word >= p_obj + size
            mark = read64(p_obj - 8_u64)
            return 0_u64 if mark & FREE_FLAG != 0_u64
            return p_obj
          end
          0_u64
        end

        def self.size_of(base : UInt64) : UInt64
          read64(base - 24_u64)
        end

        def self.allocated_bytes : UInt64
          @@allocated_bytes
        end

        def self.allocated_bytes=(value : UInt64) : Nil
          @@allocated_bytes = value
        end

        def self.budget : UInt64
          @@budget
        end

        def self.budget=(value : UInt64) : Nil
          @@budget = value
        end

        def self.all_arenas : UInt64
          @@all_arenas
        end

        def self.large_objects : UInt64
          @@large_objects
        end

        def self.free_list(index : Int32) : UInt64
          return 0_u64 if @@heap_start == 0_u64
          (free_lists + index.to_i64).value
        end

        def self.set_free_list(index : Int32, head : UInt64) : Nil
          return if @@heap_start == 0_u64
          (free_lists + index.to_i64).value = head
        end

        def self.sweep_left_of(index : Int32) : UInt64
          0_u64
        end

        def self.pages_retained : UInt64
          0_u64
        end

        def self.pages_rewarmed : UInt64
          0_u64
        end
      end

      class IyiRoots
        def self.each_root(visit : Proc(UInt64, Nil)) : Nil
          scan_stack(visit)
          scan_globals(visit)
        end

        def self.scan_stack(visit : Proc(UInt64, Nil)) : Nil
          sp = LibWasmIntrinsics.stacksave.address
          stack_base = pointerof(LibSymbols.__heap_base).address
          scan_range(sp, stack_base, visit)
        end

        def self.scan_globals(visit : Proc(UInt64, Nil)) : Nil
          data_end = pointerof(LibSymbols.__data_end).address
          scan_range(0_u64, data_end, visit)
        end

        def self.scan_range(low : UInt64, high : UInt64, visit : Proc(UInt64, Nil)) : Nil
          return if high <= low
          cursor = low
          rem = cursor & 3_u64
          cursor = cursor + (4_u64 - rem) if rem != 0_u64
          while cursor + 4_u64 <= high
            val = (Pointer(Int32).new(cursor).value.to_i64 & 0xFFFFFFFF_i64).to_u64
            if val != 0_u64
              base = IyiHeap.base_of(val)
              visit.call(base) if base != 0_u64
            end
            cursor = cursor + 4_u64
          end
        end

        def self.base_of(word : UInt64) : UInt64
          IyiHeap.base_of(word)
        end
      end

      class IyiMark
        WHITE  = 0_u64
        GRAY   = 1_u64
        BLACK  = 2_u64
        COLOUR = 3_u64

        @@auto : Bool = true
        @@swept : UInt64 = 0_u64
        @@bytes_freed : UInt64 = 0_u64
        @@collections : UInt64 = 0_u64
        @@chunks_kept : UInt64 = 0_u64
        @@bytes_marked : UInt64 = 0_u64

        @@queue : Pointer(UInt64) = Pointer(UInt64).new(0_u64)
        @@queue_cap : UInt64 = 0_u64
        @@queue_len : UInt64 = 0_u64

        def self.init_queue(buffer : UInt64, capacity : UInt64) : Nil
          @@queue = Pointer(UInt64).new(buffer)
          @@queue_cap = capacity.unsafe_div(8_u64)
          @@queue_len = 0_u64
        end

        def self.ensure_queue : Nil
          if @@queue.address == 0_u64
            init_queue(IyiHeap.heap_start + 2048_u64, 63488_u64)
          end
        end

        def self.push_queue(base : UInt64) : Nil
          ensure_queue
          if @@queue_len < @@queue_cap
            (@@queue + @@queue_len.to_i64).value = base
            @@queue_len = @@queue_len + 1_u64
          else
            prev = LibWasmMem.memory_grow(0, 1)
            if prev >= 0
              page = prev.to_u64.unsafe_shl(16_u64)
              IyiHeap.update_heap_limits(page, 1_u64)
              new_q = Pointer(UInt64).new(page)
              idx = 0_u64
              while idx < @@queue_len
                (new_q + idx.to_i64).value = (@@queue + idx.to_i64).value
                idx = idx + 1_u64
              end
              @@queue = new_q
              @@queue_cap = 65536_u64.unsafe_div(8_u64)
              (@@queue + @@queue_len.to_i64).value = base
              @@queue_len = @@queue_len + 1_u64
            end
          end
        end

        def self.auto=(value : Bool) : Nil
          @@auto = value
        end

        def self.auto : Bool
          @@auto
        end

        def self.swept : UInt64
          @@swept
        end

        def self.bytes_freed : UInt64
          @@bytes_freed
        end

        def self.collections : UInt64
          @@collections
        end

        def self.colour(base : UInt64) : UInt64
          return WHITE if base == 0_u64
          mark = IyiHeap.read64(base - 8_u64)
          mark & COLOUR
        end

        def self.set_colour(base : UInt64, col : UInt64) : Nil
          mark = IyiHeap.read64(base - 8_u64)
          IyiHeap.write64(base - 8_u64, (mark - (mark & COLOUR)) | col)
        end

        def self.shade(base : UInt64) : Nil
          return if base == 0_u64
          return if colour(base) != WHITE
          self.set_colour(base, GRAY)
          self.push_queue(base)
        end

        def self.layouts_table : UInt64
          pointerof(LibIyiGCTable.__iyi_gc_layouts).address == 0_u64 ? 0_u64 : LibIyiGCTable.__iyi_gc_layouts.address
        end

        def self.layout_search(table : UInt64, entry_count : UInt64, type_id : UInt64) : UInt64
          return 0_u64 if entry_count == 0_u64 || table == 0_u64
          low = 0_u64
          high = entry_count - 1_u64
          while low <= high
            mid = low + (high - low).unsafe_shr(1_u64)
            entry = table + 8_u64 + mid * 40_u64
            entry_id = IyiHeap.read64(entry)
            if entry_id == type_id
              return entry
            elsif entry_id < type_id
              low = mid + 1_u64
            else
              return 0_u64 if mid == 0_u64
              high = mid - 1_u64
            end
          end
          0_u64
        end

        def self.drain : Nil
          table = layouts_table
          has_table = table != 0_u64 && IyiHeap.read64(table) > 0_u64
          entry_count = has_table ? IyiHeap.read64(table) : 0_u64

          while @@queue_len > 0_u64
            @@queue_len = @@queue_len - 1_u64
            base = (@@queue + @@queue_len.to_i64).value

            mark = IyiHeap.read64(base - 8_u64)
            is_atomic = mark & IyiHeap::ATOMIC_FLAG != 0_u64
            type_id = IyiHeap.read64(base - 16_u64)
            size = IyiHeap.read64(base - 24_u64)

            if !is_atomic
              entry = has_table && type_id != 0_u64 ? layout_search(table, entry_count, type_id) : 0_u64
              if entry != 0_u64
                scan_count = IyiHeap.read64(entry + 24_u64)
                scan_index = IyiHeap.read64(entry + 32_u64)
                offsets_base = table + 8_u64 + entry_count * 40_u64 + scan_index * 8_u64
                idx = 0_u64
                while idx < scan_count
                  offset = IyiHeap.read64(offsets_base + idx * 8_u64)
                  child_val = (Pointer(Int32).new(base + offset).value.to_i64 & 0xFFFFFFFF_i64).to_u64
                  if child_val != 0_u64
                    child_base = IyiHeap.base_of(child_val)
                    self.shade(child_base) if child_base != 0_u64
                  end
                  idx = idx + 1_u64
                end
              else
                cursor = base
                limit = base + size
                rem = cursor & 3_u64
                cursor = cursor + (4_u64 - rem) if rem != 0_u64
                while cursor + 4_u64 <= limit
                  child_val = (Pointer(Int32).new(cursor).value.to_i64 & 0xFFFFFFFF_i64).to_u64
                  if child_val != 0_u64
                    child_base = IyiHeap.base_of(child_val)
                    self.shade(child_base) if child_base != 0_u64
                  end
                  cursor = cursor + 4_u64
                end
              end
            end

            self.set_colour(base, BLACK)
            @@bytes_marked = @@bytes_marked + size
          end
        end

        def self.sweep : Nil
          @@swept = 0_u64
          @@bytes_freed = 0_u64
          @@chunks_kept = 0_u64

          arena = IyiHeap.all_arenas
          while arena != 0_u64
            chunk_size = IyiHeap.read64(arena + 8_u64)
            class_idx = IyiHeap.read64(arena + 16_u64).to_i32
            cursor = IyiHeap.read64(arena + 24_u64)
            head = arena + 64_u64
            while head + chunk_size <= arena + cursor
              p_obj = head + 24_u64
              mark = IyiHeap.read64(p_obj - 8_u64)
              if mark & IyiHeap::FREE_FLAG != 0_u64
                # already free
              elsif mark & COLOUR == WHITE
                IyiHeap.write64(p_obj, IyiHeap.free_list(class_idx))
                IyiHeap.set_free_list(class_idx, p_obj)
                IyiHeap.write64(p_obj - 8_u64, mark | IyiHeap::FREE_FLAG)
                payload_size = IyiHeap.read64(p_obj - 24_u64)
                @@bytes_freed = @@bytes_freed + payload_size
                @@swept = @@swept + 1_u64
              elsif mark & COLOUR == BLACK
                set_colour(p_obj, WHITE)
                @@chunks_kept = @@chunks_kept + 1_u64
              end
              head = head + chunk_size
            end
            arena = IyiHeap.read64(arena + 0_u64)
          end

          large = IyiHeap.large_objects
          while large != 0_u64
            p_obj = large + 24_u64
            mark = IyiHeap.read64(p_obj - 8_u64)
            if mark & IyiHeap::FREE_FLAG != 0_u64
              # already free
            elsif mark & COLOUR == WHITE
              IyiHeap.write64(p_obj - 8_u64, mark | IyiHeap::FREE_FLAG)
              size = IyiHeap.read64(p_obj - 24_u64)
              @@bytes_freed = @@bytes_freed + size
              @@swept = @@swept + 1_u64
            elsif mark & COLOUR == BLACK
              set_colour(p_obj, WHITE)
              @@chunks_kept = @@chunks_kept + 1_u64
            end
            large = IyiHeap.read64(large + 0_u64)
          end
        end

        def self.mark : UInt64
          IyiHeap.init_if_needed
          @@bytes_marked = 0_u64
          @@queue_len = 0_u64

          IyiRoots.each_root(->(base : UInt64) { shade(base) })
          drain
          @@bytes_marked
        end

        def self.collect : Nil
          mark
          sweep

          budget = @@bytes_marked * 2_u64
          budget = 1048576_u64 if budget < 1048576_u64
          IyiHeap.budget = budget
          IyiHeap.allocated_bytes = 0_u64
          @@collections = @@collections + 1_u64
        end

        def self.sweep_one(wanted : UInt64) : UInt64
          0_u64
        end

        def self.epoch_flag : UInt64
          0_u64
        end

        def self.pressure(bytes : UInt64) : Nil
          collect_if_due
        end

        def self.born_during_mark(base : UInt64, size : UInt64) : Nil
        end

        def self.assist : Nil
        end

        def self.collect_if_due : Nil
          if @@auto && IyiHeap.allocated_bytes >= IyiHeap.budget
            collect
          end
        end
      end
    {% else %}
      class IyiHeap
        @@cursor : UInt64 = 0_u64
        @@left : UInt64 = 0_u64

        def self.alloc(size : UInt64) : Void*
          bytes = size.to_i64
          remainder = bytes % 8
          bytes = bytes + (8 - remainder) if remainder > 0
          bytes = bytes + 16

          if @@left < bytes.to_u64
            pages = bytes // 65536
            pages = pages + 1 if bytes % 65536 > 0
            previous = LibWasmMem.memory_grow(0, pages.to_i32)
            if previous < 0
              __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
              __iyi_exit(1)
            end
            @@cursor = previous.to_u64.unsafe_shl(16)
            @@left = pages.to_u64.unsafe_shl(16)
          end

          block = Pointer(Void).new(@@cursor)
          @@cursor = @@cursor + bytes.to_u64
          @@left = @@left - bytes.to_u64
          block.as(Pointer(UInt64)).value = size
          block + 16_i64
        end

        def self.alloc_atomic(size : UInt64) : Void*
          alloc(size)
        end

        def self.realloc(pointer : Void*, size : UInt64) : Void*
          return alloc(size) if pointer.address == 0
          old_size = Pointer(UInt64).new(pointer.address - 16).value
          new_pointer = alloc(size)
          source = pointer.as(Pointer(UInt8))
          destination = new_pointer.as(Pointer(UInt8))
          limit = old_size < size ? old_size : size
          index = 0_u64
          while index < limit
            (destination + index.to_i64).value = (source + index.to_i64).value
            index = index + 1
          end
          new_pointer
        end
      end
    {% end %}

    fun __iyi_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __iyi_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc_atomic(size)
    end

    fun __iyi_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    {% if !flag?(:gc_none) %}
      fun __iyi_new(size : UInt64, type_id : UInt64, flags : UInt64) : Void*
        IyiHeap.new_object(size, type_id, flags & 1_u64 != 0, flags & 2_u64 != 0)
      end
    {% end %}
    # `memset` is defined locally because codegen itself reaches for the name
    # (`pre_initialize_aggregate` and `generic_array_malloc` lower to the LLVM
    # `llvm.memset` intrinsic, which becomes a C `memset` call once the size is
    # not a constant), and wasm32's size_t is 32-bit, so the signature LLVM
    # expects here is `void(i8*, i32, i32)` rather than the 64-bit count the
    # Linux and win32 paths carry. A definition with the matching name, types
    # and return is the only thing that can intercept it. The bulk goes four
    # bytes at a time because the pointers are 4-aligned at best on wasm32;
    # the byte loop carries the tail.
    fun memset(destination : Void*, value : Int32, count : Int32) : Void*
      byte = value.to_u8!
      word = (byte.to_u64 * 0x01010101_u64).to_i32
      words = destination.as(Pointer(Int32))
      total = count.to_i64.to_u64
      filled = 0_u64
      while filled + 4_u64 <= total
        words.value = word
        words = words + 1_i64
        filled = filled + 4_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < total
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% else %}
    {% raise "iyi: this target has no allocator binding in iyi's prelude. " \
             "Teach src/iyi/prelude.iyi a branch for this platform rather than " \
             "linking something absent." %}
  {% end %}
{% end %}

{% if flag?(:arm) || flag?(:wasm32) %}
  # `__multi3` is compiler-rt's 128-bit multiply helper, and LLVM emits calls
  # to it behind the program's back: on a 32-bit target a checked 64-bit
  # multiply legalizes by widening to an `i128` multiply, and neither arm nor
  # wasm32 has that instruction, so the multiply becomes a call to `__multi3`.
  # This prelude has two such multiplies on the wasm32 path alone — `memset`'s
  # word pattern and `Int64#to_s`'s power-of-ten count — and measured, that
  # helper is the one compiler-rt name in the wasm32 object's undefined list.
  # The mirror of `src/crystal/compiler_rt.cr` is exact on the flag: it
  # requires `compiler_rt/multi3.cr` precisely when `flag?(:arm) ||
  # flag?(:wasm32)`, so the same gate is here, and nothing else from that
  # file is pulled in. `shift.cr` (`__ashlti3` and kin) and `pow.cr`
  # (`__powisf2`, `__powidf2`) are wasm32 needs of Int128 shifts and `**`,
  # and iyi's primitives cross Int32/Int64/UInt8/UInt64/Float64 only, so no
  # codegen path emits those calls; fixint, float, mul and divmod128 serve
  # the Int128 division and conversion surface, which the same five types
  # lower natively.
  #
  # Written out rather than required, although `src/crystal/compiler_rt/` is
  # Crystal and pulling it in costs no library: `multi3.cr` is written against
  # Crystal's full primitives — `~`, `to_i128!`, arithmetic on Int128 — which
  # this prelude's five-type surface does not carry, so the file does not
  # compile under it. The algorithm is compiler-rt's (multi3.c over mulddi3.c,
  # which Crystal's port carries); the expression of it is iyi's. The halves
  # are read out of the operands as UInt64 words through a pointer — wasm32
  # and the arm targets Crystal builds are little-endian, so word 0 is the low
  # half — because the language has no i128 arithmetic to split with. Every
  # operation below is the wrapping form, which is exactly the mod 2^64 the
  # algorithm is written in, and the signed result falls out of the two's
  # complement words with no case analysis, the same way compiler-rt's does.
  fun __multi3(a : Int128, b : Int128) : Int128
    x = a
    y = b
    x_words = pointerof(x).as(Pointer(UInt64))
    y_words = pointerof(y).as(Pointer(UInt64))
    a_low = x_words.value
    a_high = (x_words + 1_i64).value
    b_low = y_words.value
    b_high = (y_words + 1_i64).value

    # mask keeps the low 32 bits of a word.
    mask = 0xFFFFFFFF_u64

    # mulddi3: the unsigned 64x64 -> 128 product of the two low words, kept
    # as a (low, high) pair rather than packed into an Int128.
    low = (a_low & mask) &* (b_low & mask)
    t = low.unsafe_shr(32)
    low = low & mask
    t = t &+ ((a_low.unsafe_shr(32)) &* (b_low & mask))
    low = low &+ ((t & mask).unsafe_shl(32))
    high = t.unsafe_shr(32)
    t = low.unsafe_shr(32)
    low = low & mask
    t = t &+ ((b_low.unsafe_shr(32)) &* (a_low & mask))
    low = low &+ ((t & mask).unsafe_shl(32))
    high = high &+ t.unsafe_shr(32)
    high = high &+ ((a_low.unsafe_shr(32)) &* (b_low.unsafe_shr(32)))

    # multi3's own step: the high word adds the cross products, mod 2^64.
    high = high &+ (a_high &* b_low)
    high = high &+ (a_low &* b_high)

    result = uninitialized Int128
    result_words = pointerof(result).as(Pointer(UInt64))
    result_words.value = low
    (result_words + 1_i64).value = high
    result
  end
{% end %}

{% if flag?(:win32) %}
  # The four division helpers LLVM calls for a 128-bit `/` and `%`, and why
  # Windows is the target that has to carry them.
  #
  # LLVM has no 128-bit divide instruction to lower to on any target: an
  # `sdiv`/`udiv`/`srem`/`urem` on `i128` becomes a call to `__divti3`,
  # `__udivti3`, `__modti3` or `__umodti3`, the compiler-rt names. Linux and
  # darwin have that library on the link line already, as libgcc or as the
  # platform's own compiler-rt; the msvc link step has neither, so every
  # program that divided a 128-bit integer failed to link:
  #
  #   I-nt128.o0.obj : error LNK2019: unresolved external symbol __modti3
  #   referenced in function .2A.Int128.23..25..3C.Int128.3E..3A.Int128
  #
  # which is `std/int`'s `Int128#%`. Linking `clang_rt.builtins-x86_64.lib`
  # for four functions would move this tree's dependency floor
  # (`bench/dependency_floor.sh`: kernel32, advapi32, ws2_32, the CRT import
  # libraries and the opt-in collector), so the four are defined here
  # instead, the same way `__multi3` above is defined for the targets that
  # ask for it.
  #
  # These are ABI, not library API: LLVM emits the calls behind the
  # program's back, so the names, the parameters and the return are the
  # backend's, and a definition that merely looks right is a silently wrong
  # quotient. The shape below is measured, from `--emit asm` on a program
  # that divides a `UInt128`: the call site passes each operand *by
  # address*, dividend in rcx and divisor in rdx, and reads the answer out
  # of xmm0 —
  #
  #   lea rcx, [rsp + 80]   ; the dividend's two words
  #   lea rdx, [rsp + 64]   ; the divisor's two words
  #   call __udivti3
  #   movq rax, xmm0
  #   pshufd xmm0, xmm0, 238
  #   movq rdx, xmm0
  #
  # which is the Win64 rule for a 16-byte value, and not the rax:rdx pair
  # that `fun __udivti3(a : UInt128, b : UInt128) : UInt128` is lowered
  # to. Written that way first, every quotient was 0 and the program then
  # died of a divide by zero fault: the callee was reading register halves
  # nobody had put operands in. So the parameters here are pointers, the
  # answer is put in xmm0 by hand, and the functions return nothing —
  # `__iyi_win_answer128` below says what happened to the one iyi return
  # type that reaches that register.
  #
  # Nothing below divides a 128-bit value, because `/` and `%` on one are
  # calls to these very functions and the program would recurse until the
  # stack ran out. The arithmetic is 64-bit words throughout, read out of
  # the operands through a pointer the way `__multi3` reads them; win32 is
  # little-endian, so word 0 is the low half.

  # How many bits the word occupies: the highest set bit's index plus one,
  # and zero for zero. It is what keeps the long division below off the
  # leading zeros of the dividend — 2^100 over a divisor above 2^64 costs
  # the 101 steps its bits ask for, not 128.
  def __iyi_win_bit_span(word : UInt64) : Int32
    value = word
    span = 0
    if value.unsafe_shr(32) != 0_u64
      value = value.unsafe_shr(32)
      span = span + 32
    end
    if value.unsafe_shr(16) != 0_u64
      value = value.unsafe_shr(16)
      span = span + 16
    end
    if value.unsafe_shr(8) != 0_u64
      value = value.unsafe_shr(8)
      span = span + 8
    end
    if value.unsafe_shr(4) != 0_u64
      value = value.unsafe_shr(4)
      span = span + 4
    end
    if value.unsafe_shr(2) != 0_u64
      value = value.unsafe_shr(2)
      span = span + 2
    end
    if value.unsafe_shr(1) != 0_u64
      value = value.unsafe_shr(1)
      span = span + 1
    end
    value == 0_u64 ? 0 : span + 1
  end

  # A word the optimiser cannot see the value of. It exists for the
  # divide-by-zero case below: inside a branch that has just tested the
  # divisor's low word against zero, LLVM knows what that word is, and it
  # folds a divide by a known zero to poison rather than emitting the
  # instruction. Measured: at `--release` the 128-bit divide by zero over
  # a dividend wider than a word printed 1554060939272 and exited 0, while
  # the same program at -O0 faulted. The word travels through an empty asm
  # here, so the divide that follows is a real one.
  def __iyi_win_opaque_word(word : UInt64) : UInt64
    answer = uninitialized UInt64
    asm("" : "=r"(answer) : "r"(word) :: "volatile")
    answer
  end

  # The unsigned kernel: quotient and remainder of one 128-bit division,
  # both written through the caller's pointers, which is compiler-rt's own
  # `__udivmodti4` shape. One kernel answers all four names, and the
  # remainder falls out of the same loop the quotient does, so `%` costs a
  # division and not a division plus a multiply.
  #
  # Division by zero is the processor's, not this file's. Measured on this
  # machine, an iyi program whose 64-bit divisor is zero prints nothing and
  # the process dies with exit code 0xC0000094,
  # STATUS_INTEGER_DIVIDE_BY_ZERO — the runtime's vectored filter answers
  # only for a stack overflow and an access violation, so the fault travels
  # to Windows untouched. The two word-sized cases below are therefore left
  # to the hardware `div`, which is the instruction that raises exactly
  # that, rather than given a check of their own: a second behaviour for a
  # divisor of zero, invented here and different at 128 bits than at 64,
  # would be the worse answer. It is also what compiler-rt does —
  # `n.s.high % d.s.low` on a zero low word is in `udivmodti4.c` for this
  # reason. `std/int`'s `//` and `%` still refuse a zero divisor with a
  # sentence before any of this is reached; what is matched here is what
  # `unsafe_div` and `unsafe_mod` do.
  def __iyi_win_udivmod128(a : UInt128, b : UInt128, quotient : Pointer(UInt128), remainder : Pointer(UInt128)) : Nil
    dividend = a
    divisor = b
    dividend_words = pointerof(dividend).as(Pointer(UInt64))
    divisor_words = pointerof(divisor).as(Pointer(UInt64))
    a_low = dividend_words.value
    a_high = (dividend_words + 1_i64).value
    b_low = divisor_words.value
    b_high = (divisor_words + 1_i64).value

    quotient_words = quotient.as(Pointer(UInt64))
    remainder_words = remainder.as(Pointer(UInt64))

    if b_high == 0_u64
      if a_high == 0_u64
        # Both operands inside one word: one 64-bit divide answers it, and
        # a zero divisor faults here.
        quotient_words.value = a_low.unsafe_div(b_low)
        (quotient_words + 1_i64).value = 0_u64
        remainder_words.value = a_low.unsafe_mod(b_low)
        (remainder_words + 1_i64).value = 0_u64
        return nil
      end
      if b_low == 0_u64
        # A zero divisor under a dividend too wide for a word: the high
        # word divided by it raises the same fault, and the divisor goes
        # through `__iyi_win_opaque_word` so that the divide is still there
        # at -O3.
        zero = __iyi_win_opaque_word(b_low)
        quotient_words.value = a_high.unsafe_div(zero)
        (quotient_words + 1_i64).value = 0_u64
        remainder_words.value = a_high.unsafe_mod(zero)
        (remainder_words + 1_i64).value = 0_u64
        return nil
      end
    end

    # Shift-subtract long division, most significant bit first: the
    # remainder takes one bit of the dividend per step, and the step where
    # it reaches the divisor subtracts and sets that bit of the quotient.
    # A 128-bit compare is the high words, then the low; a 128-bit subtract
    # is the low words with the borrow carried into the high.
    q_low = 0_u64
    q_high = 0_u64
    r_low = 0_u64
    r_high = 0_u64
    bit = a_high == 0_u64 ? __iyi_win_bit_span(a_low) - 1 : __iyi_win_bit_span(a_high) + 63
    while bit >= 0
      r_high = r_high.unsafe_shl(1) | r_low.unsafe_shr(63)
      r_low = r_low.unsafe_shl(1)
      r_low = r_low | (bit >= 64 ? a_high.unsafe_shr(bit - 64) & 1_u64 : a_low.unsafe_shr(bit) & 1_u64)
      if r_high > b_high || (r_high == b_high && r_low >= b_low)
        borrow = r_low < b_low ? 1_u64 : 0_u64
        r_low = r_low &- b_low
        r_high = (r_high &- b_high) &- borrow
        if bit >= 64
          q_high = q_high | 1_u64.unsafe_shl(bit - 64)
        else
          q_low = q_low | 1_u64.unsafe_shl(bit)
        end
      end
      bit = bit - 1
    end

    quotient_words.value = q_low
    (quotient_words + 1_i64).value = q_high
    remainder_words.value = r_low
    (remainder_words + 1_i64).value = r_high
    nil
  end

  # The signed pair, built out of the unsigned kernel: each operand's sign
  # is the top bit of its high word, the magnitudes are the two's
  # complement negations, and C's rules put the signs back — the quotient
  # takes the two signs multiplied, the remainder takes the dividend's.
  #
  # The one magnitude that does not fit needs no case of its own: negating
  # the most negative Int128 yields the same two words, and read unsigned
  # they are 2^127, which is its magnitude exactly. That also settles
  # `MIN / -1`, whose true quotient is one past the type: the unsigned
  # quotient is 2^127, negating it gives back 2^127, and the words read
  # signed are MIN again — the wrap the hardware and compiler-rt both
  # answer for a division C leaves undefined. `std/int`'s `//` and `%`
  # refuse that pair before ever reaching here.
  def __iyi_win_divmod128_signed(a : Int128, b : Int128, quotient : Pointer(Int128), remainder : Pointer(Int128)) : Nil
    left = a
    right = b
    left_words = pointerof(left).as(Pointer(UInt64))
    right_words = pointerof(right).as(Pointer(UInt64))
    a_low = left_words.value
    a_high = (left_words + 1_i64).value
    b_low = right_words.value
    b_high = (right_words + 1_i64).value

    a_negative = a_high.unsafe_shr(63) != 0_u64
    b_negative = b_high.unsafe_shr(63) != 0_u64
    if a_negative
      a_borrow = a_low != 0_u64 ? 1_u64 : 0_u64
      a_low = 0_u64 &- a_low
      a_high = (0_u64 &- a_high) &- a_borrow
    end
    if b_negative
      b_borrow = b_low != 0_u64 ? 1_u64 : 0_u64
      b_low = 0_u64 &- b_low
      b_high = (0_u64 &- b_high) &- b_borrow
    end

    magnitude_a = uninitialized UInt128
    magnitude_b = uninitialized UInt128
    magnitude_a_words = pointerof(magnitude_a).as(Pointer(UInt64))
    magnitude_b_words = pointerof(magnitude_b).as(Pointer(UInt64))
    magnitude_a_words.value = a_low
    (magnitude_a_words + 1_i64).value = a_high
    magnitude_b_words.value = b_low
    (magnitude_b_words + 1_i64).value = b_high

    unsigned_quotient = uninitialized UInt128
    unsigned_remainder = uninitialized UInt128
    __iyi_win_udivmod128(magnitude_a, magnitude_b, pointerof(unsigned_quotient), pointerof(unsigned_remainder))

    quotient_source = pointerof(unsigned_quotient).as(Pointer(UInt64))
    remainder_source = pointerof(unsigned_remainder).as(Pointer(UInt64))
    q_low = quotient_source.value
    q_high = (quotient_source + 1_i64).value
    r_low = remainder_source.value
    r_high = (remainder_source + 1_i64).value

    if a_negative != b_negative
      q_borrow = q_low != 0_u64 ? 1_u64 : 0_u64
      q_low = 0_u64 &- q_low
      q_high = (0_u64 &- q_high) &- q_borrow
    end
    if a_negative
      r_borrow = r_low != 0_u64 ? 1_u64 : 0_u64
      r_low = 0_u64 &- r_low
      r_high = (0_u64 &- r_high) &- r_borrow
    end

    quotient_words = quotient.as(Pointer(UInt64))
    quotient_words.value = q_low
    (quotient_words + 1_i64).value = q_high
    remainder_words = remainder.as(Pointer(UInt64))
    remainder_words.value = r_low
    (remainder_words + 1_i64).value = r_high
    nil
  end

  # The answer, into the register the call site reads it from: one
  # unaligned 16-byte load, and it is the last thing each entry point
  # does. Nothing after it touches xmm0, so the register still holds both
  # words at the `ret`.
  #
  # The value is not handed back as a return value, because a 128-bit one
  # has no iyi type that lands in xmm0. A `Float64` out of the asm was
  # tried and answered every wide quotient with its low word and a zero
  # high word: a double is 64 bits, so LLVM rounded the register through
  # the stack — `movsd qword ptr [rsp + 8], xmm0` and back — and the high
  # lane went with it. These functions therefore return nothing, and the
  # register is the answer.
  def __iyi_win_answer128(value : Void*) : Nil
    asm("movups ($0), %xmm0" :: "r"(value) : "xmm0" : "volatile")
    nil
  end

  fun __udivti3(a : Pointer(UInt128), b : Pointer(UInt128)) : Nil
    quotient = uninitialized UInt128
    remainder = uninitialized UInt128
    __iyi_win_udivmod128(a.value, b.value, pointerof(quotient), pointerof(remainder))
    __iyi_win_answer128(pointerof(quotient).as(Void*))
  end

  fun __umodti3(a : Pointer(UInt128), b : Pointer(UInt128)) : Nil
    quotient = uninitialized UInt128
    remainder = uninitialized UInt128
    __iyi_win_udivmod128(a.value, b.value, pointerof(quotient), pointerof(remainder))
    __iyi_win_answer128(pointerof(remainder).as(Void*))
  end

  fun __divti3(a : Pointer(Int128), b : Pointer(Int128)) : Nil
    quotient = uninitialized Int128
    remainder = uninitialized Int128
    __iyi_win_divmod128_signed(a.value, b.value, pointerof(quotient), pointerof(remainder))
    __iyi_win_answer128(pointerof(quotient).as(Void*))
  end

  fun __modti3(a : Pointer(Int128), b : Pointer(Int128)) : Nil
    quotient = uninitialized Int128
    remainder = uninitialized Int128
    __iyi_win_divmod128_signed(a.value, b.value, pointerof(quotient), pointerof(remainder))
    __iyi_win_answer128(pointerof(remainder).as(Void*))
  end
{% end %}
# ── end of the memory layer ─────────────────────────────────────────────

# The three symbols an `ensure` names and a `defer` links: a personality,
# the exception fetch and the re-raise. None is reachable — reaching one
# would mean something is unwinding, and nothing here unwinds (III.1.4).
fun __iyi_personality
  print "iyi: __iyi_personality called, which cannot happen\n"
  __iyi_exit(1)
end

fun __iyi_get_exception(exception : Void*) : UInt64
  print "iyi: __iyi_get_exception called, which cannot happen\n"
  __iyi_exit(1)
  0_u64
end

@[Raises]
fun __iyi_raise(exception : Void*) : NoReturn
  print "iyi: __iyi_raise called, which cannot happen\n"
  __iyi_exit(1)
end

# Every checked operation names this; the body is the ordinary panic, so an
# overflow in a task dies at the task boundary like any other bug.
fun __iyi_raise_overflow : NoReturn
  raise "arithmetic overflow"
end

struct Pointer(T)
  def [](offset : Int32) : T
    (self + offset.to_i64).value
  end

  def []=(offset : Int32, value : T) : T
    (self + offset.to_i64).value = value
  end

  # Bytes, not elements: every caller here is copying string contents.
  def copy_from(source : Pointer(T), count : Int32) : Nil
    index = 0
    while index < count
      self[index] = source[index]
      index = index + 1
    end
  end
end

# ── Panics — SPEC.md III.1.4, built ───────────────────────────────────
#
# A panic is for bugs, not control flow, and it unwinds without an
# unwinder: `defer` registers its cleanup on the way in (the normalizer
# emits `__iyi_defer_push`/`__iyi_defer_pop_run` around every deferred
# scope), so the panic path walks a list, not frames, and the Itanium
# machinery stays unlinked. On the concurrency targets the registry lives
# on the current fiber and a panicking task dies alone: its defers run,
# its siblings are cancelled, and the group's join re-panics in the owner
# (III.1.4); an uncaught panic still reaches main and exits 1. Elsewhere
# the registry is one global stack and a panic is a clean exit.

# One registered cleanup; a class, since an intrusive list node must be a reference.
class IyiDeferNode
  @proc : Proc(Nil)
  property next_node : IyiDeferNode?

  def initialize(@proc : Proc(Nil))
    @next_node = nil
  end

  def run : Nil
    @proc.call
  end
end

{% unless (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
  # No fibers on this target, so one global stack is exact.
  class IyiDefers
    @@head : IyiDeferNode?

    def self.push(node : IyiDeferNode) : Nil
      node.next_node = @@head
      @@head = node
    end

    def self.pop_run : Nil
      node = @@head
      return unless node.is_a?(IyiDeferNode)
      @@head = node.next_node
      node.run
    end

    def self.drain : Nil
      while true
        node = @@head
        return unless node.is_a?(IyiDeferNode)
        @@head = node.next_node
        node.run
      end
    end
  end

  def __iyi_defer_push(cleanup : Proc(Nil)) : Nil
    IyiDefers.push(IyiDeferNode.new(cleanup))
  end

  def __iyi_defer_pop_run : Nil
    IyiDefers.pop_run
  end
{% end %}

# `raise` is a panic. It prints once, at the point of the bug, then
# unwinds by registry: pending defers run innermost-first, and on the
# concurrency targets the current *task* dies rather than the process —
# the group boundary re-raises in the owner, which is where III.1.4
# says a panic is caught. `NoReturn` is a type-system fact `.or_panic`
# depends on (III.1.3): the fiber never resumes.
class IyiPanic
  @@resolver : Proc(Pointer(Void*), Int32, Nil)? = nil

  def self.resolver=(r : Proc(Pointer(Void*), Int32, Nil)?) : Nil
    @@resolver = r
  end

  def self.resolver
    @@resolver
  end
end

# The panic's own write: descriptor 2 directly, no stream object, no error;
# `print` raises when a pipe closes and `STDERR` may not exist yet.
private def __iyi_say(text : String) : Nil
  written = 0_i64
  total = text.bytesize.to_i64
  while written < total
    n = __iyi_write(2, (text.to_unsafe + written).as(Void*), (total - written).to_u64)
    break if n <= 0_i64
    written = written + n
  end
end

def raise(message : String, file : String = __FILE__, line : Int32 = __LINE__) : NoReturn
  {% if flag?(:darwin) %}
    callstack = uninitialized Void*[64]
    count = LibC.backtrace(pointerof(callstack).as(Void**), 64)
  {% elsif flag?(:win32) && flag?(:x86_64) %}
    # Captured before anything is printed, and two frames skipped: this
    # function and the kernel's own collector. Sixty-four is what the
    # darwin arm asks for, so a resolver written against one works on the
    # other.
    callstack = uninitialized Void*[64]
    count = LibC.RtlCaptureStackBackTrace(2, 64, pointerof(callstack).as(Void**), Pointer(Int32).new(0_u64)) & 0xFFFF
  {% end %}
  __iyi_say("iyi: panic: ")
  __iyi_say(message)
  __iyi_say("\n")
  # The site, when it is the program's; a panic the library raises names
  # the library's own line, which is not where the bug is, and prints none.
  unless file.includes?("/src/iyi/") || file.includes?("/src/std/") || file.starts_with?("src/iyi/") || file.starts_with?("src/std/")
    __iyi_say("  at ")
    __iyi_say(file)
    __iyi_say(":")
    __iyi_say(line.to_s)
    __iyi_say("\n")
  end
  {% if flag?(:darwin) %}
    if r = IyiPanic.resolver
      r.call(count > 1 ? pointerof(callstack).as(Void**) + 1 : pointerof(callstack).as(Void**), count > 1 ? count - 1 : count)
    elsif count > 1
      LibC.backtrace_symbols_fd(pointerof(callstack).as(Void**) + 1, count - 1, 2)
    elsif count == 1
      LibC.backtrace_symbols_fd(pointerof(callstack).as(Void**), 1, 2)
    end
  {% end %}
  {% if flag?(:win32) && flag?(:x86_64) %}
    # A resolver if a program imported one (`std/debug` installs itself),
    # and otherwise nothing: Windows has no `backtrace_symbols_fd`, and an
    # address with no name and no line beside it is noise on the error
    # stream rather than a frame. What names them is `std/debug`, which
    # reads the program's own PDB.
    if r = IyiPanic.resolver
      if count > 0
        r.call(pointerof(callstack).as(Void**), count)
      end
    end
  {% end %}
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
    IyiScheduler.panic_current(message)
  {% else %}
    IyiDefers.drain
    __iyi_exit(1)
  {% end %}
end

# The one word a test needs (`iyi test`): a false condition is a panic
# naming the site, exiting 1, which is the contract every gate runs on.
def assert(condition : Bool, message : String = "", file : String = __FILE__, line : Int32 = __LINE__) : Nil
  return if condition
  raise(message.empty? ? "assertion failed" : "assertion failed: " + message, file, line)
end

# What a wait answers when its task was cancelled (III.4.2): an error
# member. Here, not in the runtime: `IyiSocket` answers it on every target.
pub struct Cancelled
  def initialize
  end
end

impl Error for Cancelled
  def message : String
    "cancelled"
  end
end

# A failed `.as` in `select` expansion is a compiler bug; this panic carries
# the constant's name rather than an exception type.
class TypeCastError
  @message : String

  def initialize(@message : String)
  end

  def message : String
    @message
  end
end

def raise(error : TypeCastError) : NoReturn
  raise error.message
end

# Until a `break`.
def loop(& : -> Nil) : Nil
  while true
    yield
  end
end

# The program's own name-plate: arguments and environment, read on
# demand from what already exists — no captured state, no boot order to
# get wrong. `ARGC_UNSAFE`/`ARGV_UNSAFE` are the compiler's predefined
# constants, initialised from `main`'s own parameters before anything
# else runs (codegen/const.cr); on the POSIX targets `environ` is the C
# runtime's exported global. A first draft captured argv in class
# variables from `main` and read zeros: `__iyi_main` runs the
# class-variable initialisers *after* `main`'s prologue stored, wiping
# it — symbols do not have that ordering problem.
#
# On wasm32 there is no environment to read and `env` answers nil for
# every name: the sandbox story (SPEC.md III.12) is that the runtime
# hands the program nothing, and an absent surface beats a permission.
#
# On Windows there is no `environ` worth reaching. The CRT's `_environ`,
# whose address `__p__environ` hands back, is the *ANSI* environment: a
# copy of the real block folded into the process's code page. Measured
# with PowerShell setting `IYI_PROBE_TR` to `değer-日本`, 13 bytes of
# UTF-8, and the program reading it back through that table: `deger-??`,
# 8 bytes — `ğ` best-fitted to `g`, `ı` to `i`, `ş` to `s`, and `日本` to
# two question marks, the same defect the paths and the console had.
#
# It is also not the environment anybody else reads. `ENV["X"] = …` used
# to install a table of its own here, and measured, after that write
# `GetEnvironmentStringsW` — the block `CreateProcess` copies into a
# child — did not carry the variable at all, while the CRT table did. Two
# environments that disagreed, and the one every child inherits was the
# one iyi was not writing.
#
# So on Windows the platform's own block is the only environment: a lookup
# is `GetEnvironmentVariableW`, a write and a delete are
# `SetEnvironmentVariableW`, and enumeration is `GetEnvironmentStringsW`
# (`src/std/env.iyi`). UTF-16 both ways, nothing folded, and one
# environment instead of two.
{% if flag?(:win32) %}
  @[Link("kernel32")]
  lib LibIyiEnv
    fun GetEnvironmentVariableW(name : UInt16*, buffer : UInt16*, size : Int32) : Int32
    fun SetEnvironmentVariableW(name : UInt16*, value : UInt16*) : Int32
    fun GetEnvironmentStringsW : UInt16*
    fun FreeEnvironmentStringsW(block : UInt16*) : Int32
    # The last-error slot is half of `GetEnvironmentVariableW`'s answer and
    # the call leaves it alone when it succeeds, so it is cleared before
    # asking; `LibC.GetLastError` reads it back.
    fun SetLastError(error : Int32)
  end
{% elsif !flag?(:wasm32) %}
  lib LibIyiEnv
    $environ : UInt8**
  end
{% end %}

{% if flag?(:win32) %}
  # A name and a value are UTF-8 on iyi's side and UTF-16 on Windows', and
  # these two are the whole of the conversion: `MultiByteToWideChar` and
  # `WideCharToMultiByte` at CP_UTF8 (65001), the same pair
  # `__iyi_wide_path` and `__iyi_utf8_size_from_wide` put a path through.
  #
  # Two differences from those, both of them the environment's. The flags
  # are strict — MB_ERR_INVALID_CHARS (8) and WC_ERR_INVALID_CHARS (128) —
  # where a path passes 0: with 0, bytes that are not UTF-8 become U+FFFD
  # and a lone surrogate in a value becomes U+FFFD too, so what comes back
  # is a half-converted string that no longer matches the name it was asked
  # for, and nil is the honest answer for both. And the count is explicit
  # rather than `-1`: a name in `GetEnvironmentStringsW`'s block is the
  # slice in front of the first `=` and carries no terminator of its own,
  # which a NUL-terminated-only conversion cannot express.
  #
  # Windows documents a zero count as a failed call, so the empty string is
  # answered here rather than asked about — a variable whose value is `""`
  # exists, and `ENV["X"] = ""` is a write the platform keeps.
  def __iyi_win_env_wide(text : UInt8*, bytes : Int32) : UInt16*
    if bytes == 0
      empty = Pointer(UInt16).malloc(1_u64)
      empty[0] = 0_u16
      return empty
    end
    needed = LibC.MultiByteToWideChar(65001, 8, text, bytes, Pointer(UInt16).new(0_u64), 0)
    return Pointer(UInt16).new(0_u64) if needed <= 0
    # An explicit byte count leaves the terminator out of the answer and out
    # of the buffer, and every one of these goes to a `*W` call that wants
    # one, so it is written on.
    wide = Pointer(UInt16).malloc((needed + 1).to_u64)
    written = LibC.MultiByteToWideChar(65001, 8, text, bytes, wide, needed)
    return Pointer(UInt16).new(0_u64) if written <= 0
    wide[written] = 0_u16
    wide
  end

  def __iyi_win_env_text(wide : UInt16*, count : Int32) : String | Nil
    return "" if count == 0
    needed = LibC.WideCharToMultiByte(65001, 128, wide, count, Pointer(UInt8).new(0_u64), 0,
      Pointer(UInt8).new(0_u64), Pointer(Int32).new(0_u64))
    return nil if needed <= 0
    String.new(needed) do |target|
      LibC.WideCharToMultiByte(65001, 128, wide, count, target, needed,
        Pointer(UInt8).new(0_u64), Pointer(Int32).new(0_u64))
    end
  end

  # ERROR_ENVVAR_NOT_FOUND, which is the one thing a zero answer from
  # `GetEnvironmentVariableW` can mean besides a value of `""`.
  IYI_WIN_ENVVAR_NOT_FOUND = 203

  # One variable out of the block. `GetEnvironmentVariableW` says three
  # different things with one number, and reading two of them as one is the
  # confusion this shape exists to avoid: the characters it copied when the
  # buffer held the value, the characters the value *needs* — terminator
  # included — when it did not, and 0 both when the variable is absent and
  # when its value is the empty string. Only the error slot separates the
  # last two, and the call does not write it on success, so it is cleared
  # first.
  #
  # 256 characters is one call for every ordinary variable and two for
  # `PATH`; the retry asks for exactly what the first call said it needed,
  # so it repeats only if something grew the value in between.
  def __iyi_win_env_get(name : UInt8*, name_bytes : Int32) : String | Nil
    wide = __iyi_win_env_wide(name, name_bytes)
    return nil if wide.address == 0_u64
    room = 256
    buffer = Pointer(UInt16).malloc(room.to_u64)
    LibIyiEnv.SetLastError(0)
    length = LibIyiEnv.GetEnvironmentVariableW(wide, buffer, room)
    while length >= room
      room = length
      buffer = Pointer(UInt16).malloc(room.to_u64)
      LibIyiEnv.SetLastError(0)
      length = LibIyiEnv.GetEnvironmentVariableW(wide, buffer, room)
    end
    if length == 0
      return nil if LibC.GetLastError == IYI_WIN_ENVVAR_NOT_FOUND
      return ""
    end
    __iyi_win_env_text(buffer, length)
  end

  # A write and a delete are the same call: Windows spells the deletion
  # with a null value and has no separate entry point for it. Both answer
  # false rather than raising when the name or the value is not UTF-8,
  # because the caller in `src/std/env.iyi` is the one that knows whether
  # that is a refusal or a nil.
  def __iyi_win_env_set(name : UInt8*, name_bytes : Int32, value : UInt8*, value_bytes : Int32) : Bool
    wide_name = __iyi_win_env_wide(name, name_bytes)
    return false if wide_name.address == 0_u64
    wide_value = __iyi_win_env_wide(value, value_bytes)
    return false if wide_value.address == 0_u64
    LibIyiEnv.SetEnvironmentVariableW(wide_name, wide_value) != 0
  end

  def __iyi_win_env_unset(name : UInt8*, name_bytes : Int32) : Bool
    wide_name = __iyi_win_env_wide(name, name_bytes)
    return false if wide_name.address == 0_u64
    LibIyiEnv.SetEnvironmentVariableW(wide_name, Pointer(UInt16).new(0_u64)) != 0
  end
{% end %}

# The environment's table, and the only two operations anything performs on
# it: read the current one, and put a new one in its place. Windows is
# absent from both because it has no table to edit — nothing there reads
# `_environ` any more.
{% if !flag?(:wasm32) && !flag?(:win32) %}
  def __iyi_environ : UInt8**
    LibIyiEnv.environ
  end

  def __iyi_set_environ(entries : UInt8**) : Nil
    LibIyiEnv.environ = entries
    nil
  end
{% end %}

# The running program: its arguments and its environment, on demand.
class Program
  # The arguments after the program's own name, the way every shell
  # hands them over.
  def self.args : Array(String)
    {% if flag?(:win32) %}
      # The command line, as Windows kept it, and not as the C runtime
      # handed it over. `ARGV_UNSAFE` is the CRT's `argv`, which is the
      # *ANSI* command line: measured, a program given `ünïcode-çğış` and
      # `日本` from PowerShell saw `ünïcode-çgis` — `ğ`, `ı` and `ş`
      # replaced by the code page's best-fit letters — and `??`. A file
      # named in an argument therefore named a different file, or none.
      #
      # `GetCommandLineW` is the line the kernel kept, in UTF-16, and the
      # splitting is done here rather than by `CommandLineToArgvW`
      # because that one lives in shell32 and a second DLL is a floor this
      # library does not move (SPEC.md III.10). The rules are Microsoft's
      # own, and they are about backslashes only where a quote follows:
      # 2n backslashes before a `"` are n backslashes and the quote
      # toggles, 2n+1 are n backslashes and a literal quote, and a
      # backslash with no quote after it is a backslash. Inside quotes,
      # `""` is a literal quote — the rule that lets a quoted argument
      # carry one.
      line = LibC.GetCommandLineW
      return [] of String if line.address == 0_u64
      result = [] of String
      # One buffer for the argument being built: an argument is never
      # longer than the whole line, and the line is read once.
      length = 0
      while line[length] != 0_u16
        length = length + 1
      end
      piece = Pointer(UInt16).malloc((length + 1).to_u64)
      index = 0
      first = true
      while index < length
        # Whitespace between arguments: space and tab, as the parser
        # Windows documents treats them.
        while index < length && (line[index] == 32_u16 || line[index] == 9_u16)
          index = index + 1
        end
        break if index >= length
        taken = 0
        quoted = false
        while index < length
          ch = line[index]
          break if !quoted && (ch == 32_u16 || ch == 9_u16)
          if ch == 92_u16
            slashes = 0
            while index < length && line[index] == 92_u16
              slashes = slashes + 1
              index = index + 1
            end
            if index < length && line[index] == 34_u16
              pairs = slashes // 2
              written = 0
              while written < pairs
                piece[taken] = 92_u16
                taken = taken + 1
                written = written + 1
              end
              if slashes % 2 == 1
                piece[taken] = 34_u16
                taken = taken + 1
                index = index + 1
              else
                quoted = !quoted
                index = index + 1
              end
            else
              written = 0
              while written < slashes
                piece[taken] = 92_u16
                taken = taken + 1
                written = written + 1
              end
            end
          elsif ch == 34_u16
            if quoted && index + 1 < length && line[index + 1] == 34_u16
              piece[taken] = 34_u16
              taken = taken + 1
              index = index + 2
            else
              quoted = !quoted
              index = index + 1
            end
          else
            piece[taken] = ch
            taken = taken + 1
            index = index + 1
          end
        end
        piece[taken] = 0_u16
        # The first argument is the program's own name, which every shell
        # drops before handing the rest over.
        unless first
          size = __iyi_utf8_size_from_wide(piece)
          if size > 0
            result << String.new(size - 1) { |target| __iyi_utf8_bytes_from_wide(piece, target, size) }
          end
        end
        first = false
      end
      result
    {% else %}
      result = [] of String
      index = 1
      while index < ARGC_UNSAFE
        result << string_from(ARGV_UNSAFE[index])
        index = index + 1
      end
      result
    {% end %}
  end

  # One variable, or nil. No map of everything: the asking program names
  # what it wants, and a tool that dumps its whole environment into a
  # structure was one `puts` away from leaking it.
  def self.env(name : String) : String | Nil
    {% if flag?(:wasm32) %}
      nil
    {% elsif flag?(:win32) %}
      # Windows' own block, not the CRT's ANSI copy of it: that copy
      # answered a variable PowerShell had set to `değer-日本` as
      # `deger-??`.
      __iyi_win_env_get(name.to_unsafe, name.bytesize)
    {% else %}
      pointer = __iyi_environ
      return nil if pointer.address == 0_u64

      length = name.bytesize
      bytes = name.to_unsafe
      index = 0
      while (entry = pointer[index]).address != 0_u64
        offset = 0
        while offset < length && entry[offset] == bytes[offset]
          offset = offset + 1
        end
        # 61 is '=': the byte that ends the name in `NAME=value`.
        if offset == length && entry[length] == 61_u8
          return string_from(entry + (length + 1))
        end
        index = index + 1
      end
      nil
    {% end %}
  end

  # The directory the process is in, which is not what `PWD` says.
  # `PWD` is a variable a shell keeps: cmd and PowerShell never set it,
  # so on Windows every program that expanded a relative path panicked
  # ("no base given and PWD is not set"), and on POSIX it is a copy that
  # a program's own `Dir.cd` leaves behind. Nil when the platform has no
  # answer — wasm32-wasi resolves a path against a preopened directory
  # and names none — or when the directory is gone from under the
  # process.
  #
  # 4096 bytes covers POSIX's PATH_MAX and Windows' MAX_PATH; the second
  # try is for a Windows path built with `\\?\`, which reaches 32,767
  # characters and up to three UTF-8 bytes each.
  def self.cwd : String | Nil
    answer = cwd_into(4096_u64)
    return answer if answer.is_a?(String)
    cwd_into(98304_u64)
  end

  private def self.cwd_into(size : UInt64) : String | Nil
    buffer = Pointer(UInt8).malloc(size)
    length = __iyi_getcwd(buffer, size)
    return nil if length <= 0_i64
    String.new(length.to_i32) do |target|
      target.copy_from(buffer, length.to_i32)
    end
  end

  private def self.string_from(entry : UInt8*) : String
    length = 0
    while entry[length] != 0_u8
      length = length + 1
    end
    String.new(length) do |target|
      target.copy_from(entry, length)
    end
  end
end

lib LibIyiMain
  @[Raises]
  fun __iyi_main(argc : Int32, argv : UInt8**)
end

{% if flag?(:win32) %}
  # What Windows does with an unhandled fault, and what it should do.
  #
  # Left alone, a fault raises Windows Error Reporting: a dialog on a
  # desktop and a process that waits for somebody to click it in CI, and
  # then an exit code with no sentence anywhere. `SetErrorMode` with
  # SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX (0x1 | 0x2) turns the
  # dialog off, and the filter below is what replaces it: the two faults a
  # program of this runtime's shape actually takes, each named.
  #
  # A stack overflow is the reason the filter exists. On the POSIX targets
  # `IyiStackGuard` catches it on an alternate signal stack and prints
  # where it happened; Windows has no sigaltstack, and the guard page is
  # already spent by the time anything runs, so the handler needs room
  # reserved in advance. On a thread's own stack that is
  # `SetThreadStackGuarantee`, 16 KB, below; on a fiber's it is the
  # committed slack under the guard page `IyiFiber#map_stack` arms, the
  # same 16 KB for the same code. Both are what make printing from here
  # safe at all.
  #
  # The write is `WriteFile` on the standard error handle rather than
  # `print`: a fault may have landed inside the allocator, and the console
  # path above allocates.
  IYI_WIN_STACK_OVERFLOW = -1073741571 # 0xC00000FD, as the Int32 this file spells a DWORD with
  IYI_WIN_ACCESS_VIOLATION = -1073741819 # 0xC0000005
  IYI_WIN_GUARD_PAGE = -2147483647 # 0x80000001, STATUS_GUARD_PAGE_VIOLATION

  fun __iyi_win_fault(info : Void*) : Int32
    record = Pointer(UInt64).new(info.address).value
    code = Pointer(Int32).new(record).value
    handle = LibC.GetStdHandle(-12)
    written = uninitialized Int32
    if code == IYI_WIN_STACK_OVERFLOW
      message = "iyi: panic: stack overflow: the stack ran out, which is infinite or very deep recursion\n"
      LibC.WriteFile(handle, message.to_unsafe.as(Void*), message.bytesize, pointerof(written), nil)
      LibC.ExitProcess(1)
    end
    if code == IYI_WIN_GUARD_PAGE
      # A guard-page violation on a fiber stack, which is a fiber's stack
      # running out reported the other way. Measured, the ordinary case is
      # *not* this one: `switch_stack` writes the fiber's bounds into the
      # TEB's StackBase and StackLimit, so the kernel reads a fiber stack
      # as the thread's own and answers a hit on the PAGE_GUARD page
      # `IyiFiber#map_stack` armed with STATUS_STACK_OVERFLOW (0xC00000FD)
      # — the branch above. This branch is what answers the same page
      # touched while the TEB names another stack, where the alternative
      # is calling a stack overflow a memory fault. Either way Windows has
      # cleared the attribute by now, so the handler stands on that page
      # and the committed slack beneath it.
      #
      # A guard page is the kernel's own mechanism for other things too,
      # so the address is checked against the stacks the scheduler knows
      # rather than assumed, and anything else is left to whoever armed
      # it: EXCEPTION_CONTINUE_SEARCH, not a sentence of ours.
      faulting = Pointer(UInt64).new(record + 40_u64).value
      {% if flag?(:x86_64) %}
        if IyiScheduler.fiber_guard_hit?(faulting)
          overflow = "iyi: panic: stack overflow: the stack ran out, which is infinite or very deep recursion\n"
          LibC.WriteFile(handle, overflow.to_unsafe.as(Void*), overflow.bytesize, pointerof(written), nil)
          LibC.ExitProcess(1)
        end
      {% end %}
      return 0
    end
    if code == IYI_WIN_ACCESS_VIOLATION
      # An access violation is a wild pointer *or* a frame that stepped
      # over the fiber's guard page whole and landed in the uncommitted
      # page at the bottom of its reservation — one `sub rsp` past the
      # guard and the slack together. Windows raises STACK_OVERFLOW only
      # for a thread's own stack, so the runtime tells the two apart by
      # address. The faulting one is the second of the record's exception
      # parameters — code 0, flags 4, record 8, address 16, parameter
      # count 24, parameters from 32 — and the scheduler knows which page
      # belongs to which stack.
      faulting = Pointer(UInt64).new(record + 40_u64).value
      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
        if IyiScheduler.fiber_guard_hit?(faulting)
          overflow = "iyi: panic: stack overflow: the stack ran out, which is infinite or very deep recursion\n"
          LibC.WriteFile(handle, overflow.to_unsafe.as(Void*), overflow.bytesize, pointerof(written), nil)
          LibC.ExitProcess(1)
        end
      {% end %}
      message = "iyi: the program died of a memory fault. Outside `Pointer`, an iyi program cannot reach memory it does not own: if the program uses `Pointer`, that is the place to look. If it does not, it is a bug in iyi's own runtime, and ours to fix: https://github.com/iyilang/iyi/issues\n"
      LibC.WriteFile(handle, message.to_unsafe.as(Void*), message.bytesize, pointerof(written), nil)
      LibC.ExitProcess(1)
    end
    # EXCEPTION_CONTINUE_SEARCH: not one of ours, so whatever Windows would
    # have done with it, it still does.
    0
  end

  def __iyi_win_install_fault_handler : Nil
    LibC.SetErrorMode(3)
    guarantee = 16384_i32
    LibC.SetThreadStackGuarantee(pointerof(guarantee))
    # A proc's first word is its function, which is the address Windows
    # wants — the same way `IyiThread.address_of` hands a thread entry to
    # `CreateThread`. This one closes over nothing, so there is no second
    # word and it is callable from outside iyi.
    filter = ->__iyi_win_fault(Void*)
    address = Pointer(Void).new(Pointer(UInt64).new(pointerof(filter).address).value)
    # Both, and the vectored one is the one that works: a program whose
    # entry point is the CRT's `mainCRTStartup` runs inside
    # `__scrt_common_main_seh`, whose own `__except` takes a stack overflow
    # before the unhandled-exception filter is ever asked — measured, with
    # `SetUnhandledExceptionFilter` alone the process exited 0xC00000FD and
    # printed nothing. A vectored handler is asked first, before any
    # frame-based one. The filter answers only for the two codes it names,
    # so a C++ exception (0xE06D7363, which is how `rescue` travels on
    # msvc) passes straight through.
    LibC.AddVectoredExceptionHandler(1, address)
    LibC.SetUnhandledExceptionFilter(address)
    nil
  end
{% end %}

fun main(argc : Int32, argv : UInt8**) : Int32
  # There is nothing to start under the default allocator, and nothing missing
  # either: `gc/none.cr`'s `GC.init` sets up thread suspend and resume, and
  # 0.1.0 has one thread. Only Boehm has an `init` worth calling.
  {% if flag?(:gc_boehm) %}
    LibGC.init
  {% end %}
  {% if flag?(:win32) %}
    __iyi_win_install_fault_handler
  {% end %}
  LibIyiMain.__iyi_main(argc, argv)
  0
end

{% if flag?(:wasm32) %}
  # iyi: wasi-libc's `crt1-command.o` is what exports `_start`, and what it
  # calls is not `main`. Clang renames a C `main` to `__main_argc_argv` or
  # `__main_void` depending on its parameters, and the entry stub calls that
  # name; `main` itself is left as a weak undefined reference, so a module that
  # only defines `main` links without complaint and traps on `unreachable` the
  # moment the entry calls through it.
  #
  # Defining the name the entry actually calls is the whole fix. It is declared
  # here rather than emitted by codegen because the prelude is where this
  # platform's contract already lives, and because `main` above stays exactly as
  # it is for every other target.
  fun __main_argc_argv(argc : Int32, argv : UInt8**) : Int32
    LibIyiMain.__iyi_main(argc, argv)
    0
  end
{% end %}
