class Animal
  def name : String
    "animal"
  end
end

class Dog < Animal
  def name : String
    "dog"
  end
end

class Container(T)
  @item : T

  def initialize(@item : T)
  end

  def item : T
    @item
  end
end

class SubContainer(T) < Container(T)
end

class VarContainer(*T)
end

abstract class Shape
  abstract def area : Float64
end

struct Point
  def x : Int32
    0
  end
end

struct Pair(A, B)
  @left : A

  def initialize(@left : A)
  end

  def left : A
    @left
  end
end

abstract struct ValueObject
end

class Node
  @next_node : Node?

  def next_node : Node?
    @next_node
  end
end
