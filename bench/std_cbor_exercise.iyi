# Text a writer gets wrong: quotes, backslashes, every control JSON names
# and the ones it does not, DEL, two- three- and four-byte characters, the
# last scalar value, a byte order mark, a line separator.
TRICKY = ["", "a", "key", "\"", "\\", "\n", "\r", "\t", "\b", "\f", "\u0000", "\u0001", "\u001F", "\u007F",
          "é", "ü", "水", "😀", "𐅑", "\uFEFF", "\u2028", "\uFFFD", "\u{10FFFF}", "'", "/", " ", "_", "Z"]

EDGES = [0_u64, 1_u64, 23_u64, 24_u64, 255_u64, 256_u64, 65535_u64, 65536_u64, 4294967295_u64, 4294967296_u64,
         9223372036854775807_u64, 9223372036854775808_u64, 18446744073709551615_u64]

TAGS = [0_u64, 1_u64, 4_u64, 5_u64, 21_u64, 23_u64, 24_u64, 32_u64, 255_u64, 256_u64, 1000_u64, 55799_u64,
        65535_u64, 65536_u64, 4294967296_u64, 18446744073709551615_u64]

# A value of every kind the data model has, nested to `depth` 4 at most.
def generate(rng : Rng, depth : Int32) : Any
  k = depth >= 4 ? rng.below(10) : rng.below(15)
  if k == 0
    edge = EDGES[rng.below(EDGES.size)]
    edge = edge &+ rng.below(3).to_u64 if rng.chance(3) && edge < 18446744073709551613_u64
    v = Any.new(edge)
    rng.chance(2) ? v : Any.new(CBORBignum.new(true, v.as_big.magnitude))
  elsif k == 1
    v = rng.draw.unsafe_shr(rng.below(64))
    rng.chance(2) ? Any.new(v) : Any.new(CBORBignum.new(true, Any.new(v).as_big.magnitude))
  elsif k == 2
    size = 1 + rng.below(20)
    magnitude = Array(UInt8).new(size) { |i| i == 0 ? (1_u8 | rng.byte) : rng.byte }
    Any.new(CBORBignum.new(rng.chance(2), magnitude))
  elsif k == 3 || k == 4
    float(rng)
  elsif k == 5
    Any.new(Array(UInt8).new(rng.below(17)) { rng.byte })
  elsif k == 6
    text = String::Builder.new
    rng.below(5).times { text << TRICKY[rng.below(TRICKY.size)] }
    Any.new(text.to_s)
  elsif k == 7
    pick = rng.below(4)
    pick == 0 ? Any.new(true) : (pick == 1 ? Any.new(false) : (pick == 2 ? Any.new(nil) : Any.undefined))
  elsif k == 8
    s = rng.below(20 + 224)
    Any.new(CBORSimple.new(s < 20 ? s : s + 12))
  elsif k == 9
    Any.new(rng.below(1000) - 500)
  elsif k == 10 || k == 11
    Any.new(Array(Any).new(rng.below(6)) { generate(rng, depth + 1) })
  elsif k == 12 || k == 13
    h = Hash(Any, Any).new
    rng.below(5).times { h[generate(rng, depth + 1)] = generate(rng, depth + 1) }
    Any.new(h)
  else
    Any.new(CBORTag.new(TAGS[rng.below(TAGS.size)], generate(rng, depth + 1)))
  end
end

# A float from bits of each width, so that every width is the shortest for
# some: a half's, a single's, a double's, or one of the values at an edge.
def float(rng : Rng) : Any
  pick = rng.below(5)
  if pick == 0
    decoded([0xF9_u8, rng.byte, rng.byte], "a random half")
  elsif pick == 1
    decoded([0xFA_u8, rng.byte, rng.byte, rng.byte, rng.byte], "a random single")
  elsif pick == 2
    Any.new(f64(rng.draw))
  elsif pick == 3
    Any.new((rng.below(2000000) - 1000000).to_f64 / 64.0)
  else
    specials = [0x0_u64, 0x8000000000000000_u64, 0x7FF0000000000000_u64, 0xFFF0000000000000_u64, 0x7FF8000000000000_u64,
                0x7FF0000000000001_u64, 0x7FF4000000000000_u64, 0xFFF8000000000000_u64, 0x7FF8000020000000_u64,
                0x0000000000000001_u64, 0x3E70000000000000_u64, 0x3E60000000000000_u64, 0x36A0000000000000_u64,
                0x36A0000000000001_u64, 0x47EFFFFFE0000000_u64, 0x40EFFE0000000000_u64, 0x40EFFE1000000000_u64]
    Any.new(f64(specials[rng.below(specials.size)]))
  end
end

# The variant encoder: the same value written every other way the format
# allows - an argument longer than it needs, an indefinite length, chunked
# strings (text cut only between characters), a map's pairs in a random
# order, a float wider than it needs, an integer as a bignum with leading
# zeros - so the decoder reads what other encoders write and `CBOR.encode`
# brings each back to the one deterministic form.
def variant_head(sink : Array(UInt8), major : Int32, arg : UInt64, rng : Rng) : Nil
  least = arg < 24_u64 ? 0 : (arg < 256_u64 ? 1 : (arg < 65536_u64 ? 2 : (arg < 4294967296_u64 ? 3 : 4)))
  width = least
  width = least + rng.below(5 - least) if rng.chance(4)
  if width == 0
    sink << ((major << 5) | arg.to_i32).to_u8
    return
  end
  size = 1 << (width - 1)
  sink << ((major << 5) | (23 + width)).to_u8
  shift = (size - 1) * 8
  while shift >= 0
    sink << (arg.unsafe_shr(shift) & 0xFF_u64).to_u8
    shift = shift - 8
  end
end

def variant_string(sink : Array(UInt8), major : Int32, bytes : Array(UInt8), rng : Rng) : Nil
  unless rng.chance(3)
    variant_head(sink, major, bytes.size.to_u64, rng)
    sink.concat(bytes)
    return
  end
  sink << ((major << 5) | 31).to_u8
  at = 0
  while at < bytes.size || rng.chance(4)
    cut = at + rng.below(bytes.size - at + 1)
    if major == 3
      while cut < bytes.size && (bytes[cut] & 0xC0_u8) == 0x80_u8
        cut = cut + 1
      end
    end
    variant_head(sink, major, (cut - at).to_u64, rng)
    sink.concat(bytes[at, cut - at])
    at = cut
    break if at >= bytes.size && !rng.chance(4)
  end
  sink << 0xFF_u8
end

def variant(sink : Array(UInt8), v : Any, rng : Rng) : Nil
  r = v.raw
  if r.is_a?(Array(Any))
    if rng.chance(3)
      sink << 0x9F_u8
      r.each { |item| variant(sink, item, rng) }
      sink << 0xFF_u8
    else
      variant_head(sink, 4, r.size.to_u64, rng)
      r.each { |item| variant(sink, item, rng) }
    end
  elsif r.is_a?(Hash(Any, Any))
    pairs = r.to_a
    i = pairs.size - 1
    while i > 0
      j = rng.below(i + 1)
      swap = pairs[i]
      pairs[i] = pairs[j]
      pairs[j] = swap
      i = i - 1
    end
    indefinite = rng.chance(3)
    indefinite ? (sink << 0xBF_u8) : variant_head(sink, 5, pairs.size.to_u64, rng)
    pairs.each do |pair|
      variant(sink, pair[0], rng)
      variant(sink, pair[1], rng)
    end
    sink << 0xFF_u8 if indefinite
  elsif r.is_a?(String)
    variant_string(sink, 3, text_bytes(r), rng)
  elsif r.is_a?(Array(UInt8))
    variant_string(sink, 2, r, rng)
  elsif r.is_a?(CBORTag)
    variant_head(sink, 6, r.number, rng)
    variant(sink, r.value, rng)
  elsif r.is_a?(Int64) || r.is_a?(CBORBignum)
    big = v.as_big
    n = big.magnitude_u64?
    if n.nil? || rng.chance(6)
      variant_head(sink, 6, big.negative? ? 3_u64 : 2_u64, rng)
      padded = Array(UInt8).new(rng.below(3), 0_u8) + big.magnitude
      variant_string(sink, 2, padded, rng)
    else
      variant_head(sink, big.negative? ? 1 : 0, n, rng)
    end
  elsif r.is_a?(Float64) && rng.chance(2)
    sink << 0xFB_u8
    bits = IyiFloatText.bits_of(r)
    shift = 56
    while shift >= 0
      sink << (bits.unsafe_shr(shift) & 0xFF_u64).to_u8
      shift = shift - 8
    end
  else
    sink.concat(CBOR.encode(v))
  end
end

# Derived types. `Inner` and `Record` derive std/json's, std/yaml's and
# std/toml's too, which is how a type that is all four spells it, and
# what lets Python compare the CBOR with the JSON of the same value.
struct Inner
  getter x : Int32
  getter label : String?

  def initialize(@x : Int32, @label : String?)
  end

  derive serializable, yaml_serializable, toml_serializable, cbor_serializable
end

struct Record
  getter name : String
  getter blob : Array(UInt8)
  getter tags : Array(String)
  getter weights : Hash(String, Float64)
  getter count : Int64
  getter small : UInt8
  getter big : UInt64
  getter ratio : Float64
  getter flag : Bool
  getter note : String?
  getter inner : Inner
  getter inners : Array(Inner)
  getter maybe : Inner?
  getter matrix : Array(Array(Int32))

  def initialize(@name : String, @blob : Array(UInt8), @tags : Array(String), @weights : Hash(String, Float64), @count : Int64, @small : UInt8, @big : UInt64, @ratio : Float64, @flag : Bool, @note : String?, @inner : Inner, @inners : Array(Inner), @maybe : Inner?, @matrix : Array(Array(Int32)))
  end

  derive serializable, yaml_serializable, toml_serializable, cbor_serializable
end

# What only CBOR holds of these: a UInt64 past Int64, integer keys, any
# item as a key, an `Any`.
struct Wide
  getter top : UInt64
  getter by_id : Hash(Int32, String)
  getter keyed : Hash(Any, Int64)
  getter extra : Any

  def initialize(@top : UInt64, @by_id : Hash(Int32, String), @keyed : Hash(Any, Int64), @extra : Any)
  end

  derive cbor_serializable
end

struct Spot
  getter x : Float64
  getter name : String
  getter note : String?

  derive cbor_serializable
end

struct Listener
  @port : Int32 = 8080
  @host : String? = "localhost"
  getter port
  getter host
  getter name : String

  derive cbor_serializable
end

puts "== RFC 8949 appendix A, decoded to its notation"
APPENDIX_A.each do |example|
  puts "RFC #{example[1]}\t#{example[0]}"
end
APPENDIX_A.each do |example|
  v = decoded(unhex(example[1]), "appendix A decodes #{example[1]}")
  assert_str(example[0], v.to_s, "appendix A decodes #{example[1]} to #{example[0]}")
  want = example[2].empty?
  assert_true(CBOR.deterministic?(unhex(example[1])) == want, "appendix A: #{example[1]} is #{want ? "" : "not "}deterministic")
end
puts "  #{APPENDIX_A.size} examples, each read to the notation the RFC prints beside it"

puts "== RFC 8949 appendix A, encoded"
APPENDIX_A.each do |example|
  v = decoded(unhex(example[1]), "appendix A decodes #{example[1]}")
  want = example[2].empty? ? example[1] : example[2]
  assert_str(want, hex(CBOR.encode(v)), "appendix A encodes #{example[0]}")
  assert_true(decoded(CBOR.encode(v), "appendix A's encoding decodes") == v, "appendix A's #{example[0]} reads back equal")
end
