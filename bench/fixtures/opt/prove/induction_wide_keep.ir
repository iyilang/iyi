; iyi-ir 1
source_filename = "induction_wide_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @induction_wide_keep(i32 %n, ptr %negative_out) {
entry:
  br label %head
head:
  %i = phi i32 [ 0, label %entry ], [ %next, label %body ]
  %more = icmp slt i32 %i, %n
  br i1 %more, label %body, label %done
body:
  %negative = icmp slt i32 %i, 0
  store i1 %negative, ptr %negative_out, align 1
  %next = add i32 %i, 2
  br label %head
done:
  ret void
}
