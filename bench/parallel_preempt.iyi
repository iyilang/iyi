# Preemption at loop back-edges, exercised: SPEC.md III.4.13, part 9.
#
#   ./bin/iyi run bench/parallel_preempt.iyi -- slice --workers=1
#   ./bin/iyi run bench/parallel_preempt.iyi -- server --workers=8
#
# A parallel task computing in a loop with no call in it held its worker
# until it ended: a task queued behind it waited for the whole computation,
# and so did whatever waited in that worker's poller and sleep heap - the
# connection whose request had arrived, the sleeper whose time had come.
# Every loop of a program with a pool now checks the worker's preemption
# word at its back-edge, and the pool's monitor raises the word of a worker
# one task has held for a quantum, 5 to 10 ms.
#
#   slice   a walk and a vectorised sum each hold their worker until a
#           short task is queued and the preemption word is raised. The
#           short task must run on that worker before the computation ends.
#           `-Dpreempt_off` runs the walk without checks and fails that order.
#   unit    a preempted task keeps its unit's token: a task `spawn` started
#           inside it never runs between two of its statements that are not
#           a park, while another parallel task's ticker, asleep on the
#           same worker, wakes within 100 ms of its time.
#   server  a dedicated fast request completes while a slow handler stays
#           active, followed by bulk fast and slow latency measurements.
#   poller  a fast connection waits in the one worker's poller while a
#           slow handler computes until it is answered. The healthy path
#           also holds the 80 ms latency bound; the copy-only proof records
#           whether preemption entered the worker's nonblocking poll.
#   fresh   a task holds the worker until the monitor raises its word,
#           then its queued successor runs on the same worker. Copy-only
#           hooks hold the monitor and check that the switch lowers the word.
#   period  the monitor's period, its looks over a task computing half a
#           second on a pool of one, held to 4 to 10.5 ms (8 on Windows);
#           and the quantum, two such tasks taking turns on the one worker,
#           held to three of the looks the same run measured. A Windows
#           monitor waiting on the system timer's tick (10.1 to 14.3 ms
#           apart in 56 runs on GitHub's runners) fails the first, and a
#           monitor that waits three looks unchanged rather than one the
#           second.
#   tight   each loop and its @[NoPreempt] twin run once, with matching
#           answers; their timings and ratios are performance information.
#
# With no arguments it runs slice, unit and period on a pool of one and
# prints only that every property held: the slice step's short task must
# wait for a preemption, which a second, idle worker would make needless.
#
# bench/parallel_exercise.sh runs it, and broken copies of the runtime,
# each caught by the step that names it.

@[Unsafe("the loops read arrays through unsafe_fetch, each index kept in 0...size by the loop that makes it")]
module bench/parallel_preempt

import std/int
import std/indexable
import std/socket::{IyiSocket, SocketError}

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  def elapsed_ms(since : Int64) : Int64
    (__iyi_monotonic_ns - since) // 1000000_i64
  end

  # A step's measurements, printed when steps were asked for by name: a run
  # with no arguments says only that every property held.
  def say(line : String) : Nil
    puts line unless Program.args.empty?
  end

  # Integer work with nothing to allocate and no call in its loop: a
  # xorshift walk. It and the tight step's other loops, and their twins, are
  # `@[NoInline]`: bench/parallel_exercise.sh reads the checks of each in
  # the release build's IR by the def's name, which inlined into the step's
  # block it would not have.
  @[NoInline]
  def spin(rounds : Int64, seed : UInt64) : UInt64
    x = seed | 1_u64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      i = i + 1
    end
    x
  end

  # The same walk, never preempted.
  @[NoInline]
  @[NoPreempt]
  def spin_np(rounds : Int64, seed : UInt64) : UInt64
    x = seed | 1_u64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      i = i + 1
    end
    x
  end

  # The walk the slice step's long task takes: preempted, or under
  # `-Dpreempt_off` not.
  def long_walk(rounds : Int64, seed : UInt64) : UInt64
    {% if flag?(:preempt_off) %}
      spin_np(rounds, seed)
    {% else %}
      spin(rounds, seed)
    {% end %}
  end

  # A sum LLVM vectorises, and its twin.
  @[NoInline]
  def sum(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    t = 0
    while t < times
      i = 0
      size = values.size
      while i < size
        total = total &+ values.unsafe_fetch(i)
        i = i + 1
      end
      t = t + 1
    end
    total
  end

  @[NoInline]
  @[NoPreempt]
  def sum_np(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    t = 0
    while t < times
      i = 0
      size = values.size
      while i < size
        total = total &+ values.unsafe_fetch(i)
        i = i + 1
      end
      t = t + 1
    end
    total
  end

  # The same sum through `times` and `each`, whose loops are the prelude's
  # and check because they are inlined into this def.
  @[NoInline]
  def sum_each(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    times.times do
      values.each { |v| total = total &+ v }
    end
    total
  end

  @[NoInline]
  @[NoPreempt]
  def sum_each_np(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    times.times do
      values.each { |v| total = total &+ v }
    end
    total
  end

  # A table-driven CRC-32, a loop of dependent loads.
  @[NoInline]
  def crc(table : Array(UInt32), data : Array(UInt8), times : Int32) : UInt32
    c = 0xFFFFFFFF_u32
    t = 0
    while t < times
      i = 0
      size = data.size
      while i < size
        c = table.unsafe_fetch(((c ^ data.unsafe_fetch(i).to_u32) & 0xFF_u32).to_i32) ^ c.unsafe_shr(8_u32)
        i = i + 1
      end
      t = t + 1
    end
    c ^ 0xFFFFFFFF_u32
  end

  @[NoInline]
  @[NoPreempt]
  def crc_np(table : Array(UInt32), data : Array(UInt8), times : Int32) : UInt32
    c = 0xFFFFFFFF_u32
    t = 0
    while t < times
      i = 0
      size = data.size
      while i < size
        c = table.unsafe_fetch(((c ^ data.unsafe_fetch(i).to_u32) & 0xFF_u32).to_i32) ^ c.unsafe_shr(8_u32)
        i = i + 1
      end
      t = t + 1
    end
    c ^ 0xFFFFFFFF_u32
  end

  def crc_table : Array(UInt32)
    table = Array(UInt32).new(256, 0_u32)
    n = 0
    while n < 256
      c = n.to_u32
      k = 0
      while k < 8
        c = (c & 1_u32) != 0_u32 ? (0xEDB88320_u32 ^ c.unsafe_shr(1_u32)) : c.unsafe_shr(1_u32)
        k = k + 1
      end
      table[n] = c
      n = n + 1
    end
    table
  end

  # Walk rounds a millisecond on this machine, on the main thread.
  def calibrate : Int64
    t = __iyi_monotonic_ns
    x = spin_np(50_000_000_i64, 3_u64)
    ms = elapsed_ms(t)
    ms = ms + 1_i64 if x == 0_u64
    50_000_000_i64 // (ms > 0_i64 ? ms : 1_i64)
  end

  # Latencies the tasks record: `Share` by their atomic fields.
  class Stat
    @max : Atomic(Int64)
    @count : Atomic(Int64)
    @over20 : Atomic(Int64)

    def initialize
      @max = Atomic(Int64).new(0_i64)
      @count = Atomic(Int64).new(0_i64)
      @over20 = Atomic(Int64).new(0_i64)
    end

    def add(us : Int64) : Nil
      @count.add(1_i64)
      @over20.add(1_i64) if us > 20000_i64
      while true
        m = @max.get
        break if us <= m
        break if @max.compare_and_set(m, us)[1]
      end
    end

    def max_ms : Int64
      @max.get // 1000_i64
    end

    def count : Int64
      @count.get
    end

    def over20 : Int64
      @over20.get
    end
  end

  # ── slice ────────────────────────────────────────────────────────────
  # The long task holds its worker until the short task is queued and the
  # monitor's word is up. The short task records where it ran, not a time.
  # The bound is retained for the separate ticker check in unit.
  BOUND_MS = 100_i64

  class SliceState
    @holding : Atomic(Int64)
    @queued : Atomic(Int64)
    @phase : Atomic(Int64)
    @worker : Atomic(UInt64)
    @witness : Atomic(Int64)

    def initialize
      @holding = Atomic(Int64).new(0_i64)
      @queued = Atomic(Int64).new(0_i64)
      @phase = Atomic(Int64).new(0_i64)
      @worker = Atomic(UInt64).new(0_u64)
      @witness = Atomic(Int64).new(0_i64)
    end

    def holding(worker : UInt64) : Nil
      @worker.set(worker)
      @holding.set(1_i64)
    end

    def holding? : Bool
      @holding.get != 0_i64
    end

    def queue : Nil
      @queued.set(1_i64)
    end

    def queued? : Bool
      @queued.get != 0_i64
    end

    def start : Nil
      @phase.set(1_i64)
    end

    def finish : Nil
      @phase.set(2_i64)
    end

    def finished? : Bool
      @phase.get == 2_i64
    end

    @[NoInline]
    @[NoPreempt]
    def record_short : Nil
      phase = @phase.get
      result = if IyiScheduler.state.object_id != @worker.get
                 4_i64
               elsif phase == 1_i64
                 1_i64
               elsif phase == 2_i64
                 2_i64
               else
                 3_i64
               end
      @witness.set(result)
    end

    def witness : Int64
      @witness.get
    end
  end

  def slice_hang(what : String) : Nil
    puts "FAIL: slice: progress hang: #{what}"
    __iyi_exit(76)
  end

  @[NoInline]
  @[NoPreempt]
  def slice_hold(proof : SliceState, force_flag : Bool) : Nil
    st = IyiScheduler.state
    address = st.preempt_word
    fail("slice: not armed: the worker has no preemption word") if address == 0_u64
    word = Pointer(Atomic(UInt64)).new(address)
    {% if flag?(:noflag_force) %}
      if force_flag
        IyiWorkers.force_flag_arm(st.object_id)
      end
    {% end %}
    proof.holding(st.object_id)
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    {% if flag?(:noflag_force) %}
      if force_flag
        while IyiWorkers.force_flag_seen == 0_u64
          IyiThread.spin_pause
          slice_hang("the monitor did not decide for the held worker in 20000 ms") if __iyi_monotonic_ns > limit
        end
        seen = IyiWorkers.force_flag_seen
        fail("slice: the monitor's preemption decision for a held worker left its word down") if seen == 1_u64
        fail("slice: not armed: the monitor recorded an invalid word decision #{seen}") unless seen == 2_u64
        # Printing here can yield before proof.start marks the computation.
      end
    {% end %}
    while !proof.queued? || word.value.get == 0_u64
      IyiThread.spin_pause
      slice_hang("the queued task and raised word did not reach the held worker in 20000 ms") if __iyi_monotonic_ns > limit
    end
    proof.start
  end

  def slice_round(which : String, per_ms : Int64) : Nil
    proof = SliceState.new
    waited = Atomic(Int64).new(-1_i64)
    answer = Atomic(UInt64).new(0_u64)
    walk = 1000_i64 * (per_ms > 0_i64 ? per_ms : 1_i64)
    preempts = IyiWorkers.preempts
    group do |g|
      g.spawn(unit: :new) do
        if which == "walk"
          slice_hold(proof, true)
          answer.set(long_walk(walk, 5_u64))
        else
          values = Array(Int64).new(1_000_000) { |i| i.to_i64 * 3_i64 }
          t = __iyi_monotonic_ns
          once = sum_np(values, 10) // 10_i64
          pass_ns = (__iyi_monotonic_ns - t) // 10_i64
          times = (1_000_000_000_i64 // (pass_ns > 0_i64 ? pass_ns : 1_i64)).to_i32
          times = 1 if times < 1
          times = 20000 if times > 20000
          slice_hold(proof, false)
          answer.set((sum(values, times) &- once &* times.to_i64).to_u64)
        end
        proof.finish
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !proof.holding?
        sleep(1)
        slice_hang("the #{which} task did not enter its hold in 10000 ms") if __iyi_monotonic_ns > limit
      end
      asked = __iyi_monotonic_ns
      g.spawn(unit: :new) do
        proof.record_short
        waited.set(elapsed_ms(asked))
        0
      end
      proof.queue
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !proof.finished? || proof.witness == 0_i64
        sleep(1)
        slice_hang("the #{which} and short task did not finish in 10000 ms") if __iyi_monotonic_ns > limit
      end
    end
    witness = proof.witness
    fail("slice: the short task queued before the walk ran only after the walk ended") if witness == 2_i64
    fail("slice: not armed: the short task's #{which} witness was #{witness}, not the same worker during the walk") unless witness == 1_i64
    want = which == "walk" ? spin_np(walk, 5_u64) : 0_u64
    if answer.get != want
      fail("slice: the preempted #{which} answered #{answer.get}, and unpreempted it answers #{want}")
    end
    given = IyiWorkers.preempts - preempts
    fail("slice: the short task started and no task was preempted") if given == 0_u64
    {% if flag?(:noflag_force) %}
      puts "slice: the monitor's preemption decision for a held worker raised its word" if which == "walk"
    {% end %}
    say "slice: the short task queued before the #{which} ran inside it on the same worker"
    say "slice: the short task waited #{waited.get} ms behind #{which} (#{given} preemptions); the #{which}'s answer is the unpreempted one"
  end

  def slice(per_ms : Int64) : Nil
    slice_round("walk", per_ms)
    slice_round("sum", per_ms)
  end

  # ── unit ─────────────────────────────────────────────────────────────
  # Force a same-unit child to be the next candidate at a preemption
  # decision. The switch counter also advances when that child is deferred.
  def unit_hang(what : String) : Nil
    puts "FAIL: unit: progress hang: #{what}"
    __iyi_exit(76)
  end

  def unit_forced(per_ms : Int64) : Nil
    computing = Atomic(Int64).new(0_i64)
    ran_inside = Atomic(Int64).new(0_i64)
    ran = Atomic(Int64).new(0_i64)
    finished = Atomic(Int64).new(0_i64)
    group do |g|
      g.spawn(unit: :new) do
        group do |inner|
          inner.spawn(unit: :same) do
            ran_inside.set(computing.get)
            ran.set(1_i64)
            0
          end
          fail("unit: not armed: the same-unit child ran before the computation started") if ran.get != 0_i64
          st = IyiScheduler.state
          before = st.switches
          computing.set(1_i64)
          x = 7_u64
          limit = __iyi_monotonic_ns + 20_000_000_000_i64
          while st.switches == before
            x = spin(per_ms // 10_i64, x)
            unit_hang("the computing task reached no preemption check in 20000 ms") if __iyi_monotonic_ns > limit
          end
          computing.set(0_i64)
          finished.set(1_i64)
          x
        end
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while finished.get == 0_i64 || ran.get == 0_i64
        sleep(1)
        unit_hang("the computing task and same-unit child did not finish in 10000 ms") if __iyi_monotonic_ns > limit
      end
    end
    fail("unit: a task of the same unit ran inside the preempted task") if ran_inside.get == 1_i64
    fail("unit: not armed: the same-unit child never ran") if ran.get != 1_i64
    say "unit: the task of the same unit ran only after the computing task's preemption check"
  end

  # A parallel task computes 300 ms on a pool of one while a task it
  # spawned sleeps 1 ms and counts, and another parallel task's ticker
  # sleeps 1 ms and measures how late it woke. The ticker is what the
  # computing task is preempted for; its child, of the same unit, must not
  # run until the computation ends, and the count it moves is read on both
  # sides of the computation.
  def unit(per_ms : Int64) : Nil
    unit_forced(per_ms)
    late = Stat.new
    moved = Atomic(Int64).new(-1_i64)
    done = Atomic(Int64).new(0_i64)
    preempts = IyiWorkers.preempts
    group do |g|
      g.spawn(unit: :new) do
        count = Atomic(Int64).new(0_i64)
        group do |inner|
          inner.spawn do
            while done.get == 0_i64
              sleep(1)
              count.add(1_i64)
            end
            0
          end
          sleep(5)
          before = count.get
          # The walk's answer is kept, or an optimised build drops the
          # walk: it has no effect but its answer.
          walked = spin(300_i64 * per_ms, 7_u64)
          moved.set(count.get - before + (walked == 0_u64 ? 1_i64 : 0_i64))
          done.set(1_i64)
        end
        0
      end
      g.spawn(unit: :new) do
        while done.get == 0_i64
          s = __iyi_monotonic_ns
          sleep(1)
          late.add((__iyi_monotonic_ns - s) // 1000_i64 - 1000_i64)
        end
        0
      end
    end
    given = IyiWorkers.preempts - preempts
    fail("unit: the computing task was never preempted for the ticker beside it") if given == 0_u64
    if moved.get != 0_i64
      puts "unit: the child ran #{moved.get} times during the preempted task"
      fail("unit: a task of the same unit ran inside the preempted task")
    end
    if late.max_ms > BOUND_MS
      fail("unit: a ticker asleep on the worker of a computing task woke #{late.max_ms} ms late, past #{BOUND_MS} ms")
    end
    say "unit: a task preempted #{given} times kept its unit's token, and its child ran only after it; the ticker beside it woke at most #{late.max_ms} ms late over #{late.count} sleeps"
  end

  # ── server ───────────────────────────────────────────────────────────
  FAST_BOUND_MS = 80_i64
  # A dedicated pair establishes that one fast request is served while a
  # slow handler is active. Bulk timings below are measurements.

  class ServerRelease
    @value : Atomic(Int64)
    @active : Atomic(Int64)

    def initialize
      @value = Atomic(Int64).new(0_i64)
      @active = Atomic(Int64).new(0_i64)
    end

    def open : Nil
      @value.set(1_i64)
    end

    def open? : Bool
      @value.get != 0_i64
    end

    def start : Nil
      @active.set(1_i64)
    end

    def active? : Bool
      @active.get != 0_i64
    end
  end

  @[NoInline]
  def server_hold(release : ServerRelease) : Nil
    release.start
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    while !release.open?
      IyiThread.spin_pause
      fail("server: progress hang: the slow handler was not released in 20000 ms") if __iyi_monotonic_ns > limit
    end
  end

  def server_pair : Nil
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    slow_client = IyiSocket.connect("127.0.0.1", port, 5000)
    fail("server: slow connect answered #{slow_client}") unless slow_client.is_a?(IyiSocket)
    slow_server = listener.accept
    fail("server: slow accept answered #{slow_server}") unless slow_server.is_a?(IyiSocket)
    fast_client = IyiSocket.connect("127.0.0.1", port, 5000)
    fail("server: fast connect answered #{fast_client}") unless fast_client.is_a?(IyiSocket)
    fast_server = listener.accept
    fail("server: fast accept answered #{fast_server}") unless fast_server.is_a?(IyiSocket)
    slow_fd = slow_server.fd
    slow_family = slow_server.family
    fast_fd = fast_server.fd
    fast_family = fast_server.family
    release = ServerRelease.new
    served = Atomic(Int64).new(0_i64)
    group do |g|
      g.spawn(unit: :new) do
        socket = IyiSocket.new(slow_fd, slow_family)
        got = socket.read(1)
        fail("server: slow request answered #{got.inspect}") unless got == "b"
        server_hold(release)
        0
      end
      g.spawn(unit: :new) do
        socket = IyiSocket.new(fast_fd, fast_family)
        got = socket.read(1)
        fail("server: fast request answered #{got.inspect}") unless got == "c"
        fail("server: not armed: slow handler was not active") unless release.active? && !release.open?
        wrote = socket.write("k")
        fail("server: fast response answered #{wrote.inspect}") unless wrote.is_a?(Int32)
        served.set(1_i64)
        0
      end
      wrote = slow_client.write("b")
      fail("server: slow send answered #{wrote.inspect}") unless wrote.is_a?(Int32)
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !release.active?
        sleep(1)
        fail("server: progress hang: slow handler did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      wrote = fast_client.write("c")
      fail("server: fast send answered #{wrote.inspect}") unless wrote.is_a?(Int32)
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while served.get == 0_i64
        sleep(1)
        fail("server: progress hang: the fast request was not served in 10000 ms") if __iyi_monotonic_ns > limit
      end
      release.open
    end
    slow_client.close
    slow_server.close
    fast_client.close
    fast_server.close
    listener.close
    say "server: a fast request was served while the slow handler remained active"
  end

  def server(per_ms : Int64) : Nil
    server_pair
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    conns = 32
    fast = Stat.new
    slow = Stat.new
    group do |g|
      g.spawn do
        conns.times do
          client = listener.accept
          fail("server: accept answered #{client}") unless client.is_a?(IyiSocket)
          fd = client.fd
          family = client.family
          g.spawn(unit: :new) do
            socket = IyiSocket.new(fd, family)
            while true
              got = socket.read(64)
              break unless got.is_a?(String) && !got.empty?
              cost = got.starts_with?("b") ? 100_i64 * per_ms : per_ms // 5_i64
              x = spin(cost, 5_u64)
              socket.write(x == 0_u64 ? "K" : "k")
            end
            socket.close
            0
          end
        end
        0
      end
      clients = [] of IyiSocket
      conns.times do
        c = IyiSocket.connect("127.0.0.1", port, 5000)
        fail("server: connect answered #{c}") unless c.is_a?(IyiSocket)
        clients << c
      end
      group do |cg|
        conns.times do |i|
          c = clients[i]
          cg.spawn do
            heavy = i < 4
            rounds = heavy ? 10 : 400
            rounds.times do
              s = __iyi_monotonic_ns
              c.write(heavy ? "b" : "c")
              c.read(8)
              us = (__iyi_monotonic_ns - s) // 1000_i64
              if heavy
                slow.add(us)
              else
                fast.add(us)
              end
              sleep(1) unless heavy
            end
            0
          end
        end
      end
      clients.each(&.close)
    end
    say "server: 28 connections of 0.2 ms requests beside 4 of 100 ms on #{IyiWorkers.count} workers: the slowest fast request took #{fast.max_ms} ms, #{fast.over20} of #{fast.count} over 20 ms; the slow ones at most #{slow.max_ms} ms"
  end

  # ── poller ───────────────────────────────────────────────────────────
  # The fast handler parks on its second read before the slow handler's
  # worker is armed. In the forced copy, the slow half records whether its
  # next decision actually enters the nonblocking poll, before main sends
  # the fast request. The hold ends on the answer, not on a latency bound.
  def poller_fiber_in_state?(id : UInt64, state : IyiFiberState) : Bool
    fiber = IyiScheduler.first_fiber
    while fiber.is_a?(IyiFiber)
      return fiber.state == state if fiber.object_id == id
      fiber = fiber.next_fiber
    end
    false
  end

  def poller_hang(message : String) : NoReturn
    puts "FAIL: poller: progress hang: #{message}"
    __iyi_exit(76)
  end

  def poller(per_ms : Int64) : Nil
    fail("poller: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    computing = Atomic(Int64).new(0_i64)
    answered = Atomic(Int64).new(0_i64)
    reader = Atomic(UInt64).new(0_u64)
    worker = Atomic(UInt64).new(0_u64)
    took_us = 0_i64
    group do |g|
      g.spawn do
        2.times do
          client = listener.accept
          fail("poller: accept answered #{client}") unless client.is_a?(IyiSocket)
          fd = client.fd
          family = client.family
          g.spawn(unit: :new) do
            socket = IyiSocket.new(fd, family)
            while true
              got = socket.read(64)
              break unless got.is_a?(String) && !got.empty?
              x = spin(per_ms // 5_i64, 5_u64)
              if got.starts_with?("b")
                worker.set(IyiScheduler.state.object_id)
                computing.set(1_i64)
                limit = __iyi_monotonic_ns + 20_000_000_000_i64
                while answered.get == 0_i64
                  poller_hang("the fast request was not answered in 20000 ms") if __iyi_monotonic_ns > limit
                  x = spin(per_ms, x)
                end
              end
              socket.write(x == 0_u64 ? "K" : "k")
              reader.set(IyiScheduler.current.object_id) unless got.starts_with?("b")
            end
            socket.close
            0
          end
        end
        0
      end
      slow = IyiSocket.connect("127.0.0.1", port, 5000)
      fail("poller: connect answered #{slow}") unless slow.is_a?(IyiSocket)
      fast = IyiSocket.connect("127.0.0.1", port, 5000)
      fail("poller: connect answered #{fast}") unless fast.is_a?(IyiSocket)
      fast.write("c")
      fast.read(8)
      slow.write("b")
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while computing.get == 0_i64 || reader.get == 0_u64 || !poller_fiber_in_state?(reader.get, IyiFiberState::WaitingIo)
        poller_hang("the fast reader did not park while the slow handler computed in 10000 ms") if __iyi_monotonic_ns > limit
        sleep(1)
      end
      {% if flag?(:nopoll_force) %}
        IyiWorkers.force_poll_arm(worker.get)
        limit = __iyi_monotonic_ns + 10_000_000_000_i64
        while IyiWorkers.force_poll_result == 0_u64
          poller_hang("the armed worker made no poll decision in 10000 ms") if __iyi_monotonic_ns > limit
          sleep(1)
        end
        result = IyiWorkers.force_poll_result
        fail("poller: a preemption with a read waiting did not poll its worker's poller") if result == 2_u64
        fail("poller: not armed: the poll decision recorded #{result}") unless result == 1_u64
        puts "poller: a preemption with a read waiting polled its worker's poller"
      {% end %}
      s = __iyi_monotonic_ns
      fast.write("c")
      fast.read(8)
      took_us = (__iyi_monotonic_ns - s) // 1000_i64
      answered.set(1_i64)
      slow.read(8)
      slow.close
      fast.close
    end
    {% unless flag?(:nopoll_force) %}
      if took_us // 1000_i64 > FAST_BOUND_MS
        puts "poller: the fast request took #{took_us // 1000_i64} ms, past #{FAST_BOUND_MS} ms"
        fail("poller: the fast request exceeded the wait bound")
      end
    {% end %}
    say "poller: a fast request whose connection waited in the poller of the one worker, busy computing, was answered in #{took_us} us"
  end

  # ── fresh ────────────────────────────────────────────────────────────
  # Hold the first task until its worker's word is raised and its successor
  # is queued. The copy-only monitor gate holds a whole look at its entry,
  # so an older look cannot raise the word after the switch lowers it.
  # Both the normal and forced runs rendezvous on state, not elapsed work.
  class FreshState
    @started : Atomic(Int64)
    @queued : Atomic(Int64)
    @finished : Atomic(Int64)
    @successor : Atomic(Int64)
    @owner : Atomic(UInt64)

    def initialize
      @started = Atomic(Int64).new(0_i64)
      @queued = Atomic(Int64).new(0_i64)
      @finished = Atomic(Int64).new(0_i64)
      @successor = Atomic(Int64).new(0_i64)
      @owner = Atomic(UInt64).new(0_u64)
    end

    def start(id : UInt64) : Nil
      @owner.set(id)
      @started.set(1_i64)
    end

    def started? : Bool
      @started.get != 0_i64
    end

    def queue : Nil
      @queued.set(1_i64)
    end

    def queued? : Bool
      @queued.get != 0_i64
    end

    def finish : Nil
      @finished.set(1_i64)
    end

    def finished? : Bool
      @finished.get != 0_i64
    end

    def owner : UInt64
      @owner.get
    end

    def start_successor : Nil
      @successor.set(1_i64)
    end

    def successor_started? : Bool
      @successor.get != 0_i64
    end
  end

  def fresh_hang(message : String) : NoReturn
    puts "FAIL: fresh: progress hang: #{message}"
    __iyi_exit(76)
  end

  @[NoInline]
  @[NoPreempt]
  def fresh_hold(shared : FreshState) : Nil
    st = IyiScheduler.state
    word = Pointer(Atomic(UInt64)).new(st.preempt_word)
    shared.start(st.object_id)
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    while !shared.queued? || word.value.get == 0_u64
      fresh_hang("the successor was not queued or the worker's word was not raised in 20000 ms") if __iyi_monotonic_ns > limit
      IyiThread.spin_pause
    end
    {% if flag?(:stale_force) %}
      IyiWorkers.force_stale_arm(st.object_id)
      IyiWorkers.force_stale_close_gate
      while IyiWorkers.force_stale_gate_state != 2_u64
        fresh_hang("the monitor released its gate before the switch") if IyiWorkers.force_stale_gate_state == 4_u64
        fresh_hang("the monitor did not enter its gate in 20000 ms") if __iyi_monotonic_ns > limit
        IyiThread.spin_pause
      end
    {% end %}
    shared.finish
  end

  def fresh(per_ms : Int64) : Nil
    fail("fresh: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    shared = FreshState.new
    group do |g|
      g.spawn(unit: :new) do
        fresh_hold(shared)
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !shared.started?
        fresh_hang("the first task did not start in 10000 ms") if __iyi_monotonic_ns > limit
        sleep(1)
      end
      g.spawn(unit: :new) do
        fail("fresh: not armed: the successor ran before the first task held a raised word") unless shared.finished?
        fail("fresh: not armed: the successor ran on a different worker") unless IyiScheduler.state.object_id == shared.owner
        shared.start_successor
        spin(per_ms, 19_u64)
      end
      shared.queue
      {% if flag?(:stale_force) %}
        limit = __iyi_monotonic_ns + 10_000_000_000_i64
        while IyiWorkers.force_stale_word == 0_u64
          fresh_hang("the monitor released its gate before the switch") if IyiWorkers.force_stale_gate_state == 4_u64
          fresh_hang("the armed switch did not record its word in 10000 ms") if __iyi_monotonic_ns > limit
          sleep(1)
        end
        fresh_hang("the monitor released its gate before the switch") if IyiWorkers.force_stale_gate_state == 4_u64
        fail("fresh: not armed: the switch did not receive the raised word") unless IyiWorkers.force_stale_before == 2_u64
        word = IyiWorkers.force_stale_word
        fail("fresh: the word raised for the task before was still up after the switch") if word == 2_u64
        fail("fresh: not armed: the switch recorded word #{word}") unless word == 1_u64
        puts "fresh: the switch after a task held its raised word lowered the word"
      {% end %}
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !shared.successor_started?
        fresh_hang("the successor did not run in 10000 ms") if __iyi_monotonic_ns > limit
        sleep(1)
      end
    end
    say "fresh: a task held its worker until its word was raised, then its queued successor ran on that worker"
  end

  # ── period ───────────────────────────────────────────────────────────
  # The monitor's period, and the quantum it makes. A task computing half a
  # second on a pool of one, and the monitor's looks over it: every look
  # is a tick, PREEMPT_TICK_MS apart. Then two such tasks on the one
  # worker, which take turns: the time they took over the turns they took
  # is the quantum, two ticks once each look after a turn sees the count
  # move and the next sees it stand. Linux, darwin and Windows looked every
  # 5.1 to 6.3 ms and took turns of 10.2 to 12.3 ms on the machines
  # measured (SPEC.md III.4.13); a Windows wait that ends on the system
  # timer's tick looked every 11.2 to 12.3 ms there, and a wait that ends
  # at once would spin the monitor.
  #
  # The look's bound sits between the two. darwin's three-core runners,
  # sharing their cores with the task the monitor watches, looked every
  # 6.3, 8.9 and 9.0 ms in three CI runs (the last, job 122004173378, past
  # the 9 ms this bound was), and 7.1 to 8.9 ms in the 7 runs of macos-15
  # in CI's logs. Windows' looks end on a high-resolution timer: its
  # runners read 5.14 to 5.42 ms in 101 runs. The timer-tick copy read
  # 10.6 to 14.3 ms in 36, and in job 124885593140 came under 10.5: it
  # passed the look and was caught only by the 20 ms the turn was then
  # held to, at turns of 20845 us, about two of its looks. It read 10.1 to
  # 13.1 ms in 20 runs of debug jobs 124913849506 and 124922160886, where
  # the real looks read 5.15 to 5.30. So on Windows the bound is 8 ms,
  # half again the slowest real look and under four fifths of the copy's
  # quickest.
  #
  # The quantum is two looks wherever the looks are, so it is held to
  # QUANTUM_LOOKS of the ones this run measured, not to a time a slow
  # runner's looks stretch it towards: Windows took 1.91 to 2.09 looks a
  # turn in those 101 runs, and darwin 1.52 to 2.52 in 15 on macos-14 and
  # macos-15, where looks of up to 8.9 ms made turns of up to 17.2 ms,
  # 2.8 ms under the 20 ms the turn was held to. In the debug jobs,
  # macos-15 took 1.61 to 2.25 looks a turn in 44 runs (124913849625 and
  # 124922160678) and windows-2025 1.94 to 2.03 in 40. A monitor that
  # raises the word after three unchanged looks rather than one takes
  # four looks a turn, and fails it.
  PERIOD_FLOOR_US   =  4000_i64
  {% if flag?(:win32) %}
    PERIOD_BOUND_US = 8000_i64
  {% else %}
    PERIOD_BOUND_US = 10500_i64
  {% end %}
  QUANTUM_LOOKS     =     3_i64
  {% if flag?(:slowturn_force) %}
  # The forced check (`-Dslowturn_force`), run first and apart from the timed checks below. Two tasks compute on
  # the one worker until the monitor has raised its word three times (a progress limit names a hang). The copy
  # records, at each raise, the unchanged looks it came after: the control raises after one, the mutant after
  # three. Zero is not armed. No clock decides anything here.
  def period_forced(per_ms : Int64) : Nil
    fail("period: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    base = IyiWorkers.force_raise_count
    done = Atomic(Int64).new(0_i64)
    group do |g|
      2.times do |i|
        g.spawn(unit: :new) do
          x = 13_u64 + i.to_u64
          while done.get < 1_i64
            x = x &* 6364136223846793005_u64 &+ 1_u64
          end
          x
        end
      end
      limit = __iyi_monotonic_ns + 20_000_000_000_i64
      while IyiWorkers.force_raise_count < base + 3_u64
        sleep(1)
        fail("period: progress hang: the monitor raised no word three times in 20000 ms") if __iyi_monotonic_ns > limit
      end
      done.set(1_i64)
    end
    ticks = IyiWorkers.force_raise_ticks
    fail("period: not armed: a raise of the monitor's word recorded no unchanged looks") if ticks == 0_u64
    fail("period: a worker's word was raised after 3 unchanged looks") if ticks == 3_u64
    fail("period: a worker's word was raised after #{ticks} unchanged looks") unless ticks == 1_u64
    puts "period: the monitor raised a worker's word after one unchanged look"
  end
  {% end %}


  def period(per_ms : Int64) : Nil
    {% if flag?(:coarse_force) && flag?(:win32) %}
      fail("period: runs on a pool of one") if IyiWorkers.count != 1
      done = Atomic(Int64).new(0_i64)
      started = Atomic(Int64).new(0_i64)
      group do |g|
        g.spawn(unit: :new) do
          x = 13_u64
          started.set(1_i64)
          while done.get == 0_i64
            x = x &* 6364136223846793005_u64 &+ 1_u64
          end
          x
        end
        limit = __iyi_monotonic_ns + 20_000_000_000_i64
        while started.get == 0_i64
          sleep(1)
          fail("period: the active worker did not start") if __iyi_monotonic_ns > limit
        end
        IyiWorkers.force_tick_arm
        while IyiWorkers.force_tick_wait == 0_u64
          sleep(1)
          fail("period: the active monitor tick did not complete") if __iyi_monotonic_ns > limit
        end
        done.set(1_i64)
      end
      tick = IyiWorkers.force_tick_wait
      fail("period: the high-resolution timer could not be made") if tick == 5_u64
      fail("period: the high-resolution timer could not be set") if tick == 4_u64
      fail("period: a wait on the high-resolution timer failed") if tick == 3_u64
      fail("period: the semaphore wait failed") if tick == 6_u64
      fail("period: the active monitor used the semaphore fallback") if tick == 2_u64
      fail("period: the active monitor's tick recorded #{tick}") unless tick == 1_u64
      puts "period: the active monitor used its high-resolution timer"
      return
    {% end %}
    {% if flag?(:slowturn_force) %}
      period_forced(per_ms)
      return
    {% end %}
    fail("period: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    looked = Atomic(Int64).new(0_i64)
    took = Atomic(Int64).new(0_i64)
    group do |g|
      g.spawn(unit: :new) do
        before = IyiWorkers.looks
        t = __iyi_monotonic_ns
        x = spin(500_i64 * per_ms, 11_u64)
        took.set((__iyi_monotonic_ns - t) // 1000_i64 + (x == 0_u64 ? 1_i64 : 0_i64))
        looked.set((IyiWorkers.looks - before).to_i64)
        0
      end
    end
    looks = looked.get
    fail("period: the monitor looked #{looks} times in #{took.get} us of a task computing") if looks < 2_i64
    us = took.get // looks
    if us < PERIOD_FLOOR_US || us > PERIOD_BOUND_US
      fail("period: the monitor looked every #{us} us over #{looks} looks, outside #{PERIOD_FLOOR_US} to #{PERIOD_BOUND_US} us")
    end
    preempts = IyiWorkers.preempts
    t = __iyi_monotonic_ns
    group do |g|
      2.times do |i|
        g.spawn(unit: :new) do
          spin(300_i64 * per_ms, 13_u64 + i.to_u64) == 0_u64 ? 1 : 0
        end
      end
    end
    total = (__iyi_monotonic_ns - t) // 1000_i64
    turns = (IyiWorkers.preempts - preempts).to_i64
    fail("period: two tasks computing on one worker took no turns in #{total} us") if turns == 0_i64
    quantum = total // (turns + 1_i64)
    if quantum > QUANTUM_LOOKS * us
      fail("period: two tasks computing on one worker took turns of #{quantum} us, past #{QUANTUM_LOOKS} of the #{us} us looks")
    end
    say "period: the monitor looked every #{us} us over #{looks} looks; two tasks computing on one worker took #{turns} turns of #{quantum} us"
  end

  # Each loop and its @[NoPreempt] twin run once inside a parallel task.
  # Their answers must agree; their times and ratio are information only.
  # bench/parallel_exercise.sh checks the generated back-edges in the IR.

  def tight : Nil
    group do |g|
      g.spawn(unit: :new) do
        values = Array(Int64).new(1_000_000) { |i| i.to_i64 * 3_i64 }
        bytes = Array(UInt8).new(262_144) { |i| ((i * 7 + 3) & 0xFF).to_u8 }
        table = crc_table
        ["walk", "sum", "each", "crc"].each do |name|
          t = __iyi_monotonic_ns
          a = case name
              when "walk" then spin(200_000_000_i64, 7_u64)
              when "sum"  then sum(values, 300).to_u64
              when "each" then sum_each(values, 300).to_u64
              else             crc(table, bytes, 600).to_u64
              end
          took = __iyi_monotonic_ns - t
          t = __iyi_monotonic_ns
          b = case name
              when "walk" then spin_np(200_000_000_i64, 7_u64)
              when "sum"  then sum_np(values, 300).to_u64
              when "each" then sum_each_np(values, 300).to_u64
              else             crc_np(table, bytes, 600).to_u64
              end
          took_np = __iyi_monotonic_ns - t
          fail("tight: #{name} answered #{a} checked and #{b} unchecked") if a != b
          fail("tight: #{name} recorded a zero unchecked duration") if took_np <= 0_i64
          ratio = (took * 1000_i64 // took_np).to_f / 1000.0
          say "tight: #{name}: #{took // 1000_i64} us checked, #{took_np // 1000_i64} us unchecked, #{ratio}x (performance information)"
        end
        0
      end
    end
  end

  STEPS = ["slice", "unit", "server", "poller", "fresh", "period", "tight"]

  # With no arguments, the steps that hold on a pool of one and take
  # seconds, there: slice, unit and period, which wants the pool of one.
  # The server shape wants workers, and the tight loops half a minute.
  workers = Program.args.empty? ? 1 : 4
  chosen = [] of String
  Program.args.each do |argument|
    if argument.starts_with?("--workers=")
      workers = argument[10, argument.size - 10].to_i
    else
      fail("no step named #{argument}") unless STEPS.includes?(argument)
      chosen << argument
    end
  end
  chosen = ["slice", "unit", "period"] if chosen.empty?
  IyiWorkers.count = workers
  per_ms = calibrate
  chosen.each do |name|
    case name
    when "slice"  then slice(per_ms)
    when "unit"   then unit(per_ms)
    when "server" then server(per_ms)
    when "poller" then poller(per_ms)
    when "fresh"  then fresh(per_ms)
    when "period" then period(per_ms)
    when "tight"  then tight
    end
  end
  puts "parallel preemption: every property held on #{IyiWorkers.count} workers"
{% else %}
  puts "parallel preemption: no pool on this target, nothing to hold"
{% end %}
