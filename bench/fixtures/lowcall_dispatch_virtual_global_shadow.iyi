lib LibC
  fun exit(status : Int32) : NoReturn
end

fun hook : Int32
  1
end

class Base
  def hook : Int32
    2
  end

  def run : Int32
    hook
  end
end

class Child < Base
  def hook : Int32
    8
  end
end

def choose(flag : Bool) : Base
  flag ? Base.new : Child.new
end

LibC.exit(choose(false).run)
