# A panic or an `exit` ends the process whatever its other tasks are
# parked on.
#
#   ./bin/iyi run bench/panic_exit.iyi -- task-panic --workers=12
#
# Each step starts reads on both ends of connections nobody writes to,
# an accept nobody connects to, sleepers, and channel receivers. Once
# every read and accept has registered and parked on the poller (Windows'
# completion port), the step ends the program:
#
#   task-panic: a task panics. Its group cancels the others, and the join
#               re-raises in the main task, which exits 1.
#   main-panic: the main task panics inside the group. The join it
#               deferred cancels the tasks, and the process exits 1.
#   task-exit:  a task calls `exit(3)`, and the process ends with 3, the
#               other tasks with it.
#
# `--workers=N` starts the scenario tasks in new units on a pool of N
# workers. `--workers=0` keeps them on the main thread in the same unit.
# Once the io waits have parked, a watchdog on the main thread fails the run
# if it is still going `--watch` ms later (5,000 by default). A cancel that
# never ends a parked wait is a join that never ends, so that hang
# becomes a named failure, not a hung job. When a panic's join is over,
# the watchdog, cancelled last, prints how long the tasks took to end.
# bench/parallel_exercise.sh runs every step both ways, and a broken copy
# of the runtime whose cancel leaves an io wait parked.
module bench/panic_exit

import std/socket::{IyiSocket, SocketError}

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  PAIRS = 4
  # This unmarked file uses the runtime copy's shared ending when hooks run.
  # Standalone failure paths run on the main thread and need no claim word.

  def fail(message : String) : Nil
    {% if flag?(:run_end_copy) %}
      end_run(1, 1, "FAIL: ", message, "\n")
    {% else %}
      print "FAIL: #{message}\n"
      __iyi_exit(1)
    {% end %}
  end

  def progress_hang(message : String) : NoReturn
    {% if flag?(:run_end_copy) %}
      end_run(76, 1, "FAIL: ", message, "\n")
    {% else %}
      print "FAIL: #{message}\n"
      __iyi_exit(76)
    {% end %}
  end

  def setup_failure(message : String) : NoReturn
    {% if flag?(:run_end_copy) %}
      end_run(76, 1, "FAIL: ", message, "\n")
    {% else %}
      print "FAIL: #{message}\n"
      __iyi_exit(76)
    {% end %}
  end

  # A read nobody answers: parked on the poller until it is cancelled.
  def park_read(fd : Int32, target : Bool = false) : Int32
    {% if flag?(:panic_park_watchdog) %}
      # Keep one reader off the poller to exercise the rendezvous watchdog.
      if target
        held = Channel(Int32).new
        held.receive
      end
    {% end %}
    {% if flag?(:parkedio_force) %}
      IyiScheduler.force_io_target(IyiScheduler.current) if target
    {% end %}
    case got = IyiSocket.new(fd).read(1)
    in Cancelled, SocketError
      0
    in String
      1
    end
  end

  def park_accept(fd : Int32) : Int32
    case got = IyiSocket.new(fd).accept
    in Cancelled, SocketError
      0
    in IyiSocket
      1
    end
  end

  def park_receive(never : Channel(Int32)) : Int32
    case got = never.receive
    in Cancelled, ChannelClosed
      0
    in Int32
      got
    end
  end

  # A same-thread fiber has no listed_on word. Its scheduler's io list is
  # protected by this lock on every platform, and this scan cannot switch
  # to another fiber while it holds the lock.
  @[NoInline]
  @[NoPreempt]
  def local_io_parked?(fiber : IyiFiber) : Bool
    state = IyiScheduler.state
    found = false
    IyiScheduler.lists_lock(state)
    cursor = state.io_head
    while cursor.is_a?(IyiFiber)
      if cursor.object_id == fiber.object_id
        found = true
        break
      end
      cursor = cursor.next_io
    end
    IyiScheduler.lists_unlock(state)
    found
  end

  # A pool fiber publishes the io-list owner atomically and clears on_cpu
  # only after switching out. Same-thread readers are in their io list.
  def await_io_parks(readers : Array(IyiTask(Int32)), mode : String) : Nil
    started = __iyi_monotonic_ns
    parked = false
    while !parked
      sleep(1)
      parked = true
      i = 0
      while i < readers.size
        fiber = readers[i].fiber
        if fiber.unit.is_a?(IyiUnit)
          parked = false if fiber.listed_on == 0_u64 || fiber.on_cpu?
        else
          parked = false unless local_io_parked?(fiber)
        end
        {% if flag?(:parkedio_force) %}
          parked = false unless IyiScheduler.force_io_registered?
        {% end %}
        i = i + 1
      end
      progress_hang("#{mode}: progress hang: a reader did not park on its io wait") if !parked && (__iyi_monotonic_ns - started) // 1000000_i64 >= 4000_i64
    end
  end

  # The parked tasks and the ending, spawned one way or the other: the
  # block a parallel task runs is checked for what it captures, so it is
  # written out at each spawn rather than passed along as a proc.
  {% for kind in [{"spawn", "spawn(unit: :same)"}, {"parallel", "spawn(unit: :new)"}] %}
    def ends_{{kind[0].id}}(g : IyiGroup, mode : String, near : Array(Int32), far : Array(Int32), listening : Int32, never : Channel(Int32), watch_ready : Channel(Int32)) : Nil
      readers = [] of IyiTask(Int32)
      release = Channel(Int32).new
      PAIRS.times do |index|
        a = near[index]
        b = far[index]
        target = index == 0
        readers << g.{{kind[1].id}} { park_read(a, target) }
        readers << g.{{kind[1].id}} { park_read(b) }
      end
      readers << g.{{kind[1].id}} { park_accept(listening) }
      2.times do
        g.{{kind[1].id}} do
          sleep(60000)
          0
        end
        g.{{kind[1].id}} { park_receive(never) }
      end
      case mode
      when "task-panic"
        g.{{kind[1].id}} do
          release.receive
          raise "a task's panic, with tasks parked on the poller"
        end
      when "task-exit"
        g.{{kind[1].id}} do
          release.receive
          exit(3)
        end
      end
      await_io_parks(readers, mode)
      watch_ready.send(1)
      if mode == "main-panic"
        raise "the main task's panic, with tasks parked on the poller"
      else
        release.send(1)
      end
    end
  {% end %}

  def ends(mode : String, parallel : Bool, watch : Int32) : Nil
    started = __iyi_monotonic_ns
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    near = [] of Int32
    far = [] of Int32
    PAIRS.times do
      client = IyiSocket.connect("127.0.0.1", port, 5000)
      setup_failure("#{mode}: setup: connect answered #{client}") unless client.is_a?(IyiSocket)
      server = listener.accept
      setup_failure("#{mode}: setup: accept answered #{server}") unless server.is_a?(IyiSocket)
      near << client.fd
      far << server.fd
    end
    never = Channel(Int32).new
    watch_ready = Channel(Int32).new
    group do |w|
      w.spawn(unit: :same) do
        watch_ready.receive
        waited = sleep(watch)
        progress_hang("#{mode}: progress hang: still running #{watch} ms after its io waits parked") unless waited.is_a?(Cancelled)
        puts "#{mode}: every task ended #{(__iyi_monotonic_ns - started) // 1000000_i64} ms after the start"
        0
      end
      group do |g|
        if parallel
          ends_parallel(g, mode, near, far, listener.fd, never, watch_ready)
        else
          ends_spawn(g, mode, near, far, listener.fd, never, watch_ready)
        end
      end
      fail("#{mode}: the group ended, and the program went on")
    end
  end

  STEPS = ["task-panic", "main-panic", "task-exit"]

  workers = 12
  watch = 5000
  chosen = ""
  Program.args.each do |argument|
    if argument.starts_with?("--workers=")
      value = argument[10, argument.size - 10].to_i?
      setup_failure("setup: workers must be a nonnegative integer") unless value.is_a?(Int32) && value >= 0
      workers = value
    elsif argument.starts_with?("--watch=")
      value = argument[8, argument.size - 8].to_i?
      setup_failure("setup: watch must be a positive integer") unless value.is_a?(Int32) && value > 0
      watch = value
    else
      setup_failure("setup: no step named #{argument}") unless STEPS.includes?(argument)
      chosen = argument
    end
  end
  # Every step ends the process, by panic or by exit, so a bare run - which
  # Windows CI makes of every bench program and holds to exit 0 - names
  # them and ends there.
  if chosen.empty?
    puts "panic exit: each step ends the program; name one of #{STEPS.join(", ")}, as bench/parallel_exercise.sh does"
  else
    IyiWorkers.count = workers if workers > 0
    ends(chosen, workers > 0, watch)
  end
{% else %}
  puts "panic exit: no pool on this target, nothing to hold"
{% end %}
