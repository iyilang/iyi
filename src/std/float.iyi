# `Float32`, made a number, and what `Float64` still lacked.
#
# The prelude's float is `Float64`: `1.5`, arithmetic, comparisons, `floor`,
# `ceil`, `round`, `abs`, `**` and the shortest decimal that reads back as
# the same double. A `Float32` literal, `1.5_f32`, exists but had no method
# to land on. This module declares the `@[Primitive]` matrix for it the way
# the prelude does for `Float64` - arithmetic, comparisons and conversions
# against every numeric type, instructions and nothing underneath - and
# gives it `abs`, `floor`, `ceil`, `round`, `trunc`, unary `-`, `%`, `//`,
# `remainder`, `<=>` (a total order, NaN last), `nan?`, `infinite?`, `finite?`, the constants `NAN`,
# `INFINITY`, `MIN`, `MAX`, `EPSILON`, `MIN_POSITIVE`, and a printer of its
# own: the shortest decimal that reads back as the same *single*, on the
# prelude's exact bignum, so `0.1_f32` prints `0.1` and `Float32::MAX`
# prints `3.4028235e+38`. `Float64` gets the same constants, `trunc`, unary
# `-`, `%`, `//`, `remainder`, `<=>` and the three predicates.
#
# Mixed arithmetic answers the receiver's type, as the prelude's does:
# `1_u16 + 1.5_f32` is a `Float32`, `1.5 + 1.5_f32` a `Float64`, and
# `1.5_f32 + 1.5` a `Float32` (computed in double, then narrowed). A single
# compared with an integer is compared exactly, on the double it is:
# `16777217 == 16777216.0_f32` is false.
#
# `%` is the floored modulo, its sign the divisor's, as `Float#%` has meant
# where the name comes from, and so is the zero it answers: `-0.0 % 1.0` is
# `0.0`; `remainder` is the truncated one, its sign the dividend's; `//` is
# the floored quotient, so `divmod` answers what Python's does. All exact:
# no `x - y * q` that rounds. Either by zero panics "modulo by zero" or
# "division by zero". A conversion to an integer truncates and then refuses
# what the truncation does not hold ("arithmetic overflow"): `255.5_f32.to_u8`
# is 255, NaN and the infinities are refused. Narrowing a double to a
# single overflows to the infinity of its sign, as the single's own
# arithmetic does, and so does `2.0_f32 ** 128`.
module std/float

import std/int
import std/number

{% begin %}
  {% ints = %w(Int8 Int16 Int32 Int64 Int128 UInt8 UInt16 UInt32 UInt64 UInt128) %}
  {% nums = ints + %w(Float64) %}
  {% int_convs = [
       {"to_i8", "Int8"}, {"to_i16", "Int16"}, {"to_i32", "Int32"}, {"to_i", "Int32"},
       {"to_i64", "Int64"}, {"to_i128", "Int128"},
       {"to_u8", "UInt8"}, {"to_u16", "UInt16"}, {"to_u32", "UInt32"}, {"to_u", "UInt32"},
       {"to_u64", "UInt64"}, {"to_u128", "UInt128"},
     ] %}

  # A single whose truncation fits the integer, decided on the double it
  # is exactly: see `float_limits` in std/int, which these repeat for the
  # single's own conversions.
  {% float_limits = {
       "Int8"    => "128.0",
       "Int16"   => "32768.0",
       "Int32"   => "2147483648.0",
       "Int64"   => "9223372036854775808.0",
       "Int128"  => "170141183460469231731687303715884105728.0",
       "UInt8"   => "256.0",
       "UInt16"  => "65536.0",
       "UInt32"  => "4294967296.0",
       "UInt64"  => "18446744073709551616.0",
       "UInt128" => "340282366920938463463374607431768211456.0",
     } %}
  {% float_refuse_low = {
       "Int8"    => "wide <= -129.0",
       "Int16"   => "wide <= -32769.0",
       "Int32"   => "wide <= -2147483649.0",
       "Int64"   => "wide < -9223372036854775808.0",
       "Int128"  => "wide < -170141183460469231731687303715884105728.0",
       "UInt8"   => "wide <= -1.0",
       "UInt16"  => "wide <= -1.0",
       "UInt32"  => "wide <= -1.0",
       "UInt64"  => "wide <= -1.0",
       "UInt128" => "wide <= -1.0",
     } %}
  {% wide_ints = %w(Int64 UInt64 Int128 UInt128) %}

  struct ::Float32
    @[::Primitive(:convert)]
    def to_f : Float64
    end

    @[::Primitive(:convert)]
    def to_f64 : Float64
    end

    @[::Primitive(:convert)]
    def to_f32 : Float32
    end

    # Truncated first, then refused if the truncation does not fit:
    # `255.5_f32.to_u8` is 255 and `(-0.5_f32).to_u8` is 0. The instruction
    # is std/int's, on the double every single is exactly.
    {% for conv in int_convs %}
      def {{ conv[0].id }} : {{ conv[1].id }}
        wide = to_f64
        if wide != wide || {{ float_refuse_low[conv[1]].id }} || wide >= {{ float_limits[conv[1]].id }}
          raise "arithmetic overflow"
        end
        wide.unsafe_{{ conv[0].id }}
      end
    {% end %}

    {% for num in %w(Float64 Float32) %}
      {% for op in %w(== != < <= > >=) %}
        @[::Primitive(:binary)]
        def {{ op.id }}(other : {{ num.id }}) : Bool
        end
      {% end %}
    {% end %}

    # Against an integer, exact: on the double the single is exactly,
    # which holds every integer under 64 bits exactly too, and through
    # std/int's exact `<=>` for the wider ones - the prelude's own `Int64 ==
    # Float64` is not exact. `16777217 == 16777216.0_f32` was true, the
    # integer rounded to a single first.
    {% for int in ints %}
      {% if wide_ints.includes?(int) %}
        {% for pair in [{"==", "c == 0"}, {"!=", "c != 0"}, {"<", "c == 1"}, {"<=", "c == 1 || c == 0"}, {">", "c == -1"}, {">=", "c == -1 || c == 0"}] %}
          def {{ pair[0].id }}(other : {{ int.id }}) : Bool
            # IEEE against NaN: only `!=` is true. `<=>` places NaN for
            # sorting and would answer the wrong way here.
            return {{ pair[0] == "!=" }} if nan?
            c = other <=> to_f64
            {{ pair[1].id }}
          end
        {% end %}
      {% else %}
        {% for op in %w(== != < <= > >=) %}
          def {{ op.id }}(other : {{ int.id }}) : Bool
            to_f64 {{ op.id }} other.to_f64
          end
        {% end %}
      {% end %}
    {% end %}

    {% for num in nums + %w(Float32) %}
      {% for op in %w(+ - *) %}
        @[::Primitive(:binary)]
        def {{ op.id }}(other : {{ num.id }}) : self
        end
      {% end %}

      @[::Primitive(:binary)]
      def fdiv(other : {{ num.id }}) : self
      end
    {% end %}

    @[::Primitive(:binary)]
    def /(other : Float32) : Float32
    end
  end

  {% for num in nums %}
    struct ::{{ num.id }}
      {% if num == "Float64" %}
        # The instruction, unchecked: a double past the single's range
        # narrows to the infinity of its sign, as `Float32::MAX * 2.0_f32`
        # answers. It used to panic "arithmetic overflow" here alone.
        @[::Primitive(:unchecked_convert)]
        def to_f32 : Float32
        end

        {% for op in %w(== != < <= > >=) %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : Float32) : Bool
          end
        {% end %}

        {% for op in %w(+ - *) %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : Float32) : self
          end
        {% end %}

        @[::Primitive(:binary)]
        def fdiv(other : Float32) : self
        end
      {% else %}
        @[::Primitive(:convert)]
        @[Raises]
        def to_f32 : Float32
        end

        # The single's exact comparison, with the sides swapped.
        {% for pair in [{"==", "=="}, {"!=", "!="}, {"<", ">"}, {"<=", ">="}, {">", "<"}, {">=", "<="}] %}
          def {{ pair[0].id }}(other : Float32) : Bool
            other {{ pair[1].id }} self
          end
        {% end %}

        {% for op in %w(+ - *) %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : Float32) : Float32
          end
        {% end %}

        def /(other : Float32) : Float32
          to_f32 / other
        end
      {% end %}
    end
  {% end %}

  # --- what both floats get, written once per type -------------------------
  {% for f in [{"Float32", "_f32", 24, "16777216.0_f32"}, {"Float64", "", 53, "9007199254740992.0"}] %}
    {% name = f[0] %}
    {% sfx = f[1] %}
    struct ::{{ name.id }}
      NAN      = 0.0{{ sfx.id }} / 0.0{{ sfx.id }}
      INFINITY = 1.0{{ sfx.id }} / 0.0{{ sfx.id }}
      {% if name == "Float32" %}
        MIN          = -3.40282347e+38_f32
        MAX          =  3.40282347e+38_f32
        EPSILON      =  1.1920929e-07_f32
        MIN_POSITIVE =  1.17549435e-38_f32
      {% else %}
        MIN          = -1.7976931348623157e+308
        MAX          =  1.7976931348623157e+308
        EPSILON      =  2.220446049250313e-16
        MIN_POSITIVE =  2.2250738585072014e-308
      {% end %}

      def nan? : Bool
        self != self
      end

      # 1 for +Infinity, -1 for -Infinity, nil for anything finite or NaN.
      def infinite? : Int32?
        if self == INFINITY
          1
        elsif self == -INFINITY
          -1
        else
          nil
        end
      end

      def finite? : Bool
        !nan? && infinite?.nil?
      end

      # Multiplied rather than subtracted from zero, so `-(0.0)` is `-0.0`.
      def - : {{ name.id }}
        -1.0{{ sfx.id }} * self
      end

      # A total order, so `Comparable` holds and a list of floats sorts:
      # NaN is after everything and equal to NaN. `<` and `==` keep IEEE's
      # answer, false against NaN; this is the one place NaN is placed.
      def <=>(other : {{ name.id }}) : Int32
        if nan?
          other.nan? ? 0 : 1
        elsif other.nan?
          -1
        else
          self < other ? -1 : (self > other ? 1 : 0)
        end
      end

      # The remainder of the truncated division, the dividend's sign (C's
      # `fmod`), computed exactly: the divisor is doubled up to the dividend
      # and subtracted, and every such difference is exact.
      def remainder(other : {{ name.id }}) : {{ name.id }}
        raise "modulo by zero" if other == 0.0{{ sfx.id }}
        return NAN if nan? || other.nan? || !infinite?.nil?
        return self if !other.infinite?.nil?
        ax = abs
        ay = other.abs
        while ax >= ay
          t = ay
          while t + t <= ax
            t = t + t
          end
          ax = ax - t
        end
        self < 0.0{{ sfx.id }} ? -ax : ax
      end

      # The floored modulo, the divisor's sign: `-7.5 % 2.0` is 0.5,
      # `7.5 % -2.0` is -0.5, and a zero takes the divisor's sign too -
      # `-0.0 % 1.0` is `0.0` - where it used to keep the dividend's.
      def %(other : {{ name.id }}) : {{ name.id }}
        r = remainder(other)
        if r == 0.0{{ sfx.id }}
          return other < 0.0{{ sfx.id }} ? -0.0{{ sfx.id }} : 0.0{{ sfx.id }}
        end
        if (r < 0.0{{ sfx.id }}) != (other < 0.0{{ sfx.id }})
          r = r + other
        end
        r
      end

      # The floored quotient, `divmod`'s other half: `7.5 // 2.0` is 3.0
      # and `-7.5 // 2.0` is -4.0. The exact remainder is taken off first
      # so the division is of a multiple of the divisor; it can still round,
      # so the quotient is floored and nudged up past a half. A zero
      # quotient has the sign of the division.
      def //(other : {{ name.id }}) : {{ name.id }}
        raise "division by zero" if other == 0.0{{ sfx.id }}
        r = remainder(other)
        q = (self - r) / other
        if r != 0.0{{ sfx.id }} && (r < 0.0{{ sfx.id }}) != (other < 0.0{{ sfx.id }})
          q = q - 1.0{{ sfx.id }}
        end
        return q if q != q
        return self / other * 0.0{{ sfx.id }} if q == 0.0{{ sfx.id }}
        f = q.floor
        q - f > 0.5{{ sfx.id }} ? f + 1.0{{ sfx.id }} : f
      end

      # Toward zero. Past 2^{{ f[2] }} every value is an integer already and is
      # answered as it is; NaN and the infinities likewise.
      def trunc : {{ name.id }}
        return self if self != self || abs >= {{ f[3].id }}
        {% if name == "Float32" %}
          to_i64.to_f32
        {% else %}
          to_i64.to_f64
        {% end %}
      end
    end
  {% end %}
{% end %}

struct ::Float32
  # Every single is a double, and the integer nearest a single is a
  # single: the prelude's `Float64` roundings are exact for it.
  def abs : Float32
    self < 0.0_f32 ? -1.0_f32 * self : self
  end

  def floor : Float32
    to_f64.floor.to_f32
  end

  def ceil : Float32
    to_f64.ceil.to_f32
  end

  def round : Float32
    to_f64.round.to_f32
  end

  def round(digits : Int32) : Float32
    to_f64.round(digits).to_f32
  end

  def **(exponent : Int32) : Float32
    (to_f64 ** exponent).to_f32
  end

  def to_s : String
    Std::Float::Float32Text.text(Std::Float::Float32Text.bits_of(self))
  end

  def hash : Int32
    bits = Std::Float::Float32Text.bits_of(self == 0.0_f32 ? 0.0_f32 : self)
    (bits & 2147483647_u32).to_i32 ^ (bits.unsafe_shr(31)).to_i32
  end
end

struct ::Float64
  def hash : Int32
    # `-0.0 == 0.0`, so they hash alike.
    bits = IyiFloatText.bits_of(self == 0.0 ? 0.0 : self)
    mix = bits ^ bits.unsafe_shr(32_u64)
    (mix & 2147483647_u64).to_i32 ^ (mix.unsafe_shr(31_u64) & 1_u64).to_i32
  end
end

# The single's shortest round-tripping decimal: the prelude's free-format
# digit generation (Steele & White, Burger & Dybvig's scaling) on the
# prelude's exact bignum, with the single's layout - a 24-bit significand,
# exponents from -149 - so the boundaries between one single and the next,
# not the double's, decide where the digits stop. The notation is the
# prelude's `Float64#to_s`'s.
module Float32Text
  def self.bits_of(value : Float32) : UInt32
    holder = Pointer(Float32).malloc(1_u64)
    holder.value = value
    Pointer(UInt32).new(holder.address).value
  end

  def self.from_bits(bits : UInt32) : Float32
    holder = Pointer(UInt32).malloc(1_u64)
    holder.value = bits
    Pointer(Float32).new(holder.address).value
  end

  def self.text(bits32 : UInt32) : String
    bits = bits32.to_u64
    negative = bits.unsafe_shr(31_u64) != 0_u64
    exponent_bits = bits.unsafe_shr(23_u64) & 255_u64
    fraction = bits & 8388607_u64
    if exponent_bits == 255_u64
      return "NaN" if fraction != 0_u64
      return negative ? "-Infinity" : "Infinity"
    end
    return negative ? "-0.0" : "0.0" if exponent_bits == 0_u64 && fraction == 0_u64

    # value = f * 2^e, f the 24-bit significand (23 for a subnormal).
    hidden = 8388608_u64
    f = exponent_bits == 0_u64 ? fraction : fraction | hidden
    e = exponent_bits == 0_u64 ? -149 : exponent_bits.to_i64.to_i32 - 150

    # r/s is the value, m+/s and m-/s the distances to the neighbours'
    # midpoints; a significand at the bottom of its binade has a nearer
    # neighbour below, so the gap above is twice the gap below.
    unequal = fraction == 0_u64 && exponent_bits > 1_u64
    r = IyiBig.new(f)
    s = IyiBig.new(1_u64)
    if e >= 0
      r.shl(e + (unequal ? 2 : 1))
      s.shl(unequal ? 2 : 1)
      m_plus = IyiBig.new(1_u64)
      m_plus.shl(unequal ? e + 1 : e)
      m_minus = IyiBig.new(1_u64)
      m_minus.shl(e)
    else
      r.shl(unequal ? 2 : 1)
      s.shl(-e + (unequal ? 2 : 1))
      m_plus = IyiBig.new(unequal ? 2_u64 : 1_u64)
      m_minus = IyiBig.new(1_u64)
    end

    # An even significand owns its boundaries (round-half-even reads a
    # midpoint back as the even neighbour), an odd one does not.
    even = f & 1_u64 == 0_u64

    # k, the decimal exponent, estimated from the binary one and corrected
    # below by the comparisons the digits will use anyway.
    length = 0
    probe = f
    while probe != 0_u64
      probe = probe.unsafe_shr(1_u64)
      length = length + 1
    end
    k = ((e + length - 1) * 1233) // 4096
    k = k - 1 if (e + length - 1) < 0 && ((e + length - 1) * 1233) % 4096 != 0
    k = k + 1
    if k >= 0
      s.mul_pow10(k)
    else
      r.mul_pow10(-k)
      m_plus.mul_pow10(-k)
      m_minus.mul_pow10(-k)
    end
    while (c = r.compare_sum(m_plus, s)) > 0 || (c == 0 && even)
      s.mul_small(10_u64)
      k = k + 1
    end
    while true
      r_ten = r.copy
      r_ten.mul_small(10_u64)
      m_ten = m_plus.copy
      m_ten.mul_small(10_u64)
      c = r_ten.compare_sum(m_ten, s)
      break if c > 0 || (c == 0 && even)
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      k = k - 1
    end

    digits = Pointer(UInt8).malloc(20_u64)
    count = 0
    while true
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      digit = r.divide_digit(s)
      low_c = r.compare(m_minus)
      low = low_c < 0 || (low_c == 0 && even)
      high_c = r.compare_sum(m_plus, s)
      high = high_c > 0 || (high_c == 0 && even)
      if !low && !high
        digits[count] = digit.to_u8
        count = count + 1
        next
      end
      if low && high
        twice = r.copy
        twice.shl(1)
        c = twice.compare(s)
        digit = digit + 1 if c > 0 || (c == 0 && digit % 2 == 1)
      elsif high
        digit = digit + 1
      end
      digits[count] = digit.to_u8
      count = count + 1
      break
    end

    IyiFloatText.format(negative, digits, count, k)
  end
end

struct ::Float32
  def round(mode : Std::Number::RoundingMode) : Float32
    to_f64.round(mode).to_f32
  end
end
