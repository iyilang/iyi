; iyi-ir 1
source_filename = "counter_guarded"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @counter_guarded(i32 %n, ptr %negative_out, ptr %above_out) {
entry:
  br label %head
head:
  %i = phi i32 [ 0, label %entry ], [ %next, label %body ]
  %more = icmp slt i32 %i, %n
  br i1 %more, label %body, label %done
body:
  store i1 false, ptr %negative_out, align 1
  store i1 false, ptr %above_out, align 1
  %next = add i32 %i, 1
  br label %head
done:
  ret void
}
