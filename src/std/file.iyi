# File: comprehensive file operations, metadata inspection, and manipulation.
#
# Extends the prelude's core File with File::Info, File::Type, File::Permissions,
# path queries, permissions, timestamps, symlinks, and iteration without external C libraries.

module std/file

import std/path::{Path}

{% if flag?(:darwin) %}
  lib LibC
    struct Timespec
      tv_sec : Int64
      tv_nsec : Int64
    end

    struct Stat
      st_dev : Int32
      st_mode_nlink : Int32
      st_ino : UInt64
      st_uid : Int32
      st_gid : Int32
      st_rdev : Int32
      st_pad : Int32
      st_atimespec : Timespec
      st_mtimespec : Timespec
      st_ctimespec : Timespec
      st_birthtimespec : Timespec
      st_size : Int64
      st_blocks : Int64
      st_blksize : Int32
      st_flags : Int32
      st_gen : Int32
      st_lspare : Int32
      st_qspare0 : Int64
      st_qspare1 : Int64
    end

    fun stat = stat64(path : UInt8*, buf : Stat*) : Int32
    fun lstat = lstat64(path : UInt8*, buf : Stat*) : Int32
    fun fstat = fstat64(fd : Int32, buf : Stat*) : Int32
    fun rename(oldpath : UInt8*, newpath : UInt8*) : Int32
    fun link(oldpath : UInt8*, newpath : UInt8*) : Int32
    fun symlink(target : UInt8*, linkpath : UInt8*) : Int32
    fun readlink(path : UInt8*, buf : UInt8*, bufsiz : UInt64) : Int64
    fun realpath(path : UInt8*, resolved : UInt8*) : UInt8*
    fun chmod(path : UInt8*, mode : Int32) : Int32
    fun chown(path : UInt8*, owner : Int32, group : Int32) : Int32
    fun truncate(path : UInt8*, length : Int64) : Int32
    fun ftruncate(fd : Int32, length : Int64) : Int32
    fun access(path : UInt8*, mode : Int32) : Int32
    fun utimes(path : UInt8*, times : Void*) : Int32
    fun arc4random_buf(buffer : Void*, count : UInt64) : Void
    fun lseek(fd : Int32, offset : Int64, whence : Int32) : Int64
  end
{% elsif flag?(:win32) %}
  # The calls below name this `Std::File::LibKernel32` in full, the way the
  # linux arm names `Std::File::LibC`: these methods live on `class ::File` at
  # the top level, so a body typed outside this unit has no lexical path to a
  # module-level name, and a bare `LibKernel32` came back as "undefined
  # constant" in every module that called `File.rename`.
  #
  # A FILETIME is two DWORDs, and a Win32 structure of DWORDs aligns to four,
  # so the structures below carry each one as its halves rather than as a
  # UInt64: one 8-byte field would bring 8-byte alignment with it and shift
  # every field behind it off the layout the kernel writes.
  lib LibKernel32
    struct WIN32_FILE_ATTRIBUTE_DATA
      dwFileAttributes : UInt32
      ftCreationTimeLow : UInt32
      ftCreationTimeHigh : UInt32
      ftLastAccessTimeLow : UInt32
      ftLastAccessTimeHigh : UInt32
      ftLastWriteTimeLow : UInt32
      ftLastWriteTimeHigh : UInt32
      nFileSizeHigh : UInt32
      nFileSizeLow : UInt32
    end

    struct BY_HANDLE_FILE_INFORMATION
      dwFileAttributes : UInt32
      ftCreationTimeLow : UInt32
      ftCreationTimeHigh : UInt32
      ftLastAccessTimeLow : UInt32
      ftLastAccessTimeHigh : UInt32
      ftLastWriteTimeLow : UInt32
      ftLastWriteTimeHigh : UInt32
      dwVolumeSerialNumber : UInt32
      nFileSizeHigh : UInt32
      nFileSizeLow : UInt32
      nNumberOfLinks : UInt32
      nFileIndexHigh : UInt32
      nFileIndexLow : UInt32
    end

    # The `*W` twin of each path call, never the `*A` one: an `*A` entry point
    # reads its path in the process's active code page, so a name this
    # library was handed as UTF-8 arrived as whatever those bytes spell there
    # and the file it named was not the file the caller meant; and a path past
    # MAX_PATH was refused, because the `\\?\` prefix that lifts the limit is
    # understood by the wide calls alone. Every path below therefore goes
    # through the prelude's `__iyi_wide_path`, which is the one conversion and
    # the one place that prefix is put on. The handle calls further down take
    # no path and stay as they are.
    fun MoveFileExW(oldpath : UInt16*, newpath : UInt16*, flags : UInt32) : Int32
    fun CreateHardLinkW(newpath : UInt16*, oldpath : UInt16*, sec : Void*) : Int32
    # Alone among these, this one answers a BOOLEAN and not a BOOL: one byte,
    # returned in the low eight bits of the register with the rest left as
    # whatever was there. Read as an Int32 it was almost never zero, so a
    # refused symlink — ERROR_PRIVILEGE_NOT_HELD, which is what a machine
    # without SeCreateSymbolicLinkPrivilege and without Developer Mode
    # answers — came back as success and the failure surfaced later, as a
    # `symlink?` that said no about a link that was never made.
    fun CreateSymbolicLinkW(linkpath : UInt16*, target : UInt16*, flags : UInt32) : UInt8
    # A DWORD is declared Int32 here, as the prelude declares it: the same 32
    # bits at the ABI, and one signature per symbol is what a program gets.
    fun GetFileAttributesW(name : UInt16*) : Int32
    # The one bit of a POSIX mode Windows has: `File.chmod` turns the
    # owner's write bit into FILE_ATTRIBUTE_READONLY with this.
    fun SetFileAttributesW(name : UInt16*, attributes : Int32) : Int32
    fun GetFileAttributesExW(path : UInt16*, level : Int32, data : WIN32_FILE_ATTRIBUTE_DATA*) : Int32
    fun CreateFileW(name : UInt16*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
    fun GetFileInformationByHandle(handle : Void*, info : BY_HANDLE_FILE_INFORMATION*) : Int32
    fun CloseHandle(handle : Void*) : Int32
    fun SetFileTime(handle : Void*, creation : Int64*, access : Int64*, write : Int64*) : Int32
    fun GetSystemTimeAsFileTime(time : Int64*) : Void
    fun SetFilePointerEx(handle : Void*, distance : Int64, new_pointer : Int64*, method : Int32) : Int32
    fun SetEndOfFile(handle : Void*) : Int32
    # What a link points at, and where a path really goes. Both were
    # missing, and both answers were made up rather than asked for:
    # `readlink` returned the empty string for every link on this
    # platform and `real_path` handed the caller its own argument back,
    # so a program that followed a link on Windows followed nothing and
    # was told it had succeeded. The reparse point is read raw —
    # `GetFinalPathNameByHandleW` resolves the whole chain, which is
    # `real_path`'s question and not `readlink`'s.
    fun DeviceIoControl(handle : Void*, code : Int32, in_buffer : Void*, in_size : Int32,
                        out_buffer : Void*, out_size : Int32, returned : Int32*,
                        overlapped : Void*) : Int32
    fun GetFinalPathNameByHandleW(handle : Void*, path : UInt16*, count : Int32, flags : Int32) : Int32
    # What the last call's failure was, for a message that says why. A
    # Windows program reads `GetLastError` where a POSIX one reads `errno`,
    # and `FormatMessageW` is the system's own sentence for that number.
    fun GetLastError : Int32
    fun FormatMessageW(flags : Int32, source : Void*, message_id : Int32, language_id : Int32,
                       buffer : UInt16*, size : Int32, arguments : Void*) : Int32
  end
{% else %}
  # Linux: the kernel's own calls, as `socket` and the prelude make them
  # (SPEC.md III.9: an own-prelude object asks libc for nothing). The
  # shape is libc's, so the callers above read the same; a failure comes
  # back as the negative errno the kernel answers, which every caller
  # here reads as "not zero". `realpath` is a walk over `readlinkat` and
  # `newfstatat`, since libc's is a library function and not a call.
  pub struct LibC
    pub struct Timespec
      getter tv_sec : Int64
      getter tv_nsec : Int64

      def initialize
        @tv_sec = 0_i64
        @tv_nsec = 0_i64
      end
    end

    {% if flag?(:aarch64) %}
      # asm-generic `struct stat`, 128 bytes.
      pub struct Stat
        getter st_dev : UInt64
        getter st_ino : UInt64
        getter st_mode : Int32
        getter st_nlink : Int32
        getter st_uid : Int32
        getter st_gid : Int32
        getter st_rdev : UInt64
        getter st_pad1 : UInt64
        getter st_size : Int64
        getter st_blksize : Int32
        getter st_pad2 : Int32
        getter st_blocks : Int64
        getter st_atime : Timespec
        getter st_mtime : Timespec
        getter st_ctime : Timespec
        getter st_unused0 : Int32
        getter st_unused1 : Int32

      def initialize
        @st_dev = 0_u64
        @st_ino = 0_u64
        @st_mode = 0
        @st_nlink = 0
        @st_uid = 0
        @st_gid = 0
        @st_rdev = 0_u64
        @st_pad1 = 0_u64
        @st_size = 0_i64
        @st_blksize = 0
        @st_pad2 = 0
        @st_blocks = 0_i64
        @st_atime = Timespec.new
        @st_mtime = Timespec.new
        @st_ctime = Timespec.new
        @st_unused0 = 0
        @st_unused1 = 0
      end
      end
    {% else %}
      # x86_64 `struct stat`, 144 bytes, the layout glibc shares with the kernel.
      pub struct Stat
        getter st_dev : UInt64
        getter st_ino : UInt64
        getter st_nlink : UInt64
        getter st_mode : Int32
        getter st_uid : Int32
        getter st_gid : Int32
        getter st_pad0 : Int32
        getter st_rdev : UInt64
        getter st_size : Int64
        getter st_blksize : Int64
        getter st_blocks : Int64
        getter st_atime : Timespec
        getter st_mtime : Timespec
        getter st_ctime : Timespec
        getter st_reserved0 : Int64
        getter st_reserved1 : Int64
        getter st_reserved2 : Int64

      def initialize
        @st_dev = 0_u64
        @st_ino = 0_u64
        @st_nlink = 0_u64
        @st_mode = 0
        @st_uid = 0
        @st_gid = 0
        @st_pad0 = 0
        @st_rdev = 0_u64
        @st_size = 0_i64
        @st_blksize = 0_i64
        @st_blocks = 0_i64
        @st_atime = Timespec.new
        @st_mtime = Timespec.new
        @st_ctime = Timespec.new
        @st_reserved0 = 0_i64
        @st_reserved1 = 0_i64
        @st_reserved2 = 0_i64
      end
      end
    {% end %}

    AT_FDCWD           =  -100_i64
    AT_SYMLINK_NOFOLLOW = 0x100_i64

    def self.sys(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64 = 0_i64, e : Int64 = 0_i64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    # Syscall numbers: x86_64 first, aarch64 second.
    {% if flag?(:x86_64) %}
      SYS_NEWFSTATAT = 262_i64
      SYS_FSTAT      =   5_i64
      SYS_RENAMEAT   = 264_i64
      SYS_LINKAT     = 265_i64
      SYS_SYMLINKAT  = 266_i64
      SYS_READLINKAT = 267_i64
      SYS_FCHMODAT   = 268_i64
      SYS_FCHOWNAT   = 260_i64
      SYS_TRUNCATE   =  76_i64
      SYS_FTRUNCATE  =  77_i64
      SYS_FACCESSAT  = 269_i64
      SYS_GETCWD     =  79_i64
      SYS_GETPID     =  39_i64
      SYS_UTIMENSAT  = 280_i64
      SYS_GETRANDOM  = 318_i64
      SYS_LSEEK      =   8_i64
    {% else %}
      SYS_NEWFSTATAT =  79_i64
      SYS_FSTAT      =  80_i64
      SYS_RENAMEAT   =  38_i64
      SYS_LINKAT     =  37_i64
      SYS_SYMLINKAT  =  36_i64
      SYS_READLINKAT =  78_i64
      SYS_FCHMODAT   =  53_i64
      SYS_FCHOWNAT   =  54_i64
      SYS_TRUNCATE   =  45_i64
      SYS_FTRUNCATE  =  46_i64
      SYS_FACCESSAT  =  48_i64
      SYS_GETCWD     =  17_i64
      SYS_GETPID     = 172_i64
      SYS_UTIMENSAT  =  88_i64
      SYS_GETRANDOM  = 278_i64
      SYS_LSEEK      =  62_i64
    {% end %}

    def self.stat(path : UInt8*, buf : Stat*) : Int32
      sys(SYS_NEWFSTATAT, AT_FDCWD, path.address.to_i64, buf.address.to_i64, 0_i64).to_i32
    end

    def self.lstat(path : UInt8*, buf : Stat*) : Int32
      sys(SYS_NEWFSTATAT, AT_FDCWD, path.address.to_i64, buf.address.to_i64, AT_SYMLINK_NOFOLLOW).to_i32
    end

    def self.fstat(fd : Int32, buf : Stat*) : Int32
      sys(SYS_FSTAT, fd.to_i64, buf.address.to_i64, 0_i64).to_i32
    end

    def self.rename(oldpath : UInt8*, newpath : UInt8*) : Int32
      sys(SYS_RENAMEAT, AT_FDCWD, oldpath.address.to_i64, AT_FDCWD, newpath.address.to_i64).to_i32
    end

    def self.link(oldpath : UInt8*, newpath : UInt8*) : Int32
      sys(SYS_LINKAT, AT_FDCWD, oldpath.address.to_i64, AT_FDCWD, newpath.address.to_i64, 0_i64).to_i32
    end

    def self.symlink(target : UInt8*, linkpath : UInt8*) : Int32
      sys(SYS_SYMLINKAT, target.address.to_i64, AT_FDCWD, linkpath.address.to_i64).to_i32
    end

    def self.readlink(path : UInt8*, buf : UInt8*, bufsiz : UInt64) : Int64
      sys(SYS_READLINKAT, AT_FDCWD, path.address.to_i64, buf.address.to_i64, bufsiz.to_i64)
    end

    def self.chmod(path : UInt8*, mode : Int32) : Int32
      sys(SYS_FCHMODAT, AT_FDCWD, path.address.to_i64, mode.to_i64).to_i32
    end

    def self.chown(path : UInt8*, owner : Int32, group : Int32) : Int32
      sys(SYS_FCHOWNAT, AT_FDCWD, path.address.to_i64, owner.to_i64, group.to_i64, 0_i64).to_i32
    end

    def self.truncate(path : UInt8*, length : Int64) : Int32
      sys(SYS_TRUNCATE, path.address.to_i64, length, 0_i64).to_i32
    end

    def self.ftruncate(fd : Int32, length : Int64) : Int32
      sys(SYS_FTRUNCATE, fd.to_i64, length, 0_i64).to_i32
    end

    def self.access(path : UInt8*, mode : Int32) : Int32
      sys(SYS_FACCESSAT, AT_FDCWD, path.address.to_i64, mode.to_i64).to_i32
    end

    # *sec* 0 is "now" (a null timespec, as utimensat documents). Otherwise
    # atime and mtime are both that Unix second.
    def self.utimensat(path : UInt8*, sec : Int64) : Int32
      if sec == 0_i64
        sys(SYS_UTIMENSAT, AT_FDCWD, path.address.to_i64, 0_i64, 0_i64).to_i32
      else
        ts = Pointer(Int64).malloc(4_u64)
        ts[0] = sec
        ts[1] = 0_i64
        ts[2] = sec
        ts[3] = 0_i64
        sys(SYS_UTIMENSAT, AT_FDCWD, path.address.to_i64, ts.address.to_i64, 0_i64).to_i32
      end
    end

    # The absolute path with every `.`, `..` and symbolic link resolved, or
    # null when a component does not exist. Forty links deep is the limit,
    # as it is in libc.
    def self.realpath(path : UInt8*, resolved : UInt8*) : UInt8*
      text = c_text(path)
      return Pointer(UInt8).new(0_u64) if text.bytesize == 0
      if text.to_unsafe[0] != 47_u8
        cwd = Pointer(UInt8).malloc(4096_u64)
        return Pointer(UInt8).new(0_u64) if sys(SYS_GETCWD, cwd.address.to_i64, 4096_i64, 0_i64) < 0_i64
        text = c_text(cwd) + "/" + text
      end
      hops = 0
      done = ""
      rest = text
      while rest.bytesize > 0
        i = 0
        while i < rest.bytesize && rest.to_unsafe[i] == 47_u8
          i = i + 1
        end
        rest = rest[i, rest.bytesize - i]
        break if rest.bytesize == 0
        j = 0
        while j < rest.bytesize && rest.to_unsafe[j] != 47_u8
          j = j + 1
        end
        part = rest[0, j]
        rest = rest[j, rest.bytesize - j]
        next if part == "."
        if part == ".."
          k = done.bytesize
          while k > 0 && done.to_unsafe[k - 1] != 47_u8
            k = k - 1
          end
          done = k > 0 ? done[0, k - 1] : ""
          next
        end
        candidate = done + "/" + part
        buf = Pointer(UInt8).malloc(4096_u64)
        n = readlink(c_bytes(candidate), buf, 4095_u64)
        if n > 0_i64
          hops = hops + 1
          return Pointer(UInt8).new(0_u64) if hops > 40
          target = String.new(n.to_i) { |t| t.copy_from(buf, n.to_i) }
          rest = target + (rest.bytesize > 0 ? "/" + rest : "")
          done = "" if target.to_unsafe[0] == 47_u8
          next
        end
        st = uninitialized Stat
        return Pointer(UInt8).new(0_u64) if lstat(c_bytes(candidate), pointerof(st)) != 0
        done = candidate
      end
      done = "/" if done.bytesize == 0
      return Pointer(UInt8).new(0_u64) if done.bytesize >= 4096
      resolved.copy_from(done.to_unsafe, done.bytesize)
      resolved[done.bytesize] = 0_u8
      resolved
    end

    private def self.c_text(p : UInt8*) : String
      n = 0
      while p[n] != 0_u8
        n = n + 1
      end
      String.new(n) { |t| t.copy_from(p, n) }
    end

    private def self.c_bytes(s : String) : UInt8*
      buf = Pointer(UInt8).malloc(s.bytesize.to_u64 + 1_u64)
      buf.copy_from(s.to_unsafe, s.bytesize)
      buf[s.bytesize] = 0_u8
      buf
    end
  end
{% end %}
class ::File
  {% if flag?(:win32) %}
    # The separator of the platform the program runs on. This said `/` on
    # every target, while `Path` — which every `File.join` goes through —
    # joins with `\` on Windows and `Dir.current` answers `\`: a program
    # that built a path out of this constant got a different separator
    # from one that called `join`, and the two disagreed about the same
    # file. Both forms are accepted wherever a path comes in; this is the
    # one iyi writes.
    SEPARATOR        = '\\'
    SEPARATOR_STRING = "\\"
  {% else %}
    SEPARATOR        = '/'
    SEPARATOR_STRING = "/"
  {% end %}
  import std/path::{Path}

  private def self.sys_path(path : String) : UInt8*
    n = path.bytesize
    ptr = path.to_unsafe
    i = 0
    while i < n
      raise "path contains a NUL byte" if ptr[i] == 0_u8
      i = i + 1
    end
    buffer = Pointer(UInt8).malloc((n + 1).to_u64)
    buffer.copy_from(ptr, n)
    buffer[n] = 0_u8
    buffer
  end

  {% if flag?(:win32) %}
    # Why the last call failed, in Windows' own words. A message that names
    # only what was attempted — "Cannot symlink A to B" — leaves the caller
    # with nothing to act on, and on Windows the difference between "a
    # required privilege is not held" and "the file already exists" is the
    # difference between a machine setting and a bug in the program. The
    # code is kept beside the text because the text is localised and the
    # number is not.
    #
    # FORMAT_MESSAGE_FROM_SYSTEM is 0x1000 and FORMAT_MESSAGE_IGNORE_INSERTS
    # 0x200: without the second, a message with an insert in it fails rather
    # than printing the placeholder. Windows ends these sentences with CRLF
    # and sometimes a trailing space, which is a line break in the middle of
    # a panic, so the tail comes off.
    private def self.win_error : String
      code = Std::File::LibKernel32.GetLastError
      room = 1024
      wide = Pointer(UInt16).malloc(room.to_u64)
      written = Std::File::LibKernel32.FormatMessageW(0x1200, Pointer(Void).new(0_u64), code, 0,
        wide, room - 1, Pointer(Void).new(0_u64))
      return "Windows error #{code}" if written <= 0
      while written > 0 && (wide[written - 1] == 13_u16 || wide[written - 1] == 10_u16 ||
            wide[written - 1] == 32_u16 || wide[written - 1] == 46_u16)
        written = written - 1
      end
      wide[written] = 0_u16
      size = __iyi_utf8_size_from_wide(wide)
      return "Windows error #{code}" if size <= 1
      text = String.new(size - 1) { |t| __iyi_utf8_bytes_from_wide(wide, t, size) }
      "Windows error #{code}: #{text}"
    end
  {% end %}

  enum Type : UInt8
    File            = 0
    Directory       = 1
    Symlink         = 2
    Socket          = 3
    Pipe            = 4
    CharacterDevice = 5
    BlockDevice     = 6
    Unknown         = 7

    def file? : Bool
      value == 0_u8
    end

    def directory? : Bool
      value == 1_u8
    end

    def symlink? : Bool
      value == 2_u8
    end

    def socket? : Bool
      value == 3_u8
    end

    def pipe? : Bool
      value == 4_u8
    end

    def character_device? : Bool
      value == 5_u8
    end

    def block_device? : Bool
      value == 6_u8
    end

    def device? : Bool
      character_device? || block_device?
    end
  end

  struct Permissions
    getter value : Int32

    def initialize(@value : Int32)
    end

    def to_i : Int32
      @value
    end

    def owner_read? : Bool
      (@value & 0o400) != 0
    end

    def owner_write? : Bool
      (@value & 0o200) != 0
    end

    def owner_execute? : Bool
      (@value & 0o100) != 0
    end

    def group_read? : Bool
      (@value & 0o040) != 0
    end

    def group_write? : Bool
      (@value & 0o020) != 0
    end

    def group_execute? : Bool
      (@value & 0o010) != 0
    end

    def other_read? : Bool
      (@value & 0o004) != 0
    end

    def other_write? : Bool
      (@value & 0o002) != 0
    end

    def other_execute? : Bool
      (@value & 0o001) != 0
    end

    def to_s(io : IO) : Nil
      io.write(owner_read? ? "r" : "-")
      io.write(owner_write? ? "w" : "-")
      io.write(owner_execute? ? "x" : "-")
      io.write(group_read? ? "r" : "-")
      io.write(group_write? ? "w" : "-")
      io.write(group_execute? ? "x" : "-")
      io.write(other_read? ? "r" : "-")
      io.write(other_write? ? "w" : "-")
      io.write(other_execute? ? "x" : "-")
    end

    def to_s : String
      res = ""
      res = res + (owner_read? ? "r" : "-")
      res = res + (owner_write? ? "w" : "-")
      res = res + (owner_execute? ? "x" : "-")
      res = res + (group_read? ? "r" : "-")
      res = res + (group_write? ? "w" : "-")
      res = res + (group_execute? ? "x" : "-")
      res = res + (other_read? ? "r" : "-")
      res = res + (other_write? ? "w" : "-")
      res = res + (other_execute? ? "x" : "-")
      res
    end
  end

  struct Flags
    getter value : Int32

    def initialize(@value : Int32 = 0)
    end

    def set_user? : Bool
      (@value & 1) != 0
    end

    def set_group? : Bool
      (@value & 2) != 0
    end

    def sticky? : Bool
      (@value & 4) != 0
    end
  end

  struct Info
    getter size : Int64
    getter permissions : Permissions
    getter type : Type
    getter flags : Flags
    getter modification_time : Int64
    getter owner_id : String
    getter group_id : String
    getter dev : Int64
    getter ino : UInt64

    def initialize(@size : Int64, @permissions : Permissions, @type : Type,
                   @flags : Flags, @modification_time : Int64,
                   @owner_id : String, @group_id : String,
                   @dev : Int64 = 0_i64, @ino : UInt64 = 0_u64)
    end

    def file? : Bool
      @type.file?
    end

    def directory? : Bool
      @type.directory?
    end

    def symlink? : Bool
      @type.symlink?
    end

    def readable? : Bool
      @permissions.owner_read?
    end

    def writable? : Bool
      @permissions.owner_write?
    end

    def executable? : Bool
      @permissions.owner_execute?
    end

    def same_file?(other : Info) : Bool
      @dev == other.dev && @ino == other.ino
    end
  end

  def self.info(path : String | Path, follow_symlinks : Bool = true) : Info
    res = info?(path, follow_symlinks)
    if res
      res
    else
      raise "File not found: #{path.to_s}"
    end
  end

  def self.info?(path : String | Path, follow_symlinks : Bool = true) : Info?
    p = path.to_s
    {% if flag?(:darwin) %}
      stat_buf = uninitialized Std::File::LibC::Stat
      ret = if follow_symlinks
              Std::File::LibC.stat(sys_path(p), pointerof(stat_buf))
            else
              Std::File::LibC.lstat(sys_path(p), pointerof(stat_buf))
            end
      return nil if ret != 0

      mode_int = stat_buf.st_mode_nlink.to_i64 & 0xffff_i64
      perms = Permissions.new((mode_int & 0o777_i64).to_i32)

      file_type = case mode_int & 0o170000_i64
                  when 0o100000_i64 then Type::File
                  when 0o040000_i64 then Type::Directory
                  when 0o120000_i64 then Type::Symlink
                  when 0o140000_i64 then Type::Socket
                  when 0o010000_i64 then Type::Pipe
                  when 0o020000_i64 then Type::CharacterDevice
                  when 0o060000_i64 then Type::BlockDevice
                  else                   Type::Unknown
                  end

      flag_val = 0
      flag_val = flag_val | 1 if (mode_int & 0o4000_i64) != 0
      flag_val = flag_val | 2 if (mode_int & 0o2000_i64) != 0
      flag_val = flag_val | 4 if (mode_int & 0o1000_i64) != 0
      file_flags = Flags.new(flag_val)

      mtime = stat_buf.st_mtimespec.tv_sec
      owner = stat_buf.st_uid.to_s
      group = stat_buf.st_gid.to_s
      dev = stat_buf.st_dev.to_i64
      ino = stat_buf.st_ino

      Info.new(stat_buf.st_size, perms, file_type, file_flags, mtime, owner, group, dev, ino)
    {% elsif flag?(:linux) %}
      stat_buf = uninitialized Std::File::LibC::Stat
      ret = if follow_symlinks
              Std::File::LibC.stat(sys_path(p), pointerof(stat_buf))
            else
              Std::File::LibC.lstat(sys_path(p), pointerof(stat_buf))
            end
      return nil if ret != 0

      mode_int = stat_buf.st_mode.to_i64 & 0xffff_i64
      perms = Permissions.new((mode_int & 0o777_i64).to_i32)

      file_type = case mode_int & 0o170000_i64
                  when 0o100000_i64 then Type::File
                  when 0o040000_i64 then Type::Directory
                  when 0o120000_i64 then Type::Symlink
                  when 0o140000_i64 then Type::Socket
                  when 0o010000_i64 then Type::Pipe
                  when 0o020000_i64 then Type::CharacterDevice
                  when 0o060000_i64 then Type::BlockDevice
                  else                   Type::Unknown
                  end

      flag_val = 0
      flag_val = flag_val | 1 if (mode_int & 0o4000_i64) != 0
      flag_val = flag_val | 2 if (mode_int & 0o2000_i64) != 0
      flag_val = flag_val | 4 if (mode_int & 0o1000_i64) != 0
      file_flags = Flags.new(flag_val)

      mtime = stat_buf.st_mtime.tv_sec
      owner = stat_buf.st_uid.to_s
      group = stat_buf.st_gid.to_s
      dev = stat_buf.st_dev.to_i64
      ino = stat_buf.st_ino

      Info.new(stat_buf.st_size, perms, file_type, file_flags, mtime, owner, group, dev, ino)
    {% elsif flag?(:win32) %}
      wpath = __iyi_wide_path(sys_path(p))
      return nil if wpath.address == 0_u64
      data = uninitialized Std::File::LibKernel32::WIN32_FILE_ATTRIBUTE_DATA
      # 0 is GetFileExInfoStandard, the one level this call answers.
      if Std::File::LibKernel32.GetFileAttributesExW(wpath, 0, pointerof(data)) == 0
        return nil
      end

      attrs = data.dwFileAttributes
      size = ((data.nFileSizeHigh.to_u64 << 32) | data.nFileSizeLow.to_u64).to_i64
      write_ticks = ((data.ftLastWriteTimeHigh.to_u64 << 32) | data.ftLastWriteTimeLow.to_u64).to_i64

      # The attribute call carries no file identity and answers about the path
      # itself, so the handle is asked for both. FILE_FLAG_BACKUP_SEMANTICS
      # (0x2000000) is what opens a directory; leaving
      # FILE_FLAG_OPEN_REPARSE_POINT (0x200000) off resolves a symlink to its
      # target, which is the whole difference between `stat` and `lstat` here.
      # A path another process holds exclusively opens for neither, and then
      # the attributes above are the whole answer and the identity stays 0 —
      # `same_file?` reads two of those as the same file, which is as far as
      # attribute data can go.
      dev = 0_i64
      ino = 0_u64
      open_flags = follow_symlinks ? 0x2000000 : 0x2200000
      handle = Std::File::LibKernel32.CreateFileW(wpath, 0, 0x7, Pointer(Void).new(0_u64), 3, open_flags, Pointer(Void).new(0_u64))
      if handle.address != 0xFFFFFFFFFFFFFFFF_u64
        by_handle = uninitialized Std::File::LibKernel32::BY_HANDLE_FILE_INFORMATION
        if Std::File::LibKernel32.GetFileInformationByHandle(handle, pointerof(by_handle)) != 0
          attrs = by_handle.dwFileAttributes
          size = ((by_handle.nFileSizeHigh.to_u64 << 32) | by_handle.nFileSizeLow.to_u64).to_i64
          write_ticks = ((by_handle.ftLastWriteTimeHigh.to_u64 << 32) | by_handle.ftLastWriteTimeLow.to_u64).to_i64
          dev = by_handle.dwVolumeSerialNumber.to_i64
          ino = (by_handle.nFileIndexHigh.to_u64 << 32) | by_handle.nFileIndexLow.to_u64
        end
        Std::File::LibKernel32.CloseHandle(handle)
      end

      # A reparse point is read first: a directory symlink carries the
      # directory attribute too.
      file_type = if (attrs & 0x400_u32) != 0_u32
                    Type::Symlink
                  elsif (attrs & 0x10_u32) != 0_u32
                    Type::Directory
                  else
                    Type::File
                  end

      # Windows has no mode, no uid, no gid and no link count: what it has is
      # an ACL, and this struct has no field for one. The permissions are the
      # 0o755 a directory and the 0o644 a file get from a default umask on
      # posix, and the ids are the "0" a posix stat answers for root — said
      # here rather than dressed up as an owner nobody set.
      #
      # The one real bit is FILE_ATTRIBUTE_READONLY (0x1), which is what
      # `File.chmod` writes and therefore what `writable?` has to read: with
      # the default alone, a file `File.chmod(path, 0o444)` had just made
      # read-only still answered `writable? true` and the next write
      # panicked, which is the library disagreeing with itself.
      mode = file_type.directory? ? 0o755 : 0o644
      mode = mode & ~0o222 if (attrs & 0x1_u32) != 0_u32
      perms = Permissions.new(mode)

      # A FILETIME is 100-nanosecond ticks from 1601-01-01, and
      # `modification_time` is the unix second the posix arms read out of
      # `st_mtime`.
      mtime = (write_ticks - 116444736000000000_i64) // 10000000_i64

      Info.new(size, perms, file_type, Flags.new(0), mtime, "0", "0", dev, ino)
    {% else %}
      nil
    {% end %}
  end

  def self.size(path : String | Path) : Int64
    info(path).size
  end

  def self.file?(path : String | Path) : Bool
    inf = info?(path)
    inf ? inf.file? : false
  end

  def self.directory?(path : String | Path) : Bool
    inf = info?(path)
    inf ? inf.directory? : false
  end

  def self.symlink?(path : String | Path) : Bool
    inf = info?(path, follow_symlinks: false)
    inf ? inf.symlink? : false
  end

  def self.readable?(path : String | Path) : Bool
    {% if flag?(:darwin) || flag?(:linux) %}
      Std::File::LibC.access(sys_path(path.to_s), 4) == 0
    {% else %}
      inf = info?(path)
      inf ? inf.readable? : false
    {% end %}
  end

  def self.writable?(path : String | Path) : Bool
    {% if flag?(:darwin) || flag?(:linux) %}
      Std::File::LibC.access(sys_path(path.to_s), 2) == 0
    {% else %}
      inf = info?(path)
      inf ? inf.writable? : false
    {% end %}
  end

  def self.executable?(path : String | Path) : Bool
    {% if flag?(:darwin) || flag?(:linux) %}
      Std::File::LibC.access(sys_path(path.to_s), 1) == 0
    {% else %}
      inf = info?(path)
      inf ? inf.executable? : false
    {% end %}
  end

  def self.empty?(path : String | Path) : Bool
    inf = info?(path)
    inf ? inf.size == 0_i64 : false
  end

  def self.same?(path1 : String | Path, path2 : String | Path) : Bool
    i1 = info?(path1)
    i2 = info?(path2)
    return false unless i1 && i2
    i1.same_file?(i2)
  end

  def self.same_content?(path1 : String | Path, path2 : String | Path) : Bool
    p1 = path1.to_s
    p2 = path2.to_s
    return false unless file?(p1) && file?(p2)
    s1 = size(p1)
    s2 = size(p2)
    return false if s1 != s2
    File.read(p1) == File.read(p2)
  end

  # *time* 0 is "now"; any other value is the Unix second both atime and
  # mtime are set to.
  #
  # The darwin branch passed a null `times` to `utimes`, which is the
  # kernel's spelling of "now" — so `touch(path, 1)` set the clock's time
  # there and the epoch second on Linux, one name with two behaviours
  # decided by the platform (SPEC.md III.1.7a). It writes the pair now, in
  # the same shape the Linux branch writes its `timespec`s: `timeval` is an
  # `Int64` second and an `Int32` microsecond padded to eight, so four
  # `Int64` slots are the two structures and the odd slots are the
  # microseconds, zero.
  def self.touch(path : String | Path, time : Int64 = 0_i64) : Nil
    p = path.to_s
    File.write(p, "") unless File.exists?(p)
    {% if flag?(:linux) %}
      if Std::File::LibC.utimensat(sys_path(p), time) != 0
        raise "Cannot touch #{p}"
      end
    {% elsif flag?(:darwin) %}
      times = Pointer(Void).new(0_u64)
      if time != 0_i64
        tv = Pointer(Int64).malloc(4_u64)
        tv[0] = time
        tv[1] = 0_i64
        tv[2] = time
        tv[3] = 0_i64
        times = tv.as(Void*)
      end
      if Std::File::LibC.utimes(sys_path(p), times) != 0
        raise "Cannot touch #{p}"
      end
    {% elsif flag?(:win32) %}
      # FILE_WRITE_ATTRIBUTES (0x100) is the whole of what SetFileTime asks
      # for, and FILE_FLAG_BACKUP_SEMANTICS (0x2000000) is what opens a
      # directory. Both times are written, the way the arms above write the
      # pair: a FILETIME is 100-nanosecond ticks from 1601-01-01, and *time* 0
      # is the clock, which the kernel reads out in those ticks already.
      wpath = __iyi_wide_path(sys_path(p))
      if wpath.address == 0_u64
        raise "Cannot touch #{p}: the path is not valid UTF-8"
      end
      handle = Std::File::LibKernel32.CreateFileW(wpath, 0x100, 0x7, Pointer(Void).new(0_u64), 3, 0x2000000, Pointer(Void).new(0_u64))
      if handle.address == 0xFFFFFFFFFFFFFFFF_u64
        raise "Cannot touch #{p}: #{win_error}"
      end
      ticks = uninitialized Int64
      if time == 0_i64
        Std::File::LibKernel32.GetSystemTimeAsFileTime(pointerof(ticks))
      else
        ticks = time * 10000000_i64 + 116444736000000000_i64
      end
      written = Std::File::LibKernel32.SetFileTime(handle, Pointer(Int64).new(0_u64), pointerof(ticks), pointerof(ticks))
      Std::File::LibKernel32.CloseHandle(handle)
      if written == 0
        raise "Cannot touch #{p}: #{win_error}"
      end
    {% end %}
  end

  def self.touch?(path : String | Path, time : Int64 = 0_i64) : Bool
    touch(path, time)
    true
  end

  def self.rename(old_path : String | Path, new_path : String | Path) : Nil
    o = old_path.to_s
    n = new_path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if Std::File::LibC.rename(sys_path(o), sys_path(n)) != 0
        raise "Cannot rename #{o} to #{n}"
      end
    {% elsif flag?(:win32) %}
      # MoveFileW refuses a destination that exists, where posix `rename`
      # replaces it: MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED is the
      # same method's meaning, the second flag so a move across volumes is a
      # copy rather than a refusal.
      old_wide = __iyi_wide_path(sys_path(o))
      new_wide = __iyi_wide_path(sys_path(n))
      if old_wide.address == 0_u64 || new_wide.address == 0_u64
        raise "Cannot rename #{o} to #{n}: a path is not valid UTF-8"
      end
      if Std::File::LibKernel32.MoveFileExW(old_wide, new_wide, 0x3_u32) == 0
        # A destination that exists *and* is read-only refuses the
        # replacement with ERROR_ACCESS_DENIED, where posix `rename`
        # asks the directory and overwrites whatever mode the target
        # had — measured, renaming onto a name `File.chmod 0o444` had
        # marked died here. The attribute comes off for one retry and
        # goes back when that still refuses, the same shape
        # `__iyi_unlink` and `Dir.delete` have.
        replaced = false
        if Std::File::LibKernel32.GetLastError == 5
          attributes = Std::File::LibKernel32.GetFileAttributesW(new_wide)
          if attributes != -1 && (attributes & 1) != 0 &&
             Std::File::LibKernel32.SetFileAttributesW(new_wide, attributes - 1) != 0
            replaced = Std::File::LibKernel32.MoveFileExW(old_wide, new_wide, 0x3_u32) != 0
            Std::File::LibKernel32.SetFileAttributesW(new_wide, attributes) unless replaced
          end
        end
        raise "Cannot rename #{o} to #{n}: #{win_error}" unless replaced
      end
    {% end %}
  end

  def self.link(old_path : String | Path, new_path : String | Path) : Nil
    o = old_path.to_s
    n = new_path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if Std::File::LibC.link(sys_path(o), sys_path(n)) != 0
        raise "Cannot link #{o} to #{n}"
      end
    {% elsif flag?(:win32) %}
      old_wide = __iyi_wide_path(sys_path(o))
      new_wide = __iyi_wide_path(sys_path(n))
      if old_wide.address == 0_u64 || new_wide.address == 0_u64
        raise "Cannot link #{o} to #{n}: a path is not valid UTF-8"
      end
      if Std::File::LibKernel32.CreateHardLinkW(new_wide, old_wide, Pointer(Void).new(0_u64)) == 0
        raise "Cannot link #{o} to #{n}: #{win_error}"
      end
    {% end %}
  end

  def self.symlink(old_path : String | Path, new_path : String | Path) : Nil
    o = old_path.to_s
    n = new_path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if Std::File::LibC.symlink(sys_path(o), sys_path(n)) != 0
        raise "Cannot symlink #{o} to #{n}"
      end
    {% elsif flag?(:win32) %}
      # 0x2 is SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE, without which a
      # user who is not an administrator is refused with
      # ERROR_PRIVILEGE_NOT_HELD even with Developer Mode on; 0x1 says the
      # target is a directory, which Windows decides when the link is made
      # rather than reading it off the target the way posix does.
      # INVALID_FILE_ATTRIBUTES is 0xFFFFFFFF, which is what that DWORD
      # spells as the Int32 it is declared as. The target's attributes are
      # read off the wide path already in hand rather than through the
      # prelude's `__iyi_path_attributes`, which would convert the same string
      # a second time to arrive at the same pointer.
      old_wide = __iyi_wide_path(sys_path(o))
      new_wide = __iyi_wide_path(sys_path(n))
      if old_wide.address == 0_u64 || new_wide.address == 0_u64
        raise "Cannot symlink #{o} to #{n}: the path is not valid UTF-8"
      end
      target_attrs = Std::File::LibKernel32.GetFileAttributesW(old_wide)
      link_flags = 0x2_u32
      if target_attrs != -1 && (target_attrs & 0x10) != 0
        link_flags = link_flags | 0x1_u32
      end
      if Std::File::LibKernel32.CreateSymbolicLinkW(new_wide, old_wide, link_flags) == 0_u8
        raise "Cannot symlink #{o} to #{n}: #{win_error}"
      end
    {% end %}
  end

  def self.readlink(path : String | Path) : String
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      buf = Pointer(UInt8).malloc(4096_u64)
      res = Std::File::LibC.readlink(sys_path(p), buf, 4096_u64)
      if res <= 0_i64
        raise "Cannot readlink: #{p}"
      end
      String.new(res.to_i) { |t| t.copy_from(buf, res.to_i) }
    {% elsif flag?(:win32) %}
      # The stored target, not the resolved one: this is `readlink`, so the
      # reparse point is read as it was written. FILE_FLAG_OPEN_REPARSE_POINT
      # (0x200000) opens the link instead of following it, and
      # FILE_FLAG_BACKUP_SEMANTICS (0x2000000) is what lets a directory link
      # be opened at all. FSCTL_GET_REPARSE_POINT is 0x900A8, and the buffer
      # it fills is the tag (4 bytes), the data length (2), two reserved (2),
      # and then, for a symbolic link, four 16-bit offsets and a 32-bit flag
      # word before the wide characters at offset 20. A junction —
      # IO_REPARSE_TAG_MOUNT_POINT — has no flag word, so its names start at
      # 16. Windows writes the substitute name as `\??\C:\...`, which is the
      # object-manager spelling of the same path and not something a caller
      # can hand back to `File.read`, so those four bytes come off.
      wide = __iyi_wide_path(sys_path(p))
      raise "Cannot readlink: #{p} is not valid UTF-8" if wide.address == 0_u64
      handle = Std::File::LibKernel32.CreateFileW(wide, 0, 0x7, Pointer(Void).new(0_u64),
        3, 0x2200000, Pointer(Void).new(0_u64))
      raise "Cannot readlink: #{p}: #{win_error}" if handle.address &+ 1_u64 == 0_u64
      buffer = Pointer(UInt8).malloc(16384_u64)
      returned = 0
      ok = Std::File::LibKernel32.DeviceIoControl(handle, 0x900A8, Pointer(Void).new(0_u64), 0,
        buffer.as(Void*), 16384, pointerof(returned),
        Pointer(Void).new(0_u64))
      Std::File::LibKernel32.CloseHandle(handle)
      raise "Cannot readlink: #{p}: #{win_error}" if ok == 0
      raise "Cannot readlink: #{p}: the reparse point is #{returned} bytes, too few to hold a target" if returned < 9
      tag = buffer.as(UInt32*).value
      names_at = if tag == 0xA000000C_u32
                   20
                 elsif tag == 0xA0000003_u32
                   16
                 else
                   raise "Cannot readlink: #{p} is not a link"
                 end
      name_offset = (buffer + 8).as(UInt16*).value.to_i32
      name_bytes = (buffer + 10).as(UInt16*).value.to_i32
      raise "Cannot readlink: #{p}: the reparse point names #{name_bytes} bytes at #{names_at + name_offset} of #{returned}" if name_bytes <= 0 || names_at + name_offset + name_bytes > returned
      chars = name_bytes // 2
      target = Pointer(UInt16).malloc((chars + 1).to_u64)
      target.copy_from((buffer + (names_at + name_offset).to_i64).as(UInt16*), chars)
      target[chars] = 0_u16
      if chars >= 4 && target[0] == 92_u16 && target[1] == 63_u16 && target[2] == 63_u16 && target[3] == 92_u16
        target = target + 4
      end
      size = __iyi_utf8_size_from_wide(target)
      raise "Cannot readlink: #{p}: the target Windows stored is not convertible to UTF-8" if size <= 0
      String.new(size - 1) { |t| __iyi_utf8_bytes_from_wide(target, t, size) }
    {% else %}
      ""
    {% end %}
  end

  def self.real_path(path : String | Path) : String
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      buf = Pointer(UInt8).malloc(4096_u64)
      res = Std::File::LibC.realpath(sys_path(p), buf)
      if res.address == 0_u64
        raise "Cannot resolve realpath for #{p}"
      end
      len = 0
      while res[len] != 0_u8
        len = len + 1
      end
      String.new(len) { |t| t.copy_from(res, len) }
    {% elsif flag?(:win32) %}
      # `realpath`'s answer is the path with every link followed and every
      # `.`, `..` and short name gone, and the only thing on Windows that
      # knows it is the file system: `GetFinalPathNameByHandleW` over an
      # open handle. FILE_FLAG_BACKUP_SEMANTICS (0x2000000) is there so a
      # directory can be opened; VOLUME_NAME_DOS (0) asks for a drive letter
      # rather than a volume GUID. The answer arrives with the `\\?\`
      # prefix, which is Windows' own spelling for "do not parse this
      # again" and not part of the name, so it comes off — except for a UNC
      # path, where `\\?\UNC\server\share` goes back to `\\server\share`.
      # This used to hand the caller its argument back unchanged, which was
      # wrong for every path with a link, a dot or a relative segment in it,
      # and said nothing about a path that does not exist.
      wide = __iyi_wide_path(sys_path(p))
      raise "Cannot resolve realpath for #{p}: the path is not valid UTF-8" if wide.address == 0_u64
      handle = Std::File::LibKernel32.CreateFileW(wide, 0, 0x7, Pointer(Void).new(0_u64),
        3, 0x2000000, Pointer(Void).new(0_u64))
      raise "Cannot resolve realpath for #{p}: #{win_error}" if handle.address &+ 1_u64 == 0_u64
      room = 32768
      full = Pointer(UInt16).malloc(room.to_u64)
      written = Std::File::LibKernel32.GetFinalPathNameByHandleW(handle, full, room - 1, 0)
      Std::File::LibKernel32.CloseHandle(handle)
      raise "Cannot resolve realpath for #{p}: #{win_error}" if written <= 0
      raise "Cannot resolve realpath for #{p}: the resolved path is #{written} characters, past the #{room} this asks for" if written >= room
      resolved = full
      if written > 8 && full[0] == 92_u16 && full[1] == 92_u16 && full[2] == 63_u16 && full[3] == 92_u16
        if full[4] == 85_u16 && full[5] == 78_u16 && full[6] == 67_u16 && full[7] == 92_u16
          resolved = full + 6
          resolved[0] = 92_u16
          resolved[1] = 92_u16
        else
          resolved = full + 4
        end
      end
      size = __iyi_utf8_size_from_wide(resolved)
      raise "Cannot resolve realpath for #{p}: the path Windows resolved is not convertible to UTF-8" if size <= 0
      String.new(size - 1) { |t| __iyi_utf8_bytes_from_wide(resolved, t, size) }
    {% else %}
      p
    {% end %}
  end

  def self.chmod(path : String | Path, mode : Int32) : Nil
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if Std::File::LibC.chmod(sys_path(p), mode) != 0
        raise "Cannot chmod #{p}"
      end
    {% elsif flag?(:win32) %}
      # Windows has one bit of this, and it is the one callers use: a file
      # is read-only or it is not (FILE_ATTRIBUTE_READONLY, 0x1). There are
      # no owner, group and other bits to set — an ACL is a different
      # model and a different call — so the owner's write bit decides, and
      # the rest of *mode* has nowhere to go.
      #
      # This used to do nothing at all, and the silence was the defect:
      # `File.chmod(path, 0o444)` left `File.writable?` answering true and
      # the next `File.write` succeeded, so a program that asked for a
      # file to be unwritable was told it had been.
      attrs = __iyi_path_attributes(sys_path(p))
      raise "Cannot chmod #{p}: #{win_error}" if attrs == -1
      wanted = mode & 0o200 == 0 ? attrs | 0x1 : attrs & ~0x1
      if wanted != attrs
        wide = __iyi_wide_path(sys_path(p))
        raise "Cannot chmod #{p}: the path is not valid UTF-8" if wide.address == 0_u64
        if Std::File::LibKernel32.SetFileAttributesW(wide, wanted) == 0
          raise "Cannot chmod #{p}: #{win_error}"
        end
      end
    {% end %}
  end

  def self.chown(path : String | Path, uid : Int32, gid : Int32) : Nil
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if Std::File::LibC.chown(sys_path(p), uid, gid) != 0
        raise "Cannot chown #{p}"
      end
    {% end %}
    # Nothing on Windows, deliberately: a file's owner there is a SID in a
    # security descriptor, not a numeric uid and gid, so there is no
    # honest thing to do with the two numbers this takes. A Windows
    # program that means to change an owner wants a different call and a
    # different signature, and inventing one here would be a method that
    # looks portable and is not.
  end

  def self.truncate(path : String | Path, size : Int64 = 0_i64) : Nil
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if Std::File::LibC.truncate(sys_path(p), size) != 0
        raise "Cannot truncate #{p}"
      end
    {% elsif flag?(:win32) %}
      # GENERIC_WRITE (0x40000000) is what moving the end of a file asks for.
      # The pointer is placed from FILE_BEGIN (0) and SetEndOfFile cuts there,
      # which extends with zeroes past the end exactly as posix `truncate`
      # does.
      wpath = __iyi_wide_path(sys_path(p))
      if wpath.address == 0_u64
        raise "Cannot truncate #{p}: the path is not valid UTF-8"
      end
      handle = Std::File::LibKernel32.CreateFileW(wpath, 0x40000000, 0x7, Pointer(Void).new(0_u64), 3, 0, Pointer(Void).new(0_u64))
      if handle.address == 0xFFFFFFFFFFFFFFFF_u64
        raise "Cannot truncate #{p}: #{win_error}"
      end
      if Std::File::LibKernel32.SetFilePointerEx(handle, size, Pointer(Int64).new(0_u64), 0) == 0
        message = "Cannot truncate #{p}: #{win_error}"
        Std::File::LibKernel32.CloseHandle(handle)
        raise message
      end
      cut = Std::File::LibKernel32.SetEndOfFile(handle)
      Std::File::LibKernel32.CloseHandle(handle)
      if cut == 0
        raise "Cannot truncate #{p}: #{win_error}"
      end
    {% end %}
  end

  def self.basename(path : String | Path, suffix : String? = nil) : String
    Path.new(path.to_s).basename(suffix)
  end

  def self.dirname(path : String | Path) : String
    Path.new(path.to_s).dirname
  end

  def self.extname(path : String | Path) : String
    Path.new(path.to_s).extension
  end

  def self.expand_path(path : String | Path, base : String? = nil) : String
    Path.new(path.to_s).expand(base, home: true).to_s
  end

  def self.join(first : String | Path, second : String | Path) : String
    Path.new(first.to_s).join(second.to_s).to_s
  end

  def self.join(first : String | Path, second : String | Path, third : String | Path) : String
    Path.new(first.to_s).join(second.to_s).join(third.to_s).to_s
  end

  def self.join(parts : Array(String)) : String
    p = Path.new("")
    parts.each do |part|
      p = p.join(part)
    end
    p.to_s
  end

  def self.read_lines(path : String | Path) : Array(String)
    content = File.read(path.to_s)
    res = [] of String
    len = content.bytesize
    ptr = content.to_unsafe
    line_start = 0
    i = 0
    while i < len
      if ptr[i] == 10_u8
        line_len = i - line_start
        # Strip CR if CRLF
        line_len = line_len - 1 if line_len > 0 && ptr[line_start + line_len - 1] == 13_u8
        res << String.new(line_len) { |t| t.copy_from(ptr + line_start, line_len) }
        line_start = i + 1
      end
      i = i + 1
    end
    if line_start < len
      rem_len = len - line_start
      rem_len = rem_len - 1 if rem_len > 0 && ptr[line_start + rem_len - 1] == 13_u8
      res << String.new(rem_len) { |t| t.copy_from(ptr + line_start, rem_len) }
    end
    res
  end

  def self.each_line(path : String | Path, &block : String -> Nil) : Nil
    lines = read_lines(path)
    lines.each do |l|
      yield l
    end
  end

  def self.match?(path : String | Path, pattern : String) : Bool
    glob_match_at(path.to_s, 0, pattern, 0)
  end

  private def self.glob_match_at(name : String, ni : Int32, pattern : String, pi : Int32) : Bool
    nlen = name.bytesize
    plen = pattern.bytesize
    nptr = name.to_unsafe
    pptr = pattern.to_unsafe
    while pi < plen
      pc = pptr[pi]
      if pc == 42_u8
        while pi < plen && pptr[pi] == 42_u8
          pi = pi + 1
        end
        return true if pi == plen
        while ni <= nlen
          return true if glob_match_at(name, ni, pattern, pi)
          ni = ni + 1
        end
        return false
      elsif pc == 63_u8
        return false if ni >= nlen
        ni = ni + 1
        pi = pi + 1
      else
        return false if ni >= nlen || nptr[ni] != pc
        ni = ni + 1
        pi = pi + 1
      end
    end
    ni == nlen
  end

  @@temp_counter = 0_u64

  # A new, empty file in the temporary directory, and its path.
  #
  # Made with an exclusive create - `O_CREAT | O_EXCL`, `CREATE_NEW` on
  # Windows - which fails when anything is at the path, a symlink
  # included, rather than asked whether something is there and written
  # after. The name was the process id and a counter, and the file was
  # written wherever the path led if nothing was there when asked: a
  # symlink planted at the next name in a shared `/tmp` between the
  # question and the write sent an upload wherever its owner pointed it.
  # The name is sixteen hex digits of the system's randomness now, so it
  # cannot be planted in advance either; Windows' `%TEMP%` belongs to the
  # user, and there the create's refusal is the guarantee and the name
  # needs only to be new. The file is the owner's alone, mode 0600.
  def self.tempfile(prefix : String = "tmp", suffix : String = "") : String
    # Where the environment says, and the platform's own default only when
    # it says nothing — the same order `Dir.tempdir` reads, because the two
    # answering different directories is how a program writes a temporary
    # file somewhere it cannot later find it. On Windows the hardcoded
    # fallback was `C:\Windows\Temp`, which is a system directory an
    # ordinary account cannot write to: measured, this answered
    # `C:\Windows\Temp/wperm_0_1001` — a mixed separator and a path that
    # only worked because the session was elevated — while `TEMP` named the
    # per-user directory all along.
    tmpdir = ""
    named = Program.env("TMPDIR")
    tmpdir = named if named && !named.empty?
    if tmpdir.empty?
      named = Program.env("TEMP")
      tmpdir = named if named && !named.empty?
    end
    if tmpdir.empty?
      named = Program.env("TMP")
      tmpdir = named if named && !named.empty?
    end
    if tmpdir.empty?
      {% if flag?(:win32) %}
        tmpdir = "C:\\Windows\\Temp"
      {% else %}
        tmpdir = "/tmp"
      {% end %}
    end
    # One trailing separator off, as `Dir.tempdir` does: darwin's TMPDIR
    # ends with one, and the name below adds its own.
    last = tmpdir[tmpdir.bytesize - 1]
    if tmpdir.bytesize > 1 && (last == '/' || last == File::SEPARATOR)
      tmpdir = tmpdir[0, tmpdir.bytesize - 1]
    end
    attempt = 0
    while attempt < 100
      path = tmpdir + File::SEPARATOR_STRING + prefix + "_" + temp_token + suffix
      return path if create_new(path)
      attempt = attempt + 1
    end
    raise "Cannot create tempfile in #{tmpdir}: a hundred fresh names were all taken"
  end

  # Sixteen hex digits nobody could have guessed: the kernel's randomness
  # where a call reaches it without another library, the clock and a
  # counter where the create alone is the guarantee.
  private def self.temp_token : String
    word = 0_u64
    {% if flag?(:linux) %}
      got = Std::File::LibC.sys(Std::File::LibC::SYS_GETRANDOM, pointerof(word).address.to_i64, 8_i64, 0_i64)
      raise "Cannot create tempfile: getrandom failed (#{got})" if got != 8_i64
    {% elsif flag?(:darwin) %}
      Std::File::LibC.arc4random_buf(pointerof(word).as(Void*), 8_u64)
    {% elsif flag?(:win32) %}
      @@temp_counter = @@temp_counter &+ 1_u64
      now = 0_i64
      Std::File::LibKernel32.GetSystemTimeAsFileTime(pointerof(now))
      word = (now.unsafe_to_u64 ^ @@temp_counter.unsafe_shl(40_u64)) &* 0x9E3779B97F4A7C15_u64
    {% else %}
      @@temp_counter = @@temp_counter &+ 1_u64
      word = @@temp_counter &* 0x9E3779B97F4A7C15_u64
    {% end %}
    digits = "0123456789abcdef"
    String.new(16) do |buffer|
      index = 15
      while index >= 0
        buffer[index] = digits.to_unsafe[(word & 15_u64).to_i32]
        word = word.unsafe_shr(4_u64)
        index = index - 1
      end
    end
  end

  # True when the file was made here and now; false when something was
  # already at the path, whatever it is; a panic for any other refusal.
  private def self.create_new(path : String) : Bool
    {% if flag?(:linux) %}
      # O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, mode 0600. EEXIST is 17.
      fd = __iyi_openat(sys_path(path), 1 | 64 | 128 | 0x80000, 384)
      return false if fd == -17_i64
      raise "Cannot create tempfile #{path}: error #{-fd}" if fd < 0
      __iyi_close(fd)
      true
    {% elsif flag?(:darwin) %}
      # O_WRONLY | O_CREAT | O_EXCL, mode 0600.
      fd = ::LibC.open(sys_path(path), 1 | 0x200 | 0x800, 384)
      if fd < 0
        return false if symlink?(path) || exists?(path)
        raise "Cannot create tempfile #{path}"
      end
      ::LibC.close(fd)
      true
    {% elsif flag?(:win32) %}
      # GENERIC_WRITE, CREATE_NEW (1), FILE_ATTRIBUTE_NORMAL.
      # ERROR_FILE_EXISTS is 80, ERROR_ALREADY_EXISTS 183.
      handle = Std::File::LibKernel32.CreateFileW(__iyi_wide_path(sys_path(path)), 0x40000000, 0x7,
        Pointer(Void).new(0_u64), 1, 0x80, Pointer(Void).new(0_u64))
      if handle.address == 0xFFFFFFFFFFFFFFFF_u64
        code = Std::File::LibKernel32.GetLastError
        return false if code == 80 || code == 183
        raise "Cannot create tempfile #{path}: #{win_error}"
      end
      Std::File::LibKernel32.CloseHandle(handle)
      true
    {% else %}
      return false if exists?(path)
      File.write(path, "")
      true
    {% end %}
  end

  def self.tempfile(prefix : String = "tmp", suffix : String = "", &block : String -> Nil) : Nil
    p = tempfile(prefix, suffix)
    defer File.delete(p)
    yield p
  end
end

# Where in an open file the next read or write happens, and moving it:
# Crystal's `IO#seek`, `#pos` and `#pos=`. A large file, or a range of
# one, is sent from where it lies rather than read whole into memory
# first. What is buffered goes first: the writes are flushed before the
# move, and read-ahead the move skips is dropped, so the next read is
# from the new place.
class ::IyiIO
  enum Seek
    Set     = 0
    Current = 1
    End     = 2
  end

  # Moves to *offset* from the start, from here, or from the end, and
  # answers the new position.
  def seek(offset : Int64, whence : Seek = Seek::Set) : Int64
    raise "cannot seek a closed IO" if closed?
    # The kernel's position is past what was read ahead, so "from here"
    # is from where the program has read to.
    offset = offset - (@read_limit - @read_pos).to_i64 if whence == Seek::Current && @read_limit > @read_pos
    flush
    moved = IyiIO.lseek(handle, offset, whence.value.to_i32)
    raise "cannot seek to #{offset} (#{whence}): error #{-moved}" if moved < 0_i64
    @read_pos = 0
    @read_limit = 0
    @eof = false
    moved
  end

  def seek(offset : Int32, whence : Seek = Seek::Set) : Int64
    seek(offset.to_i64, whence)
  end

  # Bytes from the start to where the next read or write happens.
  def pos : Int64
    raise "cannot ask a closed IO its position" if closed?
    here = IyiIO.lseek(handle, 0_i64, 1)
    raise "cannot ask the position: error #{-here}" if here < 0_i64
    unread = @read_limit > @read_pos ? (@read_limit - @read_pos).to_i64 : 0_i64
    here - unread + @write_pos.to_i64
  end

  def pos=(position : Int64) : Int64
    seek(position, Seek::Set)
  end

  # The kernel's move: the new offset, or a negative error.
  protected def self.lseek(fd : Int64, offset : Int64, whence : Int32) : Int64
    {% if flag?(:win32) %}
      moved = 0_i64
      if Std::File::LibKernel32.SetFilePointerEx(Pointer(Void).new(fd.to_u64), offset, pointerof(moved), whence) == 0
        return -Std::File::LibKernel32.GetLastError.to_i64
      end
      moved
    {% elsif flag?(:darwin) %}
      moved = Std::File::LibC.lseek(fd.to_i32, offset, whence)
      moved < 0_i64 ? -1_i64 : moved
    {% elsif flag?(:wasm32) %}
      raise "seek is not available on wasm32-wasi"
    {% else %}
      Std::File::LibC.sys(Std::File::LibC::SYS_LSEEK, fd, offset, whence.to_i64)
    {% end %}
  end
end

pub alias File = ::File
