; iyi-ir 1
source_filename = "ptrtoint_chain"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @ptrtoint_chain(i1 %run, ptr %base, ptr %out) {
entry:
  %bits = ptrtoint ptr %base to i64
  %part = lshr i64 %bits, 8
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  store i64 %part, ptr %out, align 8
  br label %head
done:
  ret void
}
