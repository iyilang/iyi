pub class MacroIf < ASTNode
  property cond : ASTNode
  property then : ASTNode
  property else : ASTNode

  def initialize(@cond : ASTNode, a_then : ASTNode? = nil, a_else : ASTNode? = nil)
    @then = a_then || Nop.new
    @else = a_else || Nop.new
  end

  def clone_without_location : self
    MacroIf.new(@cond.clone, @then.clone, @else.clone)
  end

  def accept_children(visitor) : Nil
    @cond.accept(visitor)
    @then.accept(visitor)
    @else.accept(visitor)
  end

  def ==(other : self) : Bool
    @cond == other.cond && @then == other.then && @else == other.else
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    31 &* (31 &* (31 &* 17 &+ @cond.hash) &+ @then.hash) &+ @else.hash
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "{% if "
    @cond.to_s(sb)
    sb << " %}
  "
    @then.to_s(sb)
    unless @else.is_a?(Nop)
      sb << "
{% else %}
  "
      @else.to_s(sb)
    end
    sb << "
{% end %}"
  end
end

pub class MacroFor < ASTNode
  property vars : Array(Var)
  property exp : ASTNode
  property body : ASTNode

  def initialize(@vars : Array(Var) = [] of Var, @exp : ASTNode = Nop.new, body : ASTNode? = nil)
    @body = body || Nop.new
  end

  def clone_without_location : self
    cloned_vars = @vars.map { |v| v.clone.as(Var) }
    MacroFor.new(cloned_vars, @exp.clone, @body.clone)
  end

  def accept_children(visitor) : Nil
    @vars.each { |v| v.accept(visitor) }
    @exp.accept(visitor)
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    (@vars == other.vars) && (@exp == other.exp) && (@body == other.body)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@vars)
    h = 31 &* h &+ hash_val(@exp)
    h = 31 &* h &+ hash_val(@body)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "{% for "
    i = 0
    while i < @vars.size
      sb << ", " if i > 0
      @vars[i].to_s(sb)
      i = i + 1
    end
    sb << " in "
    @exp.to_s(sb)
    sb << " %}
  "
    @body.to_s(sb)
    sb << "
{% end %}"
  end
end

pub class MacroVar < ASTNode
