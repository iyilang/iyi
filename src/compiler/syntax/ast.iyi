pub class MagicConstant < ASTNode
  property name : TokenKind

  def initialize(@name : TokenKind)
  end

  def clone_without_location : self
    MagicConstant.new(@name)
  end

  def ==(other : self) : Bool
    (@name == other.name)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    case @name
    when TokenKind::MAGIC_LINE
      sb << "__LINE__"
    when TokenKind::MAGIC_END_LINE
      sb << "__END_LINE__"
    when TokenKind::MAGIC_FILE
      sb << "__FILE__"
    when TokenKind::MAGIC_DIR
      sb << "__DIR__"
    else
      sb << @name.to_s
    end
  end
end

