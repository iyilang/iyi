# Exercises `std/cbor`: RFC 8949's CBOR decoded, encoded in core
# deterministic encoding and written as diagnostic notation - every
# example of the RFC's Appendix A both ways, every not-well-formed example
# of Appendix F refused with its sentence, integers, bignums and floats at
# the edges of their widths, the deterministic rules and their refusals,
# UTF-8, a generated corpus round-tripped and re-serialized every other
# way the format allows, random and mutated bytes decoded in a task that
# must not panic, nesting to DEPTH_LIMIT, and `derive cbor_serializable`
# beside std/json's, std/yaml's and std/toml's derives.
#
# Lines starting RFC, CORPUS, VARIANT, INVALID, FUZZ and DERIVE are records
# for bench/std_cbor_exercise.sh, whose Python decodes the same bytes with
# a decoder of its own over the standard library (`struct` for the
# floats, the UTF-8 codec, `json` for the strings of the notation) and
# compares: an item's bytes in hex and what this module made of them.
#
# Run via:
#     ./bin/iyi run bench/std_cbor_exercise.iyi

module bench/std_cbor_exercise

import std/cbor::{CBOR, Any, CBORError, CBORTag, CBORSimple, CBORBignum, cbor_serializable}
import std/toml::{TOML, toml_serializable}
import std/yaml::{YAML, yaml_serializable}
import std/json::{JSON, serializable}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

HEX_DIGITS = "0123456789abcdef"

def hex(bytes : Array(UInt8)) : String
  out = String::Builder.new(bytes.size * 2 + 1)
  bytes.each do |b|
    v = b.to_i32
    out << HEX_DIGITS[v >> 4] << HEX_DIGITS[v & 15]
  end
  out.to_s
end

def unhex(text : String) : Array(UInt8)
  bytes = [] of UInt8
  i = 0
  while i + 1 < text.size
    hi = HEX_DIGITS.index(text[i]) || raise "not hex: #{text}"
    lo = HEX_DIGITS.index(text[i + 1]) || raise "not hex: #{text}"
    bytes << (hi * 16 + lo).to_u8
    i = i + 2
  end
  bytes
end

def text_bytes(text : String) : Array(UInt8)
  p = text.to_unsafe
  Array(UInt8).new(text.bytesize) { |i| p[i] }
end

# The item `bytes` hold, or a failed assertion naming `msg`.
def decoded(bytes : Array(UInt8), msg : String) : Any
  answer = CBOR.decode(bytes)
  raise "ASSERTION FAILED: #{msg}: refused with #{answer.message}" if answer.is_a?(CBORError)
  answer
end

# Refused with exactly `sentence`; recorded for Python, whose decoder must
# refuse the bytes too.
def refused(hexed : String, sentence : String, deterministic : Bool = false) : Nil
  answer = CBOR.decode(unhex(hexed), deterministic: deterministic)
  raise "ASSERTION FAILED: accepted #{hexed}" unless answer.is_a?(CBORError)
  assert_str(sentence, answer.message, "the refusal of #{hexed}")
  puts "INVALID #{hexed}\t#{deterministic ? 1 : 0}"
end

# The sentence `action` panicked with, or what it answered when it did not.
def panic_of(action : Proc(String)) : String
  said = "unread"
  group do |g|
    task = g.spawn { action.call }
    answer = task.value
    said = answer.is_a?(Panicked) ? answer.message : answer
  end
  said
end

def f64(bits : UInt64) : Float64
  IyiFloatText.from_bits(bits)
end

def ints(values : Array(Int32)) : Any
  Any.new(values.map { |v| Any.new(v) })
end

def map_of(pairs : Array(Tuple(Any, Any))) : Any
  h = Hash(Any, Any).new
  pairs.each { |pair| h[pair[0]] = pair[1] }
  Any.new(h)
end

# A small generator of its own (xorshift64*), so the corpus and the fuzz
# are the same on every run and every target.
class Rng
  @state : UInt64

  def initialize(@state : UInt64)
  end

  def draw : UInt64
    x = @state
    x = x ^ x.unsafe_shr(12)
    x = x ^ x.unsafe_shl(25)
    x = x ^ x.unsafe_shr(27)
    @state = x
    x &* 0x2545F4914F6CDD1D_u64
  end

  def below(n : Int32) : Int32
    (draw % n.to_u64).to_i32
  end

  def chance(n : Int32) : Bool
    below(n) == 0
  end

  def byte : UInt8
    (draw & 0xFF_u64).to_u8
  end
end

