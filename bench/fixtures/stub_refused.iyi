@[Unsafe("exits with the selected result")]
lib LibC
  fun exit(status : Int32) : NoReturn
end

struct Proc
  @[Primitive(:proc_call)]
  def probe_call(*args : *T) : R
  end
end

class StubExercise
  def twice(value : Int32) : Int32
    value &* 2
  end

  def refused : Proc(Int32, Int32)
    ->(value : Int32) { twice(value) }
  end
end

if ARGC_UNSAFE > 1
  LibC.exit(StubExercise.new.refused.probe_call(3))
else
  LibC.exit(23)
end
