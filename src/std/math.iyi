module std/math

# std/int for the small integers' comparisons and negation in gcd; std/float
# for the Float32 overloads: `to_f64`, the comparisons, and a `to_f32` that
# rounds a double past the single's range to its infinity.
import std/int
import std/float

# The hardware instructions this module names. A fused multiply-add is
# among them on aarch64 only: `llvm.fma.f64` is one instruction there and
# a call into libm on the x86-64 baseline, and the floor (SPEC.md III.9)
# links no libm, so `fma` asks the prelude's `IyiRounding` for x86-64's
# instruction where the processor has it and takes musl's exact software
# arm where it has not.
lib LibLLVMMath # llvm.sqrt.f64 llvm.copysign.f64 llvm.fma.f64
  fun sqrt_f64 = "llvm.sqrt.f64"(x : Float64) : Float64
  fun sqrt_f32 = "llvm.sqrt.f32"(x : Float32) : Float32
  fun copysign_f64 = "llvm.copysign.f64"(mag : Float64, sgn : Float64) : Float64
  fun copysign_f32 = "llvm.copysign.f32"(mag : Float32, sgn : Float32) : Float32
  {% if flag?(:aarch64) %}
    fun fma_f64 = "llvm.fma.f64"(a : Float64, b : Float64, c : Float64) : Float64
    fun fma_f32 = "llvm.fma.f32"(a : Float32, b : Float32, c : Float32) : Float32
  {% end %}
end

pub struct Math
  PI    =  3.14159265358979323846
  TAU   = 6.283185307179586476925
  E     =  2.71828182845904523536
  LOG2  = 0.693147180559945309417
  LOG10 =  2.30258509299404568402

