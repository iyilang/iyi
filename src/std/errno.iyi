# Errno wraps and gives access to libc/platform errno values.

module std/errno

lib LibErrno
  {% if flag?(:darwin) %}
    fun __error : Int32*
  {% elsif flag?(:linux) %}
    fun __errno_location : Int32*
  {% end %}
end

pub enum Errno
  NONE            =   0
  EPERM           =   1
  ENOENT          =   2
  ESRCH           =   3
  EINTR           =   4
  EIO             =   5
  ENXIO           =   6
  E2BIG           =   7
  ENOEXEC         =   8
  EBADF           =   9
  ECHILD          =  10
  EDEADLK         =  35
  ENOMEM          =  12
  EACCES          =  13
  EFAULT          =  14
  ENOTBLK         =  15
  EBUSY           =  16
  EEXIST          =  17
  EXDEV           =  18
  ENODEV          =  19
  ENOTDIR         =  20
  EISDIR          =  21
  EINVAL          =  22
  ENFILE          =  23
  EMFILE          =  24
  ENOTTY          =  25
  ETXTBSY         =  26
  EFBIG           =  27
  ENOSPC          =  28
  ESPIPE          =  29
  EROFS           =  30
  EMLINK          =  31
  EPIPE           =  32
  EDOM            =  33
  ERANGE          =  34
  EAGAIN          =  11
  EWOULDBLOCK     =  11
  EINPROGRESS     =  36
  EALREADY        =  37
  ENOTSOCK        =  38
  EDESTADDRREQ    =  39
  EMSGSIZE        =  40
  EPROTOTYPE      =  41
  ENOPROTOOPT     =  42
  EPROTONOSUPPORT =  43
  ESOCKTNOSUPPORT =  44
  EOPNOTSUPP      =  45
  EPFNOSUPPORT    =  46
  EAFNOSUPPORT    =  47
  EADDRINUSE      =  48
  EADDRNOTAVAIL   =  49
  ENETDOWN        =  50
  ENETUNREACH     =  51
  ENETRESET       =  52
  ECONNABORTED    =  53
  ECONNRESET      =  54
  ENOBUFS         =  55
  EISCONN         =  56
  ENOTCONN        =  57
  ESHUTDOWN       =  58
  ETOOMANYREFS    =  59
  ETIMEDOUT       =  60
  ECONNREFUSED    =  61
  ELOOP           =  62
  ENAMETOOLONG    =  63
  EHOSTDOWN       =  64
  EHOSTUNREACH    =  65
  ENOTEMPTY       =  66
  EUSERS          =  68
  EDQUOT          =  69
  ESTALE          =  70
  EREMOTE         =  71
  ENOLCK          =  77
  ENOSYS          =  78
  EOVERFLOW       =  84
  ECANCELED       =  89
  EIDRM           =  90
  ENOMSG          =  91
  EILSEQ          =  92
  EBADMSG         =  94
  EMULTIHOP       =  95
  ENODATA         =  96
  ENOLINK         =  97
  ENOSR           =  98
  ENOSTR          =  99
  EPROTO          = 100
  ETIME           = 101
  ENOTRECOVERABLE = 104
  EOWNERDEAD      = 105

  def message : String
    case self
    when NONE            then "Success"
    when EPERM           then "Operation not permitted"
    when ENOENT          then "No such file or directory"
    when ESRCH           then "No such process"
    when EINTR           then "Interrupted system call"
    when EIO             then "Input/output error"
    when ENXIO           then "Device not configured"
    when E2BIG           then "Argument list too long"
    when ENOEXEC         then "Exec format error"
    when EBADF           then "Bad file descriptor"
    when ECHILD          then "No child processes"
    when EDEADLK         then "Resource deadlock avoided"
    when ENOMEM          then "Cannot allocate memory"
    when EACCES          then "Permission denied"
    when EFAULT          then "Bad address"
    when ENOTBLK         then "Block device required"
    when EBUSY           then "Resource busy"
    when EEXIST          then "File exists"
    when EXDEV           then "Cross-device link"
    when ENODEV          then "Operation not supported by device"
    when ENOTDIR         then "Not a directory"
    when EISDIR          then "Is a directory"
    when EINVAL          then "Invalid argument"
    when ENFILE          then "Too many open files in system"
    when EMFILE          then "Too many open files"
    when ENOTTY          then "Inappropriate ioctl for device"
    when ETXTBSY         then "Text file busy"
    when EFBIG           then "File too large"
    when ENOSPC          then "No space left on device"
    when ESPIPE          then "Illegal seek"
    when EROFS           then "Read-only file system"
    when EMLINK          then "Too many links"
    when EPIPE           then "Broken pipe"
    when EDOM            then "Numerical argument out of domain"
    when ERANGE          then "Result too large"
    when EAGAIN          then "Resource temporarily unavailable"
    when EINPROGRESS     then "Operation now in progress"
    when EALREADY        then "Operation already in progress"
    when ENOTSOCK        then "Socket operation on non-socket"
    when EDESTADDRREQ    then "Destination address required"
    when EMSGSIZE        then "Message too long"
    when EPROTOTYPE      then "Protocol wrong type for socket"
    when ENOPROTOOPT     then "Protocol not available"
    when EPROTONOSUPPORT then "Protocol not supported"
    when ESOCKTNOSUPPORT then "Socket type not supported"
    when EOPNOTSUPP      then "Operation not supported"
    when EPFNOSUPPORT    then "Protocol family not supported"
    when EAFNOSUPPORT    then "Address family not supported by protocol family"
    when EADDRINUSE      then "Address already in use"
    when EADDRNOTAVAIL   then "Can't assign requested address"
    when ENETDOWN        then "Network is down"
    when ENETUNREACH     then "Network is unreachable"
    when ENETRESET       then "Network dropped connection on reset"
    when ECONNABORTED    then "Software caused connection abort"
    when ECONNRESET      then "Connection reset by peer"
    when ENOBUFS         then "No buffer space available"
    when EISCONN         then "Socket is already connected"
    when ENOTCONN        then "Socket is not connected"
    when ESHUTDOWN       then "Can't send after socket shutdown"
    when ETOOMANYREFS    then "Too many references"
    when ETIMEDOUT       then "Operation timed out"
    when ECONNREFUSED    then "Connection refused"
    when ELOOP           then "Too many levels of symbolic links"
    when ENAMETOOLONG    then "File name too long"
    when EHOSTDOWN       then "Host is down"
    when EHOSTUNREACH    then "No route to host"
    when ENOTEMPTY       then "Directory not empty"
    when EUSERS          then "Too many users"
    when EDQUOT          then "Disc quota exceeded"
    when ESTALE          then "Stale file handle"
    when EREMOTE         then "Too many levels of remote in path"
    when ENOLCK          then "No locks available"
    when ENOSYS          then "Function not implemented"
    when EOVERFLOW       then "Value too large to be stored in data type"
    when ECANCELED       then "Operation canceled"
    when EIDRM           then "Identifier removed"
    when ENOMSG          then "No message of desired type"
    when EILSEQ          then "Illegal byte sequence"
    when EBADMSG         then "Bad message"
    when EMULTIHOP       then "Multihop attempted"
    when ENODATA         then "No message available on STREAM"
    when ENOLINK         then "Link has been severed"
    when ENOSR           then "No STREAM resources"
    when ENOSTR          then "Not a STREAM"
    when EPROTO          then "Protocol error"
    when ETIME           then "STREAM ioctl timeout"
    when ENOTRECOVERABLE then "State not recoverable"
    when EOWNERDEAD      then "Previous owner died"
    else                      "Unknown error"
    end
  end

  def self.value : self
    {% if flag?(:darwin) %}
      Errno.new(LibErrno.__error.value)
    {% elsif flag?(:linux) %}
      Errno.new(LibErrno.__errno_location.value)
    {% else %}
      Errno::NONE
    {% end %}
  end

  def self.value=(errno : Errno) : Errno
    {% if flag?(:darwin) %}
      LibErrno.__error.value = errno.value
    {% elsif flag?(:linux) %}
      LibErrno.__errno_location.value = errno.value
    {% end %}
    errno
  end
end
