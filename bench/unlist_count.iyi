# The listed pages' count against the bits that list them, after one batch of
# them is unlisted, checked by `IyiHeap.audit_listed`: the sweep's audit, which
# only the copies `bench/sweep_exercise.sh` builds define. Those copies are a
# prelude that plays the neighbouring adoption at the batch's edges (the fix),
# and one that also counts the clear it lost (the broken counting). The first
# must pass and the second must fail on its one run.
#
#   bash bench/sweep_exercise.sh
#
# It prints `unlist: ok, the audit found no arena count off, the arena counts N
# listed pages, its bits list M` when the audit agrees. When it counts one arena
# off, it prints `FAIL: unlist: the audit found 1 arena count off: the arena
# counts N listed pages, its bits list M` and exits 1. The audit is compiled
# only under -Dunlist_audit, which the sweep gate passes; built bare, as Windows
# CI builds every bench program, it prints `unlist: built bare, ...` and exits 0.
#
# One thread, no timing. A zeroed fake header lists pages 1 to 5 with
# `IyiHeap.set_listed` and sets the count to 5, as a sweep leaves it. Then
# `IyiHeap.unlist_batch` unlists pages 1 to 3, so two pages stay listed and the
# count must be 2. Only one interleaving can make it differ: two adoptions read
# the edge page listed, one clears it, and the other's clear loses. A count
# that includes the lost clear reads short of the bits.

@[Unsafe("it writes a fake arena header by address, which nothing else owns")]
module bench/unlist_count

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  # The fake header is not a root the collector scans, so no collection runs
  # while the check holds its address.
  IyiMark.auto = false

  # How many bits of a bitmap word are set, one lowest bit at a time.
  def listed_bits(word : UInt64) : UInt64
    count = 0_u64
    while word != 0_u64
      word = word & (word - 1_u64)
      count = count + 1_u64
    end
    count
  end

  # The header holds the count and the bitmap's first word and nothing past
  # them: `set_listed`, `unlist_batch` and `unlist_page` touch no other offset.
  words = IyiHeap::OFF_LISTED_PAGES.unsafe_shr(3_u64) + 1_u64
  header = Pointer(UInt64).malloc(words)
  arena = header.address
  slot = 0_u64
  while slot < words
    IyiHeap.write64(arena + slot * 8_u64, 0_u64)
    slot = slot + 1_u64
  end

  # The header's map covers one bitmap word, 64 pages, which is all that
  # `IyiHeap.audit_listed` reads of it.
  IyiHeap.write64(arena + IyiHeap::OFF_MAP, 1_u64.unsafe_shl(IyiHeap::PAGE_SHIFT + 6_u64))

  # Pages 1 to 5 listed, and the count set to the five of them.
  IyiHeap.set_listed(arena, arena + IyiHeap::PAGE, arena + 6_u64 * IyiHeap::PAGE, true)
  IyiHeap.write64(arena + IyiHeap::OFF_LISTED, 5_u64)
  count = IyiHeap.read64(arena + IyiHeap::OFF_LISTED)
  bits = listed_bits(IyiHeap.read64(arena + IyiHeap::OFF_LISTED_PAGES))
  unless count == 5_u64 && bits == 5_u64
    print "FAIL: unlist: setup: the arena counts #{count.to_i64} listed pages, its bits list #{bits.to_i64}, not 5 and 5\n"
    __iyi_exit(2)
  end

  IyiHeap.unlist_batch(arena, 1_u64, 3_u64)

  count = IyiHeap.read64(arena + IyiHeap::OFF_LISTED)
  bits = listed_bits(IyiHeap.read64(arena + IyiHeap::OFF_LISTED_PAGES))
{% if flag?(:unlist_audit) %}
  # The sweep's audit, `IyiHeap.audit_listed`, is the function trim_stress checks
  # at every pause: the arena's count against the bits its bitmap lists. Here
  # it counts one arena, so `listed_off` is 0 or 1. Only the copies
  # `bench/sweep_exercise.sh` builds define it, and it builds this program with
  # -Dunlist_audit: Windows CI builds every bench program bare, against the
  # real prelude, where the audit does not exist.
  IyiHeap.audit_listed(arena, count)
  if IyiHeap.listed_off == 0_u64
    puts "unlist: ok, the audit found no arena count off, the arena counts #{count.to_i64} listed pages, its bits list #{bits.to_i64}"
  else
    print "FAIL: unlist: the audit found #{IyiHeap.listed_off.to_i64} arena count off: the arena counts #{IyiHeap.listed_off_count.to_i64} listed pages, its bits list #{IyiHeap.listed_off_pages.to_i64}\n"
    __iyi_exit(1)
  end
{% else %}
  puts "unlist: built bare, the audit is the sweep's copies' (-Dunlist_audit), the arena counts #{count.to_i64} listed pages, its bits list #{bits.to_i64}"
{% end %}
{% else %}
  puts "unlist: no collector's allocator on this target, nothing to count"
{% end %}
