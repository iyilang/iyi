; iyi-ir 1
source_filename = "constant_removed"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
@slot = external global ptr
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @constant_null() {
entry:
  %nil = inttoptr i64 0 to ptr
  br label %join
join:
  store ptr %nil, ptr @slot, align 8
  br label %done
done:
  ret void
}
define external void @constant_number(ptr %destination) {
entry:
  br label %join
join:
  store i64 42, ptr %destination, align 8
  br label %done
done:
  ret void
}
