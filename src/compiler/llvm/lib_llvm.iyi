    fun get_host_cpu_name = LLVMGetHostCPUName : Char*

    fun create_target_machine = LLVMCreateTargetMachine(t : TargetRef, triple : Char*, cpu : Char*, features : Char*,
                                                       level : CodeGenOptLevel, reloc : RelocMode, code_model : CodeModel) : TargetMachineRef
    fun dispose_target_machine = LLVMDisposeTargetMachine(t : TargetMachineRef)
    fun get_target_machine_target = LLVMGetTargetMachineTarget(t : TargetMachineRef) : TargetRef
    fun get_target_machine_triple = LLVMGetTargetMachineTriple(t : TargetMachineRef) : Char*
    fun get_target_machine_cpu = LLVMGetTargetMachineCPU(t : TargetMachineRef) : Char*
    fun create_target_data_layout = LLVMCreateTargetDataLayout(t : TargetMachineRef) : TargetDataRef
    fun dispose_target_data = LLVMDisposeTargetData(td : TargetDataRef)
    fun target_machine_emit_to_file = LLVMTargetMachineEmitToFile(t : TargetMachineRef, m : ModuleRef, filename : Char*,
                                                                 codegen : CodeGenFileType, error_message : Char**) : Bool
    fun target_machine_emit_to_memory_buffer = LLVMTargetMachineEmitToMemoryBuffer(t : TargetMachineRef, m : ModuleRef,
                                                                                   codegen : CodeGenFileType, error_message : Char**,
                                                                                   out_mem_buf : MemoryBufferRef*) : Bool

    fun size_of_type_in_bits = LLVMSizeOfTypeInBits(td : TargetDataRef, ty : TypeRef) : ULongLong
    fun abi_size_of_type = LLVMABISizeOfType(td : TargetDataRef, ty : TypeRef) : ULongLong
    fun abi_alignment_of_type = LLVMABIAlignmentOfType(td : TargetDataRef, ty : TypeRef) : UInt
    fun offset_of_element = LLVMOffsetOfElement(td : TargetDataRef, struct_ty : TypeRef, element : UInt) : ULongLong
    fun copy_string_rep_of_target_data = LLVMCopyStringRepOfTargetData(td : TargetDataRef) : Char*

    # Verification
    fun verify_module = LLVMVerifyModule(m : ModuleRef, action : VerifierFailureAction, out_message : Char**) : Bool
    fun verify_function = LLVMVerifyFunction(fn : ValueRef, action : VerifierFailureAction) : Bool

    # Passes
    fun run_passes = LLVMRunPasses(m : ModuleRef, passes : Char*, tm : TargetMachineRef, options : PassBuilderOptionsRef) : ErrorRef
    fun create_pass_builder_options = LLVMCreatePassBuilderOptions : PassBuilderOptionsRef
    fun dispose_pass_builder_options = LLVMDisposePassBuilderOptions(options : PassBuilderOptionsRef)
    fun pass_builder_options_set_loop_unrolling = LLVMPassBuilderOptionsSetLoopUnrolling(options : PassBuilderOptionsRef, enable : Bool)
    fun pass_builder_options_set_loop_vectorization = LLVMPassBuilderOptionsSetLoopVectorization(options : PassBuilderOptionsRef, enable : Bool)
    fun pass_builder_options_set_slp_vectorization = LLVMPassBuilderOptionsSetSLPVectorization(options : PassBuilderOptionsRef, enable : Bool)

    {% if is_lt_170 %}

      fun pass_manager_create = LLVMCreatePassManager : PassManagerRef
