# A coordinate at its own width, padded to whole bytes: 48 bytes for every
# one below 2^384.
def coordinate(hex : String) : String
  hex.bytesize.odd? ? "0" + hex : hex
end

args = Program.args

if args.size > 0 && args[0] == "oracle"
  File.read(args[1]).lines.each do |line|
    parts = line.split(' ')
    key = P384PrivateKey.from_bytes(b(parts[1])).or_panic
    message = parts.size > 2 ? b(parts[2]) : [] of UInt8
    signature = key.sign(hash_named(parts[0]), message)
    puts "#{hex(key.public_point)[2, 96]} #{hex(key.public_point)[98, 96]} #{hex(signature)}"
  end
  exit 0
end

if args.size > 0 && args[0] == "digest"
  File.read(args[1]).lines.each do |line|
    parts = line.split(' ')
    key = P384PrivateKey.from_bytes(b(parts[1])).or_panic
    signature = key.sign_digest(hash_named(parts[0]), b(parts[2]))
    puts signature.is_a?(EcdsaError) ? "refused" : hex(signature)
  end
  exit 0
end

if args.size > 0 && args[0] == "ecdh"
  File.read(args[1]).lines.each do |line|
    parts = line.split(' ')
    key = P384PrivateKey.from_bytes(b(parts[0])).or_panic
    shared = key.shared_secret(b(parts[1]))
    puts shared.is_a?(EcdsaError) ? "refused" : "#{hex(shared)} #{hex(key.public_point)}"
  end
  exit 0
end

if args.size > 0 && args[0] == "keys"
  File.read(args[1] + "/list").lines.each do |name|
    text = File.read(args[1] + "/" + name)
    der = Array(UInt8).new(text.bytesize) { |i| text.to_unsafe[i] }
    key = name.ends_with?(".p8") ? P384PrivateKey.from_pkcs8(der) : P384PrivateKey.from_sec1(der)
    if key.is_a?(EcdsaError)
      puts "#{name} refused: #{key.message}"
    else
      puts "#{name} #{hex(key.public_point)[2, 96]} #{hex(key.public_point)[98, 96]}"
    end
  end
  exit 0
end

if args.size > 0 && args[0] == "wycheproof"
  valid = 0
  invalid = 0
  taken = 0
  turned = 0
  wrong = 0
  File.read(args[1]).lines.each do |line|
    parts = line.split(' ')
    key = P384PrivateKey.from_bytes(b(parts[2]))
    answer = key.is_a?(EcdsaError) ? key : key.shared_secret(parts[3] == "-" ? [] of UInt8 : b(parts[3]))
    case parts[1]
    when "valid"
      if answer.is_a?(EcdsaError)
        puts "tcId #{parts[0]}: valid, refused: #{answer.message}"
        wrong = wrong + 1
      elsif hex(answer) != parts[4]
        puts "tcId #{parts[0]}: valid, answered #{hex(answer)}, not #{parts[4]}"
        wrong = wrong + 1
      else
        valid = valid + 1
      end
    when "invalid"
      if answer.is_a?(EcdsaError)
        invalid = invalid + 1
      else
        puts "tcId #{parts[0]}: invalid, accepted"
        wrong = wrong + 1
      end
    else
      if answer.is_a?(EcdsaError)
        turned = turned + 1
        puts "tcId #{parts[0]}: acceptable, refused: #{answer.message}"
      else
        taken = taken + 1
        puts "tcId #{parts[0]}: acceptable, taken"
      end
    end
  end
  puts "#{valid} valid as Wycheproof's shared value, #{invalid} invalid refused, #{taken + turned} acceptable (#{taken} taken, #{turned} refused), #{wrong} wrong"
  exit wrong == 0 ? 0 : 1
end

if args.size > 0 && args[0] == "time"
  d = b("6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5")
  rfc = P384PrivateKey.from_bytes(d).or_panic
  one = P384PrivateKey.from_bytes(b("0" * 95 + "1")).or_panic
  last = P384PrivateKey.from_bytes(b("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52972")).or_panic
  peer = b("04" + CAVP_CDH[0].split(' ')[3] + CAVP_CDH[0].split(' ')[4])
  runs = args.size > 1 ? args[1].to_i : 101
  puts "keygen #{median_ns(runs) { P384PrivateKey.from_bytes(d).or_panic; nil }}"
  [{"rfc", rfc}, {"one", one}, {"last", last}].each do |entry|
    name, key = entry
    puts "ecdh-#{name} #{median_ns(runs) { key.shared_secret(peer).or_panic; nil }}"
    puts "sign-#{name} #{median_ns(runs) { key.sign(EcdsaHash::SHA384, "sample"); nil }}"
  end
  exit 0
end

puts "== RFC 6979's P-384 key and signatures (appendix A.2.6)"
key = P384PrivateKey.from_bytes(b("6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5")).or_panic
check hex(key.public_point)[2, 96] == "ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc13", "the key's Ux: #{hex(key.public_point)[2, 96]}"
check hex(key.public_point)[98, 96] == "8015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720", "the key's Uy: #{hex(key.public_point)[98, 96]}"
check key.public_key.x.to_s(16) == "ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc13", "std/ecdsa's public key has Ux"
# The DER of each of the RFC's (r, s), written from its r and s. SHA-256
# first: its digest is 256 bits, so the nonce takes two HMAC blocks to
# reach P-384's 384.
RFC6979 = [
  {"sample", EcdsaHash::SHA256, "SHA-256", "3065023021b13d1e013c7fa1392d03c5f99af8b30c570c6f98d4ea8e354b63a21d3daa33bde1e888e63355d92fa2b3c36d8fb2cd023100f3aa443fb107745bf4bd77cb3891674632068a10ca67e3d45db2266fa7d1feebefdc63eccd1ac42ec0cb8668a4fa0ab0"},
  {"test", EcdsaHash::SHA256, "SHA-256", "306402306d6defac9ab64dabafe36c6bf510352a4cc27001263638e5b16d9bb51d451559f918eedaf2293be5b475cc8f0188636b02302d46f3becbcc523d5f1a1256bf0c9b024d879ba9e838144c8ba6baeb4b53b47d51ab373f9845c0514eefb14024787265"},
  {"sample", EcdsaHash::SHA384, "SHA-384", "306602310094edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe4602310099ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8"},
  {"test", EcdsaHash::SHA384, "SHA-384", "30660231008203b63d3c853e8d77227fb377bcf7b7b772e97892a80f36ab775d509d7a5feb0542a7f0812998da8f1dd3ca3cf023db023100ddd0760448d42d8a43af45af836fce4de8be06b485e9b61b827c2f13173923e06a739f040649a667bf3b828246baa5a5"},
  {"sample", EcdsaHash::SHA512, "SHA-512", "3065023100ed0959d5880ab2d869ae7f6c2915c6d60f96507f9cb3e047c0046861da4a799cfe30f35cc900056d7c99cd78824337090230512c8cceee3890a84058ce1e22dbc2198f42323ce8aca9135329f03c068e5112dc7cc3ef3446defceb01a45c2667fdd5"},
  {"test", EcdsaHash::SHA512, "SHA-512", "3066023100a0d5d090c9980faf3c2ce57b7ae951d31977dd11c775d314af55f76c676447d06fb6495cd21b4b6e340fc236584fb277023100976984e59b4c77b0e8e4460dca3d9f20e07b9bb1f63beefaf576f6b2e8b224634a2092cd3792e0159ad9cee37659c736"},
]
RFC6979.each do |entry|
  message, hash, name, want = entry
  signature = key.sign(hash, message)
  check hex(signature) == want, "the signature of #{message.inspect} under #{name}: #{hex(signature)}"
  check key.public_key.verify(hash, message, signature), "the RFC's signature of #{message.inspect} under #{name} verifies"
end
check key.sign(EcdsaHash::SHA256, "sample") == key.sign(EcdsaHash::SHA256, "sample"), "one key and one message sign alike"
puts "  the public key and its six signatures, as the RFC has them"

puts "== the keys at the ends of the range"
one = P384PrivateKey.from_bytes(b("0" * 95 + "1")).or_panic
check hex(one.public_point)[2, 96] == "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7", "d = 1: G's x"
check hex(one.public_point)[98, 96] == "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f", "d = 1: G's y"
last = P384PrivateKey.from_bytes(b("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52972")).or_panic
check hex(last.public_point)[2, 96] == "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7", "d = n - 1: -G's x"
check hex(last.public_point)[98, 96] == "c9e821b569d9d390a26167406d6d23d6070be242d765eb831625ceec4a0f473ef59f4e30e2817e6285bce2846f15f1a0", "d = n - 1: -G's y, p - G's"
[one, last].each_with_index do |k, i|
  [EcdsaHash::SHA256, EcdsaHash::SHA384, EcdsaHash::SHA512].each do |hash|
    signature = k.sign(hash, "edge #{i}")
    check k.public_key.verify(hash, "edge #{i}", signature), "the edge key #{i} signs under #{hash} what std/ecdsa takes"
  end
end
puts "  d = 1 is G, d = n - 1 is -G, and both sign under every hash"

puts "== every hash, checked by std/ecdsa"
[EcdsaHash::SHA256, EcdsaHash::SHA384, EcdsaHash::SHA512].each do |hash|
  8.times do |i|
    message = "message #{i} " * (i * 9)
    signature = key.sign(hash, message)
    check key.public_key.verify(hash, message, signature), "#{hash}: message #{i} verifies"
    check !key.public_key.verify(hash, message + ".", signature), "#{hash}: another message refused"
    check !last.public_key.verify(hash, message, signature), "#{hash}: another key refused"
  end
end
puts "  SHA-256, SHA-384 and SHA-512, 8 messages each: held, and refused for another message or key"

puts "== digests signed as they are (sign_digest)"
# Python's cryptography 46.0.5 (OpenSSL 3.5.5), `sign(digest,
# ec.ECDSA(Prehashed(hashes.SHA384()), deterministic_signing=True))` with
# RFC 6979's key. 48 bytes of 0xff is past n, so bits2octets' reduction
# mod n is what makes the nonce's input; 64 bytes of 0xff under SHA-512 is
# cut to its leftmost 384 bits first, and that is past n too.
DIGEST_SHA384 = "3066023100d80ff7df60149e5cedb63fac36c3f0c16c47fbf93d40090804dbbaa45249ba8c11475f1b5844cdad9e2dd9528077dab8023100d3e3b8ed8c6bef24339475f39c4223a498647c34f90a5ef26f6f6739bd81a8f9b9acf711f6c2a887a18c64ca2bda854e"
DIGEST_SHA512 = "3066023100a1b31b960d19557460981d9113fdf90305c24b8e179c76a65bac4ff9a4d619adeefe061b8d9cccf2da3b8b00fb2753d7023100fb139d49d6bd2dc1150efa89f1ec47405efde93d30953db982722d4ae5ce4cdbf0d8806bb765169056a14fe2270c5b6d"
high384 = key.sign_digest(EcdsaHash::SHA384, Array(UInt8).new(48, 0xff_u8)).or_panic
check hex(high384) == DIGEST_SHA384, "the SHA-384 digest of 48 bytes 0xff: #{hex(high384)}"
high512 = key.sign_digest(EcdsaHash::SHA512, Array(UInt8).new(64, 0xff_u8)).or_panic
check hex(high512) == DIGEST_SHA512, "the SHA-512 digest of 64 bytes 0xff: #{hex(high512)}"
[EcdsaHash::SHA256, EcdsaHash::SHA384, EcdsaHash::SHA512].each do |hash|
  check key.sign_digest(hash, hash.digest(b("73616d706c65"))).or_panic == key.sign(hash, "sample"), "#{hash}: the digest of \"sample\" signs as \"sample\" does"
end
wrong_size = key.sign_digest(EcdsaHash::SHA384, Array(UInt8).new(32, 1_u8))
check wrong_size.is_a?(EcdsaError) && wrong_size.message.includes?("is 48 bytes, not 32"), "a SHA-384 digest of 32 bytes refused"
wrong_size = key.sign_digest(EcdsaHash::SHA256, Array(UInt8).new(48, 1_u8))
check wrong_size.is_a?(EcdsaError) && wrong_size.message.includes?("is 32 bytes, not 48"), "a SHA-256 digest of 48 bytes refused"
puts "  two digests past n as Python signs them, every hash's digest as its message signs, two wrong sizes refused"

puts "== what is not a private key"
refused P384PrivateKey.from_bytes(Array(UInt8).new(47, 1_u8)), "is 48 bytes, not 47", "47 bytes"
# 2^384 - 1 first: past n, d G is still a point (d mod n of them), and
# only the range check refuses it; n itself is the identity.
refused P384PrivateKey.from_bytes(Array(UInt8).new(48, 0xff_u8)), "from 1 to n - 1", "d = 2^384 - 1"
refused P384PrivateKey.from_bytes(Array(UInt8).new(48, 0_u8)), "from 1 to n - 1", "d = 0"
refused P384PrivateKey.from_bytes(b("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973")), "from 1 to n - 1", "d = n"
refused P384PrivateKey.from_pkcs8([2_u8, 1_u8, 0_u8]), "the private key", "an INTEGER as PKCS #8"
# RFC 6979's d with G for its public key, and with prime256v1 named.
SEC1_WRONG_PUBLIC = ""
SEC1_OTHER_CURVE  = "304102010104306b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5a00a06082a8648ce3d030107"
refused P384PrivateKey.from_sec1(b(SEC1_WRONG_PUBLIC)), "its public key is not the private key's", "an ECPrivateKey carrying another public key"
refused P384PrivateKey.from_sec1(b(SEC1_OTHER_CURVE)), "names a curve that is not secp384r1", "an ECPrivateKey naming prime256v1"
puts "  47 bytes, 0, n, 2^384 - 1, an INTEGER for a OneAsymmetricKey, another public key and another curve refused"

puts "== Diffie-Hellman (ECDH): NIST's CAVP vectors"
CAVP_CDH.each_with_index do |line, i|
  v = line.split(' ')
  ours = P384PrivateKey.from_bytes(b(v[0])).or_panic
  check hex(ours.public_point) == "04" + v[1] + v[2], "NIST's CDH vector #{i}: QIUT"
  shared = ours.shared_secret(b("04" + v[3] + v[4]))
  check shared.is_a?(Array(UInt8)) && hex(shared) == v[5], "NIST's CDH vector #{i}: ZIUT"
end
CAVP_KEY_PAIRS.each_with_index do |line, i|
  v = line.split(' ')
  check hex(P384PrivateKey.from_bytes(b(v[0])).or_panic.public_point) == "04" + v[1] + v[2], "NIST's key pair #{i}"
end
cavp = P384PrivateKey.from_bytes(b(CAVP_CDH[0].split(' ')[0])).or_panic
cavs_point = b("04" + CAVP_CDH[0].split(' ')[3] + CAVP_CDH[0].split(' ')[4])
[one, last, key, cavp].each_with_index do |a, i|
  [one, last, key, cavp].each_with_index do |c, j|
    check a.shared_secret(c.public_point).or_panic == c.shared_secret(a.public_point).or_panic, "keys #{i} and #{j} agree"
  end
end
# [1]Q is Q and [n - 1]Q is -Q: both answer Q's own x.
check hex(one.shared_secret(cavs_point).or_panic) == CAVP_CDH[0].split(' ')[3], "d = 1 answers the peer's own x"
check hex(last.shared_secret(cavs_point).or_panic) == CAVP_CDH[0].split(' ')[3], "d = n - 1 answers the peer's own x"
puts "  25 CDH vectors (QIUT and ZIUT), 10 key pairs, four keys agreeing pairwise, d = 1 and d = n - 1"

puts "== points that are not P-384's"
# (0, 0) first, its reason printed as it is met. It is off the curve (b is
# not 0), so the curve check refuses it; past that, [d](0 : 0 : 1) under
# the complete formulas is (X : Y : 0) - doubling (0 : 0 : 1) gives
# (0 : Y : 0) when b is not 0 - and SEC 1's check of the point at infinity
# refuses it. The gate breaks the first wall alone and both, and reads
# which refusal this line names.
zero = key.shared_secret(Array(UInt8).new(97) { |i| i == 0 ? 4_u8 : 0_u8 })
raise "ASSERTION FAILED: (0, 0): accepted" unless zero.is_a?(EcdsaError)
puts "  (0, 0) refused: #{zero.message}"
off = cavs_point.dup
off[96] = off[96] ^ 1_u8
refused_point key.shared_secret(off), "not on P-384", "a point off the curve"
# (0, y) is on the curve; written with x = p it is the same point modulo
# p, which only the range check refuses.
X_ZERO_Y = "c306610fb0ae5a159cf45c06069f22a6c5eb3641c602d42dea2c4b4f75550793406d80d2b91ad54f9048bd487af1ade1"
refused_point key.shared_secret(b("04fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff" + X_ZERO_Y)), "a coordinate of p or more", "a point whose x is p"
check key.shared_secret(b("04" + "0" * 96 + X_ZERO_Y)).is_a?(Array(UInt8)), "the point (0, y) taken"
refused_point key.shared_secret(cavs_point[0, 49]), "is 97 bytes", "a compressed-length point"
refused_point key.shared_secret(cavs_point[0, 96]), "is 97 bytes", "a point a byte short"
refused_point key.shared_secret(cavs_point + [0_u8]), "is 97 bytes", "a point a byte long"
refused_point key.shared_secret([] of UInt8), "is 97 bytes", "no point"
compressed = cavs_point.dup
compressed[0] = 2_u8
refused_point key.shared_secret(compressed), "is 97 bytes", "a point not marked uncompressed"
refused_point key.shared_secret([0_u8]), "is 97 bytes", "the single byte 0x00, SEC 1's point at infinity"
CAVP_PKV.each_with_index do |line, i|
  v = line.split(' ')
  answer = key.shared_secret(b("04" + coordinate(v[1]) + coordinate(v[2])))
  if v[0] == "P0"
    check answer.is_a?(Array(UInt8)), "NIST's PKV #{i}, P: taken"
  else
    refused_point answer, v[0] == "F1" ? "is 97 bytes" : "not on P-384", "NIST's PKV #{i}, #{v[0]}"
  end
end
puts "  (0, 0), a point off the curve, x = p, 49, 96, 98 and 0 bytes, a 0x02 mark and the byte 0x00 refused;"
puts "  NIST's 12 PKV points: 4 P taken, 4 out of range and 4 off the curve refused"

puts "\nALL CHECKS PASSED"
