; iyi-ir 1
source_filename = "overflow_by_one_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @signed_add(i8 %x) {
entry:
  %value = and i8 %x, 127
  %pair = intrinsic llvm.sadd.with.overflow.i8(i8 %value, i8 1)
  %flag = extractvalue { i8, i1 } %pair, 1
  ret i1 %flag
}
define internal i1 @unsigned_add(i8 %x, i8 %y) {
entry:
  %value = and i8 %x, 127
  %pair = intrinsic llvm.uadd.with.overflow.i8(i8 %value, i8 %y)
  %flag = extractvalue { i8, i1 } %pair, 1
  ret i1 %flag
}
define internal i1 @signed_sub(i8 %x) {
entry:
  %value = and i8 %x, 127
  %pair = intrinsic llvm.ssub.with.overflow.i8(i8 %value, i8 -1)
  %flag = extractvalue { i8, i1 } %pair, 1
  ret i1 %flag
}
define internal i1 @signed_mul(i8 %x) {
entry:
  %value = and i8 %x, 15
  %pair = intrinsic llvm.smul.with.overflow.i8(i8 %value, i8 9)
  %flag = extractvalue { i8, i1 } %pair, 1
  ret i1 %flag
}
define internal i1 @signed_add_i64(i64 %x) {
entry:
  %value = and i64 %x, 9223372036854775807
  %pair = intrinsic llvm.sadd.with.overflow.i64(i64 %value, i64 1)
  %flag = extractvalue { i64, i1 } %pair, 1
  ret i1 %flag
}
