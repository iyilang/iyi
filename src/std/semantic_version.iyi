# Semantic versions, as Semantic Versioning 2.0.0 spells them:
# `MAJOR.MINOR.PATCH`, an optional `-prerelease` of dot-separated
# identifiers, an optional `+build` tail.
#
# `SemanticVersion.parse?` answers nil and `SemanticVersion.parse` panics
# with `not a semantic version: "1.0"` for anything the grammar refuses:
# a missing field, a leading zero in a numeric field or in a numeric
# prerelease identifier, an empty identifier (`1.0.0-alpha..1`, `1.0.0-`,
# `1.0.0+`), a byte outside `[0-9A-Za-z-]` in an identifier, a `v` prefix.
# One trailing newline is tolerated, the way a version read from a file
# arrives, and nothing else outside the grammar is.
#
# Ordering is the standard's: numeric fields, then prerelease identifiers
# (numeric before alphanumeric, numeric by value, alphanumeric by bytes,
# a shorter list first, and no prerelease after every prerelease). Build
# metadata never orders (`1.0.0+a` and `1.0.0+b` compare equal) but does
# distinguish (`==` and `hash` read it), so a set of versions keeps both.

module std/semantic_version

import std/traits
using std/traits::{Comparable}

pub struct SemanticVersion
  getter major : Int32
  getter minor : Int32
  getter patch : Int32
  getter build : String?
  getter prerelease : Prerelease

  # The dot-separated identifiers after `-`; a numeric identifier is held
  # as a number so that `beta.2 < beta.11`.
  struct Prerelease
    getter identifiers : Array(String | Int32)

    def self.parse(str : String) : self
      identifiers = [] of String | Int32
      return new(identifiers) if str.empty?
      parts = str.split('.')
      i = 0
      while i < parts.size
        part = parts[i]
        if n = part.to_i?
          identifiers << n
        else
          identifiers << part
        end
        i += 1
      end
      new(identifiers)
    end

    def initialize(@identifiers : Array(String | Int32) = [] of String | Int32)
    end

    def empty? : Bool
      @identifiers.empty?
    end

    def to_s(io : IO) : Nil
      io.write(to_s)
    end

    def to_s : String
      res = ""
      i = 0
      while i < @identifiers.size
        res = res + "." if i > 0
        res = res + @identifiers[i].to_s
        i += 1
      end
      res
    end

    def <=>(other : self) : Int32
      if @identifiers.empty?
        return other.identifiers.empty? ? 0 : 1
      elsif other.identifiers.empty?
        return -1
      end

      i = 0
      while i < @identifiers.size
        return 1 if i >= other.identifiers.size
        r = compare_identifier(@identifiers[i], other.identifiers[i])
        return r if r != 0
        i += 1
      end

      @identifiers.size < other.identifiers.size ? -1 : 0
    end

    private def compare_identifier(x : String | Int32, y : String | Int32) : Int32
      if x.is_a?(Int32)
        if y.is_a?(Int32)
          x == y ? 0 : (x < y ? -1 : 1)
        else
          -1
        end
      else
        if y.is_a?(Int32)
          1
        else
          x == y ? 0 : (x < y ? -1 : 1)
        end
      end
    end

    def ==(other : Prerelease) : Bool
      (self <=> other) == 0
    end

    def hash : Int32
      value = 17
      i = 0
      while i < @identifiers.size
        value = (value &* 31) &+ @identifiers[i].hash
        i += 1
      end
      value
    end
  end

  impl Comparable for Prerelease
    def <=>(other : self) : Int32
      self <=> other
    end
  end

  def self.valid?(str : String) : Bool
    !scan(str).nil?
  end

  def self.parse(str : String) : self
    parse?(str) || raise "not a semantic version: #{str.inspect}"
  end

  def self.parse?(str : String) : self?
    parts = scan(str)
    return nil unless parts

    major_range, minor_range, patch_range, pre_range, build_range = parts

    major_str = str[major_range.begin, major_range.end - major_range.begin]
    minor_str = str[minor_range.begin, minor_range.end - minor_range.begin]
    patch_str = str[patch_range.begin, patch_range.end - patch_range.begin]

    pre_str = pre_range ? str[pre_range.begin, pre_range.end - pre_range.begin] : nil
    build_str = build_range ? str[build_range.begin, build_range.end - build_range.begin] : nil

    major = major_str.to_i?
    minor = minor_str.to_i?
    patch = patch_str.to_i?
    # A field of more digits than an Int32 holds is a number the type
    # cannot carry, not a version.
    return nil unless major && minor && patch

    new(major, minor, patch, pre_str, build_str)
  end

  # Byte ranges of the five fields, or nil where the grammar is not met.
  private def self.scan(str : String)
    bytes = str.to_unsafe
    stop = str.bytesize

    stop -= 1 if stop > 0 && bytes[stop - 1] == 10_u8 # '\n'

    major_end = scan_field(bytes, 0, stop)
    return nil unless major_end
    return nil unless major_end < stop && bytes[major_end] == 46_u8 # '.'

    minor_end = scan_field(bytes, major_end + 1, stop)
    return nil unless minor_end
    return nil unless minor_end < stop && bytes[minor_end] == 46_u8 # '.'

    patch_end = scan_field(bytes, minor_end + 1, stop)
    return nil unless patch_end

    pos = patch_end
    prerelease = nil
    build = nil

    if pos < stop && bytes[pos] == 45_u8 # '-'
      pos += 1
      plus = pos
      while plus < stop && bytes[plus] != 43_u8 # '+'
        plus += 1
      end

      return nil unless scan_identifiers?(bytes, pos, plus, reject_leading_zero: true)
      prerelease = pos...plus
      pos = plus
    end

    if pos < stop && bytes[pos] == 43_u8 # '+'
      pos += 1
      return nil unless scan_identifiers?(bytes, pos, stop, reject_leading_zero: false)
      build = pos...stop
      pos = stop
    end

    return nil unless pos == stop

    {0...major_end, (major_end + 1)...minor_end, (minor_end + 1)...patch_end, prerelease, build}
  end

  # A numeric field: `0`, or a digit run that does not start with `0`.
  private def self.scan_field(bytes : Pointer(UInt8), start : Int32, stop : Int32) : Int32?
    return nil unless start < stop && bytes[start] >= 48_u8 && bytes[start] <= 57_u8
    return start + 1 if bytes[start] == 48_u8 # '0'

    pos = start + 1
    while pos < stop && bytes[pos] >= 48_u8 && bytes[pos] <= 57_u8
      pos += 1
    end
    pos
  end

  private def self.scan_identifiers?(bytes : Pointer(UInt8), start : Int32, stop : Int32, *, reject_leading_zero : Bool) : Bool
    pos = start

    while true
      first = pos
      numeric = true

      while pos < stop
        b = bytes[pos]
        break if b == 46_u8 # '.'
        is_num = b >= 48_u8 && b <= 57_u8
        is_alpha = (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8)
        is_dash = b == 45_u8
        return false unless is_num || is_alpha || is_dash
        numeric = false unless is_num
        pos += 1
      end

      return false if pos == first
      return false if reject_leading_zero && numeric && pos - first > 1 && bytes[first] == 48_u8

      break if pos == stop
      pos += 1
    end

    true
  end

  def initialize(@major : Int32, @minor : Int32, @patch : Int32, prerelease : String | Prerelease | Nil = nil, @build : String? = nil)
    raise "negative version field: #{@major}.#{@minor}.#{@patch}" if @major < 0 || @minor < 0 || @patch < 0
    @prerelease = case prerelease
                  when Prerelease
                    prerelease
                  when String
                    Prerelease.parse(prerelease)
                  else
                    Prerelease.new
                  end
  end

  def to_s(io : IO) : Nil
    io.write(to_s)
  end

  def to_s : String
    res = "#{@major}.#{@minor}.#{@patch}"
    unless @prerelease.empty?
      res = res + "-" + @prerelease.to_s
    end
    if b = @build
      res = res + "+" + b
    end
    res
  end

  def copy_with(major : Int32 = @major, minor : Int32 = @minor, patch : Int32 = @patch, prerelease : String | Prerelease | Nil = @prerelease, build : String? = @build) : SemanticVersion
    SemanticVersion.new(major, minor, patch, prerelease, build)
  end

  def bump_major : self
    copy_with(major: @major + 1, minor: 0, patch: 0, prerelease: nil, build: nil)
  end

  def bump_minor : self
    copy_with(minor: @minor + 1, patch: 0, prerelease: nil, build: nil)
  end

  # A prerelease of a patch is bumped to that patch; a release to the next.
  def bump_patch : self
    if @prerelease.empty?
      copy_with(patch: @patch + 1, prerelease: nil, build: nil)
    else
      copy_with(prerelease: nil, build: nil)
    end
  end

  # Precedence, with build metadata ignored as the standard says.
  def <=>(other : self) : Int32
    r = @major == other.major ? 0 : (@major < other.major ? -1 : 1)
    return r unless r == 0
    r = @minor == other.minor ? 0 : (@minor < other.minor ? -1 : 1)
    return r unless r == 0
    r = @patch == other.patch ? 0 : (@patch < other.patch ? -1 : 1)
    return r unless r == 0
    @prerelease <=> other.prerelease
  end

  # Identity, with build metadata read: `1.0.0+a` is not `1.0.0+b`.
  def ==(other : SemanticVersion) : Bool
    (self <=> other) == 0 && @build == other.build
  end

  def hash : Int32
    value = @major
    value = (value &* 31) &+ @minor
    value = (value &* 31) &+ @patch
    value = (value &* 31) &+ @prerelease.hash
    if b = @build
      value = (value &* 31) &+ b.hash
    end
    value
  end
end

impl Comparable for SemanticVersion
  def <=>(other : self) : Int32
    self <=> other
  end
end
