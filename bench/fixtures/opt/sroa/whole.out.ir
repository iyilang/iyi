; iyi-ir 1
source_filename = "whole"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external iyicc { i64, i64 } @whole({ i64, i64 } %pair) {
entry:
  %0 = extractvalue { i64, i64 } %pair, 0
  %1 = extractvalue { i64, i64 } %pair, 1
  %2 = insertvalue { i64, i64 } zeroinitializer, i64 %0, 0
  %3 = insertvalue { i64, i64 } %2, i64 %1, 1
  ret { i64, i64 } %3
}
