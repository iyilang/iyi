; iyi-ir 1
source_filename = "partition_asm_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal ptr @__iyi_new(i64 %size, i64 %tid, i64 %flags) {
entry:
  ret ptr null
}
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @assembly_reference() {
entry:
  call void () asm sideeffect "bl __iyi_publish", ""()
  ret void
}
define external i64 @local() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 3, i64 2)
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
define external i32 @known_header() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 19, i64 1)
  %header = getelementptr i8, ptr %p, i64 -4
  %id = load i32, ptr %header, align 4
  ret i32 %id
}
define external void @stack_barrier(ptr %value) {
entry:
  %slot = alloca { ptr, ptr }, align 8
  %field = getelementptr inbounds { ptr, ptr }, ptr %slot, i32 0, i32 1
  %mark = load i8, ptr @__iyi_marking, align 1
  %active = icmp ne i8 %mark, 0
  br i1 %active, label %begin, label %plain
begin:
  call void () @__iyi_write_barrier_begin()
  br label %join
plain:
  br label %join
join:
  store ptr %value, ptr %field, align 8
  br i1 %active, label %shade, label %done
shade:
  call void (ptr, i64) @__iyi_write_barrier(ptr %field, i64 1)
  br label %done
done:
  ret void
}
