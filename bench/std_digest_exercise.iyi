# Exercises `std/digest`.
#
# Run via:
#     ./bin/iyi run bench/std_digest_exercise.iyi

module bench/std_digest_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/digest::{Digest, MD5, SHA1, SHA224, SHA256, SHA384, SHA512, SHA3_224, SHA3_256, SHA3_384, SHA3_512, SHAKE128, SHAKE256, CRC32, CRC64, Adler32, XXH64}

puts "== md5"
assert_str "d41d8cd98f00b204e9800998ecf8427e", MD5.hexdigest(""), "empty"
assert_str "900150983cd24fb0d6963f7d28e17f72", MD5.hexdigest("abc"), "abc"
puts "  empty and abc"

puts "\n== sha"
assert_str "da39a3ee5e6b4b0d3255bfef95601890afd80709", SHA1.hexdigest(""), "sha1 empty"
assert_str "a9993e364706816aba3e25717850c26c9cd0d89d", SHA1.hexdigest("abc"), "sha1 abc"
assert_str "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", SHA256.hexdigest(""), "sha256 empty"
assert_str "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", SHA256.hexdigest("abc"), "sha256 abc"
assert_str "df81eea14671ce970fb1052e9f5dd6dbda652ed37423ed3624120ec1534784a7", SHA256.hexdigest("fooø"), "sha256 of a string's bytes, not its characters"
puts "  SHA-1 and SHA-256"

# FIPS 180-4's examples: one block, two blocks of 448 and 896 bits (the
# length field forced into a block of its own), and a million a's.
puts "\n== sha-2"
m448 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
m896 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
million = "a" * 1000000
assert_str "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7", SHA224.hexdigest("abc"), "sha224 abc"
assert_str "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f", SHA224.hexdigest(""), "sha224 empty"
assert_str "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525", SHA224.hexdigest(m448), "sha224 448 bits"
assert_str "20794655980c91d8bbb4c1ea97618a4bf03f42581948b2ee4ee7ad67", SHA224.hexdigest(million), "sha224 a million a's"
assert_str "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", SHA256.hexdigest(m448), "sha256 448 bits"
assert_str "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0", SHA256.hexdigest(million), "sha256 a million a's"
assert_str "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7", SHA384.hexdigest("abc"), "sha384 abc"
assert_str "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b", SHA384.hexdigest(""), "sha384 empty"
assert_str "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039", SHA384.hexdigest(m896), "sha384 896 bits"
assert_str "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985", SHA384.hexdigest(million), "sha384 a million a's"
assert_str "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", SHA512.hexdigest("abc"), "sha512 abc"
assert_str "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", SHA512.hexdigest(""), "sha512 empty"
assert_str "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445", SHA512.hexdigest(m448), "sha512 448 bits"
assert_str "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909", SHA512.hexdigest(m896), "sha512 896 bits"
assert_str "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b", SHA512.hexdigest(million), "sha512 a million a's"
assert_true SHA512.hash_bytes("abc").size == 64 && SHA384.hash_bytes("abc").size == 48 && SHA224.hash_bytes("abc").size == 28, "digest sizes"
assert_true SHA512.new.block_size == 128 && SHA384.new.block_size == 128 && SHA224.new.block_size == 64 && MD5.new.block_size == 64, "block sizes"
puts "  SHA-224, SHA-256, SHA-384 and SHA-512 on FIPS 180-4's messages"

# Every message length from 0 to 300 bytes, which crosses each place the
# padding can fall for both block sizes: the hex digests of each, joined,
# hashed once more. Python's hashlib gives these.
puts "\n== every length"

def chain(algorithm : H.class) : String forall H
  joined = ""
  n = 0
  while n <= 300
    joined = joined + algorithm.hexdigest("a" * n)
    n = n + 1
  end
  SHA256.hexdigest(joined)
end

assert_str "27452e6cf089495b517655679d0a5c4285eae74ac242a82ddf3e7056e69a6e50", chain(MD5), "md5 lengths 0..300"
assert_str "13c163778aff2d852f9b4f1ae660d9e229888173a4dc54b0411459757b6badc4", chain(SHA1), "sha1 lengths 0..300"
assert_str "c5d85bca0cf36324f09e3359c05a87d92483519c7a2676da490d2b726d8347f1", chain(SHA224), "sha224 lengths 0..300"
assert_str "1d2ef37f10edc523a59e4fa147289061bd7b8b98a208a636c2b3334c56a5838d", chain(SHA256), "sha256 lengths 0..300"
assert_str "33a3b0c3f322c61b2e2bb9a6e9feebe78e8839fbf636fb4b2920aa17ecd73428", chain(SHA384), "sha384 lengths 0..300"
assert_str "1d3846c8feab28aac0bc7c7079d241a7017202a8f3d2b1eb488e81fbb9491ef4", chain(SHA512), "sha512 lengths 0..300"
puts "  six hashes over every length to 300 bytes"

# 1,280 bytes, 0 to 255 five times, given in pieces of 1, 8, 15, ...
# bytes: a piece that fills a part-filled block, one that spans blocks,
# and one that leaves a remainder all happen.
puts "\n== in pieces"
bytes = Array(UInt8).new(1280) { |i| (i % 256).to_u8 }

def in_pieces(d : Digest, bytes : Array(UInt8)) : String
  i = 0
  step = 1
  while i < bytes.size
    stop = i + step > bytes.size ? bytes.size : i + step
    d.update(bytes.to_unsafe + i.to_i64, stop - i)
    i = stop
    step = step + 7
  end
  d.hexfinal
end

assert_str "82829f1f3f2bb0f18b25f278e5bba8bd", in_pieces(MD5.new, bytes), "md5 in pieces"
assert_str "e37a04cb2353309f5cff4ee036cfb91a5e31cefd", in_pieces(SHA1.new, bytes), "sha1 in pieces"
assert_str "e2e07ef955598bf865c30a5dca2ac6af0711cf7b28d37f58a81acef3", in_pieces(SHA224.new, bytes), "sha224 in pieces"
assert_str "d414b085826eb06778483ba35564dc849e643359f69ed9747878ba6e54985bed", in_pieces(SHA256.new, bytes), "sha256 in pieces"
assert_str "f5943b1fe9e4b5bd3b45c83ef1e748f5e0f095f405a67d11a37016e5e908a4c5033bf084186d1e352db6fdda24dda58c", in_pieces(SHA384.new, bytes), "sha384 in pieces"
assert_str "c93f55ccf2fa8c82699ff9b58afe3591242b135d908a6d865e17e38adb41c21d1d5359e51273036373d54d20b5659cc87e6e7b381ff027d33f971416cc590f90", in_pieces(SHA512.new, bytes), "sha512 in pieces"
assert_str SHA256.hexdigest(bytes), SHA256.new.update(bytes).hexfinal, "an Array(UInt8) whole"
puts "  1,280 bytes in growing pieces, against the whole"

puts "\n== state"
d = SHA512.new
d.update("ab")
copy = d.dup
d.update("x")
copy.update("c")
assert_str SHA512.hexdigest("abc"), copy.hexfinal, "a dup goes on from where it was copied"
assert_str SHA512.hexdigest("abx"), d.hexfinal, "and the original is untouched by it"
d.reset
d.update("abc")
assert_str SHA512.hexdigest("abc"), d.hexfinal, "reset after final hashes again"
keyed = SHA256.new
keyed.update("a" * 100)
e = SHA256.new
e.update("unrelated")
e.copy_from(keyed)
e.update("b")
assert_str SHA256.hexdigest("a" * 100 + "b"), e.hexfinal, "copy_from takes the bytes taken and the block in progress"
into = Array(UInt8).new(40, 7_u8)
SHA256.new.update("abc").final(into)
assert_true into[0] == 0xba_u8 && into[31] == 0xad_u8 && into[32] == 7_u8, "final into an array writes the digest and nothing past it"
puts "  dup, reset, copy_from and final into a buffer"

# FIPS 202's examples as NIST publishes them (csrc.nist.gov, "Example
# Values"): the empty message and 1,600 bits of 0xa3, 200 bytes, which
# is more than every rate and so absorbs a whole block and pads another.
# SHAKE's 1,600-bit examples give 4,096 bits of output: its last 16 bytes
# here, and SHA-256 of all 512, which python's hashlib also gives.
puts "\n== sha-3"
a3 = Array(UInt8).new(200, 0xa3_u8)
assert_str "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7", SHA3_224.hexdigest(""), "sha3-224 empty"
assert_str "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", SHA3_256.hexdigest(""), "sha3-256 empty"
assert_str "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004", SHA3_384.hexdigest(""), "sha3-384 empty"
assert_str "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26", SHA3_512.hexdigest(""), "sha3-512 empty"
assert_str "9376816aba503f72f96ce7eb65ac095deee3be4bf9bbc2a1cb7e11e0", SHA3_224.hexdigest(a3), "sha3-224 of 200 bytes of 0xa3"
assert_str "79f38adec5c20307a98ef76e8324afbfd46cfd81b22e3973c65fa1bd9de31787", SHA3_256.hexdigest(a3), "sha3-256 of 200 bytes of 0xa3"
assert_str "1881de2ca7e41ef95dc4732b8f5f002b189cc1e42b74168ed1732649ce1dbcdd76197a31fd55ee989f2d7050dd473e8f", SHA3_384.hexdigest(a3), "sha3-384 of 200 bytes of 0xa3"
assert_str "e76dfad22084a8b1467fcf2ffa58361bec7628edf5f3fdc0e4805dc48caeeca81b7c13c30adf52a3659584739a2df46be589c51ca1a4a8416df6545a1ce8ba00", SHA3_512.hexdigest(a3), "sha3-512 of 200 bytes of 0xa3"
assert_str "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26", SHAKE128.hexdigest("", 32), "shake128 empty"
assert_str "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f", SHAKE256.hexdigest("", 32), "shake256 empty"
long128 = SHAKE128.hash_bytes(a3, 512)
long256 = SHAKE256.hash_bytes(a3, 512)
assert_str "c1134ff48c4e5e770824f32bdcc5b4f80376fa3d2a957297ce5728780bb8551c", SHA256.hexdigest(long128), "shake128 of 200 bytes of 0xa3, 512 bytes out"
assert_str "5324d170930075b539d5b2752dfe21dca1a2172f5fc7f48ab6f468162ab458ea", SHA256.hexdigest(long256), "shake256 of 200 bytes of 0xa3, 512 bytes out"
assert_str "f17d7259ab075216c0699511643b6439", SHAKE128.hexdigest(a3, 512)[992, 32], "shake128's last 16 of 512 bytes"
assert_str "ca92bf0be5615e96959d767197a0beeb", SHAKE256.hexdigest(a3, 512)[992, 32], "shake256's last 16 of 512 bytes"
assert_true SHA3_224.new.block_size == 144 && SHA3_256.new.block_size == 136 && SHA3_384.new.block_size == 104 && SHA3_512.new.block_size == 72, "sha3 rates"
assert_true SHAKE128.new.block_size == 168 && SHAKE256.new.block_size == 136, "shake rates"
assert_str "be2be6e6c147e29e18ee15898183f629374e212f58b3870d51d77eea41c6e238", chain(SHA3_224), "sha3-224 lengths 0..300"
assert_str "10ffe9e389e3016f3d7f929bb6816eaa2fa4b56e53a0144623c7309cf4fc33d9", chain(SHA3_256), "sha3-256 lengths 0..300"
assert_str "618d1675e5bd5aa12f0c1104afb30097057d48adc05bdc414da2c98d1d2146ef", chain(SHA3_384), "sha3-384 lengths 0..300"
assert_str "24789ebaf0d13822b010648e28e37c75dec683b516e978eaa85390d2c3827232", chain(SHA3_512), "sha3-512 lengths 0..300"
assert_str in_pieces(SHA3_256.new, bytes), SHA3_256.hexdigest(bytes), "sha3-256 in pieces"
assert_str in_pieces(SHA3_512.new, bytes), SHA3_512.hexdigest(bytes), "sha3-512 in pieces"
puts "  SHA3-224, SHA3-256, SHA3-384, SHA3-512, SHAKE128 and SHAKE256 on FIPS 202's messages"

# Reads of 0 to 40 bytes, joined, are the one read of their total, across
# both rates' block ends; and a dup and a reset behave as SHA-2's do.
puts "\n== shake reads"
whole = SHAKE128.new.update("abc").read(2000)
x = SHAKE128.new.update("abc")
at = 0
step = 0
while at < 2000
  n = step % 41
  n = 2000 - at if at + n > 2000
  piece = x.read(n)
  piece.each_with_index { |byte, i| assert_true byte == whole[at + i], "shake128 read in pieces, byte #{at + i}" }
  at = at + n
  step = step + 1
end
x.reset
x.update("abc")
assert_true x.read(2000) == whole, "shake reset reads again"
s3 = SHA3_384.new
s3.update("ab")
s3copy = s3.dup
s3copy.update("c")
assert_str SHA3_384.hexdigest("abc"), s3copy.hexfinal, "a sha3 dup goes on from where it was copied"
puts "  reads in pieces against one read, reset and dup"

puts "\n== checksum"
assert_str "00000000", CRC32.hexdigest(""), "crc empty"
assert_str "cbf43926", CRC32.hexdigest("123456789"), "crc ITU"
assert_str "00000001", Adler32.hexdigest(""), "adler empty"
assert_str "091e01de", Adler32.hexdigest("123456789"), "adler ITU"
# Past a table's eight bytes and Adler-32's 5,552 between reductions,
# on bytes near their largest: python's zlib gives these.
ones = "\u00ff" * 5552
assert_str "fb3469c3", CRC32.hexdigest(ones), "crc of 11,104 bytes of 0xc3 0xbf"
assert_str "73c4b541", Adler32.hexdigest(ones), "adler of 11,104 bytes of 0xc3 0xbf"
puts "  CRC-32 and Adler-32"

# `update` goes on from a finished checksum, so a message cut anywhere and
# taken in its pieces is the checksum of the whole: every cut of 300
# bytes, and cuts either side of 5,552 bytes in the long one, where
# Adler-32's reduction falls inside the first piece or straddles the two.
def crc_in_pieces(s : String, cut : Int32) : UInt32
  CRC32.update(CRC32.update(0_u32, s.to_unsafe, cut), s.to_unsafe + cut.to_i64, s.bytesize - cut)
end

def adler_in_pieces(s : String, cut : Int32) : UInt32
  Adler32.update(Adler32.update(1_u32, s.to_unsafe, cut), s.to_unsafe + cut.to_i64, s.bytesize - cut)
end

mixed = String.new(300) do |dst|
  i = 0
  while i < 300
    dst[i] = ((i * 37 + 11) & 0xff).to_u8
    i = i + 1
  end
end
cut = 0
while cut <= 300
  assert_true crc_in_pieces(mixed, cut) == CRC32.checksum(mixed), "crc in pieces, cut at #{cut}"
  assert_true adler_in_pieces(mixed, cut) == Adler32.checksum(mixed), "adler in pieces, cut at #{cut}"
  cut = cut + 1
end
[1, 5551, 5552, 5553, 7000, 11103].each do |at|
  assert_true crc_in_pieces(ones, at) == CRC32.checksum(ones), "crc in pieces of the long one, cut at #{at}"
  assert_true adler_in_pieces(ones, at) == Adler32.checksum(ones), "adler in pieces of the long one, cut at #{at}"
end
assert_true CRC32.update(0_u32, mixed.to_unsafe, 0) == 0_u32 && Adler32.update(1_u32, mixed.to_unsafe, 0) == 1_u32, "nothing taken is the start"
puts "  CRC-32 and Adler-32 in pieces, cut anywhere"

# CRC-64/XZ: reveng's catalogue gives 995dc9bbdf1939fa as its check
# value, the CRC of "123456789"; the others are what liblzma stores as a
# block's CRC64 (Python's `lzma.compress(data, check=CHECK_CRC64)`), and
# the .sh compares three thousand more with it.
puts "\n== crc-64"
assert_str "995dc9bbdf1939fa", CRC64.hexdigest("123456789"), "crc64 check value"
assert_str "0000000000000000", CRC64.hexdigest(""), "crc64 empty"
assert_str "1f641a570685fc3f", CRC64.hexdigest("abcdefghijklmnopqrstuvwxyz0123456789" * 3), "crc64 of 108 bytes, as liblzma has it"

def crc64_in_pieces(s : String, cut : Int32) : UInt64
  CRC64.update(CRC64.update(0_u64, s.to_unsafe, cut), s.to_unsafe + cut.to_i64, s.bytesize - cut)
end

cut = 0
while cut <= 300
  assert_true crc64_in_pieces(mixed, cut) == CRC64.checksum(mixed), "crc64 in pieces, cut at #{cut}"
  cut = cut + 1
end
[1, 7, 8, 9, 5552, 11103].each do |at|
  assert_true crc64_in_pieces(ones, at) == CRC64.checksum(ones), "crc64 in pieces of the long one, cut at #{at}"
end
assert_true CRC64.update(0_u64, mixed.to_unsafe, 0) == 0_u64, "crc64: nothing taken is the start"
puts "  CRC-64 of the check value, of nothing, and in pieces, cut anywhere"

# What a checksum costs against a pass that only adds the bytes up: CRC-32
# went a bit at a time and Adler-32 reduced twice a byte, 36 and 7 times
# the pass in a plain build. A release build turns the pass into vector
# code, so the ratio means nothing there and is not asked.
{% unless flag?(:release) %}
  def byte_sum(s : String) : UInt32
    p = s.to_unsafe
    sum = 0_u32
    i = 0
    while i < s.bytesize
      sum = sum &+ p[i].to_u32
      i = i + 1
    end
    sum
  end

  sample = "0123456789abcdefghijklmnopqrstuvwxyz!?" * 60000
  best_sum = 0_i64
  best_crc = 0_i64
  best_adler = 0_i64
  seen = 0_u32
  3.times do |k|
    t0 = IyiMark.now_ns
    seen = seen ^ byte_sum(sample)
    t1 = IyiMark.now_ns
    seen = seen ^ CRC32.checksum(sample)
    t2 = IyiMark.now_ns
    seen = seen ^ Adler32.checksum(sample)
    t3 = IyiMark.now_ns
    best_sum = (t1 - t0).to_i64 if k == 0 || (t1 - t0).to_i64 < best_sum
    best_crc = (t2 - t1).to_i64 if k == 0 || (t2 - t1).to_i64 < best_crc
    best_adler = (t3 - t2).to_i64 if k == 0 || (t3 - t2).to_i64 < best_adler
  end
  assert_true best_crc < best_sum * 6, "crc cost: #{best_crc * 10 // best_sum}/10 of a byte sum (#{seen})"
  # Adler-32 is 1.3 byte sums on x86_64, and reduced every byte 7.
  assert_true best_adler < best_sum * 4, "adler cost: #{best_adler * 10 // best_sum}/10 of a byte sum"
  # Named without its measurements: `bench/std_exercise.sh` runs this from
  # source and from artifacts and compares what it prints.
  puts "  CRC-32 and Adler-32 within a few passes that add the bytes up"
{% end %}

puts "\n== xxh64"
# xxhash's own values for nothing, "a" and "abc"; the rest checked by a
# reference in Python that Python's zstd agrees with in the low 32 bits,
# which is what a frame's checksum carries. A stripe is 32 bytes, so 31,
# 32 and 100 bytes are a tail alone, one stripe, and stripes and a tail.
assert_str "ef46db3751d8e999", XXH64.hexdigest(""), "xxh64 empty"
assert_str "d24ec4f1a98c6e5b", XXH64.hexdigest("a"), "xxh64 of 'a'"
assert_str "44bc2cf5ad770999", XXH64.hexdigest("abc"), "xxh64 of 'abc'"
assert_str "d5afba1336a3be4b", XXH64.hexdigest("", 1_u64), "xxh64 empty, seed 1"
assert_str "26c7827d889f6da3", XXH64.hexdigest("hello"), "xxh64 of 'hello'"
assert_str "60dd0d01083b99f0", XXH64.hexdigest("x" * 31), "xxh64 of 31 bytes"
assert_str "64da1f1d3495ce66", XXH64.hexdigest("y" * 32), "xxh64 of one stripe"
assert_str "d30e21c99c2a766d", XXH64.hexdigest("z" * 100), "xxh64 of 100 bytes"
assert_str "51a7c25008bf8063", XXH64.hexdigest("z" * 100, 1_u64), "xxh64 of 100 bytes, seed 1"
cut = 0
while cut <= 300
  h = XXH64.new
  h.update(mixed.to_unsafe, cut)
  h.update(mixed.to_unsafe + cut.to_i64, 300 - cut)
  assert_true h.digest == XXH64.checksum(mixed), "xxh64 in pieces, cut at #{cut}"
  cut = cut + 1
end
h = XXH64.new
h.update(mixed.to_unsafe, 50)
midway = h.digest
h.update(mixed.to_unsafe + 50_i64, 250)
assert_true midway == XXH64.checksum(mixed[0, 50]) && h.digest == XXH64.checksum(mixed), "xxh64 asked midway goes on as if it had not been"
h.reset
assert_true h.digest == XXH64.checksum(""), "xxh64 reset is the hash of nothing"
puts "  XXH64 of xxhash's values and the reference's, in pieces cut anywhere, asked midway, reset"

puts "\nALL CHECKS PASSED"
