@[Unsafe("the program declares the float-to-integer conversion primitives it measures")]
module float_to_int

import std/float
import std/int

# Every float-to-integer conversion the compiler lowers, from a single and a double to each integer width:
# `sat_*` is the unchecked primitive (llvm.fpto{si,ui}.sat: NaN is 0, past the range the nearer bound) and `chk_*`
# the checked one (the prelude's range check, then the truncation). Each value reaches the conversion as a
# parameter, so nothing is folded, and the last line converts NaN with the checked form, which stops the program.

struct ::Float32
  @[::Primitive(:unchecked_convert)]
  def sat_i8 : Int8
  end

  @[::Primitive(:convert)]
  def chk_i8 : Int8
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i16 : Int16
  end

  @[::Primitive(:convert)]
  def chk_i16 : Int16
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i32 : Int32
  end

  @[::Primitive(:convert)]
  def chk_i32 : Int32
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i64 : Int64
  end

  @[::Primitive(:convert)]
  def chk_i64 : Int64
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i128 : Int128
  end

  @[::Primitive(:convert)]
  def chk_i128 : Int128
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u8 : UInt8
  end

  @[::Primitive(:convert)]
  def chk_u8 : UInt8
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u16 : UInt16
  end

  @[::Primitive(:convert)]
  def chk_u16 : UInt16
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u32 : UInt32
  end

  @[::Primitive(:convert)]
  def chk_u32 : UInt32
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u64 : UInt64
  end

  @[::Primitive(:convert)]
  def chk_u64 : UInt64
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u128 : UInt128
  end

  @[::Primitive(:convert)]
  def chk_u128 : UInt128
  end
end

struct ::Float64
  @[::Primitive(:unchecked_convert)]
  def sat_i8 : Int8
  end

  @[::Primitive(:convert)]
  def chk_i8 : Int8
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i16 : Int16
  end

  @[::Primitive(:convert)]
  def chk_i16 : Int16
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i32 : Int32
  end

  @[::Primitive(:convert)]
  def chk_i32 : Int32
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i64 : Int64
  end

  @[::Primitive(:convert)]
  def chk_i64 : Int64
  end

  @[::Primitive(:unchecked_convert)]
  def sat_i128 : Int128
  end

  @[::Primitive(:convert)]
  def chk_i128 : Int128
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u8 : UInt8
  end

  @[::Primitive(:convert)]
  def chk_u8 : UInt8
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u16 : UInt16
  end

  @[::Primitive(:convert)]
  def chk_u16 : UInt16
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u32 : UInt32
  end

  @[::Primitive(:convert)]
  def chk_u32 : UInt32
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u64 : UInt64
  end

  @[::Primitive(:convert)]
  def chk_u64 : UInt64
  end

  @[::Primitive(:unchecked_convert)]
  def sat_u128 : UInt128
  end

  @[::Primitive(:convert)]
  def chk_u128 : UInt128
  end
end

def quotient(a : Float64, b : Float64) : Float64
  a / b
end

def single_quotient(a : Float32, b : Float32) : Float32
  a / b
end

def saturate_double(x : Float64) : Nil
  puts "#{x.sat_i8} #{x.sat_i16} #{x.sat_i32} #{x.sat_i64} #{x.sat_i128} #{x.sat_u8} #{x.sat_u16} #{x.sat_u32} #{x.sat_u64} #{x.sat_u128}"
end

def saturate_single(x : Float32) : Nil
  puts "#{x.sat_i8} #{x.sat_i16} #{x.sat_i32} #{x.sat_i64} #{x.sat_i128} #{x.sat_u8} #{x.sat_u16} #{x.sat_u32} #{x.sat_u64} #{x.sat_u128}"
end

def f32_i8(x : Float32) : Int8
  x.chk_i8
end

def f32_i16(x : Float32) : Int16
  x.chk_i16
end

def f32_i32(x : Float32) : Int32
  x.chk_i32
end

def f32_i64(x : Float32) : Int64
  x.chk_i64
end

def f32_i128(x : Float32) : Int128
  x.chk_i128
end

def f32_u8(x : Float32) : UInt8
  x.chk_u8
end

def f32_u16(x : Float32) : UInt16
  x.chk_u16
end

def f32_u32(x : Float32) : UInt32
  x.chk_u32
end

def f32_u64(x : Float32) : UInt64
  x.chk_u64
end

def f32_u128(x : Float32) : UInt128
  x.chk_u128
end

def f64_i8(x : Float64) : Int8
  x.chk_i8
end

def f64_i16(x : Float64) : Int16
  x.chk_i16
end

def f64_i32(x : Float64) : Int32
  x.chk_i32
end

def f64_i64(x : Float64) : Int64
  x.chk_i64
end

def f64_i128(x : Float64) : Int128
  x.chk_i128
end

def f64_u8(x : Float64) : UInt8
  x.chk_u8
end

def f64_u16(x : Float64) : UInt16
  x.chk_u16
end

def f64_u32(x : Float64) : UInt32
  x.chk_u32
end

def f64_u64(x : Float64) : UInt64
  x.chk_u64
end

def f64_u128(x : Float64) : UInt128
  x.chk_u128
end

saturate_double(quotient(0.0, 0.0))
saturate_double(quotient(1.0, 0.0))
saturate_double(quotient(-1.0, 0.0))
saturate_double(0.0)
saturate_double(-0.0)
saturate_double(0.5)
saturate_double(-0.5)
saturate_double(1.5)
saturate_double(-1.5)
saturate_double(127.5)
saturate_double(128.0)
saturate_double(-128.5)
saturate_double(-129.0)
saturate_double(255.5)
saturate_double(256.0)
saturate_double(32767.5)
saturate_double(32768.0)
saturate_double(-32768.5)
saturate_double(-32769.0)
saturate_double(65535.5)
saturate_double(65536.0)
saturate_double(2147483647.5)
saturate_double(2147483648.0)
saturate_double(-2147483648.5)
saturate_double(-2147483649.0)
saturate_double(4294967295.5)
saturate_double(4294967296.0)
saturate_double(9223372036854774784.0)
saturate_double(9223372036854775808.0)
saturate_double(-9223372036854775808.0)
saturate_double(-9223372036854777856.0)
saturate_double(18446744073709549568.0)
saturate_double(18446744073709551616.0)
saturate_double(170141183460469212842221372237303250944.0)
saturate_double(170141183460469231731687303715884105728.0)
saturate_double(-170141183460469231731687303715884105728.0)
saturate_double(-170141183460469269510619166673045815296.0)
saturate_double(340282366920938425684442744474606501888.0)
saturate_double(340282366920938463463374607431768211456.0)
saturate_double(1.0e300)
saturate_double(-1.0e300)
saturate_single(single_quotient(0.0_f32, 0.0_f32))
saturate_single(single_quotient(1.0_f32, 0.0_f32))
saturate_single(single_quotient(-1.0_f32, 0.0_f32))
saturate_single(0.0_f32)
saturate_single(-0.0_f32)
saturate_single(0.5_f32)
saturate_single(-0.5_f32)
saturate_single(127.5_f32)
saturate_single(128.0_f32)
saturate_single(-128.5_f32)
saturate_single(-129.0_f32)
saturate_single(255.5_f32)
saturate_single(256.0_f32)
saturate_single(32767.5_f32)
saturate_single(32768.0_f32)
saturate_single(-32768.5_f32)
saturate_single(-32769.0_f32)
saturate_single(65535.5_f32)
saturate_single(65536.0_f32)
saturate_single(2147483520.0_f32)
saturate_single(2147483648.0_f32)
saturate_single(-2147483648.0_f32)
saturate_single(-2147483904.0_f32)
saturate_single(4294967040.0_f32)
saturate_single(4294967296.0_f32)
saturate_single(9223371487098961920.0_f32)
saturate_single(9223372036854775808.0_f32)
saturate_single(-9223372036854775808.0_f32)
saturate_single(18446742974197923840.0_f32)
saturate_single(18446744073709551616.0_f32)
saturate_single(170141173319264429905852091742258462720.0_f32)
saturate_single(170141183460469231731687303715884105728.0_f32)
saturate_single(-170141183460469231731687303715884105728.0_f32)
saturate_single(-170141203742878835383357727663135391744.0_f32)
saturate_single(340282346638528859811704183484516925440.0_f32)
saturate_single(-340282346638528859811704183484516925440.0_f32)
puts "#{f32_i8(127.5_f32)} #{f32_i8(-128.5_f32)}"
puts "#{f32_i16(32767.5_f32)} #{f32_i16(-32768.5_f32)}"
puts "#{f32_i32(2147483520.0_f32)} #{f32_i32(-2147483648.0_f32)}"
puts "#{f32_i64(9223371487098961920.0_f32)} #{f32_i64(-9223372036854775808.0_f32)}"
puts "#{f32_i128(170141173319264429905852091742258462720.0_f32)} #{f32_i128(-170141183460469231731687303715884105728.0_f32)}"
puts "#{f32_u8(255.5_f32)} #{f32_u8(-0.5_f32)}"
puts "#{f32_u16(65535.5_f32)} #{f32_u16(-0.5_f32)}"
puts "#{f32_u32(4294967040.0_f32)} #{f32_u32(-0.5_f32)}"
puts "#{f32_u64(18446742974197923840.0_f32)} #{f32_u64(-0.5_f32)}"
puts "#{f32_u128(340282346638528859811704183484516925440.0_f32)} #{f32_u128(-0.5_f32)}"
puts "#{f64_i8(127.5)} #{f64_i8(-128.5)}"
puts "#{f64_i16(32767.5)} #{f64_i16(-32768.5)}"
puts "#{f64_i32(2147483647.5)} #{f64_i32(-2147483648.5)}"
puts "#{f64_i64(9223372036854774784.0)} #{f64_i64(-9223372036854775808.0)}"
puts "#{f64_i128(170141183460469212842221372237303250944.0)} #{f64_i128(-170141183460469231731687303715884105728.0)}"
puts "#{f64_u8(255.5)} #{f64_u8(-0.5)}"
puts "#{f64_u16(65535.5)} #{f64_u16(-0.5)}"
puts "#{f64_u32(4294967295.5)} #{f64_u32(-0.5)}"
puts "#{f64_u64(18446744073709549568.0)} #{f64_u64(-0.5)}"
puts "#{f64_u128(340282366920938425684442744474606501888.0)} #{f64_u128(-0.5)}"
puts f64_i32(quotient(0.0, 0.0))
