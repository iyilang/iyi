# Exercises std/ecdsa: ECDSA signatures checked on P-256, P-384 and P-521,
# and keys read and refused.
#
# With no argument: signatures Python's cryptography made, each curve
# under each hash, the digest cut where it is longer than the group's
# order (P-256 under SHA-512); signatures made by hand that break one rule
# each - r or s zero, n, or past n, r and s swapped, a third INTEGER, a
# byte after the signature, r negative or written a byte longer than DER
# allows, a SET for the SEQUENCE - and n - s, which is the other valid
# signature and is taken. Keys whose private value is 1 and n - 1, so that
# u1·G + u2·Q meets a doubling (Q = G) and the identity (Q = -G): on P-384
# in G + Q, which the bit-at-a-time path adds first; on P-256 in signatures
# whose width-5 and width-7 digits of u2 and u1 meet (D1 over "special
# 11" and "special 73", DNEG over "special 3" and "special 9", about one
# signature in eighteen, found by running Python's signatures through a
# copy that said so). Then
# keys that are not keys. The modes the gate script drives:
#   verify FILE   each line `spki hash message signature`, in hex,
#                 answered `true`, `false` or `key: <why>`;
#   roots DIR     each certificate's own signature checked with its own
#                 key, where both are ECDSA: `name true|false|skip`.

import std/ecdsa::{EcdsaPublicKey, EcdsaCurve, EcdsaHash, EcdsaError}
import std/asn1::{Der, DerValue, Asn1Error}
import std/dir::{Dir}
import std/file::{File}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def hash_named(name : String) : EcdsaHash
  case name
  when "SHA256" then EcdsaHash::SHA256
  when "SHA384" then EcdsaHash::SHA384
  else               EcdsaHash::SHA512
  end
end

def refused(der : String, phrase : String, label : String) : Nil
  answer = EcdsaPublicKey.from_spki(b(der))
  raise "ASSERTION FAILED: #{label}: accepted" unless answer.is_a?(EcdsaError)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

def read_file(path : String) : Array(UInt8)
  data = File.read(path)
  Array(UInt8).new(data.bytesize) { |i| data.to_unsafe[i] }
end

# The hash a certificate's ecdsa-with-SHA* signature algorithm names.
def certificate_hash(algorithm : Array(DerValue)) : String?
  case algorithm[0].oid.or_panic
  when "1.2.840.10045.4.3.2" then "SHA256"
  when "1.2.840.10045.4.3.3" then "SHA384"
  when "1.2.840.10045.4.3.4" then "SHA512"
  else                            nil
  end
end

