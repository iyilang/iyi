    0x3f941d60a76a82ed_u64, 0x3f941db571d96126_u64, 0xb8ddf34bcdacf353_u64, 0x3f9921c0a0486537_u64,
    0x3f99226605233224_u64, 0xb9338e672f1696d5_u64, 0x3f99c360a8dd681a_u64, 0x3f99c412d62c1440_u64,
    0x3911edd261167baf_u64, 0x3f9d6315f7ee7e01_u64, 0x3f9d641e6d5e769a_u64, 0xb92af7dec023f5b9_u64,
    0x3f9ea6fdc56fc61a_u64, 0x3f9ea829e3e988e5_u64, 0xb92f358e90326f9a_u64, 0x3fa2749dc4d19c6d_u64,
    0x3fa275a3d78c01ec_u64, 0x39149ab71c17bd11_u64, 0x3fa69768dc89bb00_u64, 0x3fa69949b3d51fb1_u64,
    0xb8e14b91318650e8_u64, 0x3faa4816b2066707_u64, 0x3faa4b0bfb0454d5_u64, 0x3c4fffffffffffff_u64,
    0x3fad77b117f230d6_u64, 0x3fad7bdcd778049f_u64, 0x38daafc31a59e093_u64, 0x3fafc7a07b2549aa_u64,
    0x3fafccdc252cad1f_u64, 0xb92dc02fdac5159a_u64, 0x3fb2df0542154f1b_u64, 0x3fb2e36813a98740_u64,
    0xb9363abaa885a4da_u64, 0x3fb51cf5db1b1956_u64, 0x3fb5231b416ba885_u64, 0xb93e1e3f45d0bec3_u64,
    0x3fcd0ef799001ba9_u64, 0x3fcd5064e6fe82c5_u64, 0xb9284b9ecb11e241_u64, 0x3fd4a8e1a96e38e3_u64,
    0x3fd50954b7bbf87b_u64, 0xb93b9f88cfb1ef42_u64, 0x3fdceee68154d1c9_u64, 0x3fde05b0e0a809bc_u64,
    0x394117d6aecd2594_u64, 0x3fdda4e0e6c717a5_u64, 0x3fded25c5eb8c916_u64, 0xb9289e120e5744a5_u64,
    0x3fde9950730c4696_u64, 0x3fdfe767739d0f6d_u64, 0x38716376667a73f3_u64,
  ]

  # Nearest integer, ties to even, of 0 <= x < 2^52.
  private def self.invtrig_roundeven(x : Float64) : Float64
    (x + 4503599627370496.0) - 4503599627370496.0
  end

  private def self.invtrig_fasttwosum(x : Float64, y : Float64) : {Float64, Float64}
    s = x + y
    z = s - x
    {s, y - z}
  end

  private def self.invtrig_fastsum(xh : Float64, xl : Float64, yh : Float64, yl : Float64) : {Float64, Float64}
    sh, sl = invtrig_fasttwosum(xh, yh)
    {sh, (xl + yl) + sl}
  end

  private def self.invtrig_muldd(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahhh = ch * xh
    {ahhh, (cl * xh + ch * xl) + fma(ch, xh, ahhh * -1.0)}
  end

  # polydd over INVTRIG_C (n = 5); l is the low tail fed in.
  private def self.invtrig_polydd(xh : Float64, xl : Float64, l : Float64) : {Float64, Float64}
    c = INVTRIG_C.to_unsafe
    ch, l = invtrig_fasttwosum(IyiFloatText.from_bits(c[8]), l)
    cl = IyiFloatText.from_bits(c[9]) + l
    i = 3
    while i >= 0
      ch, cl = invtrig_muldd(xh, xl, ch, cl)
      ch, cl = invtrig_fastsum(IyiFloatText.from_bits(c[2 * i]), IyiFloatText.from_bits(c[2 * i + 1]), ch, cl)
      i -= 1
    end
    {ch, cl}
  end

  # asin(z + zl) + (f0h + f0l) on the shared table: row round(128 z^2), t the
  # offset from it; {lb, ub} bracket the result.
  private def self.invtrig_fast(z : Float64, zl : Float64, t : Float64, jd : Float64, f0h : Float64, f0l : Float64, eps : Float64) : {Float64, Float64}
    c = INVTRIG_CC.to_unsafe
    j = jd.unsafe_to_i32 * 8
    t2 = t * t
    d = t * ((IyiFloatText.from_bits(c[j + 2]) + t * IyiFloatText.from_bits(c[j + 3])) + t2 * ((IyiFloatText.from_bits(c[j + 4]) + t * IyiFloatText.from_bits(c[j + 5])) + t2 * (IyiFloatText.from_bits(c[j + 6]) + t * IyiFloatText.from_bits(c[j + 7]))))
    fh = IyiFloatText.from_bits(c[j])
    fl = IyiFloatText.from_bits(c[j + 1]) + d
    fh, fl = invtrig_muldd(z, zl, fh, fl)
    fh, fl = invtrig_fastsum(f0h, f0l, fh, fl)
    {fh + (fl - eps), fh + (fl + eps)}
  end

  # The refinements' common start: sqrt(1 - x^2) as ch + cl, then the
  # rotation by the table angle jf*pi/64 to v + dv, and the asin series of
  # it (times s) as {fh, fl}.
  private def self.invtrig_rotate(x : Float64, jf : Int32, s : Float64) : {Float64, Float64}
    s2 = x * x
    dx2 = fma(x, x, s2 * -1.0)
    c2h, c2l = invtrig_fasttwosum(1.0, s2 * -1.0)
    c2l = c2l - dx2
    c2h, c2l = invtrig_fasttwosum(c2h, c2l)
    ch = sqrt(c2h)
    cl = (c2l - fma(ch, ch, c2h * -1.0)) * (0.5 / ch)
    tab = INVTRIG_S.to_unsafe
    big_ch = IyiFloatText.from_bits(tab[(32 - jf) * 2 + 1])
    big_cl = IyiFloatText.from_bits(tab[(32 - jf) * 2])
    big_sh = IyiFloatText.from_bits(tab[jf * 2 + 1])
    big_sl = IyiFloatText.from_bits(tab[jf * 2])
    ax = x.abs
    dsh = ax - big_sh
    dsl = big_sl * -1.0
    dch = ch - big_ch
    dcl = cl - big_cl
    sc = fma(big_sh, dch, 0.09375) - 0.09375
    dsc = fma(big_sh, dch, sc * -1.0)
    cs = fma(big_ch, dsh, 0.09375) - 0.09375
    dcs = fma(big_ch, dsh, cs * -1.0)
    v = cs - sc
    dv = (big_ch * dsl + big_cl * dsh) - (big_sh * dcl + big_sl * dch) - (dsc - dcs)
    v, dv = invtrig_fasttwosum(v, dv)
    ct = INVTRIG_CT.to_unsafe
    v2, dv2 = invtrig_muldd(v, dv, v, dv)
    v = v * s
    dv = dv * s
    fl = v2 * (IyiFloatText.from_bits(ct[0]) + v2 * (IyiFloatText.from_bits(ct[1]) + v2 * IyiFloatText.from_bits(ct[2])))
    fh, fl = invtrig_polydd(v2, dv2, fl)
    invtrig_muldd(v, dv, fh, fl)
  end

  private def self.atan_muldd_acc(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahlh = ch * xl
    alhh = cl * xh
    ahhh = ch * xh
    ahhl = fma(ch, xh, ahhh * -1.0)
    ahhl = ahhl + (alhh + ahlh)
    invtrig_fasttwosum(ahhh, ahhl)
  end

  private def self.atan_adddd(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    s = xh + ch
    d = s - xh
    {s, ((ch - d) + (xh + (d - s))) + (xl + cl)}
  end

  # as_atan_refine2's polydd over its 3-row ch.
  private def self.atan_polydd(xh : Float64, xl : Float64, l : Float64) : {Float64, Float64}
    ch = -0.14285714285714285 + l
    cl = (-0.14285714285714285 - ch) + l + -7.930161522310759e-18
    ch, cl = atan_muldd_acc(xh, xl, ch, cl)
    th = ch + 0.2
    tl = (0.2 - th) + ch
    ch = th
    cl = cl + (tl + -1.1102230246265417e-17)
    ch, cl = atan_muldd_acc(xh, xl, ch, cl)
    th = ch + -0.3333333333333333
    tl = (-0.3333333333333333 - th) + ch
    ch = th
    cl = cl + (tl + -1.850371707708594e-17)
    {ch, cl}
  end

  # as_atan_refine2: 0x1p-27 <= |x|, a the fast path's approximation.
  private def self.atan_refine(x : Float64, a : Float64) : Float64
    tab = ATAN_A.to_unsafe
    phi = a.abs * 81.48733086305042 + 256.5
    i = (IyiFloatText.bits_of(phi).unsafe_shr(44_u64) & 0xff_u64).unsafe_to_i32
    h = 0.0
    hl = 0.0
    if i == 128
      h = -1.0 / x
      hl = fma(h, x, 1.0) * h
    else
      ta = copysign(IyiFloatText.from_bits(tab[i * 2]), x)
      zta = x * ta
      ztal = fma(x, ta, zta * -1.0)
      zmta = x - ta
      v = 1.0 + zta
      d = 1.0 - v
      ev = (d + zta) - ((d + v) - 1.0) + ztal
      r = 1.0 / v
      rl = (fma(r, v * -1.0, 1.0) - ev * r) * r
      h = r * zmta
      hl = fma(r, zmta, h * -1.0) + rl * zmta
    end
    h2, h2l = atan_muldd_acc(h, hl, h, hl)
    h4 = h2 * h2
    h3, h3l = atan_muldd_acc(h, hl, h2, h2l)
    fl = h2 * ((0.1111111111111111 + h2 * -0.09090909090907358) + h4 * (0.07692307637971313 + h2 * -0.06665779689246536))
    f, fl = atan_polydd(h2, h2l, fl)
    f, fl = atan_muldd_acc(h3, h3l, f, fl)
    ah = h
    al = f
    at = fl
    if i != 0
      df = 0.0
      df = copysign(1.0, x) * IyiFloatText.from_bits(tab[i * 2 + 1]) if i < 128
      id = copysign(i.to_f64, x)
      ah = 0.012271846303085088 * id
      al = 4.21117410793604e-17 * id
      at = -9.794523599166037e-32 * id
      al, at = atan_adddd(al, at, df, 0.0)
      al, at = atan_adddd(al, at, h, hl)
      al, at = atan_adddd(al, at, f, fl)
    end
    v0, v2 = invtrig_fasttwosum(ah, al)
    v1, v2 = invtrig_fasttwosum(v2, at)
    ax = x.abs
    t0 = IyiFloatText.bits_of(v0)
    t1 = IyiFloatText.bits_of(v1)
    mask = 0x000fffffffffffff_u64
    if ((t1 &+ 1_u64) & mask) <= 2_u64 || (t0.unsafe_shr(52_u64) & 0x7ff_u64) &- (t1.unsafe_shr(52_u64) & 0x7ff_u64) > 103_u64
      db = ATAN_DB.to_unsafe
      j = 0
      while j < 12
        if ax == IyiFloatText.from_bits(db[j * 3])
          return copysign(IyiFloatText.from_bits(db[j * 3 + 1]), x) + copysign(1.0, x) * IyiFloatText.from_bits(db[j * 3 + 2])
        end
        j += 1
      end
      if t1 & mask == 0_u64
        w = IyiFloatText.bits_of(v2)
        t1 = (w ^ t1).unsafe_shr(63_u64) != 0_u64 ? t1 &- 1_u64 : t1 &+ 1_u64
        v1 = IyiFloatText.from_bits(t1)
      end
    end
    v1 + v0
  end

  private def self.asin_database(x : Float64, f : Float64) : Float64
    db = ASIN_DB.to_unsafe
    ax = x.abs
    a = 0
    b = 29
    while a + 1 < b
      m = (a + b) // 2
      if IyiFloatText.from_bits(db[m * 3]) <= ax
        a = m
      else
        b = m
      end
    end
    return f unless IyiFloatText.from_bits(db[a * 3]) == ax
    hi = IyiFloatText.from_bits(db[a * 3 + 1])
    lo = IyiFloatText.from_bits(db[a * 3 + 2])
    x > 0.0 ? hi + lo : hi * -1.0 - lo
  end

  # as_asin_refine, phi the fast path's approximation.
  private def self.asin_refine(x : Float64, phi : Float64) : Float64
    jf = invtrig_roundeven(phi.abs * 20.371832715762604).unsafe_to_i32
    sgn = copysign(1.0, x)
    jt = jf.to_f64 * sgn
    fh, fl = invtrig_rotate(x, jf, sgn)
    ph = jt * 0.04908738521234035
    pl = 1.684469643174416e-16 * jt
    ps = -3.917809439666406e-31 * jt
    pl, ps = invtrig_fastsum(fh, fl, pl, ps)
    ph, pl = invtrig_fasttwosum(ph, pl)
    pl, ps = invtrig_fasttwosum(pl, ps)
    ph, pl = invtrig_fasttwosum(ph, pl)
    pl, ps = invtrig_fasttwosum(pl, ps)
    th = IyiFloatText.bits_of(ph)
    tl = IyiFloatText.bits_of(pl) & 0x7fffffffffffffff_u64
    tn = (th & 0x7ff0000000000000_u64) &- 0x0350000000000000_u64
    dn = (tl &- tn).unsafe_to_i64
    de = (tn &- tl).unsafe_shr(52_u64)
    res = ph + pl
    res = asin_database(x, res) if (dn >= -2_i64 && dn <= 0_i64) || de > 47_u64
    res
  end

  # as_acos_refine, phi the fast path's approximation.
  private def self.acos_refine(x : Float64, phi : Float64) : Float64
    jf = invtrig_roundeven((phi - 1.5707963267948966).abs * 20.371832715762604).unsafe_to_i32
    sgn = copysign(1.0, x)
    jt = 32.0 - jf.to_f64 * sgn
    fh, fl = invtrig_rotate(x, jf, sgn * -1.0)
    ph = jt * 0.04908738521234035
    pl = 1.684469643174416e-16 * jt
    ps = -3.917809439666406e-31 * jt
    # sum: a two-sum (not fast) of fh and pl
    sh = fh + pl
    a_prime = sh - pl
    b_prime = sh - a_prime
    sl = (fh - a_prime) + (pl - b_prime)
    pl = sh
    ps = (fl + ps) + sl
    ph, pl = invtrig_fasttwosum(ph, pl)
    pl, ps = invtrig_fasttwosum(pl, ps)
    ph, pl = invtrig_fasttwosum(ph, pl)
    pl, ps = invtrig_fasttwosum(pl, ps)
    t = IyiFloatText.bits_of(pl)
    e = (t.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i64 &- 1023_i64
    e = 52_i64 &- (107_i64 &+ e)
    e = 0_i64 if e < 0_i64
    e = 52_i64 if e > 52_i64
    m = 0x0010000000000000_u64 &- 1_u64.unsafe_shl(e.unsafe_to_u64)
    e = 64_i64 if e == 0_i64
    if (t &+ 1_u64.unsafe_shl((e &- 1_i64).unsafe_to_u64)) & m == 0_u64
      return 3.5762786865234566e-07 + 1.3234889800848443e-23 if x == 0.999999999999936
      return 1.4877135408445967 + 5.551115123125783e-17 if x == 0.08298723566019295
      return 1.5698246257648432 + 1.6653345369377348e-16 if x == 0.0009717008771394217
      return 1.788139343261721e-07 + 6.617444900424222e-24 if x == 0.999999999999984
      return 1.5325721397906955 - 1.5407439555097887e-33 if x == 0.038214879531014476
      w = IyiFloatText.bits_of(ps)
      t = (w ^ t).unsafe_shr(63_u64) != 0_u64 ? t &- 1_u64 : t &+ 1_u64
      pl = IyiFloatText.from_bits(t)
    end
    ph + pl
  end

  def self.atan(value : Float64) : Float64
    x = value
    bits = IyiFloatText.bits_of(x)
    at = bits & 0x7fffffffffffffff_u64
    if at < 0x3f7b21c475e6362a_u64
      return x if at == 0_u64
      return fma(-5.551115123125783e-17, x, x) if at < 0x3e40000000000000_u64
      x2 = x * x
      x3 = x * x2
      x4 = x2 * x2
      f = x3 * ((-0.3333333333333333 + x2 * 0.199999999999994) + x4 * (-0.1428571424743179 + x2 * 0.11110113960028833))
      epsp = f * 1.2212453270876722e-15
      epsm = f * 6.106226635438361e-16
      ub = (f + epsp) + x
      lb = (f - epsm) + x
      return ub if ub == lb
      return atan_refine(x, ub)
    end
    h = 0.0
    ah = 0.0
    al = 0.0
    if at > 0x4062ded8e34a9035_u64
      ah = copysign(1.5707963267948966, x)
      al = copysign(6.123233995736766e-17, x)
      if at >= 0x434d02967c31cdb5_u64
        return x + x if at > 0x7ff0000000000000_u64
        return ah + al
      end
      h = -1.0 / x
    else
      c = ATAN_C.to_unsafe
      tab = ATAN_A.to_unsafe
      k = (at.unsafe_shr(51_u64) &- 2030_u64).unsafe_to_i32 * 3
      u = bits & 0x0007ffffffffffff_u64
      ut = u.unsafe_shr(35_u64)
      ut2 = (ut &* ut).unsafe_shr(16_u64)
      i = ((c[k].unsafe_shl(16_u64) &+ ut &* c[k + 1]) &- ut2 &* c[k + 2]).unsafe_shr(25_u64).unsafe_to_i32
      sgn = copysign(1.0, x)
      ta = sgn * IyiFloatText.from_bits(tab[i * 2])
      id = sgn * i.to_f64
      al = sgn * IyiFloatText.from_bits(tab[i * 2 + 1]) + 4.2111741079360304e-17 * id
      h = (x - ta) / (1.0 + x * ta)
      ah = 0.012271846303085088 * id
    end
    h2 = h * h
    h4 = h2 * h2
    f = (1.0 + h2 * -0.333333333333331) + h4 * (0.1999999997326265 + h2 * -0.1428473928322857)
    al = fma(h, f, al)
    e = h * 8.743006318923108e-16
    ub = (al + e) + ah
    lb = (al - e) + ah
    return ub if ub == lb
    atan_refine(x, ub)
  end

  def self.atan(value : Float32) : Float32
    atan(value.to_f64).to_f32
  end

  def self.atan(value : T) : Float64 forall T
    atan(value.to_f64)
  end

  # atan2: CORE-MATH's correctly rounded cr_atan2 (binary64/atan2/atan2.c
  # and tint.h at revision b1a4badf6765), ported operation for operation.
  # Copyright (c) 2023-2025 Paul Zimmermann and Alexei Sibidanov; MIT
  # licence. Tables hold each double's bits in the C file's row-major order;
  # a tint_t is five words h, m, l, ex, sgn: (-1)^sgn (h/2^64 + m/2^128 +
  # l/2^192) 2^ex. Only the exception flags and errno were left out.

  private ATAN2_T2 = [
    0x0000000000000000_u64, 0x3f90000000000000_u64, 0x3fa0000000000000_u64, 0x3fa8000000000000_u64,
    0x3fb0000000000000_u64, 0x3fb4000000000000_u64, 0x3fb8000000000000_u64, 0x3fbc000000000000_u64,
    0x3fc0000000000000_u64, 0x3fc2000000000000_u64, 0x3fc4000000000000_u64, 0x3fc6000000000000_u64,
    0x3fc8000000000000_u64, 0x3fca000000000000_u64, 0x3fcc000000000000_u64, 0x3fce000000000000_u64,
    0x3fd0000000000000_u64, 0x3fd1000000000000_u64, 0x3fd2000000000000_u64, 0x3fd3000000000000_u64,
    0x3fd4000000000000_u64, 0x3fd5000000000000_u64, 0x3fd6000000000000_u64, 0x3fd7000000000000_u64,
    0x3fd8000000000000_u64, 0x3fd9000000000000_u64, 0x3fda000000000000_u64, 0x3fdb000000000000_u64,
    0x3fdc000000000000_u64, 0x3fdd000000000000_u64, 0x3fde000000000000_u64, 0x3fdf000000000000_u64,
    0x3fe0000000000000_u64, 0x3fe0800000000000_u64, 0x3fe1000000000000_u64, 0x3fe1800000000000_u64,
    0x3fe2000000000000_u64, 0x3fe2800000000000_u64, 0x3fe3000000000000_u64, 0x3fe3800000000000_u64,
    0x3fe4000000000000_u64, 0x3fe4800000000000_u64, 0x3fe5000000000000_u64, 0x3fe5800000000000_u64,
    0x3fe6000000000000_u64, 0x3fe6800000000000_u64, 0x3fe7000000000000_u64, 0x3fe7800000000000_u64,
    0x3fe8000000000000_u64, 0x3fe8800000000000_u64, 0x3fe9000000000000_u64, 0x3fe9800000000000_u64,
    0x3fea000000000000_u64, 0x3fea800000000000_u64, 0x3feb000000000000_u64, 0x3feb800000000000_u64,
    0x3fec000000000000_u64, 0x3fec800000000000_u64, 0x3fed000000000000_u64, 0x3fed800000000000_u64,
    0x3fee000000000000_u64, 0x3fee800000000000_u64, 0x3fef000000000000_u64, 0x3fef800000000000_u64,
    0x3ff0000000000000_u64,
  ]
  private ATAN2_F2 = [
    0x0000000000000000_u64, 0x0000000000000000_u64, 0xbca95220c39d4dff_u64, 0x3f8fff555bbb7300_u64,
    0x3ca2542779d776de_u64, 0x3f9ffd55bba97600_u64, 0xbca6061bbe3de53c_u64, 0x3fa7fb818430da40_u64,
    0xbca639269b0da47e_u64, 0x3faff55bb72cfe00_u64, 0xbc84a7663af440f7_u64, 0x3fb3f59f0e7c55a0_u64,
    0x3cad1824d59f9e13_u64, 0x3fb7ee182602f100_u64, 0x3c8bef71e5340b31_u64, 0x3fbbe39ebe6f07c0_u64,
