# The one sequence — SPEC.md, "0.1.0", item 3.
#
# `Array` is a compiler-known generic class, like `String`: an array literal is
# lowered to `Array(T).unsafe_build` and `to_unsafe` before any of this is
# read (`LiteralExpander#expand`), so those two names are not ours to choose.
#
# A buffer, a size and a capacity. Growth doubles, which is the only policy
# that keeps a run of `<<` linear, and there is no shrinking: nothing in the
# samples removes elements.
class Array(T)
  @size : Int32
  @capacity : Int32
  @buffer : Pointer(T)

  def initialize
    @size = 0
    @capacity = 0
    @buffer = Pointer(T).new(0_u64)
  end

  def initialize(capacity : Int32)
    # A negative capacity reached `to_u64` and panicked about arithmetic,
    # which says nothing about the array that was asked for.
    raise "negative capacity" if capacity < 0
    @size = 0
    @capacity = capacity
    @buffer = capacity == 0 ? Pointer(T).new(0_u64) : Pointer(T).malloc(capacity.to_u64)
  end

  # `Array(T).new(n) { |i| ... }`: n elements, each the block's answer for
  # its index - a row of a grid, a table of squares.
  def self.new(size : Int32, & : Int32 -> T) : Array(T)
    raise "negative size" if size < 0
    array = Array(T).new(size)
    index = 0
    while index < size
      array << yield index
      index = index + 1
    end
    array
  end

  # An array of *capacity* elements that are not written yet. The literal
  # expander fills them through `to_unsafe` immediately afterwards, which is
  # why this is allowed to hand out a size it has not stored anything at.
  def self.unsafe_build(capacity : Int32) : Array(T)
    array = Array(T).new(capacity)
    array.unsafe_set_size(capacity)
    array
  end

  # :nodoc:
  def unsafe_set_size(size : Int32) : Nil
    @size = size
  end

  def to_unsafe : Pointer(T)
    @buffer
  end

  def size : Int32
    @size
  end

  def empty? : Bool
    @size == 0
  end

  def <<(value : T) : Array(T)
    grow if @size == @capacity
    @buffer[@size] = value
    @size = @size + 1
    self
  end

  # A negative index counts from the end, so `a[-1]` is the last element.
  # Still out of range after that wrap (or empty) raises, same message.
  def [](index : Int32) : T
    asked = index
    index = @size + index if index < 0
    raise "index #{asked} out of range for #{@size} elements" if index < 0 || index >= @size
    @buffer[index]
  end

  def []?(index : Int32) : T?
    index = @size + index if index < 0
    return nil if index < 0 || index >= @size
    @buffer[index]
  end

  def []=(index : Int32, value : T) : T
    asked = index
    index = @size + index if index < 0
    raise "index #{asked} out of range for #{@size} elements" if index < 0 || index >= @size
    @buffer[index] = value
  end

  def each(& : T -> Nil) : Nil
    index = 0
    while index < @size
      yield @buffer[index]
      index = index + 1
    end
  end

  # Here rather than on `Enumerable`: the trait is iyi's, written in
  # `src/std`, and every one of its methods that returns a sequence
  # returns one of these. So an `Array` is what a sample ends up holding, and
  # `join` is what it ends up calling.
  # With nothing between: `["a", "b"].join` is `"ab"`.
  def join : String
    join("")
  end

  def join(separator : String) : String
    result = ""
    first = true
    each do |value|
      result = result + separator unless first
      result = result + value.to_s
      first = false
    end
    result
  end

  # No zero to start from — that would need a trait this prelude does not
  # have — so an empty array is a panic rather than a 0. The trait's own `sum`
  # does have one (`Num.zero`) and answers for the empty case.
  def sum : T
    raise "sum of an empty array" if empty?

    total = @buffer[0]
    index = 1
    while index < @size
      total = total + @buffer[index]
      index = index + 1
    end
    total
  end

  # The sum of what the block answers for each element.
  def sum(& : T -> U) : U forall U
    raise "sum of an empty array" if empty?

    total = yield @buffer[0]
    index = 1
    while index < @size
      total = total + (yield @buffer[index])
      index = index + 1
    end
    total
  end

  def map(& : T -> U) : Array(U) forall U
    result = Array(U).new(@size)
    each { |value| result << yield value }
    result
  end

  # `a.concat(a)` is a doubling, not a loop: `each` walked *other*'s growing
  # size while `<<` grew it, so `[1, 2].concat(itself)` grew the buffer until
  # the capacity arithmetic overflowed. The length is read once.
  def concat(other : Array(T)) : Array(T)
    index = 0
    taking = other.size
    while index < taking
      self << other[index]
      index = index + 1
    end
    self
  end

  def last? : T?
    empty? ? nil : @buffer[@size - 1]
  end

  # `last` on an empty array is a mistake rather than a nil, as `first` is.
  def last : T
    raise "last of an empty array" if empty?
    @buffer[@size - 1]
  end

  def each_with_index(& : T, Int32 -> Nil) : Nil
    index = 0
    while index < @size
      yield @buffer[index], index
      index = index + 1
    end
  end

  # The questions a list gets asked with one answer. `find` answers nil
  # when none does, the way Crystal's does and `index` below already did.
  def count(& : T -> Bool) : Int32
    total = 0
    each { |value| total = total + 1 if yield value }
    total
  end

  def any?(& : T -> Bool) : Bool
    each { |value| return true if yield value }
    false
  end

  def all?(& : T -> Bool) : Bool
    each { |value| return false unless yield value }
    true
  end

  def find(& : T -> Bool) : T?
    each { |value| return value if yield value }
    nil
  end

  # The element whose key is largest, or smallest, by `<` on the keys; the
  # first of equals. Empty is a mistake, as with `first`.
  def max_by(& : T -> U) : T forall U
    raise "max_by of an empty array" if empty?
    best = @buffer[0]
    best_key = yield best
    index = 1
    while index < @size
      key = yield @buffer[index]
      if best_key < key
        best = @buffer[index]
        best_key = key
      end
      index = index + 1
    end
    best
  end

  def min_by(& : T -> U) : T forall U
    raise "min_by of an empty array" if empty?
    best = @buffer[0]
    best_key = yield best
    index = 1
    while index < @size
      key = yield @buffer[index]
      if key < best_key
        best = @buffer[index]
        best_key = key
      end
      index = index + 1
    end
    best
  end

  # Removes and returns the last element. Empty is a mistake, as with `last`.
  def pop : T
    raise "pop of an empty array" if empty?
    @size = @size - 1
    @buffer[@size]
  end

  # Removes and returns the first element, moving the rest down. Linear, which
  # is what an array without a head offset costs; `each_cons` in the trait is
  # the one caller and its window is `n` long.
  def shift : T
    raise "shift of an empty array" if empty?

    value = @buffer[0]
    index = 1
    while index < @size
      @buffer[index - 1] = @buffer[index]
      index = index + 1
    end
    @size = @size - 1
    value
  end

  # The first element or nil, which is how a queue is drained: `while
  # item = queue.shift?`.
  def shift? : T?
    empty? ? nil : shift
  end

  # Insertion sort: the samples sort five elements, and a merge sort would be
  # three times the lines to be slower at that size.
  # Sorts this array, and `sorted` is the one that leaves it alone.
  #
  # The name is spelled out because of the library beside this one (SPEC.md
  # III.1.7a). III.1.7(A) says the plain verb mutates and the participle
  # copies, which is Swift's convention and was chosen because `!` had to leave
  # identifiers so that postfix `!` could propagate an error. Crystal spells
  # the same pair `sort!` and `sort`, so a plain `sort` here would mean the
  # opposite of a plain `sort` under `--crystal` — the same call, two meanings,
  # no error. A longer name costs a few characters and cannot be misread.
  def sort_in_place(& : T, T -> Int32) : self
    index = 1
    while index < @size
      value = self[index]
      slot = index - 1
      while slot >= 0 && (yield self[slot], value) > 0
        self[slot + 1] = self[slot]
        slot = slot - 1
      end
      self[slot + 1] = value
      index = index + 1
    end
    self
  end

  # The copy, with the comparison written out. One body, because the difference
  # between the pair is which array it runs on.
  def sorted(&block : T, T -> Int32) : Array(T)
    copy = dup
    copy.sort_in_place(&block)
    copy
  end

  # Sorted on a key each element answers, ascending by `<`: the same pair
  # as above, one name longer. The key is computed once per comparison
  # rather than once per element, which is the cost of an insertion sort
  # with no scratch array; the arrays this prelude sorts are short.
  def sort_in_place_by(& : T -> U) : self forall U
    index = 1
    while index < @size
      value = self[index]
      key = yield value
      slot = index - 1
      while slot >= 0 && key < (yield self[slot])
        self[slot + 1] = self[slot]
        slot = slot - 1
      end
      self[slot + 1] = value
      index = index + 1
    end
    self
  end

  def sorted_by(&block : T -> U) : Array(T) forall U
    copy = dup
    copy.sort_in_place_by(&block)
    copy
  end

  # `first` on an empty array is a mistake rather than a nil: the array knows
  # it is empty and so does whoever wrote the call. `last?` above answers the
  # other question, and is the one the trait defaults use.
  def first : T
    raise "first of an empty array" if empty?
    @buffer[0]
  end

  # The first `n`, or all of them when there are fewer: a prefix, not a
  # question, so it never panics.
  def first(n : Int32) : Array(T)
    raise "negative count: #{n}" if n < 0
    count = n < @size ? n : @size
    result = Array(T).new(count)
    index = 0
    while index < count
      result << @buffer[index]
      index = index + 1
    end
    result
  end

  def select(& : T -> Bool) : Array(T)
    result = Array(T).new(@size)
    each { |value| result << value if yield value }
    result
  end

  # The elements that are not nil, in an array whose type says so: what a
  # list of `to_i?` answers becomes once the failures are dropped.
  def compact
    result = [] of typeof(compact_element)
    each do |value|
      result << value unless value.nil?
    end
    result
  end

  # :nodoc:
  # The element type without Nil, for `compact`'s array: never called,
  # only typed.
  private def compact_element
    value = @buffer[0]
    raise "" if value.nil?
    value
  end

  def reject(& : T -> Bool) : Array(T)
    result = Array(T).new(@size)
    each { |value| result << value unless yield value }
    result
  end

  def includes?(value : T) : Bool
    each { |element| return true if element == value }
    false
  end

  # Where a value first is, or nil.
  def index(value : T) : Int32?
    index = 0
    while index < @size
      return index if @buffer[index] == value
      index = index + 1
    end
    nil
  end

  # Removes the first element equal to `value`, closing the gap; answers
  # whether there was one.
  def delete(value : T) : Bool
    at = index(value)
    return false unless at
    while at < @size - 1
      @buffer[at] = @buffer[at + 1]
      at = at + 1
    end
    @size = @size - 1
    true
  end

  # A copy in the other order.
  def reversed : Array(T)
    result = Array(T).new(@size)
    index = @size
    while index > 0
      index = index - 1
      result << @buffer[index]
    end
    result
  end

  # Each value once, in the order first met: quadratic, on the arrays a
  # first program has.
  def uniq : Array(T)
    result = Array(T).new(@size)
    each { |value| result << value unless result.includes?(value) }
    result
  end

  # The same values as a `Set`, in the order first met.
  def to_set : Set(T)
    set = Set(T).new
    each { |value| set.add(value) }
    set
  end

  # Pairs, element by element, as long as the shorter.
  def zip(other : Array(U)) : Array(Tuple(T, U)) forall U
    count = @size < other.size ? @size : other.size
    result = Array(Tuple(T, U)).new(count)
    index = 0
    while index < count
      result << {@buffer[index], other[index]}
      index = index + 1
    end
    result
  end

  def reduce(initial : U, & : U, T -> U) : U forall U
    accumulator = initial
    each { |value| accumulator = yield accumulator, value }
    accumulator
  end

  # `sort` takes the comparison, `sorted` is the one for elements that already
  # compare — SPEC.md III.1.7(A)'s pair, with the name that says a copy comes
  # back.
  def sorted : Array(T)
    sorted { |a, b| a < b ? -1 : (a == b ? 0 : 1) }
  end

  # `[1, 2, 3]`, the way it is written: an array printed is its elements
  # inspected, so a string inside keeps its quotes and a nil says so.
  def to_s : String
    "[" + map { |value| value.inspect }.join(", ") + "]"
  end

  def inspect : String
    to_s
  end

  def dup : Array(T)
    copy = Array(T).new(@size)
    each { |value| copy << value }
    copy
  end

  def ==(other : Array(T)) : Bool
    return false unless @size == other.size

    index = 0
    while index < @size
      return false unless @buffer[index] == other[index]
      index = index + 1
    end
    true
  end

  private def grow : Nil
    capacity = @capacity == 0 ? 4 : @capacity * 2
    buffer = Pointer(T).malloc(capacity.to_u64)
    index = 0
    while index < @size
      buffer[index] = @buffer[index]
      index = index + 1
    end
    @buffer = buffer
    @capacity = capacity
  end
end
