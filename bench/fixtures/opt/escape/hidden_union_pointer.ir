; iyi-ir 1
source_filename = "escape_hidden_union_pointer"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%PackedUnion = type <{ i8, [1 x i64] }>
@"__iyi_gc_layouts:table" = internal constant [7 x i64] [ i64 1, i64 10, i64 9, i64 9, i64 1, i64 0, i64 1 ]
@__iyi_gc_layouts = internal constant ptr @"__iyi_gc_layouts:table"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i8 @hidden_union(ptr %heap) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%PackedUnion, ptr null, i32 1) to i64), i64 10, i64 0)
  %field = getelementptr %PackedUnion, ptr %p, i64 0, i32 1, i64 0
  %bits = ptrtoint ptr %heap to i64
  store i64 %bits, ptr %field, align 1
  %first = load i8, ptr %p, align 1
  ret i8 %first
}
