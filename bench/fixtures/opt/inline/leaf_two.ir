; iyi-ir 1
source_filename = "leaf_two"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @leaf(i64 %x, i64 %y) {
entry:
  %v = sub i64 %x, %y
  ret i64 %v
}
define external i64 @one(i64 %a, i64 %b) {
entry:
  %v = call i64 (i64, i64) @leaf(i64 %a, i64 %b)
  %a1 = add i64 %v, 1
  %a2 = add i64 %a1, 2
  %a3 = add i64 %a2, 3
  %a4 = add i64 %a3, 4
  %a5 = add i64 %a4, 5
  ret i64 %a5
}
define external i64 @two(i64 %a, i64 %b) {
entry:
  %v = call i64 (i64, i64) @leaf(i64 %b, i64 %a)
  %a1 = add i64 %v, 1
  %a2 = add i64 %a1, 2
  %a3 = add i64 %a2, 3
  %a4 = add i64 %a3, 4
  %a5 = add i64 %a4, 5
  ret i64 %a5
}
