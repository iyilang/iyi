# `Mutex(T)`: a value two tasks or two threads may both change, kept behind
# a lock. SPEC.md III.4.4's synchronised type that owns its contents, and the
# escape the `Share` rule leaves for state that has to be shared and has to
# change: `Mutex(Array(Int32))` may be captured by `IyiThread.start`'s block
# although `Array(Int32)` may not.
#
#     import std/mutex::{Mutex}
#
#     totals = Mutex.new { {} of String => Int32 }
#     totals.lock { |t| t["seen"] = (t["seen"]? || 0) + 1 }.or_panic
#     seen = totals.get { |t| t.size }.or_panic
#     count = Mutex.new { 0 }
#     count.update { |n| n + 1 }.or_panic
#
# **Waiting for a change.** `wait_for` is the condition variable, with the
# condition and its action one step: its block runs with the lock held each
# time another task has had the lock, until it answers something other than
# nil, which `wait_for` answers. A consumer takes from a queue a producer
# fills with `queue.wait_for { |q| q.empty? ? nil : q.shift }`.
#
# **Only a block reaches the value, and the compiler checks every block.**
# The value is made by the block `Mutex.new` runs, so nothing outside holds
# it, and is reached only inside the blocks `lock`, `get` and `update` run
# with the lock held. Each of those blocks may capture only `Share` values -
# a captured array would be within reach of the value and outside the lock
# at once - and what `get` answers must be `Share`, since it leaves the
# lock. A block that breaks either is refused where it is written, naming
# the variable or the answer (`CleanupTransformer#check_share_boundary`).
# What the check does not see is a method the block calls that stores its
# argument somewhere global; that is the same edge the thread check has.
#
# **Waiting.** A task that finds the lock held waits without holding its
# thread hostage. While the holder may be running on another thread it
# first spins a few turns, which is what a short critical section wants;
# then it parks, as a task waiting on a channel parks, on the lock's word
# (`IyiScheduler.park_on`, a futex for tasks), and the release wakes one
# task parked there. Its thread runs its other tasks meanwhile, and on the
# pool another worker takes them: a worker that slept in the kernel here
# held every task queued behind the waiter with it. A waiting task is
# cancellable, as every blocking call is (III.4.2): `lock`, `get` and
# `update` answer `Cancelled` then, and the block does not run.
#
# **What is refused.** A task locking a Mutex it already holds would wait
# for itself, and panics saying so. A wait on a program's one thread with
# nothing else on it to run, asleep or waiting - so nothing that could
# ever release or change the value - panics saying that too, in the task
# that waits; a deadlock anywhere else is the scheduler's to name, as it
# names one on a channel. A panic inside the block releases the lock as
# it leaves (`defer`), so a task that dies does not take the lock with
# it.
#
# The lock is not fair: a task arriving as it is released may take it ahead
# of one that waited.

module std/mutex

@[Share(owns: true)]
pub class Mutex(T)
  @value : T
  # The futex word: `FREE`, `HELD`, or `CONTENDED` - held, and a task may
  # be parked on it, so the release wakes one. Drepper's three states
  # ("Futexes Are Tricky", mutex2): a task that has waited takes the lock
  # as `CONTENDED`, since another may be parked behind it.
  @word : Atomic(UInt64)
  # The task holding it and the thread it took it on, by object id; 0
  # when it is free. The thread is a hint for spinning, and may be old:
  # a parallel task moves between workers (SPEC.md III.4.13).
  @holder : Atomic(UInt64)
  @holder_thread : Atomic(UInt64)
  # How many times the lock has been released, which `wait_for` watches
  # for a change, and how many tasks are parked watching it.
  @changes : Atomic(UInt64)
  @change_waiters : Atomic(UInt64)

  # Spins before a waiter parks, while the holder may be running.
  SPINS     =   100
  FREE      = 0_u64
  HELD      = 1_u64
  CONTENDED = 2_u64

  # The value is the block's: made here, so nothing outside holds it. The
  # constructor that takes a value is private for that reason.
  def self.new(&block : -> U) : Mutex(U) forall U
    Mutex(U).build(block.call)
  end

  protected def self.build(value : T) : Mutex(T)
    new(value)
  end

  private def initialize(@value : T)
    @word = Atomic(UInt64).new(FREE)
    @holder = Atomic(UInt64).new(0_u64)
    @holder_thread = Atomic(UInt64).new(0_u64)
    @changes = Atomic(UInt64).new(0_u64)
    @change_waiters = Atomic(UInt64).new(0_u64)
  end

  # Runs the block with the value, the lock held; answers nil, or
  # `Cancelled` when the task was cancelled while it waited.
  def lock(&block : T -> _) : Nil | Cancelled
    if refused = acquire
      return refused
    end
    defer release
    block.call(@value)
    nil
  end

  # The block's answer, worked out with the lock held. It must be `Share`,
  # because it leaves the lock.
  def get(&block : T -> R) : R | Cancelled forall R
    if refused = acquire
      return refused
    end
    defer release
    block.call(@value)
  end

  # The value replaced by the block's answer, with the lock held: what a
  # number or any other value type wants, which a block cannot change in
  # place.
  def update(&block : T -> T) : Nil | Cancelled
    if refused = acquire
      return refused
    end
    defer release
    @value = block.call(@value)
    nil
  end

  # Runs the block with the lock held each time the value changes, until it
  # answers something other than nil, and answers that: a condition and
  # what is done once it holds, in one step no other task can come between.
  #
  #     queue = Mutex.new { [] of Int32 }
  #     job = queue.wait_for { |q| q.empty? ? nil : q.shift }.or_panic
  #
  # A change is any lock, get, update or wait_for of this Mutex by another
  # task; between them the waiter holds no lock, and is parked on the count
  # of releases until another task's moves it. Cancellable, as `lock` is.
  # A wait nothing could end - one thread, and nothing else on it to run -
  # panics saying so.
  def wait_for(&block : T -> R?) : R | Cancelled forall R
    while true
      if refused = acquire
        return refused
      end
      # Read with the lock held, so the only release before the wait below
      # is this task's own: one more than this is another task's.
      mine = @changes.get + 1_u64
      answer = held(block)
      return answer unless answer.nil?
      waited = await_change(mine)
      return waited if waited.is_a?(Cancelled)
    end
  end

  private def held(block : T -> R?) : R? forall R
    defer release
    block.call(@value)
  end

  # Parks until the count of releases is past *mine*, the one this task's
  # own release made. The waiter counts itself before `park_on` looks at
  # the count again, under the scheduler's lock: a release that read no
  # waiter had moved the count first, and the look sees it.
  private def await_change(mine : UInt64) : Nil | Cancelled
    {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
      while @changes.get == mine
        if Mutex.alone?
          raise "Mutex#wait_for: deadlock: nothing is left to change the value - no other task on this thread, and no other thread"
        end
        @change_waiters.add(1_u64)
        waited = IyiScheduler.park_on(pointerof(@changes), mine)
        @change_waiters.sub(1_u64)
        return waited if waited.is_a?(Cancelled)
      end
      nil
    {% else %}
      raise "Mutex#wait_for: deadlock: this program's one thread waits, and nothing else can change the value"
    {% end %}
  end

  # Whether some task holds it now: an answer that may be old by the time
  # it is read, for a report rather than a decision.
  def locked? : Bool
    @word.get != FREE
  end

  private def acquire : Cancelled?
    me = Mutex.task_id
    return nil if take(me)
    if @holder.get == me
      raise "Mutex: this task already holds the lock, and a second lock would wait for itself"
    end
    {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
      turns = 0
      while turns < SPINS && Mutex.holder_may_run?(@holder_thread.get)
        return nil if take(me)
        IyiThread.spin_pause
        turns = turns + 1
      end
      # Marked contended, so the release wakes; and taken, still marked,
      # when it is free, since a task may be parked behind. A task woken
      # here takes it the same way and never as `HELD`: taken plainly, the
      # mark was gone with tasks still parked, the release woke none of
      # them, and twenty tasks on one thread ended in a deadlock.
      while @word.swap(CONTENDED) != FREE
        if Mutex.alone?
          raise "Mutex: deadlock: the task holding this lock is parked on this thread, and nothing left on this thread can wake it"
        end
        waited = IyiScheduler.park_on(pointerof(@word), CONTENDED)
        if waited.is_a?(Cancelled)
          # A release may have woken this task as it was cancelled, and the
          # wake goes on to the next task parked here, or that one waits
          # for a release nobody holding the lock now will make.
          IyiScheduler.wake_on(pointerof(@word), 1)
          return waited
        end
      end
      record(me)
      nil
    {% else %}
      # One thread and no tasks: a lock held here is held by its caller.
      raise "Mutex: this program's one thread already holds the lock, and a second lock would wait for itself"
    {% end %}
  end

  # One try: the lock taken and its holder recorded, or false.
  private def take(me : UInt64) : Bool
    return false unless @word.compare_and_set(FREE, HELD)[1]
    record(me)
    true
  end

  private def record(me : UInt64) : Nil
    @holder.set(me)
    @holder_thread.set(Mutex.thread_id)
  end

  private def release : Nil
    @holder.set(0_u64)
    @holder_thread.set(0_u64)
    # A change for `wait_for`, counted before the lock is free, so a waiter
    # that takes the lock next sees it.
    @changes.add(1_u64)
    {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
      IyiScheduler.wake_on(pointerof(@word), 1) if @word.swap(FREE) == CONTENDED
      IyiScheduler.wake_on(pointerof(@changes), 0x7FFFFFFF) if @change_waiters.get != 0_u64
    {% else %}
      @word.set(FREE)
    {% end %}
  end

  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
    protected def self.task_id : UInt64
      IyiScheduler.current.object_id
    end

    protected def self.thread_id : UInt64
      IyiScheduler.state.object_id
    end

    # Whether the holder, which took the lock on *thread*, may be running
    # now: another thread exists, and the holder is not on this one, which
    # is running the waiter.
    protected def self.holder_may_run?(thread : UInt64) : Bool
      {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
        IyiThread.program_threads > 1_u64 && thread != 0_u64 && thread != thread_id
      {% else %}
        false
      {% end %}
    end

    # The program's one thread, with nothing on it to run but the waiting
    # task: no task runnable, asleep or waiting on I/O, and none another
    # thread has woken into its inbox (SPEC.md III.4.13). Nothing can
    # release or change the value then.
    protected def self.alone? : Bool
      {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
        return false if IyiThread.program_threads > 1_u64
      {% end %}
      st = IyiScheduler.state
      busy = !st.run_head.nil? || !st.sleep_head.nil? || !st.io_head.nil? || st.mail?
      {% if flag?(:win32) %}
        busy = busy || !st.stdin_waiter.nil?
      {% end %}
      !busy
    end
  {% else %}
    protected def self.task_id : UInt64
      1_u64
    end

    protected def self.thread_id : UInt64
      1_u64
    end
  {% end %}
end
