# Exercises `std/steppable`.
#
# Run via:
#     ./bin/iyi run bench/std_steppable_exercise.iyi

module bench/std_steppable_exercise

import std/steppable
using std/steppable::{Steppable, NumericStepIterator}

import std/iterator
using std/iterator::{Iterator}

# User-defined type implementing Steppable trait.
# Requires +, -, <=>, >, < for NumericStepIterator's contract.
pub struct StepInt
  getter val : Int32

  def initialize(@val : Int32)
  end

  def +(other : StepInt) : StepInt
    StepInt.new(@val + other.val)
  end

  def -(other : StepInt) : StepInt
    StepInt.new(@val - other.val)
  end

  def <=>(other : StepInt) : Int32
    @val < other.val ? -1 : (@val > other.val ? 1 : 0)
  end

  def >(other : Int32) : Bool
    @val > other
  end

  def <(other : Int32) : Bool
    @val < other
  end

  def ==(other : StepInt) : Bool
    @val == other.val
  end

  def to_s : String
    @val.to_s
  end
end

impl Steppable for StepInt
end

def assert_true(msg : String, cond : Bool) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_int(msg : String, expected : Int32, actual : Int32) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
end

def assert_equal(msg : String, expected : String, actual : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def collect_vals(iter : NumericStepIterator(StepInt)) : Array(Int32)
  res = [] of Int32
  while !(x = iter.next).nil?
    res << x.val
  end
  res
end

puts "== forward stepping and step of one"
s1 = StepInt.new(1).step(to: StepInt.new(5), by: StepInt.new(1))
assert_equal("forward step 1 inclusive", "[1, 2, 3, 4, 5]", collect_vals(s1).to_s)

s2 = StepInt.new(1).step(to: StepInt.new(5), by: StepInt.new(1), exclusive: true)
assert_equal("forward step 1 exclusive", "[1, 2, 3, 4]", collect_vals(s2).to_s)

s3 = StepInt.new(0).step(to: StepInt.new(8), by: StepInt.new(2))
assert_equal("forward step 2 inclusive", "[0, 2, 4, 6, 8]", collect_vals(s3).to_s)

s4 = StepInt.new(0).step(to: StepInt.new(8), by: StepInt.new(2), exclusive: true)
assert_equal("forward step 2 exclusive", "[0, 2, 4, 6]", collect_vals(s4).to_s)
puts "  forward stepping holds inclusive and exclusive"

puts "\n== step not dividing span evenly"
s5 = StepInt.new(1).step(to: StepInt.new(6), by: StepInt.new(2))
assert_equal("forward uneven inclusive", "[1, 3, 5]", collect_vals(s5).to_s)

s6 = StepInt.new(1).step(to: StepInt.new(6), by: StepInt.new(2), exclusive: true)
assert_equal("forward uneven exclusive", "[1, 3, 5]", collect_vals(s6).to_s)

s7 = StepInt.new(0).step(to: StepInt.new(10), by: StepInt.new(3))
assert_equal("forward uneven step 3", "[0, 3, 6, 9]", collect_vals(s7).to_s)
puts "  step stopping before boundary holds"

puts "\n== backward stepping with negative step"
s8 = StepInt.new(5).step(to: StepInt.new(1), by: StepInt.new(-1))
assert_equal("backward step -1 inclusive", "[5, 4, 3, 2, 1]", collect_vals(s8).to_s)

s9 = StepInt.new(5).step(to: StepInt.new(1), by: StepInt.new(-1), exclusive: true)
assert_equal("backward step -1 exclusive", "[5, 4, 3, 2]", collect_vals(s9).to_s)

s10 = StepInt.new(10).step(to: StepInt.new(3), by: StepInt.new(-3))
assert_equal("backward uneven inclusive", "[10, 7, 4]", collect_vals(s10).to_s)

s11 = StepInt.new(10).step(to: StepInt.new(3), by: StepInt.new(-3), exclusive: true)
assert_equal("backward uneven exclusive", "[10, 7, 4]", collect_vals(s11).to_s)

s12 = StepInt.new(10).step(to: StepInt.new(4), by: StepInt.new(-3), exclusive: true)
assert_equal("backward exact exclusive", "[10, 7]", collect_vals(s12).to_s)
puts "  backward stepping holds inclusive, exclusive, and uneven"

puts "\n== single-element spans and boundaries"
s13 = StepInt.new(4).step(to: StepInt.new(4), by: StepInt.new(1))
assert_equal("same start and limit inclusive", "[4]", collect_vals(s13).to_s)

s14 = StepInt.new(4).step(to: StepInt.new(4), by: StepInt.new(1), exclusive: true)
assert_equal("same start and limit exclusive", "[]", collect_vals(s14).to_s)

s15 = StepInt.new(4).step(to: StepInt.new(4), by: StepInt.new(-1))
assert_equal("same start and limit negative step inclusive", "[4]", collect_vals(s15).to_s)

s16 = StepInt.new(4).step(to: StepInt.new(4), by: StepInt.new(-1), exclusive: true)
assert_equal("same start and limit negative step exclusive", "[]", collect_vals(s16).to_s)
puts "  single-element and empty spans hold"

puts "\n== zero step and direction mismatches"
s17 = StepInt.new(1).step(to: StepInt.new(5), by: StepInt.new(0))
assert_equal("zero step with limit", "[]", collect_vals(s17).to_s)

s18 = StepInt.new(5).step(to: StepInt.new(1), by: StepInt.new(0))
assert_equal("zero step with backward limit", "[]", collect_vals(s18).to_s)

s19 = StepInt.new(1).step(to: StepInt.new(5), by: StepInt.new(-1))
assert_equal("negative step on forward range", "[]", collect_vals(s19).to_s)

s20 = StepInt.new(5).step(to: StepInt.new(1), by: StepInt.new(1))
assert_equal("positive step on backward range", "[]", collect_vals(s20).to_s)
puts "  zero step and mismatched directions return empty"

puts "\n== open-ended stepping without limit"
s21 = StepInt.new(10).step(by: StepInt.new(5))
inf1 = [] of Int32
cnt = 0
while cnt < 4 && !(x = s21.next).nil?
  inf1 << x.val
  cnt = cnt + 1
end
assert_equal("infinite step sequence", "[10, 15, 20, 25]", inf1.to_s)

s22 = StepInt.new(7).step(by: StepInt.new(0))
inf2 = [] of Int32
cnt = 0
while cnt < 3 && !(x = s22.next).nil?
  inf2 << x.val
  cnt = cnt + 1
end
assert_equal("infinite zero step sequence", "[7, 7, 7]", inf2.to_s)
puts "  open-ended stepping without limit holds"

puts "\n== block iteration from trait default"
block_vals = [] of Int32
StepInt.new(2).step(to: StepInt.new(8), by: StepInt.new(3)) do |item|
  block_vals << item.val
end
assert_equal("block iteration forward", "[2, 5, 8]", block_vals.to_s)

block_rev = [] of Int32
StepInt.new(8).step(to: StepInt.new(2), by: StepInt.new(-3)) do |item|
  block_rev << item.val
end
assert_equal("block iteration backward", "[8, 5, 2]", block_rev.to_s)
puts "  block iteration yields expected elements"

puts "\n== iterator sum and std/iterator integration"
sum1 = StepInt.new(1).step(to: StepInt.new(5), by: StepInt.new(1)).sum(StepInt.new(0))
assert_int("sum of 1..5", 15, sum1.val)

sum2 = StepInt.new(10).step(to: StepInt.new(3), by: StepInt.new(-3)).sum(StepInt.new(0))
assert_int("sum of 10, 7, 4", 21, sum2.val)

inf_iter = StepInt.new(100).step(by: StepInt.new(25))
taken = inf_iter.take(3)
taken_vals = [] of Int32
while !(x = taken.next).nil?
  taken_vals << x.val
end
assert_equal("take on NumericStepIterator", "[100, 125, 150]", taken_vals.to_s)
puts "  sum and iterator adaptors hold"

puts "\n== Int32 overflow near the type's edges"
MAX = 2147483647
s_max = StepInt.new(MAX - 2).step(to: StepInt.new(MAX), by: StepInt.new(1))
assert_equal("inclusive step to Int32 MAX", "[2147483645, 2147483646, 2147483647]", collect_vals(s_max).to_s)
assert_true("next after MAX is nil", s_max.next.nil?)

s_max2 = StepInt.new(MAX - 1).step(to: StepInt.new(MAX), by: StepInt.new(2))
assert_equal("step 2 near Int32 MAX", "[2147483646]", collect_vals(s_max2).to_s)

s_max_ex = StepInt.new(MAX - 2).step(to: StepInt.new(MAX), by: StepInt.new(1), exclusive: true)
assert_equal("exclusive step near Int32 MAX", "[2147483645, 2147483646]", collect_vals(s_max_ex).to_s)

MIN = -2147483648
s_min = StepInt.new(MIN + 2).step(to: StepInt.new(MIN), by: StepInt.new(-1))
assert_equal("inclusive step to Int32 MIN", "[-2147483646, -2147483647, -2147483648]", collect_vals(s_min).to_s)
assert_true("next after MIN is nil", s_min.next.nil?)

s_min2 = StepInt.new(MIN + 1).step(to: StepInt.new(MIN), by: StepInt.new(-2))
assert_equal("step -2 near Int32 MIN", "[-2147483647]", collect_vals(s_min2).to_s)

sum_empty = StepInt.new(1).step(to: StepInt.new(5), by: StepInt.new(-1)).sum(StepInt.new(99))
assert_int("sum of empty iterator", 99, sum_empty.val)
puts "  draining inclusive step to Int32 MAX and MIN holds, empty sum holds"

puts "\nALL CHECKS PASSED"
