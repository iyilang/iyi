; iyi-ir 1
source_filename = "loop_join_clobber_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @loop_join_clobber_keep(ptr %p, ptr %q, i64 %x, i1 %choose, i1 %again) {
entry:
  %before = load i64, ptr %p, align 8
  br i1 %choose, label %left, label %right
left:
  store i64 %x, ptr %q, align 8
  br label %loop
right:
  br label %loop
loop:
  %inside = load i64, ptr %p, align 8
  br i1 %again, label %loop, label %done
done:
  %sum = add i64 %before, %inside
  ret i64 %sum
}
