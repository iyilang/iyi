# Exercises std/system_roots: the operating system's trusted roots, read.
#
# With no argument: the platform's own store - at least one root, each
# certificate once - then what a collector does with a certificate the
# platform denies and a root it restricts, then, where
# `$SYSTEM_ROOTS_ORACLE` names a file, the platform's store against the
# roots, the restricted and the distrusted that file says another reader
# of the same store found, and then `$SSL_CERT_FILE` and `$SSL_CERT_DIR`
# over files written here: a bundle holding a root twice beside a broken
# block, a directory of two files, and a bundle with no certificate in it,
# which is refused. The oracle file is the gate's, a verdict and a SHA-256
# a line:
#   keep F        a root the platform trusts for a server
#   drop F        a root the platform keeps from authenticating a server
#   either F      a root whose own extension, not the store, names its
#                 purposes: std/x509's to refuse, so kept or not
#   distrusted F  a certificate the platform says never to trust
# The mode the gate script drives:
#   fingerprints  the platform store's certificates, one SHA-256 of each
#                 DER a line, sorted, then `unreadable N`.

import std/system_roots::{SystemRoots, SystemRootsCollector}
import std/x509::{Certificate, X509Error}
import std/env::{ENV}
import std/dir::{Dir}
import std/file::{File}
import std/digest::{SHA256}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def hex(bytes : Array(UInt8)) : String
  String.build do |io|
    bytes.each do |b|
      io << "0123456789abcdef"[b.to_i32 >> 4]
      io << "0123456789abcdef"[b.to_i32 & 15]
    end
  end
end

ROOT_ONE = "-----BEGIN CERTIFICATE-----\nMIIBSTCB8aADAgECAhQWhkufqlF7b3mMBvZ/8D0fKAklmDAKBggqhkjOPQQDAjAb\nMRkwFwYDVQQDDBBGaXh0dXJlIFJvb3QgT25lMB4XDTI2MDEwMTAwMDAwMFoXDTQ2\nMDEwMTAwMDAwMFowGzEZMBcGA1UEAwwQRml4dHVyZSBSb290IE9uZTBZMBMGByqG\nSM49AgEGCCqGSM49AwEHA0IABILKhThMDDqgDuXAs+1PZBbsOLAZAlLu0ZuJbsgb\nMV8xHFv+9Brw5M0+5KVTYBWJqX2gEY6MSu7k5x2nqaj+ARqjEzARMA8GA1UdEwEB\n/wQFMAMBAf8wCgYIKoZIzj0EAwIDRwAwRAIgCSE7ziC7j6CEGdQGNwiol1O1XyDi\nz3162d1cp6/PgfMCIDwNZMPpK3/ikQJ9u7QNHykwOkHErt6Mg/iWtlJn9+k6\n-----END CERTIFICATE-----\n"
ROOT_TWO = "-----BEGIN CERTIFICATE-----\nMIIBSjCB8aADAgECAhR/hHylWAuY7mS5QJPCq/5pOgzwbTAKBggqhkjOPQQDAjAb\nMRkwFwYDVQQDDBBGaXh0dXJlIFJvb3QgVHdvMB4XDTI2MDEwMTAwMDAwMFoXDTQ2\nMDEwMTAwMDAwMFowGzEZMBcGA1UEAwwQRml4dHVyZSBSb290IFR3bzBZMBMGByqG\nSM49AgEGCCqGSM49AwEHA0IABLVTv8jR8Q4IhQS8NzTL4UpH/KzWNQuprNcIhig4\nSQDkPeDAGy0kpjvzKt1XeAdMQ9i+GLKjijfMctG2karRqwqjEzARMA8GA1UdEwEB\n/wQFMAMBAf8wCgYIKoZIzj0EAwIDSAAwRQIhAJpJHf47/LJGUaqJMgc7quWxDvib\nnLOv05dGx55YRFaIAiB+vM4X1U8O8zZ7LsgT7Jp20mQxTE1XNkpEtq9gdDYuHg==\n-----END CERTIFICATE-----\n"

ENV.delete("SSL_CERT_FILE")
ENV.delete("SSL_CERT_DIR")

if Program.args.size > 0 && Program.args[0] == "fingerprints"
  store = SystemRoots.load.or_panic
  store.certificates.map { |c| hex(SHA256.hash_bytes(c.raw)) }.sorted.each { |f| puts f }
  puts "unreadable #{store.unreadable}"
  exit 0
end

puts "== the platform's own store"
store = SystemRoots.load.or_panic
check store.certificates.size > 0, "no roots from #{store.source}"
fingerprints = store.certificates.map { |c| hex(SHA256.hash_bytes(c.raw)) }
check fingerprints.uniq.size == fingerprints.size, "a root twice in #{store.source}"
puts "  #{store.certificates.size} roots from #{store.source}, #{store.unreadable} unreadable, #{store.restricted} restricted, #{store.distrusted.size} distrusted"

puts "== what the platform denies and what it restricts"
one = Certificate.pem_blocks(ROOT_ONE).or_panic[0]
two = Certificate.pem_blocks(ROOT_TWO).or_panic[0]
gathered = SystemRootsCollector.new
gathered.add(one)
gathered.add(two)
gathered.deny(one)
gathered.deny(one)
check gathered.certificates.map(&.subject_name) == ["CN=Fixture Root Two"], "a denied root is dropped: #{gathered.certificates.map(&.subject_name)}"
gathered.add(one)
check gathered.certificates.size == 1, "a denied root is not kept after: #{gathered.certificates.size} roots"
check gathered.distrusted == [one], "a denied certificate is distrusted once, and was #{gathered.distrusted.size} times"
answered = gathered.answer("a collector").or_panic
check answered.distrusted == [one] && answered.restricted == 0, "the store answers what was denied: #{answered.distrusted.size} distrusted, #{answered.restricted} restricted"
unseen = SystemRootsCollector.new
unseen.deny(two)
unseen.add(two)
check unseen.empty? && unseen.distrusted == [two], "a certificate denied before it is met is distrusted and never kept"
limited = SystemRootsCollector.new
limited.add(one)
limited.add(two)
limited.restrict(two)
limited.restrict(two)
limited.add(two)
check limited.certificates.map(&.subject_name) == ["CN=Fixture Root One"], "a restricted root is left out: #{limited.certificates.map(&.subject_name)}"
check limited.restricted == 1, "a root restricted twice counted #{limited.restricted} times"
check limited.distrusted.empty?, "a restricted root is not distrusted"
check limited.answer("a collector").or_panic.restricted == 1, "the store answers what was restricted"
puts "  a denied certificate dropped and distrusted, a restricted root left out and counted"

puts "== the platform's store held to another reader of it"
oracle = ENV["SYSTEM_ROOTS_ORACLE"]?
if oracle && !oracle.empty?
  verdicts = {"keep" => [] of String, "drop" => [] of String, "either" => [] of String, "distrusted" => [] of String}
  File.read(oracle).split('\n').each do |line|
    words = line.strip.split(' ')
    next unless words.size == 2
    check verdicts.has_key?(words[0]), "an oracle line that is no verdict: #{line}"
    verdicts[words[0]] << words[1]
  end
  gone = verdicts["distrusted"]
  missing = verdicts["keep"].reject { |f| gone.includes?(f) || fingerprints.includes?(f) }
  check missing.size <= store.unreadable, "a root the platform trusts for a server is missing: #{missing}"
  wrong = verdicts["drop"].select { |f| fingerprints.includes?(f) }
  check wrong.empty?, "a root the platform keeps from server authentication is trusted: #{wrong}"
  denied = gone.select { |f| fingerprints.includes?(f) }
  check denied.empty?, "a root the platform distrusts is trusted: #{denied}"
  unknown = fingerprints.reject { |f| verdicts["keep"].includes?(f) || verdicts["either"].includes?(f) }
  check unknown.empty?, "a root the oracle does not list: #{unknown}"
  check store.restricted >= verdicts["drop"].size && store.restricted <= verdicts["drop"].size + verdicts["either"].size,
    "#{store.restricted} roots restricted, where the oracle has #{verdicts["drop"].size} and #{verdicts["either"].size} either way"
  check store.distrusted.map { |der| hex(SHA256.hash_bytes(der)) }.sorted == gone.sorted,
    "#{store.distrusted.size} certificates distrusted, where the oracle has #{gone.size}"
  puts "  held to the oracle: #{verdicts["keep"].size} to keep, #{verdicts["drop"].size} to drop, #{verdicts["either"].size} either way, #{gone.size} distrusted"
else
  puts "  no oracle named, so the store goes uncompared"
end

puts "== roots named by $SSL_CERT_FILE and $SSL_CERT_DIR"
# A fresh name from the system's randomness, and the directory beside it.
token = File.tempfile("iyi-roots")
work = token + ".d"
Dir.mkdir_p(work + "/dir")
bundle = work + "/bundle.pem"
File.write(bundle, "a comment\n" + ROOT_ONE + ROOT_ONE + "-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n")
ENV["SSL_CERT_FILE"] = bundle
named = SystemRoots.load.or_panic
check named.certificates.size == 1, "a root written twice read #{named.certificates.size} times"
check named.unreadable == 1, "a broken block counted #{named.unreadable} times, not once"
check named.certificates[0].subject_name == "CN=Fixture Root One", "the bundle's root: #{named.certificates[0].subject_name}"
check named.source.includes?(bundle), "the source names the file: #{named.source}"
check named.distrusted.empty? && named.restricted == 0, "named roots carry none of the platform's verdicts"
File.write(work + "/dir/a.pem", ROOT_ONE)
File.write(work + "/dir/b.crt", ROOT_TWO)
File.write(work + "/dir/notes.txt", "not a certificate\n")
ENV["SSL_CERT_DIR"] = work + "/dir"
both = SystemRoots.load.or_panic
check both.certificates.map(&.subject_name).sorted == ["CN=Fixture Root One", "CN=Fixture Root Two"], "a file and a directory: #{both.certificates.map(&.subject_name)}"
ENV.delete("SSL_CERT_DIR")
File.write(bundle, "no certificates here\n")
none = SystemRoots.load
check none.is_a?(X509Error) && none.message.includes?("no root certificates in"), "a bundle with no root refused"
ENV.delete("SSL_CERT_FILE")
["/dir/a.pem", "/dir/b.crt", "/dir/notes.txt", "/bundle.pem"].each { |f| File.delete(work + f) }
Dir.delete(work + "/dir")
Dir.delete(work)
File.delete(token)
puts "  a root kept once, a broken block counted, a directory read, an empty bundle refused"

puts "\nALL CHECKS PASSED"
