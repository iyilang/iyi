# Where a `spawn` runs, exercised: SPEC.md III.4.15 and III.4.16.
#
#   ./bin/iyi run bench/spawn_eligible.iyi -- together nested unit serial asked --workers=4
#   ./bin/iyi run bench/spawn_eligible.iyi -- one --workers=1
#   ./bin/iyi run bench/spawn_eligible.iyi -- askedone --workers=1
#
# The compiler decides per call: a block every capture of which is `Share`,
# reaching no module state that is not, runs as a parallel task of its own
# unit; any other stays in its spawner's unit, as every spawn did before.
# `spawn(unit: :same)` keeps a task in its unit and `spawn(unit: :new)`
# puts it on the pool, whatever the compiler would have decided.
#
#   together  four spawns whose blocks capture only atomics, from the main
#             thread, are all running at one instant: each counts itself in
#             and spins, without parking, until the four are in or two
#             seconds have passed. Four tasks in one unit, or on the one
#             thread, run one at a time, and each waits the two seconds
#             out alone.
#   nested    the same four, spawned inside a parallel task: an eligible
#             spawn there is a unit of its own, not its parent's.
#   unit      four spawns inside a parallel task whose blocks append to the
#             parent's `Array` stay in its unit: each spins 20 ms counting
#             how many of the unit's tasks are running, and the parent
#             spins too before it joins; the most ever running is one, and
#             the array holds the four appends.
#   serial    the same with `spawn(unit: :same)` and blocks that capture only
#             atomics, which `spawn` would have run in parallel: one at a
#             time, from inside a parallel task and from the main thread.
#   asked     the four of `together` spawned with `unit: :new`: all
#             running at one instant.
#   one       on a pool of one, eligible spawns stay on the spawner's
#             thread, one at a time, and the pool never starts.
#   askedone  on a pool of one, run in its own process: four
#             `spawn(unit: :new)` tasks run on the pool's worker and not
#             on the main thread, where a plain spawn of the same blocks
#             (`one`) stays.
#   grows     run first in its process: the pool starts one worker for one
#             eligible spawn, a few for spawns made and joined one at a
#             time, and every worker only when that many tasks are running
#             at one instant (`IyiWorkers.grow`).
#
# bench/spawn_eligible.sh runs it, and broken copies of the runtime, each
# caught by the step that names it.

module bench/spawn_eligible

import std/int

{% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  TASKS    =                4
  TOGETHER =            4_i64
  WAIT_NS  = 2000_000_000_i64
  SPIN_NS  =   20_000_000_i64

  # Each block below spins with its counters in its own text rather than
  # through a def: an `Atomic` is a struct, and an argument is a copy of
  # it. A spinning task never parks, so nothing but another thread runs
  # beside it.

  def together(where : String) : Nil
    arrived = Atomic(Int64).new(0_i64)
    missed = Atomic(Int64).new(0_i64)
    started = __iyi_monotonic_ns
    group do |g|
      TASKS.times do
        g.spawn do
          arrived.add(1_i64)
          until_ns = __iyi_monotonic_ns + WAIT_NS
          while arrived.get < TOGETHER && __iyi_monotonic_ns < until_ns
          end
          missed.add(1_i64) if arrived.get < TOGETHER
          0
        end
      end
    end
    took = (__iyi_monotonic_ns - started) // 1000000_i64
    if missed.get != 0_i64
      fail("#{where}: #{missed.get} of #{TOGETHER} eligible spawns waited #{WAIT_NS // 1000000_i64} ms for the others and left alone: they ran one at a time")
    end
    puts "#{where}: #{TOGETHER} eligible spawns were all running at one instant, in #{took} ms"
  end

  def nested : Nil
    group do |g|
      g.spawn(unit: :new) do
        together("nested")
        0
      end
    end
  end

  def unit : Nil
    running = Atomic(Int64).new(0_i64)
    most = Atomic(Int64).new(0_i64)
    total = Atomic(Int64).new(0_i64)
    group do |g|
      g.spawn(unit: :new) do
        appended = [] of Int64
        group do |inner|
          TASKS.times do |i|
            inner.spawn do
              now = running.add(1_i64) + 1_i64
              seen = most.get
              while now > seen
                seen, set = most.compare_and_set(seen, now)
                break if set
              end
              until_ns = __iyi_monotonic_ns + SPIN_NS
              while __iyi_monotonic_ns < until_ns
              end
              running.add(-1_i64)
              appended << i.to_i64
              0
            end
          end
          mine = running.add(1_i64) + 1_i64
          high = most.get
          while mine > high
            high, done = most.compare_and_set(high, mine)
            break if done
          end
          spun_until = __iyi_monotonic_ns + SPIN_NS
          while __iyi_monotonic_ns < spun_until
          end
          running.add(-1_i64)
        end
        total.set(appended.size.to_i64)
        0
      end
    end
    if most.get != 1_i64
      fail("unit: #{most.get} tasks of one unit were running at one instant")
    end
    fail("unit: the unit's array holds #{total.get} of #{TOGETHER} appends") if total.get != TOGETHER
    puts "unit: #{TOGETHER} spawns appending to their parent's array ran one at a time in its unit"
  end

  # The most `spawn(unit: :same)` tasks, and their spawner, ever running at one
  # instant.
  def serial_round : Int64
    running = Atomic(Int64).new(0_i64)
    most = Atomic(Int64).new(0_i64)
    group do |g|
      TASKS.times do
        g.spawn(unit: :same) do
          now = running.add(1_i64) + 1_i64
          seen = most.get
          while now > seen
            seen, set = most.compare_and_set(seen, now)
            break if set
          end
          until_ns = __iyi_monotonic_ns + SPIN_NS
          while __iyi_monotonic_ns < until_ns
          end
          running.add(-1_i64)
          0
        end
      end
      mine = running.add(1_i64) + 1_i64
      high = most.get
      while mine > high
        high, done = most.compare_and_set(high, mine)
        break if done
      end
      spun_until = __iyi_monotonic_ns + SPIN_NS
      while __iyi_monotonic_ns < spun_until
      end
      running.add(-1_i64)
    end
    most.get
  end

  def serial : Nil
    inside = Atomic(Int64).new(0_i64)
    group do |g|
      g.spawn(unit: :new) do
        inside.set(serial_round)
        0
      end
    end
    if inside.get != 1_i64
      fail("serial: #{inside.get} spawn(unit: :same) tasks were running at one instant inside a parallel task")
    end
    outside = serial_round
    if outside != 1_i64
      fail("serial: #{outside} spawn(unit: :same) tasks were running at one instant on the main thread")
    end
    puts "serial: spawn(unit: :same) kept #{TOGETHER} tasks that capture only atomics in their unit, one at a time, inside a parallel task and on the main thread"
  end

  def one : Nil
    running = Atomic(Int64).new(0_i64)
    most = Atomic(Int64).new(0_i64)
    away = Atomic(Int64).new(0_i64)
    group do |g|
      TASKS.times do
        g.spawn do
          now = running.add(1_i64) + 1_i64
          seen = most.get
          while now > seen
            seen, set = most.compare_and_set(seen, now)
            break if set
          end
          until_ns = __iyi_monotonic_ns + SPIN_NS
          while __iyi_monotonic_ns < until_ns
          end
          running.add(-1_i64)
          away.add(1_i64) if IyiScheduler.state.worker
          0
        end
      end
    end
    fail("one: #{most.get} eligible spawns were running at one instant on a pool of one") if most.get != 1_i64
    fail("one: #{away.get} eligible spawns ran on a pool worker, with one worker asked for") if away.get != 0_i64
    fail("one: the pool started for eligible spawns on a pool of one") if IyiWorkers.started?
    puts "one: on a pool of one, #{TOGETHER} eligible spawns ran on the main thread, one at a time, and no pool started"
  end

  # The four of `together`, asked onto the pool with `unit: :new`.
  def asked : Nil
    arrived = Atomic(Int64).new(0_i64)
    missed = Atomic(Int64).new(0_i64)
    group do |g|
      TASKS.times do
        g.spawn(unit: :new) do
          arrived.add(1_i64)
          until_ns = __iyi_monotonic_ns + WAIT_NS
          while arrived.get < TOGETHER && __iyi_monotonic_ns < until_ns
          end
          missed.add(1_i64) if arrived.get < TOGETHER
          0
        end
      end
    end
    if missed.get != 0_i64
      fail("asked: #{missed.get} of #{TOGETHER} spawn(unit: :new) tasks waited #{WAIT_NS // 1000000_i64} ms for the others and left alone: they ran one at a time")
    end
    puts "asked: #{TOGETHER} spawn(unit: :new) tasks were all running at one instant"
  end

  # On a pool of one, `unit: :new` still goes to the pool, where a
  # plain spawn of the same block stays on its spawner's thread (`one`).
  def askedone : Nil
    away = Atomic(Int64).new(0_i64)
    group do |g|
      TASKS.times do
        g.spawn(unit: :new) do
          away.add(1_i64) if IyiScheduler.state.worker
          0
        end
      end
    end
    fail("askedone: #{TOGETHER - away.get} of #{TOGETHER} spawn(unit: :new) tasks ran on the spawner's thread on a pool of one") if away.get != TOGETHER
    puts "askedone: on a pool of one, #{TOGETHER} spawn(unit: :new) tasks ran on the pool's worker"
  end

  # The pool starts its workers as the work asks for them. One spawn,
  # joined, is the shape of a small program and starts one worker. Spawns
  # made and joined one at a time may find the worker that ran the last
  # still on its way to idle, and start another: 2 in each of 12 runs on
  # four workers, and 3 in one of three runs on twelve (Linux, 12 vCPUs,
  # shared), so LIGHT_MOST is 3, short of the pool's four. Four tasks that
  # spin until all four are running start the four.
  LIGHT_ROUNDS = 200
  LIGHT_MOST   =   3

  def grows : Nil
    done = Atomic(Int64).new(0_i64)
    group do |g|
      g.spawn do
        done.add(1_i64)
        0
      end
    end
    first = IyiWorkers.launched
    fail("grows: one eligible spawn started #{first} of the pool's #{IyiWorkers.count} workers") if first != 1
    LIGHT_ROUNDS.times do
      group do |g|
        g.spawn do
          done.add(1_i64)
          0
        end
      end
    end
    light = IyiWorkers.launched
    if light > LIGHT_MOST
      fail("grows: #{LIGHT_ROUNDS} eligible spawns made and joined one at a time started #{light} of the pool's #{IyiWorkers.count} workers")
    end
    together("grows")
    loaded = IyiWorkers.launched
    if loaded != IyiWorkers.count
      fail("grows: #{TOGETHER} eligible spawns running at one instant started #{loaded} of the pool's #{IyiWorkers.count} workers, with #{IyiWorkers.owes} starts owed")
    end
    puts "grows: one eligible spawn started 1 of #{IyiWorkers.count} workers, #{LIGHT_ROUNDS} joined one at a time #{light}, and #{TOGETHER} running at one instant all #{loaded}"
  end

  STEPS = ["together", "nested", "unit", "serial", "asked", "one", "askedone", "grows"]

  workers = 4
  chosen = [] of String
  Program.args.each do |argument|
    if argument.starts_with?("--workers=")
      workers = argument[10, argument.size - 10].to_i
    else
      fail("no step named #{argument}") unless STEPS.includes?(argument)
      chosen << argument
    end
  end
  chosen = ["together", "nested", "unit", "serial", "asked"] if chosen.empty?
  IyiWorkers.count = workers
  chosen.each do |name|
    case name
    when "together" then together("together")
    when "nested"   then nested
    when "unit"     then unit
    when "serial"   then serial
    when "asked"    then asked
    when "one"      then one
    when "askedone" then askedone
    when "grows"    then grows
    end
  end
  puts "spawn eligibility: every property held on #{IyiWorkers.count} workers"
{% else %}
  puts "spawn eligibility: no pool on this target, nothing to hold"
{% end %}
