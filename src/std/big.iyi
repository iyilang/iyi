# Arbitrary precision numbers: BigInt, BigDecimal, BigRational and BigFloat.
#
# Everything here is iyi all the way down: no GMP, no libc, no `lib` (SPEC.md
# III.9, III.10). The module refuses what it cannot answer with a sentence and
# exits 1: division and modulo by zero, a negative exponent, a base outside
# 2..36, a digit the base does not have, a value that does not fit the integer
# asked for.
#
# BigInt is sign-magnitude:
#   @sign : Int32          -1 negative, 0 zero, 1 positive
#   @limbs : Array(UInt64) little-endian 32-bit digits, no leading zeros
#
# Each limb holds 32 bits in a 64-bit word so that a 32x32 product plus two
# carries still fits the word; the canonical form (zero is sign 0 with no
# limbs) makes equality a limb-by-limb comparison.
#
# Algorithms: schoolbook add/sub; schoolbook multiply below 64 limbs and
# Karatsuba above; single-limb short division, one pass for a quotient of
# one limb, or Knuth's Algorithm D (TAOCP 4.3.1); binary square-and-multiply
# for `**`; Montgomery multiplication on 64-bit words with a sliding window
# for `pow_mod` modulo an odd number, a fixed window that reads its whole
# table for `pow_mod_secret`, square-and-multiply modulo an even one; two's
# complement over infinite sign extension for `& | ^ ~ << >>`. `//`
# truncates toward zero and `%` takes the dividend's sign, the prelude's
# Int32 rule. `hash` mixes every limb with wrapping arithmetic, so any size
# hashes.
#
# BigDecimal is `value * 10^-scale` with an exact BigInt value. `+ - *` are
# exact. `/` is the one operation that can be inexact: `div(other, precision)`
# answers the quotient rounded half away from zero to `precision` fractional
# digits, and an exact quotient is answered with the fewest digits that write
# it (`1/4` is `0.25`, `6/3` is `2`); `a / b` is `a.div(b, DIVISION_PRECISION)`
# with 20 fractional digits. `==` and `hash` agree: `1.10 == 1.1` and both
# hash alike. Zero prints as `0` whatever its scale.
#
# BigRational is a reduced numerator/denominator pair with a positive
# denominator; every operation reduces, so `==` and `hash` are structural.
#
# BigFloat is a binary float of any precision, `±mantissa · 2^exponent`
# with the mantissa exactly `precision` bits, each result rounded once to
# the nearest, ties to even, from its exact value (see `BigFloat`).

module std/big

import std/int
import std/traits::{Comparable, Num, Hashable}

pub struct BigInt
  getter sign : Int32
  getter limbs : Array(UInt64)

  # Crossover point above which Karatsuba multiplication is used.
  # Empirically measured: schoolbook is faster below 64 limbs (2048 bits)
  # due to zero allocation overhead in its flat result buffer.
  KARATSUBA_THRESHOLD = 64

  # Raw constructor from sign and limbs. Trims leading zero limbs to enforce
  # the canonical representation invariant: zero has empty limbs and sign 0.
  def initialize(sign : Int32, limbs : Array(UInt64))
    while limbs.size > 0 && limbs.last == 0_u64
      limbs.pop
    end
    if limbs.empty?
      @sign = 0
      @limbs = limbs
    else
      @sign = sign < 0 ? -1 : (sign > 0 ? 1 : 0)
      @limbs = limbs
    end
  end

  # Constructs a BigInt from an Int64.
  def self.new(val : Int64) : BigInt
    return BigInt.zero if val == 0_i64
    if val < 0_i64
      sign = -1
      mag = val == -9223372036854775808_i64 ? 0x8000000000000000_u64 : (-val).to_u64
    else
      sign = 1
      mag = val.to_u64
    end
    limbs = Array(UInt64).new(2)
    limbs << (mag & 0xFFFFFFFF_u64)
    high = mag.unsafe_shr(32_u64)
    limbs << high if high > 0_u64
    BigInt.new(sign, limbs)
  end

  # Constructs a BigInt from an Int32.
  def self.new(val : Int32) : BigInt
    new(val.to_i64)
  end

  # Parses a BigInt from a string in the given base (2..36, default 10).
  # Supports leading whitespace, optional sign ('+' or '-'), and base prefixes
  # (0x/0X for hex, 0b/0B for binary, 0o/0O for octal).
  def self.new(str : String, base : Int32 = 10) : BigInt
    parse(str, base)
  end

  # Parses a hexadecimal string (with or without '0x' prefix).
  def self.from_hex(str : String) : BigInt
    parse(str, 16)
  end

  # The big-endian *bytes* as a non-negative BigInt: a key, a signature, a
  # coordinate as cryptography writes them. Four bytes a limb, the low
  # limb from the last four.
  def self.from_bytes(bytes : Array(UInt8)) : BigInt
    limbs = Array(UInt64).new((bytes.size + 3) // 4, 0_u64)
    n = bytes.size
    i = 0
    while i < n
      limbs[i // 4] = limbs[i // 4] | (bytes[n - 1 - i].to_u64 << ((i % 4) * 8))
      i = i + 1
    end
    BigInt.new(1, limbs)
  end

  # The value big-endian in exactly *size* bytes, zeros in front: the
  # inverse of `from_bytes` at a fixed width, which is how a signature or a
  # coordinate is written. Nil for a negative value or one that does not
  # fit, never a value cut short.
  def to_bytes(size : Int32) : Array(UInt8)?
    return nil if negative? || size < 0
    bytes = Array(UInt8).new(size, 0_u8)
    i = 0
    while i < @limbs.size
      limb = @limbs[i]
      k = 0
      while k < 4
        byte = ((limb >> (k * 8)) & 0xFF_u64).to_u8
        at = i * 4 + k
        if at >= size
          return nil unless byte == 0_u8
        else
          bytes[size - 1 - at] = byte
        end
        k = k + 1
      end
      i = i + 1
    end
    bytes
  end

  # Parses a string with full error checking.
  def self.parse(str : String, base : Int32 = 10) : BigInt
    raise "invalid base: #{base} (must be 2..36)" if base < 2 || base > 36

    bytes = str.to_unsafe
    start_idx = 0
    end_idx = str.bytesize - 1
    while start_idx <= end_idx && (bytes[start_idx] == 32_u8 || bytes[start_idx] == 9_u8 || bytes[start_idx] == 10_u8 || bytes[start_idx] == 13_u8)
      start_idx = start_idx + 1
    end
    while end_idx >= start_idx && (bytes[end_idx] == 32_u8 || bytes[end_idx] == 9_u8 || bytes[end_idx] == 10_u8 || bytes[end_idx] == 13_u8)
      end_idx = end_idx - 1
    end

    raise "invalid BigInt: empty string" if start_idx > end_idx

    # Sign check
    sign = 1
    if bytes[start_idx] == 45_u8 # '-'
      sign = -1
      start_idx = start_idx + 1
    elsif bytes[start_idx] == 43_u8 # '+'
      start_idx = start_idx + 1
    end

    raise "invalid BigInt: string has sign only" if start_idx > end_idx

    actual_base = base
    # Prefix check if base is 10 or 16
    if start_idx + 1 <= end_idx && bytes[start_idx] == 48_u8 # '0'
      prefix_char = bytes[start_idx + 1]
      if (prefix_char == 120_u8 || prefix_char == 88_u8) && (base == 10 || base == 16) # 'x' or 'X'
        actual_base = 16
        start_idx = start_idx + 2
      elsif (prefix_char == 98_u8 || prefix_char == 66_u8) && (base == 10 || base == 2) # 'b' or 'B'
        actual_base = 2
        start_idx = start_idx + 2
      elsif (prefix_char == 111_u8 || prefix_char == 79_u8) && (base == 10 || base == 8) # 'o' or 'O'
        actual_base = 8
        start_idx = start_idx + 2
      end
    end

    raise "invalid BigInt: empty digits after prefix" if start_idx > end_idx

    # The digits' values, most significant first. Each base keeps its own
    # sentence for a byte that is not one of its digits.
    digits = Array(UInt8).new(end_idx - start_idx + 1)
    idx = start_idx
    while idx <= end_idx
      byte = bytes[idx]
      idx = idx + 1
      next if byte == 95_u8 # '_'
      digit = BigInt.digit_value(byte)
      if digit >= actual_base
        char = byte.unsafe_chr
        raise "invalid BigInt digit: #{char}" if actual_base == 10
        raise "invalid BigInt hex digit: #{char}" if actual_base == 16
        raise "invalid BigInt binary digit: #{char}" if actual_base == 2
        raise "invalid BigInt digit: #{char} for base #{actual_base}"
      end
      digits << digit.to_u8
    end
    # Underscores are skipped, so `_`, `-_` and `0x_` get here with none.
    raise "invalid BigInt: no digits in \"#{str}\"" if digits.empty?

    result = BigInt.from_digits(digits, actual_base)
    sign < 0 ? result.negate : result
  end

  # A digit byte's value in any base up to 36, or 36 for a byte that is a
  # digit in none.
  protected def self.digit_value(byte : UInt8) : Int32
    if byte >= 48_u8 && byte <= 57_u8
      (byte - 48_u8).to_i32
    elsif byte >= 97_u8 && byte <= 122_u8
      (byte - 87_u8).to_i32
    elsif byte >= 65_u8 && byte <= 90_u8
      (byte - 55_u8).to_i32
    else
      36
    end
  end

  # The value of `digits`, most significant first, in `base`: the inverse
  # of `to_s(base)`, and built the same way. A power-of-two base packs the
  # digits' bits into limbs directly. Any other splits the digits at a
  # power of the chunk (`append_digits`), so that the halves meet in one
  # Karatsuba product each, and runs the short pieces at the bottom through
  # one multiply-add per chunk in place. This had shifted or multiplied a
  # whole new BigInt per digit - per nine digits in decimal - and 80,000
  # hex digits took more than a second.
  protected def self.from_digits(digits : Array(UInt8), base : Int32) : BigInt
    count = digits.size
    return BigInt.zero if count == 0
    if base & (base - 1) == 0
      width = BigInt.bits_per_digit(base).to_u64
      limbs = Array(UInt64).new(count * width.to_i32 // 32 + 1)
      acc = 0_u64
      held = 0_u64
      i = count - 1
      while i >= 0
        acc = acc | digits[i].to_u64.unsafe_shl(held)
        held = held + width
        if held >= 32_u64
          limbs << (acc & 0xFFFFFFFF_u64)
          acc = acc.unsafe_shr(32_u64)
          held = held - 32_u64
        end
        i = i - 1
      end
      limbs << acc if acc > 0_u64
      return BigInt.new(1, limbs)
    end

    chunk = base.to_u64
    per = 1
    while chunk * base.to_u64 <= 0xFFFFFFFF_u64
      chunk = chunk * base.to_u64
      per = per + 1
    end
    powers = [BigInt.new(chunk.to_i64)]
    while per.unsafe_shl(powers.size) < count
      powers << powers.last * powers.last
    end
    value_of_digits(digits, 0, count, base.to_u64, per, powers)
  end

  # The value of `count` digits from `from`: the high part times the power
  # of the chunk that the low part's digits stand for, plus the low part.
  protected def self.value_of_digits(digits : Array(UInt8), from : Int32, count : Int32, base : UInt64, per : Int32, powers : Array(BigInt)) : BigInt
    if count > per * DIGITS_SPLIT_LIMBS
      level = powers.size - 1
      while level > 0 && per.unsafe_shl(level) >= count
        level = level - 1
      end
      low = per.unsafe_shl(level)
      high = value_of_digits(digits, from, count - low, base, per, powers)
      return high * powers[level] + value_of_digits(digits, from + count - low, low, base, per, powers)
    end

    limbs = Array(UInt64).new(count // per + 2)
    i = from
    stop = from + count
    while i < stop
      value = 0_u64
      scale = 1_u64
      taken = 0
      while taken < per && i < stop
        value = value * base + digits[i].to_u64
        scale = scale * base
        taken = taken + 1
        i = i + 1
      end
      carry = value
      w = limbs.to_unsafe
      j = 0
      size = limbs.size
      while j < size
        product = w[j] &* scale &+ carry
        w[j] = product & 0xFFFFFFFF_u64
        carry = product.unsafe_shr(32_u64)
        j = j + 1
      end
      limbs << carry if carry > 0_u64
    end
    BigInt.new(1, limbs)
  end

  # Number of limbs currently allocated.
  def size : Int32
    @limbs.size
  end

  # Returns true if this number is zero.
  def zero? : Bool
    @sign == 0
  end

  # Returns true if this number is strictly positive (> 0).
  def positive? : Bool
    @sign > 0
  end

  # Returns true if this number is strictly negative (< 0).
  def negative? : Bool
    @sign < 0
  end

  # Returns true if this number is even.
  def even? : Bool
    @limbs.empty? || (@limbs[0] & 1_u64) == 0_u64
  end

  # Returns true if this number is odd.
  def odd? : Bool
    !even?
  end

  # Returns the absolute value of self.
  def abs : BigInt
    @sign < 0 ? BigInt.new(1, @limbs.dup) : self
  end

  # Returns the negated value of self (-self).
  def negate : BigInt
    return self if zero?
    BigInt.new(-@sign, @limbs.dup)
  end

  def - : BigInt
    negate
  end

  def + : BigInt
    self
  end

  # Magnitude comparison: compares |self| and |other|.
  # Returns -1 if |self| < |other|, 0 if |self| == |other|, 1 if |self| > |other|.
  def cmp_abs(other : BigInt) : Int32
    if @limbs.size != other.limbs.size
      return @limbs.size < other.limbs.size ? -1 : 1
    end
    a = @limbs.to_unsafe
    b = other.limbs.to_unsafe
    i = @limbs.size - 1
    while i >= 0
      return a[i] < b[i] ? -1 : 1 if a[i] != b[i]
      i = i - 1
    end
    0
  end

  # Three-way comparison is `<=>`, from `impl Comparable` below.
  def !=(other : BigInt) : Bool
    (self <=> other) != 0
  end

  # Comparison overloads for Int64 and Int32
  def <=>(other : Int64) : Int32
    (self <=> BigInt.new(other))
  end

  def ==(other : Int64) : Bool
    (self <=> other) == 0
  end

  def !=(other : Int64) : Bool
    (self <=> other) != 0
  end

  def <(other : Int64) : Bool
    (self <=> other) < 0
  end

  def <=(other : Int64) : Bool
    (self <=> other) <= 0
  end

  def >(other : Int64) : Bool
    (self <=> other) > 0
  end

  def >=(other : Int64) : Bool
    (self <=> other) >= 0
  end

  def <=>(other : Int32) : Int32
    (self <=> other.to_i64)
  end

  def ==(other : Int32) : Bool
    (self <=> other) == 0
  end

  def !=(other : Int32) : Bool
    (self <=> other) != 0
  end

  def <(other : Int32) : Bool
    (self <=> other) < 0
  end

  def <=(other : Int32) : Bool
    (self <=> other) <= 0
  end

  def >(other : Int32) : Bool
    (self <=> other) > 0
  end

  def >=(other : Int32) : Bool
    (self <=> other) >= 0
  end

  # Addition
  def +(other : BigInt) : BigInt
    return other if zero?
    return self if other.zero?
    if @sign == other.sign
      res_limbs = add_abs_limbs(@limbs, other.limbs)
      BigInt.new(@sign, res_limbs)
    else
      c = cmp_abs(other)
      if c == 0
        BigInt.zero
      elsif c > 0
        res_limbs = sub_abs_limbs(@limbs, other.limbs)
        BigInt.new(@sign, res_limbs)
      else
        res_limbs = sub_abs_limbs(other.limbs, @limbs)
        BigInt.new(other.sign, res_limbs)
      end
    end
  end

  def +(other : Int64) : BigInt
    self + BigInt.new(other)
  end

  def +(other : Int32) : BigInt
    self + BigInt.new(other.to_i64)
  end

  # Subtraction: the sum with the other's sign turned, without copying it.
  def -(other : BigInt) : BigInt
    return self if other.zero?
    return other.negate if zero?
    if @sign != other.sign
      BigInt.new(@sign, add_abs_limbs(@limbs, other.limbs))
    else
      c = cmp_abs(other)
      if c == 0
        BigInt.zero
      elsif c > 0
        BigInt.new(@sign, sub_abs_limbs(@limbs, other.limbs))
      else
        BigInt.new(-@sign, sub_abs_limbs(other.limbs, @limbs))
      end
    end
  end

  def -(other : Int64) : BigInt
    self - BigInt.new(other)
  end

  def -(other : Int32) : BigInt
    self - BigInt.new(other.to_i64)
  end

  # The limb loops below go through the arrays' pointers: every index is
  # inside the sizes they are given, and a bounds check and a growth check
  # per limb were most of what adding, multiplying and dividing cost.
  private def add_abs_limbs(a : Array(UInt64), b : Array(UInt64)) : Array(UInt64)
    long = a.size >= b.size ? a : b
    short = a.size >= b.size ? b : a
    n = long.size
    m = short.size
    res = Array(UInt64).unsafe_build(n + 1)
    r = res.to_unsafe
    x = long.to_unsafe
    y = short.to_unsafe
    carry = 0_u64
    i = 0
    while i < m
      sum = x[i] &+ y[i] &+ carry
      r[i] = sum & 0xFFFFFFFF_u64
      carry = sum.unsafe_shr(32_u64)
      i = i + 1
    end
    while i < n
      sum = x[i] &+ carry
      r[i] = sum & 0xFFFFFFFF_u64
      carry = sum.unsafe_shr(32_u64)
      i = i + 1
    end
    r[n] = carry
    res.unsafe_set_size(carry > 0_u64 ? n + 1 : n)
    res
  end

  # |a| - |b|, |a| at least |b|.
  private def sub_abs_limbs(a : Array(UInt64), b : Array(UInt64)) : Array(UInt64)
    n = a.size
    m = b.size
    res = Array(UInt64).unsafe_build(n)
    r = res.to_unsafe
    x = a.to_unsafe
    y = b.to_unsafe
    borrow = 0_u64
    i = 0
    while i < n
      sub = (i < m ? y[i] : 0_u64) &+ borrow
      va = x[i]
      if va >= sub
        r[i] = va &- sub
        borrow = 0_u64
      else
        r[i] = va &+ 0x100000000_u64 &- sub
        borrow = 1_u64
      end
      i = i + 1
    end
    res
  end

  # Multiplication
  def *(other : BigInt) : BigInt
    return BigInt.zero if zero? || other.zero?
    sign = @sign == other.sign ? 1 : -1

    res_limbs = if @limbs.size < KARATSUBA_THRESHOLD || other.limbs.size < KARATSUBA_THRESHOLD
                  mul_schoolbook(@limbs, other.limbs)
                else
                  mul_karatsuba(@limbs, other.limbs, KARATSUBA_THRESHOLD)
                end
    BigInt.new(sign, res_limbs)
  end

  def *(other : Int64) : BigInt
    return BigInt.zero if zero? || other == 0_i64
    magnitude = other == -9223372036854775808_i64 ? 0x8000000000000000_u64 : (other < 0_i64 ? -other : other).to_u64
    return self * BigInt.new(other) if magnitude > 0xFFFFFFFF_u64
    BigInt.new(other < 0_i64 ? -@sign : @sign, mul_limb(@limbs, magnitude))
  end

  def *(other : Int32) : BigInt
    self * other.to_i64
  end

  # |a| times one limb, in one pass.
  private def mul_limb(a : Array(UInt64), limb : UInt64) : Array(UInt64)
    n = a.size
    res = Array(UInt64).unsafe_build(n + 1)
    r = res.to_unsafe
    x = a.to_unsafe
    carry = 0_u64
    i = 0
    while i < n
      product = x[i] &* limb &+ carry
      r[i] = product & 0xFFFFFFFF_u64
      carry = product.unsafe_shr(32_u64)
      i = i + 1
    end
    r[n] = carry
    res.unsafe_set_size(carry > 0_u64 ? n + 1 : n)
    res
  end

  # The result starts at zero: `Pointer.malloc` clears what it hands out.
  private def mul_schoolbook(a : Array(UInt64), b : Array(UInt64)) : Array(UInt64)
    n = a.size
    m = b.size
    res = Array(UInt64).unsafe_build(n + m)
    r = res.to_unsafe
    x = a.to_unsafe
    y = b.to_unsafe
    i = 0
    while i < n
      a_limb = x[i]
      if a_limb != 0_u64
        carry = 0_u64
        j = 0
        while j < m
          # At most (2^32 - 1)^2 + 2 * (2^32 - 1), which is 2^64 - 1.
          prod = a_limb &* y[j] &+ r[i + j] &+ carry
          r[i + j] = prod & 0xFFFFFFFF_u64
          carry = prod.unsafe_shr(32_u64)
          j = j + 1
        end
        r[i + m] = carry
      end
      i = i + 1
    end
    size = n + m
    while size > 0 && r[size - 1] == 0_u64
      size = size - 1
    end
    res.unsafe_set_size(size)
    res
  end

  private def slice_limbs(a : Array(UInt64), start : Int32, count : Int32) : Array(UInt64)
    res = Array(UInt64).new(count)
    i = 0
    while i < count
      idx = start + i
      res << (idx < a.size ? a[idx] : 0_u64)
      i = i + 1
    end
    while res.size > 0 && res.last == 0_u64
      res.pop
    end
    res
  end

  private def shift_limbs_left(a : Array(UInt64), k : Int32) : Array(UInt64)
    return a if a.empty? || k <= 0
    res = Array(UInt64).new(a.size + k) { 0_u64 }
    i = 0
    while i < a.size
      res[i + k] = a[i]
      i = i + 1
    end
    res
  end

  private def mul_karatsuba(a : Array(UInt64), b : Array(UInt64), threshold : Int32) : Array(UInt64)
    if a.size < threshold || b.size < threshold || a.empty? || b.empty?
      return mul_schoolbook(a, b)
    end

    n = a.size > b.size ? a.size : b.size
    k = (n + 1) // 2

    # The split below takes k limbs off each side for the low halves and
    # the rest for the high ones, which is a negative count for a side
    # shorter than k: `3 ** 10000` multiplies a squared base by a result
    # a fraction of its size, and panicked "negative capacity". A side that
    # short is multiplied against the other in pieces of its own size.
    if a.size < k || b.size < k
      return mul_unbalanced(a.size < b.size ? a : b, a.size < b.size ? b : a, threshold)
    end

    x0 = slice_limbs(a, 0, k)
    x1 = slice_limbs(a, k, a.size - k)
    y0 = slice_limbs(b, 0, k)
    y1 = slice_limbs(b, k, b.size - k)

    z0 = mul_karatsuba(x0, y0, threshold)
    z2 = mul_karatsuba(x1, y1, threshold)

    xsum = add_abs_limbs(x0, x1)
    ysum = add_abs_limbs(y0, y1)
    z1_raw = mul_karatsuba(xsum, ysum, threshold)
    z1 = sub_abs_limbs(sub_abs_limbs(z1_raw, z0), z2)

    z2_shifted = shift_limbs_left(z2, 2 * k)
    z1_shifted = shift_limbs_left(z1, k)
    add_abs_limbs(add_abs_limbs(z2_shifted, z1_shifted), z0)
  end

  # |short| times |long|, where `long` is more than twice as long: `long` in
  # pieces of `short`'s size, each piece's product added in at its offset.
  # The result starts at zero (`mul_schoolbook`), and a carry out of a
  # piece's product stops before n + m, because the whole product fits.
  private def mul_unbalanced(short : Array(UInt64), long : Array(UInt64), threshold : Int32) : Array(UInt64)
    m = short.size
    n = long.size
    res = Array(UInt64).unsafe_build(n + m)
    r = res.to_unsafe
    offset = 0
    while offset < n
      count = n - offset < m ? n - offset : m
      piece = mul_karatsuba(short, slice_limbs(long, offset, count), threshold)
      p = piece.to_unsafe
      carry = 0_u64
      i = 0
      while i < piece.size
        sum = r[offset + i] &+ p[i] &+ carry
        r[offset + i] = sum & 0xFFFFFFFF_u64
        carry = sum.unsafe_shr(32_u64)
        i = i + 1
      end
      while carry > 0_u64
        sum = r[offset + i] &+ carry
        r[offset + i] = sum & 0xFFFFFFFF_u64
        carry = sum.unsafe_shr(32_u64)
        i = i + 1
      end
      offset = offset + m
    end
    size = n + m
    while size > 0 && r[size - 1] == 0_u64
      size = size - 1
    end
    res.unsafe_set_size(size)
    res
  end

  # Division and Modulo. Returns {quotient, remainder}.
  # Division truncates towards zero; remainder follows the sign of the dividend (self).
  #
  # A long divisor and a long quotient go to `divmod_recursive`, the
  # recursive division `to_s` splits its digits with, on the magnitudes,
  # and take their signs after. Long division costs the product of the
  # quotient's length and the divisor's, and every division went to it: a
  # value twice a divisor of 524,288 bits took 282 ms in a release build
  # and one of 2,097,152 bits 4,929 ms, four times over per doubling,
  # where these take 179 and 1,964.
  def divmod(other : BigInt) : Tuple(BigInt, BigInt)
    raise "division by zero" if other.zero?
    divisor_bits = BigInt.bit_length(other)
    if divisor_bits > DIVIDE_RECURSIVE_BITS && BigInt.bit_length(self) - divisor_bits > DIVIDE_SPLIT_BITS
      q, r = abs.divmod_recursive(other.abs)
      return {@sign == other.sign ? q : q.negate, @sign < 0 ? r.negate : r}
    end
    divmod_long(other)
  end

  # Knuth's Algorithm D, with the signs `divmod` gives.
  protected def divmod_long(other : BigInt) : Tuple(BigInt, BigInt)
    raise "division by zero" if other.zero?
    return {BigInt.zero, BigInt.zero} if zero?

    q_sign = @sign == other.sign ? 1 : -1
    r_sign = @sign # remainder sign follows dividend

    c = cmp_abs(other)
    if c < 0
      return {BigInt.zero, self}
    elsif c == 0
      arr = Array(UInt64).new(1)
      arr << 1_u64
      return {BigInt.new(q_sign, arr), BigInt.zero}
    end

    # Single-limb divisor optimization: O(m) division
    if other.limbs.size == 1
      v0 = other.limbs[0]
      q_limbs = Array(UInt64).unsafe_build(@limbs.size)
      q = q_limbs.to_unsafe
      u = @limbs.to_unsafe
      rem = 0_u64
      i = @limbs.size - 1
      while i >= 0
        cur = rem.unsafe_shl(32_u64) | u[i]
        q[i] = cur.unsafe_div(v0)
        rem = cur.unsafe_mod(v0)
        i = i - 1
      end
      r_limbs = Array(UInt64).new(1)
      r_limbs << rem if rem > 0_u64
      q = BigInt.new(q_sign, q_limbs)
      r = BigInt.new(r_sign, r_limbs)
      return {q, r}
    end

    # A quotient under 2^32, which is what each step of Euclid's algorithm
    # divides by: `divmod_one_limb`, one pass and one array where Algorithm
    # D below copies both operands to normalise them and the remainder
    # twice more to give it back. A 2048-bit value over a 2046-bit one took
    # 0.60 us and takes 0.15 in a --release build, and the extended Euclid
    # that inverts a 2048-bit RSA signature's blinding factor took 592 us
    # and takes 281, where the two CRT halves of the signature take 620.
    shift = BigInt.bit_length(other) - 32
    return divmod_one_limb(other, shift, q_sign, r_sign) if BigInt.bit_length(self) - shift <= 63

    # Knuth Algorithm D for n >= 2 limbs
    n = other.limbs.size
    m = @limbs.size - n

    # Step D1: Normalize divisor so that most significant bit of high limb is 1
    v_high = other.limbs.last
    s = 0_u64
    tmp = v_high
    while tmp < 0x80000000_u64
      tmp = tmp.unsafe_shl(1_u64)
      s = s + 1_u64
    end

    u_prime = shift_left_limbs(@limbs, s)
    v_prime = shift_left_limbs(other.limbs, s)

    while u_prime.size < m + n + 1
      u_prime << 0_u64
    end

    q_limbs = Array(UInt64).unsafe_build(m + 1)
    qp = q_limbs.to_unsafe
    up = u_prime.to_unsafe
    vp = v_prime.to_unsafe
    vn1 = vp[n - 1]
    vn2 = vp[n - 2]

    # Steps D2 through D7: Loop on j from m down to 0
    j = m
    while j >= 0
      ujn = up[j + n]
      ujn1 = up[j + n - 1]
      ujn2 = up[j + n - 2]

      # Step D3: Calculate quotient estimate q_hat
      numerator = ujn.unsafe_shl(32_u64) | ujn1
      if ujn == vn1
        q_hat = 0xFFFFFFFF_u64
        r_hat = ujn.unsafe_shl(32_u64) | ujn1
        r_hat = r_hat - q_hat * vn1
      else
        q_hat = numerator.unsafe_div(vn1)
        r_hat = numerator.unsafe_mod(vn1)
      end

      # Refine q_hat
      while q_hat > 0xFFFFFFFF_u64 || (r_hat < 0x100000000_u64 && q_hat * vn2 > (r_hat.unsafe_shl(32_u64) | ujn2))
        q_hat = q_hat - 1_u64
        r_hat = r_hat + vn1
      end

      # Step D4: Multiply and subtract u_prime[j..j+n] -= q_hat * v_prime
      borrow = 0_u64
      k = 0
      while k < n
        p = q_hat &* vp[k] &+ borrow
        p_low = p & 0xFFFFFFFF_u64
        borrow = p.unsafe_shr(32_u64)

        u_val = up[j + k]
        if u_val >= p_low
          up[j + k] = u_val &- p_low
        else
          up[j + k] = u_val &+ 0x100000000_u64 &- p_low
          borrow = borrow &+ 1_u64
        end
        k = k + 1
      end

      u_val = up[j + n]
      if u_val >= borrow
        up[j + n] = u_val &- borrow
        negative = false
      else
        up[j + n] = u_val &+ 0x100000000_u64 &- borrow
        negative = true
      end

      # Step D5 & D6: Add back if q_hat was 1 too large
      if negative
        q_hat = q_hat - 1_u64
        carry = 0_u64
        k = 0
        while k < n
          sum = up[j + k] &+ vp[k] &+ carry
          up[j + k] = sum & 0xFFFFFFFF_u64
          carry = sum.unsafe_shr(32_u64)
          k = k + 1
        end
        up[j + n] = (up[j + n] &+ carry) & 0xFFFFFFFF_u64
      end

      qp[j] = q_hat
      j = j - 1
    end

    # Step D8: Unnormalize remainder by shifting right by s
    rem_limbs = Array(UInt64).new(n)
    k = 0
    while k < n
      rem_limbs << u_prime[k]
      k = k + 1
    end
    unnorm_rem = shift_right_limbs(rem_limbs, s)

    q = BigInt.new(q_sign, q_limbs)
    r = BigInt.new(r_sign, unnorm_rem)
    {q, r}
  end

  # |self| divided by |other|, two limbs or more, for a quotient under
  # 2^32: *shift* is the divisor's bit length less 32, and |self| over
  # 2^shift, A, fits 63 bits. With B the divisor's top 32 bits, the
  # quotient is estimated as A / (B + 1), which is never more than the
  # quotient and short of it by less than A / B^2 + 1, at most three; a - q
  # b is taken in one pass and the divisor taken off what is left while it
  # is not below it.
  protected def divmod_one_limb(other : BigInt, shift : Int32, q_sign : Int32, r_sign : Int32) : Tuple(BigInt, BigInt)
    q = BigInt.window(@limbs, shift) // (BigInt.window(other.limbs, shift) + 1_u64)
    n = @limbs.size
    m = other.limbs.size
    res = Array(UInt64).unsafe_build(n)
    r = res.to_unsafe
    u = @limbs.to_unsafe
    v = other.limbs.to_unsafe
    carry = 0_u64
    borrow = 0_u64
    i = 0
    while i < n
      # At most (2^32 - 1)^2 + 2^32 - 1: q is under 2^32.
      p = (i < m ? q &* v[i] : 0_u64) &+ carry
      carry = p.unsafe_shr(32_u64)
      sub = (p & 0xFFFFFFFF_u64) &+ borrow
      if u[i] >= sub
        r[i] = u[i] &- sub
        borrow = 0_u64
      else
        r[i] = u[i] &+ 0x100000000_u64 &- sub
        borrow = 1_u64
      end
      i = i + 1
    end
    res.unsafe_set_size(n)
    while BigInt.limbs_at_least(r, n, v, m)
      borrow = 0_u64
      i = 0
      while i < n
        sub = (i < m ? v[i] : 0_u64) &+ borrow
        if r[i] >= sub
          r[i] = r[i] &- sub
          borrow = 0_u64
        else
          r[i] = r[i] &+ 0x100000000_u64 &- sub
          borrow = 1_u64
        end
        i = i + 1
      end
      q = q + 1_u64
    end
    q_limbs = Array(UInt64).new(2, 0_u64)
    q_limbs[0] = q & 0xFFFFFFFF_u64
    q_limbs[1] = q.unsafe_shr(32_u64)
    {BigInt.new(q_sign, q_limbs), BigInt.new(r_sign, res)}
  end

  # |value| over 2^shift, for one under 2^64: the limbs from bit *shift*.
  protected def self.window(limbs : Array(UInt64), shift : Int32) : UInt64
    i = shift >> 5
    s = (shift & 31).to_u64
    w = limbs[i].unsafe_shr(s)
    w = w | limbs[i + 1].unsafe_shl(32_u64 - s) if i + 1 < limbs.size
    w = w | limbs[i + 2].unsafe_shl(64_u64 - s) if s > 0_u64 && i + 2 < limbs.size
    w
  end

  # Whether the *n* limbs at *r* are at least the *m* at *v*.
  protected def self.limbs_at_least(r : Pointer(UInt64), n : Int32, v : Pointer(UInt64), m : Int32) : Bool
    i = n - 1
    while i >= m
      return true if r[i] != 0_u64
      i = i - 1
    end
    while i >= 0
      return r[i] > v[i] if r[i] != v[i]
      i = i - 1
    end
    true
  end

  def //(other : BigInt) : BigInt
    divmod(other)[0]
  end

  def //(other : Int64) : BigInt
    self // BigInt.new(other)
  end

  def //(other : Int32) : BigInt
    self // BigInt.new(other.to_i64)
  end

  def %(other : BigInt) : BigInt
    raise "modulo by zero" if other.zero?
    divmod(other)[1]
  end

  def %(other : Int64) : BigInt
    self % BigInt.new(other)
  end

  def %(other : Int32) : BigInt
    self % BigInt.new(other.to_i64)
  end

  private def shift_left_limbs(limbs : Array(UInt64), bits : UInt64) : Array(UInt64)
    return limbs.dup if bits == 0_u64
    n = limbs.size
    res = Array(UInt64).unsafe_build(n + 1)
    r = res.to_unsafe
    x = limbs.to_unsafe
    carry = 0_u64
    rshift = 32_u64 - bits
    i = 0
    while i < n
      val = x[i]
      r[i] = (val.unsafe_shl(bits) | carry) & 0xFFFFFFFF_u64
      carry = val.unsafe_shr(rshift)
      i = i + 1
    end
    r[n] = carry
    res.unsafe_set_size(carry > 0_u64 ? n + 1 : n)
    res
  end

  private def shift_right_limbs(limbs : Array(UInt64), bits : UInt64) : Array(UInt64)
    return limbs.dup if bits == 0_u64
    n = limbs.size
    res = Array(UInt64).unsafe_build(n)
    r = res.to_unsafe
    x = limbs.to_unsafe
    carry = 0_u64
    lshift = 32_u64 - bits
    i = n - 1
    while i >= 0
      val = x[i]
      r[i] = val.unsafe_shr(bits) | carry
      carry = val.unsafe_shl(lshift) & 0xFFFFFFFF_u64
      i = i - 1
    end
    size = n
    while size > 0 && r[size - 1] == 0_u64
      size = size - 1
    end
    res.unsafe_set_size(size)
    res
  end

  # Exponentiation by squaring: a ** exp
  def **(exp : Int32) : BigInt
    self ** exp.to_i64
  end

  def **(exp : Int64) : BigInt
    raise "negative exponent: #{exp}" if exp < 0_i64
    return BigInt.one if exp == 0_i64
    return BigInt.zero if zero?

    res = BigInt.one
    base = self
    e = exp
    while e > 0_i64
      res = res * base if (e & 1_i64) == 1_i64
      e = e // 2_i64
      base = base * base if e > 0_i64
    end
    res
  end

  def **(exp : BigInt) : BigInt
    raise "negative exponent: #{exp}" if exp.negative?
    return BigInt.one if exp.zero?
    return BigInt.zero if zero?

    res = BigInt.one
    base = self
    e = exp
    while !e.zero?
      res = res * base if e.odd?
      e = e >> 1
      base = base * base if !e.zero?
    end
    res
  end

  # Greatest Common Divisor (Euclidean algorithm)
  def gcd(other : BigInt) : BigInt
    a = self.abs
    b = other.abs
    while !b.zero?
      rem = a % b
      a = b
      b = rem
    end
    a
  end

  def gcd(other : Int64) : BigInt
    gcd(BigInt.new(other))
  end

  def gcd(other : Int32) : BigInt
    gcd(BigInt.new(other.to_i64))
  end

  # Least Common Multiple
  def lcm(other : BigInt) : BigInt
    return BigInt.zero if zero? || other.zero?
    (self.abs // gcd(other)) * other.abs
  end

  def lcm(other : Int64) : BigInt
    lcm(BigInt.new(other))
  end

  def lcm(other : Int32) : BigInt
    lcm(BigInt.new(other.to_i64))
  end

  # Bitwise NOT (~a = -a - 1 in two's complement)
  def ~ : BigInt
    -(self + 1_i64)
  end

  def abs2 : BigInt
    self * self
  end

  def to_big_i : BigInt
    self
  end

  # Modular exponentiation: (self ** exp) % mod, in 0...mod whatever the
  # base's sign. An odd modulus, which is every modulus RSA, Diffie-Hellman
  # and DSA work in, goes to `Montgomery` with a sliding window; an even one
  # keeps square-and-multiply with a division per step.
  #
  # Each step here was a product and a long division of twice the
  # modulus' length, and a 2048-bit modulus with a 2048-bit exponent took
  # 19.0 ms in a --release build where Python 3.14's `pow` took 13.3 (3072
  # bits: 63.2 and 42.3, 4096: 168.7 and 100.3). Montgomery's takes 2.5 ms,
  # 8.5 and 20.6 in the run of bench/std_big_exercise.sh that measured
  # Python at 13.7, 45.4 and 102.1, which prints these each run.
  def pow_mod(exp : BigInt, mod : BigInt) : BigInt
    raise "modulo by zero" if mod.zero?
    raise "modulus must be positive" if mod.negative?
    raise "negative exponent in pow_mod: #{exp}" if exp.negative?
    return BigInt.zero if mod == 1_i64

    # Ensure base is non-negative modulo mod
    base = self % mod
    base = base + mod if base.negative?
    return Montgomery.new(mod, false).pow(base, exp) if mod.odd?

    # The exponent's bits read where they lie: shifting it right a bit at
    # a time made a copy of it per bit.
    result = BigInt.one
    bits = BigInt.bit_length(exp)
    i = 0
    while i < bits
      if (exp.limbs[i >> 5].unsafe_shr((i & 31).to_u64) & 1_u64) == 1_u64
        result = (result * base) % mod
      end
      i = i + 1
      base = (base * base) % mod if i < bits
    end
    result
  end

  # `pow_mod` for an exponent that is a secret, a private key's: a fixed
  # window, every entry of its table read for each window and the one
  # wanted kept by a mask, so neither a branch nor a memory address depends
  # on the exponent's bits, and as many windows as the longer of the
  # exponent and the modulus takes, so the exponent's length does not show
  # either. The modulus has to be odd (a Montgomery modulus): an even one
  # is a misuse, refused.
  #
  # What it does not hide: the base is reduced by `%`, whose time depends
  # on the base and the modulus, so a caller with a secret base (RSA's
  # CRT halves of a message) blinds it first, as std/rsa's signing does.
  def pow_mod_secret(exp : BigInt, mod : BigInt) : BigInt
    raise "modulo by zero" if mod.zero?
    raise "modulus must be positive" if mod.negative?
    raise "negative exponent in pow_mod_secret: #{exp}" if exp.negative?
    raise "pow_mod_secret needs an odd modulus, not #{mod}" if mod.even?
    return BigInt.zero if mod == 1_i64
    base = self % mod
    base = base + mod if base.negative?
    exp_bits = BigInt.bit_length(exp)
    mod_bits = BigInt.bit_length(mod)
    Montgomery.new(mod, true).pow_fixed(base, exp, exp_bits > mod_bits ? exp_bits : mod_bits)
  end

  def pow_mod(exp : Int64, mod : Int64) : BigInt
    pow_mod(BigInt.new(exp), BigInt.new(mod))
  end

  def pow_mod(exp : Int32, mod : Int32) : BigInt
    pow_mod(BigInt.new(exp.to_i64), BigInt.new(mod.to_i64))
  end

  # Bitwise Left Shift: a << count
  def <<(count : Int32) : BigInt
    return self >> (-count) if count < 0
    return self if count == 0 || zero?

    limb_shift = count // 32
    bit_shift = (count % 32).to_u64

    # Zero limbs below, from `Pointer.malloc`, and the shifted ones above.
    n = @limbs.size
    res_limbs = Array(UInt64).unsafe_build(n + limb_shift + 1)
    r = res_limbs.to_unsafe + limb_shift.to_i64
    x = @limbs.to_unsafe
    carry = 0_u64
    rshift = 32_u64 - bit_shift
    i = 0
    while i < n
      val = x[i]
      r[i] = (val.unsafe_shl(bit_shift) | carry) & 0xFFFFFFFF_u64
      carry = val.unsafe_shr(rshift)
      i = i + 1
    end
    r[n] = carry
    res_limbs.unsafe_set_size(carry > 0_u64 ? n + limb_shift + 1 : n + limb_shift)
    BigInt.new(@sign, res_limbs)
  end

  # Bitwise Right Shift (arithmetic): a >> count
  def >>(count : Int32) : BigInt
    return self << (-count) if count < 0
    return self if count == 0 || zero?

    if positive?
      limb_shift = count // 32
      return BigInt.zero if limb_shift >= @limbs.size

      bit_shift = (count % 32).to_u64
      res_size = @limbs.size - limb_shift
      res_limbs = Array(UInt64).new(res_size) { 0_u64 }

      if bit_shift == 0_u64
        i = 0
        while i < res_size
          res_limbs[i] = @limbs[i + limb_shift]
          i = i + 1
        end
      else
        carry = 0_u64
        lshift = 32_u64 - bit_shift
        i = @limbs.size - 1
        while i >= limb_shift
          val = @limbs[i]
          new_val = (val.unsafe_shr(bit_shift)) | carry
          carry = (val.unsafe_shl(lshift)) & 0xFFFFFFFF_u64
          res_limbs[i - limb_shift] = new_val
          i = i - 1
        end
      end
      BigInt.new(1, res_limbs)
    else
      # Two's complement arithmetic right shift for negative numbers: floor(self / 2^count)
      # For a < 0, let a = -m.
      # If m is divisible by 2^count, result is -(m >> count).
      # Otherwise, result is -((m >> count) + 1).
      m = abs
      shifted = m >> count
      # Check if lower bits of m are non-zero
      limb_shift = count // 32
      bit_shift = count % 32
      has_remainder = false
      i = 0
      while i < limb_shift && i < m.limbs.size
        if m.limbs[i] != 0_u64
          has_remainder = true
          break
        end
        i = i + 1
      end
      if !has_remainder && limb_shift < m.limbs.size && bit_shift > 0
        mask = (1_u64.unsafe_shl(bit_shift.to_u64)) - 1_u64
        has_remainder = (m.limbs[limb_shift] & mask) != 0_u64
      end

      if has_remainder
        -(shifted + BigInt.one)
      else
        -shifted
      end
    end
  end

  # Helper: bitwise magnitude operation with sign inversion
  protected def twos_mag : BigInt
    abs - BigInt.one
  end

  # Bitwise AND (&) with two's complement semantics
  def &(other : BigInt) : BigInt
    if positive? && other.positive?
      n = @limbs.size < other.limbs.size ? @limbs.size : other.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        res << (@limbs[i] & other.limbs[i])
        i = i + 1
      end
      BigInt.new(1, res)
    elsif positive? && other.negative?
      # a & (~mb)
      mb = other.twos_mag
      n = @limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        b_limb = i < mb.limbs.size ? mb.limbs[i] : 0_u64
        res << (@limbs[i] & (b_limb ^ 0xFFFFFFFF_u64))
        i = i + 1
      end
      BigInt.new(1, res)
    elsif negative? && other.positive?
      other & self
    elsif negative? && other.negative?
      # (~ma) & (~mb) = ~(ma | mb) = -((ma | mb) + 1)
      ma = twos_mag
      mb = other.twos_mag
      n = ma.limbs.size > mb.limbs.size ? ma.limbs.size : mb.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        va = i < ma.limbs.size ? ma.limbs[i] : 0_u64
        vb = i < mb.limbs.size ? mb.limbs[i] : 0_u64
        res << (va | vb)
        i = i + 1
      end
      -(BigInt.new(1, res) + BigInt.one)
    else
      BigInt.zero
    end
  end

  # Bitwise OR (|) with two's complement semantics
  def |(other : BigInt) : BigInt
    return other if zero?
    return self if other.zero?

    if positive? && other.positive?
      n = @limbs.size > other.limbs.size ? @limbs.size : other.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        va = i < @limbs.size ? @limbs[i] : 0_u64
        vb = i < other.limbs.size ? other.limbs[i] : 0_u64
        res << (va | vb)
        i = i + 1
      end
      BigInt.new(1, res)
    elsif positive? && other.negative?
      # a | (~mb) = ~ (mb & ~a) = -((mb & ~a) + 1)
      mb = other.twos_mag
      n = mb.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        va = i < @limbs.size ? @limbs[i] : 0_u64
        vb = mb.limbs[i]
        res << (vb & (va ^ 0xFFFFFFFF_u64))
        i = i + 1
      end
      -(BigInt.new(1, res) + BigInt.one)
    elsif negative? && other.positive?
      other | self
    else
      # (~ma) | (~mb) = ~(ma & mb) = -((ma & mb) + 1)
      ma = twos_mag
      mb = other.twos_mag
      n = ma.limbs.size < mb.limbs.size ? ma.limbs.size : mb.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        res << (ma.limbs[i] & mb.limbs[i])
        i = i + 1
      end
      -(BigInt.new(1, res) + BigInt.one)
    end
  end

  # Bitwise XOR (^) with two's complement semantics
  def ^(other : BigInt) : BigInt
    return other if zero?
    return self if other.zero?

    if positive? && other.positive?
      n = @limbs.size > other.limbs.size ? @limbs.size : other.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        va = i < @limbs.size ? @limbs[i] : 0_u64
        vb = i < other.limbs.size ? other.limbs[i] : 0_u64
        res << (va ^ vb)
        i = i + 1
      end
      BigInt.new(1, res)
    elsif positive? && other.negative?
      # a ^ (~mb) = ~(a ^ mb) = -((a ^ mb) + 1)
      mb = other.twos_mag
      n = @limbs.size > mb.limbs.size ? @limbs.size : mb.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        va = i < @limbs.size ? @limbs[i] : 0_u64
        vb = i < mb.limbs.size ? mb.limbs[i] : 0_u64
        res << (va ^ vb)
        i = i + 1
      end
      -(BigInt.new(1, res) + BigInt.one)
    elsif negative? && other.positive?
      other ^ self
    else
      # (~ma) ^ (~mb) = ma ^ mb
      ma = twos_mag
      mb = other.twos_mag
      n = ma.limbs.size > mb.limbs.size ? ma.limbs.size : mb.limbs.size
      res = Array(UInt64).new(n)
      i = 0
      while i < n
        va = i < ma.limbs.size ? ma.limbs[i] : 0_u64
        vb = i < mb.limbs.size ? mb.limbs[i] : 0_u64
        res << (va ^ vb)
        i = i + 1
      end
      BigInt.new(1, res)
    end
  end

  # Converts this BigInt to a string in the given base (default 10).
  # Bases 2..36 supported. Digits above 9 are lowercase 'a'..'z'.
  #
  # The digits are gathered least significant first and written into the
  # string once. A base that is a power of two reads them straight off the
  # limbs' bits; any other divides a copy of the limbs in place by the
  # largest power of the base a limb holds - 10^9 for decimal - and takes
  # that many digits from each remainder. This had built the text with
  # `res = res + s`, a copy of everything so far per chunk, and divided by
  # a fresh one-limb BigInt per chunk, or per digit outside bases 2, 10
  # and 16: 3 ** 400000 took a second in decimal and in binary, and nine
  # and a half in base 7.
  def to_s(base : Int32) : String
    raise "invalid base: #{base} (must be 2..36)" if base < 2 || base > 36
    return "0" if zero?

    digits = Array(UInt8).new(@limbs.size * 32 // BigInt.bits_per_digit(base) + 2)
    if base & (base - 1) == 0
      width = BigInt.bits_per_digit(base).to_u64
      mask = (base - 1).to_u64
      acc = 0_u64
      held = 0_u64
      @limbs.each do |limb|
        acc = acc | limb.unsafe_shl(held)
        held = held + 32_u64
        while held >= width
          digits << BigInt.digit_byte(acc & mask)
          acc = acc.unsafe_shr(width)
          held = held - width
        end
      end
      while acc > 0_u64
        digits << BigInt.digit_byte(acc & mask)
        acc = acc.unsafe_shr(width)
      end
    else
      chunk = base.to_u64
      per = 1
      while chunk * base.to_u64 <= 0xFFFFFFFF_u64
        chunk = chunk * base.to_u64
        per = per + 1
      end
      # chunk, chunk ** 2, chunk ** 4, ... up to about half this value.
      powers = [BigInt.new(chunk.to_i64)]
      while powers.last.limbs.size * 2 <= @limbs.size
        powers << powers.last * powers.last
      end
      abs.append_digits(base.to_u64, chunk, per, powers, powers.size - 1, 0, digits)
    end
    while digits.size > 1 && digits.last == 48_u8
      digits.pop
    end

    negative = @sign < 0
    lead = negative ? 1 : 0
    count = digits.size
    String.new(count + lead) do |bytes|
      bytes[0] = 45_u8 if negative
      i = 0
      while i < count
        bytes[lead + i] = digits[count - 1 - i]
        i = i + 1
      end
    end
  end

  # The bits one digit of a power-of-two base takes; for any other base,
  # the fewest bits a digit can carry, so that a limb's worth of bits
  # bounds how many digits it makes.
  protected def self.bits_per_digit(base : Int32) : Int32
    bits = 1
    while (1 << (bits + 1)) <= base
      bits = bits + 1
    end
    bits
  end

  protected def self.digit_byte(value : UInt64) : UInt8
    value < 10_u64 ? (48_u64 + value).to_u8 : (87_u64 + value).to_u8
  end

  # Below this many limbs a value's digits come one chunk at a time.
  DIGITS_SPLIT_LIMBS = 48

  # The digits of this value's magnitude, least significant first, onto
  # `sink`: exactly `width` of them when `width` is positive, zeros above.
  #
  # A long value is split by `powers[level]`, a power of the chunk about
  # half its size, and each half is written by the level below - the low
  # half to exactly the digits that power stands for, so its leading zeros
  # are kept. Dividing by one chunk at a time is a hardware division per
  # limb per nine digits, n^2 / 9 of them; the split does that only for the
  # short pieces at the bottom and multiplies its way through the rest,
  # dividing by `divmod_recursive`.
  protected def append_digits(radix : UInt64, chunk : UInt64, per : Int32, powers : Array(BigInt), level : Int32, width : Int32, sink : Array(UInt8)) : Nil
    if level >= 0 && @limbs.size >= DIGITS_SPLIT_LIMBS
      if cmp_abs(powers[level]) < 0
        append_digits(radix, chunk, per, powers, level - 1, width, sink)
      else
        split = per.unsafe_shl(level)
        halves = divmod_recursive(powers[level])
        halves[1].append_digits(radix, chunk, per, powers, level - 1, split, sink)
        halves[0].append_digits(radix, chunk, per, powers, level - 1, width > 0 ? width - split : 0, sink)
      end
      return
    end

    start = sink.size
    work = Array(UInt64).new(@limbs.size)
    work.concat(@limbs)
    w = work.to_unsafe
    size = work.size
    while size > 0
      rem = 0_u64
      i = size - 1
      while i >= 0
        current = rem.unsafe_shl(32_u64) | w[i]
        w[i] = current.unsafe_div(chunk)
        rem = current.unsafe_mod(chunk)
        i = i - 1
      end
      while size > 0 && w[size - 1] == 0_u64
        size = size - 1
      end
      taken = 0
      while taken < per && (size > 0 || rem > 0_u64)
        sink << BigInt.digit_byte(rem.unsafe_mod(radix))
        rem = rem.unsafe_div(radix)
        taken = taken + 1
      end
    end
    while sink.size < start + width
      sink << 48_u8
    end
  end

  # Below this many bits of quotient `divmod`'s long division answers. It
  # is as fast as the recursion below up to a divisor of 65,536 bits and
  # slower past it: 53 ms to 45 at 262,144 bits.
  DIVIDE_SPLIT_BITS = 16384

  # And below this many bits of divisor `divmod` itself divides long:
  # the recursion is the faster only past it, and it divides a value many
  # times the divisor's length one divisor's length at a time.
  DIVIDE_RECURSIVE_BITS = 65536

  # The quotient and remainder of this value, not negative, by `divisor`,
  # positive, for the time a few products of half the length take: long
  # division costs the product of the two lengths, and the split print
  # divides by a power half as long as the value, so `to_s` was quadratic -
  # 787 ms for 381,698 digits and 3,107 ms for twice as many. Burnikel and
  # Ziegler's recursive division, in the form Python's `_pylong` writes it,
  # by bits. A value past twice the divisor's length has its top divided
  # first, as long division takes a digit at a time; the rest is shifted so
  # that the divisor's length halves evenly down to where long division is
  # the faster, and the remainder shifted back.
  protected def divmod_recursive(divisor : BigInt) : Tuple(BigInt, BigInt)
    n = BigInt.bit_length(divisor)
    high = self >> n
    if high.cmp_abs(divisor) >= 0
      q, r = high.divmod_recursive(divisor)
      low, r = ((r << n) + bits(0, n)).divmod_recursive(divisor)
      return {(q << n) + low, r}
    end
    m = n
    k = 0
    while m > DIVIDE_SPLIT_BITS
      m = (m + 1) >> 1
      k = k + 1
    end
    pad = (m << k) - n
    q, r = (self << pad).div_two_by_one(divisor << pad, m << k)
    {q, r >> pad}
  end

  # This value, under `divisor * 2^n`, by `divisor`, exactly `n` bits long
  # and `n` even until it is short enough for long division: the top
  # `n + n/2` bits by the divisor, then the remainder and the next `n/2`.
  # Each is a division by the divisor's top half, a product by its bottom
  # half, and at most two corrections, the divisor's top bit being set.
  protected def div_two_by_one(divisor : BigInt, n : Int32) : Tuple(BigInt, BigInt)
    return divmod_long(divisor) if BigInt.bit_length(self) - n <= DIVIDE_SPLIT_BITS
    half = n >> 1
    top = divisor >> half
    bottom = divisor.bits(0, half)
    high, r = (self >> n).div_three_by_two(bits(half, half), divisor, top, bottom, half)
    low, r = r.div_three_by_two(bits(0, half), divisor, top, bottom, half)
    {(high << half) + low, r}
  end

  # This value's `2n` bits and `low`'s `n` by `b`, `top` and `bottom` its
  # halves of `n` bits each.
  protected def div_three_by_two(low : BigInt, b : BigInt, top : BigInt, bottom : BigInt, n : Int32) : Tuple(BigInt, BigInt)
    if (self >> n).cmp_abs(top) == 0
      q = (BigInt.one << n) - BigInt.one
      r = self - (top << n) + top
    else
      q, r = div_two_by_one(top, n)
    end
    r = (r << n) + low - q * bottom
    while r.negative?
      q = q - BigInt.one
      r = r + b
    end
    {q, r}
  end

  # `count` bits of this value, not negative, from bit `from` up, in one
  # copy.
  protected def bits(from : Int32, count : Int32) : BigInt
    size = (count + 31) >> 5
    res = Array(UInt64).new(size)
    start = from >> 5
    shift = (from & 31).to_u64
    i = 0
    while i < size
      j = start + i
      lo = j < @limbs.size ? @limbs[j] : 0_u64
      hi = j + 1 < @limbs.size ? @limbs[j + 1] : 0_u64
      res << ((lo.unsafe_shr(shift) | hi.unsafe_shl(32_u64 - shift)) & 0xFFFFFFFF_u64)
      i = i + 1
    end
    res[size - 1] = res[size - 1] & (1_u64.unsafe_shl((count & 31).to_u64) - 1_u64) if count & 31 != 0
    BigInt.new(1, res)
  end

  # The bits |value| takes to write.
  protected def self.bit_length(value : BigInt) : Int32
    return 0 if value.zero?
    top = value.limbs.last
    bits = (value.limbs.size - 1) * 32
    while top > 0_u64
      top = top.unsafe_shr(1_u64)
      bits = bits + 1
    end
    bits
  end

  def to_s : String
    to_s(10)
  end

  # Converts to Int64 if the value fits, or nil if it overflows.
  def to_i64? : Int64?
    return 0_i64 if zero?
    return nil if @limbs.size > 2

    if @limbs.size == 1
      val = @limbs[0].to_i64
      return @sign < 0 ? -val : val
    end

    # limbs.size == 2
    high = @limbs[1]
    low = @limbs[0]
    if @sign > 0
      return nil if high > 0x7FFFFFFF_u64
      uval = (high.unsafe_shl(32_u64)) | low
      uval.to_i64
    else
      return nil if high > 0x80000000_u64
      return nil if high == 0x80000000_u64 && low > 0_u64
      if high == 0x80000000_u64 && low == 0_u64
        return -9223372036854775808_i64
      end
      uval = (high.unsafe_shl(32_u64)) | low
      0_i64 - uval.to_i64
    end
  end

  # Converts to Int64, raising an overflow error if the value exceeds Int64 range.
  def to_i64 : Int64
    to_i64? || raise "BigInt overflow: #{self} does not fit in Int64"
  end

  # Converts to Int32 if the value fits, or nil if it overflows.
  def to_i32? : Int32?
    return 0 if zero?
    return nil if @limbs.size > 1

    val = @limbs[0]
    if @sign > 0
      return nil if val > 0x7FFFFFFF_u64
      val.to_i32
    else
      return nil if val > 0x80000000_u64
      return -2147483648 if val == 0x80000000_u64
      0 - val.to_i32
    end
  end

  # Converts to Int32, raising an overflow error if the value exceeds Int32 range.
  def to_i32 : Int32
    to_i32? || raise "BigInt overflow: #{self} does not fit in Int32"
  end

  def to_i : Int32
    to_i32
  end

  def to_big : BigInt
    self
  end

  def to_big_d : BigDecimal
    BigDecimal.new(self, 0)
  end

  def to_big_r : BigRational
    BigRational.new(self, BigInt.one)
  end

  # FNV-1a over the sign and every limb, folded to 31 bits. Wrapping
  # multiplication (`&*`) is the point: a checked product would overflow on
  # the second limb, and a hash has to answer for any size.
  def hash : Int32
    h = 14695981039346656037_u64
    h = (h ^ (@sign + 1).to_u64) &* 1099511628211_u64
    i = 0
    while i < @limbs.size
      h = (h ^ @limbs[i]) &* 1099511628211_u64
      i = i + 1
    end
    ((h ^ h.unsafe_shr(32_u64)) & 0x7FFFFFFF_u64).to_i32
  end
end

impl Comparable for BigInt
  def <=>(other : self) : Int32
    if @sign != other.sign
      return @sign < other.sign ? -1 : 1
    end
    return 0 if @sign == 0
    c = cmp_abs(other)
    @sign > 0 ? c : -c
  end
end

impl Num for BigInt
  def self.zero : self
    BigInt.new(0, Array(UInt64).new)
  end

  def self.one : self
    arr = Array(UInt64).new(1)
    arr << 1_u64
    BigInt.new(1, arr)
  end

  def add(other : self) : self
    self + other
  end

  def mul(other : self) : self
    self * other
  end
end

impl Hashable for BigInt
  def hash_key : Int32
    hash
  end
end

# Arithmetic modulo an odd *m* in Montgomery form, for `pow_mod` and
# `pow_mod_secret`: a value x is held as x R mod m, R = 2^(64 n) for the n
# 64-bit words m takes, and a product's division by m becomes a division by
# R, which is a shift, after adding the multiple of m that clears the low
# words (q = t n' mod 2^64 a word, n' = -1/m mod 2^64). Words here are 64
# bits, not BigInt's 32-bit limbs: products are taken in `UInt128`, and a
# quarter as many of them make a product as 32-bit limbs would.
#
# Every value held is reduced, below m, and every operation answers one
# that is: what a product leaves is under 2m, and m is taken off by a mask,
# not a branch, so nothing here branches or indexes on a value. For
# `pow_mod_secret` the conversion constants are made the same way, by
# doubling and squaring; `pow_mod`, whose numbers are public, takes its
# base into Montgomery form by one division instead, (base << 64n) mod m,
# 4 us for a 2048-bit modulus. Making R^2 by squaring was over a third of
# checking an RSA signature: e = 65537 modulo 2048 bits took 36 us with it
# and takes 22 without, in a --release build.
#
# A mask is not enough on its own: LLVM saw that `0 - keep` is 0 or all
# ones, made the selection a branch and took it out of the loop, so the
# release build of the first version here copied t only when it kept t,
# and the table scan read only the entry it wanted. Every mask is xored
# with `@zero`, a zero read through an atomic load, which the optimiser
# cannot see the value of; the assembly of a --release build shows the and
# and the or in both loops, every time.
struct Montgomery
  @m : Array(UInt64)
  @n : Int32
  @inv : UInt64
  # n + 2 words, the product while it is reduced
  @t : Array(UInt64)
  # 2n words, a square before it is reduced
  @p : Array(UInt64)
  # R mod m, which is 1 in Montgomery form, and R^2 mod m, which takes a
  # value into it (made only for a secret exponent)
  @one : Array(UInt64)
  @r2 : Array(UInt64)
  # 0, read where it is needed by an atomic load (see above)
  @zero : Atomic(UInt64)
  @mod : BigInt
  @secret : Bool

  def initialize(@mod : BigInt, @secret : Bool)
    mod = @mod
    @m = Montgomery.words(mod.limbs, (mod.limbs.size + 1) >> 1)
    @n = @m.size
    @inv = Montgomery.negated_inverse(@m[0])
    @t = Array(UInt64).new(@n + 2, 0_u64)
    @p = Array(UInt64).new(2 * @n, 0_u64)
    @one = Array(UInt64).new(@n, 0_u64)
    @r2 = Array(UInt64).new(@n, 0_u64)
    @zero = Atomic(UInt64).new(0_u64)
    constants(Montgomery.bit_length(mod.limbs))
  end

  # BigInt's 32-bit limbs two to a word, *n* words.
  def self.words(limbs : Array(UInt64), n : Int32) : Array(UInt64)
    res = Array(UInt64).new(n, 0_u64)
    i = 0
    while i < limbs.size
      res[i >> 1] = res[i >> 1] | limbs[i].unsafe_shl(((i & 1) * 32).to_u64)
      i = i + 1
    end
    res
  end

  # The bits a BigInt's limbs take to write.
  def self.bit_length(limbs : Array(UInt64)) : Int32
    return 0 if limbs.empty?
    top = limbs.last
    bits = (limbs.size - 1) * 32
    while top > 0_u64
      top = top.unsafe_shr(1_u64)
      bits = bits + 1
    end
    bits
  end

  # Bit *i* of a BigInt's limbs, 0 past the top.
  def self.bit(limbs : Array(UInt64), i : Int32) : Int32
    return 0 if (i >> 5) >= limbs.size
    (limbs[i >> 5].unsafe_shr((i & 31).to_u64) & 1_u64).to_i32
  end

  # -1/m0 mod 2^64 by Newton's iteration: an odd m0 is its own inverse to
  # three bits, and each step doubles the bits that are right, so five
  # steps make 96.
  def self.negated_inverse(m0 : UInt64) : UInt64
    x = m0
    5.times { x = x &* (2_u64 &- m0 &* x) }
    0_u64 &- x
  end

  # The window for an exponent of *bits* bits: the sizes OpenSSL takes,
  # where one more bit of window costs more products to fill the table
  # than it saves in the exponent.
  def self.window(bits : Int32) : Int32
    return 6 if bits > 671
    return 5 if bits > 239
    return 4 if bits > 79
    return 3 if bits > 23
    1
  end

  # R mod m, and for a secret exponent R^2 mod m, for an m of *bits* bits.
  # 2^(bits - 1) is under m (an odd m is not a power of two), and doubling
  # it with a reduction each time reaches R = 2^(64 n). That is 2^0 in
  # Montgomery form; doubling on to 2^h R and squaring s times makes
  # 2^(h 2^s) R, which is R^2 when h 2^s = 64 n: s the trailing zero bits
  # of 64 n, h its odd part.
  private def constants(bits : Int32) : Nil
    n = @n
    x = @one.to_unsafe
    x[(bits - 1) >> 6] = 1_u64.unsafe_shl(((bits - 1) & 63).to_u64)
    (64 * n - bits + 1).times { double(x) }
    return unless @secret
    s = 6
    h = n
    while (h & 1) == 0
      h = h >> 1
      s = s + 1
    end
    r = @r2.to_unsafe
    i = 0
    while i < n
      r[i] = x[i]
      i = i + 1
    end
    h.times { double(r) }
    s.times { sqr(r, r) }
  end

  # x = 2x mod m, in place.
  private def double(x : Pointer(UInt64)) : Nil
    n = @n
    t = @t.to_unsafe
    carry = 0_u64
    i = 0
    while i < n
      t[i] = x[i].unsafe_shl(1_u64) | carry
      carry = x[i].unsafe_shr(63_u64)
      i = i + 1
    end
    reduce(t, carry, x)
  end

  # r = t - m if t, with *top* the word over its n, is at least m, else t:
  # the difference is always taken and one of the two kept by a mask. t is
  # under 2m, so top - borrow is 0 (keep the difference) or -1 (keep t),
  # and its high word is the mask. r is not t.
  private def reduce(t : Pointer(UInt64), top : UInt64, r : Pointer(UInt64)) : Nil
    n = @n
    m = @m.to_unsafe
    borrow = 0_u64
    j = 0
    while j < n
      w = t[j].to_u128 &- m[j].to_u128 &- borrow.to_u128
      r[j] = w.unsafe_to_u64
      borrow = w.unsafe_shr(127).unsafe_to_u64
      j = j + 1
    end
    below = (top.to_u128 &- borrow.to_u128).unsafe_shr(64).unsafe_to_u64 ^ @zero.get
    j = 0
    while j < n
      r[j] = (t[j] & below) | (r[j] & ~below)
      j = j + 1
    end
  end

  # r = a b / R mod m by coarsely integrated operand scanning (CIOS): n
  # rounds of a times one word of b and one word's reduction, the two in
  # one pass over t (q comes from t's low word and a's first product, so
  # it is known before the pass), where two passes read and wrote t twice.
  # r may be a or b: it is written once both have been read.
  def mul(a : Pointer(UInt64), b : Pointer(UInt64), r : Pointer(UInt64)) : Nil
    n = @n
    m = @m.to_unsafe
    t = @t.to_unsafe
    inv = @inv
    k = 0
    while k < n + 1
      t[k] = 0_u64
      k = k + 1
    end
    i = 0
    while i < n
      bi = b[i].to_u128
      w = a[0].to_u128 &* bi &+ t[0].to_u128
      c = w.unsafe_shr(64)
      low = w.unsafe_to_u64
      q = (low &* inv).to_u128
      d = (q &* m[0].to_u128 &+ low.to_u128).unsafe_shr(64)
      j = 1
      while j < n
        w = a[j].to_u128 &* bi &+ t[j].to_u128 &+ c
        c = w.unsafe_shr(64)
        v = q &* m[j].to_u128 &+ w.unsafe_to_u64.to_u128 &+ d
        d = v.unsafe_shr(64)
        t[j - 1] = v.unsafe_to_u64
        j = j + 1
      end
      w = t[n].to_u128 &+ c &+ d
      t[n - 1] = w.unsafe_to_u64
      t[n] = w.unsafe_shr(64).unsafe_to_u64
      i = i + 1
    end
    reduce(t, t[n], r)
  end

  # r = a^2 / R mod m: the square first, each product off the diagonal
  # taken once and doubled, then reduced a word at a time (separated
  # operand scanning). A square is most of what an exponentiation does,
  # and this one takes n(n - 1)/2 + n products where `mul` takes n^2,
  # before the n^2 of its reduction. r may be a.
  def sqr(a : Pointer(UInt64), r : Pointer(UInt64)) : Nil
    n = @n
    m = @m.to_unsafe
    p = @p.to_unsafe
    inv = @inv
    k = 0
    while k < 2 * n
      p[k] = 0_u64
      k = k + 1
    end
    i = 0
    while i < n - 1
      ai = a[i].to_u128
      row = p + i.to_i64
      c = 0_u128
      j = i + 1
      while j < n
        w = ai &* a[j].to_u128 &+ row[j].to_u128 &+ c
        row[j] = w.unsafe_to_u64
        c = w.unsafe_shr(64)
        j = j + 1
      end
      row[n] = c.unsafe_to_u64
      i = i + 1
    end
    # Doubled, and the diagonal added: a^2 < 2^(128 n), so nothing carries
    # out of the top word.
    shifted = 0_u64
    c = 0_u128
    i = 0
    while i < n
      low = p[2 * i]
      high = p[2 * i + 1]
      square = a[i].to_u128 &* a[i].to_u128
      w = (low.unsafe_shl(1_u64) | shifted).to_u128 &+ square.unsafe_to_u64.to_u128 &+ c
      p[2 * i] = w.unsafe_to_u64
      c = w.unsafe_shr(64)
      w = (high.unsafe_shl(1_u64) | low.unsafe_shr(63_u64)).to_u128 &+ square.unsafe_shr(64) &+ c
      p[2 * i + 1] = w.unsafe_to_u64
      c = w.unsafe_shr(64)
      shifted = high.unsafe_shr(63_u64)
      i = i + 1
    end
    # Word i cleared by q m 2^(64 i); what carries out past word i + n is
    # held over and added where the next round's carry lands.
    extra = 0_u64
    i = 0
    while i < n
      row = p + i.to_i64
      q = (row[0] &* inv).to_u128
      c = 0_u128
      j = 0
      while j < n
        w = q &* m[j].to_u128 &+ row[j].to_u128 &+ c
        row[j] = w.unsafe_to_u64
        c = w.unsafe_shr(64)
        j = j + 1
      end
      w = row[n].to_u128 &+ c &+ extra.to_u128
      row[n] = w.unsafe_to_u64
      extra = w.unsafe_shr(64).unsafe_to_u64
      i = i + 1
    end
    reduce(p + n.to_i64, extra, r)
  end

  # *base*, below m, into Montgomery form at *r*.
  private def enter(base : BigInt, r : Pointer(UInt64)) : Nil
    if @secret
      x = Montgomery.words(base.limbs, @n)
      mul(x.to_unsafe, @r2.to_unsafe, r)
    else
      x = Montgomery.words(((base << (64 * @n)) % @mod).limbs, @n)
      i = 0
      while i < @n
        r[i] = x[i]
        i = i + 1
      end
    end
  end

  # The value at *a* out of Montgomery form, as a BigInt: a times 1 / R.
  private def leave(a : Pointer(UInt64)) : BigInt
    n = @n
    one = Array(UInt64).new(n, 0_u64)
    one[0] = 1_u64
    out = Array(UInt64).new(n, 0_u64)
    o = out.to_unsafe
    mul(a, one.to_unsafe, o)
    limbs = Array(UInt64).new(2 * n, 0_u64)
    i = 0
    while i < n
      limbs[2 * i] = o[i] & 0xFFFFFFFF_u64
      limbs[2 * i + 1] = o[i].unsafe_shr(32_u64)
      i = i + 1
    end
    BigInt.new(1, limbs)
  end

  # base^exp mod m, base below m, by a sliding window, left to right: the
  # table holds the odd powers g, g^3, ... g^(2^k - 1), a run of zero bits
  # costs a square each, and a window of up to k bits that starts and ends
  # on a one costs its squares and one product.
  def pow(base : BigInt, exp : BigInt) : BigInt
    n = @n
    bits = Montgomery.bit_length(exp.limbs)
    return leave(@one.to_unsafe) if bits == 0
    k = Montgomery.window(bits)
    size = 1 << (k - 1)
    table = Array(UInt64).new(size * n, 0_u64)
    tp = table.to_unsafe
    enter(base, tp)
    if size > 1
      g2 = Array(UInt64).new(n, 0_u64)
      sqr(tp, g2.to_unsafe)
      i = 1
      while i < size
        mul(tp + ((i - 1) * n).to_i64, g2.to_unsafe, tp + (i * n).to_i64)
        i = i + 1
      end
    end
    acc = Array(UInt64).new(n, 0_u64)
    ap = acc.to_unsafe
    limbs = exp.limbs
    started = false
    i = bits - 1
    while i >= 0
      if Montgomery.bit(limbs, i) == 0
        sqr(ap, ap)
        i = i - 1
      else
        low = i - k + 1
        low = 0 if low < 0
        while Montgomery.bit(limbs, low) == 0
          low = low + 1
        end
        value = 0
        j = i
        while j >= low
          value = value * 2 + Montgomery.bit(limbs, j)
          j = j - 1
        end
        entry = tp + ((value >> 1) * n).to_i64
        if started
          (i - low + 1).times { sqr(ap, ap) }
          mul(ap, entry, ap)
        else
          j = 0
          while j < n
            ap[j] = entry[j]
            j = j + 1
          end
          started = true
        end
        i = low - 1
      end
    end
    leave(ap)
  end

  # base^exp mod m, base below m, by a fixed window of k bits over *width*
  # bits of exponent, with nothing taken from the exponent's bits but a
  # mask: the table holds g^0 (R mod m) through g^(2^k - 1), every window
  # costs k squares and one product, the product with g^0 included, and
  # every entry of the table is read for every window. The window is at
  # most 5 bits, not `window`'s 6: every entry is read for every window,
  # so a 64-entry table costs more scanning than the products it saves.
  # With the one-pass product, a 2048-bit PSS signature went from 1,077 to
  # 1,013 us (best of eight, --release, a machine other jobs shared).
  def pow_fixed(base : BigInt, exp : BigInt, width : Int32) : BigInt
    n = @n
    k = Montgomery.window(width)
    k = 5 if k > 5
    size = 1 << k
    table = Array(UInt64).new(size * n, 0_u64)
    tp = table.to_unsafe
    one = @one.to_unsafe
    j = 0
    while j < n
      tp[j] = one[j]
      j = j + 1
    end
    enter(base, tp + n.to_i64)
    i = 2
    while i < size
      mul(tp + ((i - 1) * n).to_i64, tp + n.to_i64, tp + (i * n).to_i64)
      i = i + 1
    end
    acc = Array(UInt64).new(n, 0_u64)
    ap = acc.to_unsafe
    j = 0
    while j < n
      ap[j] = one[j]
      j = j + 1
    end
    chosen = Array(UInt64).new(n, 0_u64)
    cp = chosen.to_unsafe
    limbs = exp.limbs
    zero = @zero.get
    w = (width + k - 1) // k - 1
    while w >= 0
      k.times { sqr(ap, ap) }
      value = 0_u64
      b = k - 1
      while b >= 0
        value = value.unsafe_shl(1_u64) | Montgomery.bit(limbs, w * k + b).to_u64
        b = b - 1
      end
      j = 0
      while j < n
        cp[j] = 0_u64
        j = j + 1
      end
      e = 0
      while e < size
        d = e.to_u64 ^ value
        mask = ((d | (0_u64 &- d)).unsafe_shr(63_u64) &- 1_u64) ^ zero
        entry = tp + (e * n).to_i64
        j = 0
        while j < n
          cp[j] = cp[j] | (entry[j] & mask)
          j = j + 1
        end
        e = e + 1
      end
      mul(ap, cp, ap)
      w = w - 1
    end
    leave(ap)
  end
end

pub struct BigDecimal
  getter value : BigInt
  getter scale : Int32

  def initialize(@value : BigInt, @scale : Int32 = 0)
  end

  def initialize(num : Int32 = 0, scale : Int32 = 0)
    @value = BigInt.new(num.to_i64)
    @scale = scale
  end

  def initialize(num : Int64, scale : Int32 = 0)
    @value = BigInt.new(num)
    @scale = scale
  end

  # Parses `[+-]digits[.digits][e[+-]digits]`; anything else is refused.
  def initialize(str : String)
    raise "not a decimal: \"#{str}\"" if str.empty?
    negative = false
    idx = 0
    len = str.bytesize
    ptr = str.to_unsafe

    if ptr[0] == 45_u8 # '-'
      negative = true
      idx = 1
    elsif ptr[0] == 43_u8 # '+'
      idx = 1
    end

    digits = [] of Char
    decimal_point = -1
    exp = 0
    exp_negative = false
    has_exp = false

    while idx < len
      byte = ptr[idx]
      if byte == 46_u8 # '.'
        raise "not a decimal: \"#{str}\"" if decimal_point >= 0 || has_exp
        decimal_point = digits.size
      elsif byte == 101_u8 || byte == 69_u8 # 'e' or 'E'
        has_exp = true
        idx = idx + 1
        if idx < len && ptr[idx] == 45_u8 # '-'
          exp_negative = true
          idx = idx + 1
        elsif idx < len && ptr[idx] == 43_u8 # '+'
          idx = idx + 1
        end
        exp_digits = 0
        exp_start = idx
        while idx < len
          eb = ptr[idx]
          if eb >= 48_u8 && eb <= 57_u8
            # The scale is an Int32: an exponent of ten digits had panicked
            # "arithmetic overflow" here or in the scale below.
            raise "decimal exponent out of range: \"#{str}\"" if exp_digits >= 100_000_000
            exp_digits = exp_digits * 10 + (eb - 48_u8).to_i32
          else
            raise "not a decimal: \"#{str}\""
          end
          idx = idx + 1
        end
        raise "not a decimal: \"#{str}\"" if idx == exp_start
        exp = exp_negative ? -exp_digits : exp_digits
        break
      elsif byte >= 48_u8 && byte <= 57_u8
        digits << byte.to_i32.chr
      else
        raise "not a decimal: \"#{str}\""
      end
      idx = idx + 1
    end

    raise "not a decimal: \"#{str}\"" if digits.empty?

    digit_str = digits.join("")
    frac_len = decimal_point >= 0 ? (digits.size - decimal_point) : 0
    final_scale = frac_len - exp

    val = BigInt.new(digit_str)
    @value = negative ? -val : val
    @scale = final_scale
  end

  # Fractional digits `/` keeps when the quotient is not exact.
  DIVISION_PRECISION = 20

  def zero? : Bool
    @value.zero?
  end

  def positive? : Bool
    @value.positive?
  end

  def negative? : Bool
    @value.negative?
  end

  def abs : BigDecimal
    BigDecimal.new(@value.abs, @scale)
  end

  def negate : BigDecimal
    BigDecimal.new(-@value, @scale)
  end

  def - : BigDecimal
    negate
  end

  def + : BigDecimal
    self
  end

  protected def self.align(a : BigDecimal, b : BigDecimal) : Tuple(BigInt, BigInt, Int32)
    if a.scale == b.scale
      {a.value, b.value, a.scale}
    elsif a.scale > b.scale
      diff = a.scale - b.scale
      factor = BigInt.new(10_i64) ** diff
      {a.value, b.value * factor, a.scale}
    else
      diff = b.scale - a.scale
      factor = BigInt.new(10_i64) ** diff
      {a.value * factor, b.value, b.scale}
    end
  end

  def +(other : BigDecimal) : BigDecimal
    tup = BigDecimal.align(self, other)
    BigDecimal.new(tup[0] + tup[1], tup[2])
  end

  def +(other : Int32 | Int64) : BigDecimal
    self + BigDecimal.new(other)
  end

  def -(other : BigDecimal) : BigDecimal
    tup = BigDecimal.align(self, other)
    BigDecimal.new(tup[0] - tup[1], tup[2])
  end

  def -(other : Int32 | Int64) : BigDecimal
    self - BigDecimal.new(other)
  end

  def *(other : BigDecimal) : BigDecimal
    BigDecimal.new(@value * other.value, @scale + other.scale)
  end

  def *(other : Int32 | Int64) : BigDecimal
    self * BigDecimal.new(other)
  end

  # `self / other` rounded to `precision` fractional digits, half away from
  # zero. A quotient that is exact within `precision` digits is answered with
  # the fewest digits that write it: `1/4` is `0.25`, `6/3` is `2`. One that
  # is not keeps all `precision` digits, so the reader sees where it was cut.
  def div(other : BigDecimal, precision : Int32) : BigDecimal
    raise "division by zero" if other.zero?
    raise "negative precision: #{precision}" if precision < 0
    return BigDecimal.zero if zero?
    # self / other = (@value / other.value) * 10^(other.scale - @scale);
    # scale that by 10^precision and divide as integers.
    shift = other.scale - @scale + precision
    num = @value
    den = other.value
    if shift >= 0
      num = num * (BigInt.new(10_i64) ** shift)
    else
      den = den * (BigInt.new(10_i64) ** (-shift))
    end
    qr = num.divmod(den)
    q = qr[0]
    r = qr[1]
    return BigDecimal.new(q, precision).normalized if r.zero?
    if ((r.abs * 2) <=> den.abs) >= 0
      q = @value.sign == other.value.sign ? q + 1 : q - 1
    end
    BigDecimal.new(q, precision)
  end

  def /(other : BigDecimal) : BigDecimal
    div(other, DIVISION_PRECISION)
  end

  def /(other : Int32 | Int64) : BigDecimal
    div(BigDecimal.new(other), DIVISION_PRECISION)
  end

  def //(other : BigDecimal) : BigDecimal
    raise "division by zero" if other.zero?
    tup = BigDecimal.align(self, other)
    BigDecimal.new(tup[0] // tup[1], 0)
  end

  def %(other : BigDecimal) : BigDecimal
    raise "modulo by zero" if other.zero?
    tup = BigDecimal.align(self, other)
    BigDecimal.new(tup[0] % tup[1], tup[2])
  end

  # The same value with the smallest non-negative scale: trailing zeros of
  # the fraction are dropped and a negative scale is multiplied out.
  def normalized : BigDecimal
    return BigDecimal.zero if zero?
    if @scale < 0
      return BigDecimal.new(@value * (BigInt.new(10_i64) ** (-@scale)), 0)
    end
    stripped = strip_zeros(@scale)
    BigDecimal.new(stripped[0], @scale - stripped[1])
  end

  # The value without its trailing zeros, at most `limit` of them, and how
  # many went. Counted once in the digits and divided out once: one divmod
  # by ten per zero was quadratic, and the hash of `1.` and 40,000 zeros, or
  # `3.div(3, 40000)`, took 725 ms. A value that does not end in zero is
  # answered by one division by ten, without printing it.
  protected def strip_zeros(limit : Int32) : Tuple(BigInt, Int32)
    return {@value, 0} if limit <= 0 || !(@value % BigInt.new(10_i64)).zero?
    digits = @value.abs.to_s
    bytes = digits.to_unsafe
    last = digits.bytesize - 1
    count = 0
    while count < limit && count < last && bytes[last - count] == 48_u8
      count = count + 1
    end
    return {@value, 0} if count == 0
    {@value // (BigInt.new(10_i64) ** count), count}
  end

  def !=(other : BigDecimal) : Bool
    (self <=> other) != 0
  end

  # Zero is `0` whatever its scale; every other value prints every digit of
  # its scale, so `1.10` stays `1.10`.
  def to_s : String
    return "0" if @value.zero?
    v_str = @value.abs.to_s
    prefix = negative? ? "-" : ""

    # The zeros in one string each: a string grown by one per zero copied
    # it per zero, and `1e50000` took 2.9 s to print where the same value
    # as a BigInt took 57 ms.
    if @scale <= 0
      zeros = "0" * -@scale
      prefix + v_str + zeros
    elsif v_str.size <= @scale
      leading_zeros = "0" * (@scale - v_str.size)
      prefix + "0." + leading_zeros + v_str
    else
      split_pos = v_str.size - @scale
      int_part = v_str[0, split_pos]
      frac_part = v_str[split_pos, @scale]
      prefix + int_part + "." + frac_part
    end
  end

  def inspect : String
    to_s
  end

  def to_big_d : BigDecimal
    self
  end

  def to_big_i : BigInt
    @scale <= 0 ? @value * (BigInt.new(10_i64) ** (-@scale)) : @value // (BigInt.new(10_i64) ** @scale)
  end

  def to_f64 : Float64
    to_s.to_f
  end

  def to_f : Float64
    to_f64
  end

  def to_i64 : Int64
    to_big_i.to_i64
  end

  def to_i32 : Int32
    to_big_i.to_i32
  end

  # Bounds on the place of the leading digit, from the limb count alone:
  # 10^(lo - 1) <= |self| < 10^hi. 30102 and 30103 in 100,000 bracket
  # log10(2) for each 32-bit limb.
  protected def magnitude_bounds : Tuple(Int64, Int64)
    limbs = @value.limbs.size.to_i64
    lo = (32_i64 * (limbs - 1_i64) * 30102_i64) // 100000_i64 + 1_i64 - @scale.to_i64
    hi = (32_i64 * limbs * 30103_i64) // 100000_i64 + 1_i64 - @scale.to_i64
    {lo, hi}
  end

  # The same value at another scale is the same key: `1.10`, `1.1` and
  # `11e-1` hash alike because `==` says they are equal. The digits without
  # their trailing zeros and the exponent that goes with them name the value;
  # multiplying a negative scale out made `1e1000000.hash` take 2.6 s.
  def hash : Int32
    return BigInt.zero.hash if zero?
    stripped = strip_zeros(2147483647)
    stripped[0].hash &* 31 &+ (@scale &- stripped[1])
  end
end

impl Comparable for BigDecimal
  def <=>(other : self) : Int32
    if @value.sign != other.value.sign
      return @value.sign < other.value.sign ? -1 : 1
    end
    return 0 if zero?
    # Values whose leading digits sit apart are ordered before aligning:
    # aligning first built 10^1000000, and `1e-1000000 < 1` and
    # `1e1000000 == 1` took 2.4 s each. Bounds that overlap keep the scales
    # within the digit counts.
    mine = magnitude_bounds
    theirs = other.magnitude_bounds
    return -@value.sign if mine[1] < theirs[0]
    return @value.sign if theirs[1] < mine[0]
    tup = BigDecimal.align(self, other)
    (tup[0] <=> tup[1])
  end
end

impl Num for BigDecimal
  def self.zero : self
    BigDecimal.new(BigInt.zero, 0)
  end

  def self.one : self
    BigDecimal.new(BigInt.one, 0)
  end

  def add(other : self) : self
    self + other
  end

  def mul(other : self) : self
    self * other
  end
end

impl Hashable for BigDecimal
  def hash_key : Int32
    hash
  end
end

pub struct BigRational
  getter numerator : BigInt
  getter denominator : BigInt

  def initialize(numerator : BigInt, denominator : BigInt)
    raise "division by zero" if denominator.zero?
    if denominator.negative?
      numerator = -numerator
      denominator = -denominator
    end
    if numerator.zero?
      @numerator = BigInt.zero
      @denominator = BigInt.one
    else
      g = numerator.abs.gcd(denominator)
      @numerator = numerator // g
      @denominator = denominator // g
    end
  end

  def initialize(num : Int64 = 0_i64, den : Int64 = 1_i64)
    initialize(BigInt.new(num), BigInt.new(den))
  end

  def initialize(num : Int32, den : Int32 = 1)
    initialize(BigInt.new(num.to_i64), BigInt.new(den.to_i64))
  end

  def initialize(str : String)
    slash_idx = str.index('/')
    if slash_idx
      n_str = str[0, slash_idx]
      d_str = str[slash_idx + 1, str.bytesize - slash_idx - 1]
      initialize(BigInt.new(n_str), BigInt.new(d_str))
    else
      initialize(BigInt.new(str), BigInt.one)
    end
  end

  def zero? : Bool
    @numerator.zero?
  end

  def positive? : Bool
    @numerator.positive?
  end

  def negative? : Bool
    @numerator.negative?
  end

  def abs : BigRational
    BigRational.new(@numerator.abs, @denominator)
  end

  def negate : BigRational
    BigRational.new(-@numerator, @denominator)
  end

  def - : BigRational
    negate
  end

  def + : BigRational
    self
  end

  def inv : BigRational
    raise "division by zero" if @numerator.zero?
    BigRational.new(@denominator, @numerator)
  end

  def +(other : BigRational) : BigRational
    BigRational.new(@numerator * other.denominator + other.numerator * @denominator, @denominator * other.denominator)
  end

  def +(other : Int32 | Int64 | BigInt) : BigRational
    self + BigRational.new(other.to_big_i, BigInt.one)
  end

  def -(other : BigRational) : BigRational
    BigRational.new(@numerator * other.denominator - other.numerator * @denominator, @denominator * other.denominator)
  end

  def -(other : Int32 | Int64 | BigInt) : BigRational
    self - BigRational.new(other.to_big_i, BigInt.one)
  end

  def *(other : BigRational) : BigRational
    BigRational.new(@numerator * other.numerator, @denominator * other.denominator)
  end

  def *(other : Int32 | Int64 | BigInt) : BigRational
    self * BigRational.new(other.to_big_i, BigInt.one)
  end

  def /(other : BigRational) : BigRational
    raise "division by zero" if other.zero?
    BigRational.new(@numerator * other.denominator, @denominator * other.numerator)
  end

  def /(other : Int32 | Int64 | BigInt) : BigRational
    self / BigRational.new(other.to_big_i, BigInt.one)
  end

  def **(exp : Int32) : BigRational
    if exp == 0
      BigRational.one
    elsif exp > 0
      BigRational.new(@numerator ** exp, @denominator ** exp)
    else
      BigRational.new(@denominator ** (-exp), @numerator ** (-exp))
    end
  end

  def !=(other : BigRational) : Bool
    (self <=> other) != 0
  end

  def to_s : String
    @denominator == 1_i64 ? @numerator.to_s : "#{@numerator}/#{@denominator}"
  end

  def inspect : String
    to_s
  end

  def to_big_r : BigRational
    self
  end

  def to_big_i : BigInt
    @numerator // @denominator
  end

  def to_big_d : BigDecimal
    BigDecimal.new(@numerator) / BigDecimal.new(@denominator)
  end

  # The Float64 nearest this value, ties to even, as python's
  # `float(Fraction)` answers. This had gone through `to_big_d`, twenty
  # fractional digits: every value under 5e-21 was 0.0 and every one under
  # 1e-3 lost significant digits. The quotient is taken to 55 or 56 bits -
  # 55 at the smallest exponent, where the subnormals start - with a sticky
  # low bit for a nonzero remainder, rounded to the bits a Float64 keeps (53,
  # fewer as a subnormal), and scaled by the power of two it was shifted by,
  # which is exact: a value past the largest Float64 is Infinity.
  def to_f64 : Float64
    return 0.0 if zero?
    a = @numerator.abs
    b = @denominator
    diff = BigInt.bit_length(a) - BigInt.bit_length(b)
    shift = (diff > -1021 ? diff : -1021) - 55
    qr = shift >= 0 ? a.divmod(b << shift) : (a << (0 - shift)).divmod(b)
    q = qr[0].to_i64
    q = q | 1_i64 unless qr[1].zero?
    bits = 0
    while (q >> bits) > 0_i64
      bits = bits + 1
    end
    # The bits below the kept ones: 2 or 3 for a normal value, 2 for a
    # subnormal, whose last bit stands for 2^-1074 where q's stands for 2^-1076.
    extra = (bits > -1021 - shift ? bits : -1021 - shift) - 53
    half = 1_i64 << (extra - 1)
    q = q + half if (q & half) != 0_i64 && (q & (3_i64 * half - 1_i64)) != 0_i64
    q = q - (q & (2_i64 * half - 1_i64))
    f = q.to_f64
    e = shift
    while e != 0
      step = e > 1000 ? 1000 : (e < -1000 ? -1000 : e)
      f = f * (2.0 ** step)
      e = e - step
    end
    negative? ? f * -1.0 : f
  end

  # A rational is stored reduced, so equal values have equal parts.
  def hash : Int32
    @numerator.hash &* 31 &+ @denominator.hash
  end
end

impl Comparable for BigRational
  def <=>(other : self) : Int32
    ((@numerator * other.denominator) <=> other.numerator * @denominator)
  end
end

impl Num for BigRational
  def self.zero : self
    BigRational.new(BigInt.zero, BigInt.one)
  end

  def self.one : self
    BigRational.new(BigInt.one, BigInt.one)
  end

  def add(other : self) : self
    self + other
  end

  def mul(other : self) : self
    self * other
  end
end

impl Hashable for BigRational
  def hash_key : Int32
    hash
  end
end

# A binary floating-point number of any precision: `±mantissa · 2^exponent`,
# the mantissa exactly *precision* bits long (128 unless asked), every
# result rounded once, to the nearest value of that many bits, ties to even
# - the rounding IEEE 754 gives a double, at any width. The other library's
# BigFloat is GMP's `mpf`, which truncates and keeps more bits than it was
# asked for; this one answers what MPFR does.
#
#     a = BigFloat.new(2, 256)
#     a.sqrt.to_s
#     # => "1.4142135623730950488016887242096980785696718753769480731766797379907324784621"
#     BigFloat.new("0.1", 24).to_f64   # => 0.10000000149011612
#
# An operation between two answers at the larger precision; with an
# integer, at the BigFloat's. `to_s` writes the fewest decimal digits that
# read back to the same value at its precision, positional from 1e-4 to
# below 1e15 and with an exponent outside, as `Float64#to_s` writes. There
# is no NaN or infinity: dividing by zero, the square root of a negative
# number, a NaN or an infinite double, a precision under 1 and a string
# that is no number are refused.
pub struct BigFloat
  DEFAULT_PRECISION = 128

  getter precision : Int32
  @negative : Bool
  # 0, or exactly *precision* bits.
  @mantissa : BigInt
  @exponent : Int64

  protected def initialize(@negative : Bool, @mantissa : BigInt, @exponent : Int64, @precision : Int32)
  end

  def self.new(value : Int32, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    new(BigInt.new(value.to_i64), precision)
  end

  def self.new(value : Int64, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    new(BigInt.new(value), precision)
  end

  def self.new(value : BigInt, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    rounded(value.negative?, value.abs, BigInt.one, 0_i64, precision)
  end

  # The double's exact value, rounded to *precision* bits.
  def self.new(value : Float64, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    holder = Pointer(Float64).malloc(1_u64)
    holder.value = value
    bits = Pointer(UInt64).new(holder.address).value
    exponent_bits = bits.unsafe_shr(52_u64) & 2047_u64
    fraction = bits & 4503599627370495_u64
    raise "BigFloat: #{value} is not a finite number" if exponent_bits == 2047_u64
    f = exponent_bits == 0_u64 ? fraction : fraction | 4503599627370496_u64
    e = exponent_bits == 0_u64 ? -1074_i64 : exponent_bits.to_i64 - 1075_i64
    rounded(bits.unsafe_shr(63_u64) != 0_u64, BigInt.new(f.to_i64), BigInt.one, e, precision)
  end

  def self.new(value : BigRational, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    rounded(value.numerator.negative?, value.numerator.abs, value.denominator, 0_i64, precision)
  end

  def self.new(value : BigDecimal, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    if value.scale >= 0
      rounded(value.value.negative?, value.value.abs, BigInt.new(10_i64) ** value.scale, 0_i64, precision)
    else
      rounded(value.value.negative?, value.value.abs * (BigInt.new(10_i64) ** (0 - value.scale)), BigInt.one, 0_i64, precision)
    end
  end

  # A decimal - `-12.5`, `1e-30`, `6.02214076E23` - rounded to *precision*
  # bits; anything else is refused.
  def self.new(text : String, precision : Int32 = DEFAULT_PRECISION) : BigFloat
    parse?(text, precision) || raise "BigFloat: not a number: #{text.inspect}"
  end

  # As `new`, nil for a string that is no number.
  def self.parse?(text : String, precision : Int32 = DEFAULT_PRECISION) : BigFloat?
    check(precision)
    bytes = text.to_unsafe
    size = text.bytesize
    at = 0
    negative = false
    if at < size && (bytes[at] == 45_u8 || bytes[at] == 43_u8)
      negative = bytes[at] == 45_u8
      at = at + 1
    end
    digits = BigInt.zero
    seen = 0
    scale = 0_i64
    while at < size && bytes[at] >= 48_u8 && bytes[at] <= 57_u8
      digits = digits * 10 + (bytes[at] - 48_u8).to_i32
      seen = seen + 1
      at = at + 1
    end
    if at < size && bytes[at] == 46_u8
      at = at + 1
      while at < size && bytes[at] >= 48_u8 && bytes[at] <= 57_u8
        digits = digits * 10 + (bytes[at] - 48_u8).to_i32
        scale = scale - 1_i64
        seen = seen + 1
        at = at + 1
      end
    end
    return nil if seen == 0
    if at < size && (bytes[at] == 101_u8 || bytes[at] == 69_u8)
      at = at + 1
      down = false
      if at < size && (bytes[at] == 45_u8 || bytes[at] == 43_u8)
        down = bytes[at] == 45_u8
        at = at + 1
      end
      power = 0_i64
      exponent_digits = 0
      while at < size && bytes[at] >= 48_u8 && bytes[at] <= 57_u8
        power = power * 10_i64 + (bytes[at] - 48_u8).to_i64
        return nil if power > 100_000_000_i64
        exponent_digits = exponent_digits + 1
        at = at + 1
      end
      return nil if exponent_digits == 0
      scale = scale + (down ? 0_i64 - power : power)
    end
    return nil if at != size
    if scale >= 0_i64
      rounded(negative, digits * (BigInt.new(10_i64) ** scale.to_i32), BigInt.one, 0_i64, precision)
    else
      rounded(negative, digits, BigInt.new(10_i64) ** (0_i64 - scale).to_i32, 0_i64, precision)
    end
  end

  # *num*/*den* · 2^*shift* (both non-negative, *den* not zero), rounded to
  # *precision* bits, ties to even: every value here is made by this, from
  # an exact one.
  protected def self.rounded(negative : Bool, num : BigInt, den : BigInt, shift : Int64, precision : Int32) : BigFloat
    check(precision)
    return new(false, BigInt.zero, 0_i64, precision) if num.zero?
    # num/den lies in [2^(gap - 1), 2^(gap + 1)), so its quotient by 2^k
    # has precision or precision + 1 bits; one too many moves k up.
    k = (BigInt.bit_length(num) - BigInt.bit_length(den) - precision).to_i64
    while true
      # The remainder is of the divisor actually used, which is den
      # scaled up when k is not negative.
      divisor = k >= 0_i64 ? den << k.to_i32 : den
      q, r = k >= 0_i64 ? num.divmod(divisor) : (num << (0_i64 - k).to_i32).divmod(divisor)
      if BigInt.bit_length(q) > precision
        k = k + 1_i64
        next
      end
      twice = (r << 1) <=> divisor
      q = q + BigInt.one if twice > 0 || (twice == 0 && q.odd?)
      if BigInt.bit_length(q) > precision
        q = q >> 1
        k = k + 1_i64
      end
      return new(negative, q, k + shift, precision)
    end
  end

  protected def self.check(precision : Int32) : Nil
    raise "BigFloat: a precision of #{precision} bits; it is at least 1" if precision < 1
  end

  def zero? : Bool
    @mantissa.zero?
  end

  def negative? : Bool
    @negative
  end

  def positive? : Bool
    !@negative && !zero?
  end

  protected def mantissa : BigInt
    @mantissa
  end

  protected def exponent : Int64
    @exponent
  end

  # The place above the leading bit: 2^(top - 1) <= |self| < 2^top.
  protected def top : Int64
    @exponent + BigInt.bit_length(@mantissa).to_i64
  end

  # This value at another precision, rounded if it is fewer bits.
  def with_precision(bits : Int32) : BigFloat
    BigFloat.rounded(@negative, @mantissa, BigInt.one, @exponent, bits)
  end

  def - : BigFloat
    BigFloat.new(zero? ? false : !@negative, @mantissa, @exponent, @precision)
  end

  def + : BigFloat
    self
  end

  def abs : BigFloat
    @negative ? -self : self
  end

  def +(other : BigFloat) : BigFloat
    sum(other, @precision > other.precision ? @precision : other.precision)
  end

  def -(other : BigFloat) : BigFloat
    sum(-other, @precision > other.precision ? @precision : other.precision)
  end

  def *(other : BigFloat) : BigFloat
    BigFloat.rounded(@negative != other.negative?, @mantissa * other.mantissa, BigInt.one, @exponent + other.exponent, @precision > other.precision ? @precision : other.precision)
  end

  def /(other : BigFloat) : BigFloat
    raise "BigFloat: division by zero" if other.zero?
    BigFloat.rounded(@negative != other.negative?, @mantissa, other.mantissa, @exponent - other.exponent, @precision > other.precision ? @precision : other.precision)
  end

  def +(other : Int32 | Int64 | BigInt) : BigFloat
    sum(BigFloat.exactly(other), @precision)
  end

  def -(other : Int32 | Int64 | BigInt) : BigFloat
    sum(-BigFloat.exactly(other), @precision)
  end

  def *(other : Int32 | Int64 | BigInt) : BigFloat
    exact = BigFloat.exactly(other)
    BigFloat.rounded(@negative != exact.negative?, @mantissa * exact.mantissa, BigInt.one, @exponent + exact.exponent, @precision)
  end

  def /(other : Int32 | Int64 | BigInt) : BigFloat
    exact = BigFloat.exactly(other)
    raise "BigFloat: division by zero" if exact.zero?
    BigFloat.rounded(@negative != exact.negative?, @mantissa, exact.mantissa, @exponent - exact.exponent, @precision)
  end

  # An integer at exactly the bits it has.
  protected def self.exactly(value : Int32 | Int64 | BigInt) : BigFloat
    whole = value.is_a?(BigInt) ? value : BigInt.new(value.to_i64)
    bits = BigInt.bit_length(whole.abs)
    rounded(whole.negative?, whole.abs, BigInt.one, 0_i64, bits < 1 ? 1 : bits)
  end

  # The exact sum, rounded once. An addend more than *precision* + 2 bits
  # below the other cannot move it - it is under a quarter of the larger's
  # last place, even where that place halves below a power of two - and
  # is not shifted out to a size it would only be rounded away from.
  protected def sum(other : BigFloat, precision : Int32) : BigFloat
    return other.with_precision(precision) if zero?
    return with_precision(precision) if other.zero?
    gap = top - other.top
    return with_precision(precision) if gap > precision.to_i64 + 2_i64
    return other.with_precision(precision) if 0_i64 - gap > precision.to_i64 + 2_i64
    low = @exponent < other.exponent ? @exponent : other.exponent
    mine = @mantissa << (@exponent - low).to_i32
    theirs = other.mantissa << (other.exponent - low).to_i32
    total = (@negative ? -mine : mine) + (other.negative? ? -theirs : theirs)
    BigFloat.rounded(total.negative?, total.abs, BigInt.one, low, precision)
  end

  # The square root, rounded once. The mantissa is widened to at least
  # 2·precision + 4 bits over an even power of two, so the integer root
  # has two bits past the ones kept, and a root that is not exact carries a
  # half below its last bit into the rounding, which no tie can be.
  def sqrt : BigFloat
    raise "BigFloat: the square root of a negative number" if @negative
    return self if zero?
    widen = 2 * @precision + 4 - BigInt.bit_length(@mantissa)
    widen = 0 if widen < 0
    widen = widen + 1 if (@exponent - widen.to_i64) % 2_i64 != 0_i64
    square = @mantissa << widen
    root = BigFloat.isqrt(square)
    sticky = root * root == square ? BigInt.zero : BigInt.one
    BigFloat.rounded(false, (root << 1) + sticky, BigInt.new(2_i64), (@exponent - widen.to_i64) // 2_i64, @precision)
  end

  # The largest integer whose square is at most *value*, by Newton's
  # method from above.
  protected def self.isqrt(value : BigInt) : BigInt
    return value if value < BigInt.new(2_i64)
    x = BigInt.one << ((BigInt.bit_length(value) + 1) // 2)
    while true
      y = (x + value // x) >> 1
      return x if y >= x
      x = y
    end
  end

  # The power, its exact value rounded once; a negative exponent is the
  # reciprocal of the power, rounded once.
  def **(exponent : Int32) : BigFloat
    odd = exponent % 2 != 0
    if exponent < 0
      raise "BigFloat: division by zero" if zero?
      power = @mantissa ** (0 - exponent)
      return BigFloat.rounded(@negative && odd, BigInt.one, power, 0_i64 - @exponent * (0 - exponent).to_i64, @precision)
    end
    BigFloat.rounded(@negative && odd, @mantissa ** exponent, BigInt.one, @exponent * exponent.to_i64, @precision)
  end

  # The exact value as a fraction.
  def to_big_r : BigRational
    if @exponent >= 0_i64
      BigRational.new(signed(@mantissa << @exponent.to_i32), BigInt.one)
    else
      BigRational.new(signed(@mantissa), BigInt.one << (0_i64 - @exponent).to_i32)
    end
  end

  private def signed(value : BigInt) : BigInt
    @negative ? -value : value
  end

  # The double nearest, ties to even; past the largest double, infinite,
  # and below the smallest, zero.
  def to_f64 : Float64
    return 0.0 if @mantissa.zero?
    if top > 1025_i64
      infinity = Pointer(UInt64).malloc(1_u64)
      infinity.value = @negative ? 0xFFF0000000000000_u64 : 0x7FF0000000000000_u64
      return Pointer(Float64).new(infinity.address).value
    end
    return @negative ? -0.0 : 0.0 if top < -1080_i64
    to_big_r.to_f64
  end

  # Toward zero, floor, ceiling, and to the nearest integer, ties to even.
  def to_big_i : BigInt
    trunc_whole
  end

  def trunc : BigFloat
    whole = trunc_whole
    BigFloat.rounded(whole.negative?, whole.abs, BigInt.one, 0_i64, @precision)
  end

  def floor : BigFloat
    whole = trunc_whole
    whole = whole - BigInt.one if @negative && !exact_whole?
    BigFloat.rounded(whole.negative?, whole.abs, BigInt.one, 0_i64, @precision)
  end

  def ceil : BigFloat
    whole = trunc_whole
    whole = whole + BigInt.one if !@negative && !zero? && !exact_whole?
    BigFloat.rounded(whole.negative?, whole.abs, BigInt.one, 0_i64, @precision)
  end

  # Under one half is zero; from there the fraction is at most
  # *precision* bits, compared with one half exactly.
  def round : BigFloat
    return self if exact_whole?
    return BigFloat.rounded(false, BigInt.zero, BigInt.one, 0_i64, @precision) if top < 0_i64
    drop = (0_i64 - @exponent).to_i32
    whole = @mantissa >> drop
    rest = @mantissa - (whole << drop)
    against = rest <=> (BigInt.one << (drop - 1))
    whole = whole + BigInt.one if against > 0 || (against == 0 && whole.odd?)
    BigFloat.rounded(@negative && !whole.zero?, whole, BigInt.one, 0_i64, @precision)
  end

  protected def trunc_whole : BigInt
    return signed(@mantissa << @exponent.to_i32) if @exponent >= 0_i64
    return BigInt.zero if top <= 0_i64
    signed(@mantissa >> (0_i64 - @exponent).to_i32)
  end

  private def exact_whole? : Bool
    return true if @exponent >= 0_i64 || zero?
    return false if top <= 0_i64
    drop = (0_i64 - @exponent).to_i32
    (@mantissa >> drop) << drop == @mantissa
  end

  # The fewest decimal digits that read back as this value at its
  # precision, the nearest such when there are two; written as
  # `Float64#to_s` writes a double.
  def to_s : String
    return "0.0" if zero?
    lead = decimal_lead
    # Enough digits always read back: ceil(precision · log10 2) + 1.
    low = 1
    high = (@precision.to_i64 * 30103_i64 // 100000_i64 + 2_i64).to_i32
    while low < high
      middle = (low + high) // 2
      candidate = decimal_digits(middle, lead)
      if reads_back?(candidate[0], candidate[1])
        high = middle
      else
        low = middle + 1
      end
    end
    best = decimal_digits(low, lead)
    text = best[0].to_s
    # Trailing zeros are the place's, not digits: 100 is one digit.
    stop = text.bytesize
    while stop > 1 && text.to_unsafe[stop - 1] == 48_u8
      stop = stop - 1
    end
    point = best[1] + text.bytesize.to_i64 - 1_i64
    (@negative ? "-" : "") + BigFloat.place(text[0, stop], point)
  end

  def inspect : String
    to_s
  end

  # *digits* with its first digit at 10^*point*, as `Float64#to_s` puts
  # a point: positional from 10^-4 to 10^14, an exponent outside.
  protected def self.place(digits : String, point : Int64) : String
    if point >= -4_i64 && point < 15_i64
      if point >= 0_i64
        whole_size = point.to_i32 + 1
        if digits.bytesize <= whole_size
          return digits + "0" * (whole_size - digits.bytesize) + ".0"
        end
        return digits[0, whole_size] + "." + digits[whole_size, digits.bytesize - whole_size]
      end
      return "0." + "0" * (-1_i64 - point).to_i32 + digits
    end
    fraction = digits.bytesize > 1 ? digits[1, digits.bytesize - 1] : "0"
    digits[0, 1] + "." + fraction + "e" + (point < 0_i64 ? "-" : "+") + point.abs.to_s
  end

  # The power of ten of the leading decimal digit: 10^lead <= |self| <
  # 10^(lead + 1), exactly.
  private def decimal_lead : Int64
    lead = ((top - 1_i64) * 30103_i64) // 100000_i64
    lead = lead - 1_i64 if top - 1_i64 < 0_i64
    while compare_power(lead) < 0
      lead = lead - 1_i64
    end
    while compare_power(lead + 1_i64) >= 0
      lead = lead + 1_i64
    end
    lead
  end

  # |self| against 10^*power*, exactly.
  private def compare_power(power : Int64) : Int32
    left = @mantissa
    right = BigInt.one
    if @exponent >= 0_i64
      left = left << @exponent.to_i32
    else
      right = right << (0_i64 - @exponent).to_i32
    end
    if power >= 0_i64
      right = right * (BigInt.new(10_i64) ** power.to_i32)
    else
      left = left * (BigInt.new(10_i64) ** (0_i64 - power).to_i32)
    end
    left <=> right
  end

  # |self| to *count* significant digits, ties to even: the digits as an
  # integer and the power of ten of the last one. A carry to one more digit
  # is the next power's first.
  private def decimal_digits(count : Int32, lead : Int64) : {BigInt, Int64}
    last = lead - count.to_i64 + 1_i64
    num = @mantissa
    den = BigInt.one
    if @exponent >= 0_i64
      num = num << @exponent.to_i32
    else
      den = den << (0_i64 - @exponent).to_i32
    end
    if last >= 0_i64
      den = den * (BigInt.new(10_i64) ** last.to_i32)
    else
      num = num * (BigInt.new(10_i64) ** (0_i64 - last).to_i32)
    end
    q, r = num.divmod(den)
    twice = (r << 1) <=> den
    q = q + BigInt.one if twice > 0 || (twice == 0 && q.odd?)
    {q, last}
  end

  # Whether *digits* · 10^*last* rounds back to this value.
  private def reads_back?(digits : BigInt, last : Int64) : Bool
    back = if last >= 0_i64
             BigFloat.rounded(@negative, digits * (BigInt.new(10_i64) ** last.to_i32), BigInt.one, 0_i64, @precision)
           else
             BigFloat.rounded(@negative, digits, BigInt.new(10_i64) ** (0_i64 - last).to_i32, 0_i64, @precision)
           end
    back.mantissa == @mantissa && back.exponent == @exponent
  end

  # Equal values hash alike whatever their precision: the mantissa without
  # its trailing zero bits.
  def hash : Int32
    return 0 if zero?
    m = @mantissa
    e = @exponent
    while !m.odd?
      m = m >> 1
      e = e + 1_i64
    end
    (m.hash &* 31 &+ e.to_i32) &* (@negative ? -1 : 1)
  end

  def ==(other : BigFloat) : Bool
    (self <=> other) == 0
  end
end

impl Comparable for BigFloat
  def <=>(other : self) : Int32
    return 0 if zero? && other.zero?
    return (other.negative? ? 1 : -1) if zero?
    return (negative? ? -1 : 1) if other.zero?
    return (negative? ? -1 : 1) if negative? != other.negative?
    magnitude = if top != other.top
                  top > other.top ? 1 : -1
                else
                  low = exponent < other.exponent ? exponent : other.exponent
                  (mantissa << (exponent - low).to_i32) <=> (other.mantissa << (other.exponent - low).to_i32)
                end
    negative? ? 0 - magnitude : magnitude
  end
end

impl Hashable for BigFloat
  def hash_key : Int32
    hash
  end
end

struct ::Int64
  def to_big : Std::Big::BigInt
    Std::Big::BigInt.new(self)
  end

  def to_big_i : Std::Big::BigInt
    to_big
  end

  def to_big_d : Std::Big::BigDecimal
    Std::Big::BigDecimal.new(self, 0)
  end

  def to_big_r : Std::Big::BigRational
    Std::Big::BigRational.new(self, 1_i64)
  end

  def +(other : Std::Big::BigInt) : Std::Big::BigInt
    to_big + other
  end

  def -(other : Std::Big::BigInt) : Std::Big::BigInt
    to_big - other
  end

  def *(other : Std::Big::BigInt) : Std::Big::BigInt
    to_big * other
  end

  def ==(other : Std::Big::BigInt) : Bool
    other == self
  end

  def <=>(other : Std::Big::BigInt) : Int32
    to_big <=> other
  end
end

struct ::Int32
  def to_big : Std::Big::BigInt
    Std::Big::BigInt.new(self.to_i64)
  end

  def to_big_i : Std::Big::BigInt
    to_big
  end

  def to_big_d : Std::Big::BigDecimal
    Std::Big::BigDecimal.new(self, 0)
  end

  def to_big_r : Std::Big::BigRational
    Std::Big::BigRational.new(self, 1)
  end

  def +(other : Std::Big::BigInt) : Std::Big::BigInt
    to_big + other
  end

  def -(other : Std::Big::BigInt) : Std::Big::BigInt
    to_big - other
  end

  def *(other : Std::Big::BigInt) : Std::Big::BigInt
    to_big * other
  end

  def ==(other : Std::Big::BigInt) : Bool
    other == self
  end

  def <=>(other : Std::Big::BigInt) : Int32
    to_big <=> other
  end
end

class ::String
  def to_big_i : Std::Big::BigInt
    Std::Big::BigInt.new(self)
  end

  def to_big_d : Std::Big::BigDecimal
    Std::Big::BigDecimal.new(self)
  end

  def to_big_r : Std::Big::BigRational
    Std::Big::BigRational.new(self)
  end
end
