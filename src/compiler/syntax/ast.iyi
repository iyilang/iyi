pub class TraitDef < ASTNode
  property name : Path
  property body : ASTNode
  property type_vars : Array(String)?
  property assoc_types : Array(String)?
  property supertraits : Array(ASTNode)?

  def initialize(
    @name : Path = Path.new(""),
    body : ASTNode? = nil,
    @type_vars : Array(String)? = nil,
    @assoc_types : Array(String)? = nil,
    @supertraits : Array(ASTNode)? = nil,
  )
    @body = body || Nop.new
  end

  def clone_without_location : self
    cloned_supertraits = clone_opt_nodes(@supertraits)
    TraitDef.new(
      @name.clone.as(Path),
      @body.clone,
      clone_opt_strings(@type_vars),
      clone_opt_strings(@assoc_types),
      cloned_supertraits
    )
  end

  def accept_children(visitor) : Nil
    @name.accept(visitor)
    if st = @supertraits
      st.each { |s| s.accept(visitor) }
    end
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@body == other.body) && (@type_vars == other.type_vars) && (@assoc_types == other.assoc_types) && (@supertraits == other.supertraits)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@body)
    h = 31 &* h &+ hash_val(@type_vars)
    h = 31 &* h &+ hash_val(@assoc_types)
    h = 31 &* h &+ hash_val(@supertraits)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "trait "
    @name.to_s(sb)
    if tv = @type_vars
      sb << "(" << tv.join(", ") << ")"
    end
    sb << "
  "
    @body.to_s(sb)
    sb << "
end"
  end
end

pub class ImplDef < ASTNode
  property trait : Path
  property trait_args : Array(ASTNode)?
  property target : ASTNode
  property body : ASTNode
  property type_vars : Array(String)?
  property assoc_types : Array(AssocTypeDecl)?

  def initialize(
    @trait : Path = Path.new(""),
    target : ASTNode? = nil,
    body : ASTNode? = nil,
    @type_vars : Array(String)? = nil,
    @trait_args : Array(ASTNode)? = nil,
    @assoc_types : Array(AssocTypeDecl)? = nil,
  )
    @body = body || Nop.new
    @target = target || Path.new("")
  end

  def clone_without_location : self
    cloned_trait_args = clone_opt_nodes(@trait_args)
    if at = @assoc_types
      cloned_assoc_types = at.map { |a| a.clone.as(AssocTypeDecl) }
    else
      cloned_assoc_types = nil
    end
    ImplDef.new(
      @trait.clone.as(Path),
      @target.clone,
      @body.clone,
      clone_opt_strings(@type_vars),
      cloned_trait_args,
      cloned_assoc_types
    )
  end

  def accept_children(visitor) : Nil
    @trait.accept(visitor)
    if ta = @trait_args
      ta.each { |a| a.accept(visitor) }
    end
    @target.accept(visitor)
    if at = @assoc_types
      at.each { |a| a.accept(visitor) }
    end
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    @trait == other.trait && @trait_args == other.trait_args && @target == other.target &&
      @body == other.body && @type_vars == other.type_vars && @assoc_types == other.assoc_types
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @trait.hash
    h = 31 &* h &+ hash_val(@trait_args)
    h = 31 &* h &+ @target.hash
    h = 31 &* h &+ @body.hash
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "impl "
    @trait.to_s(sb)
    if ta = @trait_args
      sb << "("
      i = 0
      while i < ta.size
        sb << ", " if i > 0
        ta[i].to_s(sb)
        i = i + 1
      end
      sb << ")"
    end
    sb << " for "
    @target.to_s(sb)
    sb << "
  "
    @body.to_s(sb)
    sb << "
end"
  end
end

