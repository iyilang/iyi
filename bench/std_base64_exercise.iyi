# Exercises `std/base64`.
#
# Run via:
#     ./bin/iyi run bench/std_base64_exercise.iyi

@[Unsafe("its byte helper reads a string's bytes through to_unsafe, to compare std/base64's output byte for byte")]
module bench/std_base64_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/base64::{Base64, Base64Error}

# What `decode?` answered, as one line: the bytes, or the refusal's
# sentence.
def answered(got : String | Base64Error) : String
  got.is_a?(Base64Error) ? "refused: " + got.message : got
end

puts "== encode"
assert_str "aGk=", Base64.encode("hi"), "hi"
assert_str "Zg==", Base64.encode("f"), "f"
assert_str "Zm8=", Base64.encode("fo"), "fo"
assert_str "Zm9v", Base64.encode("foo"), "foo"
assert_str "", Base64.encode(""), "empty"
assert_str "Pz8=", Base64.urlsafe_encode("??"), "urlsafe"
puts "  RFC 4648, with padding"

# Past eight bytes the encoder reads six at a time and writes eight
# characters as one word; every byte value, both alphabets, and every
# length around the switch to the byte-at-a-time tail.
every_byte = String.new(256) { |p| 256.times { |k| p[k] = k.to_u8 } }
backwards = String.new(256) { |p| 256.times { |k| p[k] = (255 - k).to_u8 } }
assert_str "", Base64.encode(every_byte), "every byte value"
assert_str "__79_Pv6-fj39vX08_Lx8O_u7ezr6uno5-bl5OPi4eDf3t3c29rZ2NfW1dTT0tHQz87NzMvKycjHxsXEw8LBwL--vby7urm4t7a1tLOysbCvrq2sq6qpqKempaSjoqGgn56dnJuamZiXlpWUk5KRkI-OjYyLiomIh4aFhIOCgYB_fn18e3p5eHd2dXRzcnFwb25tbGtqaWhnZmVkY2JhYF9eXVxbWllYV1ZVVFNSUVBPTk1MS0pJSEdGRURDQkFAPz49PDs6OTg3NjU0MzIxMC8uLSwrKikoJyYlJCMiISAfHh0cGxoZGBcWFRQTEhEQDw4NDAsKCQgHBgUEAwIBAA==", Base64.urlsafe_encode(backwards), "every byte value, url-safe"
40.times do |len|
  piece = every_byte[200 - len, len]
  assert_str piece, Base64.decode(Base64.encode(piece)), "a round trip of #{len} bytes"
end
puts "  every byte value, both alphabets, every length to 40"

# What encoding costs against a pass that only adds the bytes up: a byte
# and a character at a time it was five of them in a plain build, read
# and written a word at a time it is under one. A release build turns the
# pass into vector code, so the ratio is not asked there.
{% unless flag?(:release) %}
  def byte_sum(s : String) : UInt64
    p = s.to_unsafe
    sum = 0_u64
    i = 0
    while i < s.bytesize
      sum = sum &+ p[i].to_u64
      i = i + 1
    end
    sum
  end

  sample = "0123456789abcdefghijklmnopqrstuvwxyz!?" * 30000
  best_sum = 0_i64
  best_encode = 0_i64
  seen = 0_u64
  3.times do |k|
    t0 = IyiMark.now_ns
    seen = seen &+ byte_sum(sample)
    t1 = IyiMark.now_ns
    seen = seen &+ Base64.encode(sample).bytesize.to_u64
    t2 = IyiMark.now_ns
    best_sum = (t1 - t0).to_i64 if k == 0 || (t1 - t0).to_i64 < best_sum
    best_encode = (t2 - t1).to_i64 if k == 0 || (t2 - t1).to_i64 < best_encode
  end
  assert_true best_encode * 2 < best_sum * 5, "encode cost: #{best_encode * 10 // best_sum}/10 of a byte sum (#{seen})"
  # Named without its measurements: `bench/std_exercise.sh` runs this from
  # source and from artifacts and compares what it prints.
  puts "  encode within a few passes that add the bytes up"
{% end %}

puts "\n== decode"
assert_str "hi", Base64.decode("aGk="), "pad"
assert_str "hello world", Base64.decode(Base64.encode("hello world")), "round trip"
# What stays lenient next to the refusals the gate drives: missing or
# partial padding, and whitespace anywhere, including between the `=`.
assert_str "A", Base64.decode("QQ"), "missing padding"
assert_str "A", Base64.decode("QQ="), "partial padding"
assert_str "ABCA", Base64.decode("QUJD\nQQ=\n=\n"), "whitespace between groups and padding"
assert_str "ABCEFG", Base64.decode("QUJD\nRUZH"), "whole groups either side of a line break"
assert_str "ABCD", Base64.decode("QUJDRA=="), "a full group then a padded one"
# All six ASCII whitespace bytes, as the module's header says: `\v` and
# `\f` were refused as invalid bytes.
assert_str "ABCD", Base64.decode("QUJD\vRA=\f="), "vertical tab and form feed are whitespace"
puts "  decode and round trip"

puts "\n== decode?"
assert_str "hi", answered(Base64.decode?("aGk=")), "decode? of a text that is base64"
assert_str "ABCA", answered(Base64.decode?("QUJD\nQQ=\n=\n")), "decode? reads what decode reads"
# Each refusal the gate drives through `decode` as a panic, answered here
# as a value with the same sentence.
assert_str "refused: base64: invalid byte 42", answered(Base64.decode?("QU*JD")), "decode? answers a byte outside the alphabet"
assert_str "refused: base64: invalid byte 33", answered(Base64.decode?("QUJDQUJD!!not-base64!!")), "decode? answers a byte after whole groups"
assert_str "refused: base64: data after padding", answered(Base64.decode?("QQ==QQ==")), "decode? answers data after the padding"
assert_str "refused: base64: discontinuous padding", answered(Base64.decode?("QU=JD")), "decode? answers data inside the padding"
assert_str "refused: base64: excess padding", answered(Base64.decode?("QQ===")), "decode? answers more padding than the group needs"
assert_str "refused: base64: padding with no group to close", answered(Base64.decode?("QUJD=")), "decode? answers padding after a full group"
assert_str "refused: base64: 1 data characters, 1 more than a multiple of 4: a single character cannot encode a byte", answered(Base64.decode?("Q=")), "decode? answers a padded lone character"
assert_str "refused: base64: 5 data characters, 1 more than a multiple of 4: a single character cannot encode a byte", answered(Base64.decode?("QUJDR")), "decode? answers a final group of one character"
puts "  a text that is base64 decoded, and each refusal answered with decode's sentence"

puts "\nALL CHECKS PASSED"
