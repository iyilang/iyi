; iyi-ir 1
source_filename = "escape_dynamic_memset"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @dynamic_fill(i64 %length) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 16, i64 1, i64 2)
  intrinsic llvm.memset.p0.i64(ptr %p, i8 0, i64 %length, i1 false)
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
