# The mark beside the program, exercised: GC_DESIGN.md Stage 9.
#
#   ./bin/iyi run bench/concurrent_mark.iyi
#
# What a concurrent mark has to get right is the one thing a stop-the-world
# mark never faces: the program moving pointers while the marker walks. The
# losing move is a pointer taken out of an object the marker has not reached
# (white) and stored into one it has finished (black), the old edge cut —
# without a write barrier the marker never sees the object again, and the
# sweep frees something the program holds. This program makes exactly that
# move, many times, each time under a mark it started itself:
#
#   - `holders`: a rooted array of 64 boxes, one hop from a global, so the
#     marker blackens them early;
#   - a chain of 200 000 nodes, built while the trigger is off, with a
#     payload hanging off its last node — the object the marker reaches
#     last, if it reaches it;
#   - allocation until the marking flag is up, then the payload moved from
#     the chain's tail into a holder and the chain's edge cut, with no
#     local keeping it: a barrier-only object;
#   - the collection waited out, and the payload read back through the
#     holder: its header must not carry the sweep's free flag and its bytes
#     must be the pattern written into them.
#
# Every round that made its move under a mark counts; the program asks for
# at least one, and reports how many. Twenty-four rounds, and on past them
# until one has, up to ninety-six: whether the program reaches the tail
# before the marker does is a race it wins most rounds and, on a loaded
# machine, can lose twenty-four times running. The pauses are printed beside the
# stop-the-world mark's over the same chain: a concurrent collection's two
# stops, the longest of each, against the one stop that marked it all —
# and how many second stops found a white root or a full pool and retreated
# to mark it beside the program before stopping again.
#
# bench/concurrent_mark.sh drives it and proves the check fails when the
# barrier shades nothing.

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  class Payload
    @bytes : Pointer(UInt8)
    @seed : UInt64

    def initialize(@seed : UInt64)
      @bytes = Pointer(UInt8).malloc(256_u64)
      index = 0_u64
      while index < 256_u64
        (@bytes + index.to_i64).value = ((@seed &+ index) & 0xFF_u64).to_u8
        index = index + 1_u64
      end
    end

    def intact? : Bool
      index = 0_u64
      while index < 256_u64
        return false if (@bytes + index.to_i64).value != ((@seed &+ index) & 0xFF_u64).to_u8
        index = index + 1_u64
      end
      true
    end

    def seed : UInt64
      @seed
    end
  end

  class Cell
    @next : Cell?
    @payload : Payload?

    def initialize(@next : Cell?, @payload : Payload?)
    end

    def next : Cell?
      @next
    end

    def payload : Payload?
      @payload
    end

    def payload=(value : Payload?)
      @payload = value
    end
  end

  class Holder
    @payload : Payload?

    def initialize
      @payload = nil
    end

    def payload : Payload?
      @payload
    end

    def payload=(value : Payload?)
      @payload = value
    end
  end

  class Roots
    @@holders : Array(Holder) = [] of Holder

    def self.holders : Array(Holder)
      @@holders
    end
  end

  CHAIN = 200000

  # The chain, its tail first: the last node made is the head, so the
  # payload sits on the node the marker reaches last.
  def build_chain(seed : UInt64) : Cell
    head = Cell.new(nil, Payload.new(seed))
    count = 1
    while count < CHAIN
      head = Cell.new(head, nil)
      count = count + 1
    end
    head
  end

  def tail(link : Cell) : Cell
    cursor = link
    while true
      following = cursor.next
      break unless following.is_a?(Cell)
      cursor = following
    end
    cursor
  end

  def churn(bytes : UInt64) : Nil
    burned = 0_u64
    while burned < bytes
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
      burned = burned + 64_u64
    end
  end

  # Allocate until a mark is running beside this thread, or the budget has
  # gone by twice, which means no mark will be concurrent here.
  def allocate_until_marking : Bool
    burned = 0_u64
    limit = IyiMark.budget * 2_u64
    while burned < limit
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
      burned = burned + 64_u64
      return true if IyiMark.marking?
    end
    false
  end

  # A holder born under the mark, and blackened here: an object born
  # under a mark is white and alive by its epoch's parity (the mutator
  # writes no mark byte), and a holder with nothing in it is what a scan
  # leaves black, so the colour is put on it directly - the move below
  # then lands in a black holder, and the barrier is the only thing that
  # saves the payload, which is what the failure proof removes. Waiting
  # for one of the pre-made holders to turn black instead proved nothing
  # on some machines: when it turns black is the workers' order of
  # business, and where the 200,000-cell chain came first the payload
  # was black already, found through the chain's tail, and the proof had
  # nothing to lose. The new holder goes into the rooted array so it is
  # a root's child; the array's store is its own barrier's business.
  def born_black_holder(round : Int32) : Holder
    holder = Holder.new
    Roots.holders[round % 64] = holder
    IyiMark.recolour(holder.object_id.to_u64, IyiMark::BLACK) if IyiMark.marking?
    holder
  end

  # The move, under a mark: payload from the chain's tail into a holder,
  # the tail's edge cut. `@[NoInline]` so the local that carried it is
  # gone with the frame before the mark finishes.
  @[NoInline]
  def move(chain : Cell, holder : Holder) : Nil
    last = tail(chain)
    holder.payload = last.payload
    last.payload = nil
  end

  def check(holder : Holder, seed : UInt64, round : Int32) : Nil
    payload = holder.payload
    fail("round #{round}: the holder's payload is nil") unless payload.is_a?(Payload)
    address = payload.object_id.to_u64
    if IyiMark.flags(address) & IyiHeap::FREE_FLAG != 0
      fail("round #{round}: the payload moved into a black holder under the mark was freed: the barrier lost it")
    end
    fail("round #{round}: the payload's seed is #{payload.seed.to_i64} rather than #{seed.to_i64}: its chunk was reused, the barrier lost it") if payload.seed != seed
    fail("round #{round}: the payload's bytes changed under the mark") unless payload.intact?
  end

  # The two stops of the last concurrent collection, folded into the
  # longest of each.
  class Stops
    @@first : UInt64 = 0_u64
    @@second : UInt64 = 0_u64

    def self.note : Nil
      first = IyiMark.stop_first_ns
      second = IyiMark.stop_second_ns
      @@first = first if first > @@first
      @@second = second if second > @@second
    end

    def self.first : UInt64
      @@first
    end

    def self.second : UInt64
      @@second
    end
  end

  # A holder and the payload only it holds, made where no local of the
  # caller's keeps the payload.
  @[NoInline]
  def stray_holder(seed : UInt64) : Holder
    holder = Holder.new
    holder.payload = Payload.new(seed)
    holder
  end

  def note_stops : Nil
    Stops.note
  end

  # Threads of the program's own, allocating until told to stop: the
  # cores they hold are not the helpers' to take.
  class Busy
    @@page : UInt64 = 0_u64

    def self.setup : Nil
      @@page = __iyi_mmap(4096_u64).address
    end

    def self.stop : Pointer(Atomic(UInt64))
      Pointer(Atomic(UInt64)).new(@@page)
    end
  end

  def busy_until_stopped : Nil
    while Busy.stop.value.get == 0_u64
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
    end
  end

  index = 0
  while index < 64
    Roots.holders << Holder.new
    index = index + 1
  end

  # ── The stop-the-world mark over the same chain, for the pause ────────
  IyiMark.auto = false
  IyiMark.workers = 0_u64
  chain = build_chain(1_u64)
  IyiMark.collect
  IyiMark.collect
  stw_pauses = 0_u64
  round = 0
  while round < 5
    started = IyiMark.pause_total_ns
    IyiMark.collect
    stw_pauses = stw_pauses + (IyiMark.pause_total_ns - started)
    round = round + 1
  end
  stw_mean = stw_pauses.unsafe_div(5_u64)
  fail("the chain's tail lost its payload under a stop-the-world mark") unless tail(chain).payload.is_a?(Payload)

  # ── A barrier that runs after its mark has ended ──────────────────────
  # A store reads the marking flag and its barrier runs after it, and a
  # thread stopped between the two finds the mark over when it goes on.
  # The barrier has nothing to shade then, and must shade nothing: a
  # holder grayed after its arena's sweep went into the next mark gray,
  # which that mark never queues, and the payload only it held was swept.
  # Every arena is swept by the collection first, so nothing turns the
  # holder white again before the next mark.
  IyiMark.collect
  stray = stray_holder(77_u64)
  cell = Pointer(UInt64).malloc(1_u64)
  cell.value = stray.object_id.to_u64
  IyiHeap.enter_barrier
  IyiMark.barrier(cell.address, 1_u64)
  IyiHeap.leave_barrier
  IyiMark.collect
  strayed = stray.payload
  fail("stray: the holder lost its payload") unless strayed.is_a?(Payload)
  if IyiMark.flags(strayed.object_id.to_u64) & IyiHeap::FREE_FLAG != 0 || strayed.seed != 77_u64 || !strayed.intact?
    fail("stray: a barrier run after its mark had ended left the holder gray, and the next mark swept the payload it held")
  end
  puts "stray: a barrier run after its mark had ended shaded nothing, and the next mark kept what the holder held"

  # ── The moves, under marks beside the program ─────────────────────────
  IyiMark.workers = 15_u64
  under_mark = 0
  round = 0
  concurrent_before = IyiMark.concurrent_collections
  while round < 24 || (under_mark == 0 && round < 96)
    IyiMark.auto = false
    seed = 1000_u64 + round.to_u64
    chain = build_chain(seed)
    Roots.holders[round % 64].payload = nil
    IyiMark.auto = true
    marking = allocate_until_marking
    holder = born_black_holder(round)
    # Under a mark, and the chain's tail not reached yet: a payload the
    # workers found through the chain is saved by the chain, and that
    # round is not the barrier's to prove.
    payload = tail(chain).payload
    payload_white = payload.is_a?(Payload) && IyiMark.colour(payload.object_id.to_u64) == IyiMark::WHITE
    marking = marking && IyiMark.marking? && IyiMark.colour(holder.object_id.to_u64) == IyiMark::BLACK && payload_white
    under_mark = under_mark + 1 if marking
    move(chain, holder)
    # The chain is garbage from here; the payload lives in the holder only.
    chain = build_chain(0_u64)
    IyiMark.settle
    note_stops
    churn(IyiMark.budget)
    IyiMark.settle
    note_stops
    check(holder, seed, round)
    round = round + 1
  end
  IyiMark.auto = false
  rounds = round
  concurrent = IyiMark.concurrent_collections - concurrent_before
  fail("no round made its move under a mark: nothing here was concurrent") if under_mark == 0
  fail("no collection ran beside the program across #{rounds} rounds") if concurrent == 0_u64

  puts "moves: #{under_mark} of #{rounds} rounds moved a payload into a black holder under a running mark, #{concurrent.to_i64} collections ran beside the program, every payload intact"
  puts "pause: #{stw_mean.unsafe_div(1000_u64).to_i64} us to mark the chain stopped; beside the program the longest first stop was #{Stops.first.unsafe_div(1000_u64).to_i64} us, the longest second #{Stops.second.unsafe_div(1000_u64).to_i64} us, and #{IyiMark.finish_retries.to_i64} second stops retreated to mark what they found"
  # The helpers for each mark beside the program are woken by the
  # program's own thread, and the wake is the program's time. On Linux it
  # is one futex call; on Windows a woken helper ran above the thread that
  # woke it and took its core, 3.7 to 40 ms at the longest. The longest
  # wake was the check, and it caught the machine instead once: a runner
  # took the thread away for 3.7 ms in one wake of 49, which it does
  # without any help. So the wakes are counted, over two hundred more
  # collections beside a kept chain, and the check is how many were slow.
  # On a four-core Windows runner, 40 runs each: the shipped helpers made
  # no wake past a millisecond in 10,000, and helpers with the boost made
  # 5 to 88 in every run of 250. Asserted where it was measured; printed
  # everywhere.
  IyiMark.auto = true
  kept = build_chain(1_u64)
  wake_round = 0
  while wake_round < 200
    churn(IyiMark.budget)
    IyiMark.settle
    wake_round = wake_round + 1
  end
  IyiMark.auto = false
  fail("the kept chain lost its payload under the wake rounds") unless tail(kept).payload.is_a?(Payload)
  wake = IyiMark.wake_longest_ns
  wakes = IyiMark.wakes
  slow = IyiMark.wakes_slow
  {% if flag?(:win32) %}
    fail("wake: waking the helpers held the program's thread past #{(IyiMark::WAKE_SLOW_NS // 1000_u64).to_i64} us in #{slow.to_i64} wakes of #{wakes.to_i64}, the longest #{(wake // 1000_u64).to_i64} us") if slow > 3_u64
  {% end %}
  puts "wake: the program's thread woke the helpers #{wakes.to_i64} times, #{slow.to_i64} of them past #{(IyiMark::WAKE_SLOW_NS // 1000_u64).to_i64} us, the longest #{(wake // 1000_u64).to_i64} us"

  # ── The helpers' share beside a busy program ──────────────────────────
  # The program runs a thread for every core but one, and a mark starts
  # beside them: on Windows it asks for one helper, where it asked for
  # every helper there was and the threads' stalls doubled (the prelude's
  # `start_concurrent` has the numbers). Asserted where it was measured;
  # printed everywhere.
  cores = IyiThread.core_count
  if cores >= 3_u64
    Busy.setup
    busy = [] of IyiThread
    while busy.size.to_u64 < cores - 2_u64
      busy << IyiThread.start { busy_until_stopped; nil }
    end
    threads = IyiThread.program_threads
    IyiMark.auto = false
    chain = build_chain(7_u64)
    IyiMark.auto = true
    asked = 0_u64
    marked = false
    attempt = 0
    while !marked && attempt < 8
      marked = allocate_until_marking
      asked = IyiMark.beside_helpers if marked
      IyiMark.settle
      attempt = attempt + 1
    end
    Busy.stop.value.set(1_u64)
    busy.each(&.join)
    IyiMark.auto = false
    fail("share: no mark ran beside the busy threads in 8 tries") unless marked
    {% if flag?(:win32) %}
      fail("share: with #{threads.to_i64} threads of the program's on #{cores.to_i64} cores, the mark beside them asked for #{asked.to_i64} helpers rather than 1") if asked != 1_u64
    {% end %}
    puts "share: with #{threads.to_i64} threads of the program's on #{cores.to_i64} cores, the mark beside them asked for #{asked.to_i64} helpers"
    fail("the chain's tail lost its payload beside the busy threads") unless tail(chain).payload.is_a?(Payload)
  end
  puts "concurrent mark: every property held"
{% else %}
  puts "concurrent mark: needs the collector and a thread target; nothing to exercise here"
{% end %}
