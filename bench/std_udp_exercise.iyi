# Exercises `std/udp`.
#
# Run via:
#     ./bin/iyi run bench/std_udp_exercise.iyi

module bench/std_udp_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def assert_int(expected : Int32, actual : Int32, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
end

import std/udp
using std/udp::{UdpSocket, Datagram, IPv4Address, Bytes}

puts "== address parsing"
ip = UdpSocket.parse_ipv4("127.0.0.1")
assert_str "127.0.0.1", ip.to_s, "ipv4 to_s"
assert_true ip.b0 == 127_u8 && ip.b1 == 0_u8 && ip.b2 == 0_u8 && ip.b3 == 1_u8, "ipv4 octets"

ip_local = UdpSocket.parse_ipv4("localhost")
assert_str "127.0.0.1", ip_local.to_s, "localhost resolves to 127.0.0.1"

ip_zero = UdpSocket.parse_ipv4("0.0.0.0")
assert_str "0.0.0.0", ip_zero.to_s, "0.0.0.0 resolves to 0.0.0.0"

v6 = UdpSocket.parse_ipv6("::1")
assert_true v6[15] == 1_u8 && v6[0] == 0_u8, "ipv6 loopback parsed"
puts "  numeric IPv4 and IPv6 parsing without libc"

puts "\n== bind to port 0 and loopback exchange"
server = UdpSocket.bind("127.0.0.1", 0)
server_port = server.local_port
assert_true server_port > 0, "OS assigns port > 0"
assert_str "127.0.0.1", server.local_address, "bound local address is 127.0.0.1"

client = UdpSocket.client
sent = client.send_to("ping loopback", "127.0.0.1", server_port)
assert_int 13, sent, "sent byte count"

dg = server.receive_datagram
assert_str "ping loopback", dg.text, "received datagram text"
assert_str "127.0.0.1", dg.host, "sender host is 127.0.0.1"
client_port = dg.port
assert_true client_port > 0, "sender port is non-zero"
assert_int 13, dg.data.size, "datagram byte size"
assert_str "ping loopback", dg.to_s, "datagram to_s matches text"

server.send_to("pong reply", dg.host, client_port)
reply_dg = client.receive_datagram
assert_str "pong reply", reply_dg.text, "reply text"
assert_str "127.0.0.1", reply_dg.host, "reply sender host"
assert_int server_port, reply_dg.port, "reply sender port matches server port"

client.send_to("slice payload", "127.0.0.1", server_port)
buf = Bytes.new(32)
slice, r_host, r_port = server.receive_from(buf)
assert_int 13, slice.size, "caller buffer received slice size"
assert_str "127.0.0.1", r_host, "caller buffer received sender host"
assert_int client_port, r_port, "caller buffer received sender port"

self_sent = server.send_to("self datagram", "127.0.0.1", server_port)
assert_int 13, self_sent, "self-sent byte count"
self_dg = server.receive_datagram
assert_str "self datagram", self_dg.text, "self datagram text"
assert_str "127.0.0.1", self_dg.host, "self datagram sender host"
assert_int server_port, self_dg.port, "self datagram sender port is own port"
puts "  OS assigns port 0, send_to and receive_from report sender address"

puts "\n== connected sockets"
c1 = UdpSocket.bind("127.0.0.1", 0)
c2 = UdpSocket.bind("127.0.0.1", 0)
cp1 = c1.local_port
cp2 = c2.local_port

c1.connect("127.0.0.1", cp2)
c2.connect("127.0.0.1", cp1)

c1.send("connected datagram")
c2_recv = c2.receive
assert_int 18, c2_recv.size, "connected receive byte size"
c1.close
c2.close
puts "  connect, send, and receive"

puts "\n== maximum datagram size"
server.send_buffer_size = 131072
server.receive_buffer_size = 131072
client.send_buffer_size = 131072
client.receive_buffer_size = 131072

max_payload = Bytes.new(65507)
max_payload[0] = 0xAA_u8
max_payload[32768] = 0x55_u8
max_payload[65506] = 0xFF_u8

client.send_to(max_payload, "127.0.0.1", server_port)
big_dg = server.receive_datagram(65536)
assert_int 65507, big_dg.data.size, "received max payload size"
assert_true big_dg.data[0] == 0xAA_u8 && big_dg.data[32768] == 0x55_u8 && big_dg.data[65506] == 0xFF_u8, "payload contents intact"
puts "  65,507-byte datagram sent and received intact"

puts "\n== non-blocking and timeout receive with no data"
assert_true !server.non_blocking?, "non_blocking default is false"
server.non_blocking = true
assert_true server.non_blocking?, "non_blocking is true"
assert_true !server.poll_read(0), "poll_read is false when no data pending"
assert_true server.receive_from?.nil?, "receive_from? returns nil when would block"
assert_true server.receive_datagram?.nil?, "receive_datagram? returns nil when would block"

server.non_blocking = false
server.read_timeout = 10
assert_int 10, server.read_timeout, "read_timeout is 10ms"
assert_true server.receive_from?.nil?, "receive_from? returns nil on timeout"
assert_true server.receive_datagram?.nil?, "receive_datagram? returns nil on timeout"
server.read_timeout = 0
puts "  receive_from? and receive_datagram? return nil when no data pending"

puts "\n== socket lifecycle and close"
assert_true !client.closed?, "client initially not closed"
client.close
assert_true client.closed?, "client is closed"
assert_int -1, client.to_unsafe, "closed client fd is -1"

assert_true !server.closed?, "server initially not closed"
server.close
assert_true server.closed?, "server is closed"
assert_int -1, server.to_unsafe, "closed server fd is -1"
puts "  close marks socket closed and invalidates fd"

puts "\nALL CHECKS PASSED"
