fun int_add(a : Int32, b : Int32) : Int32
  a &+ b
end

fun int_ops(a : Int32, b : Int32) : Int32
  (a &+ b) &* (a &- b)
end

fun int_bitwise(a : Int32, b : Int32) : Int32
  (a & b) | (a ^ b)
end

fun int_shifts(a : Int32, b : Int32) : Int32
  a.unsafe_shl(b) &+ a.unsafe_shr(b)
end

fun int64_calc(a : Int64, b : Int64) : Int64
  (a &+ b) &* (a &- b)
end
