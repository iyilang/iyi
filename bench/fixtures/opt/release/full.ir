; iyi-ir 1
source_filename = "full"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @helper(i64 %x) {
entry:
  %slot = alloca { i64, i64 }, align 8
  %field = getelementptr { i64, i64 }, ptr %slot, i64 0, i32 0
  store i64 %x, ptr %field, align 8
  %value = load i64, ptr %field, align 8
  %sum = add i64 %value, 1
  ret i64 %sum
}
define external i64 @run(i64 %x) {
entry:
  %v = call i64 (i64) @helper(i64 %x)
  %a = add i64 %v, 0
  ret i64 %a
}
