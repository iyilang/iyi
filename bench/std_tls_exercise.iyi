# Exercises std/tls: a TLS 1.3 client and server, and the client's TLS 1.2.
#
# With no argument: RFC 8448's "Simple 1-RTT Handshake" trace, held byte for
# byte through the key schedule and the record protection - every secret
# from the early one to the exporter's, the server's handshake flight
# decrypted from the trace's record to the trace's plaintext, both
# Finished values, the client's Finished sealed into exactly the trace's
# record, and the application data both ways after a NewSessionTicket -
# and TLS 1.2's PRF over SHA-256 and SHA-384 against the vectors that
# circulate for it, the form a host takes in server_name, and a session's
# tickets between a client and a server of this run's own on loopback
# (127.0.0.1, ports the kernel picks). The modes the gate script drives:
#   scenarios DIR       every scenario of bench/std_tls_server.py, whose
#                       port and roots are in DIR, each holding or refused
#                       for its reason;
#   get PORT ROOTS HOST [ALPN|-] [CHAIN KEY]
#                       GET / over a connection to 127.0.0.1:PORT for HOST,
#                       its status line, suite, protocol, version and group
#                       printed, or why it was refused; with CHAIN and KEY,
#                       presented if the server asks; TLS 1.2 offered too
#                       when TLS_MIN_VERSION is 1.2, X25519MLKEM768 not
#                       offered when TLS_POST_QUANTUM is 0;
#   renegotiate PORT ROOTS HOST
#                       "first", a read that times out, "second", a read:
#                       what a TLS 1.2 server that sends a HelloRequest
#                       between is answered;
#   serve DIR COUNT     a TlsServer on 127.0.0.1, its port written to
#                       DIR/port, with DIR/chain.pem and DIR/key.pem and
#                       ALPN h2 and http/1.1 - asking for a client's
#                       certificate under DIR/client-roots.pem when there
#                       is one, not requiring it when DIR/client-optional
#                       is there, and speaking TLS 1.2 too when
#                       TLS_MIN_VERSION is 1.2: COUNT connections, one at
#                       a time, each line "held ..." or "refused: why".
#                       Bytes are echoed as "echo:..."; a request ending
#                       in a blank line is answered `HTTP/1.0 200 ok` and
#                       what was agreed, then close_notify;
#   config CHAIN KEY    TlsServerConfig.from_pem's answer.

import std/tls::{TlsClient, TlsConfig, TlsEarlyData, TlsEchConfig, TlsEchKey, TlsError, TlsHeldTicket, TlsIdentity, TlsKeySchedule, TlsMadeUnder, TlsRecordCipher, TlsReplayGuard, TlsServer, TlsServerConfig, TlsSession, TlsTicket, TlsTicketKeys, TlsVersion}
import std/x509::{Certificate}
import std/time::{Time}
import std/socket::{IyiSocket, SocketError}
import std/file::{File}
import std/env::{ENV}
import std/hpke::{HpkeSuite, HpkeKem, HpkeKdf, HpkeAead, HpkeSender}
import std/curve25519::{X25519}
import std/mlkem::{MlKem768PrivateKey}
import std/random::{Random}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def text(bytes : Array(UInt8)) : String
  String.new(bytes.size) { |buf| buf.copy_from(bytes.to_unsafe, bytes.size) }
end

# Everything the server sends after *conn* has written "hello", or the
# error that ended it.
def drain(conn : TlsClient) : String
  got = ""
  while true
    chunk = conn.read
    return got + " [#{chunk.message}]" if chunk.is_a?(TlsError)
    return got if chunk.empty?
    got = got + chunk
  end
  got
end

