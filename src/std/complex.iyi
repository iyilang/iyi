module std/complex

import std/math
import std/float
import std/int

pub struct Complex
  getter real : Float64
  getter imag : Float64

  def initialize(real : ::Number, imag : ::Number = 0)
    @real = real.to_f64
    @imag = imag.to_f64
  end

  def self.new(c : Complex)
    c
  end

  def ==(other : Complex) : ::Bool
    @real == other.real && @imag == other.imag
  end

  def ==(other : ::Number) : ::Bool
    @real == other.to_f64 && @imag == 0.0
  end

  def to_c : Complex
    self
  end

  def to_f64 : Float64
    raise "Complex number with non-zero imaginary part can't be converted to real" unless @imag == 0.0
    @real
  end

  def to_f : Float64
    to_f64
  end

  def to_i32 : Int32
    to_f64.to_i32
  end

  def to_i64 : Int64
    to_f64.to_i64
  end

  def to_f32 : Float32
    to_f64.to_f32
  end

  def to_s : String
    r = @real.to_s
    sign_str = @imag >= 0.0 ? " + " : " - "
    im = @imag >= 0.0 ? @imag.to_s : (0.0 - @imag).to_s
    r + sign_str + im + "i"
  end

  def to_s(io : IyiIO) : ::Nil
    io.print(to_s)
  end

  def inspect : String
    "(" + to_s + ")"
  end

  def inspect(io : IyiIO) : ::Nil
    io.print(inspect)
  end

  def abs : Float64
    ::Math.hypot(@real, @imag)
  end

  def abs2 : Float64
    @real * @real + @imag * @imag
  end

  def sign : Complex
    return self if zero?
    mag = abs
    Complex.new(@real / mag, @imag / mag)
  end

  def phase : Float64
    ::Math.atan2(@imag, @real)
  end

  def polar : {Float64, Float64}
    {abs, phase}
  end

  def conj : Complex
    Complex.new(@real, 0.0 - @imag)
  end

  def inv : Complex
    conj / abs2
  end

  def + : Complex
    self
  end

  def +(other : Complex) : Complex
    Complex.new(@real + other.real, @imag + other.imag)
  end

  def +(other : ::Number) : Complex
    Complex.new(@real + other.to_f64, @imag)
  end

  def - : Complex
    Complex.new(0.0 - @real, 0.0 - @imag)
  end

  def -(other : Complex) : Complex
    Complex.new(@real - other.real, @imag - other.imag)
  end

  def -(other : ::Number) : Complex
    Complex.new(@real - other.to_f64, @imag)
  end

  def *(other : Complex) : Complex
    Complex.new(@real * other.real - @imag * other.imag, @real * other.imag + @imag * other.real)
  end

  def *(other : ::Number) : Complex
    n = other.to_f64
    Complex.new(@real * n, @imag * n)
  end

  def /(other : Complex) : Complex
    d = other.abs2
    raise "Division by zero" if d == 0.0
    Complex.new((@real * other.real + @imag * other.imag) / d, (@imag * other.real - @real * other.imag) / d)
  end

  def /(other : ::Number) : Complex
    n = other.to_f64
    raise "Division by zero" if n == 0.0
    Complex.new(@real / n, @imag / n)
  end

  def clone : Complex
    self
  end

  def hash : Int32
    @real.to_i64.to_i32 ^ @imag.to_i64.to_i32
  end

  def self.zero : Complex
    new(0, 0)
  end

  def zero? : ::Bool
    @real == 0.0 && @imag == 0.0
  end

  def self.additive_identity : Complex
    zero
  end

  def self.multiplicative_identity : Complex
    new(1, 0)
  end

  def round(digits : Int32 = 0) : Complex
    Complex.new(@real.round(digits), @imag.round(digits))
  end
end

struct ::Number
  def to_c : Std::Complex::Complex
    Std::Complex::Complex.new(self, 0)
  end

  def i : Std::Complex::Complex
    Std::Complex::Complex.new(0, self)
  end

  def cis : Std::Complex::Complex
    val = to_f64
    Std::Complex::Complex.new(::Math.cos(val), ::Math.sin(val))
  end

  def +(other : Std::Complex::Complex) : Std::Complex::Complex
    other + self
  end

  def -(other : Std::Complex::Complex) : Std::Complex::Complex
    Std::Complex::Complex.new(to_f64 - other.real, 0.0 - other.imag)
  end

  def *(other : Std::Complex::Complex) : Std::Complex::Complex
    other * self
  end

  def /(other : Std::Complex::Complex) : Std::Complex::Complex
    Std::Complex::Complex.new(self, 0) / other
  end
end

module ::Math
  def exp(value : Std::Complex::Complex) : Std::Complex::Complex
    r = exp(value.real)
    Std::Complex::Complex.new(r * cos(value.imag), r * sin(value.imag))
  end

  def log(value : Std::Complex::Complex) : Std::Complex::Complex
    Std::Complex::Complex.new(log(value.abs), value.phase)
  end

  def log2(value : Std::Complex::Complex) : Std::Complex::Complex
    log(value) / LOG2
  end

  def log10(value : Std::Complex::Complex) : Std::Complex::Complex
    log(value) / LOG10
  end

  def sqrt(value : Std::Complex::Complex) : Std::Complex::Complex
    r = value.abs
    re = if value.real >= 0.0
           0.5 * sqrt(2.0 * (r + value.real))
         else
           value.imag.abs / sqrt(2.0 * (r - value.real))
         end
    im = if value.real <= 0.0
           0.5 * sqrt(2.0 * (r - value.real))
         else
           value.imag.abs / sqrt(2.0 * (r + value.real))
         end
    Std::Complex::Complex.new(re, value.imag >= 0.0 ? im : 0.0 - im)
  end
end
