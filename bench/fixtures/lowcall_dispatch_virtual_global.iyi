lib LibC
  fun exit(status : Int32) : NoReturn
end

def helper(value : Int32) : Int32
  7
end

def helper(value : String) : Int32
  19
end

class Base
  def run(value : Int32 | String) : Int32
    helper(value)
  end
end

class Child < Base
end

def choose(flag : Bool) : Base
  flag ? Base.new : Child.new
end

def payload(flag : Bool) : Int32 | String
  flag ? 4 : "a"
end

if choose(false).run(payload(true)) == 7
  LibC.exit(choose(false).run(payload(false)))
end
LibC.exit(1)
