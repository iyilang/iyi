; iyi-ir 1
source_filename = "join_no_fact_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @join_no_fact_keep(i32 %x) {
entry:
  %guard = icmp slt i32 %x, 0
  br i1 %guard, label %left, label %right
left:
  br label %join
right:
  br label %join
join:
  %test = icmp sge i32 %x, 0
  ret i1 %test
}
