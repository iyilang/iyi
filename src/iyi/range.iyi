# Ranges — SPEC.md, "0.1.0", item 3.
#
# `1..10` is not syntax the prelude can decline: the compiler expands a range
# literal to `Range.new(from, to, exclusive)` (literal_expander.cr), and the
# type itself is predefined so the compiler can refer to it. What was missing
# was every method on it, so `(1..10).each` answered "wrong number of arguments
# for 'Range(B, E).new' (given 3, expected 0)" — a message about a constructor
# nobody wrote, for the second loop anybody writes.
#
# There is no `Enumerable` on it, no `step`, no reverse iteration: a range
# in this prelude counts up by one and stops.
struct Range(B, E)
  getter begin : B
  getter end : E

  def initialize(@begin : B, @end : E, @exclusive : Bool)
  end

  # `1...10` excludes its end, `1..10` includes it.
  def exclusive? : Bool
    @exclusive
  end

  # The inclusive walk stops *at* the end rather than stepping past it: with
  # `value <= @end` the last step left the type on the checked `+`, so
  # `(2147483645..2147483647).each` panicked with "arithmetic overflow" at
  # the value it was asked to yield last.
  def each(& : B -> Nil) : Nil
    value = @begin
    while value < @end
      yield value
      value = value + 1
    end
    yield value if !@exclusive && value == @end
  end

  def size : Int32
    count = 0
    each { |_| count = count + 1 }
    count
  end

  def to_a : Array(B)
    result = Array(B).new(size)
    each { |value| result << value }
    result
  end

  # The three a range is written for: a value per position, the positions
  # that answer, and the total.
  def map(& : B -> U) : Array(U) forall U
    result = Array(U).new(size)
    each { |value| result << yield value }
    result
  end

  def select(& : B -> Bool) : Array(B)
    result = [] of B
    each { |value| result << value if yield value }
    result
  end

  def sum : B
    total = @begin - @begin
    each { |value| total = total + value }
    total
  end

  # A range is a value, so two written the same way are the same range:
  # `Object#==` is identity, and `(1..3) == (1..3)` was false. `1..3` and
  # `1...3` differ, and that is the flag's whole job.
  def ==(other : self) : Bool
    @begin == other.begin && @end == other.end && @exclusive == other.exclusive?
  end

  # `when 1..5` is `(1..5) === x`: inclusion. `==` answered, and no arm matched.
  def ===(value) : Bool
    @begin <= value && (@exclusive ? value < @end : value <= @end)
  end

  # And hashing follows equality, or equal ranges would land in two slots.
  def hash : Int32
    value = (@begin.hash &* 31) &+ @end.hash
    @exclusive ? (value &* 31) &+ 1 : value &* 31
  end
end
