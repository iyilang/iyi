# X.509 certificates read and chains checked (RFC 5280), written in iyi:
# what a TLS client asks of a server's certificates.
#
#     import std/x509::{Certificate, X509, X509Error}
#
#     roots = Certificate.from_pem(File.read("/etc/ssl/certs/ca-certificates.crt")).or_panic
#     leaf = Certificate.parse(der).or_panic
#     chain = X509.verify(leaf, intermediates, roots, "example.com").or_panic
#     # the chain from leaf to root, or an X509Error saying why there is none
#
# `Certificate.parse` reads a certificate's DER through std/asn1 and its
# key through std/rsa, std/ecdsa or std/curve25519: version, serial,
# issuer and subject (kept as their DER, which is what a chain matches),
# validity, key, signature, and the extensions a chain is checked by -
# basicConstraints, keyUsage, extKeyUsage, subjectAltName's DNS names and
# IP addresses, nameConstraints, and the key identifiers. An extension
# that appears twice is refused. One that is critical and not among these
# is kept by name, and a chain through its certificate is refused: RFC
# 5280 section 4.2 says a certificate with a critical extension it does
# not understand must not be used. The signature algorithm written inside
# the signed part must be the one written outside it.
#
# `X509.verify` builds a chain from the leaf to one of the given roots,
# through the given intermediates, matching each certificate's issuer to a
# candidate's subject byte for byte and trying every candidate that
# matches before giving up, ten certificates at most. A certificate
# checked as an issuer must be valid at the time given, a CA by its
# basicConstraints, allowed keyCertSign if it carries keyUsage, within its
# pathLenConstraint, allowed the chain's purpose if it carries extKeyUsage
# (serverAuth for a server's certificate, the default; clientAuth for a
# client's, `X509Purpose::Client`), and the leaf's names must fall inside
# its nameConstraints; it must have signed the certificate below it. Name
# constraints are checked for DNS names and IP addresses; a constraint of
# any other kind refuses the chain rather than being passed over. A DNS
# name is judged by a constraint as a host is matched to it, without its
# final dot, and a constraint or a name under one with an empty label
# refuses the chain. The leaf must be valid at that time, not a CA (a
# CA's certificate is not a server's, as the Web PKI's verifiers hold, nor
# a client's), allowed the purpose if it carries extKeyUsage, and, when a
# host is given, name it.
#
# A host is matched against subjectAltName only, never the subject's
# common name, as browsers and RFC 6125 have it: a DNS name exactly,
# without regard to case or a final dot, or as `*.rest` where the `*` is
# the whole of the leftmost label and stands for exactly one; an IP
# address, v4 or v6, against the iPAddress entries.
#
# Signatures: RSA PKCS #1 v1.5 and PSS, and ECDSA, under SHA-256, SHA-384
# and SHA-512, and Ed25519 (RFC 8410: the key's and the signature's
# AlgorithmIdentifier carry no parameters at all). A certificate signed
# under SHA-1 is refused, as every browser refuses one, and so is a chain
# with an RSA key under 2048 bits anywhere in it, root included (see
# `X509::MIN_RSA_BITS` for how OpenSSL's level 2 compares). A root's own
# signature is not checked: a root is trusted for being in the store, not
# for what it says about itself.
#
# Pure computation: std/asn1, std/rsa, std/ecdsa, std/curve25519,
# std/base64 for PEM and std/idna for a host written in Unicode.

module std/x509

import std/asn1::{Der, DerValue, DerTag, Asn1Error}
import std/rsa::{RsaPublicKey, RsaHash, RsaError}
import std/ecdsa::{EcdsaPublicKey, EcdsaHash, EcdsaError}
import std/curve25519::{Ed25519PublicKey, CurveError}
import std/time::{Time}
import std/base64::{Base64}
import std/idna::{IDNA, IdnaError}

# What reading a certificate, or checking a chain, answers when it fails.
pub struct X509Error
  getter message : String

  def initialize(message : String)
    @message = "x509: #{message}"
  end

  def to_s : String
    @message
  end
end

impl Error for X509Error
  def message : String
    @message
  end
end

pub struct Certificate
  # The whole certificate as it was read, and its signed part.
  getter raw : Array(UInt8)
  getter tbs : Array(UInt8)
  getter version : Int32
  # The serial number's two's-complement bytes, as written.
  getter serial : Array(UInt8)
  # Issuer and subject as their DER: two names are the same name when
  # these are the same bytes.
  getter issuer : Array(UInt8)
  getter subject : Array(UInt8)
  # The subject and issuer written out for a person, `CN=..., O=...`.
  getter subject_name : String
  getter issuer_name : String
  getter not_before : Time
  getter not_after : Time
  getter public_key : RsaPublicKey | EcdsaPublicKey | Ed25519PublicKey
  # The signature algorithm's OID, and the signature.
  getter signature_algorithm : String
  getter signature : Array(UInt8)
  # basicConstraints: whether it was present, cA, and pathLenConstraint.
  getter basic_constraints : Bool
  getter ca : Bool
  getter path_length : Int32?
  # keyUsage's bits, bit 0 digitalSignature to bit 8 decipherOnly; nil
  # when the extension is absent.
  getter key_usage : Int32?
  # extKeyUsage's OIDs; nil when the extension is absent.
  getter extended_key_usage : Array(String)?
  # subjectAltName's dNSName and iPAddress entries.
  getter dns_names : Array(String)
  getter ip_addresses : Array(Array(UInt8))
  # nameConstraints: DNS names and IP ranges (address and mask), and
  # whether a constraint of any other kind is there.
  getter permitted_dns : Array(String)
  getter excluded_dns : Array(String)
  getter permitted_ips : Array(Array(UInt8))
  getter excluded_ips : Array(Array(UInt8))
  getter other_constraints : Bool
  getter subject_key_id : Array(UInt8)?
  getter authority_key_id : Array(UInt8)?
  # Critical extensions this does not understand, by OID.
  getter unhandled_critical : Array(String)
  @signature_parameters : DerValue?

  # keyUsage bits (RFC 5280 section 4.2.1.3), counted from the first.
  KEY_DIGITAL_SIGNATURE = 0
  KEY_CERT_SIGN         = 5

  def initialize(@raw : Array(UInt8), @tbs : Array(UInt8), @version : Int32, @serial : Array(UInt8),
                 @issuer : Array(UInt8), @subject : Array(UInt8), @subject_name : String, @issuer_name : String,
                 @not_before : Time, @not_after : Time, @public_key : RsaPublicKey | EcdsaPublicKey | Ed25519PublicKey,
                 @signature_algorithm : String, @signature_parameters : DerValue?, @signature : Array(UInt8),
                 extensions : X509Extensions)
    @basic_constraints = extensions.basic_constraints
    @ca = extensions.ca
    @path_length = extensions.path_length
    @key_usage = extensions.key_usage
    @extended_key_usage = extensions.extended_key_usage
    @dns_names = extensions.dns_names
    @ip_addresses = extensions.ip_addresses
    @permitted_dns = extensions.permitted_dns
    @excluded_dns = extensions.excluded_dns
    @permitted_ips = extensions.permitted_ips
    @excluded_ips = extensions.excluded_ips
    @other_constraints = extensions.other_constraints
    @subject_key_id = extensions.subject_key_id
    @authority_key_id = extensions.authority_key_id
    @unhandled_critical = extensions.unhandled_critical
  end

  # The certificate *der* holds (RFC 5280 section 4.1).
  def self.parse(der : Array(UInt8)) : Certificate | X509Error
    outer = X509Asn1.values(X509Asn1.value(Der.parse(der))!.sequence)!
    return X509Error.new("a Certificate of #{outer.size} values, not 3") unless outer.size == 3
    tbs = X509Asn1.values(outer[0].sequence)!
    at = 0
    version = 1
    if tbs.size > 0 && tbs[0].context?(0)
      number = X509Asn1.int(X509Asn1.value(tbs[0].explicit(0))!.integer)!
      return X509Error.new("a certificate of version #{number + 1}, past 3") unless number >= 0 && number <= 2
      version = (number + 1).to_i32
      at = 1
    end
    return X509Error.new("a TBSCertificate of #{tbs.size} values, under the #{at + 6} it needs") if tbs.size < at + 6
    serial = X509Asn1.bytes(tbs[at].integer_bytes)!
    inner_algorithm = tbs[at + 1]
    outer_algorithm = outer[1]
    unless inner_algorithm.raw == outer_algorithm.raw
      return X509Error.new("the signature algorithm signed differs from the one the signature is under")
    end
    algorithm = X509Asn1.values(outer_algorithm.sequence)!
    return X509Error.new("an AlgorithmIdentifier with no algorithm") if algorithm.empty?
    signature_algorithm = X509Asn1.text(algorithm[0].oid)!
    parameters = algorithm.size > 1 ? algorithm[1] : nil
    issuer = tbs[at + 2]
    subject = tbs[at + 4]
    issuer_name = X509Names.describe(issuer)!
    subject_name = X509Names.describe(subject)!
    validity = X509Asn1.values(tbs[at + 3].sequence)!
    return X509Error.new("a Validity of #{validity.size} values, not 2") unless validity.size == 2
    not_before = X509Asn1.time(validity[0].time)!
    not_after = X509Asn1.time(validity[1].time)!
    key = X509Keys.read(tbs[at + 5])!
    extensions = X509Extensions.new
    rest = at + 6
    # RFC 5280 section 4.1: issuerUniqueID [1], subjectUniqueID [2] and
    # extensions [3], each at most once and in that order. A second
    # extensions block was read on top of the first, so a certificate
    # whose second block said cA where its first did not was a CA here and
    # not to a reader that stopped at the first; Python's cryptography and
    # OpenSSL refuse to read one at all.
    last = 0
    while rest < tbs.size
      field = tbs[rest]
      tag = field.context?(1) ? 1 : (field.context?(2) ? 2 : (field.context?(3) ? 3 : 0))
      return X509Error.new("#{field.describe} where the TBSCertificate ends") if tag == 0
      return X509Error.new("#{field.describe} after [#{last}], where RFC 5280 has each of [1], [2] and [3] once and in order") unless tag > last
      last = tag
      if tag < 3
        return X509Error.new("a unique identifier in a version 1 certificate") if version < 2
      else
        return X509Error.new("extensions in a version #{version} certificate") unless version == 3
        extensions.read(X509Asn1.value(field.explicit(3))!)!
      end
      rest = rest + 1
    end
    signature = X509Asn1.bytes(outer[2].bit_string)!
    Certificate.new(der, outer[0].raw, version, serial, issuer.raw, subject.raw, subject_name, issuer_name,
      not_before, not_after, key, signature_algorithm, parameters, signature, extensions)
  end

  # Every CERTIFICATE block in a PEM text, read; the first one that is not
  # a certificate is the answer.
  def self.from_pem(text : String) : Array(Certificate) | X509Error
    found = [] of Certificate
    X509Pem.blocks(text)!.each do |der|
      found << Certificate.parse(der)!
    end
    found
  end

  # The DER of every CERTIFICATE block in a PEM text, unread: a store
  # can keep what it can read and count the rest.
  def self.pem_blocks(text : String) : Array(Array(UInt8)) | X509Error
    X509Pem.blocks(text)
  end

  def valid_at?(time : Time) : Bool
    @not_before <= time && time <= @not_after
  end

  # Whether *issuer*'s key made this certificate's signature.
  def signed_by?(issuer : Certificate) : Bool
    signature_error(issuer).nil?
  end

  # Why *issuer*'s key did not make this certificate's signature, or nil.
  def signature_error(issuer : Certificate) : String?
    key = issuer.public_key
    case @signature_algorithm
    when X509Oids::SHA256_RSA, X509Oids::SHA384_RSA, X509Oids::SHA512_RSA
      return "#{@signature_algorithm} with parameters that are not NULL" unless X509Keys.null_or_absent?(@signature_parameters)
      return "an RSA signature under #{issuer.subject_name}'s #{X509Keys.kind(key)} key" unless key.is_a?(RsaPublicKey)
      hash = case @signature_algorithm
             when X509Oids::SHA256_RSA then RsaHash::SHA256
             when X509Oids::SHA384_RSA then RsaHash::SHA384
             else                           RsaHash::SHA512
             end
      return nil if key.verify_pkcs1v15(hash, @tbs, @signature)
    when X509Oids::RSA_PSS
      return "an RSA signature under #{issuer.subject_name}'s #{X509Keys.kind(key)} key" unless key.is_a?(RsaPublicKey)
      parameters = @signature_parameters
      return "RSASSA-PSS without its parameters" unless parameters
      pss = X509Keys.pss(parameters)
      return pss if pss.is_a?(String)
      return nil if key.verify_pss(pss[0], @tbs, @signature, salt_length: pss[1])
    when X509Oids::ECDSA_SHA256, X509Oids::ECDSA_SHA384, X509Oids::ECDSA_SHA512
      return "#{@signature_algorithm} with parameters" unless @signature_parameters.nil?
      return "an ECDSA signature under #{issuer.subject_name}'s #{X509Keys.kind(key)} key" unless key.is_a?(EcdsaPublicKey)
      hash = case @signature_algorithm
             when X509Oids::ECDSA_SHA256 then EcdsaHash::SHA256
             when X509Oids::ECDSA_SHA384 then EcdsaHash::SHA384
             else                             EcdsaHash::SHA512
             end
      return nil if key.verify(hash, @tbs, @signature)
    when X509Oids::ED25519
      return "#{@signature_algorithm} with parameters" unless @signature_parameters.nil?
      return "an Ed25519 signature under #{issuer.subject_name}'s #{X509Keys.kind(key)} key" unless key.is_a?(Ed25519PublicKey)
      return nil if key.verify(@tbs, @signature)
    when X509Oids::SHA1_RSA, X509Oids::ECDSA_SHA1
      return "#{@subject_name} is signed under SHA-1, which is refused"
    else
      return "#{@subject_name} is signed under #{@signature_algorithm}, which this does not check"
    end
    "#{@subject_name}'s signature is not #{issuer.subject_name}'s"
  end

  # Whether *host* is a name this certificate is for: a DNS name or an IP
  # address in its subjectAltName (see the module's header).
  def matches_host?(host : String) : Bool
    name = host
    name = name[1, name.size - 2] if name.starts_with?("[") && name.ends_with?("]")
    address = X509Names.ip(name)
    return @ip_addresses.any? { |a| a == address } if address
    name = name.downcase
    name = name[0, name.size - 1] if name.ends_with?(".")
    return false if name.empty?
    unless name.bytesize == name.size
      ascii = IDNA.to_ascii(name)
      return false if ascii.is_a?(IdnaError)
      name = ascii.downcase
    end
    @dns_names.any? { |pattern| X509Names.dns_matches?(pattern, name) }
  end
end

pub struct X509
  MAX_CHAIN = 10
  # Signature checks one search for a chain may make, whatever the chain:
  # a peer's intermediates under one name, each signing the others, made
  # the search try every order of them - seven took 13,700 checks, and a
  # Certificate message holds far more than seven. The other library's
  # path builder in Go stops at the same 100.
  MAX_SIGNATURE_CHECKS = 100
  # An RSA key under this many bits is refused anywhere in a chain, leaf
  # to root: the floor std/rsa signs at and the CA/Browser Forum's for a
  # certificate's key. OpenSSL at its security level 2 (`openssl verify
  # -auth_level 2`, where Debian's and Ubuntu's builds start) refuses a
  # 1024- or 1536-bit key at any depth as this does; it judges by NIST SP
  # 800-56B's strength estimate, which took 1990 bits and up when measured
  # (OpenSSL 3.5.5), so the two part only between 1990 and 2047 bits.
  # std/rsa itself reads keys down to 1024 bits.
  MIN_RSA_BITS = 2048

  # The DER of every block labelled *label* in a PEM text - `"CERTIFICATE"`
  # or `"PRIVATE KEY"` - each checked to be base64 before it is decoded.
  def self.pem(text : String, label : String) : Array(Array(UInt8)) | X509Error
    X509Pem.blocks(text, label)
  end

  # The chain from *leaf* to one of *roots*, through *intermediates*, for
  # *host* (nil: any) at *now* - leaf first, root last - or why there is
  # none. *purpose* is what the leaf is for: a server's certificate
  # (serverAuth, the default) or a client's (clientAuth), each certificate
  # that carries extKeyUsage allowing it. See the module's header for what
  # else is checked.
  def self.verify(leaf : Certificate, intermediates : Array(Certificate), roots : Array(Certificate),
                  host : String? = nil, now : Time = Time.utc, purpose : X509Purpose = X509Purpose::Server) : Array(Certificate) | X509Error
    problem = leaf_error(leaf, host, now, purpose)
    return X509Error.new(problem) if problem
    failures = [] of String
    checks = [0]
    chain = grow([leaf], intermediates, roots, now, failures, purpose, checks)
    return chain if chain
    if checks[0] > MAX_SIGNATURE_CHECKS
      return X509Error.new("no chain from #{leaf.subject_name} within #{MAX_SIGNATURE_CHECKS} signature checks")
    end
    return X509Error.new(failures[0]) unless failures.empty?
    X509Error.new("no certificate here issued #{leaf.issuer_name}, the issuer of #{leaf.subject_name}")
  end

  private def self.leaf_error(leaf : Certificate, host : String?, now : Time, purpose : X509Purpose) : String?
    return "#{leaf.subject_name} is not valid at #{now}: from #{leaf.not_before} to #{leaf.not_after}" unless leaf.valid_at?(now)
    weak = weak_key(leaf)
    return weak if weak
    return "#{leaf.subject_name} carries critical extension #{leaf.unhandled_critical[0]}, which this does not understand" unless leaf.unhandled_critical.empty?
    return "#{leaf.subject_name} is not allowed #{purpose.usage}" unless allowed?(leaf, purpose)
    return "#{leaf.subject_name} is a CA certificate, not a #{purpose.holder}'s" if leaf.ca
    if host && !leaf.matches_host?(host)
      return "#{leaf.subject_name} is not valid for #{host}: it names #{(leaf.dns_names + leaf.ip_addresses.map { |a| X509Names.ip_text(a) }).join(", ")}"
    end
    nil
  end

  private def self.allowed?(certificate : Certificate, purpose : X509Purpose) : Bool
    usages = certificate.extended_key_usage
    return true unless usages
    usages.includes?(purpose.oid) || usages.includes?(X509Oids::ANY_EXTENDED_KEY_USAGE)
  end

  # Why *certificate*'s key is too weak to be in a chain, or nil.
  private def self.weak_key(certificate : Certificate) : String?
    key = certificate.public_key
    return nil unless key.is_a?(RsaPublicKey) && key.bits < MIN_RSA_BITS
    "#{certificate.subject_name}'s RSA key is #{key.bits} bits, under the #{MIN_RSA_BITS} a chain is held to"
  end

  # The chain grown from *chain* to a root, trying every issuer that
  # matches, or nil; why each candidate failed goes to *failures*. Each
  # candidate weighed counts in *checks*, and past `MAX_SIGNATURE_CHECKS`
  # the search gives up.
  private def self.grow(chain : Array(Certificate), intermediates : Array(Certificate), roots : Array(Certificate),
                        now : Time, failures : Array(String), purpose : X509Purpose, checks : Array(Int32)) : Array(Certificate)?
    child = chain[chain.size - 1]
    roots.each do |root|
      next unless root.subject == child.issuer
      checks[0] += 1
      return nil if checks[0] > MAX_SIGNATURE_CHECKS
      problem = issuer_error(child, root, chain, now, purpose)
      if problem
        failures << problem
      else
        return chain + [root]
      end
    end
    return nil if chain.size + 1 >= MAX_CHAIN
    intermediates.each do |candidate|
      next unless candidate.subject == child.issuer
      next if chain.any? { |c| c.raw == candidate.raw }
      checks[0] += 1
      return nil if checks[0] > MAX_SIGNATURE_CHECKS
      problem = issuer_error(child, candidate, chain, now, purpose)
      if problem
        failures << problem
        next
      end
      found = grow(chain + [candidate], intermediates, roots, now, failures, purpose, checks)
      return found if found
      return nil if checks[0] > MAX_SIGNATURE_CHECKS
    end
    nil
  end

  # Why *issuer* cannot be the next certificate above *child*, the last of
  # *chain*, or nil.
  private def self.issuer_error(child : Certificate, issuer : Certificate, chain : Array(Certificate), now : Time, purpose : X509Purpose) : String?
    name = issuer.subject_name
    return "#{name} is not valid at #{now}: from #{issuer.not_before} to #{issuer.not_after}" unless issuer.valid_at?(now)
    weak = weak_key(issuer)
    return weak if weak
    return "#{name} carries critical extension #{issuer.unhandled_critical[0]}, which this does not understand" unless issuer.unhandled_critical.empty?
    return "#{name} is not a CA" unless issuer.basic_constraints && issuer.ca
    usage = issuer.key_usage
    if usage && (usage >> Certificate::KEY_CERT_SIGN) & 1 == 0
      return "#{name} is not allowed to sign certificates"
    end
    length = issuer.path_length
    if length && chain.size - 1 > length
      return "#{name} allows #{length} CA certificates under it, and the chain has #{chain.size - 1}"
    end
    return "#{name} is not allowed #{purpose.usage}" unless allowed?(issuer, purpose)
    problem = constraint_error(chain[0], issuer)
    return problem if problem
    child.signature_error(issuer)
  end

  private def self.constraint_error(leaf : Certificate, issuer : Certificate) : String?
    name = issuer.subject_name
    return "#{name} constrains names of a kind this does not check" if issuer.other_constraints
    unless issuer.permitted_dns.empty? && issuer.excluded_dns.empty?
      # A constraint with an empty label ("evil.example.") names no
      # subtree; read as a suffix it holds nothing, and an excluded one
      # held nothing out. Refused, as Python's verifier refuses it.
      (issuer.permitted_dns + issuer.excluded_dns).each do |c|
        return "#{name} constrains names by #{c.inspect}, which is no name" unless c.empty? || X509Names.labels?(c, leading_dot: true)
      end
    end
    leaf.dns_names.each do |written|
      next if issuer.permitted_dns.empty? && issuer.excluded_dns.empty?
      # Judged as `matches_host?` reads it, without its final dot: the
      # name "evil.example." is the host evil.example to the matcher, and
      # was outside a constraint excluding evil.example while the two
      # read it differently.
      dns = X509Names.unrooted(written)
      return "#{written} is no host name for #{name}'s constraints to judge" unless X509Names.labels?(dns)
      unless issuer.permitted_dns.empty? || issuer.permitted_dns.any? { |c| X509Names.within?(dns, c) }
        return "#{written} is outside the names #{name} permits"
      end
      # A wildcard names every host one label over its rest, so one of
      # those excluded holds the whole name out, whatever host it is
      # matched to - as Python's verifier does, and Go's since it fixed
      # the same gap (CVE-2025-61727). "*.example.com" under an exclusion
      # of bad.example.com held for bad.example.com before.
      if issuer.excluded_dns.any? { |c| X509Names.within?(dns, c) || X509Names.dns_matches?(dns, c) }
        return "#{written} is among the names #{name} excludes"
      end
    end
    leaf.ip_addresses.each do |ip|
      unless issuer.permitted_ips.empty? || issuer.permitted_ips.any? { |c| X509Names.ip_within?(ip, c) }
        return "#{X509Names.ip_text(ip)} is outside the addresses #{name} permits"
      end
      if issuer.excluded_ips.any? { |c| X509Names.ip_within?(ip, c) }
        return "#{X509Names.ip_text(ip)} is among the addresses #{name} excludes"
      end
    end
    nil
  end
end

# The OIDs read here.
struct X509Oids
  SHA1_RSA               = "1.2.840.113549.1.1.5"
  SHA256_RSA             = "1.2.840.113549.1.1.11"
  SHA384_RSA             = "1.2.840.113549.1.1.12"
  SHA512_RSA             = "1.2.840.113549.1.1.13"
  RSA_PSS                = "1.2.840.113549.1.1.10"
  MGF1                   = "1.2.840.113549.1.1.8"
  ECDSA_SHA1             = "1.2.840.10045.4.1"
  ECDSA_SHA256           = "1.2.840.10045.4.3.2"
  ECDSA_SHA384           = "1.2.840.10045.4.3.3"
  ECDSA_SHA512           = "1.2.840.10045.4.3.4"
  SHA256                 = "2.16.840.1.101.3.4.2.1"
  SHA384                 = "2.16.840.1.101.3.4.2.2"
  SHA512                 = "2.16.840.1.101.3.4.2.3"
  RSA_ENCRYPTION         = "1.2.840.113549.1.1.1"
  EC_PUBLIC_KEY          = "1.2.840.10045.2.1"
  ED25519                = "1.3.101.112"
  SUBJECT_KEY_ID         = "2.5.29.14"
  KEY_USAGE              = "2.5.29.15"
  SUBJECT_ALT_NAME       = "2.5.29.17"
  BASIC_CONSTRAINTS      = "2.5.29.19"
  NAME_CONSTRAINTS       = "2.5.29.30"
  CERTIFICATE_POLICIES   = "2.5.29.32"
  AUTHORITY_KEY_ID       = "2.5.29.35"
  EXT_KEY_USAGE          = "2.5.29.37"
  SERVER_AUTH            = "1.3.6.1.5.5.7.3.1"
  CLIENT_AUTH            = "1.3.6.1.5.5.7.3.2"
  ANY_EXTENDED_KEY_USAGE = "2.5.29.37.0"
end

# What a chain is checked for: a TLS server's certificate or a client's
# (RFC 5280 section 4.2.1.12's id-kp-serverAuth and id-kp-clientAuth).
pub enum X509Purpose
  Server
  Client

  def oid : String
    self == X509Purpose::Server ? X509Oids::SERVER_AUTH : X509Oids::CLIENT_AUTH
  end

  # The usage's name, as a sentence says it.
  def usage : String
    self == X509Purpose::Server ? "serverAuth" : "clientAuth"
  end

  def holder : String
    self == X509Purpose::Server ? "server" : "client"
  end
end

# The extensions of one certificate, read (RFC 5280 section 4.2).
class X509Extensions
  property basic_constraints : Bool = false
  property ca : Bool = false
  property path_length : Int32? = nil
  property key_usage : Int32? = nil
  property extended_key_usage : Array(String)? = nil
  property dns_names : Array(String) = [] of String
  property ip_addresses : Array(Array(UInt8)) = [] of Array(UInt8)
  property permitted_dns : Array(String) = [] of String
  property excluded_dns : Array(String) = [] of String
  property permitted_ips : Array(Array(UInt8)) = [] of Array(UInt8)
  property excluded_ips : Array(Array(UInt8)) = [] of Array(UInt8)
  property other_constraints : Bool = false
  property subject_key_id : Array(UInt8)? = nil
  property authority_key_id : Array(UInt8)? = nil
  property unhandled_critical : Array(String) = [] of String

  def initialize
  end

  def read(value : DerValue) : Nil | X509Error
    seen = [] of String
    X509Asn1.values(value.sequence)!.each do |extension|
      fields = X509Asn1.values(extension.sequence)!
      return X509Error.new("an Extension of #{fields.size} values") unless fields.size == 2 || fields.size == 3
      oid = X509Asn1.text(fields[0].oid)!
      return X509Error.new("extension #{oid} appears twice") if seen.includes?(oid)
      seen << oid
      critical = fields.size == 3 ? X509Asn1.bool(fields[1].boolean)! : false
      body = X509Asn1.bytes(fields[fields.size - 1].octet_string)!
      inner = X509Asn1.value(Der.parse(body))!
      case oid
      when X509Oids::BASIC_CONSTRAINTS then read_basic_constraints(inner)!
      when X509Oids::KEY_USAGE         then read_key_usage(inner)!
      when X509Oids::EXT_KEY_USAGE
        usages = [] of String
        X509Asn1.values(inner.sequence)!.each { |u| usages << X509Asn1.text(u.oid)! }
        return X509Error.new("an empty extKeyUsage") if usages.empty?
        @extended_key_usage = usages
      when X509Oids::SUBJECT_ALT_NAME then read_alt_names(inner)!
      when X509Oids::NAME_CONSTRAINTS then read_name_constraints(inner)!
      when X509Oids::SUBJECT_KEY_ID   then @subject_key_id = X509Asn1.bytes(inner.octet_string)!
      when X509Oids::AUTHORITY_KEY_ID
        X509Asn1.values(inner.sequence)!.each do |field|
          @authority_key_id = field.content if field.context?(0)
        end
      when X509Oids::CERTIFICATE_POLICIES
        X509Asn1.values(inner.sequence)!
      else
        @unhandled_critical << oid if critical
      end
    end
    nil
  end

  private def read_basic_constraints(inner : DerValue) : Nil | X509Error
    fields = X509Asn1.values(inner.sequence)!
    at = 0
    @basic_constraints = true
    if at < fields.size && fields[at].universal?(DerTag::BOOLEAN)
      @ca = X509Asn1.bool(fields[at].boolean)!
      at = at + 1
    end
    if at < fields.size
      length = X509Asn1.int(fields[at].integer)!
      return X509Error.new("a pathLenConstraint of #{length}") if length < 0 || length > 1000
      @path_length = length.to_i32
      at = at + 1
    end
    return X509Error.new("basicConstraints of #{fields.size} values") unless at == fields.size
    nil
  end

  private def read_key_usage(inner : DerValue) : Nil | X509Error
    bits = X509Asn1.bits(inner.bit_string_bits)!
    usage = 0
    bits[0].each_with_index do |byte, i|
      8.times do |k|
        usage = usage | (1 << (i * 8 + k)) if (byte >> (7 - k)) & 1_u8 == 1_u8 && i * 8 + k < 31
      end
    end
    @key_usage = usage
    nil
  end

  private def read_alt_names(inner : DerValue) : Nil | X509Error
    X509Asn1.values(inner.sequence)!.each do |name|
      if name.context?(2) && !name.constructed?
        @dns_names << X509Names.ascii(name.content).downcase
      elsif name.context?(7) && !name.constructed?
        address = name.content
        return X509Error.new("an iPAddress of #{address.size} bytes") unless address.size == 4 || address.size == 16
        @ip_addresses << address
      end
    end
    nil
  end

  private def read_name_constraints(inner : DerValue) : Nil | X509Error
    X509Asn1.values(inner.sequence)!.each do |subtrees|
      permitted = subtrees.context?(0)
      return X509Error.new("nameConstraints holding #{subtrees.describe}") unless permitted || subtrees.context?(1)
      X509Asn1.values(subtrees.children)!.each do |subtree|
        fields = X509Asn1.values(subtree.sequence)!
        return X509Error.new("an empty GeneralSubtree") if fields.empty?
        base = fields[0]
        if fields.size > 1
          # minimum and maximum: RFC 5280 says absent; a range is a kind
          # of constraint this does not check.
          @other_constraints = true
        elsif base.context?(2) && !base.constructed?
          dns = X509Names.ascii(base.content).downcase
          permitted ? @permitted_dns << dns : @excluded_dns << dns
        elsif base.context?(7) && !base.constructed?
          range = base.content
          return X509Error.new("an iPAddress constraint of #{range.size} bytes") unless range.size == 8 || range.size == 32
          # RFC 5280 section 4.2.1.10 writes the range as CIDR (RFC 4632):
          # its mask is ones, then zeros. One with a hole in it was taken
          # and matched bit by bit, a range no CIDR reader sees; Go
          # refuses it, as Python's cryptography does.
          unless X509Names.prefix_mask?(range[range.size // 2, range.size // 2])
            return X509Error.new("an iPAddress constraint whose mask is not a CIDR prefix")
          end
          permitted ? @permitted_ips << range : @excluded_ips << range
        else
          @other_constraints = true
        end
      end
    end
    nil
  end
end

# Keys from a SubjectPublicKeyInfo, and RSASSA-PSS's parameters.
struct X509Keys
  def self.read(spki : DerValue) : RsaPublicKey | EcdsaPublicKey | Ed25519PublicKey | X509Error
    fields = X509Asn1.values(spki.sequence)!
    return X509Error.new("a SubjectPublicKeyInfo of #{fields.size} values, not 2") unless fields.size == 2
    algorithm = X509Asn1.values(fields[0].sequence)!
    return X509Error.new("an AlgorithmIdentifier with no algorithm") if algorithm.empty?
    oid = X509Asn1.text(algorithm[0].oid)!
    case oid
    when X509Oids::RSA_ENCRYPTION
      key = RsaPublicKey.from_spki(spki)
      return X509Error.new(key.message) if key.is_a?(RsaError)
      key
    when X509Oids::EC_PUBLIC_KEY
      key = EcdsaPublicKey.from_spki(spki)
      return X509Error.new(key.message) if key.is_a?(EcdsaError)
      key
    when X509Oids::ED25519
      # RFC 8410 section 3: the parameters MUST be absent.
      return X509Error.new("an Ed25519 key with parameters, which RFC 8410 says are absent") unless algorithm.size == 1
      key = Ed25519PublicKey.from_bytes(X509Asn1.bytes(fields[1].bit_string)!)
      return X509Error.new(key.message) if key.is_a?(CurveError)
      key
    else
      X509Error.new("a key for #{oid}, which this does not read")
    end
  end

  # A key's kind, for a sentence.
  def self.kind(key : RsaPublicKey | EcdsaPublicKey | Ed25519PublicKey) : String
    case key
    when RsaPublicKey   then "RSA"
    when EcdsaPublicKey then "ECDSA"
    else                     "Ed25519"
    end
  end

  def self.null_or_absent?(parameters : DerValue?) : Bool
    return true if parameters.nil?
    parameters.universal?(DerTag::NULL) && !parameters.null.is_a?(Asn1Error)
  end

  # RSASSA-PSS-params (RFC 4055 section 3.1): the hash, MGF1 over the same
  # hash, the salt's length and a trailer of 1. SHA-1, the default, is
  # refused.
  def self.pss(parameters : DerValue) : {RsaHash, Int32} | String
    fields = parameters.sequence
    return "RSASSA-PSS parameters that are not a SEQUENCE" if fields.is_a?(Asn1Error)
    hash = nil
    mgf_hash = nil
    salt = 20
    fields.each do |field|
      inner = field.context?(0) || field.context?(1) || field.context?(2) || field.context?(3) ? field.children : nil
      return "RSASSA-PSS parameters holding #{field.describe}" if inner.nil? || inner.is_a?(Asn1Error) || inner.size != 1
      value = inner[0]
      if field.context?(0)
        hash = digest_named(value)
        return "RSASSA-PSS under a hash this does not take" if hash.nil?
      elsif field.context?(1)
        mgf = value.sequence
        return "an RSASSA-PSS mask that is not MGF1" if mgf.is_a?(Asn1Error) || mgf.size != 2 || mgf[0].oid != X509Oids::MGF1
        mgf_hash = digest_named(mgf[1])
      elsif field.context?(2)
        length = value.integer
        return "an RSASSA-PSS salt length that is not a length" if length.is_a?(Asn1Error) || length < 0 || length > 1024
        salt = length.to_i32
      else
        trailer = value.integer
        return "an RSASSA-PSS trailer that is not 1" unless trailer == 1_i64
      end
    end
    return "RSASSA-PSS under SHA-1, which is refused" if hash.nil?
    return "RSASSA-PSS whose mask is under another hash" unless mgf_hash == hash
    {hash, salt}
  end

  private def self.digest_named(algorithm : DerValue) : RsaHash?
    fields = algorithm.sequence
    return nil if fields.is_a?(Asn1Error) || fields.empty?
    return nil if fields.size > 1 && !null_or_absent?(fields[1])
    case fields[0].oid
    when X509Oids::SHA256 then RsaHash::SHA256
    when X509Oids::SHA384 then RsaHash::SHA384
    when X509Oids::SHA512 then RsaHash::SHA512
    else                       nil
    end
  end
end

# Names: a Name written for a person, host names and IP addresses matched.
struct X509Names
  # `CN=..., O=...`, the attributes in the order written.
  def self.describe(name : DerValue) : String | X509Error
    parts = [] of String
    X509Asn1.values(name.sequence)!.each do |rdn|
      attributes = X509Asn1.values(rdn.set)!
      # RelativeDistinguishedName ::= SET SIZE (1..MAX) (RFC 5280
      # appendix A.1): an empty one was read as no attribute at all.
      return X509Error.new("an empty RelativeDistinguishedName") if attributes.empty?
      attributes.each do |attribute|
        fields = X509Asn1.values(attribute.sequence)!
        return X509Error.new("an AttributeTypeAndValue of #{fields.size} values") unless fields.size == 2
        oid = X509Asn1.text(fields[0].oid)!
        text = fields[1].string
        value = text.is_a?(Asn1Error) ? "#" + fields[1].describe : text
        parts << "#{short_name(oid)}=#{value}"
      end
    end
    parts.join(", ")
  end

  def self.short_name(oid : String) : String
    case oid
    when "2.5.4.3"  then "CN"
    when "2.5.4.6"  then "C"
    when "2.5.4.7"  then "L"
    when "2.5.4.8"  then "ST"
    when "2.5.4.10" then "O"
    when "2.5.4.11" then "OU"
    else                 oid
    end
  end

  # Whether *mask* is ones, then zeros, as a CIDR prefix is.
  def self.prefix_mask?(mask : Array(UInt8)) : Bool
    zeros = false
    mask.each do |b|
      8.times do |k|
        one = (b >> (7 - k)) & 1_u8 == 1_u8
        return false if one && zeros
        zeros = true unless one
      end
    end
    true
  end

  # The bytes as text where every one is ASCII, else a text that matches
  # no host: a dNSName is IA5String.
  def self.ascii(bytes : Array(UInt8)) : String
    return "\u{FFFD}" if bytes.any? { |b| b >= 0x80_u8 }
    String.build { |io| bytes.each { |b| io << b.to_i32.chr } }
  end

  # *host*, lowercase and in ASCII, against one dNSName.
  def self.dns_matches?(pattern : String, host : String) : Bool
    pattern = unrooted(pattern)
    if pattern.starts_with?("*.")
      rest = pattern[2, pattern.size - 2]
      return false if rest.includes?("*") || !rest.includes?(".")
      dot = host.index('.')
      return false if dot.nil? || dot == 0
      return host[dot + 1, host.size - dot - 1] == rest
    end
    return false if pattern.includes?("*")
    pattern == host
  end

  # A dNSName as `dns_matches?` reads it: its one final dot dropped.
  def self.unrooted(name : String) : String
    name.ends_with?(".") ? name[0, name.size - 1] : name
  end

  # Whether *name* is labels joined by dots, none of them empty - after a
  # leading dot, where *leading_dot* allows one (a constraint's way of
  # naming what is under a domain and not the domain).
  def self.labels?(name : String, leading_dot : Bool = false) : Bool
    name = name[1, name.size - 1] if leading_dot && name.starts_with?(".")
    !name.empty? && !name.starts_with?(".") && !name.ends_with?(".") && !name.includes?("..")
  end

  # Whether a DNS name falls under a dNSName constraint: the name itself
  # or one with labels added on the left; a constraint written with a
  # leading dot only the latter.
  def self.within?(name : String, constraint : String) : Bool
    return true if constraint.empty?
    return name.ends_with?(constraint) && name.size > constraint.size if constraint.starts_with?(".")
    name == constraint || name.ends_with?("." + constraint)
  end

  # Whether an address falls in an address-and-mask constraint of its own
  # length.
  def self.ip_within?(address : Array(UInt8), range : Array(UInt8)) : Bool
    return false unless range.size == address.size * 2
    address.each_with_index do |byte, i|
      mask = range[address.size + i]
      return false unless byte & mask == range[i] & mask
    end
    true
  end

  def self.ip_text(address : Array(UInt8)) : String
    return address.map(&.to_s).join(".") if address.size == 4
    groups = [] of String
    i = 0
    while i < address.size
      groups << ((address[i].to_i32 << 8) | address[i + 1].to_i32).to_s(16)
      i = i + 2
    end
    groups.join(":")
  end

  # *text* as an IPv4 address in dotted decimal or an IPv6 address
  # (RFC 4291 section 2.2, `::` and a final dotted quad included), or nil
  # for anything else.
  def self.ip(text : String) : Array(UInt8)?
    return nil unless text.bytesize == text.size
    return ipv6(text) if text.includes?(":")
    ipv4(text)
  end

  def self.ipv4(text : String) : Array(UInt8)?
    parts = text.split('.')
    return nil unless parts.size == 4
    found = [] of UInt8
    parts.each do |part|
      value = number(part, 10, 3)
      return nil if value.nil? || value > 255
      return nil if part.size > 1 && part.starts_with?("0")
      found << value.to_u8
    end
    found
  end

  def self.ipv6(text : String) : Array(UInt8)?
    gap = -1
    p = text.to_unsafe
    i = 0
    while i + 1 < text.bytesize
      if p[i] == 58_u8 && p[i + 1] == 58_u8
        return nil if gap >= 0
        gap = i
        i = i + 2
      else
        i = i + 1
      end
    end
    if gap < 0
      whole = groups(text)
      return whole && whole.size == 16 ? whole : nil
    end
    head = groups(text[0, gap])
    tail = groups(text[gap + 2, text.size - gap - 2])
    return nil if head.nil? || tail.nil? || head.size + tail.size > 14
    head + Array(UInt8).new(16 - head.size - tail.size, 0_u8) + tail
  end

  # The bytes of colon-separated hex groups, the last of which may be a
  # dotted IPv4 address.
  private def self.groups(text : String) : Array(UInt8)?
    found = [] of UInt8
    return found if text.empty?
    parts = text.split(':')
    parts.each_with_index do |part, i|
      if i == parts.size - 1 && part.includes?(".")
        v4 = ipv4(part)
        return nil unless v4
        found.concat(v4)
        next
      end
      value = number(part, 16, 4)
      return nil if value.nil?
      found << (value >> 8).to_u8
      found << (value & 0xFF).to_u8
    end
    found
  end

  # *text* as a number of at most *width* digits in *base* (10 or 16), or
  # nil.
  private def self.number(text : String, base : Int32, width : Int32) : Int32?
    return nil if text.empty? || text.bytesize > width
    value = 0
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      b = p[i]
      digit = if b >= 48_u8 && b <= 57_u8
                b.to_i32 - 48
              elsif base == 16 && b >= 97_u8 && b <= 102_u8
                b.to_i32 - 87
              elsif base == 16 && b >= 65_u8 && b <= 70_u8
                b.to_i32 - 55
              else
                -1
              end
      return nil if digit < 0
      value = value * base + digit
      i = i + 1
    end
    value
  end
end

# PEM (RFC 7468): the base64 lines between a `-----BEGIN <label>-----` line
# and its END line, checked before they are decoded, as std/base64 panics
# on what is not base64. Text outside the blocks is passed over, as a
# bundle's comments are.
struct X509Pem
  def self.blocks(text : String, label : String = "CERTIFICATE") : Array(Array(UInt8)) | X509Error
    opening = "-----BEGIN #{label}-----"
    closing = "-----END #{label}-----"
    found = [] of Array(UInt8)
    body = nil
    text.lines.each do |raw_line|
      line = raw_line.strip
      current = body
      if current.nil?
        body = String::Builder.new if line == opening
      elsif line == closing
        found << decode(current.to_s, label)!
        body = nil
      else
        current << line
      end
    end
    return X509Error.new("a #{label} block with no END line") unless body.nil?
    found
  end

  private def self.decode(text : String, label : String) : Array(UInt8) | X509Error
    return X509Error.new("a #{label} block whose base64 is #{text.bytesize} bytes, not a multiple of 4") unless text.bytesize % 4 == 0 && text.bytesize > 0
    padding = 0
    padding = 1 if text.ends_with?("=")
    padding = 2 if text.ends_with?("==")
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      b = p[i]
      letter = (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8) || (b >= 48_u8 && b <= 57_u8)
      ok = letter || b == 43_u8 || b == 47_u8 || (b == 61_u8 && i >= text.bytesize - padding)
      return X509Error.new("a #{label} block with byte #{b} in its base64, at #{i}") unless ok
      i = i + 1
    end
    decoded = Base64.decode(text)
    Array(UInt8).new(decoded.bytesize) { |k| decoded.to_unsafe[k] }
  end
end

# std/asn1's errors as this one's, one helper a type.
struct X509Asn1
  def self.value(answer : DerValue | Asn1Error) : DerValue | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.values(answer : Array(DerValue) | Asn1Error) : Array(DerValue) | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.bytes(answer : Array(UInt8) | Asn1Error) : Array(UInt8) | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.bits(answer : {Array(UInt8), Int32} | Asn1Error) : {Array(UInt8), Int32} | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.text(answer : String | Asn1Error) : String | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.time(answer : Time | Asn1Error) : Time | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.bool(answer : Bool | Asn1Error) : Bool | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end

  def self.int(answer : Int64 | Asn1Error) : Int64 | X509Error
    answer.is_a?(Asn1Error) ? X509Error.new(answer.message) : answer
  end
end
