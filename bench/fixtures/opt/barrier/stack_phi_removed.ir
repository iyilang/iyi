; iyi-ir 1
source_filename = "stack_phi_removed"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @stack_phi_removed(i1 %choose, ptr %value) {
entry:
  %left_slot = alloca ptr, align 8
  %right_slot = alloca ptr, align 8
  br i1 %choose, label %left, label %right
left:
  br label %pick
right:
  br label %pick
pick:
  %slot = phi ptr [ %left_slot, label %left ], [ %right_slot, label %right ]
  %mark = load i8, ptr @__iyi_marking, align 1
  %active = icmp ne i8 %mark, 0
  br i1 %active, label %begin, label %plain
begin:
  call void () @__iyi_write_barrier_begin()
  br label %join
plain:
  br label %join
join:
  store ptr %value, ptr %slot, align 8
  br i1 %active, label %shade, label %done
shade:
  call void (ptr, i64) @__iyi_write_barrier(ptr %slot, i64 1)
  br label %done
done:
  ret void
}
