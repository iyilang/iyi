module std/math

# std/int for the small integers' comparisons and negation in gcd; std/float
# for the Float32 overloads: `to_f64`, the comparisons, and a `to_f32` that
# rounds a double past the single's range to its infinity.
import std/int
import std/float

# The hardware instructions this module names. A fused multiply-add is
# among them on aarch64 only: `llvm.fma.f64` is one instruction there and
# a call into libm on the x86-64 baseline, and the floor (SPEC.md III.9)
# links no libm, so `fma` writes x86-64's instruction by hand where the
# processor has it and the exact product below is Dekker's, in iyi.
lib LibLLVMMath # llvm.sqrt.f64 llvm.copysign.f64 llvm.fma.f64
  fun sqrt_f64 = "llvm.sqrt.f64"(x : Float64) : Float64
  fun sqrt_f32 = "llvm.sqrt.f32"(x : Float32) : Float32
  fun copysign_f64 = "llvm.copysign.f64"(mag : Float64, sgn : Float64) : Float64
  fun copysign_f32 = "llvm.copysign.f32"(mag : Float32, sgn : Float32) : Float32
  {% if flag?(:aarch64) %}
    fun fma_f64 = "llvm.fma.f64"(a : Float64, b : Float64, c : Float64) : Float64
    fun fma_f32 = "llvm.fma.f32"(a : Float32, b : Float32, c : Float32) : Float32
  {% end %}
end

pub struct Math
  PI    =  3.14159265358979323846
  TAU   = 6.283185307179586476925
  E     =  2.71828182845904523536
  LOG2  = 0.693147180559945309417
  LOG10 =  2.30258509299404568402

  private HALF_PI     =     1.57079632679489661923
  private QUARTER_PI  =     0.78539816339744830962
  private INV_HALF_PI = 0.636619772367581343075535

  # pi/2 in three parts. The first two carry 33 bits each, so q times
  # either is exact for q below 2^20 on its own, and the products are
  # taken with a fused multiply-add below so that they are exact for any
  # q; the third carries the rest to 1e-37.
  private P1 =     1.57079632673412561417
  private P2 = 6.07710050630396597660e-11
  private P3 = 2.02226624879595063154e-21

  private def self.sin_taylor(r : Float64) : Float64
    r2 = r * r
    s = 1.0 / 355687428096000.0
    s = s * r2 - 1.0 / 1307674368000.0
    s = s * r2 + 1.0 / 6227020800.0
    s = s * r2 - 1.0 / 39916800.0
    s = s * r2 + 1.0 / 362880.0
    s = s * r2 - 1.0 / 5040.0
    s = s * r2 + 1.0 / 120.0
    s = s * r2 - 1.0 / 6.0
    s = s * r2 + 1.0
    r * s
  end

  private def self.cos_taylor(r : Float64) : Float64
    r2 = r * r
    s = 1.0 / 20922789888000.0
    s = s * r2 - 1.0 / 87178291200.0
    s = s * r2 + 1.0 / 479001600.0
    s = s * r2 - 1.0 / 3628800.0
    s = s * r2 + 1.0 / 40320.0
    s = s * r2 - 1.0 / 720.0
    s = s * r2 + 1.0 / 24.0
    s = s * r2 - 1.0 / 2.0
    s = s * r2 + 1.0
    s
  end

  private def self.sincos_reduced(x : Float64) : {Float64, Float64}
    scaled = x * INV_HALF_PI
    q_f = scaled + (scaled >= 0.0 ? 0.5 : -0.5)
    # Past ~2^63 half-turns the argument has no bit of a fraction of a
    # period left in Float64; panicking "arithmetic overflow" is worse
    # than answering a finite point on the circle.
    return {0.0, 1.0} if q_f.abs >= 9223372036854775808.0
    q = q_f.to_i64
    q_f = q.to_f64
    # Each product q * P is taken as a rounded part and its exact error,
    # so nothing is lost until the three parts themselves run out at
    # q * 1e-37; the chain of subtractions below is what limits x to
    # about 1e15 for a full-precision answer.
    p1 = q_f * P1
    p1e = prod_err(q_f, P1, p1)
    p2 = q_f * P2
    p2e = prod_err(q_f, P2, p2)
    p3 = q_f * P3
    p3e = prod_err(q_f, P3, p3)
    r = (((((x - p1) - p1e) - p2) - p2e) - p3) - p3e
    s_r = sin_taylor(r)
    c_r = cos_taylor(r)
    quad = (q % 4_i64 + 4_i64) % 4_i64
    if quad == 0_i64
      {s_r, c_r}
    elsif quad == 1_i64
      {c_r, 0.0 - s_r}
    elsif quad == 2_i64
      {0.0 - s_r, 0.0 - c_r}
    else
      {0.0 - c_r, s_r}
    end
  end

  def self.sin(value : Float64) : Float64
    return value if value == 0.0
    return 0.0 / 0.0 if value != value || value == 2.0 * value
    sincos_reduced(value)[0]
  end

  def self.sin(value : Float32) : Float32
    sin(value.to_f64).to_f32
  end

  def self.sin(value : T) : Float64 forall T
    sin(value.to_f64)
  end

  def self.cos(value : Float64) : Float64
    return 1.0 if value == 0.0
    return 0.0 / 0.0 if value != value || value == 2.0 * value
    sincos_reduced(value)[1]
  end

  def self.cos(value : Float32) : Float32
    cos(value.to_f64).to_f32
  end

  def self.cos(value : T) : Float64 forall T
    cos(value.to_f64)
  end

  def self.tan(value : Float64) : Float64
    return value if value == 0.0
    return 0.0 / 0.0 if value != value || value == 2.0 * value
    s, c = sincos_reduced(value)
    s / c
  end

  def self.tan(value : Float32) : Float32
    tan(value.to_f64).to_f32
  end

  def self.tan(value : T) : Float64 forall T
    tan(value.to_f64)
  end

  def self.sqrt(value : Float64) : Float64
    LibLLVMMath.sqrt_f64(value)
  end

  def self.sqrt(value : Float32) : Float32
    LibLLVMMath.sqrt_f32(value)
  end

  def self.sqrt(value : T) : Float64 forall T
    sqrt(value.to_f64)
  end

  def self.cbrt(value : Float64) : Float64
    return value if value == 2.0 * value || value != value
    neg = value < 0.0
    v = neg ? 0.0 - value : value
    # v = m * 2^e with e a multiple of three, so the root is taken of a
    # number in [0.5, 4) and scaled back exactly.
    m, e = frexp(v)
    r = (e % 3 + 3) % 3
    m = m * (r == 0 ? 1.0 : (r == 1 ? 2.0 : 4.0))
    e = e - r
    res = exp(log(m) / 3.0)
    res3 = res * res * res
    res = res * (res3 + 2.0 * m) / (2.0 * res3 + m)
    res = ldexp(res, e // 3)
    if v <= 2.0e14 && v == v.to_i64.to_f64
      iv = v.to_i64
      ir = (res + 0.5).to_i64
      if ir * ir * ir == iv
        res = ir.to_f64
      end
    end
    neg ? 0.0 - res : res
  end

  def self.cbrt(value : Float32) : Float32
    cbrt(value.to_f64).to_f32
  end

  def self.cbrt(value : T) : Float64 forall T
    cbrt(value.to_f64)
  end

  # exp as glibc computes it on Linux - Arm's optimized-routines exp, which
  # glibc has carried since 2.28 - so a program's `Math.exp` is the other
  # library's to the last bit: fdlibm's, which this was, differed from it
  # for one argument in ten over a million drawn from +-700, and a result
  # printed in full differed with it. Exactly glibc's build without FMA;
  # on a processor with FMA glibc picks a fused build of the same source,
  # which answers differently in the last bit for about 7 arguments in
  # 10,000 - glibc against itself - and this, unfused on every target,
  # answers the same everywhere. x = k ln2/128 + r, |r| <= ln2/256,
  # the reduction by adding 1.5 * 2^52 as glibc's x86_64 build does; then
  # 2^(k/128) from a table of 128 pairs, as the scale's bits and a
  # correction, and exp(r) - 1 by a degree-5 polynomial. No division, where
  # fdlibm had one, and under 0.51 ulp. The table and the coefficients are
  # `math/exp_data.c`'s for N = 128, order 5, taken from its text rather
  # than retyped. Arm's code is MIT OR Apache-2.0 WITH LLVM-exception, used
  # here under MIT:
  #
  #   Copyright (c) 2018-2025 Arm Limited
  #
  #   Permission is hereby granted, free of charge, to any person obtaining
  #   a copy of this software and associated documentation files (the
  #   "Software"), to deal in the Software without restriction, including
  #   without limitation the rights to use, copy, modify, merge, publish,
  #   distribute, sublicense, and/or sell copies of the Software, and to
  #   permit persons to whom the Software is furnished to do so, subject to
  #   the following conditions: The above copyright notice and this
  #   permission notice shall be included in all copies or substantial
  #   portions of the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT
  #   WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO
  #   THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
  #   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
  #   LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
  #   OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
  #   WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
  private EXP_INVLN2N  =       184.6649652337873
  private EXP_NEGLN2HI =   -0.005415212348111709
  private EXP_NEGLN2LO = -1.2864023111638346e-14
  private EXP_SHIFT    =      6755399441055744.0
  private EXP_C2       =     0.49999999999996786
  private EXP_C3       =     0.16666666666665886
  private EXP_C4       =      0.0416666808410674
  private EXP_C5       =    0.008333335853059549

  # tab[2k] is T[k]'s bits and tab[2k + 1] H[k]'s less (k << 52) / 128,
  # where 2^(k/128) ~= H[k] * (1 + T[k]).
  private EXP_TAB = [
    0x0_u64, 0x3ff0000000000000_u64, 0x3c9b3b4f1a88bf6e_u64, 0x3feff63da9fb3335_u64,
    0xbc7160139cd8dc5d_u64, 0x3fefec9a3e778061_u64, 0xbc905e7a108766d1_u64, 0x3fefe315e86e7f85_u64,
    0x3c8cd2523567f613_u64, 0x3fefd9b0d3158574_u64, 0xbc8bce8023f98efa_u64, 0x3fefd06b29ddf6de_u64,
    0x3c60f74e61e6c861_u64, 0x3fefc74518759bc8_u64, 0x3c90a3e45b33d399_u64, 0x3fefbe3ecac6f383_u64,
    0x3c979aa65d837b6d_u64, 0x3fefb5586cf9890f_u64, 0x3c8eb51a92fdeffc_u64, 0x3fefac922b7247f7_u64,
    0x3c3ebe3d702f9cd1_u64, 0x3fefa3ec32d3d1a2_u64, 0xbc6a033489906e0b_u64, 0x3fef9b66affed31b_u64,
    0xbc9556522a2fbd0e_u64, 0x3fef9301d0125b51_u64, 0xbc5080ef8c4eea55_u64, 0x3fef8abdc06c31cc_u64,
    0xbc91c923b9d5f416_u64, 0x3fef829aaea92de0_u64, 0x3c80d3e3e95c55af_u64, 0x3fef7a98c8a58e51_u64,
    0xbc801b15eaa59348_u64, 0x3fef72b83c7d517b_u64, 0xbc8f1ff055de323d_u64, 0x3fef6af9388c8dea_u64,
    0x3c8b898c3f1353bf_u64, 0x3fef635beb6fcb75_u64, 0xbc96d99c7611eb26_u64, 0x3fef5be084045cd4_u64,
    0x3c9aecf73e3a2f60_u64, 0x3fef54873168b9aa_u64, 0xbc8fe782cb86389d_u64, 0x3fef4d5022fcd91d_u64,
    0x3c8a6f4144a6c38d_u64, 0x3fef463b88628cd6_u64, 0x3c807a05b0e4047d_u64, 0x3fef3f49917ddc96_u64,
