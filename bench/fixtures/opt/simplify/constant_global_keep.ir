; iyi-ir 1
source_filename = "constant_global_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@mutable = internal global i32 42
@constant = internal constant i32 42
@__iyi_marking = internal constant i8 0
define external i32 @read_mutable() {
entry:
  %v = load i32, ptr @mutable, align 4
  ret i32 %v
}
define external i32 @read_volatile() {
entry:
  %v = volatile load i32, ptr @constant, align 4
  ret i32 %v
}
define external i32 @read_atomic() {
entry:
  %v = load i32, ptr @constant, align 4 atomic acquire
  ret i32 %v
}
define external i8 @read_marking() {
entry:
  %v = load i8, ptr @__iyi_marking, align 1
  ret i8 %v
}
