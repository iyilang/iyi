macro emit_forward_guard
  class EscapedForward
    REC_HEAP        = 1376_u64
    CLASSES         =       67
    PARTITION_BYTES = 2048_u64

    \{% if TAKEN * 8 < REC_HEAP || (TAKEN + CLASSES) * 8 > PARTITION_BYTES %}
      \{% raise "escaped forward guard unexpectedly taken" %}
    \{% end %}

    TAKEN = 176
  end
end

emit_forward_guard
nil
