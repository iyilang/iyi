RSA_KEY       = ""
POINT_ON_P384 = "3056301006072a8648ce3d020106052b81040022034200041ce8bd42f847d37ba2a624ea4f21ffdbac7682974b514df89b538e95ac7cbe0e9870c79029b37954a86c95e5f5b9cd4b2569c8dc102d2be6937d839b0d42da58"
POINT_P256    = "041ce8bd42f847d37ba2a624ea4f21ffdbac7682974b514df89b538e95ac7cbe0e9870c79029b37954a86c95e5f5b9cd4b2569c8dc102d2be6937d839b0d42da58"

args = Program.args

if args.size > 0 && args[0] == "verify"
  File.read(args[1]).lines.each do |line|
    next if line.empty?
    f = line.split(' ')
    key = EcdsaPublicKey.from_spki(b(f[0]))
    if key.is_a?(EcdsaError)
      puts "key: #{key.message}"
    else
      puts key.verify(hash_named(f[1]), b(f[2]), f.size > 3 ? b(f[3]) : [] of UInt8)
    end
  end
  exit 0
end

if args.size > 0 && args[0] == "roots"
  Dir.children(args[1]).sorted.each do |name|
    cert = Der.parse(read_file(args[1] + "/" + name)).or_panic.sequence.or_panic
    tbs = cert[0].sequence.or_panic
    at = tbs[0].context?(0) ? 1 : 0
    hash = certificate_hash(cert[1].sequence.or_panic)
    key = EcdsaPublicKey.from_spki(tbs[at + 5])
    if hash.nil? || key.is_a?(EcdsaError)
      puts "#{name} skip"
      next
    end
    puts "#{name} #{key.verify(hash_named(hash), cert[0].raw, cert[2].bit_string.or_panic)}"
  end
  exit 0
end

puts "== signatures Python's cryptography made"
p256 = EcdsaPublicKey.from_spki(b(K_P256)).or_panic
p384 = EcdsaPublicKey.from_spki(b(K_P384)).or_panic
p521 = EcdsaPublicKey.from_spki(b(K_P521)).or_panic
check p256.curve == EcdsaCurve::P256, "a P-256 key read as #{p256.curve}"
check p384.curve == EcdsaCurve::P384, "a P-384 key read as #{p384.curve}"
check p521.curve == EcdsaCurve::P521, "a P-521 key read as #{p521.curve}"
SIGNATURES.each do |c|
  key = EcdsaPublicKey.from_spki(b(c[0])).or_panic
  got = key.verify(hash_named(c[1]), c[2], b(c[3]))
  check got == c[4], "#{c[5]} (#{key.curve} #{c[1]}): expected #{c[4]}, got #{got}"
end
puts "  #{SIGNATURES.count { |c| c[4] }} accepted and #{SIGNATURES.count { |c| !c[4] }} refused as they should be"
check p256.verify(EcdsaHash::SHA256, b("616263"), b(SIGNATURES[0][3])), "a message given as bytes"
from_point = EcdsaPublicKey.from_point(EcdsaCurve::P256, b(POINT_P256)).or_panic
check from_point.x == p256.x && from_point.y == p256.y, "a point read as the key that carries it"

puts "== keys that are not keys"
refused COMPRESSED, "a compressed point", "a compressed point refused"
refused OFF_CURVE, "not on P256", "a point off the curve refused"
refused PAST_P, "not below the field's prime", "a coordinate past p refused"
refused SHORT_POINT, "not the 65 of an uncompressed", "a point a byte short refused"
refused POINT_ON_P384, "not the 97 of an uncompressed", "a P-256 point named P-384 refused"
refused SECP256K1, "not P-256, P-384 or P-521", "secp256k1 refused"
refused EXPLICIT, "not a named curve", "explicit curve parameters refused"
refused RSA_KEY, "not id-ecPublicKey", "an RSA key refused"
refused "020101", "expected a SEQUENCE", "an INTEGER where a key goes refused"

puts "\nALL CHECKS PASSED"
