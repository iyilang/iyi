    fun get_error_message = LLVMGetErrorMessage(err : ErrorRef) : Char*
    fun dispose_error_message = LLVMDisposeErrorMessage(err_msg : Char*)
  end
{% end %}

lib ::LibC
  fun strlen(s : UInt8*) : UInt64
end

pub def string_from_c(ptr : UInt8*) : String
  return "" if ptr.address == 0
  len = LibC.strlen(ptr).to_i32
  String.new(len) do |b|
    b.copy_from(ptr, len)
  end
end

pub def string_and_dispose(ptr : UInt8*) : String
  return "" if ptr.address == 0
  s = string_from_c(ptr)
  LibLLVM.dispose_message(ptr)
  s
end

pub def to_c_str(s : String) : UInt8*
  p = Pointer(UInt8).malloc(s.bytesize.to_u64 + 1_u64)
  p.copy_from(s.to_unsafe, s.bytesize)
  p[s.bytesize] = 0_u8
  p
end
