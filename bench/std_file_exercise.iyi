# Exercises `std/file`.
#
# Run via:
#     ./bin/iyi run bench/std_file_exercise.iyi

module bench/std_file_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/file::{File}
import std/dir::{Dir}

# The sandbox is the argument, then IYI_FILE_SANDBOX, then the platform's
# own temporary directory. It was `/tmp` last, which is not a directory on
# Windows: every write panicked there unless a gate set the variable, and
# `bench/std_exercise.sh`, which runs every exercise from source and from
# artifacts without it, compared two panics whose locations differed.
args = Program.args
env_sandbox = Program.env("IYI_FILE_SANDBOX")
sandbox = if args.size > 0
            args[0]
          elsif !env_sandbox.nil?
            env_sandbox
          else
            Dir.tempdir
          end

puts "== write, read, and append"
f1 = sandbox + "/std_file_ex_1.txt"
File.write(f1, "first line\n")
assert_str "first line\n", File.read(f1), "write then read back"

File.write(f1, File.read(f1) + "second line\n")
assert_str "first line\nsecond line\n", File.read(f1), "append"
puts "  write, read back, and append verified"

puts "\n== exists, size, and empty"
assert_true File.exists?(f1), "file exists"
assert_true File.size(f1) == 23_i64, "file size matches bytesize"
assert_true !File.empty?(f1), "file is not empty"

f_empty = sandbox + "/std_file_ex_empty.txt"
File.write(f_empty, "")
assert_true File.exists?(f_empty), "empty file exists"
assert_true File.size(f_empty) == 0_i64, "empty file size is 0"
assert_true File.empty?(f_empty), "empty? is true for empty file"

f_nonexistent = sandbox + "/std_file_ex_nonexistent_xyz.txt"
assert_true !File.exists?(f_nonexistent), "nonexistent file does not exist"
assert_true File.info?(f_nonexistent).nil?, "info? on nonexistent returns nil"
assert_true !File.empty?(f_nonexistent), "empty? on a missing path is false"
puts "  exists, size, and empty verified"

puts "\n== line-wise reading"
lines = File.read_lines(f1)
assert_true lines.size == 2, "read_lines returned 2 lines"
assert_str "first line", lines[0], "line 0"
assert_str "second line", lines[1], "line 1"

count = 0
File.each_line(f1) do |l|
  count = count + 1
end
assert_true count == 2, "each_line visited 2 lines"
puts "  read_lines and each_line verified"

puts "\n== truncation and overwrite"
File.truncate(f1, 5_i64)
assert_str "first", File.read(f1), "truncated content"
assert_true File.size(f1) == 5_i64, "truncated size"

File.write(f1, "overwritten content")
assert_str "overwritten content", File.read(f1), "overwritten content"
assert_true File.size(f1) == 19_i64, "overwritten size"
File.touch(f1)
assert_str "overwritten content", File.read(f1), "touch does not truncate"
File.touch(f1, 1_i64)
assert_true File.info(f1).modification_time == 1_i64, "touch sets the given unix time"
File.touch(f1)
puts "  truncation and overwrite verified"

puts "\n== metadata and permissions"
inf = File.info(f1)
assert_true inf.file?, "info is file"
assert_true !inf.directory?, "info is not directory"
assert_true inf.size == 19_i64, "info size"
assert_true File.readable?(f1), "File.readable?"
assert_true File.writable?(f1), "File.writable?"
assert_true File.file?(f1), "File.file?"
assert_true !File.directory?(f1), "File.directory? on file is false"

File.chmod(f1, 0o644)
perms = File.info(f1).permissions
assert_true perms.owner_read?, "owner read"
assert_true perms.owner_write?, "owner write"
assert_str "rw-r--r--", perms.to_s, "permissions string"
puts "  metadata, permissions, and chmod verified"

# A read-only file is still the directory's to remove. POSIX asks the
# directory for permission to unlink and Windows asks the file, which
# refuses with ERROR_ACCESS_DENIED while it carries
# FILE_ATTRIBUTE_READONLY — the attribute `File.chmod(path, 0o444)`
# sets. Measured before the retry: write a file, make it read-only,
# delete it, and the program died with "cannot delete" on Windows and
# nowhere else.
locked = sandbox + "/readonly.txt"
File.write(locked, "locked")
File.chmod(locked, 0o444)
# Not "and it is unwritable": CI's Linux container runs as root, where
# `access(W_OK)` answers true for a 0o444 file and the assertion said so.
# What is being tested is the removal, which the mode never governed.
File.delete(locked)
assert_true !File.exists?(locked), "a read-only file is still the directory's to delete"
puts "  a read-only file is deleted by its directory's leave"

# And a read-only *destination* is still replaceable: posix `rename`
# asks the directory, Windows asks the target and refuses with
# ERROR_ACCESS_DENIED. Measured before the retry: renaming onto a name
# `File.chmod(path, 0o444)` had marked died with "Access is denied" on
# Windows and replaced the file everywhere else.
from_name = sandbox + "/rename_source.txt"
onto_name = sandbox + "/rename_target.txt"
File.write(from_name, "source")
File.write(onto_name, "target")
File.chmod(onto_name, 0o444)
File.rename(from_name, onto_name)
assert_str "source", File.read(onto_name), "a read-only destination is replaced"
assert_true !File.exists?(from_name), "the source is gone after the rename"
File.chmod(onto_name, 0o644)
File.delete(onto_name)
puts "  a read-only destination is replaced by a rename"

puts "\n== directory and file queries"
assert_true File.exists?(sandbox), "sandbox directory exists"
assert_true File.directory?(sandbox), "sandbox is a directory"
assert_true !File.file?(sandbox), "sandbox is not a file"
dir_info = File.info(sandbox)
assert_true dir_info.directory?, "dir_info.directory?"
assert_true !dir_info.file?, "dir_info not file?"
assert_true dir_info.type.directory?, "dir_info.type.directory?"
assert_true File.readable?(sandbox), "sandbox directory is readable"
puts "  directory inspection verified"

puts "\n== paths, links, and content comparison"
f2 = sandbox + "/std_file_ex_2.txt"
File.write(f2, "overwritten content")
assert_true File.same_content?(f1, f2), "same_content? is true for identical content"
assert_true !File.same?(f1, f2), "same? is false for distinct files"

flink = sandbox + "/std_file_ex_link.txt"
File.link(f1, flink)
assert_true File.exists?(flink), "link exists"
assert_true File.same?(f1, flink), "hard link same? is true"
assert_str "overwritten content", File.read(flink), "link content"

fsym = sandbox + "/std_file_ex_sym.txt"
# Making a symbolic link on Windows takes a privilege
# (SeCreateSymbolicLinkPrivilege): an administrator has it, Developer Mode
# grants it to everyone, and a machine with neither refuses with
# ERROR_PRIVILEGE_NOT_HELD. That is a fact about the machine and not about
# `std/file`, so the exercise asks Windows first — through the same call
# `File.symlink` makes — and reports what it cannot measure instead of
# failing. Everywhere else a symlink always works and the answer is yes.
symlinks_allowed = true
{% if flag?(:win32) %}
  probe = sandbox + "/std_file_ex_probe.txt"
  File.delete(probe) if File.exists?(probe)
  probe_wide = __iyi_wide_path(probe.to_unsafe)
  target_wide = __iyi_wide_path(f1.to_unsafe)
  symlinks_allowed = probe_wide.address != 0_u64 && target_wide.address != 0_u64 &&
                     Std::File::LibKernel32.CreateSymbolicLinkW(probe_wide, target_wide, 0x2_u32) != 0_u8
{% end %}
if symlinks_allowed
  File.symlink(f1, fsym)
  assert_true File.symlink?(fsym), "symlink? is true"
  # Windows keeps a link's target in its own spelling — every separator a
  # backslash, whatever the caller wrote — so the exact bytes handed to
  # `File.symlink` are not the bytes stored. Both platforms are asked the
  # question that matters: the link and the target are one file.
  assert_true File.real_path(File.readlink(fsym)) == File.real_path(f1), "readlink returns target"
  assert_true File.real_path(fsym) == File.real_path(f1), "real_path resolves target"
else
  puts "  symlink checks skipped: this machine refuses a symbolic link (no create-symlink privilege, no Developer Mode)"
end

fren = sandbox + "/std_file_ex_renamed.txt"
File.rename(f2, fren)
assert_true !File.exists?(f2), "old path does not exist after rename"
assert_true File.exists?(fren), "new path exists after rename"

assert_str "std_file_ex_1.txt", File.basename(f1), "basename"
assert_str ".txt", File.extname(f1), "extname"
assert_str sandbox, File.dirname(f1), "dirname"
# `join` writes the separator of the platform it runs on, so the expected
# string is built out of the same constant rather than pinning `/`: on
# POSIX these are the two strings they always were.
sep = File::SEPARATOR_STRING
assert_str "a" + sep + "b" + sep + "c", File.join(["a", "b", "c"]), "join"
assert_str "a" + sep + "b", File.join("a", "b"), "join two strings"
assert_true File.match?("foo.txt", "*.txt"), "match * suffix"
assert_true !File.match?("foo.txt", "*.md"), "match rejects a different suffix"
assert_true File.match?("a.txt", "?.txt"), "match ?"
ta = File.tempfile("std_file_ex")
tb = File.tempfile("std_file_ex")
assert_true ta != tb, "tempfile names differ"
File.delete(ta)
File.delete(tb)
# A symlink planted where the next temporary file would go, pointing at a
# file of someone else's: the temporary file is made somewhere else, alone,
# and the target is left as it was - wherever a symlink can be made at all
# (`symlinks_allowed`, above).
if symlinks_allowed
  # Where `File.tempfile` makes its file: TMPDIR, TEMP, TMP, in that
  # order, as `Dir.tempdir` reads them. `/tmp` is not a directory on
  # Windows, and a run without TMPDIR there planted nothing anywhere.
  tmp = Dir.tempdir
  victim = sandbox + "/std_file_ex_victim.txt"
  File.write(victim, "kept")
  planted = tmp + "/plant_0000000000000000"
  File.delete(planted) if File.symlink?(planted) || File.exists?(planted)
  File.symlink(victim, planted)
  made = File.tempfile("plant")
  assert_true !File.symlink?(made), "tempfile never answers a planted symlink"
  File.write(made, "upload")
  assert_str "kept", File.read(victim), "a planted symlink's target is left alone"
  # Mode bits are POSIX's: a Windows file's reach is its ACL, inherited
  # from the directory it is made in.
  {% unless flag?(:win32) %}
    assert_true (File.info(made).permissions.value & 0o777) == 0o600, "a temporary file is its owner's alone"
  {% end %}
  File.delete(made)
  File.delete(planted)
  File.delete(victim)
end
puts "  links, rename, and path helpers verified"

puts "\n== seek"
fseek = sandbox + "/std_file_ex_seek.bin"
File.write(fseek, String.build { |io| 1000.times { |i| io << (i % 10).to_s } })
sio = File.open(fseek)
assert_str "012", sio.read_bytes(3), "seek: a first read"
assert_true sio.pos == 3_i64, "seek: pos counts what was read, not what was read ahead"
sio.seek(500)
assert_str "0123", sio.read_bytes(4), "seek: from the start, past the read-ahead"
sio.seek(-2, IyiIO::Seek::Current)
assert_str "234", sio.read_bytes(3), "seek: from here"
sio.seek(-3, IyiIO::Seek::End)
assert_str "789", sio.read_bytes(10), "seek: from the end, to the end"
assert_true sio.pos == 1000_i64, "seek: pos at the end"
sio.pos = 7
assert_str "78", sio.read_bytes(2), "seek: pos="
sio.close
File.delete(fseek)
puts "  seek and pos read a file from where they say"

puts "\n== delete"
File.delete(f1)
assert_true !File.exists?(f1), "f1 deleted"
File.delete(f_empty)
assert_true !File.exists?(f_empty), "f_empty deleted"
File.delete(flink)
assert_true !File.exists?(flink), "flink deleted"
if symlinks_allowed
  File.delete(fsym)
  assert_true !File.exists?(fsym), "fsym deleted"
end
File.delete(fren)
assert_true !File.exists?(fren), "fren deleted"
puts "  file deletion verified"

puts "\nALL CHECKS PASSED"
