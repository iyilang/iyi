; iyi-ir 1
; A well-formed module for x86_64 Linux. The native tool links aarch64-apple-darwin only, so it must refuse this
; module by its target rather than link its functions into a Mach-O image (bench/native_backend_select_exercise.sh).
module "backend_select_linux_target"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

define i32 @main() {
entry:
  ret i32 7
}
