# Exercises `std/number`: Number#abs, sign, zero? on Int32.
#
# Run via:
#     ./bin/iyi run bench/std_number_exercise.iyi

module bench/std_number_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/number
using std/number::{RoundingMode}

puts "== abs"
assert_true (-7).abs == 7, "abs"
assert_true 7.abs == 7, "abs pos"
assert_true 3.abs2 == 9, "abs2"
puts "  abs, abs2"

puts "\n== sign"
assert_true (-2).sign == -1, "neg"
assert_true 0.sign == 0, "zero"
assert_true 4.sign == 1, "pos"
assert_true 0.zero?, "zero?"
puts "  sign and zero?"

puts "\n== round"
assert_true 2.5.round(RoundingMode::TiesEven) == 2.0, "ties even 2.5"
assert_true 2.5.round(RoundingMode::TiesAway) == 3.0, "ties away 2.5"
assert_true 2.5.round(RoundingMode::ToZero) == 2.0, "to zero 2.5"
assert_true 2.5.round(RoundingMode::ToPositive) == 3.0, "to positive 2.5"
assert_true 2.5.round(RoundingMode::ToNegative) == 2.0, "to negative 2.5"
assert_true (-2.5).round(RoundingMode::TiesEven) == -2.0, "ties even -2.5"
assert_true (-2.5).round(RoundingMode::TiesAway) == -3.0, "ties away -2.5"
assert_true (-2.5).round(RoundingMode::ToZero) == -2.0, "to zero -2.5"
assert_true (-2.5).round(RoundingMode::ToPositive) == -2.0, "to positive -2.5"
assert_true (-2.5).round(RoundingMode::ToNegative) == -3.0, "to negative -2.5"
assert_true 3.5.round(RoundingMode::TiesEven) == 4.0, "ties even 3.5"
assert_true 2.5.round == 3.0, "no-arg round is still ties away"
assert_true 5.round(RoundingMode::ToZero) == 5, "int identity"
puts "  the mode is the rounding"

puts "\nALL CHECKS PASSED"
