pub class Annotation < ASTNode
  property path : Path
  property args : Array(ASTNode)
  property named_args : Array(NamedArgument)?

  def initialize(@path : Path, @args : Array(ASTNode) = [] of ASTNode, @named_args : Array(NamedArgument)? = nil)
  end

  def clone_without_location : self
    if na = @named_args
      cloned_named_args = na.map { |a| a.clone.as(NamedArgument) }
    else
      cloned_named_args = nil
    end
    Annotation.new(@path.clone.as(Path), clone_nodes(@args), cloned_named_args)
  end

  def accept_children(visitor) : Nil
    @path.accept(visitor)
    @args.each { |a| a.accept(visitor) }
    if na = @named_args
      na.each { |a| a.accept(visitor) }
    end
  end

  def ==(other : self) : Bool
    (@path == other.path) && (@args == other.args) && (@named_args == other.named_args)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@path)
    h = 31 &* h &+ hash_val(@args)
    h = 31 &* h &+ hash_val(@named_args)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "@["
    @path.to_s(sb)
    if @args.size > 0 || @named_args
      sb << "("
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        @args[i].to_s(sb)
        i = i + 1
      end
      if na = @named_args
        j = 0
        while j < na.size
          sb << ", " if @args.size > 0 || j > 0
          na[j].to_s(sb)
          j = j + 1
        end
      end
      sb << ")"
    end
    sb << "]"
  end
end

