# A dudect-style timing test (Reparaz, Balasch and Verbauwhede, "Dude, is
# my code constant time?", 2017) for the secret paths in std: each
# measurement runs one operation on an input of one of two classes - a
# fixed input, or a fresh random one - the class drawn at random for each
# measurement so that drift on the machine falls on both, and Welch's t
# is taken between the two classes' times. A path whose time does not
# depend on its secret keeps |t| small however many samples there are; one
# that leaks grows |t| with the square root of the samples. As dudect
# does, t is also taken over the measurements under the 50th, 75th and
# 90th percentile of all of them, which drops the long tail that other
# processes put on a time, and the largest |t| is the answer.
#
#     iyi build --release bench/ct_timing.iyi -o ct_timing
#     ./ct_timing TARGET SAMPLES [PEM]
#
# TARGET is inverse (std/big's `inverse_mod_secret` modulo 2048 bits,
# x = (m - 1) / 2 against x random), euclid (the extended Euclid's algorithm
# std/rsa took the blinding off with before, the same classes: the leak
# the tool has to see), rsa (`sign_pss` with the 2048-bit key in PEM, a
# fixed message against random ones), p256 (`P256PrivateKey#sign`, a
# fixed message against random ones, one key), p256-length (the same,
# the random messages drawn from 256 whose r and s are as long in DER as
# the fixed one's) or x25519 (`X25519.shared`,
# a fixed private key against random ones, one peer). It prints the
# samples and the largest |t|. The time is `Time.monotonic_nanoseconds`:
# std has no cycle counter, and a nanosecond clock read around operations
# of microseconds is fine enough. `bench/ct_timing.sh` drives it.

import std/big::{BigInt}
import std/rsa::{RsaPrivateKey, RsaHash}
import std/p256::{P256PrivateKey}
import std/ecdsa::{EcdsaHash}
import std/curve25519::{X25519}
import std/file::{File}
import std/time::{Time}
import std/math::{Math}

# xorshift64*: the classes and the random inputs, reproducible.
class Draw
  @state : UInt64

  def initialize(@state : UInt64)
  end

  def next : UInt64
    x = @state
    x = x ^ x.unsafe_shr(12)
    x = x ^ x.unsafe_shl(25)
    x = x ^ x.unsafe_shr(27)
    @state = x
    x &* 0x2545F4914F6CDD1D_u64
  end

  def bytes(count : Int32) : Array(UInt8)
    Array(UInt8).new(count) { |_| (self.next.unsafe_shr(56) & 0xFF_u64).to_u8 }
  end
end

def euclid(a : BigInt, m : BigInt) : BigInt?
  t0 = BigInt.new(0)
  t1 = BigInt.new(1)
  r0 = m
  r1 = a % m
  going = !r1.zero?
  while going
    q, rest = r0.divmod(r1)
    r0 = r1
    r1 = rest
    t0, t1 = t1, t0 - q * t1
    going = !r1.zero?
  end
  return nil unless r0 == BigInt.new(1)
  t0.negative? ? t0 + m : t0
end

# Welch's t between the times of class 0 and class 1 at or under *limit*.
def welch(times : Array(Int64), classes : Array(Int32), limit : Int64) : Float64
  n = [0.0, 0.0]
  mean = [0.0, 0.0]
  m2 = [0.0, 0.0]
  i = 0
  while i < times.size
    if times[i] <= limit
      c = classes[i]
      x = times[i].to_f64
      n[c] = n[c] + 1.0
      d = x - mean[c]
      mean[c] = mean[c] + d / n[c]
      m2[c] = m2[c] + d * (x - mean[c])
    end
    i = i + 1
  end
  return 0.0 if n[0] < 2.0 || n[1] < 2.0
  v0 = m2[0] / (n[0] - 1.0)
  v1 = m2[1] / (n[1] - 1.0)
  spread = Math.sqrt(v0 / n[0] + v1 / n[1])
  return 0.0 if spread == 0.0
  (mean[0] - mean[1]) / spread
end

args = Program.args
raise "usage: ct_timing TARGET SAMPLES [PEM]" if args.size < 2
target = args[0]
samples = args[1].to_i
draw = Draw.new(0x9E3779B97F4A7C15_u64)

modulus = (BigInt.one << 2047) + BigInt.from_bytes(draw.bytes(255))
modulus = modulus + BigInt.one if modulus.even?
# (m - 1) / 2: as long as a random x, and its Euclid ends in two steps.
fixed_x = (modulus - BigInt.one) >> 1
rsa_key = target == "rsa" ? RsaPrivateKey.from_pem(File.read(args[2])).or_panic : nil
p256_key = P256PrivateKey.from_bytes(draw.bytes(32)).or_panic
peer = X25519.public_key(draw.bytes(32))
fixed_secret = draw.bytes(32)
fixed_message = draw.bytes(64)
# For p256-length: random messages whose r and s are as long in DER as the
# fixed one's, a DER INTEGER being as long as its value's top bytes make it:
# the signature's encoding, which is public, then takes one course.
same_length = [] of Array(UInt8)
if target == "p256-length"
  fixed_signature = p256_key.sign(EcdsaHash::SHA256, fixed_message)
  # SEQUENCE { INTEGER r, INTEGER s }: r's length at 3, s's after r.
  want = {fixed_signature[3], fixed_signature[5 + fixed_signature[3].to_i32]}
  while same_length.size < 256
    candidate = draw.bytes(64)
    signature = p256_key.sign(EcdsaHash::SHA256, candidate)
    same_length << candidate if {signature[3], signature[5 + signature[3].to_i32]} == want
  end
end

# The random inputs are drawn before the clock starts, 1,024 of each, so
# that neither class allocates more than the other between measurements.
xs = Array(BigInt).new(1024) { |_| BigInt.from_bytes(draw.bytes(256)) % modulus }
messages = Array(Array(UInt8)).new(1024) { |_| draw.bytes(64) }
secrets = Array(Array(UInt8)).new(1024) { |_| draw.bytes(32) }
times = Array(Int64).new(samples, 0_i64)
classes = Array(Int32).new(samples, 0)
sink = 0
i = 0
while i < samples + samples // 10
  c = (draw.next & 1_u64).to_i32
  pick = (draw.next & 1023_u64).to_i32
  x = c == 0 ? fixed_x : xs[pick]
  message = c == 0 ? fixed_message : (target == "p256-length" ? same_length[pick & 255] : (target == "p256-two" ? messages[0] : messages[pick]))
  secret = c == 0 ? fixed_secret : secrets[pick]
  started = Time.monotonic_nanoseconds
  case target
  when "inverse"
    sink = sink ^ (x.inverse_mod_secret(modulus) || BigInt.zero).limbs.size
  when "euclid"
    sink = sink ^ (euclid(x, modulus) || BigInt.zero).limbs.size
  when "rsa"
    key = rsa_key
    raise "rsa needs a PEM" unless key
    sink = sink ^ key.sign_pss(RsaHash::SHA256, message).size
  when "p256", "p256-length", "p256-two"
    sink = sink ^ p256_key.sign(EcdsaHash::SHA256, message).size
  when "x25519"
    shared = X25519.shared(secret, peer)
    sink = sink ^ (shared.is_a?(String) ? shared.bytesize : 0)
  else
    raise "no target #{target}: inverse, euclid, rsa, p256 or x25519"
  end
  took = Time.monotonic_nanoseconds - started
  # The first tenth warms caches and the clock and is not kept.
  if i >= samples // 10
    at = i - samples // 10
    times[at] = took.to_i64
    classes[at] = c
  end
  i = i + 1
end

sorted = times.sorted
largest = 0.0
[sorted[sorted.size - 1], sorted[sorted.size * 9 // 10], sorted[sorted.size * 3 // 4], sorted[sorted.size // 2]].each do |limit|
  t = welch(times, classes, limit).abs
  largest = t if t > largest
end
puts "#{target}: #{samples} samples, max |t| = #{(largest * 100).round / 100} (#{sink & 0})"
