; iyi-ir 1
module "diamond"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @choose(i64 %x) {
entry:
  %yes = icmp sgt i64 %x, 0
  br i1 %yes, label %positive, label %other
positive:
  %a = mul i64 %x, 3
  %b = add i64 %a, 5
  ret i64 %b
other:
  %c = sub i64 7, %x
  %d = mul i64 %c, 2
  ret i64 %d
}

define i32 @main() {
entry:
  %a = call i64 (i64) @choose(i64 4)
  %b = call i64 (i64) @choose(i64 -3)
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %q = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  ret i32 0
}
