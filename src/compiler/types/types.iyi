  def initialize(program : SemanticProgram, @not_nil_type : Type)
    super(program, [@not_nil_type, program.nil_type] of Type)
  end

  def nilable? : Bool
    true
  end

  def full_name : String
    "(#{@not_nil_type.full_name} | Nil)"
  end

  def to_s : String
    full_name
  end
end

