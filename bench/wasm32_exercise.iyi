# wasm32-wasi collector exercise — GC_DESIGN.md Stage 10.
#
# Proves:
# 1. Size-classed allocation and 8-byte alignment.
# 2. Garbage collection and address reclamation.
# 3. Rooted object survival from both globals and the shadow stack.
# 4. Precision of layout scanning (pointer fields followed, integer fields ignored).
# 5. Realloc memory preservation.
# 6. Weak references: a held target answered, one nothing holds cleared by
#    the collection, before its memory is reused.
# 7. Objects held by locals alone survive, in plain and optimised builds.

import std/weak_ref::{WeakRef}

def count(value : UInt64) : String
  value.to_i64.to_s
end

def hex(value : UInt64) : String
  value.to_i64.to_s(16)
end

class Node
  property next : Node?
  property value : Int32

  def initialize(@value : Int32)
    @next = nil
  end
end

class TypedNode
  property next : TypedNode?
  property child : Node?
  property decoy : UInt64

  def initialize(@decoy : UInt64)
    @next = nil
    @child = nil
  end
end

class RootedGlobal
  @@head : Node? = nil
  @@typed : TypedNode? = nil

  def self.head : Node?
    @@head
  end

  def self.head=(node : Node?) : Nil
    @@head = node
  end

  def self.typed : TypedNode?
    @@typed
  end

  def self.typed=(node : TypedNode?) : Nil
    @@typed = node
  end
end

class SeenLedger
  LIMIT = 1024_u64
  @@buffer : Pointer(UInt64) = Pointer(UInt64).new(0_u64)
  @@count : UInt64 = 0_u64

  def self.init : Nil
    return if @@buffer.address != 0_u64
    @@buffer = IyiHeap.alloc_atomic(LIMIT * 8_u64).as(Pointer(UInt64))
    @@count = 0_u64
  end

  def self.add(addr : UInt64) : Nil
    init
    if @@count < LIMIT
      (@@buffer + @@count.to_i64).value = addr
      @@count = @@count + 1_u64
    end
  end

  def self.holds?(addr : UInt64) : Bool
    init
    idx = 0_u64
    while idx < @@count
      return true if (@@buffer + idx.to_i64).value == addr
      idx = idx + 1_u64
    end
    false
  end

  def self.forget : Nil
    @@count = 0_u64
  end
end

class DecoyHolder
  MASK = 0x5555555555555555_u64
  @@addr : UInt64 = 0_u64

  def self.set(a : UInt64) : Nil
    @@addr = a ^ MASK
  end

  def self.get : UInt64
    @@addr ^ MASK
  end
end

# === 1. Allocation and Alignment ===
puts "== allocation and alignment =="
blocks = [] of Pointer(UInt8)
sizes = [16, 24, 48, 96, 128, 256, 512, 1024]
idx = 0
while idx < 128
  sz = sizes[idx % sizes.size]
  b = Pointer(UInt8).malloc(sz.to_u64)
  if b.address & 7_u64 != 0_u64
    raise "alignment: block #{idx} is not 8-aligned at 0x#{hex(b.address)}"
  end
  bidx = 0
  while bidx < sz
    (b + bidx.to_i64).value = ((idx + bidx * 31) % 256).to_u8
    bidx = bidx + 1
  end
  blocks << b
  idx = idx + 1
end

idx = 0
while idx < blocks.size
  sz = sizes[idx % sizes.size]
  b = blocks[idx]
  bidx = 0
  while bidx < sz
    expected = ((idx + bidx * 31) % 256).to_u8
    actual = (b + bidx.to_i64).value
    if actual != expected
      raise "corruption: block #{idx} byte #{bidx} corrupted"
    end
    bidx = bidx + 1
  end
  idx = idx + 1
end
puts "allocation: 128 blocks across 8 sizes hold patterns, all 8-aligned"

# === 2. Collection and Reclamation ===
puts "== collection and reclamation =="
SeenLedger.forget
i = 0
while i < 100
  n = Node.new(i)
  SeenLedger.add(n.as(Pointer(Void)).address)
  i = i + 1
end

IyiMark.collect
swept = IyiMark.swept
freed = IyiMark.bytes_freed

if swept == 0_u64 || freed == 0_u64
  raise "reclamation: nothing was reclaimed by collection"
end

reused = 0_u64
j = 0
while j < 100
  fresh_node = Node.new(j + 5000)
  reused = reused + 1_u64 if SeenLedger.holds?(fresh_node.as(Pointer(Void)).address)
  j = j + 1
end

if reused == 0_u64
  raise "reclamation: no addresses were reused after collection"
end
puts "reclamation: #{count(swept)} chunks swept, #{count(freed)} bytes freed, #{count(reused)} of 100 allocations reused reclaimed addresses"

# === 3. Rooted Object Survival ===
puts "== rooted object survival =="
# Global root
RootedGlobal.head = Node.new(1111)
g_child = Node.new(2222)
g_head = RootedGlobal.head
if g_head.is_a?(Node)
  g_head.next = g_child
end

@[NoInline]
def check_stack_survival : Nil
  stack_root = Node.new(3333)
  stack_child = Node.new(4444)
  stack_root.next = stack_child
  p_stack = pointerof(stack_root)

  asm("" :: "r"(p_stack) : "memory")

  k = 0
  while k < 50
    garbage = Node.new(k + 9000)
    k = k + 1
  end

  IyiMark.collect

  sr = p_stack.value
  if sr.value != 3333
    raise "survival: stack root was corrupted or collected"
  end
  sc = sr.next
  if !sc.is_a?(Node) || sc.value != 4444
    raise "survival: child of stack root was corrupted or collected"
  end
end

check_stack_survival

# Verify global root survived intact
gh = RootedGlobal.head
if !gh.is_a?(Node) || gh.value != 1111
  raise "survival: global root was corrupted or collected"
end
gc = gh.next
if !gc.is_a?(Node) || gc.value != 2222
  raise "survival: child of global root was corrupted or collected"
end

puts "survival: global roots, stack roots, and reachable children all survived collection"

# === 4. Precision of Layout Scanning ===
puts "== precision and layout scan =="

@[NoInline]
def build_typed_graph : Nil
  decoy = Node.new(7777)
  DecoyHolder.set(decoy.as(Pointer(Void)).address)
  real_child = Node.new(8888)
  typed_root = TypedNode.new(DecoyHolder.get)
  typed_root.child = real_child
  RootedGlobal.typed = typed_root
end

@[NoInline]
def wipe_stack_frame : Nil
  a = 0_u64; b = 0_u64; c = 0_u64; d = 0_u64
  asm("" :: "r"(pointerof(a)) : "memory")
end

build_typed_graph
wipe_stack_frame

# Mark only (without sweep, so colours reflect reachability directly)
IyiMark.mark

t_node = RootedGlobal.typed
if t_node.is_a?(TypedNode)
  ch = t_node.child
  if !ch.is_a?(Node) || ch.value != 8888
    raise "precision: child of typed node was collected"
  end
  if IyiMark.colour(ch.as(Pointer(Void)).address) != IyiMark::BLACK
    raise "precision: real child was not marked black"
  end
end

decoy_addr = DecoyHolder.get
decoy_colour = IyiMark.colour(decoy_addr)
if decoy_colour != IyiMark::WHITE
  raise "precision: integer field holding address was followed by marker"
end

# Complete the collection by sweeping
IyiMark.sweep
puts "precision: typed node pointer field followed, integer field holding address not followed"

# === 5. Realloc ===
puts "== realloc =="
buf = Pointer(UInt8).malloc(64_u64)
bidx = 0
while bidx < 64
  (buf + bidx.to_i64).value = (bidx * 5 % 256).to_u8
  bidx = bidx + 1
end
new_buf = buf.realloc(256_u64)
bidx = 0
while bidx < 64
  expected = (bidx * 5 % 256).to_u8
  actual = (new_buf + bidx.to_i64).value
  if actual != expected
    raise "realloc: byte #{bidx} corrupted after growth"
  end
  bidx = bidx + 1
end
puts "realloc: data preserved across buffer growth"

# === 6. Weak References ===
puts "== weak references =="

# Made in a frame of their own: no slot of the caller's holds a target.
# The arrays are held by locals alone, and the collector runs whenever it
# is due while they are made: a local is a root, optimised or not.
def make_weak(held : Array(Node), refs : Array(WeakRef(Node))) : Nil
  widx = 0
  while widx < 200
    node = Node.new(widx)
    held << node if widx.even?
    refs << WeakRef.new(node)
    widx = widx + 1
  end
end

weak_held = [] of Node
weak_refs = [] of WeakRef(Node)
make_weak(weak_held, weak_refs)
wipe_stack_frame
IyiMark.collect
weak_kept = 0
weak_cleared = 0
widx = 0
while widx < 200
  target = weak_refs[widx].value
  if widx.even?
    weak_kept = weak_kept + 1 if !target.nil? && target.object_id == weak_held[widx // 2].object_id && target.value == widx
  elsif target.nil?
    weak_cleared = weak_cleared + 1
  elsif target.value != widx
    raise "weak: reference #{widx} answered memory that is no longer its target"
  end
  widx = widx + 1
end
raise "weak: #{weak_kept} of 100 held targets answered themselves" if weak_kept != 100
raise "weak: #{weak_cleared} of 100 targets nothing held were cleared" if weak_cleared < 95
puts "weak: 100 held targets answered, #{weak_cleared} of 100 others cleared by the collection"

# === 7. Objects held by locals alone ===
puts "== objects held by locals alone =="

# A WebAssembly local is not in linear memory, where the collector looks:
# the compiler keeps every value a call may outlive in a stack slot too
# (src/compiler/iyi/wasm_roots.cr). Each case below holds its objects in
# locals and nothing else, across a collection and enough allocation to
# reuse whatever it freed: an array at the top level and in a function, a
# call's first argument while its second is made, a chain held by its
# head, a union whose payload is a word, and a parameter across a
# collection in the callee.
# Zeroes the stack below the caller, frame by frame, before a collection:
# the frames of calls that returned still hold the addresses they made,
# the scan reads them, and a case would hold by a stale copy instead of by
# the slot it is about. After the recursive call, so it stays recursion.
@[NoInline]
def scrub_stack(depth : Int32) : Nil
  a = 0_u64; b = 0_u64; c = 0_u64; d = 0_u64; e = 0_u64; f = 0_u64; g = 0_u64; h = 0_u64
  i = 0_u64; j = 0_u64; k = 0_u64; l = 0_u64; m = 0_u64; n = 0_u64; o = 0_u64; p = 0_u64
  scrub_stack(depth - 1) if depth > 0
  asm("" :: "r"(pointerof(a)), "r"(pointerof(b)), "r"(pointerof(c)), "r"(pointerof(d)) : "memory")
  asm("" :: "r"(pointerof(e)), "r"(pointerof(f)), "r"(pointerof(g)), "r"(pointerof(h)) : "memory")
  asm("" :: "r"(pointerof(i)), "r"(pointerof(j)), "r"(pointerof(k)), "r"(pointerof(l)) : "memory")
  asm("" :: "r"(pointerof(m)), "r"(pointerof(n)), "r"(pointerof(o)), "r"(pointerof(p)) : "memory")
end

# A collection with nothing stale beneath it.
def collect_clean : Nil
  scrub_stack(48)
  IyiMark.collect
end

def churn(n : Int32) : Int32
  sum = 0
  n.times do |i|
    b = Node.new(i)
    sum = sum &+ b.value
  end
  sum
end

def pair(a : Node, b : Node) : Int32
  collect_clean
  churn(2000)
  a.value &+ b.value
end

def held_in_function : Int32
  kept = [] of Node
  200.times { |i| kept << Node.new(i) }
  collect_clean
  churn(2000)
  total = 0
  kept.each { |b| total = total &+ b.value }
  total
end

def either(i : Int32) : Node | Int32
  i > 0 ? Node.new(i) : i
end

# The same, made after a collection and enough allocation to reuse what it
# freed: whatever the caller holds meanwhile must be held in memory.
def either_after_collection(i : Int32) : Node | Int32
  collect_clean
  churn(2000)
  either(i)
end

def value_of(u : Node | Int32) : Int32
  u.is_a?(Node) ? u.value : u
end

def sum_either(a : Node | Int32, b : Node | Int32) : Int32
  value_of(a) &+ value_of(b)
end

locals_kept = [] of Node
200.times { |i| locals_kept << Node.new(i) }
collect_clean
churn(2000)
locals_total = 0
locals_kept.each { |b| locals_total = locals_total &+ b.value }
raise "locals: a top-level array held #{locals_kept.size} nodes summing to #{locals_total}, not 200 and 19900" unless locals_kept.size == 200 && locals_total == 19900

in_function = held_in_function
raise "locals: an array in a function summed to #{in_function}, not 19900" unless in_function == 19900

paired = pair(Node.new(40), Node.new(2))
raise "locals: a call's arguments added to #{paired}, not 42" unless paired == 42

locals_head = Node.new(0)
locals_node = locals_head
100.times do |i|
  locals_next = Node.new(i + 1)
  locals_node.next = locals_next
  locals_node = locals_next
end
collect_clean
churn(3000)
locals_length = 0
locals_cursor = locals_head.next
while c = locals_cursor
  locals_length = locals_length + 1
  raise "locals: link #{locals_length} of a chain holds #{c.value}" unless c.value == locals_length
  locals_cursor = c.next
end
raise "locals: a chain held by its head is #{locals_length} long, not 100" unless locals_length == 100

# Made here, not returned by a call: a union a call returns comes back in
# the caller's memory (wasm32 returns a struct that way), where the scan
# finds it anyway, while one made in place keeps its payload - the node's
# address - as a 32-bit integer and nothing else. Not a constant, or it
# folds away into a plain pointer.
locals_union = Program.args.size == 0 ? Node.new(Program.args.size + 77) : Program.args.size
collect_clean
churn(2000)
case locals_union
when Node
  raise "locals: a union's node holds #{locals_union.value}, not 77" unless locals_union.value == 77
else
  raise "locals: a union's node read back as #{locals_union}"
end
# A union returned by value, waiting as a call's first argument while the
# second is made.
unions = sum_either(either(Program.args.size + 30), either_after_collection(Program.args.size + 12))
raise "locals: two unions as a call's arguments added to #{unions}, not 42" unless unions == 42
puts "locals: a top-level array, an array in a function, a call's arguments, a chain, a union and unions as arguments held across a collection"

puts "all wasm32 collector checks passed"
