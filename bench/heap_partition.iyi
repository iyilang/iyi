# heap22's plumbing, driven: the first slice of the one-heap-per-pool-unit
# prototype (branch h22/heap-partition), in which every unit still
# allocates in the shared heap and nothing is meant to behave differently.
#
#   ./bin/iyi build bench/heap_partition.iyi && ./heap_partition
#   bash bench/heap_partition.sh       # this, and the broken copies
#
# What it checks, each by the word its failure starts with:
#
# - `records:` a partition's record (`IyiHeap.partition_new`) has an id of
#   its own that maps back to it, a freed record is the next one handed
#   out, ids run past one slab of 32, and no record is left live after the
#   tasks that made them end. With partitions in the runtime each `:new`
#   unit has a record of its own too, let go when the unit's last fiber
#   leaves the registry (design section 4.4), which may come after its
#   joiner has its answer: those are waited for, up to 2 s.
# - `caches:` a live record is on the caches list the pause strips, as a
#   thread's cache is, and a freed one is off it.
# - `bracket:` `IyiHeap.within` installs its record's cache for the block
#   and puts back what was there, and `IyiHeap.shared` installs the
#   thread's own cache inside it and puts the record back.
# - `switch:` a fiber parked inside `within` comes back to its record's
#   cache - on the main thread beside a fiber of the shared heap, which
#   must never see the record's, and on a pool where a unit's task parks on
#   one worker and resumes on another.
# - `fibers:` each unit's list of its fibers (`IyiUnit#fibers`) holds the
#   task and the three it spawned while they live, and the task alone once
#   they have ended.
# - `kept:` every object a task allocated inside its record and kept
#   across parks and collections still holds what it was built with.
#   Without partitions in the runtime the tasks' allocation triggers the
#   collections. With them (`-Dheap_partitions`) a unit's allocation
#   never feeds the global trigger, and a record no unit owns is
#   collected by the global collection alone (design section 4.2): each
#   task asks for one every 65,536 rounds in its record, then runs its
#   rounds again in its own unit's partition, where local collections
#   (section 4.1) must run on their own.
# - `dead:` (with partitions) a fiber is born in the shared heap and
#   outlives its unit through its task's handle, so nothing it keeps may
#   name the dead unit's partition: the waiter `park_on` keeps as its
#   spare is the shared heap's, and a reaped fiber lets its group and its
#   block go. `dead` runs this check alone, `dead quiet` its steps only.
#
# With no arguments it runs the checks on a pool of four workers and
# prints one fixed line, as every bench program's bare run does on CI.
# `W ROUNDS` sets the pool and each task's rounds.

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  import std/mutex::{Mutex}

  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  def records_check : Nil
    listed = IyiHeap.caches_listed
    a = IyiHeap.partition_new
    b = IyiHeap.partition_new
    ida = IyiHeap.partition_id(a)
    idb = IyiHeap.partition_id(b)
    fail("records: two live records share id #{ida}") if ida == idb || ida == 0_u64 || idb == 0_u64
    fail("records: id #{ida} maps to another record") unless IyiHeap.partition_at(ida) == a
    fail("records: id 0 maps to a record") unless IyiHeap.partition_at(0_u64) == 0_u64
    fail("caches: #{IyiHeap.caches_listed} caches listed with two live records, #{listed} before") unless IyiHeap.caches_listed == listed + 2_u64
    fail("caches: a live record is not on the caches list") unless IyiHeap.cache_listed?(a) && IyiHeap.cache_listed?(b)
    IyiHeap.partition_free(b)
    fail("caches: a freed record is still on the caches list") if IyiHeap.cache_listed?(b)
    fail("caches: freeing one record took another off the caches list") unless IyiHeap.cache_listed?(a)
    IyiHeap.partition_free(a)
    fail("caches: a freed record is still on the caches list") if IyiHeap.cache_listed?(a)
    fail("caches: the main thread's own cache is off the caches list") unless IyiHeap.cache_listed?(IyiHeap.home_page)
    fail("caches: #{IyiHeap.caches_listed} caches listed after both were freed, #{listed} before") unless IyiHeap.caches_listed == listed
    again = IyiHeap.partition_new
    fail("records: the record freed last was not the next one made") unless again == a
    IyiHeap.partition_free(again)
    # Past one slab: 100 at once, every id distinct and mapping back.
    held = [] of UInt64
    100.times { held << IyiHeap.partition_new }
    held.each_with_index do |record, i|
      id = IyiHeap.partition_id(record)
      fail("records: record #{i} of 100 has id #{id}, which maps elsewhere") unless IyiHeap.partition_at(id) == record
      j = i + 1
      while j < held.size
        fail("records: records #{i} and #{j} of 100 share id #{id}") if IyiHeap.partition_id(held[j]) == id
        j = j + 1
      end
    end
    fail("caches: #{IyiHeap.caches_listed} caches listed with 100 live records, #{listed} before") unless IyiHeap.caches_listed == listed + 100_u64
    held.each { |record| IyiHeap.partition_free(record) }
    fail("caches: #{IyiHeap.caches_listed} caches listed after 100 were freed, #{listed} before") unless IyiHeap.caches_listed == listed
    fail("records: #{IyiHeap.partitions_live} records live after every one was freed") unless IyiHeap.partitions_live == 0_u64
  end

  def bracket_check : Nil
    home = IyiHeap.installed_page
    fail("bracket: the main thread runs on #{home}, not its own cache #{IyiHeap.home_page}") unless home == IyiHeap.home_page
    record = IyiHeap.partition_new
    IyiHeap.within(record) do
      fail("bracket: within did not install its record") unless IyiHeap.installed_page == record
      kept = "inside #{record}"
      IyiHeap.shared do
        fail("bracket: shared did not install the thread's own cache") unless IyiHeap.installed_page == home
      end
      fail("bracket: shared did not put the record back") unless IyiHeap.installed_page == record
      IyiHeap.within(0_u64) do
        fail("bracket: within(0) did not install the thread's own cache") unless IyiHeap.installed_page == home
      end
      fail("bracket: within(0) did not put the record back") unless IyiHeap.installed_page == record
      fail("kept: a string made inside the record reads #{kept}") unless kept == "inside #{record}"
    end
    fail("bracket: within did not put the thread's own cache back") unless IyiHeap.installed_page == home
    IyiHeap.partition_free(record)
  end

  # Two fibers of the main thread taking turns, one inside a record.
  def main_switch_check : Nil
    home = IyiHeap.installed_page
    record = IyiHeap.partition_new
    there = Channel(Int64).new
    back = Channel(Int64).new
    group do |g|
      g.spawn(unit: :same) do
        100.times do
          got = there.receive
          fail("switch: the main thread's other fiber ran on #{IyiHeap.installed_page}, not its thread's cache #{home}") unless IyiHeap.installed_page == home
          back.send(got.is_a?(Int64) ? got &+ 1_i64 : -1_i64)
        end
      end
      IyiHeap.within(record) do
        i = 0_i64
        while i < 100_i64
          there.send(i)
          answer = back.receive
          fail("switch: round #{i} answered #{answer}") unless answer == i &+ 1_i64
          fail("switch: the fiber inside the record came back from a park on #{IyiHeap.installed_page}, not #{record}") unless IyiHeap.installed_page == record
          i = i + 1_i64
        end
      end
    end
    fail("switch: the main fiber ended its turns on #{IyiHeap.installed_page}, not #{home}") unless IyiHeap.installed_page == home
    IyiHeap.partition_free(record)
  end

  class Kept
    @id : Int64
    @label : String
    @parts : Array(Int64)

    def initialize(@id : Int64, @label : String, @parts : Array(Int64))
    end

    def intact? : Bool
      @label == "k#{@id}" && @parts.size == 3 && @parts[0] == @id && @parts[2] == @id &+ 2_i64
    end
  end

  # A task's rounds of allocation in the cache *record* names, parking
  # every eighth round and keeping a ring of objects, and a global
  # collection asked for every *every* rounds when it is not 0. Answers
  # how many objects read back wrong.
  def ring_rounds(task : Int64, rounds : Int64, record : UInt64, every : Int64) : Int64
    lost = 0_i64
    ring = Array(Kept?).new(256, nil)
    round = 0_i64
    while round < rounds
      id = task &* 1000000000_i64 &+ round
      made = Kept.new(id, "k#{id}", [id, id &+ 1_i64, id &+ 2_i64])
      lost = lost &+ 1_i64 unless made.intact?
      ring[(round % 256_i64).to_i] = made
      if round % 8_i64 == 0_i64
        sleep(0)
        fail("switch: task #{task} came back from a park on #{IyiHeap.installed_page}, not its record #{record}") unless IyiHeap.installed_page == record
      end
      IyiMark.collect if every != 0_i64 && round % every == every - 1_i64
      round = round + 1_i64
    end
    ring.each do |kept|
      lost = lost &+ 1_i64 if kept.is_a?(Kept) && !kept.intact?
    end
    lost
  end

  # A unit's task: three fibers of its own unit parked on a channel while
  # the list is read, then a record of its own for ROUNDS rounds of
  # allocation (`ring_rounds`). With partitions in the runtime the record
  # feeds no trigger, so the task asks for the global collections itself,
  # and then runs ROUNDS more in its unit's own partition, which collects
  # itself.
  def unit_task(task : Int64, rounds : Int64) : Int64
    unit = IyiScheduler.current.unit
    fail("fibers: a :new task has no unit") unless unit.is_a?(IyiUnit)
    gate = Channel(Int64).new
    group do |g|
      3.times { g.spawn(unit: :same) { gate.receive } }
      sleep(0)
      fail("fibers: the unit lists #{unit.fiber_count} fibers with its task and three of its own alive") unless unit.fiber_count == 4
      3.times { gate.send(task) }
    end
    waited = 0
    while unit.fiber_count != 1 && waited < 2000
      sleep(1)
      waited = waited + 1
    end
    fail("fibers: the unit still lists #{unit.fiber_count} fibers 2 s after three of its four ended") unless unit.fiber_count == 1
    first = unit.fibers
    me = IyiScheduler.current
    fail("fibers: the one fiber the unit lists is not its task") unless first.is_a?(IyiFiber) && first.object_id == me.object_id
    record = IyiHeap.partition_new
    lost = 0_i64
    every = 0_i64
    {% if flag?(:heap_partitions) %}
      every = 65536_i64
    {% end %}
    IyiHeap.within(record) do
      lost = ring_rounds(task, rounds, record, every)
    end
    IyiHeap.partition_free(record)
    {% if flag?(:heap_partitions) %}
      own = unit.heap
      fail("kept: task #{task}'s unit has no partition of its own") if own == 0_u64
      fail("switch: task #{task} runs on #{IyiHeap.installed_page} outside its record, not its unit's partition #{own}") unless IyiHeap.installed_page == own
      lost = lost &+ ring_rounds(task, rounds, own, 0_i64)
    {% end %}
    lost
  end

  {% if flag?(:heap_partitions) %}
    # A `:new` task that parks once on a lock main holds (`park_on`), then
    # runs a child of its own unit in a group made in its partition and
    # waits until the child is reaped. With *check* it asserts that
    # nothing the dead fibers keep names its partition; without, it only
    # does the same steps, so `-Dheap_verify`'s death check is what sees
    # a broken copy.
    def dead_task(slots : Mutex(Array(IyiFiber?)), go : Channel(Int64), check : Bool) : Int64
      unit = IyiScheduler.current.unit
      fail("dead: a :new task has no unit") unless unit.is_a?(IyiUnit)
      own = unit.heap
      fail("dead: the task's unit has no partition of its own") if own == 0_u64
      go.receive
      slots.lock { |s| s[0] = IyiScheduler.current }
      waiter = IyiScheduler.current.spare_waiter
      if check
        fail("dead: the task never parked on the lock main held") unless waiter.is_a?(IyiWaiter)
        at = IyiHeap.owner_of(waiter.object_id)
        fail("dead: park_on's waiter, the fiber's spare, was made in partition #{at}, not the shared heap") if at != 0_u64
      end
      group do |g|
        g.spawn(unit: :same) do
          slots.lock { |s| s[1] = IyiScheduler.current }
          0
        end.value
      end
      waited = 0
      while unit.fiber_count != 1 && waited < 2000
        sleep(1)
        waited = waited + 1
      end
      fail("dead: the unit still lists #{unit.fiber_count} fibers 2 s after its child ended") unless unit.fiber_count == 1
      if check
        child = slots.get { |s| s[1] }
        fail("dead: the child never ran") unless child.is_a?(IyiFiber)
        kept = child.group
        fail("dead: a reaped fiber still names its group, made in partition #{IyiHeap.owner_of(kept.object_id)}") if kept.is_a?(IyiGroup)
        fail("dead: a reaped fiber still names its block") unless child.proc.is_a?(Nil)
      end
      0_i64
    end

    # `dead:` a fiber is born in the shared heap and outlives its unit
    # through its task's handle, and the global mark still traces it: the
    # waiter `park_on` keeps as its spare is the shared heap's, and a
    # reaped fiber lets its group and its block go (HS4c's reports
    # IyiFiber#@spare_waiter and IyiFiber#@group; the block's context
    # named as IyiFiber#@proc once the group was let go, web_cores
    # `parallel` --reference, tmac).
    def dead_check(check : Bool) : Nil
      slots = Mutex.new { Array(IyiFiber?).new(2, nil) }
      go = Channel(Int64).new
      live = IyiHeap.partitions_live
      group do |g|
        handle = g.spawn(unit: :new) { dead_task(slots, go, check) }
        slots.lock do |s|
          go.send(1_i64)
          sleep(20)
        end
        fail("dead: the task answered #{handle.value}") unless handle.value == 0_i64
      end
      waited = 0
      while IyiHeap.partitions_live > live && waited < 2000
        sleep(1)
        waited = waited + 1
      end
      fail("dead: #{IyiHeap.partitions_live} records live 2 s after the task's unit ended, #{live} before") if IyiHeap.partitions_live > live
      return unless check
      task = slots.get { |s| s[0] }
      fail("dead: the task never took the lock") unless task.is_a?(IyiFiber)
      fail("dead: the reaped task still names its group") unless task.group.is_a?(Nil)
      fail("dead: the reaped task still names its block") unless task.proc.is_a?(Nil)
    end
  {% end %}

  arguments = Program.args
  # `dead` runs that check alone; `dead quiet` its steps without the
  # asserts, for `-Dheap_verify`'s death check (bench/heap_partition.sh).
  {% if flag?(:heap_partitions) %}
    if !arguments.empty? && arguments[0] == "dead"
      dead_check(arguments.size == 1)
      puts "dead: no dead fiber names its unit's partition"
      exit(0)
    end
  {% end %}
  quiet = arguments.empty?
  fail("usage: heap_partition WORKERS ROUNDS | dead [quiet]") unless quiet || arguments.size == 2
  workers = quiet ? 4 : arguments[0].to_i
  rounds = quiet ? 200000_i64 : arguments[1].to_i.to_i64
  records_check
  bracket_check
  main_switch_check
  IyiWorkers.count = workers
  collections = IyiMark.collections
  {% if flag?(:heap_partitions) %}
    locals = IyiHeap.local_collections
  {% end %}
  bad = 0_i64
  group do |g|
    handles = [] of IyiTask(Int64)
    (workers * 2).times do |t|
      handles << g.spawn(unit: :new) { unit_task(t.to_i64, rounds) }
    end
    handles.each do |handle|
      value = handle.value
      fail("a task answered #{value}") unless value.is_a?(Int64)
      bad = bad &+ value
    end
  end
  fail("kept: #{bad} objects made inside a record read back wrong") unless bad == 0_i64
  {% if flag?(:heap_partitions) %}
    waited = 0
    while IyiHeap.partitions_live != 0_u64 && waited < 2000
      sleep(1)
      waited = waited + 1
    end
    fail("records: #{IyiHeap.partitions_live} records live 2 s after every task freed its own and every unit ended") unless IyiHeap.partitions_live == 0_u64
    dead_check(true)
  {% else %}
    fail("records: #{IyiHeap.partitions_live} records live after every task freed its own") unless IyiHeap.partitions_live == 0_u64
  {% end %}
  ran = IyiMark.collections - collections
  {% if flag?(:heap_partitions) %}
    fail("kept: no global collection ran while the tasks allocated in their records, though each asked for one every 65536 rounds") if ran == 0_u64
    local = IyiHeap.local_collections - locals
    fail("kept: no local collection ran while the tasks allocated in their units' own partitions, so nothing was kept across one") if local == 0_u64
  {% else %}
    fail("kept: no collection ran while the tasks allocated, so nothing was kept across one") if ran == 0_u64
  {% end %}
  if quiet
    puts "heap partition: records, brackets, switches and unit fiber lists hold"
  else
    {% if flag?(:heap_partitions) %}
      puts "workers=#{workers} rounds=#{rounds} collections=#{ran} local=#{local}"
    {% else %}
      puts "workers=#{workers} rounds=#{rounds} collections=#{ran}"
    {% end %}
  end
{% else %}
  puts "heap partition: no pool on this target, nothing to check"
{% end %}
