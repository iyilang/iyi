; iyi-ir 1
source_filename = "unreachable_use"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
define internal iyicc i32 @f(i1 %c) {
entry:
  %x = add i32 1, 2
  br label %m
u:
  %y = add i32 %x, 1
  br label %m
m:
  %p = phi i32 [ %x, label %entry ], [ %x, label %u ]
  ret i32 %p
}

