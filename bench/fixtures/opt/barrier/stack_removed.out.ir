; iyi-ir 1
source_filename = "stack_removed"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @stack_removed(ptr %value) {
entry:
  %slot = alloca { ptr, ptr }, align 8
  %field = getelementptr inbounds { ptr, ptr }, ptr %slot, i32 0, i32 1
  br label %join
join:
  store ptr %value, ptr %field, align 8
  br label %done
done:
  ret void
}
