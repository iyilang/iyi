module main

import std/file
import std/text
using std/file::{File}

pub struct Token
  getter kind : String
  getter line : Int32
  getter col : Int32
  getter value : String

  def initialize(@kind : String, @line : Int32, @col : Int32, @value : String)
  end

  def dump : String
    "#{kind}\t#{line}\t#{col}\t#{value}"
  end
end

pub class Lexer
  @src : String
  @pending : Array(Token)
  @prev_kind : String
  @pos : Int32
  @line : Int32
  @col : Int32

  def initialize(@src : String)
    @pending = [] of Token
    @prev_kind = ""
    @pos = 0
    @line = 1
    @col = 1
  end

  def at_end? : Bool
    @pos >= @src.bytesize
  end

  def peek : Char
    return '\0' if at_end?
    @src[@pos]
  end

  def peek_at(offset : Int32) : Char
    i = @pos + offset
    return '\0' if i >= @src.bytesize
    @src[i]
  end

  def advance : Char
    c = peek
    @pos = @pos + 1
    if c == '\n'
      @line = @line + 1
      @col = 1
    else
      @col = @col + 1
    end
    c
  end

  def ident_start?(c : Char) : Bool
    c.ascii_letter? || c == '_'
  end

  def ident_char?(c : Char) : Bool
    c.ascii_alphanumeric? || c == '_'
  end

  # One token, or nil at end of input.
  def next_token : Token?
    # A string lexes as three tokens the way the current lexer does it:
    # the opening delimiter, the body, the closing delimiter. Queued here
    # rather than returned as an array, so the caller stays a simple loop.
    unless @pending.empty?
      return @pending.shift
    end
    return nil if at_end?
    line = @line
    col = @col
    c = peek

    if c == '\n'
      advance
      return Token.new("NEWLINE", line, col, "NEWLINE")
    end

    if c == ' ' || c == '\t'
      while !at_end? && (peek == ' ' || peek == '\t')
        advance
      end
      return Token.new("SPACE", line, col, "SPACE")
    end

    if c == '#'
      text = ""
      while !at_end? && peek != '\n'
        text = text + advance.to_s
      end
      return Token.new("COMMENT", line, col, text)
    end

    if c == '@'
      advance
      kind = "INSTANCE_VAR"
      if peek == '@'
        advance
        kind = "CLASS_VAR"
      end
      text = if kind == "CLASS_VAR"
               "@@"
             else
               "@"
             end
      while !at_end? && ident_char?(peek)
        text = text + advance.to_s
      end
      return Token.new(kind, line, col, text)
    end

    if ident_start?(c)
      text = ""
      while !at_end? && ident_char?(peek)
        text = text + advance.to_s
      end
      # `foo?` and `bar!` are one identifier, which is a lexing rule and
      # not a parsing one.
      if !at_end? && (peek == '?' || peek == '!')
        text = text + advance.to_s
      end
      if text == "_"
        return Token.new("_", line, col, "_")
      end
      kind = if c.ascii_uppercase?
               "CONST"
             else
               "IDENT"
             end
      return Token.new(kind, line, col, text)
    end

    # `-42` is one NUMBER, but `a - 42` is three tokens. What separates them
    # is what came before: after a value, a minus is subtraction.
    if c == '-' && peek_at(1).ascii_number? &&
       @prev_kind != "IDENT" && @prev_kind != "CONST" && @prev_kind != "NUMBER" &&
       @prev_kind != ")" && @prev_kind != "]" && @prev_kind != "INSTANCE_VAR"
      advance
      text = "-"
      while !at_end? && (peek.ascii_number? || (peek == '_' && !peek_at(1).ascii_letter?))
        text = text + advance.to_s
      end
      if peek == '.' && peek_at(1).ascii_number?
        text = text + advance.to_s
        while !at_end? && (peek.ascii_number? || (peek == '_' && !peek_at(1).ascii_letter?))
          text = text + advance.to_s
        end
      end
      if peek == '_' && peek_at(1).ascii_letter?
        advance
        while !at_end? && ident_char?(peek)
          advance
        end
      end
      return Token.new("NUMBER", line, col, text)
    end

    if c.ascii_number?
      text = ""
      while !at_end? && (peek.ascii_number? || (peek == '_' && !peek_at(1).ascii_letter?))
        text = text + advance.to_s
      end
      # A suffix (`_i64`, `_u8`, `_f32`) is consumed and dropped: the current
      # lexer records it as the number's kind rather than part of its text.
      if peek == '_' && peek_at(1).ascii_letter?
        advance
        while !at_end? && ident_char?(peek)
          advance
        end
        return Token.new("NUMBER", line, col, text)
      end

      # A float is one token. The dot only belongs to the number when a
      # digit follows it: `3.14` is a literal, `3.times` is a call.
      if peek == '.' && peek_at(1).ascii_number?
        text = text + advance.to_s
        while !at_end? && (peek.ascii_number? || (peek == '_' && !peek_at(1).ascii_letter?))
          text = text + advance.to_s
        end
      end
      if peek == '_' && peek_at(1).ascii_letter?
        advance
        while !at_end? && ident_char?(peek)
          advance
        end
      end
      return Token.new("NUMBER", line, col, text)
    end

    if c == '\''
      advance
      text = ""
      if peek == '\\'
        advance
        esc = advance
        text = "\\" + esc.to_s
      else
        text = advance.to_s
      end
      advance unless at_end?
      return Token.new("CHAR", line, col, text)
    end

    if c == '"'
      advance
      # An escape closes the piece it is in: the current lexer reports a
      # string body as runs of literal text with each escape as its own
      # token, and a port that merges them is a different token stream.
      text = ""
      pieces = [] of String
      kinds = [] of String
      while !at_end? && peek != '"'
        if peek == '#' && peek_at(1) == '{'
          # The interpolated expression is skipped rather than lexed, with
          # braces counted so a `{` inside it does not end it early. The
          # tree the current parser builds for an interpolated string is a
          # `StringInterpolation`, and this slice reproduces that node
          # rather than its contents: lexing the expression is the same
          # work as lexing the file, and it is done by the same loop when
          # this slice grows to call itself.
          unless text == ""
            pieces << text
            kinds << "STRING"
          end
          text = ""
          advance                # #
          advance                # {
          depth = 1
          while !at_end? && depth > 0
            ch = advance
            depth = depth + 1 if ch == '{'
            depth = depth - 1 if ch == '}'
          end
          pieces << "INTERPOLATION"
          kinds << "INTERPOLATION_START"
        elsif peek == '#'
          pieces << text unless text == ""
          kinds << "STRING" unless text == ""
          pieces << advance.to_s
          kinds << "STRING"
          text = ""
        elsif peek == '\\'
          pieces << text unless text == ""
          kinds << "STRING" unless text == ""
          advance
          esc = advance
          # Printed as the escape, not as the byte: a real newline inside a
          # token value turns a line-oriented dump into a liar.
          pieces << "\\" + esc.to_s
          kinds << "STRING"
          text = ""
        else
          text = text + advance.to_s
        end
      end
      unless text == ""
        pieces << text
        kinds << "STRING"
      end

      end_line = @line
      end_col = @col
      advance unless at_end?
      index = 0
      while index < pieces.size
        @pending << Token.new(kinds[index], line, col + 1, pieces[index])
        index = index + 1
      end
      @pending << Token.new("DELIMITER_END", end_line, end_col, "DELIMITER_END")
      return Token.new("DELIMITER_START", line, col, "DELIMITER_START")
    end

    # `[]`, `[]=` and `[]?` are one token: they are method names, and the
    # lexer is where that is decided.
    if c == '[' && peek_at(1) == ']'
      advance
      advance
      if peek == '=' || peek == '?'
        op = "[]#{advance}"
        return Token.new(op, line, col, op)
      end
      return Token.new("[]", line, col, "[]")
    end

    # Three characters before two before one. `...` is not `..` and `.`,
    # and `<=>` is not `<=` and `>`.
    three = "#{c}#{peek_at(1)}#{peek_at(2)}"
    if three == "..." || three == "<=>" || three == "===" || three == "**=" ||
       three == "||=" || three == "&&=" || three == "<<=" || three == ">>="
      advance
      advance
      advance
      return Token.new(three, line, col, three)
    end

    # Two-character operators before one, or `==` lexes as two `=`.
    two = "#{c}#{peek_at(1)}"
    if two == "==" || two == "!=" || two == "<=" || two == ">=" ||
       two == "&&" || two == "||" || two == "->" || two == "=>" ||
       two == "::" || two == ".." || two == "+=" || two == "-=" ||
       two == "*=" || two == "/=" || two == "%=" || two == "|=" ||
       two == "&=" || two == "^=" || two == "<<" || two == ">>" ||
       two == "=~" || two == "!~" || two == "&+" || two == "&-" ||
       two == "&*"
      advance
      advance
      return Token.new(two, line, col, two)
    end

    advance
    Token.new(c.to_s, line, col, c.to_s)
  end

  def dump_all : Nil
    while token = next_token
      # SPACE and NEWLINE do not count as "what came before": `x = -1`
      # has a space in it and the minus is still part of the literal.
      unless token.kind == "SPACE" || token.kind == "NEWLINE" || token.kind == "COMMENT"
        @prev_kind = token.kind
      end
      puts token.dump
    end
  end
end# The parser slice, written in iyi, over the lexer slice above.
#
# The AST is the shape the model experiment settled on: a union of node types
# with traits for the passes, rather than a class hierarchy iyi cannot have.
# One pass here, `sexp`, because the diff against the current parser is what
# this is for.
#
# Scope: a module header, `pub def` with typed arguments and a return type,
# assignment, calls with and without parentheses, identifiers, integer and
# string literals, and binary operators with precedence. Not yet: blocks,
# `if`/`while`, generics, traits and impls, macros, string interpolation.

pub struct PathNode
  getter names : String
  def initialize(@names : String)
  end
end

pub struct NumNode
  getter value : String
  def initialize(@value : String)
  end
end

pub struct StrNode
  getter value : String
  def initialize(@value : String)
  end
end

pub struct VarNode
  getter name : String
  def initialize(@name : String)
  end
end

pub struct ExtendNode
  def initialize
  end
end

# `(self)`, which is the only argument the injected `extend` ever takes.
pub struct SelfNode
  def initialize
  end
end

# A body that is not there: an `abstract def` has one, and so does a type
# whose body is empty.
pub struct NopNode
  def initialize
  end
end

# A string with an interpolation in it is a different node from a string,
# and the current parser says so. Its parts are not carried here: the
# oracle prints the node and this slice reproduces the node.
pub struct InterpNode
  def initialize
  end
end

# `import a/b` and `using a/b::{C}` are declarations, not calls. Reading
# them as calls is what the port did before, and it produced a tree that
# parsed the same text into a different program.
pub struct ImportNode
  def initialize
  end
end

# `[1, 2, 3]` is one node in the current parser, and its elements are not
# in the shape the oracle prints.
pub struct ArrayNode
  def initialize
  end
end

# `Array(Int32)` is a type applied to its arguments, not a call to a
# method named `Array`. Nested, because `Array(Array(Int32))` is one.
pub class GenericNode
  getter name : Array(Node)
  getter args : Array(Node)
  def initialize(@name : Array(Node), @args : Array(Node))
  end
end

pub struct HashNode
  def initialize
  end
end

pub struct TupleNode
  def initialize
  end
end

pub struct RangeNode
  def initialize
  end
end

pub struct CharNode
  def initialize
  end
end

# `String | Nil` is one type, and the current parser prints it as a node
# with no parts, so the port answers the node rather than the members.
pub struct UnionNode
  def initialize
  end
end

pub class AssocTypeNode
  getter name : String
  getter value : Array(Node)
  def initialize(@name : String, @value : Array(Node))
  end
end

pub class IfNode
  getter cond : Array(Node)
  getter then_branch : Array(Node)
  getter else_branch : Array(Node)
  def initialize(@cond : Array(Node), @then_branch : Array(Node), @else_branch : Array(Node))
  end
end

# `unless` is its own node in the current parser, with its branches in
# the order they were written. Building an `if` with them swapped is the
# same program and a different tree.
pub class UnlessNode
  getter cond : Array(Node)
  getter then_branch : Array(Node)
  getter else_branch : Array(Node)
  def initialize(@cond : Array(Node), @then_branch : Array(Node), @else_branch : Array(Node))
  end
end

pub class WhileNode
  getter cond : Array(Node)
  getter body : Array(Node)
  def initialize(@cond : Array(Node), @body : Array(Node))
  end
end

pub class ReturnNode
  getter value : Array(Node)
  def initialize(@value : Array(Node))
  end
end

# `&&` and `||` are their own nodes in the current parser, not calls to a
# method named `&&`: they short-circuit, and a call cannot.
pub class AndNode
  getter left : Array(Node)
  getter right : Array(Node)
  def initialize(@left : Array(Node), @right : Array(Node))
  end
end

pub class OrNode
  getter left : Array(Node)
  getter right : Array(Node)
  def initialize(@left : Array(Node), @right : Array(Node))
  end
end

pub struct BoolNode
  getter value : String
  def initialize(@value : String)
  end
end

pub struct NilNode
  def initialize
  end
end

# `!x`, and what `until` is written as: the current parser has no `until`
# node, it negates the condition of a `while`.
pub class NotNode
  getter exp : Array(Node)
  def initialize(@exp : Array(Node))
  end
end

pub struct UsingNode
  def initialize
  end
end

pub struct IvarNode
  getter name : String
  def initialize(@name : String)
  end
end

pub class TypeDeclNode
  getter target : Array(Node)
  getter declared : Array(Node)
  def initialize(@target : Array(Node), @declared : Array(Node))
  end
end

pub class TraitDefNode
  getter name : Array(Node)
  getter vars : String
  getter body : Array(Node)
  def initialize(@name : Array(Node), @vars : String, @body : Array(Node))
  end
end

# `struct` and `class` are one node with a flag in the current parser, and
# the flag decides what the program means, so the port carries it too.
pub class ClassDefNode
  getter kind : String
  getter name : Array(Node)
  getter vars : String
  getter body : Array(Node)
  def initialize(@kind : String, @name : Array(Node), @vars : String, @body : Array(Node))
  end
end

pub class ImplDefNode
  getter trait_name : Array(Node)
  getter target : Array(Node)
  getter vars : String
  getter body : Array(Node)
  def initialize(@trait_name : Array(Node), @target : Array(Node), @vars : String, @body : Array(Node))
  end
end

pub class CallNode
  getter name : String
  getter recv : Array(Node)
  getter args : Array(Node)
  def initialize(@name : String, @recv : Array(Node), @args : Array(Node))
  end
end

pub class AssignNode
  getter target : Array(Node)
  getter value : Array(Node)
  def initialize(@target : Array(Node), @value : Array(Node))
  end
end

pub class ArgNode
  getter name : String
  getter restriction : Array(Node)
  def initialize(@name : String, @restriction : Array(Node))
  end
end

pub class DefNode
  getter name : String
  getter args : Array(Node)
  getter ret : Array(Node)
  getter body : Array(Node)
  def initialize(@name : String, @args : Array(Node), @ret : Array(Node), @body : Array(Node))
  end
end

pub class ExprsNode
  getter items : Array(Node)
  def initialize(@items : Array(Node))
  end
end

pub class ModuleHeaderNode
  getter path : String
  def initialize(@path : String)
  end
end

pub class ModuleDefNode
  getter name : Array(Node)
  getter body : Array(Node)
  def initialize(@name : Array(Node), @body : Array(Node))
  end
end

# A single-element Array(Node) stands in for a nilable child: `Node?` would
# need Nil to implement every trait the union does, and an array of one says
# the same thing without that.
pub alias Node = PathNode | NumNode | StrNode | VarNode | ExtendNode |
                 CallNode | AssignNode | ArgNode | DefNode | ExprsNode |
                 ModuleHeaderNode | ModuleDefNode | SelfNode | NopNode |
                 IvarNode | TypeDeclNode | TraitDefNode | ClassDefNode |
                 ImplDefNode | InterpNode | ImportNode | UsingNode |
                 ArrayNode | IfNode | WhileNode | ReturnNode | AndNode |
                 OrNode | BoolNode | NilNode | NotNode | GenericNode |
                 HashNode | TupleNode | RangeNode | CharNode | UnlessNode |
                 UnionNode | AssocTypeNode

pub trait Sexp
  abstract def sexp : String
end

def sexp_list(nodes : Array(Node)) : String
  out = ""
  first = true
  nodes.each do |n|
    out = out + " " unless first
    out = out + n.sexp
    first = false
  end
  out
end

impl Sexp for PathNode
  def sexp : String
    "(path #{names})"
  end
end

impl Sexp for NumNode
  def sexp : String
    "(num #{value})"
  end
end

impl Sexp for StrNode
  def sexp : String
    "(str \"#{value}\")"
  end
end

impl Sexp for VarNode
  def sexp : String
    "(var #{name})"
  end
end

impl Sexp for ExtendNode
  def sexp : String
    # The injected `extend` extends the module with itself, and the oracle
    # prints the argument: `(extend (self))`, not `(extend)`.
    "(extend (self))"
  end
end

impl Sexp for SelfNode
  def sexp : String
    "(self)"
  end
end

impl Sexp for NopNode
  def sexp : String
    "(nop)"
  end
end

impl Sexp for InterpNode
  def sexp : String
    "(stringinterpolation)"
  end
end

impl Sexp for ImportNode
  def sexp : String
    "(importdecl)"
  end
end

impl Sexp for ArrayNode
  def sexp : String
    "(arrayliteral)"
  end
end

impl Sexp for GenericNode
  def sexp : String
    "(generic #{name[0].sexp} #{sexp_list(args)})"
  end
end

impl Sexp for HashNode
  def sexp : String
    "(hashliteral)"
  end
end

impl Sexp for TupleNode
  def sexp : String
    "(tupleliteral)"
  end
end

impl Sexp for RangeNode
  def sexp : String
    "(rangeliteral)"
  end
end

impl Sexp for CharNode
  def sexp : String
    "(charliteral)"
  end
end

impl Sexp for UnionNode
  def sexp : String
    "(union)"
  end
end

impl Sexp for AssocTypeNode
  def sexp : String
    return "(assoctype #{name})" if value.size == 0
    "(assoctype #{name} #{value[0].sexp})"
  end
end

impl Sexp for IfNode
  def sexp : String
    "(if #{cond[0].sexp} #{then_branch[0].sexp} #{else_branch[0].sexp})"
  end
end

impl Sexp for UnlessNode
  def sexp : String
    "(unless #{cond[0].sexp} #{then_branch[0].sexp} #{else_branch[0].sexp})"
  end
end

impl Sexp for WhileNode
  def sexp : String
    "(while #{cond[0].sexp} #{body[0].sexp})"
  end
end

impl Sexp for ReturnNode
  def sexp : String
    return "(return)" if value.size == 0
    "(return #{value[0].sexp})"
  end
end

impl Sexp for AndNode
  def sexp : String
    "(and #{left[0].sexp} #{right[0].sexp})"
  end
end

impl Sexp for OrNode
  def sexp : String
    "(or #{left[0].sexp} #{right[0].sexp})"
  end
end

impl Sexp for BoolNode
  def sexp : String
    "(bool #{value})"
  end
end

impl Sexp for NilNode
  def sexp : String
    "(nil)"
  end
end

impl Sexp for NotNode
  def sexp : String
    "(not #{exp[0].sexp})"
  end
end

impl Sexp for UsingNode
  def sexp : String
    "(usingdecl)"
  end
end

impl Sexp for IvarNode
  def sexp : String
    "(ivar #{name})"
  end
end

impl Sexp for TypeDeclNode
  def sexp : String
    "(typedecl #{target[0].sexp} : #{declared[0].sexp})"
  end
end

impl Sexp for TraitDefNode
  def sexp : String
    "(trait #{name[0].sexp}#{vars} #{body[0].sexp})"
  end
end

impl Sexp for ClassDefNode
  def sexp : String
    "(#{kind} #{name[0].sexp}#{vars} #{body[0].sexp})"
  end
end

impl Sexp for ImplDefNode
  def sexp : String
    "(impl #{trait_name[0].sexp} for #{target[0].sexp}#{vars} #{body[0].sexp})"
  end
end

impl Sexp for CallNode
  def sexp : String
    head = if recv.empty?
             "(call #{name}"
           else
             "(call #{recv[0].sexp}.#{name}"
           end
    if args.empty?
      head + ")"
    else
      head + " " + sexp_list(args) + ")"
    end
  end
end

impl Sexp for AssignNode
  def sexp : String
    "(assign #{target[0].sexp} #{value[0].sexp})"
  end
end

impl Sexp for ArgNode
  def sexp : String
    if restriction.empty?
      "(arg #{name})"
    else
      "(arg #{name} : #{restriction[0].sexp})"
    end
  end
end

impl Sexp for DefNode
  def sexp : String
    r = if ret.empty?
          ""
        else
          " -> #{ret[0].sexp}"
        end
    "(def #{name} (args #{sexp_list(args)})#{r} #{body[0].sexp})"
  end
end

impl Sexp for ExprsNode
  def sexp : String
    "(exprs #{sexp_list(items)})"
  end
end

impl Sexp for ModuleHeaderNode
  def sexp : String
    "(module #{path})"
  end
end

impl Sexp for ModuleDefNode
  def sexp : String
    "(moduledef #{name[0].sexp} #{body[0].sexp})"
  end
end

pub class Parser
  @tokens : Array(Token)
  @pos : Int32
  @locals : Array(String)
  @imports : Array(Node)
  @header : String

  # The imports a file declares, which the current parser puts beside the
  # module rather than inside it: `(exprs (module a/b) (importdecl)
  # (moduledef ...))`. `using` is the other half of the same pair and does
  # live in the body, so it is an ordinary statement.
  def imports : Array(Node)
    @imports
  end

  # The module path as written, empty when the file has no header. The
  # driver used to re-lex the file to find this and printed a header for a
  # file that had none.
  def header : String
    @header
  end

  def initialize(source : String)
    @tokens = [] of Token
    @pos = 0
    @locals = [] of String
    @imports = [] of Node
    @header = ""
    lexer = Lexer.new(source)
    while token = lexer.next_token
      # The parser works on significant tokens; newlines end statements and
      # are handled by looking at line numbers rather than by token.
      unless token.kind == "SPACE" || token.kind == "COMMENT"
        @tokens << token
      end
    end
  end

  def at_end? : Bool
    @pos >= @tokens.size
  end

  def peek : Token
    return Token.new("EOF", 0, 0, "EOF") if at_end?
    @tokens[@pos]
  end

  def peek_at(offset : Int32) : Token
    i = @pos + offset
    return Token.new("EOF", 0, 0, "EOF") if i >= @tokens.size
    @tokens[i]
  end

  def advance : Token
    t = peek
    @pos = @pos + 1
    t
  end

  # Everything left on the line the cursor is on. A declaration this slice
  # records but does not model is read this way: the node says what it is,
  # and the tokens it spans are not turned into a tree that would then have
  # to be kept in step with one.
  def skip_line : Nil
    line = peek.line
    while !at_end? && peek.line == line && peek.kind != "NEWLINE"
      advance
    end
  end

  def skip_newlines : Nil
    while peek.kind == "NEWLINE"
      advance
    end
  end

  def accept(value : String) : Bool
    if peek.kind == "IDENT" && peek.value == value
      advance
      true
    else
      false
    end
  end

  def accept_kind(kind : String) : Bool
    if peek.kind == kind
      advance
      true
    else
      false
    end
  end

  # module a/b -> the header, and the name the body is wrapped in
  def parse_module_header : String
    advance                      # module
    path = advance.value         # first segment
    while peek.kind == "/"
      advance
      path = path + "/" + advance.value
    end
    path
  end

  # `samples/init_order` names the type `Samples::InitOrder`: a segment is
  # camelised on its underscores, not just capitalised on its first letter.
  # Capitalising only the first produced `Init_order`, and four samples in
  # the corpus differed on their module name alone.
  def camelize(text : String) : String
    out = ""
    text.split('_').each do |part|
      next if part == ""
      out = out + part[0].upcase.to_s + part[1, part.size - 1]
    end
    out
  end

  def parse : Node
    skip_newlines
    header = ""
    if peek.kind == "IDENT" && peek.value == "module"
      header = parse_module_header
      @header = header
    end
    skip_newlines

    # Only a module hoists its leading imports out of itself. A file with
    # no header has nothing to hoist them out of, and they stay where they
    # were written.
    unless header == ""
      while peek.kind == "IDENT" && peek.value == "import"
        skip_line
        @imports << ImportNode.new.as(Node)
        skip_newlines
      end
    end

    body = [] of Node
    # The current parser injects an `extend` into a module's body, and a port
    # that skips it produces a different tree even when every statement agrees.
    # A file with no module has no body to extend.
    body << ExtendNode.new.as(Node) unless header == ""
    while !at_end?
      skip_newlines
      break if at_end?
      body << parse_statement
      skip_newlines
    end

    # `module samples/hello` names the type `Samples::Hello`: every segment
    # is capitalised and the path is kept, not just its last piece.
    mod_name = ""
    header.split("/").each do |segment|
      mod_name = mod_name + "::" unless mod_name == ""
      mod_name = mod_name + camelize(segment)
    end

    # A file with no `module` line is not wrapped in anything: the current
    # parser builds the statements and stops. `samples/iyi/std_text.iyi` is
    # one, and the port used to invent a module named after nothing.
    if header == ""
      return ExprsNode.new(body).as(Node)
    end

    ModuleDefNode.new(
      [PathNode.new(mod_name).as(Node)] of Node,
      [ExprsNode.new(body).as(Node)] of Node,
    ).as(Node)
  end

  # A statement, at the top of a file or inside a type. `pub` is a
  # visibility marker the tree does not carry, so it is consumed and the
  # decision is made on what follows it.
  def parse_statement : Node
    offset = 0
    offset = 1 if peek.kind == "IDENT" && peek.value == "pub"
    word = peek_at(offset)

    if word.kind == "IDENT"
      if word.value == "def"
        advance if offset == 1
        return parse_def(false)
      end
      if word.value == "abstract" &&
         peek_at(offset + 1).kind == "IDENT" && peek_at(offset + 1).value == "def"
        advance if offset == 1
        advance                  # abstract
        return parse_def(true)
      end
      if word.value == "trait"
        advance if offset == 1
        return parse_trait
      end
      if word.value == "struct" || word.value == "class"
        advance if offset == 1
        return parse_class(word.value)
      end
      if word.value == "impl"
        advance if offset == 1
        return parse_impl
      end
      if word.value == "using"
        advance if offset == 1
        skip_line
        return UsingNode.new.as(Node)
      end
      # An `import` before any statement is hoisted out of the module by
      # the current parser; one that comes after a statement stays where it
      # was written. `samples/init_order` is the file that says so, and it
      # is the file that exists to say so.
      if word.value == "import"
        advance if offset == 1
        skip_line
        return ImportNode.new.as(Node)
      end
      # `type Elem` in a trait, `type Elem = Int32` in an impl: the
      # requirement and the answer are the same node. Only a declaration
      # body writes this; anywhere else `type` is an ordinary name.
      if word.value == "type" && peek_at(offset + 1).kind == "CONST"
        advance if offset == 1
        advance                  # type
        assoc_name = advance.value
        value = [] of Node
        if peek.kind == "="
          advance
          value << parse_type
        end
        return AssocTypeNode.new(assoc_name, value).as(Node)
      end
      if word.value == "if" || word.value == "unless"
        advance if offset == 1
        return with_modifiers(parse_if(word.value == "unless"))
      end
      if word.value == "while" || word.value == "until"
        advance if offset == 1
        return with_modifiers(parse_while(word.value == "until"))
      end
    end
    if peek.kind == "IDENT" && peek.value == "return"
      advance
      value = [] of Node
      unless at_end? || peek.kind == "NEWLINE" ||
             (peek.kind == "IDENT" && (peek.value == "if" || peek.value == "unless"))
        value << parse_expression
      end
      return with_modifiers(ReturnNode.new(value).as(Node))
    end
    with_modifiers(parse_expression)
  end

  # The statements between a declaration's header and its `end`, as the one
  # node the current parser puts there: the statement itself when there is
  # one, an `Expressions` when there are several, a `Nop` when there are
  # none.
  # `expr if cond` and `expr unless cond`, applied to a statement once it
  # has been read. The trailing form is an `If` with the statement as its
  # only branch, which is the tree the current parser builds.
  def with_modifiers(node : Node) : Node
    result = node
    while peek.kind == "IDENT" && (peek.value == "if" || peek.value == "unless" ||
                                   peek.value == "while" || peek.value == "until")
      word = advance.value
      cond = parse_expression
      if word == "if"
        result = IfNode.new([cond] of Node, [result] of Node,
                            [NopNode.new.as(Node)] of Node).as(Node)
      elsif word == "unless"
        result = UnlessNode.new([cond] of Node, [result] of Node,
                                [NopNode.new.as(Node)] of Node).as(Node)
      elsif word == "while"
        result = WhileNode.new([cond] of Node, [result] of Node).as(Node)
      else
        result = WhileNode.new([NotNode.new([cond] of Node).as(Node)] of Node,
                               [result] of Node).as(Node)
      end
    end
    result
  end

  # The statements up to one of the words that can end a branch, as the one
  # node the current parser puts there.
  def parse_branch_body : Node
    items = [] of Node
    skip_newlines
    while !at_end? && !(peek.kind == "IDENT" &&
                        (peek.value == "end" || peek.value == "else" || peek.value == "elsif"))
      items << parse_statement
      skip_newlines
    end
    return NopNode.new.as(Node) if items.size == 0
    return items[0] if items.size == 1
    ExprsNode.new(items).as(Node)
  end

  # `if`, `elsif` and `else`, and `unless`, which is the same node with the
  # branches the other way round.
  def parse_if(negated : Bool) : Node
    advance                      # if or unless
    cond = parse_expression
    then_branch = parse_branch_body

    else_branch = NopNode.new.as(Node)
    if peek.kind == "IDENT" && peek.value == "elsif"
      # An `elsif` is an `if` in the else branch, and it consumes the `end`
      # that closes the whole chain.
      else_branch = parse_if(false)
      return build_if(negated, cond, then_branch, else_branch)
    end
    if peek.kind == "IDENT" && peek.value == "else"
      advance
      else_branch = parse_branch_body
    end
    advance                      # end
    build_if(negated, cond, then_branch, else_branch)
  end

  def build_if(negated : Bool, cond : Node, then_branch : Node, else_branch : Node) : Node
    if negated
      return UnlessNode.new([cond] of Node, [then_branch] of Node,
                            [else_branch] of Node).as(Node)
    end
    IfNode.new([cond] of Node, [then_branch] of Node, [else_branch] of Node).as(Node)
  end

  def parse_while(negated : Bool) : Node
    advance                      # while or until
    cond = parse_expression
    cond = NotNode.new([cond] of Node).as(Node) if negated
    body = parse_body
    WhileNode.new([cond] of Node, [body] of Node).as(Node)
  end

  def parse_body : Node
    items = [] of Node
    skip_newlines
    while !at_end? && !(peek.kind == "IDENT" && peek.value == "end")
      items << parse_statement
      skip_newlines
    end
    advance                      # end
    return NopNode.new.as(Node) if items.size == 0
    return items[0] if items.size == 1
    ExprsNode.new(items).as(Node)
  end

  # `struct Box(T)` declares a parameter, and the current parser prints it
  # beside the name: `(struct (path Box)(T) ...)`.
  def parse_type_vars : String
    return "" unless peek.kind == "("
    advance
    out = ""
    while peek.kind != ")" && !at_end?
      token = advance
      next if token.kind == ","
      out = out + " " unless out == ""
      out = out + token.value
    end
    advance                      # )
    "(" + out + ")"
  end

  def parse_trait : Node
    advance                      # trait
    name = advance.value
    vars = parse_type_vars
    TraitDefNode.new(
      [PathNode.new(name).as(Node)] of Node,
      vars,
      [parse_body] of Node,
    ).as(Node)
  end

  def parse_class(kind : String) : Node
    advance                      # struct or class
    name = advance.value
    vars = parse_type_vars
    ClassDefNode.new(
      kind,
      [PathNode.new(name).as(Node)] of Node,
      vars,
      [parse_body] of Node,
    ).as(Node)
  end

  def parse_impl : Node
    advance                      # impl
    # Both sides are types: `impl Show for Box(T) forall T` implements a
    # trait for a generic, and reading either as a bare name lost the
    # arguments.
    trait_name = parse_type
    advance                      # for
    target = parse_type

    vars = ""
    if peek.kind == "IDENT" && peek.value == "forall"
      advance
      names = ""
      while peek.kind == "CONST" || peek.kind == ","
        token = advance
        next if token.kind == ","
        names = names + " " unless names == ""
        names = names + token.value
      end
      vars = " forall " + names
    end

    ImplDefNode.new(
      [trait_name] of Node,
      [target] of Node,
      vars,
      [parse_body] of Node,
    ).as(Node)
  end

  def parse_def(is_abstract : Bool) : Node
    advance                      # def
    name = advance.value
    # A parameter is a local inside its own method and nowhere else. The
    # first version never restored this, so a `name` argument in one method
    # made every later `name` a variable, and `polite(name)` in a method
    # that had no such parameter parsed as a variable where the current
    # parser built a call to the getter.
    outer_locals = @locals.dup
    args = [] of Node
    # `def initialize(@value : Int32)` is an argument *and* an assignment:
    # the current parser names the argument `value` and puts `@value =
    # value` at the top of the body, so the port has to do both.
    assigns = [] of Node
    if peek.kind == "("
      advance
      while peek.kind != ")" && !at_end?
        # `&` and `&block : Int32 -> Nil` are the block parameter, which
        # the current parser keeps beside the arguments rather than among
        # them: a def that takes one prints `(args )`. Its name is still a
        # local, because the body calls it.
        if peek.kind == "&"
          advance
          if peek.kind == "IDENT"
            @locals << advance.value
          end
          depth = 0
          while !at_end?
            break if depth == 0 && (peek.kind == ")" || peek.kind == ",")
            k = advance.kind
            depth = depth + 1 if k == "(" || k == "["
            depth = depth - 1 if k == ")" || k == "]"
          end
          advance if peek.kind == ","
          next
        end

        raw = advance
        arg_name = raw.value
        if raw.kind == "INSTANCE_VAR"
          arg_name = raw.value[1, raw.value.size - 1]
          assigns << AssignNode.new(
            [IvarNode.new(raw.value).as(Node)] of Node,
            [VarNode.new(arg_name).as(Node)] of Node,
          ).as(Node)
        end
        @locals << arg_name
        restriction = [] of Node
        if peek.kind == ":"
          advance
          # A restriction is a type, and a type can be generic or a union:
          # reading it as a bare name made `links : Hash(String, Session)`
          # a path, and `String | Nil` a call.
          restriction << parse_type
        end
        args << ArgNode.new(arg_name, restriction).as(Node)
        advance if peek.kind == ","
      end
      advance                    # )
    end
    ret = [] of Node
    if peek.kind == ":"
      advance
      ret << parse_type
    end

    # `forall T`, and `forall T : Greet` with a bound. The parameters it
    # introduces are not in the shape the oracle prints, so the clause is
    # read to the end of the line and not modelled: a `forall` this slice
    # pretended to understand would be a tree that agrees by accident.
    if peek.kind == "IDENT" && peek.value == "forall"
      skip_line
    end

    # An `abstract def` has no body and no `end`: the requirement is the
    # whole declaration.
    if is_abstract
      @locals = outer_locals
      return DefNode.new(name, args, ret, [NopNode.new.as(Node)] of Node).as(Node)
    end

    body = [] of Node
    assigns.each { |a| body << a }
    skip_newlines
    while !at_end? && !(peek.kind == "IDENT" && peek.value == "end")
      body << parse_statement
      skip_newlines
    end
    advance                      # end

    inner = if body.size == 0
              NopNode.new.as(Node)
            elsif body.size == 1
              body[0]
            else
              ExprsNode.new(body).as(Node)
            end
    @locals = outer_locals
    DefNode.new(name, args, ret, [inner] of Node).as(Node)
  end

  # A type, which is not an expression: `String | Nil` is one type and
  # `a | b` is a call. Restrictions, return types and generic arguments
  # are read here, and nowhere else is.
  def parse_type : Node
    first = parse_primary
    return first unless peek.kind == "|"
    while peek.kind == "|"
      advance
      parse_primary
    end
    UnionNode.new.as(Node)
  end

  def parse_expression : Node
    left = parse_binary(0)

    # `1..10` and `1...10`. Looser than the arithmetic in its ends, so
    # `a + 1 .. b` is a range of two sums.
    if peek.kind == ".." || peek.kind == "..."
      advance
      parse_binary(0)
      left = RangeNode.new.as(Node)
    end

    # `value : Int32`, which is what a field declaration is and what a
    # macro call like `getter value : Int32` carries as its argument. The
    # `:` only means this after a name; a `def`'s return type is read where
    # the `def` is parsed, never here.
    if peek.kind == ":"
      target = [] of Node
      case left
      when VarNode  then target << left.as(Node)
      when IvarNode then target << left.as(Node)
      when CallNode
        # A bare name reads as a call everywhere else, and in front of a
        # `:` that is what `getter name : String` looks like by the time it
        # gets here. The declaration names a variable, so the target is
        # rebuilt as one.
        if left.recv.size == 0 && left.args.size == 0
          target << VarNode.new(left.name).as(Node)
        end
      end
      unless target.size == 0
        advance
        declared = parse_type
        return TypeDeclNode.new(target, [declared] of Node).as(Node)
      end
    end

    if peek.kind == "="
      advance
      value = parse_binary(0)
      case left
      when VarNode then @locals << left.name
      when CallNode
        # `a[i] = v` is one call, `[]=`, not an assignment to a call.
        if left.name == "[]"
          args = [] of Node
          left.args.each { |a| args << a }
          args << value
          return CallNode.new("[]=", left.recv, args).as(Node)
        end
      end
      return AssignNode.new([left] of Node, [value] of Node).as(Node)
    end
    left
  end

  # Tighter binds higher. `||` loosest, then `&&`, then the comparisons,
  # then the arithmetic: `a + 1 > b && c` groups the way it reads.
  def precedence(op : String) : Int32
    if op == "*" || op == "/" || op == "%"
      6
    elsif op == "+" || op == "-"
      5
    elsif op == "<<" || op == ">>"
      4
    elsif op == "==" || op == "!=" || op == "<" || op == ">" ||
          op == "<=" || op == ">=" || op == "<=>"
      3
    elsif op == "&&"
      2
    elsif op == "||"
      1
    else
      0
    end
  end

  def parse_binary(min : Int32) : Node
    left = parse_primary
    while !at_end?
      op = peek.kind
      prec = precedence(op)
      break if prec == 0 || prec < min
      advance
      right = parse_binary(prec + 1)
      if op == "&&"
        left = AndNode.new([left] of Node, [right] of Node).as(Node)
      elsif op == "||"
        left = OrNode.new([left] of Node, [right] of Node).as(Node)
      else
        left = CallNode.new(op, [left] of Node, [right] of Node).as(Node)
      end
    end
    left
  end

  # A block written with braces, consumed rather than parsed: the shape the
  # oracle prints for a call does not include its block, so a tree built
  # for one would be checked against nothing. `do ... end` is not here,
  # because a modifier `if` inside one has no `end` to match and a counter
  # that guessed would be wrong quietly.
  def skip_brace_block : Nil
    return unless peek.kind == "{"
    advance
    depth = 1
    while !at_end? && depth > 0
      k = advance.kind
      depth = depth + 1 if k == "{"
      depth = depth - 1 if k == "}"
    end
  end

  # Whether the word at the cursor opens something that an `end` closes.
  # `if` does when it starts a statement and does not when it trails one:
  # `return 0 if n < 0` has no `end`, and a counter that treated the two
  # alike would eat the `end` of whatever contained it.
  def opens_block?(index : Int32, word : String) : Bool
    return true if word == "do" || word == "def" || word == "class" ||
                   word == "struct" || word == "trait" || word == "impl" ||
                   word == "module" || word == "case" || word == "begin" ||
                   word == "enum" || word == "lib"
    return false unless word == "if" || word == "unless" ||
                        word == "while" || word == "until"
    return true if index == 0
    before = @tokens[index - 1]
    before.kind == "NEWLINE" || before.kind == "=" ||
      (before.kind == "IDENT" && (before.value == "do" || before.value == "else" ||
                                  before.value == "then" || before.value == "begin"))
  end

  def skip_do_block : Nil
    return unless peek.kind == "IDENT" && peek.value == "do"
    advance
    depth = 1
    while !at_end? && depth > 0
      index = @pos
      token = advance
      next unless token.kind == "IDENT"
      if token.value == "end"
        depth = depth - 1
      elsif opens_block?(index, token.value)
        depth = depth + 1
      end
    end
  end

  def skip_block : Nil
    skip_brace_block
    skip_do_block
  end

  # `a.b(c).d` is a chain of calls on the thing before the dot. Applied to
  # every primary, because a receiver can be a literal, a paren group or a
  # call as easily as a variable.
  def with_postfix(node : Node) : Node
    result = node
    while peek.kind == "." || peek.kind == "["
      # `parts[0]` is a call to `[]` on what precedes it, which is why it
      # chains with the dot rather than being its own kind of expression.
      if peek.kind == "["
        advance
        args = [] of Node
        while peek.kind != "]" && !at_end?
          args << parse_expression
          advance if peek.kind == ","
        end
        advance                  # ]
        # `links[path]?` is a call to `[]?`, a different method from `[]`:
        # one raises where the other answers nil.
        name = "[]"
        if peek.kind == "?"
          advance
          name = "[]?"
        end
        result = CallNode.new(name, [result] of Node, args).as(Node)
        next
      end
      advance
      name = advance.value
      args = [] of Node
      if peek.kind == "("
        advance
        while peek.kind != ")" && !at_end?
          args << parse_expression
          advance if peek.kind == ","
        end
        advance
      end
      skip_block
      result = CallNode.new(name, [result] of Node, args).as(Node)
    end
    result
  end

  def parse_primary : Node
    t = peek
    if t.kind == "INSTANCE_VAR"
      advance
      return with_postfix(IvarNode.new(t.value).as(Node))
    end
    if t.kind == "NUMBER"
      advance
      return with_postfix(NumNode.new(t.value).as(Node))
    end

    if t.kind == "CHAR"
      advance
      return with_postfix(CharNode.new.as(Node))
    end
    if t.kind == "DELIMITER_START"
      advance
      text = ""
      interpolated = false
      while peek.kind == "STRING" || peek.kind == "INTERPOLATION_START"
        piece = advance
        if piece.kind == "INTERPOLATION_START"
          interpolated = true
        else
          text = text + piece.value
        end
      end
      advance if peek.kind == "DELIMITER_END"
      return with_postfix(InterpNode.new.as(Node)) if interpolated
      return with_postfix(StrNode.new(text).as(Node))
    end
    if t.kind == "CONST"
      advance
      # `App::Greeter` is one path, not a path and an operator and another
      # path: the current parser reads the whole qualified name here.
      name = t.value
      while peek.kind == "::" && peek_at(1).kind == "CONST"
        advance
        name = name + "::" + advance.value
      end
      path = PathNode.new(name).as(Node)
      if peek.kind == "("
        advance
        targs = [] of Node
        while peek.kind != ")" && !at_end?
          targs << parse_type
          advance if peek.kind == ","
        end
        advance                  # )
        return with_postfix(GenericNode.new([path] of Node, targs).as(Node))
      end
      return with_postfix(path)
    end

    if t.kind == "{"
      # A brace in expression position is a literal, not a block: a block
      # only ever follows a call, and `with_postfix` reads it there. Which
      # literal it is depends on whether a `=>` turns up before the
      # matching brace.
      advance
      empty = peek.kind == "}"
      depth = 1
      is_hash = false
      while !at_end? && depth > 0
        k = advance.kind
        depth = depth + 1 if k == "{"
        depth = depth - 1 if k == "}"
        is_hash = true if depth == 1 && k == "=>"
      end

      # `{} of String => Array(String)` names both types, and both belong
      # to the literal rather than being a call to `of`. It is also the
      # only place an empty hash says it is one: there is no `=>` between
      # the braces to see, and reading `{} of String => Int32` as a tuple
      # is what the port did.
      if peek.kind == "IDENT" && peek.value == "of"
        advance
        parse_primary
        if peek.kind == "=>"
          advance
          parse_primary
          is_hash = true
        end
      end

      # `{}` on its own is an empty hash, not an empty tuple.
      is_hash = true if empty
      return with_postfix(HashNode.new.as(Node)) if is_hash
      return with_postfix(TupleNode.new.as(Node))
    end

    if t.kind == "[]"
      # `[]` is one token, because it is also a method name. Here it is an
      # empty array, and `[] of String` names what it is empty of.
      advance
      if peek.kind == "IDENT" && peek.value == "of"
        advance
        parse_primary
      end
      return with_postfix(ArrayNode.new.as(Node))
    end

    if t.kind == "["
      # Read to the matching bracket, counting nesting, and answer the node
      # the oracle prints. The elements are not in that shape, so parsing
      # them would be inventing a tree to be checked against nothing.
      advance
      depth = 1
      while !at_end? && depth > 0
        k = advance.kind
        depth = depth + 1 if k == "["
        depth = depth - 1 if k == "]"
      end
      # `[] of Greet` names the element type, and the name belongs to the
      # literal rather than being a call to `of`.
      if peek.kind == "IDENT" && peek.value == "of"
        advance
        parse_primary
      end
      return with_postfix(ArrayNode.new.as(Node))
    end
    if t.kind == "("
      advance
      inner = parse_expression
      advance if peek.kind == ")"
      # A paren group is an Expressions node in the current parser, not a
      # transparent wrapper, and the tree says so.
      return with_postfix(ExprsNode.new([inner] of Node).as(Node))
    end
    if t.kind == "!"
      advance
      return NotNode.new([parse_primary] of Node).as(Node)
    end

    if t.kind == "IDENT" && (t.value == "true" || t.value == "false")
      advance
      return with_postfix(BoolNode.new(t.value).as(Node))
    end

    if t.kind == "IDENT" && t.value == "nil"
      advance
      return with_postfix(NilNode.new.as(Node))
    end

    if t.kind == "IDENT"
      advance
      name = t.value
      if peek.kind == "("
        advance
        args = [] of Node
        while peek.kind != ")" && !at_end?
          args << parse_expression
          advance if peek.kind == ","
        end
        advance                  # )
        return with_postfix(CallNode.new(name, [] of Node, args).as(Node))
      end
      # A known local is a variable. So is a name about to be assigned:
      # `total = 0` declares it, and the assignment reads its target as a
      # variable rather than as a call to a method named `total`.
      if @locals.includes?(name)
        return with_postfix(VarNode.new(name).as(Node))
      end
      if peek.kind == "="
        return VarNode.new(name).as(Node)
      end
      if peek.line == t.line &&
         (peek.kind == "IDENT" || peek.kind == "NUMBER" || peek.kind == "DELIMITER_START" || peek.kind == "CONST")
        args = [] of Node
        args << parse_expression
        while peek.kind == ","
          advance
          args << parse_expression
        end
        return CallNode.new(name, [] of Node, args).as(Node)
      end
      # Everything else is a call with no arguments and no receiver, which
      # is what the current parser builds: whether `greet` is a method or a
      # local is not the parser's question, and answering it here made
      # `greet.upcase` a variable the semantic pass had never heard of.
      return with_postfix(CallNode.new(name, [] of Node, [] of Node).as(Node))
    end
    advance
    VarNode.new(t.value).as(Node)
  end
end

path = Program.args[0]?
if path.nil?
  puts "usage: parser <file.iyi>"
else
  source = File.read(path)
  parser = Parser.new(source)
  tree = parser.parse
  imports = ""
  parser.imports.each { |node| imports = imports + node.sexp + " " }
  if parser.header == ""
    # No header, no wrapper: the file's statements are the whole tree.
    puts tree.sexp
  else
    puts "(exprs (module #{parser.header}) #{imports}#{tree.sexp})"
  end
end
