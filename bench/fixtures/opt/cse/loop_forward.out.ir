; iyi-ir 1
source_filename = "loop_forward"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @loop_forward(ptr %p, i1 %again) {
entry:
  %before = load i64, ptr %p, align 8
  br label %head
head:
  br i1 %again, label %body, label %done
body:
  br label %head
done:
  %sum = add i64 %before, %before
  ret i64 %sum
}

define internal i64 @self_forward(ptr %p, i1 %again) {
entry:
  %before = load i64, ptr %p, align 8
  br label %loop
loop:
  br i1 %again, label %loop, label %done
done:
  %sum = add i64 %before, %before
  ret i64 %sum
}

define internal i64 @irreducible_forward(ptr %p, i1 %choose, i1 %again) {
entry:
  %before = load i64, ptr %p, align 8
  br i1 %choose, label %left, label %right
left:
  br i1 %again, label %right, label %left_done
right:
  br i1 %again, label %left, label %right_done
left_done:
  ret i64 %before
right_done:
  ret i64 %before
}

define internal i64 @loop_store_forward(ptr %p, i64 %x, i1 %again) {
entry:
  store i64 %x, ptr %p, align 8
  br label %loop
loop:
  br i1 %again, label %loop, label %done
done:
  ret i64 %x
}
