# Datagram sockets: UDP networking for iyi
#
# A native UDP socket with numeric IP resolution (IPv4 dotted-decimal, IPv6, and localhost).
#
# Address resolution:
# getaddrinfo is the standard route in libc, but on Linux it pulls in libc.so,
# dynamic NSS modules (libnss_dns, libnss_files), and resolver state, which destroys
# the zero-undefined-symbol dependency floor (SPEC.md III.9).
# By parsing numeric IPv4 dotted-decimal and IPv6 strings (and mapping "localhost" to
# 127.0.0.1) in pure iyi arithmetic without libc, Linux programs retain raw syscall
# purity (zero undefined symbols) and Darwin programs only link standard socket symbols
# provided by libSystem.
#
# Concurrency: every receive is `MSG_DONTWAIT`, and when nothing is queued
# the calling task parks on the descriptor the way `std/socket` does
# (SPEC.md III.4.2) - under the runtime on the poller, without one on a
# `poll`. So `receive_from` answers `T | Cancelled`: `!` passes a cancelled
# task through, `.or_panic` refuses it at the top level, and a socket
# closed by another task under a parked receive answers it too. The `?`
# variants answer nil when nothing is queued right now, and never park.
# There are no kernel timeouts and no non-blocking flag: a wait that must
# end is `poll_read(ms)` followed by `receive_from?`.

module std/udp

pub import std/slice
import std/slice::{Bytes, Slice}
import std/socket::{IPv4Address, IPv6Address, IyiSocket}

pub alias Bytes = Std::Slice::Bytes
# The address types, their parsers and the `sockaddr_in`/`sockaddr_in6`
# writers are `std/socket`'s; this module had copies, and the copies had
# drifted: its IPv6 parser read no dotted tail and its printer compressed
# only `::` and `::1`.
pub alias IPv4Address = Std::Socket::IPv4Address
pub alias IPv6Address = Std::Socket::IPv6Address

# An incoming datagram with payload bytes and remote peer origin.
pub struct Datagram
  getter data : Bytes
  getter host : String
  getter port : Int32

  def initialize(@data : Bytes, @host : String, @port : Int32)
  end

  def to_tuple : Tuple(Bytes, String, Int32)
    {@data, @host, @port}
  end

  def [](i : Int32) : Bytes | String | Int32
    if i == 0
      @data
    elsif i == 1
      @host
    elsif i == 2
      @port
    else
      raise "Datagram index #{i} is not 0, 1, or 2"
    end
  end

  # Decodes payload bytes as a String.
  def text : String
    String.new(@data.size) do |target|
      target.copy_from(@data.to_unsafe, @data.size)
    end
  end

  def to_s : String
    text
  end
end

pub class UdpSocket
  getter fd : Int32
  getter family : Int32
  @closed : Bool

  def initialize(fd : Int32 = -1, @family : Int32 = 2)
    if fd < 0
      @fd = UdpSocket.__sys_socket(@family)
      raise "cannot create UDP socket" if @fd < 0
    else
      @fd = fd
    end
    @closed = false
  end

  def to_unsafe : Int32
    @fd
  end

  private def check_open : Nil
    raise "socket is closed" if @fd < 0
  end

  # --- Factory Constructors ---

  # Creates an unbound UDP client socket.
  def self.client(family : Int32 = 2) : UdpSocket
    fd = __sys_socket(family)
    raise "cannot create UDP socket" if fd < 0
    UdpSocket.new(fd, family)
  end

  # Creates an unbound IPv6 UDP client socket.
  def self.client_v6 : UdpSocket
    client(AF_INET6)
  end

  # Creates an unbound UDP socket.
  def self.open(family : Int32 = 2) : UdpSocket
    client(family)
  end

  # Creates an unbound UDP socket.
  def self.unbound(family : Int32 = 2) : UdpSocket
    client(family)
  end

  # Binds a UDP socket to the specified host and port.
  # Automatically detects whether host is an IPv4 or IPv6 address.
  def self.bind(host : String, port : Int32) : UdpSocket
    addr, addrlen, family = make_sockaddr(host, port)
    fd = __sys_socket(family)
    raise "cannot create UDP socket" if fd < 0

    __sys_set_reuseaddr(fd)

    if __sys_bind(fd, addr, addrlen) < 0
      IyiSocket.__sys_close(fd)
      raise "cannot bind UDP socket to #{host}:#{port}"
    end

    UdpSocket.new(fd, family)
  end

  # Binds a UDP socket to 0.0.0.0 and the specified port.
  def self.bind(port : Int32) : UdpSocket
    bind("0.0.0.0", port)
  end

  # Binds an IPv6 UDP socket to [::] and the specified port.
  def self.bind6(port : Int32) : UdpSocket
    bind("::", port)
  end

  # --- Sending Datagrams ---

  # Sends bytes to a destination host and port.
  def send_to(bytes : Bytes, host : String, port : Int32) : Int32
    check_open
    addr, addrlen, _ = UdpSocket.make_sockaddr(host, port)
    res = UdpSocket.__sys_sendto(@fd, bytes.to_unsafe, bytes.size.to_u64, 0, addr, addrlen)
    raise "cannot send to #{host}:#{port}" if res < 0_i64
    res.to_i32
  end

  # Sends string contents as a datagram to a destination host and port.
  def send_to(str : String, host : String, port : Int32) : Int32
    send_to(Bytes.new(str.to_unsafe, str.bytesize), host, port)
  end

  # Sends a raw buffer to a destination host and port.
  def send_to(buffer : Pointer(UInt8), count : Int32, host : String, port : Int32) : Int32
    check_open
    raise "negative count: #{count}" if count < 0
    addr, addrlen, _ = UdpSocket.make_sockaddr(host, port)
    res = UdpSocket.__sys_sendto(@fd, buffer, count.to_u64, 0, addr, addrlen)
    raise "cannot send to #{host}:#{port}" if res < 0_i64
    res.to_i32
  end

  # --- Receiving Datagrams ---

  # One receive, parked when nothing is queued: `MSG_DONTWAIT`, and on
  # EAGAIN the task waits for the descriptor and asks again. A socket
  # closed while the task is parked wakes it, and `@fd` is gone.
  private def receive_into(buffer : Pointer(UInt8), capacity : Int32, addr : Pointer(UInt8)) : Int32 | Cancelled
    len = 28_u32
    while true
      raise "socket is closed" if @fd < 0
      count = UdpSocket.__sys_recvfrom(@fd, buffer, capacity.to_u64, MSG_DONTWAIT, addr, pointerof(len))
      next if count < 0_i64 && UdpSocket.__is_eintr(count)
      return count.to_i32 if count >= 0_i64
      # A datagram larger than the buffer. POSIX fills the buffer, drops
      # the rest and answers the bytes it wrote; Winsock refuses the call
      # with WSAEMSGSIZE and fills the buffer anyway. Measured before
      # this line: a ten-byte datagram read with a four-byte buffer
      # panicked with "cannot receive from UDP socket" on Windows and
      # answered four bytes everywhere else, so a program whose peer sent
      # more than it asked for died on one platform only.
      return capacity if UdpSocket.__is_msgsize(count)
      raise "cannot receive from UDP socket" unless UdpSocket.__is_eagain(count)
      {% if flag?(:win32) %}
        # Windows' readable-wait is destructive on a datagram socket: the
        # zero-byte overlapped read the scheduler posts takes the datagram
        # and answers nothing, and the `recvfrom` after one answers
        # WSAEWOULDBLOCK — measured. So the receive itself is the wait,
        # posted with this buffer, and the completion port answers it when a
        # datagram lands.
        posted = UdpSocket.__sys_recvfrom_posted(@fd, buffer, capacity, addr, pointerof(len))
        return posted
      {% else %}
        waited = IyiSocket.await_readable(@fd)
        return waited if waited.is_a?(Cancelled)
        return Cancelled.new if @fd < 0
      {% end %}
    end
  end

  # One receive that does not wait: what is queued now, or nil.
  private def receive_now(buffer : Pointer(UInt8), capacity : Int32, addr : Pointer(UInt8)) : Int32?
    check_open
    len = 28_u32
    while true
      count = UdpSocket.__sys_recvfrom(@fd, buffer, capacity.to_u64, MSG_DONTWAIT, addr, pointerof(len))
      next if count < 0_i64 && UdpSocket.__is_eintr(count)
      return count.to_i32 if count >= 0_i64
      return capacity if UdpSocket.__is_msgsize(count)
      return nil if UdpSocket.__is_eagain(count)
      raise "cannot receive from UDP socket"
    end
  end

  # Receives a datagram into a newly allocated Bytes slice up to max_bytes.
  # Answers {payload, peer_host, peer_port}, parking until one arrives.
  def receive_from(max_bytes : Int32 = 65536) : Tuple(Bytes, String, Int32) | Cancelled
    check_open
    raise "negative count: #{max_bytes}" if max_bytes < 0
    buffer = Pointer(UInt8).malloc(max_bytes.to_u64)
    addr = Pointer(UInt8).malloc(28_u64)
    count = receive_into(buffer, max_bytes, addr)
    return count if count.is_a?(Cancelled)
    bytes = Bytes.new(count)
    bytes.to_unsafe.copy_from(buffer, count)
    host, port = UdpSocket.format_address(addr)
    {bytes, host, port}
  end

  # Receives a datagram into a caller-supplied Bytes buffer.
  # Answers {subslice_of_received_bytes, peer_host, peer_port}.
  def receive_from(buffer : Bytes) : Tuple(Bytes, String, Int32) | Cancelled
    check_open
    addr = Pointer(UInt8).malloc(28_u64)
    count = receive_into(buffer.to_unsafe, buffer.size, addr)
    return count if count.is_a?(Cancelled)
    host, port = UdpSocket.format_address(addr)
    {buffer[0, count], host, port}
  end

  # What is queued now, or nil. Never parks.
  def receive_from?(max_bytes : Int32 = 65536) : Tuple(Bytes, String, Int32)?
    raise "negative count: #{max_bytes}" if max_bytes < 0
    buffer = Pointer(UInt8).malloc(max_bytes.to_u64)
    addr = Pointer(UInt8).malloc(28_u64)
    count = receive_now(buffer, max_bytes, addr)
    return nil if count.nil?
    bytes = Bytes.new(count)
    bytes.to_unsafe.copy_from(buffer, count)
    host, port = UdpSocket.format_address(addr)
    {bytes, host, port}
  end

  # Into a buffer: what is queued now, or nil. Never parks.
  def receive_from?(buffer : Bytes) : Tuple(Bytes, String, Int32)?
    addr = Pointer(UInt8).malloc(28_u64)
    count = receive_now(buffer.to_unsafe, buffer.size, addr)
    return nil if count.nil?
    host, port = UdpSocket.format_address(addr)
    {buffer[0, count], host, port}
  end

  # Receives a Datagram struct containing data, host, and port.
  def receive_datagram(max_bytes : Int32 = 65536) : Datagram | Cancelled
    res = receive_from(max_bytes)
    return res if res.is_a?(Cancelled)
    Datagram.new(res[0], res[1], res[2])
  end

  # A Datagram of what is queued now, or nil.
  def receive_datagram?(max_bytes : Int32 = 65536) : Datagram?
    res = receive_from?(max_bytes)
    return nil if res.nil?
    Datagram.new(res[0], res[1], res[2])
  end

  # --- Connected Socket Helpers ---

  # Connects the UDP socket to a remote host and port (sets default peer).
  def connect(host : String, port : Int32) : Nil
    check_open
    addr, addrlen, _ = UdpSocket.make_sockaddr(host, port)
    res = UdpSocket.__sys_connect(@fd, addr, addrlen)
    raise "cannot connect UDP socket to #{host}:#{port}" if res < 0
  end

  # Sends bytes to the connected peer.
  def send(bytes : Bytes) : Int32
    check_open
    res = UdpSocket.__sys_send(@fd, bytes.to_unsafe, bytes.size.to_u64)
    raise "cannot send on UDP socket" if res < 0_i64
    res.to_i32
  end

  # Sends string to the connected peer.
  def send(str : String) : Int32
    send(Bytes.new(str.to_unsafe, str.bytesize))
  end

  # Receives payload bytes from the connected peer, parking until some arrive.
  def receive(max_bytes : Int32 = 65536) : Bytes | Cancelled
    res = receive_from(max_bytes)
    return res if res.is_a?(Cancelled)
    res[0]
  end

  # Payload bytes queued now from the connected peer, or nil.
  def receive?(max_bytes : Int32 = 65536) : Bytes?
    res = receive_from?(max_bytes)
    return nil if res.nil?
    res[0]
  end

  # --- Metadata and Lifecycle ---

  # Reads back the locally bound port assigned by the OS.
  def local_port : Int32
    check_open
    addr = Pointer(UInt8).malloc(28_u64)
    len = 28_u32
    res = UdpSocket.__sys_getsockname(@fd, addr, pointerof(len))
    raise "cannot get local port" if res < 0

    (addr[2].to_i32 << 8) | addr[3].to_i32
  end

  # Reads back the locally bound IP address.
  def local_address : String
    check_open
    addr = Pointer(UInt8).malloc(28_u64)
    len = 28_u32
    res = UdpSocket.__sys_getsockname(@fd, addr, pointerof(len))
    raise "cannot get local address" if res < 0

    host, _ = UdpSocket.format_address(addr)
    host
  end

  # Closes the socket file descriptor.
  def close : Nil
    if @fd >= 0
      fd = @fd
      @fd = -1
      @closed = true
      {% if @top_level.has_constant?("IyiScheduler") %}
        # A task parked on this socket is woken first, and finds `@fd`
        # already gone; then the descriptor goes.
        wake_closed(fd)
      {% end %}
      IyiSocket.__sys_close(fd)
    end
  end

  def closed? : Bool
    @fd < 0 || @closed
  end

  # --- Buffer Sizes ---

  # Returns the current receive buffer size (SO_RCVBUF).
  def receive_buffer_size : Int32
    check_open
    UdpSocket.__sys_get_buffer_size(@fd, SOL_SOCKET, SO_RCVBUF)
  end

  # Sets the receive buffer size (SO_RCVBUF).
  def receive_buffer_size=(size : Int32) : Nil
    check_open
    raise "negative buffer size: #{size}" if size < 0
    res = UdpSocket.__sys_set_buffer_size(@fd, SOL_SOCKET, SO_RCVBUF, size)
    raise "cannot set receive buffer size" if res < 0
  end

  # Returns the current send buffer size (SO_SNDBUF).
  def send_buffer_size : Int32
    check_open
    UdpSocket.__sys_get_buffer_size(@fd, SOL_SOCKET, SO_SNDBUF)
  end

  # Sets the send buffer size (SO_SNDBUF).
  def send_buffer_size=(size : Int32) : Nil
    check_open
    raise "negative buffer size: #{size}" if size < 0
    res = UdpSocket.__sys_set_buffer_size(@fd, SOL_SOCKET, SO_SNDBUF, size)
    raise "cannot set send buffer size" if res < 0
  end

  # --- Waiting with a bound ---

  # Polls whether the socket is readable within timeout_ms milliseconds.
  # Returns true if a datagram is ready to be read, false on timeout.
  def poll_read(timeout_ms : Int32 = 0) : Bool
    check_open
    raise "negative timeout: #{timeout_ms}" if timeout_ms < 0
    UdpSocket.__sys_poll_read(@fd, timeout_ms)
  end

  # --- Address Parsing and Formatting ---

  def self.make_sockaddr(host : String, port : Int32) : Tuple(Pointer(UInt8), SockLen, Int32)
    raise "port #{port} is not a port: 0 to 65535" if port < 0 || port > 65535
    if host.includes?(":")
      {IyiSocket.make_sockaddr_in6(IyiSocket.parse_ipv6(host), port), SOCKADDR_IN6_SIZE, AF_INET6}
    else
      ip = IyiSocket.parse_ip(host)
      {IyiSocket.make_sockaddr_in(ip, port), SOCKADDR_IN_SIZE, 2}
    end
  end

  def self.format_address(addr : Pointer(UInt8)) : Tuple(String, Int32)
    port = (addr[2].to_i32 << 8) | addr[3].to_i32
    family = {% if flag?(:darwin) %} addr[1].to_i32 {% else %} addr[0].to_i32 {% end %}
    is_v6 = {% if flag?(:darwin) %} family == 30 {% elsif flag?(:win32) %} family == 23 {% else %} family == 10 {% end %}

    host = if is_v6
             IPv6Address.new(addr + 8_u64).to_s
           else
             "#{addr[4]}.#{addr[5]}.#{addr[6]}.#{addr[7]}"
           end
    {host, port}
  end

  # --- Platform System Call Bindings ---

  {% if flag?(:darwin) %}
    AF_INET6          =     30
    SOL_SOCKET        = 0xffff
    SO_REUSEADDR      = 0x0004
    SO_RCVBUF         = 0x1002
    SO_SNDBUF         = 0x1001
    MSG_DONTWAIT      =   0x80
    SOCKADDR_IN_SIZE  = 16_u32
    SOCKADDR_IN6_SIZE = 28_u32
    alias SockLen = UInt32

    lib LibC
      fun socket(domain : Int32, type : Int32, protocol : Int32) : Int32
      fun bind(fd : Int32, addr : Void*, addrlen : UInt32) : Int32
      fun connect(fd : Int32, addr : Void*, addrlen : UInt32) : Int32
      fun send(fd : Int32, buf : Void*, len : UInt64, flags : Int32) : Int64
      fun sendto(fd : Int32, buf : Void*, len : UInt64, flags : Int32, addr : Void*, addrlen : UInt32) : Int64
      fun recvfrom(fd : Int32, buf : Void*, len : UInt64, flags : Int32, addr : Void*, addrlen : UInt32*) : Int64
      fun getsockname(fd : Int32, addr : Void*, addrlen : UInt32*) : Int32
      fun setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32) : Int32
      fun getsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32*) : Int32
      fun kqueue : Int32
      fun kevent(kq : Int32, changelist : Void*, nchanges : Int32, eventlist : Void*, nevents : Int32, timeout : Void*) : Int32
      fun close(fd : Int32) : Int32
      fun __error : Int32*
    end

    def self.__sys_socket(domain : Int32 = 2) : Int32
      LibC.socket(domain, 2, 0)
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), len : UInt32) : Int32
      LibC.bind(fd, addr.as(Void*), len)
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), len : UInt32) : Int32
      LibC.connect(fd, addr.as(Void*), len)
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      LibC.send(fd, buf.as(Void*), len, 0)
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : UInt32) : Int64
      LibC.sendto(fd, buf.as(Void*), len, flags, addr.as(Void*), addrlen)
    end

    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      LibC.recvfrom(fd, buf.as(Void*), len, flags, addr.as(Void*), addrlen)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibC.getsockname(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_set_buffer_size(fd : Int32, level : Int32, optname : Int32, size : Int32) : Int32
      val = size
      LibC.setsockopt(fd, level, optname, pointerof(val).as(Void*), 4_u32)
    end

    def self.__sys_get_buffer_size(fd : Int32, level : Int32, optname : Int32) : Int32
      val = 0_i32
      len = 4_u32
      res = LibC.getsockopt(fd, level, optname, pointerof(val).as(Void*), pointerof(len))
      raise "cannot get buffer size" if res < 0
      val
    end

    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      val = 1_i32
      LibC.setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, pointerof(val).as(Void*), 4_u32)
    end

    def self.__sys_poll_read(fd : Int32, timeout_ms : Int32) : Bool
      kq = LibC.kqueue
      return false if kq < 0

      change = Pointer(UInt8).malloc(32_u64)
      i = 0; while i < 32
        change[i] = 0_u8; i = i + 1
      end
      change.as(Pointer(UInt64)).value = fd.to_u64
      # EVFILT_READ is -1 (0xFFFF), EV_ADD is 1
      change[8] = 0xFF_u8
      change[9] = 0xFF_u8
      change[10] = 0x01_u8
      change[11] = 0x00_u8

      null_ptr = Pointer(Void).new(0_u64)
      reg = LibC.kevent(kq, change.as(Void*), 1, null_ptr, 0, null_ptr)
      if reg < 0
        LibC.close(kq)
        return false
      end

      event = Pointer(UInt8).malloc(32_u64)
      i = 0; while i < 32
        event[i] = 0_u8; i = i + 1
      end

      sec = (timeout_ms // 1000).to_i64
      nsec = ((timeout_ms % 1000) * 1_000_000).to_i64
      ts = Pointer(UInt8).malloc(16_u64)
      ts.as(Pointer(Int64)).value = sec
      Pointer(Int64).new(ts.address + 8_u64).value = nsec

      nev = LibC.kevent(kq, null_ptr, 0, event.as(Void*), 1, ts.as(Void*))
      LibC.close(kq)
      nev > 0
    end

    def self.__is_eagain(res : Int64) : Bool
      res < 0_i64 && LibC.__error.value == 35
    end

    def self.__is_eintr(res : Int64) : Bool
      res < 0_i64 && LibC.__error.value == 4
    end

    # No such refusal: a datagram larger than the buffer fills it, the
    # rest is dropped and the length answered is what fit.
    def self.__is_msgsize(res : Int64) : Bool
      false
    end
  {% elsif flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    AF_INET6        = 10
    SOL_SOCKET         = 1
    SO_REUSEADDR       = 2
    SO_RCVBUF          = 8
    SO_SNDBUF          = 7
    MSG_DONTWAIT       = 0x40
    SOCKADDR_IN_SIZE   = 16_i64
    SOCKADDR_IN6_SIZE  = 28_i64
    alias SockLen = Int64

    {% if flag?(:x86_64) %}
      SYS_SOCKET        =  41_i64
      SYS_CONNECT       =  42_i64
      SYS_SENDTO        =  44_i64
      SYS_RECVFROM      =  45_i64
      SYS_BIND          =  49_i64
      SYS_GETSOCKNAME   =  51_i64
      SYS_SETSOCKOPT    =  54_i64
      SYS_GETSOCKOPT    =  55_i64
      SYS_EPOLL_CREATE1 = 291_i64
      SYS_EPOLL_CTL     = 233_i64
      SYS_EPOLL_PWAIT   = 281_i64
      EPOLL_DATA_OFFSET =   4_u64
    {% else %}
      SYS_SOCKET        = 198_i64
      SYS_BIND          = 200_i64
      SYS_CONNECT       = 203_i64
      SYS_GETSOCKNAME   = 204_i64
      SYS_SENDTO        = 206_i64
      SYS_RECVFROM      = 207_i64
      SYS_SETSOCKOPT    = 208_i64
      SYS_GETSOCKOPT    = 209_i64
      SYS_EPOLL_CREATE1 =  20_i64
      SYS_EPOLL_CTL     =  21_i64
      SYS_EPOLL_PWAIT   =  22_i64
      EPOLL_DATA_OFFSET =   8_u64
    {% end %}

    def self.__sys3(number : Int64, a : Int64, b : Int64, c : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys5(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys6(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64, f : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e), "{r9}"(f)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e), "{x5}"(f)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys_socket(domain : Int32 = 2) : Int32
      __sys3(SYS_SOCKET, domain.to_i64, 2_i64, 0_i64).to_i32
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), len : Int64) : Int32
      __sys3(SYS_BIND, fd.to_i64, addr.address.to_i64, len).to_i32
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), len : Int64) : Int32
      __sys3(SYS_CONNECT, fd.to_i64, addr.address.to_i64, len).to_i32
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      __sys6(SYS_SENDTO, fd.to_i64, buf.address.to_i64, len.to_i64, 0_i64, 0_i64, 0_i64)
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int64
      __sys6(SYS_SENDTO, fd.to_i64, buf.address.to_i64, len.to_i64, flags.to_i64, addr.address.to_i64, addrlen)
    end

    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      __sys6(SYS_RECVFROM, fd.to_i64, buf.address.to_i64, len.to_i64, flags.to_i64, addr.address.to_i64, addrlen.address.to_i64)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      __sys3(SYS_GETSOCKNAME, fd.to_i64, addr.address.to_i64, addrlen.address.to_i64).to_i32
    end

    def self.__sys_set_buffer_size(fd : Int32, level : Int32, optname : Int32, size : Int32) : Int32
      val = size
      __sys5(SYS_SETSOCKOPT, fd.to_i64, level.to_i64, optname.to_i64, pointerof(val).address.to_i64, 4_i64).to_i32
    end

    def self.__sys_get_buffer_size(fd : Int32, level : Int32, optname : Int32) : Int32
      val = 0_i32
      len = 4_u32
      res = __sys5(SYS_GETSOCKOPT, fd.to_i64, level.to_i64, optname.to_i64, pointerof(val).address.to_i64, pointerof(len).address.to_i64).to_i32
      raise "cannot get buffer size" if res < 0
      val
    end

    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      val = 1_i32
      __sys5(SYS_SETSOCKOPT, fd.to_i64, SOL_SOCKET.to_i64, SO_REUSEADDR.to_i64, pointerof(val).address.to_i64, 4_i64).to_i32
    end

    def self.__sys_poll_read(fd : Int32, timeout_ms : Int32) : Bool
      epfd = __sys3(SYS_EPOLL_CREATE1, 0_i64, 0_i64, 0_i64)
      return false if epfd < 0_i64

      event = Pointer(UInt8).malloc(16_u64)
      i = 0; while i < 16; event[i] = 0_u8; i = i + 1; end
      # EPOLLIN is 1
      event.as(Pointer(UInt32)).value = 1_u32
      Pointer(UInt64).new(event.address + EPOLL_DATA_OFFSET).value = fd.to_u64

      ctl = __sys6(SYS_EPOLL_CTL, epfd, 1_i64, fd.to_i64, event.address.to_i64, 0_i64, 0_i64)
      if ctl < 0_i64
        __iyi_close(epfd)
        return false
      end

      events = Pointer(UInt8).malloc(16_u64)
      count = __sys6(SYS_EPOLL_PWAIT, epfd, events.address.to_i64, 1_i64, timeout_ms.to_i64, 0_i64, 8_i64)
      __iyi_close(epfd)
      count > 0_i64
    end

    def self.__is_eagain(res : Int64) : Bool
      res == -11_i64 # -EAGAIN / -EWOULDBLOCK on Linux
    end

    def self.__is_eintr(res : Int64) : Bool
      res == -4_i64 # -EINTR on Linux
    end
    # No such refusal: a datagram larger than the buffer fills it, the
    # rest is dropped and the length answered is what fit.
    def self.__is_msgsize(res : Int64) : Bool
      false
    end

  {% elsif flag?(:win32) %}
    # AF_INET6 is 23 here, not Linux's 10 and not darwin's 30; the other
    # option numbers are Winsock's own too. `MSG_DONTWAIT` is 0 because
    # Winsock has no such flag — it answers WSAEOPNOTSUPP to the POSIX bit,
    # measured — so `__sys_socket` below makes every datagram socket
    # non-blocking instead, which is what makes the 0 honest.
    AF_INET6          =     23
    SOL_SOCKET        = 0xffff
    SO_RCVBUF         = 0x1002
    SO_SNDBUF         = 0x1001
    MSG_DONTWAIT      =      0
    SOCKADDR_IN_SIZE  =     16
    SOCKADDR_IN6_SIZE =     28
    alias SockLen = Int32

    SOCK_DGRAM  =  2
    IPPROTO_UDP = 17

    # See `std/socket`'s win32 arm for all three: the ioctl that is the only
    # route to a non-blocking socket on Windows, the SOCKET that is not a
    # descriptor, and the one kernel32 error a posted operation answers
    # with.
    FIONBIO          =            -2147195266
    INVALID_SOCKET   = 0xffffffffffffffff_u64
    ERROR_IO_PENDING =                    997
    # POLLRDNORM: a datagram is there to be read.
    POLLRDNORM = 0x0100_i16
    # SIO_UDP_CONNRESET, the ioctl that turns off the report below.
    SIO_UDP_CONNRESET = 0x9800000c_u32
    # WSA_IO_INCOMPLETE: what the read below answers while the operation it
    # is asked about is still under way.
    WSA_IO_INCOMPLETE = 996

    # This module's own bindings, the way each arm in this file has its own
    # `lib LibC`: `std/socket`'s block declares the stream calls it needs and
    # this one declares the datagram calls, which do not overlap. What is
    # *not* duplicated is `WSAStartup`, which is once per process rather than
    # once per module, so `__sys_socket` below asks `std/socket` for it.
    @[Link("ws2_32")]
    lib LibWs2_32
      fun WSAGetLastError : Int32
      fun socket(af : Int32, type : Int32, protocol : Int32) : UInt64
      fun bind(s : UInt64, addr : Void*, namelen : Int32) : Int32
      fun connect(s : UInt64, addr : Void*, namelen : Int32) : Int32
      fun send(s : UInt64, buf : Void*, len : Int32, flags : Int32) : Int32
      fun sendto(s : UInt64, buf : Void*, len : Int32, flags : Int32, addr : Void*,
                 addrlen : Int32) : Int32
      fun recvfrom(s : UInt64, buf : Void*, len : Int32, flags : Int32, addr : Void*,
                   addrlen : Int32*) : Int32
      fun getsockname(s : UInt64, addr : Void*, addrlen : Int32*) : Int32
      fun setsockopt(s : UInt64, level : Int32, optname : Int32, optval : Void*,
                     optlen : Int32) : Int32
      fun getsockopt(s : UInt64, level : Int32, optname : Int32, optval : Void*,
                     optlen : Int32*) : Int32
      fun ioctlsocket(s : UInt64, cmd : Int32, argp : Int32*) : Int32
      fun WSAIoctl(s : UInt64, code : UInt32, inbuf : Void*, inlen : Int32, outbuf : Void*,
                   outlen : Int32, returned : Int32*, overlapped : Void*, routine : Void*) : Int32
      fun WSARecvFrom(s : UInt64, buffers : WSABuf*, count : Int32, received : Int32*,
                      flags : Int32*, from : Void*, fromlen : Int32*, overlapped : Void*,
                      routine : Void*) : Int32
      fun WSAGetOverlappedResult(s : UInt64, overlapped : Void*, transferred : Int32*,
                                 wait : Int32, flags : Int32*) : Int32
      fun WSAPoll(fdarray : PollFd*, nfds : Int32, timeout : Int32) : Int32

      # Both are kept on the caller's frame rather than the heap: the kernel
      # reads and writes them after a post, while the fiber is parked, and a
      # heap chunk whose only reference is a local the posting call has
      # finished with is a chunk the collector can hand to somebody else
      # first.
      struct WSABuf
        len : Int32
        buf : UInt8*
      end

      struct PollFd
        fd : UInt64
        events : Int16
        revents : Int16
      end
    end

    def self.__sys_handle(fd : Int32) : UInt64
      fd.to_i64.unsafe_to_u64
    end

    # Winsock's error number, negated, which is the shape the POSIX arms
    # answer the kernel's errno in; the two predicates at the bottom are the
    # only things that read which number it was.
    def self.__sys_error : Int64
      -(LibWs2_32.WSAGetLastError.to_i64)
    end

    def self.__sys_socket(domain : Int32 = 2) : Int32
      IyiSocket.__sys_winsock
      s = LibWs2_32.socket(domain, SOCK_DGRAM, IPPROTO_UDP)
      return -1 if s == INVALID_SOCKET
      on = 1
      LibWs2_32.ioctlsocket(s, FIONBIO, pointerof(on))
      # Windows tells an *unconnected* datagram socket about the ICMP
      # port-unreachable its own earlier `sendto` provoked: the next receive
      # on it answers WSAECONNRESET instead of "nothing queued", and since
      # only WSAEWOULDBLOCK is read as that below, the receive panicked and
      # a server died of its first stale peer. Measured: a socket that sent
      # to dead port 9 answered -10054 to the next `recvfrom`. POSIX never
      # reports this, which is why the shared bodies have no case for it, so
      # the report is turned off here rather than taught to them — the cure
      # Windows itself offers.
      off = 0_i32
      returned = 0_i32
      LibWs2_32.WSAIoctl(s, SIO_UDP_CONNRESET, pointerof(off).as(Void*), 4,
        Pointer(Void).new(0_u64), 0, pointerof(returned), Pointer(Void).new(0_u64),
        Pointer(Void).new(0_u64))
      s.unsafe_to_i32
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), len : Int32) : Int32
      return __sys_error.to_i32 if LibWs2_32.bind(__sys_handle(fd), addr.as(Void*), len) != 0
      0
    end

    # A datagram socket's `connect` only records the peer, so there is no
    # handshake to wait for and nothing to post.
    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), len : Int32) : Int32
      return __sys_error.to_i32 if LibWs2_32.connect(__sys_handle(fd), addr.as(Void*), len) != 0
      0
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      n = LibWs2_32.send(__sys_handle(fd), buf.as(Void*), len.to_i32, 0)
      return n.to_i64 if n >= 0
      __sys_error
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32,
                          addr : Pointer(UInt8), addrlen : Int32) : Int64
      n = LibWs2_32.sendto(__sys_handle(fd), buf.as(Void*), len.to_i32, flags, addr.as(Void*), addrlen)
      return n.to_i64 if n >= 0
      __sys_error
    end

    # Winsock's address length is an `int*` where POSIX has a `socklen_t*`:
    # the same width and the same bytes, so the callers keep one signature.
    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32,
                            addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      n = LibWs2_32.recvfrom(__sys_handle(fd), buf.as(Void*), len.to_i32, flags, addr.as(Void*),
        addrlen.as(Pointer(Int32)))
      return n.to_i64 if n >= 0
      __sys_error
    end

    # The receive that waits, which on Windows is a posted one: see the note
    # in `receive_into` for why the readable-wait cannot be used here. The
    # buffer descriptor and the flags stay on this frame for the whole
    # operation, and the address and its length are the caller's, which
    # `receive_from` reads after this returns.
    def self.__sys_recvfrom_posted(fd : Int32, buf : Pointer(UInt8), capacity : Int32,
                                   addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32 | Cancelled
      # A cancelled task must not post: nothing would wake it but the
      # completion, and a datagram nobody sends never produces one.
      return Cancelled.new if IyiScheduler.current.cancelled
      s = __sys_handle(fd)
      descriptor = LibWs2_32::WSABuf.new(len: capacity, buf: buf)
      flags = 0_i32
      received = 0_i32
      ov = IyiScheduler.arm_overlapped_current(Pointer(Void).new(s))
      answered = LibWs2_32.WSARecvFrom(s, pointerof(descriptor), 1, pointerof(received),
        pointerof(flags), addr.as(Void*), addrlen.as(Pointer(Int32)), ov.as(Void*),
        Pointer(Void).new(0_u64))
      return received if answered == 0
      err = LibWs2_32.WSAGetLastError
      raise "cannot receive from UDP socket" if err != ERROR_IO_PENDING
      parked = IyiScheduler.park_overlapped_current
      if parked.is_a?(Cancelled)
        # `CancelIoEx` is a request, not an end: the descriptor above, the
        # caller's address and length, and the OVERLAPPED are the kernel's
        # until the operation is really over, and all of them are this
        # frame's or the caller's. Returning on the flag alone left the
        # kernel writing into a frame that is gone and an OVERLAPPED the
        # collector may already have handed to somebody else, so the
        # operation is waited out first — see `__sys_overlapped_await` for
        # what that wait has to be here. No datagram arrived that the caller
        # can have, which is what `Cancelled` says.
        __sys_overlapped_await(s, ov)
        return Cancelled.new
      end
      # The socket was closed under the park: a close does complete a posted
      # receive, and no datagram arrived, which is the same answer. A
      # datagram too large for the buffer ends the same operation with
      # WSAEMSGSIZE, and that one *did* arrive: the buffer holds its first
      # bytes, which is the answer POSIX gives without an error at all.
      result = __sys_overlapped_result(s, ov)
      return capacity if __is_msgsize(result)
      return Cancelled.new if result < 0_i64
      result.to_i32
    end

    # What the posted operation ended with, read off the operation itself:
    # the completion port's byte count cannot tell a failure from a datagram
    # of no bytes, which is a legal datagram. Nothing waits here, which is
    # what the 0 says.
    def self.__sys_overlapped_result(s : UInt64, ov : Pointer(UInt8)) : Int64
      transferred = 0_i32
      flags = 0_i32
      answered = LibWs2_32.WSAGetOverlappedResult(s, ov.as(Void*), pointerof(transferred), 0,
        pointerof(flags))
      return transferred.to_i64 if answered != 0
      __sys_error
    end

    # The wait a cancelled post still owes the kernel. `CancelIoEx` is a
    # request, and on a socket tied to a completion port the operation is not
    # over when it returns: measured here, the status stays STATUS_PENDING
    # and the descriptor, the caller's address and the OVERLAPPED are the
    # kernel's until the completion packet is taken *off the port* — the
    # poller's `GetQueuedCompletionStatus` is what writes them. The same
    # measurement on an unassociated socket had the status written by
    # `CancelIoEx` itself, which is why this is not obvious. So
    # `WSAGetOverlappedResult`'s own wait flag cannot be the wait either: it
    # waits on the OVERLAPPED's event, the scheduler's OVERLAPPED has none,
    # and the socket handle it falls back to is never signalled for a socket
    # on a port — it hung forever on the first cancelled receive tried.
    #
    # What ends the operation is the poller, so the frame parks once more and
    # lets it. `IyiScheduler.cancel` has already unregistered this fiber,
    # which is what would have left the packet to be dropped; parking puts it
    # back, and the wake means the dequeue has happened. Asked first, because
    # a completion the poller delivered *before* the cancel is already over
    # and no second packet is coming — parking on one would never wake.
    def self.__sys_overlapped_await(s : UInt64, ov : Pointer(UInt8)) : Int64
      result = __sys_overlapped_result(s, ov)
      return result if result != -(WSA_IO_INCOMPLETE.to_i64)
      IyiScheduler.park_overlapped_current
      __sys_overlapped_result(s, ov)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibWs2_32.getsockname(__sys_handle(fd), addr.as(Void*), addrlen.as(Pointer(Int32)))
    end

    def self.__sys_set_buffer_size(fd : Int32, level : Int32, optname : Int32, size : Int32) : Int32
      val = size
      LibWs2_32.setsockopt(__sys_handle(fd), level, optname, pointerof(val).as(Void*), 4)
    end

    def self.__sys_get_buffer_size(fd : Int32, level : Int32, optname : Int32) : Int32
      val = 0_i32
      len = 4
      res = LibWs2_32.getsockopt(__sys_handle(fd), level, optname, pointerof(val).as(Void*),
        pointerof(len))
      raise "cannot get buffer size" if res < 0
      val
    end

    # Nothing, for the reason `std/socket`'s win32 arm gives: SO_REUSEADDR on
    # Windows lets a different socket take a port this one is bound to, which
    # is not what the POSIX arms ask for with it. A datagram socket needs the
    # waiver even less than a listening one — there is no TIME_WAIT on a
    # port that never had a connection.
    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      0
    end

    # One descriptor, one event, and a bound on the wait, which is what the
    # epoll and kqueue arms do with theirs.
    def self.__sys_poll_read(fd : Int32, timeout_ms : Int32) : Bool
      entry = LibWs2_32::PollFd.new(fd: __sys_handle(fd), events: POLLRDNORM, revents: 0_i16)
      LibWs2_32.WSAPoll(pointerof(entry), 1, timeout_ms) > 0
    end

    def self.__is_eagain(res : Int64) : Bool
      res == -10035_i64 # -WSAEWOULDBLOCK, Winsock's own number
    end

    # Never: Winsock has no EINTR. A call either answers, or answers
    # WSAEWOULDBLOCK, or is posted and completed.
    def self.__is_eintr(res : Int64) : Bool
      false
    end

    # A datagram that did not fit is an error here where it is a silent
    # truncation everywhere else: WSAEMSGSIZE (10040), with the buffer
    # already filled, which is why the caller answers its capacity.
    def self.__is_msgsize(res : Int64) : Bool
      res == -10040_i64
    end
  {% else %}
    AF_INET6          =     10
    SOL_SOCKET        =      1
    SO_REUSEADDR      =      2
    SO_RCVBUF         =      8
    SO_SNDBUF         =      7
    MSG_DONTWAIT      =   0x40
    SOCKADDR_IN_SIZE  = 16_i64
    SOCKADDR_IN6_SIZE = 28_i64
    alias SockLen = Int64

    def self.__sys_socket(domain : Int32 = 2) : Int32
      raise "UdpSocket is not supported on this platform"
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), len) : Int32
      -1
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), len) : Int32
      -1
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      -1_i64
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen) : Int64
      -1_i64
    end

    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      -1_i64
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_set_buffer_size(fd : Int32, level : Int32, optname : Int32, size : Int32) : Int32
      -1
    end

    def self.__sys_get_buffer_size(fd : Int32, level : Int32, optname : Int32) : Int32
      -1
    end

    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      -1
    end

    def self.__sys_poll_read(fd : Int32, timeout_ms : Int32) : Bool
      false
    end

    def self.__is_eagain(res : Int64) : Bool
      false
    end

    def self.__is_eintr(res : Int64) : Bool
      false
    end

    # No such refusal: a datagram larger than the buffer fills it, the
    # rest is dropped and the length answered is what fit.
    def self.__is_msgsize(res : Int64) : Bool
      false
    end
  {% end %}
end
