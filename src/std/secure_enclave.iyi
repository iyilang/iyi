# Secure Enclave P-256 keys. The private key stays in the enclave; signatures
# are ECDSA over SHA-256, encoded as an X9.62 DER SEQUENCE of r and s.
#
#     import std/secure_enclave::{SecureEnclave, SecureEnclaveKey}
#     key = SecureEnclaveKey.generate.or_panic
#     signature = key.sign("message").or_panic
#     public_key = key.public_key
#     handle = key.handle
#     restored = SecureEnclaveKey.restore(handle).or_panic
#
# Generated keys are ephemeral, not keychain-persistent, and use the
# PrivateKeyUsage access-control flag without user-presence or biometric
# requirements. A handle is an opaque capability to use a key on this
# device: protect it accordingly. It is not a portable private-key export.
#
# `restore` accepts a token supplied by the caller and signs a challenge.
# A foreign token requiring user presence may prompt or block: never pass an
# untrusted handle. The challenge checks consistency, not provenance; when
# identity matters, compare the restored public key with an independently
# trusted public key.
#
# Apple can make a handle unusable, for example if the enclave's wrapping
# key is reset. Restore uses the Security.framework key attribute "toid",
# which is not declared in the SDK headers; if Apple withholds or changes it,
# an error is returned. No fixed length or internal layout is assumed.
# Security can return a public point from a damaged handle, so restore signs
# a fixed domain-separated message and verifies it under that point.
#
# An iyi key retains only copied bytes and its public key, not a CF object.
# Each operation opens and releases its own native key, so no finalizer or
# caller-managed close is needed. `available?` tries an ephemeral generation,
# and may be false on a Mac whose enclave is absent or unavailable.

@[Unsafe("Security.framework and CoreFoundation objects are managed through their C interfaces")]
module std/secure_enclave

{% unless flag?(:darwin) %}
  {% raise "std/secure_enclave requires macOS and its Secure Enclave; this target is not darwin" %}
{% end %}

import std/ecdsa::{EcdsaPublicKey, EcdsaCurve, EcdsaHash, EcdsaError}

@[Link(framework: "Security")]
lib LibEnclaveSecurity
  fun SecAccessControlCreateWithFlags(allocator : Void*, protection : Void*, flags : UInt64, error : Void**) : Void*
  fun SecKeyCreateRandomKey(attributes : Void*, error : Void**) : Void*
  fun SecKeyCreateWithData(data : Void*, attributes : Void*, error : Void**) : Void*
  fun SecKeyCopyAttributes(key : Void*) : Void*
  fun SecKeyCopyPublicKey(key : Void*) : Void*
  fun SecKeyCopyExternalRepresentation(key : Void*, error : Void**) : Void*
  fun SecKeyCreateSignature(key : Void*, algorithm : Void*, data : Void*, error : Void**) : Void*
end

@[Link(framework: "CoreFoundation")]
lib LibEnclaveCF
  fun dlsym(handle : Void*, symbol : UInt8*) : Void*
  fun CFDictionaryCreateMutable(allocator : Void*, capacity : Int64, key_callbacks : Void*, value_callbacks : Void*) : Void*
  fun CFDictionarySetValue(dictionary : Void*, key : Void*, value : Void*) : Void
  fun CFDictionaryGetValue(dictionary : Void*, key : Void*) : Void*
  fun CFNumberCreate(allocator : Void*, type : Int64, value : Void*) : Void*
  fun CFStringCreateWithCString(allocator : Void*, text : UInt8*, encoding : UInt32) : Void*
  fun CFStringGetLength(string : Void*) : Int64
  fun CFStringGetMaximumSizeForEncoding(length : Int64, encoding : UInt32) : Int64
  fun CFStringGetCString(string : Void*, buffer : UInt8*, size : Int64, encoding : UInt32) : UInt8
  fun CFDataCreate(allocator : Void*, bytes : UInt8*, length : Int64) : Void*
  fun CFDataGetLength(data : Void*) : Int64
  fun CFDataGetBytePtr(data : Void*) : UInt8*
  fun CFDataGetTypeID : UInt64
  fun CFGetTypeID(object : Void*) : UInt64
  fun CFErrorGetCode(error : Void*) : Int64
  fun CFErrorCopyDescription(error : Void*) : Void*
  fun CFRelease(object : Void*) : Void
end

# A Security.framework failure. A zero code means that no CFError was
# supplied, for example when an expected attribute is missing.
pub struct SecureEnclaveError
  getter message : String
  getter code : Int64

  def initialize(message : String, @code : Int64 = 0_i64)
    @message = "secure_enclave: #{message}"
  end

  def to_s : String
    @message
  end
end

impl Error for SecureEnclaveError
  def message : String
    @message
  end
end

pub struct SecureEnclave
  # This checks the actual ephemeral creation path, not the CPU model.
  def self.available? : Bool
    !SecureEnclaveKey.generate.is_a?(SecureEnclaveError)
  end
end

pub struct SecureEnclaveKey
  @handle : Array(UInt8)
  @public_bytes : Array(UInt8)
  getter public_key : EcdsaPublicKey

  private def initialize(@handle : Array(UInt8), @public_bytes : Array(UInt8), @public_key : EcdsaPublicKey)
  end

  def self.generate : SecureEnclaveKey | SecureEnclaveError
    callbacks = SecureEnclaveNative.callbacks!
    protection = SecureEnclaveNative.constant("kSecAttrAccessibleWhenUnlockedThisDeviceOnly")!
    is_permanent = SecureEnclaveNative.constant("kSecAttrIsPermanent")!
    false_value = SecureEnclaveNative.constant("kCFBooleanFalse")!
    access_control = SecureEnclaveNative.constant("kSecAttrAccessControl")!
    key_type = SecureEnclaveNative.constant("kSecAttrKeyType")!
    ec_type = SecureEnclaveNative.constant("kSecAttrKeyTypeECSECPrimeRandom")!
    key_size = SecureEnclaveNative.constant("kSecAttrKeySizeInBits")!
    token_id = SecureEnclaveNative.constant("kSecAttrTokenID")!
    enclave_id = SecureEnclaveNative.constant("kSecAttrTokenIDSecureEnclave")!
    private_key_attrs = SecureEnclaveNative.constant("kSecPrivateKeyAttrs")!
    null = SecureEnclaveNative.null
    error = null
    # kSecAccessControlPrivateKeyUsage only: no presence or biometric flags.
    access = LibEnclaveSecurity.SecAccessControlCreateWithFlags(null, protection, 1073741824_u64, pointerof(error))
    return SecureEnclaveNative.failure("create private-key access control", error) if access.address == 0
    bits = 256_i32
    number = LibEnclaveCF.CFNumberCreate(null, 9_i64, pointerof(bits).as(Void*))
    if number.address == 0
      LibEnclaveCF.CFRelease(access)
      return SecureEnclaveError.new("cannot allocate key size")
    end
    private_attrs = SecureEnclaveNative.dictionary(callbacks)
    attrs = SecureEnclaveNative.dictionary(callbacks)
    if private_attrs.address == 0 || attrs.address == 0
      SecureEnclaveNative.release(private_attrs)
      SecureEnclaveNative.release(attrs)
      LibEnclaveCF.CFRelease(number)
      LibEnclaveCF.CFRelease(access)
      return SecureEnclaveError.new("cannot allocate key attributes")
    end
    LibEnclaveCF.CFDictionarySetValue(private_attrs, is_permanent, false_value)
    LibEnclaveCF.CFDictionarySetValue(private_attrs, access_control, access)
    LibEnclaveCF.CFDictionarySetValue(attrs, key_type, ec_type)
    LibEnclaveCF.CFDictionarySetValue(attrs, key_size, number)
    LibEnclaveCF.CFDictionarySetValue(attrs, token_id, enclave_id)
    LibEnclaveCF.CFDictionarySetValue(attrs, private_key_attrs, private_attrs)
    key = LibEnclaveSecurity.SecKeyCreateRandomKey(attrs, pointerof(error))
    LibEnclaveCF.CFRelease(attrs)
    LibEnclaveCF.CFRelease(private_attrs)
    LibEnclaveCF.CFRelease(number)
    LibEnclaveCF.CFRelease(access)
    return SecureEnclaveNative.failure("generate Secure Enclave key", error) if key.address == 0
    SecureEnclaveNative.release(error)
    from_native(key)
  end

  # Restore trusted handles only: a foreign token can request user presence
  # during the signing check and can prompt or block. Compare public_key to
  # an independently trusted key when identity continuity matters.
  def self.restore(handle : Array(UInt8)) : SecureEnclaveKey | SecureEnclaveError
    key = SecureEnclaveNative.open(handle)
    return key if key.is_a?(SecureEnclaveError)
    restored = from_native(key)
    return restored if restored.is_a?(SecureEnclaveError)
    # Security can return a public key from a damaged token before checking
    # the wrapped private key. Force that check, and bind the answer to the
    # public point, before reporting a usable restored key.
    challenge = "std/secure_enclave handle integrity"
    signature = restored.sign(challenge)
    if signature.is_a?(SecureEnclaveError)
      return SecureEnclaveError.new("restore token handle: #{signature.message}", signature.code)
    end
    unless restored.public_key.verify(EcdsaHash::SHA256, challenge, signature)
      return SecureEnclaveError.new("restore token handle: signature does not match its public key")
    end
    restored
  end

  private def self.from_native(key : Void*) : SecureEnclaveKey | SecureEnclaveError
    result = SecureEnclaveNative.read_key(key)
    return result if result.is_a?(SecureEnclaveError)
    new(result[0], result[1], result[2])
  end

  # A copy: callers cannot change the key by changing the returned array.
  def handle : Array(UInt8)
    @handle.dup
  end

  # SEC 1 uncompressed point: 0x04, followed by 32-byte x and y coordinates.
  def public_bytes : Array(UInt8)
    @public_bytes.dup
  end

  def sign(message : Array(UInt8) | String) : Array(UInt8) | SecureEnclaveError
    algorithm = SecureEnclaveNative.constant("kSecKeyAlgorithmECDSASignatureMessageX962SHA256")!
    key = SecureEnclaveNative.open(@handle)
    return key if key.is_a?(SecureEnclaveError)
    size = message.is_a?(String) ? message.bytesize : message.size
    data = LibEnclaveCF.CFDataCreate(SecureEnclaveNative.null, message.to_unsafe, size.to_i64)
    if data.address == 0
      LibEnclaveCF.CFRelease(key)
      return SecureEnclaveError.new("cannot allocate message data")
    end
    error = SecureEnclaveNative.null
    signature = LibEnclaveSecurity.SecKeyCreateSignature(key, algorithm, data, pointerof(error))
    LibEnclaveCF.CFRelease(data)
    LibEnclaveCF.CFRelease(key)
    return SecureEnclaveNative.failure("sign with Secure Enclave key", error) if signature.address == 0
    SecureEnclaveNative.release(error)
    result = SecureEnclaveNative.bytes(signature)
    LibEnclaveCF.CFRelease(signature)
    result
  end
end

# CF Create and Copy results are owned here; Get results are borrowed and
# copied before their owner is released. A SecKey passed to read_key is
# consumed even on an error.
struct SecureEnclaveNative
  UTF8 = 0x08000100_u32

  def self.null : Void*
    Pointer(Void).new(0_u64)
  end

  def self.release(object : Void*) : Nil
    LibEnclaveCF.CFRelease(object) unless object.address == 0
  end

  # Directly reading this module's framework globals failed an .iyimod
  # round trip. Resolve them from the already-linked frameworks instead;
  # report a missing symbol before allocating any CF object.
  def self.symbol(name : String) : Void* | SecureEnclaveError
    # macOS dlfcn.h: RTLD_DEFAULT is (void *)-2.
    address = LibEnclaveCF.dlsym(Pointer(Void).new(0xfffffffffffffffe_u64), name.to_unsafe)
    return SecureEnclaveError.new("framework symbol #{name} is unavailable") if address.address == 0
    address
  end

  def self.constant(name : String) : Void* | SecureEnclaveError
    address = symbol(name)!
    value = address.as(Pointer(Void*))[0]
    return SecureEnclaveError.new("framework constant #{name} is null") if value.address == 0
    value
  end

  def self.callbacks : {Void*, Void*} | SecureEnclaveError
    keys = symbol("kCFTypeDictionaryKeyCallBacks")!
    values = symbol("kCFTypeDictionaryValueCallBacks")!
    {keys, values}
  end

  def self.dictionary(callbacks : {Void*, Void*}) : Void*
    LibEnclaveCF.CFDictionaryCreateMutable(null, 0_i64, callbacks[0], callbacks[1])
  end

  def self.failure(what : String, error : Void*) : SecureEnclaveError
    return SecureEnclaveError.new("#{what}: no CFError supplied") if error.address == 0
    code = LibEnclaveCF.CFErrorGetCode(error)
    description = LibEnclaveCF.CFErrorCopyDescription(error)
    why = description.address == 0 ? "no description" : string(description)
    release(description)
    LibEnclaveCF.CFRelease(error)
    SecureEnclaveError.new("#{what}: #{why} (CFError #{code})", code)
  end

  def self.string(value : Void*) : String
    length = LibEnclaveCF.CFStringGetLength(value)
    capacity = LibEnclaveCF.CFStringGetMaximumSizeForEncoding(length, UTF8) + 1_i64
    return "description unavailable" if capacity <= 0_i64
    buffer = Pointer(UInt8).malloc(capacity.to_u64)
    return "description unavailable" if LibEnclaveCF.CFStringGetCString(value, buffer, capacity, UTF8) == 0_u8
    size = 0
    while buffer[size] != 0_u8
      size = size + 1
    end
    String.new(size) { |dest| dest.copy_from(buffer, size) }
  end

  def self.bytes(data : Void*) : Array(UInt8)
    length = LibEnclaveCF.CFDataGetLength(data).to_i32
    ptr = LibEnclaveCF.CFDataGetBytePtr(data)
    Array(UInt8).new(length) { |i| ptr[i] }
  end

  def self.open(handle : Array(UInt8)) : Void* | SecureEnclaveError
    return SecureEnclaveError.new("restore: empty token handle") if handle.empty?
    callbacks = self.callbacks!
    token_id = constant("kSecAttrTokenID")!
    enclave_id = constant("kSecAttrTokenIDSecureEnclave")!
    token = LibEnclaveCF.CFDataCreate(null, handle.to_unsafe, handle.size.to_i64)
    name = LibEnclaveCF.CFStringCreateWithCString(null, "toid".to_unsafe, UTF8)
    attrs = dictionary(callbacks)
    if token.address == 0 || name.address == 0 || attrs.address == 0
      release(token)
      release(name)
      release(attrs)
      return SecureEnclaveError.new("restore: cannot allocate token attributes")
    end
    LibEnclaveCF.CFDictionarySetValue(attrs, token_id, enclave_id)
    LibEnclaveCF.CFDictionarySetValue(attrs, name, token)
    empty = LibEnclaveCF.CFDataCreate(null, Pointer(UInt8).new(0_u64), 0_i64)
    if empty.address == 0
      LibEnclaveCF.CFRelease(attrs)
      LibEnclaveCF.CFRelease(name)
      LibEnclaveCF.CFRelease(token)
      return SecureEnclaveError.new("restore: cannot allocate key data")
    end
    error = null
    key = LibEnclaveSecurity.SecKeyCreateWithData(empty, attrs, pointerof(error))
    LibEnclaveCF.CFRelease(empty)
    LibEnclaveCF.CFRelease(attrs)
    LibEnclaveCF.CFRelease(name)
    LibEnclaveCF.CFRelease(token)
    return failure("restore token handle", error) if key.address == 0
    release(error)
    key
  end

  def self.read_key(key : Void*) : {Array(UInt8), Array(UInt8), EcdsaPublicKey} | SecureEnclaveError
    attrs = LibEnclaveSecurity.SecKeyCopyAttributes(key)
    name = LibEnclaveCF.CFStringCreateWithCString(null, "toid".to_unsafe, UTF8)
    if attrs.address == 0 || name.address == 0
      release(attrs)
      release(name)
      LibEnclaveCF.CFRelease(key)
      return SecureEnclaveError.new("key attributes or toid name unavailable")
    end
    token = LibEnclaveCF.CFDictionaryGetValue(attrs, name)
    if token.address == 0 || LibEnclaveCF.CFGetTypeID(token) != LibEnclaveCF.CFDataGetTypeID
      LibEnclaveCF.CFRelease(name)
      LibEnclaveCF.CFRelease(attrs)
      LibEnclaveCF.CFRelease(key)
      return SecureEnclaveError.new("key has no toid token data")
    end
    handle = bytes(token)
    LibEnclaveCF.CFRelease(name)
    LibEnclaveCF.CFRelease(attrs)
    public_key = LibEnclaveSecurity.SecKeyCopyPublicKey(key)
    LibEnclaveCF.CFRelease(key)
    return SecureEnclaveError.new("cannot copy the enclave public key") if public_key.address == 0
    error = null
    data = LibEnclaveSecurity.SecKeyCopyExternalRepresentation(public_key, pointerof(error))
    LibEnclaveCF.CFRelease(public_key)
    return failure("export public key", error) if data.address == 0
    release(error)
    point = bytes(data)
    LibEnclaveCF.CFRelease(data)
    parsed = EcdsaPublicKey.from_point(EcdsaCurve::P256, point)
    return SecureEnclaveError.new("invalid enclave public key: #{parsed.message}") if parsed.is_a?(EcdsaError)
    {handle, point, parsed}
  end
end
