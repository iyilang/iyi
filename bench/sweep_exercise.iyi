# Stage 6 sweep, exercised rather than asserted. GC_DESIGN.md names the
# verification: unreachable objects are freed and heap space is reclaimed.
#
#   ./bin/iyi run bench/sweep_exercise.iyi
#
# This is the stage where the collector stops being a decision and starts being
# memory that comes back, so the check that matters is the one nobody can fake:
# allocate garbage, collect, allocate again, and see the same addresses handed
# out. A sweep that only counted things would pass while reclaiming nothing.
#
# Everything here needs the collector's allocator, the default on POSIX.
# Built with `-Dgc_none` or `-Dgc_boehm` the program says so in one
# line and exits 0, which is what stops a build that compiled the whole section
# out from reading as a pass.
#
# Not under `samples/`: the sample count is a gated number, and samples are
# explanations rather than torture tests.

@[Unsafe("it keeps addresses in a raw buffer the collector does not scan, so the sweep frees what only that buffer names")]
{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin) || (flag?(:win32) && flag?(:x86_64))) %}
  # The allocation-pressure trigger is off for this exercise: it
  # choreographs colours and free lists across explicit collections,
  # and a string interpolation running a collection mid-check would be
  # the trigger working, measured as a flake.
  # bench/collect_trigger.sh is where the trigger itself is proven.
  IyiMark.auto = false

  def count(value : UInt64) : String
    value.to_i64.to_s
  end

  def hex(value : UInt64) : String
    value.to_i64.to_s(16)
  end

  # Addresses recorded outside the heap, so recording one does not root it.
  class Seen
    LIMIT = 8192_u64

    @@buffer : UInt64 = 0_u64
    @@count : UInt64 = 0_u64

    def self.buffer : UInt64
      @@buffer = __iyi_mmap(LIMIT * 8_u64).address if @@buffer == 0
      @@buffer
    end

    def self.add(value : UInt64) : Nil
      raise "the ledger is full" if @@count >= LIMIT
      Pointer(UInt64).new(buffer + @@count * 8_u64).value = value
      @@count = @@count + 1_u64
    end

    def self.at(index : UInt64) : UInt64
      Pointer(UInt64).new(buffer + index * 8_u64).value
    end

    def self.count : UInt64
      @@count
    end

    def self.forget : Nil
      @@count = 0_u64
    end

    def self.holds?(value : UInt64) : Bool
      index = 0_u64
      while index < @@count
        return true if at(index) == value
        index = index + 1_u64
      end
      false
    end
  end

  class Held
    @@keep : UInt64 = 0_u64

    def self.keep : UInt64
      @@keep
    end

    def self.keep=(value : UInt64) : Nil
      @@keep = value
    end
  end

  def fresh(size : UInt64) : UInt64
    Pointer(UInt8).malloc(size).address
  end

  # The arenas mapped for one class, counted off the list of all of them.
  def class_arenas(index : Int32) : UInt64
    arenas = 0_u64
    arena = IyiHeap.first_arena
    while arena != 0
      arenas = arenas + 1_u64 if IyiHeap.arena_chunk(arena) == IyiHeap.chunk_of(index)
      arena = IyiHeap.arena_next(arena)
    end
    arenas
  end

  # Garbage: `count` chunks of `size` bytes nothing keeps.
  def burst(size : UInt64, count : UInt64) : Nil
    index = 0_u64
    while index < count
      fresh(size)
      index = index + 1_u64
    end
  end

  # The pages of a class's arenas the sweep listed warm on its batches,
  # which `IyiHeap.warm_of` (idle warm pages) does not count.
  def listed_in(index : Int32) : UInt64
    listed = 0_u64
    arena = IyiHeap.first_arena
    while arena != 0
      listed = listed + IyiHeap.read64(arena + IyiHeap::OFF_LISTED) if IyiHeap.arena_chunk(arena) == IyiHeap.chunk_of(index)
      arena = IyiHeap.arena_next(arena)
    end
    listed
  end

  # The pages of `arena` from the one `low` is on to the one `high - 1`
  # is on that are idle and warm - the ones the trim hands back. A chunk
  # reaching into cold pages is safe: they went back before it was
  # anybody's, and only a warm page is handed back later.
  def warm_pages_in(arena : UInt64, low : UInt64, high : UInt64) : UInt64
    pages = 0_u64
    page = low & (0_u64 &- IyiHeap::PAGE)
    while page < high
      pages = pages + 1_u64 if IyiHeap.page_idle?(arena, page) && !IyiHeap.page_cold?(arena, page)
      page = page + IyiHeap::PAGE
    end
    pages
  end

  # The runs of warm idle pages a class's arenas hold: each may keep its
  # first page warm past any room, when a chunk of the page before
  # reaches into it (`IyiMark.age_idle`).
  def warm_runs(index : Int32) : UInt64
    runs = 0_u64
    arena = IyiHeap.first_arena
    while arena != 0
      if IyiHeap.arena_chunk(arena) == IyiHeap.chunk_of(index)
        warm = false
        page = arena
        stop = arena + IyiHeap.read64(arena + IyiHeap::OFF_MAP)
        while page < stop
          now = IyiHeap.page_idle?(arena, page) && !IyiHeap.page_cold?(arena, page)
          runs = runs + 1_u64 if now && !warm
          warm = now
          page = page + IyiHeap::PAGE
        end
      end
      arena = IyiHeap.arena_next(arena)
    end
    runs
  end

  # Check 10's work for one class: warm runs threaded a slab's worth at
  # a time, as a refill threads them, up to `cuts` times - and, `reached`
  # asked, no more once a list's last chunk reaches into an idle page, so
  # that the trim meets that page; every chunk of every list written
  # whole, as the objects a program made of them would be; the last chunk
  # of each list checked to reach under a page into the idle rest of its
  # run; then the idle trim, and every byte read back. Answers how many
  # lists' last chunk reached into an idle page.
  def trim_threaded(size : UInt64, cuts : Int32, reached : Bool) : UInt64
    index = IyiHeap.class_index(size)
    chunk = IyiHeap.chunk_of(index)
    table = Pointer(UInt64).new(IyiHeap.cache_page)
    Seen.forget
    reaching = 0_u64
    cut = 0
    while cut < cuts && !(reached && reaching != 0_u64)
      head = IyiHeap.thread_warm_of(table, index)
      raise "cut: the #{count(chunk)}-byte class had no warm run left to thread at cut #{cut}" if head == 0_u64
      node = head
      last = 0_u64
      while node != 0_u64
        following = Pointer(UInt64).new(node).value
        byte = 0_u64
        while byte < chunk
          Pointer(UInt8).new(node + byte).value = 0xC3_u8
          byte = byte + 1_u64
        end
        Seen.add(node)
        last = node
        node = following
      end
      arena = IyiHeap.arena_of(last)
      reach = warm_pages_in(arena, last, last + chunk)
      raise "cut: the last chunk of a threaded warm run, #{count(chunk)} bytes at #{hex(last)}, reaches over #{count(reach)} idle pages of the rest of the run" if reach > 1_u64
      reaching = reaching + reach
      cut = cut + 1
    end
    released_before = IyiHeap.pages_released
    raise "trim: the idle trim found a collection under way in a program that runs none" unless IyiMark.trim_idle
    raise "trim: the idle trim handed back no page with the #{count(chunk)}-byte class's warm runs to hand back" if IyiHeap.pages_released == released_before
    entry = 0_u64
    while entry < Seen.count
      block = Seen.at(entry)
      byte = 0_u64
      while byte < chunk
        if Pointer(UInt8).new(block + byte).value != 0xC3_u8
          raise "trim: byte #{count(byte)} of a threaded #{count(chunk)}-byte chunk at #{hex(block)} reads #{count(Pointer(UInt8).new(block + byte).value.to_u64)} after the idle trim"
        end
        byte = byte + 1_u64
      end
      entry = entry + 1_u64
    end
    reaching
  end

  # Check 11b's work for one class: the window between a refill's taking
  # of a batch off the centre and its `adopt_batch`, which unlists the
  # batch's pages, replayed on this thread in that order with the idle
  # trim inside it. Garbage over five slices, collected and swept slice
  # by slice onto the centre (`IyiMark.sweep_one`); two batches of one
  # arena found whose ranges share a page the sweep listed - the lower
  # slice's last chunk reaches into it and the upper slice's run, going
  # on from the lower's listed pages, lists it whole (`IyiMark.close_run`);
  # one of the two taken off the centre as a refill takes it, the lower
  # or the upper as `take_lower` says; the trim; and the taken batch
  # adopted. Every chunk of the list the cache then holds must lie,
  # head and tail, on no idle page. Answers the shared page's chunks
  # on the list.
  def trim_edge(size : UInt64, take_lower : Bool) : UInt64
    index = IyiHeap.class_index(size)
    chunk = IyiHeap.chunk_of(index)
    line = IyiHeap.class_line(index)
    burst(size, (5_u64 * IyiMark::SWEEP_SPAN).unsafe_div(size))
    IyiMark.collect
    while IyiMark.sweep_one(size) == 1_u64
    end
    lower = 0_u64
    upper = 0_u64
    shared = 0_u64
    low_batch = IyiHeap.read64(line + IyiHeap::CLASS_BATCHES)
    while low_batch != 0_u64 && lower == 0_u64
      arena = low_batch & (0_u64 &- IyiHeap::MAP)
      last = IyiHeap.read64(low_batch + IyiHeap::BATCH_NEXT).unsafe_shr(IyiHeap::RANGE_SHIFT)
      high_batch = IyiHeap.read64(line + IyiHeap::CLASS_BATCHES)
      while high_batch != 0_u64 && lower == 0_u64
        if high_batch != low_batch && high_batch & (0_u64 &- IyiHeap::MAP) == arena &&
           IyiHeap.read64(high_batch + IyiHeap::OFF_LINK).unsafe_shr(IyiHeap::RANGE_SHIFT) == last &&
           IyiHeap.page_listed?(arena, arena + last * IyiHeap::PAGE)
          lower = low_batch
          upper = high_batch
          shared = arena + last * IyiHeap::PAGE
        end
        high_batch = IyiHeap.read64(high_batch + IyiHeap::BATCH_NEXT) & IyiHeap::LOW48
      end
      low_batch = IyiHeap.read64(low_batch + IyiHeap::BATCH_NEXT) & IyiHeap::LOW48
    end
    raise "edge: no two batches of the #{count(chunk)}-byte class share a listed page, so the trim's range edges were never at stake" if lower == 0_u64
    taken = take_lower ? lower : upper
    previous = 0_u64
    node = IyiHeap.read64(line + IyiHeap::CLASS_BATCHES)
    while node != taken
      previous = node
      node = IyiHeap.read64(node + IyiHeap::BATCH_NEXT) & IyiHeap::LOW48
    end
    following = IyiHeap.read64(taken + IyiHeap::BATCH_NEXT) & IyiHeap::LOW48
    if previous == 0_u64
      IyiHeap.write64(line + IyiHeap::CLASS_BATCHES, following)
    else
      IyiHeap.write64(previous + IyiHeap::BATCH_NEXT, (IyiHeap.read64(previous + IyiHeap::BATCH_NEXT) & (0_u64 &- IyiHeap::LOW48 &- 1_u64)) | following)
    end
    raise "edge: the idle trim found a collection under way in a program that runs none" unless IyiMark.trim_idle
    table = Pointer(UInt64).new(IyiHeap.cache_page)
    IyiHeap.adopt_batch(table, index, taken)
    on_shared = 0_u64
    node = table[index]
    while node != 0_u64
      arena = IyiHeap.arena_of(node)
      if IyiHeap.page_idle?(arena, node) || IyiHeap.page_idle?(arena, node + chunk - 1_u64)
        raise "edge: a #{count(chunk)}-byte chunk at #{hex(node)} on the #{take_lower ? "lower" : "upper"} batch, taken off the centre before the idle trim and adopted after it, lies on an idle page; the batches shared the page at #{hex(shared)}"
      end
      on_shared = on_shared + 1_u64 if node + chunk > shared && node < shared + IyiHeap::PAGE
      node = Pointer(UInt64).new(node).value
    end
    raise "edge: the #{take_lower ? "lower" : "upper"} batch has no chunk on the page it shares at #{hex(shared)}" if on_shared == 0_u64
    on_shared
  end

  # Garbage in a class nothing below asks for, made before the first
  # collection, for check 6c.
  def first_epoch_garbage(size : UInt64) : Nil
    index = 0
    while index < 64
      fresh(size)
      index = index + 1
    end
  end

  FIRST_EPOCH_SIZE = 1500_u64
  first_epoch_garbage(FIRST_EPOCH_SIZE)

  puts "== the exercise, the collector's allocator"

  # 1. Garbage is reclaimed, and the proof is reuse rather than a counter.
  # Allocate a batch nothing references, record the addresses, collect, then
  # allocate the same shape again. If the sweep put those chunks back on the
  # free list, the second batch is drawn from them.
  Seen.forget
  batch = 0_u64
  while batch < 300_u64
    Seen.add(fresh(96_u64))
    batch = batch + 1_u64
  end
  IyiMark.collect
  swept = IyiMark.swept
  freed = IyiMark.bytes_freed

  reused = 0_u64
  batch = 0_u64
  while batch < 300_u64
    reused = reused + 1_u64 if Seen.holds?(fresh(96_u64))
    batch = batch + 1_u64
  end
  raise "sweep: nothing was reclaimed, so no address came back" if reused == 0
  puts "    reclaimed: #{count(swept)} chunks swept and #{count(freed)} bytes freed, and #{count(reused)} of 300 new allocations came from addresses the sweep reclaimed"

  # 1b. Whole pages of dead chunks outlive the pause. The sweep keeps a
  # budget's worth of them warm on its batch and lists their pages; a
  # second collection before anything takes the batch drops every list -
  # and the listed pages become idle, warm, nobody's. The refill threads
  # them into the cache's list ahead of any slice or slab, so the batch
  # below comes from the first batch's pages, the class's high water does
  # not move, and every chunk comes back cleared, because a warm page
  # still holds what the dead object left. The class is its own: 64-byte
  # requests, 64-byte chunks - untyped memory is headless - four thousand of them across some seventy
  # pages.
  Seen.forget
  retained_before = IyiHeap.pages_retained
  rewarmed_before = IyiHeap.pages_rewarmed
  batch = 0_u64
  dirt = 0_u64
  while batch < 4096_u64
    block = fresh(64_u64)
    index = 0_u64
    while index < 64_u64
      Pointer(UInt8).new(block + index).value = 0xAA_u8
      index = index + 1_u64
    end
    # Read back, and reported below: a store nothing reads is a store
    # the back end may drop, and then the pages hold nothing to clear.
    dirt = dirt + Pointer(UInt8).new(block + (batch & 63_u64)).value.to_u64
    Seen.add(block)
    batch = batch + 1_u64
  end
  IyiMark.collect
  warm_index = IyiHeap.class_index(64_u64)
  while IyiHeap.sweep_left_of(warm_index) != 0_u64
    IyiMark.sweep_one(64_u64)
  end
  retained = IyiHeap.pages_retained - retained_before
  raise "warm: #{count(IyiMark.swept)} chunks swept and no page of them kept warm" if retained == 0
  # The second pause: the batch nobody took is dropped, its pages idle.
  IyiMark.collect
  idle_warm = 0_u64
  arena = IyiHeap.first_arena
  while arena != 0
    idle_warm = idle_warm + IyiHeap.read64(arena + IyiHeap::OFF_WARM) if IyiHeap.arena_chunk(arena) == 64_u64
    arena = IyiHeap.arena_next(arena)
  end
  raise "warm: #{count(retained)} pages kept warm and none of them idle after a second pause, so the kept pages died with the lists" if idle_warm == 0
  high_before = 0_u64
  arena = IyiHeap.first_arena
  while arena != 0
    high_before = high_before + IyiHeap.arena_high(arena) - arena if IyiHeap.arena_chunk(arena) == 64_u64
    arena = IyiHeap.arena_next(arena)
  end
  reused = 0_u64
  batch = 0_u64
  while batch < 4096_u64
    # The allocator's own clearing entry, as a class instance reaches it:
    # `Pointer.malloc` clears again on its own in codegen and would hide a
    # chunk the allocator handed out dirty.
    words = IyiHeap.alloc(64_u64)
    reused = reused + 1_u64 if Seen.holds?(words.address)
    index = 0_u64
    while index < 64_u64
      if Pointer(UInt8).new(words.address + index).value != 0_u8
        raise "warm: a chunk from a warm page came back dirty at byte #{count(index)}"
      end
      index = index + 1_u64
    end
    if IyiMark.flags(words.address) != IyiMark.epoch_flag | IyiHeap::UNTYPED_FLAG
      raise "warm: a chunk from a warm page carried stale bits"
    end
    batch = batch + 1_u64
  end
  rewarmed = IyiHeap.pages_rewarmed - rewarmed_before
  raise "warm: #{count(idle_warm)} pages idle and warm and #{count(rewarmed)} taken up again, so the refill is not taking them first" if rewarmed * 2_u64 < idle_warm
  high_after = 0_u64
  arena = IyiHeap.first_arena
  while arena != 0
    high_after = high_after + IyiHeap.arena_high(arena) - arena if IyiHeap.arena_chunk(arena) == 64_u64
    arena = IyiHeap.arena_next(arena)
  end
  if high_after > high_before + 8_u64 * IyiHeap::PAGE
    raise "warm: the class's high water moved #{count(high_after - high_before)} bytes with #{count(retained)} warm pages to take"
  end
  puts "    warm: #{count(retained)} pages of dead chunks kept warm, #{count(idle_warm)} still idle after a second pause, #{count(rewarmed)} taken up by the refill, #{count(reused)} of 4096 allocations on the first batch's addresses, all cleared of the #{count(dirt)} bytes' worth of 0xAA written, high water moved #{count(high_after - high_before)} bytes"

  # 2. A live object survives a collection, and its bytes are intact. This is
  # the direction that matters: a sweep that frees a live object is a corrupted
  # program, not a failed test.
  survivor = fresh(64_u64)
  Held.keep = survivor
  index = 0_u64
  while index < 64_u64
    Pointer(UInt8).new(survivor + index).value = 0x5A_u8
    index = index + 1_u64
  end
  IyiMark.collect
  index = 0_u64
  while index < 64_u64
    got = Pointer(UInt8).new(survivor + index).value
    raise "sweep: a live object's byte #{count(index)} is #{count(got.to_u64)} rather than 90" if got != 0x5A_u8
    index = index + 1_u64
  end
  raise "sweep: the survivor is not white after the sweep repainted it" if IyiMark.colour(survivor) != IyiMark::WHITE
  puts "    survivor: a rooted object keeps all 64 bytes through a collection and comes out white for the next one"

  # 3. The survivor's chunk is not handed out again while it is still live.
  # Reclaiming a live object is the one failure a collector cannot have, so it
  # gets its own check rather than being implied by the bytes above.
  handed = 0_u64
  index = 0_u64
  while index < 400_u64
    handed = handed + 1_u64 if fresh(64_u64) == survivor
    index = index + 1_u64
  end
  raise "sweep: the live survivor's chunk was handed out #{count(handed)} times" if handed != 0
  puts "    liveness: 400 further allocations never returned the live object's chunk"

  # 4. The large-object list is walked, and the deterministic direction is the
  # one asserted. A 2 MiB object held in a global survives a collection with
  # its bytes intact and comes out white. Whether an unreferenced large object
  # is reclaimed cannot be asserted here, because a local holds its address and
  # a conservative scan is right to retain it. That half is reported, the same
  # treatment the small garbage gets above.
  big = fresh(2097152_u64)
  raise "sweep: the large allocation failed" if big == 0
  Held.keep = big
  Pointer(UInt8).new(big).value = 0x77_u8
  Pointer(UInt8).new(big + 2097151_u64).value = 0x88_u8
  IyiMark.collect
  # Read the root back before touching the bytes: the read is the check that
  # the global still holds the object, and it is also what keeps the store
  # alive under optimisation — a global written and never read is a store the
  # back end may legally drop, and a dropped store is a root that never
  # existed. A collector cannot promise more than "reachable through memory";
  # this line is what makes the object reachable through memory.
  raise "sweep: the large root was lost" if Held.keep != big
  if Pointer(UInt8).new(big).value != 0x77_u8 || Pointer(UInt8).new(big + 2097151_u64).value != 0x88_u8
    raise "sweep: a rooted 2 MiB object lost its first or last byte"
  end
  raise "sweep: the large survivor is not white again" if IyiMark.colour(big) != IyiMark::WHITE
  puts "    large: a rooted 2 MiB object keeps its first and last byte through a collection and comes out white"

  Held.keep = 0_u64
  IyiMark.collect
  IyiMark.collect
  puts "    large, unrooted: #{count(IyiMark.bytes_freed)} bytes freed on the pass after the global was cleared"

  # 5. Repeated collections are stable. A heap that grew every cycle would be a
  # sweep that reclaims less than it keeps, which no single collection shows.
  cycle = 0_u64
  while cycle < 20_u64
    churn = 0_u64
    while churn < 200_u64
      fresh(128_u64)
      churn = churn + 1_u64
    end
    IyiMark.collect
    cycle = cycle + 1_u64
  end
  arenas = 0_u64
  arena = IyiHeap.first_arena
  while arena != 0
    arenas = arenas + 1_u64
    arena = IyiHeap.arena_next(arena)
  end
  puts "    steady: 20 cycles of 200 allocations each left #{count(arenas)} arenas mapped and #{count(IyiMark.collections)} collections recorded"

  # 6. A class past 128 bytes is a quarter step, and a request one byte
  # past the class below rounds up by nearly that: 32,769 bytes asked of
  # 40,960-byte chunks. A program asking a budget's worth of them every
  # epoch has its dead pages kept warm - counted at the full chunk, the
  # budget kept a fifth too few, and every epoch that fifth went back to
  # the kernel and came back by a fault a page (BigInt's limb arrays,
  # crystal-metric's Pidigits a third slower for it). Measured after eight
  # epochs, when the class's pages have settled.
  request = IyiHeap.chunk_of(IyiHeap.class_index(32768_u64)) + 1_u64
  epoch = 0
  released_before = 0_u64
  while epoch < 16
    released_before = IyiHeap.pages_released if epoch == 8
    asked = IyiMark.budget.unsafe_div(request) - 1_u64
    index = 0_u64
    while index < asked
      fresh(request)
      index = index + 1_u64
    end
    IyiMark.collect
    epoch = epoch + 1
  end
  released = IyiHeap.pages_released - released_before
  raise "rounding: #{count(released)} pages of #{count(request)}-byte requests handed back in eight steady epochs, each asking a budget's worth" if released != 0
  puts "    rounding: eight epochs of a budget's worth of #{count(request)}-byte requests, and no page of theirs went back cold"

  # 6b. An epoch can ask for more than the budget: a mark beside many
  # workers runs as long as its helpers take, and the workers allocate all
  # the while. The budget's worth of dead pages stays warm and the rest
  # goes back cold, and the next epoch carves that rest again - a release
  # and a fault a page for nothing, which twelve workers paid on 94-98% of
  # what the sweep released (issue #150). What the carve takes back cold
  # is counted in the class's take, and the next epoch's room holds it
  # (`IyiMark.warm_pages`), so a churn asking twice its budget every
  # epoch hands back almost nothing once it has settled - under a quarter
  # of its excess here, the excess every epoch when the carve is not
  # counted.
  request = 3000_u64
  excess_pages = IyiMark.budget.unsafe_div(IyiHeap::PAGE)
  epoch = 0
  released_before = 0_u64
  while epoch < 16
    released_before = IyiHeap.pages_released if epoch == 8
    asked = (IyiMark.budget * 2_u64).unsafe_div(request)
    index = 0_u64
    while index < asked
      fresh(request)
      index = index + 1_u64
    end
    IyiMark.collect
    epoch = epoch + 1
  end
  released = IyiHeap.pages_released - released_before
  raise "refault: #{count(released)} pages handed back in eight steady epochs of #{count(request)}-byte requests asking twice the budget, where the excess is #{count(excess_pages)} pages an epoch" if released * 4_u64 > excess_pages * 8_u64
  puts "    refault: eight epochs asking twice the budget handed back under a quarter of their excess"

  # 6c. A class the program stops allocating in keeps none of its pages
  # warm: the warm room is for the classes the next epoch will ask, and
  # pages kept for one nobody refills held the room the classes the
  # program moved to wanted. But not after a few short epochs: a class
  # asked for now and then would hand its arena back and map it again.
  # The 3,000-byte requests above stop, and four epochs of 200-byte ones
  # follow at once: the 3,000-byte class keeps its warm pages, and the
  # 1,500-byte class allocated in only before the first collection keeps
  # its arena - a stamp from the first epoch, which has no start on
  # record, read as more than a second old, and that class's arenas went
  # back three collections in. Past a second (`IyiMark::IDLE_NS`), four
  # more, and the 3,000-byte class's warm pages go back to the kernel, its
  # empty arena with them, and the 1,500-byte class's arena too.
  def idle_churn : Nil
    epoch = 0
    while epoch < 4
      index = 0_u64
      while index < 2000_u64
        fresh(200_u64)
        index = index + 1_u64
      end
      IyiMark.collect
      epoch = epoch + 1
    end
  end

  idle_index = IyiHeap.class_index(request)
  idle_churn
  idle_short = IyiHeap.warm_of(idle_index)
  raise "idle class: the #{count(request)}-byte class kept no page warm through four short epochs, under IDLE_NS" if idle_short == 0_u64
  first_index = IyiHeap.class_index(FIRST_EPOCH_SIZE)
  raise "idle class: the #{count(FIRST_EPOCH_SIZE)}-byte class shares a class with the 3,000-byte one, so it tests nothing of its own" if first_index == idle_index
  first_short = class_arenas(first_index)
  raise "idle class: the #{count(FIRST_EPOCH_SIZE)}-byte class, allocated in only before the first collection, maps no arena four short epochs on, under IDLE_NS" if first_short == 0_u64
  released_before = IyiHeap.pages_released
  mapped_before = IyiHeap.arenas_mapped
  sleep(1100)
  idle_churn
  idle_after = IyiHeap.warm_of(idle_index)
  raise "idle class: the #{count(request)}-byte class kept #{count(idle_after)} pages warm through four epochs nobody allocated in it, past IDLE_NS" if idle_after != 0_u64
  # And its arena, empty and nobody's cushion now, went back whole: the
  # header and the tables with it.
  idle_arenas = class_arenas(idle_index)
  raise "idle class: the #{count(request)}-byte class still maps #{count(idle_arenas)} empty arenas a second and four epochs after its last allocation" if idle_arenas != 0_u64
  first_after = class_arenas(first_index)
  raise "idle class: the #{count(FIRST_EPOCH_SIZE)}-byte class, allocated in only before the first collection, still maps #{count(first_after)} empty arenas a second and four epochs on" if first_after != 0_u64
  puts "    idle class: #{count(idle_short)} pages of a class the program stopped allocating in still warm four short epochs on, and #{count(first_short)} arenas of one allocated in only before the first collection still mapped; a second and four epochs on, none warm and none of either's arenas mapped, #{count(IyiHeap.pages_released - released_before)} pages handed back cold, #{count(IyiHeap.arenas_mapped - mapped_before)} arenas mapped"

  # 7. A carve takes a page's worth of chunks: the first is the object,
  # the rest go onto the cache's list stamped free and this epoch's, so
  # the next allocations are pops rather than carves. A 120-byte class
  # nothing above touched, so its first allocation carves.
  carved = fresh(120_u64)
  carve_arena = IyiHeap.arena_of(carved)
  carve_chunk = IyiHeap.arena_chunk(carve_arena)
  listed = carved + carve_chunk
  entry = IyiHeap.read8(IyiHeap.meta(carve_arena, listed))
  raise "batch: the chunk after a carved one is not listed free (entry #{count(entry)})" if entry & IyiHeap::FREE_FLAG == 0_u64 || entry & IyiHeap::CARVED_FLAG == 0_u64
  raise "batch: the listed chunk is not this epoch's" if entry & IyiHeap::EPOCH_FLAG != IyiMark.epoch_flag
  following = fresh(120_u64)
  raise "batch: the next allocation came from #{hex(following)}, not the listed chunk at #{hex(listed)}" if following != listed
  raise "batch: the listed chunk handed out still reads free" if IyiHeap.read8(IyiHeap.meta(carve_arena, following)) & IyiHeap::FREE_FLAG != 0_u64
  puts "    batch: a carve lists the rest of its page, stamped free and this epoch's, and the next allocation pops it"

  # 8. A class's warm room is what it took last epoch, not the budget.
  # A budget's worth of 896-byte garbage leaves that many pages warm;
  # sixteen epochs asking 64 KiB of the class each follow, served by the
  # chunks of pages partly alive, and the class keeps its room - a few
  # slabs' worth - and at most the first page of each warm run past it,
  # where a room of the budget kept the burst's pages for as long as the
  # program ran: issue #145's app kept 14-57 MB idle across a collection
  # on a 40-48 MB budget.
  room_size = 896_u64
  room_index = IyiHeap.class_index(room_size)
  burst(room_size, IyiMark.budget.unsafe_div(room_size))
  IyiMark.collect
  burst_warm = IyiHeap.warm_of(room_index) + listed_in(room_index)
  small = 65536_u64.unsafe_div(room_size)
  epoch = 0
  while epoch < 16
    burst(room_size, small)
    IyiMark.collect
    epoch = epoch + 1
  end
  room_warm = IyiHeap.warm_of(room_index) + listed_in(room_index)
  room_runs = warm_runs(room_index)
  room_limit = 4_u64 * 65536_u64.unsafe_div(IyiHeap::PAGE)
  raise "room: the #{count(room_size)}-byte class keeps #{count(room_warm)} pages warm in #{count(room_runs)} runs after sixteen epochs asking #{count(small)} chunks each, past #{count(room_limit)} and a page a run; a budget's worth of its garbage had left #{count(burst_warm)}" if room_warm > room_limit + room_runs || room_warm * 2_u64 > burst_warm
  puts "    room: a budget's worth of #{count(room_size)}-byte garbage left #{count(burst_warm)} pages warm, and sixteen epochs asking #{count(small)} chunks each left #{count(room_warm)}, in #{count(room_runs)} runs"

  # 9. A refill threads a slab's worth of a warm run, and the rest stays
  # idle and warm for the next: the pages a cache threads are what its
  # class is counted as taking, and a cache that threaded a run of
  # hundreds of pages to allocate a few read as a class that took them
  # all. 640-byte chunks, 128 pages of them garbage, two collections.
  thread_size = 640_u64
  thread_index = IyiHeap.class_index(thread_size)
  burst(thread_size, (128_u64 * IyiHeap::PAGE).unsafe_div(thread_size))
  IyiMark.collect
  IyiMark.collect
  thread_before = IyiHeap.warm_of(thread_index)
  slab_pages = IyiHeap::WARM_RUN.unsafe_div(IyiHeap::PAGE)
  raise "threaded: the #{count(thread_size)}-byte class has #{count(thread_before)} warm idle pages, too few to cut a slab's worth from" if thread_before < 3_u64 * slab_pages
  head = IyiHeap.thread_warm_of(Pointer(UInt64).new(IyiHeap.cache_page), thread_index)
  raise "threaded: no warm run of the #{count(thread_size)}-byte class was threaded" if head == 0_u64
  thread_after = IyiHeap.warm_of(thread_index)
  raise "threaded: one refill threaded #{count(thread_before - thread_after)} of #{count(thread_before)} warm pages, past a slab's worth (#{count(slab_pages)} pages and a chunk)" if thread_before - thread_after > slab_pages + 1_u64
  puts "    threaded: one refill threaded #{count(thread_before - thread_after)} of #{count(thread_before)} warm idle pages, a slab's worth, and left the rest idle"

  # 10. The idle trim hands every warm run back and keeps every chunk a
  # program holds. A run threaded short of its end leaves its last chunk
  # reaching into the first page of the rest, still idle: the cut is on
  # the chunk grid, so that chunk reaches under a page into it, and the
  # trim keeps a run's first page when a chunk reaches into it. One class
  # under a page, whose chunks straddle page boundaries, and one of
  # fourteen 4 KB pages (three and a half of 16 KB), whose last chunk
  # cut off the grid would reach several pages into the rest.
  trim_small = 2560_u64
  burst(trim_small, (256_u64 * IyiHeap::PAGE).unsafe_div(trim_small))
  IyiMark.collect
  IyiMark.collect
  reaching_small = trim_threaded(trim_small, 8, true)
  raise "trim: no threaded #{count(trim_small)}-byte chunk reached into an idle page, so the trim's first page was never at stake" if reaching_small == 0_u64
  trim_large = 57344_u64
  burst(trim_large, (512_u64 * IyiHeap::PAGE).unsafe_div(trim_large))
  IyiMark.collect
  IyiMark.collect
  reaching_large = trim_threaded(trim_large, 4, false)
  small_index = IyiHeap.class_index(trim_small)
  raise "trim: #{count(IyiHeap.warm_of(small_index))} pages of the #{count(trim_small)}-byte class still warm after the idle trim, in #{count(warm_runs(small_index))} runs: a run keeps its first page at most" if IyiHeap.warm_of(small_index) > warm_runs(small_index)
  puts "    cut: slabs of #{count(trim_small)}-byte chunks and of #{count(trim_large)}-byte ones threaded, each list's last chunk reaching under a page into the rest of its run (#{count(reaching_small)} and #{count(reaching_large)} times into an idle one)"
  puts "    trim: every warm run of both classes handed back but #{count(IyiHeap.warm_of(small_index))} first pages of the #{count(trim_small)}-byte class's runs, and every byte of every threaded chunk intact"

  # 11. The idle trim takes the warm pages the sweep listed on the
  # centre's batches too: the batches are dropped and the pages inside
  # each batch's range handed back, and what the refill hands out next is
  # on no idle page - a batch left on the centre with its pages gone idle
  # hands out objects the mark would refuse.
  batch_size = 1280_u64
  batch_index = IyiHeap.class_index(batch_size)
  burst(batch_size, (96_u64 * IyiHeap::PAGE).unsafe_div(batch_size))
  IyiMark.collect
  listed_before = listed_in(batch_index)
  raise "batches: the sweep listed no page of the #{count(batch_size)}-byte class's garbage" if listed_before == 0_u64
  released_before = IyiHeap.pages_released
  raise "batches: the idle trim found a collection under way in a program that runs none" unless IyiMark.trim_idle
  listed_after = listed_in(batch_index)
  raise "batches: #{count(listed_after)} of #{count(listed_before)} listed pages of the #{count(batch_size)}-byte class still listed after the idle trim" if listed_after * 4_u64 > listed_before
  batch_released = IyiHeap.pages_released - released_before
  index = 0_u64
  while index < 200_u64
    taken = fresh(batch_size)
    raise "batches: an allocation at #{hex(taken)} lies on an idle page after the idle trim, handed out of a batch whose pages went idle" if IyiHeap.page_idle?(IyiHeap.arena_of(taken), taken)
    index = index + 1_u64
  end
  puts "    batches: the idle trim took #{count(listed_before - listed_after)} of #{count(listed_before)} listed pages off the centre's batches and handed back #{count(batch_released)} pages, and 200 allocations after it landed on no idle page"

  # 11b. The trim leaves a batch's first and last pages listed: the page
  # two adjacent slices share holds chunks of both batches, and the other
  # batch may be off the centre and not yet adopted, a refill's between
  # its pop and `adopt_batch` - made idle then, its chunks are handed
  # out of an idle page. Replayed in that order on this thread, with the
  # lower batch taken, then the upper, 3072-byte chunks.
  edge_size = 3072_u64
  edge_lower = trim_edge(edge_size, true)
  edge_upper = trim_edge(edge_size, false)
  puts "    edge: a batch taken off the centre before the idle trim and adopted after it lies on no idle page, the lower of two sharing a listed page (#{count(edge_lower)} chunk on it) and the upper (#{count(edge_upper)} on it)"

  # 12. The pause pays the sweep's debt before its mark with each arena
  # handed to the centre as one batch (`IyiMark.sweep_one_held`): the
  # threads allocate from those batches while the mark runs beside them,
  # and an arena cut a slice at a time went out to every thread at once -
  # bench/alloc_scaling.iyi at 8 workers ran 13-17% slower on macOS
  # 26.6, Apple M2 Pro. Replayed on this thread: garbage over five slices
  # of a class nothing else asks for, its arena claimed for the epoch the
  # next collection turns to, as a walker the stop finds mid-slice holds
  # it; a collection the trigger runs with no helpers, which leaves every
  # arena to the lazy sweep; and a collection, whose sweep before the
  # stop passes the claimed arena by and whose pause finishes it.
  held_size = 3584_u64
  held_index = IyiHeap.class_index(held_size)
  raise "held: the #{count(held_size)}-byte class has arenas already, so its garbage is not one arena's" if class_arenas(held_index) != 0_u64
  held_first = fresh(held_size)
  burst(held_size, (5_u64 * IyiMark::SWEEP_SPAN).unsafe_div(held_size))
  held_arena = IyiHeap.arena_of(held_first)
  raise "held: the #{count(held_size)}-byte class's garbage spans #{count(class_arenas(held_index))} arenas" if class_arenas(held_index) != 1_u64
  held_epoch = IyiMark.epoch + 1_u64
  IyiHeap.write64(held_arena + IyiHeap::OFF_SWEEPING, held_epoch)
  helpers = IyiMark.workers
  IyiMark.workers = 0_u64
  IyiMark.auto = true
  collections = IyiMark.collections
  while IyiMark.collections == collections
    fresh(704_u64)
  end
  IyiMark.auto = false
  raise "held: the triggered collection turned to epoch #{count(IyiMark.epoch)}, not #{count(held_epoch)}" if IyiMark.epoch != held_epoch
  raise "held: the #{count(held_size)}-byte class's arena was handed back by the triggered collection" unless IyiHeap.mapped?(held_arena)
  raise "held: the #{count(held_size)}-byte class's arena was swept before the pause, so the pause had nothing of it to pay" unless IyiMark.sweep_left?(held_arena, held_epoch)
  paid_before = IyiMark.debt_paid_in_pause
  batches_before = IyiMark.batches_paid_in_pause
  IyiMark.collect
  IyiMark.workers = helpers
  # The walker's claim let go, as `release_claim` lets an older epoch's go.
  IyiHeap.write64(held_arena + IyiHeap::OFF_SWEEPING, 0_u64) if IyiHeap.read64(held_arena + IyiHeap::OFF_SWEEPING) == held_epoch
  held_paid = IyiMark.debt_paid_in_pause - paid_before
  held_batches = IyiMark.batches_paid_in_pause - batches_before
  raise "held: the pause paid no arena of the sweep's debt, so its sweep was never at stake" if held_paid == 0_u64
  raise "held: the pause's sweep before its mark handed #{count(held_paid)} arena over as #{count(held_batches)} batches, a slice's at a time" if held_batches > held_paid
  puts "    held: the pause's sweep before its mark finished #{count(held_paid)} arena a walker held and handed it over as #{count(held_batches)} batch"

  # 13. A program whose pool goes idle hands its warm pages back without
  # anything allocating: the pool's monitor, parked with every worker
  # idle, asks for the idle trim after a second of it with no collection
  # in between (`IyiWorkers.park_monitor`). Last, because the task below
  # starts the pool, and its workers are threads every later stop would
  # stop. 1792-byte garbage, two collections, warm idle pages left; one
  # task on the pool; three seconds asleep.
  idle_size = 1792_u64
  idle_class = IyiHeap.class_index(idle_size)
  burst(idle_size, (64_u64 * IyiHeap::PAGE).unsafe_div(idle_size))
  IyiMark.collect
  IyiMark.collect
  idle_warm = IyiHeap.warm_of(idle_class)
  raise "idle: the #{count(idle_size)}-byte class kept no page warm to hand back" if idle_warm == 0_u64
  trims_before = IyiMark.trims
  group do |g|
    task = g.spawn(unit: :new) do
      1
    end
    raise "idle: the pool's task answered #{task.value}" if task.value != 1
  end
  sleep(3000)
  idle_trims = IyiMark.trims - trims_before
  idle_left = IyiHeap.warm_of(idle_class)
  raise "idle: three seconds with the pool idle ran #{count(idle_trims)} idle trims and left #{count(idle_left)} of #{count(idle_warm)} warm pages of the #{count(idle_size)}-byte class" if idle_trims == 0_u64 || idle_left * 8_u64 > idle_warm
  puts "    idle: three seconds with the pool idle ran #{count(idle_trims)} idle trim and left #{count(idle_left)} of #{count(idle_warm)} warm pages of the #{count(idle_size)}-byte class"

  puts "    all sweep checks passed"
{% else %}
  puts "    sweeping needs the collector's allocator (the default on linux-x86_64, linux-aarch64 and darwin); this build deselected it, nothing to exercise here"
{% end %}
