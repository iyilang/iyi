  # Maps legacy Windows-1252 numeric entity codepoints 0x80..0x9F to Unicode.
  private def self.map_windows_1252(cp : Int32) : Int32
    case cp
    when 0x80; 0x20AC
    when 0x82; 0x201A
    when 0x83; 0x0192
    when 0x84; 0x201E
    when 0x85; 0x2026
    when 0x86; 0x2020
    when 0x87; 0x2021
    when 0x88; 0x02C6
    when 0x89; 0x2030
    when 0x8A; 0x0160
    when 0x8B; 0x2039
    when 0x8C; 0x0152
    when 0x8E; 0x017D
    when 0x91; 0x2018
    when 0x92; 0x2019
    when 0x93; 0x201C
    when 0x94; 0x201D
    when 0x95; 0x2022
    when 0x96; 0x2013
    when 0x97; 0x2014
    when 0x98; 0x02DC
    when 0x99; 0x2122
    when 0x9A; 0x0161
    when 0x9B; 0x203A
    when 0x9C; 0x0153
    when 0x9E; 0x017E
    when 0x9F; 0x0178
    else
      cp
    end
  end

  # Appends UTF-8 encoding of codepoint to byte array.
  # Replaces invalid codepoints (surrogates, 0, > 0x10FFFF) with 0xFFFD.
  private def self.append_codepoint(bytes : Array(UInt8), codepoint : Int32) : Nil
    cp = codepoint
    # Windows-1252 remap
    if cp >= 0x80 && cp <= 0x9F
      cp = map_windows_1252(cp)
    end

    # Replace invalid codepoints with Unicode replacement character (U+FFFD: EF BF BD)
    if cp <= 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)
      bytes << 0xEF_u8
      bytes << 0xBF_u8
      bytes << 0xBD_u8
      return
    end

    if cp < 0x80
      bytes << cp.to_u8
    elsif cp < 0x800
      bytes << (0xC0 | (cp >> 6)).to_u8
      bytes << (0x80 | (cp & 0x3F)).to_u8
    elsif cp < 0x10000
      bytes << (0xE0 | (cp >> 12)).to_u8
      bytes << (0x80 | ((cp >> 6) & 0x3F)).to_u8
      bytes << (0x80 | (cp & 0x3F)).to_u8
    else
      bytes << (0xF0 | (cp >> 18)).to_u8
      bytes << (0x80 | ((cp >> 12) & 0x3F)).to_u8
      bytes << (0x80 | ((cp >> 6) & 0x3F)).to_u8
      bytes << (0x80 | (cp & 0x3F)).to_u8
    end
  end

  private def self.hex_val(b : UInt8) : Int32
    if b >= 48_u8 && b <= 57_u8
      (b - 48_u8).to_i
    elsif b >= 65_u8 && b <= 70_u8
      (b - 65_u8 + 10_u8).to_i
    elsif b >= 97_u8 && b <= 102_u8
      (b - 97_u8 + 10_u8).to_i
    else
      -1
    end
  end

  # Unescapes HTML character references.
  # Handles:
  # - 253 standard named entities (e.g. &amp;, &copy;, &euro;)
  # - Decimal numeric entities (e.g. &#60;)
  # - Hexadecimal numeric entities (e.g. &#x3c;, &#X3C;)
  # - Bare & that is not an entity is preserved unchanged
  # - Unterminated entities are handled safely
  # - Out of range numeric entities are replaced with U+FFFD
  def self.unescape(string : String) : String
    return string unless string.includes?("&")

    raw = string.to_unsafe
    len = string.bytesize
    bytes = [] of UInt8
    ptr = 0

    while ptr < len
      if raw[ptr] == 38_u8 # '&'
        start_amp = ptr
        ptr = ptr + 1

        if ptr < len && raw[ptr] == 35_u8 # '#'
          # Numeric reference
          ptr = ptr + 1
          is_hex = false
          if ptr < len && (raw[ptr] == 120_u8 || raw[ptr] == 88_u8) # 'x' or 'X'
            is_hex = true
            ptr = ptr + 1
          end

          num_start = ptr
          if is_hex
            while ptr < len && hex_val(raw[ptr]) >= 0
              ptr = ptr + 1
            end
          else
            while ptr < len && raw[ptr] >= 48_u8 && raw[ptr] <= 57_u8
              ptr = ptr + 1
            end
          end

          if ptr == num_start
            # No digits found: bare &# or &#x
            k = start_amp
            while k < ptr
              bytes << raw[k]
              k = k + 1
            end
          else
            # Parse number
            cp = 0_i64
            overflow = false
            k = num_start
            if is_hex
              while k < ptr
                val = hex_val(raw[k])
                cp = (cp << 4) | val.to_i64
                if cp > 0x10FFFF
                  overflow = true
                end
                k = k + 1
              end
            else
              while k < ptr
                val = (raw[k] - 48_u8).to_i64
                cp = (cp * 10) + val
                if cp > 0x10FFFF
                  overflow = true
                end
                k = k + 1
              end
            end

            # Optional trailing semicolon
            if ptr < len && raw[ptr] == 59_u8 # ';'
              ptr = ptr + 1
            end

            if overflow
              append_codepoint(bytes, 0xFFFD)
            else
              append_codepoint(bytes, cp.to_i)
            end
          end
        else
          # Named entity: scan ASCII alphanumeric characters
          name_start = ptr
          while ptr < len && ((raw[ptr] >= 97_u8 && raw[ptr] <= 122_u8) ||
                (raw[ptr] >= 65_u8 && raw[ptr] <= 90_u8) ||
                (raw[ptr] >= 48_u8 && raw[ptr] <= 57_u8))
            ptr = ptr + 1
          end

          if ptr == name_start
            # Bare '&' followed by non-alphanumeric
            bytes << 38_u8
          else
            name = string[name_start, ptr - name_start]
            cp = named_entity_codepoint(name)

            has_semi = ptr < len && raw[ptr] == 59_u8 # ';'
            if has_semi
              ptr = ptr + 1
            end

            if cp >= 0
              append_codepoint(bytes, cp)
            else
              # Unknown named entity: preserve original text
              k = start_amp
              while k < ptr
                bytes << raw[k]
                k = k + 1
              end
            end
          end
        end
      else
        bytes << raw[ptr]
        ptr = ptr + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end
end
