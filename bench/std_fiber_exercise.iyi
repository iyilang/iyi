# Exercises `std/fiber`: Fiber API.
#
# Run via:
#     ./bin/iyi run bench/std_fiber_exercise.iyi

module bench/std_fiber_exercise

import std/fiber
using std/fiber::{Fiber}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def assert_int(expected : Int32, actual : Int32, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
end

# ---------------------------------------------------------------------------
# 1. Accessors and current fiber inspection
# ---------------------------------------------------------------------------
puts "== accessors and identity"
main = Fiber.current
assert_true main.running?, "main fiber must be running"
assert_true !main.dead?, "main fiber cannot be dead while executing"
assert_true !main.resumable?, "running fiber is not resumable"

# Fiber.current? accessor
cur = Fiber.current?
assert_true !cur.nil?, "Fiber.current? must not be nil"
assert_true cur == main, "Fiber.current? must equal Fiber.current"
assert_true cur.same?(main), "Fiber.current? must be same instance as main"

# Name accessor on current fiber
assert_true main.name.nil?, "main fiber has no initial name"
main.name = "coordinator"
assert_str "coordinator", main.name || "", "main fiber name assignment"

# String representations
id_hex = main.object_id.to_s(16)
assert_str "#<Fiber:0x#{id_hex} coordinator>", main.to_s, "named fiber to_s"
assert_str main.to_s, main.inspect, "named fiber inspect matches to_s"

puts "  current fiber state, name, and string representation verified"

# ---------------------------------------------------------------------------
# 2. Spawning and initial state
# ---------------------------------------------------------------------------
puts "== spawning and initial state"
unnamed = Fiber.new do
end

assert_true unnamed.name.nil?, "unnamed fiber has nil name"
unnamed_hex = unnamed.object_id.to_s(16)
assert_str "#<Fiber:0x#{unnamed_hex}>", unnamed.to_s, "unnamed fiber to_s"

worker = Fiber.new("worker-init") do
end

assert_str "worker-init", worker.name || "", "spawned worker has assigned name"
assert_true !worker.running?, "freshly spawned fiber is not running"
assert_true worker.resumable?, "freshly spawned fiber is resumable"
assert_true !worker.dead?, "freshly spawned fiber is not dead"

assert_true worker == worker, "fiber equals itself"
assert_true worker.same?(worker), "fiber is same as itself"
assert_true worker != unnamed, "distinct fibers do not equal"
assert_true !worker.same?(unnamed), "distinct fibers are not same"

# Clean up initial test fibers so the run queue stays clean
worker.resume
unnamed.resume
Fiber.yield
Fiber.yield
puts "  fiber creation, state before enqueue, and identity verified"

# ---------------------------------------------------------------------------
# 3. Cooperative yielding and deterministic FIFO ordering
# ---------------------------------------------------------------------------
puts "== cooperative yielding and deterministic ordering"
# Assert only the sequential orderings the scheduler guarantees: each fiber
# executes its own steps in order across yields, and both fibers run to
# completion.
trace = Array(String).new

fiber_a = Fiber.new("fiber-A") do
  assert_str "fiber-A", Fiber.current.name || "", "fiber A name inside"
  assert_true Fiber.current.running?, "fiber A running inside"
  trace << "A1"
  Fiber.yield
  trace << "A2"
  Fiber.yield
  trace << "A3"
end

fiber_b = Fiber.new("fiber-B") do
  assert_str "fiber-B", Fiber.current.name || "", "fiber B name inside"
  assert_true Fiber.current.running?, "fiber B running inside"
  trace << "B1"
  Fiber.yield
  trace << "B2"
end

fiber_a.enqueue
fiber_b.enqueue

loops = 0
while (!fiber_a.dead? || !fiber_b.dead?) && loops < 20
  Fiber.yield
  loops += 1
end

assert_int 5, trace.size, "all fiber steps executed"
a1_idx = -1
a2_idx = -1
a3_idx = -1
b1_idx = -1
b2_idx = -1

i = 0
while i < trace.size
  item = trace[i]
  a1_idx = i if item == "A1"
  a2_idx = i if item == "A2"
  a3_idx = i if item == "A3"
  b1_idx = i if item == "B1"
  b2_idx = i if item == "B2"
  i += 1
end

assert_true a1_idx >= 0, "A1 executed"
assert_true a2_idx >= 0, "A2 executed"
assert_true a3_idx >= 0, "A3 executed"
assert_true b1_idx >= 0, "B1 executed"
assert_true b2_idx >= 0, "B2 executed"

assert_true a1_idx < a2_idx, "fiber A preserved sequential order A1 before A2"
assert_true a2_idx < a3_idx, "fiber A preserved sequential order A2 before A3"
assert_true b1_idx < b2_idx, "fiber B preserved sequential order B1 before B2"

puts "  cooperative fiber execution and sequential ordering verified"

# ---------------------------------------------------------------------------
# 4. Completed fiber vs suspended fiber states
# ---------------------------------------------------------------------------
puts "== completion and suspended states"

# fiber_b has completed its block
assert_true fiber_b.dead?, "completed fiber is dead"
assert_true !fiber_b.running?, "completed fiber is not running"
assert_true !fiber_b.resumable?, "completed fiber is not resumable"

# Spawn a completed worker and a worker that yields mid-execution
completed_ran = false
c_worker = Fiber.new("c-worker") do
  completed_ran = true
end

partially_ran = false
fully_ran = false
s_worker = Fiber.new("s-worker") do
  partially_ran = true
  Fiber.yield
  fully_ran = true
end

c_worker.resume
s_worker.resume

loops = 0
while (!c_worker.dead? || !s_worker.dead?) && loops < 20
  Fiber.yield
  loops += 1
end

assert_true completed_ran, "c_worker completed"
assert_true c_worker.dead?, "c_worker is dead"
assert_true !c_worker.running?, "c_worker is not running"
assert_true !c_worker.resumable?, "c_worker is not resumable"

assert_true partially_ran, "s_worker ran partially"
assert_true fully_ran, "s_worker ran to completion"
assert_true s_worker.dead?, "s_worker is dead after completion"
assert_true !s_worker.running?, "s_worker is not running after completion"
assert_true !s_worker.resumable?, "s_worker is not resumable after completion"

puts "  completed dead fiber vs mid-execution suspended fiber verified"

# ---------------------------------------------------------------------------
# 5. Explicit suspend and resume handoff
# ---------------------------------------------------------------------------
puts "== explicit suspend and resume"
# Fiber.suspend parks the current fiber off the scheduler's run queue.
# Unlike Fiber.yield, calling Fiber.yield in main does NOT wake a suspended
# fiber until it is explicitly re-enqueued via resume or enqueue.
handoff_step = 0

parked_worker = Fiber.new("parked-worker") do
  handoff_step = 1
  Fiber.suspend
  handoff_step = 2
end

parked_worker.resume
Fiber.yield
Fiber.yield
assert_int 1, handoff_step, "worker reached suspend point"

# Yielding from main does not run parked_worker because it was not enqueued
Fiber.yield
Fiber.yield
assert_int 1, handoff_step, "parked worker remained off run queue"
assert_true !parked_worker.dead?, "parked worker is not dead"

# Explicit resume puts it back on run queue
parked_worker.resume
assert_true !parked_worker.dead?, "resumed worker is not dead"

loops = 0
while !parked_worker.dead? && loops < 20
  Fiber.yield
  loops += 1
end
assert_int 2, handoff_step, "parked worker completed after explicit resume"
assert_true parked_worker.dead?, "parked worker is now dead"

puts "  Fiber.suspend removes from run queue until explicit resume verified"

puts "\nALL CHECKS PASSED"
