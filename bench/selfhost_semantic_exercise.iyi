import compiler/syntax/ast
import compiler/syntax/parser
import compiler/semantic/top_level
import compiler/semantic/main_visitor
import compiler/semantic/recursive_struct_checker

using compiler/syntax/ast::{ASTNode, Expressions}
using compiler/syntax/parser::{Parser}
using compiler/semantic/top_level::{SemanticProgram, TopLevelVisitor, TypeException, dump_program_declarations}
using compiler/semantic/main_visitor::{MainVisitor, dump_program_expressions}
using compiler/semantic/recursive_struct_checker::{RecursiveStructChecker}

module BenchSelfhostSemanticExercise
  def self.run_source(src : String, filename : String = "eval.iyi") : String
    parser = Parser.new(src, filename)
    node = parser.parse
    prog = SemanticProgram.new
    visitor = TopLevelVisitor.new(prog)
    node.accept(visitor)
    visitor.finish
    dump_program_declarations(prog)
  end

  def self.run_expr_source(src : String, filename : String = "eval.iyi") : String
    parser = Parser.new(src, filename)
    node = parser.parse
    prog = SemanticProgram.new
    tl = TopLevelVisitor.new(prog)
    node.accept(tl)
    tl.finish
    mv = MainVisitor.new(prog)
    node.accept(mv)
    RecursiveStructChecker.new(prog).run
    dump_program_expressions(prog, node, mv)
  end

  def self.count_declarations(src : String, filename : String) : Int32
    parser = Parser.new(src, filename)
    node = parser.parse
    prog = SemanticProgram.new
    visitor = TopLevelVisitor.new(prog)
    node.accept(visitor)
    visitor.finish
    count = 0
    prog.types.keys.each do |k|
      unless prog.initial_type_names.includes?(k)
        count = count + 1
      end
    end
    if pdefs = prog.defs
      pdefs.each_value { |list| count = count + list.size }
    end
    count
  end

  def self.count_expressions(src : String, filename : String) : Int32
    parser = Parser.new(src, filename)
    node = parser.parse
    prog = SemanticProgram.new
    tl = TopLevelVisitor.new(prog)
    node.accept(tl)
    mv = MainVisitor.new(prog)
    node.accept(mv)
    mv.node_types.size
  end

  def self.run_all
    puts "Running Selfhost Semantic Verification Suite (pure iyi stage 0)"
    puts "==============================================================="
    print "testing basic class and def declaration... "
    out1 = run_source("class Foo; def bar : Int32; 1; end; end")
    unless out1.includes?("Type: Foo (class)") && out1.includes?("Def: bar")
      raise "basic class test failed"
    end
    puts "ok (class and method verified)"

    print "testing class inheritance... "
    out2 = run_source("class A; end; class B < A; end")
    unless out2.includes?("superclass: A")
      raise "inheritance test failed"
    end
    puts "ok (inheritance verified)"

    print "testing traits and impls... "
    out3 = run_source("trait Tr; abstract def f; end; class C; end; impl Tr for C; def f; end; end")
    unless out3.includes?("Type: Tr (trait)") && out3.includes?("parents: [Reference, Tr]")
      raise "trait and impl test failed"
    end
    puts "ok (traits and impls verified)"

    print "testing enums and members... "
    out4 = run_source("enum E; A; B = 10; end")
    unless out4.includes?("enum_members: [A=0, B=10]")
      raise "enum test failed"
    end
    puts "ok (enums verified)"

    print "testing aliases and constants... "
    out5 = run_source("alias MyInt = Int32; CONST_VAL = 42")
    unless out5.includes?("Type: MyInt (alias)") && out5.includes?("Type: CONST_VAL (constant)")
      raise "alias and const test failed"
    end
    puts "ok (aliases and constants verified)"

    print "testing expression typing and calls... "
    out6 = run_expr_source("def add(a : Int32, b : Int32) : Int32; a; end; res = add(1, 2)")
    unless out6.includes?("Call: Int32") && out6.includes?("target_def: add: Int32")
      raise "expression typing and call test failed"
    end
    puts "ok (typed expressions and calls verified)"

    print "testing control flow typing... "
    out7 = run_expr_source("x = if true; 1; else; 2; end; while false; y = 1; end")
    unless out7.includes?("If: Int32") && out7.includes?("While: Nil")
      raise "control flow typing test failed"
    end
    puts "ok (control flow typing verified)"

    print "testing instance variable type inference... "
    out8 = run_expr_source("class Point; @x = 10; def get_x : Int32; @x; end; end; p = Point.new; res = p.get_x")
    unless out8.includes?("InstanceVar: Int32") && out8.includes?("target_def: get_x: Int32")
      raise "instance variable typing test failed"
    end
    puts "ok (instance variable type inference verified)"

    print "testing class variable initializers... "
    out9 = run_expr_source("class Config; @@count = 100; def self.get_count : Int32; @@count; end; end; res = Config.get_count")
    unless out9.includes?("ClassVar: Int32") && out9.includes?("target_def: get_count: Int32")
      raise "class variable typing test failed"
    end
    puts "ok (class variable initializers verified)"

    print "testing recursive struct checker... "
    out10 = run_expr_source("struct Node; def initialize(@val : Int32); end; end; n = Node.new(1)")
    unless out10.includes?("ClassDef: Nil")
      raise "recursive struct check test failed"
    end
    puts "ok (recursive struct check verified)"

    print "testing overload resolution... "
    out11 = run_expr_source("def f(x : Int32); 1; end; def f(x : String); 2; end; r1 = f(10); r2 = f(\"a\")")
    unless out11.includes?("target_def: f: Int32")
      raise "overload resolution test failed"
    end
    puts "ok (overload resolution verified)"

    print "testing multiple dispatch over union receiver... "
    out12 = run_expr_source("class A; def val : Int32; 10; end; end; class B; def val : String; \"x\"; end; end; x = if true; A.new; else; B.new; end; res = x.val")
    unless out12.includes?("Call: (Int32 | String)")
      raise "multiple dispatch test failed"
    end
    puts "ok (multiple dispatch over union receiver verified)"

    print "testing block and closure type inference... "
    out13 = run_expr_source("def run(&); yield 1; yield \"b\"; end; a = 0; run do |x|; a = x; end; final_a = a")
    unless out13.includes?("Var: (Int32 | String)")
      raise "block and closure inference test failed"
    end
    puts "ok (block and closure type inference verified)"

    puts "==============================================================="
    puts "ALL SELFHOST SEMANTIC CHECKS PASSED SUCCESSFULLY!"
    puts "==============================================================="
  end
end

if Program.args.size > 0
  if Program.args[0] == "-e" && Program.args.size > 1
    source = Program.args[1]
    print BenchSelfhostSemanticExercise.run_source(source, "eval.iyi")
  elsif Program.args.size > 1 && Program.args[1] == "--expr"
    filename = Program.args[0]
    source = File.read(filename)
    print BenchSelfhostSemanticExercise.run_expr_source(source, filename)
  elsif Program.args.size > 1 && Program.args[1] == "--expr-count"
    filename = Program.args[0]
    source = File.read(filename)
    puts BenchSelfhostSemanticExercise.count_expressions(source, filename)
  elsif Program.args.size > 1 && Program.args[1] == "--count"
    filename = Program.args[0]
    source = File.read(filename)
    puts BenchSelfhostSemanticExercise.count_declarations(source, filename)
  else
    filename = Program.args[0]
    source = File.read(filename)
    print BenchSelfhostSemanticExercise.run_source(source, filename)
  end
else
  BenchSelfhostSemanticExercise.run_all
end
