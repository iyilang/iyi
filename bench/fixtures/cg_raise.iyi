lib LibRunner
  @[Raises]
  fun c_raise = __runner_raise(ex : Void*) : NoReturn
end

@[Raises]
fun __crystal_raise(ex : Void*) : NoReturn
  LibRunner.c_raise(ex)
end

def raise(msg : String) : NoReturn
  __crystal_raise(msg.as(Void*))
end

fun test_direct_raise(code : Int32) : Int32
  if code < 0
    raise "negative"
  end
  code &* 3
end
