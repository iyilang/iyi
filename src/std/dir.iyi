# Dir: directory stream and filesystem directory operations.
#
# Provides opening, reading entries, creating, deleting, traversing,
# changing current working directory, and globbing without external C libraries.

module std/dir

import std/path::{Path}
import std/env::{ENV}
# `Dir.glob` matches with `File.match?` and asks `File.symlink?`; `std/file`
# imports nothing of this module's.
import std/file::{File}

{% if flag?(:darwin) %}
  lib LibC
    fun opendir(name : UInt8*) : Void*
    fun readdir(dirp : Void*) : Void*
    fun closedir(dirp : Void*) : Int32
    fun rewinddir(dirp : Void*) : Void
    fun getcwd(buf : UInt8*, size : UInt64) : UInt8*
    fun chdir(path : UInt8*) : Int32
    fun mkdir(path : UInt8*, mode : Int32) : Int32
    fun rmdir(path : UInt8*) : Int32
  end
{% elsif flag?(:win32) %}
  lib LibKernel32
    fun CreateDirectoryW(path : UInt16*, sec : Void*) : Int32
    fun RemoveDirectoryW(path : UInt16*) : Int32
    fun SetCurrentDirectoryW(path : UInt16*) : Int32
    fun FindFirstFileW(pattern : UInt16*, data : Void*) : Void*
    fun FindNextFileW(handle : Void*, data : Void*) : Int32
    fun FindClose(handle : Void*) : Int32
    # Where Windows itself says a program may write scratch files. The
    # last resort here was the literal `C:\Windows\Temp`, which a
    # standard user may not write to; this call answers TMP, then TEMP,
    # then the profile directory — measured with both variables cleared,
    # `C:\Users\dogru\`, which the person running the program owns.
    fun GetTempPathW(buffer_count : Int32, buffer : UInt16*) : Int32
    # What a refused removal is asked about. A directory carrying
    # FILE_ATTRIBUTE_READONLY (0x1) refuses `RemoveDirectoryW` with
    # ERROR_ACCESS_DENIED (5) where POSIX's `rmdir` asks the parent and
    # succeeds — measured, a directory `File.chmod 0o444` had marked
    # could not be removed at all.
    fun GetFileAttributesW(name : UInt16*) : Int32
    fun SetFileAttributesW(name : UInt16*, attributes : Int32) : Int32
    fun GetLastError : Int32
  end

  # The `*A` twins of the calls above read a path in the process's active code
  # page and answer a name in it, so a directory whose name is not spellable
  # there could not be opened and an entry that was came back as mojibake;
  # and a path past MAX_PATH was refused outright, because the `\\?\` prefix
  # that lifts the limit is understood by the wide calls alone. The prelude's
  # `__iyi_wide_path` is the one conversion into UTF-16 and the one place the
  # prefix is put on, `__iyi_utf8_size_from_wide` and
  # `__iyi_utf8_bytes_from_wide` the way back for a name Windows answers.
  # `GetFileAttributesW` is not declared here because the prelude's
  # `__iyi_path_attributes` is that call with the conversion already in it.
  #
  # WIN32_FIND_DATAW, byte by byte: 4 for dwFileAttributes, 24 for the three
  # FILETIMEs, 16 for the four DWORDs behind them — both halves of the size
  # and the two reserved — 520 for cFileName's 260 wide characters and 28 for
  # cAlternateFileName's 14. That is 592, where the ANSI struct was 320.
  # Nothing in front of the name is wider than a DWORD, so `cFileName` keeps
  # the byte offset of 44 it had.
  WIN32_FIND_DATAW_BYTES = 4 + 24 + 16 + 260 * 2 + 14 * 2
{% else %}
  # Linux: the kernel's own calls (SPEC.md III.9), in libc's shape so the
  # callers below read the same. A directory stream is a descriptor and
  # a buffer of `linux_dirent64` records from `getdents64`, which is the
  # record libc's `readdir` hands back: the name sits at byte 19 either way.
  pub struct LibC
    AT_FDCWD     = -100_i64
    AT_REMOVEDIR = 0x200_i64
    BUFFER       = 32768_i64
    {% if flag?(:x86_64) %}
      SYS_GETDENTS64 = 217_i64
      SYS_LSEEK      =   8_i64
      SYS_GETCWD     =  79_i64
      SYS_CHDIR      =  80_i64
      SYS_MKDIRAT    = 258_i64
      SYS_UNLINKAT   = 263_i64
    {% else %}
      SYS_GETDENTS64 =  61_i64
      SYS_LSEEK      =  62_i64
      SYS_GETCWD     =  17_i64
      SYS_CHDIR      =  49_i64
      SYS_MKDIRAT    =  34_i64
      SYS_UNLINKAT   =  35_i64
    {% end %}

    def self.sys(number : Int64, a : Int64, b : Int64, c : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    # The stream: one block, three words - descriptor, read position, fill -
    # and the records `getdents64` writes behind them, from byte HEAD. The
    # records were a second block whose address the stream kept as an
    # integer in the first, which the collector does not read as a
    # reference, so the buffer was freed while the directory was open and
    # the kernel wrote the next records into whatever had the memory then
    # (measured on Windows, whose stream had the same shape).
    HEAD = 24_i64

    def self.opendir(name : UInt8*) : Void*
      # x86_64: O_DIRECTORY 00200000 | O_CLOEXEC 02000000 = 0x90000
      # aarch64: O_DIRECTORY (1<<14)=0x4000 | O_CLOEXEC 02000000 = 0x84000
      # (arm64 fcntl.h overrides O_DIRECTORY; 0x90000 there is O_DIRECT|O_CLOEXEC.)
      {% if flag?(:x86_64) %}
        fd = __iyi_openat(name, 0x90000, 0)
      {% else %}
        fd = __iyi_openat(name, 0x84000, 0)
      {% end %}
      return Pointer(Void).new(0_u64) if fd < 0_i64
      stream = Pointer(UInt8).malloc((HEAD + BUFFER).to_u64)
      words = stream.as(Int64*)
      words[0] = fd
      words[1] = 0_i64
      words[2] = 0_i64
      stream.as(Void*)
    end

    def self.readdir(dirp : Void*) : Void*
      words = dirp.as(Int64*)
      records = dirp.as(UInt8*) + HEAD
      if words[1] >= words[2]
        n = sys(SYS_GETDENTS64, words[0], records.address.to_i64, BUFFER)
        return Pointer(Void).new(0_u64) if n <= 0_i64
        words[1] = 0_i64
        words[2] = n
      end
      record = records + words[1]
      words[1] = words[1] + record[16].to_i64 + (record[17].to_i64 << 8)
      record.as(Void*)
    end

    def self.closedir(dirp : Void*) : Int32
      __iyi_close(dirp.as(Int64*)[0])
      0
    end

    def self.rewinddir(dirp : Void*) : Nil
      words = dirp.as(Int64*)
      sys(SYS_LSEEK, words[0], 0_i64, 0_i64)
      words[1] = 0_i64
      words[2] = 0_i64
    end

    def self.getcwd(buf : UInt8*, size : UInt64) : UInt8*
      sys(SYS_GETCWD, buf.address.to_i64, size.to_i64, 0_i64) < 0_i64 ? Pointer(UInt8).new(0_u64) : buf
    end

    def self.chdir(path : UInt8*) : Int32
      sys(SYS_CHDIR, path.address.to_i64, 0_i64, 0_i64).to_i32
    end

    def self.mkdir(path : UInt8*, mode : Int32) : Int32
      sys(SYS_MKDIRAT, AT_FDCWD, path.address.to_i64, mode.to_i64).to_i32
    end

    def self.rmdir(path : UInt8*) : Int32
      sys(SYS_UNLINKAT, AT_FDCWD, path.address.to_i64, AT_REMOVEDIR).to_i32
    end
  end
{% end %}

pub class Dir
  getter path : String

  @handle : Void*
  @closed : Bool

  def initialize(path : String | Path)
    @path = path.to_s
    @handle = open_dir(@path)
    @closed = false
  end

  def self.open(path : String | Path) : Dir
    Dir.new(path)
  end

  def self.open(path : String | Path, &block : Dir -> Nil) : Nil
    d = Dir.new(path)
    defer d.close
    yield d
  end

  private def open_dir(dir_path : String) : Void*
    {% if flag?(:darwin) || flag?(:linux) %}
      p = LibC.opendir(Dir.c_str(dir_path))
      if p.address == 0_u64
        raise "Cannot open directory: #{dir_path}"
      end
      p.as(Void*)
    {% elsif flag?(:win32) %}
      # The stream: one block, two words - the find handle, and whether the
      # name already sitting in the buffer is still owed to a reader - and
      # the WIN32_FIND_DATAW the kernel writes into behind them, from byte
      # 16. FindFirstFileW fetches the first entry while it opens the
      # search, so that first name has to be remembered here or the first
      # `read` would skip it. The buffer was a block of its own, its address
      # kept as an integer in the stream, which the collector does not read
      # as a reference: the next collection freed it with the directory
      # open, and FindNextFileW wrote each entry into whatever had the
      # memory then - measured, a live String came to hold an entry's name,
      # and `Dir.glob` over 4,000 files died of a memory fault.
      pattern = Dir.find_pattern(dir_path)
      if pattern.address == 0_u64
        raise "Cannot open directory: #{dir_path}"
      end
      stream = Pointer(UInt8).malloc((16 + WIN32_FIND_DATAW_BYTES).to_u64)
      handle = LibKernel32.FindFirstFileW(pattern, (stream + 16).as(Void*))
      if handle.address == 0xFFFFFFFFFFFFFFFF_u64
        raise "Cannot open directory: #{dir_path}"
      end
      words = stream.as(Int64*)
      words[0] = handle.address.to_i64
      words[1] = 1_i64
      stream.as(Void*)
    {% else %}
      Pointer(Void).new(0_u64)
    {% end %}
  end

  def read : String?
    raise "Cannot read from closed Dir" if @closed
    {% if flag?(:darwin) || flag?(:linux) %}
      entry = LibC.readdir(@handle)
      return nil if entry.address == 0_u64

      {% if flag?(:darwin) %}
        name_ptr = entry.as(UInt8*) + 21
      {% else %}
        name_ptr = entry.as(UInt8*) + 19
      {% end %}

      len = 0
      while name_ptr[len] != 0_u8
        len = len + 1
      end
      String.new(len) do |target|
        target.copy_from(name_ptr, len)
      end
    {% elsif flag?(:win32) %}
      stream = @handle.as(Int64*)
      find_data = (@handle.as(UInt8*) + 16).as(Void*)
      while true
        if stream[1] == 0_i64
          if LibKernel32.FindNextFileW(Pointer(Void).new(stream[0].to_u64), find_data) == 0
            return nil
          end
        end
        stream[1] = 0_i64

        # `cFileName` sits at byte 44 of WIN32_FIND_DATAW, the way the linux
        # record's name sits at byte 19 — UTF-16 there, so the name is decoded
        # rather than copied out. `.` and `..` come back as they do from
        # `readdir`: the callers that do not want them filter them themselves,
        # and `children` reads the same on every platform because of it.
        name_ptr = (find_data.as(UInt8*) + 44).as(UInt16*)

        # The size counts the terminator, which a String does not carry in
        # its length but does have room for behind it. A name Windows will
        # not convert has no UTF-8 spelling and so no iyi String — an
        # unpaired surrogate, which NTFS stores and UTF-8 cannot say — and
        # the loop steps over it rather than reading it as the end of the
        # directory, which is what a bare `nil` here would mean.
        size = __iyi_utf8_size_from_wide(name_ptr)
        if size > 0
          name = String.new(size - 1) do |target|
            __iyi_utf8_bytes_from_wide(name_ptr, target, size)
          end
          return name
        end
      end
    {% else %}
      nil
    {% end %}
  end

  def rewind : self
    raise "Cannot rewind closed Dir" if @closed
    {% if flag?(:darwin) || flag?(:linux) %}
      LibC.rewinddir(@handle)
    {% elsif flag?(:win32) %}
      # A find handle cannot be rewound: the search is closed and reopened,
      # which puts the first entry back in the buffer and owes it to a reader
      # again.
      stream = @handle.as(Int64*)
      LibKernel32.FindClose(Pointer(Void).new(stream[0].to_u64))
      pattern = Dir.find_pattern(@path)
      if pattern.address == 0_u64
        raise "Cannot rewind directory: #{@path}"
      end
      handle = LibKernel32.FindFirstFileW(pattern, (@handle.as(UInt8*) + 16).as(Void*))
      if handle.address == 0xFFFFFFFFFFFFFFFF_u64
        raise "Cannot rewind directory: #{@path}"
      end
      stream[0] = handle.address.to_i64
      stream[1] = 1_i64
    {% end %}
    self
  end

  def close : Nil
    return if @closed
    {% if flag?(:darwin) || flag?(:linux) %}
      LibC.closedir(@handle)
    {% elsif flag?(:win32) %}
      stream = @handle.as(Int64*)
      LibKernel32.FindClose(Pointer(Void).new(stream[0].to_u64))
    {% end %}
    @closed = true
  end

  def closed? : Bool
    @closed
  end

  def each(&block : String -> Nil) : Nil
    while entry = read
      yield entry
    end
  end

  def entries : Array(String)
    res = [] of String
    rewind
    while entry = read
      res << entry
    end
    res
  end

  def each_child(&block : String -> Nil) : Nil
    rewind
    while entry = read
      if entry != "." && entry != ".."
        yield entry
      end
    end
  end

  def children : Array(String)
    res = [] of String
    each_child do |entry|
      res << entry
    end
    res
  end

  def to_s : String
    "#<Dir:#{@path}>"
  end

  def inspect : String
    to_s
  end

  # Class-level directory helpers

  # One implementation, in the prelude: `Path#expand` needs the same
  # answer and cannot import this module (`std/dir` imports `std/path`),
  # so the platform arms live beside `Program.args` and `Program.env`,
  # which are the process's other facts.
  def self.current : String
    Program.cwd || raise "Error getting current working directory"
  end

  def self.current=(path : String | Path) : String
    cd(path)
  end

  def self.cd(path : String | Path) : String
    target = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if LibC.chdir(c_str(target)) != 0
        raise "Cannot change directory to: #{target}"
      end
    {% elsif flag?(:win32) %}
      wide = __iyi_wide_path(c_str(target))
      if wide.address == 0_u64 || LibKernel32.SetCurrentDirectoryW(wide) == 0
        code = LibKernel32.GetLastError
        # ERROR_FILENAME_EXCED_RANGE (206): the working directory holds
        # MAX_PATH less 2 unless long paths are enabled, and the `\\?\`
        # prefix counts against it - measured, 254 characters went in and
        # 255 did not, while every other call here took 396. The refusal
        # named the directory and nothing else.
        if code == 206 && exists?(target)
          raise "Cannot change directory to: #{target}: the directory is there, and Windows refused it as " \
                "the working directory: past 254 characters it does unless long paths are enabled"
        end
        raise "Cannot change directory to: #{target} (Windows error #{code})"
      end
    {% end %}
    # And `PWD` with it, as a shell's `cd` keeps it: `Path#expand` reads
    # `PWD` first - the path the person walked - and after a `Dir.cd` it
    # named where the program had been, so `File.expand_path("x")`
    # answered a file in the old directory. Only where it is set; a
    # program started without one is not given one.
    ENV["PWD"] = current if ENV.has_key?("PWD")
    target
  end

  def self.cd(path : String | Path, &block : -> Nil) : Nil
    old_dir = current
    cd(path)
    defer cd(old_dir)
    yield
  end

  def self.tempdir : String
    tmp = Program.env("TMPDIR")
    return without_trailing_separator(tmp) if tmp && !tmp.empty?
    tmp2 = Program.env("TEMP")
    return without_trailing_separator(tmp2) if tmp2 && !tmp2.empty?
    tmp3 = Program.env("TMP")
    return without_trailing_separator(tmp3) if tmp3 && !tmp3.empty?
    {% if flag?(:win32) %}
      # Windows' own answer, not a literal: `C:\Windows\Temp` is a
      # directory a standard user may not write to, and the platform
      # keeps the question. The call always ends its answer with a
      # separator, which no other branch here does.
      wide = Pointer(UInt16).malloc(4096_u64)
      chars = LibKernel32.GetTempPathW(4096, wide)
      return "C:\\Windows\\Temp" if chars <= 0 || chars > 4096
      size = __iyi_utf8_size_from_wide(wide)
      return "C:\\Windows\\Temp" if size <= 1
      answer = String.new(size - 1) { |t| __iyi_utf8_bytes_from_wide(wide, t, size) }
      answer.ends_with?("\\") ? answer[0, answer.bytesize - 1] : answer
    {% else %}
      "/tmp"
    {% end %}
  end

  # One trailing separator off, as Crystal's `Dir.tempdir` answers: darwin
  # sets TMPDIR to `/var/folders/.../T/`, and every path joined onto it had
  # two separators and a `dirname` that was not the directory it came from.
  # The root alone is left as it is - and on Windows a drive's root is
  # `C:\`, whose separator is the root: without it `C:` is the current
  # directory on that drive, and a TMP of `C:\` answered the directory
  # the program happened to be in.
  def self.without_trailing_separator(dir : String) : String
    return dir if dir.bytesize <= 1
    last = dir[dir.bytesize - 1]
    trailing = last == '/'
    {% if flag?(:win32) %}
      trailing = trailing || last == '\\'
      return dir if trailing && dir[dir.bytesize - 2] == ':'
    {% end %}
    trailing ? dir[0, dir.bytesize - 1] : dir
  end

  def self.each(dirname : String | Path, &block : String -> Nil) : Nil
    Dir.open(dirname) do |dir|
      dir.each do |filename|
        yield filename
      end
    end
  end

  def self.entries(dirname : String | Path) : Array(String)
    Dir.open(dirname) do |dir|
      return dir.entries
    end
    [] of String
  end

  def self.each_child(dirname : String | Path, &block : String -> Nil) : Nil
    Dir.open(dirname) do |dir|
      dir.each_child do |filename|
        yield filename
      end
    end
  end

  def self.children(dirname : String | Path) : Array(String)
    Dir.open(dirname) do |dir|
      return dir.children
    end
    [] of String
  end

  def self.exists?(path : String | Path) : Bool
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      dirp = LibC.opendir(c_str(p))
      if dirp.address != 0_u64
        LibC.closedir(dirp)
        true
      else
        false
      end
    {% elsif flag?(:win32) %}
      # INVALID_FILE_ATTRIBUTES is 0xFFFFFFFF, which is what that DWORD
      # spells as the Int32 the prelude's helper answers, and 0x10 is
      # FILE_ATTRIBUTE_DIRECTORY. The helper is GetFileAttributesW with the
      # wide conversion in front of it, so a long or non-ASCII directory
      # answers here the same as a short ASCII one.
      attrs = __iyi_path_attributes(c_str(p))
      attrs != -1 && (attrs & 0x10) != 0
    {% else %}
      false
    {% end %}
  end

  def self.empty?(path : String | Path) : Bool
    Dir.open(path) do |dir|
      dir.each_child do |_|
        return false
      end
    end
    true
  end

  def self.mkdir(path : String | Path, mode : Int32 = 0o777) : Nil
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if LibC.mkdir(c_str(p), mode) != 0
        raise "Cannot create directory: #{p}"
      end
    {% elsif flag?(:win32) %}
      wide = __iyi_wide_path(c_str(p))
      if wide.address == 0_u64 || LibKernel32.CreateDirectoryW(wide, Pointer(Void).new(0_u64)) == 0
        raise "Cannot create directory: #{p}"
      end
    {% end %}
  end

  def self.mkdir_p(path : String | Path, mode : Int32 = 0o777) : Nil
    p_str = path.to_s
    return if exists?(p_str)

    p = Path.new(p_str)
    segments = p.parts
    raise "Cannot create directory: #{p_str}" if segments.empty?

    # Each prefix is joined with the platform's separator, and not after
    # an anchor that ends in one or in a drive's colon. It was `/`
    # always, and on Windows that is two different mistakes: `C:rel\x`,
    # which is `rel\x` under the current directory on C:, became
    # `C:/rel` - a directory created at the drive's root - and in a
    # `\\?\` path, which Windows does not parse again, `/` is not a
    # separator at all, so every segment after the first was refused.
    acc = ""
    segments.each do |seg|
      if acc.empty?
        acc = seg
      elsif acc.ends_with?("/") || ({{ flag?(:win32) }} && (acc.ends_with?("\\") || acc.ends_with?(":")))
        acc = acc + seg
      else
        acc = acc + {{ flag?(:win32) ? "\\" : "/" }} + seg
      end

      if !exists?(acc)
        # Try mkdir, ignore if already exists (e.g. root or race)
        {% if flag?(:darwin) || flag?(:linux) %}
          LibC.mkdir(c_str(acc), mode)
        {% elsif flag?(:win32) %}
          # Each segment is converted on its own, so the `\\?\` prefix goes on
          # exactly the ones long enough to need it: the whole path can be
          # past MAX_PATH while the first segments are not, and those are
          # created by their plain relative names.
          acc_wide = __iyi_wide_path(c_str(acc))
          if acc_wide.address != 0_u64
            LibKernel32.CreateDirectoryW(acc_wide, Pointer(Void).new(0_u64))
          end
        {% end %}
      end
    end

    raise "Cannot create directory: #{p_str}" unless exists?(p_str)
  end

  def self.delete(path : String | Path) : Nil
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      if LibC.rmdir(c_str(p)) != 0
        raise "Cannot remove directory: #{p}"
      end
    {% elsif flag?(:win32) %}
      wide = __iyi_wide_path(c_str(p))
      if wide.address == 0_u64 || !remove_directory(wide)
        raise "Cannot remove directory: #{p}"
      end
    {% end %}
  end

  def self.delete?(path : String | Path) : Bool
    p = path.to_s
    {% if flag?(:darwin) || flag?(:linux) %}
      LibC.rmdir(c_str(p)) == 0
    {% elsif flag?(:win32) %}
      wide = __iyi_wide_path(c_str(p))
      wide.address != 0_u64 && remove_directory(wide)
    {% else %}
      false
    {% end %}
  end

  {% if flag?(:win32) %}
    # The removal, and the one retry Windows needs to mean what `rmdir`
    # means. POSIX asks the parent directory for permission to remove a
    # name; Windows asks the directory itself, and one carrying
    # FILE_ATTRIBUTE_READONLY refuses with ERROR_ACCESS_DENIED —
    # measured, a directory `File.chmod 0o444` had marked could not be
    # removed by its owner at all. The attribute comes off for the
    # retry and goes back when the retry still refuses, so a directory
    # this could not remove is not a directory this left writable. It
    # is the same shape the prelude's `__iyi_unlink` has for a file.
    private def self.remove_directory(wide : Pointer(UInt16)) : Bool
      return true if LibKernel32.RemoveDirectoryW(wide) != 0
      return false if LibKernel32.GetLastError != 5
      attributes = LibKernel32.GetFileAttributesW(wide)
      return false if attributes == -1 || (attributes & 1) == 0
      # `attributes - 1` clears bit 0, which the line above proved is
      # set; `~` is not an operation the prelude carries.
      return false if LibKernel32.SetFileAttributesW(wide, attributes - 1) == 0
      return true if LibKernel32.RemoveDirectoryW(wide) != 0
      LibKernel32.SetFileAttributesW(wide, attributes)
      false
    end
  {% end %}

  def self.rmdir(path : String | Path) : Nil
    delete(path)
  end

  def self.glob(patterns : String | Array(String)) : Array(String)
    res = [] of String
    glob(patterns) do |entry|
      res << entry
    end
    res
  end

  def self.glob(patterns : String | Array(String), &block : String -> Nil) : Nil
    if patterns.is_a?(String)
      glob_single(patterns, &block)
    else
      patterns.each do |p|
        glob_single(p, &block)
      end
    end
  end

  def self.[](patterns : String | Array(String)) : Array(String)
    glob(patterns)
  end

  # The walk starts at the pattern's literal prefix - its bytes up to the
  # separator before the first wildcard, as written - and goes one directory
  # deeper for each separator the rest of the pattern has, or as deep as
  # there is under a `**`. A path is built from the prefix and the names
  # below it, joined with the separator the pattern uses, and matched whole.
  #
  # It listed the pattern's `dirname` and matched names in it, which answered
  # nothing when a wildcard stood before the last segment - `src/*/x.iyi`
  # and `d/s*/*.txt` were `[]` - and nothing for `./*.txt`, whose names were
  # matched without the `./` the pattern has; and it joined with the
  # platform's separator on one path and `/` on the other, so on Windows
  # `d/*.txt` answered `d\x.txt` and `d/**/*.txt` answered `d/x.txt`.
  #
  # The match is `File.match?`'s, its language and its linear algorithm. It
  # was a matcher of its own that `File.match?`'s fix did not reach: `?`
  # took one byte, so `?.txt` missed `ü.txt`; `[ab].*` and `*.{txt,md}`
  # were literal text and answered `[]`; and `*` backtracked at every
  # position, four times slower for each star - nine of them against one
  # forty-character name took 30 seconds where `File.match?` takes none.
  private def self.glob_single(pattern : String, &block : String -> Nil) : Nil
    bytes = pattern.to_unsafe
    n = pattern.bytesize
    first_wild = 0
    # `\\?\` and `\\.\` are how a Windows path is spelled, not a wildcard:
    # the scan stopped at that `?`, the walk began at `\\`, and the pattern
    # answered `[]` for a directory `Dir.children` listed.
    if {{ flag?(:win32) }} && n >= 4 && glob_sep?(bytes[0]) && glob_sep?(bytes[1]) &&
       (bytes[2] == 63_u8 || bytes[2] == 46_u8) && glob_sep?(bytes[3])
      first_wild = 4
    end
    while first_wild < n && !glob_wild?(bytes[first_wild])
      first_wild = first_wild + 1
    end
    cut = -1
    at = 0
    while at < first_wild
      cut = at if glob_sep?(bytes[at])
      at = at + 1
    end
    prefix = cut < 0 ? "" : String.new(cut + 1) { |t| t.copy_from(bytes, cut + 1) }
    # `File.match?` reads a pattern's `\` as a separator on Windows but a
    # `**` as one only between `/`s, so `d\**\x.txt` did not find `d\x.txt`;
    # it is given the pattern with `/` alone, and the answers keep the
    # spelling of the pattern as written.
    matcher = pattern
    {% if flag?(:win32) %}
      matcher = String.new(n) do |t|
        t.copy_from(bytes, n)
        i = 0
        while i < n
          t[i] = 47_u8 if t[i] == 92_u8
          i = i + 1
        end
      end
    {% end %}
    # The separators after the prefix: each is where a deeper directory's
    # part of the pattern ends, and the walk goes no deeper than they do.
    # Each level's part is matched before the walk goes into it, while the
    # parts are whole patterns: a separator inside a `{...}` or a `[...]`
    # gives the branches different depths, and from there on the walk only
    # counts levels and leaves the deciding to the whole match.
    ends = [] of Int32
    parts = [] of String
    braces = 0
    whole = true
    at = cut + 1
    while at < n
      c = bytes[at]
      if c == 91_u8
        # A class runs to its `]`, and its first member - after `[` or
        # `[^` - may be a `]`, as `File.match?` reads one.
        at = at + 1
        at = at + 1 if at < n && bytes[at] == 94_u8
        first = true
        while at < n && (first || bytes[at] != 93_u8)
          at = at + 1 if !{{ flag?(:win32) }} && bytes[at] == 92_u8 && at + 1 < n
          if glob_sep?(bytes[at])
            ends << at
            whole = false
          end
          first = false
          at = at + 1
        end
      elsif c == 123_u8
        braces = braces + 1
      elsif c == 125_u8 && braces > 0
        braces = braces - 1
      elsif !{{ flag?(:win32) }} && c == 92_u8 && at + 1 < n
        # An escape: the byte behind it is literal, and an escaped `/` is
        # still a level, but a part cut after the `\` is no pattern.
        at = at + 1
        if glob_sep?(bytes[at])
          ends << at
          whole = false
        end
      elsif glob_sep?(c)
        ends << at
        whole = false if braces > 0
        parts << matcher[0, at] if whole
      end
      at = at + 1
    end
    # A name that starts with `.` is hidden: a wildcard does not answer it,
    # and the walk does not go into it, unless the pattern's own segment
    # there starts with `.` - or with a `{`, whose branches decide. Past a
    # `**`, or a separator inside braces, which segment a name is under is
    # not known, and any segment starting so will do.
    deep = pattern.includes?("**")
    dots = [] of Bool
    any_dot = false
    start = cut + 1
    level = 0
    while start <= n
      dot = start < n && (bytes[start] == 46_u8 || bytes[start] == 123_u8)
      any_dot = any_dot || dot
      dots << dot if !deep && level <= parts.size
      start = level < ends.size ? ends[level] + 1 : n + 1
      level = level + 1
    end
    sep_at = ends.empty? ? cut : ends[0]
    sep = sep_at < 0 ? "/" : String.new(1) { |t| t[0] = bytes[sep_at] }
    glob_walk(prefix.empty? ? "." : prefix, prefix, matcher, parts, ends.size, dots, any_dot, 0, deep, sep, &block)
  end

  private def self.glob_walk(dir : String, shown : String, matcher : String, parts : Array(String), limit : Int32,
                             dots : Array(Bool), any_dot : Bool, level : Int32, deep : Bool, sep : String,
                             &block : String -> Nil) : Nil
    return unless Dir.exists?(dir)
    Dir.each_child(dir) do |child|
      next if child.starts_with?('.') && !(level < dots.size ? dots[level] : any_dot)
      full = shown + child
      yield full if File.match?(full, matcher)
      next unless deep || level < limit
      # Only into a directory the pattern's part so far can match.
      next unless deep || level >= parts.size || File.match?(full, parts[level])
      next unless Dir.exists?(full)
      # Under `**` the walk does not go through a link, as the other
      # library's and the shells' do not. A junction back up the tree was
      # walked again at every level - one file answered 64 times, and two
      # such links branched past any finish - until a cap of 64 levels
      # stopped the walk, which also cut a real tree 70 deep off without a
      # word.
      next if deep && File.symlink?(full)
      glob_walk(full, full + sep, matcher, parts, limit, dots, any_dot, level + 1, deep, sep, &block)
    end
  end

  # What ends a pattern's literal prefix: `*`, `?`, `[` and `{`, and on
  # posix the `\` that escapes the next byte. The scan knew `*` and `?`,
  # so a pattern that began with a class or a brace was walked as a
  # directory named by its text.
  private def self.glob_wild?(c : UInt8) : Bool
    c == 42_u8 || c == 63_u8 || c == 91_u8 || c == 123_u8 || (!{{ flag?(:win32) }} && c == 92_u8)
  end

  # Windows has two separators and a program mixes them without meaning to:
  # `Dir.current` answers backslashes, every caller here joins with `/`, and a
  # pattern arrives carrying whatever the two of them produced. On posix a
  # backslash is an ordinary byte in a name and stays one.
  private def self.glob_sep?(c : UInt8) : Bool
    {% if flag?(:win32) %}
      c == 47_u8 || c == 92_u8
    {% else %}
      c == 47_u8
    {% end %}
  end

  protected def self.c_str(str : String) : UInt8*
    n = str.bytesize
    ptr = str.to_unsafe
    i = 0
    while i < n
      raise "path contains a NUL byte" if ptr[i] == 0_u8
      i = i + 1
    end
    buf = Pointer(UInt8).malloc((n + 1).to_u64)
    buf.copy_from(ptr, n)
    buf[n] = 0_u8
    buf
  end

  {% if flag?(:win32) %}
    # The search pattern FindFirstFileW is opened with: the directory, wide,
    # with a separator and a `*` behind it. The directory is converted on its
    # own and the wildcard appended to the result, not converted with it,
    # because a long path's conversion runs through `GetFullPathNameW` and
    # that is a path normaliser rather than a pattern one — the `\\?\` prefix
    # it produces is what a long directory needs here, and a `*` is no
    # business of its. A null pointer is the conversion having failed, which
    # the callers read as the directory not opening.
    protected def self.find_pattern(dir_path : String) : UInt16*
      # An empty path names no directory, as POSIX `opendir("")` fails: it
      # became a pattern for the current drive's root, and
      # `Dir.children("")` listed `C:\` while `Dir.exists?("")` said false.
      return Pointer(UInt16).new(0_u64) if dir_path.empty?
      wide = __iyi_wide_path(c_str(dir_path))
      return wide if wide.address == 0_u64
      length = 0
      while wide[length] != 0_u16
        length = length + 1
      end
      # One separator, not two. A path this library hands on unprefixed is
      # normalised by Windows, which collapses `\\` in the middle of a
      # pattern, so a caller's trailing separator cost nothing; past 248
      # characters `__iyi_wide_path` puts the `\\?\` prefix on, and that
      # prefix means "do not parse this again" — the doubled separator then
      # reaches the file system as it is and `FindFirstFileW` refuses a
      # directory `Dir.exists?` accepts on the same string.
      #
      # A root keeps its separator, and gets no second one: `\` or `/`
      # alone became `\\*` or `/\*`, which Windows reads as the start of
      # a network path, so `Dir.children("/")` panicked on a directory
      # `Dir.exists?` accepted. And a bare drive gets none: `C:` is the
      # current directory on C:, and `C:\*` listed the drive's root.
      while length > 1 && (wide[length - 1] == 92_u16 || wide[length - 1] == 47_u16) && wide[length - 2] != 58_u16
        length = length - 1
      end
      last = length > 0 ? wide[length - 1] : 0_u16
      separated = last == 92_u16 || last == 47_u16 || last == 58_u16
      pattern = Pointer(UInt16).malloc((length + 3).to_u64)
      index = 0
      while index < length
        pattern[index] = wide[index]
        index = index + 1
      end
      unless separated
        pattern[index] = 92_u16 # '\'
        index = index + 1
      end
      pattern[index] = 42_u16 # '*'
      pattern[index + 1] = 0_u16
      pattern
    end
  {% end %}
end
