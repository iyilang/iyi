# The Stage 2 arena allocator, exercised rather than asserted — the program
# half of GC_DESIGN.md's Stage 2 verification ("allocate and free objects of
# various sizes; verify no corruption; inspect arena structure; measure
# allocation speed"). `bench/arena_exercise.sh` drives it.
#
#   ./bin/iyi run bench/arena_exercise.iyi
#   ./bin/iyi run -Dgc_none bench/arena_exercise.iyi
#
# Built twice: a plain build runs every check below against the size-class
# arena allocator, which is the default now, and `-Dgc_none` runs the
# allocator-independent checks against the opted-out bump pointer, so the
# same program proves the opt-out path still works. The checks that only an
# arena can answer (free, clearing, classes, addressability, large-object
# release) compile out under `-Dgc_none`. Every check raises with the block and offset on a wrong byte, and a
# panic exits non-zero, which is what the driver keys on.
#
# The header is one word under the pointer: the mark word, the type id in
# its high half; the size is the chunk's, which the arena knows. It was
# three words - a size, a type id, a mark word - until the diet that put a
# 16-byte object in 24 bytes of heap rather than 40. The checks that read
# the class back out of the arena's chunk size subtract eight now, and a
# section below says the header's own bytes behave.
#
# Not under `samples/`: the sample count is a gated number and samples are
# explanations, not torture tests.

# The stopwatch. Linux reads CLOCK_MONOTONIC with a raw syscall for the
# prelude's own reason (libc is not bound there); darwin asks libSystem,
# which is the platform's documented interface. Either way the answer is
# nanoseconds; what it costs is two allocations of sixteen bytes, once per
# call, which a per-allocation measurement can afford at the ends of a run.
{% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
  def monotonic_ns : UInt64
    stamp = Pointer(UInt64).malloc(2_u64)
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      # clock_gettime, CLOCK_MONOTONIC = 1.
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(228_i64), "{rdi}"(1_i64), "{rsi}"(stamp.as(Void*))
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(113_i64), "{x0}"(1_i64), "{x1}"(stamp.as(Void*))
                   : "memory"
                   : "volatile")
    {% end %}
    stamp[0] * 1000000000_u64 + stamp[1]
  end
{% elsif flag?(:darwin) %}
  lib LibC
    fun clock_gettime(clock_id : Int32, stamp : Void*) : Int32
  end

  def monotonic_ns : UInt64
    stamp = Pointer(UInt64).malloc(2_u64)
    # CLOCK_MONOTONIC_RAW is 4 on darwin: 1 answers EINVAL there, 6 is
    # CLOCK_MONOTONIC and is rounded to the microsecond on arm64, and 4 is
    # the 24 MHz counter the prelude's own clock reads — a per-allocation
    # figure in nanoseconds wants the ticks.
    LibC.clock_gettime(4, stamp.as(Void*))
    stamp[0] * 1000000000_u64 + stamp[1]
  end
{% end %}

# Every byte of a block gets a value distinct to the block and the offset:
# the seed names the block, and 31 is coprime with 256, so the offset term
# walks every residue. A chunk handed to two owners, or a cleared chunk that
# was not, cannot survive eight blocks of this unchanged by accident.
def fill(pointer : Pointer(UInt8), size : Int32, seed : Int32) : Nil
  index = 0
  while index < size
    pointer[index] = ((seed + index * 31) % 256).to_u8

    index = index + 1
  end
end

def verify(pointer : Pointer(UInt8), size : Int32, seed : Int32, tag : String) : Nil
  index = 0
  while index < size
    expected = ((seed + index * 31) % 256).to_u8
    actual = pointer[index]
    if actual != expected
      raise "#{tag}: byte #{index}: expected #{expected.to_i32}, got #{actual.to_i32}"
    end
    index = index + 1
  end
end

sizes = [24, 100, 500, 2000, 9000, 48, 300, 1200]

# --- Survival: patterns written are patterns read back, both allocators ---
blocks = [] of Pointer(UInt8)
seeds = [] of Int32
index = 0
while index < 256
  size = sizes[index % sizes.size]
  block = Pointer(UInt8).malloc(size.to_u64)
  seed = index * 7 + 1
  fill(block, size, seed)
  blocks << block
  seeds << seed
  index = index + 1
end
index = 0
while index < blocks.size
  verify(blocks[index], sizes[index % sizes.size], seeds[index], "survival block #{index}")
  index = index + 1
end
puts "survival: #{blocks.size} blocks across #{sizes.size} sizes hold their patterns"

# --- Alignment: every pointer 8-aligned, both allocators ---
index = 0
while index < blocks.size
  if blocks[index].address & 7 != 0
    raise "alignment: block #{index} is not 8-aligned"
  end
  index = index + 1
end
puts "alignment: every pointer 8-aligned"

# --- realloc: same-class growth, cross-class growth, and null, both allocators ---
grown = Pointer(UInt8).malloc(24_u64)
fill(grown, 24, 3)
grown = grown.realloc(30_u64)
verify(grown, 24, 3, "realloc within class")
fill(grown, 30, 3)
grown = grown.realloc(2000_u64)
verify(grown, 30, 3, "realloc across classes")
nothing = Pointer(UInt8).new(0_u64)
nothing = nothing.realloc(64_u64)
fill(nothing, 64, 9)
verify(nothing, 64, 9, "realloc of null")
puts "realloc: same-class, cross-class and null all hold their bytes"

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin)) %}
  # The allocation-pressure trigger is off for this exercise: it
  # choreographs colours and free lists across explicit collections,
  # and a string interpolation running a collection mid-check would be
  # the trigger working, measured as a flake.
  # bench/collect_trigger.sh is where the trigger itself is proven.
  IyiMark.auto = false

  # --- Size classes: a request lands in its class, and the class is the payload ---
  # Untyped memory is headless: the chunk is the request's class, and a
  # 4096-byte buffer is a 4096-byte chunk.
  requests = [1, 15, 16, 17, 40, 129, 4095, 4096, 5000]
  expected = [16, 16, 16, 24, 40, 160, 4096, 4096, 5120]
  index = 0
  while index < requests.size
    block = IyiHeap.alloc(requests[index].to_u64)
    arena = IyiHeap.containing(block)
    raise "size classes: request #{requests[index]} is in no arena" if arena == 0
    payload = IyiHeap.arena_chunk(arena)
    if payload != expected[index].to_u64
      raise "size classes: request #{requests[index]} landed in class #{payload.to_i64}, expected #{expected[index]}"
    end
    if IyiHeap.size_of(block.address) != payload
      raise "size classes: request #{requests[index]} reports #{IyiHeap.size_of(block.address).to_i64} bytes, its chunk is #{payload.to_i64}"
    end
    if block.address & 7 != 0
      raise "size classes: request #{requests[index]} is not 8-aligned"
    end
    index = index + 1
  end
  puts "size classes: 1/15/16/17/40/129/4095/4096/5000 -> 16/16/16/24/40/160/4096/4096/5120, all 8-aligned"

  # --- Addressability: a live block resolves, a foreign pointer answers 0 ---
  probe = IyiHeap.alloc(100_u64)
  arena = IyiHeap.containing(probe)
  raise "addressability: live block is in no arena" if arena == 0
  middle = Pointer(Void).new(probe.address + 50)
  if IyiHeap.containing(middle) != arena
    raise "addressability: block middle resolved to a different arena"
  end
  payload = IyiHeap.arena_chunk(arena)
  if payload != 104_u64
    raise "addressability: block of 100 resolved to class #{payload.to_i64}, expected 104"
  end
  local = 0_u64
  foreign = IyiHeap.containing(pointerof(local).as(Void*))
  if foreign != 0
    raise "addressability: a stack word was claimed by arena #{foreign.to_i64.to_s(16)}"
  end
  puts "addressability: live block and its middle resolve to class 104, a stack word answers 0"

  # --- Header: a word under a headed object and none under a headless
  # one, and the bits in the chunk's byte either way. A headed instance
  # (the class's `:headed` byte said so) carries its type id as a u32 at
  # P-4, read back as the word's high half the way dispatch reads it; a
  # headless one carries it in the arena's layout table and its chunk is
  # its fields alone; untyped memory is headless with a slot of 0. The
  # collector's bits - colour, free, atomic, the epoch's parity, headed -
  # are the chunk's byte, never the word. Read as words, not `UInt32`:
  # `UInt32` in this prelude has no `<`, no `to_u64`, and an `==` that
  # answers false even for `x = 99_u32; x == 99_u32`.
  headed_probe = IyiHeap.new_object(64_u64, 99_u64, true, false)
  size_at = IyiHeap.size_of(headed_probe.address)
  raise "header: the size of a headed 64-byte object is #{size_at.to_i64}, expected 64" if size_at != 64_u64
  read_word = Pointer(UInt64).new(headed_probe.address - 8_u64).value
  if read_word.unsafe_shr(32_u64) != 99_u64 || IyiMark.type_id_of(headed_probe.address) != 99_u64
    raise "header: a headed object's type id did not round trip through the word at P-8"
  end
  if IyiMark.flags(headed_probe.address) != IyiMark.epoch_flag | IyiHeap::HEADED_FLAG
    raise "header: a headed object's byte is #{IyiMark.flags(headed_probe.address).to_i64}, expected the epoch stamp and the headed bit"
  end
  arena = IyiHeap.containing(headed_probe)
  raise "header: a headed 64-byte object is in the #{IyiHeap.arena_chunk(arena).to_i64} class, expected 72" if IyiHeap.arena_chunk(arena) != 72_u64
  headless_probe = IyiHeap.new_object(64_u64, 77_u64, false, false)
  raise "header: the size of a headless 64-byte object is #{IyiHeap.size_of(headless_probe.address).to_i64}, expected 64" if IyiHeap.size_of(headless_probe.address) != 64_u64
  raise "header: a headless object's type id reads as #{IyiMark.type_id_of(headless_probe.address).to_i64}, expected 77" if IyiMark.type_id_of(headless_probe.address) != 77_u64
  if IyiMark.flags(headless_probe.address) != IyiMark.epoch_flag
    raise "header: a headless object's byte is #{IyiMark.flags(headless_probe.address).to_i64}, expected the epoch stamp alone"
  end
  arena = IyiHeap.containing(headless_probe)
  raise "header: a headless 64-byte object is in the #{IyiHeap.arena_chunk(arena).to_i64} class, expected 64" if IyiHeap.arena_chunk(arena) != 64_u64
  header_probe = IyiHeap.alloc(64_u64)
  raise "header: untyped memory's type id reads as #{IyiMark.type_id_of(header_probe.address).to_i64}, expected 0" if IyiMark.type_id_of(header_probe.address) != 0_u64
  header_probe = header_probe.realloc(2000_u64)
  moved_size = IyiHeap.size_of(header_probe.address)
  raise "header: realloc to 2000 bytes answers a size of #{moved_size.to_i64}" if moved_size < 2000_u64
  raise "header: realloc to 2000 bytes answers a size of #{moved_size.to_i64}, past its class" if moved_size > 2048_u64
  puts "header: a word at P-8 under a headed object and none under a headless one, the bits in the chunk's byte; the size the arena's, live through a realloc"

  # --- Clearing: a dirty chunk comes back zeroed through the clearing entry ---
  dirty = IyiHeap.alloc(100_u64).as(Pointer(UInt8))
  index = 0
  while index < 100
    dirty[index] = 170_u8
    index = index + 1
  end
  IyiHeap.free(dirty.as(Void*))
  fresh = IyiHeap.alloc(100_u64).as(Pointer(UInt8))
  index = 0
  while index < 100
    if fresh[index] != 0_u8
      raise "clearing: reused chunk dirty at byte #{index}: got #{fresh[index].to_i32}"
    end
    index = index + 1
  end
  # The same check end to end through codegen's clearing entry point:
  # Pointer of a pointerful type routes to `__iyi_malloc64`.
  words = Pointer(Pointer(UInt8)).malloc(16_u64)
  index = 0
  while index < 128
    words.as(Pointer(UInt8))[index] = 170_u8
    index = index + 1
  end
  IyiHeap.free(words.as(Void*))
  words = Pointer(Pointer(UInt8)).malloc(16_u64)
  index = 0
  while index < 128
    if words.as(Pointer(UInt8))[index] != 0_u8
      raise "clearing: __iyi_malloc64 reused chunk dirty at byte #{index}"
    end
    index = index + 1
  end
  # And the chunk's byte: a reused chunk must come back with fresh bits,
  # whichever entry point handed it out, because a stale colour is a
  # live object the collector never scans. Bit 4 is the allocator's own
  # stamp, the epoch parity the lazy sweep reads (GC_DESIGN.md);
  # everything else - colour, the free flag, the atomic flag - must be
  # zero, and untyped memory is headless.
  if IyiMark.flags(words.address) != IyiMark.epoch_flag | IyiHeap::UNTYPED_FLAG
    raise "clearing: reused chunk carried stale bits: #{IyiMark.flags(words.address).to_i64}"
  end
  puts "clearing: a freed chunk of 0xAA bytes comes back zeroed, directly, through __iyi_malloc64, and in its byte"

  # --- No corruption under reuse: freed chunks serve new owners, survivors unchanged ---
  rblocks = [] of Pointer(UInt8)
  rseeds = [] of Int32
  index = 0
  while index < 200
    size = sizes[index % sizes.size]
    block = Pointer(UInt8).malloc(size.to_u64)
    seed = index * 13 + 5
    fill(block, size, seed)
    rblocks << block
    rseeds << seed
    index = index + 1
  end
  # Free every other block, newest first, which is not the allocation order.
  index = rblocks.size - 2
  while index >= 0
    IyiHeap.free(rblocks[index].as(Void*))
    index = index - 2
  end
  # Allocate again against the freed chunks, in a different size order, so a
  # reused chunk that aliases a survivor overwrites it and is caught below.
  nblocks = [] of Pointer(UInt8)
  nseeds = [] of Int32
  index = 0
  while index < 100
    size = sizes[(index * 3 + 1) % sizes.size]
    block = Pointer(UInt8).malloc(size.to_u64)
    seed = 7000 + index * 11
    fill(block, size, seed)
    nblocks << block
    nseeds << seed
    index = index + 1
  end
  index = 1
  while index < rblocks.size
    verify(rblocks[index], sizes[index % sizes.size], rseeds[index], "reuse survivor #{index}")
    index = index + 2
  end
  index = 0
  while index < nblocks.size
    verify(nblocks[index], sizes[(index * 3 + 1) % sizes.size], nseeds[index], "reuse block #{index}")
    index = index + 1
  end
  puts "reuse: 200 allocated, 100 freed out of order, 100 allocated again, every byte intact"

  # --- Large objects: over the top class, round trip, listed, unlisted on free ---
  big = 2097153
  large = Pointer(UInt8).malloc(big.to_u64)
  fill(large, big, 17)
  verify(large, big, 17, "large object")
  if IyiHeap.containing_large(large.as(Void*)) == 0
    raise "large: a live large object is on no list"
  end
  if IyiHeap.containing(large.as(Void*)) != 0
    raise "large: an arena claimed a large object"
  end

  # realloc across the large boundary in both directions: a class chunk
  # growing past the top class, a large object growing to another mapping,
  # and one shrinking back into a class. Each one allocates, copies the
  # smaller of the two sizes and frees the old, so a lost byte or a leaked
  # node shows up here rather than in a program.
  crossing = Pointer(UInt8).malloc(500_u64)
  fill(crossing, 500, 11)
  crossing = crossing.realloc(2000000_u64)
  verify(crossing, 500, 11, "realloc class to large")
  fill(crossing, 3000, 21)
  crossing = crossing.realloc(3000000_u64)
  verify(crossing, 3000, 21, "realloc large to larger")
  fill(crossing, 300, 31)
  crossing = crossing.realloc(100_u64)
  verify(crossing, 100, 31, "realloc large to class")
  puts "realloc: class to large, large to larger and large back to class all hold their bytes"

  # --- Traversal: the arena list and the large list both walk ---
  arenas = 0
  arena = IyiHeap.first_arena
  while arena != 0
    puts "  arena #{arenas}: chunk #{IyiHeap.arena_chunk(arena).to_i64} bytes, #{IyiHeap.arena_map(arena).to_i64} mapped"
    arenas = arenas + 1
    arena = IyiHeap.arena_next(arena)
  end
  larges = 0
  node = IyiHeap.first_large
  while node != 0
    larges = larges + 1
    node = IyiHeap.large_next(node)
  end
  raise "traversal: no arenas on the list" if arenas == 0
  if larges != 1
    raise "traversal: #{larges} large objects listed, expected 1"
  end
  puts "traversal: #{arenas} arenas and #{larges} large object walked"

  IyiHeap.free(large.as(Void*))
  if IyiHeap.first_large != 0
    raise "large: still listed after free"
  end
  puts "large: 2 MiB over the top class round trips and unlists on free; bench/arena_large_probe.iyi proves the mapping is gone"

  {% if flag?(:linux) %}
    # --- Huge pages: an arena's first four megabytes refuse them, the rest
    # is the kernel's default. A transparent huge page given to a 16 MB
    # mapping's first touch is 2 MB resident for a class with one object
    # in it; an arena carved past IyiHeap::HUGE_AT is large, and its tail
    # faults in huge where THP is `always`, which is what a large heap's
    # page walk is saved by. Read from the kernel's own books: resident
    # pages in /proc/self/statm for twelve one-object arenas, and the flags
    # the kernel holds for an arena's two halves in /proc/self/smaps - `nh`
    # on the first, not on the second - which is the rule as the kernel
    # has it, whatever huge pages it has to give today; what it gave is
    # reported from AnonHugePages. Nothing to see where THP is `never`.
    def number_after(text : String, key : String) : UInt64
      bytes = text.to_unsafe
      size = text.bytesize
      want = key.to_unsafe
      length = key.bytesize
      at = 0
      while at + length <= size
        matched = 0
        while matched < length && bytes[at + matched] == want[matched]
          matched = matched + 1
        end
        break if matched == length
        at = at + 1
      end
      raise "huge: #{key} not found" if at + length > size
      at = at + length
      while at < size && (bytes[at] == 32_u8 || bytes[at] == 9_u8)
        at = at + 1
      end
      value = 0_u64
      while at < size && bytes[at] >= 48_u8 && bytes[at] <= 57_u8
        value = value * 10_u64 + (bytes[at] - 48_u8).to_u64
        at = at + 1
      end
      value
    end

    def resident_kb : UInt64
      # statm: size resident shared text lib data dt, in pages.
      text = File.read("/proc/self/statm")
      bytes = text.to_unsafe
      at = 0
      while bytes[at] != 32_u8
        at = at + 1
      end
      number_after(text, " ") * 4_u64
    end

    def anon_huge_kb : UInt64
      number_after(File.read("/proc/self/smaps_rollup"), "AnonHugePages:")
    end

    # The VmFlags line of the mapping holding `address`, from smaps: each
    # mapping is a "low-high perms ..." line and a block of fields after
    # it, VmFlags the last.
    def vm_flags_at(address : UInt64) : String
      text = File.read("/proc/self/smaps")
      bytes = text.to_unsafe
      size = text.bytesize
      at = 0
      inside = false
      while at < size
        stop = at
        while stop < size && bytes[stop] != 10_u8
          stop = stop + 1
        end
        line = text[at, stop - at]
        if line.bytesize > 12 && bytes[at] >= 48_u8 && ((bytes[at] <= 57_u8) || (bytes[at] >= 97_u8 && bytes[at] <= 102_u8)) && !line.starts_with?("VmFlags")
          # A range line: low-high in hex.
          low = 0_u64
          cursor = at
          while bytes[cursor] != 45_u8
            digit = bytes[cursor]
            low = low * 16_u64 + (digit <= 57_u8 ? (digit - 48_u8).to_u64 : (digit - 87_u8).to_u64)
            cursor = cursor + 1
          end
          cursor = cursor + 1
          high = 0_u64
          while bytes[cursor] != 32_u8
            digit = bytes[cursor]
            high = high * 16_u64 + (digit <= 57_u8 ? (digit - 48_u8).to_u64 : (digit - 87_u8).to_u64)
            cursor = cursor + 1
          end
          inside = low <= address && address < high
        elsif inside && line.starts_with?("VmFlags")
          return line
        end
        at = stop + 1
      end
      raise "huge: no mapping in smaps holds #{address.to_i64.to_s(16)}"
    end

    thp = File.read("/sys/kernel/mm/transparent_hugepage/enabled")
    if !thp.includes?("[never]")
      # Twelve classes this program has not touched, one object each: twelve
      # fresh arenas, a page or two resident apiece.
      resident_before = resident_kb
      size = 10240_u64
      index = 0
      while index < 12
        Pointer(UInt8).malloc(size).value = 1_u8
        size = size + 2048_u64
        index = index + 1
      end
      grew = resident_kb - resident_before
      if grew > 2048_u64
        raise "huge: twelve arenas of one object each added #{grew.to_i64} KB resident, so small arenas are taking huge pages"
      end
      puts "huge: twelve one-object arenas added #{grew.to_i64} KB resident, none of it a huge page"
    end
    if thp.includes?("[never]")
      puts "huge: transparent huge pages are `never` here, nothing to check"
    else
      # One class carved past HUGE_AT and four megabytes on: the arena's
      # first four megabytes refuse huge pages (`nh` in its flags) and the
      # rest does not, whatever the kernel found to give it.
      huge_before = anon_huge_kb
      kept = Array(Pointer(UInt8)).new
      carved = 0_u64
      while carved < IyiHeap::HUGE_AT + 4194304_u64
        block = Pointer(UInt8).malloc(3000_u64)
        block.value = 1_u8
        kept << block
        carved = carved + 3072_u64
      end
      grew = anon_huge_kb - huge_before
      arena = IyiHeap.containing(kept[0].as(Void*))
      raise "huge: the carved class is in no arena" if arena == 0
      head_flags = vm_flags_at(arena)
      tail_flags = vm_flags_at(arena + IyiHeap::HUGE_AT)
      if !head_flags.includes?(" nh")
        raise "huge: an arena's first #{IyiHeap::HUGE_AT.unsafe_shr(20_u64).to_i64} MB do not refuse huge pages (#{head_flags})"
      end
      if tail_flags.includes?(" nh")
        raise "huge: an arena's tail past #{IyiHeap::HUGE_AT.unsafe_shr(20_u64).to_i64} MB refuses huge pages too (#{tail_flags}), so a large heap never gets them"
      end
      puts "huge: an arena carved #{carved.unsafe_shr(20_u64).to_i64} MB refuses huge pages on its first #{IyiHeap::HUGE_AT.unsafe_shr(20_u64).to_i64} MB and not past them, and #{grew.to_i64} KB of it faulted in huge (#{kept.size} blocks kept)"
    end
  {% end %}
{% else %}
  puts "arena checks skipped: this build deselected the collector's allocator; a plain build runs them"
{% end %}

# --- Speed: a long run of allocations, nanoseconds per allocation ---
# The best of three passes, the way every number in this repository is
# read: the gate below is a ratio against the bump pointer measured in
# the same run, and one pass on a shared runner read 2.7x where the next
# read 2.2 - a scheduler's tick landing in one loop and not the other.
runs = 2000000
sink = 0_u64
best = 0_u64
pass = 0
while pass < 3
  start = monotonic_ns
  index = 0
  while index < runs
    block = Pointer(UInt8).malloc(24_u64)
    block[0] = 1_u8
    sink = sink &+ block.address
    index = index + 1
  end
  elapsed = monotonic_ns - start
  best = elapsed if pass == 0 || elapsed < best
  pass = pass + 1
end
puts "speed: #{best.unsafe_div(runs.to_u64).to_i64} ns per allocation over #{runs} (sink #{(sink & 1023).to_i64})"

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin)) %}
  # The pair loop: what an allocation costs when its chunk is freed each
  # time, which is the shape a collecting heap's mutator actually takes.
  best = 0_u64
  pass = 0
  while pass < 3
    start = monotonic_ns
    index = 0
    while index < runs
      block = Pointer(UInt8).malloc(24_u64)
      block[0] = 1_u8
      sink = sink &+ block.address
      IyiHeap.free(block.as(Void*))
      index = index + 1
    end
    elapsed = monotonic_ns - start
    best = elapsed if pass == 0 || elapsed < best
    pass = pass + 1
  end
  puts "speed: #{best.unsafe_div(runs.to_u64).to_i64} ns per alloc+free pair over #{runs}"
{% end %}

puts "arena allocator: every check passed"
