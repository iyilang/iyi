# Exercises std/acme, and the certificate writing it takes from std/x509.
#
# With no argument: base64url without padding (RFC 4648 section 10's
# values, RFC 7515 appendix C's); RFC 7638's thumbprint and RFC 8037's;
# RFC 7515 appendix A.2's RS256 signature byte for byte, and A.3's ES256
# signing input, its signature checked as R || S and one made here
# checked the same way; RFC 8037's EdDSA signature byte for byte; the
# certificate requests std/x509 writes, read back field by field and
# their signatures checked under the key each carries; the tls-alpn-01
# certificate's extension; the http-01 responder; Retry-After read. Then
# a whole order against a server in this program that holds the client to
# RFC 8555 and breaks the protocol one rule at a time: a problem
# document, a badNonce answer, Retry-After, a finalize, a key rollover, an
# invalid challenge, a wait past its polls and one past its time.
#
# The modes the gate script drives:
#   write DIR       requests, signatures and a tls-alpn-01 certificate,
#                   for OpenSSL and Python's cryptography to read;
#   alpn-serve DIR  one TLS handshake with the tls-alpn-01 config on a
#                   port written to DIR/port;
#   pebble DIRECTORY MINICA MANAGEMENT CHALLTESTSRV HTTP_PORT TLS_PORT OUT REJECT [RSA_PEM]
#                   whole orders against Let's Encrypt's Pebble, by
#                   http-01, dns-01 and tls-alpn-01, the chains checked by
#                   std/x509 against Pebble's root and written to OUT.

import std/acme::{AcmeClient, AcmeJws, AcmeError, AcmeHttp01, AcmeTlsAlpn01, AcmeOrder, AcmeAuthorization, AcmeChallenge}
import std/x509::{X509, X509Error, SigningKey, Certificate}
import std/rsa::{RsaPublicKey, RsaPrivateKey, RsaHash}
import std/ecdsa::{EcdsaPublicKey, EcdsaCurve, EcdsaHash}
import std/p256::{P256PrivateKey}
import std/p384::{P384PrivateKey}
import std/curve25519::{Ed25519PublicKey}
import std/asn1::{Der, DerValue, Asn1Error}
import std/http::{HTTP, Request, Response, Server}
import std/socket::{IyiSocket}
import std/tls::{TlsServer, TlsServerConfig, TlsConfig, TlsError}
import std/json::{JSON, Any}
import std/base64::{Base64}
import std/digest::{SHA256}
import std/file::{File}
import std/time::{Time, Span}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def bytes(text : String) : Array(UInt8)
  Array(UInt8).new(text.bytesize) { |i| text.to_unsafe[i] }
end

def text(data : Array(UInt8)) : String
  String.new(data.size) { |buf| buf.copy_from(data.to_unsafe, data.size) }
end

def unb64(encoded : String) : Array(UInt8)
  bytes(Base64.decode(encoded))
end

def hex(data : Array(UInt8)) : String
  data.map { |x| (x < 16_u8 ? "0" : "") + x.to_s(16) }.join("")
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def ms : Int64
  Time.monotonic.total_milliseconds.to_i64
end

# A DER INTEGER of a big-endian number, for the Ecdsa-Sig-Value a raw
# signature is checked as.
def der_integer(magnitude : Array(UInt8)) : Array(UInt8)
  at = 0
  while at < magnitude.size - 1 && magnitude[at] == 0_u8
    at = at + 1
  end
  body = magnitude[at, magnitude.size - at]
  body = [0_u8] + body if body[0] >= 0x80_u8
  [2_u8, body.size.to_u8] + body
end

# R || S as the DER std/ecdsa checks.
def der_of(raw : Array(UInt8)) : Array(UInt8)
  half = raw.size // 2
  body = der_integer(raw[0, half]) + der_integer(raw[half, half])
  body.size < 128 ? [0x30_u8, body.size.to_u8] + body : [0x30_u8, 0x81_u8, body.size.to_u8] + body
end

# The three parts of a flattened JWS.
def jws_parts(jws : String) : {String, String, String}
  fields = JSON.parse(jws).as_h
  {fields["protected"].as_s, fields["payload"].as_s, fields["signature"].as_s}
end

