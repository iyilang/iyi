    0x3e1a7d1e330dccce_u64, 0x3f84cb7000000000_u64, 0x3e0187025e656ba3_u64, 0x3f857cd000000000_u64,
    0xbe4532c1269e2038_u64, 0x3f862e5000000000_u64,
  ]

  private ASINH_MASK52  = 0x000fffffffffffff_u64
  private ASINH_ONE_EXP = 0x3ff0000000000000_u64

  private def self.asinh_at(t : Pointer(UInt64), i : Int32) : Float64
    IyiFloatText.from_bits(t[i])
  end

  private def self.asinh_fabs(x : Float64) : Float64
    IyiFloatText.from_bits(IyiFloatText.bits_of(x) & 0x7fffffffffffffff_u64)
  end

  # ddcoremath.h fasttwosum
  private def self.asinh_fast_two_sum(x : Float64, y : Float64) : {Float64, Float64}
    s = x + y
    z = s - x
    {s, y - z}
  end

  # ddcoremath.h fasttwosub
  private def self.asinh_fast_two_sub(x : Float64, y : Float64) : {Float64, Float64}
    s = x - y
    z = x - s
    {s, z - y}
  end

  # ddcoremath.h adddd
  private def self.asinh_add_dd(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    s = xh + ch
    d = s - xh
    {s, ((ch - d) + (xh + (d - s))) + (xl + cl)}
  end

  # ddcoremath.h muldd_acc
  private def self.asinh_muldd_acc(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahlh = ch * xl
    alhh = cl * xh
    ahhh = ch * xh
    ahhl = Math.fma(ch, xh, ahhh * -1.0)
    ahhl = ahhl + (alhh + ahlh)
    h = ahhh + ahhl
    {h, (ahhh - h) + ahhl}
  end

  # ddcoremath.h muldd_acc2
  private def self.asinh_muldd_acc2(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahlh = ch * xl
    alhh = cl * xh
    ahhh = ch * xh
    ahhl = Math.fma(ch, xh, ahhh * -1.0)
    ahhl = ahhl + (alhh + ahlh)
    asinh_fast_two_sum(ahhh, ahhl)
  end

  # ddcoremath.h mulddd
  private def self.asinh_mulddd(xh : Float64, xl : Float64, ch : Float64) : {Float64, Float64}
    ahlh = ch * xl
    ahhh = ch * xh
    ahhl = Math.fma(ch, xh, ahhh * -1.0)
    ahhl = ahhl + ahlh
    h = ahhh + ahhl
    {h, (ahhh - h) + ahhl}
  end

  # ddcoremath.h mulddd3
  private def self.asinh_mulddd3(xh : Float64, xl : Float64, ch : Float64) : {Float64, Float64}
    hh = xh * ch
    {hh, Math.fma(ch, xh, hh * -1.0) + xl * ch}
  end

  # ddcoremath.h polydd: c holds n {hi, lo} rows, l the low tail in.
  private def self.asinh_polydd(xh : Float64, xl : Float64, n : Int32, c : Pointer(UInt64), l : Float64) : {Float64, Float64}
    i = n - 1
    ch, cl = asinh_fast_two_sum(asinh_at(c, 2 * i), l)
    cl = cl + asinh_at(c, 2 * i + 1)
    while i > 0
      i -= 1
      ch, cl = asinh_muldd_acc(xh, xl, ch, cl)
      c0 = asinh_at(c, 2 * i)
      th = ch + c0
      tl = (c0 - th) + ch
      ch = th
      cl = cl + (tl + asinh_at(c, 2 * i + 1))
    end
    {ch, cl}
  end

  # ddcoremath.h polydd3
  private def self.asinh_polydd3(xh : Float64, xl : Float64, n : Int32, c : Pointer(UInt64), l : Float64) : {Float64, Float64}
    i = n - 1
    ch, cl = asinh_fast_two_sum(asinh_at(c, 2 * i), l)
    cl = cl + asinh_at(c, 2 * i + 1)
    while i > 0
      i -= 1
      ch, cl = asinh_muldd_acc2(xh, xl, ch, cl)
      th, tl = asinh_fast_two_sum(asinh_at(c, 2 * i), ch)
      ch = th
      cl = cl + (tl + asinh_at(c, 2 * i + 1))
    end
    {ch, cl}
  end

  # The final bit fix of the refinements: a low part exactly a power of two
  # moves one ulp toward the tail w.
  private def self.asinh_nudge(v1 : Float64, v2 : Float64) : Float64
    t = IyiFloatText.bits_of(v1)
    return v1 if t & ASINH_MASK52 != 0_u64
    w = IyiFloatText.bits_of(v2)
    if (w ^ t).unsafe_shr(63_u64) != 0_u64
      t = t &- 1_u64
    else
      t = t &+ 1_u64
    end
    IyiFloatText.from_bits(t)
  end

  # Index j into r1/r2, l1/l2 from the mantissa bits t (s_asinh.c, e_acosh.c,
  # e_atanh.c): b interleaves the c0, c1 fields of B.
  private def self.asinh_index(t : UInt64, b : Pointer(Int64)) : UInt64
    i = t.unsafe_shr(47_u64).unsafe_to_i32
    d = (t & 0x00007fffffffffff_u64).unsafe_to_i64
    c0 = b[2 * i].unsafe_to_u64.unsafe_shl(33_u64)
    c1 = b[2 * i + 1] &* d.unsafe_shr(16_i64)
    (t &+ c0 &+ c1.unsafe_to_u64).unsafe_shr(42_u64)
  end

  # Binary search of an exception table of {x, h, l} rows; sgn multiplies
  # both parts (1.0 for acosh).
  private def self.asinh_db_search(db : Pointer(UInt64), rows : Int32, ax : Float64, sgn : Float64, f : Float64) : Float64
    a = 0
    b = rows - 1
    m = (a + b) // 2
    while a <= b
      key = asinh_at(db, 3 * m)
      if key < ax
        a = m + 1
      elsif key == ax
        return sgn * asinh_at(db, 3 * m + 1) + sgn * asinh_at(db, 3 * m + 2)
      else
        b = m - 1
      end
      m = (a + b) // 2
    end
    f
  end

  # log(2^e (1 + x)) for the refinements: the t1..t4 / LL tables, sum
  # L[0..2] of the four table entries plus e log 2.
  private def self.asinh_ll_sum(i1 : Int32, i2 : Int32, i3 : Int32, i4 : Int32, k : Int32) : Float64
    ll = ASINH_LL.to_unsafe
    (asinh_at(ll, i1 * 3 + k) + asinh_at(ll, (17 + i2) * 3 + k)) + (asinh_at(ll, (34 + i3) * 3 + k) + asinh_at(ll, (51 + i4) * 3 + k))
  end

  # s_asinh.c as_asinh_zero
  private def self.asinh_zero(x : Float64, x2h : Float64, x2l : Float64) : Float64
    cl = ASINH_ZERO_CL.to_unsafe
    y2 = x2h * (asinh_at(cl, 0) + x2h * (asinh_at(cl, 1) + x2h * (asinh_at(cl, 2) + x2h * (asinh_at(cl, 3) + x2h * asinh_at(cl, 4)))))
    y1, y2 = asinh_polydd(x2h, x2l, 12, ASINH_ZERO_CH.to_unsafe, y2)
    y1, y2 = asinh_muldd_acc(y1, y2, x2h, x2l)
    y1, y2 = asinh_mulddd(y1, y2, x)
    y0, y1 = asinh_fast_two_sum(x, y1)
    y1, y2 = asinh_fast_two_sum(y1, y2)
    y0 + asinh_nudge(y1, y2)
  end

  # s_asinh.c as_asinh_refine
  private def self.asinh_refine(x : Float64, zh : Float64, zl : Float64, a : Float64) : Float64
    t = IyiFloatText.bits_of(zh)
    e = t.unsafe_shr(52_u64).unsafe_to_i32 - 0x3ff + (zl == 0.0 ? 1 : 0)
    t = (t & ASINH_MASK52) | ASINH_ONE_EXP
    ed = e.to_f64
    v = IyiFloatText.bits_of(a - ed + ASINH_REFINE_BIAS)
    i = (v &- ASINH_ONE_EXP).unsafe_shr(36_u64)
    i1 = (i.unsafe_shr(12_u64) & 0x1f_u64).unsafe_to_i32
    i2 = (i.unsafe_shr(8_u64) & 0xf_u64).unsafe_to_i32
    i3 = (i.unsafe_shr(4_u64) & 0xf_u64).unsafe_to_i32
    i4 = (i & 0xf_u64).unsafe_to_i32
    el2 = ASINH_REFINE_L22 * ed
    el1 = ASINH_REFINE_L21 * ed
    el0 = ASINH_REFINE_L20 * ed
    l0 = asinh_ll_sum(i1, i2, i3, i4, 0)
    l1 = asinh_ll_sum(i1, i2, i3, i4, 1)
    l2 = asinh_ll_sum(i1, i2, i3, i4, 2)
    l0 = l0 + el0
    t12 = asinh_at(ASINH_T1.to_unsafe, i1) * asinh_at(ASINH_T2.to_unsafe, i2)
    t34 = asinh_at(ASINH_T3.to_unsafe, i3) * asinh_at(ASINH_T4.to_unsafe, i4)
    th = t12 * t34
    tl = Math.fma(t12, t34, th * -1.0)
    tf = IyiFloatText.from_bits(t)
    dh = th * tf
    dl = Math.fma(th, tf, dh * -1.0)
    sh = tl * tf
    sl = Math.fma(tl, tf, sh * -1.0)
    xh, xl = asinh_fast_two_sum(dh - 1.0, dl)
    if zl != 0.0
      t = IyiFloatText.bits_of(zl) &- e.to_i64.unsafe_shl(52_i64).unsafe_to_u64
      xl = xl + th * IyiFloatText.from_bits(t)
    end
    xh, xl = asinh_add_dd(xh, xl, sh, sl)
    cl = ASINH_REFINE_CL.to_unsafe
    sl = xh * (asinh_at(cl, 0) + xh * (asinh_at(cl, 1) + xh * asinh_at(cl, 2)))
    sh, sl = asinh_polydd(xh, xl, 3, ASINH_REFINE_CH.to_unsafe, sl)
    sh, sl = asinh_muldd_acc(xh, xl, sh, sl)
    sh, sl = asinh_add_dd(sh, sl, el1, el2)
    sh, sl = asinh_add_dd(sh, sl, l1, l2)
    v0, v2 = asinh_fast_two_sum(l0, sh)
    v1, v2 = asinh_fast_two_sum(v2, sl)
    v0, v1 = asinh_fast_two_sum(v0, v1)
    v1, v2 = asinh_fast_two_sum(v1, v2)
    s2 = Math.copysign(2.0, x)
    v0 = v0 * s2
    v1 = asinh_nudge(v1 * s2, v2 * s2)
    t = IyiFloatText.bits_of(v1)
    t0 = IyiFloatText.bits_of(v0)
    er = (t &+ 41_u64) & ASINH_MASK52
    de = (t0.unsafe_shr(52_u64) & 0x7ff_u64) &- (t.unsafe_shr(52_u64) & 0x7ff_u64)
    res = v0 + v1
    return asinh_db_search(ASINH_DB.to_unsafe, 35, asinh_fabs(x), Math.copysign(1.0, x), res) if de > 99_u64 || er < 80_u64
    res
  end

  # e_acosh.c as_acosh_one
  private def self.acosh_one(x : Float64, sh : Float64, sl : Float64) : Float64
    cl = ACOSH_ONE_CL.to_unsafe
    y2 = x * (asinh_at(cl, 0) + x * (asinh_at(cl, 1) + x * (asinh_at(cl, 2) + x * (asinh_at(cl, 3) + x * (asinh_at(cl, 4) + x * asinh_at(cl, 5))))))
    y1, y2 = asinh_polydd3(x, 0.0, 10, ACOSH_ONE_CH.to_unsafe, y2)
    y1, y2 = asinh_mulddd(y1, y2, x)
    y0, y1 = asinh_fast_two_sum(1.0, y1)
    y1 = y1 + y2
    y0, y1 = asinh_muldd_acc2(y0, y1, sh, sl)
    y0 + y1
  end

  # e_acosh.c as_acosh_refine
  private def self.acosh_refine(x : Float64, a : Float64) : Float64
    ix = IyiFloatText.bits_of(x)
    zh = x
    zl = 0.0
    if ix < 0x4190000000000000_u64
      x2h = x * x
      x2l = Math.fma(x, x, x2h * -1.0)
      wh, wl = asinh_fast_two_sum(x2h - 1.0, x2l)
      sh = Math.sqrt(wh)
      ish = 0.5 / wh
      sl = (ish * sh) * (wl - Math.fma(sh, sh, wh * -1.0))
      zh, zl = asinh_fast_two_sum(x, sh)
      zl = zl + sl
      zh, zl = asinh_fast_two_sum(zh, zl)
    elsif ix < 0x4330000000000000_u64
      zh = 2.0 * x
      zl = -0.5 / x
    end
    t = IyiFloatText.bits_of(zh)
    e = t.unsafe_shr(52_u64).unsafe_to_i32 - 0x3ff + (zl == 0.0 ? 1 : 0)
    t = (t & ASINH_MASK52) | ASINH_ONE_EXP
    ed = e.to_f64
    v = IyiFloatText.bits_of(a - ed + ASINH_REFINE_BIAS)
    i = (v &- ASINH_ONE_EXP).unsafe_shr(36_u64)
    i1 = (i.unsafe_shr(12_u64) & 0x1f_u64).unsafe_to_i32
    i2 = (i.unsafe_shr(8_u64) & 0xf_u64).unsafe_to_i32
    i3 = (i.unsafe_shr(4_u64) & 0xf_u64).unsafe_to_i32
    i4 = (i & 0xf_u64).unsafe_to_i32
    el2 = ASINH_REFINE_L22 * ed
    el1 = ASINH_REFINE_L21 * ed
    el0 = ASINH_REFINE_L20 * ed
    l0 = asinh_ll_sum(i1, i2, i3, i4, 0)
    l1 = asinh_ll_sum(i1, i2, i3, i4, 1)
    l2 = asinh_ll_sum(i1, i2, i3, i4, 2)
    l0 = l0 + el0
    t12 = asinh_at(ASINH_T1.to_unsafe, i1) * asinh_at(ASINH_T2.to_unsafe, i2)
    t34 = asinh_at(ASINH_T3.to_unsafe, i3) * asinh_at(ASINH_T4.to_unsafe, i4)
    th = t12 * t34
    tl = Math.fma(t12, t34, th * -1.0)
    tf = IyiFloatText.from_bits(t)
    dh = th * tf
    dl = Math.fma(th, tf, dh * -1.0)
    sh = tl * tf
    sl = Math.fma(tl, tf, sh * -1.0)
    xh, xl = asinh_fast_two_sum(dh - 1.0, dl)
    if zl != 0.0
      t = IyiFloatText.bits_of(zl) &- e.to_i64.unsafe_shl(52_i64).unsafe_to_u64
      xl = xl + th * IyiFloatText.from_bits(t)
    end
    xh, xl = asinh_add_dd(xh, xl, sh, sl)
    cl = ASINH_REFINE_CL.to_unsafe
    sl = xh * (asinh_at(cl, 0) + xh * (asinh_at(cl, 1) + xh * asinh_at(cl, 2)))
    sh, sl = asinh_polydd3(xh, xl, 3, ASINH_REFINE_CH.to_unsafe, sl)
    sh, sl = asinh_muldd_acc2(xh, xl, sh, sl)
    sh, sl = asinh_add_dd(sh, sl, el1, el2)
    sh, sl = asinh_add_dd(sh, sl, l1, l2)
    v0, v2 = asinh_fast_two_sum(l0, sh)
    v1, v2 = asinh_fast_two_sum(v2, sl)
    v0 = v0 * 2.0
    v1 = asinh_nudge(v1 * 2.0, v2 * 2.0)
    t = IyiFloatText.bits_of(v1)
    t0 = IyiFloatText.bits_of(v0)
    er = (t &+ 7_u64) & ASINH_MASK52
    de = (t0.unsafe_shr(52_u64) & 0x7ff_u64) &- (t.unsafe_shr(52_u64) & 0x7ff_u64)
    res = v0 + v1
    return asinh_db_search(ACOSH_DB.to_unsafe, 10, x, 1.0, res) if de > 102_u64 || er < 15_u64
    res
  end

  # e_atanh.c as_atanh_zero
  private def self.atanh_zero(x : Float64) : Float64
    x2 = x * x
    x2l = Math.fma(x, x, x2 * -1.0)
    cl = ATANH_CL.to_unsafe
    y2 = x2 * (asinh_at(cl, 0) + x2 * (asinh_at(cl, 1) + x2 * (asinh_at(cl, 2) + x2 * (asinh_at(cl, 3) + x2 * asinh_at(cl, 4)))))
    y1, y2 = asinh_polydd3(x2, x2l, 13, ATANH_CH.to_unsafe, y2)
    y1, y2 = asinh_mulddd3(y1, y2, x)
    y1, y2 = asinh_muldd_acc2(x2, x2l, y1, y2)
    y0, y1 = asinh_fast_two_sum(x, y1)
    y1, y2 = asinh_fast_two_sum(y1, y2)
    y0 + asinh_nudge(y1, y2)
  end

  # e_atanh.c as_atanh_refine
  private def self.atanh_refine(x : Float64, zh : Float64, zl : Float64, a : Float64) : Float64
    t = IyiFloatText.bits_of(zh)
    e = t.unsafe_shr(52_u64).unsafe_to_i32 - 0x3ff
    t = (t & ASINH_MASK52) | ASINH_ONE_EXP
    ed = e.to_f64
    v = IyiFloatText.bits_of(a - ed + ASINH_REFINE_BIAS)
    i = (v &- ASINH_ONE_EXP).unsafe_shr(36_u64)
    i1 = i.unsafe_shr(12_u64).unsafe_to_i32
    i2 = (i.unsafe_shr(8_u64) & 0xf_u64).unsafe_to_i32
    i3 = (i.unsafe_shr(4_u64) & 0xf_u64).unsafe_to_i32
    i4 = (i & 0xf_u64).unsafe_to_i32
    el2 = ATANH_REFINE_L22 * ed
    el1 = ATANH_L2L * ed
    el0 = ATANH_L2H * ed
    l0 = asinh_ll_sum(i1, i2, i3, i4, 0) + el0
    l1 = asinh_ll_sum(i1, i2, i3, i4, 1)
    l2 = asinh_ll_sum(i1, i2, i3, i4, 2)
    t12 = asinh_at(ASINH_T1.to_unsafe, i1) * asinh_at(ASINH_T2.to_unsafe, i2)
    t34 = asinh_at(ASINH_T3.to_unsafe, i3) * asinh_at(ASINH_T4.to_unsafe, i4)
    th = t12 * t34
    tl = Math.fma(t12, t34, th * -1.0)
    tf = IyiFloatText.from_bits(t)
    dh = th * tf
    dl = Math.fma(th, tf, dh * -1.0)
    sh = tl * tf
    sl = Math.fma(tl, tf, sh * -1.0)
    xh, xl = asinh_fast_two_sum(dh - 1.0, dl)
    t = IyiFloatText.bits_of(zl) &- e.to_i64.unsafe_shl(52_i64).unsafe_to_u64
    xl = xl + th * IyiFloatText.from_bits(t)
    xh, xl = asinh_add_dd(xh, xl, sh, sl)
    cl = ASINH_REFINE_CL.to_unsafe
    sl = xh * (asinh_at(cl, 0) + xh * (asinh_at(cl, 1) + xh * asinh_at(cl, 2)))
    sh, sl = asinh_polydd(xh, xl, 3, ASINH_REFINE_CH.to_unsafe, sl)
    sh, sl = asinh_muldd_acc(xh, xl, sh, sl)
    sh, sl = asinh_add_dd(sh, sl, el1, el2)
    sh, sl = asinh_add_dd(sh, sl, l1, l2)
    v0, v2 = asinh_fast_two_sum(l0, sh)
    v1, v2 = asinh_fast_two_sum(v2, sl)
    v1 = asinh_nudge(v1, v2)
    t = IyiFloatText.bits_of(v1)
    t0 = IyiFloatText.bits_of(v0)
    er = (t &+ 1_u64) & ASINH_MASK52
    de = (t0.unsafe_shr(52_u64) & 0x7ff_u64) &- (t.unsafe_shr(52_u64) & 0x7ff_u64)
    sgn = Math.copysign(1.0, x)
    res = v0 * sgn + v1 * sgn
    return asinh_db_search(ATANH_DB.to_unsafe, 2, asinh_fabs(x), sgn, res) if de > 104_u64 || er < 3_u64
    res
  end

  # Correctly rounded (CORE-MATH, s_asinh.c): odd, asinh(+-0) = +-0,
  # +-inf and NaN come back as x + x.
  def self.asinh(value : Float64) : Float64
    x = value
    u = IyiFloatText.bits_of(x) & 0x7fffffffffffffff_u64
    ax = IyiFloatText.from_bits(u)
    if u < 0x3fbb000000000000_u64
      # |x| < 0x1.bp-4
      if u < 0x3e57137449123ef7_u64
        return x if u == 0_u64
        return Math.fma(ASINH_TINY_SCALE, x, x)
      end
      x2h = x * x
      x2l = Math.fma(x, x, x2h * -1.0)
      x3h = x2h * x
      sl = 0.0
      if u < 0x3f93000000000000_u64
        if u < 0x3f30000000000000_u64
          c = ASINH_CL2.to_unsafe
          if u < 0x3e5a000000000000_u64
            sl = x3h * asinh_at(c, 0)
          else
            sl = x3h * (asinh_at(c, 0) + x2h * asinh_at(c, 1))
          end
        else
          c = ASINH_CL4.to_unsafe
          sl = x3h * (asinh_at(c, 0) + x2h * (asinh_at(c, 1) + x2h * (asinh_at(c, 2) + x2h * asinh_at(c, 3))))
        end
      else
        c = ASINH_CL7.to_unsafe
        c1 = asinh_at(c, 1) + x2h * asinh_at(c, 2)
        c3 = asinh_at(c, 3) + x2h * asinh_at(c, 4)
        c5 = asinh_at(c, 5) + x2h * asinh_at(c, 6)
        x4 = x2h * x2h
        sl = x3h * (asinh_at(c, 0) + x2h * (c1 + x4 * (c3 + x4 * c5)))
      end
      eps = ASINH_ZERO_EPS * x3h
      lb = x + (sl - eps)
      ub = x + (sl + eps)
      return lb if lb == ub
      return asinh_zero(x, x2h, x2l)
    end
    x2h = 0.0
    x2l = 0.0
    ah = ax
    al = 0.0
    off = 0x3ff
    if u < 0x4190000000000000_u64
      x2h = x * x
      x2l = Math.fma(x, x, x2h * -1.0)
      th = 0.0
      tl = 0.0
      if u < 0x3ff0000000000000_u64
        th, tl = asinh_fast_two_sum(1.0, x2h)
      else
        th, tl = asinh_fast_two_sum(x2h, 1.0)
      end
      tl = tl + x2l
      ah = Math.sqrt(th)
      rs = 0.5 / th
      al = (tl - Math.fma(ah, ah, th * -1.0)) * (rs * ah)
      ah, tl = asinh_fast_two_sum(ah, ax)
      al = al + tl
    elsif u < 0x4330000000000000_u64
      ah = 2.0 * ax
      al = 0.5 / ax
    else
      return x + x if u >= 0x7ff0000000000000_u64
      off = 0x3fe
    end
    t = IyiFloatText.bits_of(ah)
    e = t.unsafe_shr(52_u64).unsafe_to_i32 - off
    t = t & ASINH_MASK52
    ed = e.to_f64
    j = asinh_index(t, ASINH_B.to_unsafe)
    t = t | ASINH_ONE_EXP
    i1 = j.unsafe_shr(5_u64).unsafe_to_i32
    i2 = (j & 0x1f_u64).unsafe_to_i32
    r = asinh_at(ASINH_R1.to_unsafe, i1) * asinh_at(ASINH_R2.to_unsafe, i2)
    dx = Math.fma(r, IyiFloatText.from_bits(t), -1.0)
    dx2 = dx * dx
    c = ASINH_C.to_unsafe
    f = dx2 * ((asinh_at(c, 0) + dx * asinh_at(c, 1)) + dx2 * ((asinh_at(c, 2) + dx * asinh_at(c, 3)) + dx2 * asinh_at(c, 4)))
    l1 = ASINH_L1.to_unsafe
    l2 = ASINH_L2.to_unsafe
    lh = ASINH_L2H * ed + (asinh_at(l1, 2 * i1 + 1) + asinh_at(l2, 2 * i2 + 1))
    ll = ASINH_L2L * ed + asinh_at(l1, 2 * i1) + asinh_at(l2, 2 * i2) + al / ah + f
    ll = ll + dx
    sgn = Math.copysign(1.0, x)
    lh = lh * sgn
    ll = ll * sgn
    lb = lh + (ll - ASINH_EPS)
    ub = lh + (ll + ASINH_EPS)
    return lb if lb == ub
    return asinh_zero(x, x2h, x2l) if ax < 0.25
    asinh_refine(x, ah, al, ASINH_INV_LOG2 * asinh_fabs(lb))
  end

  def self.asinh(value : Float32) : Float32
    asinh(value.to_f64).to_f32
  end

  def self.asinh(value : T) : Float64 forall T
    asinh(value.to_f64)
  end

  # Correctly rounded (CORE-MATH, e_acosh.c): NaN below 1 (and for NaN),
  # acosh(1) = 0, acosh(inf) = inf.
  def self.acosh(value : Float64) : Float64
    x = value
    ix = IyiFloatText.bits_of(x)
    if ix >= 0x7ff0000000000000_u64
      # x < 0, NaN or +inf
      return x + x if ix == 0x7ff0000000000000_u64 || ix.unsafe_shl(1_u64) > 0xffe0000000000000_u64
      return (x - x) / (x - x)
    end
    if ix <= 0x3ff0000000000000_u64
      return 0.0 if ix == 0x3ff0000000000000_u64
      return (x - x) / (x - x)
    end
    g = 0.0
    off = 0x3fe
    t = ix
    if ix < 0x3ff1e83e425aee63_u64
      # 1 < x < 0x1.1e83e425aee63p+0
      z = x - 1.0
      iz = -0.25 / z
      zt = 2.0 * z
      sh = Math.sqrt(zt)
      sl = Math.fma(sh, sh, zt * -1.0) * (sh * iz)
      c = ACOSH_CL9.to_unsafe
      z2 = z * z
      z4 = z2 * z2
      p = asinh_at(c, 0) + z * (((asinh_at(c, 1) + z * asinh_at(c, 2)) + z2 * (asinh_at(c, 3) + z * asinh_at(c, 4))) + z4 * ((asinh_at(c, 5) + z * asinh_at(c, 6)) + z2 * (asinh_at(c, 7) + z * asinh_at(c, 8))))
      ds = Math.fma(sh * z, p, sl)
      eps = ds * ACOSH_ONE_EPS - ACOSH_ONE_EPS_ABS * sh
      lb = sh + (ds - eps)
      ub = sh + (ds + eps)
      return lb if lb == ub
      return acosh_one(z, sh, sl)
    elsif ix < 0x405bf00000000000_u64
      off = 0x3ff
      x2h = x * x
      wh = x2h - 1.0
      wl = Math.fma(x, x, x2h * -1.0)
      sh = Math.sqrt(wh)
      ish = 0.5 / wh
      sl = (wl - Math.fma(sh, sh, wh * -1.0)) * (sh * ish)
      th, tl = asinh_fast_two_sum(x, sh)
      tl = tl + sl
      t = IyiFloatText.bits_of(th)
      g = tl / th
    elsif ix < 0x4087100000000000_u64
      c = ACOSH_CL4.to_unsafe
      z = 1.0 / (x * x)
      g = asinh_at(c, 0) + z * (asinh_at(c, 1) + z * (asinh_at(c, 2) + z * asinh_at(c, 3)))
    elsif ix < 0x40e0100000000000_u64
      c = ACOSH_CL3.to_unsafe
      z = 1.0 / (x * x)
      g = asinh_at(c, 0) + z * (asinh_at(c, 1) + z * asinh_at(c, 2))
    elsif ix < 0x41ea000000000000_u64
      c = ACOSH_CL2.to_unsafe
      z = 1.0 / (x * x)
      g = asinh_at(c, 0) + z * asinh_at(c, 1)
    end
    e = t.unsafe_shr(52_u64).unsafe_to_i32 - off
    t = t & ASINH_MASK52
    ed = e.to_f64
    j = asinh_index(t, ASINH_B.to_unsafe)
    t = t | ASINH_ONE_EXP
    i1 = j.unsafe_shr(5_u64).unsafe_to_i32
    i2 = (j & 0x1f_u64).unsafe_to_i32
    r = asinh_at(ASINH_R1.to_unsafe, i1) * asinh_at(ASINH_R2.to_unsafe, i2)
    dx = Math.fma(r, IyiFloatText.from_bits(t), -1.0)
    dx2 = dx * dx
    c = ASINH_C.to_unsafe
    f = dx2 * ((asinh_at(c, 0) + dx * asinh_at(c, 1)) + dx2 * ((asinh_at(c, 2) + dx * asinh_at(c, 3)) + dx2 * asinh_at(c, 4)))
    l1 = ASINH_L1.to_unsafe
    l2 = ASINH_L2.to_unsafe
    lh = (asinh_at(l1, 2 * i1 + 1) + asinh_at(l2, 2 * i2 + 1)) + ASINH_L2H * ed
    ll = dx + ASINH_L2L * ed
    ll = ll + g
    ll = ll + (asinh_at(l1, 2 * i1) + asinh_at(l2, 2 * i2))
    ll = ll + f
    lb = lh + (ll - ACOSH_EPS)
    ub = lh + (ll + ACOSH_EPS)
    return lb if lb == ub
    acosh_refine(x, ASINH_INV_LOG2 * lb)
  end

  def self.acosh(value : Float32) : Float32
    acosh(value.to_f64).to_f32
  end

  def self.acosh(value : T) : Float64 forall T
    acosh(value.to_f64)
  end

  # Correctly rounded (CORE-MATH, e_atanh.c): odd, atanh(+-1) = +-inf, NaN
  # beyond 1 in magnitude (and for NaN).
  def self.atanh(value : Float64) : Float64
    x = value
    aix = IyiFloatText.bits_of(x) & 0x7fffffffffffffff_u64
    ax = IyiFloatText.from_bits(aix)
    if aix >= 0x3ff0000000000000_u64
      return (x < 0.0 ? -1.0 : 1.0) / 0.0 if aix == 0x3ff0000000000000_u64
      return x + x if aix > 0x7ff0000000000000_u64
      return (x - x) / (x - x)
    end
    if aix < 0x3fd0000000000000_u64
      # |x| < 0x1p-2
      return Math.fma(x, ATANH_TINY_SCALE, x) if aix < 0x3e4d12ed0af1a27f_u64
      x2 = x * x
      c = ATANH_C9.to_unsafe
      dx2 = Math.fma(x, x, x2 * -1.0)
      x4 = x2 * x2
      x3 = x2 * x
      x8 = x4 * x4
      dx3 = Math.fma(x2, x, x3 * -1.0) + dx2 * x
      p = (asinh_at(c, 0) + x2 * asinh_at(c, 1)) + x4 * (asinh_at(c, 2) + x2 * asinh_at(c, 3)) + x8 * ((asinh_at(c, 4) + x2 * asinh_at(c, 5)) + x4 * (asinh_at(c, 6) + x2 * asinh_at(c, 7)) + x8 * asinh_at(c, 8))
      t = Math.fma(x2, p, ATANH_THIRD_LO)
      ph, pl = asinh_fast_two_sum(ATANH_THIRD, t)
      ph, pl = asinh_muldd_acc(ph, pl, x3, dx3)
      ph, tl = asinh_fast_two_sum(x, ph)
      pl = pl + tl
      eps = x * (x4 * ATANH_ZERO_EPS + ATANH_ZERO_EPS_ABS)
      lb = ph + (pl - eps)
      ub = ph + (pl + eps)
      return lb if lb == ub
      return atanh_zero(x)
    end
    ph, pl = asinh_fast_two_sum(1.0, ax)
    qh, ql = asinh_fast_two_sub(1.0, ax)
    iqh = 1.0 / qh
    th = ph * iqh
    tl = Math.fma(ph, iqh, th * -1.0) + (pl + ph * (Math.fma(qh * -1.0, iqh, 1.0) - ql * iqh)) * iqh
    c = ATANH_C5.to_unsafe
    t = IyiFloatText.bits_of(th)
    e = t.unsafe_shr(52_u64).unsafe_to_i32 - 0x3ff
    t = t & ASINH_MASK52
    ed = e.to_f64
    j = asinh_index(t, ATANH_B.to_unsafe)
    t = t | ASINH_ONE_EXP
    i1 = j.unsafe_shr(5_u64).unsafe_to_i32
    i2 = (j & 0x1f_u64).unsafe_to_i32
    tf = IyiFloatText.from_bits(t)
    r = (0.5 * asinh_at(ATANH_R1.to_unsafe, i1)) * asinh_at(ATANH_R2.to_unsafe, i2)
    dx = Math.fma(r, tf, -0.5)
    dx2 = dx * dx
    rx = r * tf
    dxl = Math.fma(r, tf, rx * -1.0)
    f = dx2 * ((asinh_at(c, 0) + dx * asinh_at(c, 1)) + dx2 * (asinh_at(c, 2) + dx * asinh_at(c, 3) + dx2 * asinh_at(c, 4)))
    l1 = ATANH_L1.to_unsafe
    l2 = ATANH_L2.to_unsafe
    lh = (asinh_at(l1, 2 * i1 + 1) + asinh_at(l2, 2 * i2 + 1)) + ATANH_L2H * ed
    lh, ll = asinh_fast_two_sum(lh, rx - 0.5)
    ll = ll + (ATANH_L2L * ed + (asinh_at(l1, 2 * i1) + asinh_at(l2, 2 * i2)) + dxl + 0.5 * tl / th)
    ll = ll + f
    sgn = Math.copysign(1.0, x)
    lh = lh * sgn
    ll = ll * sgn
    eps = ATANH_EPS + dx2 * ATANH_EPS_DX2
    lb = lh + (ll - eps)
    ub = lh + (ll + eps)
    return lb if lb == ub
    th, tl = asinh_fast_two_sum(th, tl)
    atanh_refine(x, th, tl, ATANH_INV_LOG2 * asinh_fabs(lh + ll))
  end

  def self.atanh(value : Float32) : Float32
    atanh(value.to_f64).to_f32
  end

  def self.atanh(value : T) : Float64 forall T
    atanh(value.to_f64)
  end

  # sqrt(x^2 + y^2) scaled by the larger magnitude, so that neither square
  # overflows or underflows on its own.
  def self.hypot(x : Float64, y : Float64) : Float64
    a = x.abs
    b = y.abs
    return 1.0 / 0.0 if a == 2.0 * a && a > 0.0 || b == 2.0 * b && b > 0.0
    return 0.0 / 0.0 if a != a || b != b
    if b > a
      t = a
      a = b
      b = t
    end
    return a if b == 0.0
    r = b / a
    a * sqrt(1.0 + r * r)
  end

  def self.hypot(x : Float32, y : Float32) : Float32
    hypot(x.to_f64, y.to_f64).to_f32
  end

  def self.hypot(x : T, y : U) : Float64 forall T, U
    hypot(x.to_f64, y.to_f64)
  end

  private EXP_MASK  = 0x7FF0000000000000_u64
  private REST_MASK = 0x800FFFFFFFFFFFFF_u64
  private TWO_54    =    18014398509481984.0

  # value * 2^exponent, with one rounding: the exponent field is rewritten
  # outright, and a result that lands among the subnormals is scaled down
  # from a normal one in a single step.
  def self.ldexp(value : Float64, exponent : Int32) : Float64
    return value if value == 0.0 || exponent == 0 || value != value || value == 2.0 * value
    m, e = frexp(value)
    step = exponent > 2200 ? 2200 : (exponent < -2200 ? -2200 : exponent)
    e = e + step
    return copysign(1.0 / 0.0, value) if e > 1024
    return copysign(0.0, value) if e < -1075
    rest = IyiFloatText.bits_of(m) & REST_MASK
    if e >= -1021
      IyiFloatText.from_bits(rest | (e + 1022).to_i64.to_u64.unsafe_shl(52_u64))
    else
      IyiFloatText.from_bits(rest | (e + 1076).to_i64.to_u64.unsafe_shl(52_u64)) / TWO_54
    end
  end

  # value as m * 2^e with m in [0.5, 1) (or 0, NaN or an infinity as it
  # came, with 0), read from the bits: a subnormal is first scaled up by
  # 2^54 so that it has an exponent field of its own.
  def self.frexp(value : Float64) : {Float64, Int32}
    return {value, 0} if value == 0.0 || value != value || value == 2.0 * value
    bits = IyiFloatText.bits_of(value)
    adjust = 0
    if (bits & EXP_MASK) == 0_u64
      bits = IyiFloatText.bits_of(value * TWO_54)
      adjust = -54
    end
    biased = (bits & EXP_MASK).unsafe_shr(52_u64).to_i64.to_i32
    m = IyiFloatText.from_bits((bits & REST_MASK) | 0x3FE0000000000000_u64)
    {m, biased - 1022 + adjust}
  end

