; iyi-ir 1
source_filename = "invariant_arith"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @invariant_arith(i1 %run, i32 %a, i32 %b, ptr %out) {
entry:
  %scale = mul i32 %a, %b
  %bias = add i32 %scale, 7
  br label %head
head:
  %iv = phi i32 [ 0, label %entry ], [ %next, label %body ]
  br i1 %run, label %body, label %done
body:
  %mixed = add i32 %iv, %bias
  store i32 %mixed, ptr %out, align 4
  %next = add i32 %iv, 1
  br label %head
done:
  ret i32 %iv
}
