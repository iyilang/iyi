# Exercises `std/compress`.
#
# Run via:
#     ./bin/iyi run bench/std_compress_exercise.iyi
#     ./bin/iyi run bench/std_compress_exercise.iyi <fixtures>
#
# With a directory, the streams zlib wrote there (every level, every
# envelope) are read back and compared, whole and through `Inflater` a
# piece at a time, Python's own gzip and zlib streams are read through
# tiny reads, and this module's streams - `Deflate` and `Deflater` - are
# written beside them for zlib to read; `bench/std_compress_exercise.sh`
# is the other half of that conversation.

module bench/std_compress_exercise

import std/compress::{Deflate, Zlib, Gzip, Inflater, Deflater, Envelope, CompressError}
import std/digest::{CRC32}
import std/random::{Random}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

# A source that gives *stream* *piece* bytes at a time and counts what it
# has been asked for, so a check can say how far the decoder pulled.
class Feed
  getter calls : Int32
  getter at : Int32

  def initialize(@stream : String, @piece : Int32)
    @at = 0
    @calls = 0
  end

  def next : String?
    @calls = @calls + 1
    return nil if @at >= @stream.bytesize
    n = @piece
    n = @stream.bytesize - @at if n > @stream.bytesize - @at
    src = @stream.to_unsafe + @at.to_i64
    @at = @at + n
    String.new(n) { |dst| dst.copy_from(src, n) }
  end
end

# Every byte an Inflater gives, *max* at most a read, or the error it
# answers instead.
def drain(z : Inflater, max : Int32) : String | CompressError
  all = String::Builder.new
  while true
    piece = z.read(max)
    case piece
    when CompressError
      return piece
    else
      assert_true piece.bytesize <= max, "a read of #{max} answered #{piece.bytesize} bytes"
      break if piece.bytesize == 0
      all << piece
    end
  end
  assert_true z.finished?, "an Inflater that answered \"\" is finished"
  all.to_s
end

def stream_through(envelope : Envelope, stream : String, piece : Int32, max : Int32) : String | CompressError
  feed = Feed.new(stream, piece)
  z = Inflater.new(envelope) { feed.next }
  drain(z, max)
end

# The bytes, where the stream must read.
def streamed(envelope : Envelope, stream : String, piece : Int32, max : Int32, label : String) : String
  got = stream_through(envelope, stream, piece, max)
  case got
  when CompressError
    raise "ASSERTION FAILED: #{label}, #{piece} bytes a piece and #{max} a read: refused with #{got.message.inspect}"
  else
    got
  end
end

# The error, where the stream must not read; its sentence must say *phrase*.
def refused(envelope : Envelope, stream : String, piece : Int32, phrase : String, label : String) : CompressError
  got = stream_through(envelope, stream, piece, 65536)
  case got
  when CompressError
    assert_true got.message.includes?(phrase), "#{label}: refused with #{got.message.inspect}, which does not say #{phrase.inspect}"
    got
  else
    raise "ASSERTION FAILED: #{label}: read #{got.bytesize} bytes instead of refusing"
  end
end

# The stream fed one byte, seven bytes and all at once, each read back
# the same.
def every_feed(envelope : Envelope, stream : String, plain : String, label : String) : Nil
  whole = stream.bytesize > 0 ? stream.bytesize : 1
  {1, 7, whole}.each do |piece|
    assert_true streamed(envelope, stream, piece, 65536, label) == plain, "#{label}, #{piece} bytes a piece"
  end
end

def piece_of(s : String, from : Int32, n : Int32) : String
  src = s.to_unsafe + from.to_i64
  String.new(n) { |dst| dst.copy_from(src, n) }
end

def bytes(values : Array(Int32)) : String
  String.new(values.size) do |dst|
    i = 0
    while i < values.size
      dst[i] = values[i].to_u8
      i = i + 1
    end
  end
end

def run_of(byte : Int32, n : Int32) : String
  String.new(n) do |dst|
    i = 0
    while i < n
      dst[i] = byte.to_u8
      i = i + 1
    end
  end
end

def random_bytes(n : Int32, seed : UInt64) : String
  rng = Random.new(seed)
  String.new(n) do |dst|
    i = 0
    while i < n
      dst[i] = (rng.next_u & 0xff_u32).to_u8
      i = i + 1
    end
  end
end

def every_byte(times : Int32) : String
  String.new(256 * times) do |dst|
    i = 0
    while i < 256 * times
      dst[i] = (i & 0xff).to_u8
      i = i + 1
    end
  end
end

# Records the shape of an API's answers: keys repeated in every record,
# numbers and tags that vary.
def json_records(n : Int32, seed : UInt64) : String
  rng = Random.new(seed)
  tags = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta"]
  b = String::Builder.new
  b << "[\n"
  i = 0
  while i < n
    score = (rng.next_u % 1000_u32).to_i32
    b << "  {\"id\": #{i}, \"name\": \"user#{i}\", \"email\": \"user#{i}@example.com\", \"score\": #{score}, "
    b << "\"tags\": [\"#{tags[score % 6]}\", \"#{tags[(score // 6) % 6]}\"], \"active\": #{score % 3 == 0}}"
    b << (i + 1 < n ? ",\n" : "\n")
    i = i + 1
  end
  b << "]\n"
  b.to_s
end

# A stream's bits, least significant first, read the way RFC 1951 writes
# them and nothing else: the exercise's own reader of block headers, so
# what it says about a header does not come from the module it checks.
class Bits
  def initialize(@s : String)
    @pos = 0
  end

  def take(n : Int32) : Int32
    v = 0
    i = 0
    while i < n
      byte = @s.to_unsafe[@pos >> 3].to_i32
      v = v | (((byte >> (@pos & 7)) & 1) << i)
      @pos = @pos + 1
      i = i + 1
    end
    v
  end

  # One symbol of the canonical code with lengths *lens*, a bit at a time.
  def decode(lens : Array(Int32)) : Int32
    code = 0
    first = 0
    len = 1
    while len <= 15
      code = code | take(1)
      count = 0
      lens.each { |l| count = count + 1 if l == len }
      if code - first < count
        k = code - first
        sym = 0
        while sym < lens.size
          if lens[sym] == len
            return sym if k == 0
            k = k - 1
          end
          sym = sym + 1
        end
      end
      first = (first + count) << 1
      code = code << 1
      len = len + 1
    end
    raise "ASSERTION FAILED: a code not in its table"
  end
end

# The literal/length and the distance code lengths a dynamic block at the
# start of *stream* declares (RFC 1951 §3.2.7); nil if it is not one.
def declared_lengths(stream : String) : {Array(Int32), Array(Int32)}?
  b = Bits.new(stream)
  b.take(1)
  return nil unless b.take(2) == 2
  hlit = b.take(5) + 257
  hdist = b.take(5) + 1
  hclen = b.take(4) + 4
  order = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
  cl = Array.new(19, 0)
  i = 0
  while i < hclen
    cl[order[i]] = b.take(3)
    i = i + 1
  end
  lengths = [] of Int32
  while lengths.size < hlit + hdist
    sym = b.decode(cl)
    if sym < 16
      lengths << sym
    else
      value = sym == 16 ? lengths[lengths.size - 1] : 0
      times = sym == 16 ? 3 + b.take(2) : (sym == 17 ? 3 + b.take(3) : 11 + b.take(7))
      times.times { lengths << value }
    end
  end
  {lengths[0, hlit], lengths[hlit, hdist]}
end

# Whether lengths make a complete prefix code: their 2^-length sum to one.
def complete?(lens : Array(Int32)) : Bool
  sum = 0
  lens.each { |l| sum = sum + (1 << (15 - l)) if l > 0 }
  sum == 1 << 15
end

# Two pieces for a `Deflater`: 24,000 bytes of noise, then copies of
# pieces of it whose lengths are one per length code, 3 to 31, as many of
# each as the Fibonacci numbers 1 to 1,597, the most of the shortest. The
# second piece is a block of matches alone, so its literal/length counts
# are those numbers and the end-of-block's 1: an optimal Huffman code for
# them is 16 bits deep, one past what DEFLATE allows. Each copy starts
# one byte or more past where the last one's source ended, and never on a
# byte that equals the one after that source, so no match runs on into
# the next copy and the counts come out exact.
def fibonacci_pieces : {String, String}
  rng = Random.new(77_u64)
  noise = random_bytes(24000, 77_u64)
  fibs = [1, 1]
  while fibs.size < 17
    fibs << fibs[fibs.size - 1] + fibs[fibs.size - 2]
  end
  lengths = [3, 4, 5, 6, 7, 8, 9, 10, 11, 13, 15, 17, 19, 23, 27, 31]
  lens = [] of Int32
  k = 0
  while k < 16
    fibs[16 - k].times { lens << lengths[k] }
    k = k + 1
  end
  i = lens.size - 1
  while i > 0
    j = (rng.next_u % (i + 1).to_u32).to_i32
    t = lens[i]
    lens[i] = lens[j]
    lens[j] = t
    i = i - 1
  end
  copies = String::Builder.new
  at = 0
  lens.each do |l|
    copies << piece_of(noise, at, l)
    stop = at + l
    at = stop + 1
    while noise.to_unsafe[at] == noise.to_unsafe[stop]
      at = at + 1
    end
  end
  {noise, copies.to_s}
end

def round_trip(label : String, data : String) : Nil
  raw = Deflate.compress(data)
  assert_true Deflate.decompress(raw) == data, "#{label}: raw round trip"
  z = Zlib.compress(data)
  assert_true Zlib.decompress(z) == data, "#{label}: zlib round trip"
  g = Gzip.compress(data)
  assert_true Gzip.decompress(g) == data, "#{label}: gzip round trip"
  assert_true z.bytesize == raw.bytesize + 6 && g.bytesize == raw.bytesize + 18, "#{label}: the envelopes cost 6 and 18 bytes"
  puts "  #{label}: #{data.bytesize} -> #{raw.bytesize} bytes, back the same three ways"
end

puts "== round trips"
round_trip "nothing", ""
round_trip "one byte", "x"
round_trip "a sentence", "the quick brown fox jumps over the lazy dog"
text = ""
i = 0
while i < 400
  text = text + "line #{i}: the quick brown fox jumps over the lazy dog #{i % 7}\n"
  i = i + 1
end
round_trip "repetitive text", text
round_trip "a run of one byte", run_of(97, 100000)
round_trip "every byte value", every_byte(40)
random = random_bytes(70000, 7_u64)
round_trip "random bytes", random
far = random_bytes(3000, 3_u64)
round_trip "a repeat from 40 KiB back", far + random_bytes(40000, 9_u64) + far
round_trip "a repeat from 20 KiB back", far + random_bytes(20000, 11_u64) + far

puts "\n== what the match finder finds"
run = Deflate.compress(run_of(97, 100000))
assert_true run.bytesize < 400, "a 100,000-byte run is 388 matches of 258, under 400 bytes (#{run.bytesize})"
rep = Deflate.compress(text)
assert_true rep.bytesize * 4 < text.bytesize, "repetitive text compresses at least 4x (#{text.bytesize} -> #{rep.bytesize})"
middle = random_bytes(20000, 11_u64)
alone = Deflate.compress(far + middle).bytesize
near = Deflate.compress(far + middle + far).bytesize
assert_true near < alone + 100, "a 3,000-byte repeat from 20 KiB back is twelve back-references, under 100 bytes (#{near - alone})"
beyond = Deflate.compress(far + random_bytes(40000, 9_u64) + far).bytesize
alone = Deflate.compress(far + random_bytes(40000, 9_u64)).bytesize
assert_true beyond >= alone + 3000, "the same repeat from 40 KiB back is outside the window and costs its bytes, stored (#{beyond - alone})"
noise = Deflate.compress(random)
assert_true noise.bytesize <= 70000 + 5 * 5, "random bytes are stored, five bytes of header for each of five blocks at most (#{noise.bytesize})"
puts "  a run, repetition, a 20 KiB back-reference, a 40 KiB one, and noise each cost what they should"

puts "\n== levels"
# Every level, 0 to 9, in every envelope, read back; the envelope's
# header says the level as zlib says it (FLEVEL in zlib's FLG, XFL in
# gzip's header); level 0 is stored blocks and nothing else.
json = json_records(800, 31_u64)
level_corpora = [{"nothing", ""}, {"one byte", "x"}, {"a sentence", "the quick brown fox jumps over the lazy dog"},
                 {"repetitive text", text}, {"a run of one byte", run_of(97, 100000)}, {"every byte value", every_byte(40)},
                 {"random bytes", random}, {"json", json}, {"a repeat from 20 KiB back", far + random_bytes(20000, 11_u64) + far}]
flg = [0x01, 0x01, 0x5e, 0x5e, 0x5e, 0x5e, 0x9c, 0xda, 0xda, 0xda]
xfl = [4, 4, 0, 0, 0, 0, 0, 0, 0, 2]
level_corpora.each do |pair|
  data = pair[1]
  sizes = [] of Int32
  10.times do |level|
    raw = Deflate.compress(data, level)
    assert_true Deflate.decompress(raw) == data, "#{pair[0]} at level #{level}, raw"
    z = Zlib.compress(data, level)
    assert_true Zlib.decompress(z) == data && z.bytesize == raw.bytesize + 6, "#{pair[0]} at level #{level}, zlib"
    assert_true z.to_unsafe[1] == flg[level].to_u8, "zlib's FLG at level #{level} is #{flg[level]}"
    g = Gzip.compress(data, level)
    assert_true Gzip.decompress(g) == data && g.bytesize == raw.bytesize + 18, "#{pair[0]} at level #{level}, gzip"
    assert_true g.to_unsafe[8] == xfl[level].to_u8, "gzip's XFL at level #{level} is #{xfl[level]}"
    sizes << raw.bytesize
  end
  blocks = data.bytesize == 0 ? 1 : (data.bytesize + 65534) // 65535
  assert_true sizes[0] == data.bytesize + 5 * blocks, "#{pair[0]} at level 0 is #{blocks} stored blocks (#{sizes[0]} bytes)"
  puts "  #{pair[0]}: #{data.bytesize} bytes, levels 0 to 9: #{sizes.join(" ")}"
end
# The sizes are the parse's fingerprint: a change to the match finder or
# to the block choice moves them, and a deliberate one re-pins them here
# after the zlib ratios in the .sh have been held.
pins = [{"repetitive text", text}, {"json", json}]
pinned = [[22295, 1543, 1547, 1579, 1539, 1548, 1547, 1547, 1178, 1181], [99332, 13506, 12632, 11564, 11591, 10736, 10518, 10232, 9934, 9930]]
pins.each_with_index do |pair, k|
  got = (0..9).map { |level| Deflate.compress(pair[1], level).bytesize }
  assert_true got == pinned[k], "#{pair[0]} at levels 0 to 9 is #{got.join(", ")} bytes, pinned at #{pinned[k].join(", ")}"
end
puts "  repetitive text and json, the same size at every level as when pinned"

puts "\n== block types"
# Each block is written as whichever of stored, fixed and dynamic costs
# the fewest bits: the first block's BTYPE says which was chosen.
btype = ->(s : String) { (s.to_unsafe[0].to_i32 >> 1) & 3 }
assert_true btype.call(Deflate.compress("abc")) == 1, "three letters are a fixed block: a dynamic one's header alone costs more"
assert_true btype.call(Deflate.compress(text)) == 2, "text is a dynamic block"
assert_true btype.call(Deflate.compress(random)) == 0, "noise is a stored block"
assert_true btype.call(Deflate.compress("")) == 1 && btype.call(Deflate.compress("", 0)) == 0, "nothing is an empty fixed block, or at level 0 an empty stored one"
lit = declared_lengths(Deflate.compress(text))
if lit
  assert_true complete?(lit[0]) && complete?(lit[1]), "a dynamic block's two codes are complete"
else
  raise "ASSERTION FAILED: text's first block declares no lengths"
end
puts "  three letters fixed, text dynamic with complete codes, noise stored, nothing an empty fixed block"

puts "\n== a code held to 15 bits"
# A block of matches whose length codes are counted out by the Fibonacci
# numbers wants a code 16 bits deep; DEFLATE allows 15, so the code is
# held to 15 and stays complete, and the stream reads back.
fib_noise, fib_copies = fibonacci_pieces
fd = Deflater.new(Envelope::Raw, 3)
fib_first = fd.compress(fib_noise)
fib_block = fd.compress(fib_copies)
fib_stream = fib_first + fib_block + fd.finish
assert_true streamed(Envelope::Raw, fib_stream, fib_stream.bytesize, 65536, "the Fibonacci block") == fib_noise + fib_copies, "the Fibonacci block reads back"
declared = declared_lengths(fib_block)
if declared
  most = 0
  declared[0].each { |l| most = l if l > most }
  counted = 0
  declared[0].each { |l| counted = counted + 1 if l > 0 }
  assert_true counted == 17, "the block's literal/length code is the end of block and 16 length codes (#{counted} codes)"
  assert_true most == 15, "its longest code is 15 bits (#{most})"
  assert_true complete?(declared[0]), "and the code held to 15 bits is complete"
else
  raise "ASSERTION FAILED: the Fibonacci block is not a dynamic block"
end
puts "  #{fib_copies.bytesize} bytes of copies in a #{fib_block.bytesize}-byte block whose longest code is 15 bits, complete, read back"

puts "\n== the format's own words"
assert_true Deflate.decompress(bytes([0x03, 0x00])) == "", "an empty fixed block"
assert_true Deflate.compress("") == bytes([0x03, 0x00]), "and that is what nothing compresses to"
stored = bytes([0x01, 0x05, 0x00, 0xfa, 0xff, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
assert_true Deflate.decompress(stored) == "hello", "a stored block"
two = bytes([0x00, 0x02, 0x00, 0xfd, 0xff, 0x68, 0x69, 0x01, 0x03, 0x00, 0xfc, 0xff, 0x21, 0x21, 0x21])
assert_true Deflate.decompress(two) == "hi!!!", "two stored blocks, the second final"
# A Huffman block, then stored ones: zlib's sync flush writes an empty
# stored block straight after the codes, and a decoder that looked a code
# up by more bits than it took has whole bytes in hand when the stored
# block's length is read, which is where they must come from.
mixed = bytes([0xca, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0xc8, 0xc0, 0x20, 0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x0d, 0x00, 0xf2, 0xff,
               0x77, 0x6f, 0x72, 0x6c, 0x64, 0x2c, 0x20, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64])
assert_true Deflate.decompress(mixed) == "hello hello hello hello world, stored", "a code block, an empty stored block and a stored one"
# And at every bit the code block can end on: the same shape after twelve
# lengths of text.
mixed_streams = [
  {bytes([0x4a, 0x4c, 0xca, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x31]), "abhello stored 1"},
  {bytes([0x4a, 0x4c, 0x4a, 0x4c, 0xca, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0x80, 0x90, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x32]), "ababhello hello stored 2"},
  {bytes([0x4a, 0x4c, 0x4a, 0x04, 0xc2, 0x8c, 0xd4, 0x9c, 0x9c, 0x7c, 0x05, 0x64, 0x12, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x33]), "abababhello hello hello stored 3"},
  {bytes([0x4a, 0x4c, 0x4a, 0x04, 0xc3, 0x8c, 0xd4, 0x9c, 0x9c, 0x7c, 0x05, 0x4c, 0x12, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x34]), "ababababhello hello hello hello stored 4"},
  {bytes([0x4a, 0x4c, 0x4a, 0x84, 0xc2, 0x8c, 0xd4, 0x9c, 0x9c, 0x7c, 0x05, 0x5c, 0x24, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x35]), "abababababhello hello hello hello hello stored 5"},
  {bytes([0x4a, 0x4c, 0x4a, 0x84, 0xc3, 0x8c, 0xd4, 0x9c, 0x9c, 0x7c, 0x05, 0xfc, 0x24, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x36]), "ababababababhello hello hello hello hello hello stored 6"},
  {bytes([0x4a, 0x4c, 0x4a, 0x44, 0x82, 0x19, 0xa9, 0x39, 0x39, 0xf9, 0x0a, 0xc4, 0x90, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x37]), "abababababababhello hello hello hello hello hello hello stored 7"},
  {bytes([0x4a, 0x4c, 0x4a, 0x44, 0x81, 0x19, 0xa9, 0x39, 0x39, 0xf9, 0x0a, 0xc4, 0x93, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x38]), "ababababababababhello hello hello hello hello hello hello hello stored 8"},
  {bytes([0x4a, 0x4c, 0x4a, 0x44, 0x83, 0x19, 0xa9, 0x39, 0x39, 0xf9, 0x0a, 0xa4, 0x92, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x08, 0x00, 0xf7, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x39]), "abababababababababhello hello hello hello hello hello hello hello hello stored 9"},
  {bytes([0x4a, 0x4c, 0x4a, 0xc4, 0x80, 0x19, 0xa9, 0x39, 0x39, 0xf9, 0x0a, 0xe4, 0x91, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x09, 0x00, 0xf6, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x31, 0x30]), "ababababababababababhello hello hello hello hello hello hello hello hello hello stored 10"},
  {bytes([0x4a, 0x4c, 0x4a, 0xc4, 0x02, 0x33, 0x52, 0x73, 0x72, 0xf2, 0x15, 0x28, 0x21, 0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x09, 0x00, 0xf6, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x31, 0x31]), "abababababababababababhello hello hello hello hello hello hello hello hello hello hello stored 11"},
  {bytes([0x4a, 0x4c, 0x4a, 0xc4, 0x0a, 0x33, 0x52, 0x73, 0x72, 0xf2, 0x15, 0x28, 0x27, 0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0x01, 0x09, 0x00, 0xf6, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x31, 0x32]), "ababababababababababababhello hello hello hello hello hello hello hello hello hello hello hello stored 12"},
]
mixed_streams.each do |pair|
  assert_true Deflate.decompress(pair[0]) == pair[1], "a code block, then stored ones: #{pair[1]}"
end
# A dynamic block may leave bit patterns without a code only when its one
# code is one bit long: a lone distance, a lone end-of-block. zlib reads
# both; an incomplete code of any other shape is refused (the .sh).
lone_distance = bytes([0x0d, 0xc0, 0x01, 0x04, 0x00, 0x00, 0x00, 0x80, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
                       0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x9f, 0x05])
assert_true Deflate.decompress(lone_distance) == "aaaa", "a dynamic block whose distance code is one one-bit code"
lone_end = bytes([0x05, 0xc0, 0x01, 0x04, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
                  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x00])
assert_true Deflate.decompress(lone_end) == "", "a dynamic block whose literal/length code is end-of-block alone, one bit"
assert_true Zlib.decompress(bytes([0x78, 0x9c, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01])) == "", "zlib's own empty stream"
assert_true Gzip.decompress(bytes([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xff, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])) == "", "gzip's own empty stream"
# Two members, as `gzip.compress(b"ab") + gzip.compress(b"cd")` writes
# them: a gzip file is a series of members, and it holds all of them.
two_members = bytes([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xff, 0x4b, 0x4c, 0x02, 0x00, 0x6d, 0x48, 0x83, 0x9e, 0x02, 0x00, 0x00, 0x00,
                     0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xff, 0x4b, 0x4e, 0x01, 0x00, 0xda, 0x8f, 0xd6, 0x45, 0x02, 0x00, 0x00, 0x00])
assert_true Gzip.decompress(two_members) == "abcd", "two gzip members read as one (#{Gzip.decompress(two_members).inspect})"
z = Zlib.compress("abc")
assert_true z.bytesize == 11 && z.to_unsafe[0] == 0x78_u8 && z.to_unsafe[1] == 0x9c_u8, "the zlib header is 78 9c"
assert_true z.to_unsafe[7] == 0x02_u8 && z.to_unsafe[8] == 0x4d_u8 && z.to_unsafe[9] == 0x01_u8 && z.to_unsafe[10] == 0x27_u8, "the Adler-32 of abc is 024d0127, big-endian"
g = Gzip.compress("abc")
assert_true g.bytesize == 23 && g.to_unsafe[0] == 0x1f_u8 && g.to_unsafe[1] == 0x8b_u8 && g.to_unsafe[2] == 8_u8, "the gzip header"
assert_true g.to_unsafe[15] == 0xc2_u8 && g.to_unsafe[16] == 0x41_u8 && g.to_unsafe[17] == 0x24_u8 && g.to_unsafe[18] == 0x35_u8, "the CRC-32 of abc is 352441c2, little-endian"
assert_true g.to_unsafe[19] == 3_u8 && g.to_unsafe[20] == 0_u8 && g.to_unsafe[22] == 0_u8, "the length of abc"
puts "  empty, stored, and the two envelopes byte for byte"
# A gzip file is a series of members, which is what `cat a.gz b.gz`
# makes: every member is read, zero padding after the last is taken as
# gzip takes it, and only the first member came back before.
joined = Gzip.compress("first\n") + Gzip.compress("second\n") + Gzip.compress("")
assert_true Gzip.decompress(joined) == "first\nsecond\n", "every member of a concatenated gzip file"
assert_true Gzip.decompress(Gzip.compress("first\n") + "\0\0\0\0") == "first\n", "zero padding after the last member"
puts "  a gzip file of three members, and one padded with zeros"
# And in the time its members take. Every member was sized by the file's
# last trailer, or by three times the bytes after it, so each allocated
# what the rest of the file could hold: a thousand two-byte members ahead
# of one of 8 MB took 2.6 s where that member alone took 64 ms. A bound,
# not a benchmark: six times the one member and 100 ms over.
zeros = run_of(0, 8_000_000)
one = Gzip.compress(zeros)
many = Gzip.compress("x\n") * 1000 + one
best_one = 0_i64
best_many = 0_i64
3.times do |k|
  t0 = IyiMark.now_ns
  inflated_one = Gzip.decompress(one)
  t1 = IyiMark.now_ns
  joined_many = Gzip.decompress(many)
  t2 = IyiMark.now_ns
  assert_true inflated_one == zeros && joined_many == "x\n" * 1000 + zeros, "8 MB of zeros, alone and behind a thousand members"
  best_one = (t1 - t0).to_i64 if k == 0 || (t1 - t0).to_i64 < best_one
  best_many = (t2 - t1).to_i64 if k == 0 || (t2 - t1).to_i64 < best_many
end
assert_true best_many <= best_one * 6 + 100_000_000_i64, "a thousand members and one of 8 MB took #{best_many // 1000000} ms where that one took #{best_one // 1000000} ms"
puts "  a thousand members ahead of one of 8 MB within six times that one and 100 ms"

puts "\n== streaming inflate"
# The same streams through `Inflater`, a byte at a time, seven at a time
# and whole: a piece boundary falls inside every header, code, extra-bits
# field, stored length and trailer somewhere among them.
corpora = [{"nothing", ""}, {"one byte", "x"}, {"repetitive text", text}, {"a run of one byte", run_of(97, 100000)},
           {"every byte value", every_byte(40)}, {"random bytes", random}, {"a repeat from 20 KiB back", far + random_bytes(20000, 11_u64) + far}]
corpora.each do |pair|
  every_feed(Envelope::Raw, Deflate.compress(pair[1]), pair[1], "#{pair[0]}, raw")
  every_feed(Envelope::Zlib, Zlib.compress(pair[1]), pair[1], "#{pair[0]}, zlib")
  every_feed(Envelope::Gzip, Gzip.compress(pair[1]), pair[1], "#{pair[0]}, gzip")
end
puts "  #{corpora.size} corpora in three envelopes, fed a byte, seven bytes and whole"
every_feed(Envelope::Raw, stored, "hello", "a stored block")
every_feed(Envelope::Raw, two, "hi!!!", "two stored blocks")
every_feed(Envelope::Raw, mixed, "hello hello hello hello world, stored", "a code block, an empty stored block and a stored one")
mixed_streams.each do |pair|
  every_feed(Envelope::Raw, pair[0], pair[1], "a code block, then stored ones: #{pair[1]}")
end
every_feed(Envelope::Raw, lone_distance, "aaaa", "a lone one-bit distance code")
every_feed(Envelope::Raw, lone_end, "", "a lone one-bit end-of-block code")
every_feed(Envelope::Zlib, bytes([0x78, 0x9c, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]), "", "zlib's own empty stream")
every_feed(Envelope::Gzip, bytes([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xff, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]), "", "gzip's own empty stream")
puts "  the format's own words, the same three ways"
# The window: 32 KiB of noise four times over is matches from exactly
# 32,768 back, the farthest a distance reaches, and read a few bytes at a
# time the buffer slides under them again and again, each slide followed
# by a match that reaches the oldest byte it kept.
noise = random_bytes(32768, 13_u64)
far_back = noise * 4
far_stream = Deflate.compress(far_back)
assert_true far_stream.bytesize < 32768 + 32768 // 8 + 2000, "the repeats are matches (#{far_stream.bytesize} bytes)"
assert_true streamed(Envelope::Raw, far_stream, 7, 100, "matches from 32 KiB back") == far_back, "matches from 32 KiB back, 100 bytes a read"
assert_true streamed(Envelope::Raw, far_stream, 4096, 1, "matches from 32 KiB back") == far_back, "matches from 32 KiB back, a byte a read"
assert_true streamed(Envelope::Zlib, Zlib.compress(far_back), 1, 997, "matches from 32 KiB back") == far_back, "matches from 32 KiB back, zlib"
assert_true streamed(Envelope::Gzip, Gzip.compress(far_back), 3, 65536, "matches from 32 KiB back") == far_back, "matches from 32 KiB back, gzip"
puts "  matches from 32 KiB back, across the window's slides, read a byte and 100 bytes at a time"
# A read answers as soon as it has bytes and going on would ask the
# source for more: the first bytes of a long stream come out long before
# the stream has all been fed.
long_gzip = Gzip.compress(text)
feed = Feed.new(long_gzip, 1)
early = Inflater.new(Envelope::Gzip) { feed.next }
first = early.read
case first
when CompressError
  raise "ASSERTION FAILED: the first read refused with #{first.message}"
else
  assert_true first.bytesize > 0 && feed.at < long_gzip.bytesize // 4, "the first read answered #{first.bytesize} bytes after #{feed.at} of #{long_gzip.bytesize} fed"
end
assert_true !early.finished? && early.leftover == "", "an Inflater part way is not finished and has nothing left over"
puts "  the first read answers after #{feed.at} of #{long_gzip.bytesize} bytes fed"

puts "\n== refused as a value"
# A stream that is not what it says is a `CompressError` from `read`, the
# sentence the whole-string calls panic with, and not a panic: every
# proper prefix, every byte flipped, and each check by name.
sample = "the quick brown fox jumps over the lazy dog, the lazy dog sleeps\n" * 3
[{Envelope::Raw, Deflate.compress(sample)}, {Envelope::Zlib, Zlib.compress(sample)}, {Envelope::Gzip, Gzip.compress(sample)}].each do |pair|
  envelope = pair[0]
  whole = pair[1]
  cut = 0
  while cut < whole.bytesize
    {1, cut > 0 ? cut : 1}.each do |piece|
      got = stream_through(envelope, piece_of(whole, 0, cut), piece, 65536)
      case got
      when CompressError
        said = got.message
        assert_true said.includes?(" ends ") || said.includes?(" shorter "), "#{envelope} cut at #{cut}: #{said.inspect} does not say the stream ended"
      else
        raise "ASSERTION FAILED: #{envelope} cut at #{cut} read #{got.bytesize} bytes instead of refusing"
      end
    end
    cut = cut + 1
  end
  # A raw stream has no checksum, so a flipped byte can decode to other
  # bytes; an envelope's checksum, or its decoding, refuses every one.
  unless envelope == Envelope::Raw
    from = envelope == Envelope::Zlib ? 2 : 10
    at = from
    while at < whole.bytesize
      flipped = String.new(whole.bytesize) do |dst|
        dst.copy_from(whole.to_unsafe, whole.bytesize)
        dst[at] = dst[at] ^ 0x55_u8
      end
      got = stream_through(envelope, flipped, 5, 65536)
      assert_true got.is_a?(CompressError), "#{envelope} with byte #{at} flipped read back"
      at = at + 1
    end
  end
end
puts "  every prefix of a stream in each envelope ends early, and every byte flipped in zlib and gzip is refused"
sample_gzip = Gzip.compress(sample)
bad_crc = String.new(sample_gzip.bytesize) do |dst|
  dst.copy_from(sample_gzip.to_unsafe, sample_gzip.bytesize)
  dst[sample_gzip.bytesize - 8] = dst[sample_gzip.bytesize - 8] ^ 1_u8
end
bad_len = String.new(sample_gzip.bytesize) do |dst|
  dst.copy_from(sample_gzip.to_unsafe, sample_gzip.bytesize)
  dst[sample_gzip.bytesize - 4] = dst[sample_gzip.bytesize - 4] ^ 1_u8
end
sample_zlib = Zlib.compress(sample)
bad_adler = String.new(sample_zlib.bytesize) do |dst|
  dst.copy_from(sample_zlib.to_unsafe, sample_zlib.bytesize)
  dst[sample_zlib.bytesize - 1] = dst[sample_zlib.bytesize - 1] ^ 1_u8
end
# FHCRC: the header's own CRC-16, right and wrong.
hcrc_head = bytes([0x1f, 0x8b, 8, 2, 0, 0, 0, 0, 0, 0xff])
hcrc = CRC32.checksum(hcrc_head) & 0xffff_u32
abc = Gzip.compress("abc")
abc_body = piece_of(abc, 10, abc.bytesize - 10)
good_hcrc = hcrc_head + bytes([(hcrc & 0xff_u32).to_i32, (hcrc >> 8).to_i32]) + abc_body
bad_hcrc = hcrc_head + bytes([(hcrc & 0xff_u32).to_i32 ^ 1, (hcrc >> 8).to_i32]) + abc_body
every_feed(Envelope::Gzip, good_hcrc, "abc", "a gzip header with its CRC-16")
[1, 4096].each do |piece|
  refused(Envelope::Gzip, bad_crc, piece, "gzip: the checksum does not match (", "a gzip CRC-32 one bit off")
  refused(Envelope::Gzip, bad_len, piece, "gzip: the length does not match (#{sample.bytesize}, stream says #{sample.bytesize ^ 1})", "a gzip length one bit off")
  refused(Envelope::Zlib, bad_adler, piece, "zlib: the checksum does not match (", "a zlib Adler-32 one bit off")
  refused(Envelope::Gzip, bad_hcrc, piece, "gzip: the header checksum does not match", "a gzip header CRC-16 one bit off")
  refused(Envelope::Gzip, bytes([0x1f, 0x8b, 8, 0x20, 0, 0, 0, 0, 0, 0xff, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0]), piece, "gzip: a reserved header flag is set (FLG 32)", "a reserved gzip flag")
  refused(Envelope::Gzip, bytes([0x1f, 0x8c, 8, 0, 0, 0, 0, 0, 0, 0xff, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0]), piece, "gzip: not a gzip stream", "a gzip stream that is not one")
  refused(Envelope::Gzip, bytes([0x1f, 0x8b, 8, 8, 0, 0, 0, 0, 0, 0xff, 0x61, 0x62, 0x63]), piece, "gzip: the stream ends inside its header", "a gzip name that never ends")
  refused(Envelope::Zlib, bytes([0x78, 0xbb, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]), piece, "zlib: a preset dictionary is not supported", "a zlib preset dictionary")
  refused(Envelope::Zlib, bytes([0x78, 0x9d, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]), piece, "zlib: the header check failed", "a zlib header whose check fails")
  refused(Envelope::Zlib, bytes([0x77, 0x9c, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]), piece, "zlib: not a deflate stream (method 7)", "a zlib header that is not deflate")
  refused(Envelope::Raw, bytes([0x07]), piece, "DEFLATE: block type 3 is reserved", "a reserved block type")
  refused(Envelope::Raw, bytes([0x01, 0x05, 0x00, 0x00, 0x00, 0x68]), piece, "DEFLATE: a stored block's length does not match its complement", "a stored length that is not its complement")
  refused(Envelope::Raw, bytes([0x01, 0x05, 0x00, 0xfa, 0xff, 0x68]), piece, "DEFLATE: the stream ends inside a stored block", "a stored block cut short")
  # A literal, then a match two bytes back where one has been written.
  refused(Envelope::Raw, bytes([0x4b, 0x04, 0x42, 0x00]), piece, "DEFLATE: a distance reaches before the output began", "a distance before the output")
  refused(Envelope::Raw, bytes([0x05, 0xc0, 0x01, 0x04, 0x00, 0x00, 0x00, 0x80, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
                                0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x13]),
    piece, "DEFLATE: the literal/length code is incomplete", "an incomplete literal/length code")
end
# And once refused, refused for good: the same error to every read after.
feed = Feed.new(bad_crc, 64)
broken = Inflater.new(Envelope::Gzip) { feed.next }
said = drain(broken, 65536)
again = broken.read
assert_true said.is_a?(CompressError) && again.is_a?(CompressError) && again.message == said.message, "a second read after the error answers it again"
assert_true !broken.finished? && broken.leftover == "", "a refused stream is not finished"
puts "  checksums, lengths, headers, block types, stored lengths and distances refused by name, read a byte and 4 KiB at a time"

puts "\n== gzip members and what follows"
every_feed(Envelope::Gzip, joined, "first\nsecond\n", "three gzip members")
every_feed(Envelope::Gzip, two_members, "abcd", "two gzip members")
every_feed(Envelope::Gzip, Gzip.compress("first\n") + "\0\0\0\0", "first\n", "zero padding after the last member")
# What follows the stream is the caller's: the next request on the
# connection. zlib and raw streams end where their trailer does, and the
# source is not asked for a byte past it; a gzip stream ends where no
# member follows, which takes one byte more to see.
tail = "HTTP/1.1 200 OK\r\n"
[{Envelope::Raw, Deflate.compress(text)}, {Envelope::Zlib, Zlib.compress(text)}, {Envelope::Gzip, Gzip.compress(text)},
 {Envelope::Gzip, joined}].each do |pair|
  envelope = pair[0]
  stream = pair[1]
  plain = envelope == Envelope::Gzip && stream == joined ? "first\nsecond\n" : text
  all = stream + tail
  {1, 7, 1000, all.bytesize}.each do |piece|
    feed = Feed.new(all, piece)
    z = Inflater.new(envelope) { feed.next }
    got = drain(z, 65536)
    assert_true got == plain, "#{envelope} followed by more, #{piece} bytes a piece"
    assert_true z.leftover == piece_of(all, stream.bytesize, feed.at - stream.bytesize), "#{envelope}, #{piece} bytes a piece: what is left over is what was fed past the stream (#{z.leftover.inspect})"
    if piece == 1
      past = envelope == Envelope::Gzip ? 1 : 0
      assert_true feed.at == stream.bytesize + past, "#{envelope}, a byte a piece: the source was asked for #{feed.at - stream.bytesize} bytes past the stream"
    end
  end
end
# Bytes that start like a member and are not one are left over too, fed
# a byte at a time: as far as it took to see that no member follows.
{ {"\x1f", "\x1f"}, {"\x1fx", "\x1fx"}, {"\0\0\0\0", "\0"} }.each do |pair|
  feed = Feed.new(Gzip.compress("ab") + pair[0], 1)
  z = Inflater.new(Envelope::Gzip) { feed.next }
  assert_true drain(z, 65536) == "ab" && z.leftover == pair[1], "a gzip stream followed by #{pair[0].inspect} leaves #{pair[1].inspect} over (#{z.leftover.inspect})"
end
puts "  members read as one stream, and what follows a stream is left over, the source asked for nothing more than it took to see the end"

puts "\n== deflater"

# Pieces written as they come, each a sync flush: what has been written
# decodes to every byte given so far without another byte of stream.
def read_exactly(z : Inflater, n : Int32, label : String) : String
  all = String::Builder.new
  got = 0
  while got < n
    piece = z.read(n - got)
    case piece
    when CompressError
      raise "ASSERTION FAILED: #{label}: refused with #{piece.message.inspect}"
    else
      assert_true piece.bytesize > 0, "#{label}: the stream ended after #{got} of #{n} bytes"
      all << piece
      got = got + piece.bytesize
    end
  end
  all.to_s
end

pieces = [piece_of(text, 0, 5000), "", random_bytes(5000, 21_u64), run_of(98, 70000), "x", piece_of(text, 5000, text.bytesize - 5000)]
given = pieces.join
deflated = [] of String
[Envelope::Raw, Envelope::Zlib, Envelope::Gzip].each do |envelope|
  d = Deflater.new(envelope)
  written = ""
  so_far = ""
  pieces.each do |piece|
    written = written + d.compress(piece)
    so_far = so_far + piece
    next if so_far.bytesize == 0
    feed = Feed.new(written, written.bytesize)
    z = Inflater.new(envelope) { feed.next }
    assert_true read_exactly(z, so_far.bytesize, "#{envelope} after #{so_far.bytesize} bytes") == so_far, "#{envelope}: what was written decodes to all #{so_far.bytesize} bytes given"
    assert_true feed.calls == 1, "#{envelope}: and the decoder asked for nothing more (#{feed.calls} calls)"
  end
  stream = written + d.finish
  every_feed(envelope, stream, given, "#{envelope} from a Deflater")
  whole = envelope == Envelope::Raw ? Deflate.decompress(stream) : (envelope == Envelope::Zlib ? Zlib.decompress(stream) : Gzip.decompress(stream))
  assert_true whole == given, "#{envelope} from a Deflater, read whole"
  deflated << stream
end
assert_true Deflater.new(Envelope::Raw).finish == bytes([0x03, 0x00]), "an empty raw Deflater is an empty fixed block"
assert_true Deflater.new(Envelope::Zlib).finish == bytes([0x78, 0x9c, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]), "an empty zlib Deflater is zlib's own empty stream"
assert_true Deflater.new(Envelope::Gzip).finish == Gzip.compress(""), "an empty gzip Deflater is Gzip.compress of nothing"
head_first = Deflater.new(Envelope::Gzip)
assert_true head_first.compress("").bytesize == 10 && head_first.compress("") == "", "the header comes with the first call, empty or not, and once"
puts "  #{pieces.size} pieces in three envelopes, each decodable as it was written, and the whole read back every way"

# The window is kept from piece to piece: the same 3,000 bytes of noise
# given twice are, the second time, a dozen back-references into the
# piece before, where a Deflater that forgot it would store them again.
kept = Deflater.new(Envelope::Raw)
kept_first = kept.compress(far)
kept_again = kept.compress(far)
assert_true kept_first.bytesize > 3000 && kept_again.bytesize < 60, "the same 3,000 bytes again cost #{kept_again.bytesize} bytes, the first time #{kept_first.bytesize}"
assert_true Deflate.decompress(kept_first + kept_again + kept.finish) == far + far, "and read back"
puts "  3,000 bytes of noise given twice: #{kept_first.bytesize} bytes, then #{kept_again.bytesize}"

# A source of the pieces written so far, for one Inflater that reads the
# stream as it is written; asked for more than there is, it says so.
class Pending
  getter starved : Int32

  def initialize
    @pieces = [] of String
    @starved = 0
  end

  def push(s : String) : Nil
    @pieces << s if s.bytesize > 0
  end

  def next : String?
    if @pieces.empty?
      @starved = @starved + 1
      return nil
    end
    @pieces.shift
  end
end

# Pieces of random sizes, some empty, at levels 0, 1, 6 and 9 in every
# envelope: one Inflater reads each piece's bytes from what has been
# written as soon as it is written, and never waits on the next. The
# streams and where each piece ended go to zlib too (the .sh).
mixed = piece_of(text, 0, 9000) + json + random_bytes(30000, 41_u64) + run_of(120, 20000) + every_byte(20)
in_pieces = [] of {String, String, String}
[0, 1, 6, 9].each do |level|
  [Envelope::Raw, Envelope::Zlib, Envelope::Gzip].each do |envelope|
    rng = Random.new((level * 3 + envelope.value + 1).to_u64)
    d = Deflater.new(envelope, level)
    pending = Pending.new
    z = Inflater.new(envelope) { pending.next }
    written = String::Builder.new
    index = String::Builder.new
    at = 0
    out_at = 0
    count = 0
    while at < mixed.bytesize
      n = (rng.next_u % 12001_u32).to_i32
      n = mixed.bytesize - at if n > mixed.bytesize - at
      piece = piece_of(mixed, at, n)
      bytes_out = d.compress(piece)
      written << bytes_out
      pending.push(bytes_out)
      at = at + n
      out_at = out_at + bytes_out.bytesize
      count = count + 1
      index << "#{at} #{out_at}\n"
      label = "level #{level} #{envelope}, piece #{count}"
      assert_true read_exactly(z, n, label) == piece, "#{label}: #{n} bytes read back as soon as they were written"
      assert_true pending.starved == 0, "#{label}: the reader waited on the next piece"
    end
    last = d.finish
    written << last
    pending.push(last)
    index << "#{at} #{out_at + last.bytesize}\n"
    ended = z.read
    assert_true ended == "" && z.finished?, "level #{level} #{envelope}: the stream ends, its trailer checked, after the last piece"
    in_pieces << {"#{level}.#{envelope.to_s.downcase}", written.to_s, index.to_s}
  end
end
puts "  #{mixed.bytesize} bytes in pieces of 0 to 12,000 at levels 0, 1, 6 and 9 in three envelopes, each read back as it was written"

args = Program.args
if args.size > 0
  dir = args[0]
  puts "\n== against zlib"
  names = ["text", "zeros", "bytes", "random", "far", "source"]
  levels = ["0", "1", "6", "9"]
  names.each do |name|
    plain = File.read("#{dir}/#{name}.bin")
    levels.each do |level|
      assert_true Deflate.decompress(File.read("#{dir}/#{name}.#{level}.raw")) == plain, "#{name} at level #{level}, raw"
      assert_true Zlib.decompress(File.read("#{dir}/#{name}.#{level}.zlib")) == plain, "#{name} at level #{level}, zlib"
      assert_true Gzip.decompress(File.read("#{dir}/#{name}.#{level}.gzip")) == plain, "#{name} at level #{level}, gzip"
    end
    File.write("#{dir}/#{name}.iyi.raw", Deflate.compress(plain))
    File.write("#{dir}/#{name}.iyi.zlib", Zlib.compress(plain))
    File.write("#{dir}/#{name}.iyi.gzip", Gzip.compress(plain))
    puts "  #{name}: zlib's twelve streams read back, three written for zlib"
  end
  assert_true Gzip.decompress(File.read("#{dir}/fields.gzip")) == File.read("#{dir}/text.bin"), "a gzip header with a name, a comment, an extra field and a header CRC"
  puts "  a gzip header's optional fields are walked past"

  puts "\n== streaming zlib's streams"
  names.each do |name|
    plain = File.read("#{dir}/#{name}.bin")
    levels.each do |level|
      every_feed(Envelope::Raw, File.read("#{dir}/#{name}.#{level}.raw"), plain, "#{name} at level #{level}, raw")
      every_feed(Envelope::Zlib, File.read("#{dir}/#{name}.#{level}.zlib"), plain, "#{name} at level #{level}, zlib")
      every_feed(Envelope::Gzip, File.read("#{dir}/#{name}.#{level}.gzip"), plain, "#{name} at level #{level}, gzip")
    end
    puts "  #{name}: zlib's twelve streams fed a byte, seven bytes and whole"
  end
  every_feed(Envelope::Gzip, File.read("#{dir}/fields.gzip"), File.read("#{dir}/text.bin"), "a gzip header with every field")
  puts "  and the gzip header with every optional field and its CRC-16"

  puts "\n== python's streams through tiny reads"
  # Python's gzip and zlib modules on noise and on repetition, read a
  # byte, three and seventeen bytes at a time from pieces of other sizes.
  ["py_random", "py_repeat", "py_members"].each do |name|
    plain = File.read("#{dir}/#{name}.bin")
    exts = name == "py_members" ? [{"gz", Envelope::Gzip}] : [{"gz", Envelope::Gzip}, {"zlib", Envelope::Zlib}, {"raw", Envelope::Raw}]
    exts.each do |pair|
      stream = File.read("#{dir}/#{name}.#{pair[0]}")
      { {stream.bytesize, 1}, {1, 3}, {5, 17}, {4096, 1} }.each do |shape|
        assert_true streamed(pair[1], stream, shape[0], shape[1], "#{name}.#{pair[0]}") == plain, "#{name}.#{pair[0]}, #{shape[0]} bytes a piece and #{shape[1]} a read"
      end
    end
    puts "  #{name}: #{plain.bytesize} bytes, read back byte for byte"
  end

  puts "\n== every level, for zlib to read"
  # The .sh's corpora - prose, source code, JSON, noise, repetition,
  # nothing, one byte, and 10 MB of the repository's text - at every
  # level, raw, zlib and gzip (the 10 MB in zlib's and gzip's envelopes at
  # level 6 only), for zlib to read and to size against its own; and
  # each level's time over the 10 MB.
  ["l_text", "l_source", "l_json", "l_random", "l_repeat", "l_empty", "l_one", "l_big"].each do |name|
    plain = File.read("#{dir}/#{name}.bin")
    sizes = [] of Int32
    speeds = [] of String
    10.times do |level|
      t0 = IyiMark.now_ns
      raw = Deflate.compress(plain, level)
      t1 = IyiMark.now_ns
      assert_true Deflate.decompress(raw) == plain, "#{name} at level #{level} reads back"
      File.write("#{dir}/#{name}.#{level}.iyi.raw", raw)
      if name != "l_big" || level == 6
        File.write("#{dir}/#{name}.#{level}.iyi.zlib", Zlib.compress(plain, level))
        File.write("#{dir}/#{name}.#{level}.iyi.gzip", Gzip.compress(plain, level))
      end
      sizes << raw.bytesize
      ns = (t1 - t0).to_i64
      ns = 1_i64 if ns < 1_i64
      speeds << "#{level}: #{ns // 1000000} ms, #{plain.bytesize.to_i64 * 1000_i64 // ns} MB/s"
    end
    puts "  #{name}: #{plain.bytesize} bytes, levels 0 to 9: #{sizes.join(" ")}"
    puts "  speed of iyi over #{name}'s #{plain.bytesize} bytes, level #{speeds.join("; ")}" if name == "l_big"
  end

  # What the Deflater wrote in random pieces, with where each ended, and
  # the block held to 15 bits, for zlib to read (the .sh).
  File.write("#{dir}/pieces.bin", mixed)
  in_pieces.each do |t|
    File.write("#{dir}/pieces.#{t[0]}", t[1])
    File.write("#{dir}/pieces.#{t[0]}.idx", t[2])
  end
  File.write("#{dir}/fibonacci.bin", fib_noise + fib_copies)
  File.write("#{dir}/fibonacci.raw", fib_stream)

  # What the Deflater wrote, for zlib to read (the .sh).
  File.write("#{dir}/deflater.bin", given)
  File.write("#{dir}/deflater.raw", deflated[0])
  File.write("#{dir}/deflater.zlib", deflated[1])
  File.write("#{dir}/deflater.gzip", deflated[2])
end

puts "\nALL CHECKS PASSED"
