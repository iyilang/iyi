; iyi-ir 1
source_filename = "merge_other_object_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @merge_other_object_keep(ptr %first, ptr %second, ptr %left, ptr %right) {
entry:
  %f0 = getelementptr inbounds { ptr, ptr }, ptr %first, i32 0, i32 0
  %m0 = load i8, ptr @__iyi_marking, align 1
  %p0 = icmp ne i8 %m0, 0
  br i1 %p0, label %begin0, label %plain0
begin0:
  call void () @__iyi_write_barrier_begin()
  br label %join0
plain0:
  br label %join0
join0:
  store ptr %left, ptr %f0, align 8
  br i1 %p0, label %shade0, label %after0
shade0:
  call void (ptr, i64) @__iyi_write_barrier(ptr %f0, i64 1)
  br label %after0
after0:
  %f1 = getelementptr inbounds { ptr, ptr }, ptr %second, i32 0, i32 1
  %m1 = load i8, ptr @__iyi_marking, align 1
  %p1 = icmp ne i8 %m1, 0
  br i1 %p1, label %begin1, label %plain1
begin1:
  call void () @__iyi_write_barrier_begin()
  br label %join1
plain1:
  br label %join1
join1:
  store ptr %right, ptr %f1, align 8
  br i1 %p1, label %shade1, label %done
shade1:
  call void (ptr, i64) @__iyi_write_barrier(ptr %f1, i64 1)
  br label %done
done:
  ret void
}
