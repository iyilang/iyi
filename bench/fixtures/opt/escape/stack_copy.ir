; iyi-ir 1
source_filename = "escape_stack_copy"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @copy(i64 %x) {
entry:
  %src = alloca [2 x i64], align 8
  store i64 %x, ptr %src, align 8
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr ([2 x i64], ptr null, i32 1) to i64), i64 3, i64 2)
  intrinsic llvm.memcpy.p0.p0.i64(ptr %p, ptr %src, i64 16, i1 false)
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
