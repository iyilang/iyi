lib LibC
  fun exit(status : Int32) : NoReturn
end

struct Float32
  @[Primitive(:unchecked_convert)]
  def sat_i8 : Int8
  end

  @[Primitive(:unchecked_convert)]
  def sat_i16 : Int16
  end

  @[Primitive(:unchecked_convert)]
  def sat_i32 : Int32
  end

  @[Primitive(:unchecked_convert)]
  def sat_i64 : Int64
  end

  @[Primitive(:unchecked_convert)]
  def sat_i128 : Int128
  end

  @[Primitive(:unchecked_convert)]
  def sat_u8 : UInt8
  end

  @[Primitive(:unchecked_convert)]
  def sat_u16 : UInt16
  end

  @[Primitive(:unchecked_convert)]
  def sat_u32 : UInt32
  end

  @[Primitive(:unchecked_convert)]
  def sat_u64 : UInt64
  end

  @[Primitive(:unchecked_convert)]
  def sat_u128 : UInt128
  end
end

struct Float64
  @[Primitive(:unchecked_convert)]
  def sat_i8 : Int8
  end

  @[Primitive(:unchecked_convert)]
