# Exercises `std/iterable`.
#
# Run via:
#     ./bin/iyi run bench/std_iterable_exercise.iyi

module bench/std_iterable_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_false(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" if cond
end

def assert_int(expected : Int32, actual : Int32, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
end

def assert_int_nil(actual : Int32?, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected nil\n  got      #{actual.inspect}" unless actual.nil?
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/iterator
using std/iterator::{Iterator, ArrayIterator}

import std/iterable
using std/iterable::{Iterable}

# -----------------------------------------------------------------------------
# 1. Trait implementation on custom collection types
# -----------------------------------------------------------------------------

# A minimal sequence implementing ONLY the single abstract requirement `def each`,
# answering the associated type `type Iter = ArrayIterator(T)`.
#
# All five defaults (cycle, cycle(n), each_step(n), each_step(n, offset),
# each_with_index) arrive solely from `Iterable`.
pub struct SimpleSeq(T)
  @data : Array(T)

  def initialize(@data : Array(T))
  end
end

impl Iterable for SimpleSeq(T) forall T
  type Iter = ArrayIterator(T)

  def each : ArrayIterator(T)
    Iterator.of(@data)
  end
end

# A tracking iterator that counts calls to `next`.
pub class PullCounter
  getter pulls : Int32

  def initialize(@items : Array(Int32))
    @idx = 0
    @pulls = 0
  end

  def next : Int32?
    @pulls = @pulls + 1
    if @idx < @items.size
      val = @items[@idx]
      @idx = @idx + 1
      val
    else
      nil
    end
  end
end

impl Iterator for PullCounter
  type Elem = Int32

  def next : Int32?
    @pulls = @pulls + 1
    if @idx < @items.size
      val = @items[@idx]
      @idx = @idx + 1
      val
    else
      nil
    end
  end
end

pub struct TrackedSeq
  @tracker : PullCounter

  def initialize(@tracker : PullCounter)
  end
end

impl Iterable for TrackedSeq
  type Iter = PullCounter

  def each : PullCounter
    @tracker
  end
end

# -----------------------------------------------------------------------------
# 2. Empty source
# -----------------------------------------------------------------------------
puts "== empty source"

empty = SimpleSeq(Int32).new([] of Int32)
assert_int_nil empty.each.next, "empty each.next is nil"
assert_int_nil empty.cycle.next, "empty cycle.next is nil"
assert_int 0, empty.cycle(3).to_a.size, "empty cycle(3) is empty"
assert_int 0, empty.each_step(2).to_a.size, "empty each_step(2) is empty"
assert_int 0, empty.each_step(2, offset: 1).to_a.size, "empty each_step(2, offset: 1) is empty"
assert_int 0, empty.each_with_index.to_a.size, "empty each_with_index is empty"
assert_int 0, empty.each_with_index(5).to_a.size, "empty each_with_index(5) is empty"

puts "  empty source holds across all defaults"

# -----------------------------------------------------------------------------
# 3. One-element source
# -----------------------------------------------------------------------------
puts "\n== one-element source"

single = SimpleSeq(Int32).new([42])

# each
s_iter = single.each
assert_int 42, s_iter.next || 0, "single each returns 42"
assert_int_nil s_iter.next, "single each exhausts after 1"

# cycle(n)
c3 = single.cycle(3).to_a
assert_int 3, c3.size, "single cycle(3) size"
assert_int 42, c3[0], "c3[0]"
assert_int 42, c3[1], "c3[1]"
assert_int 42, c3[2], "c3[2]"

# each_step
s_step1 = single.each_step(1).to_a
assert_int 1, s_step1.size, "single each_step(1) size"
assert_int 42, s_step1[0], "single each_step(1)[0]"

s_step2 = single.each_step(2).to_a
assert_int 1, s_step2.size, "single each_step(2) size"
assert_int 42, s_step2[0], "single each_step(2)[0]"

s_step_off = single.each_step(2, offset: 1).to_a
assert_int 0, s_step_off.size, "single each_step(2, offset: 1) size is 0"

# each_with_index
s_wi0 = single.each_with_index.to_a
assert_int 1, s_wi0.size, "single each_with_index size"
assert_int 42, s_wi0[0][0], "s_wi0[0] value"
assert_int 0, s_wi0[0][1], "s_wi0[0] index"

s_wi10 = single.each_with_index(10).to_a
assert_int 1, s_wi10.size, "single each_with_index(10) size"
assert_int 42, s_wi10[0][0], "s_wi10[0] value"
assert_int 10, s_wi10[0][1], "s_wi10[0] index"

# short-circuit on infinite cycle
assert_true single.cycle.any? { |x| x == 42 }, "single cycle.any? short-circuits"

puts "  one-element source holds across all defaults"

# -----------------------------------------------------------------------------
# 4. Multi-element source
# -----------------------------------------------------------------------------
puts "\n== multi-element source"

multi = SimpleSeq(Int32).new([10, 20, 30, 40, 50])

# cycle(n)
mc2 = multi.cycle(2).to_a
assert_int 10, mc2.size, "multi cycle(2) size"
assert_int 10, mc2[0], "mc2[0]"
assert_int 20, mc2[1], "mc2[1]"
assert_int 30, mc2[2], "mc2[2]"
assert_int 40, mc2[3], "mc2[3]"
assert_int 50, mc2[4], "mc2[4]"
assert_int 10, mc2[5], "mc2[5]"
assert_int 20, mc2[6], "mc2[6]"
assert_int 30, mc2[7], "mc2[7]"
assert_int 40, mc2[8], "mc2[8]"
assert_int 50, mc2[9], "mc2[9]"

# each_step(n)
ms2 = multi.each_step(2).to_a
assert_int 3, ms2.size, "multi each_step(2) size"
assert_int 10, ms2[0], "ms2[0]"
assert_int 30, ms2[1], "ms2[1]"
assert_int 50, ms2[2], "ms2[2]"

# each_step(n, offset: m)
ms2_off1 = multi.each_step(2, offset: 1).to_a
assert_int 2, ms2_off1.size, "multi each_step(2, offset: 1) size"
assert_int 20, ms2_off1[0], "ms2_off1[0]"
assert_int 40, ms2_off1[1], "ms2_off1[1]"

ms3_off1 = multi.each_step(3, offset: 1).to_a
assert_int 2, ms3_off1.size, "multi each_step(3, offset: 1) size"
assert_int 20, ms3_off1[0], "ms3_off1[0]"
assert_int 50, ms3_off1[1], "ms3_off1[1]"

# each_with_index
mwi = multi.each_with_index.to_a
assert_int 5, mwi.size, "multi each_with_index size"
assert_int 10, mwi[0][0], "mwi[0] val"
assert_int 0, mwi[0][1], "mwi[0] idx"
assert_int 20, mwi[1][0], "mwi[1] val"
assert_int 1, mwi[1][1], "mwi[1] idx"
assert_int 30, mwi[2][0], "mwi[2] val"
assert_int 2, mwi[2][1], "mwi[2] idx"
assert_int 40, mwi[3][0], "mwi[3] val"
assert_int 3, mwi[3][1], "mwi[3] idx"
assert_int 50, mwi[4][0], "mwi[4] val"
assert_int 4, mwi[4][1], "mwi[4] idx"

mwi100 = multi.each_with_index(100).to_a
assert_int 5, mwi100.size, "multi each_with_index(100) size"
assert_int 10, mwi100[0][0], "mwi100[0] val"
assert_int 100, mwi100[0][1], "mwi100[0] idx"
assert_int 50, mwi100[4][0], "mwi100[4] val"
assert_int 104, mwi100[4][1], "mwi100[4] idx"

puts "  multi-element source holds across all defaults"

# -----------------------------------------------------------------------------
# 5. Combinators: short-circuiting and full consumption proofs
# -----------------------------------------------------------------------------
puts "\n== combinator proofs: short-circuit and full consumption"

# Short-circuiting proof on infinite cycle:
# A source with 5 elements cycled infinitely pulls only 2 elements when searching for 20.
tracker1 = PullCounter.new([10, 20, 30, 40, 50])
tracked1 = TrackedSeq.new(tracker1)
found20 = tracked1.cycle.any? { |x| x == 20 }
assert_true found20, "found 20 in infinite cycle"
assert_int 2, tracker1.pulls, "infinite cycle short-circuits after exactly 2 pulls"

# Short-circuiting proof on each_step:
# Stepping by 2 through 7 elements to find 30 pulls 10, 20, 30 and stops before 40..70.
tracker2 = PullCounter.new([10, 20, 30, 40, 50, 60, 70])
tracked2 = TrackedSeq.new(tracker2)
found30 = tracked2.each_step(2).any? { |x| x == 30 }
assert_true found30, "each_step found 30"
assert_int 3, tracker2.pulls, "each_step.any? short-circuits after 3 pulls"

# Short-circuiting proof on each_with_index:
tracker3 = PullCounter.new([10, 20, 30, 40, 50])
tracked3 = TrackedSeq.new(tracker3)
found_idx = tracked3.each_with_index.any? { |pair| pair[1] == 1 }
assert_true found_idx, "each_with_index found index 1"
assert_int 2, tracker3.pulls, "each_with_index short-circuits after 2 pulls"

# Full consumption proof 1: cycle(2).reduce consumes every element across cycles
tracker4 = PullCounter.new([10, 20, 30, 40, 50])
tracked4 = TrackedSeq.new(tracker4)
sum_cycle2 = tracked4.cycle(2).reduce(0) { |acc, x| acc + x }
assert_int 300, sum_cycle2, "cycle(2).reduce sum is 300"
# In CycleNIterator, 5 elements are pulled to fill cache, plus 1 sentinel nil = 6 pulls.
# The second cycle reads entirely from cache with no more pulls to the underlying source.
assert_int 6, tracker4.pulls, "cycle(2) fully consumed source into cache"

# Full consumption proof 2: each_step(2).reduce consumes all elements in step sequence
tracker5 = PullCounter.new([10, 20, 30, 40, 50])
tracked5 = TrackedSeq.new(tracker5)
sum_step = tracked5.each_step(2).reduce(0) { |acc, x| acc + x }
assert_int 90, sum_step, "each_step(2).reduce sum is 10 + 30 + 50 = 90"
assert_int 6, tracker5.pulls, "each_step(2) consumes all elements to exhaustion"

# Full consumption proof 3: each_with_index.to_a consumes all elements
tracker6 = PullCounter.new([1, 2, 3])
tracked6 = TrackedSeq.new(tracker6)
arr_wi = tracked6.each_with_index.to_a
assert_int 3, arr_wi.size, "each_with_index size is 3"
assert_int 4, tracker6.pulls, "each_with_index consumes all 3 elements + nil"

puts "  short-circuiting and full-consumption proofs hold"

puts "\nALL CHECKS PASSED"
