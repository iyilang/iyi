module std/number

pub enum RoundingMode
  TiesEven
  TiesAway
  ToZero
  ToPositive
  ToNegative
end

struct ::Number
  def self.zero : self
    new(0)
  end

  def self.additive_identity : self
    zero
  end

  def self.multiplicative_identity : self
    new(1)
  end

  def + : self
    self
  end

  def abs : self
    self < 0 ? -self : self
  end

  def abs2 : self
    self * self
  end

  def sign : Int32
    self < 0 ? -1 : (self == 0 ? 0 : 1)
  end

  def zero? : ::Bool
    self == 0
  end

  def positive? : ::Bool
    self > 0
  end

  def negative? : ::Bool
    self < 0
  end

  def divmod(number)
    q = (self // number)
    r = self % number
    {q, r}
  end

  # An integer is already whole: every mode answers self. `Float64` names
  # the mode below; `round` with no arguments stays the prelude's (ties
  # away from zero).
  def round(mode : Std::Number::RoundingMode = Std::Number::RoundingMode.new(0)) : self
    self
  end
end

struct ::Float64
  def round(mode : Std::Number::RoundingMode) : Float64
    return self if self != self || abs >= 9007199254740992.0
    if mode == Std::Number::RoundingMode::ToZero
      self < 0.0 ? ceil : floor
    elsif mode == Std::Number::RoundingMode::ToPositive
      ceil
    elsif mode == Std::Number::RoundingMode::ToNegative
      floor
    elsif mode == Std::Number::RoundingMode::TiesAway
      round
    else
      f = floor
      d = self - f
      if d < 0.5
        f
      elsif d > 0.5
        f + 1.0
      else
        even = (f / 2.0).floor * 2.0
        even == f ? f : f + 1.0
      end
    end
  end
end
