module compiler/llvm/lib_llvm

{% begin %}
  {% llvm_config = env("LLVM_CONFIG") || "llvm-config" %}
  {% llvm_version = env("LLVM_VERSION") || `#{llvm_config.id} --version 2> /dev/null || true`.strip.stringify %}
  {% llvm_version = "22.1.8" if llvm_version.empty? %}
  {% llvm_targets = env("LLVM_TARGETS") || `#{llvm_config.id} --targets-built 2> /dev/null || true`.strip.stringify %}
  {% llvm_ldflags = env("LLVM_LDFLAGS") || `#{llvm_config.id} --libs --system-libs --ldflags 2> /dev/null || true`.strip.gsub(/\n/, " ").stringify %}
  {% llvm_ldflags = "-lLLVM" if llvm_ldflags.empty? %}

  @[Link("stdc++")]
  {% if llvm_ldflags && !llvm_ldflags.empty? %}
    @[Link(ldflags: {{ llvm_ldflags }})]
  {% end %}
  {% is_lt_90 = compare_versions(llvm_version, "9.0.0") < 0 %}
  {% is_lt_110 = compare_versions(llvm_version, "11.0.0") < 0 %}
  {% is_lt_120 = compare_versions(llvm_version, "12.0.0") < 0 %}
  {% is_lt_130 = compare_versions(llvm_version, "13.0.0") < 0 %}
  {% is_lt_140 = compare_versions(llvm_version, "14.0.0") < 0 %}
  {% is_lt_150 = compare_versions(llvm_version, "15.0.0") < 0 %}
  {% is_lt_160 = compare_versions(llvm_version, "16.0.0") < 0 %}
  {% is_lt_170 = compare_versions(llvm_version, "17.0.0") < 0 %}
  {% is_lt_180 = compare_versions(llvm_version, "18.0.0") < 0 %}
  {% is_lt_190 = compare_versions(llvm_version, "19.0.0") < 0 %}
  {% is_lt_200 = compare_versions(llvm_version, "20.0.0") < 0 %}
  {% is_lt_210 = compare_versions(llvm_version, "21.0.0") < 0 %}

  lib ::LibLLVM
    VERSION = {{ llvm_version.strip.gsub(/git/, "").gsub(/-?rc.*/, "") }}
    IS_LT_90  = {{ is_lt_90 }}
    IS_LT_110 = {{ is_lt_110 }}
    IS_LT_120 = {{ is_lt_120 }}
    IS_LT_130 = {{ is_lt_130 }}
    IS_LT_140 = {{ is_lt_140 }}
    IS_LT_150 = {{ is_lt_150 }}
    IS_LT_160 = {{ is_lt_160 }}
    IS_LT_170 = {{ is_lt_170 }}
    IS_LT_180 = {{ is_lt_180 }}
    IS_LT_190 = {{ is_lt_190 }}
    IS_LT_200 = {{ is_lt_200 }}
    IS_LT_210 = {{ is_lt_210 }}

    alias Bool = Int32
    alias Char = UInt8
    alias SizeT = UInt64
    alias UInt = Int32
    alias ULongLong = UInt64
    alias LongLong = Int64
    alias Double = Float64
    alias AttributeIndex = Int32


    alias ContextRef = Void*
    alias ModuleRef = Void*
    alias TypeRef = Void*
    alias ValueRef = Void*
    alias BasicBlockRef = Void*
    alias BuilderRef = Void*
    alias TargetRef = Void*
    alias TargetMachineRef = Void*
    alias TargetDataRef = Void*
    alias PassBuilderOptionsRef = Void*
    alias PassManagerRef = Void*
    alias MemoryBufferRef = Void*
    alias ErrorRef = Void*
    alias AttributeRef = Void*
    alias MetadataRef = Void*

    enum CodeGenOptLevel
      None = 0
      Less = 1
      Default = 2
      Aggressive = 3
    end

    enum CodeGenFileType
      AssemblyFile = 0
      ObjectFile = 1
    end

    enum RelocMode
      Default = 0
      Static = 1
      PIC = 2
      DynamicNoPIC = 3
      ROPI = 4
      RWPI = 5
      ROPI_RWPI = 6
    end

    enum CodeModel
      Default = 0
      JITDefault = 1
      Tiny = 2
      Small = 3
      Kernel = 4
      Medium = 5
      Large = 6
    end

    enum VerifierFailureAction
      AbortProcessAction = 0
      PrintMessageAction = 1
      ReturnStatusAction = 2
    end

    enum Linkage
      External = 0
      AvailableExternally = 1
      LinkOnceAny = 2
      LinkOnceODR = 3
      LinkOnceODRAutoHide = 4
      WeakAny = 5
      WeakODR = 6
      Appending = 7
      Internal = 8
      Private = 9
      DLLImport = 10
      DLLExport = 11
      ExternalWeak = 12
      Ghost = 13
      Common = 14
      LinkerPrivate = 15
      LinkerPrivateWeak = 16
    end

    enum CallConvention
      C = 0
      Fast = 8
      Cold = 9
    end

    enum IntPredicate
      EQ = 32
      NE = 33
      UGT = 34
      UGE = 35
      ULT = 36
      ULE = 37
      SGT = 38
      SGE = 39
      SLT = 40
      SLE = 41
    end

    enum RealPredicate
      PredicateFalse = 0
      OEQ = 1
      OGT = 2
      OGE = 3
      OLT = 4
      OLE = 5
      ONE = 6
      ORD = 7
      UNO = 8
      UEQ = 9
      UGT = 10
      UGE = 11
      ULT = 12
      ULE = 13
      UNE = 14
      PredicateTrue = 15
    end

    enum TypeKind
      Void = 0
      Half = 1
      Float = 2
      Double = 3
      X86_FP80 = 4
      FP128 = 5
      PPC_FP128 = 6
      Label = 7
      Integer = 8
      Function = 9
      Struct = 10
      Array = 11
      Pointer = 12
      Vector = 13
      Metadata = 14
      X86_MMX = 15
      Token = 16
      ScalableVector = 17
      BFloat = 18
      X86_AMX = 19
      TargetExt = 20
    end

    enum ValueKind
      Argument = 0
      BasicBlock = 1
      Function = 2
      GlobalAlias = 3
      GlobalIFunc = 4
      GlobalVariable = 5
      BlockAddress = 6
      ConstantExpr = 7
      ConstantArray = 8
      ConstantStruct = 9
      ConstantVector = 10
      UndefValue = 11
      ConstantInt = 12
      ConstantFP = 13
      ConstantPointerNull = 14
      ConstantDataArray = 15
      ConstantDataVector = 16
      Instruction = 17
    end

    enum ModuleFlagBehavior
      Error = 0
      Warning = 1
      Require = 2
      Override = 3
      Append = 4
      AppendUnique = 5
    end

    # Target initialization functions
    fun initialize_aarch64_target_info = LLVMInitializeAArch64TargetInfo
    fun initialize_aarch64_target = LLVMInitializeAArch64Target
    fun initialize_aarch64_target_mc = LLVMInitializeAArch64TargetMC
    fun initialize_aarch64_asm_printer = LLVMInitializeAArch64AsmPrinter
    fun initialize_aarch64_asm_parser = LLVMInitializeAArch64AsmParser

    fun initialize_x86_target_info = LLVMInitializeX86TargetInfo
    fun initialize_x86_target = LLVMInitializeX86Target
    fun initialize_x86_target_mc = LLVMInitializeX86TargetMC
    fun initialize_x86_asm_printer = LLVMInitializeX86AsmPrinter
    fun initialize_x86_asm_parser = LLVMInitializeX86AsmParser

    fun initialize_arm_target_info = LLVMInitializeARMTargetInfo
    fun initialize_arm_target = LLVMInitializeARMTarget
    fun initialize_arm_target_mc = LLVMInitializeARMTargetMC
    fun initialize_arm_asm_printer = LLVMInitializeARMAsmPrinter
    fun initialize_arm_asm_parser = LLVMInitializeARMAsmParser

    fun initialize_webassembly_target_info = LLVMInitializeWebAssemblyTargetInfo
    fun initialize_webassembly_target = LLVMInitializeWebAssemblyTarget
    fun initialize_webassembly_target_mc = LLVMInitializeWebAssemblyTargetMC
    fun initialize_webassembly_asm_printer = LLVMInitializeWebAssemblyAsmPrinter
    fun initialize_webassembly_asm_parser = LLVMInitializeWebAssemblyAsmParser

    fun initialize_riscv_target_info = LLVMInitializeRISCVTargetInfo
    fun initialize_riscv_target = LLVMInitializeRISCVTarget
    fun initialize_riscv_target_mc = LLVMInitializeRISCVTargetMC
    fun initialize_riscv_asm_printer = LLVMInitializeRISCVAsmPrinter
    fun initialize_riscv_asm_parser = LLVMInitializeRISCVAsmParser

    fun initialize_mips_target_info = LLVMInitializeMipsTargetInfo
    fun initialize_mips_target = LLVMInitializeMipsTarget
    fun initialize_mips_target_mc = LLVMInitializeMipsTargetMC
    fun initialize_mips_asm_printer = LLVMInitializeMipsAsmPrinter
    fun initialize_mips_asm_parser = LLVMInitializeMipsAsmParser

    fun initialize_powerpc_target_info = LLVMInitializePowerPCTargetInfo
    fun initialize_powerpc_target = LLVMInitializePowerPCTarget
    fun initialize_powerpc_target_mc = LLVMInitializePowerPCTargetMC
    fun initialize_powerpc_asm_printer = LLVMInitializePowerPCAsmPrinter
    fun initialize_powerpc_asm_parser = LLVMInitializePowerPCAsmParser

    fun initialize_bpf_target_info = LLVMInitializeBPFTargetInfo
    fun initialize_bpf_target = LLVMInitializeBPFTarget
    fun initialize_bpf_target_mc = LLVMInitializeBPFTargetMC
    fun initialize_bpf_asm_printer = LLVMInitializeBPFAsmPrinter
    fun initialize_bpf_asm_parser = LLVMInitializeBPFAsmParser

    # Version information
    fun get_version = LLVMGetVersion(major : UInt*, minor : UInt*, patch : UInt*) : Void

    # Context management
    fun create_context = LLVMContextCreate : ContextRef
    fun dispose_context = LLVMContextDispose(c : ContextRef)
    fun get_global_context = LLVMGetGlobalContext : ContextRef

    # Module management
    fun module_create_with_name_in_context = LLVMModuleCreateWithNameInContext(name : Char*, c : ContextRef) : ModuleRef
    fun dispose_module = LLVMDisposeModule(m : ModuleRef)
    fun get_module_identifier = LLVMGetModuleIdentifier(m : ModuleRef, len : SizeT*) : Char*
    fun set_module_identifier = LLVMSetModuleIdentifier(m : ModuleRef, ident : Char*, len : SizeT)
    fun set_target = LLVMSetTarget(m : ModuleRef, triple : Char*)
    fun get_target = LLVMGetTarget(m : ModuleRef) : Char*
    fun set_module_data_layout = LLVMSetModuleDataLayout(m : ModuleRef, dl : TargetDataRef)
    fun get_module_data_layout = LLVMGetDataLayoutStr(m : ModuleRef) : Char*
    fun dump_module = LLVMDumpModule(m : ModuleRef)
    fun print_module_to_string = LLVMPrintModuleToString(m : ModuleRef) : Char*
    fun print_module_to_file = LLVMPrintModuleToFile(m : ModuleRef, filename : Char*, error_message : Char**) : Bool
    fun get_module_context = LLVMGetModuleContext(m : ModuleRef) : ContextRef
    fun add_module_flag = LLVMAddModuleFlag(m : ModuleRef, behavior : ModuleFlagBehavior, key : Char*, key_len : SizeT, val : MetadataRef)

    # Functions & Globals in Module
    fun add_function = LLVMAddFunction(m : ModuleRef, name : Char*, function_ty : TypeRef) : ValueRef
    {% if is_lt_200 %}
      fun get_named_function = LLVMGetNamedFunction(m : ModuleRef, name : Char*) : ValueRef
    {% else %}
      fun get_named_function_with_length = LLVMGetNamedFunctionWithLength(m : ModuleRef, name : Char*, length : SizeT) : ValueRef
    {% end %}
    fun get_first_function = LLVMGetFirstFunction(m : ModuleRef) : ValueRef
    fun get_next_function = LLVMGetNextFunction(fn : ValueRef) : ValueRef
    fun delete_function = LLVMDeleteFunction(fn : ValueRef)

    fun add_global = LLVMAddGlobal(m : ModuleRef, ty : TypeRef, name : Char*) : ValueRef
    {% if is_lt_200 %}
      fun get_named_global = LLVMGetNamedGlobal(m : ModuleRef, name : Char*) : ValueRef
    {% else %}
      fun get_named_global_with_length = LLVMGetNamedGlobalWithLength(m : ModuleRef, name : Char*, length : SizeT) : ValueRef
    {% end %}
    fun get_first_global = LLVMGetFirstGlobal(m : ModuleRef) : ValueRef
    fun get_next_global = LLVMGetNextGlobal(global_var : ValueRef) : ValueRef
    fun get_initializer = LLVMGetInitializer(global_var : ValueRef) : ValueRef
    fun set_initializer = LLVMSetInitializer(global_var : ValueRef, constant_val : ValueRef)
    fun is_global_constant = LLVMIsGlobalConstant(global_var : ValueRef) : Bool
    fun set_global_constant = LLVMSetGlobalConstant(global_var : ValueRef, is_constant : Bool)
    fun is_thread_local = LLVMIsThreadLocal(global_var : ValueRef) : Bool
    fun set_thread_local = LLVMSetThreadLocal(global_var : ValueRef, is_thread_local : Bool)
    fun get_alignment = LLVMGetAlignment(val : ValueRef) : UInt
    fun set_alignment = LLVMSetAlignment(val : ValueRef, bytes : UInt) : Void

    # Types
    fun get_type_kind = LLVMGetTypeKind(ty : TypeRef) : TypeKind
    fun get_type_context = LLVMGetTypeContext(ty : TypeRef) : ContextRef
    fun print_type_to_string = LLVMPrintTypeToString(ty : TypeRef) : Char*

    fun void_type_in_context = LLVMVoidTypeInContext(c : ContextRef) : TypeRef
    fun int1_type_in_context = LLVMInt1TypeInContext(c : ContextRef) : TypeRef
    fun int8_type_in_context = LLVMInt8TypeInContext(c : ContextRef) : TypeRef
    fun int16_type_in_context = LLVMInt16TypeInContext(c : ContextRef) : TypeRef
    fun int32_type_in_context = LLVMInt32TypeInContext(c : ContextRef) : TypeRef
    fun int64_type_in_context = LLVMInt64TypeInContext(c : ContextRef) : TypeRef
    fun int128_type_in_context = LLVMInt128TypeInContext(c : ContextRef) : TypeRef
    fun int_type_in_context = LLVMIntTypeInContext(c : ContextRef, num_bits : UInt) : TypeRef
    fun get_int_type_width = LLVMGetIntTypeWidth(integer_ty : TypeRef) : UInt

    fun half_type_in_context = LLVMHalfTypeInContext(c : ContextRef) : TypeRef
    fun float_type_in_context = LLVMFloatTypeInContext(c : ContextRef) : TypeRef
    fun double_type_in_context = LLVMDoubleTypeInContext(c : ContextRef) : TypeRef

    fun function_type = LLVMFunctionType(return_type : TypeRef, param_types : TypeRef*, param_count : UInt, is_var_arg : Bool) : TypeRef
    fun is_function_var_arg = LLVMIsFunctionVarArg(function_ty : TypeRef) : Bool
    fun get_return_type = LLVMGetReturnType(function_ty : TypeRef) : TypeRef
    fun count_param_types = LLVMCountParamTypes(function_ty : TypeRef) : UInt
    fun get_param_types = LLVMGetParamTypes(function_ty : TypeRef, dest : TypeRef*)

    fun struct_type_in_context = LLVMStructTypeInContext(c : ContextRef, element_types : TypeRef*, element_count : UInt, packed : Bool) : TypeRef
    fun struct_create_named = LLVMStructCreateNamed(c : ContextRef, name : Char*) : TypeRef
    fun get_struct_name = LLVMGetStructName(ty : TypeRef) : Char*
    fun struct_set_body = LLVMStructSetBody(struct_ty : TypeRef, element_types : TypeRef*, element_count : UInt, packed : Bool)
    fun count_struct_element_types = LLVMCountStructElementTypes(struct_ty : TypeRef) : UInt
    fun get_struct_element_types = LLVMGetStructElementTypes(struct_ty : TypeRef, dest : TypeRef*)
    fun is_packed_struct = LLVMIsPackedStruct(struct_ty : TypeRef) : Bool

    fun array_type = LLVMArrayType(element_type : TypeRef, element_count : UInt) : TypeRef
    fun get_array_length = LLVMGetArrayLength(array_ty : TypeRef) : UInt
    fun pointer_type = LLVMPointerType(element_type : TypeRef, address_space : UInt) : TypeRef
    {% unless is_lt_150 %}
      fun pointer_type_in_context = LLVMPointerTypeInContext(c : ContextRef, address_space : UInt) : TypeRef
    {% end %}
    fun vector_type = LLVMVectorType(element_type : TypeRef, element_count : UInt) : TypeRef
    fun get_vector_size = LLVMGetVectorSize(vector_ty : TypeRef) : UInt
    fun get_element_type = LLVMGetElementType(ty : TypeRef) : TypeRef

    # Values
    fun type_of = LLVMTypeOf(val : ValueRef) : TypeRef
    fun get_value_kind = LLVMGetValueKind(val : ValueRef) : ValueKind
    fun get_value_name = LLVMGetValueName(val : ValueRef) : Char*
    fun set_value_name = LLVMSetValueName(val : ValueRef, name : Char*)
    fun dump_value = LLVMDumpValue(val : ValueRef)
    fun print_value_to_string = LLVMPrintValueToString(val : ValueRef) : Char*
    fun is_constant = LLVMIsConstant(val : ValueRef) : Bool
    fun is_undef = LLVMIsUndef(val : ValueRef) : Bool
    fun is_null = LLVMIsNull(val : ValueRef) : Bool

    fun const_null = LLVMConstNull(ty : TypeRef) : ValueRef
    fun get_undef = LLVMGetUndef(ty : TypeRef) : ValueRef
    fun const_pointer_null = LLVMConstPointerNull(ty : TypeRef) : ValueRef

    fun const_int = LLVMConstInt(int_ty : TypeRef, n : ULongLong, sign_extend : Bool) : ValueRef
    fun const_real = LLVMConstReal(real_ty : TypeRef, n : Double) : ValueRef
    fun const_int_get_zext_value = LLVMConstIntGetZExtValue(constant_val : ValueRef) : ULongLong
    fun const_int_get_sext_value = LLVMConstIntGetSExtValue(constant_val : ValueRef) : LongLong

    {% if is_lt_190 %}
      fun const_string_in_context = LLVMConstStringInContext(c : ContextRef, str : Char*, length : UInt, dont_null_terminate : Bool) : ValueRef
    {% else %}
      fun const_string_in_context2 = LLVMConstStringInContext2(c : ContextRef, str : Char*, length : SizeT, dont_null_terminate : Bool) : ValueRef
    {% end %}
    fun const_struct_in_context = LLVMConstStructInContext(c : ContextRef, constant_vals : ValueRef*, count : UInt, packed : Bool) : ValueRef
    fun const_array = LLVMConstArray(element_ty : TypeRef, constant_vals : ValueRef*, length : UInt) : ValueRef

    fun size_of = LLVMSizeOf(ty : TypeRef) : ValueRef
    fun align_of = LLVMAlignOf(ty : TypeRef) : ValueRef

    # Function properties & basic blocks
    fun count_params = LLVMCountParams(fn : ValueRef) : UInt
    fun get_params = LLVMGetParams(fn : ValueRef, params : ValueRef*)
    fun get_param = LLVMGetParam(fn : ValueRef, index : UInt) : ValueRef
    fun get_linkage = LLVMGetLinkage(val : ValueRef) : Linkage
    fun set_linkage = LLVMSetLinkage(val : ValueRef, linkage : Linkage)
    fun get_function_call_convention = LLVMGetFunctionCallConv(fn : ValueRef) : CallConvention
    fun set_function_call_convention = LLVMSetFunctionCallConv(fn : ValueRef, cc : CallConvention)
    fun set_personality_fn = LLVMSetPersonalityFn(fn : ValueRef, personality_fn : ValueRef)

    fun get_entry_basic_block = LLVMGetEntryBasicBlock(fn : ValueRef) : BasicBlockRef
    fun get_first_basic_block = LLVMGetFirstBasicBlock(fn : ValueRef) : BasicBlockRef
    fun get_next_basic_block = LLVMGetNextBasicBlock(bb : BasicBlockRef) : BasicBlockRef
    fun append_basic_block_in_context = LLVMAppendBasicBlockInContext(c : ContextRef, fn : ValueRef, name : Char*) : BasicBlockRef
    fun delete_basic_block = LLVMDeleteBasicBlock(bb : BasicBlockRef)
    fun get_basic_block_name = LLVMGetBasicBlockName(bb : BasicBlockRef) : Char*
    fun get_basic_block_parent = LLVMGetBasicBlockParent(bb : BasicBlockRef) : ValueRef
    fun get_first_instruction = LLVMGetFirstInstruction(bb : BasicBlockRef) : ValueRef
    fun get_next_instruction = LLVMGetNextInstruction(inst : ValueRef) : ValueRef

    # Builder
    fun create_builder_in_context = LLVMCreateBuilderInContext(c : ContextRef) : BuilderRef
    fun position_builder_at_end = LLVMPositionBuilderAtEnd(b : BuilderRef, bb : BasicBlockRef)
    fun position_builder_before = LLVMPositionBuilderBefore(b : BuilderRef, inst : ValueRef)
    fun get_insert_block = LLVMGetInsertBlock(b : BuilderRef) : BasicBlockRef
    fun dispose_builder = LLVMDisposeBuilder(b : BuilderRef)

    fun build_ret_void = LLVMBuildRetVoid(b : BuilderRef) : ValueRef
    fun build_ret = LLVMBuildRet(b : BuilderRef, v : ValueRef) : ValueRef
    fun build_br = LLVMBuildBr(b : BuilderRef, dest : BasicBlockRef) : ValueRef
    fun build_cond_br = LLVMBuildCondBr(b : BuilderRef, if_cond : ValueRef, then_bb : BasicBlockRef, else_bb : BasicBlockRef) : ValueRef
    fun build_switch = LLVMBuildSwitch(b : BuilderRef, v : ValueRef, else_bb : BasicBlockRef, num_cases : UInt) : ValueRef
    fun add_case = LLVMAddCase(switch_val : ValueRef, on_val : ValueRef, dest_bb : BasicBlockRef)
    fun build_unreachable = LLVMBuildUnreachable(b : BuilderRef) : ValueRef

    fun build_add = LLVMBuildAdd(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_sub = LLVMBuildSub(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_mul = LLVMBuildMul(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_sdiv = LLVMBuildSDiv(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_exact_sdiv = LLVMBuildExactSDiv(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_udiv = LLVMBuildUDiv(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_srem = LLVMBuildSRem(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_urem = LLVMBuildURem(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_fadd = LLVMBuildFAdd(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_fsub = LLVMBuildFSub(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_fmul = LLVMBuildFMul(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_fdiv = LLVMBuildFDiv(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_frem = LLVMBuildFRem(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_neg = LLVMBuildNeg(b : BuilderRef, val : ValueRef, name : Char*) : ValueRef
    fun build_fneg = LLVMBuildFNeg(b : BuilderRef, val : ValueRef, name : Char*) : ValueRef

    fun build_and = LLVMBuildAnd(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_or = LLVMBuildOr(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_xor = LLVMBuildXor(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_not = LLVMBuildNot(b : BuilderRef, val : ValueRef, name : Char*) : ValueRef
    fun build_shl = LLVMBuildShl(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_lshr = LLVMBuildLShr(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_ashr = LLVMBuildAShr(b : BuilderRef, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef

    fun build_alloca = LLVMBuildAlloca(b : BuilderRef, ty : TypeRef, name : Char*) : ValueRef
    fun build_array_alloca = LLVMBuildArrayAlloca(b : BuilderRef, ty : TypeRef, count : ValueRef, name : Char*) : ValueRef
    fun build_load2 = LLVMBuildLoad2(b : BuilderRef, ty : TypeRef, ptr : ValueRef, name : Char*) : ValueRef
    fun build_store = LLVMBuildStore(b : BuilderRef, val : ValueRef, ptr : ValueRef) : ValueRef
    fun build_gep2 = LLVMBuildGEP2(b : BuilderRef, ty : TypeRef, ptr : ValueRef, indices : ValueRef*, num_indices : UInt, name : Char*) : ValueRef
    fun build_inbounds_gep2 = LLVMBuildInBoundsGEP2(b : BuilderRef, ty : TypeRef, ptr : ValueRef, indices : ValueRef*, num_indices : UInt, name : Char*) : ValueRef
    fun build_global_string_ptr = LLVMBuildGlobalStringPtr(b : BuilderRef, str : Char*, name : Char*) : ValueRef

    fun build_trunc = LLVMBuildTrunc(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_zext = LLVMBuildZExt(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_sext = LLVMBuildSExt(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_fp2ui = LLVMBuildFPToUI(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_fp2si = LLVMBuildFPToSI(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_ui2fp = LLVMBuildUIToFP(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_si2fp = LLVMBuildSIToFP(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_fptrunc = LLVMBuildFPTrunc(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_fpext = LLVMBuildFPExt(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_ptr2int = LLVMBuildPtrToInt(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_int2ptr = LLVMBuildIntToPtr(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef
    fun build_bit_cast = LLVMBuildBitCast(b : BuilderRef, val : ValueRef, dest_ty : TypeRef, name : Char*) : ValueRef

    fun build_icmp = LLVMBuildICmp(b : BuilderRef, op : IntPredicate, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef
    fun build_fcmp = LLVMBuildFCmp(b : BuilderRef, op : RealPredicate, lhs : ValueRef, rhs : ValueRef, name : Char*) : ValueRef

    fun build_phi = LLVMBuildPhi(b : BuilderRef, ty : TypeRef, name : Char*) : ValueRef
