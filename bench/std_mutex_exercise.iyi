# Exercises `std/mutex`.
#
# Run via:
#     ./bin/iyi run bench/std_mutex_exercise.iyi

module bench/std_mutex_exercise

import std/mutex::{Mutex}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

pub struct Stop
  def initialize
  end
end

impl Error for Stop
  def message : String
    "stop"
  end
end

def now_ms : Int64
  __iyi_monotonic_ns // 1000000_i64
end

# Two workers: one task holds the lock while it computes 300 ms without
# parking, a second waits for it on the other worker, and a third parallel
# task is started meanwhile. The waiter parks on the lock's word, so its
# worker is free and the third starts at once. A waiter that held its
# worker - asleep in the kernel, as the lock's waiters once slept when
# their thread had nothing else - left the third nowhere to start until
# the release. Last in the run, since the pool's threads are there for
# good once it starts and the refusals before it count threads; and on its
# own under `-- parks`, which is how bench/std_mutex_exercise.sh runs it
# against a copy whose waiter holds its worker.
def waiter_parks : Nil
  puts "\n== a waiter parks, and its worker runs other tasks"
  IyiWorkers.count = 2
  gate = Mutex.new { [0] }
  holding = Atomic(Int64).new(0_i64)
  waiting = Atomic(Int64).new(0_i64)
  started_at = Atomic(Int64).new(0_i64)
  spawned_at = 0_i64
  group do |g|
    g.spawn_parallel do
      gate.lock do |cell|
        holding.set(1_i64)
        began = __iyi_monotonic_ns
        while __iyi_monotonic_ns - began < 300_000_000_i64
          IyiThread.spin_pause
        end
        cell[0] = 1
      end.or_panic
      0
    end
    while holding.get == 0_i64
      sleep(1)
    end
    g.spawn_parallel do
      waiting.set(1_i64)
      gate.lock { |cell| cell[0] = cell[0] + 1 }.or_panic
      0
    end
    while waiting.get == 0_i64
      sleep(1)
    end
    # Past the waiter's spin, and parked.
    sleep(20)
    spawned_at = now_ms
    g.spawn_parallel do
      started_at.set(now_ms)
      0
    end
  end
  late = started_at.get - spawned_at
  assert_true(gate.get { |cell| cell[0] }.or_panic == 2, "the holder and the waiter each wrote once")
  assert_true(late < 150, "a task started #{late} ms after it was spawned, while a Mutex waiter held one worker of two and the holder computed on the other")
  # The milliseconds stay in the assertion's sentence: the exercise's
  # output is compared between its source and artifact builds, and a
  # printed 0 against a 1 failed that comparison (job 121373299527).
  puts "  a task spawned beside a parked waiter started within 150 ms, the holder still computing"
end

if Program.args.includes?("parks")
  waiter_parks
  puts "\nALL CHECKS PASSED"
  exit(0)
end

puts "== a value behind a lock"
names = Mutex.new { [] of String }
names.lock { |list| list << "ada" }.or_panic
names.lock { |list| list << "grace" }.or_panic
assert_true(names.get { |list| list.size }.or_panic == 2, "two names went in")
assert_true(names.get { |list| list.join(",") }.or_panic == "ada,grace", "and read back in order")
count = Mutex.new { 0 }
3.times { count.update { |n| n + 1 }.or_panic }
assert_true(count.get { |n| n }.or_panic == 3, "a number replaced three times")
assert_true(!count.locked?, "free when no block runs")
inside = count.get { |n| count.locked? }.or_panic
assert_true(inside, "held while its block runs")
puts "  lock, get and update; a String answer and a number replaced"

# Twenty tasks on one thread each read, park and write fifty times. The park
# inside the block is what makes it a critical section on one thread: without
# the lock another task runs between the read and the write, and its
# increment is lost.
puts "\n== tasks that park while they hold it"
tally = Mutex.new { [0] }
group do |g|
  20.times do
    g.spawn do
      50.times do
        tally.lock do |cell|
          seen = cell[0]
          sleep(0)
          cell[0] = seen + 1
        end.or_panic
      end
      0
    end
  end
end
total = tally.get { |cell| cell[0] }.or_panic
assert_true(total == 1000, "twenty tasks parking inside the lock counted #{total} of 1000")
puts "  twenty tasks, a park inside each of a thousand increments, none lost"

# Four kernel threads and the main one, each adding to one array behind the
# lock. `Mutex(Array(Int32))` is Share although the array is not, so the
# threads' blocks may capture it.
puts "\n== threads"
shared = Mutex.new { [0, 0] }
rounds = 100000
threads = (0...4).map do |index|
  IyiThread.start do
    rounds.times do
      shared.lock do |cells|
        cells[0] = cells[0] + 1
        cells[1] = cells[1] + 2
      end.or_panic
    end
    nil
  end
end
rounds.times do
  shared.lock do |cells|
    cells[0] = cells[0] + 1
    cells[1] = cells[1] + 2
  end.or_panic
end
threads.each(&.join)
sums = shared.get { |cells| {cells[0], cells[1]} }.or_panic
assert_true(sums[0] == 5 * rounds && sums[1] == 10 * rounds, "five threads' increments came to #{sums[0]} and #{sums[1]}, not #{5 * rounds} and #{10 * rounds}")
puts "  five threads, #{5 * rounds} increments of two cells each, none lost or torn"

# The main thread waits with nothing else to run while a thread holds the
# lock for 150 ms: its task parks on the lock's word, the thread asleep in
# its poller until the release rings it.
puts "\n== a thread asleep until the release"
slow = Mutex.new { [0] }
started = Atomic(Int64).new(0_i64)
holder = IyiThread.start do
  slow.lock do |cell|
    started.set(1_i64)
    sleep(150)
    cell[0] = 7
  end.or_panic
  nil
end
while started.get == 0_i64
  sleep(1)
end
began = now_ms
got = slow.get { |cell| cell[0] }.or_panic
waited = now_ms - began
holder.join
assert_true(got == 7, "the waiter read #{got}, not what the holder wrote before it released")
assert_true(waited >= 100, "the waiter came through after #{waited} ms, before the holder's 150 ms were up")
puts "  the waiter read what the holder wrote, once it released"

# A failing sibling cancels a task waiting for the lock, and its block does
# not run; the holder's own sleep is cancelled too, and its release frees
# the lock for the next.
puts "\n== cancelled while it waits"
guarded = Mutex.new { [0] }
waiter_saw = ""
holding = Atomic(Int64).new(0_i64)
began = now_ms
group do |g|
  g.spawn do
    guarded.lock do |cell|
      holding.set(1_i64)
      sleep(5000)
      cell[0] = cell[0] + 1
    end
    0
  end
  g.spawn do
    while holding.get == 0_i64
      sleep(1)
    end
    outcome = guarded.lock { |cell| cell[0] = 100 }
    waiter_saw = outcome.is_a?(Cancelled) ? "cancelled" : "ran"
    0
  end
  g.spawn do
    sleep(50)
    Stop.new
  end
end
elapsed = now_ms - began
assert_true(waiter_saw == "cancelled", "the waiting task's lock answered #{waiter_saw.inspect}, not Cancelled")
assert_true(elapsed < 2000, "cancellation took #{elapsed} ms against a 5 s hold")
assert_true(!guarded.locked? && guarded.get { |cell| cell[0] }.or_panic == 1, "the cancelled holder released, and the waiter's block never ran")
puts "  a waiting task answered Cancelled, its block unrun, and the holder released"

# A queue a task waits on while another fills it: each `wait_for` runs its
# block once the queue has changed, and takes an item only when there is
# one, the test and the take one step.
puts "\n== waiting for the value to change"
queue = Mutex.new { [] of Int32 }
taken = [] of Int32
group do |g|
  g.spawn do
    5.times do |item|
      sleep(10)
      queue.lock { |q| q << item }.or_panic
    end
    0
  end
  5.times do
    taken << queue.wait_for { |q| q.empty? ? nil : q.shift }.or_panic
  end
end
assert_true(taken == [0, 1, 2, 3, 4], "a task waiting on another's queue took #{taken}")

# Across threads: a producer thread, and the main thread waiting with
# nothing else to run, whose task parks until a release rings its thread.
items = Mutex.new { [] of Int32 }
producer = IyiThread.start do
  1000.times do |item|
    items.lock { |q| q << item }.or_panic
    sleep(1) if item % 250 == 0
  end
  nil
end
sum = 0
1000.times { sum = sum + items.wait_for { |q| q.empty? ? nil : q.shift }.or_panic }
producer.join
assert_true(sum == 499500, "a thousand items from another thread summed to #{sum}")

late = Mutex.new { [0] }
writer = IyiThread.start do
  sleep(150)
  late.lock { |cell| cell[0] = 9 }.or_panic
  nil
end
began = now_ms
seen_late = late.wait_for { |cell| cell[0] == 0 ? nil : cell[0] }.or_panic
waited_late = now_ms - began
writer.join
assert_true(seen_late == 9 && waited_late >= 100 && waited_late < 2000, "a wait for a write 150 ms away answered #{seen_late} after #{waited_late} ms")

# A failing sibling cancels a task waiting for a change that never comes.
never = Mutex.new { [0] }
outcome_never = ""
group do |g|
  g.spawn do
    got_never = never.wait_for { |cell| cell[0] == 0 ? nil : cell[0] }
    outcome_never = got_never.is_a?(Cancelled) ? "cancelled" : "answered"
    0
  end
  g.spawn do
    sleep(30)
    Stop.new
  end
end
assert_true(outcome_never == "cancelled", "a wait nothing ends, its sibling failed: #{outcome_never}")
puts "  a queue between tasks and one between threads, a wait its thread slept through in its poller, and a cancelled one"

puts "\n== what it refuses"
said = assert_panics("already holds the lock") do
  count.lock { |n| count.lock { |m| m } }
end
assert_true(!count.locked?, "the panic released the lock it held")
assert_true(count.get { |n| n }.or_panic == 3, "and the value is as it was")
assert_panics("boom") do
  names.lock { |list| raise "boom" }
end
assert_true(!names.locked?, "a panic inside the block released the lock")
names.lock { |list| list << "linus" }.or_panic
assert_true(names.get { |list| list.size }.or_panic == 3, "and the next lock took it")
puts "  a second lock by its holder panics, and a panicking block releases"
said_alone = assert_panics("nothing is left to change the value") do
  count.wait_for { |n| n > 100 ? n : nil }
end
assert_true(!count.locked?, "the refused wait holds no lock")
puts "  a wait nothing could end panics, naming why"

waiter_parks

puts "\nALL CHECKS PASSED"
