; iyi-ir 1
source_filename = "escape_loop_read_zero"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Point = type { i64, i64 }
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @loop_read_zero() {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, label %entry ], [ %next, label %write ]
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%Point, ptr null, i32 1) to i64), i64 9, i64 0)
  %field = getelementptr %Point, ptr %p, i64 0, i32 1
  %first = icmp eq i64 %i, 0
  br i1 %first, label %write, label %read
write:
  store i64 42, ptr %field, align 8
  %next = add i64 %i, 1
  br label %loop
read:
  %value = load i64, ptr %field, align 8
  ret i64 %value
}
