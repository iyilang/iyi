; iyi-ir 1
source_filename = "bulk_removed"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @stack_copy(ptr %source) {
entry:
  %slot = alloca ptr, align 8
  br label %join
join:
  intrinsic llvm.memcpy.p0.p0.i64(ptr %slot, ptr %source, i64 8, i1 false)
  br label %done
done:
  ret void
}
define external void @heap_zero(ptr %object) {
entry:
  br label %join
join:
  intrinsic llvm.memset.p0.i64(ptr %object, i8 0, i64 16, i1 false)
  br label %done
done:
  ret void
}
