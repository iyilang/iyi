# Exercises `std/ini`: INI.parse of top-level keys and sections.
#
# Run via:
#     ./bin/iyi run bench/std_ini_exercise.iyi

module bench/std_ini_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/ini::{INI}

puts "== parse"
doc = INI.parse("k=v\n[s]\na=b\n")
assert_str "v", doc[""]["k"], "top"
assert_str "b", doc["s"]["a"], "section"
built = INI.build(doc)
assert_true built.includes?("k=v"), "build top"
assert_true built.includes?("[s]"), "build section"
puts "  parse and build"

# A byte order mark, which PowerShell 5.1 and older Notepad put at the
# front of a UTF-8 file, is not the first key's and does not break a
# section: it panicked at `[s]` and kept itself in a bare first key.
marked = INI.parse("\uFEFF[s]\r\na=b\r\n")
assert_str "b", marked["s"]["a"], "a section behind a byte order mark"
assert_str "v", INI.parse("\uFEFFk=v\n")[""]["k"], "a first key behind a byte order mark"
puts "  a byte order mark"

# What `parse` would read back as something else is refused, not written:
# a value holding a line break wrote a section and a key of its own, and a
# padded value came back unpadded. What can be written round-trips.
def build_refusal(ini : Hash(String, Hash(String, String))) : String
  said = "built"
  group do |g|
    attempt = g.spawn { INI.build(ini) }
    outcome = attempt.value
    said = outcome.message.to_s if outcome.is_a?(Panicked)
    0
  end
  said
end

injected = build_refusal({"s" => {"motd" => "hello\r\n[admin]\r\nrole=root"}})
assert_true injected.includes?("holds a line break"), "a value with a line break is refused, not #{injected.inspect}"
padded = build_refusal({"s" => {"pad" => "  two spaces  "}})
assert_true padded.includes?("blanks at either end"), "a padded value is refused, not #{padded.inspect}"
assert_true build_refusal({"s" => {"a=b" => "c"}}).includes?("holds `=`"), "a key holding = is refused"
assert_true build_refusal({"s]x" => {"a" => "b"}}).includes?("holds `]`"), "a section name holding ] is refused"
plain = {"s" => {"hash" => "#not a comment", "eq" => "a=b=c"}}
back = INI.parse(INI.build(plain))
assert_true back.keys == ["s"] && back["s"].keys == ["hash", "eq"], "what can be written round-trips its names"
assert_str "#not a comment", back["s"]["hash"], "a value opening with # round-trips"
assert_str "a=b=c", back["s"]["eq"], "a value holding = round-trips"
# A first top-level key opening with U+FEFF is written at the front of the
# text, where `parse` reads past it as a byte order mark: `"\uFEFFkey"`
# came back `key`.
bom_key = build_refusal({"" => {"\uFEFFkey" => "v"}})
assert_true bom_key.includes?("opens with U+FEFF"), "a key opening with U+FEFF is refused, not #{bom_key.inspect}"
inner = INI.parse(INI.build({"s" => {"k\uFEFF" => "v"}}))
assert_true inner["s"].has_key?("k\uFEFF"), "a U+FEFF past a key's first character round-trips"
puts "  build refuses a line break, padding, a key with = or opening with U+FEFF and a section with ]"

puts "\n== leading whitespace"
# ASCII whitespace before a line, as the other library skips it: `\v` and
# `\f` were read as the start of a key, so the header after one was refused
# (`expected declaration at line 1, column 5`) and a line of `\f` was no
# blank line.
spaced = INI.parse("\v[s]\n\fk = v\n\f\n")
assert_true spaced.size == 1, "one section, #{spaced.size}"
assert_str "v", spaced["s"]["k"], "a key after a form feed"
puts "  vertical tab, form feed"

puts "\nALL CHECKS PASSED"
