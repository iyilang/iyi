# Exercises the concurrency runtime: SPEC.md III.4, built in III.4.8's order.
#
# Every check here is a property III.4 states, asserted rather than printed:
# a wrong answer is exit 1 with the property named. The one property a
# program cannot assert about itself — that a deadlocked program dies loudly
# instead of hanging — is bench/concurrency_exercise.sh's failure proof.
#
# The timing thresholds are structural, not benchmarks: 2 x 150 ms of
# sleeping finishing under 260 ms cannot happen sequentially, and a task
# blocked for 10 s finishing under 5 s cannot happen unless cancellation
# reached it while blocked. Generous margins, because the aarch64 arm of CI
# runs under emulation.

def fail(message : String) : Nil
  puts "FAIL: #{message}"
  __iyi_exit(1)
end

def elapsed_ms(since : Int64) : Int64
  (__iyi_monotonic_ns - since) // 1000000_i64
end

# A pipe, for the poller check. The exercise's own binding, the way every
# probe of a call the prelude does not carry yet gets one: raw `pipe2` on
# Linux, libSystem's `pipe` on darwin, which is III.9's darwin rule
# applied to a test probe.
{% if flag?(:darwin) %}
  lib LibC
    fun pipe(fds : Int32*) : Int32
  end

  def make_pipe : Pointer(Int32)
    fds = Pointer(UInt8).malloc(8_u64).as(Pointer(Int32))
    fail("pipe failed") if LibC.pipe(fds) < 0
    fds
  end
{% elsif flag?(:win32) %}
  # Same as `runtime_exercise`: the prelude's `LibC` is wide-only now, and
  # this pipe name is the exercise's own ASCII.
  lib LibC
    fun CreateFileA(name : UInt8*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
  end

  def make_pipe : Pointer(Int64)
    pipe_name = "\\\\.\\pipe\\iyi_conc_pipe_#{__iyi_monotonic_ns}".to_unsafe
    h_read = LibC.CreateNamedPipeA(pipe_name, 0x40000001_i32, 0_i32, 1_i32, 4096_i32, 4096_i32, 0_i32, Pointer(Void).new(0_u64))
    fail("CreateNamedPipeA failed") if h_read.address &+ 1_u64 == 0_u64
    h_write = LibC.CreateFileA(pipe_name, 1073741824_i32, 0_i32, Pointer(Void).new(0_u64), 3_i32, 128_i32, Pointer(Void).new(0_u64))
    fail("CreateFileA for pipe failed") if h_write.address &+ 1_u64 == 0_u64
    fds = Pointer(UInt8).malloc(16_u64).as(Pointer(Int64))
    fds[0] = h_read.address.to_i64
    fds[1] = h_write.address.to_i64
    fds
  end
{% else %}
  {% if flag?(:x86_64) %}
    EX_SYS_PIPE2 = 293_i64
  {% else %}
    EX_SYS_PIPE2 = 59_i64
  {% end %}

  def make_pipe : Pointer(Int32)
    fds = Pointer(UInt8).malloc(8_u64).as(Pointer(Int32))
    result = __iyi_conc_syscall3(EX_SYS_PIPE2, fds.address.to_i64, 0_i64, 0_i64)
    fail("pipe2 failed") if result < 0
    fds
  end
{% end %}

pub struct TaskFailed
  def initialize
  end
end

impl Error for TaskFailed
  def message : String
    "the failing task's error"
  end
end

# ── 1. Interleaving is real, and deterministic ──────────────────────────
#
# Two tasks ping-pong through two channels. A `group` that ran its tasks
# one after another — the imitation III.4.8 refused to ship — cannot
# produce this order: each letter needs the other task to have moved.
ping = Channel(Int32).new(1)
pong = Channel(Int32).new(1)
order = ""

group do |g|
  g.spawn do
    round = 0
    while round < 3
      ping.receive
      order = order + "a"
      pong.send(1)
      round = round + 1
    end
    0
  end
  g.spawn do
    round = 0
    while round < 3
      order = order + "b"
      ping.send(1)
      pong.receive
      round = round + 1
    end
    0
  end
end

fail("interleaving: expected bababa, got #{order}") unless order == "bababa"
puts "interleaved: #{order}"

# ── 2. Waits overlap: the anti-sequential clock ─────────────────────────
started = __iyi_monotonic_ns
group do |g|
  g.spawn do
    sleep(150)
  end
  g.spawn do
    sleep(150)
  end
end
overlap = elapsed_ms(started)
fail("overlap: 2 x 150 ms took #{overlap} ms, which is sequential") if overlap >= 260
puts "two 150 ms sleeps in #{overlap} ms"

# ── 3. The first failing task cancels a *blocked* sibling — III.4.2/3 ───
started = __iyi_monotonic_ns
victim_saw = ""
group do |g|
  victim = g.spawn do
    slept = sleep(10000)
    victim_saw = slept.is_a?(Cancelled) ? "cancelled" : "slept"
    slept
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
cancelled_after = elapsed_ms(started)
fail("cancellation never reached the sleeping task") unless victim_saw == "cancelled"
fail("cancellation took #{cancelled_after} ms against a 10 s sleep") if cancelled_after >= 5000
puts "a failing task cancelled a sibling blocked in sleep, in #{cancelled_after} ms"

# ── 4. `!` drains a cancelled task through its later waits ──────────────
def two_naps : Nil | Cancelled
  sleep(10000)!
  sleep(10000)!
  nil
end

started = __iyi_monotonic_ns
drained = ""
group do |g|
  g.spawn do
    outcome = two_naps
    drained = outcome.is_a?(Cancelled) ? "propagated" : "finished"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("`!` did not propagate Cancelled out of the task body") unless drained == "propagated"
fail("draining a cancelled task took #{elapsed_ms(started)} ms") if elapsed_ms(started) >= 5000
puts "a cancelled task drained through `!`"

# ── 5. The poller: a read parks the fiber, the thread keeps working ─────
fds = make_pipe
read_fd = fds[0]
write_fd = fds[1]
io_order = ""

group do |g|
  g.spawn do
    io_order = io_order + "parked,"
    buffer = Pointer(UInt8).malloc(1_u64)
    got = iyi_read(read_fd, buffer.as(Void*), 1_u64)
    case got
    in Int64
      io_order = io_order + "read:#{buffer.value.to_i64}"
    in Cancelled
      io_order = io_order + "cancelled"
    end
    0
  end
  g.spawn do
    sleep(40)
    io_order = io_order + "wrote,"
    byte = Pointer(UInt8).malloc(1_u64)
    byte.value = 7_u8
    __iyi_write(write_fd, byte.as(Void*), 1_u64)
    0
  end
end

fail("poller: expected parked,wrote,read:7 — got #{io_order}") unless io_order == "parked,wrote,read:7"
puts "a read parked in the poller and a sleeping writer woke it"

# ── 6. A closed channel drains, then refuses, and wakes the parked ──────
late = Channel(Int32).new(1)
closed_saw = ""
group do |g|
  g.spawn do
    value = late.receive
    closed_saw = value.is_a?(ChannelClosed) ? "closed" : "value"
    0
  end
  g.spawn do
    sleep(20)
    late.close
    0
  end
end
fail("close did not wake the parked receiver with ChannelClosed") unless closed_saw == "closed"
puts "close woke a parked receiver with ChannelClosed"

# ── 7. `task.value` joins and answers what the block returned ───────────
doubled = 0
group do |g|
  t = g.spawn do
    sleep(10)
    21
  end
  value = t.value
  doubled = value.is_a?(Int32) ? value * 2 : -1
end
fail("task.value answered #{doubled // 2}") unless doubled == 42
puts "task.value joined and answered"

# ── 8. The join is deferred: an early return cannot leak a task ─────────
def leaves_early(finished : Pointer(Int32)) : Nil
  group do |g|
    g.spawn do
      sleep(30)
      finished.value = 1
      0
    end
    return
  end
end

flag = Pointer(Int32).malloc(4_u64)
flag.value = 0
leaves_early(flag)
fail("a `return` out of the group block left its task running") unless flag.value == 1
puts "an early return still joined the group"

# ── 9. A rendezvous send parks until its value is taken ─────────────────
#
# `Channel(T).new` with no capacity: the sender cannot leave `send` until
# a receiver takes the value, and the order string is the witness — "s1"
# can only follow "r". A buffered channel would print "s0,s1,r".
meet = Channel(Int32).new
meet_order = ""
group do |g|
  g.spawn do
    meet_order = meet_order + "s0,"
    meet.send(11)
    meet_order = meet_order + "s1"
    0
  end
  g.spawn do
    sleep(20)
    meet_order = meet_order + "r,"
    value = meet.receive
    value.is_a?(Int32) ? value : -1
  end
end
fail("rendezvous: expected s0,r,s1 — got #{meet_order}") unless meet_order == "s0,r,s1"
puts "a rendezvous send parked until its value was taken"

# ── 10. And the other way round: a parked receiver completes the send ───
meet2 = Channel(Int32).new
got2 = 0
group do |g|
  g.spawn do
    value = meet2.receive
    got2 = value.is_a?(Int32) ? value : -1
    0
  end
  g.spawn do
    sleep(20)
    meet2.send(23)
    0
  end
end
fail("rendezvous: the parked receiver got #{got2}") unless got2 == 23
puts "a parked receiver completed a rendezvous send"

# ── 11. Parked sends complete in the order they parked ──────────────────
#
# The def is load-bearing: a `while` body is one scope, so a closure made
# in it would capture one shared variable; a parameter is a fresh binding.
def spawn_send(g : IyiGroup, fifo : Channel(Int32), n : Int32) : Nil
  g.spawn do
    fifo.send(n)
    0
  end
  nil
end

fifo = Channel(Int32).new
drained = ""
group do |g|
  index = 1
  while index <= 3
    spawn_send(g, fifo, index)
    index = index + 1
  end
  g.spawn do
    sleep(20)
    round = 0
    while round < 3
      value = fifo.receive
      drained = drained + (value.is_a?(Int32) ? value.to_s : "?")
      round = round + 1
    end
    0
  end
end
fail("rendezvous FIFO: expected 123, got #{drained}") unless drained == "123"
puts "parked sends completed in park order"

# ── 12. Cancellation reaches a parked sender; its value dies undelivered ─
lonely = Channel(Int32).new
sender_saw = ""
group do |g|
  g.spawn do
    outcome = lonely.send(99)
    sender_saw = outcome.is_a?(Cancelled) ? "cancelled" : "sent"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("a parked sender was not cancelled: #{sender_saw}") unless sender_saw == "cancelled"
# Had the cancelled send's value leaked into the buffer, this receive
# would answer 99; a closed empty channel answers ChannelClosed.
lonely.close
received_late = lonely.receive
fail("a cancelled send's value was delivered anyway") if received_late.is_a?(Int32)
puts "a cancelled rendezvous send died undelivered"

# ── 13. Closing fails a parked sender, loudly ───────────────────────────
doomed = Channel(Int32).new
closed_send = ""
group do |g|
  g.spawn do
    outcome = doomed.send(7)
    closed_send = outcome.is_a?(ChannelClosed) ? "refused" : "other"
    0
  end
  g.spawn do
    sleep(20)
    doomed.close
    0
  end
end
fail("close did not fail the parked sender: #{closed_send}") unless closed_send == "refused"
puts "close failed a parked sender with ChannelClosed"

# ── 14. `select` takes the arm that is ready ────────────────────────────
left = Channel(Int32).new
right = Channel(String).new
picked = ""
group do |g|
  g.spawn do
    sleep(20)
    right.send("hello")
    0
  end
  g.spawn do
    select
    when n = left.receive
      picked = "left"
    when s = right.receive
      picked = s.is_a?(String) ? "right:#{s}" : "right:?"
    end
    0
  end
end
fail("select: expected right:hello, got #{picked}") unless picked == "right:hello"
puts "select took the arm that became ready"

# ── 15. A select's send arm can win while parked ────────────────────────
narrow = Channel(Int32).new
sent_arm = ""
group do |g|
  g.spawn do
    select
    when narrow.send(31)
      sent_arm = "sent"
    when n = Channel(Int32).new(1).receive
      sent_arm = "impossible"
    end
    0
  end
  g.spawn do
    sleep(20)
    value = narrow.receive
    value.is_a?(Int32) ? value : -1
  end
end
fail("select: the parked send arm saw #{sent_arm}") unless sent_arm == "sent"
puts "a select's send arm won while parked"

# ── 16. `select` with an `else` does not park ───────────────────────────
idle = Channel(Int32).new
took_else = ""
select
when n = idle.receive
  took_else = "arm"
else
  took_else = "else"
end
fail("select else: got #{took_else}") unless took_else == "else"
puts "select with nothing ready took its else"

# ── 17. The typed group — III.4.9 ────────────────────────────────────────
#
# Two direct spawns make the group a value: the tuple of what they
# answered, or the first error member, with `!` propagating it out of the
# enclosing def through III.1.2's ordinary machinery.
def fetch_pair(fail_second : Bool) : Tuple(Int32, Int32) | TaskFailed | Cancelled | Panicked
  group do |g|
    x = g.spawn do
      slept = sleep(10)
      slept.is_a?(Cancelled) ? slept : 21
    end
    y = g.spawn do
      slept = sleep(fail_second ? 20 : 10)
      slept.is_a?(Cancelled) ? slept : (fail_second ? TaskFailed.new : 2)
    end
  end!
end

pair = fetch_pair(false)
case pair
in Tuple(Int32, Int32) then fail("typed group: got #{it[0]}, #{it[1]}") unless it[0] == 21 && it[1] == 2
in TaskFailed          then fail("typed group: failed on the success path")
in Cancelled           then fail("typed group: cancelled on the success path")
in Panicked            then fail("typed group: panicked on the success path")
end
puts "a typed group answered its tuple"

started = __iyi_monotonic_ns
broken = fetch_pair(true)
fail("typed group: the failure did not leave as the error") unless broken.is_a?(TaskFailed)
puts "a typed group's first failure left as the error"

# ── 18. A dynamic group keeps the general form ───────────────────────────
#
# A spawn in a loop has no arity, so the group stays `Nil` and handles
# answer through `task.value` — the expansion refusing quietly is the
# method call standing as written.
drainer = Channel(Int32).new(3)
shape = group do |g|
  index = 0
  while index < 3
    spawn_send(g, drainer, index)
    index = index + 1
  end
end
fail("a loop-spawning group grew a type") unless shape.is_a?(Nil)
round = 0
while round < 3
  drainer.receive
  round = round + 1
end
puts "a dynamic group kept the general form"

puts "concurrency exercise: every property held"
