# What a kernel thread costs the dependency floor, measured before the
# design that needed one was written — and it is written now:
# `src/iyi/thread.iyi` is this mechanism in the runtime (GC_DESIGN.md
# Stage 4; SPEC.md III.4.11), and this probe stays the floor's
# measurement of it, arm by arm, cost by cost. The
# question III.9 asks is exact — a scheduler that reached for pthreads
# would put libc back on the link line — so on Linux this program reaches
# for the kernel instead: `clone` onto a stack of its own mapping, `futex`
# to join, `tgkill` and a signal handler to stop every thread where it
# stands and start it again, which is the whole of what a stop-the-world
# needs from the platform. On darwin there is no kernel to reach for —
# III.9's own rule is that raw syscalls are not a stable ABI there and
# libSystem is the platform — so the same program is `pthread_create`,
# `pthread_kill` and `sigaction` from libSystem, and what it measures is
# exactly which names that costs. bench/thread_floor.sh drives it and
# reads the floor off the binary.
#
#   ./bin/iyi run bench/thread_floor.iyi
#
# Linux x86_64 and aarch64; darwin aarch64. Nothing in a thread body
# allocates or touches the scheduler: the arena has no lock and the run
# queue is one thread's, which is precisely the state this measurement
# exists to price.

{% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
  def fail(message : String) : Nil
    puts "FAIL: #{message}"
    __iyi_exit(1)
  end

  # ── Atomics, the prelude's ──────────────────────────────────────────────
  #
  # The counters were three `fun`s of inline asm for as long as the prelude
  # had no atomic, and the release build's `xchg` clobbered a register the
  # asm had declared an input (CHANGELOG.md, Fixed). They are `Atomic(T)`
  # now — `src/iyi/atomic.iyi`, this program its first caller — over the
  # same words at the same addresses: the instructions are the compiler's
  # (`lock xadd`, `xchg`, `mov`; `ldaxr`/`stlxr`, `ldar`, `stlr`), the
  # register allocation is LLVM's, and the floor read off this binary in
  # step 2 is what proves an atomic costs no name.
  def __tf_word(address : UInt64) : Pointer(Atomic(UInt64))
    Pointer(Atomic(UInt64)).new(address)
  end

  def __tf_add(address : UInt64, delta : UInt64) : UInt64
    __tf_word(address).value.add(delta)
  end

  def __tf_load(address : UInt64) : UInt64
    __tf_word(address).value.get
  end

  def __tf_store(address : UInt64, value : UInt64) : Nil
    __tf_word(address).value.set(value)
  end

  # One word every thread adds to on every turn of its loop — the
  # contended case, where a lost update is what a non-atomic
  # read-modify-write does under a second thread. The sum of the threads'
  # own counters is what it must equal at the end, and under
  # `-Dtf_plain_add` the add is a load and a store, so it does not: the
  # driver's failure proof for the prelude's atomic.
  def __tf_add_shared(address : UInt64) : Nil
    {% if flag?(:tf_plain_add) %}
      word = __tf_word(address)
      word.value.set(word.value.get &+ 1_u64)
    {% else %}
      __tf_word(address).value.add(1_u64)
    {% end %}
  end

  # Where each thread lives: one 64-byte line per thread, so two threads'
  # words never share a cache line and a false-sharing artefact cannot
  # pose as a measurement.
  #   +0   the parent's handle on the thread: on Linux the tid, written by
  #        the kernel at start and zeroed by it at exit; on darwin the
  #        pthread_t `pthread_create` answered
  #   +8   the tid the thread read for itself
  #   +16  work counter, the thread's own
  #   +24  the seed the thread found in its thread-local block
  #   +32  set if the thread ever saw another thread's value in its slot
  #   +40  darwin only: the thread's park word, a pipe's two descriptors or
  #        an `os_unfair_lock`, under the flags that park so
  #   +48  where the thread's stack is: on Linux the mapping's base, on
  #        darwin the address of a local in the thread's first frame
  #   +56  the most bytes a stop handler ran below the interrupted sp
  class Threads
    LINE = 64_u64
    @@table : UInt64 = 0_u64
    @@count : Int64 = 0_i64
    # Shared words, each on its own line.
    @@stop : UInt64 = 0_u64
    @@suspended : UInt64 = 0_u64
    @@resume : UInt64 = 0_u64
    @@resumed : UInt64 = 0_u64
    # Handlers that read a context whose sp was not their thread's stack.
    @@astray : UInt64 = 0_u64
    # The word every thread adds to on every turn: the contended atomic.
    @@shared : UInt64 = 0_u64

    def self.setup(count : Int64) : Nil
      @@count = count
      @@table = __iyi_mmap(LINE * count.to_u64).address
      shared = __iyi_mmap(LINE * 6_u64).address
      @@stop = shared
      @@suspended = shared + LINE
      @@resume = shared + LINE * 2_u64
      @@resumed = shared + LINE * 3_u64
      @@astray = shared + LINE * 4_u64
      @@shared = shared + LINE * 5_u64
    end

    def self.count : Int64
      @@count
    end

    def self.line(index : Int64) : UInt64
      @@table + LINE * index.to_u64
    end

    def self.stop : UInt64
      @@stop
    end

    def self.suspended : UInt64
      @@suspended
    end

    def self.resume : UInt64
      @@resume
    end

    def self.resumed : UInt64
      @@resumed
    end

    def self.astray : UInt64
      @@astray
    end

    def self.shared : UInt64
      @@shared
    end

    # What Stage 4's handler does between counting itself in and parking:
    # read the interrupted thread's registers out of the context the kernel
    # handed it. Here the two that root a stack scan, sp and pc, read at
    # the platform's offsets by the caller; the stack pointer has to be on
    # this thread's own stack (a context that is not the thread's would
    # scan the wrong stack and root nothing), and the handler's own depth
    # below that sp — the kernel's frame, the trampoline, this frame — is
    # recorded, because it is what a fiber stack has to have spare for a
    # signal to land on it, or a thread needs a `sigaltstack`.
    def self.held(sp : UInt64, pc : UInt64, here : UInt64) : Nil
      line = Tls.line
      if sp == 0_u64 || pc == 0_u64 || !stack_holds(line, sp)
        __tf_add(@@astray, 1_u64)
        return
      end
      depth = sp &- here
      __tf_store(line + 56_u64, depth) if depth > __tf_load(line + 56_u64)
    end

    # A thread's whole life after it has found its own tid, the same on
    # both kernels. The thread-local words: the seed as the image left it,
    # then the slot claimed with the thread's own tid. Every turn of the
    # loop reads the slot back, so a block two threads shared — a thread
    # pointer the kernel did not set, a variable that was not thread-local
    # after all — is caught as another thread's tid in it.
    def self.body(line : UInt64, tid : UInt64) : Nil
      __tf_store(line + 8_u64, tid)
      __tf_store(line + 24_u64, Tls.seed)
      Tls.seed = tid
      Tls.slot = tid
      # Spin until told to stop, counting: a thread that is running when a
      # signal lands is the case a stop-the-world has to handle, and a
      # parked one is the easy case. Two counts a turn — the thread's own
      # word and the one word they all share — and the two totals must
      # agree at the end.
      while __tf_load(Threads.stop) == 0_u64
        __tf_add(line + 16_u64, 1_u64)
        __tf_add_shared(Threads.shared)
        if Tls.slot != tid || Tls.seed != tid
          __tf_store(line + 32_u64, 1_u64)
        end
      end
    end
  end

  {% if flag?(:linux) %}
    {% if flag?(:x86_64) %}
      TF_SYS_CLONE        =  56_i64
      TF_SYS_EXIT         =  60_i64
      TF_SYS_FUTEX        = 202_i64
      TF_SYS_GETPID       =  39_i64
      TF_SYS_GETTID       = 186_i64
      TF_SYS_TGKILL       = 234_i64
      TF_SYS_RT_SIGACTION =  13_i64
      TF_SYS_SCHED_YIELD  =  24_i64
      # x86_64 has no vdso trampoline the kernel will pick for a handler's
      # return: SA_RESTORER must name one, and it is the two-instruction
      # `rt_sigreturn` below.
      TF_SA_FLAGS = 0x04000004_u64
      # The kernel's ucontext: uc_flags, uc_link, a 24-byte uc_stack, then
      # sigcontext at 40 with rsp as its 16th word and rip its 17th.
      TF_UC_SP = 160_u64
      TF_UC_PC = 168_u64
    {% else %}
      TF_SYS_CLONE        = 220_i64
      TF_SYS_EXIT         =  93_i64
      TF_SYS_FUTEX        =  98_i64
      TF_SYS_GETPID       = 172_i64
      TF_SYS_GETTID       = 178_i64
      TF_SYS_TGKILL       = 131_i64
      TF_SYS_RT_SIGACTION = 134_i64
      TF_SYS_SCHED_YIELD  = 124_i64
      # aarch64's kernel supplies the sigreturn trampoline from the vdso when
      # SA_RESTORER is absent; SA_SIGINFO alone.
      TF_SA_FLAGS = 0x00000004_u64
      # The kernel's ucontext: uc_flags, uc_link, uc_stack, then a sigmask
      # padded to 128 bytes and sigcontext 16-aligned at 176, whose sp
      # follows fault_address and 31 registers.
      TF_UC_SP = 432_u64
      TF_UC_PC = 440_u64
    {% end %}

    # CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD |
    # CLONE_SYSVSEM | CLONE_SETTLS | CLONE_CHILD_CLEARTID | CLONE_CHILD_SETTID
    # — a thread of this process, with the thread pointer the kernel is
    # handed (`%fs` base on x86_64, `tpidr_el0` on aarch64) and the tid
    # written into the word named and cleared with a futex wake when the
    # thread exits, which is the join. The thread pointer is what makes a
    # `@[ThreadLocal]` class variable the thread's own; the block it points
    # into is laid out below, from the executable's own PT_TLS.
    TF_CLONE_FLAGS = 0x012d0f00_i64
    TF_SIGUSR1     = 10_i64
    TF_FUTEX_WAIT  = 0_i64
    TF_FUTEX_WAKE  = 1_i64
    TF_STACK_BYTES = 262144_u64

    # ── The thread ──────────────────────────────────────────────────────────
    #
    # `clone` returns twice, and the second return is on a stack the compiler
    # has never heard of, so the child's whole life is inside the asm: it
    # loads the function and argument the parent left at the top of its
    # stack, calls, and exits with the thread-exit syscall. Only the parent's
    # return falls out of the block. Inputs are pinned to callee-saved
    # registers so the syscall's argument registers are free to be clobbered.
    fun __tf_clone(stack_top : UInt64, entry : UInt64, argument : UInt64, tid_word : UInt64, thread_pointer : UInt64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("leaq -16(%r12), %rsi
             movq %r13, 0(%rsi)
             movq %r14, 8(%rsi)
             movq $$0x012d0f00, %rdi
             xorq %rdx, %rdx
             movq %r15, %r10
             movq %rbx, %r8
             movq $$56, %rax
             syscall
             testq %rax, %rax
             jnz 1f
             movq 8(%rsp), %rdi
             movq 0(%rsp), %rax
             andq $$-16, %rsp
             callq *%rax
             movq $$60, %rax
             xorq %rdi, %rdi
             syscall
             1:" : "={rax}"(result)
                  : "{r12}"(stack_top), "{r13}"(entry), "{r14}"(argument), "{r15}"(tid_word), "{rbx}"(thread_pointer)
                  : "rdi", "rsi", "rdx", "r10", "r8", "rcx", "r11", "memory", "cc"
                  : "volatile")
      {% else %}
        # aarch64's `clone` takes (flags, stack, parent_tid, tls, child_tid):
        # tls in x3 and the child-tid word in x4, the reverse of x86_64's
        # (…, child_tid in r10, tls in r8). They were swapped here through
        # the first three commits — every thread's pointer was its line and
        # the kernel wrote the tid into the TLS block's control word — and
        # the cross-run job, the one place this arm runs, was red on each.
        asm("sub x1, x19, #16
             stp x20, x21, [x1]
             mov x0, #0x0f00
             movk x0, #0x012d, lsl #16
             mov x2, #0
             mov x3, x23
             mov x4, x22
             mov x8, #220
             svc #0
             cbnz x0, 1f
             ldp x9, x0, [sp], #16
             blr x9
             mov x8, #93
             mov x0, #0
             svc #0
             1:" : "={x0}"(result)
                  : "{x19}"(stack_top), "{x20}"(entry), "{x21}"(argument), "{x22}"(tid_word), "{x23}"(thread_pointer)
                  : "x1", "x2", "x3", "x4", "x8", "x9", "x30", "memory", "cc"
                  : "volatile")
      {% end %}
      result
    end

    # ── Thread-local storage, from the executable's own PT_TLS ──────────────
    #
    # A `@[ThreadLocal]` class variable is one load at a link-time offset from
    # the thread pointer (local-exec, which the compiler now asks for
    # outright), inside the `noinline` accessor the compiler keeps for every
    # thread-local so a fiber that changes threads never reads a cached
    # address. The main thread's block was laid out by the loader; a thread
    # made by raw `clone` gets one laid out here, the way a static libc's
    # startup lays out its own: find PT_TLS by walking the program headers
    # from `__ehdr_start`, copy the initialised image, leave the rest zero,
    # and put the thread pointer where the ABI says the offsets are counted
    # from. Variant II on x86_64: the block sits *below* the pointer and the
    # pointer's first word holds itself, because `%fs:0` is how code reads
    # it. Variant I on aarch64: the block sits above a 16-byte control block
    # the pointer names, rounded to the segment's alignment.
    @[NoInline]
    @[Naked]
    fun __tf_ehdr_start : UInt64
      {% if flag?(:x86_64) %}
        asm("leaq __ehdr_start(%rip), %rax
             retq" :::: "volatile")
      {% else %}
        asm("adrp x0, __ehdr_start
             add x0, x0, :lo12:__ehdr_start
             ret" :::: "volatile")
      {% end %}
      0_u64
    end

    class Tls
      @[ThreadLocal]
      @@slot : UInt64 = 0_u64
      # Initialised, so it lives in the image the block copies rather than
      # in the zeroed remainder: a thread that reads 7 here read its copy.
      @[ThreadLocal]
      @@seed : UInt64 = 7_u64
      # The thread's own line, which is how its stop handler finds it.
      @[ThreadLocal]
      @@line : UInt64 = 0_u64

      # The segment, read once: biased image address, filesz, memsz, align.
      @@image : UInt64 = 0_u64
      @@filesz : UInt64 = 0_u64
      @@memsz : UInt64 = 0_u64
      @@align : UInt64 = 0_u64

      def self.slot : UInt64
        @@slot
      end

      def self.slot=(value : UInt64) : Nil
        @@slot = value
      end

      def self.seed : UInt64
        @@seed
      end

      def self.seed=(value : UInt64) : Nil
        @@seed = value
      end

      def self.line : UInt64
        @@line
      end

      def self.line=(value : UInt64) : Nil
        @@line = value
      end

      def self.memsz : UInt64
        @@memsz
      end

      # ELF64: e_phoff at 32; e_phentsize is the top half of the word at 48,
      # e_phnum the bottom half of the word at 56. A program header is 56
      # bytes: p_type in the low half of its first word, then p_flags,
      # p_offset at 8, p_vaddr at 16, p_filesz at 32, p_memsz at 40, p_align
      # at 48. The load bias is where the header actually is minus where the
      # first PT_LOAD said it would be, which is 0 for a PIE and is read
      # rather than assumed.
      def self.read_segment : Nil
        return if @@align != 0_u64
        header = __tf_ehdr_start
        phoff = Pointer(UInt64).new(header + 32_u64).value
        phentsize = Pointer(UInt64).new(header + 48_u64).value.unsafe_shr(48_u64)
        phnum = Pointer(UInt64).new(header + 56_u64).value & 0xFFFF_u64
        bias = 0_u64
        found_load = false
        index = 0_u64
        while index < phnum
          entry = header + phoff + index * phentsize
          type = Pointer(UInt64).new(entry).value & 0xFFFFFFFF_u64
          if type == 1_u64 && !found_load
            bias = header - Pointer(UInt64).new(entry + 16_u64).value
            found_load = true
          end
          if type == 7_u64
            @@image = Pointer(UInt64).new(entry + 16_u64).value
            @@filesz = Pointer(UInt64).new(entry + 32_u64).value
            @@memsz = Pointer(UInt64).new(entry + 40_u64).value
            @@align = Pointer(UInt64).new(entry + 48_u64).value
          end
          index = index + 1_u64
        end
        raise "no PT_TLS in the executable" if @@align == 0_u64
        @@image = @@image + bias
      end

      def self.round_up(value : UInt64, align : UInt64) : UInt64
        (value + align - 1_u64) & (0_u64 &- align)
      end

      # A block for one thread; answers the thread pointer to hand `clone`.
      def self.make : UInt64
        read_segment
        size = round_up(@@memsz, @@align)
        mapping = __iyi_mmap(round_up(size + 64_u64, 4096_u64)).address
        {% if flag?(:x86_64) %}
          pointer = round_up(mapping + size, @@align)
          pointer = round_up(pointer, 64_u64)
          block = pointer - size
          Pointer(UInt64).new(pointer).value = pointer
        {% else %}
          pointer = round_up(mapping, 64_u64)
          block = pointer + round_up(16_u64, @@align)
        {% end %}
        index = 0_u64
        while index < @@filesz
          Pointer(UInt8).new(block + index).value = Pointer(UInt8).new(@@image + index).value
          index = index + 1_u64
        end
        pointer
      end
    end

    fun __tf_thread_main(line : UInt64) : Nil
      tid = __iyi_conc_syscall3(TF_SYS_GETTID, 0_i64, 0_i64, 0_i64)
      Tls.line = line
      Threads.body(line, tid.to_u64)
    end

    # The address of a `fun`, by asm, for the reason concurrency.iyi gives.
    @[NoInline]
    @[Naked]
    fun __tf_thread_main_address : UInt64
      {% if flag?(:x86_64) %}
        asm("leaq __tf_thread_main(%rip), %rax
             retq" :::: "volatile")
      {% else %}
        asm("adrp x0, __tf_thread_main
             add x0, x0, :lo12:__tf_thread_main
             ret" :::: "volatile")
      {% end %}
    0_u64
    end

    def current_thread_id : Int64
      __iyi_conc_syscall3(TF_SYS_GETTID, 0_i64, 0_i64, 0_i64)
    end

    def start_thread(index : Int64) : Nil
      line = Threads.line(index)
      stack = __iyi_mmap(TF_STACK_BYTES).address
      __tf_store(line + 48_u64, stack)
      result = __tf_clone(stack + TF_STACK_BYTES, __tf_thread_main_address, line, line, Tls.make)
      fail("clone failed: #{result}") if result < 0
    end

    # The thread's tid as its parent knows it: the word the kernel wrote
    # for CLONE_CHILD_SETTID.
    def thread_id_of(index : Int64) : Int64
      __tf_load(Threads.line(index)).to_i64
    end

    def yield_cpu : Nil
      __iyi_conc_syscall3(TF_SYS_SCHED_YIELD, 0_i64, 0_i64, 0_i64)
    end

    # Join: the kernel zeroes the tid word and wakes its futex when the
    # thread exits; until then wait on the word holding the tid it holds.
    def join_thread(index : Int64) : Nil
      line = Threads.line(index)
      while (tid = __tf_load(line)) != 0_u64
        __iyi_conc_syscall6(TF_SYS_FUTEX, line.to_i64, TF_FUTEX_WAIT, tid.to_i64, 0_i64, 0_i64, 0_i64)
      end
    end

    # ── Stop the world ──────────────────────────────────────────────────────
    #
    # The handler runs on the signalled thread, wherever it was. It counts
    # itself suspended, parks on the resume word — a futex, so a stopped
    # thread costs no CPU — and counts itself resumed on the way out. That
    # is Stage 4's mechanism entire: what the collector would do between
    # the two counts is read the thread's registers from the ucontext the
    # kernel passes as the third argument, and scan its stack from the
    # saved stack pointer up.
    # The stack is the mapping `start_thread` made, and its base is on the
    # line.
    def stack_holds(line : UInt64, sp : UInt64) : Bool
      base = __tf_load(line + 48_u64)
      sp >= base && sp < base + TF_STACK_BYTES
    end

    fun __tf_stop_handler(signal : Int32, info : Void*, context : Void*) : Nil
      __tf_add(Threads.suspended, 1_u64)
      here = uninitialized UInt64
      Threads.held(Pointer(UInt64).new(context.address + TF_UC_SP).value,
        Pointer(UInt64).new(context.address + TF_UC_PC).value, pointerof(here).address)
      while __tf_load(Threads.resume) == 0_u64
        __iyi_conc_syscall6(TF_SYS_FUTEX, Threads.resume.to_i64, TF_FUTEX_WAIT, 0_i64, 0_i64, 0_i64, 0_i64)
      end
      __tf_add(Threads.resumed, 1_u64)
    end

    @[NoInline]
    @[Naked]
    fun __tf_stop_handler_address : UInt64
      {% if flag?(:x86_64) %}
        asm("leaq __tf_stop_handler(%rip), %rax
             retq" :::: "volatile")
      {% else %}
        asm("adrp x0, __tf_stop_handler
             add x0, x0, :lo12:__tf_stop_handler
             ret" :::: "volatile")
      {% end %}
    0_u64
    end

    {% if flag?(:x86_64) %}
      @[NoInline]
      @[Naked]
      fun __tf_sigreturn : Nil
        asm("movq $$15, %rax
             syscall" :::: "volatile")
      end

      @[NoInline]
      @[Naked]
      fun __tf_sigreturn_address : UInt64
        asm("leaq __tf_sigreturn(%rip), %rax
             retq" :::: "volatile")
      0_u64
      end
    {% end %}

    # `tgkill` wants the process id beside the tid; read once, kept here.
    class Stop
      @@pid : Int64 = 0_i64

      def self.pid : Int64
        @@pid
      end

      def self.pid=(value : Int64) : Nil
        @@pid = value
      end
    end

    # The kernel's own sigaction: handler, flags, restorer, mask — the same
    # four words on both targets, with the restorer meaningful only where
    # TF_SA_FLAGS names it.
    def install_stop_handler : Nil
      Stop.pid = __iyi_conc_syscall3(TF_SYS_GETPID, 0_i64, 0_i64, 0_i64)
      action = Pointer(UInt64).malloc(4_u64)
      action[0] = __tf_stop_handler_address
      action[1] = TF_SA_FLAGS
      {% if flag?(:x86_64) %}
        action[2] = __tf_sigreturn_address
      {% else %}
        action[2] = 0_u64
      {% end %}
      action[3] = 0_u64
      result = __iyi_conc_syscall6(TF_SYS_RT_SIGACTION, TF_SIGUSR1, action.address.to_i64, 0_i64, 8_i64, 0_i64, 0_i64)
      fail("rt_sigaction failed: #{result}") if result < 0
    end

    # One round: signal every thread, wait until every handler has counted
    # itself in, then release them all with one wake and wait until every
    # handler has counted itself out. Answers the two pause halves in ns.
    def stop_the_world : Tuple(Int64, Int64)
      __tf_store(Threads.suspended, 0_u64)
      __tf_store(Threads.resumed, 0_u64)
      __tf_store(Threads.resume, 0_u64)
      count = Threads.count

      started = __iyi_monotonic_ns
      index = 0_i64
      while index < count
        tid = __tf_load(Threads.line(index) + 8_u64).to_i64
        result = __iyi_conc_syscall3(TF_SYS_TGKILL, Stop.pid, tid, TF_SIGUSR1)
        fail("tgkill failed: #{result}") if result < 0
        index = index + 1_i64
      end
      while __tf_load(Threads.suspended) < count.to_u64
        yield_cpu
      end
      stopped = __iyi_monotonic_ns

      __tf_store(Threads.resume, 1_u64)
      __iyi_conc_syscall6(TF_SYS_FUTEX, Threads.resume.to_i64, TF_FUTEX_WAKE, 1000000_i64, 0_i64, 0_i64, 0_i64)
      while __tf_load(Threads.resumed) < count.to_u64
        yield_cpu
      end
      resumed = __iyi_monotonic_ns

      {stopped - started, resumed - stopped}
    end

    def describe_threads : String
      "started by raw clone, each with a tid of its own"
    end

    def describe_join : String
      "every thread exited and its tid word was cleared by the kernel"
    end

    def describe_context : String
      "the kernel's ucontext"
    end

    def describe_thread_local : String
      "#{Tls.memsz.to_i64}-byte PT_TLS laid out per thread; every slot stayed its owner's"
    end
  {% else %}
    # ── darwin: the same program, through libSystem ─────────────────────────
    #
    # Every name below is a dependency this probe takes on, and
    # bench/thread_floor.sh holds the binary to exactly this list: it is
    # what a thread costs the darwin floor. A thread is `pthread_create`,
    # `pthread_join` and `pthread_kill` — the pthreads price III.9 refused
    # on Linux, and on darwin the only door there is. `pthread_threadid_np`
    # is the 64-bit id the kernel knows a thread by, asked once by the
    # thread of itself and once by its parent of the handle, so the two
    # views can be compared the way the tid word and `gettid` are on
    # Linux. `sigaction` is libSystem's and installs libSystem's own
    # trampoline for the handler's return, so there is no sigreturn to
    # write.
    #
    # The park is the finding. A mutex and condition were measured first,
    # four names, released by one broadcast (CHANGELOG.md has the numbers
    # for all of these); one `os_unfair_lock` the main thread holds, two
    # names, released by one unlock - which the kernel hands waiter to
    # waiter, so the resume is a chain of wakeups at some 40 µs a link;
    # one `os_unfair_lock` per thread, on the thread's own line, two
    # names, released by N unlocks issued back to back, which wake in
    # parallel and resume as fast as the broadcast does; then, once the
    # question was asked with async-signal-safety in it, `sigsuspend` and
    # a pipe per thread. The pipe was the runtime's park until it was
    # found holding two descriptors for every thread a program ever
    # started (src/iyi/thread.iyi, `IyiThread.park`). What is here now is
    # Linux's park on libSystem's public futex, macOS 14.4's
    # `os_sync_wait_on_address` on the one resume word and one
    # `os_sync_wake_by_address_all`, which cost no name of their own: the
    # collector's helpers park on them in every program. `__ulock_wait`,
    # beneath them and beneath libSystem's own locks, is the same futex as
    # private ABI. The pipe, the per-thread lock and `sigsuspend` stay as
    # flags. `sched_yield` was measured too and is not here: the main
    # thread spins on the counters with a `yield` hint instead, which
    # costs no name and, below the core count, no time. And the stop has
    # an alternative with no signal in it at all — Mach's
    # `thread_suspend`, which returns with the thread held, and
    # `thread_get_state` for its registers — kept under `-Dtf_mach` below
    # because it was the obvious other answer and it loses at every
    # count: each suspend returns only once its target has been through a
    # core and stopped, one target after another, where N signals are
    # queued at once and the handlers stop in parallel.
    lib LibC
      fun pthread_create(thread : UInt64*, attributes : Void*, start : Void*, argument : Void*) : Int32
      fun pthread_join(thread : Void*, value : Void*) : Int32
      fun pthread_kill(thread : Void*, signal : Int32) : Int32
      fun pthread_threadid_np(thread : Void*, id : UInt64*) : Int32
      fun sigaction(signal : Int32, action : Void*, previous : Void*) : Int32
      {% if flag?(:tf_park_sigsuspend) %}
        fun sigsuspend(mask : Void*) : Int32
      {% elsif flag?(:tf_park_lock) %}
        fun os_unfair_lock_lock(lock : Void*) : Nil
        fun os_unfair_lock_unlock(lock : Void*) : Nil
      {% elsif flag?(:tf_park_pipe) %}
        fun pipe(fds : Int32*) : Int32
        fun read(fd : Int32, buffer : Void*, count : UInt64) : Int64
        fun write(fd : Int32, buffer : Void*, count : UInt64) : Int64
      {% end %}
    end

    TF_SIGUSR1 = 30_i32
    TF_SIGUSR2 = 31_i32
    # struct sigaction on darwin arm64 is sixteen bytes: the handler, then
    # `sa_mask` (a 32-bit set) and `sa_flags` packed into the second word.
    # SA_SIGINFO is 0x40, in the high half.
    TF_SA_WORD = 0x0000004000000000_u64
    # The stop handler's word under `-Dtf_park_sigsuspend`: the same, with
    # SIGUSR2 in `sa_mask` (bit 30 of the low half), so a resume sent
    # between the handler's count-in and its `sigsuspend` stays pending
    # until the `sigsuspend` unblocks it, rather than running the empty
    # resume handler first and leaving the thread parked for good - the
    # lost wakeup that hung this variant on CI one run in ten.
    TF_SA_STOP_WORD = 0x0000004040000000_u64
    # The thread's park word on its own line at this offset, under the
    # flags that park on one of their own: the pipe's two descriptors, read
    # end low, write end high; or an `os_unfair_lock` (OS_UNFAIR_LOCK_INIT
    # is zero).
    TF_PARK = 40_u64
    # libSystem's ucontext: uc_onstack and a 32-bit sigmask, a 24-byte
    # uc_stack, uc_link, uc_mcsize, then at 48 a pointer to the mcontext,
    # whose 16-byte exception state precedes the thread state — x0..x28,
    # fp, lr, sp at 264, pc at 272.
    TF_UC_MCONTEXT = 48_u64
    TF_MC_SP = 264_u64
    TF_MC_PC = 272_u64

    # ── Thread-local storage, dyld's ────────────────────────────────────────
    #
    # Nothing to lay out. Mach-O carries thread-locals in `__thread_vars`
    # (one 24-byte descriptor per variable: a thunk, a key, an offset) with
    # the initialised image in `__thread_data`, and dyld allocates and
    # initialises every thread's block itself, on the thread's first touch,
    # however the thread was made. What the compiler emits for a
    # `@[ThreadLocal]` read is `adrp`/`add` to the descriptor, a load of
    # its thunk and a `blr`: LLVM has no local-exec on Mach-O. The thunk
    # the linker put in every descriptor is `__tlv_bootstrap`, bound from
    # libSystem, which dyld replaces with its own `tlv_get_addr` at load —
    # so `__tlv_bootstrap` is the one name a thread-local costs the darwin
    # floor, and it is counted. The class here is the Linux one minus the
    # segment walk, plus the thread's own line, which is how a handler
    # finds its park word: through the thread pointer, the way Stage 4's
    # handler will find its thread's state.
    class Tls
      @[ThreadLocal]
      @@slot : UInt64 = 0_u64
      # Initialised, so it lives in `__thread_data` rather than
      # `__thread_bss`: a thread that reads 7 here read dyld's copy.
      @[ThreadLocal]
      @@seed : UInt64 = 7_u64
      @[ThreadLocal]
      @@line : UInt64 = 0_u64

      def self.slot : UInt64
        @@slot
      end

      def self.slot=(value : UInt64) : Nil
        @@slot = value
      end

      def self.seed : UInt64
        @@seed
      end

      def self.seed=(value : UInt64) : Nil
        @@seed = value
      end

      def self.line : UInt64
        @@line
      end

      def self.line=(value : UInt64) : Nil
        @@line = value
      end
    end

    # The 64-bit id of the calling thread when the handle is null.
    def current_thread_id : Int64
      id = uninitialized UInt64
      result = LibC.pthread_threadid_np(Pointer(Void).new(0_u64), pointerof(id))
      fail("pthread_threadid_np failed: #{result}") if result != 0
      id.to_i64
    end

    fun __tf_thread_main(argument : Void*) : Void*
      id = uninitialized UInt64
      LibC.pthread_threadid_np(Pointer(Void).new(0_u64), pointerof(id))
      Tls.line = argument.address
      # Where this thread's stack is, without asking libSystem for its
      # bounds: the address of this frame's local, below which the spin
      # loop's frames sit.
      __tf_store(argument.address + 48_u64, pointerof(id).address)
      Threads.body(argument.address, id)
      Pointer(Void).new(0_u64)
    end

    # The address of a `fun`, by asm, for the reason concurrency.iyi gives;
    # Mach-O spells the pair @PAGE/@PAGEOFF and prefixes an underscore.
    @[NoInline]
    @[Naked]
    fun __tf_thread_main_address : UInt64
      asm("adrp x0, ___tf_thread_main@PAGE
           add x0, x0, ___tf_thread_main@PAGEOFF
           ret" :::: "volatile")
      0_u64
    end

    # The handle lands in the line's first word, where the Linux arm keeps
    # the tid: the parent's name for the thread, either way.
    def start_thread(index : Int64) : Nil
      line = Threads.line(index)
      result = LibC.pthread_create(Pointer(UInt64).new(line), Pointer(Void).new(0_u64),
        Pointer(Void).new(__tf_thread_main_address), Pointer(Void).new(line))
      fail("pthread_create failed: #{result}") if result != 0
    end

    # The thread's id as its parent knows it: asked of the handle.
    def thread_id_of(index : Int64) : Int64
      id = uninitialized UInt64
      handle = Pointer(Void).new(__tf_load(Threads.line(index)))
      result = LibC.pthread_threadid_np(handle, pointerof(id))
      fail("pthread_threadid_np failed: #{result}") if result != 0
      id.to_i64
    end

    # A hint, not a call: the spin is on the counters, and the core is
    # given up to nothing.
    def yield_cpu : Nil
      asm("yield" :::: "volatile")
    end

    def join_thread(index : Int64) : Nil
      handle = Pointer(Void).new(__tf_load(Threads.line(index)))
      result = LibC.pthread_join(handle, Pointer(Void).new(0_u64))
      fail("pthread_join failed: #{result}") if result != 0
    end

    {% if flag?(:tf_mach) %}
      # ── Stop the world, the Mach way ────────────────────────────────────────
      #
      # `-Dtf_mach`: no signal, no handler, no park. Every pthread has a Mach
      # thread port, `pthread_mach_thread_np` answers it, and
      # `thread_suspend` on that port returns once the thread is held — XNU
      # waits for it (thread_hold, then thread_wait) — so the stop is the
      # loop itself. `thread_get_state` with ARM_THREAD_STATE64 then reads
      # the held thread's registers, which is what the collector would do
      # with the ucontext in the other arm, and `thread_resume` lets it go.
      # Four libSystem names for the other arm's four (`sigaction`,
      # `pthread_kill`, the two lock calls); the numbers say which is the
      # cheaper stop, and bench/thread_floor.sh prints both.
      lib LibC
        fun pthread_mach_thread_np(thread : Void*) : Int32
        fun thread_suspend(thread : Int32) : Int32
        fun thread_resume(thread : Int32) : Int32
        fun thread_get_state(thread : Int32, flavor : Int32, state : Void*, count : Int32*) : Int32
      end

      # The thread's Mach port, on its line at this offset; and the counter
      # value it was held at, at the next word, so the resume can be waited
      # for the way the handler's count is.
      TF_PORT = 40_u64
      TF_HELD = 48_u64
      # arm_thread_state64_t: x0..x28, fp, lr, sp, pc, cpsr and padding —
      # 68 32-bit words (an Int32 here, the prelude's spelling for a u32 at
      # the ABI). sp sits at byte 248 and pc at 256.
      TF_ARM_THREAD_STATE64 = 6_i32
      TF_STATE_WORDS = 68_i32

      class Stop
        @@state : UInt64 = 0_u64

        def self.state : UInt64
          @@state = __iyi_mmap(4096_u64).address if @@state == 0_u64
          @@state
        end
      end

      def install_stop_handler : Nil
        Stop.state
        index = 0_i64
        while index < Threads.count
          line = Threads.line(index)
          port = LibC.pthread_mach_thread_np(Pointer(Void).new(__tf_load(line)))
          fail("pthread_mach_thread_np answered no port for thread #{index}") if port == 0
          __tf_store(line + TF_PORT, port.to_i64.to_u64)
          index = index + 1_i64
        end
      end

      # One round: suspend every thread — each call returns held — and read
      # its registers; then resume every thread and wait until every counter
      # has moved past where it was held. Answers the two pause halves in ns.
      def stop_the_world : Tuple(Int64, Int64)
        count = Threads.count
        state = Stop.state
        started = __iyi_monotonic_ns
        index = 0_i64
        while index < count
          line = Threads.line(index)
          port = __tf_load(line + TF_PORT).to_i32
          result = LibC.thread_suspend(port)
          fail("thread_suspend failed: #{result}") if result != 0
          index = index + 1_i64
        end
        stopped = __iyi_monotonic_ns

        # Held: the registers are readable, the stack pointer and program
        # counter are real, and the counter does not move while they are read.
        index = 0_i64
        while index < count
          line = Threads.line(index)
          held = __tf_load(line + 16_u64)
          words = TF_STATE_WORDS
          result = LibC.thread_get_state(__tf_load(line + TF_PORT).to_i32, TF_ARM_THREAD_STATE64, Pointer(Void).new(state), pointerof(words))
          fail("thread_get_state failed: #{result}") if result != 0
          sp = Pointer(UInt64).new(state + 248_u64).value
          pc = Pointer(UInt64).new(state + 256_u64).value
          fail("thread #{index} held with no stack pointer or program counter") if sp == 0_u64 || pc == 0_u64
          fail("thread #{index} counted while held") if __tf_load(line + 16_u64) != held
          __tf_store(line + TF_HELD, held)
          index = index + 1_i64
        end

        released = __iyi_monotonic_ns
        index = 0_i64
        while index < count
          result = LibC.thread_resume(__tf_load(Threads.line(index) + TF_PORT).to_i32)
          fail("thread_resume failed: #{result}") if result != 0
          index = index + 1_i64
        end
        index = 0_i64
        while index < count
          line = Threads.line(index)
          while __tf_load(line + 16_u64) == __tf_load(line + TF_HELD)
            yield_cpu
          end
          index = index + 1_i64
        end
        resumed = __iyi_monotonic_ns

        {stopped - started, resumed - released}
      end
    {% else %}
      # ── Stop the world ──────────────────────────────────────────────────────
      #
      # The handler runs on the signalled thread, wherever it was. It counts
      # itself suspended, parks, and counts itself resumed. What the
      # collector would do between the two counts is the same as on Linux:
      # the thread's registers are in the ucontext libSystem passes as the
      # third argument.
      #
      # Where it parks is a question with a wrong answer that measures well.
      # An `os_unfair_lock` the main thread holds is the fastest release (N
      # unlocks back to back) and is not on Apple's list of calls a signal
      # handler may make: it works, with no promise, and it was the first
      # answer here. A pipe per thread was the second - the handler blocks
      # in `read`, the main thread releases it with one `write` per thread -
      # because `read` is async-signal-safe by POSIX's own list; it cost
      # `pipe` and `read` where the lock cost its two calls, and two
      # descriptors a thread. The park is the futex now, as on Linux: the
      # handler waits on the resume word in `os_sync_wait_on_address`,
      # which checks its arguments and makes one `__ulock_wait2` system
      # call holding nothing - as safe in a handler as `read`, with no
      # list to say so - and one `os_sync_wake_by_address_all` releases
      # every thread. The other three parks are kept as flags so they stay
      # measured:
      #   -Dtf_park_pipe        the pipe per thread, `pipe` and `read`;
      #   -Dtf_park_lock        the `os_unfair_lock`, two names, no promise;
      #   -Dtf_park_sigsuspend  `sigsuspend` on a mask that lets SIGUSR2
      #                         through, released by one `pthread_kill` per
      #                         thread — Boehm's stop on every POSIX, one
      #                         name, and a resume that pays the kill loop a
      #                         second time.
      # Go's answer, a handler that blocks nowhere and rewrites the context
      # so the thread parks itself at a safe point in ordinary code, needs
      # what Go's compiler gives it and LLVM's does not without being asked:
      # a register no code ever holds live, to jump back through after every
      # other register is restored (Go's REGTMP), or safe-point tables that
      # say when one is free. On x86_64 `ret` pops the way back and no
      # register is needed; on aarch64 there is no jump through memory, and
      # x18, the one register darwin reserves, is zeroed by the kernel on
      # any exception return. So that answer is a codegen decision — reserve
      # a register the way Go reserves R27 — and is recorded in GC_DESIGN.md
      # rather than faked here.
      def park_word(line : UInt64) : Pointer(Void)
        Pointer(Void).new(line + TF_PARK)
      end

      {% if flag?(:tf_park_sigsuspend) %}
        # A 32-bit darwin sigset with every signal but SIGUSR2 set.
        TF_SUSPEND_MASK = 0xBFFFFFFF_u64

        fun __tf_resume_handler(signal : Int32, info : Void*, context : Void*) : Nil
        end

        @[NoInline]
        @[Naked]
        fun __tf_resume_handler_address : UInt64
          asm("adrp x0, ___tf_resume_handler@PAGE
               add x0, x0, ___tf_resume_handler@PAGEOFF
               ret" :::: "volatile")
          0_u64
        end

        def park(line : UInt64) : Nil
          mask = TF_SUSPEND_MASK
          LibC.sigsuspend(pointerof(mask).as(Void*))
        end

        def take_parks(count : Int64) : Nil
        end

        def release_parks(count : Int64) : Nil
          index = 0_i64
          while index < count
            handle = Pointer(Void).new(__tf_load(Threads.line(index)))
            result = LibC.pthread_kill(handle, TF_SIGUSR2)
            fail("pthread_kill (resume) failed: #{result}") if result != 0
            index = index + 1_i64
          end
        end

        def install_parks(count : Int64) : Nil
          action = Pointer(UInt64).malloc(2_u64)
          action[0] = __tf_resume_handler_address
          action[1] = TF_SA_WORD
          result = LibC.sigaction(TF_SIGUSR2, action.as(Void*), Pointer(Void).new(0_u64))
          fail("sigaction (resume) failed: #{result}") if result != 0
        end
      {% elsif flag?(:tf_park_lock) %}
        def park(line : UInt64) : Nil
          LibC.os_unfair_lock_lock(park_word(line))
          LibC.os_unfair_lock_unlock(park_word(line))
        end

        def take_parks(count : Int64) : Nil
          index = 0_i64
          while index < count
            LibC.os_unfair_lock_lock(park_word(Threads.line(index)))
            index = index + 1_i64
          end
        end

        def release_parks(count : Int64) : Nil
          index = 0_i64
          while index < count
            LibC.os_unfair_lock_unlock(park_word(Threads.line(index)))
            index = index + 1_i64
          end
        end

        def install_parks(count : Int64) : Nil
        end
      {% elsif flag?(:tf_park_pipe) %}
        def park(line : UInt64) : Nil
          byte = uninitialized UInt8
          fd = (__tf_load(line + TF_PARK) & 0xFFFFFFFF_u64).to_i32
          while LibC.read(fd, pointerof(byte).as(Void*), 1_u64) != 1_i64
          end
        end

        def take_parks(count : Int64) : Nil
        end

        def release_parks(count : Int64) : Nil
          byte = 1_u8
          index = 0_i64
          while index < count
            fd = __tf_load(Threads.line(index) + TF_PARK).unsafe_shr(32_u64).to_i32
            fail("write (resume) failed") if LibC.write(fd, pointerof(byte).as(Void*), 1_u64) != 1_i64
            index = index + 1_i64
          end
        end

        def install_parks(count : Int64) : Nil
          fds = Pointer(Int32).malloc(2_u64)
          index = 0_i64
          while index < count
            fail("pipe failed") if LibC.pipe(fds) != 0
            __tf_store(Threads.line(index) + TF_PARK, fds[1].to_i64.to_u64.unsafe_shl(32_u64) | fds[0].to_i64.to_u64)
            index = index + 1_i64
          end
        end
      {% else %}
        def park(line : UInt64) : Nil
          while __tf_load(Threads.resume) == 0_u64
            LibC.os_sync_wait_on_address(Pointer(Void).new(Threads.resume), 0_u64, 8_u64, 0_u32)
          end
        end

        def take_parks(count : Int64) : Nil
          __tf_store(Threads.resume, 0_u64)
        end

        def release_parks(count : Int64) : Nil
          __tf_store(Threads.resume, 1_u64)
          LibC.os_sync_wake_by_address_all(Pointer(Void).new(Threads.resume), 8_u64, 0_u32)
        end

        def install_parks(count : Int64) : Nil
        end
      {% end %}

      # The interrupted sp is at most a few frames below the first frame's
      # local, and 64 KiB is well inside the 512 KiB a pthread's stack is,
      # so a neighbour's stack cannot pass.
      def stack_holds(line : UInt64, sp : UInt64) : Bool
        reference = __tf_load(line + 48_u64)
        sp <= reference && reference &- sp < 65536_u64
      end

      fun __tf_stop_handler(signal : Int32, info : Void*, context : Void*) : Nil
        __tf_add(Threads.suspended, 1_u64)
        here = uninitialized UInt64
        mcontext = Pointer(UInt64).new(context.address + TF_UC_MCONTEXT).value
        Threads.held(Pointer(UInt64).new(mcontext + TF_MC_SP).value,
          Pointer(UInt64).new(mcontext + TF_MC_PC).value, pointerof(here).address)
        park(Tls.line)
        __tf_add(Threads.resumed, 1_u64)
      end

      @[NoInline]
      @[Naked]
      fun __tf_stop_handler_address : UInt64
        asm("adrp x0, ___tf_stop_handler@PAGE
             add x0, x0, ___tf_stop_handler@PAGEOFF
             ret" :::: "volatile")
        0_u64
      end

      def install_stop_handler : Nil
        action = Pointer(UInt64).malloc(2_u64)
        action[0] = __tf_stop_handler_address
        {% if flag?(:tf_park_sigsuspend) %}
          action[1] = TF_SA_STOP_WORD
        {% else %}
          action[1] = TF_SA_WORD
        {% end %}
        result = LibC.sigaction(TF_SIGUSR1, action.as(Void*), Pointer(Void).new(0_u64))
        fail("sigaction failed: #{result}") if result != 0
        install_parks(Threads.count)
      end

      # One round: take every thread's park, signal every thread, wait until
      # every handler has counted itself in, then release every park and
      # wait until every handler has counted itself out. Answers the two
      # pause halves in ns.
      def stop_the_world : Tuple(Int64, Int64)
        __tf_store(Threads.suspended, 0_u64)
        __tf_store(Threads.resumed, 0_u64)
        count = Threads.count
        take_parks(count)

        started = __iyi_monotonic_ns
        index = 0_i64
        while index < count
          handle = Pointer(Void).new(__tf_load(Threads.line(index)))
          result = LibC.pthread_kill(handle, TF_SIGUSR1)
          fail("pthread_kill failed: #{result}") if result != 0
          index = index + 1_i64
        end
        while __tf_load(Threads.suspended) < count.to_u64
          yield_cpu
        end
        stopped = __iyi_monotonic_ns

        release_parks(count)
        while __tf_load(Threads.resumed) < count.to_u64
          yield_cpu
        end
        resumed = __iyi_monotonic_ns

        {stopped - started, resumed - stopped}
      end

    {% end %}

    def describe_threads : String
      "started by pthread_create, each with a thread id of its own"
    end

    def describe_join : String
      "every thread exited and was joined by pthread_join"
    end

    def describe_context : String
      "libSystem's ucontext"
    end

    def describe_thread_local : String
      "dyld's block per pthread, read through __tlv_bootstrap's thunk; every slot stayed its owner's"
    end
  {% end %}

  class Plain
    @@slot : UInt64 = 0_u64

    def self.slot : UInt64
      @@slot
    end

    def self.slot=(value : UInt64) : Nil
      @@slot = value
    end
  end

  @[NoInline]
  def bump_plain : UInt64
    Plain.slot = Plain.slot &+ 1_u64
    Plain.slot
  end

  @[NoInline]
  def bump_thread_local : UInt64
    Tls.slot = Tls.slot &+ 1_u64
    Tls.slot
  end

  # ── The run ─────────────────────────────────────────────────────────────
  # `thread_floor THREADS ROUNDS`; 4 and 200 unless told otherwise, so the
  # driver can ask how the pause scales with the count.
  args = Program.args
  count = args.size > 0 ? args[0].to_i.to_i64 : 4_i64
  rounds = args.size > 1 ? args[1].to_i.to_i64 : 200_i64
  fail("at least one thread") if count < 1_i64
  # The collector's trigger off: this probe's stop is its own, on the
  # collector's signal, with a handler of its own installed under it. A
  # collection the trigger ran would register the main thread and put
  # the collector's handler in this one's place, and the probe's stop
  # would wait for threads the collector had parked - which is what the
  # sigsuspend variant did on darwin once the trigger's first collection
  # ran beside the program.
  {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64))) %}
    IyiMark.auto = false
  {% end %}
  Threads.setup(count)
  own_tid = current_thread_id
  # The main thread's block is the loader's: its seed must be the image's
  # 7 too, and its slot is claimed now so a thread that wrote into it
  # would be caught below.
  fail("main thread's seed is #{Tls.seed.to_i64}, not the image's 7") if Tls.seed != 7_u64
  Tls.slot = own_tid.to_u64
  Plain.slot = own_tid.to_u64

  index = 0_i64
  while index < count
    start_thread(index)
    index = index + 1_i64
  end

  # Every thread reports a tid of its own, unlike this one's, and the same
  # one its parent's handle names, before anything else is measured — the
  # proof there are threads at all.
  index = 0_i64
  while index < count
    line = Threads.line(index)
    while __tf_load(line + 8_u64) == 0_u64
      yield_cpu
    end
    seen = __tf_load(line + 8_u64).to_i64
    named = thread_id_of(index)
    fail("thread #{index} read tid #{seen} for itself but its parent's handle names #{named}") if seen != named
    fail("thread #{index} has the main thread's tid") if seen == own_tid
    index = index + 1_i64
  end
  puts "threads: #{count} #{describe_threads}"

  install_stop_handler

  best_stop = 0_i64
  best_resume = 0_i64
  total_stop = 0_i64
  total_resume = 0_i64
  worst_stop = 0_i64
  round = 0_i64
  while round < rounds
    pair = stop_the_world
    stop_ns = pair[0]
    resume_ns = pair[1]
    best_stop = stop_ns if round == 0_i64 || stop_ns < best_stop
    best_resume = resume_ns if round == 0_i64 || resume_ns < best_resume
    worst_stop = stop_ns if stop_ns > worst_stop
    total_stop = total_stop + stop_ns
    total_resume = total_resume + resume_ns
    round = round + 1_i64
  end
  puts "stop-the-world: #{count} running threads, #{rounds} rounds"
  puts "  stop   best #{best_stop} ns  mean #{total_stop // rounds} ns  worst #{worst_stop} ns"
  puts "  resume best #{best_resume} ns  mean #{total_resume // rounds} ns"

  # The threads were running the whole time: every counter moved. And the
  # word they all added to holds exactly the sum of the words each added
  # to alone — the prelude's `Atomic(UInt64).add` under contention, which
  # a load-and-store in its place (`-Dtf_plain_add`) fails by losing
  # updates.
  __tf_store(Threads.stop, 1_u64)
  index = 0_i64
  turns = 0_u64
  while index < count
    join_thread(index)
    own = __tf_load(Threads.line(index) + 16_u64)
    fail("thread #{index} never ran its loop") if own == 0_u64
    turns = turns &+ own
    seed = __tf_load(Threads.line(index) + 24_u64)
    fail("thread #{index} found #{seed.to_i64} in its thread-local seed, not the image's 7") if seed != 7_u64
    fail("thread #{index} saw another thread's value in its own thread-local slot") if __tf_load(Threads.line(index) + 32_u64) != 0_u64
    index = index + 1_i64
  end
  puts "joined: #{describe_join}"
  shared = __tf_load(Threads.shared)
  fail("shared counter: #{count} threads added #{turns.to_i64} times to one word and it holds #{shared.to_i64}, so #{(turns &- shared).to_i64} updates were lost") if shared != turns
  puts "atomic: #{turns.to_i64} contended adds from #{count} threads landed as #{shared.to_i64}, none lost"
  {% if !flag?(:tf_mach) %}
    # Every handler read a context whose sp was its own thread's stack, and
    # the deepest any handler ran below the interrupted sp is the budget a
    # fiber stack must keep spare for a signal, or the case for a
    # `sigaltstack`.
    fail("#{__tf_load(Threads.astray).to_i64} handlers read a context whose sp was not their thread's stack") if __tf_load(Threads.astray) != 0_u64
    deepest = 0_u64
    index = 0_i64
    while index < count
      depth = __tf_load(Threads.line(index) + 56_u64)
      deepest = depth if depth > deepest
      index = index + 1_i64
    end
    fail("no handler recorded its depth") if deepest == 0_u64
    puts "held: every handler read its thread's sp and pc from #{describe_context}, sp on that thread's stack; a handler runs #{deepest.to_i64} bytes below the interrupted sp"
  {% end %}
  fail("the main thread's thread-local slot was overwritten") if Tls.slot != own_tid.to_u64
  puts "thread-local: #{describe_thread_local}"

  # ── What a touch costs ──────────────────────────────────────────────────
  # The runtime's cutover makes the scheduler's current fiber and the
  # allocator's fast path `@[ThreadLocal]`, so what one touch of such a
  # variable costs against a plain class variable is the price of that
  # spelling, per platform: a `tpidr_el0`/`%fs`-relative address on Linux,
  # a call through the descriptor's thunk on darwin. The touch is a
  # read-modify-write in its own @[NoInline] frame — a scheduler entry
  # point's shape, and a store is what keeps the optimiser from hoisting
  # the address out of the loop or summing the reads in closed form, which
  # it did to a pure read and measured nothing.
  touches = 10000000_i64
  started = __iyi_monotonic_ns
  index = 0_i64
  while index < touches
    bump_plain
    index = index + 1_i64
  end
  plain_ns = __iyi_monotonic_ns - started
  started = __iyi_monotonic_ns
  index = 0_i64
  while index < touches
    bump_thread_local
    index = index + 1_i64
  end
  local_ns = __iyi_monotonic_ns - started
  fail("the main thread's thread-local slot did not count") if Tls.slot != own_tid.to_u64 &+ touches.to_u64
  puts "touch: plain class variable #{plain_ns * 100_i64 // touches} / 100 ns, thread-local #{local_ns * 100_i64 // touches} / 100 ns, over #{touches} read-modify-writes"
  puts "every property held"
{% else %}
  puts "thread floor: measured on Linux x86_64 and aarch64 and on darwin aarch64; nothing to measure here"
{% end %}
