; iyi-ir 1
source_filename = "memset"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i64 @zero() {
entry:
  %slot = alloca { i64, i64 }, align 8
  intrinsic llvm.memset.p0.i64(ptr %slot, i8 0, i64 16, i1 false)
  %field = getelementptr { i64, i64 }, ptr %slot, i64 0, i32 1
  %value = load i64, ptr %field, align 8
  ret i64 %value
}
