; iyi-ir 1
source_filename = "tainted_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @tainted_keep(ptr %p, ptr %out) {
entry:
  %a = ptrtoint ptr %p to i64
  %b = ptrtoint ptr %p to i64
  %x = add i64 %a, 8
  %y = add i64 %b, 8
  store i64 %x, ptr %out, align 8
  store i64 %y, ptr %out, align 8
  ret void
}
