; iyi-ir 1
source_filename = "escape_indirect_nonrecursive"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @target(i64 %n) {
entry:
  ret i64 %n
}
define internal i64 @caller(ptr %f, i64 %n) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 1, i64 2)
  %next = call i64 (i64) %f(i64 %n)
  %v = load i64, ptr %p, align 8
  %sum = add i64 %v, %next
  ret i64 %sum
}
define internal i64 @start(i64 %n) {
entry:
  %result = call i64 (ptr, i64) @caller(ptr @target, i64 %n)
  ret i64 %result
}
