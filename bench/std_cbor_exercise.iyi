refused("fb3ff8000000000000", "the float 1.5 in 9 bytes, where 3 hold it at byte 0", true)
refused("fb3ff0000020000000", "the float 1.0000001192092896 in 9 bytes, where 5 hold it at byte 0", true)
refused("fb7ff8000000000000", "the float NaN in 9 bytes, where 3 hold it at byte 0", true)
refused("9f01ff", "an array of indefinite length, which deterministic encoding does not use at byte 0", true)
refused("bf6161f5ff", "a map of indefinite length, which deterministic encoding does not use at byte 0", true)
refused("5f4101ff", "a byte string of indefinite length, which deterministic encoding does not use at byte 0", true)
refused("7f6161ff", "a text string of indefinite length, which deterministic encoding does not use at byte 0", true)
refused("a2616201616102", "the map key \"a\" sorts before the key ahead of it at byte 4", true)
refused("a2200a186401", "the map key 100 sorts before the key ahead of it at byte 3", true)
refused("a281200281186401", "the map key [100] sorts before the key ahead of it at byte 4", true)
refused("c24101", "the integer 1 as tag 2, where deterministic encoding writes one that fits 64 bits as major type 0 at byte 0", true)
refused("c348ffffffffffffffff", "the integer -18446744073709551616 as tag 3, where deterministic encoding writes one that fits 64 bits as major type 1 at byte 0", true)
refused("c24a00010000000000000000", "a bignum with a leading zero byte, which deterministic encoding leaves out at byte 1", true)
refused("a201010102", "the map key 1 written twice at byte 3", true)
refused("a201010102", "the map key 1 written twice at byte 3")
refused("a2820102f4820102f5", "the map key [1, 2] written twice at byte 5")
refused("a2f97e00f4fb7ff8000000000000f5", "the map key NaN written twice at byte 5")
assert_true(decoded(unhex("a2f90000f4f98000f5"), "0.0 and -0.0 as keys").size == 2, "0.0 and -0.0 are two keys")
refused("c26161", "tag 2 (a bignum) around a text string, not a byte string at byte 1")
refused("c380", "tag 3 (a bignum) around an array, not a byte string at byte 1")
refused("9f1817ff", "an array of indefinite length, which deterministic encoding does not use at byte 0", true)
deterministic_read = CBOR.decode(unhex("a26161016162820203"), deterministic: true)
assert_true(deterministic_read.is_a?(Any) && deterministic_read.to_s == "{\"a\": 1, \"b\": [2, 3]}", "deterministic bytes read as they always do")
assert_true(!CBOR.deterministic?(unhex("9f01ff")) && CBOR.decode?(unhex("9f01ff")).to_s == "[_ 1]", "what is not deterministic still decodes when not asked")
assert_str("the data ends before the break that closes an indefinite-length map at byte 5", (CBOR.decode(unhex("bf01020102")).as(CBORError)).message, "a well-formedness error is answered before a key written twice")
puts "  section 4.2.1's key order; a longer head, a wider float, an indefinite length, keys out of order and a bignum not preferred, each refused where it is"

