# ENV: hash-like accessor for process environment variables.
#
# Provides retrieval, modification, deletion, iteration, and inspection
# of environment variables without external C libraries.

module std/env

{% if flag?(:darwin) %}
  lib LibSystem
    fun setenv(name : UInt8*, value : UInt8*, overwrite : Int32) : Int32
    fun getenv(name : UInt8*) : UInt8*
    fun unsetenv(name : UInt8*) : Int32
  end
{% elsif flag?(:win32) %}
  lib LibKernel32
    fun SetEnvironmentVariableA(name : UInt8*, value : UInt8*) : Int32
    fun GetEnvironmentVariableA(name : UInt8*, buffer : UInt8*, size : UInt32) : UInt32
  end
{% else %}
  lib LibC
    fun setenv(name : UInt8*, value : UInt8*, overwrite : Int32) : Int32
    fun getenv(name : UInt8*) : UInt8*
    fun unsetenv(name : UInt8*) : Int32
  end
{% end %}

pub struct ENV
  def self.[](key : String) : String
    val = self[key]?
    if val
      val
    else
      raise "Missing ENV key: #{key}"
    end
  end

  def self.[]?(key : String) : String?
    {% if flag?(:wasm32) %}
      nil
    {% elsif flag?(:darwin) %}
      ptr = LibSystem.getenv(c_str(key))
      if ptr.address == 0_u64
        nil
      else
        string_from_c(ptr)
      end
    {% elsif flag?(:win32) %}
      buf = Pointer(UInt8).malloc(4096_u64)
      res = LibKernel32.GetEnvironmentVariableA(c_str(key), buf, 4096_u32)
      if res == 0_u32
        nil
      else
        String.new(res.to_i) { |t| t.copy_from(buf, res.to_i) }
      end
    {% else %}
      ptr = LibC.getenv(c_str(key))
      if ptr.address == 0_u64
        nil
      else
        string_from_c(ptr)
      end
    {% end %}
  end

  def self.[]=(key : String, value : String?) : String?
    if value == nil
      delete(key)
      nil
    else
      v_str = value
      {% if flag?(:wasm32) %}
        # noop on wasm
      {% elsif flag?(:darwin) %}
        LibSystem.setenv(c_str(key), c_str(v_str), 1)
      {% elsif flag?(:win32) %}
        LibKernel32.SetEnvironmentVariableA(c_str(key), c_str(v_str))
      {% else %}
        LibC.setenv(c_str(key), c_str(v_str), 1)
      {% end %}
      v_str
    end
  end

  def self.has_key?(key : String) : Bool
    self[key]? != nil
  end

  def self.fetch(key : String) : String
    self[key]
  end

  def self.fetch(key : String, default : T) : String | T forall T
    val = self[key]?
    if val
      val
    else
      default
    end
  end

  def self.fetch(key : String, &block : String -> T) : String | T forall T
    val = self[key]?
    if val
      val
    else
      yield key
    end
  end

  def self.delete(key : String) : String?
    old_val = self[key]?
    {% if flag?(:wasm32) %}
      # noop on wasm
    {% elsif flag?(:darwin) %}
      LibSystem.unsetenv(c_str(key))
    {% elsif flag?(:win32) %}
      LibKernel32.SetEnvironmentVariableA(c_str(key), Pointer(UInt8).new(0_u64))
    {% else %}
      LibC.unsetenv(c_str(key))
    {% end %}
    old_val
  end

  def self.clear : Nil
    keys.each do |k|
      delete(k)
    end
  end

  def self.each(&block : String, String -> Nil) : Nil
    {% if flag?(:wasm32) %}
      return
    {% else %}
      ptr = LibIyiEnv.environ
      return if ptr.address == 0_u64

      index = 0
      while (entry = ptr[index]).address != 0_u64
        # Find entry length and '=' separator
        len = 0
        eq_pos = -1
        while entry[len] != 0_u8
          if eq_pos == -1 && entry[len] == 61_u8 # '='
            eq_pos = len
          end
          len = len + 1
        end

        if eq_pos > 0
          k = String.new(eq_pos) { |t| t.copy_from(entry, eq_pos) }
          v_len = len - eq_pos - 1
          v = String.new(v_len) { |t| t.copy_from(entry + eq_pos + 1, v_len) }
          yield k, v
        end
        index = index + 1
      end
    {% end %}
  end

  def self.each_key(&block : String -> Nil) : Nil
    each do |k, _|
      yield k
    end
  end

  def self.each_value(&block : String -> Nil) : Nil
    each do |_, v|
      yield v
    end
  end

  def self.keys : Array(String)
    res = [] of String
    each do |k, _|
      res << k
    end
    res
  end

  def self.values : Array(String)
    res = [] of String
    each do |_, v|
      res << v
    end
    res
  end

  def self.to_h : Hash(String, String)
    res = {} of String => String
    each do |k, v|
      res[k] = v
    end
    res
  end

  def self.empty? : Bool
    size == 0
  end

  def self.size : Int32
    count = 0
    each do |_, _|
      count = count + 1
    end
    count
  end

  private def self.c_str(str : String) : UInt8*
    n = str.bytesize
    buf = Pointer(UInt8).malloc((n + 1).to_u64)
    buf.copy_from(str.to_unsafe, n)
    buf[n] = 0_u8
    buf
  end

  private def self.string_from_c(ptr : UInt8*) : String
    len = 0
    while ptr[len] != 0_u8
      len = len + 1
    end
    String.new(len) do |target|
      target.copy_from(ptr, len)
    end
  end
end

# Reopen top-level ENV module alias
module ::ENV
  def self.[](key : String) : String
    Std::Env::ENV[key]
  end

  def self.[]?(key : String) : String?
    Std::Env::ENV[key]?
  end

  def self.[]=(key : String, value : String?) : String?
    Std::Env::ENV[key] = value
  end

  def self.has_key?(key : String) : Bool
    Std::Env::ENV.has_key?(key)
  end

  def self.fetch(key : String) : String
    Std::Env::ENV.fetch(key)
  end

  def self.fetch(key : String, default : T) : String | T forall T
    Std::Env::ENV.fetch(key, default)
  end

  def self.delete(key : String) : String?
    Std::Env::ENV.delete(key)
  end

  def self.keys : Array(String)
    Std::Env::ENV.keys
  end

  def self.values : Array(String)
    Std::Env::ENV.values
  end

  def self.to_h : Hash(String, String)
    Std::Env::ENV.to_h
  end

  def self.each(&block : String, String -> Nil) : Nil
    Std::Env::ENV.each(&block)
  end

  def self.size : Int32
    Std::Env::ENV.size
  end

  def self.empty? : Bool
    Std::Env::ENV.empty?
  end
end
