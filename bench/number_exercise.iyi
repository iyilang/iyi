# The prelude's numbers at their edges - SPEC.md, "0.1.0", item 3.
#
#     bash bench/number_exercise.sh
#
# Three questions, each one a place where a number stops behaving like the
# mathematics and starts behaving like a machine word:
#
#   1. A value printed is a value read back, including the smallest one.
#      `Int32::MIN` has no positive twin, so a parser that accumulates the
#      magnitude and negates it cannot read what `to_s` wrote.
#   2. A string too large for the type answers `nil` rather than panicking,
#      because that is what the `?` in `to_i?` promises.
#   3. `//` and `%` agree with each other, and the two divisions that leave
#      the type - a zero divisor, and `MIN // -1` - are reported rather than
#      left to the processor, which calls an integer divide a floating-point
#      fault and kills the program.
#
# Exits non-zero at the first check that does not hold.
module main

def assert_true(condition : Bool, msg : String) : Nil
  raise "assert failed: #{msg}" unless condition
end

def assert_int(actual : Int32, expected : Int32, msg : String) : Nil
  raise "assert failed: #{msg} (#{actual} != #{expected})" unless actual == expected
end

def assert_str(actual : String, expected : String, msg : String) : Nil
  raise "assert failed: #{msg} (#{actual} != #{expected})" unless actual == expected
end

# ---- 1. Printed and read back, at the bounds
assert_str((-2147483648).to_s, "-2147483648", "number: int32 min prints")
assert_str(2147483647.to_s, "2147483647", "number: int32 max prints")
assert_int("-2147483648".to_i, -2147483648, "number: int32 min reads back")
assert_int("2147483647".to_i, 2147483647, "number: int32 max reads back")
assert_int((-2147483648).to_s.to_i, -2147483648, "number: int32 min round trip")
assert_str((-9223372036854775808_i64).to_s, "-9223372036854775808", "number: int64 min prints")
assert_str(9223372036854775807_i64.to_s, "9223372036854775807", "number: int64 max prints")
assert_str(18446744073709551615_u64.to_s, "18446744073709551615", "number: uint64 max prints")

# The ordinary ones, so a broken parser cannot pass by refusing everything.
assert_int("0".to_i, 0, "number: zero reads")
assert_int("-0".to_i, 0, "number: minus zero reads")
assert_int("123".to_i, 123, "number: a number reads")
assert_int("-123".to_i, -123, "number: a negative reads")
# `+5` is a number in every library, and it was nil here while `"+5".to_f`
# and `std/text`'s `to_i?(base)` read it - one name, two answers.
assert_int("+123".to_i, 123, "number: a plus sign reads")
assert_true("+".to_i? == nil, "number: a lone plus is nil")

# ---- 2. What does not fit says so
assert_true("2147483648".to_i? == nil, "number: max plus one is nil")
assert_true("-2147483649".to_i? == nil, "number: min minus one is nil")
assert_true("99999999999999999999".to_i? == nil, "number: far too large is nil")
assert_true("12abc".to_i? == nil, "number: trailing letters are nil")
assert_true("".to_i? == nil, "number: empty is nil")
assert_true("-".to_i? == nil, "number: a lone sign is nil")

# ---- 3. Division and remainder, which have to agree with each other
assert_int(7 // 2, 3, "number: division truncates")
assert_int(-7 // 2, -3, "number: division truncates toward zero")
assert_int(7 // -2, -3, "number: a negative divisor truncates")
assert_int(-7 % 2, -1, "number: remainder takes the dividend's sign")
assert_int(7 % -2, 1, "number: remainder ignores the divisor's sign")
assert_int((-7 // 2) * 2 + (-7 % 2), -7, "number: division identity, negative dividend")
assert_int((7 // -2) * -2 + (7 % -2), 7, "number: division identity, negative divisor")
assert_true((-7_i64 // 2_i64) * 2_i64 + (-7_i64 % 2_i64) == -7_i64, "number: int64 identity")

# The two divisions that leave the type are panics, so they are driven from
# `bench/number_exercise.sh` rather than from here: a program that panics
# has no next line to assert on. What belongs here is the remainder beside
# them, which is zero and fits: the answer is written
# rather than the fault the processor would raise underneath it.
assert_int(-2147483648 % -1, 0, "number: min remainder minus one is zero")
assert_true((-9223372036854775808_i64 % -1_i64) == 0_i64, "number: int64 min remainder is zero")

# ---- 4. Base conversion, the other direction of printing
assert_str(255.to_s(16), "ff", "number: hex")
assert_str(5.to_s(2), "101", "number: binary")
assert_str((-255).to_s(16), "-ff", "number: a negative in hex")
assert_str(35.to_s(36), "z", "number: base 36")
assert_str((-2147483648).to_s(16), "-80000000", "number: int32 min in hex")

# ---- 5. The floats, whose edges are values rather than bounds
#
# Probed and found already right, so these are here to keep it that way:
# each one is a property a program reads without thinking about it, and the
# conversions below are checked by the compiler rather than by this file.
nan = 0.0 / 0.0
inf = 1.0 / 0.0

assert_str(nan.to_s, "NaN", "number: nan prints as NaN")
assert_str(inf.to_s, "Infinity", "number: infinity prints")
assert_str((0.0 - inf).to_s, "-Infinity", "number: negative infinity prints")
assert_str((-0.0).to_s, "-0.0", "number: negative zero keeps its sign")

# NaN is the one value that is not itself, and `-0.0` is two values that are
# one. A `Hash` has to agree with both.
assert_true((nan == nan) == false, "number: nan is not itself")
assert_true(-0.0 == 0.0, "number: negative zero equals zero")
assert_true((nan < 1.0) == false, "number: nan is not less")
assert_true((nan > 1.0) == false, "number: nan is not greater")

floats = {} of Float64 => String
floats[0.0] = "zero"
assert_str(floats[-0.0]? || "missing", "zero", "number: negative zero finds zero")
floats[nan] = "nan"
assert_true(floats[nan]? == nil, "number: nan cannot be found again")
assert_int(floats.size, 2, "number: nan took a slot it cannot answer for")

# A comparison sort given a value that answers no to every comparison has to
# come back, and with everything it was handed.
assert_int([1.0, nan, 0.5].sorted.size, 3, "number: sorting with nan keeps the count")

# Toward zero, the same direction `//` takes.
assert_int(2.9.to_i, 2, "number: to_i truncates")
assert_int((-2.9).to_i, -2, "number: to_i truncates toward zero")
assert_true((-1.5).floor == -2.0, "number: floor goes down")
assert_true((-1.5).ceil == -1.0, "number: ceil goes up")
# A tie goes to the even integer, Crystal's `round` (SPEC.md III.1.7a); the
# nearest is read off the fraction, so the double under a half is not moved
# by a sum that rounds first; and a negative place count rounds to tens.
assert_true(0.49999999999999994.round == 0.0, "number: round reads the fraction, not a sum")
assert_true(2.5.round == 2.0 && 3.5.round == 4.0, "number: a tie rounds to the even integer")
assert_true((-2.5).round == -2.0 && (-3.5).round == -4.0, "number: round is symmetric")
assert_true(25.0.round(-1) == 20.0 && 1234.0.round(-2) == 1200.0, "number: round to tens and hundreds")

# The shortest text at the ends of the range, where the printer's numbers
# are largest - each is sized to the double in hand, and grows past the
# estimate rather than writing beyond it - and at a power of two, whose
# neighbour below is nearer than the one above. The other library's text,
# every one.
[{5e-324, "5.0e-324"}, {1.0e-323, "1.0e-323"}, {3.0e-310, "3.0e-310"},
 {2.2250738585072014e-308, "2.2250738585072014e-308"},
 {2.225073858507201e-308, "2.225073858507201e-308"},
 {1.7976931348623157e308, "1.7976931348623157e+308"},
 {1.7976931348623155e308, "1.7976931348623155e+308"},
 {8.98846567431158e307, "8.98846567431158e+307"},
 {1.0e-300, "1.0e-300"}, {1.0e23, "1.0e+23"}, {0.1, "0.1"},
 {1.0e15, "1.0e+15"}, {1.0e16, "1.0e+16"},
 {123456789012345680.0, "1.2345678901234568e+17"},
 {1.7800590868057611e-307, "1.7800590868057611e-307"},
 {7.120236347223045e-307, "7.120236347223045e-307"},
 {1.8446744073709552e19, "1.8446744073709552e+19"},
 {3.6893488147419103e19, "3.6893488147419103e+19"}].each do |pair|
  assert_str(pair[0].to_s, pair[1], "number: shortest text at the range's ends")
end

# ---- 6. The unchecked conversion, which is a name
#
# Crystal spells it `to_u8!`, and `!` is not part of a name in iyi
# (SPEC.md III.1.7): `x.to_u8!` reads as `x.to_u8` with its error
# propagated, which the compiler refuses. So the prelude's unchecked
# conversions were reachable only from macro-expanded code, which was
# reparsed by the other language's rules — the accident that also stopped
# any macro from generating `!`. They are `unsafe_to_u8` now, beside the
# `unsafe_chr` the prelude already had, and these are the values the
# checked forms panic on: the instruction keeps the low bits.
assert_int(300.unsafe_to_u8.to_i, 44, "number: unchecked keeps the low byte")
assert_int((-1).unsafe_to_u8.to_i, 255, "number: unchecked wraps a negative")
assert_int(4294967295_u64.unsafe_to_i32, -1, "number: unchecked reinterprets the bits")
# What Winsock needs: `-1` as a handle is `INVALID_SOCKET`, and the checked
# conversion panics on it rather than answering.
assert_true((-1_i64).unsafe_to_u64 == 18446744073709551615_u64,
  "number: unchecked makes -1 the widest value")

puts "all number checks passed"
