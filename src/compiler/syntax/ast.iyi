pub class Block < ASTNode
  property args : Array(Var)
  property body : ASTNode
  property splat_index : Int32?
  property unpacks : Hash(Int32, Expressions)? = nil

  def initialize(@args : Array(Var) = [] of Var, body : ASTNode? = nil, @splat_index : Int32? = nil, @unpacks : Hash(Int32, Expressions)? = nil)
    @body = body || Nop.new
  end

  def clone_without_location : self
    cloned_args = @args.map { |a| a.clone.as(Var) }
    cloned_unpacks = if u = @unpacks
                       cu = Hash(Int32, Expressions).new
                       u.each { |k, v| cu[k] = v.clone.as(Expressions) }
                       cu
                     else
                       nil
                     end
    Block.new(cloned_args, @body.clone, @splat_index, cloned_unpacks)
  end

  def accept_children(visitor) : Nil
    @args.each { |a| a.accept(visitor) }
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    (@args == other.args) && (@body == other.body) && (@splat_index == other.splat_index)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@args)
    h = 31 &* h &+ hash_val(@body)
    h = 31 &* h &+ hash_val(@splat_index)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "do"
    if @args.size > 0
      sb << " |"
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        sb << "*" if @splat_index == i
        @args[i].to_s(sb)
        i = i + 1
      end
      sb << "|"
    end
    sb << "
  "
    @body.to_s(sb)
    sb << "
end"
  end
end

pub class Call < ASTNode
  property obj : ASTNode?
  property name : String
  property args : Array(ASTNode)
  property block : Block?
  property block_arg : ASTNode?
  property named_args : Array(NamedArgument)?
  property has_parentheses : Bool = false
  property name_location : Location? = nil
  property global : Bool = false
  property iyi_group : Bool = false
  property expanded : ASTNode? = nil

  def initialize(
    @obj : ASTNode? = nil,
    @name : String = "",
    @args : Array(ASTNode) = [] of ASTNode,
    @block : Block? = nil,
    @block_arg : ASTNode? = nil,
    @named_args : Array(NamedArgument)? = nil,
    @has_parentheses : Bool = false,
    @name_location : Location? = nil,
    @global : Bool = false,
    @iyi_group : Bool = false,
    @expanded : ASTNode? = nil,
  )
  end
  def self.new(obj : ASTNode?, name : String, arg : ASTNode) : Call
    new(obj, name, [arg] of ASTNode)
  end

  def self.global(name : String, arg : ASTNode? = nil) : Call
    if a = arg
      new(nil, name, [a] of ASTNode, nil, nil, nil, false, nil, true)
    else
      new(nil, name, [] of ASTNode, nil, nil, nil, false, nil, true)
    end
  end

  def has_parentheses? : Bool
    @has_parentheses
  end

  def super? : Bool
    @name == "super"
  end

  def previous_def? : Bool
    @name == "previous_def"
  end

  def iyi_group? : Bool
    @iyi_group
  end

  def clone_without_location : self
    if b = @block
      cloned_block = b.clone.as(Block)
    else
      cloned_block = nil
    end
    if na = @named_args
      cloned_named_args = na.map { |a| a.clone.as(NamedArgument) }
    else
      cloned_named_args = nil
    end
    Call.new(
      clone_node(@obj),
      @name,
      clone_nodes(@args),
      cloned_block,
      clone_node(@block_arg),
      cloned_named_args,
      @has_parentheses,
      @name_location,
      @global,
      @iyi_group,
      clone_node(@expanded),
    )
  end
  def accept_children(visitor) : Nil
    if o = @obj
      o.accept(visitor)
    end
    @args.each { |a| a.accept(visitor) }
    if b = @block
      b.accept(visitor)
    end
    if ba = @block_arg
      ba.accept(visitor)
    end
    if na = @named_args
      na.each { |a| a.accept(visitor) }
    end
  end

  def ==(other : self) : Bool
    (@obj == other.obj) && (@name == other.name) && (@args == other.args) && (@block == other.block) && (@block_arg == other.block_arg) && (@named_args == other.named_args)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@obj)
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@args)
    h = 31 &* h &+ hash_val(@block)
    h = 31 &* h &+ hash_val(@block_arg)
    h = 31 &* h &+ hash_val(@named_args)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    if o = @obj
      o.to_s(sb)
      sb << "."
    end
    sb << @name
    if @args.size > 0 || @named_args || @block_arg
      sb << "("
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        @args[i].to_s(sb)
        i = i + 1
      end
      if na = @named_args
        j = 0
        while j < na.size
          sb << ", " if @args.size > 0 || j > 0
          na[j].to_s(sb)
          j = j + 1
        end
      end
      if ba = @block_arg
        has_prev = @args.size > 0
        if na = @named_args
          has_prev = true if na.size > 0
        end
        sb << ", " if has_prev
        sb << "&"
        ba.to_s(sb)
      end
      sb << ")"
    end
    if b = @block
      sb << " "
      b.to_s(sb)
    end
  end
end

pub class Arg < ASTNode
  property name : String
  property default_value : ASTNode?
  property restriction : ASTNode?
  # The front end resolves this once, at construction, and stores a plain
  # String: an argument with no external name is externally its own name.
  # A nilable field with a getter that filled the name in instead reads the
  # same from outside and compares differently from inside, which is exactly
  # what `==` below did: ivar on one side, getter on the other.
  property external_name : String

  def initialize(@name : String, @default_value : ASTNode? = nil, @restriction : ASTNode? = nil, external_name : String? = nil)
    @external_name = external_name || @name
  end

  def clone_without_location : self
    Arg.new(@name, clone_node(@default_value), clone_node(@restriction), @external_name)
  end

  def accept_children(visitor) : Nil
    if d = @default_value
      d.accept(visitor)
    end
    if r = @restriction
      r.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@default_value == other.default_value) && (@restriction == other.restriction) && (@external_name == other.external_name)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@default_value)
    h = 31 &* h &+ hash_val(@restriction)
    h = 31 &* h &+ hash_val(@external_name)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    if ext = @external_name
      sb << ext << " "
    end
    sb << @name
    if r = @restriction
      sb << " : "
      r.to_s(sb)
    end
    if d = @default_value
      sb << " = "
      d.to_s(sb)
    end
  end
end

pub class ProcNotation < ASTNode
  property inputs : Array(ASTNode)?
  property output : ASTNode?

  def initialize(@inputs : Array(ASTNode)? = nil, @output : ASTNode? = nil)
  end

  def clone_without_location : self
    cloned_inputs = clone_opt_nodes(@inputs)
    ProcNotation.new(cloned_inputs, clone_node(@output))
  end

  def accept_children(visitor) : Nil
    if inp = @inputs
      inp.each { |i| i.accept(visitor) }
    end
    if out = @output
      out.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    (@inputs == other.inputs) && (@output == other.output)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@inputs)
    h = 31 &* h &+ hash_val(@output)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    if inp = @inputs
      if inp.size == 1
        inp[0].to_s(sb)
      else
        sb << "("
        i = 0
        while i < inp.size
          sb << ", " if i > 0
          inp[i].to_s(sb)
          i = i + 1
        end
        sb << ")"
      end
    end
    sb << " -> "
    if out = @output
      out.to_s(sb)
    else
      sb << "Nil"
    end
  end
end

pub class ProcLiteral < ASTNode
  property def : Def

  def initialize(a_def : Def? = nil)
    @def = a_def || Def.new("->")
  end

  def clone_without_location : self
    ProcLiteral.new(@def.clone.as(Def))
  end

  def accept_children(visitor) : Nil
    @def.accept(visitor)
  end

  def ==(other : self) : Bool
    @def == other.def
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    31 &* 17 &+ @def.hash
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "->"
    if @def.args.size > 0
      sb << "("
      i = 0
      while i < @def.args.size
        sb << ", " if i > 0
        @def.args[i].to_s(sb)
        i = i + 1
      end
      sb << ")"
    end
    sb << " do
  "
    @def.body.to_s(sb)
    sb << "
end"
  end
end

pub class ProcPointer < ASTNode
  property obj : ASTNode?
  property name : String
  property args : Array(ASTNode)
  property global : Bool

  def initialize(@obj : ASTNode? = nil, @name : String = "", @args : Array(ASTNode) = [] of ASTNode, @global : Bool = false)
  end

  def clone_without_location : self
    ProcPointer.new(clone_node(@obj), @name, clone_nodes(@args), @global)
  end

  def accept_children(visitor) : Nil
    if o = @obj
      o.accept(visitor)
    end
    @args.each { |a| a.accept(visitor) }
  end

  def ==(other : self) : Bool
    (@obj == other.obj) && (@name == other.name) && (@args == other.args) && (@global == other.global)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@obj)
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@args)
    h = 31 &* h &+ hash_val(@global)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "->"
    if o = @obj
      o.to_s(sb)
      sb << "."
    elsif @global
      sb << "::"
    end
    sb << @name
    if @args.size > 0
      sb << "("
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        @args[i].to_s(sb)
        i = i + 1
      end
      sb << ")"
    end
  end
end

pub class Def < ASTNode
  property name : String
  property args : Array(Arg)
  property body : ASTNode
  property receiver : ASTNode?
  property block_arg : Arg?
  property return_type : ASTNode?
  property macro_def : Bool
  property abstract : Bool
  property splat_index : Int32?
  property double_splat : Arg?
  property free_vars : Array(String)?
  property uses_block_arg : Bool = false

  def uses_block_arg? : Bool
    @uses_block_arg
  end

  def initialize(
    @name : String = "",
    @args : Array(Arg) = [] of Arg,
    body : ASTNode? = nil,
    @receiver : ASTNode? = nil,
    @block_arg : Arg? = nil,
    @return_type : ASTNode? = nil,
    @macro_def : Bool = false,
    @abstract : Bool = false,
    @splat_index : Int32? = nil,
    @double_splat : Arg? = nil,
    @free_vars : Array(String)? = nil,
    @uses_block_arg : Bool = false,
  )
    @body = body || Nop.new
  end

  def clone_without_location : self
    cloned_args = @args.map { |a| a.clone.as(Arg) }
    d = Def.new(
      @name,
      cloned_args,
      @body.clone,
      clone_node(@receiver),
      (if ba = @block_arg
        ba.clone.as(Arg)
      else
        nil
      end),
      clone_node(@return_type),
      @macro_def,
      @abstract,
      @splat_index,
      (if ds = @double_splat
        ds.clone.as(Arg)
      else
        nil
      end),
      clone_opt_strings(@free_vars),
    )
    d.uses_block_arg = @uses_block_arg
    d
  end

  def accept_children(visitor) : Nil
    if r = @receiver
      r.accept(visitor)
    end
    @args.each { |a| a.accept(visitor) }
    if ds = @double_splat
      ds.accept(visitor)
    end
    if ba = @block_arg
      ba.accept(visitor)
    end
    if rt = @return_type
      rt.accept(visitor)
    end
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    @name == other.name && @args == other.args && @body == other.body &&
      @receiver == other.receiver && @block_arg == other.block_arg &&
      @return_type == other.return_type && @macro_def == other.macro_def &&
      @abstract == other.abstract && @splat_index == other.splat_index &&
      @double_splat == other.double_splat && @free_vars == other.free_vars
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @name.hash
    h = 31 &* h &+ @args.hash
    h = 31 &* h &+ @body.hash
    h = 31 &* h &+ (@abstract ? 1 : 0)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "abstract " if @abstract
    sb << "def "
    if r = @receiver
      r.to_s(sb)
      sb << "."
    end
    sb << @name
    if @args.size > 0 || @double_splat || @block_arg
      sb << "("
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        sb << "*" if @splat_index == i
        @args[i].to_s(sb)
        i = i + 1
      end
      if ds = @double_splat
        sb << ", " if @args.size > 0
        sb << "**"
        ds.to_s(sb)
      end
      if ba = @block_arg
        sb << ", " if @args.size > 0 || @double_splat
        sb << "&"
        ba.to_s(sb)
      end
      sb << ")"
    end
    if rt = @return_type
      sb << " : "
      rt.to_s(sb)
    end
    unless @abstract
      sb << "
  "
      @body.to_s(sb)
      sb << "
end"
    end
  end
end

pub class ClassDef < ASTNode
  property name : Path
  property body : ASTNode
  property superclass : ASTNode?
  property type_vars : Array(String)?
  property abstract : Bool
  property struct : Bool
  property splat_index : Int32?

  def initialize(
    @name : Path = Path.new(""),
    body : ASTNode? = nil,
    @superclass : ASTNode? = nil,
    @type_vars : Array(String)? = nil,
    @abstract : Bool = false,
    @struct : Bool = false,
    @splat_index : Int32? = nil,
  )
    @body = body || Nop.new
  end

  def clone_without_location : self
    ClassDef.new(
      @name.clone.as(Path),
      @body.clone,
      clone_node(@superclass),
      clone_opt_strings(@type_vars),
      @abstract,
      @struct,
      @splat_index
    )
  end

  def accept_children(visitor) : Nil
    @name.accept(visitor)
    if sc = @superclass
      sc.accept(visitor)
    end
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    @name == other.name && @body == other.body && @superclass == other.superclass &&
      @type_vars == other.type_vars && @abstract == other.abstract &&
      @struct == other.struct && @splat_index == other.splat_index
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @name.hash
    h = 31 &* h &+ @body.hash
    h = 31 &* h &+ hash_val(@superclass)
    h = 31 &* h &+ (@abstract ? 1 : 0)
    h = 31 &* h &+ (@struct ? 1 : 0)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "abstract " if @abstract
    sb << (@struct ? "struct " : "class ")
    @name.to_s(sb)
    if tv = @type_vars
      sb << "("
      i = 0
      while i < tv.size
        sb << ", " if i > 0
        sb << "*" if @splat_index == i
        sb << tv[i]
        i = i + 1
      end
      sb << ")"
    end
    if sc = @superclass
      sb << " < "
      sc.to_s(sb)
    end
    sb << "
  "
    @body.to_s(sb)
    sb << "
end"
  end
end

