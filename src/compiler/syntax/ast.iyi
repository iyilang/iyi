pub class Path < ASTNode
  property names : Array(String)
  property global : Bool

  def initialize(@names : Array(String) = [] of String, @global : Bool = false)
  end

  def self.new(name : String) : Path
    new([name], false)
  end

  def self.global(names : Array(String)) : Path
    new(names, true)
  end

  def self.global(name : String) : Path
    new([name] of String, true)
  end

  def clone_without_location : self
    Path.new(@names.dup, @global)
  end

  def ==(other : self) : Bool
    (@names == other.names) && (@global == other.global)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@names)
    h = 31 &* h &+ hash_val(@global)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "::" if @global
    i = 0
    while i < @names.size
      sb << "::" if i > 0
      sb << @names[i]
      i = i + 1
    end
  end
end

pub class Generic < ASTNode
  pub enum Suffix
    None
    Question
    Bang
  end

  property name : ASTNode
  property type_vars : Array(ASTNode)
  property named_args : Array(NamedArgument)?
  property suffix : Suffix

  def initialize(@name : ASTNode, @type_vars : Array(ASTNode) = [] of ASTNode, @named_args : Array(NamedArgument)? = nil, @suffix : Suffix = Suffix::None)
  end

  def clone_without_location : self
    if na = @named_args
      cloned_named_args = na.map { |a| a.clone.as(NamedArgument) }
    else
      cloned_named_args = nil
    end
    Generic.new(@name.clone, clone_nodes(@type_vars), cloned_named_args, @suffix)
  end

  def accept_children(visitor) : Nil
    @name.accept(visitor)
    @type_vars.each { |tv| tv.accept(visitor) }
    if na = @named_args
      na.each { |a| a.accept(visitor) }
    end
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@type_vars == other.type_vars) && (@named_args == other.named_args) && (@suffix == other.suffix)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@type_vars)
    h = 31 &* h &+ hash_val(@named_args)
    h = 31 &* h &+ hash_val(@suffix)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    @name.to_s(sb)
    sb << "("
    i = 0
    while i < @type_vars.size
      sb << ", " if i > 0
      @type_vars[i].to_s(sb)
      i = i + 1
    end
    if na = @named_args
      j = 0
      while j < na.size
        sb << ", " if @type_vars.size > 0 || j > 0
        na[j].to_s(sb)
        j = j + 1
      end
    end
    sb << ")"
    case @suffix
    when Suffix::Question
      sb << "?"
    when Suffix::Bang
      sb << "!"
    else
    end
  end
end

