# Numbers — SPEC.md, "0.1.0", item 3.
#
# Arithmetic is not here: `primitives.cr` defines `+`, `-`, `*`, the
# comparisons and the conversions as `@[Primitive]`s the compiler emits
# instructions for. What is left is the two operators Crystal writes in
# `int.cr` rather than in the compiler, and turning a number into text.

# The zero of each number the prelude declares, which is what an empty
# sum answers with.
#
# It is here because the alternative was a hole a program could fall
# into: `Array#sum` had no zero to start from and raised "sum of an
# empty array", while `std/enumerable`'s `sum` - bounded `Elem : Num`,
# so it *can* ask a type for one - answered 0. One program saw both,
# `Set(Int32).new.sum` and `([] of Int32).sum` disagreeing about the
# same empty question.
#
# An identity belongs to the type and not to any value of it: there is
# no element to ask when the collection is empty, which is the whole
# difficulty. Something that is not a number has no zero, so
# `["a", "b"].sum` is a compile error rather than a panic at run time -
# where Crystal puts the same refusal - and `join` is how strings are
# put together.
#
# `std/traits` writes the same table for the numbers *it* declares
# (`Int8` and the rest); these five are the prelude's, and a `.iyi` file
# may not redefine a method the prelude has (R-3), so the trait's impls
# for them take this one.
{% begin %}
  {% for t in [{"Int32", "0"}, {"Int64", "0_i64"}, {"UInt8", "0_u8"},
               {"UInt64", "0_u64"}, {"Float64", "0.0"}] %}
    struct {{ t[0].id }}
      def self.zero : self
        {{ t[1].id }}
      end
    end
  {% end %}
{% end %}

# A 32-bit signed integer, the literal `1`: `//` and `%` for integer
# division and remainder, `times`, `to_s` in any base.
struct Int32
  # The zero is checked here rather than left to the processor. `1 // 0` used
  # to reach `unsafe_div`, trap, and kill the program with "Process terminated
  # because of a floating-point system exception" — an integer division
  # reported by the operating system as a floating-point fault, which is a
  # sentence nobody can act on.
  def //(other : Int32) : Int32
    raise "division by zero" if other == 0
    # And the one division that overflows, for the same reason the zero is
    # here: `MIN // -1` is 2147483648, which the type does not hold, and the
    # processor reports it as the same unactionable floating-point fault.
    raise "arithmetic overflow" if self == -2147483648 && other == -1
    unsafe_div(other)
  end

  def %(other : Int32) : Int32
    raise "modulo by zero" if other == 0
    # Zero, and it fits: only the division underneath traps.
    return 0 if self == -2147483648 && other == -1
    unsafe_mod(other)
  end

  def - : Int32
    0 - self
  end

  # Shifts, and the magnitude: what a bit of arithmetic past the four
  # operators asks for first. A shift by the width or more answers zero,
  # which the processor does not promise.
  def <<(count : Int32) : Int32
    count >= 32 || count < 0 ? 0 : unsafe_shl(count)
  end

  def >>(count : Int32) : Int32
    count >= 32 || count < 0 ? (self < 0 ? -1 : 0) : unsafe_shr(count)
  end

  def abs : Int32
    self < 0 ? -self : self
  end

  # A whole power, by squaring: `2 ** 10`. A negative exponent is a
  # mistake for an integer, as division by zero is.
  def **(exponent : Int32) : Int32
    raise "negative exponent #{exponent}" if exponent < 0
    result = 1
    base = self
    while exponent > 0
      result = result * base if exponent % 2 == 1
      exponent = exponent // 2
      # Not squared past the last use: `2 ** 30` fits and its base's
      # next square does not.
      base = base * base if exponent > 0
    end
    result
  end

  def times(& : Int32 -> Nil) : Nil
    index = 0
    while index < self
      yield index
      index = index + 1
    end
  end

  # The character with this code, ASCII: the other half of `Char#ord`.
  def chr : Char
    raise "#{self} is out of char range" if self < 0 || self > 127
    to_u8.unsafe_chr
  end

  def even? : Bool
    self % 2 == 0
  end

  def odd? : Bool
    self % 2 != 0
  end

  def to_s : String
    to_i64.to_s
  end

  def to_s(base : Int32) : String
    to_i64.to_s(base)
  end

  def hash : Int32
    self
  end
end

# The unsigned pair, which the prelude did not declare: `UInt64`'s division
# and modulo, and text for both. They arrived inside `format.iyi` because
# `sprintf` needed them, so a program dividing two `UInt64`s had to have
# loaded a formatter to do it - which `std/time` found the moment the
# formatter stopped being everybody's.
struct UInt8
  def to_s : String
    to_i32.to_s
  end

  def to_s(base : Int32) : String
    to_i32.to_s(base)
  end
end

struct UInt64
  def //(other : UInt64) : UInt64
    raise "division by zero" if other == 0_u64
    unsafe_div(other)
  end

  def %(other : UInt64) : UInt64
    raise "modulo by zero" if other == 0_u64
    unsafe_mod(other)
  end

  def to_s : String
    to_s(10)
  end

  def to_s(base : Int32) : String
    raise "base out of range" if base < 2 || base > 36
    return "0" if self == 0_u64

    radix = base.to_u64
    digits = [] of Int32
    temp = self
    while temp > 0_u64
      rem = (temp % radix).to_i64.to_i32
      digits << rem
      temp = temp // radix
    end

    bytesize = digits.size
    String.new(bytesize) do |buffer|
      at = 0
      rev = bytesize - 1
      while rev >= 0
        d = digits[rev]
        buffer[at] = d < 10 ? (48 + d).to_u8 : (87 + d).to_u8
        at = at + 1
        rev = rev - 1
      end
    end
  end
end

# A 64-bit signed integer, the literal `1_i64`.
struct Int64
  def //(other : Int64) : Int64
    raise "division by zero" if other == 0
    # And the one division that overflows: the type's smallest value has no
    # positive twin, so `MIN // -1` is a number the type does not hold. Left
    # to the processor it traps the same way a zero divisor did, and the
    # program died of "a floating-point system exception" for an integer
    # divide. Reported the way every other arithmetic that leaves the type
    # is.
    raise "arithmetic overflow" if self == -9223372036854775808_i64 && other == -1_i64
    unsafe_div(other)
  end

  def %(other : Int64) : Int64
    raise "modulo by zero" if other == 0
    # `MIN % -1` is zero and fits; it is only the division underneath it
    # that traps, so the answer is written rather than the fault.
    return 0_i64 if self == -9223372036854775808_i64 && other == -1_i64
    unsafe_mod(other)
  end

  def - : Int64
    0_i64 - self
  end

  def <<(count : Int32) : Int64
    count >= 64 || count < 0 ? 0_i64 : unsafe_shl(count.to_i64)
  end

  def >>(count : Int32) : Int64
    count >= 64 || count < 0 ? (self < 0_i64 ? -1_i64 : 0_i64) : unsafe_shr(count.to_i64)
  end

  def abs : Int64
    self < 0_i64 ? -self : self
  end

  # Written by dividing the *negative* magnitude rather than negating it,
  # because `-Int64::MIN` is not an Int64: negation overflows and every
  # digit after it is wrong. `src/std/format.iyi` used to carry a second
  # definition of both of these with this shape, so what a program got
  # depended on whether the formatter had been loaded; there is one of each
  # now, here, where `Int32#to_s` already delegates.
  def to_s : String
    to_s(10)
  end

  # Writes digits backward using division on negative numbers so that
  # Int64::MIN (-9223372036854775808) does not overflow negation.
  def to_s(base : Int32) : String
    raise "base out of range" if base < 2 || base > 36
    return "0" if self == 0_i64

    radix = base.to_i64
    negative = self < 0_i64
    digits = [] of Int32
    temp = self
    while temp != 0_i64
      rem = temp % radix
      d = rem < 0_i64 ? (0_i64 - rem).to_i32 : rem.to_i32
      digits << d
      temp = temp // radix
    end

    bytesize = negative ? digits.size + 1 : digits.size
    String.new(bytesize) do |buffer|
      at = 0
      if negative
        buffer[0] = 45_u8
        at = 1
      end
      rev = digits.size - 1
      while rev >= 0
        d = digits[rev]
        buffer[at] = d < 10 ? (48 + d).to_u8 : (87 + d).to_u8
        at = at + 1
        rev = rev - 1
      end
    end
  end
end
