define internal i64 @umul64(i64 %a, i64 %b) {
entry:
  %pair = intrinsic llvm.umul.with.overflow.i64(i64 %a, i64 %b)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -116
ok:
