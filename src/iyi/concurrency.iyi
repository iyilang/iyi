# iyi's concurrency runtime — SPEC.md III.4, built in the order III.4.8
# settled: a scheduler, cancellable blocking primitives, then `group` and
# `Channel`. Every scheduler thread runs fibers of its own, and what makes
# that concurrency rather than sequence is the poller — a fiber that would
# block parks itself and the scheduler runs another, so two tasks' waits
# overlap on one thread. What makes it parallelism is the pool (III.4.13):
# `spawn_parallel` hands a task to worker threads, each a scheduler of its
# own, and a parallel task that parks may resume on whichever worker is
# free, the tasks it spawned with it (`IyiUnit`).
#
# The public surface, and it is deliberately all of it:
#
#   group do |g|              # III.4.1: concurrency is introduced by a scope
#     t = g.spawn { work() }  # a task on this thread; no bare spawn exists
#     u = g.spawn_parallel { crunch() }  # a task on a worker: III.4.13
#   end                       # the block cannot be left until every task is done
#   t.value                   # joins, then answers what the block returned
#   sleep(ms)                 # Nil | Cancelled
#   wait_readable(fd)         # Nil | Cancelled — the poller, made visible
#   wait_writable(fd)         # Nil | Cancelled — the other direction
#   iyi_read(fd, buf, n)      # Int64 | Cancelled — a read that parks, not blocks
#   Channel(T).new            # a rendezvous; .new(n) buffers n sends first
#   select / when / else      # over any mix of arms; the expansion's
#                             # library half is at the bottom of this file
#   IyiWorkers.count = n      # the pool's size, before its first task
#
# Cancellation (III.4.2) belongs to the group: a task whose value is an
# error member, a block left early, or a cancel of the task holding the
# group open cancels the tasks still running. A cancelled fiber is not
# torn down — it is *woken*, and every blocking primitive answers
# `Cancelled` from then on. A task written with `!` therefore drains out
# of its own accord, which is III.1.2 doing cancellation's plumbing for
# free. Where no answer can carry `Cancelled`, the task stops instead and
# its defers run (`IyiScheduler.stop_current`).
#
# `Share` (III.4.4) gates the block `spawn_parallel` runs, as it gates the
# block a thread runs; `spawn`'s block shares its thread with its spawner
# and is not gated (III.4.5). Panics at task boundaries (III.1.4) live at
# the bottom of the scheduler: a panicking task drains its defers, tells
# its group, and dies alone, on whichever thread it ran.
#
# Linux and darwin arm64, through each platform's own doorway: raw
# syscalls on Linux, libSystem on darwin, because Apple documents raw
# syscalls as explicitly not a stable ABI there (SPEC.md III.9). Either
# way the dependency floor named pthreads as the cost that must not be
# paid, and a fiber is exactly the thing that makes it unnecessary. The
# remaining platforms lose nothing they had: a program that names `group`
# on wasm32 fails to compile, which is honest — III.4.8 refused shipping
# a spelling without the feature.

# ── The switch ─────────────────────────────────────────────────────────
#
# A suspended context is one word: its stack pointer. Everything else the
# fiber will need is on the stack that pointer names, put there by the
# push half of the swap. Caller-saved registers are not saved and do not
# need to be: this is a call, and the convention already says a caller
# keeps nothing live in them across one.
#
# `@[Naked]` because the prologue of an ordinary function would move the
# very stack pointer being saved; `@[NoInline]` because an optimised build
# otherwise inlines the body and the push/ret discipline corrupts the
# caller — measured, not feared: the release build faulted until it said so.
@[NoInline]
@[Naked]
fun __iyi_ctx_swap(current : Pointer(UInt64), target : Pointer(UInt64)) : Nil
  {% if flag?(:win32) && flag?(:x86_64) %}
    # The Windows x64 convention keeps xmm6-xmm15 across a call as well
    # as the eight integer registers, and a switch is a call: a value the
    # compiler kept in one of them over `send` or `receive` was the other
    # fiber's when the call returned. Measured on a --release build, two
    # fibers each holding ten doubles over a channel handoff read the
    # other's in 4,000 of 4,000 checks. Carried in the frame now, between
    # the integer registers and the two TEB words; `movups`, because the
    # frame's alignment is the caller's.
    asm("pushq %r15
         pushq %r14
         pushq %r13
         pushq %r12
         pushq %rbp
         pushq %rbx
         pushq %rdi
         pushq %rsi
         subq $$160, %rsp
         movups %xmm6, 0(%rsp)
         movups %xmm7, 16(%rsp)
         movups %xmm8, 32(%rsp)
         movups %xmm9, 48(%rsp)
         movups %xmm10, 64(%rsp)
         movups %xmm11, 80(%rsp)
         movups %xmm12, 96(%rsp)
         movups %xmm13, 112(%rsp)
         movups %xmm14, 128(%rsp)
         movups %xmm15, 144(%rsp)
         movq %gs:0x08, %r8
         movq %gs:0x10, %r9
         movq %gs:0x1478, %r10
         pushq %r8
         pushq %r9
         pushq %r10
         movq %rsp, (%rcx)
         movq (%rdx), %rsp
         popq %r10
         popq %r9
         popq %r8
         movq %r8, %gs:0x08
         movq %r9, %gs:0x10
         movq %r10, %gs:0x1478
         movups 0(%rsp), %xmm6
         movups 16(%rsp), %xmm7
         movups 32(%rsp), %xmm8
         movups 48(%rsp), %xmm9
         movups 64(%rsp), %xmm10
         movups 80(%rsp), %xmm11
         movups 96(%rsp), %xmm12
         movups 112(%rsp), %xmm13
         movups 128(%rsp), %xmm14
         movups 144(%rsp), %xmm15
         addq $$160, %rsp
         popq %rsi
         popq %rdi
         popq %rbx
         popq %rbp
         popq %r12
         popq %r13
         popq %r14
         popq %r15
         retq" :::: "volatile")
  {% elsif flag?(:x86_64) %}
    asm("pushq %rdi
         pushq %rbx
         pushq %rbp
         pushq %r12
         pushq %r13
         pushq %r14
         pushq %r15
         movq %rsp, (%rdi)
         movq (%rsi), %rsp
         popq %r15
         popq %r14
         popq %r13
         popq %r12
         popq %rbp
         popq %rbx
         popq %rdi
         retq" :::: "volatile")
  {% else %}
    asm("stp x19, x20, [sp, #-160]!
         stp x21, x22, [sp, #16]
         stp x23, x24, [sp, #32]
         stp x25, x26, [sp, #48]
         stp x27, x28, [sp, #64]
         stp x29, x30, [sp, #80]
         stp d8, d9, [sp, #96]
         stp d10, d11, [sp, #112]
         stp d12, d13, [sp, #128]
         stp d14, d15, [sp, #144]
         mov x2, sp
         str x2, [x0]
         ldr x2, [x1]
         mov sp, x2
         ldp x21, x22, [sp, #16]
         ldp x23, x24, [sp, #32]
         ldp x25, x26, [sp, #48]
         ldp x27, x28, [sp, #64]
         ldp x29, x30, [sp, #80]
         ldp d8, d9, [sp, #96]
         ldp d10, d11, [sp, #112]
         ldp d12, d13, [sp, #128]
         ldp d14, d15, [sp, #144]
         ldp x19, x20, [sp], #160
         ret" :::: "volatile")
  {% end %}
end

# Where a fresh fiber's first resume lands. No argument crosses the swap:
# the fiber to run is `IyiScheduler.current`, set by the switch that got
# here, so the two targets never have to agree on which register survives.
fun __iyi_fiber_main : Nil
  IyiScheduler.run_spawned_fiber
end

# The trampoline's address, taken by asm because a proc literal of a `fun`
# is not a thing an iyi file can write.
@[NoInline]
@[Naked]
fun __iyi_fiber_entry_address : UInt64
  {% if flag?(:x86_64) %}
    asm("leaq __iyi_fiber_main(%rip), %rax
         retq" :::: "volatile")
  {% elsif flag?(:darwin) %}
    # Mach-O spells the relocation pair @PAGE/@PAGEOFF where ELF says
    # :lo12:, and prefixes every C-level name with an underscore.
    asm("adrp x0, ___iyi_fiber_main@PAGE
         add x0, x0, ___iyi_fiber_main@PAGEOFF
         ret" :::: "volatile")
  {% else %}
    asm("adrp x0, __iyi_fiber_main
         add x0, x0, :lo12:__iyi_fiber_main
         ret" :::: "volatile")
  {% end %}
  0_u64
end

# ── The poller's syscalls ──────────────────────────────────────────────
#
# On Linux they are raw, like every other syscall in this prelude, and
# for the same III.9 reason. The numbers are the two targets' own;
# `epoll_pwait` rather than `epoll_wait` because aarch64 only has the
# former, and with a null sigmask they are the same call. On darwin the
# same operations are libSystem calls — Apple's raw-syscall ABI is
# explicitly not stable — and the poller is a kqueue, so the constants
# there describe the 32-byte `kevent` struct rather than a syscall table.
#
# The numbers live in top-level constants because a local born inside a
# `{% if %}` dies at its `{% end %}`: a macro expansion is re-parsed, and
# only declarations cross back out of one.
{% if flag?(:win32) %}
  IYI_POLL_DATA_OFFSET =  0_u64
  IYI_POLL_EVENT_BYTES = 32_i64

  lib LibC
    fun GetProcAddress(h_module : Void*, proc_name : UInt8*) : Void*
  end
{% elsif flag?(:darwin) %}
  # A kevent's fd is its first field (`ident`), so the data offset is 0.
  IYI_POLL_DATA_OFFSET =  0_u64
  IYI_POLL_EVENT_BYTES = 32_i64
  # The scheduler's doorbell (III.4.13): an `EVFILT_USER` event (-10, so
  # 0xFFF6 as the filter's sixteen bits), under an ident no fd's filter
  # shares. Added with EV_ADD | EV_CLEAR (0x21), rung with fflags
  # NOTE_TRIGGER (0x01000000), packed as `__iyi_kevent_change` packs.
  IYI_WAKE_IDENT   =             0x7FFFFFFF
  IYI_WAKE_FILTER  =             0xFFF6_u64
  IYI_WAKE_ADD     =           0x21FFF6_u64
  IYI_WAKE_TRIGGER = 0x010000000000FFF6_u64
{% elsif flag?(:x86_64) %}
  IYI_SYS_MMAP          =   9_i64
  IYI_SYS_MPROTECT      =  10_i64
  IYI_SYS_CLOCK_GETTIME = 228_i64
  IYI_SYS_EPOLL_CTL     = 233_i64
  IYI_SYS_EPOLL_PWAIT   = 281_i64
  IYI_SYS_EVENTFD2      = 290_i64
  IYI_SYS_EPOLL_CREATE1 = 291_i64
  # The kernel packs epoll_event on x86_64: data sits at +4 of a 12-byte
  # struct. On aarch64 it is aligned: +8 of 16.
  IYI_POLL_DATA_OFFSET =  4_u64
  IYI_POLL_EVENT_BYTES = 12_i64
{% else %}
  IYI_SYS_MMAP          = 222_i64
  IYI_SYS_MPROTECT      = 226_i64
  IYI_SYS_CLOCK_GETTIME = 113_i64
  IYI_SYS_EVENTFD2      =  19_i64
  IYI_SYS_EPOLL_CTL     =  21_i64
  IYI_SYS_EPOLL_PWAIT   =  22_i64
  IYI_SYS_EPOLL_CREATE1 =  20_i64
  IYI_POLL_DATA_OFFSET  =   8_u64
  IYI_POLL_EVENT_BYTES  =  16_i64
{% end %}

{% if flag?(:darwin) %}
  # libSystem, reopened for the calls the runtime makes. `__error` is how
  # darwin spells errno's address; the poller needs it to tell EINTR from
  # a real failure, because a library call answers -1 where a raw syscall
  # answers -errno. `fstat64` is here for a read's one question, whether
  # standard input is a regular file (`IyiScheduler.read_posix`); bound
  # here alone, since one C symbol takes one signature in a program.
  lib LibC
    fun mmap(addr : Void*, len : UInt64, prot : Int32, flags : Int32, fd : Int32, offset : Int64) : Void*
    fun mprotect(addr : Void*, len : UInt64, prot : Int32) : Int32
    fun kqueue : Int32
    fun kevent(kq : Int32, changelist : Void*, nchanges : Int32, eventlist : Void*, nevents : Int32, timeout : Void*) : Int32
    fun clock_gettime_nsec_np(clock_id : Int32) : UInt64
    fun error_location = __error : Int32*
    fun fstat = fstat64(fd : Int32, buf : Void*) : Int32
  end

  # One kevent change, packed by hand for the reason the epoll_event is:
  # the prelude has no Int16 or UInt32 to declare the struct's middle
  # fields with. Bytes 8..15 hold filter (-1 = EVFILT_READ), flags and
  # fflags, which as one little-endian word are 0x1FFFF for EV_ADD and
  # 0x2FFFF for EV_DELETE; `data` and `udata` are zeroed explicitly so
  # no byte of the struct rides on what malloc left behind.
  def __iyi_kevent_change(fd : Int32, word : UInt64) : Pointer(UInt8)
    change = Pointer(UInt8).malloc(32_u64)
    change.as(Pointer(UInt64)).value = fd.to_u64
    Pointer(UInt64).new(change.address + 8_u64).value = word
    Pointer(UInt64).new(change.address + 16_u64).value = 0_u64
    Pointer(UInt64).new(change.address + 24_u64).value = 0_u64
    change
  end
{% elsif flag?(:win32) %}
  # Windows uses kernel32 APIs directly via LibC
{% else %}
  fun __iyi_conc_syscall3(number : Int64, a : Int64, b : Int64, c : Int64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  fun __iyi_conc_syscall6(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64, f : Int64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e), "{r9}"(f)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e), "{x5}"(f)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end
{% end %}
# CLOCK_MONOTONIC, in nanoseconds. The sleep queue's clock; never the
# wall. darwin's libSystem has the one-call form, and the id is 4,
# CLOCK_MONOTONIC_RAW, not 6: both stop while the machine sleeps and
# both count from boot, but 6 is rounded to the microsecond on arm64
# and 4 is the 24 MHz counter itself, 42 ns a tick — measured by the
# thread floor, whose 2 µs stop came back as 2000 or 3000 on 6. A
# deadline is a duration, so the slew 6 carries and 4 does not is
# nothing the queue wants.
@[Effect(:clock)]; def __iyi_monotonic_ns : Int64
  {% if flag?(:win32) %}
    qpc = uninitialized Int64
    freq = uninitialized Int64
    LibC.QueryPerformanceCounter(pointerof(qpc))
    LibC.QueryPerformanceFrequency(pointerof(freq))
    sec = qpc // freq
    rem = qpc % freq
    sec * 1000000000_i64 + (rem * 1000000000_i64) // freq
  {% elsif flag?(:darwin) %}
    LibC.clock_gettime_nsec_np(4).to_i64
  {% else %}
    # The timespec in this frame: a heap block here was an allocation
    # every time anything read the clock, the scheduler's sleep queue
    # included.
    spec = uninitialized UInt64[2]
    words = pointerof(spec).as(Pointer(UInt64))
    result = __iyi_conc_syscall3(IYI_SYS_CLOCK_GETTIME, 1_i64, words.address.to_i64, 0_i64)
    raise "clock_gettime failed" if result < 0
    words[0].to_i64 * 1000000000_i64 + words[1].to_i64
  {% end %}
end

# ── The error members cancellation and closing answer with ─────────────
#
# Ordinary error members (III.1.1): a blocking primitive that cannot give
# a value gives one of these, `!` propagates it, `case` handles it. That a
# *cancelled* wait is an error value rather than an unwound stack is the
# design's whole answer to III.4.2 — and panics (III.1.4) landing did not
# change it: cancellation is control flow, a panic is a bug. `Cancelled`
# itself is the prelude's (prelude.iyi), on every target: a socket answers
# it, and a socket's type may not depend on whether a runtime is present.

# What a *caught* panic answers as — III.1.4's "catchable at task
# boundaries", made literal: reading a panicked task's value delivers
# this instead of a re-raise, and III.1.3's machinery (`case`, `!`,
# `.or`) handles it like any other failure. A panic nobody reads still
# re-raises at the join: observed bugs are values, unobserved bugs are
# loud.
pub struct Panicked
  getter text : String

  def initialize(@text : String)
  end
end

impl Error for Panicked
  def message : String
    text
  end
end

pub struct ChannelClosed
  def initialize
  end
end

impl Error for ChannelClosed
  def message : String
    "channel closed"
  end
end

# ── A fiber ────────────────────────────────────────────────────────────
#
# Not user-facing (III.4.6): a raw spawn is the leak III.4.1 exists to
# make unrepresentable. `IyiTask` and `group` are the only doors.

# What a fiber is doing, which the scheduler reads and writes under the
# runtime lock. It was an `Int32` with the names in a comment, because the
# prelude had no `Enum` surface when the scheduler was written; it has one
# now (`src/iyi/enum.iyi`), and the comment was the argument for keeping the
# integer - what those comparisons cost is measured, so naming them is a
# change that has to be measured too. It was: `bench/server_load.sh`'s shape
# holds and 2,000,000 channel round trips cost what they cost before, plain
# and optimised, because `==` on an enum is its value compared and the
# member is a constant.
enum IyiFiberState : Int32
  Running   = 0 # the one fiber whose instructions are executing
  Runnable  = 1 # in the run queue, an inbox, or the pool's queues
  Sleeping  = 2 # in the sleep list, by deadline
  WaitingIo = 3 # in the io list, registered with the poller
  WaitingCh = 4 # parked in a channel's queue
  Joining   = 5 # parked on another fiber's completion
  Done      = 6 # never scheduled again; its stack is never reused
  Pooled    = 7 # a pool worker's own fiber, which waits for nothing
end

class IyiFiber
  property state : IyiFiberState
  property cancelled : Bool

  # Panics — III.1.4. The registry `defer` pushes onto and the panic
  # path drains; the flag and message a boundary reads after the join.
  property defers : IyiDeferNode?
  property panicked : Bool
  property panic_message : String
  # Set when a handle read delivered the panic as a `Panicked` value:
  # the join stops owing a re-raise for a bug somebody observed.
  property panic_delivered : Bool

  # The group that spawned this fiber, so a panic can tell it directly:
  # the trampoline's own notification lives after `block.call`, and a
  # panicking block never returns there.
  property group : IyiGroup?

  # The scheduler thread it last ran on (III.4.13): whose lists it waits
  # in when it parks in a sleep heap or a poller, and whose run queue a
  # wake of a fiber that does not move puts it in. Set when it is spawned
  # and, on a pool worker, at every switch to it; nil only for a parallel
  # task not started yet, which is waiting in the pool. A fiber of no
  # unit never changes it.
  property home : IyiSchedulerState?
  # Spawned by `spawn_parallel`: started by whichever worker is free.
  property parallel : Bool
  # The parallel task this fiber belongs to, itself or the one whose
  # block spawned it (`IyiUnit`); nil for a fiber that never moves.
  property unit : IyiUnit?
  # Woken onto its home only: a `select` with a timeout arm is in its
  # home's sleep heap while a channel may wake it from any thread, and it
  # must leave that heap on the thread that owns it. Under the scheduler's
  # lock, as the select that sets it is.
  property homebound : Bool
  {% if flag?(:iyi_observe) %} property observe_depth : Int32 = 0 {% end %}
  # A cancel from another thread, waiting in its home's list until that
  # thread takes the fiber out of its own sleep heap or poller.
  property next_cancel : IyiFiber?
  property cancel_posted : Bool
  # Parked, cancelled already, to wait out what the cancel ended - a
  # Windows packet, standard input's read - which a cancel still in the
  # mail of the thread holding it does not end again (`listed`).
  property waiting_out : Bool
  # Given its worker up at a loop's back-edge (`IyiWorkers.preempted`) and
  # waiting to run again: its unit's token is still its own
  # (`IyiUnit::YIELDED`), and whichever worker takes it next takes the
  # token from it (`IyiScheduler.take_unit`).
  property preempted : Bool
  # 1 from the moment a worker switches to this fiber until the switch
  # away from it has saved its stack pointer (`IyiScheduler.landed`): a
  # fiber woken in that gap may be taken by another worker, which waits
  # here rather than resume a stack still in use.
  @on_cpu : Atomic(UInt64)
  # The scheduler thread whose sleep heap or io list holds this fiber, by
  # its state's id, 0 when none does. Written only by that thread - when
  # it parks the fiber there and when it wakes it - so the thread reading
  # its own id here is never reading an old value: the cancel's question
  # of where a moving fiber waits (`IyiScheduler.cancel`).
  @listed_on : Atomic(UInt64)

  # The saved stack pointer, meaningful only while suspended.
  @sp : UInt64

  # The spawned body. The main fiber has none.
  property proc : Proc(Nil)?

  # Intrusive links. A fiber waits on at most one thing at a time, so one
  # link per queue kind is enough, and none of them allocate on the wait
  # path except a channel's node.
  property next_run : IyiFiber?
  property next_io : IyiFiber?
  # The one before on the io list, where the list is the POSIX poller's
  # and a waiter leaves it from wherever it is (`IyiScheduler.io_unlink`).
  property prev_io : IyiFiber?
  # The sleep heap's links (`IyiScheduler.sleep_insert`): the first
  # child, the next sibling, and the node before this one - its parent
  # when it is a first child, its previous sibling otherwise - with the
  # order an insertion took, which breaks a tie between two deadlines.
  property next_sleep : IyiFiber?
  property sleep_child : IyiFiber?
  property sleep_prev : IyiFiber?
  property sleep_seq : UInt64
  property next_child : IyiFiber?
  # Who waits for this fiber to finish: the first of them, and through
  # `next_joiner` the rest, chained through the waiters themselves. One
  # field held one joiner, and a second fiber reading the same running
  # task's `value` panicked "task already has a joiner". `awaited` is
  # the task a fiber waits on in that chain, and `joining` the group
  # whose join it waits in, so a deadlock can take it off either one.
  property joiner : IyiFiber?
  property next_joiner : IyiFiber?
  property awaited : IyiFiber?
  property joining : IyiGroup?
  # The innermost group this fiber has open, the rest through
  # `IyiGroup#outer`: what a cancel of the fiber reaches (`cancel`).
  property open_group : IyiGroup?
  # Woken to report a deadlock on its own stack (`IyiScheduler.deadlock`).
  property deadlocked : Bool

  # The registry link and the stack's high end, for the collector's root
  # walk (GC_DESIGN.md Stage 3): a parked fiber's live values sit between
  # its saved stack pointer and this top, and a walk that cannot reach
  # them frees live objects. The main fiber's top stays 0 — its stack is
  # the thread's own and the root walk already knows that one's base.
  property next_fiber : IyiFiber?
  property prev_fiber : IyiFiber?
  property prev_child : IyiFiber?
  property stack_top : UInt64

  property deadline : Int64
  # An io wait with a deadline is in the sleep list as well, by `deadline`;
  # whichever of the two wakes it takes it off the other. `timed_out` says
  # the deadline did.
  property io_timed : Bool
  property timed_out : Bool
  property wait_fd : Int32
  # Which way it waits on `wait_fd`: 1 to read, 4 to write - epoll's IN
  # and OUT bits, which the registration is the union of.
  property wait_dir : Int32
  property wait_handle : Void*
  # What the posted operation on `wait_handle` does: 1 reads, 4 writes, 0
  # neither (a connect), as `wait_posix` numbers the two directions.
  property io_direction : Int32
  property wait_overlapped : Pointer(UInt8)
  property io_bytes_read : Int64

  # Which park this fiber is suspended in, counted up at every park. A
  # channel node names the park it was made for, and a node whose nonce is
  # not the fiber's current one is a leftover — a park the fiber already
  # left through cancellation — so a wake skips it and keeps looking, and
  # nobody has to unlink a node from a queue whose type the scheduler
  # cannot see. This is also what `select` will lean on: several nodes,
  # one nonce, and the losers go stale by arithmetic.
  property park_nonce : UInt64

  # The receive node this fiber parked with last, kept for its next
  # receive (`Channel#park_receive_node`): a ring of tasks passing a
  # value parks on every receive, and a node a park was fifteen million
  # allocations in crystal-metric's Threadring. Reused only once no
  # queue holds it.
  property spare_waiter : IyiWaiter?

  # 256 KiB of stack and one guard page under it, so running off the end
  # is a fault at a page rather than a quiet corruption of a neighbour's
  # chunk: every frame probes its pages top down (`iyi_probe_stack`).
  STACK_BYTES = 262144_u64
  PAGE        =   4096_u64

  {% if flag?(:win32) %}
    # The room a fault handler has to stand in, on the one platform where
    # it has to stand on the stack that faulted. Windows has no
    # `sigaltstack`: a vectored handler runs where the fault happened, so a
    # fiber whose stack ran out had nowhere to print from and the process
    # died of a bare access violation. The stack's bottom is therefore in
    # two parts - from `base` up: one uncommitted page, the hard wall a
    # frame that jumped everything lands in, and `GUARD_SLACK` and a page
    # committed, which is the handler's room; the kernel's growth of the
    # stack stops above them (`map_stack`), and answers there with
    # STATUS_STACK_OVERFLOW.
    #
    # 16 KB because that is what `SetThreadStackGuarantee` reserves for the
    # same handler on a thread's own stack, and it is measured rather than
    # guessed. With the slack filled with a pattern and read back inside
    # the handler, the deepest byte it touched was 6,968 below the top of
    # the guard page — the guard page is 4,096 of that, so 2,872 bytes of
    # slack were used and 13,512 were spare. And the slack is what makes
    # the difference: with `GUARD_SLACK = 0` the same program prints its
    # sentence and then dies of an access violation on the way out, which
    # is the handler walking off the bottom of the guard page into the
    # page nobody committed.
    GUARD_SLACK = 16384_u64

    # What a new stack starts with committed at its top; the kernel commits
    # the rest a page at a time as the fiber reaches it. The whole 256 KiB
    # was committed up front, and Windows charges committed memory to the
    # commit limit whether it is touched or not: 10,000 tasks held 2,690
    # MiB, and at 40,000 the commit ran out and each new task panicked.
    INITIAL_COMMIT = 16384_u64
  {% end %}

  def initialize
    @state = IyiFiberState::Runnable
    @cancelled = false
    @defers = nil
    @panicked = false
    @panic_message = ""
    @panic_delivered = false
    @group = nil
    @home = nil
    @parallel = false
    @unit = nil
    @homebound = false
    @next_cancel = nil
    @cancel_posted = false
    @waiting_out = false
    @preempted = false
    @on_cpu = Atomic(UInt64).new(0_u64)
    @listed_on = Atomic(UInt64).new(0_u64)
    @sp = 0_u64
    @proc = nil
    @next_run = nil
    @next_sleep = nil
    @sleep_child = nil
    @sleep_prev = nil
    @sleep_seq = 0_u64
    @next_io = nil
    @prev_io = nil
    @next_child = nil
    @joiner = nil
    @next_joiner = nil
    @awaited = nil
    @joining = nil
    @open_group = nil
    @deadlocked = false
    @deadline = 0_i64
    @io_timed = false
    @timed_out = false
    @wait_fd = -1
    @wait_dir = 0
    @park_nonce = 0_u64
    @spare_waiter = nil
    @next_fiber = nil
    @prev_fiber = nil
    @prev_child = nil
    @stack_top = 0_u64
    @wait_handle = Pointer(Void).new(0_u64)
    @io_direction = 0
    # The OVERLAPPED is the kernel's 32 bytes; the word after it is the
    # runtime's, the id of the thread whose io list holds the fiber while
    # the operation is posted, which a completion that arrives on another
    # thread's port is forwarded to (`IyiScheduler.forward_completion`).
    @wait_overlapped = Pointer(UInt8).malloc(40_u64)
    @io_bytes_read = 0_i64
  end

  # Whether a thread is still on this fiber's stack (`@on_cpu`).
  def on_cpu? : Bool
    @on_cpu.get != 0_u64
  end

  def on_cpu=(running : Bool) : Bool
    @on_cpu.set(running ? 1_u64 : 0_u64)
    running
  end

  # Said by the thread whose sleep heap or io list this fiber has just
  # been put in, once its state says so: a read-modify-write, so the
  # `cancelled` read after it cannot be answered from before it, and a
  # cancel on another thread either sees this or is seen by the caller
  # (`IyiScheduler.listed`).
  def list_on(id : UInt64) : Nil
    @listed_on.swap(id)
  end

  # Said by that thread as the fiber leaves its lists.
  def unlist(id : UInt64) : Nil
    @listed_on.set(0_u64) if @listed_on.get == id
  end

  # The canceller's read, ordered after its write of `cancelled` by being a
  # read-modify-write.
  def listed_on_fenced : UInt64
    @listed_on.add(0_u64)
  end

  def listed_on : UInt64
    @listed_on.get
  end

  # The running program's own context: no stack to build, the kernel gave
  # it one, and the first switch away fills in @sp.
  def self.main : IyiFiber
    fiber = IyiFiber.new
    fiber.state = IyiFiberState::Running
    fiber
  end

  # A stack, from the pool if a finished fiber left one there.
  #
  # They used to be mapped and never given back, on the grounds that a
  # done fiber's stack is never reused — which is true of the fiber and
  # was read as true of the mapping. A server is a fiber per connection:
  # 256 KiB a request, never returned, is a leak with a request counter
  # on it, and the mappings are the visible half - a thousand
  # connections is two thousand lines in `/proc/self/maps`, past what
  # the root walk's own reader could hold, and the program died saying
  # so. The stack comes back now, handed over by the fiber that runs
  # next (`IyiScheduler.reap_dying`), because nothing can free the stack
  # it is standing on.
  def prepare_stack : Nil
    base = IyiScheduler.take_stack
    if base != 0
      settle_stack(base)
      return
    end
    settle_stack(map_stack)
  end

  @[Effect(:scheduler)]; def map_stack : UInt64
    # The runtime's own mapping (PROT_READ|PROT_WRITE = 3 on both
    # platforms), so a fiber stack exists under every allocator, Boehm
    # included, and a guard page (PROT_NONE) under it, so running off
    # the end is a fault rather than a quiet neighbour.
    # Declared before the branch, because a local born inside a
    # `{% if %}` dies at its `{% end %}` — the file's own top-level
    # constants comment says why.
    base = 0_u64
    {% if flag?(:win32) %}
      base_ptr = LibC.VirtualAlloc(nil, STACK_BYTES, 0x2000_i32, 1_i32)
      raise "VirtualAlloc reserve failed" if base_ptr.address == 0_u64
      base = base_ptr.address
      # A stack the way Windows makes a thread's, from the top down: the
      # top INITIAL_COMMIT committed, and one PAGE_GUARD page (0x4 | 0x100)
      # under it. The switch installs this stack's bounds in the TEB -
      # StackBase, StackLimit and DeallocationStack - so a touch of the
      # guard page is the kernel's to answer as for any thread: it commits
      # that page, moves the guard one down, and lowers StackLimit. Only
      # the pages a fiber reaches are ever committed.
      top = base + STACK_BYTES
      committed = LibC.VirtualAlloc(Pointer(Void).new(top - INITIAL_COMMIT - PAGE), INITIAL_COMMIT + PAGE, 0x1000_i32, 4_i32)
      raise "VirtualAlloc commit failed" if committed.address == 0_u64
      old = uninitialized Int32
      armed = LibC.VirtualProtect(Pointer(Void).new(top - INITIAL_COMMIT - PAGE), PAGE, 0x104_i32, pointerof(old))
      raise "VirtualProtect for the fiber stack's guard page failed" if armed == 0
      # The limit `settle_stack` installs, kept where `release_stack`
      # keeps a used stack's.
      Pointer(UInt64).new(top - 16_u64).value = top - INITIAL_COMMIT
      # And the handler's room, committed at the bottom where the kernel
      # will not grow: DeallocationStack names the byte above it (see
      # `settle_stack`), so the kernel answers STATUS_STACK_OVERFLOW there
      # and the fault handler stands on this. One uncommitted page stays
      # under it, the wall a frame that stepped over everything lands on.
      slack = LibC.VirtualAlloc(Pointer(Void).new(base + PAGE), GUARD_SLACK + PAGE, 0x1000_i32, 4_i32)
      raise "VirtualAlloc commit failed" if slack.address == 0_u64
    {% elsif flag?(:darwin) %}
      # libSystem's mmap: MAP_PRIVATE|MAP_ANON is 0x1002 here rather
      # than Linux's 0x22, and failure is MAP_FAILED (every bit set)
      # rather than -errno.
      mapped = LibC.mmap(Pointer(Void).new(0_u64), STACK_BYTES, 3, 4098, -1, 0_i64)
      raise "fiber stack mmap failed" if mapped.address &+ 1_u64 == 0_u64
      base = mapped.address
      LibC.mprotect(Pointer(Void).new(base), PAGE, 0)
    {% else %}
      mapped = __iyi_conc_syscall6(IYI_SYS_MMAP, 0_i64, STACK_BYTES.to_i64, 3_i64, 34_i64, -1_i64, 0_i64)
      raise "fiber stack mmap failed" if mapped < 0 && mapped >= -4095
      base = mapped.to_u64
      __iyi_conc_syscall3(IYI_SYS_MPROTECT, base.to_i64, PAGE.to_i64, 0_i64)
    {% end %}
    base
  end

  # The first frame, on a stack that is either fresh from the kernel or
  # back from the pool: every word the resume reads is written here, so a
  # reused stack starts exactly as a new one does.
  @[Effect(:scheduler)]; def settle_stack(base : UInt64) : Nil
    top = base + STACK_BYTES
    @stack_top = top
    {% if flag?(:win32) && flag?(:x86_64) %}
      entry_sp = top - 40_u64
      ret_slot = entry_sp - 8_u64
      Pointer(UInt64).new(ret_slot).value = __iyi_fiber_entry_address

      # The three TEB words, ten xmm registers (twenty words) and eight
      # integer registers, in the order the switch pops them.
      saved = ret_slot - 248_u64
      # DeallocationStack: the lowest byte the kernel may grow the stack
      # into, above the handler's committed room (`map_stack`).
      Pointer(UInt64).new(saved + 0_u64).value = base + PAGE + GUARD_SLACK + PAGE
      # StackLimit: the lowest committed byte, which is where the guard
      # page's top is. A fresh stack keeps `top - INITIAL_COMMIT` in its
      # word at `top - 16` (`map_stack`); a stack back from the pool keeps
      # the limit its last fiber died with (`release_stack`), because the
      # pages that fiber grew into are still committed and the guard page
      # is still under them, so the kernel never lowers this word again
      # until a frame goes deeper than that fiber did.
      #
      # It used to be `top - INITIAL_COMMIT` for every stack, on the
      # belief that a limit above what is committed only made a large
      # frame's probes touch pages already there. They write: MSVC's
      # `__chkstk` probes each page from StackLimit down to the new frame
      # with `mov byte ptr [r11], 0`. On a pooled stack the fiber's live
      # frames sit below that stale limit, so every frame over a page
      # cleared the first byte of each page between them - in CI job
      # 118465323370 a debugger watching the guard page's first word saw
      # `__chkstk` turn a return address ending 0x66 into one ending
      # 0x00 while StackLimit read 0x...cc000 and rsp 0x...caff0, and the
      # `ret` that read it jumped into the middle of `UInt8#%`. That is
      # the memory fault `bench/std_fuzz_exercise.iyi` died of at
      # tls-client seed 8 on every Windows run, after earlier seeds had
      # grown the stack the TLS 1.2 handshake's certificate parse reused.
      Pointer(UInt64).new(saved + 8_u64).value = Pointer(UInt64).new(top - 16_u64).value
      Pointer(UInt64).new(saved + 16_u64).value = top
      index = 0_i64
      while index < 28_i64
        Pointer(UInt64).new(saved + 24_u64 + index * 8_u64).value = 0_u64
        index = index + 1
      end
      @sp = saved
    {% elsif flag?(:x86_64) %}
      # The first resume pops seven zeroed callee-saved slots and returns
      # into the trampoline. The entry slot is placed so the trampoline
      # begins with rsp ≡ 8 (mod 16), which is what the ABI promises a
      # function a `call` has just reached.
      entry_sp = top - 8_u64
      ret_slot = entry_sp - 8_u64
      Pointer(UInt64).new(ret_slot).value = __iyi_fiber_entry_address
      saved = ret_slot - 56_u64
      index = 0_i64
      while index < 7_i64
        (Pointer(UInt64).new(saved) + index).value = 0_u64
        index = index + 1
      end
      @sp = saved
    {% else %}
      # aarch64 keeps sp 16-aligned always; the restored x30 carries the
      # entry, and the twenty slots mirror the swap's frame exactly.
      saved = top - 160_u64
      index = 0_i64
      while index < 20_i64
        (Pointer(UInt64).new(saved) + index).value = 0_u64
        index = index + 1
      end
      Pointer(UInt64).new(saved + 88_u64).value = __iyi_fiber_entry_address
      @sp = saved
    {% end %}
  end

  # The mapping, handed back. Called by the fiber that runs *after* this
  # one dies, never by the dying fiber: nothing frees the stack it is
  # standing on. The two words go with it, so a walk that reaches this
  # fiber again finds nothing to scan.
  def release_stack : Nil
    top = @stack_top
    return if top == 0
    {% if flag?(:win32) && flag?(:x86_64) %}
      # The StackLimit this fiber died with, from the TEB words its last
      # switch saved (`__iyi_ctx_swap`), for the next fiber the stack is
      # settled for: see `settle_stack`. Under the pool's link at the top
      # word, where nothing of a dead fiber's is read any more.
      Pointer(UInt64).new(top - 16_u64).value = Pointer(UInt64).new(@sp + 8_u64).value if @sp != 0_u64
    {% end %}
    @stack_top = 0_u64
    @sp = 0_u64
    IyiScheduler.give_stack(top - STACK_BYTES)
  end

  def sp_slot : Pointer(UInt64)
    pointerof(@sp)
  end

  # The saved stack pointer as a value, for the root walk. Meaningful only
  # while suspended, which is the only time the walk asks.
  def saved_sp : UInt64
    @sp
  end
end

# A parallel task and every task `spawn` started inside it, at any depth
# (SPEC.md III.4.13). Those tasks may share the parallel task's
# non-`Share` locals, as any task and its spawner may, so no two of them
# may run at the same instant - and each of them parks on one worker and
# may resume on another. What keeps them apart is this token: a worker
# holds it from its switch to one of them until it switches to a fiber
# of another unit or to none, and a fiber whose unit another worker holds
# waits on the unit's list until that worker lets go, then goes to the
# run queue of the worker that let go. Taking and giving are an exchange
# and a store; the list is behind the scheduler's lock, and only a unit
# with two of its fibers runnable on two workers at once ever uses it.
class IyiUnit
  # The id of the worker's state holding it, 0 when none does, or
  # `YIELDED` while a fiber of it that gave its worker up at a loop's
  # back-edge waits to run again; and 1 while the list holds a fiber.
  @active : Atomic(UInt64)
  @waiting : Atomic(UInt64)
  property deferred_head : IyiFiber?
  property deferred_tail : IyiFiber?

  def initialize
    @active = Atomic(UInt64).new(0_u64)
    @waiting = Atomic(UInt64).new(0_u64)
    @deferred_head = nil
    @deferred_tail = nil
  end

  # No worker's id: a state's object id is an address. A fiber preempted
  # at a back-edge keeps its unit's token through the wait, so no other
  # fiber of its unit runs between two of its statements that are not a
  # park - the promise `spawn` makes inside a parallel task - and the
  # others wait on the list as they would for a worker holding it.
  YIELDED = 1_u64

  # From worker *id* to the preempted fiber, and back to the worker that
  # takes that fiber.
  def hand_to_yielded(id : UInt64) : Bool
    @active.compare_and_set(id, YIELDED)[1]
  end

  def take_yielded(id : UInt64) : Bool
    @active.compare_and_set(YIELDED, id)[1]
  end

  def take(id : UInt64) : Bool
    @active.compare_and_set(0_u64, id)[1]
  end

  def holder : UInt64
    @active.get
  end

  def give : Nil
    @active.set(0_u64)
  end

  def waiting? : Bool
    @waiting.get != 0_u64
  end

  def waiting=(any : Bool) : Bool
    @waiting.set(any ? 1_u64 : 0_u64)
    any
  end
end

# A channel's receiver node. The node rather than the fiber carries the
# queue membership; whether it still *means* anything is the nonce's
# question, answered where fibers say (`IyiFiber#park_nonce`).
class IyiWaiter
  @fiber : IyiFiber
  @nonce : UInt64
  property next_node : IyiWaiter?
  property prev_node : IyiWaiter?
  # In a channel's queue: set when parked there, cleared when the node
  # leaves it (`Channel#unlink_receiver`), from the head or from wherever
  # it stands. A node still linked - one a cancelled park has not taken
  # out yet - is never parked again, or its link would join two queues.
  property linked : Bool
  # Where a rendezvous sender puts its value: the address of a `T` the
  # parked receive owns, written only while the node is `current?`, so
  # only while that receive is suspended in the park that made it. The
  # flag is the receipt: a woken receive that was handed a value answers
  # it, whatever else has happened since (`Channel#hand`).
  @slot : UInt64
  property handed : Bool

  def initialize(@fiber : IyiFiber, @nonce : UInt64, @slot : UInt64)
    @next_node = nil
    @prev_node = nil
    @linked = false
    @handed = false
  end

  # The same node for another park of the same fiber.
  def renew(nonce : UInt64, slot : UInt64) : Nil
    @nonce = nonce
    @slot = slot
    @next_node = nil
    @prev_node = nil
    @handed = false
  end

  def fiber : IyiFiber
    @fiber
  end

  def slot : UInt64
    @slot
  end

  # Still the park it was made for: the fiber is channel-parked and has
  # not parked anywhere newer.
  def current? : Bool
    @fiber.state == IyiFiberState::WaitingCh && @fiber.park_nonce == @nonce
  end
end

# A channel's sender node: the same membership plus the value being sent,
# held so a rendezvous can hand it over while its owner is suspended. The
# taken flag is the delivery receipt the woken sender reads; a value never
# taken says the send failed — the channel closed, or the task was
# cancelled — and it dies with the node. The value is a field, not a
# one-element array: a parked send is one allocation, where the box made
# it three, and a ring of fibers parks on every send.
class IyiSendNode(T)
  @fiber : IyiFiber
  @nonce : UInt64
  property next_node : IyiSendNode(T)?
  property prev_node : IyiSendNode(T)?
  @value : T
  @taken : Bool
  # In a channel's queue, as `IyiWaiter#linked` is; and read by the
  # sender that parked with it, which is when its receipt is no longer
  # needed. The channel keeps one node to park its next sender with
  # (`Channel#park_send_node`), and hands it out again only when both
  # hold: a node taken off the queue has a sender yet to wake and read
  # `delivered?`, and a node still queued is a park nobody has left.
  property linked : Bool
  property read : Bool

  def initialize(@fiber : IyiFiber, @nonce : UInt64, @value : T)
    @next_node = nil
    @prev_node = nil
    @taken = false
    @linked = false
    @read = false
  end

  # The same node for another sender's park.
  def renew(fiber : IyiFiber, nonce : UInt64, value : T) : Nil
    @fiber = fiber
    @nonce = nonce
    @value = value
    @next_node = nil
    @prev_node = nil
    @taken = false
  end

  def fiber : IyiFiber
    @fiber
  end

  def current? : Bool
    @fiber.state == IyiFiberState::WaitingCh && @fiber.park_nonce == @nonce
  end

  # The box is emptied as it is read: the channel keeps this node to park
  # its next sender with, and a node kept full held the last value parked
  # through it - 48 MB after the receiver had it and let it go.
  def take : T
    @taken = true
    value = @value
    IyiScheduler.forget(pointerof(@value))
    value
  end

  # The box emptied with nothing delivered, once its send failed or its
  # select took another arm. It was left full: a select's 48 MB send arm
  # that timed out kept 45 MiB, a cancelled send 46 MiB, and a send
  # refused by a close 46 MiB more, for as long as each channel lived.
  def forget : Nil
    IyiScheduler.forget(pointerof(@value))
  end

  def delivered? : Bool
    @taken
  end
end

# ── The scheduler ──────────────────────────────────────────────────────
#
# One run queue, one sleep list, one io list, one poller fd (an epoll on
# Linux, a kqueue on darwin) — per scheduler thread, and the shape that
# makes it so is decided here before the second thread exists, because
# it is a shape the thread floor priced (GC_DESIGN.md). Every field lives
# on one `IyiSchedulerState`, and one `@[ThreadLocal]` pointer names the
# thread's own: Go's `g`. The other spelling — every field its own
# thread-local — costs a `noinline` accessor call per field per entry
# (the floor measured a thread-local touch at three times a class
# variable's), and it puts the run queue's head in a TLS block the
# collector's root walk cannot see. This spelling pays one accessor per
# entry, and roots itself the way the fibers do: every state ever made is
# on `@@states_head`, a class variable in the image's data, so the walk
# that scans the globals reaches it and every fiber it links, and the
# thread-local is a cache of a pointer the globals already hold. Zero
# means "not created yet" throughout, as before.
class IyiSchedulerState
  property current : IyiFiber?
  property run_head : IyiFiber?
  property run_tail : IyiFiber?
  property sleep_head : IyiFiber?
  property sleep_seq : UInt64
  property io_head : IyiFiber?
  # The POSIX poller's waiters by descriptor: fd * 2 for the reader, fd *
  # 2 + 1 for the writer (`IyiScheduler.io_slot`). Made at the first io
  # wait, so a state that never waits on io holds nothing of the heap's.
  property io_slots : Array(IyiFiber?)?
  property pollfd : Int64

  # The poller's event buffer, as a *pointer*.
  #
  # It was a `UInt64` holding `.address`, and an address is a number:
  # the collector is precise over a typed object's fields, so the one
  # reference to a heap buffer was invisible and the first collection
  # freed it. The kernel went on writing epoll results into a chunk the
  # allocator had already handed back - sixteen events of twelve bytes,
  # which is the 192-byte class - and the free list it scribbled over
  # took the next allocation down with it. Every program that parks on
  # the poller and lives long enough to collect once: a server, in
  # other words, which is how this was found (a `wrk` run over a
  # hundred connections, dead at the first collection).
  property events : Pointer(UInt8)
  property next_state : IyiSchedulerState?

  # The fiber that finished on this thread and is waiting for its
  # successor to hand the stack back, and the stacks already handed
  # back. Both are this thread's alone - a fiber finishes on the thread it
  # ran on last, and its successor there is the next to run on it - so
  # neither needs the lock. The pool is a list threaded through the stacks
  # themselves, at the first word above the guard page; a stack goes to
  # the pool of the thread its fiber died on, whichever mapped it.
  property dying : IyiFiber?
  property stack_pool : UInt64
  # The fiber this thread switched away from last, whose `on_cpu` the
  # context it switched to clears once it stands on its own stack.
  property left : IyiFiber?

  # What other threads hand this one (SPEC.md III.4.13), behind the
  # scheduler's lock: the fibers they woke, already `Runnable`, and the
  # fibers of this thread they cancelled, for this thread to take out of
  # its own sleep heap or poller. `mail` says either holds something, and
  # is read without the lock on every park.
  property inbox_head : IyiFiber?
  property inbox_tail : IyiFiber?
  property cancel_head : IyiFiber?
  @mail : Atomic(UInt64)
  # Under the lock: the thread has found nothing to run and is about to
  # wait in its poller, or is waiting there (`idle`); with no sleeper and
  # no io wait of its own (`quiet`); and rung since it began to wait
  # (`notified`), so a second waker does not ring again.
  property idle : Bool
  property quiet : Bool
  property notified : Bool
  # A pool worker, which takes parallel tasks; and the unstarted ones the
  # tasks it runs have spawned, the queue other workers steal from.
  property worker : Bool
  property pool_head : IyiFiber?
  property pool_tail : IyiFiber?
  # A worker's runnable fibers that may move (SPEC.md III.4.13): Go's
  # local run queue, a ring of `RING` fiber addresses the worker pushes at
  # the tail and takes from the head, and any other worker takes half of
  # from the head by one exchange (`IyiWorkers.grab`). An address is not a
  # reference the collector follows; every fiber in it is on the fiber
  # registry, which is (`IyiScheduler.register`). Made when the thread
  # becomes a worker (`make_ring`).
  @ring : Pointer(UInt64)
  @ring_head : Atomic(UInt64)
  @ring_tail : Atomic(UInt64)
  # The unit this worker holds (`IyiUnit`), while it runs a fiber of it
  # and until it switches to a fiber of another or to none.
  property unit : IyiUnit?
  # Rung by a worker with a fiber for another to run, and looking for it
  # (`IyiWorkers.wake_one`), under the scheduler's lock.
  property spinning : Bool
  # Descriptors another thread closed while a fiber of this one may wait
  # on them, behind the scheduler's lock (`IyiScheduler.wake_closed`); and
  # on Windows the completions another thread's port took for an
  # operation a fiber of this one posted (`forward_completion`), as pairs
  # of the OVERLAPPED's address and the bytes it moved.
  property closed_fds : Array(Int32)?
  property forwarded : Array(UInt64)?
  # The doorbell another thread rings: an eventfd in this thread's epoll on
  # Linux, 1 once the `EVFILT_USER` event is on its kqueue on darwin, and
  # on Windows the OVERLAPPED a ring posts to its port (`wake_token`).
  property wake_fd : Int64
  property wake_token : Pointer(UInt8)

  # The thread's own fiber, the one with no task above it: a deadlock is
  # reported on its stack, whichever fiber's park found it.
  property root : IyiFiber?
  # Parks counted, and when the poller was last asked without waiting, so
  # it is asked even while the run queue never empties
  # (`IyiScheduler.reschedule`).
  property parks : UInt64
  property polled_at : Int64
  # Preemption at loop back-edges (SPEC.md III.4.13, part 9). `switches`
  # counts this worker's switches and back-edge slow paths, and is all the
  # pool's monitor reads to know whether one task has held the worker for
  # a quantum; `preempt_word` is the address of this worker's own
  # `IyiWorkers.@@preempt`, a thread-local, which the monitor raises.
  # `watch_seen` and `watch_ticks` are the monitor's alone: the count it
  # saw last and how many of its looks have seen it unchanged. `looks`
  # counts `worker_next`, for the turn preempted tasks get first.
  property switches : UInt64
  property preempt_word : UInt64
  property watch_seen : UInt64
  property watch_ticks : UInt64
  property looks : UInt64

  {% if flag?(:win32) %}
    # Windows' deadline: the timer this thread arms for the nearest
    # sleeper, and the two handles it waits on — the completion port and
    # that timer. The pair is a heap buffer held as a typed pointer for
    # the reason `events` above is: an address parked in a number is a
    # reference the collector cannot see. Zero timer means the machine
    # refused a high-resolution one and the poller is back on the
    # millisecond timeout.
    #
    # Declared with their zeroes and read by hand, rather than through
    # `property`: that macro writes the type alone, and a field the
    # `initialize` below does not list is nilable, while listing them
    # there means writing that method twice — once per platform, since
    # an assignment inside a macro conditional is not counted either.
    @deadline_timer : Int64 = 0_i64
    @wait_handles : Pointer(UInt8) = Pointer(UInt8).new(0_u64)
    # The fiber on this thread waiting for standard input's reader, which
    # posts to this thread's port (`IyiStdinReader.read`).
    property stdin_waiter : IyiFiber?

    def deadline_timer : Int64
      @deadline_timer
    end

    def deadline_timer=(handle : Int64) : Int64
      @deadline_timer = handle
    end

    def wait_handles : Pointer(UInt8)
      @wait_handles
    end

    def wait_handles=(pair : Pointer(UInt8)) : Pointer(UInt8)
      @wait_handles = pair
    end
  {% end %}

  def initialize
    @pollfd = 0_i64
    @events = Pointer(UInt8).new(0_u64)
    @stack_pool = 0_u64
    @sleep_seq = 0_u64
    @parks = 0_u64
    @polled_at = 0_i64
    @switches = 0_u64
    @preempt_word = 0_u64
    @watch_seen = 0_u64
    @watch_ticks = 0_u64
    @looks = 0_u64
    @io_slots = nil
    @mail = Atomic(UInt64).new(0_u64)
    @idle = false
    @quiet = false
    @notified = false
    @worker = false
    @ring = Pointer(UInt64).new(0_u64)
    @ring_head = Atomic(UInt64).new(0_u64)
    @ring_tail = Atomic(UInt64).new(0_u64)
    @spinning = false
    @wake_fd = 0_i64
    @wake_token = Pointer(UInt8).new(0_u64)
  end

  # Whether another thread has handed this one a fiber or a cancel: one
  # load, without the lock, which the lock's own reading then confirms.
  def mail? : Bool
    @mail.get != 0_u64
  end

  def post_mail : Nil
    @mail.set(1_u64)
  end

  def clear_mail : Nil
    @mail.set(0_u64)
  end

  RING = 256_u64

  # Made when the thread becomes a worker, before any other worker can
  # see it, and never again: thieves read it without the lock.
  def make_ring : Nil
    @ring = Pointer(UInt64).malloc(RING) if @ring.address == 0_u64
  end

  def ring : Pointer(UInt64)
    @ring
  end

  # The ring's slot for position *index*, which counts up for ever and
  # wraps at `RING`.
  def slot(index : UInt64) : UInt64
    Pointer(UInt64).new(@ring.address &+ (index & (RING &- 1_u64)) &* 8_u64).value
  end

  def set_slot(index : UInt64, address : UInt64) : Nil
    Pointer(UInt64).new(@ring.address &+ (index & (RING &- 1_u64)) &* 8_u64).value = address
  end

  def ring_head : UInt64
    @ring_head.get
  end

  def ring_tail : UInt64
    @ring_tail.get
  end

  def ring_tail=(tail : UInt64) : UInt64
    @ring_tail.set(tail)
    tail
  end

  def take_ring_head(seen : UInt64, past : UInt64) : Bool
    @ring_head.compare_and_set(seen, past)[1]
  end

  # Fibers in the ring now: a number that may be old by the time it is
  # read, for a decision that a wrong guess only delays.
  def ring_size : UInt64
    tail = @ring_tail.get
    head = @ring_head.get
    tail >= head ? tail - head : 0_u64
  end
end

# The scheduler's lock (SPEC.md III.4.13): channels, groups, the joiner
# chains, every thread's inbox and the pool's queues are behind it once a
# second scheduler thread exists, and before that it is a load and a
# branch. One lock for all of them, not one per channel: `select` parks
# on several channels at once and a cancel walks groups whose tasks are on
# several threads, and one lock has no order to get wrong. A holder never
# parks a fiber or waits on anything with it held - every park lets go of
# it before `reschedule` - so what it covers is a few pointer moves.
#
# Not the runtime lock (prelude.iyi), which a collection takes before it
# stops anything: a collection takes no scheduler lock, so a thread
# stopped holding this one stops nothing. The order, where both are taken,
# is this one first.
class IyiSchedLock
  @@word : UInt64 = 0_u64
  # The state of the thread holding it, so a panic raised inside a
  # critical section lets it go on its way out rather than spinning on it
  # forever in its own cleanup (`release_held`).
  @@holder : UInt64 = 0_u64

  def self.word : Pointer(Atomic(UInt64))
    Pointer(Atomic(UInt64)).new(pointerof(@@word).address)
  end

  # Read before the exchange, as the runtime lock is, so a spinner does
  # not take the line for writing on every turn; past 128 turns it gives
  # its core away, since a holder preempted with the lock is what it waits
  # for then.
  @[Effect(:scheduler)]; def self.lock : Nil
    return unless IyiScheduler.shared?
    word = self.word
    spins = 0
    while true
      if word.value.get == 0_u64 && word.value.compare_and_set(0_u64, 1_u64)[1]
        @@holder = IyiScheduler.state_id
        return
      end
      spins = spins &+ 1
      {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
        IyiThread.yield_cpu if spins & 127 == 0
      {% end %}
      {% if flag?(:x86_64) %}
        asm("pause" :::: "volatile")
      {% else %}
        asm("yield" :::: "volatile")
      {% end %}
    end
  end

  def self.unlock : Nil
    return unless IyiScheduler.shared?
    @@holder = 0_u64
    word.value.set(0_u64)
  end

  # Whether this thread holds it.
  def self.held_here? : Bool
    return false unless IyiScheduler.shared?
    id = IyiScheduler.state_id
    id != 0_u64 && word.value.get == 1_u64 && @@holder == id
  end

  # Let go, when this thread holds it: a panic on its way to the task's
  # boundary, which takes the lock itself.
  def self.release_held : Nil
    unlock if held_here?
  end
end

class IyiScheduler
  # Set by `exit`: the process is ending, and a group's join owes it no
  # wait (`IyiGroup#join`).
  @@exiting = false

  def self.exiting? : Bool
    @@exiting
  end

  def self.exiting=(value : Bool) : Nil
    @@exiting = value
  end

  @[ThreadLocal]
  @@state : IyiSchedulerState?
  @@states_head : IyiSchedulerState?

  # Whether a second scheduler thread has ever been started (III.4.13):
  # from then on fibers on two threads may wake each other, and the
  # scheduler's lock is taken. Set once, on the thread that starts the
  # second, before the thread exists, and never cleared - a program with
  # one scheduler thread pays a load and a branch for the lock.
  @@shared = false
  # Threads started that have not made their scheduler state yet, behind
  # the scheduler's lock: a deadlock is not named while one is coming.
  @@coming : Int64 = 0_i64

  def self.shared? : Bool
    @@shared
  end

  # This thread's state, by its object id, or 0 before it has one; read
  # without making it, for the lock's own bookkeeping.
  def self.state_id : UInt64
    state = @@state
    state.is_a?(IyiSchedulerState) ? state.object_id : 0_u64
  end

  # Called by `IyiThread.start` on the starting thread, before the thread
  # exists: the starter's own state made first, so a deadlock walk never
  # takes a thread that has not touched the scheduler for one that is
  # idle, and the new thread counted as coming until it has its own.
  def self.expect_thread : Nil
    state
    @@shared = true
    IyiSchedLock.lock
    @@coming = @@coming + 1_i64
    IyiSchedLock.unlock
  end

  # The new thread's first act: its state, made, and its count as coming
  # taken back.
  def self.adopt_thread : Nil
    state
    IyiSchedLock.lock
    @@coming = @@coming - 1_i64
    IyiSchedLock.unlock
  end

  # How many ready events one poll asks for; the per-event stride is the
  # top-level IYI_POLL_EVENT_BYTES — a 32-byte kevent on darwin, an
  # epoll_event the kernel packs on x86_64 and pads on aarch64.
  EVENTS = 16_i64

  # This thread's state, made on first touch and linked for the roots
  # before the thread-local names it. The push is under the runtime lock:
  # two threads' first touches would otherwise race for the list's head;
  # and under the scheduler's, which a deadlock's walk of the list takes.
  #
  # The first touch is its own method, kept out of line: made inline, its
  # allocation and barriers made this accessor too large to inline and
  # gave every call the prologue of a large function before the one load
  # it is - a fifth of a ring of fibers passing a token.
  def self.state : IyiSchedulerState
    state = @@state
    return state if state.is_a?(IyiSchedulerState)
    first_state_here
  end

  @[NoInline]
  private def self.first_state_here : IyiSchedulerState
    state = IyiSchedulerState.new
    IyiSchedLock.lock
    IyiRuntimeLock.lock
    state.next_state = @@states_head
    @@states_head = state
    IyiRuntimeLock.unlock
    IyiSchedLock.unlock
    @@state = state
    state
  end

  def self.first_state : IyiSchedulerState?
    @@states_head
  end

  # The running fiber, made on first touch on every thread: the thread's
  # own stack, wearing the thread's top where the main thread's wears 0
  # (the base `IyiRoots` found), so a walk from a parked main fiber's
  # saved sp stops at the right mapping's end.
  #
  # On Windows the main thread's top is taken here instead of left at 0
  # for the walk to fill in later, because later is too late: this runs
  # on the thread's own stack, where the TEB still describes it, and
  # `switch_stack` rewrites those two TEB words for every fiber it
  # enters. A zero left here was read back from inside a spawned fiber
  # as that fiber's top, and the scan of main's stack then ran off the
  # end of the mapping.
  def self.current : IyiFiber
    state = self.state
    fiber = state.current
    return fiber if fiber.is_a?(IyiFiber)
    main = IyiFiber.main
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      top = IyiThread.current_stack_top
      {% if flag?(:win32) %}
        top = IyiRoots.stack_base if top == 0
      {% end %}
      main.stack_top = top
    {% end %}
    state.current = main
    state.root = main
    main.home = state
    register(main)
    main
  end

  # Every *live* fiber, intrusively linked, for the collector's root
  # walk (GC_DESIGN.md Stage 3). The queues cannot serve that walk: a
  # channel-parked fiber lives in the channel's own node list, which the
  # scheduler cannot see, and a joiner hangs off the fiber it waits on.
  #
  # It used to be every fiber *ever made*, on the grounds that a done
  # one is skipped by state. Skipped is not free: a server makes a fiber
  # per connection, and a list nothing leaves makes every later
  # collection walk every request the process ever served. A fiber
  # leaves when its stack does, which is one step with the back link.
  # Under the runtime lock, for the reason the states are.
  @@all_head : IyiFiber?

  def self.register(fiber : IyiFiber) : Nil
    IyiRuntimeLock.lock
    head = @@all_head
    fiber.next_fiber = head
    fiber.prev_fiber = nil
    head.prev_fiber = fiber if head.is_a?(IyiFiber)
    @@all_head = fiber
    IyiRuntimeLock.unlock
  end

  def self.unregister(fiber : IyiFiber) : Nil
    IyiRuntimeLock.lock
    following = fiber.next_fiber
    previous = fiber.prev_fiber
    if previous.is_a?(IyiFiber)
      previous.next_fiber = following
    else
      @@all_head = following
    end
    following.prev_fiber = previous if following.is_a?(IyiFiber)
    fiber.next_fiber = nil
    fiber.prev_fiber = nil
    IyiRuntimeLock.unlock
  end

  # A stack for a new fiber out of this thread's pool (0 when it is
  # empty and the caller should map one), and the way back into it. The
  # list runs through the stacks themselves, at the top word - the one
  # place in the mapping that is writable on every target.
  #
  # The bottom is not: the guard page is `mprotect`ed by *length*, and a
  # length is rounded up to the platform's page. darwin on arm64 pages
  # at 16 KiB, so a guard asked for as 4 KiB is 16 KiB of unwritable
  # mapping and a link stored just above `PAGE` faults the first time a
  # fiber hands its stack back. It did, on the first program with tasks
  # in it, every run, on that platform only.
  def self.take_stack : UInt64
    st = state
    base = st.stack_pool
    return 0_u64 if base == 0
    st.stack_pool = Pointer(UInt64).new(base + IyiFiber::STACK_BYTES - 8_u64).value
    base
  end

  def self.give_stack(base : UInt64) : Nil
    st = state
    Pointer(UInt64).new(base + IyiFiber::STACK_BYTES - 8_u64).value = st.stack_pool
    st.stack_pool = base
  end

  # What a context does first once a switch has put it back on its own
  # stack, on the thread that made the switch: the fiber that thread left
  # is off its stack now, so another worker may resume it (`on_cpu`), and
  # one that died to get here hands its stack back.
  def self.landed : Nil
    st = state
    left = st.left
    if left.is_a?(IyiFiber)
      st.left = nil
      left.on_cpu = false
    end
    reap_dying
  end

  # The fiber that died to get here. This runs on the *successor's*
  # stack — the first instruction after a switch, and the first thing a
  # fresh fiber does — because nothing can free the ground it is
  # standing on. The mapping goes to the pool and the fiber leaves the
  # registry; its object stays for as long as a task handle wants it.
  def self.reap_dying : Nil
    st = state
    fiber = st.dying
    return unless fiber.is_a?(IyiFiber)
    st.dying = nil
    fiber.release_stack
    unregister(fiber)
  end

  def self.first_fiber : IyiFiber?
    @@all_head
  end

  # A thread's last act with the scheduler: its main fiber leaves the
  # registry, because its stack is about to. A spawned fiber leaves when
  # it is reaped; the main fiber was made by the first `current` on the
  # thread and was left on the list after the thread was gone, naming a
  # stack top the system then gave to the next thread it made. On a
  # Windows runner a collection bounded a new thread's stack by that
  # stale top - the new thread stopped before its first instruction, its
  # own line still with no top - and scanned up from its first rsp, whose
  # page is the stack's guard page: STATUS_GUARD_PAGE_VIOLATION in the
  # collector, which no handler of ours claims, and the process died of
  # it with nothing printed (`thread_exercise`, once in sixty runs there).
  # Only a fiber the registry holds is unlinked - `unregister` of one it
  # does not would rewrite the head.
  #
  # And what the scheduler made for the thread goes with it: the poller,
  # Windows' deadline timer, the stacks in the pool, and the state on the
  # roots' list. None of it was ever given back, and a thread that slept
  # once left two handles: a thousand of them, run and joined one after
  # another, took the process from 60 handles to 2,061, and a thousand
  # that each ran four tasks kept 259 MiB of stacks committed after they
  # had all ended.
  @[Effect(:scheduler)]; def self.retire_thread : Nil
    state = @@state
    return if state.is_a?(Nil)
    main = state.current
    if main.is_a?(IyiFiber)
      head = @@all_head
      linked = main.prev_fiber.is_a?(IyiFiber) || (head.is_a?(IyiFiber) && head.object_id == main.object_id)
      unregister(main) if linked
    end
    reap_dying
    # Off the roots' list first, under the scheduler's lock as well as the
    # runtime's, so a deadlock's walk of the list never meets a state whose
    # poller is already closed.
    IyiSchedLock.lock
    IyiRuntimeLock.lock
    previous : IyiSchedulerState? = nil
    cursor = @@states_head
    while cursor.is_a?(IyiSchedulerState)
      if cursor.object_id == state.object_id
        if previous.is_a?(IyiSchedulerState)
          previous.next_state = state.next_state
        else
          @@states_head = state.next_state
        end
        break
      end
      previous = cursor
      cursor = cursor.next_state
    end
    IyiRuntimeLock.unlock
    IyiSchedLock.unlock
    __iyi_close(state.pollfd) if state.pollfd > 0_i64
    {% if flag?(:linux) %}
      __iyi_close(state.wake_fd) if state.wake_fd > 0_i64
    {% end %}
    {% if flag?(:win32) %}
      __iyi_close(state.deadline_timer) if state.deadline_timer > 0_i64
    {% end %}
    base = state.stack_pool
    while base != 0_u64
      following = Pointer(UInt64).new(base + IyiFiber::STACK_BYTES - 8_u64).value
      __iyi_munmap(base, IyiFiber::STACK_BYTES)
      base = following
    end
    state.stack_pool = 0_u64
    @@state = nil
  end

  # The top of the fiber stack holding `address`, 0 when no fiber's
  # does: how a stopped thread's stack is bounded when the stop landed
  # on one of its fibers.
  def self.fiber_top_holding(address : UInt64) : UInt64
    fiber = @@all_head
    while fiber.is_a?(IyiFiber)
      top = fiber.stack_top
      return top if top != 0 && address < top && address >= top - IyiFiber::STACK_BYTES
      fiber = fiber.next_fiber
    end
    0_u64
  end

  {% if flag?(:win32) %}
    # Whether *address* is below the usable low end of a live fiber stack,
    # which is how a fiber's stack running out is told from a wild pointer
    # on Windows. There is no signal and no `sigaltstack` here, so the two
    # faults a fiber's edge can raise both arrive at the same handler and
    # it has to tell them apart by address:
    #
    #   * STATUS_STACK_OVERFLOW, which the kernel answers when the stack it
    #     grows a guard page at a time reaches the handler's room at its
    #     bottom (`map_stack`) - the ordinary way a fiber runs out; and
    #   * an access violation in the uncommitted page under that room,
    #     which is a frame big enough to step over the guard page whole.
    #
    # The range is therefore the whole reservation: the pages the kernel
    # had not grown into when the fault came, the wall and the room.
    # Including the room, which is committed and never faults, means a
    # handler that overran it still says what happened rather than
    # calling it a memory fault.
    def self.fiber_guard_hit?(address : UInt64) : Bool
      fiber = @@all_head
      while fiber.is_a?(IyiFiber)
        top = fiber.stack_top
        if top != 0
          # Anywhere in the reservation: the pages the kernel had not grown
          # into yet as well as the wall and the slack at its bottom.
          low = top - IyiFiber::STACK_BYTES
          return true if address >= low && address < top
        end
        fiber = fiber.next_fiber
      end
      false
    end
  {% end %}

  # The running fiber's stack top, 0 when it is the main fiber (or no
  # fiber has run yet). Read without making anything: the collector asks
  # this from inside a collection.
  def self.current_stack_top : UInt64
    state = @@state
    return 0_u64 if state.is_a?(Nil)
    fiber = state.current
    return 0_u64 if fiber.is_a?(Nil)
    fiber.stack_top
  end

  # A channel park: the nonce that distinguishes this suspension from
  # every earlier one, so a queue node a cancellation left behind is
  # skipped by arithmetic rather than unlinked by hand. `select` parks
  # once and stamps every arm's node with the one nonce.
  def self.park(fiber : IyiFiber) : UInt64
    nonce = fiber.park_nonce + 1
    fiber.park_nonce = nonce
    fiber.state = IyiFiberState::WaitingCh
    nonce
  end

  # Zero the value *slot* holds, once a channel has handed it out, so the
  # channel does not keep it reachable (`Channel#shift_item`,
  # `IyiSendNode#take`). Read again only after a store writes it anew.
  def self.forget(slot : Pointer(T)) : Nil forall T
    bytes = slot.as(Pointer(UInt8))
    index = 0
    while index < sizeof(T)
      bytes[index] = 0_u8
      index = index + 1
    end
  end

  # Runnable on this thread: a fiber that may move into a worker's ring,
  # where another worker may take it (`IyiWorkers.push_runnable`), and
  # any other - a `homebound` one included - into the thread's own list.
  # A fiber this thread woke out of its sleep heap or io list leaves them
  # here, so it is no longer listed on this thread (`IyiFiber#unlist`).
  def self.enqueue(fiber : IyiFiber) : Nil
    fiber.state = IyiFiberState::Runnable
    fiber.next_run = nil
    state = self.state
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      if state.worker && fiber.unit.is_a?(IyiUnit)
        fiber.unlist(state.object_id)
        unless fiber.homebound
          IyiWorkers.push_runnable(state, fiber)
          return
        end
      end
    {% end %}
    tail = state.run_tail
    if tail.is_a?(IyiFiber)
      tail.next_run = fiber
    else
      state.run_head = fiber
    end
    state.run_tail = fiber
  end

  def self.dequeue(state : IyiSchedulerState) : IyiFiber?
    head = state.run_head
    return nil unless head.is_a?(IyiFiber)
    state.run_head = head.next_run
    state.run_tail = nil if state.run_head.is_a?(Nil)
    head.next_run = nil
    head
  end

  # A fiber parked on a peer - a channel, a join - made runnable by whoever
  # ends its wait, on whatever thread that is (SPEC.md III.4.13). A fiber
  # of a parallel task's unit may resume on any worker: woken by a fiber
  # on a worker it goes into that worker's ring, Go's rule, so a value
  # handed over is taken where it is warm and a worker with more than it
  # can run calls another to steal; woken from a thread outside the pool
  # it goes to the pool's shared queue and an idle worker is called. Any
  # other fiber goes back to its home: into its run queue there, or from
  # another thread into its inbox, and that thread is rung if it waits in
  # its poller. Under the scheduler's lock, which every peer wait is
  # behind.
  def self.ready(fiber : IyiFiber) : Nil
    home = fiber.home
    if !@@shared || !home.is_a?(IyiSchedulerState)
      enqueue(fiber)
      return
    end
    me = state
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      if fiber.unit.is_a?(IyiUnit) && !fiber.homebound
        if me.worker
          enqueue(fiber)
        else
          IyiWorkers.push_shared(fiber)
        end
        return
      end
    {% end %}
    if home.object_id == me.object_id
      enqueue(fiber)
      return
    end
    send_home(home, fiber)
  end

  # *fiber*, runnable, into the inbox of *home*, another thread, which is
  # rung if it waits in its poller. Lock held.
  def self.send_home(home : IyiSchedulerState, fiber : IyiFiber) : Nil
    fiber.state = IyiFiberState::Runnable
    fiber.next_run = nil
    tail = home.inbox_tail
    if tail.is_a?(IyiFiber)
      tail.next_run = fiber
    else
      home.inbox_head = fiber
    end
    home.inbox_tail = fiber
    home.post_mail
    ring(home)
  end

  # A cancel of a fiber whose home is another thread, waiting there until
  # that thread takes it out of its own sleep heap or poller: nothing
  # touches another thread's private lists. Lock held.
  def self.post_cancel(home : IyiSchedulerState, fiber : IyiFiber) : Nil
    return if fiber.cancel_posted
    fiber.cancel_posted = true
    fiber.next_cancel = home.cancel_head
    home.cancel_head = fiber
    home.post_mail
    ring(home)
  end

  # The doorbell, for a thread waiting in its poller. A thread that is not
  # idle reads its mail before it waits, so it is never rung; one already
  # rung is not rung twice. Lock held.
  @[Effect(:scheduler)]; def self.ring(target : IyiSchedulerState) : Nil
    return unless target.idle
    return if target.notified
    target.notified = true
    {% if flag?(:win32) %}
      LibC.PostQueuedCompletionStatus(Pointer(Void).new(target.pollfd.to_u64), 0_i32, 0_u64, target.wake_token.as(Void*))
    {% elsif flag?(:darwin) %}
      change = __iyi_kevent_change(IYI_WAKE_IDENT, IYI_WAKE_TRIGGER)
      LibC.kevent(target.pollfd.to_i32, change.as(Void*), 1,
        Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64))
    {% else %}
      one = 1_u64
      __iyi_write(target.wake_fd.to_i32, pointerof(one).as(Void*), 8_u64)
    {% end %}
  end

  # This thread's doorbell, made before the thread first marks itself
  # idle, so a waker that sees it idle always has something to ring: an
  # eventfd in the epoll on Linux, an `EVFILT_USER` event on darwin's
  # kqueue (EV_ADD | EV_CLEAR, so a ring is taken once), and on Windows an
  # OVERLAPPED of the state's own that a ring posts to the port and the
  # poller recognises.
  @[Effect(:scheduler)]; def self.ensure_doorbell(st : IyiSchedulerState) : Nil
    {% if flag?(:win32) %}
      return if st.wake_token.address != 0_u64
      pollfd
      st.wake_token = Pointer(UInt8).malloc(32_u64)
    {% elsif flag?(:darwin) %}
      return if st.wake_fd != 0_i64
      change = __iyi_kevent_change(IYI_WAKE_IDENT, IYI_WAKE_ADD)
      added = LibC.kevent(pollfd.to_i32, change.as(Void*), 1,
        Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64))
      raise "kevent could not add the scheduler's doorbell" if added < 0
      st.wake_fd = 1_i64
    {% else %}
      return if st.wake_fd != 0_i64
      port = pollfd
      # EFD_NONBLOCK | EFD_CLOEXEC.
      fd = __iyi_conc_syscall3(IYI_SYS_EVENTFD2, 0_i64, 0x80800_i64, 0_i64)
      raise "eventfd2 failed: #{fd}" if fd < 0
      event = Pointer(UInt8).malloc(16_u64)
      event.as(Pointer(UInt64)).value = 1_u64
      Pointer(UInt64).new(event.address + IYI_POLL_DATA_OFFSET).value = fd.to_u64
      added = __iyi_conc_syscall6(IYI_SYS_EPOLL_CTL, port, 1_i64, fd, event.address.to_i64, 0_i64, 0_i64)
      raise "epoll_ctl could not add the scheduler's doorbell" if added < 0
      st.wake_fd = fd
    {% end %}
  end

  # What other threads handed this one, taken under the lock: the fibers
  # they woke onto the end of the run queue, in the order they came; the
  # cancels done here, on the thread whose lists the fibers wait in; the
  # descriptors closed elsewhere that a fiber here waits on; and on
  # Windows the completions another thread's port took for operations
  # posted here.
  #
  # A fiber that may move is cancelled here only while this thread's
  # lists hold it, which only this thread can say (`IyiFiber#listed_on`):
  # a cancel posted while it waited here may arrive after it was woken,
  # ran on another worker and parked in that worker's lists.
  def self.take_mail(st : IyiSchedulerState) : Nil
    IyiSchedLock.lock
    st.clear_mail
    fiber = st.inbox_head
    st.inbox_head = nil
    st.inbox_tail = nil
    while fiber.is_a?(IyiFiber)
      following = fiber.next_run
      fiber.next_run = nil
      tail = st.run_tail
      if tail.is_a?(IyiFiber)
        tail.next_run = fiber
      else
        st.run_head = fiber
      end
      st.run_tail = fiber
      fiber = following
    end
    cancelled = st.cancel_head
    st.cancel_head = nil
    while cancelled.is_a?(IyiFiber)
      following = cancelled.next_cancel
      cancelled.next_cancel = nil
      cancelled.cancel_posted = false
      waits_here = !cancelled.unit.is_a?(IyiUnit) || cancelled.listed_on == st.object_id
      if waits_here && !cancelled.waiting_out
        cancel_wait(cancelled)
      end
      cancelled = following
    end
    closed = st.closed_fds
    if closed.is_a?(Array(Int32))
      st.closed_fds = nil
      closed.each { |fd| wake_io(fd, 5) }
    end
    {% if flag?(:win32) %}
      posted = st.forwarded
      if posted.is_a?(Array(UInt64))
        st.forwarded = nil
        index = 0
        while index + 1 < posted.size
          complete_here(posted[index], posted[index + 1].to_i64)
          index = index + 2
        end
      end
    {% end %}
    IyiSchedLock.unlock
  end

  # Nothing to run on a thread outside the pool, in a program with a
  # second scheduler thread: the thread marks itself idle - after finding
  # its mail empty, under the lock every waker takes, so no wake falls
  # between the look and the wait - and waits in its poller, where the
  # doorbell reaches it. A worker waits in `idle_worker` instead.
  #
  # A deadlock is every scheduler thread idle with nothing of its own to
  # wait for, no mail anywhere, nothing runnable or waiting to start in
  # the pool and no thread on its way: named by a thread outside the pool,
  # on its root fiber, as before, and a worker that finds it rings one to
  # say so.
  def self.wait_shared(st : IyiSchedulerState) : Nil
    ensure_doorbell(st)
    IyiSchedLock.lock
    if st.mail?
      IyiSchedLock.unlock
      return
    end
    quiet = st.io_head.is_a?(Nil) && st.sleep_head.is_a?(Nil)
    {% if flag?(:win32) %}
      quiet = quiet && st.stdin_waiter.is_a?(Nil)
    {% end %}
    st.idle = true
    st.quiet = quiet
    if quiet && all_quiet?(st)
      st.idle = false
      IyiSchedLock.unlock
      deadlock_found
      return
    end
    IyiSchedLock.unlock
    wait_for_events(true)
    IyiSchedLock.lock
    st.idle = false
    st.notified = false
    IyiSchedLock.unlock
  end

  # A worker with nothing to run, on its own fiber's stack (`IyiWorkers.work`),
  # never on the stack of a fiber that parked: that fiber may be woken and
  # taken by another worker while this one waits. It marks itself idle
  # under the lock as `wait_shared` does, and looks once more after
  # saying so: a worker pushing a fiber reads the idle count after its
  # push, and this one reads the queues after its count, so one of the
  # two sees the other (`IyiWorkers.wake_one`). A deadlock it finds is
  # rung to a thread outside the pool to name.
  def self.idle_worker(st : IyiSchedulerState) : Nil
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      ensure_doorbell(st)
      IyiSchedLock.lock
      if st.mail?
        IyiSchedLock.unlock
        return
      end
      quiet = st.io_head.is_a?(Nil) && st.sleep_head.is_a?(Nil)
      {% if flag?(:win32) %}
        quiet = quiet && st.stdin_waiter.is_a?(Nil)
      {% end %}
      st.idle = true
      st.quiet = quiet
      IyiWorkers.count_idle(1_i64)
      if IyiWorkers.work_waiting?
        st.idle = false
        IyiWorkers.count_idle(-1_i64)
        IyiSchedLock.unlock
        return
      end
      ring_reporter if quiet && all_quiet?(st)
      IyiSchedLock.unlock
      wait_for_events(true)
      IyiSchedLock.lock
      st.idle = false
      st.notified = false
      IyiWorkers.count_idle(-1_i64)
      # The pool's monitor parks while every worker is idle, and this one
      # is about to run something (`IyiWorkers.monitor`).
      nudge = IyiWorkers.take_monitor_wake
      IyiSchedLock.unlock
      IyiWorkers.wake_monitor if nudge
    {% end %}
  end

  # Every other scheduler thread idle with nothing of its own to wait for
  # and no mail, and nothing on its way. Lock held.
  def self.all_quiet?(me : IyiSchedulerState) : Bool
    return false if @@coming > 0_i64
    return false unless IyiWorkers.queues_empty?
    other = @@states_head
    while other.is_a?(IyiSchedulerState)
      if other.object_id != me.object_id
        return false unless other.idle && other.quiet && !other.mail?
      end
      other = other.next_state
    end
    true
  end

  # A worker found the deadlock: the first thread outside the pool is rung
  # to name it on its root. Lock held.
  def self.ring_reporter : Nil
    other = @@states_head
    while other.is_a?(IyiSchedulerState)
      unless other.worker
        ring(other)
        return
      end
      other = other.next_state
    end
  end

  # Park the calling fiber (its state and queue membership are already
  # set) and run something else. Returns when this fiber is switched back
  # in — possibly without a switch at all, when the wait ended before
  # anything else got to run.
  #
  # Every `POLL_EVERY`th park looks at the clock as well, and at the poller
  # once `POLL_IO_NS` have passed since it last looked, without waiting.
  # Both were looked at only once the run queue was empty, and a yield
  # keeps it full: a task polling a flag with `sleep(0)` spun 20,000,000
  # times in 666-813 ms while the task sleeping 10 ms to set it never woke,
  # and a `sleep(50)` beside a channel ping-pong woke after 545-669 ms, when
  # the ping-pong had stopped by itself. The poller is a system call, and
  # asked every 256 parks it put 15 ns on a 90 ns round trip beside a parked
  # `accept`; the clock alone is not measurable there.
  #
  # Mail from other threads is looked at on every park, one load, and taken
  # before the run queue is: a fiber another thread woke waits behind no
  # more than what was already runnable here.
  #
  # A pool worker looks for the next fiber without waiting
  # (`worker_next`), and with none switches to its own fiber, which waits
  # for one (`IyiWorkers.work`): the fiber that parked may be woken and
  # resumed by another worker meanwhile, and nothing of this worker may
  # still be standing on its stack then.
  POLL_EVERY =     256_u64
  POLL_IO_NS = 1000000_i64

  def self.reschedule : Nil
    raise "a fiber parked holding the scheduler's lock" if IyiSchedLock.held_here?
    st = state
    parks = st.parks &+ 1_u64
    st.parks = parks
    poll_now(st) if parks % POLL_EVERY == 0_u64
    if st.worker
      fiber = worker_next(st)
      if fiber.is_a?(IyiFiber)
        switch_to(fiber)
        return
      end
      root = st.root
      raise "a pool worker with no fiber of its own" unless root.is_a?(IyiFiber)
      release_unit(st)
      switch_to(root)
      return
    end
    while true
      take_mail(st) if st.mail?
      fiber = dequeue(st)
      if fiber.is_a?(IyiFiber)
        switch_to(fiber)
        return
      end
      if @@shared
        wait_shared(st)
      else
        wait_for_events(true)
      end
    end
  end

  # The next fiber pool worker *st* runs, found without waiting, or nil:
  # its mail, then the fibers only it may run (`homebound`), then its own
  # ring, then the queues behind the lock - fibers a thread outside the
  # pool woke, the unstarted tasks its own tasks spawned, the pool's
  # injection queue - then half of another worker's ring, then another
  # worker's unstarted task - then a task preempted at a loop's back-edge
  # (`IyiWorkers.preempted`), last, since it has had a quantum and every
  # other one is waiting for its first; every `PREEMPTED_TURN`th look takes
  # one first, so a stream of short tasks cannot keep it waiting for
  # ever, Go's `schedtick % 61` for its global queue. A fiber of a unit
  # another worker holds is left on that unit's list (`take_unit`) and the
  # look goes on.
  PREEMPTED_TURN = 61_u64

  def self.worker_next(st : IyiSchedulerState) : IyiFiber?
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      take_mail(st) if st.mail?
      looks = st.looks &+ 1_u64
      st.looks = looks
      while true
        fiber = dequeue(st)
        fiber = IyiWorkers.take_preempted unless fiber.is_a?(IyiFiber) || looks % PREEMPTED_TURN != 0_u64
        fiber = IyiWorkers.pop(st) unless fiber.is_a?(IyiFiber)
        fiber = IyiWorkers.take_queued(st) unless fiber.is_a?(IyiFiber)
        fiber = IyiWorkers.steal(st) unless fiber.is_a?(IyiFiber)
        fiber = IyiWorkers.take_preempted unless fiber.is_a?(IyiFiber)
        return nil unless fiber.is_a?(IyiFiber)
        return fiber if take_unit(st, fiber)
      end
    {% end %}
    nil
  end

  # Whether worker *st* may run *fiber* now: a fiber of no unit, or of
  # the unit it holds, or of one it takes here, giving up the one it held
  # (`IyiUnit`). Otherwise another worker holds the unit, and the fiber
  # waits on the unit's list until that worker lets it go - looked at
  # once more after it is on the list, since the holder may have let go
  # between the take and the list, and gives the list to whoever lets go
  # (`release_unit`): one of the two sees the other.
  def self.take_unit(st : IyiSchedulerState, fiber : IyiFiber) : Bool
    unit = fiber.unit
    return true unless unit.is_a?(IyiUnit)
    held = st.unit
    return true if held.is_a?(IyiUnit) && held.object_id == unit.object_id
    id = st.object_id
    # A preempted fiber takes its unit's token back from itself.
    if fiber.preempted && unit.take_yielded(id)
      fiber.preempted = false
      release_unit(st)
      st.unit = unit
      return true
    end
    unless unit.take(id)
      IyiSchedLock.lock
      unless unit.take(id)
        fiber.next_run = nil
        tail = unit.deferred_tail
        if tail.is_a?(IyiFiber)
          tail.next_run = fiber
        else
          unit.deferred_head = fiber
        end
        unit.deferred_tail = fiber
        unit.waiting = true
        drain_unit(st, unit) if unit.holder == 0_u64
        IyiSchedLock.unlock
        return false
      end
      IyiSchedLock.unlock
    end
    release_unit(st)
    st.unit = unit
    true
  end

  # The unit worker *st* holds let go of, and the fibers that waited for
  # it onto this worker's ring.
  def self.release_unit(st : IyiSchedulerState) : Nil
    held = st.unit
    return unless held.is_a?(IyiUnit)
    st.unit = nil
    held.give
    return unless held.waiting?
    IyiSchedLock.lock
    drain_unit(st, held)
    IyiSchedLock.unlock
  end

  # The fibers that waited for *unit*, onto worker *st*'s ring - and a
  # `homebound` one back to its home, which alone may run it. Lock held.
  def self.drain_unit(st : IyiSchedulerState, unit : IyiUnit) : Nil
    unit.waiting = false
    fiber = unit.deferred_head
    unit.deferred_head = nil
    unit.deferred_tail = nil
    while fiber.is_a?(IyiFiber)
      following = fiber.next_run
      fiber.next_run = nil
      home = fiber.home
      if fiber.homebound && home.is_a?(IyiSchedulerState) && home.object_id != st.object_id
        send_home(home, fiber)
      else
        enqueue(fiber)
      end
      fiber = following
    end
  end

  # The expired sleepers and, when its time has come, the poller's news,
  # without waiting; nothing at all when nobody waits on either.
  @[Effect(:scheduler)]; def self.poll_now(st : IyiSchedulerState) : Nil
    io = !st.io_head.is_a?(Nil)
    {% if flag?(:win32) %}
      io = io || IyiStdinReader.waiting?
    {% end %}
    if io
      now = __iyi_monotonic_ns
      if now - st.polled_at >= POLL_IO_NS
        st.polled_at = now
        wait_for_events(false)
        return
      end
    end
    wake_expired_sleepers
  end

  # How a spawned fiber's stack is made, installed by the first spawn
  # (`IyiGroup#spawn`) and called through rather than named here: a
  # program that parks without spawning - a thread waiting on a lock -
  # switches too, and naming `prepare_stack` in the switch put the stack
  # mapping's `mprotect` into every such program, one more name on
  # darwin's floor for a stack it never makes.
  @@stack_maker : Proc(IyiFiber, Nil)?

  def self.make_stacks_with(&maker : IyiFiber -> Nil) : Nil
    @@stack_maker = maker
  end

  def self.makes_stacks? : Bool
    !@@stack_maker.is_a?(Nil)
  end

  # A fiber gets its stack here, the first time it is switched to, rather
  # than when it is spawned: a spawn that mapped one put a stack under
  # every task not yet run, so a loop spawning 100,000 short tasks made
  # 100,000 mappings and a guard page each before the first of them ran
  # (340 ms, and on a kernel with the default 65,530 mappings a process,
  # a burst of 33,000 was the end of it). Taken at the first switch, the
  # stack a finished task leaves in the pool is the next one's. Only a
  # fiber that has never run has no saved stack pointer: the main fiber
  # has one from the switch that left it, and a finished one is never
  # switched to.
  #
  # On a pool worker the fiber may have parked on another worker a moment
  # ago, and been woken and taken from there before that worker's switch
  # away from it had saved its stack pointer: the switch waits for that
  # (`IyiFiber#on_cpu`), which is the length of the other worker's switch.
  # The fiber's home is this worker from here, the thread its next sleep
  # or io wait parks in.
  @[Effect(:scheduler)]; def self.switch_to(fiber : IyiFiber) : Nil
    st = state
    previous = current
    if fiber.sp_slot.address == previous.sp_slot.address
      fiber.state = IyiFiberState::Running
      return
    end
    if fiber.saved_sp == 0_u64
      maker = @@stack_maker
      maker.call(fiber) unless maker.is_a?(Nil)
    end
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      if st.worker
        spins = 0
        while fiber.on_cpu?
          spins = spins &+ 1
          IyiThread.yield_cpu if spins & 127 == 0
          IyiThread.spin_pause
        end
        fiber.on_cpu = true
        fiber.home = st
        st.left = previous
        st.switches = st.switches &+ 1_u64
      end
    {% end %}
    st.current = fiber
    __iyi_ctx_swap(previous.sp_slot, fiber.sp_slot)
    # Running from here, on its own stack, and not before: the collector's
    # fiber walk skips the running fiber, whose stack the thread's own scan
    # covers from its sp, and a fiber marked running before the switch got
    # there was covered by neither - a thread another thread stopped in
    # between had what only that fiber's stack named freed under it.
    current.state = IyiFiberState::Running
    # Back on this fiber's own stack, which is the first moment a stack
    # somebody else finished with can be taken back - on whichever thread
    # this fiber resumed, which is the one `landed` asks for.
    landed
    deadlock if previous.deadlocked
  end

  # The trampoline lands here on a fresh fiber's first resume.
  def self.run_spawned_fiber : Nil
    fiber = current
    fiber.state = IyiFiberState::Running
    # A fresh fiber is also a successor: the switch that got here
    # returned into the trampoline rather than into `switch_to`.
    landed
    body = fiber.proc
    body.call unless body.is_a?(Nil)
    # Done and its readers woken in one step under the scheduler's lock,
    # which every reader checks `Done` under: a reader on another thread
    # either sees it done or is on the chain this wakes.
    IyiSchedLock.lock
    fiber.state = IyiFiberState::Done
    wake_joiners(fiber)
    IyiSchedLock.unlock
    # Never returns: a done fiber is never enqueued, so the switch away
    # is the last instruction of this stack's life — and the stack is
    # the next fiber's to take back, named here because after the
    # switch nobody else knows which one it was.
    state.dying = fiber
    reschedule
    raise "a done fiber was scheduled"
  end

  # ── Blocking, and what unblocks it ───────────────────────────────────

  @[Effect(:scheduler)]; def self.sleep_current(ms : Int32) : Nil | Cancelled
    fiber = current
    return Cancelled.new if fiber.cancelled
    if ms <= 0
      # A yield: to the back of the run queue, so every task already
      # runnable runs first. It returned at once, and a task polling with
      # `sleep(0)` spun 50 million times while the task that would have
      # set its flag never ran - the runtime has no other way to yield.
      enqueue(fiber)
      reschedule
      return fiber.cancelled ? Cancelled.new : nil
    end
    fiber.deadline = __iyi_monotonic_ns + ms.to_i64 * 1000000_i64
    fiber.state = IyiFiberState::Sleeping
    sleep_insert(fiber)
    listed(fiber)
    reschedule
    return Cancelled.new if fiber.cancelled
    nil
  end

  # The two halves of an overlapped operation, so a caller that is not a
  # read can use the same park. Windows has no readiness model: a socket's
  # `accept` and a `send` that filled the peer's window cannot be waited
  # for, they can only be *posted* and completed, so `std/socket` posts
  # `AcceptEx` and `WSASend` itself and parks here. Measured before this
  # existed: a listening socket answers the zero-byte read trick in 32 us
  # with a failure, so an accept loop over it hot-spun, and the sleep it
  # would otherwise fall back to costs 15.6 ms a round on the default
  # Windows timer tick.
  #
  # `arm` associates the handle with the port, zeroes the running fiber's
  # OVERLAPPED and answers it; `park` waits for the port to name that
  # operation. Between the two the caller makes exactly one overlapped
  # call, and reads `GetLastError` itself: ERROR_IO_PENDING (997) means
  # park, anything else means the call answered on the spot.
  #
  # *direction* is the rule `wait_posix` keeps on POSIX: one fiber reading a
  # handle and one writing it, and a second in the same direction refused.
  # Windows posted both and let them race - two readers took the bytes in
  # turns, which a program written there panicked over everywhere else.
  def self.arm_overlapped_current(handle : Void*, direction : Int32 = 0) : Pointer(UInt8)
    fiber = current
    if direction != 0
      other = state.io_head
      while other.is_a?(IyiFiber)
        if other.wait_handle.address == handle.address && other.io_direction == direction
          raise "two fibers #{direction == 1 ? "reading" : "writing"} one fd"
        end
        other = other.next_io
      end
    end
    fiber.io_direction = direction
    port = Pointer(Void).new(pollfd.to_u64)
    ov = fiber.wait_overlapped
    # A handle belongs to one port, and each thread has its own. Every
    # operation associated the handle and ignored the answer, which after
    # the first is a refusal (87): a socket read on the main thread and
    # handed to a worker kept its completions on the main thread's port,
    # and the worker's read waited forever, its deadline with it. The
    # handle is moved to this thread's port each time instead - a handle
    # on none refuses the move and is associated - and the move clears the
    # skip-on-success mode, so the mode follows it: without it, 50 reads
    # that answered at once left 50 completions that woke the next read.
    LibC.CreateIoCompletionPort(handle, port, 0_u64, 0_i32) if move_to_port(handle, port, ov) != 0
    LibC.SetFileCompletionNotificationModes(handle, 1_u8)

    Pointer(UInt64).new(ov.address + 0_u64).value = 0_u64
    Pointer(UInt64).new(ov.address + 8_u64).value = 0_u64
    Pointer(UInt64).new(ov.address + 16_u64).value = 0_u64
    Pointer(UInt64).new(ov.address + 24_u64).value = 0_u64
    # Whose io list will hold the fiber, written before the operation is
    # posted: a handle a fiber of this one's unit moved to another
    # worker's port since has this completion arrive there, which hands it
    # here (`forward_completion`).
    Pointer(UInt64).new(ov.address + 32_u64).value = state.object_id

    fiber.wait_handle = handle
    fiber.io_bytes_read = 0_i64
    ov
  end

  {% if flag?(:win32) %}
    # `NtSetInformationFile`, asked of ntdll once and kept as a proc's two
    # words: ntdll is in every process, and naming it on the import table
    # adds a DLL to the floor `bench/concurrency_exercise.sh` reads.
    @@set_information = Pointer(UInt64).new(0_u64)

    # FileReplaceCompletionInformation (61, Windows 8.1): *handle*'s
    # completions go to *port* from here on; nonzero for a handle on no
    # port. *scratch* is the fiber's OVERLAPPED, which holds the
    # information and the status block for the call and is zeroed after.
    @[Effect(:scheduler)]; def self.move_to_port(handle : Void*, port : Void*, scratch : Pointer(UInt8)) : Int32
      call = @@set_information
      if call.address == 0_u64
        call = Pointer(UInt64).malloc(2_u64)
        call.value = LibC.GetProcAddress(LibC.GetModuleHandleA("ntdll.dll".to_unsafe), "NtSetInformationFile".to_unsafe).address
        @@set_information = call
      end
      Pointer(UInt64).new(scratch.address).value = port.address
      Pointer(UInt64).new(scratch.address + 8_u64).value = 0_u64
      set = call.as(Pointer(Proc(Void*, Void*, Void*, UInt32, Int32, Int32))).value
      set.call(handle, Pointer(Void).new(scratch.address + 16_u64), scratch.as(Void*), 16_u32, 61)
    end

    # A park for standard input's reader thread: off the io list, which is
    # the port's operations, and woken by `IyiStdinReader.delivered`. A
    # fiber cancelled already parks here to wait out a read it withdrew,
    # and is not ended by that cancel a second time (`listed`).
    def self.park_stdin_current(ms : Int32) : Nil
      fiber = current
      waiting_out = fiber.cancelled
      fiber.state = IyiFiberState::WaitingIo
      fiber.wait_handle = Pointer(Void).new(0_u64)
      arm_deadline(fiber, ms)
      listed(fiber, waiting_out)
      reschedule
    end
  {% end %}

  # The park of a posted operation. A fiber cancelled already parks here
  # to wait out the packet of the operation its cancel ended, and is not
  # ended by that cancel a second time (`listed`); it parks on the thread
  # whose port the packet comes to, since its cancel made it `homebound`
  # (`cancel_wait`), which it is not past this park.
  def self.park_overlapped_current(ms : Int32 = -1) : Int64 | Cancelled
    fiber = current
    waiting_out = fiber.cancelled
    fiber.state = IyiFiberState::WaitingIo
    st = state
    fiber.next_io = st.io_head
    st.io_head = fiber
    arm_deadline(fiber, ms)
    listed(fiber, waiting_out)
    reschedule
    fiber.homebound = false

    return Cancelled.new if fiber.cancelled
    fiber.io_bytes_read
  end

  @[Effect(:scheduler)]; def self.read_current(fd : Int32 | Int64, buffer : Void*, count : UInt64, ms : Int32 = -1) : Int64 | Cancelled
    fiber = current
    return Cancelled.new if fiber.cancelled

    handle = Pointer(Void).new(0_u64)
    if fd == 0_i32 || fd == 0_i64
      handle = LibC.GetStdHandle(-10)
      # A pipe or a console waits, and is read by a thread of its own; a
      # zero-byte read is a question about readiness, which the thread asks
      # a pipe the way it reads one, and a console would answer by taking
      # a character: a console is ready at once, which is this platform's
      # limit, since what its line reads waits for Enter either way. A disk
      # file answers at once and is read where it is asked, without an
      # OVERLAPPED: on a handle not opened for one, its offset is where the
      # read starts, and every read would start at 0.
      return __iyi_read(0_i64, buffer, count) unless IyiStdinReader.waits?(handle)
      console = IyiConsole.console?(0_i64, handle)
      return 0_i64 if count == 0_u64 && console
      return IyiStdinReader.read(handle, console, buffer, count, ms)
    elsif fd == 1_i32 || fd == 1_i64
      handle = LibC.GetStdHandle(-11)
    elsif fd == 2_i32 || fd == 2_i64
      handle = LibC.GetStdHandle(-12)
    else
      # A descriptor a caller already closed is -1, and `to_u64` on a
      # negative number is a *checked* convert: a wait on a closed
      # descriptor died of "arithmetic overflow" — a sentence with
      # nothing in it about descriptors — in a frame the caller never
      # wrote. std/socket met it by closing a listener from inside a
      # handler while an accept was parked. A read of something already
      # gone is a read of nothing, and the convert below keeps its check
      # for every value that is not that.
      return 0_i64 if fd.to_i64 < 0_i64
      handle = Pointer(Void).new(fd.to_i64.to_u64)
    end

    ov = arm_overlapped_current(handle, 1)

    read_bytes = uninitialized Int32
    ok = LibC.ReadFile(handle, buffer, count.to_i32, pointerof(read_bytes), ov.as(Void*))
    if ok != 0
      return read_bytes.to_i64
    end

    err = LibC.GetLastError
    if err != 997_i32
      if err == 109_i32 || err == 38_i32
        return 0_i64
      end
      if err == 87_i32
        if LibC.ReadFile(handle, buffer, count.to_i32, pointerof(read_bytes), nil) != 0
          return read_bytes.to_i64
        end
      end
      return 0_i64
    end

    parked = park_overlapped_current(ms)
    return parked unless parked.is_a?(Cancelled)
    # Cancelled, and the read is the kernel's until its packet is off the
    # port: the bytes and the OVERLAPPED's status are written when the
    # poller takes it (`cancel` says what was measured), and a read whose
    # bytes had come already is not ended by `CancelIoEx` at all. Answered
    # `Cancelled` on the flag, those bytes were gone from the pipe and lost:
    # a sibling that wrote three and then failed left the reader's buffer
    # 0,0,0 at the answer and 97,98,99 after it, 8 runs in 8. So a status
    # still STATUS_PENDING (0x103) parks once more for the packet, as
    # `ProcessChild.settle` does, and bytes it carried are the answer.
    park_overlapped_current if Pointer(UInt64).new(ov.address).value == 0x103_u64
    fiber.io_bytes_read > 0_i64 ? fiber.io_bytes_read : parked
  end

  def self.wait_readable_current(fd : Int32 | Int64) : Nil | Cancelled
    waited = wait_readable_current(fd, -1)
    return waited if waited.is_a?(Cancelled)
    nil
  end

  # The same wait with a deadline *ms* milliseconds away, -1 for none:
  # true when *fd* is readable, false when the deadline came first. The
  # flag starts false here, not at the arm: a wait answered before arming
  # read the last one's, and after one timed-out wait a pipe holding three
  # bytes, or stdin with a line in it, was "timed out" after 0 ms.
  def self.wait_readable_current(fd : Int32 | Int64, ms : Int32) : Bool | Cancelled
    fiber = current
    fiber.timed_out = false
    return Cancelled.new if fiber.cancelled
    {% if flag?(:win32) %}
      res = read_current(fd, Pointer(Void).new(0_u64), 0_u64, ms)
      return res if res.is_a?(Cancelled)
    {% else %}
      res = wait_posix(fd.to_i32, 1, ms)
      return res if res.is_a?(Cancelled)
    {% end %}
    !fiber.timed_out
  end

  def self.wait_readable_posix(fd : Int32) : Nil | Cancelled
    wait_posix(fd, 1, -1)
  end

  # The other direction: park until *fd* can take bytes. A socket's send
  # buffer fills under a slow reader, and a write that blocked there would
  # block the thread; a fiber parks instead and the poller wakes it when
  # the kernel has room. Same registry, same one-waiter-per-fd rule.
  def self.wait_writable_current(fd : Int32 | Int64) : Nil | Cancelled
    waited = wait_writable_current(fd, -1)
    return waited if waited.is_a?(Cancelled)
    nil
  end

  # With a deadline, as `wait_readable_current`. Windows has no readiness
  # to wait for - a send there is posted, and the post is the wait, with
  # its own deadline - so it answers true at once.
  def self.wait_writable_current(fd : Int32 | Int64, ms : Int32) : Bool | Cancelled
    fiber = current
    fiber.timed_out = false
    return Cancelled.new if fiber.cancelled
    {% if flag?(:win32) %}
      true
    {% else %}
      res = wait_posix(fd.to_i32, 4, ms)
      return res if res.is_a?(Cancelled)
      !fiber.timed_out
    {% end %}
  end

  def self.wait_writable_posix(fd : Int32) : Nil | Cancelled
    wait_posix(fd, 4, -1)
  end

  # Park until *fd* can be read (1) or written (4). One reader and one
  # writer may wait on a fd at once - a WebSocket's reading fiber and its
  # writing fiber on one connection - and each is woken by its own
  # direction's event: the poller's registration for the fd is the union
  # of what its waiters want, and the event says which half is ready. A
  # second fiber in the same direction is refused: the event would wake
  # one of the two, and the other would wait for nothing.
  #
  # Mail is taken first when there is any: a descriptor another thread
  # closed under a waiter here (`wake_closed`) may be this very number
  # again by now, opened since, and the old waiter has to leave its slot
  # before a new one takes it, or the new one is refused as a second.
  @[Effect(:scheduler)]; def self.wait_posix(fd : Int32, direction : Int32, ms : Int32) : Nil | Cancelled
    fiber = current
    return Cancelled.new if fiber.cancelled
    st = state
    take_mail(st) if st.mail?
    others = io_interest(fd)
    raise "two fibers #{direction == 1 ? "reading" : "writing"} one fd" if others & direction != 0

    {% if flag?(:darwin) %}
      # EV_ADD on the direction's own filter, keyed by the fd itself:
      # EVFILT_READ (-1) or EVFILT_WRITE (-2). kqueue accepts a regular
      # file where epoll refuses one, but refuses the null device with
      # EINVAL (22) - measured on /dev/null and /dev/zero - and a fd
      # kqueue cannot watch is one whose call never parks. Same answer as
      # epoll's -EPERM below: ready now instead of dying, or a program
      # whose stdin is `< /dev/null` panics on its first wait.
      change = __iyi_kevent_change(fd, direction == 1 ? 0x1FFFF_u64 : 0x1FFFE_u64)
      added = LibC.kevent(pollfd.to_i32, change.as(Void*), 1,
        Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64)).to_i64
      return nil if added < 0 && LibC.error_location.value == 22
      raise "kevent add failed" if added < 0
    {% else %}
      # EPOLL_CTL_ADD (1) for the fd's first waiter, EPOLL_CTL_MOD (3) to
      # add a direction to one already there; the data is the fd itself.
      event = Pointer(UInt8).malloc(16_u64)
      event.as(Pointer(UInt64)).value = (others | direction).to_u64
      Pointer(UInt64).new(event.address + IYI_POLL_DATA_OFFSET).value = fd.to_u64
      added = __iyi_conc_syscall6(IYI_SYS_EPOLL_CTL, pollfd, others == 0 ? 1_i64 : 3_i64, fd.to_i64, event.address.to_i64, 0_i64, 0_i64)
      # -EPERM is epoll saying the fd is a regular file. A file never
      # blocks, which is exactly "ready now": answer it instead of dying,
      # or a program whose stdin is `< file` panics on its first wait.
      return nil if added == -1_i64
      raise "epoll_ctl add failed" if added < 0
    {% end %}

    fiber.wait_fd = fd
    fiber.wait_dir = direction
    fiber.state = IyiFiberState::WaitingIo
    io_link(fiber)
    arm_deadline(fiber, ms)
    # Said like a sleep's, so a cancel from another thread finds the
    # poller this waiter is in (`cancel_moving`).
    listed(fiber)
    reschedule
    return Cancelled.new if fiber.cancelled
    nil
  end

  # An io wait's deadline, *ms* milliseconds from now, or none for -1. The
  # fiber goes into the sleep list beside the io list; `timed_out` starts
  # false either way, so a caller reads it only after a wait that armed it.
  def self.arm_deadline(fiber : IyiFiber, ms : Int32) : Nil
    fiber.timed_out = false
    return if ms < 0
    fiber.deadline = __iyi_monotonic_ns + ms.to_i64 * 1000000_i64
    fiber.io_timed = true
    sleep_insert(fiber)
  end

  # An io wait that ended some other way leaves the sleep list, or its
  # deadline would wake the fiber a second time, wherever it is by then.
  def self.untime(fiber : IyiFiber) : Nil
    return unless fiber.io_timed
    fiber.io_timed = false
    sleep_remove(fiber)
  end

  # The directions fibers are waiting in on *fd*, as epoll bits: its two
  # slots, where it had been a walk of every fiber waiting on any fd.
  def self.io_interest(fd : Int32) : Int32
    (io_slot(fd, 1).is_a?(IyiFiber) ? 1 : 0) | (io_slot(fd, 4).is_a?(IyiFiber) ? 4 : 0)
  end

  # The fiber waiting on *fd* in *direction* (1 to read, 4 to write).
  def self.io_slot(fd : Int32, direction : Int32) : IyiFiber?
    slots = state.io_slots
    return nil if slots.is_a?(Nil)
    index = fd * 2 + (direction == 1 ? 0 : 1)
    index < slots.size ? slots[index] : nil
  end

  # Onto the io list and into its fd's slot. The list is what says that
  # anything waits on io at all; the slots are how an event, a second
  # waiter's check and a cancellation find a waiter. Each of those walked
  # the list, so every read on a server paid for every connection parked
  # beside it: a round trip over a pipe took 41 us with 4,000 idle
  # readers parked, against 2 us with none.
  def self.io_link(fiber : IyiFiber) : Nil
    st = state
    head = st.io_head
    fiber.next_io = head
    fiber.prev_io = nil
    head.prev_io = fiber if head.is_a?(IyiFiber)
    st.io_head = fiber
    slots = st.io_slots
    if slots.is_a?(Nil)
      slots = [] of IyiFiber?
      st.io_slots = slots
    end
    index = fiber.wait_fd * 2 + (fiber.wait_dir == 1 ? 0 : 1)
    while slots.size <= index
      slots << nil
    end
    slots[index] = fiber
    io_owner(index, st.object_id) if @@shared
  end

  # Off the io list and out of its slot; false when it was on neither.
  def self.io_unlink(fiber : IyiFiber) : Bool
    st = state
    before = fiber.prev_io
    after = fiber.next_io
    head = st.io_head
    if before.is_a?(IyiFiber)
      before.next_io = after
    elsif head.is_a?(IyiFiber) && head.object_id == fiber.object_id
      st.io_head = after
    else
      return false
    end
    after.prev_io = before if after.is_a?(IyiFiber)
    fiber.next_io = nil
    fiber.prev_io = nil
    slots = st.io_slots
    index = fiber.wait_fd * 2 + (fiber.wait_dir == 1 ? 0 : 1)
    if slots.is_a?(Array(IyiFiber?)) && index >= 0 && index < slots.size
      held = slots[index]
      if held.is_a?(IyiFiber) && held.object_id == fiber.object_id
        slots[index] = nil
        io_owner_clear(index, st.object_id) if @@shared
      end
    end
    true
  end

  # Which thread a fiber waits on a descriptor on, by direction - slot
  # *index* as `io_slot` numbers them, fd * 2 for the reader and + 1 for
  # the writer - for a close on another thread (`wake_closed`): a parallel
  # task's unit may close on one worker the socket one of its fibers waits
  # on in another's poller. Chunks of 4,096 descriptors, mapped when first
  # written and never moved, under a table of 1,024 mapped with the first,
  # so a reader needs no lock; past 4,194,304 descriptors nothing is
  # recorded and a close wakes its own thread's waiters only.
  IO_CHUNK  = 8192_u64
  IO_CHUNKS = 1024_u64
  @@io_owners : UInt64 = 0_u64

  def self.io_owner(index : Int32, id : UInt64) : Nil
    chunk = io_owner_chunk(index, id != 0_u64)
    return if chunk == 0_u64
    Pointer(UInt64).new(chunk &+ (index.to_u64 % IO_CHUNK) &* 8_u64).value = id
  end

  def self.io_owner_of(index : Int32) : UInt64
    chunk = io_owner_chunk(index, false)
    return 0_u64 if chunk == 0_u64
    Pointer(UInt64).new(chunk &+ (index.to_u64 % IO_CHUNK) &* 8_u64).value
  end

  # Cleared only while it still names this thread: the descriptor may have
  # been closed and its number given to a socket another thread waits on.
  def self.io_owner_clear(index : Int32, id : UInt64) : Nil
    chunk = io_owner_chunk(index, false)
    return if chunk == 0_u64
    entry = Pointer(UInt64).new(chunk &+ (index.to_u64 % IO_CHUNK) &* 8_u64)
    entry.value = 0_u64 if entry.value == id
  end

  @[Effect(:scheduler)]; private def self.io_owner_chunk(index : Int32, make : Bool) : UInt64
    # A build with no collector of iyi's own (`-Dgc_none`, `-Dgc_boehm`)
    # has no `__iyi_mmap` and no pool for a descriptor to belong to a
    # worker of, so nothing is recorded and every waiter is this thread's:
    # the spec that builds one with Boehm stopped at the mmap (job
    # 121202840186).
    {% if flag?(:gc_none) || flag?(:gc_boehm) %}
      0_u64
    {% else %}
      return 0_u64 if index < 0
      which = index.to_u64 // IO_CHUNK
      return 0_u64 if which >= IO_CHUNKS
      table = Pointer(Atomic(UInt64)).new(pointerof(@@io_owners).address).value.get
      if table == 0_u64
        return 0_u64 unless make
        IyiRuntimeLock.lock
        table = @@io_owners
        if table == 0_u64
          table = __iyi_mmap(IO_CHUNKS &* 8_u64).address
          Pointer(Atomic(UInt64)).new(pointerof(@@io_owners).address).value.set(table)
        end
        IyiRuntimeLock.unlock
      end
      entry = Pointer(Atomic(UInt64)).new(table &+ which &* 8_u64)
      chunk = entry.value.get
      if chunk == 0_u64 && make
        IyiRuntimeLock.lock
        chunk = entry.value.get
        if chunk == 0_u64
          chunk = __iyi_mmap(IO_CHUNK &* 8_u64).address
          entry.value.set(chunk)
        end
        IyiRuntimeLock.unlock
      end
      chunk
    {% end %}
  end

  # Any number of fibers wait on one task, each pushed on its chain. A
  # cancelled reader waits only for a task the cancel reached too, which
  # ends; for any other it stops (`stop_current`), because `value` has no
  # `Cancelled` to answer. It waited for that task in full: a reader of
  # an outer group's 3-second task held its failed group for 3030 ms, and
  # one whose task waited on the group's end died "deadlock".
  #
  # The task may be on another thread (III.4.13), so its state is read and
  # the chain pushed under the scheduler's lock, the one its end is
  # written under.
  def self.join(fiber : IyiFiber) : Nil
    IyiSchedLock.lock
    while fiber.state != IyiFiberState::Done
      me = current
      if me.cancelled && !fiber.cancelled
        IyiSchedLock.unlock
        stop_current
      end
      me.awaited = fiber
      me.next_joiner = fiber.joiner
      fiber.joiner = me
      me.state = IyiFiberState::Joining
      IyiSchedLock.unlock
      reschedule
      IyiSchedLock.lock
    end
    IyiSchedLock.unlock
  end

  # Every fiber waiting on *fiber*, woken in the order they came: the
  # chain is pushed at its head, so it is turned round first.
  def self.wake_joiners(fiber : IyiFiber) : Nil
    first = fiber.joiner
    return unless first.is_a?(IyiFiber)
    fiber.joiner = nil
    waiter = first
    rest = first.next_joiner
    first.next_joiner = nil
    while rest.is_a?(IyiFiber)
      following = rest.next_joiner
      rest.next_joiner = waiter
      waiter = rest
      rest = following
    end
    while true
      following = waiter.next_joiner
      waiter.next_joiner = nil
      waiter.awaited = nil
      ready(waiter)
      break unless following.is_a?(IyiFiber)
      waiter = following
    end
  end

  # *fiber* off the chain of the task it waits on.
  def self.leave_joiners(task : IyiFiber, fiber : IyiFiber) : Nil
    fiber.awaited = nil
    head = task.joiner
    return unless head.is_a?(IyiFiber)
    if head.object_id == fiber.object_id
      task.joiner = fiber.next_joiner
    else
      walk = head
      while true
        following = walk.next_joiner
        break unless following.is_a?(IyiFiber)
        if following.object_id == fiber.object_id
          walk.next_joiner = fiber.next_joiner
          break
        end
        walk = following
      end
    end
    fiber.next_joiner = nil
  end

  # A cancelled fiber that may move, its own wait ended. Its home is the
  # worker it last ran on, which may be news by now that has not reached
  # this thread, so a sleep or an io wait is ended by the thread that
  # says it holds the fiber (`IyiFiber#listed_on`), read after the flag
  # by a read-modify-write: a fiber parking there says so the same way
  # before it reads the flag (`listed`), so either this sees the thread
  # or that park sees the flag and ends itself. Lock held.
  def self.cancel_moving(fiber : IyiFiber) : Nil
    if fiber.state == IyiFiberState::WaitingCh
      ready(fiber)
      return
    end
    return if fiber.state == IyiFiberState::Joining
    owner = fiber.listed_on_fenced
    return if owner == 0_u64
    me = state
    if owner == me.object_id
      cancel_wait(fiber)
      return
    end
    other = @@states_head
    while other.is_a?(IyiSchedulerState)
      if other.object_id == owner
        post_cancel(other, fiber)
        return
      end
      other = other.next_state
    end
  end

  # Said once a fiber that may move is in this thread's sleep heap or io
  # list and its state says so: the thread's id into the fiber, by a
  # read-modify-write, and then the flag read, so a cancel that came in
  # between either finds this thread (`cancel_moving`) or is found here,
  # and the fiber ends its own wait. *waiting_out* is a fiber cancelled
  # before it parked, which parks to wait out what its cancel ended - a
  # Windows packet - and which no cancel ends again: `cancel` says nothing
  # to a fiber cancelled already, and a cancel of it still in this
  # thread's mail is passed over while it waits out (`take_mail`).
  def self.listed(fiber : IyiFiber, waiting_out : Bool = false) : Nil
    fiber.waiting_out = waiting_out
    return unless @@shared
    return unless fiber.unit.is_a?(IyiUnit)
    fiber.list_on(state.object_id)
    cancel_wait(fiber) if fiber.cancelled && !waiting_out
  end

  # ── Waiting on a word ───────────────────────────────────────────────
  #
  # A futex for fibers, which is what std/mutex and a thread's join wait
  # with: `park_on` parks the calling task while *word* still holds
  # *seen*, looked at under the scheduler's lock, and `wake_on` readies up
  # to *count* tasks parked on that word, from any thread. A word changed
  # and then woken is never missed: the change comes before the wake's
  # lock, and the look is under it. The parked task is a peer wait like a
  # channel's - its thread runs other tasks meanwhile, a worker steals,
  # and a deadlock is named as any - and its node is an `IyiWaiter` in one
  # of `LOT` lists by the word's address, stale by its nonce once the park
  # is over, as a channel's is. A park that is not *cancellable* - a
  # thread's join, which has no `Cancelled` to answer - is woken by a
  # cancel like any and answers nil; its caller looks at the word again.
  LOT = 64
  @@lot_heads : Array(IyiWaiter?)?
  @@lot_tails : Array(IyiWaiter?)?

  def self.park_on(word : Pointer(Atomic(UInt64)), seen : UInt64, cancellable : Bool = true) : Nil | Cancelled
    fiber = current
    IyiSchedLock.lock
    if cancellable && fiber.cancelled
      IyiSchedLock.unlock
      return Cancelled.new
    end
    if word.value.get != seen
      IyiSchedLock.unlock
      return nil
    end
    heads = @@lot_heads
    tails = @@lot_tails
    unless heads.is_a?(Array(IyiWaiter?)) && tails.is_a?(Array(IyiWaiter?))
      heads = Array(IyiWaiter?).new(LOT, nil)
      tails = Array(IyiWaiter?).new(LOT, nil)
      @@lot_heads = heads
      @@lot_tails = tails
    end
    nonce = park(fiber)
    waiter = fiber.spare_waiter
    if waiter.is_a?(IyiWaiter) && !waiter.linked
      waiter.renew(nonce, word.address)
    else
      waiter = IyiWaiter.new(fiber, nonce, word.address)
      fiber.spare_waiter = waiter
    end
    bucket = lot_bucket(word.address)
    waiter.linked = true
    tail = tails[bucket]
    waiter.prev_node = tail
    if tail.is_a?(IyiWaiter)
      tail.next_node = waiter
    else
      heads[bucket] = waiter
    end
    tails[bucket] = waiter
    IyiSchedLock.unlock
    reschedule
    IyiSchedLock.lock
    lot_unlink(heads, tails, bucket, waiter)
    IyiSchedLock.unlock
    return Cancelled.new if cancellable && fiber.cancelled
    nil
  end

  # The lists are read under the lock: read before it, a first `park_on`
  # that had looked at the word and not yet made them left this wake
  # nothing to walk, and parked for good.
  def self.wake_on(word : Pointer(Atomic(UInt64)), count : Int32) : Nil
    IyiSchedLock.lock
    heads = @@lot_heads
    tails = @@lot_tails
    unless heads.is_a?(Array(IyiWaiter?)) && tails.is_a?(Array(IyiWaiter?))
      IyiSchedLock.unlock
      return
    end
    bucket = lot_bucket(word.address)
    woken = 0
    node = heads[bucket]
    while node.is_a?(IyiWaiter) && woken < count
      following = node.next_node
      if node.slot == word.address
        lot_unlink(heads, tails, bucket, node)
        if node.current?
          node.handed = true
          ready(node.fiber)
          woken = woken + 1
        end
      end
      node = following
    end
    IyiSchedLock.unlock
  end

  private def self.lot_bucket(address : UInt64) : Int32
    (address.unsafe_shr(3_u64) % LOT.to_u64).to_i32
  end

  # Lock held.
  private def self.lot_unlink(heads : Array(IyiWaiter?), tails : Array(IyiWaiter?), bucket : Int32, node : IyiWaiter) : Nil
    return unless node.linked
    before = node.prev_node
    after = node.next_node
    if before.is_a?(IyiWaiter)
      before.next_node = after
    else
      heads[bucket] = after
    end
    if after.is_a?(IyiWaiter)
      after.prev_node = before
    else
      tails[bucket] = before
    end
    node.next_node = nil
    node.prev_node = nil
    node.linked = false
  end

  # III.4.2: cancellation reaches a *blocked* fiber. Whatever the fiber is
  # parked on, it is unparked here and its next (or current) blocking
  # primitive answers `Cancelled`; running or runnable, the flag is enough.
  #
  # The fiber may be another thread's (III.4.13). A peer wait - a channel,
  # a join - is behind the scheduler's lock, which the caller holds, and is
  # ended here; a sleep or an io wait is in its own thread's lists, and the
  # cancel is posted there for that thread to end. A parallel task not
  # started yet has nothing to end: it starts with the flag set.
  def self.cancel(fiber : IyiFiber) : Nil
    return if fiber.state == IyiFiberState::Done
    return if fiber.cancelled
    fiber.cancelled = true
    home = fiber.home
    if home.is_a?(IyiSchedulerState)
      if !@@shared
        cancel_wait(fiber)
      elsif fiber.unit.is_a?(IyiUnit)
        cancel_moving(fiber)
      elsif home.object_id == state.object_id
        cancel_wait(fiber)
      elsif fiber.state == IyiFiberState::WaitingCh
        ready(fiber)
      elsif fiber.state != IyiFiberState::Joining
        post_cancel(home, fiber)
      end
    end
    # And it reaches what the fiber started: the tasks of every group it
    # holds open, so a join it waits in - a park no wake above ends - ends
    # as they do. A task joining a group of its own was left to wait, and
    # its grandchild's 2-second sleep ran in full after the group failed.
    group = fiber.open_group
    while group.is_a?(IyiGroup)
      group.cancel_children_locked
      group = group.outer
    end
    # A reader of a task the walk above did not reach is woken to stop
    # (`join`); one whose task it reached waits for that task to end.
    task = fiber.awaited
    if fiber.state == IyiFiberState::Joining && task.is_a?(IyiFiber) && !task.cancelled
      leave_joiners(task, fiber)
      ready(fiber)
    end
  end

  # A cancelled fiber's own wait ended, on the thread whose lists it is in.
  @[Effect(:scheduler)]; def self.cancel_wait(fiber : IyiFiber) : Nil
    if fiber.state == IyiFiberState::Sleeping
      sleep_remove(fiber)
      enqueue(fiber)
    elsif fiber.state == IyiFiberState::WaitingIo
      {% if flag?(:win32) %}
        # `CancelIoEx` is a request, and on a handle tied to a completion
        # port it does not finish the operation here: measured, the
        # OVERLAPPED's status stays STATUS_PENDING (0x103) after a
        # successful cancel and only becomes STATUS_CANCELLED (0xC0000120)
        # when `GetQueuedCompletionStatus` takes the packet off the port —
        # three million reads of the status in between saw no change. On a
        # handle that is *not* on a port the cancel writes the status
        # itself, immediately, which is what makes the difference easy to
        # miss. So a caller cannot wait for the operation with
        # `WSAGetOverlappedResult(wait = 1)`: this OVERLAPPED has no event
        # and the handle is never signalled, and such a wait never returns.
        # `std/socket`'s cancelled paths therefore ask once and park again,
        # and the poller's dequeue is what ends them.
        #
        # The shorter answer, not taken: drop the `io_remove` and `enqueue`
        # below and let the completion wake the fiber, which would make the
        # operation provably over at every wake. It changes cancellation
        # for every kind of handle on this platform — files, the console,
        # pipes — and each would need its own measurement first.
        #
        # So the fiber resumes here, `homebound`, though it may move: the
        # packet comes to this thread's port, or is forwarded here by the
        # thread id the OVERLAPPED carries (`forward_completion`), and the
        # park that waits it out must be on this thread's io list. Resumed
        # on another worker it parked on that one's, the packet found no
        # fiber here, and the next operation's park could take it as its
        # own. `park_overlapped_current` lets go of it.
        LibC.CancelIoEx(fiber.wait_handle, fiber.wait_overlapped.as(Void*))
        io_remove(fiber)
        fiber.homebound = true if fiber.unit.is_a?(IyiUnit)
        enqueue(fiber)
      {% else %}
        io_remove(fiber)
        enqueue(fiber)
      {% end %}
    elsif fiber.state == IyiFiberState::WaitingCh
      # The channel's node is left where it is: waking bumps nothing here,
      # because the enqueue below changes the state the node's `current?`
      # reads, and every wake skips a node that is no longer current.
      enqueue(fiber)
    end
  end

  # ── The poller ───────────────────────────────────────────────────────

  DEADLOCK = "deadlock: every fiber is blocked and nothing can wake one"

  # A deadlock is the root fiber's panic, raised on the root's own stack.
  # It was raised on the stack of whichever fiber's park found it, mostly
  # a task's, parked or already done, and that task went through its
  # boundary a second time: its group counted it twice, and the next park
  # found the deadlock again - 182 reports, then "stack overflow" - or the
  # group cancelling it enqueued the dying task, which switched to itself
  # and exited 1 without the owner's cleanups. The root is taken off what
  # it waits on, so nothing wakes it there again, and woken to report it.
  def self.deadlock_found : Nil
    root = state.root
    deadlock unless root.is_a?(IyiFiber)
    IyiSchedLock.lock
    task = root.awaited
    leave_joiners(task, root) if task.is_a?(IyiFiber)
    group = root.joining
    group.forget_joiner if group.is_a?(IyiGroup)
    if root.object_id == current.object_id
      IyiSchedLock.unlock
      deadlock
    end
    root.deadlocked = true
    enqueue(root) unless root.state == IyiFiberState::Runnable
    IyiSchedLock.unlock
  end

  # On the root's stack. A second deadlock in the drain of the first, a
  # cleanup waiting on tasks cancellation does not reach, is the same news
  # and goes on through the drain without being printed again.
  def self.deadlock : NoReturn
    fiber = current
    fiber.deadlocked = false
    panic_current(DEADLOCK) if fiber.panicked && fiber.panic_message == DEADLOCK
    raise DEADLOCK
  end

  # Waits for the next event when *blocking*, and otherwise takes what has
  # arrived already (`poll_now`).
  @[Effect(:scheduler)]; def self.wait_for_events(blocking : Bool) : Nil
    sleep_head = state.sleep_head
    timeout = blocking ? -1_i64 : 0_i64
    {% if flag?(:win32) %}
      gap_ns = -1_i64
    {% end %}
    # With a second scheduler thread, a thread with nothing of its own to
    # wait for may still be woken by another, and its doorbell is in this
    # poller: whether that is a deadlock is `wait_shared`'s to decide.
    if blocking && !@@shared
      quiet = state.io_head.is_a?(Nil) && sleep_head.is_a?(Nil)
      {% if flag?(:win32) %}
        quiet = quiet && !IyiStdinReader.waiting?
      {% end %}
      if quiet
        deadlock_found
        return
      end
    end
    if blocking && sleep_head.is_a?(IyiFiber)
      now = __iyi_monotonic_ns
      gap = sleep_head.deadline - now
      gap = 0_i64 if gap < 0
      timeout = (gap + 999999_i64) // 1000000_i64
      {% if flag?(:win32) %}
        gap_ns = gap
      {% end %}
    end

    count = 0_i64
    {% if flag?(:win32) %}
      timeout_ms = timeout < 0 ? -1_i32 : timeout.to_i32
      bytes_transferred = uninitialized Int32
      completion_key = uninitialized UInt64
      overlapped_ptr = Pointer(Void).new(0_u64)
      port = Pointer(Void).new(pollfd.to_u64)

      # No deadline to keep, or a Windows that refused the timer: the
      # port's own wait, blocking or rounded up to the tick as before. Not
      # waiting, the drain below is the whole of it.
      timer = gap_ns < 0 ? -1_i64 : deadline_timer
      if timer <= 0 && blocking
        LibC.GetQueuedCompletionStatus(port, pointerof(bytes_transferred), pointerof(completion_key), pointerof(overlapped_ptr), timeout_ms)
        if overlapped_ptr.address != 0_u64 && overlapped_ptr.address == IyiStdinReader.overlapped_address
          IyiStdinReader.delivered
        elsif overlapped_ptr.address != 0_u64 && overlapped_ptr.address == state.wake_token.address
          # The doorbell (III.4.13): another thread left mail, which the
          # scheduler's loop takes.
        elsif overlapped_ptr.address != 0_u64
          complete_or_forward(overlapped_ptr.address, bytes_transferred.to_i64)
        end
      elsif timer > 0
        # A due time in hundred-nanosecond units, negative for "from
        # now"; a gap of zero is an absolute time already past, which
        # signals at once. The drain below takes whatever the port has,
        # so this wait only has to end at the right moment.
        due = 0_i64 - gap_ns // 100_i64
        timer_handle = Pointer(Void).new(timer.to_u64)
        LibC.SetWaitableTimer(timer_handle, pointerof(due), 0_i32,
          Pointer(Void).new(0_u64), Pointer(Void).new(0_u64), 0_i32)
        LibC.WaitForMultipleObjects(2_i32, state.wait_handles.as(Void*), 0_i32, timeout_ms)
        LibC.CancelWaitableTimer(timer_handle)
      end

      while true
        overlapped_ptr = Pointer(Void).new(0_u64)
        more = LibC.GetQueuedCompletionStatus(port, pointerof(bytes_transferred), pointerof(completion_key), pointerof(overlapped_ptr), 0_i32)
        break if overlapped_ptr.address == 0_u64
        if overlapped_ptr.address == IyiStdinReader.overlapped_address
          IyiStdinReader.delivered
          next
        end
        next if overlapped_ptr.address == state.wake_token.address
        complete_or_forward(overlapped_ptr.address, bytes_transferred.to_i64)
      end
    {% elsif flag?(:darwin) %}
      # kevent's timeout is a timespec pointer and null means forever:
      # -1 becomes the null, anything else two 8-byte words in this
      # frame. They were a heap block, taken off the worker's cache at
      # every poll with a timeout, the zero of a poll that does not wait
      # included, so a worker with nothing to run allocated. A -1 return
      # with errno EINTR (4) is a wakeup with no news, the same story
      # epoll's -EINTR tells below; anything else negative is real.
      timeout_ptr = Pointer(Void).new(0_u64)
      spec = uninitialized UInt64[2]
      if timeout >= 0_i64
        words = pointerof(spec).as(Pointer(UInt64))
        words[0] = (timeout // 1000_i64).to_u64
        words[1] = ((timeout % 1000_i64) * 1000000_i64).to_u64
        timeout_ptr = words.as(Void*)
      end
      count = LibC.kevent(pollfd.to_i32, Pointer(Void).new(0_u64), 0,
        Pointer(Void).new(events_buffer), EVENTS.to_i32, timeout_ptr).to_i64
      if count < 0
        raise "kevent failed" if LibC.error_location.value != 4
        count = 0_i64
      end
    {% else %}
      count = __iyi_conc_syscall6(IYI_SYS_EPOLL_PWAIT, pollfd, events_buffer.to_i64, EVENTS, timeout, 0_i64, 8_i64)
      # -EINTR (-4) is a wakeup with no news; anything else negative is real.
      raise "epoll_pwait failed" if count < 0 && count != -4_i64
    {% end %}

    index = 0_i64
    # Out here for the reason `ready` is below.
    doorbell = state.wake_fd
    while index < count
      entry = events_buffer + (index * IYI_POLL_EVENT_BYTES).to_u64
      fd = Pointer(UInt64).new(entry + IYI_POLL_DATA_OFFSET).value.to_i64
      # Declared out here: a local born inside the `{% if %}` dies at its
      # `{% end %}`.
      ready = 0
      {% if flag?(:darwin) %}
        # A kevent is one filter's news: EVFILT_READ (0xFFFF as the low
        # half of the word at +8) for the reader, the doorbell's
        # EVFILT_USER, which needs nothing more (EV_CLEAR re-arms it), and
        # anything else here the writer's EVFILT_WRITE.
        filter = Pointer(UInt64).new(entry + 8_u64).value & 0xFFFF_u64
        if filter == IYI_WAKE_FILTER
          index = index + 1
          next
        end
        ready = filter == 0xFFFF_u64 ? 1 : 4
      {% elsif flag?(:win32) %}
      {% else %}
        # The doorbell's eventfd, read back to zero; what it rang for is
        # the mail the scheduler's loop takes.
        if doorbell != 0_i64 && fd == doorbell
          drained = 0_u64
          __iyi_read(fd, pointerof(drained).as(Void*), 8_u64)
          index = index + 1
          next
        end
        # The event's mask is its first four bytes: IN (1) for the reader,
        # OUT (4) for the writer, and ERR (8) or HUP (0x10) for both, whose
        # next call finds out what happened.
        mask = Pointer(UInt64).new(entry).value & 0xFFFFFFFF_u64
        ready = ready | 1 if mask & 0x19_u64 != 0_u64
        ready = ready | 4 if mask & 0x1C_u64 != 0_u64
      {% end %}
      wake_io(fd.to_i32, ready)
      index = index + 1
    end

    wake_expired_sleepers
  end

  {% if flag?(:win32) %}
    # A completion this thread's port took: the fiber that posted it woken
    # here, or, when no fiber here posted it, handed to the thread that
    # did (`forward_completion`).
    def self.complete_or_forward(overlapped : UInt64, bytes : Int64) : Nil
      fiber = io_take_overlapped(overlapped)
      if fiber.is_a?(IyiFiber)
        fiber.io_bytes_read = bytes
        enqueue(fiber)
        return
      end
      forward_completion(overlapped, bytes) if @@shared
    end

    # A completion for an operation another thread's fiber posted. A handle
    # belongs to one port at a time, and each operation moves it to the
    # port of the thread posting (`arm_overlapped_current`): a parallel
    # task's unit may read a socket on one worker and write it on another,
    # and the read's completion then comes to the writer's port. Whose it
    # is says the word after the OVERLAPPED, once the address is known to
    # be a fiber's own - the registry is walked for that, and only for a
    # completion no fiber here claims - and that thread takes it from its
    # mail (`complete_here`).
    def self.forward_completion(overlapped : UInt64, bytes : Int64) : Nil
      owner = 0_u64
      IyiRuntimeLock.lock
      fiber = @@all_head
      while fiber.is_a?(IyiFiber)
        if fiber.wait_overlapped.address == overlapped
          owner = Pointer(UInt64).new(overlapped + 32_u64).value
          break
        end
        fiber = fiber.next_fiber
      end
      IyiRuntimeLock.unlock
      return if owner == 0_u64 || owner == state.object_id
      IyiSchedLock.lock
      other = @@states_head
      while other.is_a?(IyiSchedulerState)
        if other.object_id == owner
          posted = other.forwarded
          unless posted.is_a?(Array(UInt64))
            posted = [] of UInt64
            other.forwarded = posted
          end
          posted << overlapped
          posted << bytes.to_u64
          other.post_mail
          ring(other)
          break
        end
        other = other.next_state
      end
      IyiSchedLock.unlock
    end

    # A completion another thread's port took for a fiber here. Lock held.
    def self.complete_here(overlapped : UInt64, bytes : Int64) : Nil
      fiber = io_take_overlapped(overlapped)
      return unless fiber.is_a?(IyiFiber)
      fiber.io_bytes_read = bytes
      enqueue(fiber)
    end
  {% end %}

  def self.wake_io(fd : Int32, ready : Int32) : Nil
    if ready & 1 != 0
      reader = io_take(fd, 1)
      enqueue(reader) if reader.is_a?(IyiFiber)
    end
    if ready & 4 != 0
      writer = io_take(fd, 4)
      enqueue(writer) if writer.is_a?(IyiFiber)
    end
  end

  # A descriptor being closed under a parked waiter: the kernel drops a
  # closed fd from the poller without a word, so a fiber parked on it
  # would wait forever. The closer takes it off the registry and wakes
  # it; the woken call finds the fd gone and says so. A waiter in another
  # thread's poller - a parallel task's unit closing on one worker what
  # one of its fibers waits on in another's - is that thread's to wake,
  # and the close is posted to it (`io_owner`), which wakes it from its
  # mail. On Windows a close ends the posted operation, whose completion
  # goes to the port the waiting thread posted it on.
  def self.wake_closed(fd : Int32) : Nil
    {% if flag?(:win32) %}
    {% else %}
      wake_io(fd, 5)
      return unless @@shared
      me = state.object_id
      reader = io_owner_of(fd * 2)
      writer = io_owner_of(fd * 2 + 1)
      return if (reader == 0_u64 || reader == me) && (writer == 0_u64 || writer == me)
      IyiSchedLock.lock
      other = @@states_head
      while other.is_a?(IyiSchedulerState)
        id = other.object_id
        if id != me && (id == reader || id == writer)
          closed = other.closed_fds
          unless closed.is_a?(Array(Int32))
            closed = [] of Int32
            other.closed_fds = closed
          end
          closed << fd
          other.post_mail
          ring(other)
        end
        other = other.next_state
      end
      IyiSchedLock.unlock
    {% end %}
  end

  @[Effect(:scheduler)]; def self.wake_expired_sleepers : Nil
    return if state.sleep_head.is_a?(Nil)
    now = __iyi_monotonic_ns
    while true
      head = state.sleep_head
      return unless head.is_a?(IyiFiber)
      return if head.deadline > now
      sleep_remove(head)
      if head.io_timed
        # An io wait whose deadline came first.
        head.io_timed = false
        head.timed_out = true
        {% if flag?(:win32) %}
          # The operation is the kernel's until its completion is taken off
          # the port, and the OVERLAPPED is the fiber's next operation's
          # too: it is cancelled here, and the cancellation's completion is
          # what wakes the fiber, so nothing of it is left to arrive later.
          # Standard input's read is its thread's, and withdrawn there.
          if IyiStdinReader.waiter?(head)
            IyiStdinReader.withdraw
          else
            LibC.CancelIoEx(head.wait_handle, head.wait_overlapped.as(Void*))
          end
          next
        {% else %}
          io_remove(head)
        {% end %}
      end
      # A select with a timeout arm is in this heap and a channel's queues
      # at once, and either can wake it: one already woken is not queued
      # twice. Its `unpark` takes it out of here when it runs. A channel's
      # wake may come from another thread, under the scheduler's lock, so
      # the look and the enqueue are under it too.
      if @@shared
        IyiSchedLock.lock
        enqueue(head) unless head.state == IyiFiberState::Runnable
        IyiSchedLock.unlock
      else
        enqueue(head) unless head.state == IyiFiberState::Runnable
      end
    end
  end

  # ── Lists ────────────────────────────────────────────────────────────

  # The sleepers, earliest deadline first, as a pairing heap threaded
  # through the fibers' own links: an insertion is one comparison, taking
  # the earliest is a pass over its children, and a fiber leaves from
  # anywhere in the heap when its wait ends some other way. It was a list
  # kept sorted by walking it, so every sleep walked past the sleepers
  # before it: 100,000 tasks each sleeping under 100 ms took 11 s, and a
  # server whose reads carry a deadline paid the same on every read.
  # Equal deadlines leave in the order they came, as the list kept them.
  def self.sleep_insert(fiber : IyiFiber) : Nil
    st = state
    st.sleep_seq = st.sleep_seq &+ 1_u64
    fiber.sleep_seq = st.sleep_seq
    fiber.sleep_child = nil
    fiber.next_sleep = nil
    fiber.sleep_prev = nil
    root = st.sleep_head
    st.sleep_head = root.is_a?(IyiFiber) ? sleep_meld(root, fiber) : fiber
  end

  # Whether *fiber* is in the heap: its root, or linked under a node.
  def self.sleeping?(fiber : IyiFiber) : Bool
    root = state.sleep_head
    return true if root.is_a?(IyiFiber) && root.object_id == fiber.object_id
    fiber.sleep_prev.is_a?(IyiFiber)
  end

  # Out of the heap from wherever it is; nothing when it is not in it.
  def self.sleep_remove(fiber : IyiFiber) : Nil
    st = state
    root = st.sleep_head
    return unless root.is_a?(IyiFiber)
    children = fiber.sleep_child
    fiber.sleep_child = nil
    if root.object_id == fiber.object_id
      rest = sleep_pairs(children)
      rest.sleep_prev = nil if rest.is_a?(IyiFiber)
      st.sleep_head = rest
      return
    end
    before = fiber.sleep_prev
    unless before.is_a?(IyiFiber)
      fiber.sleep_child = children
      return
    end
    after = fiber.next_sleep
    first_child = before.sleep_child
    if first_child.is_a?(IyiFiber) && first_child.object_id == fiber.object_id
      before.sleep_child = after
    else
      before.next_sleep = after
    end
    after.sleep_prev = before if after.is_a?(IyiFiber)
    fiber.next_sleep = nil
    fiber.sleep_prev = nil
    rest = sleep_pairs(children)
    st.sleep_head = sleep_meld(root, rest) if rest.is_a?(IyiFiber)
  end

  private def self.sleep_before?(a : IyiFiber, b : IyiFiber) : Bool
    a.deadline < b.deadline || (a.deadline == b.deadline && a.sleep_seq < b.sleep_seq)
  end

  @@sleep_steps : UInt64 = 0_u64

  # Melds the sleep heap has made, in all: what an insertion and a removal
  # cost, counted, which the exercises read rather than a clock.
  def self.sleep_steps : UInt64
    @@sleep_steps
  end

  # Two roots into one: the later becomes the earlier's first child.
  private def self.sleep_meld(a : IyiFiber, b : IyiFiber) : IyiFiber
    @@sleep_steps = @@sleep_steps &+ 1_u64
    first = sleep_before?(b, a) ? b : a
    second = first.object_id == a.object_id ? b : a
    older = first.sleep_child
    second.next_sleep = older
    older.sleep_prev = second if older.is_a?(IyiFiber)
    second.sleep_prev = first
    first.sleep_child = second
    first.next_sleep = nil
    first.sleep_prev = nil
    first
  end

  # A root's children into one root: melded in pairs left to right, then
  # the pairs right to left, which is what keeps the heap shallow.
  private def self.sleep_pairs(first : IyiFiber?) : IyiFiber?
    pairs = nil
    cursor = first
    while cursor.is_a?(IyiFiber)
      partner = cursor.next_sleep
      cursor.next_sleep = nil
      cursor.sleep_prev = nil
      unless partner.is_a?(IyiFiber)
        cursor.next_sleep = pairs
        pairs = cursor
        break
      end
      following = partner.next_sleep
      partner.next_sleep = nil
      partner.sleep_prev = nil
      pair = sleep_meld(cursor, partner)
      pair.next_sleep = pairs
      pairs = pair
      cursor = following
    end
    return nil unless pairs.is_a?(IyiFiber)
    result = pairs
    pairs = result.next_sleep
    result.next_sleep = nil
    while pairs.is_a?(IyiFiber)
      following = pairs.next_sleep
      pairs.next_sleep = nil
      result = sleep_meld(pairs, result)
      pairs = following
    end
    result
  end

  def self.io_take_overlapped(ptr : UInt64) : IyiFiber?
    head = state.io_head
    return nil unless head.is_a?(IyiFiber)
    if head.wait_overlapped.address == ptr
      state.io_head = head.next_io
      head.next_io = nil
      untime(head)
      return head
    end
    cursor = head
    while true
      after = cursor.next_io
      return nil unless after.is_a?(IyiFiber)
      if after.wait_overlapped.address == ptr
        cursor.next_io = after.next_io
        after.next_io = nil
        untime(after)
        return after
      end
      cursor = after
    end
  end

  def self.read_posix(fd : Int32, buffer : Void*, count : UInt64) : Int64 | Cancelled
    {% if flag?(:darwin) %}
      # kqueue takes a regular file, where epoll refuses one, and its
      # EVFILT_READ fires only while the file's offset is short of its end:
      # a wait at the end never ended, and a program reading `< file` hung
      # after its last line. A file never blocks, so it is read unwaited,
      # which is what epoll's refusal comes to on Linux. Standard input
      # alone is asked: it is where a shell puts a file, a file a program
      # opens is read through std/file, and a socket's read is not made to
      # pay for the question.
      return __iyi_read(fd, buffer, count) if fd == 0 && regular_file?(fd)
    {% end %}
    wait_readable_posix(fd)!
    __iyi_read(fd, buffer, count)
  end

  {% if flag?(:darwin) %}
    # Whether *fd* is a regular file: S_IFREG in `st_mode`, the two bytes
    # at offset 4 of darwin's `struct stat64`, which is 144 bytes long.
    @[Effect(:scheduler)]; def self.regular_file?(fd : Int32) : Bool
      stat = uninitialized UInt64[24]
      bytes = pointerof(stat).as(Pointer(UInt8))
      return false if LibC.fstat(fd, bytes.as(Void*)) != 0
      ((bytes + 5).value & 0xF0_u8) == 0x80_u8
    end
  {% end %}

  # The fiber waiting on *fd* in *direction*, off the list and the poller.
  def self.io_take(fd : Int32, direction : Int32) : IyiFiber?
    waiter = io_slot(fd, direction)
    return nil unless waiter.is_a?(IyiFiber)
    io_remove(waiter)
    waiter
  end

  # *fiber* off the io list, whichever fd and direction it waits on: a
  # cancelled waiter is that fiber, and not whoever else waits on its fd.
  def self.io_remove(fiber : IyiFiber) : Nil
    {% if flag?(:win32) %}
      io_take_overlapped(fiber.wait_overlapped.address)
    {% else %}
      io_forget(fiber) if io_unlink(fiber)
    {% end %}
  end

  # Deregistered on every exit from the io list - wake and cancel both -
  # so a level-triggered fd cannot wake a fiber that no longer exists to
  # want it; the caller has taken *fiber* off the list already. On darwin
  # the fiber's own filter goes (EV_DELETE's packed word; a fd already
  # gone is kevent's problem and not ours). On Linux the registration is
  # the fd's, so it is narrowed to what the other direction's waiter
  # still wants (EPOLL_CTL_MOD, 3), or removed when nobody does (DEL, 2).
  @[Effect(:scheduler)]; def self.io_forget(fiber : IyiFiber) : Nil
    untime(fiber)
    {% if flag?(:win32) %}
      fiber.next_io = nil
    {% elsif flag?(:darwin) %}
      change = __iyi_kevent_change(fiber.wait_fd, fiber.wait_dir == 1 ? 0x2FFFF_u64 : 0x2FFFE_u64)
      LibC.kevent(pollfd.to_i32, change.as(Void*), 1,
        Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64))
    {% else %}
      remaining = io_interest(fiber.wait_fd)
      if remaining == 0
        __iyi_conc_syscall6(IYI_SYS_EPOLL_CTL, pollfd, 2_i64, fiber.wait_fd.to_i64, 0_i64, 0_i64, 0_i64)
      else
        event = Pointer(UInt8).malloc(16_u64)
        event.as(Pointer(UInt64)).value = remaining.to_u64
        Pointer(UInt64).new(event.address + IYI_POLL_DATA_OFFSET).value = fiber.wait_fd.to_u64
        __iyi_conc_syscall6(IYI_SYS_EPOLL_CTL, pollfd, 3_i64, fiber.wait_fd.to_i64, event.address.to_i64, 0_i64, 0_i64)
      end
    {% end %}
    fiber.next_io = nil
    fiber.wait_fd = -1
    fiber.wait_dir = 0
  end

  # ── The poller's fd, lazily ──────────────────────────────────────────

  @[Effect(:scheduler)]; def self.pollfd : Int64
    fd = state.pollfd
    return fd if fd > 0
    {% if flag?(:win32) %}
      h = LibC.CreateIoCompletionPort(Pointer(Void).new(0xFFFFFFFFFFFFFFFF_u64), Pointer(Void).new(0_u64), 0_u64, 1_i32)
      raise "CreateIoCompletionPort failed" if h.address == 0_u64
      fd = h.address.to_i64
    {% elsif flag?(:darwin) %}
      fd = LibC.kqueue.to_i64
      raise "kqueue failed" if fd < 0
    {% else %}
      fd = __iyi_conc_syscall3(IYI_SYS_EPOLL_CREATE1, 0_i64, 0_i64, 0_i64)
      raise "epoll_create1 failed" if fd < 0
    {% end %}
    state.pollfd = fd
    fd
  end

  def self.events_buffer : UInt64
    st = state
    buffer = st.events
    return buffer.address if buffer.address != 0_u64
    buffer = Pointer(UInt8).malloc((EVENTS * IYI_POLL_EVENT_BYTES).to_u64)
    st.events = buffer
    buffer.address
  end

  {% if flag?(:win32) %}
    # This thread's deadline timer, and the pair of handles the poller
    # waits on: the completion port first, the timer second.
    #
    # The port's own timeout cannot keep a deadline — Windows rounds a
    # millisecond wait up to the system timer tick, so the poller woke
    # 15.6 ms after a `sleep 1` and a hundred of them took 1,577 ms
    # instead of 100. A timer made with
    # CREATE_WAITABLE_TIMER_HIGH_RESOLUTION (0x2) keeps the millisecond
    # (1,513 us measured) and the same object without the flag does not
    # (15,879 us), so the flag is the whole point of asking for it here.
    #
    # The wake is a wait on the pair rather than the timer's completion
    # routine because a high-resolution timer refuses one:
    # `SetWaitableTimer` with a routine answers 0 and ERROR_INVALID_PARAMETER
    # on this timer and 1 on a plain one. A completion port is a waitable
    # object — measured, a packet posted to an idle port signals its
    # handle in 1 us — and the millisecond timeout stays on the wait as
    # the backstop, so a port that did not signal costs the deadline the
    # program asked for and never a hung poller.
    #
    # A machine whose Windows does not know the flag (it arrived in
    # 10 1803) answers a null handle; that is remembered as -1 and the
    # poller keeps the millisecond timeout it had before.
    @[Effect(:scheduler)]; def self.deadline_timer : Int64
      st = state
      handle = st.deadline_timer
      return handle if handle != 0_i64
      port = pollfd
      timer = LibC.CreateWaitableTimerExW(Pointer(Void).new(0_u64),
        Pointer(UInt16).new(0_u64), 2_i32, 0x1F0003_i32)
      if timer.address == 0_u64
        st.deadline_timer = -1_i64
        return -1_i64
      end
      pair = Pointer(UInt8).malloc(16_u64)
      Pointer(UInt64).new(pair.address).value = port.to_u64
      Pointer(UInt64).new(pair.address + 8_u64).value = timer.address
      st.wait_handles = pair
      st.deadline_timer = timer.address.to_i64
      timer.address.to_i64
    end
  {% end %}

  # ── Panics — III.1.4 ─────────────────────────────────────────────────

  # The panic path: run the current fiber's pending defers innermost
  # first, then die at the task boundary. A spawned task marks itself,
  # tells its group, wakes its joiners and is never scheduled again; the
  # main fiber has no boundary above it, so after its drain the process
  # exits 1. Every registered cleanup on the path has run either way,
  # which is the promise `defer` makes.
  def self.panic_current(message : String) : NoReturn
    # A panic raised inside one of the scheduler's critical sections - the
    # runtime's own sanity checks raise there - lets the lock go first: the
    # boundary below takes it, and would wait on itself forever.
    IyiSchedLock.release_held
    fiber = current
    # A fiber past its boundary has nothing left to run, and a second pass
    # through it counts the task twice in its group: the runtime's own
    # raise is the only one that can come from there, and it ends the run.
    __iyi_exit(1) if fiber.state == IyiFiberState::Done
    # The running fiber, whichever park the runtime raised in: a group
    # cancelling its children must not enqueue the one that is dying.
    IyiSchedLock.lock
    fiber.state = IyiFiberState::Running
    IyiSchedLock.unlock
    again = fiber.panicked
    # Marked before the drain: a boundary the drain itself reaches — a
    # deferred `g.join`, above all — must see that its owner is already
    # dying and keep quiet rather than re-raise into the unwind.
    fiber.panicked = true
    fiber.panic_message = message
    # A deadlock found while this fiber waited in a group's join: that join
    # is a cleanup already off the list, and it is finished here as a
    # panicking owner's, its tasks cancelled and their cleanups run.
    group = fiber.joining
    fiber.joining = nil
    group.join(true) if group.is_a?(IyiGroup) && !again

    while true
      node = fiber.defers
      break unless node.is_a?(IyiDeferNode)
      fiber.defers = node.next_node
      node.run
    end

    body = fiber.proc
    if body.is_a?(Nil)
      __iyi_flush_std
      __iyi_exit(1)
    end

    g = fiber.group
    if g.is_a?(IyiGroup)
      IyiSchedLock.lock
      g.child_panicked(fiber.cancelled)
      IyiSchedLock.unlock
    end

    IyiSchedLock.lock
    fiber.state = IyiFiberState::Done
    wake_joiners(fiber)
    IyiSchedLock.unlock
    state.dying = fiber
    reschedule
    __iyi_exit(1)
  end

  # III.4.2's other ending: a cancelled task stopped where no answer can
  # carry its `Cancelled`, `Channel.select` with no bound arm for one. Its
  # pending defers run innermost first, as a panic's do, and its group
  # counts it as a cancelled task, not a failure; nothing is printed. Its
  # handle has no value to give, and `IyiTask#value` says so as
  # `Panicked`, the union's one member for a task that did not finish.
  # Such a select answered `Cancelled` to its first arm, which runs
  # nothing unbound, so a loop around it spun at a full core and its
  # group's join waited forever.
  def self.stop_current : NoReturn
    fiber = current
    while true
      node = fiber.defers
      break unless node.is_a?(IyiDeferNode)
      fiber.defers = node.next_node
      node.run
    end
    g = fiber.group
    IyiSchedLock.lock
    if g.is_a?(IyiGroup)
      g.child_finished(false)
      g.drop_child(fiber)
    end
    fiber.state = IyiFiberState::Done
    wake_joiners(fiber)
    IyiSchedLock.unlock
    state.dying = fiber
    reschedule
    raise "a done fiber was scheduled"
  end
end

# ── The pool — III.4.13 ────────────────────────────────────────────────
#
# The worker threads parallel tasks run on: `IyiThread`s of the runtime's
# own, each a scheduler like any thread's, started at the first
# `spawn_parallel` - a program without one has no pool. A parallel task
# waits here until a worker starts it: in the queue of the worker whose
# task spawned it, or in the injection queue when a thread outside the
# pool did, and a worker with nothing of its own steals from another's.
#
# Once started, a parallel task and the tasks `spawn` starts inside it
# (its unit, `IyiUnit`) run wherever a worker is free. A runnable one is
# in its worker's ring, which any worker with nothing of its own takes
# half of (`grab`), Go's work stealing; one woken by a thread outside the
# pool, or pushed out of a full ring, is in the shared queue behind the
# lock. What made a task stay where it started was the codegen keeping a
# thread-local's address across a call and a worker waiting in its
# poller on the stack of the fiber that parked last: a thread-local is
# read through the thread pointer at every access now (`codegen.cr`,
# `iyi_thread_local_address`), and a worker waits on its own fiber's
# stack (`work`).
#
# A worker with more runnable fibers than it can run calls one idle
# worker to come and steal (`wake_one`), and only one at a time is out
# looking: one that finds work calls the next, so a burst brings the
# pool in one by one and a lone wake brings nobody, Go's `wakep`.
class IyiWorkers
  # `count=`'s answer, 0 when the program did not ask; the number started,
  # 0 before the pool is.
  @@asked : Int32 = 0
  @@started : Int32 = 0
  @@inject_head : IyiFiber?
  @@inject_tail : IyiFiber?
  # Started fibers that may move, runnable and in no worker's ring: woken
  # by a thread outside the pool, or pushed out of a full ring. Under the
  # lock.
  @@shared_head : IyiFiber?
  @@shared_tail : IyiFiber?
  # Every worker's state, as each comes up; and where the next steal or
  # ring starts looking, so no worker is always asked first.
  @@workers : Array(IyiSchedulerState)?
  @@turn : Int32 = 0
  # The same states by address, for a steal from a ring, which takes no
  # lock: written before the count that makes them visible, and never
  # moved, as an array's buffer may be when it grows.
  @@listed : Pointer(UInt64) = Pointer(UInt64).new(0_u64)
  @@listed_count : Int64 = 0_i64
  # Fibers in the queues behind the lock - the shared queue, the
  # injection queue and every worker's queue of unstarted tasks - so a
  # worker looks under the lock only when one holds something; workers
  # waiting in their pollers; and workers rung to look for work.
  @@queued : Int64 = 0_i64
  @@idle : Int64 = 0_i64
  @@spinning : Int64 = 0_i64
  # Unstarted tasks taken from another worker's queue, and started fibers
  # taken from another worker's ring, in all: what the exercise reads to
  # know each steal ran.
  @@steals : UInt64 = 0_u64
  @@grabs : UInt64 = 0_u64
  # Preemption at loop back-edges (SPEC.md III.4.13, part 9). `@@preempt`
  # is each worker's own word, which the code the compiler emits at every
  # loop's back-edge in a program with a pool loads through the thread
  # pointer (`codegen.cr#iyi_back_edge`), and which the monitor raises on
  # a worker that has run one task for a quantum; nonzero only there.
  # Tasks that gave their worker up wait in the preempted queue, behind
  # the lock, counted in `@@preempted` so a look without the lock sees
  # them. The monitor's word is 1 while it is parked, with every worker
  # idle; its page holds the tick's timespec on Linux and darwin, on
  # darwin the kevent its kqueue answers into, and on Windows the tick as
  # a relative due time for its waitable timer (`monitor_wait`), whose
  # handle `@@monitor_timer` is. `@@looks` counts the monitor's looks, which
  # is what the exercise reads its period from.
  #
  # On x86-64 Windows the word is not `@@preempt` but a slot of the TEB's
  # own: `@@preempt_slot` is its offset from `%gs`, which the compiler's
  # check reads in every function's entry and then loads `%gs`-relative,
  # as Linux loads `%fs:off` (`PreemptChecks`). A thread-local there is
  # three loads deep - `gs:0x58`, the C runtime's index into that table,
  # the word - and on a GitHub Windows runner, best of seven against
  # `@[NoPreempt]` twins, a vectorised sum and the same through `each`
  # took 1.63 to 1.75 times as long checked that way, 1.46 to 1.49 with
  # the slot, and 3.4 to 4.9 through the accessor call. The slot is a
  # `TlsAlloc` index under 64, `TlsSlots` at 0x1480 in the TEB, Go's
  # `tls_g` the same way; until the pool claims one
  # (`claim_preempt_slot`), and if it gets none under 64, it is
  # `ArbitraryUserPointer` at 0x28, Go's fallback too. Nothing but a
  # worker's slot is ever raised, and the slow half clears only a
  # worker's.
  @[ThreadLocal]
  @@preempt : UInt64 = 0_u64
  @@preempt_slot : UInt64 = 0x28_u64
  @@preempted_head : IyiFiber?
  @@preempted_tail : IyiFiber?
  @@preempted : Int64 = 0_i64
  @@preempts : UInt64 = 0_u64
  @@monitor_parked : UInt64 = 0_u64
  @@monitor_page : UInt64 = 0_u64
  @@monitor_handle : UInt64 = 0_u64
  @@monitor_timer : UInt64 = 0_u64
  @@looks : UInt64 = 0_u64

  def self.word(variable : Pointer(Int64)) : Pointer(Atomic(Int64))
    Pointer(Atomic(Int64)).new(variable.address)
  end

  # The pool's size: the workers running, or, before it starts, the
  # number it will start.
  def self.count : Int32
    started = @@started
    return started if started > 0
    resolved
  end

  # Asked for before the first parallel task; once the pool has started
  # its size does not change, and a different number is refused.
  def self.count=(workers : Int32) : Int32
    raise "IyiWorkers.count: a pool has at least one worker, not #{workers}" if workers < 1
    started = @@started
    if started > 0 && workers != started
      raise "IyiWorkers.count: the pool started with #{started} workers, and it does not grow or shrink once it has"
    end
    @@asked = workers
    workers
  end

  def self.steals : UInt64
    @@steals
  end

  def self.grabs : UInt64
    Pointer(Atomic(UInt64)).new(pointerof(@@grabs).address).value.get
  end

  # What the program asked for, `IYI_WORKERS` from the environment, or
  # the cores this process may run on - the count the parallel marker
  # sizes its helpers by, and GC_DESIGN.md's bound on the mutator's
  # threads.
  @[Effect(:process)]; def self.resolved : Int32
    return @@asked if @@asked > 0
    text = Program.env("IYI_WORKERS")
    if text.is_a?(String)
      asked = text.to_i?
      return asked if asked.is_a?(Int32) && asked > 0
    end
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      cores = IyiThread.core_count
      return 256 if cores > 256_u64
      cores.to_i32
    {% else %}
      1
    {% end %}
  end

  # The workers, started once, on the thread of the first parallel spawn.
  # Each worker is an `IyiThread`, which is what makes the collector stop
  # and scan it as it stops and scans any thread (III.4.11).
  def self.start : Nil
    return if @@started > 0
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      workers = resolved
      IyiSchedLock.lock
      if @@started > 0
        IyiSchedLock.unlock
        return
      end
      @@started = workers
      @@workers = Array(IyiSchedulerState).new(workers)
      @@listed = Pointer(UInt64).malloc(workers.to_u64)
      IyiSchedLock.unlock
      claim_preempt_slot
      index = 0
      while index < workers
        IyiThread.start { IyiWorkers.work }
        index = index + 1
      end
      start_monitor
    {% end %}
  end

  # A worker's whole life, on its own fiber, which never parks and is
  # never in a queue: the next fiber found and switched to, and when none
  # is, a wait in the poller here, on this stack - the one stack on this
  # thread no other worker can resume. A switch back here is how a fiber
  # that parked with nothing after it gives the worker back.
  def self.work : Nil
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      st = IyiScheduler.state
      root = IyiScheduler.current
      st.make_ring
      # Where the monitor raises this worker's preemption word: its own
      # thread-local's address, or on x86-64 Windows its TEB's slot, the
      # same for the worker's whole life. The accessor-check variant
      # (`-Dpreempt_check_accessor`) reads the thread-local there too, so
      # it is raised the way its check reads it.
      {% if flag?(:win32) && flag?(:x86_64) && !flag?(:preempt_check_accessor) %}
        st.preempt_word = IyiRoots.current_teb &+ @@preempt_slot
      {% else %}
        st.preempt_word = pointerof(@@preempt).address
      {% end %}
      IyiSchedLock.lock
      st.worker = true
      listed = @@workers
      listed << st if listed.is_a?(Array(IyiSchedulerState))
      slot = word(pointerof(@@listed_count)).value.get
      Pointer(UInt64).new(@@listed.address &+ slot.to_u64 &* 8_u64).value = st.object_id
      word(pointerof(@@listed_count)).value.add(1_i64)
      IyiSchedLock.unlock
      while true
        fiber = IyiScheduler.worker_next(st)
        if fiber.is_a?(IyiFiber)
          stop_spinning(st, true)
          root.state = IyiFiberState::Pooled
          IyiScheduler.switch_to(fiber)
        else
          stop_spinning(st, false)
          IyiScheduler.release_unit(st)
          IyiScheduler.idle_worker(st)
        end
      end
    {% end %}
  end

  # ── Unstarted tasks, behind the lock ─────────────────────────────────

  # A parallel task, made `Runnable`, into the spawning worker's own queue
  # or, from a thread outside the pool, the injection queue; and one idle
  # worker rung to come and take it. Lock held.
  def self.push(fiber : IyiFiber) : Nil
    fiber.state = IyiFiberState::Runnable
    fiber.next_run = nil
    st = IyiScheduler.state
    if st.worker
      tail = st.pool_tail
      if tail.is_a?(IyiFiber)
        tail.next_run = fiber
      else
        st.pool_head = fiber
      end
      st.pool_tail = fiber
    else
      tail = @@inject_tail
      if tail.is_a?(IyiFiber)
        tail.next_run = fiber
      else
        @@inject_head = fiber
      end
      @@inject_tail = fiber
    end
    word(pointerof(@@queued)).value.add(1_i64)
    workers = @@workers
    return unless workers.is_a?(Array(IyiSchedulerState))
    size = workers.size
    index = 0
    while index < size
      @@turn = @@turn + 1 >= size ? 0 : @@turn + 1
      other = workers[@@turn]
      if other.idle && !other.notified
        IyiScheduler.ring(other)
        return
      end
      index = index + 1
    end
  end

  # The next fiber for worker *st* from the queues behind the lock, or
  # nil without taking it when they are all empty: its own unstarted
  # tasks, then the shared queue of started ones, then the injection
  # queue, then another worker's unstarted task. An unstarted task is the
  # worker's from here (`home`), and one the pool hands out twice is the
  # one bug this cannot survive - two threads on one stack - so it ends
  # the run, saying so.
  def self.take_queued(st : IyiSchedulerState) : IyiFiber?
    return nil if word(pointerof(@@queued)).value.get <= 0_i64
    IyiSchedLock.lock
    fiber = st.pool_head
    if fiber.is_a?(IyiFiber)
      st.pool_head = fiber.next_run
      st.pool_tail = nil if st.pool_head.is_a?(Nil)
      fiber.next_run = nil
    else
      fiber = @@shared_head
      if fiber.is_a?(IyiFiber)
        @@shared_head = fiber.next_run
        @@shared_tail = nil if @@shared_head.is_a?(Nil)
        fiber.next_run = nil
        word(pointerof(@@queued)).value.sub(1_i64)
        IyiSchedLock.unlock
        return fiber
      end
      fiber = @@inject_head
      if fiber.is_a?(IyiFiber)
        @@inject_head = fiber.next_run
        @@inject_tail = nil if @@inject_head.is_a?(Nil)
        fiber.next_run = nil
      else
        fiber = steal_unstarted(st)
      end
    end
    unless fiber.is_a?(IyiFiber)
      IyiSchedLock.unlock
      return nil
    end
    word(pointerof(@@queued)).value.sub(1_i64)
    unless fiber.home.is_a?(Nil)
      said = "iyi: panic: the pool handed one parallel task to a worker twice: two threads would run one stack\n"
      __iyi_write(2, said.to_unsafe.as(Void*), said.bytesize.to_u64)
      __iyi_flush_std
      __iyi_exit(1)
    end
    fiber.home = st
    IyiSchedLock.unlock
    fiber
  end

  # The oldest task in another worker's queue, taken out of it. Lock held.
  private def self.steal_unstarted(st : IyiSchedulerState) : IyiFiber?
    workers = @@workers
    return nil unless workers.is_a?(Array(IyiSchedulerState))
    size = workers.size
    index = 0
    while index < size
      @@turn = @@turn + 1 >= size ? 0 : @@turn + 1
      victim = workers[@@turn]
      if victim.object_id != st.object_id
        fiber = victim.pool_head
        if fiber.is_a?(IyiFiber)
          victim.pool_head = fiber.next_run
          victim.pool_tail = nil if victim.pool_head.is_a?(Nil)
          fiber.next_run = nil
          @@steals = @@steals &+ 1_u64
          return fiber
        end
      end
      index = index + 1
    end
    nil
  end

  # A started fiber into the shared queue, and an idle worker called to
  # take it: a thread outside the pool woke it. Lock held.
  def self.push_shared(fiber : IyiFiber) : Nil
    fiber.state = IyiFiberState::Runnable
    link_shared(fiber)
    wake_one
  end

  # Lock held.
  private def self.link_shared(fiber : IyiFiber) : Nil
    fiber.next_run = nil
    tail = @@shared_tail
    if tail.is_a?(IyiFiber)
      tail.next_run = fiber
    else
      @@shared_head = fiber
    end
    @@shared_tail = fiber
    word(pointerof(@@queued)).value.add(1_i64)
  end

  # Nothing runnable or waiting to start anywhere in the pool. Lock held.
  def self.queues_empty? : Bool
    !work_waiting?
  end

  # ── Each worker's ring, without the lock ─────────────────────────────
  #
  # Go's `runqput`, `runqget` and `runqgrab` (src/runtime/proc.go): the
  # owner alone writes a slot and moves the tail; the owner and thieves
  # move the head, by exchange. A thief reads the slots it means to take
  # before its exchange, and a slot rewritten under it fails the exchange,
  # so nothing it read is used. Every load and store here is the prelude's
  # one ordering (III.4.10), stronger than the acquire and release Go asks
  # for.

  def self.fiber_at(address : UInt64) : IyiFiber
    Pointer(Void).new(address).as(IyiFiber)
  end

  # The *index*th worker to come up, by its state's address.
  def self.listed_at(index : Int64) : IyiSchedulerState
    Pointer(Void).new(Pointer(UInt64).new(@@listed.address &+ index.to_u64 &* 8_u64).value).as(IyiSchedulerState)
  end

  # Onto the owner's ring; a full ring sends half of itself and this one
  # to the shared queue. A ring holding more than the fiber the worker
  # runs next calls one idle worker to steal (`wake_one`).
  def self.push_runnable(st : IyiSchedulerState, fiber : IyiFiber) : Nil
    while true
      head = st.ring_head
      tail = st.ring_tail
      if tail &- head < IyiSchedulerState::RING
        st.set_slot(tail, fiber.object_id)
        st.ring_tail = tail &+ 1_u64
        break
      end
      break if spill(st, fiber, head)
    end
    wake_one if st.ring_size > 1_u64
  end

  # Half the ring, oldest first, and *fiber* after them into the shared
  # queue, Go's `runqputslow`; false when a thief moved the head first.
  # The slots are read after the exchange: only their owner, which is
  # here, writes a slot.
  private def self.spill(st : IyiSchedulerState, fiber : IyiFiber, head : UInt64) : Bool
    half = IyiSchedulerState::RING // 2_u64
    return false unless st.take_ring_head(head, head &+ half)
    held = IyiSchedLock.held_here?
    IyiSchedLock.lock unless held
    index = 0_u64
    while index < half
      link_shared(fiber_at(st.slot(head &+ index)))
      index = index &+ 1_u64
    end
    link_shared(fiber)
    IyiSchedLock.unlock unless held
    true
  end

  # The owner's oldest.
  def self.pop(st : IyiSchedulerState) : IyiFiber?
    return nil if st.ring.address == 0_u64
    while true
      head = st.ring_head
      tail = st.ring_tail
      return nil if head == tail
      address = st.slot(head)
      return fiber_at(address) if st.take_ring_head(head, head &+ 1_u64)
    end
  end

  # Half of another worker's ring for worker *st*, whose own ring is
  # empty: each other worker asked once, from the one after the last
  # asked. The oldest it took is answered to run now and the rest are in
  # its ring. Without the lock.
  def self.steal(st : IyiSchedulerState) : IyiFiber?
    count = word(pointerof(@@listed_count)).value.get
    return nil if count < 2_i64
    start = (@@turn.to_i64 &+ 1_i64) % count
    index = 0_i64
    while index < count
      victim = listed_at((start &+ index) % count)
      if victim.object_id != st.object_id && victim.ring_size > 0_u64
        fiber = grab(victim, st)
        if fiber.is_a?(IyiFiber)
          Pointer(Atomic(UInt64)).new(pointerof(@@grabs).address).value.add(1_u64)
          # More than this worker can run next came with it.
          wake_one if st.ring_size > 0_u64
          return fiber
        end
      end
      index = index &+ 1_i64
    end
    nil
  end

  # Go's `runqgrab`: half of *victim*'s ring, rounded up, taken by one
  # exchange of the victim's head; the oldest answered, the rest copied
  # into *thief*'s ring before the exchange and published by its tail
  # after it.
  def self.grab(victim : IyiSchedulerState, thief : IyiSchedulerState) : IyiFiber?
    while true
      head = victim.ring_head
      tail = victim.ring_tail
      n = tail &- head
      return nil if n == 0_u64
      # Read across a push and a take: the two loads disagree, so again.
      next if n > IyiSchedulerState::RING
      n = n &- n // 2_u64
      first = victim.slot(head)
      mine = thief.ring_tail
      index = 1_u64
      while index < n
        thief.set_slot(mine &+ index &- 1_u64, victim.slot(head &+ index))
        index = index &+ 1_u64
      end
      next unless victim.take_ring_head(head, head &+ n)
      thief.ring_tail = mine &+ n &- 1_u64 if n > 1_u64
      return fiber_at(first)
    end
  end

  # Something runnable or waiting to start that this worker could take:
  # the queues behind the lock, or another worker's ring. Without the
  # lock, as a look before sleeping.
  def self.work_waiting? : Bool
    return true if word(pointerof(@@queued)).value.get > 0_i64
    return true if word(pointerof(@@preempted)).value.get > 0_i64
    count = word(pointerof(@@listed_count)).value.get
    index = 0_i64
    while index < count
      return true if listed_at(index).ring_size > 0_u64
      index = index &+ 1_i64
    end
    false
  end

  # ── Calling idle workers ─────────────────────────────────────────────

  def self.count_idle(delta : Int64) : Nil
    word(pointerof(@@idle)).value.add(delta)
  end

  # One idle worker rung to come and steal, unless one is already out
  # looking or none is idle: the spinner that finds work calls the next
  # (`stop_spinning`), and one that finds none goes back to sleep. Takes
  # the lock unless this thread holds it.
  def self.wake_one : Nil
    return if word(pointerof(@@idle)).value.get <= 0_i64
    return unless word(pointerof(@@spinning)).value.compare_and_set(0_i64, 1_i64)[1]
    held = IyiSchedLock.held_here?
    IyiSchedLock.lock unless held
    rung = false
    workers = @@workers
    if workers.is_a?(Array(IyiSchedulerState))
      size = workers.size
      index = 0
      while index < size
        @@turn = @@turn + 1 >= size ? 0 : @@turn + 1
        other = workers[@@turn]
        if other.idle && !other.notified
          other.spinning = true
          IyiScheduler.ring(other)
          rung = true
          break
        end
        index = index + 1
      end
    end
    word(pointerof(@@spinning)).value.sub(1_i64) unless rung
    IyiSchedLock.unlock unless held
  end

  # A worker rung to look has looked: it is out of the count, and one
  # that found something calls the next if more is waiting.
  def self.stop_spinning(st : IyiSchedulerState, found : Bool) : Nil
    return unless st.spinning
    st.spinning = false
    word(pointerof(@@spinning)).value.sub(1_i64)
    wake_one if found && work_waiting?
  end

  # ── Preemption at loop back-edges (SPEC.md III.4.13, part 9) ─────────
  #
  # A worker looks at its own poller, sleep heap and mail only when the
  # task on it parks, so a task computing for 100 ms held everything that
  # waited there - a connection whose request had arrived, a sleeper
  # whose time had come - for the 100 ms. The compiler puts a check at
  # every loop's back-edge in a program with a pool, a load of this
  # worker's `@@preempt` and a branch, and the pool's monitor, a kernel
  # thread of its own, raises the word of a worker whose task has held it
  # for a quantum. The slow half below then hands on what waits on the
  # worker - the poller's news and the expired sleepers into its ring,
  # where an idle worker steals them - and gives the worker up only when
  # something waits that no idle worker will take.

  # The monitor looks every `PREEMPT_TICK_MS`, and raises the word of a
  # worker whose switch count it has seen unchanged `PREEMPT_TICKS` looks
  # in a row: one task has held it for between one and two ticks, 5 to 10
  # ms, the order of Go's 10. Measured on the server shape of 28
  # connections making 0.2 ms requests beside 4 making 100 ms ones (8
  # workers, release, three runs, load 4.5 to 5.3), as fast requests over
  # 20 ms and the slowest: 73 to 81, at most 113 to 231 ms, unpreempted;
  # 119 to 174, at most 33 to 36 ms, flagged after 20 to 30 ms; 0 to 7, at
  # most 19 to 21, after 10 to 15; none, at most 13 to 17, after 5 to 10;
  # none, at most 9 to 11, after 4 to 6, with the monitor awake every 2
  # ms. Sixteen CPU-bound tasks took 101 to 112 ms on eight workers and
  # 720 to 741 on one under every one of them, 102 to 108 and 725 to 752
  # unpreempted: what time-slicing costs them is under the noise.
  PREEMPT_TICK_MS =           5
  PREEMPT_TICK_NS = 5000000_u64
  PREEMPT_TICKS   =       1_u64

  # Tasks that gave their worker up at a back-edge, in all: what the
  # exercise reads to know a preemption ran.
  def self.preempts : UInt64
    Pointer(Atomic(UInt64)).new(pointerof(@@preempts).address).value.get
  end

  # The monitor's looks, in all: what the exercise divides a busy
  # stretch by to know the monitor's period.
  def self.looks : UInt64
    Pointer(Atomic(UInt64)).new(pointerof(@@looks).address).value.get
  end

  # x86-64 Windows: a `TlsAlloc` slot for the preemption word, as its
  # offset from `%gs`, before the first worker starts. `TlsAlloc` zeroes
  # the slot on every thread, and one at 64 or past it is in the
  # expansion table, not the TEB, so it is given back and the word stays
  # at `ArbitraryUserPointer`. Nothing elsewhere.
  def self.claim_preempt_slot : Nil
    {% if flag?(:win32) && flag?(:x86_64) %}
      index = LibC.TlsAlloc
      if index >= 0_i32 && index < 64_i32
        @@preempt_slot = 0x1480_u64 &+ index.to_u64 &* 8_u64
      elsif index >= 0_i32
        LibC.TlsFree(index)
      end
    {% end %}
  end

  # The preemption word's offset from `%gs` on x86-64 Windows.
  def self.preempt_slot : UInt64
    @@preempt_slot
  end

  # The back-edge's slow half, on a worker whose word the monitor raised.
  # Nothing here when a runtime lock is held - a loop in a block a prelude
  # def runs under one may check, and a park there would park the holder -
  # nor on the worker's own fiber, which runs no program code. The
  # runtime's own code never checks, and neither does anything it calls
  # (`codegen.cr#iyi_runtime_copy?`), so a check is in a program's code or
  # a library's; and a fiber that is not `Running` - one the runtime has
  # begun to move into a queue or a wait - is not given up again from a
  # block the runtime runs there. A task holding a `Mutex` may give its
  # worker up, as a thread the kernel preempts holding one does: a task
  # waiting for it parks on the lock's word rather than spin (std/mutex).
  def self.preempted : Nil
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      {% if flag?(:win32) && flag?(:x86_64) && !flag?(:preempt_check_accessor) %}
        st = IyiScheduler.state
        return unless st.worker
        Pointer(Atomic(UInt64)).new(st.preempt_word).value.set(0_u64)
      {% else %}
        @@preempt = 0_u64
        st = IyiScheduler.state
        return unless st.worker
      {% end %}
      # A fresh quantum from here: the monitor sees the count move.
      st.switches = st.switches &+ 1_u64
      return if IyiSchedLock.held_here? || IyiRuntimeLock.held?
      fiber = IyiScheduler.current
      root = st.root
      return if root.is_a?(IyiFiber) && root.object_id == fiber.object_id
      return unless fiber.state == IyiFiberState::Running
      IyiScheduler.take_mail(st) if st.mail?
      io = !st.io_head.is_a?(Nil)
      {% if flag?(:win32) %}
        io = io || IyiStdinReader.waiting?
      {% end %}
      if io
        IyiScheduler.wait_for_events(false)
      else
        IyiScheduler.wake_expired_sleepers
      end
      # What the poll woke is in this worker's ring: an idle worker is
      # called for it, even for one fiber, which `push_runnable` leaves
      # for the worker itself to run next.
      wake_one if st.ring_size > 0_u64
      give_up(st, fiber) if turn_wanted?(st, fiber)
    {% end %}
  end

  # Whether the task on worker *st* should give it up: something waits
  # that only this worker may run, or something waits and no worker is
  # idle to take it. A task of no unit - a thread outside the pool's, or
  # the worker's own - never does, nor one woken onto its home only.
  private def self.turn_wanted?(st : IyiSchedulerState, fiber : IyiFiber) : Bool
    return false unless fiber.unit.is_a?(IyiUnit) && !fiber.homebound
    return true unless st.run_head.is_a?(Nil)
    if word(pointerof(@@idle)).value.get > 0_i64
      wake_one if work_waiting?
      return false
    end
    work_waiting?
  end

  # The task gives worker *st* up: the worker takes the next fiber as a
  # park would (`IyiScheduler.worker_next`), and the task waits in the
  # preempted queue, which every worker looks at last. Its unit's token
  # goes with it (`IyiUnit::YIELDED`), so no other fiber of its unit runs
  # before it does. With nothing found after all, it runs on.
  private def self.give_up(st : IyiSchedulerState, fiber : IyiFiber) : Nil
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      unit = fiber.unit
      return unless unit.is_a?(IyiUnit)
      id = st.object_id
      return unless unit.hand_to_yielded(id)
      st.unit = nil
      following = IyiScheduler.worker_next(st)
      unless following.is_a?(IyiFiber)
        unit.take_yielded(id)
        st.unit = unit
        return
      end
      fiber.preempted = true
      IyiSchedLock.lock
      fiber.state = IyiFiberState::Runnable
      fiber.next_run = nil
      tail = @@preempted_tail
      if tail.is_a?(IyiFiber)
        tail.next_run = fiber
      else
        @@preempted_head = fiber
      end
      @@preempted_tail = fiber
      word(pointerof(@@preempted)).value.add(1_i64)
      IyiSchedLock.unlock
      Pointer(Atomic(UInt64)).new(pointerof(@@preempts).address).value.add(1_u64)
      IyiScheduler.switch_to(following)
    {% end %}
  end

  # The oldest preempted task, out of the queue, or nil.
  def self.take_preempted : IyiFiber?
    return nil if word(pointerof(@@preempted)).value.get <= 0_i64
    IyiSchedLock.lock
    fiber = @@preempted_head
    if fiber.is_a?(IyiFiber)
      @@preempted_head = fiber.next_run
      @@preempted_tail = nil if @@preempted_head.is_a?(Nil)
      fiber.next_run = nil
      word(pointerof(@@preempted)).value.sub(1_i64)
    end
    IyiSchedLock.unlock
    fiber
  end

  # ── The monitor ──────────────────────────────────────────────────────
  #
  # A helper thread (`IyiThread.start_helper`): the collector never stops
  # it, and it allocates nothing, reads the workers' states by address
  # and writes only their preemption words and its own two counts on
  # them. Go's `sysmon`, which preempts a goroutine that has run for 10
  # ms, does the same from a thread of its own. It parks while every
  # worker is idle and nothing waits, so an idle pool costs no wakeups,
  # and the first worker to leave its wait wakes it (`idle_worker`).
  @[Effect(:scheduler)]; def self.start_monitor : Nil
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
      page = __iyi_mmap(4096_u64).address
      {% if flag?(:linux) || flag?(:darwin) %}
        # The tick, as a timespec: no seconds, PREEMPT_TICK_NS.
        Pointer(UInt64).new(page).value = 0_u64
        Pointer(UInt64).new(page &+ 8_u64).value = PREEMPT_TICK_NS
      {% end %}
      {% if flag?(:darwin) %}
        kq = LibC.kqueue
        raise "kqueue failed for the pool's monitor" if kq < 0
        change = __iyi_kevent_change(IYI_WAKE_IDENT, IYI_WAKE_ADD)
        added = LibC.kevent(kq, change.as(Void*), 1, Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64))
        raise "kevent could not add the pool's monitor's doorbell" if added < 0
        @@monitor_handle = kq.to_u64
      {% elsif flag?(:win32) %}
        semaphore = LibC.CreateSemaphoreW(nil, 0_i32, 0x7FFFFFFF_i32, nil)
        raise "the pool's monitor's semaphore could not be made" if semaphore.address == 0_u64
        @@monitor_handle = semaphore.address
        # The tick's own timer. A millisecond timeout ends on the system
        # timer's tick: on a GitHub Windows runner the semaphore's 5 ms
        # wait made the monitor's looks 11.2 to 12.3 ms apart, and a
        # ticker beside a computing task woke up to 30 ms late. A
        # high-resolution waitable timer (0x2, the poller's
        # `deadline_timer`) ends on time - 5.15 to 5.27 ms a look there,
        # turns of 10.3 to 10.5 ms, the ticker at most 10 ms late - and
        # leaves the machine's timer as it was, which `timeBeginPeriod(1)`
        # would not. A Windows without the flag (before 10 1803) answers a
        # null handle, and the semaphore's timeout stays. The due time is
        # relative, in 100 ns.
        timer = LibC.CreateWaitableTimerExW(Pointer(Void).new(0_u64),
          Pointer(UInt16).new(0_u64), 2_i32, 0x1F0003_i32)
        @@monitor_timer = timer.address
        Pointer(Int64).new(page).value = 0_i64 - (PREEMPT_TICK_NS // 100_u64).to_i64
      {% end %}
      @@monitor_page = page
      IyiThread.start_helper(monitor_entry, page)
    {% end %}
  end

  def self.monitor_entry : UInt64
    proc = ->(page : UInt64) { IyiWorkers.monitor(page) }
    Pointer(UInt64).new(pointerof(proc).address).value
  end

  # The monitor's whole life.
  def self.monitor(page : UInt64) : Nil
    while true
      Pointer(Atomic(UInt64)).new(pointerof(@@looks).address).value.add(1_u64)
      if look
        monitor_wait(false)
      else
        park_monitor
      end
    end
  end

  # One look at every worker, raising the word of each that one task has
  # held for the quantum; whether any worker was running.
  private def self.look : Bool
    busy = false
    count = word(pointerof(@@listed_count)).value.get
    index = 0_i64
    while index < count
      st = listed_at(index)
      if st.idle
        st.watch_ticks = 0_u64
      else
        busy = true
        seen = st.switches
        if seen != st.watch_seen
          st.watch_seen = seen
          st.watch_ticks = 0_u64
        else
          ticks = st.watch_ticks &+ 1_u64
          if ticks >= PREEMPT_TICKS
            ticks = 0_u64
            address = st.preempt_word
            Pointer(Atomic(UInt64)).new(address).value.set(1_u64) if address != 0_u64
          end
          st.watch_ticks = ticks
        end
      end
      index = index &+ 1_i64
    end
    busy || work_waiting?
  end

  # Every worker idle and nothing waiting: the monitor says it is parked,
  # under the lock a worker leaving its wait takes, and waits until that
  # worker takes the word back (`take_monitor_wake`). Not before every
  # worker has come up: one that finds a task the moment it starts never
  # waits, so never leaves a wait to wake the monitor - the unit step's
  # task was never preempted that way, on a pool of one.
  private def self.park_monitor : Nil
    IyiSchedLock.lock
    count = word(pointerof(@@listed_count)).value.get
    quiet = count == @@started.to_i64 && !work_waiting?
    index = 0_i64
    while quiet && index < count
      quiet = false unless listed_at(index).idle
      index = index &+ 1_i64
    end
    monitor_word.value.set(1_u64) if quiet
    IyiSchedLock.unlock
    return unless quiet
    while monitor_word.value.get != 0_u64
      monitor_wait(true)
    end
  end

  private def self.monitor_word : Pointer(Atomic(UInt64))
    Pointer(Atomic(UInt64)).new(pointerof(@@monitor_parked).address)
  end

  # A worker leaving its wait, with the lock held: whether the monitor is
  # parked, taken back so one worker alone wakes it.
  def self.take_monitor_wake : Bool
    return false if monitor_word.value.get == 0_u64
    monitor_word.value.set(0_u64)
    true
  end

  # The monitor woken from its park, after `take_monitor_wake`.
  @[Effect(:scheduler)]; def self.wake_monitor : Nil
    {% if flag?(:linux) %}
      __iyi_conc_syscall6(IYI_SYS_FUTEX, pointerof(@@monitor_parked).address.to_i64, IYI_FUTEX_WAKE, 1_i64, 0_i64, 0_i64, 0_i64)
    {% elsif flag?(:darwin) %}
      change = __iyi_kevent_change(IYI_WAKE_IDENT, IYI_WAKE_TRIGGER)
      LibC.kevent(@@monitor_handle.to_i32, change.as(Void*), 1, Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64))
    {% elsif flag?(:win32) %}
      LibC.ReleaseSemaphore(Pointer(Void).new(@@monitor_handle), 1_i32, nil)
    {% end %}
  end

  # One tick, or while *parked* until a worker wakes it. Linux waits on
  # the parked word itself, which is 0 while the monitor runs and 1 while
  # it is parked, so a wake that comes before the wait is not lost;
  # darwin's doorbell and Windows' semaphore keep a wake until it is
  # taken, and a wake left over ends a tick early, which costs a look.
  # Windows' tick waits on the high-resolution timer alone (wakes come
  # only to a parked monitor), and on the semaphore's millisecond timeout,
  # the system timer's tick, where there is no such timer or it could not
  # be set.
  @[Effect(:scheduler)]; private def self.monitor_wait(parked : Bool) : Nil
    {% if flag?(:linux) %}
      expected = parked ? 1_i64 : 0_i64
      timeout = parked ? 0_i64 : @@monitor_page.to_i64
      __iyi_conc_syscall6(IYI_SYS_FUTEX, pointerof(@@monitor_parked).address.to_i64, IYI_FUTEX_WAIT, expected, timeout, 0_i64, 0_i64)
    {% elsif flag?(:darwin) %}
      page = @@monitor_page
      timeout = parked ? Pointer(Void).new(0_u64) : Pointer(Void).new(page)
      LibC.kevent(@@monitor_handle.to_i32, Pointer(Void).new(0_u64), 0, Pointer(Void).new(page &+ 64_u64), 1, timeout)
    {% elsif flag?(:win32) %}
      timer = Pointer(Void).new(@@monitor_timer)
      unless parked || timer.address == 0_u64
        set = LibC.SetWaitableTimer(timer, Pointer(Int64).new(@@monitor_page), 0_i32,
          Pointer(Void).new(0_u64), Pointer(Void).new(0_u64), 0_i32)
        if set != 0_i32
          LibC.WaitForSingleObject(timer, -1_i32)
          return
        end
      end
      LibC.WaitForSingleObject(Pointer(Void).new(@@monitor_handle), parked ? -1_i32 : PREEMPT_TICK_MS)
    {% end %}
  end
end

{% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
  # The back-edge's slow half, called by name from the check the compiler
  # emits (`codegen.cr#iyi_back_edge`) and emitted only into a program
  # that has a pool (`iyi_preempt_on?`). Out of line, so a loop carries a
  # call and not its body.
  @[NoInline]
  fun __iyi_preempt : Nil
    IyiWorkers.preempted
  end
{% end %}

{% if flag?(:win32) %}
  # Standard input, read by a thread of its own. A fiber reading stdin
  # parks on Linux and darwin (III.4.8 named the call); on Windows the
  # read was the thread's, and a fiber waiting for a line stalled every
  # sibling: a ticker beside `stdin.gets` on a pipe that answered after
  # two seconds ticked 0 times in them. A pipe or a console handed to a
  # program is not opened for overlapped reads, so the completion port
  # cannot be asked; the way Go answers the same handles is a thread that
  # makes the blocking read and posts its end. This is that thread.
  #
  # One read at a time, as one reader per fd is the rule elsewhere. The
  # fiber asks (ASKED) and rings; the thread claims the read (READING),
  # makes it into the fiber's buffer - a console wide, through its own
  # page, since it has no heap to allocate from - and posts to the port
  # with an OVERLAPPED of its own, never the fiber's, so a post arriving
  # late is never taken for the fiber's next operation. The poller hands
  # the answer over (`delivered`) and the state is IDLE again.
  #
  # A cancellation or a deadline withdraws the read: before the thread
  # claims it, the claim fails and the thread posts nothing read; after,
  # `CancelSynchronousIo` ends a pipe's blocked read (a console's runs to
  # its line, `withdraw` says why). Either way the fiber
  # waits for the post before it returns, because its buffer is the
  # thread's until then, and a read that did complete is answered with
  # its bytes rather than lost.
  class IyiStdinReader
    IDLE      = 0_u64
    ASKED     = 1_u64
    READING   = 2_u64
    WITHDRAWN = 3_u64
    ANSWERED  = 4_u64

    W_STATE    =     0_u64
    W_BUFFER   =     8_u64
    W_COUNT    =    16_u64
    W_BYTES    =    24_u64
    W_HANDLE   =    32_u64
    W_CONSOLE  =    40_u64
    W_PORT     =    48_u64
    W_DOORBELL =    56_u64
    W_THREAD   =    64_u64
    OVERLAPPED =   128_u64
    WIDE       =  4096_u64
    PAGE       = 65536_u64

    @@page : UInt64 = 0_u64

    def self.word(offset : UInt64) : Pointer(Atomic(UInt64))
      Pointer(Atomic(UInt64)).new(@@page + offset)
    end

    # The OVERLAPPED the thread posts, which the poller recognises; 0
    # before the thread exists, which no post carries.
    def self.overlapped_address : UInt64
      @@page == 0_u64 ? 0_u64 : @@page + OVERLAPPED
    end

    # This scheduler's: the fiber asking, on the thread that asked.
    def self.waiting? : Bool
      IyiScheduler.state.stdin_waiter.is_a?(IyiFiber)
    end

    def self.waiter?(fiber : IyiFiber) : Bool
      waiter = IyiScheduler.state.stdin_waiter
      waiter.is_a?(IyiFiber) && waiter.sp_slot.address == fiber.sp_slot.address
    end

    # Whether stdin's handle is one a read of could wait: a pipe (3) or a
    # character device (2), the console among them. A disk file (1)
    # answers at once, and is read where it is asked.
    @[Effect(:scheduler)]; def self.waits?(handle : Void*) : Bool
      kind = LibC.GetFileType(handle)
      kind == 2 || kind == 3
    end

    # Under the runtime lock, and the page published only once its words
    # are written, the thread made suspended (4) until then: two threads'
    # first reads would otherwise each make a reader, and one that saw the
    # page early would ring a doorbell not made yet.
    @[Effect(:scheduler)]; def self.start(handle : Void*) : Nil
      IyiRuntimeLock.lock
      if @@page == 0_u64
        page = __iyi_mmap(PAGE).address
        Pointer(UInt64).new(page + W_HANDLE).value = handle.address
        Pointer(UInt64).new(page + W_DOORBELL).value = LibC.CreateSemaphoreW(nil, 0_i32, 1_i32, nil).address
        entry = ->(argument : UInt64) { IyiStdinReader.run(argument) }
        thread = LibC.CreateThread(nil, 0_u64, Pointer(Void).new(Pointer(UInt64).new(pointerof(entry).address).value),
          Pointer(Void).new(0_u64), 4_i32, nil)
        if thread.address != 0_u64
          Pointer(UInt64).new(page + W_THREAD).value = thread.address
          @@page = page
          LibC.ResumeThread(thread)
        end
      end
      IyiRuntimeLock.unlock
      raise "CreateThread failed for standard input's reader" if @@page == 0_u64
    end

    # Any thread's fiber may ask, one read at a time in the process: the
    # claim is the state's own IDLE to ASKED, and the port to post to and
    # the fiber to wake are the asking scheduler's. They were the first
    # reader's: the port was set once, at the start, and the waiter was
    # one for the process, so a second `IyiThread` reading stdin had its
    # line posted to the main thread's port. A main thread joining it
    # never took the post and the program hung; one polling took it and
    # switched onto the other thread's fiber, an access violation, 3 runs
    # in 3 each.
    @[Effect(:scheduler)]; def self.read(handle : Void*, console : Bool, buffer : Void*, count : UInt64, ms : Int32) : Int64 | Cancelled
      fiber = IyiScheduler.current
      return Cancelled.new if fiber.cancelled
      start(handle) if @@page == 0_u64
      raise "two fibers reading standard input" unless word(W_STATE).value.compare_and_set(IDLE, ASKED)[1]
      # The read is this thread's - its port is posted to, its state names
      # the waiter - so a parallel task asking stays here until it is
      # answered (`IyiFiber#homebound`).
      fiber.homebound = true if fiber.unit.is_a?(IyiUnit)
      st = IyiScheduler.state
      st.stdin_waiter = fiber
      fiber.io_bytes_read = 0_i64
      word(W_BUFFER).value.set(buffer.address)
      word(W_COUNT).value.set(count)
      word(W_CONSOLE).value.set(console ? 1_u64 : 0_u64)
      word(W_PORT).value.set(IyiScheduler.pollfd.to_u64)
      LibC.ReleaseSemaphore(Pointer(Void).new(word(W_DOORBELL).value.get), 1_i32, nil)
      deadline = ms
      withdrawn = false
      while st.stdin_waiter.is_a?(IyiFiber)
        IyiScheduler.park_stdin_current(deadline)
        next unless st.stdin_waiter.is_a?(IyiFiber)
        # Woken with the read still the thread's: a cancellation. A
        # deadline withdraws the read from the poller and wakes nobody
        # until the post (`IyiScheduler.wake_expired_sleepers`).
        withdraw unless withdrawn
        withdrawn = true
        deadline = -1
      end
      fiber.homebound = false
      answer = fiber.io_bytes_read
      return answer if answer > 0_i64
      return Cancelled.new if fiber.cancelled
      answer
    end

    # The read taken back, on the scheduler's thread. Before the claim
    # the claim fails; inside the read the read is ended; between the
    # claim and the call there is nothing to end yet, so it is asked
    # again after a yield - for 50 ms at most, and past that the fiber
    # waits for the read to finish on its own.
    #
    # Not a console's read once it has begun. Ended there, the read
    # returns, but the console keeps the request and the next line typed
    # goes to it and is gone: measured, a read cancelled at 300 ms, then
    # "first" typed and "second" a second later, and the next read
    # answered "second". So a console's read runs to its line, which the
    # fiber answers - a sibling's failure waits for Enter, and loses
    # nothing.
    @[Effect(:scheduler)]; def self.withdraw : Nil
      return if word(W_STATE).value.compare_and_set(ASKED, WITHDRAWN)[1]
      return if word(W_CONSOLE).value.get != 0_u64
      thread = Pointer(Void).new(word(W_THREAD).value.get)
      give_up = __iyi_monotonic_ns + 50_000_000_i64
      while word(W_STATE).value.get == READING && __iyi_monotonic_ns < give_up
        break if LibC.CancelSynchronousIo(thread) != 0
        LibC.SwitchToThread
      end
    end

    # The post taken off the asking scheduler's port: the answer to its
    # fiber, and the next read free to be asked - by any thread, so the
    # bytes are read off the page first.
    def self.delivered : Nil
      st = IyiScheduler.state
      waiter = st.stdin_waiter
      bytes = word(W_BYTES).value.get.to_i64
      st.stdin_waiter = nil
      word(W_STATE).value.set(IDLE)
      return unless waiter.is_a?(IyiFiber)
      waiter.io_bytes_read = bytes
      IyiScheduler.untime(waiter)
      IyiScheduler.enqueue(waiter) if waiter.state == IyiFiberState::WaitingIo
    end

    # The thread's whole life. It touches no heap: its words and its wide
    # buffer are this page, and what it writes into is the buffer the
    # fiber asked with.
    @[Effect(:scheduler)]; def self.run(argument : UInt64) : Nil
      doorbell = Pointer(Void).new(word(W_DOORBELL).value.get)
      while true
        LibC.WaitForSingleObject(doorbell, -1_i32)
        bytes = 0_i64
        if word(W_STATE).value.compare_and_set(ASKED, READING)[1]
          handle = Pointer(Void).new(word(W_HANDLE).value.get)
          buffer = Pointer(Void).new(word(W_BUFFER).value.get)
          count = word(W_COUNT).value.get
          bytes = word(W_CONSOLE).value.get != 0_u64 ? read_console(handle, buffer, count) : read_file(handle, buffer, count)
        end
        word(W_BYTES).value.set(bytes.to_u64)
        word(W_STATE).value.set(ANSWERED)
        LibC.PostQueuedCompletionStatus(Pointer(Void).new(word(W_PORT).value.get), 0_i32, 0_u64,
          Pointer(Void).new(@@page + OVERLAPPED))
      end
    end

    # 0 for the end of the input, a broken pipe, and a withdrawn read.
    @[Effect(:scheduler)]; def self.read_file(handle : Void*, buffer : Void*, count : UInt64) : Int64
      read = 0_i32
      return 0_i64 if LibC.ReadFile(handle, buffer, count.to_i32, pointerof(read), nil) == 0
      read.to_i64
    end

    # `IyiConsole.read`'s read, with the wide buffer this page's rather
    # than the heap's.
    def self.read_console(handle : Void*, buffer : Void*, count : UInt64) : Int64
      IyiConsole.read_into(handle, buffer, count, Pointer(UInt16).new(@@page + WIDE), (PAGE - WIDE) // 2_u64 - 1_u64)
    end
  end
{% end %}

# `defer`'s runtime half on the concurrency targets: the registry is
# the current fiber's, so interleaved tasks never share cleanups. The
# normalizer emits the push on entry and the pop on every normal exit;
# what is left on the list when a panic arrives is exactly what did not
# get to clean up.
def __iyi_defer_push(cleanup : Proc(Nil)) : Nil
  fiber = IyiScheduler.current
  node = IyiDeferNode.new(cleanup)
  node.next_node = fiber.defers
  fiber.defers = node
end

def __iyi_defer_pop_run : Nil
  fiber = IyiScheduler.current
  node = fiber.defers
  return unless node.is_a?(IyiDeferNode)
  fiber.defers = node.next_node
  node.run
end

# What a standard stream set to `sync = false` still holds, written out as
# the program ends: from `main`, from `exit` below and from a panic's exit.
# Nothing wrote it, and it was lost - `STDOUT.sync = false`, two lines
# printed, then the program's end, an `exit 0` or a `raise`, and standard
# output was empty all three ways. A failed write here is a panic like any
# other write's. The targets without tasks define it beside their `exit`.
def __iyi_flush_std : Nil
  STDOUT.flush
  STDERR.flush
end

# The program ends here, with *status* as its exit code. What this task
# deferred runs first, innermost first, as a panic's cleanups do; then the
# process ends and every other task with it, their cleanups not run -
# Go's `os.Exit` and Crystal's `exit` alike. A failure a person should
# read about is a panic (`raise`, SPEC.md III.1.4); this is the other
# kind of ending, a program that has answered and says so in its status,
# as `diff` and `grep` do with 1. Before this a program reached for the
# runtime's own `__iyi_exit`, which skipped the cleanups too.
def exit(status : Int32 = 0) : NoReturn
  fiber = IyiScheduler.current
  IyiScheduler.exiting = true
  while true
    node = fiber.defers
    break unless node.is_a?(IyiDeferNode)
    fiber.defers = node.next_node
    node.run
  end
  __iyi_flush_std
  __iyi_exit(status)
end

# ── The public primitives ──────────────────────────────────────────────

# Park for *ms* milliseconds. `Cancelled` when the group said stop —
# immediately if it already had, which is what lets `!` drain a cancelled
# task through every later wait it would have done. Zero or less is a
# yield: every task already runnable runs before this one goes on.
@[Effect(:timer)]; def sleep(ms : Int32) : Nil | Cancelled
  IyiScheduler.sleep_current(ms)
end

# Park until *fd* has bytes to read. The poller, made visible: what
# `__iyi_read` does directly today, a program with other fibers live does
# through this, and III.10's IO floor will route through it wholesale.
def wait_readable(fd : Int32) : Nil | Cancelled
  IyiScheduler.wait_readable_current(fd)
end

def wait_readable(fd : Int64) : Nil | Cancelled
  IyiScheduler.wait_readable_current(fd)
end

# The same, for at most *ms* milliseconds: true when *fd* is readable,
# false when the time ran out first.
def wait_readable(fd : Int32, ms : Int32) : Bool | Cancelled
  IyiScheduler.wait_readable_current(fd, ms)
end

# Tell the poller *fd* is being closed, so a fiber parked on it wakes
# instead of waiting for an event the kernel will never deliver.
def wake_closed(fd : Int32) : Nil
  IyiScheduler.wake_closed(fd)
end

# Park until *fd* can take bytes: a socket whose send buffer is full.
def wait_writable(fd : Int32) : Nil | Cancelled
  IyiScheduler.wait_writable_current(fd)
end

def wait_writable(fd : Int64) : Nil | Cancelled
  IyiScheduler.wait_writable_current(fd)
end

def wait_writable(fd : Int32, ms : Int32) : Bool | Cancelled
  IyiScheduler.wait_writable_current(fd, ms)
end

def iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64 | Cancelled
  {% if flag?(:win32) %}
    IyiScheduler.read_current(fd, buffer, count)
  {% else %}
    IyiScheduler.read_posix(fd, buffer, count)
  {% end %}
end

def iyi_read(fd : Int64, buffer : Void*, count : UInt64) : Int64 | Cancelled
  {% if flag?(:win32) %}
    IyiScheduler.read_current(fd, buffer, count)
  {% else %}
    IyiScheduler.read_posix(fd.to_i32, buffer, count)
  {% end %}
end

# ── Tasks and groups — III.4.1 ─────────────────────────────────────────

# What `g.spawn` answers. `value` joins, then repeats what the task's
# block returned — the whole union, error members included, so `case`
# handles a task's failure exactly the way III.4.3 says (the group has
# already applied its policy by then; reading the value is optional).
# Any number of fibers may read it, before the task ends or after.
class IyiTask(T)
  @fiber : IyiFiber
  @box : Array(T)

  def initialize(@fiber : IyiFiber)
    @box = Array(T).new(1)
  end

  def fiber : IyiFiber
    @fiber
  end

  def finish(value : T) : Nil
    @box << value
  end

  def done? : Bool
    @fiber.state == IyiFiberState::Done
  end

  def value : T | Panicked
    IyiScheduler.join(@fiber)
    # III.1.4, literal: reading the panicked task's value *catches* the
    # panic — it arrives as the error value it became at the boundary,
    # `case`/`!`/`.or` handle it like any failure, and the join stops
    # owing a re-raise for it.
    if @fiber.panicked
      @fiber.panic_delivered = true
      return Panicked.new(@fiber.panic_message)
    end
    return Panicked.new("a task stopped by its cancellation has no value") if @box.empty?
    @box.first
  end
end

class IyiGroup
  @live : Int32
  getter first_failure : UInt64
  @first_child : IyiFiber?
  @joiner : IyiFiber?
  # The group its owner had open when this one opened (`open_group`).
  getter outer : IyiGroup?
  # The task that opened it, whose tasks these are: what a task inherits
  # from the one that started it - std/log's context - is found through it.
  getter owner : IyiFiber
  # Joined, so its scope is over: a handle kept past it spawned a task
  # that never ran, and nothing said so (III.4.1).
  @ended : Bool
  # Cancelled once (`cancel_children`), so a task spawned after starts
  # cancelled: one spawned 10 ms after a sibling's failure had cancelled
  # the group slept its full 2000 ms, and the group's join with it.
  @cancelled : Bool

  def initialize
    @live = 0
    @first_failure = 0_u64
    @first_child = nil
    @joiner = nil
    @ended = false
    @cancelled = false
    @owner = IyiScheduler.current
    # Under the scheduler's lock: a cancel from another thread walks the
    # owner's open groups (`IyiScheduler.cancel`).
    IyiSchedLock.lock
    @outer = @owner.open_group
    @owner.open_group = self
    IyiSchedLock.unlock
  end

  # Start a task. The block is compiled once and carried as a proc; its
  # return value is the task's, and an error member is a failure the
  # group acts on (III.4.3): the first cancels the siblings, and the task
  # it is told on is `first_failure`, which the typed group answers. A
  # task a cancelled one starts, or one a cancelled group starts, is
  # cancelled from its first wait on. It never runs at the same instant as
  # its spawner: on a thread outside the pool it runs on that thread for
  # its whole life, and inside a parallel task it joins that task's unit
  # (`IyiUnit`), whose fibers may each resume on another worker but never
  # two at once.
  def spawn(&block : -> T) : IyiTask(T) forall T
    raise "a task spawned on a group whose block has ended: no scope is left to join it" if @ended
    IyiScheduler.make_stacks_with { |fresh| fresh.prepare_stack } unless IyiScheduler.makes_stacks?
    fiber = IyiFiber.new
    fiber.home = IyiScheduler.state
    fiber.unit = IyiScheduler.current.unit
    task = IyiTask(T).new(fiber)
    runner = self
    install(fiber) do
      value = block.call
      task.finish(value)
      runner.finished(fiber, value.is_a?(::Error))
    end
    adopt(fiber)
    IyiScheduler.enqueue(fiber)
    task
  end

  {% if !flag?(:gc_none) && !flag?(:gc_boehm) %}
    # Start a task that may run on another core (SPEC.md III.4.13): it
    # waits in the pool until a worker is free, and from then on runs on
    # whichever worker is free whenever it is runnable, with the tasks it
    # spawns (`IyiUnit`). Everything else is `spawn`'s - the scope, the
    # cancel, the failure policy, the answer through `value`. What differs
    # is what the compiler asks of the block: it may capture only `Share`
    # values, as the block a thread runs may (III.4.4,
    # `CleanupTransformer#check_share_boundary`).
    def spawn_parallel(&block : -> T) : IyiTask(T) forall T
      raise "a task spawned on a group whose block has ended: no scope is left to join it" if @ended
      IyiScheduler.make_stacks_with { |fresh| fresh.prepare_stack } unless IyiScheduler.makes_stacks?
      IyiWorkers.start
      fiber = IyiFiber.new
      fiber.parallel = true
      fiber.unit = IyiUnit.new
      task = IyiTask(T).new(fiber)
      runner = self
      install(fiber) do
        value = block.call
        task.finish(value)
        runner.finished(fiber, value.is_a?(::Error))
      end
      adopt(fiber)
      IyiSchedLock.lock
      IyiWorkers.push(fiber)
      IyiSchedLock.unlock
      task
    end
  {% else %}
    def spawn_parallel(&block : -> T) : IyiTask(T) forall T
      \{% raise "spawn_parallel needs threads, and a build under -Dgc_none or -Dgc_boehm has none: a thread would race the bump pointer, or be one Boehm never heard of (SPEC.md III.4.13)" %}
    end
  {% end %}

  # :nodoc: — the end of a task's body, on its own stack: the group told,
  # under the scheduler's lock, since the group's owner may be on another
  # thread (III.4.13). An error answer is a failure unless the task was
  # cancelled.
  def finished(fiber : IyiFiber, error : Bool) : Nil
    IyiSchedLock.lock
    child_finished(error && !fiber.cancelled)
    drop_child(fiber)
    IyiSchedLock.unlock
  end

  # A new child on the list and counted live, cancelled from the start
  # when its spawner or this group already is.
  private def adopt(fiber : IyiFiber) : Nil
    spawner = IyiScheduler.current
    IyiScheduler.register(fiber)
    IyiSchedLock.lock
    fiber.cancelled = spawner.cancelled || @cancelled
    fiber.next_child = @first_child
    fiber.prev_child = nil
    first = @first_child
    first.prev_child = fiber if first.is_a?(IyiFiber)
    @first_child = fiber
    fiber.group = self
    @live = @live + 1
    IyiSchedLock.unlock
  end

  # The one place a task body becomes a stored proc. A captured block is
  # the language's own closure; a proc literal is not a thing an iyi file
  # writes.
  private def install(fiber : IyiFiber, &body : -> Nil) : Nil
    fiber.proc = body
  end

  # :nodoc: — the runtime's own callback, on the task's stack.
  # A child that finished and left nothing to say leaves the list too.
  # A group is a scope and most scopes are short, but a server's is the
  # whole run: its children are every connection it ever took, and a
  # list that only grows is the same leak the registry had. A panicked
  # child stays, because `join` owes a re-raise for one nobody read.
  def drop_child(fiber : IyiFiber) : Nil
    return if fiber.panicked
    following = fiber.next_child
    previous = fiber.prev_child
    if previous.is_a?(IyiFiber)
      previous.next_child = following
    else
      @first_child = following
    end
    following.prev_child = previous if following.is_a?(IyiFiber)
    fiber.next_child = nil
    fiber.prev_child = nil
  end

  def child_finished(failed : Bool) : Nil
    @live = @live - 1
    if failed && @first_failure == 0_u64
      @first_failure = IyiScheduler.current.object_id
      cancel_children_locked
    end
    if @live == 0
      joiner = @joiner
      if joiner.is_a?(IyiFiber)
        @joiner = nil
        IyiScheduler.ready(joiner)
      end
    end
  end

  # :nodoc: — a panicking child, on its own stack: the same accounting
  # as a returned error. What the join owes for it is read off the
  # children themselves.
  def child_panicked(cancelled : Bool) : Nil
    child_finished(!cancelled)
  end

  # :nodoc: — `group`'s deferred half, and the typed group's explicit
  # one: the scope's end, after which the group takes no task. It cannot
  # be left until every task has finished, and `defer` is what guarantees
  # "cannot". *early* says the block did not reach its end - a `return`,
  # a `break`, a `!`, a panic - and the owner stops what it started before
  # it waits (III.4.2): `return 5` beside a 2-second sleep took the 2 s.
  # A dying owner is not the sign: a cleanup's own group, opened and ended
  # on a panic's path, had its tasks cancelled at its end.
  def join(early : Bool = false) : Nil
    # An `exit` runs this task's cleanups and ends the process, the other
    # tasks with it: a group's join is one of those cleanups, and it waited
    # for every task - `exit(4)` beside a sibling's minute-long sleep took
    # the minute.
    return if IyiScheduler.exiting?
    me = IyiScheduler.current
    # The count and the joiner under the scheduler's lock, which a task
    # finishing on another thread takes to count itself out (III.4.13).
    IyiSchedLock.lock
    cancel_children_locked if early
    while @live > 0
      @joiner = me
      me.joining = self
      me.state = IyiFiberState::Joining
      IyiSchedLock.unlock
      IyiScheduler.reschedule
      IyiSchedLock.lock
      me.joining = nil
    end
    @ended = true
    me.open_group = @outer
    # The boundary owes a re-raise for any panic *nobody read*: a bug
    # observed through its handle already became a `Panicked` value
    # there, and re-raising it too would report one bug twice. The
    # child is marked delivered before the raise, so the deferred
    # second join (concurrency's own `defer g.join`) finds nothing —
    # and an owner already on its own panic path gets the mark without
    # the noise. The one named is the failure that stopped the group: the
    # list is newest first, and two panics were reported as the second.
    owed = nil
    child = @first_child
    while child.is_a?(IyiFiber)
      if child.panicked && !child.panic_delivered
        child.panic_delivered = true
        owed = child unless owed.is_a?(IyiFiber) && child.object_id != @first_failure
      end
      child = child.next_child
    end
    IyiSchedLock.unlock
    raise "a task panicked: " + owed.panic_message if owed.is_a?(IyiFiber) && !me.panicked
  end

  # :nodoc: — the owner taken out of this join by a deadlock
  # (`IyiScheduler.deadlock_found`), so no task finishing later wakes it
  # in whatever it waits on next.
  def forget_joiner : Nil
    @joiner = nil
  end

  # Cancel every task still live. The group's own tool; a failing child
  # reaches it through the policy above.
  def cancel_children : Nil
    IyiSchedLock.lock
    cancel_children_locked
    IyiSchedLock.unlock
  end

  # :nodoc: — the same, with the scheduler's lock already held: the
  # failure policy, an early join and a cancel's walk of the groups a
  # cancelled task holds open.
  def cancel_children_locked : Nil
    @cancelled = true
    child = @first_child
    while child.is_a?(IyiFiber)
      IyiScheduler.cancel(child)
      child = child.next_child
    end
  end
end

# III.4.1: concurrency is introduced by a scope, never by a call. The
# join is deferred, so no exit leaves a task running — not a `return`,
# not an error leaving through `!` — and one before the block's end
# cancels them first. The group answers what its block answers, which is
# how the typed form (III.4.9) gets a value out: the expansion appends
# the extraction to the block, and the block stays a block, so nothing a
# task assigned leaks into the enclosing scope.
def group(& : IyiGroup -> U) : U forall U
  g = IyiGroup.new
  early = true
  defer g.join(early)
  answer = yield g
  early = false
  answer
end

# ── Channel — III.4.6 ──────────────────────────────────────────────────
#
# `Channel(T).new` is a rendezvous, as Crystal's is: a send completes when
# a receive takes it, and either side parks until the other arrives. A
# parked sender carries its value in its node's box, and a parked
# receiver has a slot a sender fills, so the handoff needs no third
# party; `new(capacity)` buffers that many sends first. Closing drains
# what was delivered, then refuses: a parked sender whose box is still
# full failed, and its value dies with the node.
#
# A channel crosses threads (SPEC.md III.4.13): it is `@[Share]`,
# trusted whenever `T` is - III.4.6's "`Channel(T)` carries over, with
# `T : Share`" - so a parallel task and a thread may capture one whose
# values are themselves safe on two threads, and every operation below
# is behind the scheduler's lock, which a park lets go of before it
# switches. A wake of a fiber on another thread goes through its inbox
# (`IyiScheduler.ready`). `select` is answered by this protocol — a node
# per arm, one nonce, losers stale by arithmetic until the woken select
# takes them out — at the bottom of the class.
@[Share]
class Channel(T)
  # The values in hand, a ring: `@count` of them from `@first`. An array
  # shifted from the front steps its buffer past the slot and gives up a
  # slot of capacity with it, so a channel that handed values over one at
  # a time grew a new buffer every few sends - an allocation per four
  # messages in a ring of tasks. The ring keeps its slots.
  @ring : Pointer(T)
  @first : Int32
  @count : Int32
  @slots : Int32
  @capacity : Int32
  @closed : Bool
  @recv_head : IyiWaiter?
  @recv_tail : IyiWaiter?
  @send_head : IyiSendNode(T)?
  @send_tail : IyiSendNode(T)?
  # The send node the last parked sender used (`park_send_node`).
  @spare_send : IyiSendNode(T)?

  def initialize
    initialize(0)
  end

  def initialize(capacity : Int32)
    raise "a channel's capacity is not negative" if capacity < 0
    @slots = capacity < 1 ? 1 : capacity
    @ring = Pointer(T).malloc(@slots.to_u64)
    @first = 0
    @count = 0
    @capacity = capacity
    @closed = false
    @recv_head = nil
    @recv_tail = nil
    @send_head = nil
    @send_tail = nil
    @spare_send = nil
  end

  def send(value : T) : Nil | ChannelClosed | Cancelled
    fiber = IyiScheduler.current
    IyiSchedLock.lock
    if fiber.cancelled
      IyiSchedLock.unlock
      return Cancelled.new
    end
    if send_ready_held?
      answer = put_held(value)
      IyiSchedLock.unlock
      return answer
    end

    # Park carrying the value. The wake tells one of three stories, and
    # the box is the witness for the one that matters: emptied means
    # delivered, whatever else has happened since. A box still full is a
    # cancelled park's or a closed channel's, and its node leaves the
    # queue here and lets go of the value, so a cancelled one leaves
    # nothing behind.
    node = park_send_node(fiber, IyiScheduler.park(fiber), value)
    IyiSchedLock.unlock
    IyiScheduler.reschedule
    IyiSchedLock.lock
    delivered = node.delivered?
    node.read = true
    unless delivered
      unlink_sender(node)
      node.forget
    end
    cancelled = fiber.cancelled
    IyiSchedLock.unlock
    return nil if delivered
    return Cancelled.new if cancelled
    ChannelClosed.new
  end

  # A closed channel drains what was delivered before it refuses. A
  # rendezvous sender that finds this receive parked writes its value into
  # `got` and marks the node handed, and that is the answer even when the
  # task was cancelled before it ran: the sender was told it was taken.
  # A woken park that was handed nothing takes its node out of the queue,
  # so a cancelled one leaves nothing behind.
  def receive : T | ChannelClosed | Cancelled
    fiber = IyiScheduler.current
    IyiSchedLock.lock
    while true
      if fiber.cancelled
        IyiSchedLock.unlock
        return Cancelled.new
      end
      if receive_ready_held?
        answer = take_held
        IyiSchedLock.unlock
        return answer
      end
      got = uninitialized T
      waiter = park_receive_node(fiber, IyiScheduler.park(fiber), pointerof(got).address)
      IyiSchedLock.unlock
      IyiScheduler.reschedule
      IyiSchedLock.lock
      if waiter.handed
        IyiSchedLock.unlock
        return got
      end
      unlink_receiver(waiter)
    end
  end

  # Everyone parked is woken; what each wake means is read on the woken
  # side — a receiver finds the buffer, then `ChannelClosed`; a sender
  # finds its box still full.
  def close : Nil
    IyiSchedLock.lock
    @closed = true
    while wake_receiver
    end
    while true
      node = take_sender
      break unless node.is_a?(IyiSendNode(T))
      IyiScheduler.ready(node.fiber)
    end
    IyiSchedLock.unlock
  end

  def closed? : Bool
    @closed
  end

  # ── The halves `select` shares with the calls above ────────────────
  #
  # `*_held` assume the scheduler's lock: `ready?` promises the `_now`
  # half will not park, and with the lock held from the look to the act
  # the promise cannot be broken in the gap, by a fiber on this thread or
  # on any other. `send`, `receive` and `select` call these.
  #
  # The public spellings take the lock themselves. They were these same
  # halves, public because `select`'s arms call them, and the library
  # called them directly with no lock: std/http's `serve_parallel` freed
  # a connection's place with `slots.take_now` on whichever worker served
  # it, and a handler stopped a server with `stop.put_now(0)` from a
  # worker. A wake from there of a task parked on another thread - the
  # accept loop waiting for a place - linked it into that thread's inbox
  # under no lock, beside other threads doing the same, and the ring,
  # the count and the queues were changed by two threads at once: a stop
  # was lost now and then, and a waiter slept on. `bench/parallel_exercise`'s
  # `now` step hammers both from every worker, and a copy without the
  # lock is caught there.

  def receive_ready? : Bool
    IyiSchedLock.lock
    ready = receive_ready_held?
    IyiSchedLock.unlock
    ready
  end

  # :nodoc: - the scheduler's lock held.
  def receive_ready_held? : Bool
    @closed || @count > 0 || sender_waiting?
  end

  # The next value without waiting: the buffer, then a parked sender's
  # box, then `ChannelClosed`. On an empty open channel there is nothing
  # to take, and asking is a bug the call panics over; `select` with an
  # `else` arm is the receive that may find nothing.
  def take_now : T | ChannelClosed
    IyiSchedLock.lock
    ready = receive_ready_held?
    answer = ready ? take_held : ChannelClosed.new
    IyiSchedLock.unlock
    raise "take_now on an empty open channel" unless ready
    answer
  end

  # :nodoc: - the scheduler's lock held, and `receive_ready_held?` true:
  # the buffer, then a parked sender's box, then the refusal.
  def take_held : T | ChannelClosed
    if @count > 0
      value = shift_item
      # The buffer has room now; the oldest parked sender's value moves
      # in, so parked sends complete in the order they parked.
      refill = take_sender
      if refill.is_a?(IyiSendNode(T))
        push_item(refill.take)
        IyiScheduler.ready(refill.fiber)
      end
      return value
    end
    unless @closed
      node = take_sender
      if node.is_a?(IyiSendNode(T))
        value = node.take
        IyiScheduler.ready(node.fiber)
        return value
      end
    end
    return ChannelClosed.new if @closed
    raise "take_now on an empty open channel"
  end

  def send_ready? : Bool
    IyiSchedLock.lock
    ready = send_ready_held?
    IyiSchedLock.unlock
    ready
  end

  # :nodoc: - the scheduler's lock held.
  def send_ready_held? : Bool
    @closed || @count < @capacity || receiver_waiting?
  end

  # The value sent without waiting: to a parked receiver, or into the
  # buffer; `ChannelClosed` once the channel is. A full channel has no
  # room, and asking is a bug the call panics over; `select` with an
  # `else` arm is the send that may not happen.
  def put_now(value : T) : Nil | ChannelClosed
    IyiSchedLock.lock
    ready = send_ready_held?
    answer = ready ? put_held(value) : nil
    IyiSchedLock.unlock
    raise "put_now on a full channel" unless ready
    answer
  end

  # :nodoc: - the scheduler's lock held, and `send_ready_held?` true. A
  # rendezvous puts the value in the parked receiver's own slot (`hand`).
  # It went into the buffer, and the send answered delivered on the word
  # of the wake: a select woken that way took another arm ready by then, a
  # receiver cancelled before it ran answered `Cancelled`, and either way
  # the value stayed in a channel of no capacity after its sender left. A
  # buffered send completes when the buffer takes it, so there the woken
  # receiver finds it in the buffer.
  def put_held(value : T) : Nil | ChannelClosed
    return ChannelClosed.new if @closed
    return nil if @capacity == 0 && hand(value)
    if wake_receiver
      push_item(value)
      return nil
    end
    if @count < @capacity
      push_item(value)
      return nil
    end
    raise "put_now on a full channel"
  end

  def receive_select_action : IyiReceiveSelect(T)
    IyiReceiveSelect(T).new(self)
  end

  def send_select_action(value : T) : IyiSendSelect(T)
    IyiSendSelect(T).new(self, value)
  end

  # Onto the ring's end. A buffered channel can be asked for more than
  # its capacity: senders that each woke a parked receiver before any of
  # them ran have all those values in hand, so a full ring doubles.
  private def push_item(value : T) : Nil
    if @count == @slots
      grown = Pointer(T).malloc((@slots * 2).to_u64)
      index = 0
      while index < @count
        grown[index] = @ring[(@first + index) % @slots]
        index = index + 1
      end
      @ring = grown
      @first = 0
      @slots = @slots * 2
    end
    at = @first + @count
    at = at - @slots if at >= @slots
    @ring[at] = value
    @count = @count + 1
  end

  # The slot is emptied as it is read, as a send node's box is: a ring
  # kept every value it had held until a later send wrote over it, and 50
  # messages of 4 MB through a channel of 50, every one received, kept
  # 190 MiB.
  private def shift_item : T
    value = @ring[@first]
    IyiScheduler.forget(@ring + @first.to_i64)
    @first = @first + 1 == @slots ? 0 : @first + 1
    @count = @count - 1
    value
  end

  # `select`'s arms park through these with one shared nonce; a plain
  # call parks with a fresh nonce of its own. *slot* is where a rendezvous
  # sender puts its value (`IyiWaiter#slot`). These and the two unlinks
  # below are public for the arms' sake and change the queues, so like
  # the `*_held` halves they are called with the scheduler's lock held.
  def park_receive_node(fiber : IyiFiber, nonce : UInt64, slot : UInt64) : IyiWaiter
    waiter = fiber.spare_waiter
    if waiter.is_a?(IyiWaiter) && !waiter.linked
      waiter.renew(nonce, slot)
    else
      waiter = IyiWaiter.new(fiber, nonce, slot)
      fiber.spare_waiter = waiter
    end
    waiter.linked = true
    tail = @recv_tail
    waiter.prev_node = tail
    if tail.is_a?(IyiWaiter)
      tail.next_node = waiter
    else
      @recv_head = waiter
    end
    @recv_tail = waiter
    waiter
  end

  def park_send_node(fiber : IyiFiber, nonce : UInt64, value : T) : IyiSendNode(T)
    # A ring of tasks parks on every send: a node a park was an allocation
    # a message. A `select`'s arm never marks its node read, so a node
    # parked by a select is never handed out again.
    node = @spare_send
    if node.is_a?(IyiSendNode(T)) && node.read && !node.linked
      node.renew(fiber, nonce, value)
    else
      node = IyiSendNode(T).new(fiber, nonce, value)
      @spare_send = node
    end
    node.read = false
    node.linked = true
    tail = @send_tail
    node.prev_node = tail
    if tail.is_a?(IyiSendNode(T))
      tail.next_node = node
    else
      @send_head = node
    end
    @send_tail = node
    node
  end

  # Peeks that prune: a stale head is consumed, never counted.
  private def receiver_waiting? : Bool
    while true
      head = @recv_head
      return false unless head.is_a?(IyiWaiter)
      return true if head.current?
      unlink_receiver(head)
    end
  end

  # Out of the receive queue from wherever it stands, in constant time,
  # and no longer linked anywhere; a node no queue holds is left as it
  # is. The queue is linked both ways because a select's losing arms
  # leave from the middle: they stayed until something walked them off
  # the head, so a loop selecting over a busy channel and an idle one
  # left a node in the idle one's queue for every park - 30 MiB kept
  # after two million rounds, freed only when the idle channel was used.
  def unlink_receiver(node : IyiWaiter) : Nil
    return unless node.linked
    before = node.prev_node
    after = node.next_node
    if before.is_a?(IyiWaiter)
      before.next_node = after
    else
      @recv_head = after
    end
    if after.is_a?(IyiWaiter)
      after.prev_node = before
    else
      @recv_tail = before
    end
    node.next_node = nil
    node.prev_node = nil
    node.linked = false
  end

  private def sender_waiting? : Bool
    while true
      head = @send_head
      return false unless head.is_a?(IyiSendNode(T))
      return true if head.current?
      unlink_sender(head)
    end
  end

  # The send queue's `unlink_receiver`.
  def unlink_sender(node : IyiSendNode(T)) : Nil
    return unless node.linked
    before = node.prev_node
    after = node.next_node
    if before.is_a?(IyiSendNode(T))
      before.next_node = after
    else
      @send_head = after
    end
    if after.is_a?(IyiSendNode(T))
      after.prev_node = before
    else
      @send_tail = before
    end
    node.next_node = nil
    node.prev_node = nil
    node.linked = false
  end

  # True when a parked receiver was woken; stale nodes — parks their
  # fiber already left — are consumed and skipped, so a real waiter
  # behind one is never starved by a leftover in front of it.
  private def wake_receiver : Bool
    while true
      head = @recv_head
      return false unless head.is_a?(IyiWaiter)
      unlink_receiver(head)
      next unless head.current?
      IyiScheduler.ready(head.fiber)
      return true
    end
  end

  # `wake_receiver` for a rendezvous, with the value written into the
  # receiver's slot before its fiber runs: the wake is the delivery, so
  # the select that parked the node takes this arm, and a cancellation
  # that comes after the wake cannot strand the value. The node is
  # current, so the slot's owner is suspended in the park that made it.
  private def hand(value : T) : Bool
    while true
      head = @recv_head
      return false unless head.is_a?(IyiWaiter)
      unlink_receiver(head)
      next unless head.current?
      Pointer(T).new(head.slot).value = value
      head.handed = true
      IyiScheduler.ready(head.fiber)
      return true
    end
  end

  # The oldest parked sender still standing, not yet woken: the caller
  # takes the value first and wakes the fiber after, so the box is the
  # delivery receipt by the time its owner runs.
  private def take_sender : IyiSendNode(T)?
    while true
      head = @send_head
      return nil unless head.is_a?(IyiSendNode(T))
      unlink_sender(head)
      next unless head.current?
      return head
    end
  end

  # ── select — III.4.6, the library half of the expansion ────────────
  #
  # A `select` compiles to `%i, %v, %h = ::Channel.select({arm, arm}, b)`
  # and a case over the index; `non_blocking_select` when an `else` arm
  # exists. One def serves every arity, because a tuple's size is a
  # compile-time fact a macro walks. `%h` says the arm's operation
  # happened, and an arm nobody binds runs its body only then: it ran
  # unless its answer was an `Error`, so a `Channel(Boom)`'s receive took
  # the `Boom` and skipped the body. *bound* is the first arm that binds,
  # -1 for none, and a cancelled task's `Cancelled` goes to it, as that
  # arm's own primitive would have answered it.
  #
  # Every look and every act is under the scheduler's lock, one lock for
  # every channel an arm names, so no arm's channel changes between the
  # look that found it ready and the act; the park lets go of it.
  def self.select(actions : U, bound : Int32) forall U
    fiber = IyiScheduler.current
    IyiSchedLock.lock
    while true
      if fiber.cancelled
        IyiSchedLock.unlock
        return cancelled_answer(bound)
      end
      {% for i in 0...U.size %}
        if actions[{{ i }}].ready?
          happened{{ i }} = !actions[{{ i }}].refused?
          answer{{ i }} = actions[{{ i }}].execute
          IyiSchedLock.unlock
          return { {{ i }}, answer{{ i }}, happened{{ i }} }
        end
      {% end %}
      # Nothing ready: one park, every arm's node carrying its nonce.
      # An arm can win *while parked* — a receiver empties a send arm's
      # box, a rendezvous sender fills a receive arm's slot — and that is
      # checked before the next round of parks, once every arm's node has
      # left its queue: the losers' nodes are stale, and left there they
      # stayed until their channel was used again.
      nonce = IyiScheduler.park(fiber)
      {% for i in 0...U.size %}
        actions[{{ i }}].park(fiber, nonce)
      {% end %}
      IyiSchedLock.unlock
      IyiScheduler.reschedule
      IyiSchedLock.lock
      {% for i in 0...U.size %}
        actions[{{ i }}].unpark
      {% end %}
      {% for i in 0...U.size %}
        if actions[{{ i }}].won_while_parked?
          won{{ i }} = actions[{{ i }}].won_value
          IyiSchedLock.unlock
          return { {{ i }}, won{{ i }}, true }
        end
      {% end %}
    end
  end

  # No arm ready answers -1, which the expansion's case meets with the
  # program's own `else`.
  def self.non_blocking_select(actions : U, bound : Int32) forall U
    fiber = IyiScheduler.current
    IyiSchedLock.lock
    if fiber.cancelled
      IyiSchedLock.unlock
      return cancelled_answer(bound)
    end
    {% for i in 0...U.size %}
      if actions[{{ i }}].ready?
        happened{{ i }} = !actions[{{ i }}].refused?
        answer{{ i }} = actions[{{ i }}].execute
        IyiSchedLock.unlock
        return { {{ i }}, answer{{ i }}, happened{{ i }} }
      end
    {% end %}
    IyiSchedLock.unlock
    {-1, nil, false}
  end

  # With no bound arm a cancelled task stops (`IyiScheduler.stop_current`):
  # the `Cancelled` went to the first arm, which runs nothing unbound, so
  # a loop around `when timeout(10)` and a bound receive spun at a full
  # core, never cancelled, and its group's join waited for it forever.
  private def self.cancelled_answer(bound : Int32) : Tuple(Int32, Cancelled, Bool)
    IyiScheduler.stop_current if bound < 0
    {bound, Cancelled.new, false}
  end

  # Nothing happens on the arm `take_held` answers: `ChannelClosed` is
  # the refusal here, where a closed channel's buffer is spent.
  def receive_refused? : Bool
    @closed && @count == 0
  end
end

# The two arm shapes `select`'s expansion asks a channel for. Classes,
# because a select holds one across a park and reads what happened to
# it; a struct in a tuple is a copy nobody else can write to.
class IyiReceiveSelect(T)
  @channel : Channel(T)
  @node : IyiWaiter?
  # The slot a rendezvous sender fills while this arm is parked.
  @got : T

  def initialize(@channel : Channel(T))
    @node = nil
    @got = uninitialized T
  end

  def ready? : Bool
    @channel.receive_ready_held?
  end

  def refused? : Bool
    @channel.receive_refused?
  end

  def execute : T | ChannelClosed
    @channel.take_held
  end

  def park(fiber : IyiFiber, nonce : UInt64) : Nil
    @node = @channel.park_receive_node(fiber, nonce, pointerof(@got).address)
  end

  def unpark : Nil
    node = @node
    @channel.unlink_receiver(node) if node.is_a?(IyiWaiter)
  end

  # A rendezvous receive wins by being handed its value. A buffered one
  # wins by waking: the value is in the channel when the select looks
  # again.
  def won_while_parked? : Bool
    node = @node
    node.is_a?(IyiWaiter) && node.handed
  end

  def won_value : T
    @got
  end
end

class IyiSendSelect(T)
  @channel : Channel(T)
  @value : T
  @node : IyiSendNode(T)?

  def initialize(@channel : Channel(T), @value : T)
    @node = nil
  end

  def ready? : Bool
    @channel.send_ready_held?
  end

  def refused? : Bool
    @channel.closed?
  end

  def execute : Nil | ChannelClosed
    @channel.put_held(@value)
  end

  def park(fiber : IyiFiber, nonce : UInt64) : Nil
    @node = @channel.park_send_node(fiber, nonce, @value)
  end

  # A losing arm's node lets go of the value as it leaves: the channel
  # may keep the node as its spare (`Channel#park_send_node`).
  def unpark : Nil
    node = @node
    return unless node.is_a?(IyiSendNode(T))
    @channel.unlink_sender(node)
    node.forget unless node.delivered?
  end

  def won_while_parked? : Bool
    node = @node
    node.is_a?(IyiSendNode(T)) && node.delivered?
  end

  def won_value : Nil
    nil
  end
end

# `when timeout(ms)`: the arm that wins once *ms* milliseconds have passed
# since the select began. The expansion asked for `timeout_select_action`
# and nothing answered, so the other library's arm was "undefined method"
# here. Parked, the select waits in the sleep heap at the deadline as well
# as in its channels' queues. It never wins while parked: a channel arm
# that won in the same turn holds a value, and the deadline is read on
# the next round, after the channels have had their say.
class IyiTimeoutSelect
  @deadline : Int64
  @fiber : IyiFiber?

  @[Effect(:scheduler)]; def initialize(ms : Int32)
    @deadline = __iyi_monotonic_ns + ms.to_i64 * 1000000_i64
    @fiber = nil
  end

  @[Effect(:scheduler)]; def ready? : Bool
    __iyi_monotonic_ns >= @deadline
  end

  def refused? : Bool
    false
  end

  def execute : Nil
    nil
  end

  # Two timeout arms share the fiber's one place in the heap, at the
  # earlier deadline. The heap is this thread's, and the select may be
  # woken by a channel from any thread, so until it has left the heap
  # again it is woken onto this thread alone (`IyiFiber#homebound`):
  # `unpark` runs where the fiber does. Both under the scheduler's lock,
  # which `select` holds.
  def park(fiber : IyiFiber, nonce : UInt64) : Nil
    @fiber = fiber
    fiber.homebound = true
    if IyiScheduler.sleeping?(fiber)
      return if fiber.deadline <= @deadline
      IyiScheduler.sleep_remove(fiber)
    end
    fiber.deadline = @deadline
    IyiScheduler.sleep_insert(fiber)
  end

  def unpark : Nil
    fiber = @fiber
    if fiber.is_a?(IyiFiber)
      IyiScheduler.sleep_remove(fiber)
      fiber.homebound = false
    end
    @fiber = nil
  end

  def won_while_parked? : Bool
    false
  end

  def won_value : Nil
    nil
  end
end

@[Effect(:timer)]; def timeout_select_action(ms : Int32) : IyiTimeoutSelect
  IyiTimeoutSelect.new(ms)
end

# ── Stack overflow: a guard-page fault is a sentence, not a signal ──────
#
# A fiber stack has a guard page under it, and the main thread's stack has
# the kernel's; running off either is a fault, and a fault was the kernel's
# to report - "Segmentation fault" from the shell, or the driver's guess
# about a memory fault from `iyi run`. What the fault nearly always *is*
# for an iyi program, which outside `Pointer` cannot reach memory it does
# not own, is the stack running out, and the program can say so itself:
# a handler on an alternate stack, since the one that overflowed has no
# room to run anything, reads the faulting address and the interrupted
# stack pointer and, when the fault is at the stack's own edge, prints
# `iyi: panic: stack overflow` through the one write a panic uses and
# exits 1. No unwinding - the defers cannot run on a stack that is gone -
# which is what Go and Rust answer for the same fault. A fault anywhere
# else is not this handler's to explain: it hands the signal back to its
# default disposition and returns, the instruction faults again, and the
# process dies of the signal it would have died of, so the driver's
# sentence about a memory fault still stands for what it describes.
#
# The edge is the distance from the interrupted stack pointer: a frame is
# carved below it (`sub rsp`, a pre-indexed `stp`) and touched within a
# page or two, and a fault farther than 256 KiB above the pointer is not
# a frame. Linux by raw syscall and darwin by libSystem, the same split
# the rest of this file makes; Windows keeps its own report.
{% unless flag?(:win32) %}
  # Linux by name, not "not Windows": the numbers below are Linux syscall
  # numbers and the `SA_RESTORER` flag and the `rt_sigreturn` trampoline
  # beside them are Linux's signal ABI. darwin x86_64 is excluded by the
  # prelude's require line today; were it not, a guard reading "x86_64"
  # would have handed it Linux's numbers without a word.
  {% if flag?(:linux) && flag?(:x86_64) %}
    IYI_SG_SYS_RT_SIGACTION = 13_i64
    IYI_SG_SYS_SIGALTSTACK  = 131_i64
    # SA_SIGINFO | SA_ONSTACK | SA_RESTORER: the restorer the stop's
    # handler names, for the same reason it does.
    IYI_SG_SA_FLAGS = 0x0C000004_u64
    IYI_SG_UC_SP    = 160_u64
  {% elsif flag?(:linux) %}
    IYI_SG_SYS_RT_SIGACTION = 134_i64
    IYI_SG_SYS_SIGALTSTACK  = 132_i64
    IYI_SG_SA_FLAGS = 0x08000004_u64
    IYI_SG_UC_SP    = 432_u64
  {% end %}
  IYI_SG_SIGSEGV = 11_i32
  # 7 is Linux's; darwin's is 10, and a fiber's guard page faults with
  # it there (KERN_PROTECTION_FAILURE is SIGBUS on darwin), so with 7
  # the guard heard the main stack run out and not a fiber's.
  {% if flag?(:darwin) %}
    IYI_SG_SIGBUS = 10_i32
  {% else %}
    IYI_SG_SIGBUS = 7_i32
  {% end %}
  IYI_SG_ALT_BYTES = 65536_u64
  # How far above the interrupted sp a frame's first touch may land, and
  # how far below: 256 KiB up (a fiber's whole stack), a page down.
  IYI_SG_ABOVE = 262144_u64
  IYI_SG_BELOW =   4096_u64

  {% if flag?(:darwin) %}
    lib LibC
      fun sigaltstack(ss : Void*, oss : Void*) : Int32
      # thread.iyi declares this one too, and is left out of a `-Dgc_none`
      # or `-Dgc_boehm` build; the guard is in every build, so it says it.
      fun sigaction(signal : Int32, action : Void*, previous : Void*) : Int32
    end
  {% end %}

  module IyiStackGuard
    @@installed = false

    def self.address_of_handler(proc : Proc(Int32, Void*, Void*, Nil)) : UInt64
      Pointer(UInt64).new(pointerof(proc).address).value
    end

    def self.handler_entry : UInt64
      address_of_handler(->(signal : Int32, info : Void*, context : Void*) { IyiStackGuard.faulted(signal, info.address, context.address) })
    end

    # Per thread: an alternate stack for the handler to run on, because the
    # stack that overflowed cannot; the handler itself once per process.
    @[Effect(:scheduler)]; def self.install : Nil
      {% if flag?(:darwin) %}
        alt = LibC.mmap(Pointer(Void).new(0_u64), IYI_SG_ALT_BYTES, 3, 4098, -1, 0_i64)
        return if alt.address &+ 1_u64 == 0_u64
        # darwin's stack_t: ss_sp, ss_size, ss_flags.
        stack = Pointer(UInt64).malloc(3_u64)
        stack[0] = alt.address
        stack[1] = IYI_SG_ALT_BYTES
        stack[2] = 0_u64
        return if LibC.sigaltstack(stack.as(Void*), Pointer(Void).new(0_u64)) != 0
        return if @@installed
        @@installed = true
        action = Pointer(UInt64).malloc(2_u64)
        action[0] = handler_entry
        # SA_SIGINFO (0x40) | SA_ONSTACK (0x01), in the high half.
        action[1] = 0x0000004100000000_u64
        LibC.sigaction(IYI_SG_SIGSEGV, action.as(Void*), Pointer(Void).new(0_u64))
        LibC.sigaction(IYI_SG_SIGBUS, action.as(Void*), Pointer(Void).new(0_u64))
      {% else %}
        alt = __iyi_conc_syscall6(IYI_SYS_MMAP, 0_i64, IYI_SG_ALT_BYTES.to_i64, 3_i64, 34_i64, -1_i64, 0_i64)
        return if alt < 0 && alt >= -4095
        # The kernel's stack_t: ss_sp, ss_flags, ss_size.
        stack = Pointer(UInt64).malloc(3_u64)
        stack[0] = alt.to_u64
        stack[1] = 0_u64
        stack[2] = IYI_SG_ALT_BYTES
        return if __iyi_conc_syscall3(IYI_SG_SYS_SIGALTSTACK, stack.address.to_i64, 0_i64, 0_i64) < 0
        return if @@installed
        @@installed = true
        action = Pointer(UInt64).malloc(4_u64)
        action[0] = handler_entry
        action[1] = IYI_SG_SA_FLAGS
        {% if flag?(:linux) && flag?(:x86_64) %}
          action[2] = __iyi_sg_sigreturn_address
        {% else %}
          action[2] = 0_u64
        {% end %}
        action[3] = 0_u64
        __iyi_conc_syscall6(IYI_SG_SYS_RT_SIGACTION, IYI_SG_SIGSEGV.to_i64, action.address.to_i64, 0_i64, 8_i64, 0_i64, 0_i64)
        __iyi_conc_syscall6(IYI_SG_SYS_RT_SIGACTION, IYI_SG_SIGBUS.to_i64, action.address.to_i64, 0_i64, 8_i64, 0_i64, 0_i64)
      {% end %}
    end

    # The fault's address and the stack pointer it interrupted, from the
    # kernel's own structs; nothing here allocates or takes a lock.
    @[Effect(:scheduler)]; def self.faulted(signal : Int32, info : UInt64, context : UInt64) : Nil
      {% if flag?(:darwin) %}
        # darwin arm64's structs: `si_addr` at 24, `uc_mcontext` at 48, and
        # in `__darwin_mcontext64` the `__ss.__sp` at 264 — past the 16-byte
        # exception state and x0..x28, fp and lr. An x86_64 darwin would keep
        # `rsp` at 72, and is not built with this file.
        address = Pointer(UInt64).new(info + 24_u64).value
        mcontext = Pointer(UInt64).new(context + 48_u64).value
        sp = Pointer(UInt64).new(mcontext + 264_u64).value
      {% else %}
        address = Pointer(UInt64).new(info + 16_u64).value
        sp = Pointer(UInt64).new(context + IYI_SG_UC_SP).value
      {% end %}
      if address &+ IYI_SG_BELOW >= sp && address <= sp &+ IYI_SG_ABOVE
        say("iyi: panic: stack overflow: the stack ran out, which is infinite or very deep recursion\n")
        __iyi_exit(1)
      end
      # Not the stack's edge: the signal's default action, on the retry.
      {% if flag?(:darwin) %}
        action = Pointer(UInt64).malloc(2_u64)
        action[0] = 0_u64
        action[1] = 0_u64
        LibC.sigaction(signal, action.as(Void*), Pointer(Void).new(0_u64))
      {% else %}
        action = Pointer(UInt64).malloc(4_u64)
        action[0] = 0_u64
        action[1] = 0_u64
        action[2] = 0_u64
        action[3] = 0_u64
        __iyi_conc_syscall6(IYI_SG_SYS_RT_SIGACTION, signal.to_i64, action.address.to_i64, 0_i64, 8_i64, 0_i64, 0_i64)
      {% end %}
    end

    # One descriptor, no stream, no error: the panic's own write.
    def self.say(text : String) : Nil
      written = 0_i64
      total = text.bytesize.to_i64
      while written < total
        n = __iyi_write(2, (text.to_unsafe + written).as(Void*), (total - written).to_u64)
        break if n <= 0_i64
        written = written + n
      end
    end
  end

  {% if flag?(:linux) && flag?(:x86_64) %}
    @[NoInline]
    @[Naked]
    fun __iyi_sg_sigreturn : Nil
      asm("movq $$15, %rax
           syscall" :::: "volatile")
    end

    @[NoInline]
    @[Naked]
    fun __iyi_sg_sigreturn_address : UInt64
      asm("leaq __iyi_sg_sigreturn(%rip), %rax
           retq" :::: "volatile")
      0_u64
    end
  {% end %}

  IyiStackGuard.install
{% end %}

# The two raises codegen calls by name rather than inlining (`__iyi_raise_cast_failed`,
# `__iyi_raise_closure_to_c`): a call is one element of a build's call path where
# the inlined raise carried the source location of the cast or the closure.
fun __iyi_raise_cast_failed(from : Void*, to : Void*, at : Void*) : NoReturn
  raise TypeCastError.new(at ? "Cast from #{from.as(String)} to #{to.as(String)} failed, at #{at.as(String)}" : "Cast from #{from.as(String)} to #{to.as(String)} failed")
end
fun __iyi_raise_closure_to_c : NoReturn
  raise("passing a closure to C is not allowed", "??", 0)
end
