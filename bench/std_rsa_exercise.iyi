# Exercises std/rsa: PKCS #1 v1.5 and PSS signatures checked and made,
# and keys read and refused.
#
# With no argument: signatures Python's cryptography made, under a
# 2048-bit key and under a 1025-bit one (whose PSS encoding is a byte
# shorter than the modulus), each hash and scheme accepted; encodings made
# by hand and signed with the private key, each breaking one rule with the
# digest still matching (a 2050-bit key for a forbidden top bit that keeps
# the encoding below the modulus); and each way a
# signature can be wrong refused - the message, the hash, the scheme, the
# salt's length, a byte, the length, and a signature past the modulus that
# opens to a valid one. Then keys that are not keys. Then a private key
# cryptography drew, read as PKCS #1 and as PKCS #8, DER and PEM: its PKCS
# #1 v1.5 signatures byte for byte cryptography's, its PSS signatures
# checked; and private keys refused - each CRT parameter that disagrees,
# 1024 bits, more than two primes, an RSASSA-PSS key, an EC one, missing
# parameters, an encrypted key, two keys. The modes the gate script drives:
#   verify FILE   each line `spki scheme hash salt message signature`, in
#                 hex, answered `true`, `false` or `key: <why>`;
#   roots DIR     each certificate's own signature checked with its own
#                 key, where both are RSA: `name true|false|skip`;
#   sign FILE     each line `pem-file scheme hash message`, the message in
#                 hex, answered with the signature in hex or `key: <why>`;
#   time PEM N    N PSS signatures over SHA-256 with the key in PEM: the
#                 milliseconds one took.

import std/rsa::{RsaPublicKey, RsaPrivateKey, RsaHash, RsaError}
import std/asn1::{Der, DerValue, Asn1Error}
import std/big::{BigInt}
import std/base64::{Base64}
import std/dir::{Dir}
import std/file::{File}
import std/time::{Time}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def hash_named(name : String) : RsaHash
  case name
  when "SHA1"   then RsaHash::SHA1
  when "SHA256" then RsaHash::SHA256
  when "SHA384" then RsaHash::SHA384
  else               RsaHash::SHA512
  end
end

def verify(key : RsaPublicKey, scheme : String, hash : String, salt : Int32, message : Array(UInt8) | String, signature : Array(UInt8)) : Bool
  if scheme == "v15"
    key.verify_pkcs1v15(hash_named(hash), message, signature)
  else
    key.verify_pss(hash_named(hash), message, signature, salt_length: salt)
  end
end

def refused(der : String, phrase : String, label : String) : Nil
  answer = RsaPublicKey.from_spki(b(der))
  raise "ASSERTION FAILED: #{label}: accepted" unless answer.is_a?(RsaError)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

def hex(bytes : Array(UInt8)) : String
  bytes.map { |x| (x < 16_u8 ? "0" : "") + x.to_s(16) }.join("")
end

def text(bytes : Array(UInt8)) : String
  String.new(bytes.size) { |buf| buf.copy_from(bytes.to_unsafe, bytes.size) }
end

def pem(label : String, der : Array(UInt8)) : String
  body = Base64.encode(text(der))
  lines = [] of String
  at = 0
  while at < body.bytesize
    lines << body[at, 64]
    at = at + 64
  end
  "-----BEGIN #{label}-----\n#{lines.join("\n")}\n-----END #{label}-----\n"
end

def private_refused(answer : RsaPrivateKey | RsaError, phrase : String, label : String) : Nil
  raise "ASSERTION FAILED: #{label}: accepted" unless answer.is_a?(RsaError)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

# The eight numbers of an RSAPrivateKey, n first, as BigInts.
def numbers(der : Array(UInt8)) : Array(BigInt)
  fields = Der.parse(der).or_panic.sequence.or_panic
  fields[1, 8].map { |f| BigInt.from_bytes(f.unsigned_integer.or_panic) }
end

# RsaPrivateKey.new from eight numbers.
def from_numbers(v : Array(BigInt)) : RsaPrivateKey | RsaError
  bytes = v.map { |x| x.to_bytes((x.to_s(16).bytesize + 1) // 2) || [] of UInt8 }
  RsaPrivateKey.new(bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7])
end

def read_file(path : String) : Array(UInt8)
  data = File.read(path)
  Array(UInt8).new(data.bytesize) { |i| data.to_unsafe[i] }
end

# The hash a certificate's signature algorithm names, with its scheme and
# PSS salt: sha*WithRSAEncryption, or RSASSA-PSS with its parameters.
def certificate_scheme(algorithm : Array(DerValue)) : {String, String, Int32}?
  case algorithm[0].oid.or_panic
  when "1.2.840.113549.1.1.5"  then {"v15", "SHA1", -1}
  when "1.2.840.113549.1.1.11" then {"v15", "SHA256", -1}
  when "1.2.840.113549.1.1.12" then {"v15", "SHA384", -1}
  when "1.2.840.113549.1.1.13" then {"v15", "SHA512", -1}
  when "1.2.840.113549.1.1.10"
    hash = "SHA1"
    salt = 20
    algorithm[1].sequence.or_panic.each do |field|
      if field.context?(0)
        hash = case field.explicit(0).or_panic.sequence.or_panic[0].oid.or_panic
               when "2.16.840.1.101.3.4.2.1" then "SHA256"
               when "2.16.840.1.101.3.4.2.2" then "SHA384"
               when "2.16.840.1.101.3.4.2.3" then "SHA512"
               else                               "SHA1"
               end
      elsif field.context?(2)
        salt = field.explicit(2).or_panic.integer.or_panic.to_i32
      end
    end
    {"pss", hash, salt}
  else
    nil
  end
end

K2048            = ""
K1025            = ""
K2050            = ""
PSS_DEFAULT_SALT = ""
SIGNATURES       = [
  {K2048, "v15", "SHA1", -1, "abc", "", true},
  {K2048, "v15", "SHA256", -1, "abc", "", true},
  {K2048, "v15", "SHA384", -1, "abc", "", true},
  {K2048, "v15", "SHA512", -1, "abc", "", true},
  {K2048, "pss", "SHA256", 32, "abc", "", true},
  {K2048, "pss", "SHA256", 0, "abc", "", true},
  {K2048, "pss", "SHA384", 48, "abc", "", true},
  {K2048, "pss", "SHA512", 64, "abc", "", true},
  {K2048, "pss", "SHA1", 20, "abc", "", true},
  {K1025, "pss", "SHA256", 32, "abc", "009e07054f817a475956cb3339f968d2b553245d94b39f2408735e500e84d375c90e4a3f9d1c5e78b7814aa6e271d737580a9c474b55104be9446e9a7f7d37b0a210edd5f1abce6f38590f58a910f0cb5f4a64e94f4f3875141608de57db869b273d9fef1c2f93d3e71e2330f785af61032e6da6574924bd37f9f68fda9f9de014", true},
  {K1025, "v15", "SHA256", -1, "abc", "00c4ec9abc3dda530693ecf3e028dca42da2b11db7f9f481d9eb7490bebff439e30e22a360d258f82d645750a456f2481a16e525a6b093cb0bf7e4f65684bcc8dcb60c11ccfd78a04f675473ec5c9acb534d9159410fb32969263b34f30bdae0d3396a703b982e446805ac0587f5a743b862409628ad70e91968b1d4f51896afdc", true},
  {K1025, "pss", "SHA256", 32, "abc", "7a4aab89c66b8f5608ca3ac5f1522ecba26ed21544d7b439f162b88e57ffa45afdcc0ae9205525cf383fab726242291b977d136a7d2112aeea1599403fa5fc7bd42e6d10863078a858efbd5344d26984066519f00615e2a5c9cbf94e0ac51959823776321136185eb23c2e1b7cd297a617e968d2af00417d1f99355c2065ce9a", false},
  {K2048, "v15", "SHA256", -1, "abd", "", false},
  {K2048, "v15", "SHA384", -1, "abc", "", false},
  {K2048, "v15", "SHA256", -1, "abc", "", false},
  {K2048, "v15", "SHA256", -1, "abc", "", false},
  {K2048, "pss", "SHA256", 32, "abd", "", false},
  {K2048, "pss", "SHA256", 20, "abc", "", false},
  {K2048, "pss", "SHA256", 32, "abc", "", false},
  {K2048, "v15", "SHA256", -1, "abc", "", false},
  {K2048, "pss", "SHA256", 32, "abc", "", false},
  {K2050, "pss", "SHA256", 32, "abc", "", false},
  {K2050, "pss", "SHA256", 32, "abc", "", true},
  {K2048, "pss", "SHA256", 32, "abc", "", false},
  {K2048, "pss", "SHA256", 32, "abc", "", false},
  {K2048, "pss", "SHA256", 32, "abc", "", true},
  {K2048, "v15", "SHA256", -1, "abc", "", false},
  {K2048, "v15", "SHA256", -1, "abc", "", false},
  {K2048, "v15", "SHA256", -1, "abc", "", true},
]
EVEN_MODULUS          = ""
EXPONENT_ONE          = ""
EXPONENT_EVEN         = ""
EXPONENT_PAST_31_BITS = ""
SHORT_MODULUS         = ""
NO_PARAMETERS         = ""
EC_KEY                = ""
# A 2048-bit key cryptography drew (PKCS #1 DER); a 1024-bit one; its PKCS
# #1 v1.5 signatures over "abc" as cryptography made them.
PRIVATE_PKCS1  = ""
PRIVATE_1024   = ""
V15_SIGNATURES = {
  RsaHash::SHA256 => "",
  RsaHash::SHA384 => "",
  RsaHash::SHA512 => "",
}
# The PrivateKeyInfo headers around PRIVATE_PKCS1: rsaEncryption with its
# NULL, without it, id-RSASSA-PSS, and an EC key's algorithm.
PKCS8_HEADER        = "308204bd020100300d06092a864886f70d0101010500048204a7"
PKCS8_NO_PARAMETERS = "308204bb020100300b06092a864886f70d010101048204a7"
PKCS8_RSASSA_PSS    = "308204bd020100300d06092a864886f70d01010a0500048204a7"
PKCS8_EC            = "308204c3020100301306072a8648ce3d020106082a8648ce3d030107048204a7"

args = Program.args

if args.size > 0 && args[0] == "verify"
  File.read(args[1]).lines.each do |line|
    next if line.empty?
    f = line.split(' ')
    key = RsaPublicKey.from_spki(b(f[0]))
    if key.is_a?(RsaError)
      puts "key: #{key.message}"
    else
      puts verify(key, f[1], f[2], f[3].to_i, b(f[4]), b(f[5]))
    end
  end
  exit 0
end

if args.size > 0 && args[0] == "roots"
  Dir.children(args[1]).sorted.each do |name|
    cert = Der.parse(read_file(args[1] + "/" + name)).or_panic.sequence.or_panic
    tbs = cert[0].sequence.or_panic
    at = tbs[0].context?(0) ? 1 : 0
    scheme = certificate_scheme(cert[1].sequence.or_panic)
    key = RsaPublicKey.from_spki(tbs[at + 5])
    if scheme.nil? || key.is_a?(RsaError)
      puts "#{name} skip"
      next
    end
    puts "#{name} #{verify(key, scheme[0], scheme[1], scheme[2], cert[0].raw, cert[2].bit_string.or_panic)}"
  end
  exit 0
end

if args.size > 0 && args[0] == "sign"
  keys = {} of String => RsaPrivateKey | RsaError
  File.read(args[1]).lines.each do |line|
    next if line.empty?
    f = line.split(' ')
    key = keys[f[0]]? || RsaPrivateKey.from_pem(File.read(f[0]))
    keys[f[0]] = key
    if key.is_a?(RsaError)
      puts "key: #{key.message}"
    else
      message = b(f[3])
      puts hex(f[1] == "v15" ? key.sign_pkcs1v15(hash_named(f[2]), message) : key.sign_pss(hash_named(f[2]), message))
    end
  end
  exit 0
end

if args.size > 0 && args[0] == "time"
  key = RsaPrivateKey.from_pem(File.read(args[1])).or_panic
  count = args[2].to_i
  key.sign_pss(RsaHash::SHA256, "warm")
  started = Time.monotonic_nanoseconds
  count.times { |i| key.sign_pss(RsaHash::SHA256, "message #{i}") }
  took = (Time.monotonic_nanoseconds - started).to_f64 / count / 1000000.0
  puts "#{key.bits}-bit: #{(took * 100).round / 100} ms a signature"
  exit 0
end

puts "== signatures Python's cryptography made"
k2048 = RsaPublicKey.from_spki(b(K2048)).or_panic
k1025 = RsaPublicKey.from_spki(b(K1025)).or_panic
k2050 = RsaPublicKey.from_spki(b(K2050)).or_panic
check k2048.bits == 2048 && k2048.size == 256, "a 2048-bit key: #{k2048.bits} bits"
check k1025.bits == 1025 && k1025.size == 129, "a 1025-bit key: #{k1025.bits} bits"
SIGNATURES.each_with_index do |c, i|
  key = c[0] == K2048 ? k2048 : (c[0] == K2050 ? k2050 : k1025)
  got = verify(key, c[1], c[2], c[3], c[4], b(c[5]))
  check got == c[6], "signature #{i} (#{c[1]} #{c[2]} salt #{c[3]} over #{c[4].inspect}): expected #{c[6]}, got #{got}"
end
puts "  #{SIGNATURES.count { |c| c[6] }} accepted and #{SIGNATURES.count { |c| !c[6] }} refused as they should be"
check k2048.verify_pkcs1v15(RsaHash::SHA256, b("616263"), b(SIGNATURES[1][5])), "a message given as bytes"
check k2048.verify_pss(RsaHash::SHA256, "abc", b(PSS_DEFAULT_SALT)), "a PSS salt as long as the hash when none is named"
check !k2048.verify_pss(RsaHash::SHA384, "abc", b(PSS_DEFAULT_SALT)), "a PSS signature under another hash refused"

puts "== keys that are not keys"
refused EVEN_MODULUS, "even modulus", "an even modulus refused"
refused EXPONENT_ONE, "exponent under 3", "an exponent of 1 refused"
refused EXPONENT_EVEN, "even public exponent", "an even exponent refused"
refused EXPONENT_PAST_31_BITS, "past 2^31 - 1", "an exponent past 31 bits refused"
refused SHORT_MODULUS, "under the 1024", "a 1023-bit modulus refused"
refused NO_PARAMETERS, "not the NULL", "rsaEncryption without its NULL refused"
refused EC_KEY, "not rsaEncryption", "an EC key refused"
refused "020101", "expected a SEQUENCE", "an INTEGER where a key goes refused"

puts "== private keys: read, signing, and refused"
der = b(PRIVATE_PKCS1)
signer = RsaPrivateKey.from_pkcs1(der).or_panic
check signer.bits == 2048 && signer.size == 256, "a 2048-bit private key: #{signer.bits} bits"
as_pkcs8 = RsaPrivateKey.from_pkcs8(b(PKCS8_HEADER + PRIVATE_PKCS1)).or_panic
check as_pkcs8.public_key.modulus == signer.public_key.modulus, "the key read from PKCS #8 DER"
from_pem1 = RsaPrivateKey.from_pem(pem("RSA PRIVATE KEY", der)).or_panic
from_pem8 = RsaPrivateKey.from_pem(pem("PRIVATE KEY", b(PKCS8_HEADER + PRIVATE_PKCS1))).or_panic
check from_pem1.public_key.modulus == signer.public_key.modulus && from_pem8.public_key.exponent == signer.public_key.exponent, "the key read from both PEM blocks"
[RsaHash::SHA256, RsaHash::SHA384, RsaHash::SHA512].each do |hash|
  got = signer.sign_pkcs1v15(hash, "abc")
  check hex(got) == V15_SIGNATURES[hash], "PKCS #1 v1.5 over #{hash} as cryptography signs it"
  check as_pkcs8.sign_pkcs1v15(hash, b("616263")) == got, "PKCS #1 v1.5 over #{hash} the same from PKCS #8 and over bytes"
  pss = signer.sign_pss(hash, "abc")
  check signer.public_key.verify_pss(hash, "abc", pss), "a PSS signature over #{hash} checks with a salt as long as the hash"
  check !signer.public_key.verify_pss(hash, "abd", pss), "a PSS signature over #{hash} does not check for another message"
  check pss != signer.sign_pss(hash, "abd"), "PSS over #{hash}: another message, another signature"
end
puts "  PKCS #1 and PKCS #8, DER and PEM; PKCS #1 v1.5 over SHA-256, -384 and -512 byte for byte cryptography's; PSS checked"
v = numbers(der)
one = BigInt.new(1)
two = BigInt.new(2)
check !from_numbers(v).is_a?(RsaError), "the eight numbers read back as the key"
private_refused from_numbers([v[0] + two] + v[1, 7]), "p times q is not its modulus", "a modulus that is not p times q refused"
private_refused from_numbers([v[0], v[1], v[2], one, v[0]] + v[5, 3]), "p or q is not over 1", "a p of 1 refused"
private_refused from_numbers(v[0, 2] + [v[2] + two] + v[3, 5]), "d is not e's inverse modulo lcm(p - 1, q - 1)", "a d that is not e's inverse refused"
private_refused from_numbers(v[0, 5] + [v[5] + two] + v[6, 2]), "dp is not d mod (p - 1)", "a dp that is not d's residue refused"
private_refused from_numbers(v[0, 6] + [v[6] + two, v[7]]), "dq is not d mod (q - 1)", "a dq that is not d's residue refused"
private_refused from_numbers(v[0, 7] + [v[7] + one]), "qi is not the inverse of q mod p", "a qi that is not q's inverse refused"
private_refused from_numbers(v[0, 3] + [v[4], v[3], v[6], v[5], v[7]]), "qi is not the inverse of q mod p", "p and q swapped under the same qi refused"
private_refused RsaPrivateKey.from_pkcs1(b(PRIVATE_1024)), "1024 bits, under the 2048 this signs with", "a 1024-bit key refused for signing"
private_refused RsaPrivateKey.from_pkcs1(b("308204a3020101" + PRIVATE_PKCS1[14, PRIVATE_PKCS1.bytesize - 14])), "more than two primes", "a key of more than two primes refused"
private_refused RsaPrivateKey.from_pkcs8(b(PKCS8_RSASSA_PSS + PRIVATE_PKCS1)), "an RSASSA-PSS key (1.2.840.113549.1.1.10)", "an RSASSA-PSS key refused by name"
private_refused RsaPrivateKey.from_pkcs8(b(PKCS8_EC + PRIVATE_PKCS1)), "not rsaEncryption", "a key under the EC algorithm refused"
private_refused RsaPrivateKey.from_pkcs8(b(PKCS8_NO_PARAMETERS + PRIVATE_PKCS1)), "not the NULL", "a PKCS #8 key without rsaEncryption's NULL refused"
private_refused RsaPrivateKey.from_pkcs8(der), "expected a SEQUENCE", "PKCS #1 read as PKCS #8 refused"
private_refused RsaPrivateKey.from_pem("-----BEGIN ENCRYPTED PRIVATE KEY-----\nMIIB\n-----END ENCRYPTED PRIVATE KEY-----\n"), "an encrypted private key", "an encrypted key refused by name"
private_refused RsaPrivateKey.from_pem(pem("RSA PRIVATE KEY", der) + pem("PRIVATE KEY", b(PKCS8_HEADER + PRIVATE_PKCS1))), "2 blocks of RSA PRIVATE KEY or PRIVATE KEY, not one", "two keys refused"
private_refused RsaPrivateKey.from_pem(pem("PUBLIC KEY", b(K2048))), "0 blocks of RSA PRIVATE KEY or PRIVATE KEY, not one", "a public key refused"
puts "  each CRT parameter that disagrees, 1024 bits, three primes, RSASSA-PSS, EC, no NULL, encrypted, two keys and none refused"

puts "\nALL CHECKS PASSED"
