# The one dictionary — SPEC.md, "0.1.0", item 3.
#
# Two dense arrays in insertion order, keys and values, and an index over
# them: open addressing with linear probing from the key's hash to the
# position of its entry, `-1` where a slot is free. The compact layout
# Python's dictionary and Crystal's `Hash` both settled on, because
# iteration then follows the order things went in — the order a word count prints its words, and the
# order a person expects — and because the index is one array of integers
# rather than a copy of the keys. Deletion closes the gap in the dense
# arrays and rebuilds the index, which is the boring answer and the right
# one for a table that forgets an entry now and then; the sample that asked
# for it (`samples/iyi/sessions.iyi`) signs people out one at a time.
#
# Hashing is `key.hash`, defined per type in this prelude. It is deliberately
# not iyi's `Hashable` trait: that trait lives in `src/std`, which is the
# opt-in library, and a prelude that depended on it would have the dependency
# backwards.
class Hash(K, V)
  @keys : Pointer(K)
  @values : Pointer(V)
  @index : Pointer(Int32)
  @size : Int32
  # Entries the dense arrays can hold; the index holds twice as many slots,
  # so it is never more than half full and a probe always stops. Zero
  # until the first entry: a table made and never written - a trie's
  # leaves, each with children it will not have - costs no storage.
  @capacity : Int32
  # What `[]` answers for a key that is not there, when the table was made
  # with one: `Hash(String, Int32).new(0)`, or a block that is handed the
  # table and the key and may store what it answers - the counter a
  # k-nucleotide count keeps, written the other library's way.
  @default : Proc(Hash(K, V), K, V)?

  def initialize
    @size = 0
    @capacity = 0
    @keys = Pointer(K).new(0_u64)
    @values = Pointer(V).new(0_u64)
    @index = Pointer(Int32).new(0_u64)
    @default = nil
  end

  def initialize(&block : Hash(K, V), K -> V)
    initialize
    @default = block
  end

  def self.new(default : V) : Hash(K, V)
    new { |table, key| default }
  end

  def size : Int32
    @size
  end

  def empty? : Bool
    @size == 0
  end

  def []=(key : K, value : V) : V
    grow if @capacity == 0
    slot = slot_for(key)
    entry = @index[slot]
    if entry < 0
      if @size == @capacity
        # The index is rebuilt by the growth, so the key's slot is asked again.
        grow
        slot = slot_for(key)
      end
      entry = @size
      @index[slot] = entry
      @keys[entry] = key
      @size = @size + 1
    end
    @values[entry] = value
    value
  end

  def []?(key : K) : V?
    entry = entry_of(key)
    entry < 0 ? nil : @values[entry]
  end

  def [](key : K) : V
    entry = entry_of(key)
    if entry < 0
      if default = @default
        return default.call(self, key)
      end
      raise "no such key #{key.inspect}"
    end
    @values[entry]
  end

  def has_key?(key : K) : Bool
    entry_of(key) >= 0
  end

  # The value the key had, or nil. The entries after it move down one, so
  # the order of what remains is the order it went in, and the index is
  # built again over what is left — the whole table, once per deletion,
  # rather than tombstones in the index that every probe would have to
  # step over from then on.
  def delete(key : K) : V?
    entry = entry_of(key)
    return nil if entry < 0
    value = @values[entry]
    while entry + 1 < @size
      @keys[entry] = @keys[entry + 1]
      @values[entry] = @values[entry + 1]
      entry = entry + 1
    end
    @size = @size - 1
    rebuild_index
    value
  end

  # Every pair, in the order it went in.
  def each(& : K, V -> Nil) : Nil
    entry = 0
    while entry < @size
      yield @keys[entry], @values[entry]
      entry = entry + 1
    end
  end

  # Every pair as a tuple, in the order it went in - what a sort by value
  # starts from.
  def to_a : Array(Tuple(K, V))
    pairs = Array(Tuple(K, V)).new(@size)
    each { |key, value| pairs << {key, value} }
    pairs
  end

  # The keys, and the values, each in the order they went in.
  def keys : Array(K)
    result = Array(K).new(@size)
    each { |key, value| result << key }
    result
  end

  def values : Array(V)
    result = Array(V).new(@size)
    each { |key, value| result << value }
    result
  end

  # `{"a" => 1, "b" => 2}`, in insertion order, both sides inspected.
  def to_s : String
    parts = [] of String
    each { |key, value| parts << key.inspect + " => " + value.inspect }
    "{" + parts.join(", ") + "}"
  end

  def inspect : String
    to_s
  end

  # The key's entry in the dense arrays, -1 when it has none.
  private def entry_of(key : K) : Int32
    return -1 if @capacity == 0
    @index[slot_for(key)]
  end

  # The index slot this key belongs in: the one pointing at its entry, or
  # the first free one after where it hashes to.
  private def slot_for(key : K) : Int32
    mask = @capacity * 2 - 1
    slot = key.hash & mask
    while (entry = @index[slot]) >= 0 && !(@keys[entry] == key)
      slot = (slot + 1) & mask
    end
    slot
  end

  private def clear_index : Nil
    slot = 0
    while slot < @capacity * 2
      @index[slot] = -1
      slot = slot + 1
    end
  end

  # Twice the room, and the index rebuilt over the entries as they stand:
  # the dense arrays keep their order, so nothing is re-inserted.
  private def grow : Nil
    old_keys = @keys
    old_values = @values
    @capacity = @capacity == 0 ? 8 : @capacity * 2
    @keys = Pointer(K).malloc(@capacity.to_u64)
    @values = Pointer(V).malloc(@capacity.to_u64)
    @index = Pointer(Int32).malloc((@capacity * 2).to_u64)
    entry = 0
    while entry < @size
      @keys[entry] = old_keys[entry]
      @values[entry] = old_values[entry]
      entry = entry + 1
    end
    rebuild_index
  end

  # The index over the dense arrays as they stand, from nothing.
  private def rebuild_index : Nil
    clear_index
    entry = 0
    while entry < @size
      @index[slot_for(@keys[entry])] = entry
      entry = entry + 1
    end
  end
end
