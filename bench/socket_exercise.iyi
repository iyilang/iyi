# Sockets: runtime verification exercise.
#
#   ./bin/iyi run bench/socket_exercise.iyi
#   ./bin/iyi run bench/socket_exercise.iyi refused
#
# Exercised rather than asserted:
# 1. connect and accept on loopback with an ephemeral port (port 0)
# 2. a message each way (ping from client, pong from server)
# 3. short reads respecting byte limits (4 bytes, 8 bytes, 4 bytes)
# 4. closed peer detection (read returns empty string on EOF)
# 5. refused connection when target port has no listener

import std/socket
using std/socket::{IyiSocket, SocketError}

args = Program.args
if args.size > 0 && args[0] == "refused"
  probe_server = IyiSocket.listen(0)
  refused_port = probe_server.local_port
  probe_server.close
  # Attempt connection to closed port: a `SocketError`, which `or_panic`
  # turns into the panic "cannot connect to ...: connection refused"
  IyiSocket.connect("127.0.0.1", refused_port).or_panic
  __iyi_exit(0)
end

# 1. Ephemeral port bind and accept
server = IyiSocket.listen(0)
port = server.local_port
raise "local_port failed: port must be positive" if port <= 0

client = IyiSocket.connect("127.0.0.1", port).or_panic
raise "connect failed: client is closed" if client.closed?

client.write("ping from client\n")

conn = server.accept.or_panic
raise "accept failed: server connection is closed" if conn.closed?
puts "connect_accept: ok"

# 2. Message exchange each way
msg = conn.read(1024).or_panic
raise "message_exchange: server received wrong message" if msg != "ping from client\n"

conn.write("pong from server\n")
reply = client.read(1024).or_panic
raise "message_exchange: client received wrong reply" if reply != "pong from server\n"
puts "message_exchange: ok"

# 3. Short read respecting buffer limits
client.write("0123456789ABCDEF")

c1 = conn.read(4).or_panic
raise "short_read: chunk 1 size mismatch" if c1.bytesize != 4
raise "short_read: chunk 1 content mismatch" if c1 != "0123"

c2 = conn.read(8).or_panic
raise "short_read: chunk 2 size mismatch" if c2.bytesize != 8
raise "short_read: chunk 2 content mismatch" if c2 != "456789AB"

c3 = conn.read(4).or_panic
raise "short_read: chunk 3 size mismatch" if c3.bytesize != 4
raise "short_read: chunk 3 content mismatch" if c3 != "CDEF"
puts "short_read: ok"

# 4. Closed peer detection (EOF)
client.close
raise "closed_peer: client close failed" unless client.closed?

eof = conn.read(1024).or_panic
raise "closed_peer: expected empty string on EOF" if eof.bytesize != 0

conn.close
server.close
raise "closed_peer: conn close failed" unless conn.closed?
raise "closed_peer: server close failed" unless server.closed?
puts "closed_peer: ok"

# 5. A peer that went away is an answer: writing to it ends in a
#    `SocketError` that says so - not a panic, and not SIGPIPE killing the
#    process. The first writes land in the kernel's buffers; the peer's
#    reset comes back on a later one.
gone_server = IyiSocket.listen(0)
gone_client = IyiSocket.connect("127.0.0.1", gone_server.local_port).or_panic
gone_conn = gone_server.accept.or_panic
gone_client.close
chunk = "x" * 65536
tries = 0
wrote = gone_conn.write(chunk)
while wrote.is_a?(Int32)
  tries = tries + 1
  raise "disconnect: #{tries} writes to a closed peer all went through" if tries > 2000
  wrote = gone_conn.write(chunk)
end
raise "disconnect: expected a SocketError, got #{wrote.inspect}" unless wrote.is_a?(SocketError)
raise "disconnect: #{wrote.message} is not a disconnect" unless wrote.disconnected?
gone_conn.close
gone_server.close
puts "disconnect: ok (#{wrote.message})"

# 6. A connect nobody answers is refused as a value.
refusing = IyiSocket.listen(0)
refused_port = refusing.local_port
refusing.close
refused = IyiSocket.connect("127.0.0.1", refused_port)
raise "refused: expected a SocketError, got #{refused.inspect}" unless refused.is_a?(SocketError)
raise "refused: #{refused.message}" unless refused.message.includes?("connection refused")
puts "refused: ok (#{refused.message})"

# 7. One fiber reading and another writing the same socket, both parked
#    at once: the write fills the kernel's buffers while nobody reads
#    them, the read waits for bytes nobody has sent, and each is woken by
#    its own half of the socket.
duplex_server = IyiSocket.listen(0)
duplex_client = IyiSocket.connect("127.0.0.1", duplex_server.local_port).or_panic
duplex_conn = duplex_server.accept.or_panic
payload = "y" * 8388608
heard = ""
sent = 0
received = 0
group do |g|
  g.spawn do
    heard = duplex_conn.read(16).or_panic
    0
  end
  g.spawn do
    sent = duplex_conn.write(payload).or_panic
    0
  end
  g.spawn do
    sleep(50)
    duplex_client.write("ping").or_panic
    while received < payload.bytesize
      got = duplex_client.read(65536).or_panic
      break if got.bytesize == 0
      received = received + got.bytesize
    end
    0
  end
end
raise "duplex: the reader heard #{heard.inspect}" unless heard == "ping"
raise "duplex: the writer sent #{sent} of #{payload.bytesize}" unless sent == payload.bytesize
raise "duplex: the peer received #{received}" unless received == payload.bytesize
duplex_client.close
duplex_conn.close
duplex_server.close
puts "duplex: ok"

# 5. A read parks rather than blocks, and a cancelled task's read answers
#    `Cancelled` (SPEC.md III.4.2). Three tasks on one thread: a reader
#    parked on a connection nobody writes to, a sibling that answers an
#    error and so cancels the group, and a listener that accepts. If the
#    read blocked the thread, the sibling could never run and the group
#    could never cancel anything: the program would hang here.
struct Boom
end

impl Error for Boom
  def message : String
    "boom"
  end
end

listener = IyiSocket.listen(0)
quiet_port = listener.local_port
parked_answer = ""
held = [] of IyiSocket
group do |g|
  g.spawn do
    case peer = IyiSocket.connect("127.0.0.1", quiet_port)
    in Cancelled
      parked_answer = "connect cancelled"
    in SocketError
      parked_answer = peer.message
    in IyiSocket
      case answer = peer.read(16)
      in Cancelled
        parked_answer = "cancelled"
      in SocketError
        parked_answer = answer.message
      in String
        parked_answer = "read"
      end
      peer.close
    end
    0
  end
  g.spawn do
    # Accepted and kept open, so the peer's read has nothing to read.
    accepted = listener.accept
    held << accepted if accepted.is_a?(IyiSocket)
    0
  end
  g.spawn do
    sleep(20)
    Boom.new
  end
end
held.each { |h| h.close }
listener.close
raise "parked read: expected cancelled, got #{parked_answer.inspect}" unless parked_answer == "cancelled"
puts "parked_read_cancelled: ok"

puts "socket_exercise: all checks passed"
