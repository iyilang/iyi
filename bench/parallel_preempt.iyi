# Preemption at loop back-edges, exercised: SPEC.md III.4.13, part 9.
#
#   ./bin/iyi run bench/parallel_preempt.iyi -- slice --workers=1
#   ./bin/iyi run bench/parallel_preempt.iyi -- server --workers=8
#
# A parallel task computing in a loop with no call in it held its worker
# until it ended: a task queued behind it waited for the whole computation,
# and so did whatever waited in that worker's poller and sleep heap - the
# connection whose request had arrived, the sleeper whose time had come.
# Every loop of a program with a pool now checks the worker's preemption
# word at its back-edge, and the pool's monitor raises the word of a worker
# one task has held for a quantum, 5 to 10 ms.
#
#   slice   a task computing a second - a xorshift walk, and then a sum the
#           compiler vectorises - on a pool of one, and a short task spawned
#           20 ms into it, which starts within 100 ms; the computation's
#           answer is the one an unpreempted walk gives. Under
#           `-Dpreempt_off` the walk is a `@[NoPreempt]` def's, and the
#           short task waits for the second.
#   unit    a preempted task keeps its unit's token: a task `spawn` started
#           inside it never runs between two of its statements that are not
#           a park, while another parallel task's ticker, asleep on the
#           same worker, wakes within 100 ms of its time.
#   server  28 connections making 0.2 ms requests beside 4 making 100 ms
#           ones: a fast request whose connection waits in the poller of a
#           worker busy with a slow one is answered within 80 ms, where it
#           waited the 100 ms out before.
#   poller  the server shape's claim with its window held: one connection
#           waits in the poller of the pool's one worker while that worker
#           computes a request that runs until the connection's own request
#           is answered, or a second has passed; the answer comes within
#           80 ms. A slow half that does not poll answers it at the second.
#   fresh   a task switched in after one that held its worker 30 ms with
#           no check in its loop, on a pool of one, runs its first
#           millisecond without giving the worker up, beside a task queued
#           behind it: the word the monitor raised for the one before is
#           not its. With the word left up it gave the worker up at its
#           first back-edge.
#   period  the monitor's period, its looks over a task computing on a pool
#           of one, held to 4 to 10.5 ms (8 on Windows) over the windows
#           where a thread's 5 ms sleeps took at most that bound
#           less 1.5 ms; and the quantum, two such tasks taking turns
#           on the one worker, held to three looks a turn. A Windows
#           monitor waiting on the system timer's tick (10.1 to 14.3 ms
#           apart in 56 runs on GitHub's runners) fails the first, as does
#           a monitor ticking every 12 ms, and a monitor that waits three
#           looks unchanged rather than one the second.
#   tight   what the check costs a tight loop: four loops timed against
#           `@[NoPreempt]` twins of themselves, interleaved, best of seven,
#           each ratio held to 2x.
#
# With no arguments it runs slice, unit and period on a pool of one and
# prints only that every property held: the slice step's short task must
# wait for a preemption, which a second, idle worker would make needless.
#
# bench/parallel_exercise.sh runs it, and broken copies of the runtime,
# each caught by the step that names it.

@[Unsafe("the loops read arrays through unsafe_fetch, each index kept in 0...size by the loop that makes it; on Windows the period step's sleeper waits on a timer of its own through Windows' timer functions, C calls with a pointerof answer")]
module bench/parallel_preempt

import std/int
import std/indexable
import std/socket::{IyiSocket, SocketError}

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  def elapsed_ms(since : Int64) : Int64
    (__iyi_monotonic_ns - since) // 1000000_i64
  end

  # A step's measurements, printed when steps were asked for by name: a run
  # with no arguments says only that every property held.
  def say(line : String) : Nil
    puts line unless Program.args.empty?
  end

  # Integer work with nothing to allocate and no call in its loop: a
  # xorshift walk. It and the tight step's other loops, and their twins, are
  # `@[NoInline]`: bench/parallel_exercise.sh reads the checks of each in
  # the release build's IR by the def's name, which inlined into the step's
  # block it would not have.
  @[NoInline]
  def spin(rounds : Int64, seed : UInt64) : UInt64
    x = seed | 1_u64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      i = i + 1
    end
    x
  end

  # The same walk, never preempted.
  @[NoInline]
  @[NoPreempt]
  def spin_np(rounds : Int64, seed : UInt64) : UInt64
    x = seed | 1_u64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      i = i + 1
    end
    x
  end

  # The walk the slice step's long task takes: preempted, or under
  # `-Dpreempt_off` not.
  def long_walk(rounds : Int64, seed : UInt64) : UInt64
    {% if flag?(:preempt_off) %}
      spin_np(rounds, seed)
    {% else %}
      spin(rounds, seed)
    {% end %}
  end

  # A sum LLVM vectorises, and its twin.
  @[NoInline]
  def sum(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    t = 0
    while t < times
      i = 0
      size = values.size
      while i < size
        total = total &+ values.unsafe_fetch(i)
        i = i + 1
      end
      t = t + 1
    end
    total
  end

  @[NoInline]
  @[NoPreempt]
  def sum_np(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    t = 0
    while t < times
      i = 0
      size = values.size
      while i < size
        total = total &+ values.unsafe_fetch(i)
        i = i + 1
      end
      t = t + 1
    end
    total
  end

  # The same sum through `times` and `each`, whose loops are the prelude's
  # and check because they are inlined into this def.
  @[NoInline]
  def sum_each(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    times.times do
      values.each { |v| total = total &+ v }
    end
    total
  end

  @[NoInline]
  @[NoPreempt]
  def sum_each_np(values : Array(Int64), times : Int32) : Int64
    total = 0_i64
    times.times do
      values.each { |v| total = total &+ v }
    end
    total
  end

  # A table-driven CRC-32, a loop of dependent loads.
  @[NoInline]
  def crc(table : Array(UInt32), data : Array(UInt8), times : Int32) : UInt32
    c = 0xFFFFFFFF_u32
    t = 0
    while t < times
      i = 0
      size = data.size
      while i < size
        c = table.unsafe_fetch(((c ^ data.unsafe_fetch(i).to_u32) & 0xFF_u32).to_i32) ^ c.unsafe_shr(8_u32)
        i = i + 1
      end
      t = t + 1
    end
    c ^ 0xFFFFFFFF_u32
  end

  @[NoInline]
  @[NoPreempt]
  def crc_np(table : Array(UInt32), data : Array(UInt8), times : Int32) : UInt32
    c = 0xFFFFFFFF_u32
    t = 0
    while t < times
      i = 0
      size = data.size
      while i < size
        c = table.unsafe_fetch(((c ^ data.unsafe_fetch(i).to_u32) & 0xFF_u32).to_i32) ^ c.unsafe_shr(8_u32)
        i = i + 1
      end
      t = t + 1
    end
    c ^ 0xFFFFFFFF_u32
  end

  def crc_table : Array(UInt32)
    table = Array(UInt32).new(256, 0_u32)
    n = 0
    while n < 256
      c = n.to_u32
      k = 0
      while k < 8
        c = (c & 1_u32) != 0_u32 ? (0xEDB88320_u32 ^ c.unsafe_shr(1_u32)) : c.unsafe_shr(1_u32)
        k = k + 1
      end
      table[n] = c
      n = n + 1
    end
    table
  end

  # Walk rounds a millisecond on this machine, on the main thread.
  def calibrate : Int64
    t = __iyi_monotonic_ns
    x = spin_np(50_000_000_i64, 3_u64)
    ms = elapsed_ms(t)
    ms = ms + 1_i64 if x == 0_u64
    50_000_000_i64 // (ms > 0_i64 ? ms : 1_i64)
  end

  # Latencies the tasks record: `Share` by their atomic fields.
  class Stat
    @max : Atomic(Int64)
    @count : Atomic(Int64)
    @over20 : Atomic(Int64)

    def initialize
      @max = Atomic(Int64).new(0_i64)
      @count = Atomic(Int64).new(0_i64)
      @over20 = Atomic(Int64).new(0_i64)
    end

    def add(us : Int64) : Nil
      @count.add(1_i64)
      @over20.add(1_i64) if us > 20000_i64
      while true
        m = @max.get
        break if us <= m
        break if @max.compare_and_set(m, us)[1]
      end
    end

    def max_ms : Int64
      @max.get // 1000_i64
    end

    def count : Int64
      @count.get
    end

    def over20 : Int64
      @over20.get
    end
  end

  # ── slice ────────────────────────────────────────────────────────────
  # A pool of one worker, a task computing a second on it, and a short task
  # spawned 20 ms in: it waits in the pool's queue until the long task
  # gives the worker up at a back-edge. `which` is the walk or the sum.
  BOUND_MS = 100_i64

  def slice_round(which : String, per_ms : Int64) : Nil
    started = Atomic(Int64).new(0_i64)
    waited = Atomic(Int64).new(-1_i64)
    answer = Atomic(UInt64).new(0_u64)
    walk = 1000_i64 * per_ms
    preempts = IyiWorkers.preempts
    group do |g|
      g.spawn(unit: :new) do
        if which == "walk"
          started.set(__iyi_monotonic_ns)
          answer.set(long_walk(walk, 5_u64))
        else
          values = Array(Int64).new(1_000_000) { |i| i.to_i64 * 3_i64 }
          t = __iyi_monotonic_ns
          once = sum_np(values, 10) // 10_i64
          pass_ns = (__iyi_monotonic_ns - t) // 10_i64
          times = (1_000_000_000_i64 // (pass_ns > 0_i64 ? pass_ns : 1_i64)).to_i32
          times = 20000 if times > 20000
          started.set(__iyi_monotonic_ns)
          answer.set((sum(values, times) &- once &* times.to_i64).to_u64)
        end
        0
      end
      while started.get == 0_i64
        sleep(1)
      end
      sleep(20)
      asked = __iyi_monotonic_ns
      g.spawn(unit: :new) do
        waited.set(elapsed_ms(asked))
        0
      end
    end
    ms = waited.get
    if ms > BOUND_MS
      fail("slice: a short task waited #{ms} ms behind a task computing a #{which} on its one worker, past #{BOUND_MS} ms")
    end
    want = which == "walk" ? spin_np(walk, 5_u64) : 0_u64
    if answer.get != want
      fail("slice: the preempted #{which} answered #{answer.get}, and unpreempted it answers #{want}")
    end
    given = IyiWorkers.preempts - preempts
    fail("slice: the short task started and no task was preempted") if given == 0_u64
    say "slice: a short task spawned 20 ms into a task computing a #{which} on a pool of one started #{ms} ms later (#{given} preemptions); the #{which}'s answer is the unpreempted one"
  end

  def slice(per_ms : Int64) : Nil
    slice_round("walk", per_ms)
    slice_round("sum", per_ms)
  end

  # ── unit ─────────────────────────────────────────────────────────────
  # A parallel task computes 300 ms on a pool of one while a task it
  # spawned sleeps 1 ms and counts, and another parallel task's ticker
  # sleeps 1 ms and measures how late it woke. The ticker is what the
  # computing task is preempted for; its child, of the same unit, must not
  # run until the computation ends, and the count it moves is read on both
  # sides of the computation.
  def unit(per_ms : Int64) : Nil
    late = Stat.new
    moved = Atomic(Int64).new(-1_i64)
    done = Atomic(Int64).new(0_i64)
    preempts = IyiWorkers.preempts
    group do |g|
      g.spawn(unit: :new) do
        count = Atomic(Int64).new(0_i64)
        group do |inner|
          inner.spawn do
            while done.get == 0_i64
              sleep(1)
              count.add(1_i64)
            end
            0
          end
          sleep(5)
          before = count.get
          # The walk's answer is kept, or an optimised build drops the
          # walk: it has no effect but its answer.
          walked = spin(300_i64 * per_ms, 7_u64)
          moved.set(count.get - before + (walked == 0_u64 ? 1_i64 : 0_i64))
          done.set(1_i64)
        end
        0
      end
      g.spawn(unit: :new) do
        while done.get == 0_i64
          s = __iyi_monotonic_ns
          sleep(1)
          late.add((__iyi_monotonic_ns - s) // 1000_i64 - 1000_i64)
        end
        0
      end
    end
    given = IyiWorkers.preempts - preempts
    fail("unit: the computing task was never preempted for the ticker beside it") if given == 0_u64
    if moved.get != 0_i64
      fail("unit: a task of the same unit ran #{moved.get} times between two statements of a preempted task")
    end
    if late.max_ms > BOUND_MS
      fail("unit: a ticker asleep on the worker of a computing task woke #{late.max_ms} ms late, past #{BOUND_MS} ms")
    end
    say "unit: a task preempted #{given} times kept its unit's token, and its child ran only after it; the ticker beside it woke at most #{late.max_ms} ms late over #{late.count} sleeps"
  end

  # ── server ───────────────────────────────────────────────────────────
  FAST_BOUND_MS = 80_i64

  def server(per_ms : Int64) : Nil
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    conns = 32
    fast = Stat.new
    slow = Stat.new
    group do |g|
      g.spawn do
        conns.times do
          client = listener.accept
          fail("server: accept answered #{client}") unless client.is_a?(IyiSocket)
          fd = client.fd
          family = client.family
          g.spawn(unit: :new) do
            socket = IyiSocket.new(fd, family)
            while true
              got = socket.read(64)
              break unless got.is_a?(String) && !got.empty?
              cost = got.starts_with?("b") ? 100_i64 * per_ms : per_ms // 5_i64
              x = spin(cost, 5_u64)
              socket.write(x == 0_u64 ? "K" : "k")
            end
            socket.close
            0
          end
        end
        0
      end
      clients = [] of IyiSocket
      conns.times do
        c = IyiSocket.connect("127.0.0.1", port, 5000)
        fail("server: connect answered #{c}") unless c.is_a?(IyiSocket)
        clients << c
      end
      group do |cg|
        conns.times do |i|
          c = clients[i]
          cg.spawn do
            heavy = i < 4
            rounds = heavy ? 10 : 400
            rounds.times do
              s = __iyi_monotonic_ns
              c.write(heavy ? "b" : "c")
              c.read(8)
              us = (__iyi_monotonic_ns - s) // 1000_i64
              if heavy
                slow.add(us)
              else
                fast.add(us)
              end
              sleep(1) unless heavy
            end
            0
          end
        end
      end
      clients.each(&.close)
    end
    if fast.max_ms > FAST_BOUND_MS
      fail("server: a fast request took #{fast.max_ms} ms beside the 100 ms ones, past #{FAST_BOUND_MS} ms (#{fast.over20} of #{fast.count} over 20 ms)")
    end
    say "server: 28 connections of 0.2 ms requests beside 4 of 100 ms on #{IyiWorkers.count} workers: the slowest fast request took #{fast.max_ms} ms, #{fast.over20} of #{fast.count} over 20 ms; the slow ones at most #{slow.max_ms} ms"
  end

  # ── poller ───────────────────────────────────────────────────────────
  # The server shape's claim, held open rather than met by chance. There a
  # fast request waits in a busy worker's poller only when its connection
  # happened to park on the worker a slow request then landed on, and the
  # wait is what was left of that request's 100 ms: the copy whose slow
  # half does not poll read 76 to 141 ms in eight runs on macOS 26.6,
  # Apple M2 Pro, 10 cores (the user's machine), three of them under the
  # 80 ms bound. Here one worker and two connections make it certain: a
  # fast connection's server has answered once and parked on its next
  # read in the worker's poller, the worker takes the slow connection's
  # request, and that request computes until the fast one has been
  # answered, or POLLER_HOLD_MS if it never is. The fast request is sent
  # once the slow one is computing, and the worker holds nothing else, so
  # only the back-edge's poll hands it on: answered within FAST_BOUND_MS,
  # or at POLLER_HOLD_MS. The M2 answered in 11.1 to 11.2 ms over ten
  # runs, and the copy at 999 ms in five of five.
  POLLER_HOLD_MS = 1000_i64

  def poller(per_ms : Int64) : Nil
    fail("poller: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    computing = Atomic(Int64).new(0_i64)
    answered = Atomic(Int64).new(0_i64)
    took_us = 0_i64
    group do |g|
      g.spawn do
        2.times do
          client = listener.accept
          fail("poller: accept answered #{client}") unless client.is_a?(IyiSocket)
          fd = client.fd
          family = client.family
          g.spawn(unit: :new) do
            socket = IyiSocket.new(fd, family)
            while true
              got = socket.read(64)
              break unless got.is_a?(String) && !got.empty?
              x = spin(per_ms // 5_i64, 5_u64)
              if got.starts_with?("b")
                computing.set(1_i64)
                since = __iyi_monotonic_ns
                while answered.get == 0_i64 && elapsed_ms(since) < POLLER_HOLD_MS
                  x = spin(per_ms, x)
                end
              end
              socket.write(x == 0_u64 ? "K" : "k")
            end
            socket.close
            0
          end
        end
        0
      end
      slow = IyiSocket.connect("127.0.0.1", port, 5000)
      fail("poller: connect answered #{slow}") unless slow.is_a?(IyiSocket)
      fast = IyiSocket.connect("127.0.0.1", port, 5000)
      fail("poller: connect answered #{fast}") unless fast.is_a?(IyiSocket)
      fast.write("c")
      fast.read(8)
      slow.write("b")
      while computing.get == 0_i64
        sleep(1)
      end
      s = __iyi_monotonic_ns
      fast.write("c")
      fast.read(8)
      took_us = (__iyi_monotonic_ns - s) // 1000_i64
      answered.set(1_i64)
      slow.read(8)
      slow.close
      fast.close
    end
    if took_us // 1000_i64 > FAST_BOUND_MS
      fail("poller: a fast request took #{took_us // 1000_i64} ms, its connection in the poller of the one worker while that worker computed, past #{FAST_BOUND_MS} ms")
    end
    say "poller: a fast request whose connection waited in the poller of the one worker, busy computing, was answered in #{took_us} us"
  end

  # ── fresh ────────────────────────────────────────────────────────────
  # A task switched in begins a quantum of its own. On a pool of one, a
  # task holds the worker FRESH_HOLD_MS with no check in its loop, across
  # the monitor's looks, so the worker's word is raised, and ends; the
  # task queued behind it computes a millisecond in FRESH_SLICES slices,
  # with a third queued behind it for a give-up to hand the worker to.
  # Raised for that second task, the word comes only once the monitor has
  # seen the switch count stand from one look to the next, never under
  # PERIOD_FLOOR_US into its run; a give-up sooner is on the word left up
  # for the task before. In the server shape that word gave a fast
  # request's task up behind every preempted slow one
  # (`IyiScheduler.switch_to`).
  #
  # The monitor's time is the wall clock's, and a kernel that holds the
  # worker's thread off its core spends it: on Linux, 12 vCPUs at a load
  # of 6 to 12, a round gave the worker up 508 us after the task's first
  # statement, the word raised while the thread waited for a core. The
  # switch is between the task before's last statement and this one's
  # first, and the give-up is in the slice the preemption count moved
  # in, so the run up to it is at least that slice's start less the
  # task's first statement, and at most that slice's end less the task
  # before's last. Under the floor at most is a give-up on the stale word
  # whatever the kernel did. Under it at least, but not at most, it is
  # one too where the thread's CPU time (`thread_cpu_ns`) says the kernel
  # held it off its core across those two windows for less than the
  # floor's remainder; a round where the kernel held it off longer cannot
  # tell the word's time from the kernel's, and is run again, up to
  # FRESH_TRIES rounds for FRESH_ROUNDS judged, each failing by itself.
  # Windows, whose thread times move on the system timer's tick, too
  # coarse for this, judges every round by its first statement.
  FRESH_ROUNDS  = 10
  FRESH_TRIES   = 50
  FRESH_HOLD_MS = 30_i64
  FRESH_SLICES  = 20
  {% if flag?(:linux) || flag?(:darwin) %}
    THREAD_CLOCK = true
  {% else %}
    THREAD_CLOCK = false
  {% end %}

  # The CPU time of the thread this runs on, in nanoseconds, which stands
  # still while the kernel holds it off its core; 0 where there is no
  # clock for it fine enough (`THREAD_CLOCK`).
  def thread_cpu_ns : Int64
    {% if flag?(:linux) %}
      IyiClock.read(3).to_i64
    {% elsif flag?(:darwin) %}
      LibC.clock_gettime_nsec_np(16).to_i64
    {% else %}
      0_i64
    {% end %}
  end

  # One round: how far into its run the task switched in gave the worker
  # up, at least and at most, and how long the kernel held its thread off
  # its core in the two windows between those, in microseconds; -1 for
  # each if it ran its millisecond through.
  def fresh_round(per_ms : Int64) : Tuple(Int64, Int64, Int64)
    held_wall = Atomic(Int64).new(0_i64)
    held_cpu = Atomic(Int64).new(0_i64)
    least = Atomic(Int64).new(-1_i64)
    most = Atomic(Int64).new(-1_i64)
    off = Atomic(Int64).new(-1_i64)
    group do |g|
      g.spawn(unit: :new) do
        x = spin_np(FRESH_HOLD_MS * per_ms, 17_u64)
        held_wall.set(__iyi_monotonic_ns)
        held_cpu.set(thread_cpu_ns)
        x == 0_u64 ? 1 : 0
      end
      g.spawn(unit: :new) do
        start_cpu = thread_cpu_ns
        start = __iyi_monotonic_ns
        before = IyiWorkers.preempts
        x = 19_u64
        FRESH_SLICES.times do
          at = __iyi_monotonic_ns
          at_cpu = thread_cpu_ns
          x = spin(per_ms // FRESH_SLICES.to_i64, x)
          if least.get < 0_i64 && IyiWorkers.preempts != before
            ended_cpu = thread_cpu_ns
            ended = __iyi_monotonic_ns
            least.set((at - start) // 1000_i64)
            most.set((ended - held_wall.get) // 1000_i64)
            off.set(((start - held_wall.get) - (start_cpu - held_cpu.get) + (ended - at) - (ended_cpu - at_cpu)) // 1000_i64)
          end
        end
        x == 0_u64 ? 1 : 0
      end
      g.spawn(unit: :new) do
        0
      end
    end
    {least.get, most.get, off.get}
  end

  def fresh(per_ms : Int64) : Nil
    fail("fresh: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    preempts = IyiWorkers.preempts
    judged = 0
    set_aside = 0
    round = 0
    while judged < FRESH_ROUNDS
      if round == FRESH_TRIES
        fail("fresh: #{set_aside} of #{round} rounds gave the worker up only after the kernel held its thread off its core across the switch or the give-up, leaving #{judged} to judge")
      end
      round += 1
      gave, most, off = fresh_round(per_ms)
      if gave < 0_i64 || gave >= PERIOD_FLOOR_US
        judged += 1
      elsif most < PERIOD_FLOOR_US
        fail("fresh: round #{round}: a task switched in after one that held its worker #{FRESH_HOLD_MS} ms with no check gave the worker up within #{most} us of that task's end, under the monitor's #{PERIOD_FLOOR_US} us")
      elsif THREAD_CLOCK && gave + off >= PERIOD_FLOOR_US
        set_aside += 1
      else
        held = THREAD_CLOCK ? ", the kernel holding its thread off its core #{off} us of the #{most - gave} around the switch and the give-up" : ""
        fail("fresh: round #{round}: a task switched in after one that held its worker #{FRESH_HOLD_MS} ms with no check gave the worker up #{gave} us into its run, under the monitor's #{PERIOD_FLOOR_US} us#{held}")
      end
    end
    given = IyiWorkers.preempts - preempts
    aside = set_aside > 0 ? "; #{set_aside} more set aside, the kernel holding the worker's thread off its core across the switch or the give-up" : ""
    say "fresh: a task switched in after one that held its worker #{FRESH_HOLD_MS} ms with no check ran its first ms through, #{FRESH_ROUNDS} rounds (#{given} preemptions)#{aside}"
  end

  # ── period ───────────────────────────────────────────────────────────
  # The monitor's period, and the quantum it makes. A task computing on a
  # pool of one, and the monitor's looks over it: every look is a tick,
  # PREEMPT_TICK_MS apart. Then two such tasks on the one worker, which
  # take turns: the looks over the turns they took are the quantum, two
  # once each look after a turn sees the count move and the next sees it
  # stand. Linux, darwin and Windows looked every 5.1 to 6.3 ms and took
  # turns of 10.2 to 12.3 ms on the machines measured (SPEC.md III.4.13);
  # a Windows wait that ends on the system timer's tick looked every 11.2
  # to 12.3 ms there, and a wait that ends at once would spin the monitor.
  #
  # The look's bound sits between the two. darwin's three-core runners,
  # sharing their cores with the task the monitor watches, looked every
  # 6.3, 8.9 and 9.0 ms in three CI runs (the last, job 122004173378, past
  # the 9 ms this bound was), and 7.1 to 8.9 ms in the 7 runs of macos-15
  # in CI's logs. Windows' looks end on a high-resolution timer: its
  # runners read 5.14 to 5.42 ms in 101 runs. The timer-tick copy read
  # 10.6 to 14.3 ms in 36, and in job 124885593140 came under 10.5: it
  # passed the look and was caught only by the 20 ms the turn was then
  # held to, at turns of 20845 us, about two of its looks. It read 10.1 to
  # 13.1 ms in 20 runs of debug jobs 124913849506 and 124922160886, where
  # the real looks read 5.15 to 5.30. So on Windows the bound is 8 ms,
  # half again the slowest real look and under four fifths of the copy's
  # quickest.
  #
  # A look comes when the kernel wakes the monitor's thread from its
  # timer, and a host that wakes every such thread late makes a slow tick
  # of a sound one: a windows-2025 runner took 1.08 s over the half second
  # the task was to compute, and its monitor looked every 8206 us (CI job
  # 135466663176). So while the task computes, a thread of its own (the
  # sleeper, `sleep_windows`) sleeps PERIOD_SLEEP_MS, the tick the monitor
  # is held to, PERIOD_SLEEPS times a window, and only the windows whose
  # sleeps took PERIOD_ON_TIME_US or less on average are judged, until
  # PERIOD_JUDGED_US of them have been - the 80 looks the half second gave
  # - or PERIOD_GIVE_UP_MS has passed, which fails with the sleeps'
  # spread: there the host wakes no sleeper on time, and a monitor's tick
  # cannot be told from the host's lateness. Windows 11, 12 logical
  # processors (the user's machine), held to 4 beside 8 busy loops, is
  # such a host: its windows' sleeps took 8.0 to 13.0 ms, and the step
  # failed so for the sound runtime and the timer-tick copy alike, 3 runs
  # each. In a judged window a sound monitor looks about as soon as the
  # sleeper wakes, so the windows' bound is the look's less 1.5 ms; a
  # monitor waiting for the system timer's tick, or ticking slower, looks
  # no sooner for the host's waking threads on time. In 20 runs each
  # there, the monitor's looks over the judged windows read 5.1 to 6.4 ms
  # idle (beside other jobs), 6.0 to 6.2 held to 4 beside 4 busy loops,
  # and 6.0 to 6.2 beside 12 on its 12; the timer-tick copy's 15.0 to
  # 16.6, and a copy ticking every 12 ms 12.3 to 14.6. The Mac (macOS
  # 26.6, M2 Pro, 10 cores) looked every 6.1 to 6.5 ms idle, beside 10
  # busy loops and beside 20, its sleeps 5.7 to 7.2, the 12 ms copy 13.4
  # to 14.5; Linux 5.1 to 5.2 idle and beside 4 or 8 busy loops on 4
  # vCPUs, the 12 ms copy 11.9 to 12.5.
  #
  # The quantum is two looks wherever the looks are, so it is held to
  # QUANTUM_LOOKS looks a turn, counted over the turns themselves
  # (`take_turns`), not to a time a slow runner's looks stretch it
  # towards: Windows took 1.91 to 2.09 looks a turn in those 101 runs,
  # and darwin 1.52 to 2.52 in 15 on macos-14 and macos-15, where looks of
  # up to 8.9 ms made turns of up to 17.2 ms, 2.8 ms under the 20 ms the
  # turn was held to. In the debug jobs, macos-15 took 1.61 to 2.25 looks
  # a turn in 44 runs (124913849625 and 124922160678) and windows-2025
  # 1.94 to 2.03 in 40. Counted over all the turns, a kernel holding the
  # worker's thread off its core at a turn's end added looks to it: the
  # Mac beside 20 busy loops, or 10 and another job's, took up to 3.04
  # looks a turn and failed 1 run of 25. Counted over the turns whose ends
  # found the thread on its core, QUANTUM_TURNS of them, every machine
  # above took 1.95 to 2.00 in every run, idle and beside its busy loops.
  # A monitor that raises the word after three unchanged looks rather than
  # one takes four looks a turn, 3.87 to 4.00 there, and fails it.
  PERIOD_FLOOR_US   =  4000_i64
  {% if flag?(:win32) %}
    PERIOD_BOUND_US = 8000_i64
  {% else %}
    PERIOD_BOUND_US = 10500_i64
  {% end %}
  QUANTUM_LOOKS     =     3_i64
  QUANTUM_TURNS     =    40_i64
  QUANTUM_OFF_US    =  1000_i64
  PERIOD_SLEEP_MS   =     5
  PERIOD_SLEEPS     =    10
  PERIOD_ON_TIME_US = PERIOD_BOUND_US - 1500_i64
  PERIOD_JUDGED_US  = 400_000_i64
  PERIOD_GIVE_UP_MS = 20_000_i64

  # What the period step's sleeper saw, window by window: `Share` by its
  # atomic fields.
  class Sleeps
    getter windows : Atomic(Int64)
    getter judged : Atomic(Int64)
    getter judged_us : Atomic(Int64)
    getter looks : Atomic(Int64)
    getter least : Atomic(Int64)
    getter median : Atomic(Int64)
    getter most : Atomic(Int64)

    def initialize
      @windows = Atomic(Int64).new(0_i64)
      @judged = Atomic(Int64).new(0_i64)
      @judged_us = Atomic(Int64).new(0_i64)
      @looks = Atomic(Int64).new(0_i64)
      @least = Atomic(Int64).new(0_i64)
      @median = Atomic(Int64).new(0_i64)
      @most = Atomic(Int64).new(0_i64)
    end
  end

  # The sleeper: a thread of its own that sleeps PERIOD_SLEEP_MS at a
  # time, PERIOD_SLEEPS times a window, and counts the monitor's looks over
  # each window whose sleeps took PERIOD_ON_TIME_US or less on average,
  # until PERIOD_JUDGED_US of those or PERIOD_GIVE_UP_MS. It waits as the
  # monitor does: on Windows on a high-resolution waitable timer of its
  # own. The runtime's `sleep` waits on the completion port instead, and
  # beside 12 busy loops on Windows 11's 12 logical processors the main
  # thread's 5 ms sleeps took 11 to 48 ms, 10 runs in 10, while the
  # monitor looked every 6.1 to 6.4 ms and this timer woke at 5.9 to 7.0.
  def sleep_windows(sleeps : Sleeps) : Nil
    {% if flag?(:win32) %}
      timer = LibC.CreateWaitableTimerExW(Pointer(Void).new(0_u64), Pointer(UInt16).new(0_u64), 2_i32, 0x1F0003_i32)
      fail("period: no high-resolution waitable timer here for the sleeper") if timer.address == 0_u64
      due = 0_i64 - PERIOD_SLEEP_MS.to_i64 * 10000_i64
    {% end %}
    means = [] of Int64
    judged_us = 0_i64
    began = __iyi_monotonic_ns
    while judged_us < PERIOD_JUDGED_US && elapsed_ms(began) < PERIOD_GIVE_UP_MS
      t = __iyi_monotonic_ns
      before = IyiWorkers.looks
      PERIOD_SLEEPS.times do
        {% if flag?(:win32) %}
          LibC.SetWaitableTimer(timer, pointerof(due), 0_i32, Pointer(Void).new(0_u64), Pointer(Void).new(0_u64), 0_i32)
          LibC.WaitForSingleObject(timer, -1_i32)
        {% else %}
          sleep(PERIOD_SLEEP_MS)
        {% end %}
      end
      us = (__iyi_monotonic_ns - t) // 1000_i64
      looked = (IyiWorkers.looks - before).to_i64
      means << us // PERIOD_SLEEPS.to_i64
      if us // PERIOD_SLEEPS.to_i64 <= PERIOD_ON_TIME_US
        judged_us += us
        sleeps.judged.add(1_i64)
        sleeps.looks.add(looked)
      end
    end
    {% if flag?(:win32) %}
      LibC.CloseHandle(timer)
    {% end %}
    means.sort_in_place
    sleeps.judged_us.set(judged_us)
    sleeps.windows.set(means.size.to_i64)
    sleeps.least.set(means.first)
    sleeps.median.set(means[means.size // 2])
    sleeps.most.set(means.last)
  end

  def period(per_ms : Int64) : Nil
    fail("period: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    stop = Atomic(Int64).new(0_i64)
    running = Atomic(Int64).new(0_i64)
    sleeps = Sleeps.new
    group do |g|
      g.spawn(unit: :new) do
        x = 11_u64
        running.set(1_i64)
        while stop.get == 0_i64
          x = spin(per_ms, x)
        end
        x == 0_u64 ? 1 : 0
      end
      while running.get == 0_i64
        sleep(1)
      end
      sleeper = IyiThread.start { sleep_windows(sleeps) }
      sleeper.join
      stop.set(1_i64)
    end
    windows = sleeps.windows.get
    judged = sleeps.judged.get
    judged_us = sleeps.judged_us.get
    looks = sleeps.looks.get
    slept = "#{sleeps.least.get} to #{sleeps.most.get} us, #{sleeps.median.get} the median"
    if judged_us < PERIOD_JUDGED_US
      fail("period: a thread's #{PERIOD_SLEEP_MS} ms sleeps took #{PERIOD_ON_TIME_US} us or less, on average, in #{judged} of #{windows} windows of #{PERIOD_SLEEPS} over #{PERIOD_GIVE_UP_MS} ms of a task computing (#{slept}): #{judged_us} us judged of the #{PERIOD_JUDGED_US} needed, the host waking a thread from a timer's wait too late to tell the monitor's tick from it")
    end
    fail("period: the monitor looked #{looks} times in #{judged_us} us of a task computing") if looks < 2_i64
    us = judged_us // looks
    if us < PERIOD_FLOOR_US || us > PERIOD_BOUND_US
      fail("period: the monitor looked every #{us} us over #{looks} looks, outside #{PERIOD_FLOOR_US} to #{PERIOD_BOUND_US} us, in #{judged} of #{windows} windows where a thread's #{PERIOD_SLEEP_MS} ms sleeps took #{PERIOD_ON_TIME_US} us or less (#{slept})")
    end
    counts = Turns.new
    t = __iyi_monotonic_ns
    group do |g|
      2.times do |i|
        g.spawn(unit: :new) do
          take_turns(per_ms, 13_u64 + i.to_u64, counts) == 0_u64 ? 1 : 0
        end
      end
      while counts.whole.get < QUANTUM_TURNS && elapsed_ms(t) < PERIOD_GIVE_UP_MS
        sleep(10)
      end
      counts.stop.set(1_i64)
    end
    total = (__iyi_monotonic_ns - t) // 1000_i64
    ended = counts.ended.get
    turns = counts.whole.get
    turn_looks = counts.looks.get
    if turns < QUANTUM_TURNS
      fail("period: two tasks computing on one worker ended #{ended} turns in #{total} us, #{turns} of them with the worker's thread on its core at both ends, of the #{QUANTUM_TURNS} needed: the host held the thread off its core too often to count a turn's looks")
    end
    quantum = total // (ended + 1_i64)
    a_turn = turn_looks * 100_i64 // turns
    pad = a_turn % 100_i64 < 10_i64 ? "0" : ""
    shown = "#{a_turn // 100_i64}.#{pad}#{a_turn % 100_i64}"
    if a_turn > QUANTUM_LOOKS * 100_i64
      fail("period: two tasks computing on one worker took turns of #{shown} looks, #{turn_looks} in the #{turns} of #{ended} turns whose ends found the worker's thread on its core, past #{QUANTUM_LOOKS}")
    end
    say "period: the monitor looked every #{us} us over #{looks} looks, in #{judged} of #{windows} windows where a thread's #{PERIOD_SLEEP_MS} ms sleeps took #{PERIOD_ON_TIME_US} us or less (#{slept}); two tasks computing on one worker took #{ended} turns of #{quantum} us, #{shown} looks a turn over the #{turns} whose ends found the worker's thread on its core"
  end

  # The period step's turns, counted by the two tasks taking them: `Share`
  # by its atomic fields. *last* is the clock at the last slice either task
  # ended; *began* the monitor's looks at the latest turn's first slice,
  # -1 before the first, and *prompt* whether the worker's thread was on
  # its core across that turn's start.
  class Turns
    getter stop : Atomic(Int64)
    getter ended : Atomic(Int64)
    getter whole : Atomic(Int64)
    getter looks : Atomic(Int64)
    getter last : Atomic(Int64)
    getter began : Atomic(Int64)
    getter prompt : Atomic(Int64)

    def initialize
      @stop = Atomic(Int64).new(0_i64)
      @ended = Atomic(Int64).new(0_i64)
      @whole = Atomic(Int64).new(0_i64)
      @looks = Atomic(Int64).new(0_i64)
      @last = Atomic(Int64).new(__iyi_monotonic_ns)
      @began = Atomic(Int64).new(-1_i64)
      @prompt = Atomic(Int64).new(0_i64)
    end
  end

  # One of the period step's two tasks taking turns on the worker, until
  # the step says stop: it computes in slices of a tenth of a millisecond
  # and reads the clock, the preemption count and the monitor's looks after
  # each. Only one task runs on the worker at a time, so the two tasks'
  # slices are one line of the worker's time, and a task's first slice of
  # a turn - its first, or the one the count moved in - is the turn's
  # start and the end of the turn before. A turn's looks are those between
  # its start and the next's. The monitor raises the word at the look that
  # ends the turn whether or not the task was running before it, so a
  # kernel holding the thread off its core inside a turn adds it no look;
  # held off between that look and the switch, it adds every look it
  # waited. So a turn is counted only where the thread was on its core at
  # both ends: the first slice of the turn, and of the next, ended within
  # QUANTUM_OFF_US of the slice before it, whichever task ran that.
  def take_turns(per_ms : Int64, seed : UInt64, counts : Turns) : UInt64
    x = seed
    slice = per_ms // 10_i64
    seen = IyiWorkers.preempts
    fresh = true
    while counts.stop.get == 0_i64
      x = spin(slice, x)
      now = __iyi_monotonic_ns
      prompt = now - counts.last.get <= QUANTUM_OFF_US * 1000_i64
      counts.last.set(now)
      count = IyiWorkers.preempts
      if count != seen
        seen = count
        fresh = true
      end
      if fresh
        looked = IyiWorkers.looks.to_i64
        began = counts.began.get
        if began >= 0_i64
          counts.ended.add(1_i64)
          if prompt && counts.prompt.get == 1_i64
            counts.whole.add(1_i64)
            counts.looks.add(looked - began)
          end
        end
        counts.began.set(looked)
        counts.prompt.set(prompt ? 1_i64 : 0_i64)
        fresh = false
      end
    end
    x
  end

  # ── tight ────────────────────────────────────────────────────────────
  # Each loop and its `@[NoPreempt]` twin, alternately, seven times, inside
  # a parallel task; the best of each, and their ratio, held to
  # TIGHT_BOUND thousandths. The check is a read or two and a branch per
  # turn. On GitHub's x86-64 runners the vectorised sums run at one of two
  # speeds, about 32 or 48 ms, and a checked one at the slower: 1.46 to
  # 1.50x on Windows (`sum` 1.503x in CI job 121231000410), and through
  # `each` 1.51x on Linux, whose unchecked `sum` came in at the slower speed
  # too, 1.001x. A windows-2025 runner then took a checked sum about 54 ms
  # against 31: `each` 1.745x to 1.762x over eight runs as master builds
  # it, `sum` 1.252x to 1.265x inlined and 1.744x to 1.755x `@[NoInline]`
  # (CI job 122916661258). Windows 11 on 12 logical processors (the
  # user's machine) measured every loop 0.98x to 1.08x, either way. The
  # bound is twice, room of an eighth above that runner's worst. It says
  # what the check costs, not which check it is: one that calls the
  # accessor at every turn, as darwin's and Windows' did at first, cost
  # those sums 3.4 to 5.8 times their twins there, but 1.776x and 1.828x on
  # the Windows runner of CI job 122792275988, about what the cheap check
  # cost on another. bench/parallel_exercise.sh tells the two in the IR.
  TIGHT_BOUND = 2000_i64

  def tight : Nil
    group do |g|
      g.spawn(unit: :new) do
        values = Array(Int64).new(1_000_000) { |i| i.to_i64 * 3_i64 }
        bytes = Array(UInt8).new(262_144) { |i| ((i * 7 + 3) & 0xFF).to_u8 }
        table = crc_table
        ["walk", "sum", "each", "crc"].each do |name|
          best = 9223372036854775807_i64
          best_np = 9223372036854775807_i64
          7.times do
            t = __iyi_monotonic_ns
            a = case name
                when "walk" then spin(200_000_000_i64, 7_u64)
                when "sum"  then sum(values, 300).to_u64
                when "each" then sum_each(values, 300).to_u64
                else             crc(table, bytes, 600).to_u64
                end
            took = __iyi_monotonic_ns - t
            best = took if took < best
            t = __iyi_monotonic_ns
            b = case name
                when "walk" then spin_np(200_000_000_i64, 7_u64)
                when "sum"  then sum_np(values, 300).to_u64
                when "each" then sum_each_np(values, 300).to_u64
                else             crc_np(table, bytes, 600).to_u64
                end
            took = __iyi_monotonic_ns - t
            best_np = took if took < best_np
            fail("tight: #{name} answered #{a} checked and #{b} unchecked") if a != b
          end
          ratio = (best * 1000_i64 // best_np).to_f / 1000.0
          if best * 1000_i64 > best_np * TIGHT_BOUND
            fail("tight: #{name}: #{best // 1000_i64} us checked against #{best_np // 1000_i64} us unchecked, #{ratio}x, past #{TIGHT_BOUND / 1000.0}x")
          end
          say "tight: #{name}: #{best // 1000_i64} us checked, #{best_np // 1000_i64} us unchecked, #{ratio}x"
        end
        0
      end
    end
  end

  STEPS = ["slice", "unit", "server", "poller", "fresh", "period", "tight"]

  # With no arguments, the steps that hold on a pool of one and take
  # seconds, there: slice, unit and period, which wants the pool of one.
  # The server shape wants workers, and the tight loops half a minute.
  workers = Program.args.empty? ? 1 : 4
  chosen = [] of String
  Program.args.each do |argument|
    if argument.starts_with?("--workers=")
      workers = argument[10, argument.size - 10].to_i
    else
      fail("no step named #{argument}") unless STEPS.includes?(argument)
      chosen << argument
    end
  end
  chosen = ["slice", "unit", "period"] if chosen.empty?
  IyiWorkers.count = workers
  per_ms = calibrate
  chosen.each do |name|
    case name
    when "slice"  then slice(per_ms)
    when "unit"   then unit(per_ms)
    when "server" then server(per_ms)
    when "poller" then poller(per_ms)
    when "fresh"  then fresh(per_ms)
    when "period" then period(per_ms)
    when "tight"  then tight
    end
  end
  puts "parallel preemption: every property held on #{IyiWorkers.count} workers"
{% else %}
  puts "parallel preemption: no pool on this target, nothing to hold"
{% end %}
