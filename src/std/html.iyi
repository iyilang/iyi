# Standard HTML escaping and unescaping library for iyi.
#
# Provides escape for the five predefined entities and unescape for named,
# decimal numeric, and hexadecimal numeric references.
#
# Named entity table decision:
# We implement the complete 253-entity standard HTML 4.01 and XML set
# (Latin-1, currency, Greek alphabet, mathematical symbols, punctuation, and markup).
# HTML5 expanded named entities to over 2,100 variants, predominantly duplicate
# obscure mathematical notation. The standard 253-entity set provides complete
# coverage for standard web documents and prose while remaining within the SPEC III
# footprint floor.

module std/html

import std/text

pub struct HTML
  # Escapes the five predefined HTML characters:
  # &  -> &amp;
  # <  -> &lt;
  # >  -> &gt;
  # "  -> &quot;
  # ' -> &#39;
  def self.escape(string : String, io) : Nil
    raw = string.to_unsafe
    len = string.bytesize
    i = 0
    while i < len
      case b = raw[i]
      when 38_u8 # &
        io << "&amp;"
      when 60_u8 # <
        io << "&lt;"
      when 62_u8 # >
        io << "&gt;"
      when 34_u8 # "
        io << "&quot;"
      when 39_u8 # '
        io << "&#39;"
      else
        io << b.unsafe_chr
      end
      i = i + 1
    end
  end

  def self.escape(string : String) : String
    # Fast path: check if any character needs escaping
    raw = string.to_unsafe
    len = string.bytesize
    needs = false
    i = 0
    while i < len
      b = raw[i]
      if b == 38_u8 || b == 60_u8 || b == 62_u8 || b == 34_u8 || b == 39_u8
        needs = true
        break
      end
      i = i + 1
    end
    return string unless needs

    # Allocate and copy
    bytes = [] of UInt8
    i = 0
    while i < len
      b = raw[i]
      case b
      when 38_u8 # &
        bytes << 38_u8; bytes << 97_u8; bytes << 109_u8; bytes << 112_u8; bytes << 59_u8
      when 60_u8 # <
        bytes << 38_u8; bytes << 108_u8; bytes << 116_u8; bytes << 59_u8
      when 62_u8 # >
        bytes << 38_u8; bytes << 103_u8; bytes << 116_u8; bytes << 59_u8
      when 34_u8 # "
        bytes << 38_u8; bytes << 113_u8; bytes << 117_u8; bytes << 111_u8; bytes << 116_u8; bytes << 59_u8
      when 39_u8 # '
        bytes << 38_u8; bytes << 35_u8; bytes << 51_u8; bytes << 57_u8; bytes << 59_u8
      else
        bytes << b
      end
      i = i + 1
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

