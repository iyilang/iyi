; iyi-ir 1
source_filename = "store_forward"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @store_forward(ptr %p, ptr %q, i64 %x, i64 %y) {
entry:
  store i64 %x, ptr %p, align 8
  %a = load i64, ptr %p, align 8
  store i64 %y, ptr %q, align 8
  %b = load i64, ptr %q, align 8
  %out = add i64 %a, %b
  ret i64 %out
}
