# Size, equality, each and printing for the prelude's Tuple and NamedTuple.
#
# Heterogeneous tuples cannot implement Indexable (one Elem). This module
# adds what the compiler does not: size, empty?, first/last, ==, each, to_s.
#
module std/tuple

struct ::Tuple
  # Creates a new Tuple containing the given arguments.
  def self.new(*args : *T)
    args
  end

  # Returns true when the tuple contains zero elements.
  def empty? : Bool
    {{ T.size == 0 }}
  end

  # Returns the first element. Raises if empty.
  def first
    {% if T.size == 0 %}
      raise "first of an empty tuple"
    {% else %}
      self[0]
    {% end %}
  end

  # Returns the first element, or nil if empty.
  def first?
    {% if T.size == 0 %}
      nil
    {% else %}
      self[0]
    {% end %}
  end

  # Returns the last element. Raises if empty.
  def last
    {% if T.size == 0 %}
      raise "last of an empty tuple"
    {% else %}
      self[{{ T.size - 1 }}]
    {% end %}
  end

  # Returns the last element, or nil if empty.
  def last?
    {% if T.size == 0 %}
      nil
    {% else %}
      self[{{ T.size - 1 }}]
    {% end %}
  end

  # Value identity.
  def same?(other : self) : Bool
    self == other
  end

  # Yields each element sequentially.
  def each(&) : Nil
    {% for i in 0...T.size %}
      yield self[{{i}}]
    {% end %}
  end

  # Yields each element alongside its index.
  def each_with_index(&) : Nil
    {% for i in 0...T.size %}
      yield self[{{i}}], {{i}}
    {% end %}
  end

  # Converts the tuple into an Array typed as the union of all element types.
  # The empty tuple's is `[] of NoReturn`, the union of no types: the
  # `typeof` below had no argument there, and `Tuple.new.to_a` did not
  # compile.
  def to_a
    {% if T.size == 0 %}
      [] of NoReturn
    {% else %}
      arr = [] of typeof(
        {% for i in 0...T.size %}
          self[{{i}}],
        {% end %}
      )
      {% for i in 0...T.size %}
        arr << self[{{i}}]
      {% end %}
      arr
    {% end %}
  end

  # Returns a new Tuple with each element mapped through the block.
  def map(&)
    {% begin %}
      {
        {% for i in 0...T.size %}
          yield(self[{{i}}]),
        {% end %}
      }
    {% end %}
  end

  # Concatenates two tuples.
  def +(other : Tuple(*U)) forall U
    {% begin %}
      {
        {% for i in 0...T.size %}
          self[{{i}}],
        {% end %}
        {% for i in 0...U.size %}
          other[{{i}}],
        {% end %}
      }
    {% end %}
  end

  # Reverses elements in tuple.
  def reverse
    {% begin %}
      {
        {% for i in 1..T.size %}
          self[{{T.size - i}}],
        {% end %}
      }
    {% end %}
  end
end

struct ::NamedTuple
  # Hashing follows the `==` below, mixed as `Tuple#hash` mixes the members
  # (src/iyi/object.iyi). `Object#hash` answered the type's id, so
  # `{a: 1}` and `{a: 2}` hashed alike and 20,000 keys took 1.4 s to insert
  # where the same pairs as tuples took 1 ms. The values go in by sorted
  # key, because `==` matches by name: `{x: 1, y: 2} == {y: 2, x: 1}`, so
  # the two have to hash alike although their types list the keys in
  # another order.
  def hash : Int32
    value = 0x9E3779B97F4A7C15_u64
    {% for key in T.keys.sort_by { |k| k.stringify } %}
      value = (value ^ self[{{key.symbolize}}].hash.to_i64.unsafe_to_u64) &* 0x100000001B3_u64
      value = value ^ value.unsafe_shr(29_u64)
    {% end %}
    value.hash
  end

  # Number of key-value pairs in the named tuple.
  def size : Int32
    {{ T.keys.size }}
  end

  # Returns true when the named tuple contains zero entries.
  def empty? : Bool
    {{ T.keys.size == 0 }}
  end

  # Returns true if the named tuple contains the given key symbol.
  #
  # The keys here and below are written with `symbolize`, never as
  # `:{{key.id}}`: a quoted key such as `"content-type"` or `"x y"` pasted
  # that way is `:content-type`, a symbol minus a call, or `:x y`, which
  # does not parse, so every one of these methods failed to compile for
  # such a key. `std/named_tuple` already wrote them this way.
  def has_key?(key : Symbol) : Bool
    {% for k in T.keys %}
      return true if key == {{k.symbolize}}
    {% end %}
    false
  end

  # Compares the values by name.
  #
  # Any named tuple: the keys are sorted and compared, then the values in
  # that order as tuples compare (src/iyi/object.iyi), member by member
  # where one type holds the other. `self` took `{a: 1, b: 2}` for `{a: 1,
  # b: y}` (y : Int32?) and not back, so the pair answered true one way and
  # false the other, and `case` over them did not match.
  def ==(other : NamedTuple) : Bool
    sorted_keys == other.sorted_keys && sorted_values == other.sorted_values
  end

  # The keys, and the values, in sorted key order: the order a type lists
  # its keys in is not part of the value.
  protected def sorted_keys
    {% begin %}
      Tuple.new(
        {% for key in T.keys.sort_by { |k| k.stringify } %}
          {{key.symbolize}},
        {% end %}
      )
    {% end %}
  end

  protected def sorted_values
    {% begin %}
      Tuple.new(
        {% for key in T.keys.sort_by { |k| k.stringify } %}
          self[{{key.symbolize}}],
        {% end %}
      )
    {% end %}
  end

  # Value identity.
  def same?(other : self) : Bool
    self == other
  end

  # Yields each key symbol and corresponding value.
  def each(&) : Nil
    {% for key in T.keys %}
      yield {{key.symbolize}}, self[{{key.symbolize}}]
    {% end %}
  end

  # Yields each value in order.
  def each_value(&) : Nil
    {% for key in T.keys %}
      yield self[{{key.symbolize}}]
    {% end %}
  end

  # Returns a Tuple containing the key symbols in order.
  def keys
    {% begin %}
      {
        {% for key in T.keys %}
          {{key.symbolize}},
        {% end %}
      }
    {% end %}
  end

  # Returns a Tuple containing the values in order.
  def values
    {% begin %}
      {
        {% for key in T.keys %}
          self[{{key.symbolize}}],
        {% end %}
      }
    {% end %}
  end

  # String representation: `{name: "Alice", age: 30}`. A key that is not a
  # name is quoted, as it is written: `{"content-type": "text/plain"}`.
  def to_s : String
    parts = [] of String
    {% for key in T.keys %}
      parts << quoted_key({{key.stringify}}) + ": " + self[{{key.symbolize}}].inspect
    {% end %}
    "{" + parts.join(", ") + "}"
  end

  # The rule the other library's `Symbol.needs_quotes_for_named_argument?`
  # states: a key needs quotes when it is empty or `_`, starts with a digit,
  # or holds an ASCII byte that is not a letter, digit or `_`.
  private def quoted_key(key : String) : String
    return key.inspect if key.empty? || key == "_"
    bytes = key.to_unsafe
    i = 0
    while i < key.bytesize
      b = bytes[i]
      digit = b >= 48_u8 && b <= 57_u8
      return key.inspect if i == 0 && digit
      word = digit || (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8) || b == 95_u8
      return key.inspect if b < 128_u8 && !word
      i = i + 1
    end
    key
  end

  def inspect : String
    to_s
  end
end
