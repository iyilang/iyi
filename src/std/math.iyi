  # 64 x 64 -> 128 bit product as {hi, lo}.
  private def self.trig_mul64(x : UInt64, y : UInt64) : {UInt64, UInt64}
    xl = x & 0xffffffff_u64
    xh = x.unsafe_shr(32_u64)
    yl = y & 0xffffffff_u64
    yh = y.unsafe_shr(32_u64)
    ll = xl &* yl
    lh = xl &* yh
    hl = xh &* yl
    mid = ll.unsafe_shr(32_u64) &+ (lh & 0xffffffff_u64) &+ (hl & 0xffffffff_u64)
    hi = (xh &* yh) &+ lh.unsafe_shr(32_u64) &+ hl.unsafe_shr(32_u64) &+ mid.unsafe_shr(32_u64)
    {hi, mid.unsafe_shl(32_u64) | (ll & 0xffffffff_u64)}
  end

  # a + b and a - b modulo 2^128.
  private def self.trig_add128(ah : UInt64, al : UInt64, bh : UInt64, bl : UInt64) : {UInt64, UInt64}
    lo = al &+ bl
    {ah &+ bh &+ (lo < al ? 1_u64 : 0_u64), lo}
  end

  private def self.trig_sub128(ah : UInt64, al : UInt64, bh : UInt64, bl : UInt64) : {UInt64, UInt64}
    {ah &- bh &- (al < bl ? 1_u64 : 0_u64), al &- bl}
  end

  private def self.trig_lt128(ah : UInt64, al : UInt64, bh : UInt64, bl : UInt64) : Bool
    ah < bh || (ah == bh && al < bl)
  end

  # Shifts of a u128 by 0 <= n < 128.
  private def self.trig_shl128(h : UInt64, l : UInt64, n : UInt64) : {UInt64, UInt64}
    return {h, l} if n == 0_u64
    return {l.unsafe_shl(n &- 64_u64), 0_u64} if n >= 64_u64
    {h.unsafe_shl(n) | l.unsafe_shr(64_u64 &- n), l.unsafe_shl(n)}
  end

  private def self.trig_shr128(h : UInt64, l : UInt64, n : UInt64) : {UInt64, UInt64}
    return {h, l} if n == 0_u64
    return {0_u64, h.unsafe_shr(n &- 64_u64)} if n >= 64_u64
    {h.unsafe_shr(n), l.unsafe_shr(n) | h.unsafe_shl(64_u64 &- n)}
  end

  # __builtin_clzll for x != 0 (64 for 0).
  private def self.trig_clz(x : UInt64) : UInt64
    return 64_u64 if x == 0_u64
    n = 0_u64
    if x.unsafe_shr(32_u64) == 0_u64
      n = n &+ 32_u64
      x = x.unsafe_shl(32_u64)
    end
    if x.unsafe_shr(48_u64) == 0_u64
      n = n &+ 16_u64
      x = x.unsafe_shl(16_u64)
    end
    if x.unsafe_shr(56_u64) == 0_u64
      n = n &+ 8_u64
      x = x.unsafe_shl(8_u64)
    end
    if x.unsafe_shr(60_u64) == 0_u64
      n = n &+ 4_u64
      x = x.unsafe_shl(4_u64)
    end
    if x.unsafe_shr(62_u64) == 0_u64
      n = n &+ 2_u64
      x = x.unsafe_shl(2_u64)
    end
    x.unsafe_shr(63_u64) == 0_u64 ? n &+ 1_u64 : n
  end

  private def self.trig_at(t : Pointer(UInt64), i : Int32) : Float64
    IyiFloatText.from_bits(t[i])
  end

  # fasttwosum / fast_two_sum: {s, e} with s + e = x + y exactly, |x| >= |y|.
  private def self.trig_fasttwosum(x : Float64, y : Float64) : {Float64, Float64}
    s = x + y
    z = s - x
    {s, y - z}
  end

  # sin.c muldd: (xh + xl) * (ch + cl) as a double-double.
  private def self.sin_muldd(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahhh = xh * ch
    {ahhh, (xh * cl + xl * ch) + fma(xh, ch, ahhh * -1.0)}
  end

  # sin.c mhUU: the high 128 bits of a * b, the low * low product dropped.
  private def self.sin_mhuu(ah : UInt64, al : UInt64, bh : UInt64, bl : UInt64) : {UInt64, UInt64}
    hh, hl = trig_mul64(ah, bh)
    t = trig_mul64(ah, bl)[0]
    u = trig_mul64(al, bh)[0]
    sh, sl = trig_add128(0_u64, t, 0_u64, u)
    trig_add128(hh, hl, sh, sl)
  end

  # sin.c u128_tod: (-1)^sbit * r / 2^128 rounded, r non-zero and not tiny.
  private def self.sin_u128_tod(h : UInt64, l : UInt64, sbit : UInt64) : Float64
    sh = h != 0_u64 ? trig_clz(h) : 64_u64 &+ trig_clz(l)
    top = trig_shr128(h, l, 75_u64 &- sh)[1]
    rbit = trig_shr128(h, l, 74_u64 &- sh)[1] & 1_u64
    v = IyiFloatText.bits_of(sbit == 0_u64 ? 1.1102230246251565e-16 : -1.1102230246251565e-16) &- sh.unsafe_shl(52_u64)
    a = top.to_f64 * IyiFloatText.from_bits(v)
    b = a * (rbit != 0_u64 ? 1.1102230246251565e-16 : 5.551115123125783e-17)
    a + b
  end

  # sin.c evalPS: Sr/2^128 ~ sin2pi(r), fixed point.
  private def self.sin_eval_ps(uh : UInt64, ul : UInt64, u2h : UInt64, u2l : UInt64, u4h : UInt64, u4l : UInt64) : {UInt64, UInt64}
    ps = SIN_PS.to_unsafe
    ph, pl = trig_mul64(ps[7], u2h)
    sh, sl = trig_sub128(ps[4], ps[5], ph, pl)
    sh, sl = sin_mhuu(sh, sl, u4h, u4l)
    s, t = sin_mhuu(ps[2], ps[3], u2h, u2l)
    s, t = trig_sub128(ps[0], ps[1], s, t)
    s, t = trig_add128(s, t, sh, sl)
    sin_mhuu(s, t, uh, ul)
  end

  # sin.c evalPC: Cr/2^128 ~ cos2pi(r), fixed point.
  private def self.sin_eval_pc(u2h : UInt64, u2l : UInt64, u4h : UInt64, u4l : UInt64) : {UInt64, UInt64}
    pc = SIN_PC.to_unsafe
    ph, pl = trig_mul64(u2h, pc[9])
    sh, sl = trig_sub128(pc[6], pc[7], ph, pl)
    mh, ml = sin_mhuu(sh, sl, u2h, u2l)
    sh, sl = trig_sub128(pc[4], pc[5], mh, ml)
    s, t = sin_mhuu(pc[2], pc[3], u2h, u2l)
    s, t = trig_sub128(pc[0], pc[1], s, t)
    mh, ml = sin_mhuu(sh, sl, u4h, u4l)
    trig_add128(s, t, mh, ml)
  end

  # sin.c reduce_large, |x| >= 2^31: {j, r} with
  # x/(2pi) mod 1 ~ j/2^15 + r, 0 <= r < 2^-15.
  private def self.sin_reduce_large(x : Float64) : {UInt64, Float64}
    tu = IyiFloatText.bits_of(x)
    e = (tu.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
    m = 0x0010000000000000_u64 | (tu & 0xfffffffffffff_u64)
    tt = SIN_T.to_unsafe
    i = (e - 1011) // 64
    f = ((e - 1011) & 0x3f).unsafe_to_u64
    if f == 0_u64
      v0 = tt[i]
      v1 = tt[i + 1]
    else
      v0 = tt[i].unsafe_shl(f) | tt[i + 1].unsafe_shr(64_u64 &- f)
      v1 = tt[i + 1].unsafe_shl(f) | tt[i + 2].unsafe_shr(64_u64 &- f)
    end
    uh, ul = trig_mul64(m, v1)
    uh = uh &+ m &* v0
    uh, ul = trig_add128(uh, ul, 0x0001000000000000_u64, 0x810000000000000_u64)
    mant = (ul.unsafe_shr(60_u64) | uh.unsafe_shl(4_u64)) & 0x1fffffffffffff_u64
    {uh.unsafe_shr(49_u64), mant.to_f64 * 3.3881317890172014e-21 - 1.52587890625e-05}
  end

  # sin.c reduce_large_acc: {k, rh, rl, neg} with
  # x/(2pi) mod 1 ~ k/2^13 + (-1)^neg r/2^128, |r/2^128| <= 2^-14.
  private def self.sin_reduce_large_acc(x : Float64) : {UInt64, UInt64, UInt64, Bool}
    tu = IyiFloatText.bits_of(x)
    e = (tu.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
    m = 0x0010000000000000_u64 | (tu & 0xfffffffffffff_u64)
    tt = SIN_T.to_unsafe
    i = -1 + (e - 947) // 64
    f = ((e - 1011) & 0x3f).unsafe_to_u64
    v0 = i >= 0 ? tt[i] : 0_u64
    v1 = tt[i + 1]
    v2 = tt[i + 2]
    if f != 0_u64
      v0 = v0.unsafe_shl(f) | v1.unsafe_shr(64_u64 &- f)
      v1 = v1.unsafe_shl(f) | v2.unsafe_shr(64_u64 &- f)
      v2 = v2.unsafe_shl(f) | tt[i + 3].unsafe_shr(64_u64 &- f)
    end
    uh, ul = trig_mul64(m, v1)
    uh = uh &+ m &* v0
    vh = trig_mul64(m, v2)[0]
    uh, ul = trig_add128(uh, ul, 0_u64, vh)
    k = uh.unsafe_shr(51_u64)
    uh = uh & 0x7ffffffffffff_u64
    neg = uh.unsafe_shr(50_u64) != 0_u64
    if neg
      k = (k &+ 1_u64) & 0x1fff_u64
      uh, ul = trig_sub128(0x8000000000000_u64, 0_u64, uh, ul)
    end
    {k, uh, ul, neg}
  end

  # sin.c sin_large_accurate: |x| >= 2^31, or the moderate path's
  # rounding test failing for 2^-16 <= |x| < 2^31.
  private def self.sin_large_accurate(x : Float64) : Float64
    k, rh, rl, neg = sin_reduce_large_acc(x)
    rh, rl = trig_shl128(rh, rl, 3_u64)
    rh, rl = sin_mhuu(0xc90fdaa22168c234_u64, 0xc4c6628b80dc1cd1_u64, rh, rl)
    u2h, u2l = sin_mhuu(rh, rl, rh, rl)
    u4h, u4l = sin_mhuu(u2h, u2l, u2h, u2l)
    sbit = x > 0.0 ? 0_u64 : 1_u64
    sbit = sbit ^ k.unsafe_shr(12_u64)
    i1 = (k.unsafe_shr(6_u64) & 0x3f_u64).unsafe_to_i32
    i2 = (k & 0x3f_u64).unsafe_to_i32
    s1t = SIN_S1U.to_unsafe
    s2t = SIN_S2U.to_unsafe
    c2t = SIN_C2U.to_unsafe
    si = i1 <= 32 ? i1 : 64 - i1
    ci = i1 <= 32 ? 32 - i1 : i1 - 32
    s1h = s1t[2 * si]
    s1l = s1t[2 * si + 1]
    c1h = s1t[2 * ci]
    c1l = s1t[2 * ci + 1]
    s1uh, s1ul = sin_mhuu(s1h, s1l, c2t[2 * i2], c2t[2 * i2 + 1])
    th, tl = sin_mhuu(c1h, c1l, s2t[2 * i2], s2t[2 * i2 + 1])
    s1uh, s1ul = i1 < 32 ? trig_add128(s1uh, s1ul, th, tl) : trig_sub128(s1uh, s1ul, th, tl)
    c1uh, c1ul = sin_mhuu(c1h, c1l, c2t[2 * i2], c2t[2 * i2 + 1])
    th, tl = sin_mhuu(s1h, s1l, s2t[2 * i2], s2t[2 * i2 + 1])
    c1uh, c1ul = i1 < 32 ? trig_sub128(c1uh, c1ul, th, tl) : trig_add128(c1uh, c1ul, th, tl)
    srh, srl = sin_eval_ps(rh, rl, u2h, u2l, u4h, u4l)
    crh, crl = sin_eval_pc(u2h, u2l, u4h, u4l)
    s1uh, s1ul = sin_mhuu(s1uh, s1ul, crh, crl)
    c1uh, c1ul = sin_mhuu(c1uh, c1ul, srh, srl)
    if (i1 < 32) != neg
      s1uh, s1ul = trig_add128(s1uh, s1ul, c1uh, c1ul)
    elsif trig_lt128(s1uh, s1ul, c1uh, c1ul)
      s1uh, s1ul = trig_sub128(c1uh, c1ul, s1uh, s1ul)
      sbit = sbit ^ 1_u64
    else
      s1uh, s1ul = trig_sub128(s1uh, s1ul, c1uh, c1ul)
    end
    sin_u128_tod(s1uh, s1ul, sbit)
  end

  # sin.c sin_small_accurate: |x| < 2^-16.
  private def self.sin_small_accurate(x : Float64) : Float64
    x2h = x * x
    x2l = fma(x, x, x2h * -1.0)
    h = 0.00833333333327091 * x2h
    h = h + -9.251854266180608e-18
    h, l = trig_fasttwosum(-0.16666666666666666, h)
    h, l = sin_muldd(h, l, x2h, x2l)
    h, l = sin_muldd(h, l, x, 0.0)
    h, t = trig_fasttwosum(x, h)
    l = l + t
    h + l
  end

  # sin.c: S(j) ~ sin(j pi/2^14) as {Sh, Sl} and C(j) ~ cos as Ch, from U1 and U2.
  private def self.sin_table_sc(i1 : Int32, i2 : Int32) : {Float64, Float64, Float64}
    u1 = SIN_U1.to_unsafe
    u2 = SIN_U2.to_unsafe
    a = 4 * i1
    b = 4 * i2
    s1h, s1l = sin_muldd(trig_at(u1, a), trig_at(u1, a + 1), trig_at(u2, b + 2), trig_at(u2, b + 3))
    s2h, s2l = sin_muldd(trig_at(u2, b), trig_at(u2, b + 1), trig_at(u1, a + 2), trig_at(u1, a + 3))
    sh, sl = trig_fasttwosum(s1h, s2h)
    ch = trig_at(u1, a + 2) * trig_at(u2, b + 2) - trig_at(u1, a) * trig_at(u2, b)
    {sh, (s1l + s2l) + sl, ch}
  end

  # sin.c cr_sin_moderate: 0x1.7137449123ef6p-26 < |x| < 2^31.
  private def self.sin_moderate(x : Float64, sbit : UInt64) : Float64
    ax = x.abs
    k = ax * 5215.189175235227
    k = (k + 4503599627370496.0) - 4503599627370496.0
    rh = fma(k, -0.00019174759848570515, ax)
    rl = k * -7.474650873702107e-21
    r = rh + rl
    r2 = r * r
    j = k.unsafe_to_i64
    sbit = sbit ^ (j.unsafe_shr(14_i64) & 1_i64).unsafe_to_u64
    big_s, big_sl, big_c = sin_table_sc((j.unsafe_shr(7_i64) & 0x7f_i64).unsafe_to_i32, (j & 0x7f_i64).unsafe_to_i32)
    sh = r * (1.0 - 0.16666666659950335 * r2)
    ch = r2 * (-0.5 + 0.041666666655141404 * r2)
    sgn = sbit == 0_u64 ? 1.0 : -1.0
    fh = sgn * big_s
    fl = sgn * (big_sl + big_s * ch + big_c * sh) - 1.0122043719688889e-19
    lb = fh + fl
    ub = fh + (fl + 2.0244087439377778e-19)
    return lb if ub == lb
    return sin_small_accurate(x) if x.abs < 1.52587890625e-05
    sin_large_accurate(x)
  end

  # sin.c cr_sin_large: |x| >= 2^31.
  private def self.sin_large(x : Float64) : Float64
    j, r = sin_reduce_large(x.abs)
    sbit = x > 0.0 ? 0_u64 : 1_u64
    r2 = r * r
    sbit = sbit ^ j.unsafe_shr(14_u64)
    big_s, big_sl, big_c = sin_table_sc((j.unsafe_shr(7_u64) & 0x7f_u64).unsafe_to_i32, (j & 0x7f_u64).unsafe_to_i32)
    sh = r * (6.283185307179586 - 41.341700961418276 * r2)
    ch = r2 * (-19.739208802178716 + 64.93938786554104 * r2)
    sgn = sbit == 0_u64 ? 1.0 : -1.0
    fh = sgn * big_s
    fl = sgn * (big_sl + big_s * ch + big_c * sh)
    lb = fh + (fl - 1.359487880343152e-19)
    ub = fh + (fl + 1.359487880343152e-19)
    return lb if lb == ub
    sin_large_accurate(x)
  end

  # cos.c dint64_t values are {hi, lo, ex, sgn}: (-1)^sgn (hi/2^64 + lo/2^128) 2^ex.
  private def self.cos_dint_row(t : Pointer(UInt64), i : Int32) : {UInt64, UInt64, Int64, UInt64}
    {t[4 * i], t[4 * i + 1], t[4 * i + 2].unsafe_to_i64, t[4 * i + 3]}
  end

  # cos.c add_dint.
  private def self.cos_add_dint(ah : UInt64, al : UInt64, aex : Int64, asg : UInt64, bh : UInt64, bl : UInt64, bex : Int64, bsg : UInt64) : {UInt64, UInt64, Int64, UInt64}
    return {bh, bl, bex, bsg} if ah | al == 0_u64
    # cmp_dint_abs
    if ah == 0_u64
      c = bh == 0_u64 ? 0 : -1
    elsif bh == 0_u64
      c = 1
    elsif aex != bex
      c = aex > bex ? 1 : -1
    elsif ah != bh || al != bl
      c = trig_lt128(bh, bl, ah, al) ? 1 : -1
    else
      c = 0
    end
    if c == 0
      return {0_u64, 0_u64, -1076_i64, 0_u64} if asg ^ bsg != 0_u64
      return {ah, al, aex &+ 1_i64, asg}
    end
    if c < 0
      ah, bh = bh, ah
      al, bl = bl, al
      aex, bex = bex, aex
      asg, bsg = bsg, asg
    end
    k = (aex &- bex).unsafe_to_u64
    b_h = bh
    b_l = bl
    if k > 0_u64
      if k < 128_u64
        b_h, b_l = trig_shr128(bh, bl, k)
      else
        b_h = 0_u64
        b_l = 0_u64
      end
    end
    rex = aex
    if asg ^ bsg != 0_u64
      ch, cl = trig_sub128(ah, al, b_h, b_l)
      ex = ch != 0_u64 ? trig_clz(ch) : 64_u64 &+ trig_clz(cl)
      if ex > 0_u64
        xh, xl = trig_shl128(ah, al, ex)
        if k == 1_u64
          yh, yl = trig_shl128(bh, bl, ex &- 1_u64)
        else
          yh, yl = trig_shl128(b_h, b_l, ex)
        end
        ch, cl = trig_sub128(xh, xl, yh, yl)
        rex = rex &- ex.unsafe_to_i64
        ex = trig_clz(ch)
      end
      ch, cl = trig_shl128(ch, cl, ex)
      rex = rex &- ex.unsafe_to_i64
    else
      ch, cl = trig_add128(ah, al, b_h, b_l)
      if trig_lt128(ch, cl, ah, al)
        ch, cl = trig_shr128(ch, cl, 1_u64)
        ch = ch | 0x8000000000000000_u64
        rex = rex &+ 1_i64
      end
    end
    {ch, cl, rex, asg}
  end

  # cos.c mul_dint.
  private def self.cos_mul_dint(ah : UInt64, al : UInt64, aex : Int64, asg : UInt64, bh : UInt64, bl : UInt64, bex : Int64, bsg : UInt64) : {UInt64, UInt64, Int64, UInt64}
    m1 = trig_mul64(ah, bl)[0]
    m2 = trig_mul64(al, bh)[0]
    rh, rl = trig_mul64(ah, bh)
    sh, sl = trig_add128(0_u64, m1, 0_u64, m2)
    rh, rl = trig_add128(rh, rl, sh, sl)
    ex = rh.unsafe_shr(63_u64)
    rh, rl = trig_shl128(rh, rl, 1_u64 &- ex)
    {rh, rl, aex &+ bex &+ ex.unsafe_to_i64 &- 1_i64, asg ^ bsg}
  end

  # cos.c mul_dint_21: b's low word taken as zero.
  private def self.cos_mul_dint_21(ah : UInt64, al : UInt64, aex : Int64, asg : UInt64, bh : UInt64, bex : Int64, bsg : UInt64) : {UInt64, UInt64, Int64, UInt64}
    rh, rl = trig_mul64(ah, bh)
    rh, rl = trig_add128(rh, rl, 0_u64, trig_mul64(al, bh)[0])
    ex = rh.unsafe_shr(63_u64)
    rh, rl = trig_shl128(rh, rl, 1_u64 &- ex)
    {rh, rl, aex &+ bex &+ ex.unsafe_to_i64 &- 1_i64, asg ^ bsg}
  end

  # cos.c dint_tod, with subnormalize_dint's round-to-nearest branch.
  private def self.cos_dint_tod(hi : UInt64, lo : UInt64, ex : Int64, sgn : UInt64) : Float64
    if ex <= -1023_i64
      sh = (0_i64 &- (1011_i64 &+ ex)).unsafe_to_u64
      h = sh < 64_u64 ? hi.unsafe_shr(sh) : 0_u64
      md = sh &- 1_u64 < 64_u64 ? hi.unsafe_shr(sh &- 1_u64) & 1_u64 : 0_u64
      rest = sh < 64_u64 ? hi & 0xffffffffffffffff_u64.unsafe_shr(sh) : hi
      h = h &+ (rest != 0_u64 || lo != 0_u64 ? md : h & md)
      hi = sh < 64_u64 ? h.unsafe_shl(sh) : 0_u64
      lo = 0_u64
      if hi == 0_u64
        ex = ex &+ 1_i64
        hi = 0x8000000000000000_u64
      end
    end
    r = IyiFloatText.from_bits(hi.unsafe_shr(11_u64) | 0x3ff0000000000000_u64 | sgn.unsafe_shl(63_u64))
    rd = 0.0
    rd = rd + 1.1102230246251565e-16 if hi.unsafe_shr(10_u64) & 1_u64 != 0_u64
    rd = rd + 5.551115123125783e-17 if hi & 0x3ff_u64 != 0_u64 || lo != 0_u64
    rd = rd * -1.0 if sgn != 0_u64
    r = r + rd
    if ex > -1022_i64
      if ex > 1024_i64
        if ex == 1025_i64
          r = r * 2.0
          e = 8.98846567431158e+307
        else
          r = 1.7976931348623157e+308
          e = 1.7976931348623157e+308
        end
      else
        e = IyiFloatText.from_bits(((ex &+ 1022_i64).unsafe_to_u64 & 0x7ff_u64).unsafe_shl(52_u64))
      end
    elsif ex < -1073_i64
      if ex == -1074_i64
        r = r * 0.5
        e = 5e-324
      else
        r = 5e-324
        e = 5e-324
      end
    else
      e = IyiFloatText.from_bits(1_u64.unsafe_shl((ex &+ 1073_i64).unsafe_to_u64))
    end
    r * e
  end

  # cos.c normalize: hi's top bit set unless the value is zero.
  private def self.cos_normalize(hi : UInt64, lo : UInt64, ex : Int64) : {UInt64, UInt64, Int64}
    if hi != 0_u64
      cnt = trig_clz(hi)
      if cnt != 0_u64
        hi = hi.unsafe_shl(cnt) | lo.unsafe_shr(64_u64 &- cnt)
        lo = lo.unsafe_shl(cnt)
      end
      ex = ex &- cnt.unsafe_to_i64
    elsif lo != 0_u64
      cnt = trig_clz(lo)
      hi = lo.unsafe_shl(cnt)
      lo = 0_u64
      ex = ex &- 64_i64 &- cnt.unsafe_to_i64
    end
    {hi, lo, ex}
  end

  # cos.c reduce: X/(2pi) mod 1 for a normalized positive X, normalized.
  private def self.cos_reduce(hi : UInt64, ex : Int64) : {UInt64, UInt64, Int64}
    tt = COS_T.to_unsafe
    e = ex
    if e <= 1_i64
      uh, ul = trig_mul64(hi, tt[1])
      tiny = ul
      lo = uh
      uh, ul = trig_mul64(hi, tt[0])
      lo = lo &+ ul
      hi = uh &+ (lo < ul ? 1_u64 : 0_u64)
      hi, lo, ex = cos_normalize(hi, lo, ex)
      e = e &- ex
      lo = lo | tiny.unsafe_shr(64_u64 &- e.unsafe_to_u64) if e != 0_i64
      return {hi, lo, ex}
    end
    i = e < 127_i64 ? 0 : ((e - 127_i64 + 64_i64 - 1_i64) // 64_i64).unsafe_to_i32
    uh, ul = trig_mul64(hi, tt[i + 3])
    c0 = ul
    c1 = uh
    uh, ul = trig_mul64(hi, tt[i + 2])
    c1 = c1 &+ ul
    c2 = uh &+ (c1 < ul ? 1_u64 : 0_u64)
    uh, ul = trig_mul64(hi, tt[i + 1])
    c2 = c2 &+ ul
    c3 = uh &+ (c2 < ul ? 1_u64 : 0_u64)
    uh, ul = trig_mul64(hi, tt[i])
    c3 = c3 &+ ul
    c4 = uh &+ (c3 < ul ? 1_u64 : 0_u64)
    f = (e - 64_i64 * i.to_i64).unsafe_to_u64
    if f < 64_u64
      hi = c4.unsafe_shl(f) | c3.unsafe_shr(64_u64 &- f)
      lo = c3.unsafe_shl(f) | c2.unsafe_shr(64_u64 &- f)
      tiny = c2.unsafe_shl(f) | c1.unsafe_shr(64_u64 &- f)
    elsif f == 64_u64
      hi = c3
      lo = c2
      tiny = c1
    else
      g = f &- 64_u64
      u = trig_mul64(hi, tt[i + 4])[0]
      c0 = c0 &+ u
      carry = c0 < u
      c1 = c1 &+ (carry ? 1_u64 : 0_u64)
      c2 = c2 &+ (carry && c1 == 0_u64 ? 1_u64 : 0_u64)
      c3 = c3 &+ (carry && c1 == 0_u64 && c2 == 0_u64 ? 1_u64 : 0_u64)
      hi = c3.unsafe_shl(g) | c2.unsafe_shr(64_u64 &- g)
      lo = c2.unsafe_shl(g) | c1.unsafe_shr(64_u64 &- g)
      tiny = c1.unsafe_shl(g) | c0.unsafe_shr(64_u64 &- g)
    end
    hi, lo, ex = cos_normalize(hi, lo, 0_i64)
    lo = lo | tiny.unsafe_shr((64_i64 &+ ex).unsafe_to_u64) if ex < 0_i64
    {hi, lo, ex}
  end

  # cos.c set_dd: h + l <- c1/2^64 + c0/2^128.
  private def self.cos_set_dd(c1 : UInt64, c0 : UInt64) : {Float64, Float64}
    if c1 != 0_u64
      e = trig_clz(c1)
      if e != 0_u64
        c1 = c1.unsafe_shl(e) | c0.unsafe_shr(64_u64 &- e)
        c0 = c0.unsafe_shl(e)
      end
      f = 0x3fe_u64 &- e
      h = IyiFloatText.from_bits(f.unsafe_shl(52_u64) | c1.unsafe_shl(1_u64).unsafe_shr(12_u64))
      c0 = c1.unsafe_shl(53_u64) | c0.unsafe_shr(11_u64)
      return {h, 0.0} if c0 == 0_u64
      g = trig_clz(c0)
      c0 = c0.unsafe_shl(g) if g != 0_u64
      {h, IyiFloatText.from_bits((f &- 53_u64 &- g).unsafe_shl(52_u64) | c0.unsafe_shl(1_u64).unsafe_shr(12_u64))}
    elsif c0 != 0_u64
      e = trig_clz(c0)
      f = 0x3fe_u64 &- 64_u64 &- e
      c0 = e &+ 1_u64 < 64_u64 ? c0.unsafe_shl(e &+ 1_u64) : 0_u64
      h = IyiFloatText.from_bits(f.unsafe_shl(52_u64) | c0.unsafe_shr(12_u64))
      c0 = c0.unsafe_shl(52_u64)
      return {h, 0.0} if c0 == 0_u64
      g = trig_clz(c0)
      c0 = c0.unsafe_shl(g &+ 1_u64)
      {h, IyiFloatText.from_bits((f &- 64_u64 &- g).unsafe_shl(52_u64) | c0.unsafe_shr(12_u64))}
    else
      {0.0, 0.0}
    end
  end

  # cos.c reduce_fast: {i, h, l, err1} with i/2^11 + h + l ~ frac(x/(2pi)).
  private def self.cos_reduce_fast(x : Float64) : {Int32, Float64, Float64, Float64}
    if x <= 6.283185307179585
      h = 0.15915494309189535 * x
      l = fma(0.15915494309189535, x, h * -1.0)
      l = fma(-9.839338337591243e-18, x, l)
      err1 = 4.554824318475813e-32 * h
    else
      tu = IyiFloatText.bits_of(x)
      e = (tu.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
      m = 0x0010000000000000_u64 | (tu & 0xfffffffffffff_u64)
      tt = COS_T.to_unsafe
      if e <= 1074
        uh, ul = trig_mul64(m, tt[1])
        c0 = ul
        c1 = uh
        uh, ul = trig_mul64(m, tt[0])
        c1 = c1 &+ ul
        c2 = uh &+ (c1 < ul ? 1_u64 : 0_u64)
        e = 1075 - e
      else
        i = (e - 1138 + 63) // 64
        uh, ul = trig_mul64(m, tt[i + 2])
        c0 = ul
        c1 = uh
        uh, ul = trig_mul64(m, tt[i + 1])
        c1 = c1 &+ ul
        c2 = uh &+ (c1 < ul ? 1_u64 : 0_u64)
        c2 = c2 &+ m &* tt[i]
        e = 1139 + 64 * i - e
      end
      if e == 64
        c0 = c1
        c1 = c2
      else
        s = e.unsafe_to_u64
        c0 = c1.unsafe_shl(64_u64 &- s) | c0.unsafe_shr(s)
        c1 = c2.unsafe_shl(64_u64 &- s) | c1.unsafe_shr(s)
      end
      h, l = cos_set_dd(c1, c0)
      err1 = 1.3286588589133007e-23
    end
    i = (h * 2048.0).floor
    h = fma(i, -0.00048828125, h)
    {i.unsafe_to_i64.unsafe_to_i32, h, l, err1}
  end

  # cos.c s_mul: a * (bh + bl).
  private def self.cos_s_mul(a : Float64, bh : Float64, bl : Float64) : {Float64, Float64}
    hi = a * bh
    lo = fma(a, bh, hi * -1.0)
    {hi, fma(a, bl, lo)}
  end

  # cos.c d_mul: (ah + al) * (bh + bl) - al * bl.
  private def self.cos_d_mul(ah : Float64, al : Float64, bh : Float64, bl : Float64) : {Float64, Float64}
    hi = ah * bh
    s = fma(ah, bh, hi * -1.0)
    t = fma(al, bh, s)
    {hi, fma(ah, bl, t)}
  end

  # cos.c evalPSfast before its final d_mul by xh + xl, and evalPCfast.
  private def self.cos_eval_fast(uh : Float64, ul : Float64, p : Pointer(UInt64)) : {Float64, Float64}
    h = trig_at(p, 4)
    h = fma(h, uh, trig_at(p, 3))
    h = fma(h, uh, trig_at(p, 2))
    h, l = cos_s_mul(h, uh, ul)
    h, t = trig_fasttwosum(trig_at(p, 0), h)
    {h, l + (trig_at(p, 1) + t)}
  end

  # cos.c cos_fast: {h, l, err} with |h + l - cos(x)| < err, x > 0x1.6a09e667f3bccp-27.
  private def self.cos_fast(x : Float64) : {Float64, Float64, Float64}
    i, h, l, err1 = cos_reduce_fast(x)
    neg = i.unsafe_shr(10)
    i = i & 0x3ff
    is_cos = 1 ^ i.unsafe_shr(9)
    neg = neg ^ i.unsafe_shr(9)
    i = i & 0x1ff
    if i & 0x100 != 0
      is_cos = is_cos == 0 ? 1 : 0
      i = 0x1ff - i
      h = 0.00048828125 - h
      l = l * -1.0
    end
    sc = COS_SC.to_unsafe
    h = h - trig_at(sc, 3 * i)
    uh = h * h
    ul = fma(h, h, uh * -1.0)
    ul = fma(h + h, l, ul)
    sh, sl = cos_eval_fast(uh, ul, COS_PSFAST.to_unsafe)
    sh, sl = cos_d_mul(sh, sl, h, l)
    ch, cl = cos_eval_fast(uh, ul, COS_PCFAST.to_unsafe)
    if is_cos == 0
      sh, sl = cos_s_mul(trig_at(sc, 3 * i + 2), sh, sl)
      ch, cl = cos_s_mul(trig_at(sc, 3 * i + 1), ch, cl)
      h, l = trig_fasttwosum(ch, sh)
      l = l + (sl + cl)
      err = 2.2565487110446595e-21
    else
      ch, cl = cos_s_mul(trig_at(sc, 3 * i + 2), ch, cl)
      sh, sl = cos_s_mul(trig_at(sc, 3 * i + 1), sh, sl)
      h, l = trig_fasttwosum(ch, sh * -1.0)
      l = l + (cl - sl)
      err = 2.5477162866633252e-21
    end
    sgn = neg == 0 ? 1.0 : -1.0
    {h * sgn, l * sgn, err + err1}
  end

  # cos.c evalPS / evalPC: Horner over COS_PS or COS_PC, the odd one
  # multiplied by X at the end.
  private def self.cos_eval_acc(p : Pointer(UInt64), xh : UInt64, xl : UInt64, xex : Int64, xsg : UInt64, x2h : UInt64, x2l : UInt64, x2ex : Int64, x2sg : UInt64, odd : Bool) : {UInt64, UInt64, Int64, UInt64}
    ch, _, cex, csg = cos_dint_row(p, 5)
    yh, yl, yex, ysg = cos_mul_dint_21(x2h, x2l, x2ex, x2sg, ch, cex, csg)
    k = 4
    while k >= 0
      ch, cl, cex, csg = cos_dint_row(p, k)
      yh, yl, yex, ysg = cos_add_dint(yh, yl, yex, ysg, ch, cl, cex, csg)
      yh, yl, yex, ysg = cos_mul_dint(yh, yl, yex, ysg, x2h, x2l, x2ex, x2sg) if k > 0
      k -= 1
    end
    yh, yl, yex, ysg = cos_mul_dint(yh, yl, yex, ysg, xh, xl, xex, xsg) if odd
    {yh, yl, yex, ysg}
  end

  # cos.c cos_accurate: x > 0x1.6a09e667f3bccp-27.
  private def self.cos_accurate(x : Float64) : Float64
    tu = IyiFloatText.bits_of(x)
    fe = (tu.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i64
    m = (tu & 0xfffffffffffff_u64) &+ (fe != 0_i64 ? 0x0010000000000000_u64 : 0_u64)
    tz = trig_clz(m)
    xex = fe &- 0x3fe_i64 &- (tz > 11_u64 ? (tz &- 12_u64).unsafe_to_i64 : 0_i64)
    xh, xl, xex = cos_reduce(m.unsafe_shl(tz), xex)
    xsg = 0_u64
    # reduce2
    i = 0
    if xex > -11_i64
      sh = (64_i64 - 11_i64 - xex).unsafe_to_u64
      i = xh.unsafe_shr(sh).unsafe_to_i32
      xh = xh & (1_u64.unsafe_shl(sh) &- 1_u64)
      xh, xl, xex = cos_normalize(xh, xl, xex)
    end
    neg = false
    is_cos = true
    if i & 0x400 != 0
      neg = true
      i = i & 0x3ff
    end
    if i & 0x200 != 0
      neg = !neg
      is_cos = false
      i = i & 0x1ff
    end
    if i & 0x100 != 0
      is_cos = !is_cos
      xh, xl, xex, xsg = cos_add_dint(0x8000000000000000_u64, 0_u64, -10_i64, 0_u64, xh, xl, xex, 1_u64)
      i = 0x1ff - i
    end
    x2h, x2l, x2ex, x2sg = cos_mul_dint(xh, xl, xex, xsg, xh, xl, xex, xsg)
    uh, ul, uex, usg = cos_eval_acc(COS_PC.to_unsafe, xh, xl, xex, xsg, x2h, x2l, x2ex, x2sg, false)
    vh, vl, vex, vsg = cos_eval_acc(COS_PS.to_unsafe, xh, xl, xex, xsg, x2h, x2l, x2ex, x2sg, true)
    st = COS_S.to_unsafe
    ct = COS_C.to_unsafe
    if !is_cos
      uh, ul, uex, usg = cos_mul_dint(st[2 * i], st[2 * i + 1], COS_S_EX.to_unsafe[i], 0_u64, uh, ul, uex, usg)
      vh, vl, vex, vsg = cos_mul_dint(ct[2 * i], ct[2 * i + 1], COS_C_EX.to_unsafe[i], 0_u64, vh, vl, vex, vsg)
    else
      uh, ul, uex, usg = cos_mul_dint(ct[2 * i], ct[2 * i + 1], COS_C_EX.to_unsafe[i], 0_u64, uh, ul, uex, usg)
      vh, vl, vex, vsg = cos_mul_dint(st[2 * i], st[2 * i + 1], COS_S_EX.to_unsafe[i], 0_u64, vh, vl, vex, vsg)
      vsg = 1_u64 &- vsg
    end
    uh, ul, uex, usg = cos_add_dint(uh, ul, uex, usg, vh, vl, vex, vsg)
    lo0 = ul &- 41_u64
    hi0 = uh &- (lo0 > ul ? 1_u64 : 0_u64)
    lo1 = ul &+ 41_u64
    hi1 = uh &+ (lo1 < ul ? 1_u64 : 0_u64)
    if hi0.unsafe_shr(10_u64) != hi1.unsafe_shr(10_u64)
      exc = COS_EXCEPTIONS.to_unsafe
      k = 0
      while k < 5
        return trig_at(exc, 3 * k + 1) + trig_at(exc, 3 * k + 2) if x == trig_at(exc, 3 * k)
        k += 1
      end
    end
    usg = 1_u64 &- usg if neg
    cos_dint_tod(uh, ul, uex, usg)
  end

  def self.sin(value : Float64) : Float64
    tu = IyiFloatText.bits_of(value)
    au = tu.unsafe_shl(1_u64)
    if au <= 0x7cae26e892247dec_u64
      return value if au == 0_u64
      return fma(value, -5.551115123125783e-17, value)
    end
    e = tu.unsafe_shr(52_u64) & 0x7ff_u64
    return sin_moderate(value, tu.unsafe_shr(63_u64)) if e < 1054_u64
    return value - value if e == 0x7ff_u64
    sin_large(value)
  end

  def self.sin(value : Float32) : Float32
    sin(value.to_f64).to_f32
  end

  def self.sin(value : T) : Float64 forall T
    sin(value.to_f64)
  end

  def self.cos(value : Float64) : Float64
    tu = IyiFloatText.bits_of(value)
    if tu.unsafe_shr(52_u64) & 0x7ff_u64 == 0x7ff_u64
      # C's run-time 0.0 / 0.0: the default NaN, as inf - inf gives it.
      return value - value if tu.unsafe_shl(1_u64) == 0xffe0000000000000_u64
      return value + value
    end
    tu = tu & 0x7fffffffffffffff_u64
    ax = IyiFloatText.from_bits(tu)
    return fma(ax, -3.725290298461914e-09, 1.0) if tu <= 0x3e46a09e667f3bcc_u64
    h, l, err = cos_fast(ax)
    left = h + (l - err)
    right = h + (l + err)
    return left if left == right
    cos_accurate(ax)
  end

  def self.cos(value : Float32) : Float32
    cos(value.to_f64).to_f32
  end

  def self.cos(value : T) : Float64 forall T
    cos(value.to_f64)
  end

  # tan: CORE-MATH's correctly rounded cr_tan (tan.c at revision
  # b1a4badf6765), ported operation for operation. Copyright (c) 2022-2025
  # Paul Zimmermann and Tom Hubrecht; MIT licence. A u128 is two UInt64
  # words (hi, lo); a dint64_t is the tuple {hi, lo, ex, sgn}. Round to
  # nearest only: dint_tod's subnormalize_dint (the one fegetround branch)
  # and its overflow and underflow branches are left out, as no finite
  # double past 2^-27 has a tangent near either end of the exponent range.
  # Tables hold the C files' values in their order (doubles as bits, each
  # dint64_t as hi, lo, ex, sgn).

  private TAN_T = [
    0x28be60db9391054a_u64, 0x7f09d5f47d4d3770_u64, 0x36d8a5664f10e410_u64, 0x7f9458eaf7aef158_u64,
    0x6dc91b8e909374b8_u64, 0x01924bba82746487_u64, 0x3f877ac72c4a69cf_u64, 0xba208d7d4baed121_u64,
    0x3a671c09ad17df90_u64, 0x4e64758e60d4ce7d_u64, 0x272117e2ef7e4a0e_u64, 0xc7fe25fff7816603_u64,
    0xfbcbc462d6829b47_u64, 0xdb4d9fb3c9f2c26d_u64, 0xd3d18fd9a797fa8b_u64, 0x5d49eeb1faf97c5e_u64,
    0xcf41ce7de294a4ba_u64, 0x9afed7ec47e35742_u64, 0x1580cc11bf1edaea_u64, 0xfc33ef0826bd0d87_u64,
  ]
  private TAN_TINV = [
    0xff00ff00ff00ff02_u64, 0xfe03f80fe03f80ff_u64, 0xfd08e5500fd08e56_u64, 0xfc0fc0fc0fc0fc11_u64,
    0xfb18856506ddaba7_u64, 0xfa232cf252138ac1_u64, 0xf92fb2211855a867_u64, 0xf83e0f83e0f83e11_u64,
    0xf74e3fc22c700f76_u64, 0xf6603d980f6603db_u64, 0xf57403d5d00f5742_u64, 0xf4898d5f85bb3952_u64,
    0xf3a0d52cba872338_u64, 0xf2b9d6480f2b9d66_u64, 0xf1d48bcee0d399fc_u64, 0xf0f0f0f0f0f0f0f2_u64,
    0xf00f00f00f00f010_u64, 0xef2eb71fc4345239_u64, 0xee500ee500ee5010_u64, 0xed7303b5cc0ed731_u64,
    0xec979118f3fc4da3_u64, 0xebbdb2a5c1619c8d_u64, 0xeae56403ab959010_u64, 0xea0ea0ea0ea0ea10_u64,
    0xe939651fe2d8d35d_u64, 0xe865ac7b7603a198_u64, 0xe79372e225fe30da_u64, 0xe6c2b4481cd8568a_u64,
