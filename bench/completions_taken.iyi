# Windows' one completion port, exercised: SPEC.md III.4.13, part 5.
#
#   ./bin/iyi run bench/completions_taken.iyi                # both steps
#   ./bin/iyi run bench/completions_taken.iyi -- taken       # one of them
#
# `taken`: a reader parks on a socket, and a sibling holds its worker on a
# release word with preemption off. A spare waits in the shared port when
# the answer is sent. The healthy read must finish on another worker before
# the owner is released. The mutant exits when the armed reader's packet
# is dispatched homebound; it does not observe a later read.
#
# `boost`: the process's dynamic priority boost is off once the pool has
# started (`IyiWorkers.start`), as `GetProcessPriorityBoost` reads it.
#
# bench/parallel_exercise.sh runs both on Windows, at twelve workers, and
# a broken copy of the runtime each: a port whose packets only the thread
# their task parked on takes, and a pool that leaves the boost on.

@[Unsafe("on Windows it asks whether the process's priority boost is off through GetProcessPriorityBoost, a C call answering through pointerof")]
module bench/completions_taken

import std/socket::{IyiSocket, SocketError}

{% if flag?(:win32) && flag?(:x86_64) && !flag?(:gc_none) && !flag?(:gc_boehm) %}
  lib LibBoost
    fun GetProcessPriorityBoost(h_process : Void*, disabled : Int32*) : Int32
  end

  COMPUTE_MS = 1500_i64

  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  # Atomic observations shared by the reader and its holding sibling.
  # The forced round uses their worker identities and the read time.
  class Marks
    @reader : Atomic(UInt64)
    @read_on : Atomic(UInt64)
    @computer : Atomic(UInt64)
    @computing : Atomic(Int64)
    @read_at : Atomic(Int64)
    @computed_until : Atomic(Int64)
    @deadline : Atomic(Int64)

    def initialize
      @reader = Atomic(UInt64).new(0_u64)
      @read_on = Atomic(UInt64).new(0_u64)
      @computer = Atomic(UInt64).new(0_u64)
      @computing = Atomic(Int64).new(0_i64)
      @read_at = Atomic(Int64).new(0_i64)
      @computed_until = Atomic(Int64).new(0_i64)
      @deadline = Atomic(Int64).new(0_i64)
    end

    def reader : UInt64
      @reader.get
    end

    def note_reader(id : UInt64) : Nil
      @reader.set(id)
    end

    def read_on : UInt64
      @read_on.get
    end

    def note_read_on(id : UInt64) : Nil
      @read_on.set(id)
    end

    def computer : UInt64
      @computer.get
    end

    def note_computer(id : UInt64) : Nil
      @computer.set(id)
    end

    # 0 until the sibling has started, then 1 when it computes on the
    # reader's worker and 2 when it ran elsewhere.
    def computing : Int64
      @computing.get
    end

    def note_computing(how : Int64) : Nil
      @computing.set(how)
    end

    def read_at : Int64
      @read_at.get
    end

    def note_read_at(ns : Int64) : Nil
      @read_at.set(ns)
    end

    def computed_until : Int64
      @computed_until.get
    end

    def note_computed_until(ns : Int64) : Nil
      @computed_until.set(ns)
    end

    # Retained deadline field; the forced round does not use it.
    def deadline : Int64
      @deadline.get
    end

    def note_deadline(ns : Int64) : Nil
      @deadline.set(ns)
    end
  end

  # Retained timed computation helper; the forced round uses a release word.
  @[NoPreempt]
  def compute(deadline : Int64) : UInt64
    x = 1_u64
    while __iyi_monotonic_ns < deadline
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
    end
    x
  end

  # Counts the holders share: `Share` by its atomic field.
  class Tally
    @count : Atomic(Int64)

    def initialize
      @count = Atomic(Int64).new(0_i64)
    end

    def add(value : Int64) : Nil
      @count.add(value)
    end

    def count : Int64
      @count.get
    end
  end

  # A spin with preemption off until *count* reaches *target*: the task holding
  # a worker in it keeps the worker, and the wait ends on a word another task
  # sets, never on a clock.
  @[NoInline]
  @[NoPreempt]
  def hold_until(count : Tally, target : Int64, what : String) : Nil
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    while count.count < target
      IyiThread.spin_pause
      fail("#{what}: the hold did not release in 20000 ms") if __iyi_monotonic_ns > limit
    end
  end

  # A slot a task notes its fiber or worker in.
  class Slot
    @value : Atomic(UInt64)

    def initialize
      @value = Atomic(UInt64).new(0_u64)
    end

    def value : UInt64
      @value.get
    end

    def note(id : UInt64) : Nil
      @value.set(id)
    end
  end

  # Whether the fiber with object id *id* is in *state* now, read from the scheduler's list of every fiber.
  def fiber_in_state?(id : UInt64, state : IyiFiberState) : Bool
    fiber = IyiScheduler.first_fiber
    while fiber.is_a?(IyiFiber)
      return fiber.state == state if fiber.object_id == id
      fiber = fiber.next_fiber
    end
    false
  end

  # A spin with preemption off until *count* reaches *target*. Its limit ends a hang as a named failure.
  @[NoInline]
  @[NoPreempt]
  def hold_until_or_fail(count : Tally, target : Int64, what : String) : Nil
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    while count.count < target
      IyiThread.spin_pause
      fail("#{what}: the hold did not release in 20000 ms") if __iyi_monotonic_ns > limit
    end
  end

  # The main thread's wait for *count* to reach *target*, with a named limit.
  def wait_or_fail(count : Tally, target : Int64, what : String) : Nil
    limit = __iyi_monotonic_ns + 10_000_000_000_i64
    while count.count < target
      sleep(1)
      fail("#{what}: no progress in 10000 ms") if __iyi_monotonic_ns > limit
    end
  end

  # Every worker but one is held while the reader parks. Its sibling holds
  # that worker on a release word; a spare waits in the port before main
  # sends the answer. In a forced copy, the armed reader's dispatch records
  # whether it was made homebound. The healthy read must finish on a spare
  # before main releases the sibling. Each wait has a named progress limit.
  def forced_round(listener : IyiSocket, port : Int32) : Nil
    near = IyiSocket.connect("127.0.0.1", port, 5000)
    fail("taken: connect answered #{near}") unless near.is_a?(IyiSocket)
    far = listener.accept
    fail("taken: accept answered #{far}") unless far.is_a?(IyiSocket)
    far_fd = far.fd
    marks = Marks.new
    reader = Slot.new
    owner = Slot.new
    holders = IyiWorkers.count - 1
    parked = Tally.new
    release = Tally.new
    spare = Tally.new
    owner_go = Tally.new
    group do |g|
      (holders - 1).times do
        g.spawn(unit: :new) do
          parked.add(1_i64)
          hold_until_or_fail(release, 1_i64, "taken: progress hang: a holder was not released")
          0
        end
      end
      g.spawn(unit: :new) do
        parked.add(1_i64)
        hold_until_or_fail(spare, 1_i64, "taken: progress hang: the spare was not released")
        0
      end
      wait_or_fail(parked, holders.to_i64, "taken: progress hang: the holders did not start")
      g.spawn(unit: :new) do
        reader.note(IyiScheduler.current.object_id)
        group do |inner|
          inner.spawn(unit: :new) do
            here = IyiScheduler.state.object_id
            owner.note(here)
            marks.note_computer(here)
            marks.note_computing(here == marks.reader ? 1_i64 : 2_i64)
            hold_until_or_fail(owner_go, 1_i64, "taken: progress hang: the computing sibling was not released")
            0
          end
          marks.note_reader(IyiScheduler.state.object_id)
          got = IyiSocket.new(far_fd).read(1).or_panic
          marks.note_read_at(__iyi_monotonic_ns)
          marks.note_read_on(IyiScheduler.state.object_id)
          fail("taken: progress hang: the read answered #{got.inspect}") unless got == "x"
        end
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while reader.value == 0_u64 || !fiber_in_state?(reader.value, IyiFiberState::WaitingIo)
        sleep(1)
        fail("taken: progress hang: the reader did not park on its read in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while owner.value == 0_u64
        sleep(1)
        fail("taken: progress hang: the sibling did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      fail("taken: not armed: the sibling did not start on its reader's worker") unless owner.value == marks.reader
      {% if flag?(:nocross_force) %}
        IyiScheduler.force_dispatch_target(reader.value)
      {% end %}
      spare.add(1_i64)
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiScheduler.waiting_threads < 1_u64
        sleep(1)
        fail("taken: progress hang: no spare waited in the port in 10000 ms") if __iyi_monotonic_ns > limit
      end
      wrote = near.write("x")
      fail("taken: progress hang: the send answered #{wrote}") unless wrote.is_a?(Int32)
      {% if flag?(:nocross_force) %}
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiScheduler.force_dispatch_fiber != reader.value
        sleep(1)
        fail("taken: progress hang: the packet was not dispatched in 10000 ms") if __iyi_monotonic_ns > limit
      end
      fail("taken: the packet's fiber was made homebound to the worker it parked on, so its answer waits for that worker") if IyiScheduler.force_dispatch_homebound == 1_u64
      {% end %}
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while marks.read_on == 0_u64
        sleep(1)
        fail("taken: progress hang: the answer was not read in 10000 ms") if __iyi_monotonic_ns > limit
      end
      elsewhere = marks.read_on != owner.value
      owner_go.add(1_i64)
      release.add(1_i64)
      fail("taken: not armed: the answer was read on the worker that computed") unless elsewhere
      puts "taken: a packet's answer was read on another worker while its reader's worker computed"
    end
    near.close
    far.close
  end

  def taken : Nil
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    forced_round(listener, port)
    listener.close
  end

  def boost : Nil
    # The pool starts at the first parallel task.
    group do |g|
      g.spawn(unit: :new) { 0 }
    end
    disabled = 0
    if LibBoost.GetProcessPriorityBoost(::LibC.GetCurrentProcess, pointerof(disabled)) == 0
      fail("boost: GetProcessPriorityBoost failed")
    end
    fail("boost: the process's priority boost is on with the pool started") if disabled == 0
    puts "boost: off with the pool started"
  end

  STEPS = ["boost", "taken"]

  workers = 12
  chosen = [] of String
  Program.args.each do |argument|
    if argument.starts_with?("--workers=")
      workers = argument[10, argument.size - 10].to_i
    else
      fail("no step named #{argument}") unless STEPS.includes?(argument)
      chosen << argument
    end
  end
  chosen = STEPS if chosen.empty?
  IyiWorkers.count = workers
  chosen.each do |name|
    case name
    when "boost" then boost
    when "taken" then taken
    end
  end
  puts "completions taken: every property held on #{IyiWorkers.count} workers"
{% else %}
  puts "completions taken: one completion port is Windows', nothing to hold here"
{% end %}
