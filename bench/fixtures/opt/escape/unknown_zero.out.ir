; iyi-ir 1
source_filename = "escape_unknown_zero"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Record = type { i64, i64 }
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @unknown_zero() {
entry:
  %0 = alloca %Record, align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 16, i1 false)
  store i64 0, ptr %0, align 8
  %first = load i64, ptr %0, align 8
  ret i64 %first
}
