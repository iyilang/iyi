ascii "Bücher.EXAMPLE.", "xn--bcher-kva.example.", "ASCII letters lower-cased, a trailing dot kept"
ascii "XN--BCHER-KVA.de", "xn--bcher-kva.de", "an A-label lower-cased"
ascii "Example.COM", "example.com", "an ASCII name lower-cased"
ascii "_dmarc.example.com", "_dmarc.example.com", "an underscore label"
ascii "127.0.0.1", "127.0.0.1", "an IPv4 address"
puts "  real IDN names, stops, case, trailing dots"

puts "\n== to_unicode"
unicode "xn--bcher-kva.example", "bücher.example", "an A-label decoded"
unicode "XN--R8JZ45G.xn--zckzah", "例え.テスト", "A-labels in any case"
unicode "Bücher.Example.", "bücher.example.", "a U-label kept, ASCII lower-cased"
unicode "例え。テスト", "例え.テスト", "the stops written as dots"
["bücher.example", "例え.テスト", "пример.испытание", "مثال.إختبار", "faß.de", "col·lecció.cat"].each do |name|
  there = IDNA.to_ascii(name)
  raise "ASSERTION FAILED: #{name} refused" if there.is_a?(IdnaError)
  unicode there, name, "#{name} comes back from #{there}"
end
puts "  A-labels decoded, and names come back from their ASCII form"

puts "\n== labels refused"
refused_name "", "IDNA: the name is empty", "an empty name"
refused_name ".", "IDNA: the name is empty", "the root alone"
refused_name "a..b", "IDNA: label 2 of \"a..b\" is empty", "an empty label"
refused_name ".a", "IDNA: label 1 of \".a\" is empty", "a leading dot"
refused_name "-a.com", "IDNA: label \"-a\" begins with a hyphen", "a leading hyphen"
refused_name "a-.com", "IDNA: label \"a-\" ends with a hyphen", "a trailing hyphen"
refused_name "ab--c.com", "IDNA: label \"ab--c\" has \"--\" at its third and fourth characters and is not an A-label", "-- at three and four"
refused_name "üb--c.com", "IDNA: label \"üb--c\" has \"--\" at its third and fourth characters and is not an A-label", "-- at three and four in a U-label"
refused_name "a b.com", "IDNA: label \"a b\" holds ' ', which a host name does not", "a space"
refused_name "a/b.com", "IDNA: label \"a/b\" holds '/', which a host name does not", "a slash"
refused_name "xn--abc-.com", "IDNA: label \"xn--abc-\" is not an A-label: it decodes to \"abc\", which is all ASCII", "a fake A-label"
refused_name "xn--.com", "IDNA: label \"xn--\" is not an A-label: it decodes to \"\", which is all ASCII", "an empty A-label"
refused_name "xn--a-9.com", "IDNA: label \"xn--a-9\" is not an A-label: Punycode: the input ends inside a number", "an A-label that does not decode"
refused_name "xn--ib9b.com", "IDNA: label \"xn--ib9b\" is not an A-label: Punycode: the number ending at byte 3 is U+D800, a surrogate, which UTF-8 does not hold", "an A-label of a surrogate"
refused_name "BÜCHER.de", "IDNA: label \"BÜCHER\" holds U+00DC, which IDNA2008 does not allow; case folding and NFKC make it \"ü\", which UTS #46 would map it to and this module does not", "upper case is not mapped"
refused_name "ｅｘａｍｐｌｅ.com", "IDNA: label \"ｅｘａｍｐｌｅ\" holds U+FF45, which IDNA2008 does not allow; case folding and NFKC make it \"e\", which UTS #46 would map it to and this module does not", "full width is not mapped"
refused_name "ﬁ.example", "IDNA: label \"ﬁ\" holds U+FB01, which IDNA2008 does not allow; case folding and NFKC make it \"fi\", which UTS #46 would map it to and this module does not", "a ligature is not mapped"
refused_name "☃.net", "IDNA: label \"☃\" holds U+2603, which IDNA2008 does not allow", "a symbol"
refused_name "xn--n3h.net", "IDNA: label \"xn--n3h\" holds U+2603, which IDNA2008 does not allow", "a symbol as an A-label"
refused_name "u\u0308.de", "IDNA: label \"u\u0308\" is not in NFC; its NFC form is \"ü\"", "not NFC"
refused_name "\u0301a.de", "IDNA: label \"\u0301a\" begins with the combining mark U+0301", "a leading combining mark"
refused_name "a\u200Db.de", "IDNA: label #{"a\u200Db".inspect} holds U+200D, a joiner whose context rule needs Joining_Type and Virama, which this module does not carry; it refuses the joiners", "a joiner"
refused_name "\u0378.com", "IDNA: label \"\u0378\" holds U+0378, which Unicode 17.0.0 has not assigned", "an unassigned code point"
bad = String.new(3) { |b| b[0] = 97_u8; b[1] = 0xFF_u8; b[2] = 98_u8 }
refused_name bad, "IDNA: #{bad.inspect} is not UTF-8", "bytes that are not UTF-8"
puts "  empty labels, hyphens, bytes, fake A-labels, what UTS #46 would map, symbols, NFC, marks, joiners"

puts "\n== lengths"
ascii "a" * 63 + ".com", "a" * 63 + ".com", "a 63-octet label"
refused_name "a" * 64 + ".com", "IDNA: label \"#{"a" * 64}\" is 64 octets, past the 63 a DNS label holds", "a 64-octet label"
# 62 octets of UTF-8, 68 of A-label: the limit is the ASCII form's.
refused_name "a" * 60 + "ü.de", "IDNA: label \"xn--#{"a" * 60}-3hg\" is 68 octets, past the 63 a DNS label holds", "a U-label whose A-label is long"
name253 = (["a" * 63] * 3).join(".") + "." + "a" * 61
ascii name253, name253, "a 253-octet name"
ascii name253 + ".", name253 + ".", "a 253-octet name and its trailing dot"
refused_name name253 + "a", "IDNA: the name is 254 octets in ASCII, past the 253 a DNS name holds", "a 254-octet name"
# 149 octets of UTF-8, 399 of A-labels: the limit is the ASCII form's.
short = (["ü"] * 50).join(".")
refused_name short, "IDNA: the name is 399 octets in ASCII, past the 253 a DNS name holds", "a name long only in ASCII"
puts "  63 and 253 octets taken, 64 and 254 refused, counted in the ASCII form"

puts "\n== context rules"
ascii "col·lecció.cat", "xn--collecci-ioa91d.cat", "a middle dot between two l"
refused_name "a·b.cat", "IDNA: label \"a·b\" holds U+00B7 where RFC 5892's context rule for it does not allow it", "a middle dot elsewhere"
ascii "κ͵α.gr", "xn--wva4jza.gr", "a keraia before Greek"
refused_name "a͵.gr", "IDNA: label \"a͵\" holds U+0375 where RFC 5892's context rule for it does not allow it", "a keraia at the end"
ascii "א׳ב.il", "xn--4dbc5h.il", "a geresh after Hebrew"
refused_name "a׳.il", "IDNA: label \"a׳\" holds U+05F3 where RFC 5892's context rule for it does not allow it", "a geresh after Latin"
ascii "ア・カ.jp", "xn--ccks3v.jp", "a katakana middle dot among katakana"
refused_name "a・b.jp", "IDNA: label \"a・b\" holds U+30FB where RFC 5892's context rule for it does not allow it", "a katakana middle dot among Latin"
refused_name "ب٠۱.eg", "IDNA: label \"ب٠۱\" holds U+0660 where RFC 5892's context rule for it does not allow it", "Arabic-Indic digits of both kinds"
puts "  appendix A.3 to A.9, each met and broken"

puts "\n== property"
[{'a', IdnaProperty::PValid}, {'-', IdnaProperty::PValid}, {'A', IdnaProperty::Disallowed}, {'_', IdnaProperty::Disallowed},
 {'ß', IdnaProperty::PValid}, {'ς', IdnaProperty::PValid}, {'ü', IdnaProperty::PValid}, {'Ü', IdnaProperty::Disallowed},
 {'\u00B7', IdnaProperty::ContextO}, {'\u0660', IdnaProperty::ContextO}, {'\u200C', IdnaProperty::ContextJ},
 {'\u0640', IdnaProperty::Disallowed}, {'\u3007', IdnaProperty::PValid}, {'\u1100', IdnaProperty::Disallowed},
 {'\u20D0', IdnaProperty::Disallowed}, {'\u034F', IdnaProperty::Disallowed}, {'\u0378', IdnaProperty::Unassigned},
 {'\uFDD0', IdnaProperty::Disallowed}, {'\u{1CCF0}', IdnaProperty::Disallowed}, {'☃', IdnaProperty::Disallowed}].each do |pair|
  assert_true IDNA.property(pair[0]) == pair[1], "#{IDNA.u_plus(pair[0].ord.to_i64)} is #{pair[1]}, not #{IDNA.property(pair[0])}"
end
puts "  exceptions, LDH, joiners, unstable, ignorable, jamo, blocks, unassigned"

puts "\nALL CHECKS PASSED"
