# A `Float64` as text — SPEC.md, "0.1.0", item 3, the one it left out.
#
# `puts 0.75` printed "Float64" through `Object#to_s` for ten releases,
# because no sample had asked for a float in writing. A program that
# computes an average and prints it asks, and a reader who gets the type's
# name back has been told nothing and warned of nothing. So: the shortest
# decimal that reads back as the same double, which is what every language
# with a float printer worth the name prints (Steele & White's free-format
# algorithm with Burger & Dybvig's scaling, Dragon4's family), on a small
# unsigned bignum of 32-bit limbs, because the boundaries between one
# double and the next are exact rationals with up to eleven hundred bits
# in them and no floating arithmetic can compare them. No table of powers,
# no libc: the prelude links nothing, and `bench/dependency_floor.sh`
# audits that.
#
# The notation is Crystal's: `1.0`, `0.1`, `123.456`, `0.0001`, then
# `1.0e-5` below that and `1.0e+15` from ten to the fifteenth up (Crystal's
# `Float::Printer`, point range -3 to 15), always a fractional part, `-0.0`,
# `Infinity`, `-Infinity`, `NaN`.
struct Float64
  def to_s : String
    bits = IyiFloatText.bits_of(self)
    IyiFloatText.text(bits)
  end

  # A whole power, by squaring: `2.0 ** 10`. A negative exponent is one
  # over the positive one.
  def **(exponent : Int32) : Float64
    return 1.0 / (self ** -exponent) if exponent < 0
    result = 1.0
    base = self
    while exponent > 0
      result = result * base if exponent % 2 == 1
      exponent = exponent // 2
      # Not squared past the last use: `2 ** 30` fits and its base's
      # next square does not.
      base = base * base if exponent > 0
    end
    result
  end

  def abs : Float64
    self < 0.0 ? 0.0 - self : self
  end

  # The integer below, above and nearest, as a `Float64`. Past 2^53 every
  # double is an integer already and is answered as it is; the conversion
  # below is exact under it.
  def floor : Float64
    return self if self != self || abs >= 9007199254740992.0
    truncated = to_i64.to_f64
    truncated > self ? truncated - 1.0 : truncated
  end

  def ceil : Float64
    return self if self != self || abs >= 9007199254740992.0
    truncated = to_i64.to_f64
    truncated < self ? truncated + 1.0 : truncated
  end

  # The nearest integer, a tie to the even one — Crystal's `round`, so the
  # name means one thing in both libraries (SPEC.md III.1.7a): `2.5.round`
  # is 2.0 and `3.5.round` is 4.0. `std/number` names the other modes.
  # The magnitude's fraction decides, not a sum: `(x + 0.5).floor` rounded
  # the sum first, and 0.49999999999999994 + 0.5 is 1.0. The sign goes
  # back by a multiplication, so `(-0.25).round` is -0.0, as there.
  def round : Float64
    return self if self != self || abs >= 9007199254740992.0
    magnitude = abs
    whole = magnitude.floor
    fraction = magnitude - whole
    nearest = if fraction < 0.5
                whole
              elsif fraction > 0.5
                whole + 1.0
              else
                (whole / 2.0).floor * 2.0 == whole ? whole : whole + 1.0
              end
    self < 0.0 ? nearest * -1.0 : nearest
  end

  # To `digits` places, a tie to the even one: scaled, rounded, scaled
  # back, so `3.14159.round(2)` is the double nearest 3.14. A negative
  # `digits` rounds to tens, hundreds, ...: `1234.0.round(-2)` is 1200.0,
  # and `25.0.round(-1)` is 20.0. The scale for those divides first rather
  # than multiplying by a fraction, which no double spells exactly.
  def round(digits : Int32) : Float64
    return round if digits == 0
    if digits < 0
      scale = 10.0 ** (0 - digits)
      (self / scale).round * scale
    else
      scale = 10.0 ** digits
      (self * scale).round / scale
    end
  end
end

# An integer divided by a float is a float, as in Crystal; the integer
# division that stays an integer is `//`.
struct Int32
  def /(other : Float64) : Float64
    to_f64 / other
  end
end

struct Int64
  def /(other : Float64) : Float64
    to_f64 / other
  end
end

class String
  # The double nearest the decimal written here, correctly rounded: the
  # digits and the exponent are read into the printer's bignum and the
  # quotient taken to 54 bits with a sticky remainder, so what `to_s`
  # wrote reads back as the same double, every time, and "0.1" is the
  # double the literal `0.1` is. Accepts `-1.5`, `2.5e-3`, `1E10`, `.5`,
  # `7.`, `Infinity`, `NaN`; raises "not a number" for anything else.
  def to_f : Float64
    IyiFloatText.parse(self)
  end
end

# The bignum the printer needs and nothing more: unsigned, 32-bit limbs in
# 64-bit words so a limb product and a carry fit, little-endian. Eighty
# limbs holds anything a double asks (2^1076 times 10^308 is under 2^2100;
# sixty-six limbs), and every number was made that size: six of them per
# double printed, 3.8 KB of garbage, and most of the time `to_s` took. The
# printer now asks for what the one value in hand needs - a handful of
# limbs for most - and a number that outgrows its estimate doubles
# (`room`) rather than writing past it.
class IyiBig
  LIMBS =             80
  BASE  = 4294967296_u64
  MASK  = 4294967295_u64

  @limbs : Pointer(UInt64)
  @size : Int32
  @capacity : Int32

  def initialize(value : UInt64, capacity : Int32 = LIMBS)
    @capacity = capacity
    @limbs = Pointer(UInt64).malloc(capacity.to_u64)
    @size = 0
    while value != 0_u64
      @limbs[@size] = value & MASK
      value = value.unsafe_shr(32_u64)
      @size = @size + 1
    end
  end

  def size : Int32
    @size
  end

  def limb(index : Int32) : UInt64
    @limbs[index]
  end

  def copy : IyiBig
    other = IyiBig.new(0_u64, @capacity)
    index = 0
    while index < @size
      other.set_limb(index, @limbs[index])
      index = index + 1
    end
    other.set_size(@size)
    other
  end

  protected def set_limb(index : Int32, value : UInt64) : Nil
    @limbs[index] = value
  end

  protected def set_size(size : Int32) : Nil
    @size = size
  end

  # Room for *limbs*, doubling past it. The printer sizes a number to the
  # value it prints, and that size is an estimate: past it this grows
  # rather than writing beyond the buffer.
  protected def room(limbs : Int32) : Nil
    return if limbs <= @capacity
    capacity = @capacity
    while capacity < limbs
      capacity = capacity * 2
    end
    @limbs = @limbs.realloc(capacity.to_u64)
    @capacity = capacity
  end

  # self * small, small under 2^32.
  def mul_small(small : UInt64) : Nil
    carry = 0_u64
    index = 0
    while index < @size
      product = @limbs[index] * small + carry
      @limbs[index] = product & MASK
      carry = product.unsafe_shr(32_u64)
      index = index + 1
    end
    if carry != 0_u64
      room(@size + 1)
      @limbs[@size] = carry
      @size = @size + 1
    end
  end

  def mul_pow10(count : Int32) : Nil
    while count > 0
      mul_small(10_u64)
      count = count - 1
    end
  end

  # self * 2^bits.
  def shl(bits : Int32) : Nil
    return if @size == 0
    words = bits // 32
    rest = (bits % 32).to_u64
    room(@size + words + 1)
    if rest != 0_u64
      carry = 0_u64
      index = 0
      while index < @size
        shifted = @limbs[index].unsafe_shl(rest) | carry
        @limbs[index] = shifted & MASK
        carry = shifted.unsafe_shr(32_u64)
        index = index + 1
      end
      if carry != 0_u64
        @limbs[@size] = carry
        @size = @size + 1
      end
    end
    if words > 0
      index = @size - 1
      while index >= 0
        @limbs[index + words] = @limbs[index]
        index = index - 1
      end
      index = 0
      while index < words
        @limbs[index] = 0_u64
        index = index + 1
      end
      @size = @size + words
    end
  end

  def add(other : IyiBig) : Nil
    carry = 0_u64
    index = 0
    top = @size > other.size ? @size : other.size
    room(top + 1)
    while index < top
      a = index < @size ? @limbs[index] : 0_u64
      b = index < other.size ? other.limb(index) : 0_u64
      sum = a + b + carry
      @limbs[index] = sum & MASK
      carry = sum.unsafe_shr(32_u64)
      index = index + 1
    end
    @size = top
    if carry != 0_u64
      @limbs[@size] = carry
      @size = @size + 1
    end
  end

  # self - other, self not below other.
  def sub(other : IyiBig) : Nil
    borrow = 0_u64
    index = 0
    while index < @size
      b = index < other.size ? other.limb(index) : 0_u64
      a = @limbs[index]
      if a >= b + borrow
        @limbs[index] = a - b - borrow
        borrow = 0_u64
      else
        @limbs[index] = a + BASE - b - borrow
        borrow = 1_u64
      end
      index = index + 1
    end
    while @size > 0 && @limbs[@size - 1] == 0_u64
      @size = @size - 1
    end
  end

  def add_small(small : UInt64) : Nil
    carry = small
    index = 0
    while carry != 0_u64
      if index == @size
        room(@size + 1)
        @limbs[index] = carry & MASK
        carry = carry.unsafe_shr(32_u64)
        @size = @size + 1
      else
        sum = @limbs[index] + carry
        @limbs[index] = sum & MASK
        carry = sum.unsafe_shr(32_u64)
      end
      index = index + 1
    end
  end

  def bit_length : Int32
    return 0 if @size == 0
    top = @limbs[@size - 1]
    bits = 0
    while top != 0_u64
      top = top.unsafe_shr(1_u64)
      bits = bits + 1
    end
    (@size - 1) * 32 + bits
  end

  def low_bit : UInt64
    @size == 0 ? 0_u64 : @limbs[0] & 1_u64
  end

  def shr1 : Nil
    index = @size - 1
    carry = 0_u64
    while index >= 0
      value = @limbs[index]
      @limbs[index] = value.unsafe_shr(1_u64) | carry
      carry = (value & 1_u64).unsafe_shl(31_u64)
      index = index - 1
    end
    @size = @size - 1 if @size > 0 && @limbs[@size - 1] == 0_u64
  end

  # The low 64 bits.
  def to_u64 : UInt64
    low = @size > 0 ? @limbs[0] : 0_u64
    high = @size > 1 ? @limbs[1] : 0_u64
    low | high.unsafe_shl(32_u64)
  end

  # self / other into `quotient`, self reduced to the remainder; answers
  # whether a remainder was left. Binary long division, a bit at a time:
  # the quotients here are a few dozen bits.
  def divide(other : IyiBig, quotient : IyiBig) : Bool
    shift = bit_length - other.bit_length
    return @size != 0 if shift < 0
    divisor = other.copy
    divisor.shl(shift)
    bit = IyiBig.new(1_u64)
    bit.shl(shift)
    while shift >= 0
      if compare(divisor) >= 0
        sub(divisor)
        quotient.add(bit)
      end
      divisor.shr1
      bit.shr1
      shift = shift - 1
    end
    @size != 0
  end

  # -1, 0, 1 for self against other.
  def compare(other : IyiBig) : Int32
    return @size < other.size ? -1 : 1 if @size != other.size
    index = @size - 1
    while index >= 0
      a = @limbs[index]
      b = other.limb(index)
      return a < b ? -1 : 1 if a != b
      index = index - 1
    end
    0
  end

  # The compare of self + addend against other, the sum made in *scratch*
  # rather than in a number of its own: the digit loop asks twice a digit.
  def compare_sum(addend : IyiBig, other : IyiBig, scratch : IyiBig) : Int32
    copy_into(scratch)
    scratch.add(addend)
    scratch.compare(other)
  end

  # Self's value written over *target*'s, which is answered.
  def copy_into(target : IyiBig) : IyiBig
    target.room(@size)
    index = 0
    while index < @size
      target.set_limb(index, @limbs[index])
      index = index + 1
    end
    target.set_size(@size)
    target
  end

  # floor(self / other) for a quotient under ten, self reduced to the
  # remainder: the digit loop's one division, by subtraction.
  def divide_digit(other : IyiBig) : Int32
    digit = 0
    while compare(other) >= 0
      sub(other)
      digit = digit + 1
    end
    digit
  end
end

module IyiFloatText
  def self.bits_of(value : Float64) : UInt64
    holder = value
    pointerof(holder).as(Pointer(UInt64)).value
  end

  def self.from_bits(bits : UInt64) : Float64
    holder = Pointer(UInt64).malloc(1_u64)
    holder.value = bits
    Pointer(Float64).new(holder.address).value
  end

  def self.tail_is?(bytes : Pointer(UInt8), word : String) : Bool
    index = 0
    while index < word.bytesize
      return false if bytes[index] != word.to_unsafe[index]
      index = index + 1
    end
    true
  end

  def self.parse(text : String) : Float64
    bytes = text.to_unsafe
    size = text.bytesize
    raise "not a number: #{text.inspect}" if size == 0
    at = 0
    negative = false
    if bytes[0] == 45_u8 || bytes[0] == 43_u8
      negative = bytes[0] == 45_u8
      at = 1
    end
    rest = size - at
    if rest == 8 && tail_is?(bytes + at, "Infinity")
      return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64)
    end
    return from_bits(9221120237041090560_u64) if rest == 3 && tail_is?(bytes + at, "NaN")

    # Every digit into the bignum, the point's position remembered; the
    # exponent read after. Digits past the nineteenth are folded into the
    # exponent - enough for the mantissa's 17 significant digits and a
    # margin, the rest only moving the point.
    mantissa = IyiBig.new(0_u64)
    exponent = 0
    digits = 0
    seen_point = false
    any = false
    while at < size
      byte = bytes[at]
      if byte >= 48_u8 && byte <= 57_u8
        any = true
        if digits < 19
          mantissa.mul_small(10_u64)
          mantissa.add_small((byte - 48_u8).to_u64)
          digits = digits + 1 if digits > 0 || byte != 48_u8
          exponent = exponent - 1 if seen_point
        else
          exponent = exponent + 1 unless seen_point
        end
      elsif byte == 46_u8 && !seen_point
        seen_point = true
      elsif (byte == 101_u8 || byte == 69_u8) && any
        at = at + 1
        raise "not a number: #{text.inspect}" if at >= size
        exponent_negative = false
        if bytes[at] == 45_u8 || bytes[at] == 43_u8
          exponent_negative = bytes[at] == 45_u8
          at = at + 1
        end
        raise "not a number: #{text.inspect}" if at >= size
        read = 0
        while at < size
          byte = bytes[at]
          raise "not a number: #{text.inspect}" if byte < 48_u8 || byte > 57_u8
          read = read * 10 + (byte - 48_u8).to_i32 if read < 100000
          at = at + 1
        end
        exponent = exponent + (exponent_negative ? 0 - read : read)
        break
      else
        raise "not a number: #{text.inspect}"
      end
      at = at + 1
    end
    raise "not a number: #{text.inspect}" unless any
    return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if mantissa.size == 0
    # Far outside the format either way.
    return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64) if exponent > 310
    return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if exponent < -345

    # value = mantissa * 10^exponent as numerator / denominator.
    numerator = mantissa
    denominator = IyiBig.new(1_u64)
    if exponent >= 0
      numerator.mul_pow10(exponent)
    else
      denominator.mul_pow10(0 - exponent)
    end
    # The quotient to 54 bits (one past the significand for the rounding
    # bit), the remainder's emptiness the sticky bit: shift the numerator
    # up until the quotient has that many bits. `scale` is how far.
    top = numerator.bit_length - denominator.bit_length
    scale = 54 - top
    if scale > 0
      numerator.shl(scale)
    elsif scale < 0
      denominator.shl(0 - scale)
    end
    quotient = IyiBig.new(0_u64)
    remainder = numerator.divide(denominator, quotient)
    if quotient.bit_length > 54
      # The estimate was a bit short of the shift: one more bit of
      # quotient than asked, which the rounding below absorbs by dropping
      # it into the sticky remainder.
      extra = quotient.low_bit
      quotient.shr1
      scale = scale - 1
      remainder = remainder || extra != 0_u64
    end
    # Binary exponent of the quotient's leading bit: value = q * 2^-scale.
    binary_exponent = 53 - scale
    q = quotient.to_u64
    # Subnormal: fewer than 53 bits of significand fit; shift q right until
    # its exponent is the format's floor, folding the dropped bits into
    # the rounding.
    if binary_exponent < -1022
      drop = -1022 - binary_exponent
      return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if drop > 54
      while drop > 0
        remainder = remainder || (q & 1_u64) != 0_u64
        q = q.unsafe_shr(1_u64)
        drop = drop - 1
      end
      binary_exponent = -1022
    end
    # Round half to even on the 54th bit.
    half = q & 1_u64
    q = q.unsafe_shr(1_u64)
    if half != 0_u64 && (remainder || (q & 1_u64) != 0_u64)
      q = q + 1_u64
    end
    if q == 9007199254740992_u64
      q = q.unsafe_shr(1_u64)
      binary_exponent = binary_exponent + 1
    end
    return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64) if binary_exponent > 1023
    biased = q < 4503599627370496_u64 ? 0_u64 : (binary_exponent + 1023).to_u64
    bits = biased.unsafe_shl(52_u64) | (q & 4503599627370495_u64)
    bits = bits | 9223372036854775808_u64 if negative
    from_bits(bits)
  end

  # The digits of `value`'s shortest round-tripping decimal, and where the
  # point falls: value = 0.d1 d2 ... dn * 10^k.
  def self.text(bits : UInt64) : String
    negative = bits.unsafe_shr(63_u64) != 0_u64
    exponent_bits = bits.unsafe_shr(52_u64) & 2047_u64
    fraction = bits & 4503599627370495_u64
    if exponent_bits == 2047_u64
      return "NaN" if fraction != 0_u64
      return negative ? "-Infinity" : "Infinity"
    end
    return negative ? "-0.0" : "0.0" if exponent_bits == 0_u64 && fraction == 0_u64

    # value = f * 2^e, f the 53-bit significand (52 for a subnormal).
    hidden = 4503599627370496_u64
    f = exponent_bits == 0_u64 ? fraction : fraction | hidden
    e = exponent_bits == 0_u64 ? -1074 : exponent_bits.to_i64.to_i32 - 1075

    # r/s is the value, m+/s and m-/s the distances to the neighbours'
    # midpoints; a significand at the bottom of its binade has a nearer
    # neighbour below, so the gap above is twice the gap below.
    unequal = fraction == 0_u64 && exponent_bits > 1_u64

    # k, the decimal exponent, estimated from the binary one - log10(2) as
    # 1233/4096, a shade under - and corrected below by the comparisons
    # the digits will use anyway.
    length = 0
    probe = f
    while probe != 0_u64
      probe = probe.unsafe_shr(1_u64)
      length = length + 1
    end
    k = ((e + length - 1) * 1233) // 4096
    k = k - 1 if (e + length - 1) < 0 && ((e + length - 1) * 1233) % 4096 != 0
    k = k + 1

    # The largest any of the four gets: the significand shifted by the
    # binary exponent's size, times ten per decimal place either way (four
    # bits for each), and the digit loop's own few. In limbs, with room.
    places = k < 0 ? -k : k
    bits = 64 + (e < 0 ? -e : e) + 4 * (places + 4)
    limbs = bits // 32 + 3
    limbs = IyiBig::LIMBS if limbs > IyiBig::LIMBS

    r = IyiBig.new(f, limbs)
    s = IyiBig.new(1_u64, limbs)
    if e >= 0
      r.shl(e + (unequal ? 2 : 1))
      s.shl(unequal ? 2 : 1)
      m_plus = IyiBig.new(1_u64, limbs)
      m_plus.shl(unequal ? e + 1 : e)
      m_minus = IyiBig.new(1_u64, limbs)
      m_minus.shl(e)
    else
      r.shl(unequal ? 2 : 1)
      s.shl(-e + (unequal ? 2 : 1))
      m_plus = IyiBig.new(unequal ? 2_u64 : 1_u64, limbs)
      m_minus = IyiBig.new(1_u64, limbs)
    end
    # Where the loops below make their sums and scaled copies: one number,
    # written over, rather than two new ones a digit.
    scratch = IyiBig.new(0_u64, limbs)
    ten_r = IyiBig.new(0_u64, limbs)

    # An even significand owns its boundaries (round-half-even reads a
    # midpoint back as the even neighbour), an odd one does not.
    even = f & 1_u64 == 0_u64
    if k >= 0
      s.mul_pow10(k)
    else
      r.mul_pow10(-k)
      m_plus.mul_pow10(-k)
      m_minus.mul_pow10(-k)
    end
    # Too small an estimate: the value's high boundary reaches 10^k.
    while (c = r.compare_sum(m_plus, s, scratch)) > 0 || (c == 0 && even)
      s.mul_small(10_u64)
      k = k + 1
    end
    # Too large: even ten times the high boundary stays under 10^k.
    while true
      r.copy_into(ten_r).mul_small(10_u64)
      m_plus.copy_into(scratch).mul_small(10_u64)
      ten_r.add(scratch)
      c = ten_r.compare(s)
      break if c > 0 || (c == 0 && even)
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      k = k - 1
    end

    digits = Pointer(UInt8).malloc(20_u64)
    count = 0
    while true
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      digit = r.divide_digit(s)
      low_c = r.compare(m_minus)
      low = low_c < 0 || (low_c == 0 && even)
      high_c = r.compare_sum(m_plus, s, scratch)
      high = high_c > 0 || (high_c == 0 && even)
      if !low && !high
        digits[count] = digit.to_u8
        count = count + 1
        next
      end
      if low && high
        # Both neighbours are as short: the nearer, and on a tie the even
        # digit.
        twice = r.copy_into(scratch)
        twice.shl(1)
        c = twice.compare(s)
        digit = digit + 1 if c > 0 || (c == 0 && digit % 2 == 1)
      elsif high
        digit = digit + 1
      end
      digits[count] = digit.to_u8
      count = count + 1
      break
    end

    format(negative, digits, count, k)
  end

  # Crystal's notation: fixed from 0.0001 to just under 10^15, a fractional
  # part always, exponent form outside with a signed exponent.
  def self.format(negative : Bool, digits : Pointer(UInt8), count : Int32, k : Int32) : String
    if k > -4 && k <= 15
      if k <= 0
        # 0.000ddd
        bytesize = 2 + (-k) + count
        bytesize = bytesize + 1 if negative
        String.new(bytesize) do |buffer|
          at = 0
          if negative
            buffer[0] = 45_u8
            at = 1
          end
          buffer[at] = 48_u8
          buffer[at + 1] = 46_u8
          at = at + 2
          zeros = -k
          while zeros > 0
            buffer[at] = 48_u8
            at = at + 1
            zeros = zeros - 1
          end
          index = 0
          while index < count
            buffer[at + index] = 48_u8 + digits[index]
            index = index + 1
          end
        end
      else
        # ddd.ddd, the integer part padded with zeros past the digits and
        # the fraction "0" when there is none.
        fraction = count > k ? count - k : 1
        bytesize = k + 1 + fraction
        bytesize = bytesize + 1 if negative
        String.new(bytesize) do |buffer|
          at = 0
          if negative
            buffer[0] = 45_u8
            at = 1
          end
          index = 0
          while index < k
            buffer[at + index] = index < count ? 48_u8 + digits[index] : 48_u8
            index = index + 1
          end
          buffer[at + k] = 46_u8
          at = at + k + 1
          if count > k
            index = k
            while index < count
              buffer[at + index - k] = 48_u8 + digits[index]
              index = index + 1
            end
          else
            buffer[at] = 48_u8
          end
        end
      end
    else
      # d.ddde+xx
      exponent = k - 1
      exponent_text = exponent.to_s
      exponent_text = "+" + exponent_text if exponent >= 0
      fraction = count > 1 ? count - 1 : 1
      bytesize = 1 + 1 + fraction + 1 + exponent_text.bytesize
      bytesize = bytesize + 1 if negative
      String.new(bytesize) do |buffer|
        at = 0
        if negative
          buffer[0] = 45_u8
          at = 1
        end
        buffer[at] = 48_u8 + digits[0]
        buffer[at + 1] = 46_u8
        at = at + 2
        if count > 1
          index = 1
          while index < count
            buffer[at + index - 1] = 48_u8 + digits[index]
            index = index + 1
          end
          at = at + count - 1
        else
          buffer[at] = 48_u8
          at = at + 1
        end
        buffer[at] = 101_u8
        at = at + 1
        index = 0
        while index < exponent_text.bytesize
          buffer[at + index] = exponent_text.to_unsafe[index]
          index = index + 1
        end
      end
    end
  end
end
