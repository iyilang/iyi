# Exercises `std/diff`: edit scripts held to the longest common
# subsequence, unified diffs held byte for byte to what GNU diff 3.12 and
# Python 3.14's difflib wrote for the same texts, and patches applied
# where GNU patch applies them with no fuzz and refused where it refuses.
#
#     IYI_PATH=src:samples/iyi ./bin/iyi run bench/std_diff_exercise.iyi
#
# Given a directory, it also reads the corpus bench/std_diff_exercise.sh
# wrote there with GNU diff, GNU patch and difflib, and writes its own
# unified diffs beside it for GNU patch to apply.

module bench/std_diff_exercise

import std/diff::{Diff, Edit, EditKind, Patch, PatchHunk, PatchError}
import std/file::{File}
import std/indexable

def check(cond : Bool, what : String) : Nil
  raise "ASSERTION FAILED: #{what}" unless cond
end

def check_str(expected : String, actual : String, what : String) : Nil
  raise "ASSERTION FAILED: #{what}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def check_int(expected : Int32, actual : Int32, what : String) : Nil
  raise "ASSERTION FAILED: #{what}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
end

# Park and Miller's generator: the same numbers from every build, so the
# output can be compared between them.
class Rng
  def initialize(@state : Int64)
  end

  def below(n : Int32) : Int32
    @state = (@state * 48271_i64) % 2147483647_i64
    (@state % n.to_i64).to_i32
  end
end

# The script is well formed - runs of at least one, no two of a kind in a
# row, a change's deletions before its insertions, every position where
# the runs before it leave off - and it rebuilds *b* from *a*. Answers
# the changed elements.
def replay(a : Array(T), b : Array(T), edits : Array(Edit), what : String) : Int32 forall T
  i = 0
  j = 0
  changed = 0
  previous = EditKind::Keep
  first = true
  edits.each do |e|
    check e.count > 0, "#{what}: a run of #{e.count}"
    check e.a_start == i && e.b_start == j, "#{what}: #{e.to_s} where the runs before end at a#{i} b#{j}"
    check first || e.kind != previous, "#{what}: two #{e.kind} runs in a row"
    check first || !(previous == EditKind::Insert && e.kind == EditKind::Delete), "#{what}: an insertion before a deletion"
    case e.kind
    when EditKind::Keep
      k = 0
      while k < e.count
        check a[i + k] == b[j + k], "#{what}: #{e.to_s} pairs a#{i + k} with b#{j + k}, which differ"
        k = k + 1
      end
      i = i + e.count
      j = j + e.count
    when EditKind::Delete
      i = i + e.count
      changed = changed + e.count
    else
      j = j + e.count
      changed = changed + e.count
    end
    check e.a_end == i && e.b_end == j, "#{what}: #{e.to_s} ends at a#{e.a_end} b#{e.b_end}"
    previous = e.kind
    first = false
  end
  check i == a.size && j == b.size, "#{what}: the script ends at a#{i} b#{j} of #{a.size} and #{b.size}"
  changed
end

# The length of the longest common subsequence, by the quadratic table.
def lcs(a : Array(T), b : Array(T)) : Int32 forall T
  row = Array(Int32).new(b.size + 1, 0)
  i = 0
  while i < a.size
    diag = 0
    j = 0
    while j < b.size
      up = row[j + 1]
      if a[i] == b[j]
        row[j + 1] = diag + 1
      elsif row[j] > up
        row[j + 1] = row[j]
      end
      diag = up
      j = j + 1
    end
    i = i + 1
  end
  row[b.size]
end

def nums(lo : Int32, hi : Int32) : String
  String.build do |io|
    i = lo
    while i <= hi
      io << i << "\n"
      i = i + 1
    end
  end
end

def applied(patch : String, text : String, what : String) : String
  got = Patch.parse(patch)
  raise "ASSERTION FAILED: #{what}: the patch was refused: #{got.message}" if got.is_a?(PatchError)
  out = got.apply(text)
  raise "ASSERTION FAILED: #{what}: the hunk was refused: #{out.message}" if out.is_a?(PatchError)
  out
end

def refused(patch : String, text : String, what : String) : String
  got = Patch.parse(patch)
  return got.message if got.is_a?(PatchError)
  out = got.apply(text)
  raise "ASSERTION FAILED: #{what}: applied, as #{out.inspect}" if out.is_a?(String)
  out.message
end

def changed_lines(a : String, b : String, minimal : Bool) : Int32
  n = 0
  Diff.lines(a, b, minimal).each { |e| n = n + e.count unless e.keep? }
  n
end

puts "== edit scripts"
# Myers' own example (1986, figure 1): ABCABBA to CBABAC is five edits.
a = ['A', 'B', 'C', 'A', 'B', 'B', 'A']
b = ['C', 'B', 'A', 'B', 'A', 'C']
check_int 5, replay(a, b, Diff.edits(a, b), "ABCABBA to CBABAC"), "ABCABBA to CBABAC is five edits"
check_int 5, replay(a, b, Diff.edits(a, b, minimal: true), "ABCABBA to CBABAC, minimal"), "ABCABBA to CBABAC is five edits, minimal"
check Diff.edits([] of Int32, [] of Int32).empty?, "nothing to nothing is no script"
e = Diff.edits([] of Int32, [1, 2])
check e.size == 1 && e[0] == Edit.new(EditKind::Insert, 0, 0, 2), "nothing to two is one insertion of two"
e = Diff.edits([1, 2], [] of Int32)
check e.size == 1 && e[0] == Edit.new(EditKind::Delete, 0, 0, 2), "two to nothing is one deletion of two"
e = Diff.edits([1, 2, 3], [1, 2, 3])
check e.size == 1 && e[0] == Edit.new(EditKind::Keep, 0, 0, 3), "equal arrays are one keep"
e = Diff.edits([1, 2, 3, 4], [1, 9, 3, 4, 5])
check_str "keep 1 a0 b0|delete 1 a1 b1|insert 1 a2 b1|keep 2 a2 b2|insert 1 a4 b4", e.map(&.to_s).join("|"), "a change and an append"
check e[1].delete? && e[2].insert? && e[3].keep?, "the kinds' questions"
check e[1].a_end == 2 && e[1].b_end == 1 && e[2].a_end == 2 && e[2].b_end == 2, "a run's ends"
puts "  Myers' ABCABBA to CBABAC in five edits; empty, equal and simple pairs as runs"

puts "\n== shortest, against the longest common subsequence"
rng = Rng.new(20261017_i64)
rounds = 1500
r = 0
while r < rounds
  n = rng.below(31)
  m = rng.below(31)
  letters = 1 + rng.below(4)
  x = Array(Int32).new(n) { |i| rng.below(letters) }
  y = Array(Int32).new(m) { |i| rng.below(letters) }
  # Half the pairs are one edited into the other, the shape a file's
  # versions have; the rest are drawn apart.
  if r % 2 == 0
    y = x.dup
    k = rng.below(5)
    while k > 0
      at = y.empty? ? 0 : rng.below(y.size)
      if rng.below(2) == 0 && !y.empty?
        y.delete_at(at)
      else
        y.insert(at, rng.below(letters + 1))
      end
      k = k - 1
    end
  end
  best = x.size + y.size - 2 * lcs(x, y)
  check_int best, replay(x, y, Diff.edits(x, y), "Diff.edits round #{r}"), "Diff.edits is shortest, round #{r}: #{x} to #{y}"
  check_int best, replay(x, y, Diff.edits(x, y, minimal: true), "Diff.edits minimal round #{r}"), "Diff.edits(minimal: true) is shortest, round #{r}"
  xs = x.map { |v| "line #{v}\n" }
  ys = y.map { |v| "line #{v}\n" }
  check_int best, replay(xs, ys, Diff.line_edits(xs, ys), "Diff.line_edits round #{r}"), "Diff.line_edits is shortest, round #{r}: #{x} to #{y}"
  r = r + 1
end
puts "  #{rounds} random pairs: every script rebuilds its second side, and changes as few elements as the longest common subsequence leaves"

puts "\n== the bound on the search"
# Every element differs: 60,000 changes, so the search runs into its bound
# (4096 rounds) and splits where it got furthest, round after round. The
# script it settles for is still a script.
big = 30000
x = Array(Int32).new(big) { |i| i }
y = Array(Int32).new(big) { |i| big + i }
check_int 2 * big, replay(x, y, Diff.edits(x, y), "30,000 against 30,000 others"), "30,000 against 30,000 others: every element changed"
# Three letters at random: about 11,000 changes, past the bound. The
# bounded search answers a valid script, never shorter than the minimal
# one, which is valid too.
x = Array(Int32).new(20000) { |i| rng.below(3) }
y = Array(Int32).new(20000) { |i| rng.below(3) }
bounded = replay(x, y, Diff.edits(x, y), "three letters, bounded")
least = replay(x, y, Diff.edits(x, y, minimal: true), "three letters, minimal")
check least <= bounded, "the bounded search is never shorter than the minimal one (#{bounded} against #{least})"
check least > 2 * 4096, "three letters at random need more edits than the bound's rounds"
puts "  30,000 against 30,000 others, and 20,000 three-letter elements bounded and minimal, each a valid script"

puts "\n== lines"
check_str "[]", Diff.split_lines("").to_s, "the empty text has no lines"
check_str "[\"a\\n\", \"b\"]", Diff.split_lines("a\nb").inspect, "a last line without its newline"
check_str "[\"a\\r\\n\", \"\\n\", \"b\\n\"]", Diff.split_lines("a\r\n\nb\n").inspect, "a CR is the line's own byte"
check_str "keep 1 a0 b0|delete 1 a1 b1|insert 1 a2 b1", Diff.lines("a\nb", "a\nb\n").map(&.to_s).join("|"), "a line that gains its newline is a different line"
check_str "delete 2 a0 b0|insert 2 a2 b0", Diff.lines("a\r\nb\r\n", "a\nb\n").map(&.to_s).join("|"), "CRLF lines against LF lines are all different"
check_str "delete 2 a0 b0|insert 2 a2 b0", Diff.lines("p\nq\n", "r\ns\n").map(&.to_s).join("|"), "texts with no line in common"
puts "  lines keep their ends: a missing newline or a CR makes a line different"

puts "\n== unified, as GNU diff writes it"
# What GNU diff 3.12 wrote, `diff -U<context> --label a --label b`, for
# the same two texts.
gnu = [
  {"two hunks", nums(1, 30), nums(1, 4) + "four and a half\n" + nums(5, 24) + nums(26, 30), 3,
   "--- a\n+++ b\n@@ -2,6 +2,7 @@\n 2\n 3\n 4\n+four and a half\n 5\n 6\n 7\n@@ -22,7 +23,6 @@\n 22\n 23\n 24\n-25\n 26\n 27\n 28\n"},
  {"changes six lines apart share a hunk", nums(1, 20), nums(1, 3) + "x\n" + nums(5, 10) + "y\n" + nums(12, 20), 3,
   "--- a\n+++ b\n@@ -1,14 +1,14 @@\n 1\n 2\n 3\n-4\n+x\n 5\n 6\n 7\n 8\n 9\n 10\n-11\n+y\n 12\n 13\n 14\n"},
  {"changes seven lines apart do not", nums(1, 20), nums(1, 3) + "x\n" + nums(5, 11) + "y\n" + nums(13, 20), 3,
   "--- a\n+++ b\n@@ -1,7 +1,7 @@\n 1\n 2\n 3\n-4\n+x\n 5\n 6\n 7\n@@ -9,7 +9,7 @@\n 9\n 10\n 11\n-12\n+y\n 13\n 14\n 15\n"},
  {"an insertion with no context", nums(1, 10), nums(1, 5) + "new\n" + nums(6, 10), 0,
   "--- a\n+++ b\n@@ -5,0 +6 @@\n+new\n"},
  {"a deletion with no context", nums(1, 10), nums(1, 4) + nums(6, 10), 0,
   "--- a\n+++ b\n@@ -5 +4,0 @@\n-5\n"},
  {"changes at the top and the end", nums(1, 10), "zero\n" + nums(1, 9) + "ten\n", 3,
   "--- a\n+++ b\n@@ -1,3 +1,4 @@\n+zero\n 1\n 2\n 3\n@@ -7,4 +8,4 @@\n 7\n 8\n 9\n-10\n+ten\n"},
  {"from the empty text", "", "a\nb\n", 3, "--- a\n+++ b\n@@ -0,0 +1,2 @@\n+a\n+b\n"},
  {"to the empty text", "a\nb\n", "", 3, "--- a\n+++ b\n@@ -1,2 +0,0 @@\n-a\n-b\n"},
  {"no newline at the end of the old text", "a\nb\nc", "a\nb\nc\n", 3,
   "--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n b\n-c\n\\ No newline at end of file\n+c\n"},
  {"no newline at the end of the new text", "a\nb\nc\n", "a\nb\nc", 3,
   "--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n b\n-c\n+c\n\\ No newline at end of file\n"},
  {"no newline at the end of either", "a\nb\nc", "a\nb\nd", 3,
   "--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n b\n-c\n\\ No newline at end of file\n+d\n\\ No newline at end of file\n"},
  {"no newline on a line of context", "a\nb\nc\nd", "a\nB\nc\nd", 3,
   "--- a\n+++ b\n@@ -1,4 +1,4 @@\n a\n-b\n+B\n c\n d\n\\ No newline at end of file\n"},
  {"CRLF lines", "one\r\ntwo\r\nthree\r\n", "one\r\nTWO\r\nthree\r\n", 3,
   "--- a\n+++ b\n@@ -1,3 +1,3 @@\n one\r\n-two\r\n+TWO\r\n three\r\n"},
  {"one line of context", nums(1, 20), nums(1, 7) + "x\n" + nums(9, 20), 1,
   "--- a\n+++ b\n@@ -7,3 +7,3 @@\n 7\n-8\n+x\n 9\n"},
]
gnu.each do |v|
  check_str v[4], Diff.unified(v[1], v[2], "a", "b", v[3]), "unified: byte for byte as GNU diff wrote #{v[0]}"
  check_str v[2], applied(v[4], v[1], "Patch applies GNU diff's #{v[0]}"), "Patch applies GNU diff's #{v[0]}"
end
check_str "", Diff.unified("same\n", "same\n", "a", "b"), "equal texts are no diff"
check_str "--- a.txt\t2026-10-17 12:00:00 +0000\n+++ b.txt\n@@ -1 +1 @@\n-x\n+y\n", Diff.unified("x\n", "y\n", "a.txt\t2026-10-17 12:00:00 +0000", "b.txt"), "a date is the caller's, after a tab"
puts "  #{gnu.size} texts written as GNU diff wrote them, and each of GNU's applied back"

puts "\n== Python's difflib"
# What Python 3.14's `difflib.unified_diff` wrote, with n=3 and with dates
# and n=1, for two versions of a small program.
py_a = "def f(x):\n    if x:\n        return 1\n    return 0\n\n\ndef g(y):\n    total = 0\n    for i in range(y):\n        total += i\n    return total\n\n\nprint(f(1), g(3))\n"
py_b = "def f(x):\n    if x > 0:\n        return 1\n    return 0\n\n\ndef g(y):\n    total = 0\n    for i in range(y):\n        total += i * i\n    return total\n\n\nprint(f(1), g(4))\n"
py3 = "--- a.py\n+++ b.py\n@@ -1,5 +1,5 @@\n def f(x):\n-    if x:\n+    if x > 0:\n         return 1\n     return 0\n \n@@ -7,8 +7,8 @@\n def g(y):\n     total = 0\n     for i in range(y):\n-        total += i\n+        total += i * i\n     return total\n \n \n-print(f(1), g(3))\n+print(f(1), g(4))\n"
py1 = "--- a.py\t2026-10-17 12:00:00\n+++ b.py\t2026-10-17 12:05:00\n@@ -1,3 +1,3 @@\n def f(x):\n-    if x:\n+    if x > 0:\n         return 1\n@@ -9,3 +9,3 @@\n     for i in range(y):\n-        total += i\n+        total += i * i\n     return total\n@@ -13,2 +13,2 @@\n \n-print(f(1), g(3))\n+print(f(1), g(4))\n"
check_str py3, Diff.unified(py_a, py_b, "a.py", "b.py"), "unified: byte for byte as difflib wrote it"
check_str py_b, applied(py3, py_a, "Patch applies difflib's n=3 diff"), "Patch applies difflib's n=3 diff"
check_str py_b, applied(py1, py_a, "Patch applies difflib's n=1 diff with dates"), "Patch applies difflib's n=1 diff with dates"
p = Patch.parse(py1).or_panic
check_str "a.py", p.old_name, "the old name stops at the tab"
check_str "b.py", p.new_name, "the new name stops at the tab"
check_int 3, p.hunks.size, "three hunks"
puts "  difflib's diff written byte for byte, and both of its diffs applied"

puts "\n== a patch read"
p = Patch.parse(gnu[0][4]).or_panic
h = p.hunks[1]
check h.old_start == 22 && h.old_count == 7 && h.new_start == 23 && h.new_count == 6, "the second hunk's numbers"
check h.old_index == 21 && h.leading == 3 && h.trailing == 3, "the second hunk's place and context"
check_str "@@ -22,7 +23,6 @@", h.header, "the header as written"
check_str "22\n23\n24\n25\n26\n27\n28\n", h.old_lines.join, "the old lines"
check_str "22\n23\n24\n26\n27\n28\n", h.new_lines.join, "the new lines"
h = Patch.parse(gnu[3][4]).or_panic.hunks[0]
check h.old_index == 5 && h.old_lines.empty? && h.new_lines == ["new\n"], "an insertion with no context goes after its line"
h = Patch.parse("--- a\n+++ b\n@@ -1 +1 @@ section\n-x\n+y\n").or_panic.hunks[0]
check h.old_lines == ["x\n"] && h.new_lines == ["y\n"], "a section name after the header"
h = Patch.parse("--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n\n-c\n+d\n").or_panic.hunks[0]
check h.old_lines == ["a\n", "\n", "c\n"], "an empty line is an empty context line whose space was stripped"
h = Patch.parse("--- a\n+++ b\n@@ -1 +1 @@\n-x\n+y").or_panic.hunks[0]
check h.new_lines == ["y\n"], "the patch's last line without its newline still has one"
two = "From: someone\nSubject: two files\n\n--- a/one\n+++ b/one\n@@ -1 +1 @@\n-1\n+one\ndiff -u a/two b/two\n--- a/two\n+++ b/two\n@@ -1 +1 @@\n-2\n+two\n-- \nsignature\n"
all = Patch.parse_all(two).or_panic
check all.size == 2 && all[0].old_name == "a/one" && all[1].new_name == "b/two", "two files' patches among a mail's lines"
check_str "one\n", all[0].apply("1\n").or_panic, "the first file's patch"
check_str "two\n", all[1].apply("2\n").or_panic, "the second file's patch"
puts "  hunks, names and lines as written; a mail's text read past"

puts "\n== applying at an offset"
two_hunks = gnu[0]
check_str "0a\n0b\n" + two_hunks[2], applied(two_hunks[4], "0a\n0b\n" + two_hunks[1], "a hunk found two lines down"), "a hunk found two lines down, and the next with it"
shorter = nums(1, 11) + nums(16, 30)
check_str nums(1, 4) + "four and a half\n" + nums(5, 11) + nums(16, 24) + nums(26, 30), applied(two_hunks[4], shorter, "a hunk found four lines up"), "a hunk found four lines up"
check_str "patch: hunk #1 (@@ -1,3 +1,4 @@) does not match the start of the text, where its context holds it", refused(gnu[5][4], "x\n" + nums(1, 10), "a hunk held at the start of the file is refused a line down"), "a hunk held at the start of the file is refused a line down"
check_str "patch: hunk #2 (@@ -7,4 +8,4 @@) does not match the end of the text, where its context holds it", refused(gnu[5][4], nums(1, 10) + "x\n", "a hunk held at the end of the file is refused a line up"), "a hunk held at the end of the file is refused a line up"
again = refused(two_hunks[4], two_hunks[2], "a patch applied twice is refused and said to be")
check_str "patch: hunk #1 (@@ -2,6 +2,7 @@) does not match the text at line 2 or at any offset from it; its new lines are there already, so it may be applied or reversed", again, "a patch applied twice is refused and said to be"
# The second hunk's line is also the line the first hunk changed: it is
# not looked for before the end of the hunk before it.
check_str "patch: hunk #2 (@@ -3 +3 @@) does not match the text at line 3 or at any offset from it", refused("--- a\n+++ b\n@@ -2 +2 @@\n-c\n+C\n@@ -3 +3 @@\n-c\n+D\n", "x\nc\ny\n", "a hunk is not looked for inside the hunk before it"), "a hunk is not looked for inside the hunk before it"
check_str "patch: hunk #1 (@@ -3 +3 @@) does not match the text at line 3 or at any offset from it", refused("--- a\n+++ b\n@@ -3 +3 @@\n-q\n+Q\n", "a\nb\nc\n", "a hunk that does not match is refused"), "a hunk that does not match is refused"
check_str "patch: hunk #1 (@@ -7,0 +8 @@) inserts after line 7, and the text has 3 lines", refused("--- a\n+++ b\n@@ -7,0 +8 @@\n+x\n", "a\nb\nc\n", "an insertion past the end is refused"), "an insertion past the end is refused"
check_str "patch: hunk #1 (@@ -3,0 +4 @@) puts a line after one with no newline, which would join the two", refused("--- a\n+++ b\n@@ -3,0 +4 @@\n+x\n", "a\nb\nc", "an insertion after a line with no newline is refused"), "an insertion after a line with no newline is refused"
puts "  offsets up and down; the file's edges held; a hunk applied twice, overlapping or nowhere refused"

puts "\n== no newline at end of file"
check_str "a\nb\nc", applied("--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n b\n-c\n+c\n\\ No newline at end of file\n", "a\nb\nc\n", "the marker takes the new line's newline"), "the marker takes the new line's newline"
check_str "a\nB\nc\nd", applied(gnu[11][4], "a\nb\nc\nd", "a marked line of context"), "a marked line of context"
m = refused(gnu[8][4], "a\nb\nc\n", "an old line marked without a newline does not match one with it")
check_str "patch: hunk #1 (@@ -1,3 +1,3 @@) does not match the end of the text, where its context holds it; its new lines are there already, so it may be applied or reversed", m, "an old line marked without a newline does not match one with it"
check_str "patch: line 6: hunk #1 has a line after the one marked as the end of the file", refused("--- a\n+++ b\n@@ -1,2 +1,2 @@\n-a\n\\ No newline at end of file\n-b\n+c\n+d\n", "a\nb\n", "a line after the marked one is refused"), "a line after the marked one is refused"
puts "  the marker read on either side, and a text's last newline held to it"

puts "\n== CRLF"
check_str "one\r\nTWO\r\nthree\r\n", applied(gnu[12][4], "one\r\ntwo\r\nthree\r\n", "CRLF lines applied with their CRs"), "CRLF lines applied with their CRs"
m = refused(gnu[12][4], "one\ntwo\nthree\n", "a CRLF hunk does not match LF lines")
check_str "patch: hunk #1 (@@ -1,3 +1,3 @@) does not match the text at line 1 or at any offset from it", m, "a CRLF hunk does not match LF lines"
puts "  a CR is part of the line it ends, on both sides"

puts "\n== round trips"
words = ["{\n", "}\n", "\n", "  return x;\n", "  x += 1;\n", "int f(int x)\n", "// note\n", "end\n"]
r = 0
trips = 400
while r < trips
  n = rng.below(60)
  la = Array(String).new(n) { |i| rng.below(3) == 0 ? "line #{rng.below(1000)}\n" : words[rng.below(words.size)] }
  lb = la.dup
  k = 1 + rng.below(6)
  while k > 0
    at = lb.empty? ? 0 : rng.below(lb.size)
    case rng.below(3)
    when 0 then lb.delete_at(at) unless lb.empty?
    when 1 then lb.insert(at, words[rng.below(words.size)])
    else        lb.insert(at, "new #{r} #{k}\n")
    end
    k = k - 1
  end
  ta = la.join
  tb = lb.join
  ta = ta[0, ta.bytesize - 1] if rng.below(5) == 0 && ta.ends_with?("\n")
  tb = tb[0, tb.bytesize - 1] if rng.below(5) == 0 && tb.ends_with?("\n")
  context = rng.below(5)
  u = Diff.unified(ta, tb, "a", "b", context)
  if ta == tb
    check u.empty?, "round trip #{r}: equal texts, no diff"
  else
    check_str tb, applied(u, ta, "round trip #{r}: Patch applies Diff.unified's diff (context #{context})"), "round trip #{r}: Patch applies Diff.unified's diff (context #{context})"
  end
  r = r + 1
end
puts "  #{trips} pairs of texts, contexts 0 to 4: every diff applies back to the new text"

puts "\n== refused as a value"
bad = [
  {"no diff at all", "hello\n", "patch: no unified diff in the text: no \"--- \" line followed by a \"+++ \" line"},
  {"headers with no hunk", "--- a\n+++ b\n", "patch: line 1: the patch of \"a\" has no hunk"},
  {"a header that is not one", "--- a\n+++ b\n@@ -1,x +1 @@\n-a\n", "patch: line 3: \"@@ -1,x +1 @@\" is not a unified diff's hunk header"},
  {"a header without its closing @@", "--- a\n+++ b\n@@ -1 +1\n-a\n+b\n", "patch: line 3: \"@@ -1 +1\" is not a unified diff's hunk header"},
  {"a ten-digit line number", "--- a\n+++ b\n@@ -1234567890 +1 @@\n-a\n+b\n", "patch: line 3: \"@@ -1234567890 +1 @@\" is not a unified diff's hunk header"},
  {"lines counted from 0", "--- a\n+++ b\n@@ -0,2 +1,2 @@\n-a\n-b\n+c\n+d\n", "patch: line 3: \"@@ -0,2 +1,2 @@\" counts a range from line 0, and lines count from 1"},
  {"a hunk cut short", "--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n-b\n+c\n", "patch: line 6: hunk #1 ends after 2 of its 3 old lines and 2 of its 3 new lines"},
  {"a hunk ended by another line", "--- a\n+++ b\n@@ -1,2 +1,2 @@\n a\n-b\njunk\n+c\n", "patch: line 6: hunk #1 ends after 2 of its 2 old lines and 1 of its 2 new lines"},
  {"more lines than counted", "--- a\n+++ b\n@@ -1 +1,2 @@\n-a\n-b\n+c\n", "patch: line 5: hunk #1 holds more lines than its header \"@@ -1 +1,2 @@\" counts"},
  {"a marker before any line", "--- a\n+++ b\n@@ -1 +1 @@\n\\ No newline at end of file\n-a\n+b\n", "patch: line 4: \"\\\\ No newline at end of file\" follows no line of hunk #1"},
  {"two markers for one line", "--- a\n+++ b\n@@ -1 +1 @@\n-a\n\\ No newline at end of file\n\\ No newline at end of file\n+b\n", "patch: line 6: two markers for one line in hunk #1"},
  {"hunks out of order", "--- a\n+++ b\n@@ -5 +5 @@\n-a\n+b\n@@ -2 +2 @@\n-c\n+d\n", "patch: line 6: hunk #2 starts at old line 2, before hunk #1 ends at line 5"},
  {"two files to Patch.parse", two, "patch: the text patches 2 files; Patch.parse reads one, Patch.parse_all each"},
]
bad.each do |v|
  got = Patch.parse(v[1])
  check got.is_a?(PatchError), "refused: #{v[0]}"
  check_str v[2], got.as(PatchError).message, "refused: #{v[0]}"
  check_str v[2], got.as(PatchError).to_s, "refused, to_s: #{v[0]}"
end
puts "  #{bad.size} malformed patches refused, each with its sentence"

if Program.args.size > 0
  puts "\n== against GNU diff and GNU patch"
  dir = Program.args[0]
  pairs = 0
  same = 0
  shifted = 0
  from_python = 0
  File.read(dir + "/index.txt").split('\n').each do |row|
    next if row.empty?
    f = row.split(' ')
    name = f[0]
    context = f[1].to_i
    unique = f[2] == "unique"
    base = dir + "/" + name
    ta = File.read(base + ".a")
    tb = File.read(base + ".b")
    ours = Diff.unified(ta, tb, "a", "b", context)
    File.write(base + ".iyi", ours)
    gnu_diff = File.read(base + ".gnu")
    least = File.read(base + ".minimal").strip.to_i
    check_int least, changed_lines(ta, tb, false), "corpus #{name}: as many changed lines as diff --minimal"
    check_int least, changed_lines(ta, tb, true), "corpus #{name}: as many changed lines as diff --minimal, minimal"
    if unique
      check_str gnu_diff, ours, "corpus #{name}: byte for byte as GNU diff"
      same = same + 1
    elsif gnu_diff == ours
      same = same + 1
    end
    if ta == tb
      check ours.empty? && gnu_diff.empty?, "corpus #{name}: equal texts, no diff"
    else
      check_str tb, applied(gnu_diff, ta, "corpus #{name}: GNU diff's patch applied by Patch"), "corpus #{name}: GNU diff's patch applied by Patch"
      check_str tb, applied(ours, ta, "corpus #{name}: Diff.unified's patch applied by Patch"), "corpus #{name}: Diff.unified's patch applied by Patch"
      py = File.read(base + ".py")
      check_str tb, applied(py, ta, "corpus #{name}: difflib's patch applied by Patch"), "corpus #{name}: difflib's patch applied by Patch"
      from_python = from_python + 1
      # The text moved and the text spoilt, each as GNU patch -F0 took it.
      ["shift", "spoil"].each do |kind|
        next unless File.file?(base + "." + kind)
        text = File.read(base + "." + kind)
        got = Patch.parse(gnu_diff).or_panic.apply(text)
        if File.file?(base + "." + kind + ".out")
          want = File.read(base + "." + kind + ".out")
          check got.is_a?(String), "corpus #{name}: GNU patch -F0 and Patch agree on the #{kind} text: GNU applied it, Patch said #{got.is_a?(PatchError) ? got.message : ""}"
          check_str want, got.as(String), "corpus #{name}: GNU patch -F0 and Patch agree on the #{kind} text"
        else
          check got.is_a?(PatchError), "corpus #{name}: GNU patch -F0 and Patch agree on the #{kind} text: GNU refused it, Patch applied it"
        end
        shifted = shifted + 1
      end
    end
    pairs = pairs + 1
  end
  puts "  #{pairs} pairs: every diff as short as diff --minimal's; #{same} byte for byte as GNU diff (every unique-line pair among them)"
  puts "  GNU diff's and difflib's patches applied by Patch for #{from_python} pairs; #{shifted} moved or spoilt texts taken as GNU patch -F0 took them"
end

puts "\nALL CHECKS PASSED"
