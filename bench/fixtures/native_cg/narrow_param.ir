; iyi-ir 1
module "narrow_param"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
declare external i32 @__fixture_call_byte(ptr)
@fmt = private constant [4 x i8] c"%d\0A\00"
define i32 @byte_test(i8 %v) {
entry:
  %cmp = icmp eq i8 %v, 128
  %result = zext i1 %cmp to i32
  ret i32 %result
}
define i32 @main() {
entry:
  %v = call i32 (ptr) @__fixture_call_byte(ptr @byte_test)
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i32 %v)
  ret i32 0
}
