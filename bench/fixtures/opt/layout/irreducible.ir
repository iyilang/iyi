; iyi-ir 1
source_filename = "irreducible"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @irreducible(i1 %choose, i1 %a_cond, i1 %b_cond) {
entry:
  br i1 %choose, label %a, label %b
b:
  br i1 %b_cond, label %a, label %done
done:
  ret void
a:
  br i1 %a_cond, label %b, label %done
}
