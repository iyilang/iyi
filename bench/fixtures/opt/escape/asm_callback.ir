; iyi-ir 1
source_filename = "escape_asm_callback"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal ptr @__iyi_new(i64 %size, i64 %tid, i64 %flags) {
entry:
  ret ptr null
}
declare external i64 @dispatch(i64)
define internal i64 @asm_named_callback(i64 %n) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 1, i64 2)
  %next = call i64 (i64) @dispatch(i64 %n)
  %v = load i64, ptr %p, align 8
  %sum = add i64 %v, %next
  ret i64 %sum
}
define internal void @asm_reference() {
entry:
  call void () asm sideeffect "bl asm_named_callback", ""()
  ret void
}
