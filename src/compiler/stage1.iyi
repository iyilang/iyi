# The stage-one compiler entry point: a whole-compiler executable built from
# src/compiler/**/*.iyi with the bootstrap compiler (bin/iyi), rather than
# wiring iyi components into Crystal's compiler in-process, which the heap
# boundary makes impossible.
#
# The command driver parses argv and the executor runs supported commands
# through the native typed pipeline. Other commands refuse by name.

@[Unsafe("The stage-one entry point binds libc exit(3) in lib LibC, the one C call it makes to end the process with the driver's status. The compiler does not check that C declaration.")]
module compiler/stage1

import compiler/command/driver::{CommandDriver, OutputBuffer, CommandResult}
import compiler/command/execute::{CommandExecutor}

lib LibC
  fun exit(status : Int32) : NoReturn
end

def run_driver : Nil
  IyiFiber.stack_bytes = CommandExecutor::PHASE_STACK_BYTES
  CommandDriver.program_name = "iyi"
  driver = CommandDriver.new(Program.args)
  result = driver.run
  stdout_text = result.stdout_output
  if !stdout_text.empty?
    print stdout_text
  end
  stderr_text = result.stderr_output
  if !stderr_text.empty?
    STDERR.print stderr_text
  end
  code = result.exit_code
  if code
    LibC.exit(code)
  end
  STDOUT.flush
  STDERR.flush
  LibC.exit(CommandExecutor.execute(result))
end

run_driver
