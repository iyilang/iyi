; iyi-ir 1
source_filename = "top_level"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @force(i64 %x) [alwaysinline] {
entry:
  ret i64 %x
}
define internal i64 @step(i64 %x) {
entry:
  %v = add i64 %x, 1
  ret i64 %v
}
define external i64 @__iyi_main(i64 %n) {
entry:
  %start = call i64 (i64) @force(i64 %n)
  br label %head
head:
  %i = phi i64 [ %start, label %entry ], [ %next, label %body ]
  %more = icmp slt i64 %i, 10
  br i1 %more, label %body, label %done
body:
  %v = call i64 (i64) @step(i64 %i)
  %next = add i64 %v, 1
  br label %head
done:
  ret i64 %i
}
