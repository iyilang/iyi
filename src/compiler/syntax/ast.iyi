module compiler/syntax/ast

import compiler/foundation/location
import compiler/foundation/enums
import compiler/syntax/token

using compiler/foundation/location::{Location}
using compiler/syntax/token::{Keyword, TokenKind, NumberKind}

pub enum Visibility : Int8
  Public    = 0
  Protected = 1
  Private   = 2
end

pub enum RegexOptions : Int32
  None         =  0
  IGNORE_CASE  =  1
  MULTILINE    =  6
  DOTALL       =  2
  EXTENDED     =  8
  ANCHORED     = 16
  UTF_8        = 32
  NO_UTF_CHECK = 64

  def |(other : RegexOptions) : RegexOptions
    RegexOptions.new(value | other.value)
  end

  def &(other : RegexOptions) : RegexOptions
    RegexOptions.new(value & other.value)
  end

  def none? : Bool
    value == 0
  end

  def includes?(option : RegexOptions) : Bool
    (value & option.value) == option.value
  end
end

pub class StringBuilder
  @parts : Array(String)

  def initialize
    @parts = [] of String
  end

  def <<(str : String) : self
    @parts << str
    self
  end

  def <<(ch : Char) : self
    @parts << ch.to_s
    self
  end

  def <<(num : Int32) : self
    @parts << num.to_s
    self
  end

  def <<(num : Int64) : self
    @parts << num.to_s
    self
  end

  def append(str : String) : self
    @parts << str
    self
  end

  def to_s : String
    @parts.join("")
  end

  def empty? : Bool
    @parts.empty?
  end
end

# Out-of-band side map keyed by node object_id so ASTNode types are never reopened.
pub class NodeMap(V)
  @store : Hash(UInt64, V)

  def initialize
    @store = Hash(UInt64, V).new
  end

  def []=(node : ASTNode, value : V) : V
    @store[node.node_id] = value
    value
  end

  def []?(node : ASTNode) : V?
    @store[node.node_id]?
  end

  def [](node : ASTNode) : V
    if val = @store[node.node_id]?
      val
    else
      raise "Key not found in NodeMap"
    end
  end

  def has_key?(node : ASTNode) : Bool
    @store.has_key?(node.node_id)
  end

  def delete(node : ASTNode) : V?
    @store.delete(node.node_id)
  end

  def size : Int32
    @store.size
  end

  def empty? : Bool
    @store.empty?
  end

  def clear : Nil
    @store = Hash(UInt64, V).new
  end
end

pub abstract class ASTNode
  property location : Location?
  property end_location : Location?
  property doc : String?
  property visibility : Visibility?

  def at(@location : Location?) : self
    self
  end

  def at(node : ASTNode) : self
    @location = node.location
    @end_location = node.end_location
    self
  end

  def at_end(@end_location : Location?) : self
    self
  end

  def at_end(node : ASTNode) : self
    @end_location = node.end_location
    self
  end

  def node_id : UInt64
    object_id
  end

  def clone : self
    c = clone_without_location
    c.location = @location
    c.end_location = @end_location
    c.doc = @doc
    c.visibility = @visibility
    c
  end

  def ==(other : ASTNode) : Bool
    false
  end

  def hash : Int32
    17
  end

  def !=(other : ASTNode) : Bool
    !self.==(other)
  end

  def accept(visitor) : Nil
    if visitor.visit_any(self)
      if visitor.visit(self)
        accept_children(visitor)
      end
      visitor.end_visit(self)
      visitor.end_visit_any(self)
    end
  end

  def accept_children(visitor) : Nil
  end

  def transform(transformer) : ASTNode
    transformer.before_transform(self)
    res = transformer.transform(self)
    transformer.after_transform(self)
    res
  end

  def nop? : Bool
    false
  end

  def true_literal? : Bool
    false
  end

  def false_literal? : Bool
    false
  end

  abstract def to_s(sb : StringBuilder) : Nil

  def to_s : String
    sb = StringBuilder.new
    to_s(sb)
    sb.to_s
  end
end

def clone_nodes(nodes : Array(T)) : Array(T) forall T
  nodes.map { |node| node.clone.as(T) }
end

def clone_node(node : ASTNode?) : ASTNode?
  if n = node
    n.clone
  else
    nil
  end
end

def clone_opt_nodes(nodes : Array(T)?) : Array(T)? forall T
  if n = nodes
    n.map { |node| node.clone.as(T) }
  else
    nil
  end
end

def clone_opt_strings(strings : Array(String)?) : Array(String)?
  if s = strings
    s.dup
  else
    nil
  end
end

def hash_val(v) : Int32
  if val = v
    val.hash
  else
    0
  end
end

pub abstract class BinaryOp < ASTNode
  property left : ASTNode
  property right : ASTNode

  def initialize(@left : ASTNode, @right : ASTNode)
  end

  def accept_children(visitor) : Nil
    @left.accept(visitor)
    @right.accept(visitor)
  end

  def ==(other : self) : Bool
    @left == other.left && @right == other.right
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    31 &* (31 &* 17 &+ @left.hash) &+ @right.hash
  end
end

pub abstract class UnaryExpression < ASTNode
  property exp : ASTNode

  def initialize(@exp : ASTNode)
  end

  def accept_children(visitor) : Nil
    @exp.accept(visitor)
  end

  def ==(other : self) : Bool
    @exp == other.exp
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    31 &* 17 &+ @exp.hash
  end
end

pub abstract class ControlExpression < ASTNode
  property exp : ASTNode?

  def initialize(@exp : ASTNode? = nil)
  end

  def accept_children(visitor) : Nil
    if e = @exp
      e.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    @exp == other.exp
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    if e = @exp
      31 &* 17 &+ e.hash
    else
      17
    end
  end
end

pub class Nop < ASTNode
  def initialize
  end

  def clone_without_location : self
    Nop.new
  end

  def nop? : Bool
    true
  end

  def ==(other : self) : Bool
    true
  end

  def ==(other : ASTNode) : Bool
    other.is_a?(Nop)
  end

  def hash : Int32
    0
  end

  def to_s(sb : StringBuilder) : Nil
  end
end

pub class NilLiteral < ASTNode
  def initialize
  end

  def clone_without_location : self
    NilLiteral.new
  end

  def ==(other : self) : Bool
    true
  end

  def ==(other : ASTNode) : Bool
    other.is_a?(NilLiteral)
  end

  def hash : Int32
    1
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "nil"
  end
end

pub class BoolLiteral < ASTNode
  property value : Bool

  def initialize(@value : Bool)
  end

  def clone_without_location : self
    BoolLiteral.new(@value)
  end

  def true_literal? : Bool
    @value
  end

  def false_literal? : Bool
    !@value
  end

  def ==(other : self) : Bool
    (@value == other.value)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@value)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << (@value ? "true" : "false")
  end
end

pub class NumberLiteral < ASTNode
  property value : String
  property kind : NumberKind

  def initialize(@value : String, @kind : NumberKind = NumberKind::I32)
  end

  def clone_without_location : self
    NumberLiteral.new(@value, @kind)
  end

  def ==(other : self) : Bool
    (@value == other.value) && (@kind == other.kind)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@value)
    h = 31 &* h &+ hash_val(@kind)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << @value
  end
end

