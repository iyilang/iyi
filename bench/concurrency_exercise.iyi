# Exercises the concurrency runtime: SPEC.md III.4, built in III.4.8's order.
#
# Every check here is a property III.4 states, asserted rather than printed:
# a wrong answer is exit 1 with the property named. The one property a
# program cannot assert about itself — that a deadlocked program dies loudly
# instead of hanging — is bench/concurrency_exercise.sh's failure proof.
#
# The timing thresholds are structural, not benchmarks: 2 x 150 ms of
# sleeping finishing under 260 ms cannot happen sequentially, and a task
# blocked for 10 s finishing under 5 s cannot happen unless cancellation
# reached it while blocked. Generous margins, because the aarch64 arm of CI
# runs under emulation.

import std/gc::{GC}

def fail(message : String) : Nil
  puts "FAIL: #{message}"
  __iyi_exit(1)
end

def elapsed_ms(since : Int64) : Int64
  (__iyi_monotonic_ns - since) // 1000000_i64
end

# A pipe, for the poller check. The exercise's own binding, the way every
# probe of a call the prelude does not carry yet gets one: raw `pipe2` on
# Linux, libSystem's `pipe` on darwin, which is III.9's darwin rule
# applied to a test probe.
{% if flag?(:darwin) %}
  lib LibC
    fun pipe(fds : Int32*) : Int32
  end

  def make_pipe : Pointer(Int32)
    fds = Pointer(UInt8).malloc(8_u64).as(Pointer(Int32))
    fail("pipe failed") if LibC.pipe(fds) < 0
    fds
  end
{% elsif flag?(:win32) %}
  # Same as `runtime_exercise`: the prelude's `LibC` is wide-only now, and
  # this pipe name is the exercise's own ASCII.
  lib LibC
    fun CreateFileA(name : UInt8*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
  end

  def make_pipe : Pointer(Int64)
    pipe_name = "\\\\.\\pipe\\iyi_conc_pipe_#{__iyi_monotonic_ns}".to_unsafe
    h_read = LibC.CreateNamedPipeA(pipe_name, 0x40000001_i32, 0_i32, 1_i32, 4096_i32, 4096_i32, 0_i32, Pointer(Void).new(0_u64))
    fail("CreateNamedPipeA failed") if h_read.address &+ 1_u64 == 0_u64
    h_write = LibC.CreateFileA(pipe_name, 1073741824_i32, 0_i32, Pointer(Void).new(0_u64), 3_i32, 128_i32, Pointer(Void).new(0_u64))
    fail("CreateFileA for pipe failed") if h_write.address &+ 1_u64 == 0_u64
    fds = Pointer(UInt8).malloc(16_u64).as(Pointer(Int64))
    fds[0] = h_read.address.to_i64
    fds[1] = h_write.address.to_i64
    fds
  end
{% else %}
  {% if flag?(:x86_64) %}
    EX_SYS_PIPE2 = 293_i64
  {% else %}
    EX_SYS_PIPE2 = 59_i64
  {% end %}

  def make_pipe : Pointer(Int32)
    fds = Pointer(UInt8).malloc(8_u64).as(Pointer(Int32))
    result = __iyi_conc_syscall3(EX_SYS_PIPE2, fds.address.to_i64, 0_i64, 0_i64)
    fail("pipe2 failed") if result < 0
    fds
  end
{% end %}

pub struct TaskFailed
  def initialize
  end
end

impl Error for TaskFailed
  def message : String
    "the failing task's error"
  end
end

# ── 0. Sleepers wake in deadline order, each costing its own insertion ────
#
# The sleep queue was a list kept sorted by walking it, so every sleep
# walked past every sleeper before it: 100,000 tasks sleeping under 100 ms
# took 11 s. 32,000 tasks sleeping a millisecond or a few may cost the
# queue at most 64 steps each - a heap's melds, counted rather than timed,
# so a slow machine and a platform whose mappings cost more cannot move it
# - and must wake in the order of the deadlines their sleeps set. First,
# so that a queue out of order is named here rather than by whichever
# sleep below it breaks.
woke = [] of Int64
steps_before = IyiScheduler.sleep_steps
group do |g|
  32000.times do |k|
    g.spawn do
      sleep(k * 7919 % 7 + 1)
      woke << IyiScheduler.current.deadline
      0
    end
  end
end
steps = IyiScheduler.sleep_steps - steps_before
i = 1
while i < woke.size
  fail("sleep: a sleeper woke before one whose deadline came first") if woke[i] < woke[i - 1]
  i = i + 1
end
fail("sleep: 32000 sleepers took #{steps // 32000} queue steps each") if steps > 32000_u64 * 64_u64
puts "32000 sleepers woke in deadline order, #{steps // 32000} queue steps each"

# ── 0b. A parked reader costs the others nothing ─────────────────────────
#
# Every io event, every second waiter's check and every cancellation
# walked the list of fibers parked on io, so each read on a server paid
# for every connection parked beside it: a round trip over a pipe took
# 41 us with 4,000 idle readers parked and 2 us with none. The same round
# trips with 2,000 idle readers parked may take at most three times what
# they take alone. Linux's poller only: Windows finds a completion by its
# OVERLAPPED, and darwin's default of 256 descriptors does not hold the
# crowd.
{% if flag?(:linux) %}
  def round_trips(idle : Int32, rounds : Int32) : Int64
    crowd = [] of Pointer(Int32)
    idle.times { crowd << make_pipe }
    ping = make_pipe
    pong = make_pipe
    took = 0_i64
    group do |g|
      crowd.each do |pipe|
        fd = pipe[0]
        g.spawn do
          buffer = Pointer(UInt8).malloc(1_u64)
          iyi_read(fd, buffer.as(Void*), 1_u64)
          0
        end
      end
      g.spawn do
        buffer = Pointer(UInt8).malloc(1_u64)
        rounds.times do
          iyi_read(ping[0], buffer.as(Void*), 1_u64)
          __iyi_write(pong[1], buffer.as(Void*), 1_u64)
        end
        0
      end
      g.spawn do
        buffer = Pointer(UInt8).malloc(1_u64)
        buffer.value = 1_u8
        started = __iyi_monotonic_ns
        rounds.times do
          __iyi_write(ping[1], buffer.as(Void*), 1_u64)
          iyi_read(pong[0], buffer.as(Void*), 1_u64)
        end
        took = __iyi_monotonic_ns - started
        crowd.each { |pipe| __iyi_write(pipe[1], buffer.as(Void*), 1_u64) }
        0
      end
    end
    (crowd + [ping, pong]).each do |pipe|
      __iyi_close(pipe[0].to_i64)
      __iyi_close(pipe[1].to_i64)
    end
    took
  end

  # The best of three each, so that a busy machine's one slow run is not
  # read as a slow queue.
  alone = round_trips(0, 5000)
  crowded = round_trips(2000, 5000)
  2.times do
    again = round_trips(0, 5000)
    alone = again if again < alone
    again = round_trips(2000, 5000)
    crowded = again if again < crowded
  end
  fail("io: 5000 round trips took #{crowded * 10 // alone // 10}x as long with 2000 readers parked beside them") if crowded > alone * 3
  puts "5000 round trips took #{crowded // 1000000} ms with 2000 readers parked, #{alone // 1000000} ms alone"
{% end %}

# ── 1. Interleaving is real, and deterministic ──────────────────────────
#
# Two tasks ping-pong through two channels. A `group` that ran its tasks
# one after another — the imitation III.4.8 refused to ship — cannot
# produce this order: each letter needs the other task to have moved.
ping = Channel(Int32).new(1)
pong = Channel(Int32).new(1)
order = ""

group do |g|
  g.spawn do
    round = 0
    while round < 3
      ping.receive
      order = order + "a"
      pong.send(1)
      round = round + 1
    end
    0
  end
  g.spawn do
    round = 0
    while round < 3
      order = order + "b"
      ping.send(1)
      pong.receive
      round = round + 1
    end
    0
  end
end

fail("interleaving: expected bababa, got #{order}") unless order == "bababa"
puts "interleaved: #{order}"

# ── 2. Waits overlap ─────────────────────────────────────────────────────
# Asked by order, not by a clock: each sleeper notes when it began and when
# it woke, and the waits overlap when each began before the other woke. A
# sequential runtime cannot pass that however fast it is, and a machine
# that stalls cannot fail it however slow it is - the elapsed time this was
# once held to, under 260 ms for two 150 ms sleeps, was 529 ms once on a
# Windows runner, where a Windows machine ran the same build in 150. The
# marks are written to the heap as they are taken, so none of them is a
# register carried across a fiber switch.
marks = [0_i64, 0_i64, 0_i64, 0_i64]
group do |g|
  g.spawn do
    marks[0] = __iyi_monotonic_ns
    sleep(150)
    marks[1] = __iyi_monotonic_ns
  end
  g.spawn do
    marks[2] = __iyi_monotonic_ns
    sleep(150)
    marks[3] = __iyi_monotonic_ns
  end
end
unless marks[0] < marks[3] && marks[2] < marks[1]
  fail("overlap: two 150 ms sleeps ran one after the other, which is sequential")
end
first = marks[0] < marks[2] ? marks[0] : marks[2]
last = marks[1] > marks[3] ? marks[1] : marks[3]
puts "two 150 ms sleeps overlapped, in #{(last - first) // 1000000_i64} ms"

# ── 3. The first failing task cancels a *blocked* sibling — III.4.2/3 ───
started = __iyi_monotonic_ns
victim_saw = ""
group do |g|
  victim = g.spawn do
    slept = sleep(10000)
    victim_saw = slept.is_a?(Cancelled) ? "cancelled" : "slept"
    slept
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
cancelled_after = elapsed_ms(started)
fail("cancellation never reached the sleeping task") unless victim_saw == "cancelled"
fail("cancellation took #{cancelled_after} ms against a 10 s sleep") if cancelled_after >= 5000
puts "a failing task cancelled a sibling blocked in sleep, in #{cancelled_after} ms"

# ── 4. `!` drains a cancelled task through its later waits ──────────────
def two_naps : Nil | Cancelled
  sleep(10000)!
  sleep(10000)!
  nil
end

started = __iyi_monotonic_ns
drained = ""
group do |g|
  g.spawn do
    outcome = two_naps
    drained = outcome.is_a?(Cancelled) ? "propagated" : "finished"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("`!` did not propagate Cancelled out of the task body") unless drained == "propagated"
fail("draining a cancelled task took #{elapsed_ms(started)} ms") if elapsed_ms(started) >= 5000
puts "a cancelled task drained through `!`"

# ── 5. The poller: a read parks the fiber, the thread keeps working ─────
fds = make_pipe
read_fd = fds[0]
write_fd = fds[1]
io_order = ""

group do |g|
  g.spawn do
    io_order = io_order + "parked,"
    buffer = Pointer(UInt8).malloc(1_u64)
    got = iyi_read(read_fd, buffer.as(Void*), 1_u64)
    case got
    in Int64
      io_order = io_order + "read:#{buffer.value.to_i64}"
    in Cancelled
      io_order = io_order + "cancelled"
    end
    0
  end
  g.spawn do
    sleep(40)
    io_order = io_order + "wrote,"
    byte = Pointer(UInt8).malloc(1_u64)
    byte.value = 7_u8
    __iyi_write(write_fd, byte.as(Void*), 1_u64)
    0
  end
end

fail("poller: expected parked,wrote,read:7 — got #{io_order}") unless io_order == "parked,wrote,read:7"
puts "a read parked in the poller and a sleeping writer woke it"

# ── 5b. A read cancelled after its bytes came keeps them ────────────────
# Windows posts the read, so the bytes leave the pipe for it when they are
# written; a sibling that wrote three and failed in the same turn had the
# cancelled read answer `Cancelled`, the pipe empty, and the bytes written
# into the reader's buffer after the answer. POSIX waits for readability
# and then reads, so there the cancelled wait leaves them in the pipe.
# Either keeps them; neither writes into a buffer after its call is over.
kept_fds = make_pipe
kept_answer = "not asked"
kept = Pointer(UInt8).malloc(4_u64)
group do |g|
  g.spawn do
    got = iyi_read(kept_fds[0], kept.as(Void*), 3_u64)
    kept_answer = got.is_a?(Cancelled) ? "cancelled" : "#{got} bytes"
    0
  end
  g.spawn do
    sleep(20)
    __iyi_write(kept_fds[1], "abc".to_unsafe.as(Void*), 3_u64)
    TaskFailed.new
  end
end
kept_at_answer = "#{kept[0]},#{kept[1]},#{kept[2]}"
kept_left = 0_i64
if wait_readable(kept_fds[0].to_i32, 300) == true
  rest = Pointer(UInt8).malloc(4_u64)
  more = iyi_read(kept_fds[0], rest.as(Void*), 3_u64)
  kept_left = more if more.is_a?(Int64)
end
kept_later = "#{kept[0]},#{kept[1]},#{kept[2]}"
unless (kept_answer == "3 bytes" && kept_at_answer == "97,98,99" && kept_left == 0_i64) || (kept_answer == "cancelled" && kept_left == 3_i64)
  fail("a read cancelled after its bytes came answered #{kept_answer} with its buffer #{kept_at_answer}, and the pipe held #{kept_left} bytes after: they were lost")
end
fail("a cancelled read's buffer was written after its answer: #{kept_at_answer}, then #{kept_later}") unless kept_later == kept_at_answer
puts "a read cancelled after its bytes came kept them"

# ── 5c. A wait answered before it parks says what it found ──────────────
# `wait_readable(fd, ms)` answered the flag the last timed-out wait left:
# on Windows a pipe already holding three bytes completes the zero-byte
# read at once, and after one empty-pipe wait had timed out it answered
# false, after 0 ms. A regular file on Linux answers before the arm too.
stale_fds = make_pipe
stale_quiet = wait_readable(stale_fds[0].to_i32, 50)
__iyi_write(stale_fds[1], "abc".to_unsafe.as(Void*), 3_u64)
stale_holding = wait_readable(stale_fds[0].to_i32, 300)
fail("a wait on an empty pipe answered #{stale_quiet}, and then on one holding three bytes #{stale_holding}") unless stale_quiet == false && stale_holding == true
puts "a wait after a timed-out one found the bytes waiting"

# ── 5d. A handle read on one thread reads on another ────────────────────
# Windows only: each thread has its own completion port and a handle
# belongs to one, so a pipe read on the main thread and then on a worker
# had the worker's completions go to the main thread's port, and its read
# - deadline and all - waited forever. Fifty bytes already in the pipe
# answer the worker's first reads at once, which would leave fifty stray
# completions on its port if moving the handle lost the "skip a completion
# that answered at once" mode; the late read then woke on one of them.
{% if flag?(:win32) %}
  class Handoff
    @@outcome = Pointer(Atomic(UInt64)).malloc(1_u64)

    def self.outcome : Pointer(Atomic(UInt64))
      @@outcome
    end
  end

  # The worker's half, a def so nothing of the program's is captured:
  # fifty one-byte reads the pipe already holds, then the late five.
  def handoff_reads(fd : Int64) : Nil
    buffer = Pointer(UInt8).malloc(8_u64)
    ones = 0
    while ones < 50 && IyiScheduler.read_current(fd, buffer.as(Void*), 1_u64, 3000) == 1_i64
      ones = ones + 1
    end
    late = IyiScheduler.read_current(fd, buffer.as(Void*), 5_u64, 3000)
    whole = ones == 50 && late == 5_i64 && buffer[0] == 102_u8 && buffer[4] == 108_u8
    Handoff.outcome.value.set(whole ? 1_u64 : 2_u64)
  end

  handoff = make_pipe
  handed = Pointer(UInt8).malloc(64_u64)
  __iyi_write(handoff[1], "a".to_unsafe.as(Void*), 1_u64)
  fail("the main thread's read of the pipe to hand over failed") unless iyi_read(handoff[0], handed.as(Void*), 1_u64) == 1_i64
  __iyi_write(handoff[1], ("0123456789" * 5).to_unsafe.as(Void*), 50_u64)
  handed_fd = handoff[0]
  receiver = IyiThread.start { handoff_reads(handed_fd) }
  sleep(200)
  __iyi_write(handoff[1], "final".to_unsafe.as(Void*), 5_u64)
  waited = 0
  while Handoff.outcome.value.get == 0_u64 && waited < 500
    sleep(10)
    waited = waited + 1
  end
  handoff_outcome = Handoff.outcome.value.get
  fail("a pipe read on the main thread and then on a worker hung there for 5 s") if handoff_outcome == 0_u64
  fail("a pipe handed to a worker thread answered its reads wrongly") unless handoff_outcome == 1_u64
  receiver.join
  puts "a pipe read on the main thread was read on a worker, its late bytes too"
{% end %}

# ── 6. A closed channel drains, then refuses, and wakes the parked ──────
late = Channel(Int32).new(1)
closed_saw = ""
group do |g|
  g.spawn do
    value = late.receive
    closed_saw = value.is_a?(ChannelClosed) ? "closed" : "value"
    0
  end
  g.spawn do
    sleep(20)
    late.close
    0
  end
end
fail("close did not wake the parked receiver with ChannelClosed") unless closed_saw == "closed"
puts "close woke a parked receiver with ChannelClosed"

# ── 7. `task.value` joins and answers what the block returned ───────────
doubled = 0
group do |g|
  t = g.spawn do
    sleep(10)
    21
  end
  value = t.value
  doubled = value.is_a?(Int32) ? value * 2 : -1
end
fail("task.value answered #{doubled // 2}") unless doubled == 42
puts "task.value joined and answered"

# ── 7b. Any number of fibers read one task's value ─────────────────────
# The task kept one joiner, and a second fiber reading a task still
# running panicked "task already has a joiner". Every reader is woken,
# in the order it came: the owner first, since it asked before either
# task ran. A task that panics answers every reader `Panicked`, and the
# join owes no re-raise for a panic somebody read.
readers = ""
group do |g|
  slow_task = g.spawn do
    sleep(10)
    42
  end
  g.spawn do
    v = slow_task.value
    readers = readers + ",a:#{v.is_a?(Int32) ? v : -1}"
    0
  end
  g.spawn do
    v = slow_task.value
    readers = readers + ",b:#{v.is_a?(Int32) ? v : -1}"
    0
  end
  v = slow_task.value
  readers = readers + "owner:#{v.is_a?(Int32) ? v : -1}"
end
fail("readers: expected owner:42,a:42,b:42 — got #{readers}") unless readers == "owner:42,a:42,b:42"
broken_readers = ""
group do |g|
  failing_task = g.spawn do
    sleep(10)
    raise "the task several fibers read panicked, as it was meant to"
    0
  end
  2.times do
    g.spawn do
      v = failing_task.value
      broken_readers = broken_readers + (v.is_a?(Panicked) ? "P" : "?")
      0
    end
  end
end
fail("readers of a panicked task saw #{broken_readers}") unless broken_readers == "PP"
puts "three fibers read one task's value, and two read a panicked one's"

# ── 8. The join is deferred: an early return cannot leak a task ─────────
def leaves_early(finished : Pointer(Int32)) : Nil
  group do |g|
    g.spawn do
      sleep(30)
      finished.value = 1
      0
    end
    return
  end
end

flag = Pointer(Int32).malloc(4_u64)
flag.value = 0
leaves_early(flag)
fail("a `return` out of the group block left its task running") unless flag.value == 1
puts "an early return still joined the group"

# ── 8b. A group left early, or cancelled from outside, cancels its tasks ─
#
# III.4.2: "A group cancels its remaining children when the block leaves
# early, when a child fails under the group's policy, or when an enclosing
# group is cancelled." Only the policy held: `return 5` out of a block
# beside a task's 2-second sleep took the 2 seconds and the sleep answered
# in full, and so did a task's own group when the group around the task
# failed - its owner waited in the inner join, or on a typed group's
# values, and no cancel reached either park. Every sleep here is 10 s,
# against a 5 s bound; a task started by a cancelled one is cancelled too.
def napped(ms : Int32) : String
  sleep(ms).is_a?(Cancelled) ? "cancelled" : "slept"
end

def refusal(fails : Bool) : Int32 | TaskFailed
  return TaskFailed.new if fails
  0
end

def leave_by_return(log : Array(String)) : Int32
  group do |g|
    g.spawn do
      log << "return " + napped(10000)
      0
    end
    return 5
  end
  0
end

def leave_by_bang(log : Array(String)) : Int32 | TaskFailed
  group do |g|
    g.spawn do
      log << "! " + napped(10000)
      0
    end
    refusal(true)!
  end
  0
end

def typed_inner(log : Array(String)) : Tuple(String, Int32) | Cancelled | Panicked
  group do |h|
    a = h.spawn do
      saw = napped(10000)
      log << "typed " + saw
      saw
    end
    b = h.spawn { 2 }
  end!
end

early = [] of String
started = __iyi_monotonic_ns
fail("a `return 5` out of a group block answered something else") unless leave_by_return(early) == 5
fail("a `!` out of a group block did not leave as the error") unless leave_by_bang(early).is_a?(TaskFailed)
group do |g|
  g.spawn do
    early << "break " + napped(10000)
    0
  end
  break
end
fail("leaving a group block early took #{elapsed_ms(started)} ms beside 10 s sleeps") if elapsed_ms(started) >= 5000
fail("leaving a group block early did not cancel its task: #{early}") unless early == ["return cancelled", "! cancelled", "break cancelled"]
puts "a block left by `return`, `!` or `break` cancelled its sleeping task, under 5 s"

outer = [] of String
started = __iyi_monotonic_ns
group do |g|
  g.spawn do
    group do |h|
      h.spawn do
        outer << "joined " + napped(10000)
        0
      end
    end
    0
  end
  g.spawn do
    answered = typed_inner(outer)
    outer << "typed answered " + (answered.is_a?(Tuple(String, Int32)) ? answered[0] : "an error")
    0
  end
  g.spawn do
    outer << "owner " + napped(10000)
    group do |h|
      h.spawn do
        outer << "started late " + napped(10000)
        0
      end
    end
    0
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("a failing group took #{elapsed_ms(started)} ms to stop its grandchildren") if elapsed_ms(started) >= 5000
heard = outer.sorted.join(", ")
unless heard == "joined cancelled, owner cancelled, started late cancelled, typed answered cancelled, typed cancelled"
  fail("a cancel did not reach a task's own group: #{heard}")
end
puts "a failing group cancelled its tasks' own groups, joined, read or started late, under 5 s"

# ── 9. A rendezvous send parks until its value is taken ─────────────────
#
# `Channel(T).new` with no capacity: the sender cannot leave `send` until
# a receiver takes the value, and the order string is the witness — "s1"
# can only follow "r". A buffered channel would print "s0,s1,r".
meet = Channel(Int32).new
meet_order = ""
group do |g|
  g.spawn do
    meet_order = meet_order + "s0,"
    meet.send(11)
    meet_order = meet_order + "s1"
    0
  end
  g.spawn do
    sleep(20)
    meet_order = meet_order + "r,"
    value = meet.receive
    value.is_a?(Int32) ? value : -1
  end
end
fail("rendezvous: expected s0,r,s1 — got #{meet_order}") unless meet_order == "s0,r,s1"
puts "a rendezvous send parked until its value was taken"

# ── 10. And the other way round: a parked receiver completes the send ───
meet2 = Channel(Int32).new
got2 = 0
group do |g|
  g.spawn do
    value = meet2.receive
    got2 = value.is_a?(Int32) ? value : -1
    0
  end
  g.spawn do
    sleep(20)
    meet2.send(23)
    0
  end
end
fail("rendezvous: the parked receiver got #{got2}") unless got2 == 23
puts "a parked receiver completed a rendezvous send"

# ── 11. Parked sends complete in the order they parked ──────────────────
#
# The def is load-bearing: a `while` body is one scope, so a closure made
# in it would capture one shared variable; a parameter is a fresh binding.
def spawn_send(g : IyiGroup, fifo : Channel(Int32), n : Int32) : Nil
  g.spawn do
    fifo.send(n)
    0
  end
  nil
end

fifo = Channel(Int32).new
drained = ""
group do |g|
  index = 1
  while index <= 3
    spawn_send(g, fifo, index)
    index = index + 1
  end
  g.spawn do
    sleep(20)
    round = 0
    while round < 3
      value = fifo.receive
      drained = drained + (value.is_a?(Int32) ? value.to_s : "?")
      round = round + 1
    end
    0
  end
end
fail("rendezvous FIFO: expected 123, got #{drained}") unless drained == "123"
puts "parked sends completed in park order"

# ── 12. Cancellation reaches a parked sender; its value dies undelivered ─
lonely = Channel(Int32).new
sender_saw = ""
group do |g|
  g.spawn do
    outcome = lonely.send(99)
    sender_saw = outcome.is_a?(Cancelled) ? "cancelled" : "sent"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("a parked sender was not cancelled: #{sender_saw}") unless sender_saw == "cancelled"
# Had the cancelled send's value leaked into the buffer, this receive
# would answer 99; a closed empty channel answers ChannelClosed.
lonely.close
received_late = lonely.receive
fail("a cancelled send's value was delivered anyway") if received_late.is_a?(Int32)
puts "a cancelled rendezvous send died undelivered"

# ── 12b. A rendezvous send completes only when a receive takes it ───────
#
# A send that found a receiver parked put its value in the channel and
# answered delivered on the word of the wake. A select woken that way
# took an arm that was ready by then - "first:1" - and left "second:2" in
# a channel with no capacity after its sender was told it was taken; a
# receiver cancelled before it ran answered `Cancelled` and left the 5.
# The sender writes the value into the receiver's node now, so the wake
# is the delivery, and the sender the select did not take stays parked.
rv_first = Channel(Int32).new
rv_second = Channel(Int32).new
rv_log = ""
group do |g|
  g.spawn do
    select
    when rv_x = rv_first.receive
      rv_log = rv_log + "select first:#{rv_x};"
    when rv_y = rv_second.receive
      rv_log = rv_log + "select second:#{rv_y};"
    end
    # What the channels hold now, taken without parking.
    select
    when rv_x = rv_first.receive
      rv_log = rv_log + "then first:#{rv_x};"
    else
    end
    select
    when rv_y = rv_second.receive
      rv_log = rv_log + "then second:#{rv_y};"
    else
    end
    0
  end
  g.spawn do
    rv_second.send(2)
    0
  end
  g.spawn do
    rv_first.send(1)
    0
  end
end
fail("rendezvous select: #{rv_log}") unless rv_log == "select second:2;then first:1;"
rv_box = Channel(Int32).new
rv_saw = ""
group do |g|
  g.spawn do
    rv_got = rv_box.receive
    rv_saw = rv_got.is_a?(Int32) ? "took #{rv_got}" : "refused"
    0
  end
  g.spawn do
    rv_box.send(5)
    TaskFailed.new
  end
end
rv_left = "nothing"
select
when rv_got = rv_box.receive
  rv_left = rv_got.inspect
else
end
fail("rendezvous: a receiver cancelled after a send was handed it answered #{rv_saw}, and the channel held #{rv_left}") unless rv_saw == "took 5" && rv_left == "nothing"
puts "a rendezvous send was delivered to the receive it woke"

# ── 13. Closing fails a parked sender, loudly ───────────────────────────
doomed = Channel(Int32).new
closed_send = ""
group do |g|
  g.spawn do
    outcome = doomed.send(7)
    closed_send = outcome.is_a?(ChannelClosed) ? "refused" : "other"
    0
  end
  g.spawn do
    sleep(20)
    doomed.close
    0
  end
end
fail("close did not fail the parked sender: #{closed_send}") unless closed_send == "refused"
puts "close failed a parked sender with ChannelClosed"

# ── 14. `select` takes the arm that is ready ────────────────────────────
left = Channel(Int32).new
right = Channel(String).new
picked = ""
group do |g|
  g.spawn do
    sleep(20)
    right.send("hello")
    0
  end
  g.spawn do
    select
    when n = left.receive
      picked = "left"
    when s = right.receive
      picked = s.is_a?(String) ? "right:#{s}" : "right:?"
    end
    0
  end
end
fail("select: expected right:hello, got #{picked}") unless picked == "right:hello"
puts "select took the arm that became ready"

# ── 15. A select's send arm can win while parked ────────────────────────
narrow = Channel(Int32).new
sent_arm = ""
group do |g|
  g.spawn do
    select
    when narrow.send(31)
      sent_arm = "sent"
    when n = Channel(Int32).new(1).receive
      sent_arm = "impossible"
    end
    0
  end
  g.spawn do
    sleep(20)
    value = narrow.receive
    value.is_a?(Int32) ? value : -1
  end
end
fail("select: the parked send arm saw #{sent_arm}") unless sent_arm == "sent"
puts "a select's send arm won while parked"

# ── 16. `select` with an `else` does not park ───────────────────────────
idle = Channel(Int32).new
took_else = ""
select
when n = idle.receive
  took_else = "arm"
else
  took_else = "else"
end
fail("select else: got #{took_else}") unless took_else == "else"
puts "select with nothing ready took its else"

# ── 16a. `when timeout(ms)`, and an arm nobody binds ────────────────────
#
# The timeout arm the other library's `select` has was "undefined method
# 'timeout_select_action'". An unbound send arm ran its body when nothing
# was sent: on a closed channel, and in a cancelled task.
idle_arm = Channel(Int32).new
timeout_seen = ""
started = __iyi_monotonic_ns
select
when idle_got = idle_arm.receive
  timeout_seen = "received"
when timeout(50)
  timeout_seen = "timed out"
end
waited_ms = elapsed_ms(started)
fail("select timeout: #{timeout_seen} after #{waited_ms} ms") unless timeout_seen == "timed out" && waited_ms >= 45 && waited_ms < 5000
early_arm = Channel(Int32).new
timeout_seen = ""
group do |g|
  g.spawn do
    sleep(10)
    early_arm.send(4)
    0
  end
  g.spawn do
    select
    when early_got = early_arm.receive
      timeout_seen = "received #{early_got}"
    when timeout(5000)
      timeout_seen = "timed out"
    end
    0
  end
end
fail("select timeout: a value sent first answered #{timeout_seen}") unless timeout_seen == "received 4"

# A select whose deadline passes while a sender wakes it, before it runs,
# is woken by both: the clock is read before the run queue every 256th
# park, and it queued the fiber a second time - "a done fiber was
# scheduled", which the .sh looks for in this program's output.
racing = Channel(Int32).new(1)
raced = 0
600.times do |round|
  (round % 5).times { sleep(0) }
  group do |g|
    g.spawn do
      select
      when race_got = racing.receive
        raced = raced + 1
      when timeout(1)
        racing.receive
      end
      0
    end
    g.spawn do
      until_ns = __iyi_monotonic_ns + 1500000_i64
      while __iyi_monotonic_ns < until_ns
      end
      racing.send(1)
      0
    end
  end
end
fail("select timeout: #{raced} of 600 values sent after the deadline were taken") unless raced == 600

unbound_ran = [] of String
shut = Channel(Int32).new(1)
shut.close
select
when shut.send(1)
  unbound_ran << "closed"
end
unheard = Channel(Int32).new
group do |g|
  g.spawn do
    sleep(50)
    select
    when unheard.send(1)
      unbound_ran << "cancelled"
    end
    0
  end
  g.spawn do
    sleep(10)
    TaskFailed.new
  end
end
fail("an unbound send arm ran its body with nothing sent: #{unbound_ran}") unless unbound_ran.empty?
puts "a select timed out, lost no value to its deadline, and ran no unbound arm whose send did not happen"

# ── 16b. A ring of tasks passing a value allocates nothing per message ──
#
# Every park took a node from the heap - a receiver's and, where the
# value's next owner had not parked yet, a sender's - and the channel's
# buffer, an array shifted from the front, grew anew every few messages:
# 55 bytes a round trip, fifteen million allocations in crystal-metric's
# Threadring and a collection every few hundred thousand messages. A
# fiber keeps its receive node, a channel its send node, and the buffer is
# a ring.
{% unless flag?(:gc_none) || flag?(:gc_boehm) %}
  def ring_bytes(tasks : Int32, passes : Int32) : UInt64
    chans = Array.new(tasks) { Channel(Int32).new }
    done = Channel(Int32).new
    GC.disable
    before = GC.stats.bytes_since_collection
    group do |g|
      tasks.times do |i|
        spawn_ring_member(g, chans[i], chans[(i + 1) % tasks], done)
      end
      # The last member parks on this channel before this send has read
      # its receipt, so a node handed out again too early is read here as
      # refused - and taken out of the queue under the last member's send.
      started = chans[0].send(passes)
      fail("receipt: the ring's first send was taken and read as refused") unless started.is_a?(Nil)
      done.receive
      chans.each(&.close)
      0
    end
    used = GC.stats.bytes_since_collection - before
    GC.enable
    used
  end

  def spawn_ring_member(g : IyiGroup, mine : Channel(Int32), after : Channel(Int32), done : Channel(Int32)) : Nil
    g.spawn do
      while true
        case v = mine.receive
        in Int32
          if v == 0
            done.send(0)
            break
          end
          after.send(v - 1)
        in ChannelClosed, Cancelled
          break
        end
      end
      0
    end
  end

  # Two tasks answering each other: here the receiver is the one that
  # parks, where in the ring above it is the sender.
  def ping_pong_bytes(rounds : Int32) : UInt64
    ping = Channel(Int32).new
    pong = Channel(Int32).new
    GC.disable
    before = GC.stats.bytes_since_collection
    group do |g|
      g.spawn do
        rounds.times { ping.receive; pong.send(1) }
        0
      end
      g.spawn do
        rounds.times { ping.send(1); pong.receive }
        0
      end
    end
    used = GC.stats.bytes_since_collection - before
    GC.enable
    used
  end

  # What starting costs is the same for any number of messages, so the
  # difference between two lengths is what the messages cost.
  short_ring = ring_bytes(8, 1000)
  long_ring = ring_bytes(8, 101000)
  per_pass = long_ring > short_ring ? (long_ring - short_ring) // 100000_u64 : 0_u64
  fail("ring: #{per_pass} bytes a message around a ring, where a message allocates nothing") if per_pass > 0_u64
  short_pong = ping_pong_bytes(1000)
  long_pong = ping_pong_bytes(101000)
  per_round = long_pong > short_pong ? (long_pong - short_pong) // 100000_u64 : 0_u64
  fail("ring: #{per_round} bytes a round trip between two tasks, where a round trip allocates nothing") if per_round > 0_u64
  puts "100000 messages around a ring and 100000 round trips allocated nothing for them"
{% end %}

# ── 16c. A send node is handed out again only once its sender has read it ─
#
# The channel keeps the node its last parked sender used. Taken off the
# queue, the node's sender is woken but has not run: it still has to read
# whether its value was delivered. A sender that parks in between must get
# a node of its own, or it rewrites the receipt and the first sender reads
# its delivered value as refused.
receipt = Channel(Int32).new
first_answer = "unset"
group do |g|
  g.spawn do
    answer = receipt.send(1)
    first_answer = answer.is_a?(Nil) ? "delivered" : "refused"
    # Named here, not after the join: a sender that reads its delivered
    # value as refused takes its node out of the queue, the node is the
    # second sender's by then, and the third task would wait for ever.
    fail("receipt: the first sender's delivered value read as #{first_answer}") unless first_answer == "delivered"
    0
  end
  g.spawn do
    sleep(10)
    got = receipt.receive
    fail("receipt: received #{got.inspect}, not 1") unless got == 1
    # The first sender is woken and has not run yet; this send parks.
    receipt.send(2)
    0
  end
  g.spawn do
    sleep(40)
    got = receipt.receive
    fail("receipt: received #{got.inspect}, not 2") unless got == 2
    0
  end
end
puts "a parked sender's receipt survived the next sender's park"

# ── 16d. A select's losing arms leave their queues ──────────────────────
#
# A select parks a node in every arm's channel, and a losing arm's node
# stayed in its queue until something walked it off the head: a loop
# selecting over a busy channel and an idle one left a node in the idle
# one's queue for every park, kept until the idle channel was used. The
# woken select takes every node out, so 200,000 messages through such a
# loop may leave at most 256 KiB more kept by a collection than before.
# Asked halfway through 400,000, because the closing send to the idle
# channel walks its queue and empties it.
{% unless flag?(:gc_none) || flag?(:gc_boehm) %}
  def select_kept_bytes(rounds : Int32) : UInt64
    work = Channel(Int32).new
    quit = Channel(Int32).new
    grown = 0_u64
    GC.collect
    before = GC.stats.bytes_kept_by_last_sweep
    group do |g|
      g.spawn do
        rounds.times { |i| work.send(i) }
        quit.send(0)
        0
      end
      g.spawn do
        taken = 0
        while taken >= 0
          select
          when v = work.receive
            taken = taken + 1
            if taken == rounds // 2
              GC.collect
              after = GC.stats.bytes_kept_by_last_sweep
              grown = after > before ? after - before : 0_u64
            end
          when q = quit.receive
            taken = -1
          end
        end
        0
      end
    end
    grown
  end

  select_grown = select_kept_bytes(400000)
  if select_grown > 256_u64 * 1024_u64
    fail("select: 200000 selects beside an idle channel left #{select_grown // 1024_u64} KiB more kept")
  end
  puts "200000 selects beside an idle channel kept under 256 KiB more"
{% end %}

# ── 16e. A channel keeps no value it has handed out ─────────────────────
#
# A buffered channel's ring kept every value until a later send wrote over
# its slot, and a rendezvous channel's spare send node kept the last value
# parked through it: 50 messages of 4 MB through a channel of 50, all
# received, kept 190 MiB, and 48 MB through a rendezvous 238 MiB, for as
# long as the channels lived. 64 MB each way here, against 16 MiB.
{% unless flag?(:gc_none) || flag?(:gc_boehm) %}
  class KeptChannels
    getter buffered : Channel(String)
    getter rendezvous : Channel(String)

    def initialize
      @buffered = Channel(String).new(16)
      @rendezvous = Channel(String).new
    end
  end

  def kept_now : UInt64
    GC.collect
    GC.stats.bytes_kept_by_last_sweep
  end

  def through_buffered(ch : Channel(String)) : Nil
    16.times do |i|
      ch.send("#{i}" + ("v" * 4000000))
      ch.receive
    end
  end

  def through_rendezvous(ch : Channel(String)) : Nil
    group do |g|
      g.spawn do
        ch.send("r" * 64000000)
        0
      end
      g.spawn do
        sleep(5)
        ch.receive
        0
      end
    end
  end

  # Writes over the stack a finished call left, so what stays kept is the
  # channels' and not a stale frame's.
  def scrub_stack(depth : Int32) : Int32
    a = 0_u64
    b = 0_u64
    depth > 0 ? scrub_stack(depth - 1) + (a + b).to_i32 : 0
  end

  holding = KeptChannels.new
  kept_before = kept_now
  through_buffered(holding.buffered)
  scrub_stack(50)
  kept_buffered = kept_now
  through_rendezvous(holding.rendezvous)
  scrub_stack(50)
  kept_rendezvous = kept_now
  mib = 1048576_u64
  grew = kept_buffered > kept_before ? kept_buffered - kept_before : 0_u64
  fail("channel: 64 MB received through a buffered channel left #{grew // mib} MiB kept") if grew > 16_u64 * mib
  grew = kept_rendezvous > kept_before ? kept_rendezvous - kept_before : 0_u64
  fail("channel: 64 MB received through a rendezvous left #{grew // mib} MiB kept") if grew > 16_u64 * mib
  puts "a live channel kept under 16 MiB of the 64 MB it handed out, buffered or rendezvous"
  holding.buffered.close
{% end %}

# ── 17. The typed group — III.4.9 ────────────────────────────────────────
#
# Two direct spawns make the group a value: the tuple of what they
# answered, or the first error member, with `!` propagating it out of the
# enclosing def through III.1.2's ordinary machinery.
def fetch_pair(fail_second : Bool) : Tuple(Int32, Int32) | TaskFailed | Cancelled | Panicked
  group do |g|
    x = g.spawn do
      slept = sleep(10)
      slept.is_a?(Cancelled) ? slept : 21
    end
    y = g.spawn do
      slept = sleep(fail_second ? 20 : 10)
      slept.is_a?(Cancelled) ? slept : (fail_second ? TaskFailed.new : 2)
    end
  end!
end

pair = fetch_pair(false)
case pair
in Tuple(Int32, Int32) then fail("typed group: got #{it[0]}, #{it[1]}") unless it[0] == 21 && it[1] == 2
in TaskFailed          then fail("typed group: failed on the success path")
in Cancelled           then fail("typed group: cancelled on the success path")
in Panicked            then fail("typed group: panicked on the success path")
end
puts "a typed group answered its tuple"

started = __iyi_monotonic_ns
broken = fetch_pair(true)
fail("typed group: the failure did not leave as the error") unless broken.is_a?(TaskFailed)
puts "a typed group's first failure left as the error"

# One variable for both spawns is still two slots, each read through a
# handle of its own (`%h1`, `%h2`). Each slot read the author's variable
# after the join, so both read the last task: {2, 2}, and a failing first
# task's error was lost.
def fetch_reused(fail_first : Bool) : Tuple(Int32, Int32) | TaskFailed | Cancelled | Panicked
  group do |g|
    t = g.spawn do
      slept = sleep(10)
      slept.is_a?(Cancelled) ? slept : (fail_first ? TaskFailed.new : 21)
    end
    t = g.spawn do
      slept = sleep(20)
      slept.is_a?(Cancelled) ? slept : 2
    end
  end!
end

reused = fetch_reused(false)
case reused
in Tuple(Int32, Int32) then fail("typed group, one name reused: got #{it[0]}, #{it[1]}") unless it[0] == 21 && it[1] == 2
in TaskFailed          then fail("typed group, one name reused: failed on the success path")
in Cancelled           then fail("typed group, one name reused: cancelled on the success path")
in Panicked            then fail("typed group, one name reused: panicked on the success path")
end
fail("typed group, one name reused: the first task's failure was lost") unless fetch_reused(true).is_a?(TaskFailed)
puts "a typed group reusing one name for two spawns kept both slots and the first failure"

# The error that stopped the group leaves it, not a sibling's
# `Cancelled`: the first task, asleep when the second failed, is cancelled
# by that failure and answers `Cancelled`, and the slots asked in text
# order answered that in the failure's place.
def fetch_stopped(fail_second : Bool) : Tuple(Int32, Int32) | TaskFailed | Cancelled | Panicked
  group do |g|
    x = g.spawn do
      slept = sleep(5000)
      slept.is_a?(Cancelled) ? slept : 21
    end
    y = g.spawn do
      slept = sleep(10)
      slept.is_a?(Cancelled) ? slept : (fail_second ? TaskFailed.new : 2)
    end
  end!
end

stopped = fetch_stopped(true)
fail("typed group: a sibling's Cancelled left in place of the failure that cancelled it") unless stopped.is_a?(TaskFailed)
puts "a typed group answered the failure that stopped it, not the Cancelled it caused"

# `_ =` is the explicit discard (III.4.9): no slot in the tuple. It took
# one, and `{30, 40}` came back for `{40}`. Its failure still stopped the
# group, and still leaves it.
def fetch_discarding(fail_discarded : Bool) : Tuple(Int32) | TaskFailed | Cancelled | Panicked
  group do |g|
    _ = g.spawn { fail_discarded ? TaskFailed.new : 1 }
    y = g.spawn { 2 }
  end!
end

one_slot = fetch_discarding(false)
fail("typed group, one spawn discarded: not the one-slot tuple {2}") unless one_slot.is_a?(Tuple(Int32)) && one_slot[0] == 2
fail("typed group: a discarded task's failure did not leave") unless fetch_discarding(true).is_a?(TaskFailed)
puts "a typed group gave a discarded spawn no slot, and its failure still left"

# A task that panics is the typed group's `Panicked` (III.1.4): reading a
# value catches its task's panic, and the values are read before the join.
# The join came first and re-raised the panic nobody had read yet, so the
# program died where the group was to answer.
def explode(n : Int32) : Int32
  raise "a typed group's task panicked, as it was meant to" if n > 0
  n
end

def fetch_panicking : Tuple(Int32, Int32) | Cancelled | Panicked
  group do |g|
    x = g.spawn { explode(1) }
    y = g.spawn { 2 }
  end!
end

fail("typed group: a panicking task did not answer Panicked") unless fetch_panicking.is_a?(Panicked)
puts "a typed group answered a panicking task's Panicked"

# A block whose last expression is its own answers that: the expansion
# appended the tuple after it, and the block's answer was thrown away.
summary = group do |g|
  a = g.spawn { 20 }
  b = g.spawn { 1 }
  "#{a.value.to_s} and #{b.value.to_s}"
end
fail("a group answered #{summary} for its block's last expression") unless summary.is_a?(String) && summary == "20 and 1"
puts "a group whose block ends in its own expression answers it"

# Macro code in the block keeps the general form: what a `{% for %}`
# writes is text when the expansion is decided, so its spawns were no
# slots - the tuple came out one short, and their errors were dropped.
macro_shape = group do |g|
  g.spawn { 1 }
  {% for n in [2, 3] %}
    g.spawn { {{n}} }
  {% end %}
end
fail("a group with macro-written spawns was typed") unless macro_shape.is_a?(IyiTask(Int32))
puts "a group with macro-written spawns kept the general form"

# ── 18. A dynamic group keeps the general form ───────────────────────────
#
# A spawn in a loop has no arity, so the group stays `Nil` and handles
# answer through `task.value` — the expansion refusing quietly is the
# method call standing as written.
drainer = Channel(Int32).new(3)
shape = group do |g|
  index = 0
  while index < 3
    spawn_send(g, drainer, index)
    index = index + 1
  end
end
fail("a loop-spawning group grew a type") unless shape.is_a?(Nil)
round = 0
while round < 3
  drainer.receive
  round = round + 1
end
puts "a dynamic group kept the general form"

# ── 19. A switch keeps what the calling convention says a call keeps ─────
#
# A fiber switch is a call, so every register the platform's convention
# says survives a call survives it: on Windows x64 that is xmm6-xmm15 as
# well as the integer ones, and the switch carried the integer ones only.
# Two fibers hold ten doubles each across every handoff, loaded from
# memory so the optimiser cannot compute them again afterwards and has to
# keep them somewhere; in a --release build it kept them in xmm6-xmm15,
# and 2,000 of the 4,000 checks read the other fiber's.
def hold_doubles(v : Array(Float64), out_ch : Channel(Int32), in_ch : Channel(Int32), rounds : Int32, first : Bool) : Int32
  bad = 0
  round = 0
  while round < rounds
    a = v[0]
    b = v[1]
    c = v[2]
    d = v[3]
    e = v[4]
    f = v[5]
    g = v[6]
    h = v[7]
    i = v[8]
    j = v[9]
    if first
      out_ch.send(1)
      in_ch.receive
    else
      in_ch.receive
      out_ch.send(1)
    end
    bad = bad + 1 if a != v[0] || b != v[1] || c != v[2] || d != v[3] || e != v[4]
    bad = bad + 1 if f != v[5] || g != v[6] || h != v[7] || i != v[8] || j != v[9]
    round = round + 1
  end
  bad
end

mine = [1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5]
theirs = [-1.25, -2.25, -3.25, -4.25, -5.25, -6.25, -7.25, -8.25, -9.25, -10.25]
there = Channel(Int32).new
back = Channel(Int32).new
changed = 0
group do |g|
  g.spawn do
    changed = changed + hold_doubles(mine, there, back, 1000, true)
    0
  end
  g.spawn do
    changed = changed + hold_doubles(theirs, back, there, 1000, false)
    0
  end
end
fail("switch: #{changed} checks found a double changed across a fiber switch") if changed != 0
puts "ten doubles each, held by two fibers across 2,000 switches, unchanged"

# ── 20. A task gets its stack when it first runs ──────────────────────────
#
# Two thousand short tasks spawned in one loop, none of which runs until
# the loop is done: a stack mapped at spawn gave each its own, and a burst
# of 33,000 ran a default kernel out of mappings. Taken when a task first
# runs, the stack the last one finished on is the next one's, and the
# burst runs on a handful.
burst_tops = [] of UInt64
group do |g|
  2000.times do
    g.spawn do
      burst_tops << IyiScheduler.current.stack_top
      0
    end
  end
end
burst_distinct = [] of UInt64
burst_tops.each { |top| burst_distinct << top unless burst_distinct.includes?(top) }
fail("burst: #{burst_tops.size} of 2000 tasks ran") if burst_tops.size != 2000
fail("burst: 2000 spawned tasks ran on #{burst_distinct.size} stacks") if burst_distinct.size > 8
puts "2000 spawned tasks ran on #{burst_distinct.size} stacks"

# ── 21. A busy run queue still lets the clock and the poller in ──────────
#
# Both were looked at only when the run queue was empty, and a yield keeps
# it full: a task polling a flag with `sleep(0)` spun 20,000,000 times
# while the task sleeping 10 ms to set it never woke, and a `sleep(50)`
# beside a channel ping-pong woke when the ping-pong stopped by itself. A
# 200 ms bound, generous for the emulated arm; a wait that starves runs
# into the loops' own 2 s cap instead, and is named.
spin_started = __iyi_monotonic_ns
spin_flag = false
spin_seen = -1_i64
group do |g|
  g.spawn do
    sleep(10)
    spin_flag = true
    0
  end
  g.spawn do
    spins = 0
    while !spin_flag
      spins = spins + 1
      break if spins % 1024 == 0 && elapsed_ms(spin_started) >= 2000
      sleep(0)
    end
    spin_seen = elapsed_ms(spin_started)
    0
  end
end
fail("starvation: a 10 ms sleeper beside a sleep(0) loop woke after #{spin_seen} ms, over the 200 ms bound") if spin_seen >= 200

busy_ping = Channel(Int32).new
busy_pong = Channel(Int32).new
busy_stop = false
busy_started = __iyi_monotonic_ns
busy_woke = -1_i64
group do |g|
  g.spawn do
    sleep(50)
    busy_woke = elapsed_ms(busy_started)
    busy_stop = true
    0
  end
  g.spawn do
    rounds = 0
    while !busy_stop
      busy_ping.send(rounds)
      busy_pong.receive
      rounds = rounds + 1
      break if rounds % 1024 == 0 && elapsed_ms(busy_started) >= 2000
    end
    busy_ping.close
    0
  end
  g.spawn do
    while true
      v = busy_ping.receive
      break unless v.is_a?(Int32)
      busy_pong.send(v)
    end
    0
  end
end
fail("starvation: a 50 ms sleeper beside a channel ping-pong woke after #{busy_woke} ms, over the 200 ms bound") if busy_woke >= 200

busy_fds = make_pipe
byte_seen = false
byte_started = __iyi_monotonic_ns
byte_after = -1_i64
group do |g|
  g.spawn do
    buffer = Pointer(UInt8).malloc(1_u64)
    iyi_read(busy_fds[0], buffer.as(Void*), 1_u64)
    byte_seen = true
    0
  end
  g.spawn do
    byte = Pointer(UInt8).malloc(1_u64)
    byte.value = 9_u8
    byte_started = __iyi_monotonic_ns
    __iyi_write(busy_fds[1], byte.as(Void*), 1_u64)
    spins = 0
    while !byte_seen
      spins = spins + 1
      break if spins % 1024 == 0 && elapsed_ms(byte_started) >= 2000
      sleep(0)
    end
    byte_after = elapsed_ms(byte_started)
    0
  end
end
fail("starvation: a byte written to a pipe beside a sleep(0) loop was read after #{byte_after} ms, over the 200 ms bound") if byte_after >= 200
puts "a sleep(0) loop and a channel ping-pong let a sleeper and a pipe's reader in, under the 200 ms bound"

# ── 22. A block's own captured variable keeps its own cell ──────────────
#
# A task handle held by a group's block and read by a sibling task, and a
# channel the program names the same after that block: two variables, so
# two cells. The compiler gave every closure the later variable's cell,
# and died building this with "BUG: trying to downcast IyiTask(Int32) <-
# Channel(Int32)"; a proc reading a block's own Int32 beside a later String
# of the same name died the same way.
held = 0
group do |g|
  twin = g.spawn do
    41
  end
  g.spawn do
    value = twin.value
    held = value.is_a?(Int32) ? value : -1
    0
  end
end
twin = Channel(Int32).new
passed = 0
group do |g|
  g.spawn do
    twin.send(7)
    0
  end
  g.spawn do
    value = twin.receive
    passed = value.is_a?(Int32) ? value : -1
    0
  end
end
fail("a block's own task handle read #{held} and the later channel passed #{passed}, not 41 and 7") unless held == 41 && passed == 7
[2].each do |n|
  named = n
  fail("a proc read a block's own variable as #{-> { named + 1 }.call}, not 3") unless -> { named + 1 }.call == 3
end
named = "late"
fail("a proc read the later variable's size as #{-> { named.size }.call}, not 4") unless -> { named.size }.call == 4
puts "a block's own captured variable and a later one of the same name keep a cell each"

puts "concurrency exercise: every property held"
