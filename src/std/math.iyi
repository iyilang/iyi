  def self.log(value : Float64) : Float64
    ix = IyiFloatText.bits_of(value)
    # 1 - 2^-4 <= x < 1 + 0x1.09p-4: the polynomial in x - 1.
    if ix &- 0x3fee000000000000_u64 < 0x3ff1090000000000_u64 &- 0x3fee000000000000_u64
      return 0.0 if ix == 0x3ff0000000000000_u64
      r = value - 1.0
      r2 = r * r
      r3 = r * r2
      y = r3 * (LOG_B1 + r * LOG_B2 + r2 * LOG_B3 + r3 * (LOG_B4 + r * LOG_B5 + r2 * LOG_B6 + r3 * (LOG_B7 + r * LOG_B8 + r2 * LOG_B9 + r3 * LOG_B10)))
      w = r * 134217728.0
      rhi = r + w - w
      rlo = r - rhi
      w = rhi * rhi * LOG_B0
      hi = r + w
      lo = r - hi + w
      lo = lo + LOG_B0 * rlo * (rhi + r)
      y = y + lo
      return y + hi
    end
    top = ix.unsafe_shr(48_u64).to_i64
    if top < 0x10_i64 || top >= 0x7ff0_i64
      # Subnormal, zero, negative, infinite or NaN.
      return (1.0 / 0.0) * -1.0 if ix &* 2_u64 == 0_u64
      return value if ix == 0x7ff0000000000000_u64
      return (value - value) / (value - value) if top & 0x8000_i64 != 0_i64 || top & 0x7ff0_i64 == 0x7ff0_i64
      ix = IyiFloatText.bits_of(value * 4503599627370496.0) &- 0x0340000000000000_u64
    end
    tmp = ix &- 0x3fe6000000000000_u64
    i = (tmp.unsafe_shr(45_u64) & 127_u64).to_i32
    k = tmp.unsafe_to_i64 >> 52
    iz = ix &- (tmp & 0xfff0000000000000_u64)
    table = LOG_TAB.to_unsafe
    invc = IyiFloatText.from_bits(table[i * 4])
    logc = IyiFloatText.from_bits(table[i * 4 + 1])
    z = IyiFloatText.from_bits(iz)
    r = (z - IyiFloatText.from_bits(table[i * 4 + 2]) - IyiFloatText.from_bits(table[i * 4 + 3])) * invc
    kd = k.to_f64
    w = kd * LOG_LN2HI + logc
    hi = w + r
    lo = w - hi + r + kd * LOG_LN2LO
    r2 = r * r
    lo + r2 * LOG_A0 + r * r2 * (LOG_A1 + r * LOG_A2 + r2 * (LOG_A3 + r * LOG_A4)) + hi
  end

  def self.log(value : Float32) : Float32
    log(value.to_f64).to_f32
  end

  def self.log(value : T) : Float64 forall T
    log(value.to_f64)
  end

  def self.log(value : Float64, base : Float64) : Float64
    log(value) / log(base)
  end

  def self.log(value : T, base : U) : Float64 forall T, U
    log(value.to_f64, base.to_f64)
  end

  # log2 as glibc computes it - Arm's optimized-routines log2, glibc's
  # since 2.28, under 0.55 ulp: near 1 a degree-11 polynomial, elsewhere a
  # 64-entry table and a degree-7 one, r / ln 2 taken with r in two parts,
  # a power of two exact. `log`'s shape, unfused as it is; the series it
  # replaces answered differently for about one argument in six hundred.
  # The tables are `math/log2_data.c`'s for N = 64.
  private LOG2_INVLN2HI =     1.4426950407214463
  private LOG2_INVLN2LO = 1.6751713164886512e-10
  private LOG2_A0       =   -0.72134752044448824
