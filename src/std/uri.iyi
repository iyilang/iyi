# URI references as RFC 3986 spells them: scheme, userinfo, host, port,
# path, query and fragment, read by `URI.parse` (`URI.parse?` answers nil
# where `parse` panics with the reason), written back by `to_s`, resolved
# against a base by `resolve` (section 5.2, dot segments included),
# normalized by `normalize` (lower-case scheme and host, default port
# dropped, dot segments removed). `Params` holds an ordered multi-valued
# query, read by `Params.parse` and written by `to_s` the
# application/x-www-form-urlencoded way.
#
# Percent-encoding: `encode`, `encode_path`, `encode_path_segment` and
# `encode_www_form` each keep a documented set of bytes and encode every
# other one, `%` included, so each is injective and `decode` undoes it.
# `decode?` answers nil and `decode` panics for a `%` without two hex
# digits after it. Bytes above ASCII pass through the parser as they are
# and are encoded one by one by the encoders.
#
# What the parser refuses is listed at `parse?`. What it does not check:
# percent escapes (`decode` does), and the shape of a bracketed host.

module std/uri

import std/text

# An ordered multi-value collection representing URI query parameters
# or application/x-www-form-urlencoded form data.
pub struct Params
  @keys : Array(String)
  @values : Array(String)

  def initialize
    @keys = [] of String
    @values = [] of String
  end

  def initialize(keys : Array(String), values : Array(String))
    @keys = keys
    @values = values
  end

  def empty? : Bool
    @keys.empty?
  end

  def size : Int32
    @keys.size
  end

  def has_key?(key : String) : Bool
    i = 0
    while i < @keys.size
      return true if @keys[i] == key
      i = i + 1
    end
    false
  end

  # Returns the first value for *key*, or raises if not found.
  def [](key : String) : String
    val = self[key]?
    if val
      val
    else
      raise "missing parameter key: " + key
    end
  end

  # Returns the first value for *key*, or nil if not found.
  def []?(key : String) : String?
    i = 0
    while i < @keys.size
      return @values[i] if @keys[i] == key
      i = i + 1
    end
    nil
  end

  # Returns all values associated with *key*.
  def fetch_all(key : String) : Array(String)
    result = [] of String
    i = 0
    while i < @keys.size
      if @keys[i] == key
        result << @values[i]
      end
      i = i + 1
    end
    result
  end

  # Appends a key-value pair, preserving duplicate keys.
  def add(key : String, value : String) : Nil
    @keys << key
    @values << value
  end

  # Sets the value for *key*, replacing all previous occurrences.
  def []=(key : String, value : String) : Nil
    new_keys = [] of String
    new_values = [] of String
    replaced = false
    i = 0
    while i < @keys.size
      if @keys[i] == key
        if !replaced
          new_keys << key
          new_values << value
          replaced = true
        end
      else
        new_keys << @keys[i]
        new_values << @values[i]
      end
      i = i + 1
    end
    if !replaced
      new_keys << key
      new_values << value
    end
    @keys = new_keys
    @values = new_values
  end

  # Deletes all entries for *key*, returning the removed values or nil.
  def delete(key : String) : Array(String)?
    new_keys = [] of String
    new_values = [] of String
    removed = [] of String
    i = 0
    while i < @keys.size
      if @keys[i] == key
        removed << @values[i]
      else
        new_keys << @keys[i]
        new_values << @values[i]
      end
      i = i + 1
    end
    @keys = new_keys
    @values = new_values
    removed.empty? ? nil : removed
  end

  # Iterates through each key-value pair.
  def each(& : (String, String) -> Nil) : Nil
    i = 0
    while i < @keys.size
      yield @keys[i], @values[i]
      i = i + 1
    end
  end

  # Parses a query string into Params, the way the WHATWG URL standard
  # reads `application/x-www-form-urlencoded`: `+` is a space, `%XX` is
  # the byte, and a `%` that does not start two hex digits is itself.
  # Never a panic - the query is whatever a client sent, and `?q=100%`
  # is what browsers send for "100%". `URI.decode` stays strict: it is
  # asked of text a program made.
  def self.parse(query : String) : Params
    params = Params.new
    return params if query.empty?

    # Strip optional leading '?'
    s = query.starts_with?('?') ? query[1, query.bytesize - 1] : query
    return params if s.empty?

    pairs = s.split('&')
    p_idx = 0
    while p_idx < pairs.size
      pair = pairs[p_idx]
      unless pair.empty?
        # Support semicolon separator as well
        sub_pairs = pair.split(';')
        sp_idx = 0
        while sp_idx < sub_pairs.size
          item = sub_pairs[sp_idx]
          unless item.empty?
            eq_idx = item.index('=')
            if eq_idx
              raw_k = item[0, eq_idx]
              raw_v = item[eq_idx + 1, item.bytesize - eq_idx - 1]
              params.add(URI.decode_form_lenient(raw_k), URI.decode_form_lenient(raw_v))
            else
              params.add(URI.decode_form_lenient(item), "")
            end
          end
          sp_idx = sp_idx + 1
        end
      end
      p_idx = p_idx + 1
    end
    params
  end

  # Encodes parameters to application/x-www-form-urlencoded string.
  def to_s : String
    parts = [] of String
    i = 0
    while i < @keys.size
      k_enc = URI.encode_www_form(@keys[i])
      v_enc = URI.encode_www_form(@values[i])
      parts << (k_enc + "=" + v_enc)
      i = i + 1
    end
    parts.join("&")
  end
end

pub class URI
  @scheme : String?
  @user : String?
  @password : String?
  @host : String?
  @port : Int32?
  @path : String
  @query : String?
  @fragment : String?
  property scheme : String?
  property user : String?
  property password : String?
  property port : Int32?
  property path : String
  property query : String?
  property fragment : String?

  def initialize(
    scheme : String? = nil,
    host : String? = nil,
    port : Int32? = nil,
    path : String = "",
    query : String? = nil,
    user : String? = nil,
    password : String? = nil,
    fragment : String? = nil,
  )
    @scheme = scheme
    @port = port
    @path = path
    @query = query
    @user = user
    @password = password
    @fragment = fragment
    self.host = host
  end

  def host : String?
    @host
  end

  # Stored as given: an IPv6 address is written with its brackets,
  # `"[::1]"`, the way it appears in a URI, and `hostname` takes them off.
  def host=(h : String?) : Nil
    @host = h
  end

  # The host without the brackets an IPv6 address carries.
  def hostname : String?
    h = @host
    h ? URI.unwrap_ipv6(h) : nil
  end

  def self.unwrap_ipv6(h : String) : String
    if h.starts_with?('[') && h.ends_with?("]") && h.bytesize >= 2
      h[1, h.bytesize - 2]
    else
      h
    end
  end

  def userinfo : String?
    u = @user
    return nil unless u
    p = @password
    p ? (u + ":" + p) : u
  end

  def userinfo=(info : String?) : Nil
    if info
      colon = info.index(':')
      if colon
        @user = info[0, colon]
        @password = info[colon + 1, info.bytesize - colon - 1]
      else
        @user = info
        @password = nil
      end
    else
      @user = nil
      @password = nil
    end
  end

  def absolute? : Bool
    !@scheme.nil?
  end

  def relative? : Bool
    @scheme.nil?
  end

  def opaque? : Bool
    !@scheme.nil? && @host.nil? && !@path.starts_with?('/')
  end

  def query_params : Params
    Params.parse(@query || "")
  end

  def query_params=(params : Params) : Nil
    @query = params.empty? ? nil : params.to_s
  end

  # `userinfo@host:port`, the userinfo percent-encoded (a space is `%20`)
  # and the host written as stored.
  def authority : String?
    return nil unless @host || @user || @port

    parts = [] of String
    if u = @user
      u_enc = URI.encode_www_form(u, space_to_plus: false)
      if p = @password
        p_enc = URI.encode_www_form(p, space_to_plus: false)
        parts << (u_enc + ":" + p_enc + "@")
      else
        parts << (u_enc + "@")
      end
    end

    if h = @host
      parts << h
    end

    if prt = @port
      parts << (":" + prt.to_s)
    end

    parts.join("")
  end

  def to_s : String
    parts = [] of String
    if s = @scheme
      parts << (s + ":")
    end

    has_auth = !@host.nil? || !@user.nil? || !@port.nil?
    if has_auth
      parts << "//"
      auth_str = authority
      if auth_str
        parts << auth_str
      end
    end
    if has_auth
      if !@path.empty? && !@path.starts_with?('/')
        parts << "/"
      end
    elsif @path.starts_with?("//")
      parts << "/."
    end

    parts << @path

    if q = @query
      parts << ("?" + q)
    end

    if f = @fragment
      parts << ("#" + f)
    end
    parts.join("")
  end

  def dup : URI
    URI.new(
      scheme: @scheme,
      host: @host,
      port: @port,
      path: @path,
      query: @query,
      user: @user,
      password: @password,
      fragment: @fragment
    )
  end

  def ==(other : URI) : Bool
    @scheme == other.scheme &&
      @host == other.host &&
      @port == other.port &&
      @path == other.path &&
      @query == other.query &&
      @user == other.user &&
      @password == other.password &&
      @fragment == other.fragment
  end

  # =========================================================================
  # RFC 3986 Section 2: Percent-Encoding and Decoding
  # =========================================================================

  # Unreserved characters: ALPHA / DIGIT / "-" / "." / "_" / "~"
  def self.unreserved?(byte : UInt8) : Bool
    (byte >= 97_u8 && byte <= 122_u8) ||  # a-z
      (byte >= 65_u8 && byte <= 90_u8) || # A-Z
      (byte >= 48_u8 && byte <= 57_u8) || # 0-9
      byte == 45_u8 ||                    # -
      byte == 46_u8 ||                    # .
      byte == 95_u8 ||                    # _
      byte == 126_u8                      # ~
  end

  # Gen-delims: ":" / "/" / "?" / "#" / "[" / "]" / "@"
  def self.gen_delim?(byte : UInt8) : Bool
    byte == 58_u8 ||   # :
      byte == 47_u8 || # /
      byte == 63_u8 || # ?
      byte == 35_u8 || # #
      byte == 91_u8 || # [
      byte == 93_u8 || # ]
      byte == 64_u8    # @
  end

  # Sub-delims: "!" / "$" / "&" / "'" / "(" / ")" / "*" / "+" / "," / ";" / "="
  def self.sub_delim?(byte : UInt8) : Bool
    byte == 33_u8 ||   # !
      byte == 36_u8 || # $
      byte == 38_u8 || # &
      byte == 39_u8 || # '
      byte == 40_u8 || # (
      byte == 41_u8 || # )
      byte == 42_u8 || # *
      byte == 43_u8 || # +
      byte == 44_u8 || # ,
      byte == 59_u8 || # ;
      byte == 61_u8    # =
  end

  def self.reserved?(byte : UInt8) : Bool
    gen_delim?(byte) || sub_delim?(byte)
  end

  private def self.hex_digit?(byte : UInt8) : Bool
    (byte >= 48_u8 && byte <= 57_u8) ||   # 0-9
      (byte >= 65_u8 && byte <= 70_u8) || # A-F
      (byte >= 97_u8 && byte <= 102_u8)   # a-f
  end

  private def self.hex_value(byte : UInt8) : Int32
    if byte >= 48_u8 && byte <= 57_u8
      (byte - 48_u8).to_i
    elsif byte >= 65_u8 && byte <= 70_u8
      (byte - 65_u8 + 10_u8).to_i
    elsif byte >= 97_u8 && byte <= 102_u8
      (byte - 97_u8 + 10_u8).to_i
    else
      -1
    end
  end

  private def self.hex_char(nibble : Int32) : UInt8
    nibble < 10 ? (48 + nibble).to_u8 : (65 + nibble - 10).to_u8
  end

  # Which bytes an encoder writes as themselves; everything else,
  # `%` included, becomes `%XX`, so every encoder here is injective and
  # `decode(encode(s)) == s` for any `s`.
  private def self.keep?(b : UInt8, level : Int32) : Bool
    return true if unreserved?(b)
    case level
    when 0 then reserved?(b) # encode: RFC 3986 reserved characters pass
    when 1 then b == 47_u8   # encode_path: '/' separates segments
    else        false        # encode_path_segment, encode_www_form
    end
  end

  private def self.percent_encode(str : String, level : Int32, space_to_plus : Bool) : String
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 32_u8 && space_to_plus
        bytes << 43_u8 # '+'
      elsif keep?(b, level)
        bytes << b
      else
        bytes << 37_u8 # '%'
        bytes << hex_char((b.to_i >> 4) & 0xF)
        bytes << hex_char(b.to_i & 0xF)
      end
      i = i + 1
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  # Percent-encodes every byte that is neither unreserved nor reserved,
  # `%` among them: `"%20"` becomes `"%2520"`, and a space `"%20"` (or
  # `"+"` when *space_to_plus*). Bytes above ASCII are encoded one by one,
  # so UTF-8 text round-trips through `decode`.
  def self.encode(str : String, space_to_plus : Bool = false) : String
    percent_encode(str, 0, space_to_plus)
  end

  # Encodes a path, keeping `/` between its segments.
  def self.encode_path(str : String) : String
    percent_encode(str, 1, false)
  end

  # Encodes one path segment: only unreserved bytes pass.
  def self.encode_path_segment(str : String) : String
    percent_encode(str, 2, false)
  end

  # Encodes a form field the application/x-www-form-urlencoded way: a
  # space is `+` unless *space_to_plus* is false, and only unreserved
  # bytes pass.
  def self.encode_www_form(str : String, space_to_plus : Bool = true) : String
    percent_encode(str, 2, space_to_plus)
  end

  # Decodes `%XX` escapes (and `+` to a space when *plus_to_space*).
  # `decode?` answers nil and `decode` panics for a `%` not followed by
  # two hex digits; a multi-byte UTF-8 character encoded byte by byte
  # comes back as the character.
  def self.decode?(str : String, plus_to_space : Bool = false) : String?
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 43_u8 && plus_to_space # '+'
        bytes << 32_u8
        i = i + 1
      elsif b == 37_u8 # '%'
        if i + 2 >= len
          return nil
        end
        h1 = hex_value(raw[i + 1])
        h2 = hex_value(raw[i + 2])
        if h1 < 0 || h2 < 0
          return nil
        end
        val = ((h1 << 4) | h2).to_u8
        bytes << val
        i = i + 3
      else
        bytes << b
        i = i + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  # `+` a space and `%XX` a byte, any other `%` kept as it is: the form
  # reading `Params.parse` makes.
  protected def self.decode_form_lenient(str : String) : String
    raw = str.to_unsafe
    len = str.bytesize
    String.build(len) do |io|
      i = 0
      while i < len
        b = raw[i]
        if b == 43_u8 # '+'
          io.write_byte(32_u8)
          i = i + 1
        elsif b == 37_u8 && i + 2 < len && hex_value(raw[i + 1]) >= 0 && hex_value(raw[i + 2]) >= 0
          io.write_byte(((hex_value(raw[i + 1]) << 4) | hex_value(raw[i + 2])).to_u8)
          i = i + 3
        else
          io.write_byte(b)
          i = i + 1
        end
      end
    end
  end

  def self.decode_www_form?(str : String, plus_to_space : Bool = true) : String?
    decode?(str, plus_to_space: plus_to_space)
  end

  def self.decode(str : String, plus_to_space : Bool = false) : String
    decode?(str, plus_to_space: plus_to_space) || raise "malformed percent escape in #{str.inspect}"
  end

  def self.decode_www_form(str : String, plus_to_space : Bool = true) : String
    decode(str, plus_to_space: plus_to_space)
  end

  # =========================================================================
  # RFC 3986 Section 3 & 4: URI Parsing
  # =========================================================================

  # Reads *raw_url* as a URI reference. `parse?` answers nil and `parse`
  # panics with the reason for: a space or control character anywhere
  # (`space at byte 11 in "http://exa mple.com"`), a `:` before the first
  # `/`, `?` or `#` whose prefix is not a scheme (`invalid scheme "ht!tp"
  # in ...`), a `[` in the host with no `]`, a host with a byte a host
  # cannot hold, and a port that is not decimal digits or is above 65535.
  # Percent escapes are not checked here; `decode` does that.
  def self.parse?(raw_url : String) : URI?
    uri = URI.new
    scan(raw_url, uri) ? nil : uri
  end

  def self.parse(raw_url : String) : URI
    uri = URI.new
    if reason = scan(raw_url, uri)
      raise reason
    end
    uri
  end

  private def self.scheme_byte?(c : UInt8, first : Bool) : Bool
    return true if (c >= 97_u8 && c <= 122_u8) || (c >= 65_u8 && c <= 90_u8)
    return false if first
    (c >= 48_u8 && c <= 57_u8) || c == 43_u8 || c == 45_u8 || c == 46_u8
  end

  # Fills *uri* from *s*; answers nil, or the sentence that refuses *s*.
  private def self.scan(s : String, uri : URI) : String?
    raw = s.to_unsafe
    len = s.bytesize

    i = 0
    while i < len
      b = raw[i]
      return "space at byte #{i} in #{s.inspect}" if b == 32_u8
      return "control character at byte #{i} in #{s.inspect}" if b < 32_u8 || b == 127_u8
      i = i + 1
    end
    return nil if len == 0

    ptr = 0

    # A ':' before the first '/', '?' or '#' ends a scheme, and nothing else
    # may stand before it: "a:b" is scheme "a", "ht!tp:x" is refused.
    i = 0
    while i < len && raw[i] != 47_u8 && raw[i] != 63_u8 && raw[i] != 35_u8 && raw[i] != 58_u8
      i = i + 1
    end
    if i < len && raw[i] == 58_u8 # ':'
      k = 0
      while k < i && scheme_byte?(raw[k], k == 0)
        k = k + 1
      end
      return "invalid scheme #{s[0, i].inspect} in #{s.inspect}" if i == 0 || k < i
      uri.scheme = s[0, i]
      ptr = i + 1
    end

    # Authority: "//" up to the next '/', '?' or '#'
    if ptr + 1 < len && raw[ptr] == 47_u8 && raw[ptr + 1] == 47_u8
      ptr = ptr + 2
      auth_start = ptr
      while ptr < len && raw[ptr] != 47_u8 && raw[ptr] != 63_u8 && raw[ptr] != 35_u8
        ptr = ptr + 1
      end
      auth_str = s[auth_start, ptr - auth_start]

      host_port = auth_str
      if at_idx = auth_str.index('@')
        uinfo = auth_str[0, at_idx]
        user = uinfo
        password = nil
        if colon_ui = uinfo.index(':')
          user = uinfo[0, colon_ui]
          password = uinfo[colon_ui + 1, uinfo.bytesize - colon_ui - 1]
        end
        # Userinfo is percent-decoded here and re-encoded by `authority`;
        # a '+' in it is a '+', not a space.
        decoded_user = URI.decode?(user)
        return "malformed percent escape in userinfo #{uinfo.inspect} in #{s.inspect}" unless decoded_user
        uri.user = decoded_user
        if password
          decoded_password = URI.decode?(password)
          return "malformed percent escape in userinfo #{uinfo.inspect} in #{s.inspect}" unless decoded_password
          uri.password = decoded_password
        end
        host_port = auth_str[at_idx + 1, auth_str.bytesize - at_idx - 1]
      end

      port_str = nil
      if host_port.starts_with?('[')
        bracket_end = host_port.index(']')
        return "unterminated IPv6 host #{host_port.inspect} in #{s.inspect}" unless bracket_end
        uri.host = host_port[0, bracket_end + 1]
        rest = host_port[bracket_end + 1, host_port.bytesize - bracket_end - 1]
        if rest.starts_with?(':')
          port_str = rest[1, rest.bytesize - 1]
        elsif !rest.empty?
          return "invalid host #{host_port.inspect} in #{s.inspect}"
        end
      else
        host = host_port
        if colon_hp = host_port.index(':')
          host = host_port[0, colon_hp]
          port_str = host_port[colon_hp + 1, host_port.bytesize - colon_hp - 1]
        end
        hp = host.to_unsafe
        j = 0
        while j < host.bytesize
          c = hp[j]
          unless unreserved?(c) || sub_delim?(c) || c == 37_u8 || c >= 128_u8
            return "invalid host #{host.inspect} in #{s.inspect}"
          end
          j = j + 1
        end
        uri.host = host
      end

      if port_str && !port_str.empty?
        pp = port_str.to_unsafe
        j = 0
        while j < port_str.bytesize
          c = pp[j]
          return "invalid port #{port_str.inspect} in #{s.inspect}" if c < 48_u8 || c > 57_u8
          j = j + 1
        end
        port = port_str.to_i?
        return "port #{port_str} out of range in #{s.inspect}" if port.nil? || port > 65535
        uri.port = port
      end
    end

    # Path runs until '?', '#', or end
    path_start = ptr
    while ptr < len && raw[ptr] != 63_u8 && raw[ptr] != 35_u8
      ptr = ptr + 1
    end
    uri.path = s[path_start, ptr - path_start]

    if ptr < len && raw[ptr] == 63_u8 # '?'
      ptr = ptr + 1
      query_start = ptr
      while ptr < len && raw[ptr] != 35_u8 # '#'
        ptr = ptr + 1
      end
      uri.query = s[query_start, ptr - query_start]
    end

    if ptr < len && raw[ptr] == 35_u8 # '#'
      ptr = ptr + 1
      uri.fragment = s[ptr, len - ptr]
    end

    nil
  end

  # =========================================================================
  # RFC 3986 Section 5.2.4: Remove Dot Segments
  # =========================================================================

  def self.remove_dot_segments(path : String) : String
    return "" if path.empty?

    input = path
    output_segments = [] of String

    while !input.empty?
      # A. If the input buffer begins with a prefix of "../" or "./",
      #    then remove that prefix from the input buffer; otherwise,
      if input.starts_with?("../")
        input = input[3, input.bytesize - 3]
      elsif input.starts_with?("./")
        input = input[2, input.bytesize - 2]
        # B. if the input buffer begins with a prefix of "/./" or "/.",
        #    where "." is a complete path segment, then replace that
        #    prefix with "/" in the input buffer; otherwise,
      elsif input.starts_with?("/./")
        input = "/" + input[3, input.bytesize - 3]
      elsif input == "/."
        input = "/"
        # C. if the input buffer begins with a prefix of "/../" or "/..",
        #    where ".." is a complete path segment, then replace that
        #    prefix with "/" in the input buffer and remove the last
        #    segment and its preceding "/" (if any) from the output buffer;
      elsif input.starts_with?("/../")
        input = "/" + input[4, input.bytesize - 4]
        output_segments.pop unless output_segments.empty?
      elsif input == "/.."
        input = "/"
        output_segments.pop unless output_segments.empty?
        # D. if the input buffer consists only of "." or "..", then remove
        #    that from the input buffer; otherwise,
      elsif input == "." || input == ".."
        input = ""
        # E. move the first path segment in the input buffer to the end of
        #    the output buffer, including the initial "/" character (if any)
        #    and any subsequent characters up to, but not including, the next
        #    "/" character or the end of the input buffer.
      else
        slash_idx = -1
        if input.starts_with?('/')
          # search for next '/' after index 0
          next_slash = input.index('/', 1)
          slash_idx = next_slash ? next_slash : input.bytesize
        else
          next_slash = input.index('/')
          slash_idx = next_slash ? next_slash : input.bytesize
        end
        segment = input[0, slash_idx]
        output_segments << segment
        input = input[slash_idx, input.bytesize - slash_idx]
      end
    end

    res = output_segments.join("")
    res
  end

  # =========================================================================
  # RFC 3986 Section 5.2: Relative Reference Resolution
  # =========================================================================

  # Resolves *ref* against this URI as Base URI according to RFC 3986 section 5.2.
  def resolve(ref : URI | String) : URI
    r = ref.is_a?(URI) ? ref : URI.parse(ref)

    # 5.2.2. Transform References
    t = URI.new

    if r.absolute?
      t.scheme = r.scheme
      t.host = r.host
      t.port = r.port
      t.user = r.user
      t.password = r.password
      t.path = URI.remove_dot_segments(r.path)
      t.query = r.query
    else
      # R.scheme is undefined
      if r.host || r.user || r.port
        t.host = r.host
        t.port = r.port
        t.user = r.user
        t.password = r.password
        t.path = URI.remove_dot_segments(r.path)
        t.query = r.query
      else
        if r.path.empty?
          t.path = @path
          if r.query
            t.query = r.query
          else
            t.query = @query
          end
        else
          if r.path.starts_with?('/')
            t.path = URI.remove_dot_segments(r.path)
          else
            # Merge paths (5.2.3)
            merged = merge_paths(@path, r.path)
            t.path = URI.remove_dot_segments(merged)
          end
          t.query = r.query
        end
        t.host = @host
        t.port = @port
        t.user = @user
        t.password = @password
      end
      t.scheme = @scheme
    end

    t.fragment = r.fragment
    t
  end

  # RFC 3986 Section 5.2.3: Merge Paths
  private def merge_paths(base_path : String, ref_path : String) : String
    has_auth = !@host.nil? || !@user.nil? || !@port.nil?
    if has_auth && base_path.empty?
      "/" + ref_path
    else
      slash_idx = base_path.rindex('/')
      if slash_idx
        base_path[0, slash_idx + 1] + ref_path
      else
        ref_path
      end
    end
  end

  # =========================================================================
  # Normalization
  # =========================================================================

  def self.default_port(scheme : String) : Int32?
    s = scheme.downcase
    if s == "http" || s == "ws"
      80
    elsif s == "https" || s == "wss"
      443
    elsif s == "ftp"
      21
    elsif s == "ssh"
      22
    elsif s == "telnet"
      23
    else
      nil
    end
  end

  def normalize : URI
    dup.normalize_in_place
  end

  def normalize_in_place : URI
    if s = @scheme
      @scheme = s.downcase
    end
    if h = @host
      @host = h.downcase
    end

    if s = @scheme
      if prt = @port
        def_p = URI.default_port(s)
        if def_p && prt == def_p
          @port = nil
        end
      end
    end

    @path = URI.remove_dot_segments(@path)
    self
  end
end
