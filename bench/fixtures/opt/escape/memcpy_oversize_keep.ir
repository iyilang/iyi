; iyi-ir 1
source_filename = "escape_memcpy_oversize_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @memcpy_oversize() {
entry:
  %src = alloca [2 x i64], align 8
  store i64 1, ptr %src, align 8
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 3, i64 2)
  intrinsic llvm.memcpy.p0.p0.i64(ptr %p, ptr %src, i64 16, i1 false)
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
