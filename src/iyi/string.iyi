# Text — SPEC.md, "0.1.0", item 3.
#
# The compiler declares `String`'s fields itself — `@bytesize`, `@length` and
# `@c`, in that order, in `Program#initialize` — because codegen lays out
# string literals before any prelude is read. So this file reopens a type that
# already has its shape and only says what can be done with it.
class String
  # The two `Int32`s in front of the bytes: the byte count and the character
  # count. The type id is not in the object: it is the high half of the
  # header word under it, at P-4 (GC_DESIGN.md Stage 5). Written by hand
  # because that layout is codegen's, and a string built here has to be
  # indistinguishable from one it emitted. Under the arena a string is
  # always headed - `gc_layouts.cr` says so for this one class, because
  # this is the one object the prelude builds from bytes - and comes
  # through the class-instance entry, atomic, with the id stored by it;
  # under every other allocator the word is under `malloc`'s pointer and
  # the id is stored here.
  HEADER_SIZE = 8

  # Allocates *bytesize* bytes, hands the buffer to the block to fill, and
  # returns the string that results. The character count is left at zero,
  # "not counted yet", for `size` to scan the first time it is asked: most
  # strings built here - an encoding, a join, a line - are never asked, and
  # counting them all was a second pass over every byte built.
  #
  # The byte after the last is a NUL, as a literal's is, so `to_unsafe` is
  # a C string: `std/process` and `std/debug` hand one to the platform as a
  # path. The byte was allocated for that and never written, and a string's
  # chunk is atomic - not cleared - so a chunk that had held a longer
  # string kept that string's byte there. Measured on Windows after a
  # collection that freed longer strings: 961 of 1,000 strings built after
  # it had no terminator, and `Process.run` of a path built that way
  # answered "no such program" for a file that was there.
  def self.new(bytesize : Int32, & : Pointer(UInt8) -> Nil) : String
    memory = String.memory(bytesize + HEADER_SIZE + 1)
    buffer = memory + HEADER_SIZE
    yield buffer
    buffer[bytesize] = 0_u8

    header = memory.as(Pointer(Int32))
    header[0] = bytesize
    header[1] = 0
    memory.as(String)
  end

  protected def self.memory(bytes : Int32) : Pointer(UInt8)
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin) || flag?(:wasm32) || flag?(:win32)) %}
      IyiHeap.new_object(bytes.to_u64, "".crystal_type_id.to_u64, true, true).as(Pointer(UInt8))
    {% else %}
      memory = Pointer(UInt8).malloc(bytes.to_u64)
      Pointer(Int32).new(memory.address - 4_u64).value = "".crystal_type_id
      memory
    {% end %}
  end

  # Each character's code point and the byte it starts at, by the other
  # library's rule: a lead byte without the `10xxxxxx` bytes it calls for,
  # one of those alone, an overlong form, a surrogate or a value past
  # U+10FFFF is -1, one byte long, and `each_char` yields it as U+FFFD.
  private def each_point(& : Int32, Int32 -> Nil) : Nil
    index = 0
    while index < @bytesize
      lead = to_unsafe[index].to_i32
      width = lead < 0xC2 || lead > 0xF4 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4
      point = width > 1 ? lead & (0x7F >> width) : lead < 0x80 ? lead : -1
      k = 1
      while k < width && point >= 0
        byte = index + k < @bytesize ? to_unsafe[index + k].to_i32 : 0
        point = (byte & 0xC0) == 0x80 ? (point << 6) | (byte & 0x3F) : -1
        k = k + 1
      end
      point = -1 if width > 1 && (point < (1 << (5 * width - 4)) || point > 0x10FFFF || (point >= 0xD800 && point < 0xE000))
      yield point, index
      index = index + (point < 0 ? 1 : width)
    end
  end

  def bytesize : Int32
    @bytesize
  end

  # Crystal reads `@length == 0` on a non-empty string as "not counted yet" and
  # scans; a string it builds without knowing the count leaves the field at
  # zero. This prelude used to return the field, which was right for every
  # string it makes itself and wrong for one that arrived from Crystal's own
  # code — `to_json`'s result printed correctly here and answered `size` 0.
  #
  # No error, a wrong number, and the layout is shared on purpose (SPEC.md
  # Part V item 12), so the invariant has to be shared too. The count is
  # of what `each_char` yields, a byte that begins no character one U+FFFD.
  def size : Int32
    return @length if @length > 0 || @bytesize == 0

    count = 0
    each_point { count = count + 1 }
    @length = count
  end

  def empty? : Bool
    @bytesize == 0
  end

  # The character at *index*, and the substring that starts there, asked for by
  # `samples/iyi/calc`, which scans its input a character at a time and cannot
  # do it with `to_unsafe` without becoming a program about pointers.
  #
  # ASCII, like the rest of this file: a byte is a character here, which is true
  # of every string this prelude is asked to handle and false in general. The
  # place it stops being true is the place to make `Char` real, and `size`
  # already counts UTF-8 properly, so the two would disagree, noted rather than
  # hidden.
  #
  # A negative index counts from the end, so `s[-1]` is the last character.
  # Out of range after that wrap still raises rather than returning nil: the
  # caller knows the length. `[]?` is the question that allows absence.
  def [](index : Int32) : Char
    asked = index
    index = @bytesize + index if index < 0
    raise "index #{asked} out of range for a string of #{@bytesize} bytes" if index < 0 || index >= @bytesize
    to_unsafe[index].unsafe_chr
  end

  # Every character in order, decoded: `size` counts code points, so this
  # yields exactly that many. It used to yield one per byte, which made the
  # prelude disagree with itself — `"héllo".size` was 5 and `each_char` ran
  # six times — and `samples/iyi/basics` counted the bytes of a word it
  # printed. Indexing stays byte-indexed (`[]` above), which is the
  # convention `samples/iyi/calc` scans with; a character is a unit only
  # where a character is what was asked for.
  #
  # A byte that begins no character is one U+FFFD, as in the other library.
  # A lead byte took the bytes after it whatever they were: C3 41 was the one
  # character U+00C1 at `size` 2, and `"a" C3 '"'` swallowed the quote.
  def each_char(& : Char -> Nil) : Nil
    each_point { |point| yield point < 0 ? '\uFFFD' : point.unsafe_chr }
  end

  def []?(index : Int32) : Char?
    index = @bytesize + index if index < 0
    return nil if index < 0 || index >= @bytesize
    to_unsafe[index].unsafe_chr
  end

  # A negative *start* counts from the end, the same wrap as the one-index
  # form. *count* stays non-negative: a negative count is not a wrap, it is a
  # mistake, and it raises for that reason rather than being silently clamped.
  def [](start : Int32, count : Int32) : String
    raise "negative count: #{count}" if count < 0
    asked = start
    start = @bytesize + start if start < 0
    raise "start #{asked} out of range for a string of #{@bytesize} bytes" if start < 0 || start > @bytesize

    available = @bytesize - start
    taken = count < available ? count : available

    String.new(taken) do |buffer|
      buffer.copy_from(to_unsafe + start, taken)
    end
  end

  # Pad on the left (rjust) or the right (ljust) to *width*. A width that
  # already fits returns the string unchanged.
  # *width* is in characters, because `size` is: padding is asked for to line
  # a column up, and a string measured one way and padded another lines up
  # for ASCII and nothing else. `"héllo".rjust(7, '.')` used to answer a
  # string whose own `size` was 6. The pad travels as its own bytes for the
  # same reason — written as one byte, a `'·'` left a lone continuation byte
  # in the middle of the result. It defaults rather than living in a second
  # overload of each, which is two methods for one question.
  def rjust(width : Int32, pad : Char = ' ') : String
    count = size
    return self if width <= count
    extra = width - count
    padding = pad.to_s
    pad_bytes = padding.bytesize
    String.new(@bytesize + extra * pad_bytes) do |buffer|
      i = 0
      while i < extra
        (buffer + i * pad_bytes).copy_from(padding.to_unsafe, pad_bytes)
        i = i + 1
      end
      (buffer + extra * pad_bytes).copy_from(to_unsafe, @bytesize)
    end
  end

  def ljust(width : Int32, pad : Char = ' ') : String
    count = size
    return self if width <= count
    extra = width - count
    padding = pad.to_s
    pad_bytes = padding.bytesize
    String.new(@bytesize + extra * pad_bytes) do |buffer|
      buffer.copy_from(to_unsafe, @bytesize)
      i = 0
      while i < extra
        (buffer + @bytesize + i * pad_bytes).copy_from(padding.to_unsafe, pad_bytes)
        i = i + 1
      end
    end
  end

  # `"ab" * -3` answered `""` where Crystal raises, and III.1.7a says one
  # name means one thing in both. The size is a division rather than the
  # multiply below, so the refusal names the string: `"abcd" * 600_000_000`
  # panicked with "arithmetic overflow", which is the machine's adder.
  def *(count : Int32) : String
    raise "negative count: #{count}" if count < 0
    return "" if count == 0 || @bytesize == 0
    raise "a string of #{@bytesize} bytes repeated #{count} times is past " \
          "the 2147483647 bytes a string holds" if count > 2147483647 // @bytesize
    total = @bytesize * count
    String.new(total) do |buffer|
      i = 0
      while i < count
        (buffer + i * @bytesize).copy_from(to_unsafe, @bytesize)
        i = i + 1
      end
    end
  end

  def to_unsafe : Pointer(UInt8)
    pointerof(@c)
  end

  def to_s : String
    self
  end

  # Written down rather than printed: in double quotes, the way the
  # literal is spelled, which is what `Object#inspect`'s comment promises
  # and what makes `no such key "b"` read as a string and not a name.
  # Nothing inside is escaped: the strings this prelude holds are the
  # program's own, and a quote inside one is rare and reads as itself.
  def inspect : String
    "\"" + self + "\""
  end

  # The number this string spells - an optional sign and decimal digits,
  # the whole string - asked for by `samples/iyi/calc`, which reads a
  # token's text and needs the integer behind it. Raises on anything else,
  # as Crystal's `to_i` does: one name means one thing in both libraries
  # (SPEC.md III.1.7a), and a silent 0 for `"oops"` is wrong twice over.
  # `to_i?` answers nil for the same text, the pair `[]` and `[]?` are.
  def to_i : Int32
    to_i? || raise "not a number: #{inspect}"
  end

  # Read as a *negative* magnitude, the range that holds every value the
  # type has: `Int32::MIN` has no positive twin, so accumulating
  # `2147483648` and negating it could not read what `to_s` wrote - it
  # overflowed on the last digit, and with checked arithmetic that was a
  # panic rather than the `nil` a `?` promises.
  def to_i? : Int32?
    return nil if empty?

    index = 0
    negative = self[0] == '-'
    if negative || self[0] == '+'
      # A sign alone is not a number; `+5` is one, as it is for `to_f`.
      return nil if @bytesize == 1
      index = 1
    end

    value = 0
    while index < @bytesize
      digit = to_unsafe[index].to_i - 48
      return nil if digit < 0 || digit > 9
      # The next step would leave the type: -214748364 * 10 is the last
      # multiple that fits, and after it only eight of the ten digits do.
      return nil if value < -214748364 || (value == -214748364 && digit > 8)
      value = value * 10 - digit
      index = index + 1
    end

    return value if negative
    # And the magnitude that only exists as a negative is not a positive.
    return nil if value == -2147483648
    0 - value
  end

  def +(other : String) : String
    return other if empty?
    return self if other.empty?

    String.new(bytesize + other.bytesize) do |buffer|
      buffer.copy_from(to_unsafe, bytesize)
      (buffer + bytesize).copy_from(other.to_unsafe, other.bytesize)
    end
  end

  # The three the Kemal port's path joining needs. ASCII again — a `Char`
  # argument here is always `\'/\'` — and byte-indexed, which is the same
  # thing while the strings are ASCII.
  def starts_with?(prefix : String) : Bool
    return false if prefix.bytesize > bytesize

    index = 0
    while index < prefix.bytesize
      return false unless to_unsafe[index] == prefix.to_unsafe[index]
      index = index + 1
    end
    true
  end

  # A `Char` above ASCII is more than one byte, and these narrowed it to one
  # through a *checked* convert, so `"a☃b".index('☃')` died of "arithmetic
  # overflow". Each compares the character's own bytes now.
  def starts_with?(char : Char) : Bool
    starts_with?(char.to_s)
  end

  def chomp(char : Char) : String
    text = char.to_s
    return self unless ends_with?(text)
    byte_slice(0, bytesize - text.bytesize)
  end

  def lchop(char : Char) : String
    text = char.to_s
    return self unless starts_with?(text)
    byte_slice(text.bytesize, bytesize - text.bytesize)
  end

  def ends_with?(suffix : String) : Bool
    return false if suffix.bytesize > bytesize
    offset = bytesize - suffix.bytesize
    index = 0
    while index < suffix.bytesize
      return false unless to_unsafe[offset + index] == suffix.to_unsafe[index]
      index = index + 1
    end
    true
  end

  # Where a character first is, or nil: the question a parser asks before
  # it cuts.
  def index(char : Char) : Int32?
    wanted = char.to_s
    index = 0
    while index + wanted.bytesize <= bytesize
      return index if byte_window?(index, wanted)
      index = index + 1
    end
    nil
  end

  # *wanted*'s bytes at *at*: `index` and `split` both ask it.
  private def byte_window?(at : Int32, wanted : String) : Bool
    matched = 0
    while matched < wanted.bytesize && to_unsafe[at + matched] == wanted.to_unsafe[matched]
      matched = matched + 1
    end
    matched == wanted.bytesize
  end

  # Without the whitespace at either end.
  def strip : String
    first = 0
    while first < bytesize && to_unsafe[first].unsafe_chr.whitespace?
      first = first + 1
    end
    last = bytesize
    while last > first && to_unsafe[last - 1].unsafe_chr.whitespace?
      last = last - 1
    end
    byte_slice(first, last - first)
  end

  # The pieces between separators, empty ones included: `"a,,b".split(',')`
  # is three, `"a,".split(',')` is two, and `"".split(',')` is one empty
  # piece - the count the other library gives, so a program reads the same
  # under both.
  def split(separator : Char) : Array(String)
    pieces = [] of String
    wanted = separator.to_s
    width = wanted.bytesize
    start = 0
    index = 0
    while index + width <= bytesize
      if byte_window?(index, wanted)
        pieces << byte_slice(start, index - start)
        index = index + width
        start = index
      else
        index = index + 1
      end
    end
    pieces << byte_slice(start, bytesize - start)
    pieces
  end

  # The lines of a text, blank ones included, a final newline ending the last
  # line; `\r\n` ends one too, as in Crystal - a Windows file's lines kept the
  # `\r`, and `"1\r\n".lines[0].to_i` panicked where `File.read_lines` read 1.
  # A last `\r` with no `\n` after it stays, as `each_line` keeps it:
  # `"a\nb\r".lines` was `["a", "b"]`.
  def lines : Array(String)
    return [] of String if bytesize == 0
    pieces = split('\n')
    tail = pieces.pop
    pieces = pieces.map { |line| line.chomp('\r') }
    tail.empty? ? pieces : pieces << tail
  end

  private def byte_slice(start : Int32, count : Int32) : String
    String.new(count) do |buffer|
      buffer.copy_from(to_unsafe + start, count)
    end
  end

  # FNV-1a over the bytes: three lines, no table, and good enough for a
  # linear-probing table of a few dozen entries.
  def hash : Int32
    value = -2128831035
    index = 0
    while index < bytesize
      value = (value ^ to_unsafe[index].to_i32) &* 16777619
      index = index + 1
    end
    value
  end

  # ASCII only, and the samples are ASCII. A prelude that folded case for
  # every alphabet would be a Unicode table, which is more lines than this
  # whole file and not what any sample is about.
  def upcase : String
    String.new(bytesize) do |buffer|
      index = 0
      while index < bytesize
        byte = to_unsafe[index]
        byte = byte - 32_u8 if byte >= 97_u8 && byte <= 122_u8
        buffer[index] = byte
        index = index + 1
      end
    end
  end

  # The other half of `upcase`, ASCII for the same reason.
  def downcase : String
    String.new(bytesize) do |buffer|
      index = 0
      while index < bytesize
        byte = to_unsafe[index]
        byte = byte + 32_u8 if byte >= 65_u8 && byte <= 90_u8
        buffer[index] = byte
        index = index + 1
      end
    end
  end

  def includes?(other : String) : Bool
    !byte_index(other).nil?
  end

  # Where *search* first starts at or after byte *offset* - counted from
  # the end when negative - in bytes, as Crystal's `byte_index` answers.
  # Naive while that is cheap, and Rabin-Karp - one rolling hash per
  # position, bytes compared only where it matches - once more than four
  # bytes a position have been compared: a needle that keeps almost
  # matching, `"a" * 1000 + "b"` in a run of `a`, made the naive loop
  # n * m, 222 ms for a megabyte.
  def byte_index(search : String, offset : Int32 = 0) : Int32?
    offset = offset + bytesize if offset < 0
    return nil if offset < 0 || offset > bytesize
    return offset if search.bytesize == 0
    return nil if search.bytesize > bytesize - offset
    m = search.bytesize
    limit = bytesize - m
    s = to_unsafe
    t = search.to_unsafe
    i = offset
    spent = 0
    while i <= limit
      j = 0
      while j < m && s[i + j] == t[j]
        j = j + 1
      end
      return i if j == m
      spent = spent + j
      break if spent > 4 * (i - offset) + 64
      i = i + 1
    end
    return nil if i > limit

    prime = 16777619_u64
    power = 1_u64
    want = 0_u64
    have = 0_u64
    k = 0
    while k < m
      want = want &* prime &+ t[k].to_u64
      have = have &* prime &+ s[i + k].to_u64
      power = power &* prime
      k = k + 1
    end
    while true
      if have == want
        j = 0
        while j < m && s[i + j] == t[j]
          j = j + 1
        end
        return i if j == m
      end
      return nil if i == limit
      have = have &* prime &+ s[i + m].to_u64 &- power &* s[i].to_u64
      i = i + 1
    end
  end

  def ==(other : String) : Bool
    return false unless bytesize == other.bytesize

    index = 0
    while index < bytesize
      return false unless to_unsafe[index] == other.to_unsafe[index]
      index = index + 1
    end
    true
  end

  # Byte order, which for ASCII is dictionary order with the capitals first;
  # a prefix sorts before what it prefixes. What `sorted` and `sorted_by`
  # ask of a string.
  def <(other : String) : Bool
    index = 0
    while index < bytesize && index < other.bytesize
      a = to_unsafe[index]
      b = other.to_unsafe[index]
      return a < b if a != b
      index = index + 1
    end
    bytesize < other.bytesize
  end

  # Interpolation is a call the compiler writes: `"a#{b}"` reaches here as
  # `String.interpolation("a", b)` (`LiteralExpander#expand`). The overloads
  # are what let the common shapes avoid work — a single string is itself.
  def self.interpolation(value : String) : String
    value
  end

  def self.interpolation(value) : String
    value.to_s
  end

  def self.interpolation(*values : *T) : String forall T
    result = ""
    {% for index in 0...T.size %}
      result = result + interpolation(values[{{ index }}])
    {% end %}
    result
  end
end

# `Char`'s own, and it lives here rather than in `primitives.iyi` because the
# one-byte string it builds needs `String.new`.
#
# Without it `puts s[0]` printed the text `Char`: `Object#to_s` answers with the
# type's name, so a type that never defined `to_s` prints its own name instead
# of its value and nothing says a method is missing. `samples/iyi/calc` scans
# with `String#[]` and compares the result, which is why nothing caught it —
# comparison was defined and printing was not.
#
# UTF-8, in one to four bytes. It wrote the low byte and nothing else, which
# is right for the ASCII a byte-indexed `[]` hands back and wrong for every
# other character a program can write: `puts 'é'` printed one invalid byte,
# and `each_char` above now yields code points that would print the same way.
# `0x10FFFF` is the last one there is; past it a `'?'` goes out rather than a
# sequence no reader can decode.
struct Char
  def to_s : String
    point = ord
    if point < 0x80
      String.new(1) do |buffer|
        buffer[0] = point.to_u8
      end
    elsif point < 0x800
      String.new(2) do |buffer|
        buffer[0] = (0xC0 | (point >> 6)).to_u8
        buffer[1] = (0x80 | (point & 0x3F)).to_u8
      end
    elsif point < 0x10000
      String.new(3) do |buffer|
        buffer[0] = (0xE0 | (point >> 12)).to_u8
        buffer[1] = (0x80 | ((point >> 6) & 0x3F)).to_u8
        buffer[2] = (0x80 | (point & 0x3F)).to_u8
      end
    elsif point <= 0x10FFFF
      String.new(4) do |buffer|
        buffer[0] = (0xF0 | (point >> 18)).to_u8
        buffer[1] = (0x80 | ((point >> 12) & 0x3F)).to_u8
        buffer[2] = (0x80 | ((point >> 6) & 0x3F)).to_u8
        buffer[3] = (0x80 | (point & 0x3F)).to_u8
      end
    else
      String.new(1) { |buffer| buffer[0] = '?'.ord.to_u8 }
    end
  end

  def inspect : String
    "'" + to_s + "'"
  end

  # The classes a word counter asks about, ASCII's: a letter is one of the
  # fifty-two, a digit one of the ten, whitespace the space, tab and the
  # line breaks.
  def letter? : Bool
    (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z')
  end

  def digit? : Bool
    self >= '0' && self <= '9'
  end

  def alphanumeric? : Bool
    letter? || digit?
  end

  def whitespace? : Bool
    self == ' ' || self == '\t' || self == '\n' || self == '\r'
  end
end

# Text built a piece at a time, the way `String.build` spells it in the
# other library: `String.build { |io| io << "a" << 1 << 'b' }` is `"a1b"`.
# The bytes go into one buffer that doubles when it fills and are copied
# once, into the string, at the end — so building is linear in what is
# written. `result = result + piece` in a loop copies everything written so
# far on every piece: `Array#join` and `String#tr` were built that way and
# did not finish on a 130 MB sequence.
class String::Builder
  @buffer : Pointer(UInt8)
  @bytesize : Int32
  @capacity : Int32

  def initialize(capacity : Int32 = 64)
    @capacity = capacity < 16 ? 16 : capacity
    @buffer = Pointer(UInt8).malloc(@capacity.to_u64)
    @bytesize = 0
  end

  def bytesize : Int32
    @bytesize
  end

  def empty? : Bool
    @bytesize == 0
  end

  def <<(text : String) : self
    write(text.to_unsafe, text.bytesize)
    self
  end

  # A character's UTF-8 bytes, written in place rather than through a
  # string of its own.
  def <<(char : Char) : self
    point = char.ord
    if point < 0x80
      write_byte(point.to_u8)
    elsif point < 0x800
      reserve(2)
      write_byte((0xC0 | (point >> 6)).to_u8)
      write_byte((0x80 | (point & 0x3F)).to_u8)
    elsif point < 0x10000
      reserve(3)
      write_byte((0xE0 | (point >> 12)).to_u8)
      write_byte((0x80 | ((point >> 6) & 0x3F)).to_u8)
      write_byte((0x80 | (point & 0x3F)).to_u8)
    elsif point <= 0x10FFFF
      reserve(4)
      write_byte((0xF0 | (point >> 18)).to_u8)
      write_byte((0x80 | ((point >> 12) & 0x3F)).to_u8)
      write_byte((0x80 | ((point >> 6) & 0x3F)).to_u8)
      write_byte((0x80 | (point & 0x3F)).to_u8)
    else
      write_byte(63_u8)
    end
    self
  end

  # Anything else as its `to_s`.
  def <<(value) : self
    self << value.to_s
  end

  def write_byte(byte : UInt8) : Nil
    reserve(1)
    @buffer[@bytesize] = byte
    @bytesize = @bytesize + 1
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    return if count <= 0
    reserve(count)
    (@buffer + @bytesize.to_i64).copy_from(bytes, count)
    @bytesize = @bytesize + count
  end

  def to_s : String
    String.new(@bytesize) { |buffer| buffer.copy_from(@buffer, @bytesize) }
  end

  # In Int64, so a build doubles past 1 GiB up to the 2147483647 bytes a
  # string holds and is refused past them as `*` is: in Int32, doubling
  # 1 GiB panicked a 1.2 GB build with "arithmetic overflow".
  private def reserve(extra : Int32) : Nil
    needed = @bytesize.to_i64 + extra.to_i64
    return if needed <= @capacity.to_i64
    raise "a string of #{@bytesize} bytes and #{extra} more is past the " \
          "2147483647 bytes a string holds" if needed > 2147483647_i64
    capacity = @capacity.to_i64
    while capacity < needed
      capacity = capacity * 2
    end
    capacity = 2147483647_i64 if capacity > 2147483647_i64
    @buffer = @buffer.realloc(capacity.to_u64)
    @capacity = capacity.to_i32
  end
end

class String
  def self.build(capacity : Int32 = 64, & : String::Builder -> _) : String
    builder = String::Builder.new(capacity)
    yield builder
    builder.to_s
  end
end
