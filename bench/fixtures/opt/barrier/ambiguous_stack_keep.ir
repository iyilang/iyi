; iyi-ir 1
source_filename = "ambiguous_stack_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @ambiguous_stack_keep(i1 %choose, ptr %heap, ptr %value) {
entry:
  %slot = alloca ptr, align 8
  %destination = select i1 %choose, ptr %slot, ptr %heap
  %mark = load i8, ptr @__iyi_marking, align 1
  %active = icmp ne i8 %mark, 0
  br i1 %active, label %begin, label %plain
begin:
  call void () @__iyi_write_barrier_begin()
  br label %join
plain:
  br label %join
join:
  store ptr %value, ptr %destination, align 8
  br i1 %active, label %shade, label %done
shade:
  call void (ptr, i64) @__iyi_write_barrier(ptr %destination, i64 1)
  br label %done
done:
  ret void
}
define external void @dynamic_offset_keep(i64 %index, ptr %value) {
entry:
  %slot = alloca [4 x ptr], align 8
  %destination = getelementptr [4 x ptr], ptr %slot, i64 0, i64 %index
  %mark = load i8, ptr @__iyi_marking, align 1
  %active = icmp ne i8 %mark, 0
  br i1 %active, label %begin, label %plain
begin:
  call void () @__iyi_write_barrier_begin()
  br label %join
plain:
  br label %join
join:
  store ptr %value, ptr %destination, align 8
  br i1 %active, label %shade, label %done
shade:
  call void (ptr, i64) @__iyi_write_barrier(ptr %destination, i64 1)
  br label %done
done:
  ret void
}
