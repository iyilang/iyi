# The parallel marker, exercised: GC_DESIGN.md Stage 7.
#
#   ./bin/iyi run bench/parallel_mark.iyi
#
# A wide live graph — a binary tree of a million typed nodes, 40 MiB —
# marked by one thread and then by the collecting thread with its helpers,
# five explicit collections each; the tree's checksum must hold through
# both, the helpers must have blackened objects (a marker that never shares
# a tree is one thread with fifteen spectators), and the two pause means
# are printed side by side, reported rather than budgeted: how far the
# mark falls with helpers is the finding, and the machine is the machine.
#
# bench/parallel_mark.sh drives it and proves the sharing check fails when
# the marker stops donating its stack's bottom.

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  class Node
    @left : Node?
    @right : Node?
    @value : Int64

    def initialize(@left : Node?, @right : Node?, @value : Int64)
    end

    def sum : Int64
      left = @left
      right = @right
      total = @value
      total = total + left.sum if left.is_a?(Node)
      total = total + right.sum if right.is_a?(Node)
      total
    end
  end

  def build(depth : Int32, seed : Int64) : Node
    return Node.new(nil, nil, seed) if depth == 0
    Node.new(build(depth - 1, seed &* 3_i64 &+ 1_i64), build(depth - 1, seed &* 5_i64 &+ 2_i64), seed)
  end

  # Five explicit collections, the mean pause and the last mark's helper
  # count, with the tree checked after each.
  def collect_five(tree : Node, expected : Int64) : Tuple(Int64, Int64)
    total = 0_i64
    helpers = 0_i64
    round = 0
    while round < 5
      before = IyiMark.pause_total_ns
      IyiMark.collect
      total = total + (IyiMark.pause_total_ns - before).to_i64
      helpers = IyiMark.helper_black.to_i64
      fail("the tree's checksum changed under collection #{round}") if tree.sum != expected
      round = round + 1
    end
    {total // 5_i64, helpers}
  end

  IyiMark.auto = false
  tree = build(19, 7_i64)
  expected = tree.sum
  puts "tree: #{expected} over 1048575 nodes"

  IyiMark.workers = 0_u64
  # Two marks first so the marker's own estimate of the live set is warm
  # for both arms alike. Each phase names itself before it runs: a hang
  # on a runner then says where.
  puts "phase: two marks alone"
  IyiMark.collect
  IyiMark.collect
  puts "phase: five marks alone"
  alone = collect_five(tree, expected)
  fail("helpers blackened #{alone[1]} objects with none asked") if alone[1] != 0_i64

  IyiMark.workers = 15_u64
  puts "phase: one mark with helpers"
  IyiMark.collect
  puts "phase: five marks with helpers"
  helped = collect_five(tree, expected)
  # One core runs one thread at a time, and the marker finishes its own
  # stack before a helper is scheduled to ask for a share: nothing to
  # blacken is the right answer there, not a marker that never shares.
  # The script says how many cores it gave the program.
  one_core = Program.env("PARALLEL_MARK_CORES") == "1"
  fail("the helpers blackened nothing: the mark was one thread and the rest watched") if helped[1] == 0_i64 && !one_core

  puts "mark: #{alone[0] // 1000_i64} us alone, #{helped[0] // 1000_i64} us with helpers, which blackened #{helped[1]} of the last mark's nodes"

  wide = Array(Node?).new
  index = 0
  while index < 300000
    wide << Node.new(nil, nil, index.to_i64)
    index = index + 1
  end

  # The pool's memory is the most batches ever in it at once, not every
  # batch a mark published: a batch taken is a batch's words free again.
  # The tree's marks publish only by donation - when the pool is empty and
  # a helper is idle - which is a number of batches that depends on the
  # cores the machine has, and on a three-core runner stayed inside the
  # first piece with the recycling removed, so the proof below it did not
  # fire. The wide object publishes by spilling: a stack past SPILL_AT
  # gives a batch to the pool on every push after it, 300,000 pointers
  # are thousands of batches on any machine, and thousands of batches
  # never recycled are megabytes.
  puts "phase: one mark of the wide object with helpers"
  IyiMark.collect
  fail("the wide object lost a node under the shared mark") if wide.size != 300000 || wide[299999].as(Node).sum != 299999_i64
  # Recycling is asked of the pool directly: a batch handed out again
  # off the free list. The helped tree marks took and freed batches -
  # the helpers blackened nodes, above - and the wide mark published
  # thousands after them, so a pool that recycles has reused some, and
  # one that never frees a batch has reused none, on any machine. The
  # bytes mapped used to be the proof: the copy that never recycled
  # mapped eleven pieces and more everywhere measured, until a loaded
  # three-core darwin runner mapped 3.4 MB of it under the 4 MB bound
  # and the proof did not fire.
  pool = IyiMark.pool_bytes
  reused = IyiMark.pool_reused
  # A batch is taken by a helper, and one core never schedules one while
  # the marker works: nothing taken is nothing to hand out again.
  fail("pool: no batch was handed out twice in eleven marks, so taken batches are not being recycled") if reused == 0_u64 && !one_core
  # Four megabytes: the wide mark's spills outrun fifteen helpers for a
  # moment and the pool's high-water mark is a handful of pieces - 1.5 MB
  # on a three-core darwin runner. What the pool holds, bounded.
  fail("pool: #{pool.to_i64} bytes mapped for batches after the marks, past the bound a recycling pool keeps") if pool > 4194304_u64
  puts "pool: #{pool.to_i64} bytes mapped for the marks' batches, #{reused.to_i64} batches reused"

  # A worker's stack starts small and grows: a mark alone of one object
  # holding 300,000 pointers pushes them all, and the stack of 8,192
  # entries it began with doubles until they fit.
  IyiMark.workers = 0_u64
  grown_before = IyiMark.stacks_grown
  IyiMark.collect
  # On one core the wide object's mark with helpers was the marker's alone
  # too - nobody took a spill - so its stack had already grown to hold it,
  # and the growth to look for is the run's.
  grew = one_core ? IyiMark.stacks_grown > 0_u64 : IyiMark.stacks_grown != grown_before
  fail("stack: a 300,000-wide object was marked alone and the stack never grew past its #{IyiMark::STACK_START.to_i64} entries") unless grew
  fail("stack: the wide object lost a node under the mark") if wide.size != 300000 || wide[299999].as(Node).sum != 299999_i64
  grown = one_core ? IyiMark.stacks_grown : IyiMark.stacks_grown - grown_before
  puts "stack: the mark of a 300,000-wide object grew a worker's stack #{grown.to_i64} times from #{IyiMark::STACK_START.to_i64} entries"

  # A helper with nothing to do spins for fifty microseconds by the clock
  # and then parks, whatever a pause hint costs here: counted in hints, it
  # was 400 us on a machine whose hint is 20 ns, and a program collecting
  # every half millisecond had helpers that never parked. The shortest of
  # ten spins on a word nobody turns, so a spin the scheduler interrupted
  # does not count; a quarter millisecond is five times the bound.
  {% if flag?(:linux) || flag?(:win32) %}
    cell = Pointer(UInt64).malloc(1_u64)
    word = Pointer(Atomic(UInt64)).new(cell.address)
    shortest = 0_u64
    attempt = 0
    while attempt < 10
      started = IyiMark.now_ns
      IyiMark.spin_for_generation(word, 0_u64)
      took = IyiMark.now_ns - started
      shortest = took if attempt == 0 || took < shortest
      attempt = attempt + 1
    end
    fail("park: a helper with no work spun #{(shortest // 1000_u64).to_i64} us before it parked, past five times the #{(IyiMark::SPIN_BEFORE_PARK_NS // 1000_u64).to_i64} us it should") if shortest > 5_u64 * IyiMark::SPIN_BEFORE_PARK_NS
    fail("park: a helper with no work spun #{(shortest // 1000_u64).to_i64} us, short of the #{(IyiMark::SPIN_BEFORE_PARK_NS // 1000_u64).to_i64} us it should") if shortest < IyiMark::SPIN_BEFORE_PARK_NS
    puts "park: a helper with no work spins #{(shortest // 1000_u64).to_i64} us before it parks, for #{(IyiMark::SPIN_BEFORE_PARK_NS // 1000_u64).to_i64} asked"
  {% end %}
  puts "parallel mark: every property held"
{% else %}
  puts "parallel mark: needs the collector and a thread target; nothing to exercise here"
{% end %}
