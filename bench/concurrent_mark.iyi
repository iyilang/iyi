# The mark beside the program, exercised: GC_DESIGN.md Stage 9.
#
#   ./bin/iyi run bench/concurrent_mark.iyi
#
# What a concurrent mark has to get right is the one thing a stop-the-world
# mark never faces: the program moving pointers while the marker walks. The
# losing move is a pointer taken out of an object the marker has not reached
# (white) and stored into one it has finished (black), the old edge cut —
# without a write barrier the marker never sees the object again, and the
# sweep frees something the program holds. This program makes exactly that
# move, many times, each time under a mark it started itself:
#
#   - `holders`: a rooted array of 64 boxes, one hop from a global, so the
#     marker blackens them early;
#   - a chain of 200 000 nodes, built while the trigger is off, with a
#     payload hanging off its last node — the object the marker reaches
#     last, if it reaches it;
#   - allocation until the marking flag is up, then the payload moved from
#     the chain's tail into a holder and the chain's edge cut, with no
#     local keeping it: a barrier-only object;
#   - the collection waited out, and the payload read back through the
#     holder: its header must not carry the sweep's free flag and its bytes
#     must be the pattern written into them.
#
# Every round that made its move under a mark counts; the program asks for
# at least one, and reports how many. Twenty-four rounds. Under -Dmove_force
# (bench/concurrent_mark.sh) each round's helpers are held until its move, so
# its payload is white at the move on every round; the plain build reports the
# count and decides nothing about the race.
# The pauses are printed beside the stop-the-world mark's over the same chain: a concurrent collection's two
# stops, the longest of each, against the one stop that marked it all —
# and how many second stops found a white root or a full pool and retreated
# to mark it beside the program before stopping again.
#
# bench/concurrent_mark.sh drives it and proves the check fails when the
# barrier shades nothing.

@[Unsafe("moves raw Pointer.malloc blocks while the marker walks, flags threads through words in a platform-mapped page, and scrubs an uninitialized stack pad through pointerof and asm")]
{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  import std/int
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  # A forced premise can fail while its helpers are held. Do not allocate a
  # formatted message there, where an allocation could wait on that mark.
  def setup_fail(message : String) : Nil
    buffer = uninitialized UInt8[512]
    bytes = pointerof(buffer).as(UInt8*)
    size = message.bytesize
    if size > 505
      overflow = "FAIL: benchmark setup sentence exceeds 505 bytes\n"
      __iyi_write(2, overflow.to_unsafe.as(Void*), overflow.bytesize.to_u64)
      __iyi_exit(76)
    end
    bytes.copy_from("FAIL: ".to_unsafe, 6)
    (bytes + 6).copy_from(message.to_unsafe, size)
    bytes[size + 6] = 10_u8
    __iyi_write(2, bytes.as(Void*), (size + 7).to_u64)
    __iyi_exit(76)
  end

  class Payload
    @bytes : Pointer(UInt8)
    @seed : UInt64

    def initialize(@seed : UInt64)
      @bytes = Pointer(UInt8).malloc(256_u64)
      index = 0_u64
      while index < 256_u64
        (@bytes + index.to_i64).value = ((@seed &+ index) & 0xFF_u64).to_u8
        index = index + 1_u64
      end
    end

    def intact? : Bool
      index = 0_u64
      while index < 256_u64
        return false if (@bytes + index.to_i64).value != ((@seed &+ index) & 0xFF_u64).to_u8
        index = index + 1_u64
      end
      true
    end

    def seed : UInt64
      @seed
    end
  end

  class Cell
    @next : Cell?
    @payload : Payload?

    def initialize(@next : Cell?, @payload : Payload?)
    end

    def next : Cell?
      @next
    end

    def payload : Payload?
      @payload
    end

    def payload=(value : Payload?)
      @payload = value
    end
  end

  class Holder
    @payload : Payload?

    def initialize
      @payload = nil
    end

    def payload : Payload?
      @payload
    end

    def payload=(value : Payload?)
      @payload = value
    end
  end

  class Roots
    @@holders : Array(Holder) = [] of Holder

    def self.holders : Array(Holder)
      @@holders
    end
  end

  CHAIN = 200000

  # The chain, its tail first: the last node made is the head, so the
  # payload sits on the node the marker reaches last.
  def build_chain(seed : UInt64) : Cell
    head = Cell.new(nil, Payload.new(seed))
    count = 1
    while count < CHAIN
      head = Cell.new(head, nil)
      count = count + 1
    end
    head
  end

  def tail(link : Cell) : Cell
    cursor = link
    while true
      following = cursor.next
      break unless following.is_a?(Cell)
      cursor = following
    end
    cursor
  end

  def churn(bytes : UInt64) : Nil
    burned = 0_u64
    while burned < bytes
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
      burned = burned + 64_u64
    end
  end

  # Two hundred collections beside the program, each woken by its thread,
  # and the kept chain whole after them.
  def wake_rounds(kept : Cell) : Nil
    round = 0
    while round < 200
      churn(IyiMark.budget)
      IyiMark.settle
      round = round + 1
    end
    fail("the kept chain lost its payload under the wake rounds") unless tail(kept).payload.is_a?(Payload)
  end

  # Allocate until a mark is running beside this thread, or the budget has
  # gone by twice, which means no mark will be concurrent here.
  def allocate_until_marking : Bool
    burned = 0_u64
    limit = IyiMark.budget * 2_u64
    while burned < limit
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
      burned = burned + 64_u64
      return true if IyiMark.marking?
    end
    false
  end

  # A holder born under the mark, and blackened here: an object born
  # under a mark is white and alive by its epoch's parity (the mutator
  # writes no mark byte), and a holder with nothing in it is what a scan
  # leaves black, so the colour is put on it directly - the move below
  # then lands in a black holder, and the barrier is the only thing that
  # saves the payload, which is what the failure proof removes. Waiting
  # for one of the pre-made holders to turn black instead proved nothing
  # on some machines: when it turns black is the workers' order of
  # business, and where the 200,000-cell chain came first the payload
  # was black already, found through the chain's tail, and the proof had
  # nothing to lose. The new holder goes into the rooted array so it is
  # a root's child; the array's store is its own barrier's business.
  def born_black_holder(round : Int32) : Holder
    holder = Holder.new
    Roots.holders[round % 64] = holder
    IyiMark.recolour(holder.object_id.to_u64, IyiMark::BLACK) if IyiMark.marking?
    holder
  end

  # The move, under a mark: payload from the chain's tail into a holder,
  # the tail's edge cut. `@[NoInline]` so the local that carried it is
  # gone with the frame before the mark finishes.
  @[NoInline]
  def move(chain : Cell, holder : Holder) : Nil
    last = tail(chain)
    holder.payload = last.payload
    last.payload = nil
  end

  # Whether the chain's tail still holds a white payload, read in a frame
  # of its own for `move`'s reason: the payload is in no local of the
  # caller's. Read in the loop below, a `--release` build cut into
  # partitions (`src/compiler/iyi/release_partition.cr`) kept it where the
  # second stop's conservative scan found it, and the copy whose barrier
  # shades nothing kept every payload: 8 of 8 runs on Linux x86_64 (12
  # vCPUs, shared), against 5 of 5 caught when built as one module. Read
  # here, the partitioned copy lost round 0's payload in 4 of 4 runs.
  @[NoInline]
  def tail_white?(chain : Cell) : Bool
    payload = tail(chain).payload
    payload.is_a?(Payload) && IyiMark.colour(payload.object_id.to_u64) == IyiMark::WHITE
  end

  def check(holder : Holder, seed : UInt64, round : Int32) : Nil
    payload = holder.payload
    fail("round #{round}: the holder's payload is nil") unless payload.is_a?(Payload)
    address = payload.object_id.to_u64
    if IyiMark.flags(address) & IyiHeap::FREE_FLAG != 0
      fail("round #{round}: the payload moved into a black holder under the mark was freed: the barrier lost it")
    end
    fail("round #{round}: the payload's seed is #{payload.seed.to_i64} rather than #{seed.to_i64}: its chunk was reused, the barrier lost it") if payload.seed != seed
    fail("round #{round}: the payload's bytes changed under the mark") unless payload.intact?
  end

  # The two stops of the last concurrent collection, folded into the
  # longest of each.
  class Stops
    @@first : UInt64 = 0_u64
    @@second : UInt64 = 0_u64

    def self.note : Nil
      first = IyiMark.stop_first_ns
      second = IyiMark.stop_second_ns
      @@first = first if first > @@first
      @@second = second if second > @@second
    end

    def self.first : UInt64
      @@first
    end

    def self.second : UInt64
      @@second
    end
  end

  # A holder and the payload only it holds, made where no local of the
  # caller's keeps the payload.
  @[NoInline]
  def stray_holder(seed : UInt64) : Holder
    holder = Holder.new
    holder.payload = Payload.new(seed)
    holder
  end

  # The stack under the caller's frame zeroed, where `stray_holder` and the
  # barrier ran: the next collection's frames reuse it, and a word of theirs
  # not yet written is scanned as it stands. A payload pointer `stray_holder`
  # left there kept the payload alive through that scan, and the stray
  # check's failure proof stopped failing, three runs of three, when the
  # runtime's lock and its helpers' start changed the collector's frames.
  @[NoInline]
  def scrub_stack : Nil
    pad = uninitialized UInt64[2048]
    base = pointerof(pad).as(UInt64*)
    index = 0
    while index < 2048
      base[index] = 0_u64
      index = index + 1
    end
    asm("" :: "r"(base) : "memory" : "volatile")
  end

  def note_stops : Nil
    Stops.note
  end

  # Threads of the program's own, allocating until told to stop: the
  # cores they hold are not the helpers' to take.
  class Busy
    @@page : UInt64 = 0_u64

    def self.setup(length : UInt64) : Nil
      {% if flag?(:win32) %}
        page = LibC.VirtualAlloc(Pointer(Void).new(0_u64), length, 0x3000_i32, 4_i32).address
        setup_fail("share: the busy threads flag page could not be mapped") if page == 0_u64
        @@page = page
      {% elsif flag?(:darwin) %}
        page = LibC.mmap(Pointer(Void).new(0_u64), length, 3, 4098, -1, 0_i64).address
        setup_fail("share: the busy threads flag page could not be mapped") if page &+ 1_u64 == 0_u64
        @@page = page
      {% else %}
        page = __iyi_conc_syscall6(IYI_SYS_MMAP, 0_i64, length.unsafe_to_i64, 3_i64, 34_i64, -1_i64, 0_i64)
        setup_fail("share: the busy threads flag page could not be mapped") if page < 0_i64 && page >= -4095_i64
        @@page = page.unsafe_to_u64
      {% end %}
    end

    def self.stop : Pointer(Atomic(UInt64))
      Pointer(Atomic(UInt64)).new(@@page)
    end

    # The idle-pool step's count of tasks arrived, the page's second word.
    def self.arrived : Pointer(Atomic(UInt64))
      Pointer(Atomic(UInt64)).new(@@page + 8_u64)
    end
  end

  {% if flag?(:win32) %}
    lib LibBoost
      fun GetCurrentProcessId : UInt32
      fun CreateToolhelp32Snapshot(flags : UInt32, process : UInt32) : Void*
      fun Thread32First(snapshot : Void*, entry : UInt32*) : Int32
      fun Thread32Next(snapshot : Void*, entry : UInt32*) : Int32
      fun OpenThread(access : UInt32, inherit : Int32, thread_id : UInt32) : Void*
      fun GetThreadPriorityBoost(thread : Void*, disabled : Int32*) : Int32
      fun GetLastError : Int32
      fun CloseHandle(handle : Void*) : Int32
    end

    class ThreadBoost
      def self.setup_failure(message : String) : NoReturn
        print "FAIL: wake boost setup: #{message}\n"
        __iyi_exit(76)
      end

      # The threads of this process whose priority boost is off, from a snapshot
      # of every thread on the machine (TH32CS_SNAPTHREAD = 4). Each entry is a
      # THREADENTRY32 of seven 32-bit words: dwSize, cntUsage, th32ThreadID,
      # th32OwnerProcessID, tpBasePri, tpDeltaPri, dwFlags. The size goes in
      # first, and the owner is word 3.
      def self.count_boost_off : UInt64
        snapshot = LibBoost.CreateToolhelp32Snapshot(4_u32, 0_u32)
        setup_failure("cannot create the thread snapshot") if snapshot.address == 0xFFFFFFFFFFFFFFFF_u64
        entry = uninitialized UInt32[7]
        words = pointerof(entry).as(UInt32*)
        words[0] = 28_u32
        pid = LibBoost.GetCurrentProcessId.to_u64
        count = 0_u64
        more = LibBoost.Thread32First(snapshot, words) != 0
        setup_failure("cannot read the first thread in the snapshot") unless more
        while more
          if words[3].to_u64 == pid
            thread = LibBoost.OpenThread(0x00000040_u32, 0_i32, words[2])
            setup_failure("cannot open a process thread") if thread.address == 0_u64
            disabled = 0_i32
            queried = LibBoost.GetThreadPriorityBoost(thread, pointerof(disabled))
            LibBoost.CloseHandle(thread)
            setup_failure("cannot query a process thread's priority boost") if queried == 0
            count = count + 1_u64 if disabled != 0_i32
          end
          more = LibBoost.Thread32Next(snapshot, words) != 0
          if !more && LibBoost.GetLastError != 18_i32 # ERROR_NO_MORE_FILES
            setup_failure("cannot continue the thread snapshot")
          end
        end
        LibBoost.CloseHandle(snapshot)
        count
      end
    end
  {% end %}

  def busy_until_stopped : Nil
    while Busy.stop.value.get == 0_u64
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
    end
  end

  index = 0
  while index < 64
    Roots.holders << Holder.new
    index = index + 1
  end

  # ── The stop-the-world mark over the same chain, for the pause ────────
  # In a frame of its own, so the chain dies with it. Held by a top-level
  # local until the moves below assigned it again, the chain's head sat
  # in a slot the Windows build kept, and the small live set's check
  # found 200,000 cells alive beside it.
  @[NoInline]
  def stw_pause_over_chain : UInt64
    chain = build_chain(1_u64)
    IyiMark.collect
    IyiMark.collect
    stw_pauses = 0_u64
    round = 0
    while round < 5
      started = IyiMark.pause_total_ns
      IyiMark.collect
      stw_pauses = stw_pauses + (IyiMark.pause_total_ns - started)
      round = round + 1
    end
    fail("the chain's tail lost its payload under a stop-the-world mark") unless tail(chain).payload.is_a?(Payload)
    stw_pauses.unsafe_div(5_u64)
  end

  IyiMark.auto = false
  IyiMark.workers = 0_u64
  stw_mean = stw_pause_over_chain

  # ── A barrier that runs after its mark has ended ──────────────────────
  # A store reads the marking flag and its barrier runs after it, and a
  # thread stopped between the two finds the mark over when it goes on.
  # The barrier has nothing to shade then, and must shade nothing: a
  # holder grayed after its arena's sweep went into the next mark gray,
  # which that mark never queues, and the payload only it held was swept.
  # Every arena is swept by the collection first, so nothing turns the
  # holder white again before the next mark.
  IyiMark.collect
  stray = stray_holder(77_u64)
  cell = Pointer(UInt64).malloc(1_u64)
  cell.value = stray.object_id.to_u64
  IyiHeap.enter_barrier
  IyiMark.barrier(cell.address, 1_u64)
  IyiHeap.leave_barrier
  scrub_stack
  IyiMark.collect
  strayed = stray.payload
  fail("stray: the holder lost its payload") unless strayed.is_a?(Payload)
  if IyiMark.flags(strayed.object_id.to_u64) & IyiHeap::FREE_FLAG != 0 || strayed.seed != 77_u64 || !strayed.intact?
    fail("stray: a barrier run after its mark had ended left the holder gray, and the next mark swept the payload it held")
  end
  puts "stray: a barrier run after its mark had ended shaded nothing, and the next mark kept what the holder held"

  # ── A small live set, marked in the stop ──────────────────────────────
  # Four thousand live objects, over the thousand every first stop marks:
  # a mark whose last one kept fewer than STW_MARK_SMALL is given that
  # bound and finishes stopped, where waking a helper for each of these
  # collections cost an allocation loop three times its time and 8 ms
  # pauses. With helpers to wake, not one goes beside the program.
  IyiMark.workers = 15_u64
  IyiMark.auto = false
  small = Array(Payload).new(2000) { |index| Payload.new(index.to_u64) }
  IyiMark.collect
  small_live = IyiMark.bytes_marked
  # What the mark found is the premise: anything else still alive makes
  # the live set large, and a mark over it goes beside the program as it
  # should.
  setup_fail("small: the live set is #{small_live.to_i64} bytes, not two thousand payloads: something else is still alive") if small_live > 2097152_u64
  IyiMark.auto = true
  small_collections = IyiMark.collections
  small_beside = IyiMark.concurrent_collections
  8.times do
    churn(IyiMark.budget)
    IyiMark.settle
  end
  IyiMark.auto = false
  small_collections = IyiMark.collections - small_collections
  small_beside = IyiMark.concurrent_collections - small_beside
  setup_fail("small: eight budgets of churn triggered no collection") if small_collections == 0_u64
  fail("small: #{small_beside.to_i64} of #{small_collections.to_i64} collections over #{small_live.to_i64} live bytes ran beside the program") if small_beside != 0_u64
  fail("small: a payload of the live set came back wrong") unless small[1999].seed == 1999_u64 && small[1999].intact?
  puts "small: #{small_collections.to_i64} collections over #{small_live.to_i64} live bytes, every one finished in its stop"

  # ── The moves, under marks beside the program ─────────────────────────
  IyiMark.workers = 15_u64
  under_mark = 0
  round = 0
  concurrent_before = IyiMark.concurrent_collections
  while round < 24
    IyiMark.auto = false
    seed = 1000_u64 + round.to_u64
    chain = build_chain(seed)
    Roots.holders[round % 64].payload = nil
    # Under `-Dheap_partitions` the runtime's frames are other frames: a
    # dead one under this loop's, left by the chain's allocation, still
    # named the payload when the mark's first stop scanned the stack, and
    # the payload was no longer white when this thread reached it - 0 of
    # 96 rounds made their move under a mark, 5 runs of 5 (Linux x86_64,
    # 12 vCPUs, release); with the stack under this frame zeroed here,
    # every round's payload was white and the copy whose barrier shades
    # nothing lost round 0's. Zeroed again after the move, so no word
    # `move` or `tail_white?` left keeps the payload for the second stop.
    {% if flag?(:heap_partitions) %}
      scrub_stack
    {% end %}
    {% if flag?(:move_force) %}
      IyiMark.hold_move
    {% end %}
    IyiMark.auto = true
    marking = allocate_until_marking
    holder = born_black_holder(round)
    # Under a mark, and the chain's tail not reached yet: a payload the
    # workers found through the chain is saved by the chain, and that
    # round is not the barrier's to prove.
    payload_white = tail_white?(chain)
    marking = marking && IyiMark.marking? && IyiMark.colour(holder.object_id.to_u64) == IyiMark::BLACK && payload_white
    under_mark = under_mark + 1 if marking
    {% if flag?(:move_force) %}
      setup_fail("moves: the forced move did not find a white payload under a mark") unless marking
    {% end %}
    move(chain, holder)
    {% if flag?(:move_force) %}
      IyiMark.release_move
    {% end %}
    {% if flag?(:heap_partitions) %}
      scrub_stack
    {% end %}
    # The chain is garbage from here; the payload lives in the holder only.
    chain = build_chain(0_u64)
    IyiMark.settle
    note_stops
    churn(IyiMark.budget)
    IyiMark.settle
    note_stops
    check(holder, seed, round)
    round = round + 1
  end
  IyiMark.auto = false
  rounds = round
  concurrent = IyiMark.concurrent_collections - concurrent_before
  {% if flag?(:move_force) %}
    setup_fail("moves: no forced move ran under a mark") if under_mark == 0
  {% end %}
  setup_fail("no collection ran beside the program across #{rounds} rounds") if concurrent == 0_u64

  puts "moves: #{under_mark} of #{rounds} rounds moved a payload into a black holder under a running mark, #{concurrent.to_i64} collections ran beside the program, every payload intact"
  puts "pause: #{stw_mean.unsafe_div(1000_u64).to_i64} us to mark the chain stopped; beside the program the longest first stop was #{Stops.first.unsafe_div(1000_u64).to_i64} us, the longest second #{Stops.second.unsafe_div(1000_u64).to_i64} us, and #{IyiMark.finish_retries.to_i64} second stops retreated to mark what they found"

  # ── A large block outgrown under a mark ───────────────────────────────
  # `realloc` past 1 MiB frees the large chunk it outgrew. Under a mark
  # the helpers walk the large list without the lock, for every word no
  # arena holds, and may have that chunk queued: it stays mapped and
  # listed until the sweep after the mark. Unmapped at once, a helper
  # read the freed node's link and faulted - one run in four of a
  # program joining a 4 MB string. The outgrown addresses are kept
  # masked, so no word of this program's holds them, and they are gone
  # after the collections that follow: kept, not leaked. Not every one -
  # a stale word in a register or a dead slot keeps one on Windows,
  # where Linux kept none - but a leak keeps all of them.
  outgrown = Pointer(UInt64).malloc(64_u64)
  large_under_mark = 0
  large_round = 0
  # Probe 44660980105 kept one of two blocks in 9 of 20 macOS runs; retain
  # the plain run's eight-block margin against conservative stale words.
  large_rounds = 8
  while large_round < large_rounds
    IyiMark.auto = false
    {% if flag?(:unmapped_force) %}
      # The copy's closer for this round's mark waits before it finishes, so
      # the mark is still running when the old block is freed. Settle first:
      # the hold must be in place before any mark this round starts.
      IyiMark.settle
      IyiMark.hold_mark
    {% end %}
    # Four chains, so the assist the grown block's allocation pays does
    # not finish the mark before the old block is freed.
    chains = [build_chain(3_u64), build_chain(4_u64), build_chain(5_u64), build_chain(6_u64)]
    block = Pointer(UInt8).malloc(1_100_000_u64)
    block.value = 5_u8
    IyiMark.auto = true
    marking = allocate_until_marking
    IyiMark.auto = false
    grown = block.realloc(2_200_000_u64)
    if marking && IyiMark.marking?
      large_under_mark = large_under_mark + 1
      fail("large: a block outgrown under a mark was unmapped beside the helpers") if IyiHeap.containing_large(block.as(Void*)) == 0_u64
    end
    {% if flag?(:unmapped_force) %}
      setup_fail("large: the held round's mark was not running when its block was outgrown") unless marking && IyiMark.marking?
      IyiMark.release_mark
    {% end %}
    fail("large: the grown block lost its first byte") unless grown.value == 5_u8
    outgrown[large_round] = block.address ^ 0x5a5a5a5a5a5a5a5a_u64
    block = Pointer(UInt8).new(0_u64)
    grown = Pointer(UInt8).new(0_u64)
    chains = [] of Cell
    IyiMark.settle
    large_round = large_round + 1
  end
  IyiMark.auto = false
  # One more outgrown outside any mark and not counted, so the last counted
  # block's address is in no register or slot a stale word could keep it by.
  spare = Pointer(UInt8).malloc(1_100_000_u64).realloc(2_200_000_u64)
  spare.value = 1_u8
  spare = Pointer(UInt8).new(0_u64)
  IyiMark.collect
  IyiMark.collect
  kept_large = 0
  index = 0
  while index < large_round
    kept_large = kept_large + 1 if IyiHeap.containing_large(Pointer(Void).new(outgrown[index] ^ 0x5a5a5a5a5a5a5a5a_u64)) != 0_u64
    index = index + 1
  end
  {% if flag?(:unmapped_force) %}
    setup_fail("large: #{large_under_mark} of #{large_round} held rounds reached the check, not 8") unless large_under_mark == 8
  {% end %}
  fail("large: #{kept_large} of #{large_round} outgrown blocks were never freed, #{large_under_mark} of them outgrown under a mark") if large_under_mark >= 2 && kept_large >= large_under_mark
  puts "large: #{large_under_mark} of #{large_round} blocks outgrown under a running mark stayed mapped beside the helpers, and #{large_round - kept_large} were freed after"
  # The helpers' priority boost is off. thread.iyi's start_helper turns it off
  # for each helper the runtime starts on Windows. Wake timings below are
  # informational. Count the boost over the process's own threads: at least
  # as many with the boost off as the helpers the last mark beside the program
  # asked for, and such a mark must have asked for some.
  {% if flag?(:win32) %}
    asked_helpers = IyiMark.beside_helpers
    setup_fail("wake boost: the pool started before the count, so every thread has the boost off") if IyiWorkers.started?
    setup_fail("wake boost: no mark beside the program asked for helpers") if asked_helpers == 0_u64
    boost_off = ThreadBoost.count_boost_off
    fail("wake boost: #{boost_off.to_i64} threads of this process have the priority boost off, the mark asked for #{asked_helpers.to_i64} helpers") if boost_off < asked_helpers
    puts "wake boost: #{boost_off.to_i64} threads of this process have the priority boost off, the mark asked for #{asked_helpers.to_i64} helpers"
  {% end %}
  # The helpers for each mark beside the program are woken by the
  # program's own thread, and the wake is the program's time. On Linux it
  # is one futex call; on Windows a woken helper ran above the thread that
  # woke it and took its core, 3.7 to 40 ms at the longest. The longest
  # wake was the check, and it caught the machine instead once: a runner
  # took the thread away for 3.7 ms in one wake of 49, which it does
  # without any help. Wake counts and timings over two hundred more
  # collections are information only; the structural count above decides
  # the boost because scheduling can delay a healthy thread.
  IyiMark.auto = true
  kept = build_chain(1_u64)
  wake_rounds(kept)
  wake = IyiMark.wake_longest_ns
  wakes = IyiMark.wakes
  slow = IyiMark.wakes_slow
  IyiMark.auto = false
  puts "wake: the program's thread woke the helpers #{wakes.to_i64} times, #{slow.to_i64} of them past #{(IyiMark::WAKE_SLOW_NS // 1000_u64).to_i64} us, the longest #{(wake // 1000_u64).to_i64} us"

  # ── The helpers' share beside a busy program ──────────────────────────
  # The program runs a thread for every core but one, and a mark starts
  # beside them: on Windows it asks for one helper, where it asked for
  # every helper there was and the threads' stalls doubled (the prelude's
  # `start_concurrent` has the numbers). Asserted where it was measured;
  # printed everywhere.
  cores = IyiThread.core_count
  if cores >= 3_u64
    Busy.setup(4096_u64)
    busy = [] of IyiThread
    while busy.size.to_u64 < cores - 2_u64
      busy << IyiThread.start { busy_until_stopped; nil }
    end
    threads = IyiThread.program_threads
    IyiMark.auto = false
    chain = build_chain(7_u64)
    IyiMark.auto = true
    asked = 0_u64
    marked = false
    attempt = 0
    while !marked && attempt < 8
      marked = allocate_until_marking
      asked = IyiMark.beside_helpers if marked
      IyiMark.settle
      attempt = attempt + 1
    end
    Busy.stop.value.set(1_u64)
    busy.each(&.join)
    IyiMark.auto = false
    setup_fail("share: no mark ran beside the busy threads in 8 tries") unless marked
    {% if flag?(:win32) %}
      fail("share: with #{threads.to_i64} threads of the program's on #{cores.to_i64} cores, the mark beside them asked for #{asked.to_i64} helpers rather than 1") if asked != 1_u64
    {% end %}
    puts "share: with #{threads.to_i64} threads of the program's on #{cores.to_i64} cores, the mark beside them asked for #{asked.to_i64} helpers"
    fail("the chain's tail lost its payload beside the busy threads") unless tail(chain).payload.is_a?(Payload)
  else
    setup_fail("the share proof needs three cores; this host has #{cores.to_i64}") unless Program.args.size > 0 && Program.args[0] == "pinned"
    puts "share: the pinned run holds two processors, so the share and pool steps are measured on three or more"
  end

  # ── The helpers' share beside an idle pool ────────────────────────────
  # A pool of a worker per core, every worker waiting in its poller with
  # nothing to run, and a mark beside the program from the main thread:
  # the waiting workers hold no core, and the mark asks for more than one
  # helper. On Windows it asked for one, the workers counted as threads
  # computing, and a server idle between requests marked alone. Then the
  # same pool with every worker running a task: on Windows the mark asks
  # for one helper again, the busy workers' cores not the helpers' to
  # take. Asserted everywhere for the idle pool, on Windows for the busy.
  if cores >= 3_u64
    IyiWorkers.count = cores.to_i32
    # Every worker started first: the pool starts a worker only while none
    # is idle (SPEC.md III.4.15, part 6), so a task a worker that returns
    # at once can leave all but two unstarted, and this step then read "2
    # of 12 workers waiting". Each task spins, up to ten seconds, until all
    # have arrived and the pool has launched every worker. All arrived is
    # not enough: the pool starts its workers one at a time, each started by
    # the last to find a task (`IyiWorkers.grow`), and a task spinning past
    # its quantum gives its worker to one still queued, so the twelve can
    # all arrive time-sliced on fewer threads and end before the pool has
    # grown. On Windows 11 with 12 logical processors (the user's machine)
    # this step read "11 of 12 workers waiting" (and down to 7) in 13 of 60
    # runs of the plain build, where the twelve arrived within 10 to 25 ms
    # on 7 to 11 launched workers; a start there takes about a millisecond,
    # a quantum is 5 to 10 ms. On Linux (12 vCPU) the step alone started
    # all twelve in each of 500 runs, in 1.5 ms (median).
    Busy.arrived.value.set(0_u64)
    group do |g|
      cores.to_i32.times do
        g.spawn(unit: :new) do
          Busy.arrived.value.add(1_u64)
          until_ns = IyiMark.now_ns + 10000000000_u64
          while true
            arrived = Busy.arrived.value.get
            break unless arrived < cores || IyiWorkers.launched < cores.to_i32
            if IyiMark.now_ns >= until_ns
              if arrived < cores
                print "FAIL: idle pool: #{arrived.to_i64} of #{cores.to_i64} tasks arrived within ten seconds\n"
              else
                print "FAIL: idle pool: every task arrived, and the pool launched #{IyiWorkers.launched} of #{cores.to_i64} workers within ten seconds\n"
              end
              __iyi_exit(76)
            end
            {% if flag?(:idle_force) %}
              IyiWorkers.release_starts if arrived >= cores
            {% end %}
            IyiThread.spin_pause
          end
          0
        end
      end
      {% if flag?(:unstarted_force) %}
        IyiWorkers.release_first
      {% end %}
    end
    {% if flag?(:idle_force) %}
      IyiWorkers.release_starts
    {% end %}
    # Each task waits for both all arrivals and all worker launches. The
    # deadline names which condition stalled; it never releases a task.
    # A held-turn copy in the gate proves a turn starts the next worker.
    # On the project's Mac, the old check read 9 of 10 waiting in job
    # 134651603579; after the fix the pool filled in 56 ms or less in 150
    # release runs beside 20 busy loops.
    launched = IyiWorkers.launched
    deadline = IyiMark.now_ns + 5000000000_u64
    # A spin, not a sleep: this thread asleep would be counted waiting.
    while IyiScheduler.waiting_threads < launched.to_u64 && IyiMark.now_ns < deadline
      IyiThread.yield_cpu
    end
    waiting = IyiScheduler.waiting_threads
    if waiting < launched.to_u64
      print "FAIL: idle pool: the launched workers did not all reach their wait within five seconds\n"
      __iyi_exit(76)
    end
    fail("idle pool: #{waiting.to_i64} of #{cores.to_i64} workers waiting, and every worker the pool launched is one of them") if waiting < cores
    threads = IyiThread.program_threads
    IyiMark.auto = false
    chain = build_chain(11_u64)
    IyiMark.auto = true
    asked = 0_u64
    marked = false
    attempt = 0
    while !marked && attempt < 8
      marked = allocate_until_marking
      asked = IyiMark.beside_helpers if marked
      IyiMark.settle
      attempt = attempt + 1
    end
    IyiMark.auto = false
    setup_fail("idle pool: no mark ran beside the idle pool in 8 tries") unless marked
    fail("idle pool: with #{threads.to_i64} threads of the program's on #{cores.to_i64} cores, #{waiting.to_i64} of them pool workers waiting, the mark beside them asked for #{asked.to_i64} helper") if asked < 2_u64
    puts "idle pool: with #{threads.to_i64} threads of the program's on #{cores.to_i64} cores, #{waiting.to_i64} of them pool workers waiting, the mark beside them asked for #{asked.to_i64} helpers"
    fail("the chain's tail lost its payload beside the idle pool") unless tail(chain).payload.is_a?(Payload)

    Busy.stop.value.set(0_u64)
    busy_asked = 0_u64
    busy_waiting = 0_u64
    group do |g|
      cores.to_i32.times do
        g.spawn(unit: :new) do
          busy_until_stopped
          0
        end
      end
      deadline = IyiMark.now_ns + 5000000000_u64
      while IyiScheduler.waiting_threads > 0_u64 && IyiMark.now_ns < deadline
        IyiThread.yield_cpu
      end
      busy_waiting = IyiScheduler.waiting_threads
      IyiMark.auto = true
      marked = false
      attempt = 0
      while !marked && attempt < 8
        marked = allocate_until_marking
        busy_asked = IyiMark.beside_helpers if marked
        IyiMark.settle
        attempt = attempt + 1
      end
      IyiMark.auto = false
      Busy.stop.value.set(1_u64)
    end
    setup_fail("busy pool: no mark ran beside the busy pool in 8 tries") unless marked
    {% if flag?(:win32) %}
      fail("busy pool: with #{cores.to_i64} pool workers running on #{cores.to_i64} cores, #{busy_waiting.to_i64} waiting, the mark beside them asked for #{busy_asked.to_i64} helpers rather than 1") if busy_asked != 1_u64
    {% end %}
    puts "busy pool: with #{cores.to_i64} pool workers running on #{cores.to_i64} cores, #{busy_waiting.to_i64} waiting, the mark beside them asked for #{busy_asked.to_i64} helpers"
    fail("the chain's tail lost its payload beside the busy pool") unless tail(chain).payload.is_a?(Payload)
  else
    setup_fail("the idle and busy pool proofs need three cores; this host has #{cores.to_i64}") unless Program.args.size > 0 && Program.args[0] == "pinned"
  end
  puts "concurrent mark: every property held"
{% else %}
  puts "concurrent mark: needs the collector and a thread target; nothing to exercise here"
{% end %}
