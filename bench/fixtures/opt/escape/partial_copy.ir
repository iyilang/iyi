; iyi-ir 1
source_filename = "escape_partial_copy"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @partial(ptr %source) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 16, i64 3, i64 2)
  intrinsic llvm.memcpy.p0.p0.i64(ptr %p, ptr %source, i64 7, i1 false)
  %value = load i64, ptr %p, align 8
  ret i64 %value
}
