all: ##

-include Makefile.win.local # for optional local options e.g. threads

# Recipes for this Makefile

## Build the compiler
##   $ make -f Makefile.win
## Build the compiler with progress output
##   $ make -f Makefile.win progress=1
## Clean up built files then build the compiler
##   $ make -f Makefile.win clean crystal
## Build the compiler in release mode
##   $ make -f Makefile.win crystal release=1
## Build all assets for a package install (compiler)
##   $ make -f Makefile.win build
## Build and install crystal package
##   $ make -f Makefile.win build && sudo make -f Makefile.win install
## Run tests
##   $ make -f Makefile.win test
## Run stdlib tests
##   $ make -f Makefile.win std_spec
## Run compiler tests
##   $ make -f Makefile.win compiler_spec
## Run generators (Unicode, SSL config, ...)
##   $ make -B generate_data

CRYSTAL ?= crystal ## which previous crystal compiler use

release            ?= ## Compile in release mode
stats              ?= ## Enable statistics output
progress           ?= ## Enable progress output
threads            ?= ## Maximum number of threads to use
debug              ?= ## Add symbolic debug info
verbose            ?= ## Run specs in verbose mode
junit_output       ?= ## Path to output junit results
static             ?= ## Enable static linking
target             ?= ## Cross-compilation target
check              ?= ## Enable only check when running format
order              ?= random## Enable order for spec execution (values: "default" | "random" | seed number)
sequential_codegen ?= ## Enforce sequential codegen in compiler builds.

MAKEFLAGS += --no-builtin-rules
.SUFFIXES:

SHELL := cmd.exe
CXX   := cl.exe
RC    := rc.exe

GLOB       = $(shell dir $1 /B /S)
MKDIR      = if not exist $1 mkdir $1
CP         = copy /B /Y $1 $2
CPDIR      = robocopy /E /NJH /NJS /NS /NC /NP $1 $2 & if %%ERRORLEVEL%% GEQ 8 exit /B 1
INSTALL    = copy /B /Y $1 $2
INSTALLDIR = robocopy /E /NJH /NJS /NS /NC /NP $1 $2 & if %%ERRORLEVEL%% GEQ 8 exit /B 1
MV         = move /Y $1 $2
RM         = if exist $1 del /F /Q $1
RMDIR      = if exist $1 rd /S /Q $1

O            := .build
SOURCES      := $(call GLOB,src\\*.cr)
SPEC_SOURCES := $(call GLOB,spec\\*.cr)
override FLAGS += -D strict_multi_assign -D preview_overload_order $(if $(release),--release )$(if $(stats),--stats )$(if $(progress),--progress )$(if $(threads),--threads $(threads) )$(if $(debug),-d )$(if $(static),--static )$(if $(LDFLAGS),--link-flags="$(LDFLAGS)" )$(if $(target),--cross-compile --target $(target) )
override COMPILER_FLAGS +=  -Dwithout_openssl -Dwithout_zlib$(if $(sequential_codegen), -Dwithout_mt,)
SPEC_WARNINGS_OFF           := --exclude-warnings spec\std --exclude-warnings spec\compiler --exclude-warnings spec\primitives --exclude-warnings src\float\printer
SPEC_FLAGS                  := $(if $(verbose),-v )$(if $(junit_output),--junit_output $(junit_output) )$(if $(order),--order=$(order) )
CRYSTAL_CONFIG_LIBRARY_PATH := $$ORIGIN\lib
CRYSTAL_CONFIG_BUILD_COMMIT := $(shell git rev-parse --short HEAD)
CRYSTAL_CONFIG_PATH         := $$ORIGIN\src
ifndef CRYSTAL_VERSION
	CRYSTAL_VERSION := $(shell type src\VERSION)
endif
ifndef SOURCE_DATE_EPOCH
	SOURCE_DATE_EPOCH := $(or $(shell type src\SOURCE_DATE_EPOCH 2>NUL),$(shell git show -s --format=%ct HEAD))
endif
export_vars       = $(eval export CRYSTAL_CONFIG_BUILD_COMMIT CRYSTAL_CONFIG_PATH SOURCE_DATE_EPOCH)
export_build_vars = $(eval export CRYSTAL_CONFIG_LIBRARY_PATH)

# iyi: what `make -f Makefile.win iyi` bakes into the binary. The paths are
# the Linux Makefile's, spelled Windows's way: `;` separates them and either
# separator follows `$ORIGIN`, which the compiler expands to its own
# directory at run time (`src\compiler\iyi\iyi_path.cr`). A binary in
# `.build` therefore finds this checkout's `src`, and the same binary
# unpacked beside a `share\iyi` finds that instead.
collector                   ?= ## iyi: link the owned collector into `iyi` itself
IYI_CONFIG_BUILD_COMMIT     := $(shell git rev-parse --short HEAD)
IYI_CONFIG_PATH             := $$ORIGIN\..\share\iyi\src;$$ORIGIN\..\share\iyi\crystal;$$ORIGIN\..\src
IYI_CONFIG_LIBRARY_PATH     := $$ORIGIN\..\lib\iyi
IYI_COMPILER_FLAGS          := -Dwithout_iconv$(if $(collector),,  -Dgc_none)
export_iyi_vars   = $(eval export IYI_CONFIG_BUILD_COMMIT IYI_CONFIG_PATH IYI_CONFIG_LIBRARY_PATH)

# iyi: what a downloadable build of iyi is called. The Linux Makefile asks
# `uname` for the two last words; here the platform is the makefile, so they
# are written out.
IYI_VERSION     ?= $(shell type src\IYI_VERSION)
IYI_PACKAGE     := iyi-$(IYI_VERSION)-windows-x86_64
IYI_PACKAGE_DIR := $(O)\$(IYI_PACKAGE)

# iyi: the one library a packaged `iyi.exe` cannot find on a machine that has
# never seen LLVM. `dumpbin /dependents` on the binary names two libraries
# Windows does not ship, LLVM-C.dll and VCRUNTIME140.dll, and the second one
# comes with the Visual C++ build tools the compiler needs anyway for its
# linker — so this is the only file the zip has to carry beside the binary.
#
# Taken out of `$(O)`, where the build already put it: on msvc the compiler
# copies every DLL a binary needs beside that binary
# (`src\compiler\iyi\compiler.cr`, `copy_dlls`), so this is the exact
# LLVM-C.dll the link resolved. A `where LLVM-C.dll` instead would take
# whatever is first on PATH, which on this machine is a second LLVM install
# of its own version.
IYI_PACKAGE_LLVM ?= $(O)\LLVM-C.dll

ifeq ($(LLVM_VERSION),)
LLVM_CONFIG  ?=
LLVM_VERSION := $(if $(LLVM_CONFIG),$(shell "$(LLVM_CONFIG)" --version))
endif
LLVM_HOST_TARGET ?= $(if $(LLVM_CONFIG),$(shell $(LLVM_CONFIG) --host-target))

LLVM_EXT_DIR = src\llvm\ext
LLVM_EXT_OBJ = $(LLVM_EXT_DIR)\llvm_ext.obj
CXXFLAGS     += $(if $(static),$(if $(debug),/MTd /Od ,/MT ),$(if $(debug),/MDd /Od ,/MD ))

prefix  ?= $(or $(ProgramW6432),$(ProgramFiles))\crystal
BINDIR  ?= $(prefix)
LIBDIR  ?= $(prefix)\lib
SRCDIR  ?= $(prefix)\src
DATADIR ?= $(prefix)

colorize = $(info $1)

DEPS = $(LLVM_EXT_OBJ)
ifneq ($(LLVM_VERSION),)
  ifeq ($(shell if $(firstword $(subst ., ,$(LLVM_VERSION))) GEQ 18 echo 0),0)
    DEPS =
  endif
endif

check_llvm_config = $(eval \
	check_llvm_config := $(if $(LLVM_VERSION), \
	$(call colorize,Using $(or $(LLVM_CONFIG),externally configured LLVM) [version=$(LLVM_VERSION)]), \
	$(error "Could not locate compatible llvm-config, make sure it is installed and in your PATH, or set LLVM_VERSION / LLVM_CONFIG. Compatible versions: $(shell type src\llvm\ext\llvm-versions.txt))) \
	)

.PHONY: all
all: crystal

.PHONY: test
test: spec ## Run tests

.PHONY: spec
spec: std_spec primitives_spec compiler_spec

.PHONY: std_spec
std_spec: $(O)\std_spec.exe ## Run standard library specs
	$(O)\std_spec $(SPEC_FLAGS)

.PHONY: compiler_spec
compiler_spec: $(O)\compiler_spec.exe ## Run compiler specs
	$(O)\compiler_spec $(SPEC_FLAGS)

.PHONY: primitives_spec
primitives_spec: $(O)\primitives_spec.exe ## Run primitives specs
	$(O)\primitives_spec $(SPEC_FLAGS)

.PHONY: cli_spec
cli_spec: $(O)\cli_spec.exe ## Run compiler CLI specs
	$(O)\cli_spec $(SPEC_FLAGS)

.PHONY: smoke_test
smoke_test: ## Build specs as a smoke test
smoke_test: $(O)\std_spec.exe $(O)\compiler_spec.exe $(O)\crystal.exe

.PHONY: all_spec
all_spec: $(O)\all_spec.exe ## Run all specs (note: this builds a huge program; `test` recipe builds individual binaries and is recommended for reduced resource usage)
	$(O)\all_spec $(SPEC_FLAGS)

.PHONY: crystal
crystal: $(O)\crystal.exe ## Build the compiler [default]

.PHONY: iyi
iyi: $(O)\iyi.exe ## iyi: build `iyi` itself, runnable as .build\iyi.exe

.PHONY: iyi-daemon
iyi-daemon: $(O)\iyi-daemon.exe ## iyi: build iyi's own single-threaded build daemon

.PHONY: iyi-zip
iyi-zip: ## iyi: build a relocatable zip at .build
# bake-format off: Mbake bug with Duplicate target rule https://github.com/EbodShojaei/bake/issues/106
iyi-zip: release := 1
iyi-zip: $(O)\iyi.exe check_iyi_is_release
# bake-format on
# iyi: the layout the binary already bakes. `IYI_CONFIG_PATH` above says
# `$ORIGIN\..\share\iyi\src`, so a `bin\iyi.exe` unpacked beside a
# `share\iyi` finds its prelude with nothing set in the environment — which
# is what makes the zip relocatable and what `scripts\package-windows.ps1`
# then proves by unpacking it somewhere else and building a program with
# PATH cut down to Windows' own directories.
	$(call RMDIR,"$(IYI_PACKAGE_DIR)")
	$(call MKDIR,"$(IYI_PACKAGE_DIR)\bin")
	$(call CP,"$(O)\iyi.exe","$(IYI_PACKAGE_DIR)\bin\iyi.exe")

# `iyi-daemon.exe` is not here, and cannot be yet: `make -f Makefile.win
# iyi-daemon` stops at `can't find file 'c/poll'` from
# `src\compiler\iyi\command\daemon.cr:4`, and the design behind that line is
# the rest of it — the server loop is `poll(2)` and the per-build worker is
# `fork`, neither of which is Windows. The Linux tarball ships the binary
# this one has to leave out.

# In `bin`, not in `lib`: the loader reads a binary's own directory before it
# reads PATH, so LLVM-C.dll beside the binary is found by it and by nothing
# else on the machine.
	if not exist "$(IYI_PACKAGE_LLVM)" ( \
	  echo LLVM-C.dll is not at $(IYI_PACKAGE_LLVM) and iyi.exe cannot start without it.& \
	  echo The build copies it there; if it did not, it warned that it could not locate it in CRYSTAL_LIBRARY_PATH or on PATH. Set IYI_PACKAGE_LLVM to the DLL to package another one.& \
	  exit 1 \
	)
	$(call CP,"$(IYI_PACKAGE_LLVM)","$(IYI_PACKAGE_DIR)\bin\LLVM-C.dll")

	$(call MKDIR,"$(IYI_PACKAGE_DIR)\share\iyi\src")
	$(call CPDIR,src\iyi,"$(IYI_PACKAGE_DIR)\share\iyi\src\iyi")

# And the standard library beside it under its own name, because `import
# std/text` is a program's line and not a checkout's. 0.11.0 shipped none of
# it and answered that line with "can't find module".
	$(call CPDIR,src\std,"$(IYI_PACKAGE_DIR)\share\iyi\src\std")

# Crystal's library is not here, and the zip is honest about it rather than
# large. `--crystal` gives a program Crystal's prelude, which links pcre2-8,
# gc, iconv and the rest, and the only `.lib` files for those on a Windows
# machine are the ones in the bootstrap package's `lib`: measured here,
# `--crystal` builds and runs out of this checkout with
# `CRYSTAL_LIBRARY_PATH` pointing at that directory and cannot find the
# libraries without it. So a zip carrying the library and not those would
# reach the linker and stop there. The Linux tarball can ship the library
# because a Linux machine has the libraries.

# A sample that builds leaves its binary beside it and a copy takes whatever
# is on disk, which is how the Linux tarball once shipped 82 MB of a shard's
# `mods/`. Pruned by shape rather than by name, so the next sample of that
# shape is covered too.
	$(call CPDIR,samples\iyi,"$(IYI_PACKAGE_DIR)\share\iyi\samples" /XF *.exe *.pdb /XD lib mods)

	$(call CP,README.md,"$(IYI_PACKAGE_DIR)\share\iyi\README.md")
	$(call CP,SPEC.md,"$(IYI_PACKAGE_DIR)\share\iyi\SPEC.md")
	$(call MKDIR,"$(IYI_PACKAGE_DIR)\share\licenses\iyi")
	$(call CP,LICENSE,"$(IYI_PACKAGE_DIR)\share\licenses\iyi\LICENSE")
	$(call CP,NOTICE.md,"$(IYI_PACKAGE_DIR)\share\licenses\iyi\NOTICE.md")

# Entry by entry rather than `ZipFile.CreateFromDirectory`, and the
# separator is the whole reason: .NET Framework's CreateFromDirectory names
# entries with the separator it found on disk, so the first zip built here
# carried `bin\iyi.exe` — one filename with a backslash in it to Explorer's
# own extractor, to 7-Zip, and to `unzip` on the machine of anybody who
# looks inside it from Linux. The zip format says `/`, so each name is
# spelled that way here. `Compress-Archive` is not the alternative: it walks
# the tree through the pipeline, which over 85 MB of LLVM is minutes rather
# than the seconds this takes.
	$(call RM,"$(O)\$(IYI_PACKAGE).zip")
	powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.IO.Compression.FileSystem; $$src = (Resolve-Path '$(IYI_PACKAGE_DIR)').Path; $$zip = [System.IO.Compression.ZipFile]::Open((Join-Path (Resolve-Path '$(O)').Path '$(IYI_PACKAGE).zip'), 'Create'); Get-ChildItem -LiteralPath $$src -Recurse -File | ForEach-Object { [void] [System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile($$zip, $$_.FullName, $$_.FullName.Substring($$src.Length + 1).Replace('\', '/')) }; $$zip.Dispose()"

# The line `install.ps1` checks the download against, in `sha256sum`'s
# format, because the release publishes one SHA256SUMS for every platform's
# file and the Linux job writes its lines with `sha256sum`. Written with a
# single LF for the same reason: `sha256sum -c` reads its own file back and
# a CR is part of the filename to it.
	powershell -NoProfile -ExecutionPolicy Bypass -Command "$$zip = (Resolve-Path '$(O)\$(IYI_PACKAGE).zip').Path; $$line = (Get-FileHash -LiteralPath $$zip -Algorithm SHA256).Hash.ToLower() + '  ' + [System.IO.Path]::GetFileName($$zip) + [char]10; [System.IO.File]::WriteAllText((Join-Path (Split-Path $$zip) 'SHA256SUMS'), $$line)"
	@echo wrote $(O)\$(IYI_PACKAGE).zip

.PHONY: build
build: ## Build all files for a package install (currently the compiler)

# bake-format off: Mbake bug with Duplicate target rule https://github.com/EbodShojaei/bake/issues/106
build: release := 1
build: crystal
# bake-format on

.PHONY: deps llvm_ext
deps: $(DEPS) ## Build dependencies
llvm_ext: $(DEPS)

.PHONY: format
format: ## Format sources
	.\bin\crystal tool format$(if $(check), --check) src spec samples scripts

.PHONY: generate_data
generate_data: ## Run generator scripts for Unicode, SSL config, ...
	$(MAKE) -B -f scripts/generate_data.mk

.PHONY: install
install: ## Install the crystal compiler package at prefix
install: install_compiler

.PHONY: install_compiler
install_compiler: $(O)\crystal.exe
	$(call MKDIR,"$(BINDIR)")
	$(call INSTALL,"$(O)\crystal.exe","$(BINDIR)\crystal.exe")
	$(call INSTALL,"$(O)\crystal.pdb","$(BINDIR)\crystal.pdb")

	$(call MKDIR,"$(DATADIR)")
	$(call INSTALLDIR,src,"$(DATADIR)\src")
	$(call RM,"$(DATADIR)\$(LLVM_EXT_OBJ)")

	$(call INSTALL,LICENSE,"$(DATADIR)\LICENSE.txt")

.PHONY: uninstall ## Uninstall the Crystal compiler package from prefix
uninstall: uninstall_compiler

.PHONY: uninstall_compiler
uninstall_compiler:
	$(call RM,"$(DATADIR)\LICENSE.txt")

	$(call RMDIR,"$(DATADIR)\src")

	$(call RM,"$(BINDIR)\crystal.exe")
	$(call RM,"$(BINDIR)\crystal.pdb")

# iyi: the binary about to be packaged is an optimised one.
#
# `release := 1` on `iyi-zip` asks for that, and asking is not enough: make
# rebuilds on file times, so an `iyi.exe` left over from an ordinary `make -f
# Makefile.win iyi` is newer than every source and gets packaged as it is.
# Nothing about the zip would look wrong. The binary would simply be an
# unoptimised compiler, and every build every user ran would go through it — a
# release nobody could see was slow.
#
# So it is asked of the binary rather than of the build: `--version` says which
# it is. `exit`, not `exit /B`: make runs a recipe through a batch file and
# `exit /B` inside a parenthesised block returns from the block without
# failing the line, which passed a debug build through the first time this was
# written.
.PHONY: check_iyi_is_release
check_iyi_is_release: $(O)\iyi.exe
	@$(O)\iyi.exe --version | findstr /C:"not built in release mode" >NUL && ( \
	  echo $(O)\iyi.exe is not an optimised build, and a zip ships what it packages.& \
	  echo It is up to date by file times, so make will not rebuild it. Force it:& \
	  echo   make -f Makefile.win -B iyi release=1& \
	  exit 1 \
	) || rem the binary does not say it, which is the pass

$(O)\all_spec.exe: $(DEPS) $(SOURCES) $(SPEC_SOURCES)
	$(call check_llvm_config)
	@$(call MKDIR,"$(O)")
	$(call export_vars)
	.\bin\crystal build $(FLAGS) $(SPEC_WARNINGS_OFF) -o "$@" spec\all_spec.cr

$(O)\std_spec.exe: $(DEPS) $(SOURCES) $(SPEC_SOURCES)
	$(call check_llvm_config)
	@$(call MKDIR,"$(O)")
	.\bin\crystal build $(FLAGS) $(SPEC_WARNINGS_OFF) -o "$@" spec\std_spec.cr

$(O)\compiler_spec.exe: $(DEPS) $(SOURCES) $(SPEC_SOURCES)
	$(call check_llvm_config)
	@$(call MKDIR,"$(O)")
	$(call export_vars)
	.\bin\crystal build $(FLAGS) $(COMPILER_FLAGS) $(SPEC_WARNINGS_OFF) -o "$@" spec\compiler_spec.cr --release

$(O)\primitives_spec.exe: $(O)\crystal.exe $(DEPS) $(SOURCES) $(SPEC_SOURCES)
	@$(call MKDIR,"$(O)")
	.\bin\crystal build $(FLAGS) $(SPEC_WARNINGS_OFF) -o "$@" spec\primitives_spec.cr

$(O)\cli_spec.exe: $(O)\crystal.exe $(DEPS) $(SOURCES) $(SPEC_SOURCES)
	@$(call MKDIR,"$(O)")
	.\bin\crystal build $(FLAGS) $(SPEC_WARNINGS_OFF) -o "$@" spec\cli_spec.cr

$(O)\crystal.exe: $(DEPS) $(SOURCES) $(O)\crystal.res
	$(call check_llvm_config)
	@$(call MKDIR,"$(O)")
	$(call export_vars)
	$(call export_build_vars)
	.\bin\crystal build $(FLAGS) $(COMPILER_FLAGS)  -o "$(O)\crystal-next.exe" src\compiler\crystal.cr --link-flags=/PDBALTPATH:crystal.pdb "--link-flags=$(realpath $(O)\crystal.res)"
	$(call MV,"$(O)\crystal-next.exe","$@")
	$(call MV,"$(O)\crystal-next.pdb","$(O)\crystal.pdb")

# iyi: the binary a person types, and the daemon `iyi daemon start` looks up
# beside it. Built through `-next.exe` and moved, for the reason the compiler
# above is: Windows will not overwrite a running program, and the compiler
# that builds this one is usually the one in this directory.
$(O)\iyi.exe: $(DEPS) $(SOURCES)
	$(call check_llvm_config)
	@$(call MKDIR,"$(O)")
	$(call export_vars)
	$(call export_build_vars)
	$(call export_iyi_vars)
	.\bin\crystal build $(FLAGS) $(COMPILER_FLAGS) $(IYI_COMPILER_FLAGS) -o "$(O)\iyi-next.exe" src\compiler\iyi.cr --link-flags=/PDBALTPATH:iyi.pdb
	$(call MV,"$(O)\iyi-next.exe","$@")
	$(call MV,"$(O)\iyi-next.pdb","$(O)\iyi.pdb")
	@echo built $@

$(O)\iyi-daemon.exe: $(DEPS) $(SOURCES)
	$(call check_llvm_config)
	@$(call MKDIR,"$(O)")
	$(call export_vars)
	$(call export_build_vars)
	$(call export_iyi_vars)
	.\bin\crystal build $(FLAGS) $(COMPILER_FLAGS) $(IYI_COMPILER_FLAGS) -Dwithout_mt -o "$(O)\iyi-daemon-next.exe" src\compiler\iyi.cr --link-flags=/PDBALTPATH:iyi-daemon.pdb
	$(call MV,"$(O)\iyi-daemon-next.exe","$@")
	$(call MV,"$(O)\iyi-daemon-next.pdb","$(O)\iyi-daemon.pdb")

$(O)\crystal.res: $(O)\crystal.rc
	@$(call MKDIR,"$(O)")
	$(RC) /nologo /Fo "$@" "$<"

$(O)\crystal.rc: $(MAKEFILE_LIST)
	@$(call MKDIR,"$(O)")
	$(MAKE) -s -f $(MAKEFILE_LIST) rc > "$@"

ifneq ($(DEPS),)
$(LLVM_EXT_OBJ): $(LLVM_EXT_DIR)\llvm_ext.cc
	$(call check_llvm_config)
	@rem Disable some harmless warnings:
	@rem - warning C4244: 'initializing': conversion from '_Ty' to '_Ty2', possible loss of data
	@rem - warning C4530: C++ exception handler used, but unwind semantics are not enabled. Specify /EHsc
	@rem - warning C4624: '...': destructor was implicitly defined as deleted
	$(CXX) /nologo /c $(CXXFLAGS) /WX /wd4244 /wd4624 /wd4530 "/Fo$@" "$<" $(if $(LLVM_CONFIG),$(shell $(LLVM_CONFIG) --cxxflags))
endif
$(O)\crystal-pu.exe: spec\support\process-utils.cr $(SOURCES)
	@$(call MKDIR,"$(O)")
	$(call export_vars)
	.\bin\crystal build $(FLAGS) -o $@ $<

.PHONY: clean
clean: clean_crystal ## Clean up built directories and files
	$(call RM,"$(LLVM_EXT_OBJ)")

.PHONY: clean_crystal
clean_crystal: ## Clean up crystal built files
	$(call RMDIR,"$(O)")

.PHONY: clean_cache
clean_cache: ## Clean up CRYSTAL_CACHE_DIR files
	$(call RMDIR,"$(shell .\bin\crystal env CRYSTAL_CACHE_DIR)")

.PHONY: rc
rc: ## Write compiler resource script to standard output
	$(eval comma := ,)
	$(eval ver_comma := $(subst .,$(comma),$(subst -dev,,$(CRYSTAL_VERSION))))
	$(eval source_date := $(shell git show -s --format=%cs HEAD))
	$(eval source_year := $(firstword $(subst -, ,$(source_date))))
	$(eval ver_full := $(CRYSTAL_VERSION)$(if $(CRYSTAL_CONFIG_BUILD_COMMIT), [$(CRYSTAL_CONFIG_BUILD_COMMIT)])$(if $(source_date), ($(source_date))))
	@setlocal EnableDelayedExpansion &\
	echo #include ^<windows.h^>& \
	echo.& \
	set "_dir=$(dir $(abspath $(lastword $(MAKEFILE_LIST))))" & \
	echo VS_VERSION_INFO VERSIONINFO& \
	echo     PRODUCTVERSION $(ver_comma),0& \
	echo     FILEVERSION    $(ver_comma),1& \
	echo     FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK& \
	echo     FILEFLAGS      $(if $(findstring -dev,$(CRYSTAL_VERSION)),VS_FF_PRERELEASE,0)& \
	echo     FILEOS         VOS_NT_WINDOWS32& \
	echo     FILETYPE       VFT_APP& \
	echo     FILESUBTYPE    VFT2_UNKNOWN& \
	echo BEGIN& \
	echo     BLOCK "StringFileInfo"& \
	echo     BEGIN& \
	echo         BLOCK "040904B0"& \
	echo         BEGIN& \
	echo             VALUE "ProductName",      "Crystal"& \
	echo             VALUE "ProductVersion",   "$(ver_full)"& \
	echo             VALUE "FileVersion",      "$(ver_full)"& \
	echo             VALUE "FileDescription",  "Crystal$(if $(LLVM_HOST_TARGET), $(LLVM_HOST_TARGET))"& \
	echo             VALUE "Comments",         "$(if $(LLVM_VERSION),LLVM $(LLVM_VERSION))"& \
	echo             VALUE "InternalName",     "crystal.exe"& \
	echo             VALUE "OriginalFilename", "crystal.exe"& \
	echo             VALUE "CompanyName",      "Manas Technology Solutions"& \
	echo             VALUE "LegalCopyright",   "Copyright 2012-$(source_year) Manas Technology Solutions"& \
	echo         END& \
	echo     END& \
	echo     BLOCK "VarFileInfo"& \
	echo     BEGIN& \
	echo         VALUE "Translation", 0x0409, 0x04B0& \
	echo     END& \
	echo END

.PHONY: help
help: ## Show this help
	@setlocal EnableDelayedExpansion &\
	echo. & \
	echo targets: & \
	(for /F "usebackq tokens=1* delims=:" %%g in ($(MAKEFILE_LIST)) do ( \
		if not "%%h" == "" ( \
			set "_line=%%g                " & \
			set "_rest=%%h" & \
			set "_comment=!_rest:* ## =!" & \
			if not "!_comment!" == "!_rest!" \
				if "!_line:_rest=!" == "!_line!" \
					echo   !_line:~0,16!!_comment! \
		) \
	)) & \
	echo. & \
	echo optional variables: & \
	(for /F "usebackq tokens=1,3 delims=?#" %%g in ($(MAKEFILE_LIST)) do ( \
		if not "%%h" == "" ( \
			set "_var=%%g              " & \
			echo   !_var:~0,14! %%h \
		) \
	)) & \
	echo. & \
	echo recipes: & \
	(for /F "usebackq tokens=* delims=" %%g in ($(MAKEFILE_LIST)) do ( \
		set "_line=%%g" & \
		if "!_line:~0,7!" == "##   $$ " ( \
			echo !_name! & \
			echo  !_line:~2! \
		) else if "!_line:~0,3!" == "## " \
			set "_name=  !_line:~3!" \
	))
