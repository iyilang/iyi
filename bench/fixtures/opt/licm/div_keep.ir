; iyi-ir 1
source_filename = "div_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @div_keep(i1 %run, i32 %a, i32 %b, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %sd = sdiv i32 %a, %b
  %ud = udiv i32 %a, %b
  %sr = srem i32 %a, %b
  %ur = urem i32 %a, %b
  store i32 %sd, ptr %out, align 4
  store i32 %ud, ptr %out, align 4
  store i32 %sr, ptr %out, align 4
  store i32 %ur, ptr %out, align 4
  br label %head
done:
  ret void
}
