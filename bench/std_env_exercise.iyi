# Exercises `std/env`.
#
# Run via:
#     ./bin/iyi run bench/std_env_exercise.iyi

module bench/std_env_exercise

import std/env::{ENV}
import std/gc::{GC}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def assert_str_nilable(expected : String, actual : String?, msg : String) : Nil
  if actual.nil?
    raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got nil"
  else
    raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got #{actual.inspect}" unless expected == actual
  end
end

def assert_nil(actual : String?, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected nil\n  got #{actual.inspect}" unless actual.nil?
end

PREFIX   = "_IYI_ENV_EXERCISE_"
K1       = "#{PREFIX}VAR_ONE"
K2       = "#{PREFIX}VAR_TWO"
K3       = "#{PREFIX}VAR_THREE"
K_ABSENT = "#{PREFIX}VAR_NEVER_SET"

# Capture any pre-existing values to restore on exit
orig_k1 = ENV[K1]?
orig_k2 = ENV[K2]?
orig_k3 = ENV[K3]?
orig_absent = ENV[K_ABSENT]?

# Ensure clean starting state for the exercise keys
ENV.delete(K1)
ENV.delete(K2)
ENV.delete(K3)
ENV.delete(K_ABSENT)

puts "== set and get"
assert_nil ENV[K1]?, "K1 initially absent"
assert_true !ENV.has_key?(K1), "K1 has_key? false initially"

ENV[K1] = "first_value"
assert_str "first_value", ENV[K1], "get after set"
assert_str_nilable "first_value", ENV[K1]?, "nilable get after set"
assert_str "first_value", ENV.fetch(K1), "fetch after set"
assert_str "first_value", ENV.fetch(K1, "fallback"), "fetch with default when present"
assert_true ENV.has_key?(K1), "has_key? after set"

ENV[K1] = "updated_value"
assert_str "updated_value", ENV[K1], "get after overwrite"
puts "  set, get, overwrite, and presence"

puts "\n== absent key and defaults"
assert_nil ENV[K_ABSENT]?, "absent nilable"
assert_true !ENV.has_key?(K_ABSENT), "absent has_key?"
assert_str "my_default", ENV.fetch(K_ABSENT, "my_default"), "fetch with default"
block_res = ENV.fetch(K_ABSENT) { |k| "fallback_for_#{k}" }
assert_str "fallback_for_#{K_ABSENT}", block_res, "fetch with block fallback"
puts "  absent key nilable, default, and block fallbacks"

puts "\n== delete and presence"
ENV[K2] = "to_be_deleted"
assert_true ENV.has_key?(K2), "K2 present before delete"
old = ENV.delete(K2)
assert_str_nilable "to_be_deleted", old, "delete returns old value"
assert_nil ENV[K2]?, "K2 absent after delete"
assert_true !ENV.has_key?(K2), "K2 has_key? false after delete"

old_absent = ENV.delete(K_ABSENT)
assert_nil old_absent, "delete absent returns nil"
puts "  delete and absent delete"

puts "\n== iteration and hash"
ENV[K1] = "val1"
ENV[K2] = "val2"
ENV[K3] = "val3"

found_k1 = false
found_k2 = false
found_k3 = false
ENV.each do |k, v|
  if k == K1
    assert_str "val1", v, "K1 value in each"
    found_k1 = true
  elsif k == K2
    assert_str "val2", v, "K2 value in each"
    found_k2 = true
  elsif k == K3
    assert_str "val3", v, "K3 value in each"
    found_k3 = true
  end
end
assert_true found_k1, "K1 found in each"
assert_true found_k2, "K2 found in each"
assert_true found_k3, "K3 found in each"

keys_seen = 0
ENV.each_key do |k|
  if k == K1 || k == K2 || k == K3
    keys_seen = keys_seen + 1
  end
end
assert_true keys_seen == 3, "seen exactly 3 set keys in each_key"

vals_seen = 0
ENV.each_value do |v|
  if v == "val1" || v == "val2" || v == "val3"
    vals_seen = vals_seen + 1
  end
end
assert_true vals_seen == 3, "seen exactly 3 set values in each_value"

all_keys = ENV.keys
assert_true all_keys.includes?(K1), "keys includes K1"
assert_true all_keys.includes?(K2), "keys includes K2"
assert_true all_keys.includes?(K3), "keys includes K3"

all_vals = ENV.values
assert_true all_vals.includes?("val1"), "values includes val1"
assert_true all_vals.includes?("val2"), "values includes val2"
assert_true all_vals.includes?("val3"), "values includes val3"

env_map = ENV.to_h
assert_str "val1", env_map[K1], "to_h K1"
assert_str "val2", env_map[K2], "to_h K2"
assert_str "val3", env_map[K3], "to_h K3"

assert_true ENV.size >= 3, "size at least 3"
assert_true !ENV.empty?, "empty? is false"

# A block that deletes as it goes sees every variable all the same: the
# table was walked while `delete` closed it up, so the entry after each
# deleted one moved into the slot just read and was never yielded.
each_names = ["_IYI_ENV_EXERCISE_EACH_A", "_IYI_ENV_EXERCISE_EACH_B", "_IYI_ENV_EXERCISE_EACH_C"]
each_names.each { |name| ENV[name] = "x" }
visited = 0
ENV.each do |k, _|
  if each_names.includes?(k)
    visited = visited + 1
    ENV.delete(k)
  end
end
assert_true visited == 3, "each visits every variable while its block deletes: #{visited} of 3"
left = 0
each_names.each { |name| left = left + 1 if ENV.has_key?(name) }
assert_true left == 0, "every variable each's block deleted is gone: #{left} left"
puts "  each, each_key, each_value, keys, values, to_h, size, and cleanup"

puts "\n== nil assignment, empty value, positions, and Program.env"
ENV[K1] = "nil_me"
ENV[K1] = nil
assert_nil ENV[K1]?, "[]= nil deletes"

ENV[K1] = ""
assert_str "", ENV[K1], "empty value is present"
assert_true ENV.has_key?(K1), "empty value has_key?"

ENV[K1] = "named"
pe = Program.env(K1)
if pe.nil?
  raise "ASSERTION FAILED: Program.env sees ENV write\n  expected \"named\"\n  got nil"
else
  assert_str "named", pe, "Program.env sees ENV write"
end

ENV[K1] = "a"
ENV[K2] = "b"
ENV[K3] = "c"
ENV.delete(K2)
assert_nil ENV[K2]?, "middle deleted"
assert_str "a", ENV[K1], "first survives middle delete"
assert_str "c", ENV[K3], "last survives middle delete"
ENV.delete(K1)
assert_nil ENV[K1]?, "first of remaining deleted"
assert_str "c", ENV[K3], "last survives first delete"
ENV.delete(K3)
assert_nil ENV[K3]?, "last deleted"
puts "  nil assignment, empty value, delete positions, and Program.env"

puts "\n== what was set outlives a collection"
# A new variable is a new table and an overwritten one a new entry, both
# the collector's memory, installed into the C runtime's `environ`, which
# the collector does not scan. The churn between the two collections reuses
# whatever the first one freed, so a table nothing held reads back as
# something else, or as a fault.
kept = "kept-" + "k" * 40
ENV[K2] = kept
path_was = ENV["PATH"]?
if path_was
  ENV["PATH"] = path_was + PREFIX
end
GC.collect
churn = [] of String
20000.times { |i| churn << "c" * 48 + i.to_s }
GC.collect
assert_str kept, ENV[K2], "a variable set before two collections"
assert_true ENV.keys.includes?(K2), "a variable set before two collections is enumerated"
if path_was
  assert_str path_was + PREFIX, ENV["PATH"], "an overwritten variable after two collections"
  ENV["PATH"] = path_was
end
ENV.delete(K2)
puts "  a variable set and one overwritten read back after two collections, #{churn.size} strings between"

puts "\n== a name the environment holds twice"
# `execve` hands a program whatever table it is given, the same name twice
# included, and `unsetenv` removes every entry of the name. The table is
# built here as the C runtime would hand it over: the environment as it is,
# then K3 twice. Deleting only the first brought the variable back with
# the second value. Windows' block holds a name once, and keeps no table.
{% if !flag?(:wasm32) && !flag?(:win32) %}
  was = __iyi_environ
  count = 0
  if was.address != 0_u64
    while was[count].address != 0_u64
      count = count + 1
    end
  end
  twice = Pointer(UInt8*).malloc((count + 3).to_u64)
  count.times { |i| twice[i] = was[i] }
  ["#{K3}=first", "#{K3}=second"].each_with_index do |text, i|
    entry = Pointer(UInt8).malloc((text.bytesize + 1).to_u64)
    entry.copy_from(text.to_unsafe, text.bytesize)
    entry[text.bytesize] = 0_u8
    twice[count + i] = entry
  end
  twice[count + 2] = Pointer(UInt8).new(0_u64)
  __iyi_set_environ(twice)
  assert_str "first", ENV[K3], "the first of two entries is the value"
  assert_str_nilable "first", ENV.delete(K3), "delete answers the first entry"
  assert_nil ENV[K3]?, "no entry of a deleted name is left"
  assert_true !ENV.has_key?(K3), "has_key? after deleting a name held twice"
  assert_true !ENV.keys.includes?(K3), "keys after deleting a name held twice"
  puts "  every entry of a name held twice is deleted"
{% else %}
  puts "  not measured: this platform keeps no environ table to hold it twice"
{% end %}

# Clean up all created variables
ENV.delete(K1)
ENV.delete(K2)
ENV.delete(K3)
assert_nil ENV[K1]?, "K1 cleaned up"
assert_nil ENV[K2]?, "K2 cleaned up"
assert_nil ENV[K3]?, "K3 cleaned up"

# Restore any pre-existing variables that were set prior to exercise
if orig_k1
  ENV[K1] = orig_k1
end
if orig_k2
  ENV[K2] = orig_k2
end
if orig_k3
  ENV[K3] = orig_k3
end
if orig_absent
  ENV[K_ABSENT] = orig_absent
end

puts "\nALL CHECKS PASSED"
