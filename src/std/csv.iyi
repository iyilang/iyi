# CSV, RFC 4180, written in iyi.
#
# `CSV.parse` reads a document into rows of fields. A field may be
# quoted; a quote inside a quoted field is doubled. The separator is
# a comma. Lines end at LF, CRLF or a lone CR, as in Crystal's. `CSV.build`
# writes the same contract: a field is quoted when it holds a comma, a
# quote or a line break, or is a row's only field and empty - written
# bare, that row was nothing. A quote without its pair is `unterminated
# quoted field`, and a UTF-16 document is refused by its byte order mark.

module std/csv

pub struct CSV
  def self.parse(text : String) : Array(Array(String))
    rows = [] of Array(String)
    row = [] of String
    n = text.bytesize
    src = text.to_unsafe
    i = 0
    field = Pointer(UInt8).malloc((n + 1).to_u64)
    flen = 0
    quoted = false
    # A field that opened a quote is a field even when empty: `""` alone was
    # no row at all, where Crystal reads `[[""]]`.
    opened = false
    # Past a byte order mark, which Excel writes into every "CSV UTF-8"
    # file: the first header field kept it, and `row[0] == "id"` was false.
    i = 3 if n >= 3 && src[0] == 0xEF_u8 && src[1] == 0xBB_u8 && src[2] == 0xBF_u8
    # UTF-16's, FF FE or FE FF - what Windows PowerShell 5.1's `Out-File`
    # and `>` write - was read as UTF-8: `"ÿþ\"Name\""` and every field
    # after it with a NUL between its letters, and no error.
    if n >= 2 && ((src[0] == 0xFF_u8 && src[1] == 0xFE_u8) || (src[0] == 0xFE_u8 && src[1] == 0xFF_u8))
      raise "CSV: the document is UTF-16, by its byte order mark, and is read as UTF-8"
    end
    while i < n
      b = src[i]
      if quoted
        if b == 34_u8 # "
          if i + 1 < n && src[i + 1] == 34_u8
            field[flen] = 34_u8
            flen = flen + 1
            i = i + 2
          else
            quoted = false
            i = i + 1
          end
        else
          field[flen] = b
          flen = flen + 1
          i = i + 1
        end
      else
        if b == 34_u8 && flen == 0
          quoted = true
          opened = true
          i = i + 1
        elsif b == 44_u8 # comma
          row << take(field, flen)
          flen = 0
          opened = false
          i = i + 1
        elsif b == 13_u8 && i + 1 < n && src[i + 1] == 10_u8
          i = i + 1
        elsif b == 10_u8 || b == 13_u8
          # A lone CR ends a row too: it was dropped, and `a\rb` read as `ab`.
          row << take(field, flen)
          flen = 0
          opened = false
          rows << row
          row = [] of String
          i = i + 1
        else
          field[flen] = b
          flen = flen + 1
          i = i + 1
        end
      end
    end
    raise "unterminated quoted field" if quoted
    if flen > 0 || opened || row.size > 0 || (n > 0 && src[n - 1] == 44_u8)
      row << take(field, flen)
      rows << row
    end
    rows
  end

  # Into one builder: adding each field to the text so far copied that
  # text once per field, and 20,000 rows of five took 12.8 seconds.
  def self.build(rows : Array(Array(String))) : String
    String.build do |io|
      r = 0
      while r < rows.size
        io << '\n' if r > 0
        fields = rows[r]
        if fields.size == 1 && fields[0].empty?
          io << "\"\""
          r = r + 1
          next
        end
        c = 0
        while c < fields.size
          io << ',' if c > 0
          io << escape(fields[c])
          c = c + 1
        end
        r = r + 1
      end
    end
  end

  private def self.take(field : Pointer(UInt8), flen : Int32) : String
    String.new(flen) { |dst| dst.copy_from(field, flen) }
  end

  private def self.escape(field : String) : String
    need = false
    p = field.to_unsafe
    n = field.bytesize
    i = 0
    while i < n
      b = p[i]
      if b == 44_u8 || b == 34_u8 || b == 10_u8 || b == 13_u8
        need = true
        break
      end
      i = i + 1
    end
    return field unless need
    extra = 2
    i = 0
    while i < n
      extra = extra + 1 if p[i] == 34_u8
      i = i + 1
    end
    String.new(n + extra) do |dst|
      dst[0] = 34_u8
      o = 1
      i = 0
      while i < n
        dst[o] = p[i]
        o = o + 1
        if p[i] == 34_u8
          dst[o] = 34_u8
          o = o + 1
        end
        i = i + 1
      end
      dst[o] = 34_u8
    end
  end
end
