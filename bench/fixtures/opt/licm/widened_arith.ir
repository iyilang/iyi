; iyi-ir 1
source_filename = "widened_arith"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @widened_arith(i1 %run, i32 %value, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %wide = zext i32 %value to i64
  %scaled = mul i64 %wide, 3
  store i64 %scaled, ptr %out, align 8
  br label %head
done:
  ret void
}
