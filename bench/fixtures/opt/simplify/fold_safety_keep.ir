; iyi-ir 1
source_filename = "fold_safety_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @signed_overflow() {
entry:
  %v = sdiv i32 -2147483648, -1
  ret i32 %v
}

define internal i32 @shift_out_of_range() {
entry:
  %v = shl i32 1, 32
  ret i32 %v
}

define internal i32 @flagged_add() {
entry:
  %v = add nsw i32 1, 2
  ret i32 %v
}

define internal i128 @wide_add() {
entry:
  %v = add i128 1, 2
  ret i128 %v
}
