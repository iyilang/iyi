  def self.pow(base : Float64, exp : Float64) : Float64
    ix = IyiFloatText.bits_of(base)
    iy = IyiFloatText.bits_of(exp)
    topx = ix.unsafe_shr(52_u64).to_i64
    topy = iy.unsafe_shr(52_u64).to_i64
    sign_bias = 0_u64
    ytop = topy & 0x7ff_i64
    if topx == 0_i64 || topx >= 0x7ff_i64 || ytop < 0x3be_i64 || ytop >= 0x43e_i64
      # x subnormal, zero, infinite, NaN or negative; or |y| < 2^-65,
      # |y| >= 2^63 or y NaN.
      if pow_zero_inf_nan?(iy)
        return 1.0 if iy &* 2_u64 == 0_u64
        return 1.0 if ix == 0x3ff0000000000000_u64
        return base + exp if ix &* 2_u64 > 0xffe0000000000000_u64 || iy &* 2_u64 > 0xffe0000000000000_u64
        return 1.0 if ix &* 2_u64 == 0x7fe0000000000000_u64
        return 0.0 if (ix &* 2_u64 < 0x7fe0000000000000_u64) == (iy.unsafe_shr(63_u64) == 0_u64)
        return exp * exp
      end
      if pow_zero_inf_nan?(ix)
        x2 = base * base
        x2 = x2 * -1.0 if ix.unsafe_shr(63_u64) != 0_u64 && pow_check_int(iy) == 1
        return iy.unsafe_shr(63_u64) != 0_u64 ? 1.0 / x2 : x2
      end
      # Finite, nonzero x and y from here.
      if ix.unsafe_shr(63_u64) != 0_u64
        yint = pow_check_int(iy)
        return (base - base) / (base - base) if yint == 0
        sign_bias = 0x40000_u64 if yint == 1
        ix = ix & 0x7fffffffffffffff_u64
        topx = topx & 0x7ff_i64
      end
      if ytop < 0x3be_i64 || ytop >= 0x43e_i64
        return 1.0 if ix == 0x3ff0000000000000_u64
        if ytop < 0x3be_i64
          # |y| < 2^-65: x^y ~= 1 + y log(x).
          return ix > 0x3ff0000000000000_u64 ? 1.0 + exp : 1.0 - exp
        end
        return (ix > 0x3ff0000000000000_u64) == (topy < 0x800_i64) ? 1.0 / 0.0 : 0.0
      end
      if topx == 0_i64
        # A subnormal x, normalised so that its exponent is negative.
        ix = IyiFloatText.bits_of(base * 4503599627370496.0) & 0x7fffffffffffffff_u64
        ix = ix &- 0x0340000000000000_u64
      end
    end
    hi, lo = pow_log(ix)
    yhi = IyiFloatText.from_bits(iy & 0xfffffffff8000000_u64)
    ylo = exp - yhi
    lhi = IyiFloatText.from_bits(IyiFloatText.bits_of(hi) & 0xfffffffff8000000_u64)
    llo = hi - lhi + lo
    ehi = yhi * lhi
    elo = ylo * lhi + exp * llo
    pow_exp(ehi, elo, sign_bias)
  end

  # 0, an infinity or NaN, from the bits: 2i - 1 wraps for either zero.
  private def self.pow_zero_inf_nan?(i : UInt64) : Bool
    (i &* 2_u64) &- 1_u64 >= 0xffe0000000000000_u64 &- 1_u64
  end

  # 0 when the finite, nonzero y is not an integer, 1 when it is odd, 2
  # when it is even.
  private def self.pow_check_int(iy : UInt64) : Int32
    e = (iy.unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    return 0 if e < 0x3ff_i64
    return 2 if e > 0x3ff_i64 + 52_i64
    bit = 1_u64.unsafe_shl((0x3ff_i64 + 52_i64 - e).to_u64)
    return 0 if iy & (bit &- 1_u64) != 0_u64
    return 1 if iy & bit != 0_u64
    2
  end

  # log(x) for the bits `ix` of a positive normal x (or a subnormal one
  # normalised with its exponent below zero), as a double and a tail with
  # about 15 more bits.
  private def self.pow_log(ix : UInt64) : {Float64, Float64}
    tmp = ix &- 0x3fe6955500000000_u64
    i = (tmp.unsafe_shr(45_u64) & 127_u64).to_i32
    k = tmp.unsafe_to_i64 >> 52
    iz = ix &- (tmp & 0xfff0000000000000_u64)
    z = IyiFloatText.from_bits(iz)
    kd = k.to_f64
    table = POW_LOG_TAB.to_unsafe
    invc = IyiFloatText.from_bits(table[i * 3])
    logc = IyiFloatText.from_bits(table[i * 3 + 1])
    logctail = IyiFloatText.from_bits(table[i * 3 + 2])
    # z split so that rhi, rlo and rhi * rhi are exact.
    zhi = IyiFloatText.from_bits((iz &+ 0x80000000_u64) & 0xffffffff00000000_u64)
    zlo = z - zhi
    rhi = zhi * invc - 1.0
    rlo = zlo * invc
    r = rhi + rlo
    t1 = kd * POW_LN2HI + logc
    t2 = t1 + r
    lo1 = kd * POW_LN2LO + logctail
    lo2 = t1 - t2 + r
    ar = POW_A0 * r
    ar2 = r * ar
    ar3 = r * ar2
    arhi = POW_A0 * rhi
    arhi2 = rhi * arhi
    hi = t2 + arhi2
    lo3 = rlo * (ar + arhi)
    lo4 = t2 - hi + arhi2
    p = ar3 * (POW_A1 + r * POW_A2 + ar2 * (POW_A3 + r * POW_A4 + ar2 * (POW_A5 + r * POW_A6)))
    lo = lo1 + lo2 + lo3 + lo4 + p
    y = hi + lo
    {y, hi - y + lo}
  end

  # sign * exp(x + tail), `exp` with the tail folded in and the sign
  # carried in the scale's bits.
  private def self.pow_exp(x : Float64, tail_in : Float64, sign_bias : UInt64) : Float64
    abstop = (IyiFloatText.bits_of(x).unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    if abstop < 0x3c9_i64 || abstop >= 0x408_i64
      if abstop < 0x3c9_i64
        one = 1.0 + x
        return sign_bias != 0_u64 ? one * -1.0 : one
      end
      if abstop >= 0x409_i64
        negative = sign_bias != 0_u64
        if IyiFloatText.bits_of(x).unsafe_shr(63_u64) != 0_u64
          return negative ? -0.0 : 0.0
        end
        return negative ? (1.0 / 0.0) * -1.0 : 1.0 / 0.0
      end
      abstop = 0_i64
    end
    z = EXP_INVLN2N * x
    kd = z + EXP_SHIFT
    ki = IyiFloatText.bits_of(kd)
    kd = kd - EXP_SHIFT
    r = x + kd * EXP_NEGLN2HI + kd * EXP_NEGLN2LO
    r = r + tail_in
    table = EXP_TAB.to_unsafe
    idx = ((ki & 127_u64) &* 2_u64).to_i32
    top = (ki &+ sign_bias).unsafe_shl(45_u64)
    tail = IyiFloatText.from_bits(table[idx])
    sbits = table[idx + 1] &+ top
    r2 = r * r
    tmp = tail + r + r2 * (EXP_C2 + r * EXP_C3) + r2 * r2 * (EXP_C4 + r * EXP_C5)
    return pow_special(tmp, sbits, ki) if abstop == 0_i64
    scale = IyiFloatText.from_bits(sbits)
    scale + scale * tmp
  end

  # `exp_special` for pow: the scale may be negative, and a zero keeps its
  # sign.
  private def self.pow_special(tmp : Float64, sbits : UInt64, ki : UInt64) : Float64
    if ki & 0x80000000_u64 == 0_u64
      scale = IyiFloatText.from_bits(sbits &- 0x3f10000000000000_u64)
      return (scale + scale * tmp) * 5.486124068793689e+303
    end
    sbits = sbits &+ 0x3fe0000000000000_u64
    scale = IyiFloatText.from_bits(sbits)
    y = scale + scale * tmp
    if y.abs < 1.0
      one = y < 0.0 ? -1.0 : 1.0
      lo = scale - y + scale * tmp
      hi = one + y
      lo = one - hi + y + lo
      y = (hi + lo) - one
      y = IyiFloatText.from_bits(sbits & 0x8000000000000000_u64) if y == 0.0
    end
    2.2250738585072014e-308 * y
  end

  def self.pow(base : Float32, exp : Float32) : Float32
    pow(base.to_f64, exp.to_f64).to_f32
  end

  def self.pow(base : T, exp : U) : Float64 forall T, U
    pow(base.to_f64, exp.to_f64)
  end

  def self.copysign(mag : Float64, sgn : Float64) : Float64
    LibLLVMMath.copysign_f64(mag, sgn)
  end

  def self.copysign(mag : Float32, sgn : Float32) : Float32
    LibLLVMMath.copysign_f32(mag, sgn)
  end

  # a * b + c rounded once, as IEEE 754 defines it and as the other
  # library's `Math.fma` answers through libm. The instruction where the
  # processor has one: every aarch64 processor (`fmadd`, LLVM's intrinsic),
  # and an x86_64 one with FMA3 and an operating system that saves its
  # registers, asked once by `cpuid` and `xgetbv` as `Float64#floor` asks
  # for `roundsd`. Elsewhere musl's `fma` (MIT; Copyright 2005-2020 Rich
  # Felker, et al.), in iyi: the significands as integers, their product's
  # 128 bits exact, the sum aligned with a sticky bit, one rounding at the
  # conversion back. This was Dekker's product and two more additions,
  # which round each, and answered the neighbour of the fused result for
  # arguments that cancel.
  def self.fma(a : Float64, b : Float64, c : Float64) : Float64
    {% if flag?(:aarch64) %}
      LibLLVMMath.fma_f64(a, b, c)
    {% else %}
      {% if flag?(:x86_64) %}
        if fuses?
          fused = uninitialized Float64
          asm("vfmadd213sd $3, $2, $0" : "=x"(fused) : "0"(a), "x"(b), "x"(c))
          return fused
        end
      {% end %}
      soft_fma(a, b, c)
    {% end %}
  end

  # The single's: the instruction where there is one, and otherwise
  # musl's `fmaf` - the product of two singles is exact in a double and
  # the sum rounds once there, which is right unless that double sits on
  # a single's halfway point or among the subnormals; then the sum's
  # rounding error, which is exact, sends it to the odd neighbour, which
  # the conversion to a single cannot then misround.
  def self.fma(a : Float32, b : Float32, c : Float32) : Float32
    {% if flag?(:aarch64) %}
      LibLLVMMath.fma_f32(a, b, c)
    {% else %}
      {% if flag?(:x86_64) %}
        if fuses?
          fused = uninitialized Float32
          asm("vfmadd213ss $3, $2, $0" : "=x"(fused) : "0"(a), "x"(b), "x"(c))
          return fused
        end
      {% end %}
      soft_fmaf(a, b, c)
    {% end %}
  end

  {% if flag?(:x86_64) %}
    # 0 not asked yet, 1 the processor fuses, 2 it does not.
    @@fuses : Int32 = 0

    # FMA3 (leaf 1, ECX bit 12) and AVX's registers saved by the operating
    # system: OSXSAVE (bit 27), AVX (bit 28), and XCR0's SSE and AVX state
    # both on. An instruction the processor has and the system does not
    # save is an invalid-opcode fault.
    private def self.fuses? : Bool
      fuses = @@fuses
      if fuses == 0
        leaf = uninitialized UInt64
        features = uninitialized UInt64
        asm("cpuid" : "={rax}"(leaf), "={rcx}"(features)
                    : "{rax}"(1_u64), "{rcx}"(0_u64)
                    : "rbx", "rdx")
        wanted = 0x18001000_u64
        fuses = 2
        if features & wanted == wanted
          low = uninitialized UInt64
          high = uninitialized UInt64
          asm("xgetbv" : "={rax}"(low), "={rdx}"(high) : "{rcx}"(0_u64))
          fuses = 1 if low & 6_u64 == 6_u64
        end
        @@fuses = fuses
      end
      fuses == 1
    end
  {% end %}

  # An exponent that stands for zero, an infinity or NaN once `fma_parts`
  # has taken the bias and the significand's width off it.
  private FMA_SPECIAL = 0x7ff - 0x3ff - 52 - 1

  # musl's `normalize`: the significand with its hidden bit, shifted left
  # one so the product has room, the exponent that goes with it, and the
  # sign. A subnormal is scaled into the normal range first; a zero comes
  # out one past FMA_SPECIAL, an infinity or NaN at it.
  private def self.fma_parts(x : Float64) : {UInt64, Int32, Bool}
    ix = IyiFloatText.bits_of(x)
    e = ix.unsafe_shr(52_u64).unsafe_to_i32
    sign = e & 0x800 != 0
    e = e & 0x7ff
    if e == 0
      ix = IyiFloatText.bits_of(x * 9223372036854775808.0)
      e = (ix.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
      e = e != 0 ? e - 63 : 0x800
    end
    ix = ((ix & 0xfffffffffffff_u64) | 0x10000000000000_u64).unsafe_shl(1_u64)
    {ix, e - (0x3ff + 52 + 1), sign}
  end

  # The 128-bit product of two significands of 54 bits, as its high and
  # low words, from 32-bit halves: the middle sum cannot carry out.
  private def self.fma_wide(x : UInt64, y : UInt64) : {UInt64, UInt64}
    xlo = x & 0xffffffff_u64
    xhi = x.unsafe_shr(32_u64)
    ylo = y & 0xffffffff_u64
    yhi = y.unsafe_shr(32_u64)
    t1 = xlo &* ylo
    t2 = xlo &* yhi &+ xhi &* ylo
    t3 = xhi &* yhi
    lo = t1 &+ t2.unsafe_shl(32_u64)
    {t3 &+ t2.unsafe_shr(32_u64) &+ (t1 > lo ? 1_u64 : 0_u64), lo}
  end

  # Whether any of the bits a shift would drop is set: the sticky bit.
  private def self.fma_sticky(bits : UInt64) : UInt64
    bits != 0_u64 ? 1_u64 : 0_u64
  end

  private def self.soft_fma(x : Float64, y : Float64, z : Float64) : Float64
    mx, ex, sx = fma_parts(x)
    my, ey, sy = fma_parts(y)
    mz, ez, sz = fma_parts(z)
    return x * y + z if ex >= FMA_SPECIAL || ey >= FMA_SPECIAL
    if ez >= FMA_SPECIAL
      return x * y if ez > FMA_SPECIAL
      return z
    end
    rhi, rlo = fma_wide(mx, my)
    # The exponents aligned: z shifted up by as much of the gap as keeps
    # it in 128 bits, the product down by the rest with a sticky bit.
    e = ex + ey
    d = ez - e
    zhi = 0_u64
    zlo = 0_u64
    if d > 0
      if d < 64
        zlo = mz.unsafe_shl(d.to_u64)
        zhi = mz.unsafe_shr((64 - d).to_u64)
      else
        zhi = mz
        e = ez - 64
        d = d - 64
        if d >= 64
          rlo = 1_u64
          rhi = 0_u64
        elsif d > 0
          rlo = rhi.unsafe_shl((64 - d).to_u64) | rlo.unsafe_shr(d.to_u64) | fma_sticky(rlo.unsafe_shl((64 - d).to_u64))
          rhi = rhi.unsafe_shr(d.to_u64)
        end
      end
    else
      d = 0 - d
      if d == 0
        zlo = mz
      elsif d < 64
        zlo = mz.unsafe_shr(d.to_u64) | fma_sticky(mz.unsafe_shl((64 - d).to_u64))
      else
        zlo = 1_u64
      end
    end
    sign = sx != sy
    nonzero = true
    if sign == sz
      rlo = rlo &+ zlo
      rhi = rhi &+ zhi &+ (rlo < zlo ? 1_u64 : 0_u64)
    else
      before = rlo
      rlo = rlo &- zlo
      rhi = rhi &- zhi &- (before < rlo ? 1_u64 : 0_u64)
      if rhi.unsafe_shr(63_u64) != 0_u64
        rlo = 0_u64 &- rlo
        rhi = 0_u64 &- rhi &- fma_sticky(rlo)
        sign = !sign
      end
      nonzero = rhi != 0_u64
    end
    # The top 63 bits of the sum in rhi, its last bit sticky.
    if nonzero
      e = e + 64
      d = rhi.leading_zeros_count - 1
      rhi = rhi.unsafe_shl(d.to_u64) | rlo.unsafe_shr((64 - d).to_u64) | fma_sticky(rlo.unsafe_shl(d.to_u64))
    elsif rlo != 0_u64
      d = rlo.leading_zeros_count - 1
      rhi = d < 0 ? rlo.unsafe_shr(1_u64) | (rlo & 1_u64) : rlo.unsafe_shl(d.to_u64)
    else
      # An exact zero, whose sign is the product's and z's to settle.
      return x * y + z
    end
    e = e - d
    i = rhi.unsafe_to_i64
    i = 0_i64 &- i if sign
    r = i.to_f64
    if e < -1022 - 62
      # Subnormal before rounding: the conversion must be the only
      # rounding, so the bits the scaling would drop are folded into one.
      if e == -1022 - 63
        top = sign ? -9223372036854775808.0 : 9223372036854775808.0
        return sign ? -2.2250738585072014e-308 : 2.2250738585072014e-308 if r == top
        if rhi.unsafe_shl(53_u64) != 0_u64
          i = (rhi.unsafe_shr(1_u64) | (rhi & 1_u64) | 0x4000000000000000_u64).unsafe_to_i64
          i = 0_i64 &- i if sign
          r = 2.0 * i.to_f64 - top
        end
      else
        i = (rhi.unsafe_shr(10_u64) | fma_sticky(rhi.unsafe_shl(54_u64))).unsafe_shl(10_u64).unsafe_to_i64
        i = 0_i64 &- i if sign
        r = i.to_f64
      end
    end
    ldexp(r, e)
  end

  private def self.soft_fmaf(x : Float32, y : Float32, z : Float32) : Float32
    xy = x.to_f64 * y.to_f64
    wide = z.to_f64
    r = xy + wide
    bits = IyiFloatText.bits_of(r)
    e = bits.unsafe_shr(52_u64) & 0x7ff_u64
    halfway = bits & 0x1fffffff_u64 == 0x10000000_u64
    tiny = e <= 0x3ff_u64 - 126_u64 && e >= 0x3ff_u64 - 149_u64
    return r.to_f32 if !halfway && !tiny
    if e != 0x7ff_u64
      s = bits.unsafe_shr(63_u64)
      t = (s == 1_u64) == (xy < wide) ? xy - r + wide : wide - r + xy
      if t != 0.0
        bits = bits &- (s ^ (t < 0.0 ? 1_u64 : 0_u64))
        bits = bits | 1_u64
      end
    end
    IyiFloatText.from_bits(bits).to_f32
  end

  # The rounding error of `p = a * b`: the exact product is `p + err`.
  # Veltkamp's split at 2^27 + 1, Dekker's product; a factor past 2^996
  # would overflow the split, so it is brought down by 2^-64 and the
  # error taken back up.
  private def self.prod_err(a : Float64, b : Float64, p : Float64) : Float64
    return 0.0 if p != p || p == 2.0 * p || p == 0.0
    scale = 1.0
    if a.abs > 6.7e299 || b.abs > 6.7e299
      a = a * 5.421010862427522e-20
      b = b * 5.421010862427522e-20
      p = p * 5.421010862427522e-20 * 5.421010862427522e-20
      scale = 1.8446744073709552e19 * 1.8446744073709552e19
    end
    ta = a * 134217729.0
    ah = ta - (ta - a)
    al = a - ah
    tb = b * 134217729.0
    bh = tb - (tb - b)
    bl = b - bh
    (((ah * bh - p) + ah * bl + al * bh) + al * bl) * scale
  end

  # The smaller, with the number when one side is NaN, and -0.0 over 0.0.
  def self.min(a : Float64, b : Float64) : Float64
    return b if a != a
    return a if b != b
    return a if a < b
    return b if b < a
    copysign(1.0, a) < 0.0 ? a : b
  end

  def self.min(a : Float32, b : Float32) : Float32
    return b if a != a
    return a if b != b
    return a if a < b
    return b if b < a
    copysign(1.0_f32, a) < 0.0_f32 ? a : b
  end

  # The larger, with the number when one side is NaN, and 0.0 over -0.0.
  def self.max(a : Float64, b : Float64) : Float64
    return b if a != a
    return a if b != b
    return a if a > b
    return b if b > a
    copysign(1.0, a) < 0.0 ? b : a
  end

  def self.max(a : Float32, b : Float32) : Float32
    return b if a != a
    return a if b != b
    return a if a > b
    return b if b > a
    copysign(1.0_f32, a) < 0.0_f32 ? b : a
  end

  # atan of a value in [0, 1]: the angle is halved until it is small, then
  # a series, then doubled back.
  private def self.atan_unit(val : Float64) : Float64
    reductions = 0
    while val > 0.125
      val = val / (1.0 + sqrt(1.0 + val * val))
      reductions = reductions + 1
    end

    v2 = val * val
    s = 1.0 / 19.0
    s = s * v2 - 1.0 / 17.0
    s = s * v2 + 1.0 / 15.0
    s = s * v2 - 1.0 / 13.0
    s = s * v2 + 1.0 / 11.0
    s = s * v2 - 1.0 / 9.0
    s = s * v2 + 1.0 / 7.0
    s = s * v2 - 1.0 / 5.0
    s = s * v2 + 1.0 / 3.0
    res = val - v2 * val * s

    while reductions > 0
      res = res * 2.0
      reductions = reductions - 1
    end
    res
  end

  def self.atan(value : Float64) : Float64
    return value if value == 0.0 || value != value
    val = value.abs
    res = val > 1.0 ? HALF_PI - atan_unit(1.0 / val) : atan_unit(val)
    value < 0.0 ? 0.0 - res : res
  end

  def self.atan(value : Float32) : Float32
    atan(value.to_f64).to_f32
  end

  def self.atan(value : T) : Float64 forall T
    atan(value.to_f64)
  end

  # The angle of (x, y), with the zeros' and infinities' signs read the
  # way C's atan2 reads them: atan2(0.0, -0.0) is pi, atan2(-0.0, -1.0) is
  # -pi, atan2(inf, inf) is pi/4.
  def self.atan2(y : Float64, x : Float64) : Float64
    return 0.0 / 0.0 if x != x || y != y
    y_neg = copysign(1.0, y) < 0.0
    x_neg = copysign(1.0, x) < 0.0
    if y == 0.0
      return x_neg ? copysign(PI, y) : y
    end
    if x == 0.0
      return copysign(HALF_PI, y)
    end
    if y == 2.0 * y
      if x == 2.0 * x
        return copysign(x_neg ? 3.0 * QUARTER_PI : QUARTER_PI, y)
      end
      return copysign(HALF_PI, y)
    end
    if x == 2.0 * x
      return x_neg ? copysign(PI, y) : copysign(0.0, y)
    end
    return atan(y / x) if x > 0.0
    y_neg ? atan(y / x) - PI : atan(y / x) + PI
  end

  def self.atan2(y : Float32, x : Float32) : Float32
    atan2(y.to_f64, x.to_f64).to_f32
  end

  def self.atan2(y : T, x : U) : Float64 forall T, U
    atan2(y.to_f64, x.to_f64)
  end

  def self.asin(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value.abs > 1.0
    return value if value == 0.0
    return copysign(HALF_PI, value) if value.abs == 1.0
    atan2(value, sqrt((1.0 - value) * (1.0 + value)))
  end

  def self.asin(value : Float32) : Float32
    asin(value.to_f64).to_f32
  end

  def self.asin(value : T) : Float64 forall T
    asin(value.to_f64)
  end

  def self.acos(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value.abs > 1.0
    return 0.0 if value == 1.0
    return PI if value == -1.0
    2.0 * atan(sqrt((1.0 - value) / (1.0 + value)))
  end

  def self.acos(value : Float32) : Float32
    acos(value.to_f64).to_f32
  end

  def self.acos(value : T) : Float64 forall T
    acos(value.to_f64)
  end

  # sinh, cosh and tanh as glibc 2.43 computes them - fdlibm's
  # `e_sinh.c`, `e_cosh.c` and `s_tanh.c` (Sun's notice is at `expm1`), on
  # the `exp` and `expm1` above, which are glibc's to the last bit, so
  # these are too. Their branches are fdlibm's, at its thresholds, read off
  # the high word: a series near zero and `half_exp` past 709 answered
  # differently in the last bit for 952 arguments of sinh in 100,000, 217
  # of cosh and 4,863 of tanh.
  def self.sinh(value : Float64) : Float64
    ix = high_word(value) & 0x7fffffff_i64
    return value + value if ix >= 0x7ff00000_i64
    h = IyiFloatText.bits_of(value).unsafe_shr(63_u64) != 0_u64 ? -0.5 : 0.5
    v = value.abs
    if ix < 0x40360000_i64
      # |x| < 2^-28: sinh(x) is x.
      return value if ix < 0x3e300000_i64
      t = expm1(v)
      return h * (2.0 * t - t * t / (t + 1.0)) if ix < 0x3ff00000_i64
      return h * (t + t / (t + 1.0))
    end
    return h * exp(v) if ix < 0x40862e42_i64
    # Up to the overflow threshold, exp of half and the product.
    if IyiFloatText.bits_of(v) <= 0x408633ce8fb9f87d_u64
      w = exp(0.5 * v)
      t = h * w
      return t * w
    end
    value * 1.0e307
  end

  def self.sinh(value : Float32) : Float32
    sinh(value.to_f64).to_f32
  end

  def self.sinh(value : T) : Float64 forall T
    sinh(value.to_f64)
  end

  def self.cosh(value : Float64) : Float64
    ix = high_word(value) & 0x7fffffff_i64
    v = value.abs
    if ix < 0x40360000_i64
      if ix < 0x3fd62e43_i64
        # |x| < 0.5 ln 2: 1 + expm1(|x|)^2 / (2 exp(|x|)), and 1 below 2^-55.
        return 1.0 if ix < 0x3c800000_i64
        t = expm1(v)
        w = 1.0 + t
        return 1.0 + (t * t) / (w + w)
      end
      t = exp(v)
      return 0.5 * t + 0.5 / t
    end
    return 0.5 * exp(v) if ix < 0x40862e42_i64
    if IyiFloatText.bits_of(v) <= 0x408633ce8fb9f87d_u64
      w = exp(0.5 * v)
      t = 0.5 * w
      return t * w
    end
    return value * value if ix >= 0x7ff00000_i64
    1.0e300 * 1.0e300
  end

  def self.cosh(value : Float32) : Float32
    cosh(value.to_f64).to_f32
  end

  def self.cosh(value : T) : Float64 forall T
    cosh(value.to_f64)
  end

  def self.tanh(value : Float64) : Float64
    bits = IyiFloatText.bits_of(value)
    negative = bits.unsafe_shr(63_u64) != 0_u64
    ix = high_word(value) & 0x7fffffff_i64
    if ix >= 0x7ff00000_i64
      # tanh(+-inf) is +-1, and NaN stays NaN.
      return negative ? 1.0 / value - 1.0 : 1.0 / value + 1.0
    end
    z = 1.0
    if ix < 0x40360000_i64
      return value if bits & 0x7fffffffffffffff_u64 == 0_u64
      return value * (1.0 + value) if ix < 0x3c800000_i64
      v = value.abs
      if ix >= 0x3ff00000_i64
        t = expm1(2.0 * v)
        z = 1.0 - 2.0 / (t + 2.0)
      else
        t = expm1(-2.0 * v)
        z = (t * -1.0) / (t + 2.0)
      end
    end
    negative ? z * -1.0 : z
  end

  def self.tanh(value : Float32) : Float32
    tanh(value.to_f64).to_f32
  end

  def self.tanh(value : T) : Float64 forall T
    tanh(value.to_f64)
  end

  def self.asinh(value : Float64) : Float64
    return value if value == 0.0 || value != value || value == 2.0 * value
    v = value.abs
    res = 0.0
    if v < 1.0e-4
      v2 = v * v
      res = v - v * v2 * (1.0 / 6.0 - v2 * (3.0 / 40.0 - v2 * (5.0 / 112.0)))
    elsif v > 1.0e8
      res = log(v) + LOG2
    else
      res = log1p(v + v * v / (1.0 + sqrt(1.0 + v * v)))
    end
    value < 0.0 ? 0.0 - res : res
  end

  def self.asinh(value : Float32) : Float32
    asinh(value.to_f64).to_f32
  end

  def self.asinh(value : T) : Float64 forall T
    asinh(value.to_f64)
  end

  def self.acosh(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value < 1.0
    return 0.0 if value == 1.0
    return value if value == 2.0 * value
    return log(value) + LOG2 if value > 1.0e8
    t = value - 1.0
    log1p(t + sqrt(t * (t + 2.0)))
  end

  def self.acosh(value : Float32) : Float32
    acosh(value.to_f64).to_f32
  end

  def self.acosh(value : T) : Float64 forall T
    acosh(value.to_f64)
  end

  def self.atanh(value : Float64) : Float64
    return value if value == 0.0 || value != value
    v = value.abs
    return 0.0 / 0.0 if v > 1.0
    res = 0.0
    if v == 1.0
      res = 1.0 / 0.0
    elsif v < 1.0e-4
      v2 = v * v
      res = v + v * v2 * (1.0 / 3.0 + v2 * (1.0 / 5.0 + v2 * (1.0 / 7.0)))
    else
      res = 0.5 * log1p(2.0 * v / (1.0 - v))
    end
    value < 0.0 ? 0.0 - res : res
  end

  def self.atanh(value : Float32) : Float32
    atanh(value.to_f64).to_f32
  end

  def self.atanh(value : T) : Float64 forall T
    atanh(value.to_f64)
  end

  # sqrt(x^2 + y^2) scaled by the larger magnitude, so that neither square
  # overflows or underflows on its own.
  def self.hypot(x : Float64, y : Float64) : Float64
    a = x.abs
    b = y.abs
    return 1.0 / 0.0 if a == 2.0 * a && a > 0.0 || b == 2.0 * b && b > 0.0
    return 0.0 / 0.0 if a != a || b != b
    if b > a
      t = a
      a = b
      b = t
    end
    return a if b == 0.0
    r = b / a
    a * sqrt(1.0 + r * r)
  end

  def self.hypot(x : Float32, y : Float32) : Float32
    hypot(x.to_f64, y.to_f64).to_f32
  end

  def self.hypot(x : T, y : U) : Float64 forall T, U
    hypot(x.to_f64, y.to_f64)
  end

  private EXP_MASK  = 0x7FF0000000000000_u64
  private REST_MASK = 0x800FFFFFFFFFFFFF_u64
  private TWO_54    =    18014398509481984.0

  # value * 2^exponent, with one rounding: the exponent field is rewritten
  # outright, and a result that lands among the subnormals is scaled down
  # from a normal one in a single step.
  def self.ldexp(value : Float64, exponent : Int32) : Float64
    return value if value == 0.0 || exponent == 0 || value != value || value == 2.0 * value
    m, e = frexp(value)
    step = exponent > 2200 ? 2200 : (exponent < -2200 ? -2200 : exponent)
    e = e + step
    return copysign(1.0 / 0.0, value) if e > 1024
    return copysign(0.0, value) if e < -1075
    rest = IyiFloatText.bits_of(m) & REST_MASK
    if e >= -1021
      IyiFloatText.from_bits(rest | (e + 1022).to_i64.to_u64.unsafe_shl(52_u64))
    else
      IyiFloatText.from_bits(rest | (e + 1076).to_i64.to_u64.unsafe_shl(52_u64)) / TWO_54
    end
  end

  # value as m * 2^e with m in [0.5, 1) (or 0, NaN or an infinity as it
  # came, with 0), read from the bits: a subnormal is first scaled up by
  # 2^54 so that it has an exponent field of its own.
  def self.frexp(value : Float64) : {Float64, Int32}
    return {value, 0} if value == 0.0 || value != value || value == 2.0 * value
    bits = IyiFloatText.bits_of(value)
    adjust = 0
    if (bits & EXP_MASK) == 0_u64
      bits = IyiFloatText.bits_of(value * TWO_54)
      adjust = -54
    end
    biased = (bits & EXP_MASK).unsafe_shr(52_u64).to_i64.to_i32
    m = IyiFloatText.from_bits((bits & REST_MASK) | 0x3FE0000000000000_u64)
    {m, biased - 1022 + adjust}
  end

  private TWO_OVER_SQRT_PI = 1.12837916709551257390
  private ONE_OVER_SQRT_PI = 0.56418958354775628695

  # exp(-x^2) with x^2 taken to double precision and a half, so the
  # rounding of the square does not reach the answer for large x.
  private def self.exp_neg_square(x : Float64) : Float64
    x2 = x * x
    x2e = prod_err(x, x, x2)
    exp(0.0 - x2) * (1.0 - x2e)
  end

  # erfc(x) for x >= 1 by its continued fraction (Lentz's evaluation).
  private def self.erfc_fraction(x : Float64) : Float64
    f = x
    c = x
    d = 0.0
    n = 1
    while n <= 1000
      a = n.to_f64 * 0.5
      d = x + a * d
      d = 1.0e-300 if d == 0.0
      c = x + a / c
      c = 1.0e-300 if c == 0.0
      d = 1.0 / d
      delta = c * d
      f = f * delta
      break if (delta - 1.0).abs < 1.0e-16
      n = n + 1
    end
    exp_neg_square(x) * ONE_OVER_SQRT_PI / f
  end

  # The error function: an alternating series below 1, a series of
  # positive terms times exp(-x^2) up to 2.5, and 1 - erfc past it.
  def self.erf(value : Float64) : Float64
    return value if value == 0.0 || value != value
    x = value.abs
    res = 0.0
    if x < 1.0
      x2 = x * x
      term = x
      sum = x
      n = 1
      while true
        term = 0.0 - term * x2 / n.to_f64
        t = term / (2 * n + 1).to_f64
        sum = sum + t
        break if t.abs < 1.0e-17 * sum
        n = n + 1
      end
      res = TWO_OVER_SQRT_PI * sum
    elsif x < 2.5
      x2 = x * x
      term = x
      sum = x
      n = 1
      while true
        term = term * 2.0 * x2 / (2 * n + 1).to_f64
        sum = sum + term
        break if term < 1.0e-17 * sum
        n = n + 1
      end
      res = TWO_OVER_SQRT_PI * exp_neg_square(x) * sum
    elsif x < 6.0
      res = 1.0 - erfc_fraction(x)
    else
      res = 1.0
    end
    value < 0.0 ? 0.0 - res : res
  end

  # 1 - erf(value), kept accurate where erf is close to 1: from 1 up it is
  # the continued fraction, and erfc(10) is 2.09e-45 rather than 0.
  def self.erfc(value : Float64) : Float64
    return 0.0 / 0.0 if value != value
    return 2.0 - erfc(0.0 - value) if value < 0.0
    return 1.0 - erf(value) if value < 1.0
    return 0.0 if value > 27.5
    erfc_fraction(value)
  end

  def self.gamma(value : Float64) : Float64
    tgamma(value)
  end

  private HALF_LOG_TAU = 0.91893853320467274178

  # log|gamma(value)|: Stirling's series from 15 up, the logarithm of
  # gamma below it, and the reflection formula for negative arguments; the
  # poles at the non-positive whole numbers answer +infinity.
  def self.lgamma(value : Float64) : Float64
    return value if value != value
    return 1.0 / 0.0 if value == 2.0 * value
    return 1.0 / 0.0 if value <= 0.0 && value == value.floor
    if value < 0.0
      s = sin(PI * value).abs
      return log(PI / s) - lgamma(1.0 - value)
    end
    return log(tgamma(value).abs) if value < 15.0
    v = value
    iv = 1.0 / v
    iv2 = iv * iv
    series = iv * (1.0 / 12.0 - iv2 * (1.0 / 360.0 - iv2 * (1.0 / 1260.0 - iv2 * (1.0 / 1680.0 - iv2 * (1.0 / 1188.0 - iv2 * (691.0 / 360360.0))))))
    (v - 0.5) * log(v) - v + HALF_LOG_TAU + series
  end

  # gamma: a whole argument up to 171 is its factorial, taken exactly as
  # far as the double allows; the poles answer NaN, past 171.62 the answer
  # is infinite, and the rest is Lanczos's approximation with Godfrey's
  # g = 607/128 and fifteen terms (good to a few 1e-16), reflected for
  # arguments below a half.
  def self.tgamma(value : Float64) : Float64
    return value if value != value
    return value if value == 2.0 * value && value > 0.0
    return 0.0 / 0.0 if value == 2.0 * value
    return 0.0 / 0.0 if value <= 0.0 && value == value.floor
    return 1.0 / 0.0 if value > 171.7
    if value == value.floor
      res = 1.0
      k = 2.0
      while k < value
        res = res * k
        k = k + 1.0
      end
      return res
    end
    if value < 0.5
      PI / (sin(PI * value) * tgamma(1.0 - value))
    else
      v = value
      ser = 0.99999999999999709182
      ser = ser + 57.156235665862923517 / (v + 1.0)
      ser = ser - 59.597960355475491248 / (v + 2.0)
      ser = ser + 14.136097974741747174 / (v + 3.0)
      ser = ser - 0.49191381609762019978 / (v + 4.0)
      ser = ser + 0.33994649984811888699e-4 / (v + 5.0)
      ser = ser + 0.46523628927048575665e-4 / (v + 6.0)
      ser = ser - 0.98374475304879564677e-4 / (v + 7.0)
      ser = ser + 0.15808870322491248884e-3 / (v + 8.0)
      ser = ser - 0.21026444172410488319e-3 / (v + 9.0)
      ser = ser + 0.21743961811521264320e-3 / (v + 10.0)
      ser = ser - 0.16431810653676389022e-3 / (v + 11.0)
      ser = ser + 0.84418223983852743293e-4 / (v + 12.0)
      ser = ser - 0.26190838401581408670e-4 / (v + 13.0)
      ser = ser + 0.36899182659531622704e-5 / (v + 14.0)
      t = v + 5.2421875
      # t^(v + 0.5) alone overflows before gamma does; the halves do not.
      half = pow(t, 0.5 * (v + 0.5)) * exp(-0.5 * t)
      sqrt(TAU) * ser / v * half * half
    end
  end

  def self.besselj0(value : Float64) : Float64
    # Series expansion for small/medium values
    x = value.abs
    if x < 5.0
      term = 1.0
      sum = 1.0
      k = 1
      while k <= 25
        term = term * (0.0 - x * x / (4.0 * k.to_f64 * k.to_f64))
        sum = sum + term
        break if term.abs < 1.0e-15
        k = k + 1
      end
      sum
    else
      # Asymptotic expansion
      sqrt(2.0 / (PI * x)) * cos(x - PI / 4.0)
    end
  end

  def self.besselj1(value : Float64) : Float64
    x = value.abs
    if x < 5.0
      term = x / 2.0
      sum = term
      k = 1
      while k <= 25
        term = term * (0.0 - x * x / (4.0 * k.to_f64 * (k.to_f64 + 1.0)))
        sum = sum + term
        break if term.abs < 1.0e-15
        k = k + 1
      end
      value < 0.0 ? 0.0 - sum : sum
    else
      res = sqrt(2.0 / (PI * x)) * cos(x - 3.0 * PI / 4.0)
      value < 0.0 ? 0.0 - res : res
    end
  end

  # Euclid on the non-positive side, where every magnitude fits, the
  # type's minimum included: gcd(-2147483648, 6) is 2. Only gcd(minimum,
  # 0), whose answer does not fit, overflows.
  def self.gcd(a : ::Int, b : ::Int) : ::Int
    x = a > 0 ? -a : a
    y = b > 0 ? -b : b
    while y != 0
      t = y
      y = x % y
      x = t
    end
    -x
  end

  def self.lcm(a : ::Int, b : ::Int) : ::Int
    return (a - a) if a == 0 || b == 0
    (a.abs // gcd(a, b)) * b.abs
  end
end
