# The handshake timeout the deadline checks give the server, and the
# most a handshake under it may take before the check calls it held past
# its deadline: the margin is the scheduler's and the loopback's, not
# the order's, which never answers.
DEADLINE_MS       = 1000
DEADLINE_SLACK_MS = 2000

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

# A listener standing where a CA's directory would be: every connection
# counted and closed unanswered.
class Counter
  property connections : Int32 = 0
end

def local_checks(dir : String) : Nil
  puts "== the directory cache"
  cache = AutocertDirCache.new(dir)
  check cache.get("absent.example").nil?, "a key not in the cache is nil"
  check cache.put("entry.example", "first").nil?, "the cache made its directory and wrote an entry"
  check cache.get("entry.example") == "first", "an entry reads back"
  check cache.put("entry.example", "second").nil?, "an entry is written over"
  check cache.get("entry.example") == "second", "an entry written over reads back as the new one"
  check Dir.entries(dir).select { |e| e != "." && e != ".." } == ["entry.example"], "no temporary file is left beside an entry: #{Dir.entries(dir)}"
  ["../escape", "a/b", "", "..", "a\\b"].each do |bad|
    check cache.put(bad, "x").is_a?(AutocertError), "#{bad.inspect} is refused as a cache key"
  end
  check cache.delete("entry.example").nil? && cache.get("entry.example").nil?, "a deleted entry is gone"
  puts "  read, written over by rename, deleted, and keys that are not a file's name refused"

  listener = IyiSocket.listen("127.0.0.1", 0)
  counter = Counter.new
  directory = "https://127.0.0.1:#{listener.local_port}/directory"
  group do |g|
    g.spawn do
      while true
        socket = listener.accept
        break unless socket.is_a?(IyiSocket)
        counter.connections = counter.connections + 1
        socket.close
      end
      0
    end
    g.spawn do
      policy_checks(dir, directory, counter)
      listener.close
      0
    end
  end

  deadline_checks(dir)

  puts "\n== when a certificate is due"
  manager = AutocertManager.new(directory, cache, ["a.autocert.example"])
  start = Time.utc(2026, 1, 1).to_unix_ms
  day = 86400000_i64
  check manager.renew_time(start, start + 90_i64 * day) == start + 60_i64 * day, "a 90-day certificate is due 30 days before its end"
  check manager.renew_time(start, start + 30000_i64) == start + 20000_i64, "a 30-second certificate is due two thirds into its life"
  manager.renew_before = Span.days(7)
  check manager.renew_time(start, start + 90_i64 * day) == start + 83_i64 * day, "renew_before of seven days: due 7 days before the end"
  puts "  90 days: 30 before the end; 30 seconds: at 20; renew_before of 7 days: 7 before the end"

  puts "\n== tls-alpn-01 beside the certificates, http-01 on port 80"
  name = "alpn.autocert.example"
  alpn = AutocertManager.new(directory, cache, [name])
  check alpn.add_challenge(name, "tok-1", "tok-1.thumbprint").nil?, "the tls-alpn-01 challenge put up"
  shown = alpn.identity_for(name, ["acme-tls/1"])
  check shown.is_a?(TlsIdentity) && shown.leaf.unhandled_critical.includes?(ACME_IDENTIFIER) && shown.leaf.dns_names == [name],
    "a client offering acme-tls/1 alone is shown the challenge certificate"
  [["http/1.1"], ["acme-tls/1", "http/1.1"], ["h2", "acme-tls/1"]].each do |offered|
    other = alpn.identity_for(name, offered)
    check !(other.is_a?(TlsIdentity) && other.leaf.unhandled_critical.includes?(ACME_IDENTIFIER)),
      "a challenge certificate is shown under acme-tls/1 alone, not to a client offering #{offered.join(", ")}"
  end
  check alpn.identity_for("other.autocert.example", ["acme-tls/1"]).is_a?(TlsError), "acme-tls/1 for a name with no challenge up is refused"
  none = {} of String => String
  answered = alpn.answer(Request.new("GET", "/.well-known/acme-challenge/tok-1", nil, none, ""))
  check !answered.nil? && answered.status == 200 && answered.body == "tok-1.thumbprint", "http-01's token answered on port 80 with its key authorization"
  check alpn.answer(Request.new("GET", "/", nil, none, "")).nil?, "another path on port 80 is the program's own"
  alpn.remove_challenge(name, "tok-1")
  check alpn.identity_for(name, ["acme-tls/1"]).is_a?(TlsError), "a challenge taken down is no longer shown"
  config = alpn.tls_config(["h2", "http/1.1"])
  check config.alpn == ["h2", "http/1.1", "acme-tls/1"], "tls_config speaks acme-tls/1 after the program's protocols"
  puts "  the challenge certificate under acme-tls/1 alone, refused beside other protocols, http-01's answer, both taken down"
end

def policy_checks(dir : String, directory : String, counter : Counter) : Nil
  puts "\n== the host policy, before the CA"
  cache = AutocertDirCache.new(dir)
  manager = AutocertManager.new(directory, cache, ["a.autocert.example", "Bücher.Autocert.Example."])
  refused = manager.identity_for("evil.autocert.example", ["http/1.1"])
  check refused.is_a?(TlsError) && refused.message.includes?("not a name this manager answers for") && counter.connections == 0 && manager.orders == 0,
    "a disallowed name is refused before the CA is asked: #{refused}, #{counter.connections} connections to the CA"
  check refused.is_a?(TlsError) && refused.alert == TlsAlert::UNRECOGNIZED_NAME, "a disallowed name is refused with unrecognized_name: #{refused}"
  check manager.identity_for(nil, ["http/1.1"]).is_a?(TlsError) && counter.connections == 0, "a client naming no host is refused before the CA is asked"
  check cache.get(AutocertManager::ACCOUNT_KEY).nil?, "no account key is made for a refused name"
  # What is printed is the same on every run and platform: no port, no
  # count, no wording of the system's; the details are asserted above.
  puts "  evil.autocert.example refused with unrecognized_name, the CA not asked"

  allowed = manager.identity_for("A.autocert.example", ["http/1.1"])
  check allowed.is_a?(TlsError) && counter.connections > 0, "an allowed name, in another case, is ordered: the CA asked #{counter.connections} times"
  check allowed.is_a?(TlsError) && allowed.alert == TlsAlert::INTERNAL_ERROR && allowed.message.includes?("the CA's directory"),
    "an allowed name the CA cannot be reached for is refused with internal_error, naming the directory: #{allowed}"
  unicode = manager.identity_for("xn--bcher-kva.autocert.example", nil)
  check unicode.is_a?(TlsError) && !unicode.message.includes?("not a name this manager answers for"), "a Unicode name in the list is allowed by its A-labels: #{unicode}"
  puts "  an allowed name asks the CA, and is refused with internal_error when the CA answers nothing; a Unicode one is allowed by its A-labels"

  puts "\n== a failure remembered"
  asked = counter.connections
  again = manager.identity_for("a.autocert.example", ["http/1.1"])
  check again.is_a?(TlsError) && counter.connections == asked, "a failed name's next handshake is refused at once, the CA not asked again: #{counter.connections} against #{asked}"
  check allowed.is_a?(TlsError) && again.is_a?(TlsError) && again.message == allowed.message, "the failure remembered is the one the order ended with"
  stored = cache.get(AutocertManager::ACCOUNT_KEY)
  check stored.is_a?(String), "the account key was made and cached before the CA was asked"
  key = SigningKey.from_pem(stored.as(String))
  public = key.is_a?(SigningKey) ? key.public_key : nil
  check public.is_a?(EcdsaPublicKey) && public.curve == EcdsaCurve::P256, "the cached account key reads back as a P-256 key"
  puts "  the next handshake is refused with the same error, the CA not asked again; the account key cached, P-256"

  puts "\n== chains checked to the manager's roots"
  check cache.put("localhost", KEY_PEM + LEAF_PEM).nil?, "a chain for localhost put in the cache"
  trusting = AutocertManager.new(directory, cache, ["localhost"])
  trusting.roots = Certificate.from_pem(ROOT_PEM).or_panic
  asked = counter.connections
  shown = trusting.identity_for("localhost", ["http/1.1"])
  check shown.is_a?(TlsIdentity) && counter.connections == asked, "a cached chain that reaches the manager's roots is shown, the CA not asked: #{shown}"
  stranger = AutocertManager.new(directory, cache, ["localhost"])
  stranger.roots = Certificate.from_pem(OTHER_ROOT_PEM).or_panic
  refused_chain = stranger.identity_for("localhost", ["http/1.1"])
  check refused_chain.is_a?(TlsError) && counter.connections > asked,
    "a cached chain from a CA the manager does not trust is not shown, and the CA is asked for another: #{refused_chain}"
  check cache.delete("localhost").nil?, "the chain taken out of the cache"
  puts "  a cached chain shown under the roots that issued it, and under other roots refused and ordered again"
end

# One TLS handshake with *manager*'s config for *name*, the server given
# `DEADLINE_MS`: how long the server took to end it, in ms.
def handshake_ms(manager : AutocertManager, name : String) : Int64
  listener = IyiSocket.listen("127.0.0.1", 0)
  config = manager.tls_config
  took = -1_i64
  group do |g|
    g.spawn do
      socket = listener.accept
      if socket.is_a?(IyiSocket)
        started = Time.monotonic.total_milliseconds.to_i64
        shaken = TlsServer.over(socket, config, DEADLINE_MS)
        took = Time.monotonic.total_milliseconds.to_i64 - started
        check shaken.is_a?(TlsError), "a handshake for #{name} with no certificate to show is refused"
        socket.close
      end
      0
    end
    g.spawn do
      client = IyiSocket.connect("127.0.0.1", listener.local_port)
      if client.is_a?(IyiSocket)
        TlsClient.over(client, name, TlsConfig.new, 10000)
        client.close
      end
      0
    end
  end
  listener.close
  took
end

# A CA that takes connections and never answers: each order waits on it
# for AcmeClient's 30-second timeout. A handshake given `DEADLINE_MS`
# must end by then, with `run` and without; the CA's connections are
# counted as orders reaching it.
def deadline_checks(dir : String) : Nil
  puts "\n== a handshake's wait cut to its deadline"
  hold = IyiSocket.listen("127.0.0.1", 0)
  directory = "https://127.0.0.1:#{hold.local_port}/directory"
  taken = [] of IyiSocket
  group do |g|
    g.spawn do
      while true
        socket = hold.accept
        break unless socket.is_a?(IyiSocket)
        taken << socket
      end
      0
    end
    g.spawn do
      inline = AutocertManager.new(directory, AutocertDirCache.new(dir), ["slow.autocert.example"])
      took = handshake_ms(inline, "slow.autocert.example")
      check took < DEADLINE_MS + DEADLINE_SLACK_MS && taken.size == 1,
        "without run, a handshake waiting for an order ends by its #{DEADLINE_MS} ms deadline: it took #{took} ms, the CA asked #{taken.size} times"
      took = handshake_ms(inline, "slow.autocert.example")
      check took < DEADLINE_MS + DEADLINE_SLACK_MS && taken.size == 2,
        "without run, an order cancelled at the deadline is not remembered as a failure: the next handshake asks the CA again (#{taken.size} times), in #{took} ms"
      background = AutocertManager.new(directory, AutocertDirCache.new(dir), ["slower.autocert.example"])
      group do |r|
        r.spawn do
          background.run
          0
        end
        took = handshake_ms(background, "slower.autocert.example")
        check took < DEADLINE_MS + DEADLINE_SLACK_MS && taken.size == 3,
          "with run, a handshake waiting for an order ends by its deadline: it took #{took} ms, the CA asked #{taken.size} times"
        took = handshake_ms(background, "slower.autocert.example")
        check took < DEADLINE_MS + DEADLINE_SLACK_MS && taken.size == 3,
          "with run, the order goes on past its handshake: the next one waits for the same order, the CA asked #{taken.size} times, in #{took} ms"
        background.stop
        0
      end
      hold.close
      taken.each(&.close)
      0
    end
  end
  puts "  with run and without, handshakes end by their deadline; with run the order goes on, without it the next handshake starts it again"
end

def challenge_serve(dir : String) : Nil
  name = "alpn.autocert.example"
  authorization = "tok-alpn.thumbprint"
  manager = AutocertManager.new("https://127.0.0.1:1/directory", AutocertDirCache.new("#{dir}/cache"), [name])
  manager.add_challenge(name, "tok-alpn", authorization)
  listener = IyiSocket.listen("127.0.0.1", 0)
  File.write("#{dir}/alpn.txt", "#{name} #{authorization}\n")
  File.write("#{dir}/port", listener.local_port.to_s)
  Server.serve(listener, tls: manager.tls_config) { |r| Response.new(200, "not a challenge") }
end

# A listener on *port*. A second server binds the ports the first one
# let go of, and where the system may hold them a while after - Windows
# can, under the SO_EXCLUSIVEADDRUSE std/socket sets there, while the old
# listener's connections sit in TIME_WAIT - the bind is tried again,
# every half second for a minute.
def listen_again(port : Int32) : IyiSocket
  tries = 0
  while true
    bound = nil.as(IyiSocket?)
    why = ""
    group do |g|
      task = g.spawn { IyiSocket.listen("127.0.0.1", port) }
      got = task.value
      if got.is_a?(IyiSocket)
        bound = got
      else
        why = got.message
      end
      0
    end
    if done = bound
      return done
    end
    tries = tries + 1
    raise "the port #{port} was not bound in a minute: #{why}" if tries >= 120
    sleep(500)
  end
  raise "unreachable"
end

def serve(args : Array(String)) : Nil
  directory, minica, roots, cache_dir, tls_port, http_port, hosts, challenges, ready = args[1], args[2], args[3], args[4], args[5].to_i, args[6].to_i, args[7], args[8], args[9]
  trust = TlsConfig.new
  trust.roots = Certificate.from_pem(File.read(minica)).or_panic
  trust.alpn = ["http/1.1"]
  HTTP.tls_config = trust
  manager = AutocertManager.new(directory, AutocertDirCache.new(cache_dir), hosts.split(","))
  manager.roots = Certificate.from_pem(File.read(roots)).or_panic
  manager.accept_terms = true
  manager.email = "autocert@iyi-autocert.example"
  manager.challenges = challenges.split(",")
  config = manager.tls_config
  config.min_version = TlsVersion::TLS12
  tls_listener = listen_again(tls_port)
  http_listener = listen_again(http_port)
  File.write(ready, "ready\n")
  puts "listening on #{tls_port} and #{http_port}"
  group do |g|
    g.spawn do
      manager.run
      0
    end
    g.spawn do
      Server.serve(http_listener) { |r| manager.answer(r) || Response.new(404, "not a challenge") }
      0
    end
    if args.size > 10 && args[10] == "parallel"
      IyiWorkers.count = 4
      # A worker waits for `run` this long at most: a broken copy whose
      # asks go unanswered is then caught in seconds, not minutes.
      manager.wait_ms = 20000
      frozen = manager.frozen_tls_config(config)
      Server.serve_parallel(tls_listener, tls: frozen) { |r| Response.new(200, "worker #{IyiScheduler.state.object_id}\n") }
    else
      Server.serve(tls_listener, tls: config) { |r| Response.new(200, "orders #{manager.orders} renewals #{manager.renewals}\n") }
    end
    0
  end
end

args = Program.args
if args.size > 1 && args[0] == "challenge-serve"
  challenge_serve(args[1])
  exit 0
end
if args.size > 9 && args[0] == "serve"
  serve(args)
  exit 0
end
dir = args.size > 0 ? args[0] : "#{Dir.tempdir}/iyi-autocert-#{Random::Secure.random_bytes(6).map { |x| (x < 16_u8 ? "0" : "") + x.to_s(16) }.join("")}"
local_checks(dir)
puts "\nALL CHECKS PASSED"
