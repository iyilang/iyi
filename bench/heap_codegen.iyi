# heap22's compiler side (S3), driven: what a `-Dheap_partitions` build
# emits so that no pointer crosses from one unit's heap into another's
# unpublished, one check per mechanism.
#
#   ./bin/iyi build -Dheap_partitions -Dheap_verify -Diyi_chaos bench/heap_codegen.iyi
#   IYI_CHAOS=1 IYI_HEAP_STRESS=1 ./heap_codegen   # every check
#   ./heap_codegen c1                               # one
#   bash bench/heap_codegen.sh  # every check, and the compiler's broken copies
#
# - `c1`: a crossing block's closure is a context of its own (C1). The
#   scope that makes the block also keeps a mutable array in its own
#   closure, and grows it after the crossing; publishing the block's
#   context must leave the array the unit's. Read before any collection:
#   `IyiHeap.local?`. The block also captures an `Atomic` the scope sets
#   after the crossing: a struct capture is boxed, not copied, so the
#   block sees the scope's store, and the scope's context still stays
#   the unit's.
# - `classvar`: a unit stores a graph of its own into a class variable
#   through a call; the store publishes it.
# - `born_shared`: `Mutex`, `Channel`, `Unit`'s handle, a same-unit task's
#   fiber (and the buffer its constructor makes) and a new unit made in a
#   unit's code are the shared heap's, through `__iyi_new_shared`
#   (`IyiHeap.owner_of`).
# - `pin`: a crossing that reaches an owning type that does not keep the
#   lend protocol runs pinned, in the shared heap, and what it stores into
#   that type's graph is shared; one that keeps the protocol gets its own
#   heap.
#
# Each check ends its units' stores with `collect_here`: the stack below
# scrubbed and the unit's partition collected, so that under
# `-Dheap_verify` a word left pointing into the partition's unmarked
# `LOCAL` chunks (a store a broken compiler did not publish) is the
# verifier's report and exit 86, whatever the program's own check said.
#
# Without `-Dheap_partitions` every check passes: that build is the
# flag-off control.

@[Unsafe("the checks ask the runtime's partition records where a chunk lives, wipe their stack with raw words, and stand in for a library's owning types")]
{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  import std/gc::{GC}
  import std/mutex::{Mutex}
  import std/unit::{Unit}

  # `HEAP22_PRINT_ONLY=1`: a failed check prints its `FAIL:` line and the
  # program goes on, so that bench/heap_codegen.sh can show a broken copy
  # caught by `-Dheap_verify`'s verifier alone (the run then exits 86 at
  # the verifier's report, or 0 when nothing but the program saw it).
  class Checks
    @@print_only = false

    def self.print_only : Bool
      @@print_only
    end

    def self.read_env : Nil
      @@print_only = Program.env("HEAP22_PRINT_ONLY") == "1"
    end
  end

  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1) unless Checks.print_only
  end

  # The stack below the caller zeroed, so that no dead frame's word is a
  # root of the collection that follows.
  @[NoInline]
  def scrub : UInt64
    room = uninitialized StaticArray(UInt64, 2048)
    words = pointerof(room).as(Pointer(UInt64))
    index = 0
    while index < 2048
      words[index] = 0_u64
      index = index + 1
    end
    words[2047]
  end

  # The running unit's partition collected, until one collection has run;
  # nothing in a unit that runs in the shared heap.
  @[NoInline]
  def collect_here : Nil
    scrub
    {% if flag?(:heap_partitions) %}
      record = IyiScheduler.current.alloc
      return if record == 0_u64
      before = IyiHeap.partition_collections(record)
      tries = 0
      while IyiHeap.partition_collections(record) == before && tries < 1000
        IyiHeap.collect_local(record)
        tries = tries + 1
        sleep(1) if IyiHeap.partition_collections(record) == before
      end
      fail("a local collection did not run in 1000 tries") if IyiHeap.partition_collections(record) == before
    {% end %}
  end

  # The partitions live now; none without `-Dheap_partitions`.
  def partitions_now : UInt64
    {% if flag?(:heap_partitions) %}
      IyiHeap.partitions_live
    {% else %}
      0_u64
    {% end %}
  end

  # The partitions live back to *before*: the units a check started have
  # died, and under `-Dheap_verify` each death's check has scanned for any
  # word still naming a chunk of theirs - a published object's word into
  # the dead partition's `LOCAL` chunks among them, which the local
  # collection marks through the published object and does not report.
  # As bench/heap_crossings.iyi's `settled`, with a global collection
  # every 100 ms: a `Unit`'s partition dies only at the mark that finds
  # its handle dead (`find_dead_units`), and `born_shared`'s handle kept
  # one live through 5 s of waiting (Linux, plain and release).
  def settled(before : UInt64, what : String) : Nil
    waited = 0
    while partitions_now > before && waited < 5000
      GC.collect if waited % 100 == 0
      sleep(1)
      waited = waited + 1
    end
    fail("#{what}: #{partitions_now - before} partitions still live 5 s after the check's units ended") if partitions_now > before
  end

  class Payload
    @label : String
    @next : Payload?

    def initialize(@label : String, @next : Payload?)
    end

    def label : String
      @label
    end

    def next_node : Payload?
      @next
    end
  end

  NODES = 16

  def label_for(seed : Int32, index : Int32) : String
    "c#{seed}-#{index}-" + "y" * (index % 5 + 2)
  end

  @[NoInline]
  def build(seed : Int32) : Payload
    node = Payload.new(label_for(seed, 0), nil)
    index = 1
    while index < NODES
      node = Payload.new(label_for(seed, index), node)
      index = index + 1
    end
    node
  end

  # The chain at *node* checked node by node: published or shared, none
  # the running unit's own.
  def published(node : Payload?, what : String) : Nil
    {% if flag?(:heap_partitions) %}
      index = NODES - 1
      while node.is_a?(Payload)
        fail("#{what}: node #{index} is still local to its unit's partition") if IyiHeap.local?(node.object_id)
        fail("#{what}: node #{index}'s label is still local to its unit's partition") if IyiHeap.local?(node.label.object_id)
        node = node.next_node
        index = index - 1
      end
    {% end %}
  end

  def shared_made(address : UInt64, what : String) : Nil
    {% if flag?(:heap_partitions) %}
      fail("#{what}: made in partition #{IyiHeap.owner_of(address)}, not the shared heap") if IyiHeap.owner_of(address) != 0_u64
    {% end %}
  end

  # The running fiber's partition record: 0 when its unit runs in the
  # shared heap (pinned, or no partitions).
  def heap_here : UInt64
    {% if flag?(:heap_partitions) %}
      IyiScheduler.current.alloc
    {% else %}
      0_u64
    {% end %}
  end

  # ── C1: a crossing block's context holds its captures alone ────────────
  # The scope keeps a variable of its own in its closure and assigns it a
  # fresh array after the crossing: with the block's context published
  # beside it (no C1), that array is the unit's and only a published
  # context holds it. A local collection marks through what its unit
  # published, so the word is the verifier's at the scope's unit's death,
  # whose check scans only what the last global mark found live: the
  # block leaves where its context lives in `C1Hold`, as a block a
  # long-lived unit keeps would hold it. Without it the block's unit,
  # joined inside the scope's, ended first, and its context was found
  # live or not by the time of the scope's death (Linux, 3f6cd14b4,
  # `IYI_HEAP_STRESS=1`: missed on seeds 1-5, caught under
  # `IYI_HEAP_TRACE=1`).
  class C1Hold
    @[UnsafeReach("the crossing block leaves where its context lives here, a raw word the global mark reads and no publication follows, so that the context outlives the scope's unit")]
    @@context : Pointer(Void) = Pointer(Void).new(0_u64)

    def self.put(word : Pointer(Void)) : Nil
      @@context = word
    end

    def self.drop : Nil
      @@context = Pointer(Void).new(0_u64)
    end
  end

  @[NoInline]
  def launch_c1(g : IyiGroup, go : Channel(Int32), seed : Int32) : Nil
    payload = build(seed)
    # A mutable variable the scope keeps in its own closure, beside the
    # one the crossing block captures: a sibling slot (CO 4.3 #8).
    sibling = [Payload.new(label_for(seed, 99), nil)]
    first = sibling
    keep = -> { sibling = [Payload.new(label_for(seed, 98), nil)]; sibling.size }
    # A struct the block captures and the scope sets after the crossing.
    flag = Atomic(Int32).new(0)
    g.spawn(unit: :new) do
      go.receive
      fail("c1: the crossing block read a copy of the scope's Atomic, not the scope's (#{flag.get})") unless flag.get == 1
      C1Hold.put(pointerof(payload).as(Pointer(Void)))
      payload.label.bytesize
    end
    flag.set(1)
    published(payload, "c1: the captured chain")
    {% if flag?(:heap_partitions) %}
      fail("c1: the scope's own array was published with the crossing block's context") unless IyiHeap.local?(first.object_id)
      fail("c1: the scope's own array's element was published with the crossing block's context") unless IyiHeap.local?(first[0].object_id)
    {% end %}
    keep.call
  end

  def c1_check : Nil
    before = partitions_now
    go = Channel(Int32).new(1)
    group do |outer|
      outer.spawn(unit: :new) do
        group do |g|
          launch_c1(g, go, 41)
          collect_here
          go.send(1)
        end
        0
      end
    end
    settled(before, "c1")
    C1Hold.drop
  end

  # ── A class variable a unit stores into ───────────────────────────────
  class Latest
    @[UnsafeReach("the check stores a unit's graph here on purpose, so that the store's publication is what keeps it")]
    @@payload : Payload? = nil

    def self.put(payload : Payload) : Nil
      @@payload = payload
    end

    def self.get : Payload?
      @@payload
    end
  end

  @[NoInline]
  def store_latest(seed : Int32) : Nil
    Latest.put(build(seed))
  end

  def classvar_check : Nil
    before = partitions_now
    group do |g|
      g.spawn(unit: :new) do
        store_latest(42)
        published(Latest.get, "classvar: the stored chain")
        collect_here
        0
      end
    end
    settled(before, "classvar")
    node = Latest.get
    fail("classvar: nothing stored") unless node.is_a?(Payload)
  end

  # ── Trusted types born in the shared heap ─────────────────────────────
  # The new unit's object a crossing spawn makes in its spawner's code is
  # held, once the spawner drops it, by the new unit's fiber, which is the
  # shared heap's: made in the spawner's partition, the spawner's death
  # (`settled`) frees it under the fiber.
  def born_shared_check : Nil
    before = partitions_now
    go = Channel(Int32).new(1)
    # The new unit's fiber, for the main fiber to watch.
    watched = Atomic(UInt64).new(0_u64)
    group do |outer|
      outer.spawn(unit: :new) do
        m = Mutex.new { 1 }
        shared_made(m.object_id, "born_shared: the Mutex")
        ch = Channel(Int32).new(1)
        shared_made(ch.object_id, "born_shared: the Channel")
        u = Unit.new { 7 }
        shared_made(u.object_id, "born_shared: the Unit's handle")
        group do |g|
          task = g.spawn(unit: :same) { 3 }
          shared_made(task.fiber.object_id, "born_shared: a same-unit task's fiber")
          shared_made(task.fiber.@wait_overlapped.address, "born_shared: the buffer a same-unit task's fiber's constructor makes")
          task.value
        end
        group do |g|
          task = g.spawn(unit: :new) do
            go.receive
            5
          end
          {% if flag?(:heap_partitions) %}
            unit = task.fiber.unit
            shared_made(unit.object_id, "born_shared: a new unit's object") if unit.is_a?(IyiUnit)
          {% end %}
          collect_here
          watched.set(task.fiber.object_id)
          fail("born_shared: the new unit's answer reads wrong") unless task.value == 5
        end
        0
      end
      # The new unit parked in its receive before the send, so that its
      # waiter is made (in its partition, with the `new-shared` copy) and
      # named at its death: a send that came first left the receive
      # nothing to park on, and the copy was reported at the maker's death
      # instead (Linux, 4976717e5, seed 1: 1 run of 14). Watched from the
      # main fiber, whose parks collect no partition under
      # `IYI_HEAP_STRESS=1`, so the verifier's check count stays the same.
      parked = 0
      while !parked_in_receive?(watched.get) && parked < 5000
        sleep(1)
        parked = parked + 1
      end
      fail("born_shared: the new unit did not park in its receive in 5 s") unless parked_in_receive?(watched.get)
      go.send(1)
    end
    settled(before, "born_shared")
  end

  # Whether the fiber at *address* is parked in a channel's receive.
  def parked_in_receive?(address : UInt64) : Bool
    address != 0_u64 && Pointer(Void).new(address).as(IyiFiber).state == IyiFiberState::WaitingCh
  end

  # ── Owning types and `lends:` ─────────────────────────────────────────
  # A library's owning type that does not keep the lend protocol, and one
  # that does. The pinned unit stores a node of its own into the pool's
  # graph: made in a heap of its own (no pin), only the pool holds it once
  # the unit drops it, and the unit's collection frees it under the pool.
  @[Share(owns: true)]
  class Pool
    @items = [] of Payload

    def initialize
    end

    def add(item : Payload) : Int32
      @items << item
      @items.size
    end

    def first? : Payload?
      @items.first?
    end
  end

  @[Share(owns: true, lends: true)]
  class LentPool
    def initialize
    end

    def touch : Int32
      2
    end
  end

  @[NoInline]
  def fill(pool : Pool, seed : Int32) : Nil
    pool.add(build(seed))
    nil
  end

  def pin_check : Nil
    before = partitions_now
    pool = Pool.new
    lent = LentPool.new
    group do |g|
      pinned = g.spawn(unit: :new) do
        here = heap_here
        fail("pin: a crossing reaching an owning type without lends: has a heap of its own (record #{here})") unless here == 0_u64
        fill(pool, 43)
        collect_here
        here
      end
      own = g.spawn(unit: :new) do
        lent.touch
        heap_here
      end
      {% if flag?(:heap_partitions) %}
        fail("pin: a crossing reaching only a lends: owning type runs in the shared heap") if own.value == 0_u64
      {% else %}
        own.value
      {% end %}
      pinned.value
    end
    settled(before, "pin")
    fail("pin: the pool lost its node") unless pool.first?.is_a?(Payload)
  end

  CHECKS = ["c1", "classvar", "born_shared", "pin"]

  def run(name : String) : Nil
    case name
    when "c1"          then c1_check
    when "classvar"    then classvar_check
    when "born_shared" then born_shared_check
    when "pin"         then pin_check
    else                    fail("no check named #{name}")
    end
  end

  # The pool grown to its workers from the main fiber before any unit
  # runs. A worker started later from a unit's fiber is an `IyiThread`
  # made in that unit's partition when the compiler's `new-shared` copy is
  # off, which the verifier reported at that partition's local collection
  # or at born_shared's unit's death, whichever came first (Linux,
  # 4976717e5, seed 1: 4 runs of 10 the first).
  def grow_pool : Nil
    IyiWorkers.start
    waited = 0
    while IyiWorkers.launched < IyiWorkers.count && waited < 5000
      IyiWorkers.grow
      sleep(1)
      waited = waited + 1
    end
    fail("the pool has #{IyiWorkers.launched} of its #{IyiWorkers.count} workers 5 s after its start") if IyiWorkers.launched < IyiWorkers.count
  end

  Checks.read_env
  IyiWorkers.count = 4
  grow_pool
  arguments = Program.args
  if arguments.empty?
    CHECKS.each { |name| run(name) }
    puts "heap codegen: #{CHECKS.size} mechanisms hold"
  else
    arguments.each do |name|
      run(name)
      puts "#{name}: holds"
    end
  end
{% else %}
  puts "heap codegen: no pool on this target, nothing to check"
{% end %}
