ascii "例え。テスト", "xn--r8jz45g.xn--zckzah", "an ideographic full stop separates labels"
ascii "例え．テスト｡", "xn--r8jz45g.xn--zckzah.", "full-width stops and a trailing one"
ascii "пример.испытание", "xn--e1afmkfd.xn--80akhbyknj4f", "Cyrillic"
ascii "παράδειγμα.δοκιμή", "xn--hxajbheg2az3al.xn--jxalpdlp", "Greek"
