; iyi-ir 1
source_filename = "entry-chain"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @f(i64 %x) {
entry:
  %r = add i64 %x, 11
  ret i64 %r
}
define internal i64 @g(i64 %x) {
entry:
  %r = xor i64 %x, 777
  ret i64 %r
}
define internal i64 @force(i64 %x) [alwaysinline] {
entry:
  %r = xor i64 %x, 991
  ret i64 %r
}
define internal i64 @__iyi_main(i64 %n) [alwaysinline] {
entry:
  %outside = call i64 (i64) @f(i64 %n)
  %start = call i64 (i64) @force(i64 %outside)
  br label %head
head:
  %current = phi i64 [ %start, label %entry ], [ %next, label %body ]
  %more = icmp ne i64 %current, 0
  br i1 %more, label %body, label %done
body:
  %value = call i64 (i64) @g(i64 %current)
  %next = add i64 %value, 1
  br label %head
done:
  ret i64 %current
}
define internal i64 @__iyi_program(i64 %n) {
entry:
  %r = call i64 (i64) @__iyi_main(i64 %n)
  ret i64 %r
}
define internal i64 @__iyi_enter(i64 %n) {
entry:
  %r = call i64 (i64) @__iyi_program(i64 %n)
  ret i64 %r
}
define external i64 @main(i64 %n) {
entry:
  %r = call i64 (i64) @__iyi_enter(i64 %n)
  ret i64 %r
}
define internal i64 @__crystal_main(i64 %x) [alwaysinline] {
entry:
  %r = add i64 %x, 321
  ret i64 %r
}
define external i64 @empty_entry(i64 %x) {
entry:
  %r = call i64 (i64) @__crystal_main(i64 %x)
  ret i64 %r
}
