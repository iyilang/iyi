; iyi-ir 1
source_filename = "escape_dynamic_pointer_offset"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @dynamic_offset(i64 %offset, ptr %heap) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 32, i64 3, i64 2)
  %field = getelementptr i8, ptr %p, i64 %offset
  store ptr %heap, ptr %field, align 1
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
