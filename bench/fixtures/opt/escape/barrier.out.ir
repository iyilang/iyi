; iyi-ir 1
source_filename = "escape_barrier"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
declare external void @__iyi_write_barrier(ptr, i64)
define internal i64 @barrier() {
entry:
  %0 = alloca [8 x i8], align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 8, i1 false)
  store i64 5, ptr %0, align 8
  call void (ptr, i64) @__iyi_write_barrier(ptr %0, i64 1)
  %v = load i64, ptr %0, align 8
  ret i64 %v
}
