lib LibC
  fun exit(status : Int32) : NoReturn
end

class Box
end

def choose(flag : Bool) : Box?
  if flag
    Box.new
  else
    nil
  end
end

def check(flag : Bool) : Int32
  x = false
  x = choose(flag)
  if x.nil?
    3
  elsif x.is_a?(Box)
    4
  else
    100
  end
end

LibC.exit(check(false) &+ check(true))
