; iyi-ir 1
source_filename = "switch_const"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @switch_const() {
entry:
  switch i32 2, label %other [ i32 1, label %one, i32 2, label %two ]
one:
  ret i32 1
two:
  ret i32 2
other:
  ret i32 0
}
