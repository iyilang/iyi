; iyi-ir 1
source_filename = "escape_null_table"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Record = type { ptr, i64 }
@__iyi_gc_layouts = internal constant ptr null
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @null_table(i64 %tid, ptr %heap) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%Record, ptr null, i32 1) to i64), i64 %tid, i64 0)
  store ptr %heap, ptr %p, align 8
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
