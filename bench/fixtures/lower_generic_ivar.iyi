# A generic class instance's instance variable: Box(Int32)#@value is read through the instance's own layout.
# The box is allocated, not `uninitialized`: the pipeline gate runs this program, and reading through an
# uninitialized reference reads whatever the stack held (a crash on darwin arm64).
class Box(T)
  def initialize(@value : T)
  end

  def value : T
    @value
  end
end

h = Box(Int32).new(7)
h.value
