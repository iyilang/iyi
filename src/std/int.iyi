# The whole integer tower: `Int8`, `Int16`, `UInt16`, `UInt32`, `Int128` and
# `UInt128` made as usable as the prelude's `Int32`, `Int64`, `UInt8` and
# `UInt64`.
#
# The prelude declares arithmetic, comparison and conversion primitives for
# its four integer types and `Float64` only; a literal `1_u16` exists, but
# `1_u16 + 1_u16` has no method to land on. This module declares the rest of
# the matrix the same way the prelude does - `@[Primitive]` annotations the
# compiler lowers to instructions, no library underneath - so every pair of
# integer types adds, subtracts, multiplies, compares and converts; then
# gives each type the operators the prelude writes by hand (`//`, `%`, `<<`,
# `>>`, `abs`, unary `-`) and a printer, and every integer the bit counts
# (`popcount`, `leading_zeros_count`, `trailing_zeros_count`, `bit_length`,
# `bit`), `gcd`/`lcm`, `digits`, `<=>`, and `chr` with the prelude's contract.
#
# What it refuses: arithmetic that leaves the type panics with "arithmetic
# overflow" (the `&+` family wraps instead); a conversion that does not fit
# panics the same way, and the `to_i8?` family answers nil instead; a double
# converts by truncating first, so `127.9.to_i8` is 127 and `(-0.5).to_u16`
# is 0, and what is refused is a truncation the type does not hold; `//` and
# `%` by zero panic "division by zero" / "modulo by zero"; `digits` of a
# negative number, a base under 2, a `chr` outside 0..127, and a `to_s` base
# outside 2..36 are refused with a sentence. There is no `Int32::MAX`: the
# edges of a type are its literals, and that holds for every type here.
#
# Against a double every integer compares exactly, `<=>` included:
# `9007199254740993_i128 == 9007199254740992.0` is false. The prelude's own
# four (`Int32`, `Int64`, `UInt8`, `UInt64`) keep the prelude's `==` family,
# which rounds `Int64` and `UInt64` to the double first; their `<=>` here
# is exact.
module std/int

{% begin %}
  {% types = [
       {"Int8", 8, true, "i8"},
       {"Int16", 16, true, "i16"},
       {"Int32", 32, true, "i32"},
       {"Int64", 64, true, "i64"},
       {"Int128", 128, true, "i128"},
       {"UInt8", 8, false, "u8"},
       {"UInt16", 16, false, "u16"},
       {"UInt32", 32, false, "u32"},
       {"UInt64", 64, false, "u64"},
       {"UInt128", 128, false, "u128"},
     ] %}
  {% prelude = %w(Int32 Int64 UInt8 UInt64) %}
  {% mins = {
       "Int8"   => "-128",
       "Int16"  => "-32768",
       "Int32"  => "-2147483648",
       "Int64"  => "-9223372036854775808",
       "Int128" => "-170141183460469231731687303715884105728",
     } %}
  {% maxs = {
       "Int8"    => "127",
       "Int16"   => "32767",
       "Int32"   => "2147483647",
       "Int64"   => "9223372036854775807",
       "Int128"  => "170141183460469231731687303715884105727",
       "UInt8"   => "255",
       "UInt16"  => "65535",
       "UInt32"  => "4294967295",
       "UInt64"  => "18446744073709551615",
       "UInt128" => "340282366920938463463374607431768211455",
     } %}
  {% convs = [
       {"to_i8", "Int8"}, {"to_i16", "Int16"}, {"to_i32", "Int32"}, {"to_i", "Int32"},
       {"to_i64", "Int64"}, {"to_i128", "Int128"},
       {"to_u8", "UInt8"}, {"to_u16", "UInt16"}, {"to_u32", "UInt32"}, {"to_u", "UInt32"},
       {"to_u64", "UInt64"}, {"to_u128", "UInt128"},
     ] %}
  {% prelude_convs = %w(to_i to_i32 to_i64 to_u8 to_u64) %}
  # A double whose truncation fits the type: past `float_limits[T]` (the
  # type's largest value plus one, exact in a double) it does not, and below
  # `float_refuse_low[T]` it does not either - the largest value under the
  # smallest of the type, where that is a double, else the smallest itself.
  {% float_limits = {
       "Int8"    => "128.0",
       "Int16"   => "32768.0",
       "Int32"   => "2147483648.0",
       "Int64"   => "9223372036854775808.0",
       "Int128"  => "170141183460469231731687303715884105728.0",
       "UInt8"   => "256.0",
       "UInt16"  => "65536.0",
       "UInt32"  => "4294967296.0",
       "UInt64"  => "18446744073709551616.0",
       "UInt128" => "340282366920938463463374607431768211456.0",
     } %}
  {% float_refuse_low = {
       "Int8"    => "self <= -129.0",
       "Int16"   => "self <= -32769.0",
       "Int32"   => "self <= -2147483649.0",
       "Int64"   => "self < -9223372036854775808.0",
       "Int128"  => "self < -170141183460469231731687303715884105728.0",
       "UInt8"   => "self <= -1.0",
       "UInt16"  => "self <= -1.0",
       "UInt32"  => "self <= -1.0",
       "UInt64"  => "self <= -1.0",
       "UInt128" => "self <= -1.0",
     } %}

  # --- the primitive matrix ---------------------------------------------
  {% for from in types %}
    struct ::{{ from[0].id }}
      # Conversions: the checked form panics "arithmetic overflow" when the
      # value does not fit; the `?` form answers nil instead. A pair the
      # prelude already declares is not declared twice.
      {% for conv in convs %}
        {% to_name = conv[1] %}
        {% to = types.find { |t| t[0] == to_name } %}
        {% unless prelude.includes?(from[0]) && prelude_convs.includes?(conv[0]) %}
          @[::Primitive(:convert)]
          @[Raises]
          def {{ conv[0].id }} : {{ to_name.id }}
          end
        {% end %}

        {% need_low = from[2] && (!to[2] || to[1] < from[1]) %}
        {% need_high = to[1] < from[1] || (to[1] == from[1] && to[2] && !from[2]) %}
        def {{ conv[0].id }}? : {{ to_name.id }}?
          {% if need_low %}
            return nil if self < {{ (to[2] ? mins[to_name] : "0").id }}_{{ from[3].id }}
          {% end %}
          {% if need_high %}
            return nil if self > {{ maxs[to_name].id }}_{{ from[3].id }}
          {% end %}
          {{ conv[0].id }}
        end
      {% end %}

      {% unless prelude.includes?(from[0]) %}
        @[::Primitive(:convert)]
        def to_f : Float64
        end

        @[::Primitive(:convert)]
        def to_f64 : Float64
        end

        @[::Primitive(:unchecked_convert)]
        def unsafe_chr : Char
        end
      {% end %}

      {% for other in types %}
        {% unless prelude.includes?(from[0]) && prelude.includes?(other[0]) %}
          {% for op in %w(== != < <= > >=) %}
            @[::Primitive(:binary)]
            def {{ op.id }}(other : {{ other[0].id }}) : Bool
            end
          {% end %}

          {% for op in %w(+ - *) %}
            @[::Primitive(:binary)]
            @[Raises]
            def {{ op.id }}(other : {{ other[0].id }}) : self
            end

            @[::Primitive(:binary)]
            def &{{ op.id }}(other : {{ other[0].id }}) : self
            end
          {% end %}

          {% for op in %w(| & ^ unsafe_shl unsafe_shr unsafe_div unsafe_mod) %}
            @[::Primitive(:binary)]
            def {{ op.id }}(other : {{ other[0].id }}) : self
            end
          {% end %}
        {% end %}
      {% end %}

      {% unless prelude.includes?(from[0]) %}
        {% if from[1] < 64 %}
          # Every value of the type is a double exactly, so the double's own
          # comparison is the exact one.
          {% for op in %w(== != < <= > >=) %}
            def {{ op.id }}(other : Float64) : Bool
              to_f64 {{ op.id }} other
            end
          {% end %}
        {% else %}
          # A value this wide may not be a double: `9007199254740993_i128 ==
          # 9007199254740992.0` was true, the integer rounded to the double
          # before the comparison. `<=>` below compares exactly.
          def ==(other : Float64) : Bool
            (self <=> other) == 0
          end

          def !=(other : Float64) : Bool
            (self <=> other) != 0
          end

          def <(other : Float64) : Bool
            (self <=> other) == -1
          end

          def <=(other : Float64) : Bool
            c = self <=> other
            c == -1 || c == 0
          end

          def >(other : Float64) : Bool
            (self <=> other) == 1
          end

          def >=(other : Float64) : Bool
            c = self <=> other
            c == 1 || c == 0
          end
        {% end %}

        {% for op in %w(+ - *) %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : Float64) : Float64
          end
        {% end %}

        # An integer divided by a float is a float, as the prelude has it
        # for `Int32` and `Int64`.
        def /(other : Float64) : Float64
          to_f64 / other
        end
      {% end %}

      # Exact for every width: the double is placed against the type's
      # edges, then its floor - one of the type, once inside them - against
      # the value, then its fraction decides a tie. nil when the double is
      # NaN, as `Float64#<=>` answers. The prelude's `Int64 == Float64` is
      # not exact, and is the prelude's to mend; this one is.
      def <=>(other : Float64) : Int32?
        return nil if other != other
        return -1 if other >= {{ float_limits[from[0]].id }}
        return 1 if other < {{ (from[2] ? mins[from[0]] : "0").id }}.0
        whole = other.floor
        {% conv = convs.find { |c| c[1] == from[0] } %}
        as_int = whole.unsafe_{{ conv[0].id }}
        return -1 if self < as_int
        return 1 if self > as_int
        other > whole ? -1 : 0
      end
    end
  {% end %}

  struct ::Float64
    {% for from in types %}
      {% unless prelude.includes?(from[0]) %}
        # The integer's comparison, exact, with the sides swapped.
        {% for pair in [{"==", "=="}, {"!=", "!="}, {"<", ">"}, {"<=", ">="}, {">", "<"}, {">=", "<="}] %}
          def {{ pair[0].id }}(other : {{ from[0].id }}) : Bool
            other {{ pair[1].id }} self
          end
        {% end %}

        {% for op in %w(+ - *) %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : {{ from[0].id }}) : self
          end
        {% end %}

        @[::Primitive(:binary)]
        def fdiv(other : {{ from[0].id }}) : self
        end
      {% end %}
    {% end %}

    # The conversions to the integers the prelude does not reach. The
    # unchecked form is the instruction, for every target; the checked
    # form truncates first and refuses what the truncation does not hold:
    # `127.9.to_i8` is 127 and `(-0.5).to_u16` is 0, where the range was
    # once checked on the untruncated value and both were refused. NaN and
    # the infinities are refused. The prelude's own five (`to_i`, `to_i32`,
    # `to_i64`, `to_u8`, `to_u64`) still check before truncating.
    {% for conv in convs %}
      {% if conv[1] == "Int128" || conv[1] == "UInt128" %}
        # Not the instruction: a double to a 128-bit integer is a call
        # into compiler-rt (`__fixdfti`) on aarch64, which the floor
        # (SPEC.md III.9) does not link. The mantissa and exponent are
        # read off the bits and shifted into place instead; the caller
        # has already refused what does not fit.
        def unsafe_{{ conv[0].id }} : {{ conv[1].id }}
          bits = IyiFloatText.bits_of(self)
          biased = ((bits >> 52) & 0x7ff_u64).to_i32
          return 0_{{ conv[1] == "Int128" ? "i128".id : "u128".id }} if biased < 1023
          mantissa = ((bits & 0xfffffffffffff_u64) | 0x10000000000000_u64).to_u128
          shift = biased - 1075
          magnitude = shift >= 0 ? mantissa << shift : mantissa >> (0 - shift)
          {% if conv[1] == "Int128" %}
            if (bits >> 63) == 1_u64
              return -170141183460469231731687303715884105728_i128 if magnitude == (1_u128 << 127)
              0_i128 - magnitude.to_i128
            else
              magnitude.to_i128
            end
          {% else %}
            magnitude
          {% end %}
        end
      {% else %}
        @[::Primitive(:unchecked_convert)]
        def unsafe_{{ conv[0].id }} : {{ conv[1].id }}
        end
      {% end %}

      {% unless prelude_convs.includes?(conv[0]) %}
        def {{ conv[0].id }} : {{ conv[1].id }}
          if self != self || {{ float_refuse_low[conv[1]].id }} || self >= {{ float_limits[conv[1]].id }}
            raise "arithmetic overflow"
          end
          unsafe_{{ conv[0].id }}
        end
      {% end %}
    {% end %}
  end

  # --- the operators the prelude writes by hand, for every type it did not --
  {% for t in types %}
    {% name = t[0] %}
    {% bits = t[1] %}
    {% signed = t[2] %}
    {% suffix = t[3] %}
    struct ::{{ name.id }}
      {% unless name == "Int32" || name == "Int64" || name == "UInt64" %}
        # The zero is checked here rather than left to the processor, which
        # reports an integer division by zero as a floating-point fault.
        def //(other : {{ name.id }}) : {{ name.id }}
          raise "division by zero" if other == 0
          {% if signed %}
            # The one division that overflows: the smallest value has no
            # positive twin.
            raise "arithmetic overflow" if self == {{ mins[name].id }}_{{ suffix.id }} && other == -1
          {% end %}
          unsafe_div(other)
        end

        def %(other : {{ name.id }}) : {{ name.id }}
          raise "modulo by zero" if other == 0
          {% if signed %}
            # Zero, and it fits: only the division underneath traps.
            return 0_{{ suffix.id }} if self == {{ mins[name].id }}_{{ suffix.id }} && other == -1
          {% end %}
          unsafe_mod(other)
        end
      {% end %}

      {% unless name == "Int32" || name == "Int64" %}
        # A shift by the width or more answers zero (or the sign, shifting a
        # negative value right), which the processor does not promise.
        def <<(count : Int32) : {{ name.id }}
          count >= {{ bits }} || count < 0 ? 0_{{ suffix.id }} : unsafe_shl(count)
        end

        def >>(count : Int32) : {{ name.id }}
          {% if signed %}
            count >= {{ bits }} || count < 0 ? (self < 0 ? -1_{{ suffix.id }} : 0_{{ suffix.id }}) : unsafe_shr(count)
          {% else %}
            count >= {{ bits }} || count < 0 ? 0_{{ suffix.id }} : unsafe_shr(count)
          {% end %}
        end

        {% if signed %}
          def - : {{ name.id }}
            0_{{ suffix.id }} - self
          end

          def abs : {{ name.id }}
            self < 0 ? -self : self
          end
        {% else %}
          def abs : {{ name.id }}
            self
          end
        {% end %}
      {% end %}

      {% unless prelude.includes?(name) %}
        {% if bits < 64 %}
          # Fits an `Int64`: the prelude's printer.
          def to_s : String
            to_i64.to_s
          end

          def to_s(base : Int32) : String
            to_i64.to_s(base)
          end

          def hash : Int32
            {% if bits < 32 || signed %} to_i32 {% else %} unsafe_shr(1).to_i32 ^ (self & 1).to_i32 {% end %}
          end
        {% else %}
          # Digits backward, the negative magnitude divided rather than
          # negated so the smallest value prints (its negation is not one of
          # the type).
          def to_s : String
            to_s(10)
          end

          def to_s(base : Int32) : String
            raise "base out of range" if base < 2 || base > 36
            return "0" if self == 0

            radix = base.{{ (signed ? "to_i128" : "to_u128").id }}
            negative = self < 0
            digits = [] of Int32
            temp = self
            while temp != 0
              rem = temp % radix
              {% if signed %}
                digits << (rem < 0 ? (-rem).to_i32 : rem.to_i32)
              {% else %}
                digits << rem.to_i32
              {% end %}
              temp = temp // radix
            end

            bytesize = negative ? digits.size + 1 : digits.size
            String.new(bytesize) do |buffer|
              at = 0
              if negative
                buffer[0] = 45_u8
                at = 1
              end
              rev = digits.size - 1
              while rev >= 0
                d = digits[rev]
                buffer[at] = d < 10 ? (48 + d).to_u8 : (87 + d).to_u8
                at = at + 1
                rev = rev - 1
              end
            end
          end

          def hash : Int32
            mix = (self ^ unsafe_shr(64)) & 18446744073709551615_u64
            mix = mix ^ mix.unsafe_shr(32)
            (mix & 2147483647).to_i32
          end
        {% end %}
      {% end %}

      # --- the bits, counted with a logical shift for every type ----------
      # A negative value has its sign bits counted: `(-1).popcount` is 32,
      # one loop of the type's width.
      def popcount : Int32
        count = 0
        i = 0
        while i < {{ bits }}
          count = count + 1 if (unsafe_shr(i) & 1) != 0
          i = i + 1
        end
        count
      end

      def leading_zeros_count : Int32
        i = {{ bits }} - 1
        while i >= 0
          return {{ bits }} - 1 - i if (unsafe_shr(i) & 1) != 0
          i = i - 1
        end
        {{ bits }}
      end

      def trailing_zeros_count : Int32
        i = 0
        while i < {{ bits }}
          return i if (unsafe_shr(i) & 1) != 0
          i = i + 1
        end
        {{ bits }}
      end

      # Bits needed to write the value, the sign excluded: `255.bit_length`
      # is 8, `(-1).bit_length` is 0 and `(-2).bit_length` is 1.
      def bit_length : Int32
        {% if signed %}
          x = self < 0 ? ~self : self
          {{ bits }} - x.leading_zeros_count
        {% else %}
          {{ bits }} - leading_zeros_count
        {% end %}
      end

      def ~ : {{ name.id }}
        {% if signed %}
          self ^ -1_{{ suffix.id }}
        {% else %}
          self ^ {{ maxs[name].id }}_{{ suffix.id }}
        {% end %}
      end
    end
  {% end %}
{% end %}

struct ::Int
  def <=>(other : self) : Int32
    self < other ? -1 : (self > other ? 1 : 0)
  end

  # Bit `n`, 0 or 1; a bit past the width is 0 (or the sign).
  def bit(n : Int32) : Int32
    ((self >> n) & 1).to_i32
  end

  def bits_set?(mask : self) : Bool
    (self & mask) == mask
  end

  def gcd(other : self) : self
    a = abs
    b = other.abs
    while b != 0
      t = b
      b = a % b
      a = t
    end
    a
  end

  def lcm(other : self) : self
    return self - self if self == 0 || other == 0
    (abs // gcd(other)) * other.abs
  end

  # The digits, least significant first: `1234.digits` is `[4, 3, 2, 1]`.
  # A negative number has no digits in this sense and is refused.
  def digits(base : Int32 = 10) : Array(Int32)
    raise "base out of range: #{base}" if base < 2
    raise "digits of a negative number: #{self}" if self < 0
    return [0] if self == 0
    result = [] of Int32
    temp = self
    while temp > 0
      result << temp.unsafe_mod(base).to_i32
      temp = temp.unsafe_div(base)
    end
    result
  end

  # The character with this code, ASCII: the prelude's `Int32#chr`
  # contract for every integer type.
  def chr : Char
    raise "#{self} is out of char range" if self < 0 || self > 127
    to_u8.unsafe_chr
  end
end
