# Exercises std/ocsp: OCSP responses read and checked, requests built.
#
# With no argument: responses Python's cryptography 46 built with its
# OCSPResponseBuilder - from the issuer itself, by name and by key hash,
# from a delegated responder with and without id-pkix-ocsp-nocheck, and
# from responders that may not answer (no id-kp-OCSPSigning, only
# anyExtendedKeyUsage, out of its time, issued by another CA, not
# allowed digitalSignature, not carried), signed by another key, for
# another certificate or another issuer's key, out of their time or just
# inside the skew, without nextUpdate, under SHA-256 and SHA-512 CertIDs,
# with a nonce, under RSA and Ed25519, and unsuccessful ones - and
# responses written by hand in DER for what that builder will not write
# (a version written out, a UTCTime, a CertStatus of no kind, a reason
# CRLReason lacks, another response type, responseStatus 4, a CertID
# under MD5 or with a short hash or another issuer's name hash, an
# extension twice, a ResponderID of no kind, no SingleResponse, a
# critical extension, a nonce that is not an OCTET STRING, a nextUpdate
# before its thisUpdate, a byte after it all, and SHA-1). Each is judged
# at 2026-11-01 and the verdict is held to the one written here; then
# every truncation and flipped byte of two responses refused, requests
# held to OpenSSL's and Python's bytes, and the TLS Feature and nocheck
# extensions read. The vectors were made once and are kept: the keys that
# signed them are gone. The modes the gate script drives:
#   judge FILE      each line `name|response|leaf|issuer|now`, the
#                   response DER, the certificates PEM, now a Unix time:
#                   `name|verdict` - good, revoked or unknown, or why
#                   refused: malformed, signer, certid or time;
#   dump FILE       each line `name|response`: what the response says, a
#                   line of fields in the form the gate's Python writes;
#   request LEAF ISSUER HASH NONCE OUT
#                   the request for LEAF (PEM) under HASH (sha1 or
#                   sha256), with NONCE (hex) or none (-), written to OUT;
#   vectors DIR     the responses and certificates above written to DIR,
#                   and DIR/list: `name|response|leaf|issuer|verdict|hash`
#                   for OpenSSL to judge as well, under the CertID's hash.

import std/ocsp::{OcspResponse, OcspError, OcspCertStatus, OcspHash, OcspCertId, Ocsp, OcspVerdict}
import std/x509::{Certificate, X509Error}
import std/time::{Time}
import std/file::{File}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def hex_of(bytes : Array(UInt8)) : String
  bytes.map { |x| (x < 16_u8 ? "0" : "") + x.to_s(16) }.join("")
end

def cert(hex : String) : Certificate
  Certificate.parse(b(hex)).or_panic
end

def bytes_of(path : String) : Array(UInt8)
  held = File.read(path)
  Array(UInt8).new(held.bytesize) { |i| held.to_unsafe[i] }
end

def text_of(bytes : Array(UInt8)) : String
  String.new(bytes.size) { |p| p.copy_from(bytes.to_unsafe, bytes.size) }
end

def pem_cert(path : String) : Certificate
  Certificate.from_pem(File.read(path)).or_panic[0]
end

NOW = Time.utc(2026, 11, 1)

# What a response says of *leaf*, *issuer* its issuer, at *now*: "good,
# from the issuer", "revoked at <time>, <reason>", "unknown, from a
# delegated responder", or "refused: <why>".
def outcome(der : Array(UInt8), leaf : Certificate, issuer : Certificate, now : Time = NOW) : String
  response = OcspResponse.parse(der)
  return "refused: #{response.message}" if response.is_a?(OcspError)
  verdict = response.verify(leaf, issuer, now)
  return "refused: #{verdict.message}" if verdict.is_a?(OcspError)
  from = verdict.delegated ? "from a delegated responder" : "from the issuer"
  if verdict.status == OcspCertStatus::Revoked
    reason = verdict.single.revocation_reason
    return "revoked at #{verdict.single.revocation_time}, #{reason ? Ocsp.reason_name(reason) : "no reason"}, #{from}"
  end
  "#{verdict.status.word}, #{from}"
end

# A refusal by the step that made it, as the gate compares it with
# OpenSSL's: the response not read (malformed), the signer (signer), no
# SingleResponse for the leaf (certid), or its time (time); else the
# status.
def category(der : Array(UInt8), leaf : Certificate, issuer : Certificate, now : Time) : String
  response = OcspResponse.parse(der)
  return "malformed" if response.is_a?(OcspError)
  verdict = response.verify(leaf, issuer, now)
  if verdict.is_a?(OcspError)
    return "certid" if verdict.message.includes?("no response here is for")
    return "time" if verdict.message.includes?("Update")
    return "signer"
  end
  verdict.status.word
end

# The vectors: certificates, then responses, then requests' DER.
REQ_SHA1                        = "30433041303f303d303b300906052b0e03021a050004145d87907f09f60f8d305ab6d0697281005be2687e0414887d9a73fad3dc60fe0ca44d7ef6fbfc3f87619102021001"
REQ_SHA256                      = "305f305d305b30593057300d060960864801650304020105000420a0d55bb7b0a0eeb9eff995cd0d278d42186f5157dfd07a10fd21a9e3011205f20420f26c2334101559f08340dd5e906b9b082c9f4b23cf2c55dde7100a8d1152557c02021001"
REQ_NONCE                       = "30683066303f303d303b300906052b0e03021a050004145d87907f09f60f8d305ab6d0697281005be2687e0414887d9a73fad3dc60fe0ca44d7ef6fbfc3f87619102021001a2233021301f06092b0601050507300102041204100102030405060708090a0b0c0d0e0f10"
