# The prelude's collections at their edges - SPEC.md, "0.1.0", item 3.
#
#     bash bench/collections_exercise.sh
#
# `Array`, `Hash` and `Set` are three of the six things a program gets, and
# what a program does to them at the edges is what this file is: a key
# written twice, a table grown past its first capacity, a key deleted and
# the rest still findable, keys that all hash to one slot, an array appended
# to itself, an empty receiver asked for its first element.
#
# The one defect this file was written for: `a.concat(a)` walked *other*'s
# size while `<<` grew it, so it never reached the end - it grew the buffer
# until the capacity arithmetic overflowed and `[1, 2].concat(itself)` died
# of "arithmetic overflow".
#
# The panics belong to the driver, because a panicking program has no next
# line to assert on.
module main

def assert_true(condition : Bool, msg : String) : Nil
  raise "assert failed: #{msg}" unless condition
end

def assert_int(actual : Int32, expected : Int32, msg : String) : Nil
  raise "assert failed: #{msg} (#{actual} != #{expected})" unless actual == expected
end

def assert_str(actual : String, expected : String, msg : String) : Nil
  raise "assert failed: #{msg} (#{actual} != #{expected})" unless actual == expected
end

# ---- Hash: one key, one entry, whatever it is written with
counts = {} of String => Int32
counts["a"] = 1
counts["a"] = 2
assert_int(counts.size, 1, "hash: a key written twice is one entry")
assert_int(counts["a"]? || 0, 2, "hash: the second write is the value")

# Past the first capacity, which is where a table rebuilds its index
wide = {} of Int32 => Int32
i = 0
while i < 64
  wide[i] = i * 10
  i = i + 1
end
assert_int(wide.size, 64, "hash: sixty-four keys are sixty-four entries")
missed = 0
i = 0
while i < 64
  missed = missed + 1 if wide[i]? != i * 10
  i = i + 1
end
assert_int(missed, 0, "hash: every key survives the growth")

# A delete has to remove its own and leave the keys that probed past it
i = 0
while i < 64
  wide.delete(i) if i % 2 == 0
  i = i + 1
end
assert_int(wide.size, 32, "hash: deletes leave half")
gone = 0
kept = 0
i = 0
while i < 64
  if i % 2 == 0
    gone = gone + 1 if wide[i]? == nil
  else
    kept = kept + 1 if wide[i]? == i * 10
  end
  i = i + 1
end
assert_int(gone, 32, "hash: the deleted are gone")
assert_int(kept, 32, "hash: the rest are findable")

walked = 0
wide.each { |key, value| walked = walked + 1 }
assert_int(walked, wide.size, "hash: each counts what size says")
assert_int(wide.keys.size, wide.size, "hash: keys is as long as size")
assert_int(wide.values.size, wide.size, "hash: values is as long as size")

# Emptied and used again
i = 0
while i < 64
  wide.delete(i)
  i = i + 1
end
assert_true(wide.empty?, "hash: emptied")
assert_int(wide.size, 0, "hash: empty size")
wide[7] = 70
assert_int(wide[7]? || 0, 70, "hash: refilled after emptying")

# A key nobody put in
absent = {} of String => Int32
absent["x"] = 1
assert_true(absent.delete("y") == nil, "hash: deleting a missing key is nil")
assert_int(absent.size, 1, "hash: a missing delete removes nothing")
assert_true(absent.has_key?("x"), "hash: the survivor is still there")

# Keys that share one slot by construction: `Array` has an `==` of its own
# and takes `Object`'s hash, so every array key lands in the same slot and
# the comparison is what finds it.
crowded = {} of Array(Int32) => Int32
i = 0
while i < 16
  crowded[[i]] = i
  i = i + 1
end
wrong = 0
i = 0
while i < 16
  wrong = wrong + 1 if crowded[[i]]? != i
  i = i + 1
end
assert_int(wrong, 0, "hash: colliding keys are all findable")
crowded.delete([8])
assert_true(crowded[[8]]? == nil, "hash: one of the crowd deleted")
assert_int(crowded[[9]]? || -1, 9, "hash: its neighbour survives")
assert_int(crowded[[7]]? || -1, 7, "hash: and the one before it")

# The order `each` promises, which is the order they went in
order = {} of String => Int32
order["z"] = 1
order["a"] = 2
order["m"] = 3
names = order.keys
assert_str(names[0], "z", "hash: first in, first out")
assert_str(names[1], "a", "hash: second")
assert_str(names[2], "m", "hash: third")

# ---- Set
members = Set(Int32).new
members.add(1)
members.add(2)
members.add(1)
assert_int(members.size, 2, "set: the same value once")
assert_true(members.delete(1), "set: delete says it was there")
assert_true(members.delete(1) == false, "set: and says when it was not")
assert_int(members.size, 1, "set: size after a delete")
assert_true(members.includes?(2), "set: the other one is still in")
walked = 0
members.each { |value| walked = walked + 1 }
assert_int(walked, members.size, "set: each counts what size says")
assert_int(members.to_a.size, members.size, "set: to_a is as long as size")

others = Set(Int32).new
others.add(2)
others.add(3)
assert_int((members - others).size, 0, "set: difference removes what is shared")
assert_int((others - members).size, 1, "set: and keeps what is not")
assert_int(Set(Int32).new.size, 0, "set: an empty one is empty")

# ---- Array
three = [1, 2, 3]
assert_int(three[-1], 3, "array: the last through a negative index")
assert_int(three[-3], 1, "array: the first through a negative index")
assert_true(three[-4]? == nil, "array: past the start is nil")
assert_true(three[3]? == nil, "array: past the end is nil")
assert_int(three.first(2).size, 2, "array: first n")
assert_int(three.first(9).size, 3, "array: first n past the end is all of it")
assert_int([3, 1, 3, 2, 1].uniq.size, 3, "array: uniq")
assert_int([1, 2, 3].reversed[0], 3, "array: reversed")
assert_int([3, 1, 2].sorted[0], 1, "array: sorted")
assert_int([1, 2].concat([3]).size, 3, "array: concat")

# The defect: an array appended to itself is a doubling, not a loop.
doubling = [1, 2]
doubling.concat(doubling)
assert_int(doubling.size, 4, "array: concat with itself doubles")
assert_int(doubling[2], 1, "array: and copies what was there")
assert_int(doubling[3], 2, "array: including the last of it")

# An empty array answers the questions that have answers
nothing = [] of Int32
assert_int(nothing.size, 0, "array: empty size")
assert_true(nothing.empty?, "array: empty?")
assert_true(nothing.last? == nil, "array: empty last? is nil")
assert_str(nothing.join, "", "array: empty join is empty")
assert_int(nothing.sorted.size, 0, "array: empty sorted")
assert_int(nothing.uniq.size, 0, "array: empty uniq")
assert_int(nothing.count { |value| true }, 0, "array: empty count")
assert_true(nothing.index(1) == nil, "array: empty index is nil")

# Growth through `<<`, which is the other half of the buffer's arithmetic
grown = [] of Int32
i = 0
while i < 1000
  grown << i
  i = i + 1
end
assert_int(grown.size, 1000, "array: a thousand appends")
assert_int(grown[999], 999, "array: the last one is there")
assert_int(grown[0], 0, "array: and the first")
i = 0
while i < 500
  grown.pop
  i = i + 1
end
assert_int(grown.size, 500, "array: five hundred pops")
assert_int(grown[499], 499, "array: the new last")

# ---- Range, whose walk used to step past its own end
# `value <= @end` meant the last step left the type on the checked `+`, so a
# range ending at the type's maximum panicked at the value it was asked to
# yield last.
assert_int((2147483645..2147483647).to_a.size, 3, "range: up to the type's maximum")
assert_int((2147483645..2147483647).to_a[2], 2147483647, "range: and the maximum is in it")
assert_int((1..3).to_a.size, 3, "range: inclusive counts both ends")
assert_int((1...3).to_a.size, 2, "range: exclusive drops the end")
assert_int((3..1).to_a.size, 0, "range: backwards is empty")
assert_int((5..5).to_a.size, 1, "range: one value")
assert_int((5...5).to_a.size, 0, "range: no values")
assert_int((1..4).sum, 10, "range: sum")

# The forms a port writes first: a filled array, two joined, a table
# with a default - a value, or a block that may store what it answers -
# and a table's pairs as an array to sort.
filled = Array.new(4, 7)
assert_int(filled.size, 4, "array: filled has the size asked")
assert_int(filled[3], 7, "array: filled with the value")
joined = [1, 2] + [3]
assert_int(joined.size, 3, "array: + joins")
assert_int(joined[2], 3, "array: + keeps the order")
counts = Hash(String, Int32).new(0)
assert_int(counts["z"], 0, "hash: a default answers a missing key")
counts["a"] = counts["a"] + 1
counts["a"] = counts["a"] + 1
assert_int(counts["a"], 2, "hash: a default counts")
assert_int(counts.size, 1, "hash: a default is not stored")
squares = Hash(Int32, Int32).new { |table, n| table[n] = n * n }
assert_int(squares[6], 36, "hash: a default block answers")
assert_int(squares.size, 1, "hash: and may store")
pairs = counts.to_a
assert_int(pairs.size, 1, "hash: to_a has a pair per entry")
assert_str(pairs[0][0], "a", "hash: to_a keeps the key")

# A sort is a merge sort, and a large array is where that shows: 100,000
# elements with 50 distinct keys, sorted with a block that counts its calls.
# An insertion sort - what the prelude had, written for five elements -
# makes about n*n/4 comparisons here, 2.5 billion, and never answered for
# three million; a merge sort about n*log2(n), 1.7 million. The order must
# be ascending and, for equal keys, the order the elements came in.
class Keyed
  getter key : Int32
  getter seq : Int32

  def initialize(@key : Int32, @seq : Int32)
  end
end

class Tally
  @@calls = 0_i64

  # Past the bound the sort is not a merge sort, and waiting out the rest
  # of an insertion sort's billions is a minute; the check fails here.
  def self.bump : Nil
    @@calls = @@calls + 1
    raise "assert failed: array: a sort of 100,000 made #{@@calls} comparisons, past n*log2(n)" if @@calls > 3000000_i64
  end

  def self.calls : Int64
    @@calls
  end
end

keyed = [] of Keyed
seed = 7
index = 0
while index < 100000
  seed = (seed * 1103 + 12345) % 1000003
  keyed << Keyed.new(seed % 50, index)
  index = index + 1
end
ordered = keyed.sorted do |a, b|
  Tally.bump
  a.key < b.key ? -1 : (a.key > b.key ? 1 : 0)
end
out_of_order = 0
index = 1
while index < ordered.size
  before = ordered[index - 1]
  after = ordered[index]
  out_of_order = out_of_order + 1 if before.key > after.key || (before.key == after.key && before.seq > after.seq)
  index = index + 1
end
assert_int(ordered.size, 100000, "array: a sort keeps every element")
assert_int(out_of_order, 0, "array: a sort is ascending and keeps equal elements in order")
by_key = keyed.sorted_by { |k| k.key }
assert_int(by_key[0].seq, ordered[0].seq, "array: sorted_by keeps equal keys in order")
assert_int(by_key[99999].seq, ordered[99999].seq, "array: sorted_by agrees with sorted")

# Every key type the prelude has spreads its keys: a type without a `hash`
# of its own hashes to its type id, so all its keys share one slot and a
# table of them is a list searched from the front - two million `Int64`
# inserts did not finish in two minutes that way. A thousand distinct keys
# of each type have a thousand distinct hashes (the bytes and characters
# as many as there are).
def spread(hashes : Array(Int32)) : Int32
  seen = {} of Int32 => Bool
  hashes.each { |h| seen[h] = true }
  seen.size
end

assert_int(spread((0...1000).map { |i| (i.to_i64 * 4294967296_i64 + i.to_i64).hash }), 1000, "hash: Int64 keys spread")
assert_int(spread((0...1000).map { |i| (i.to_u64 * 4294967296_u64).hash }), 1000, "hash: UInt64 keys spread")
assert_int(spread((0...256).map { |i| i.to_u8.hash }), 256, "hash: UInt8 keys spread")
assert_int(spread((0...128).map { |i| i.chr.hash }), 128, "hash: Char keys spread")
assert_int(spread((0...1000).map { |i| (i * 0.25).hash }), 1000, "hash: Float64 keys spread")
assert_true(0.0.hash == (-0.0).hash, "hash: 0.0 and -0.0 are one key")

# A class instance is itself, and a set of them finds each one: `Object#==`
# answered false, so an instance did not equal itself and a `Set` never
# found what was added to it. A class that says what equal means keeps
# finding equal instances by it.
class Visit
  def initialize(@id : Int32)
  end
end

class Named
  getter name : String

  def initialize(@name : String)
  end

  def ==(other : Named) : Bool
    name == other.name
  end
end

here = Visit.new(1)
twin = Visit.new(1)
assert_true(here == here, "reference: an instance equals itself")
assert_true(here != twin, "reference: two instances are two")
visits = Set(Visit).new
all_visits = (0...20000).map { |i| Visit.new(i) }
all_visits.each { |v| visits.add(v) }
assert_int(visits.size, 20000, "reference: a set holds each instance once")
assert_true(all_visits.all? { |v| visits.includes?(v) }, "reference: a set finds every instance added")
assert_true(!visits.includes?(twin), "reference: and not one it was not given")
spread_visits = spread(all_visits.first(1000).map { |v| v.hash })
assert_true(spread_visits > 900, "reference: instances hash apart (#{spread_visits} of 1000)")
names = {} of Named => Int32
names[Named.new("a")] = 1
assert_int(names[Named.new("a")]? || 0, 1, "reference: a class's own == finds an equal key")

puts "all collection checks passed"
