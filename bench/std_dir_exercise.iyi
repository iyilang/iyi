# Exercises `std/dir`.
#
# Run via:
#     ./bin/iyi run bench/std_dir_exercise.iyi

module bench/std_dir_exercise

# `Dir.glob`, matching with `File.match?`, is timed against a bound.
import std/time::{Time}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

# Windows answers `Dir.current` in its own form, backslashes and all, while
# every path below is joined with `/`; both name the same directory to every
# Win32 call. So a path compare normalises the separator instead of pinning
# one platform's spelling.
def slashed(path : String) : String
  n = path.bytesize
  bytes = path.to_unsafe
  String.new(n) do |target|
    target.copy_from(bytes, n)
    i = 0
    while i < n
      target[i] = 47_u8 if target[i] == 92_u8
      i = i + 1
    end
  end
end

# The other way, for a `\\?\` path, where Windows reads `/` as a name's
# byte.
def backslashed(path : String) : String
  n = path.bytesize
  bytes = path.to_unsafe
  String.new(n) do |target|
    target.copy_from(bytes, n)
    i = 0
    while i < n
      target[i] = 92_u8 if target[i] == 47_u8
      i = i + 1
    end
  end
end

import std/dir::{Dir}
import std/file::{File}
import std/gc::{GC}

def clean_tree(dir_path : String) : Nil
  return unless Dir.exists?(dir_path)
  Dir.children(dir_path).each do |child|
    full = dir_path + "/" + child
    if Dir.exists?(full)
      clean_tree(full)
      Dir.delete?(full)
    else
      File.delete(full)
    end
  end
end

# How many of *fill* are still *byte* and nothing else.
def filled(fill : Array(String), byte : UInt8) : Int32
  intact = 0
  fill.each do |text|
    same = true
    i = 0
    while i < text.bytesize
      same = false if text.to_unsafe[i] != byte
      i = i + 1
    end
    intact = intact + 1 if same
  end
  intact
end

saved_orig = Dir.current
sandbox_env = Program.env("TEST_SANDBOX")
sandbox = if sandbox_env && !sandbox_env.empty?
            sandbox_env
          else
            Dir.cd(Dir.tempdir)
            s = Dir.current + "/iyi_std_dir_exercise_sandbox"
            Dir.cd(saved_orig)
            s
          end

clean_tree(sandbox)
Dir.delete?(sandbox)

puts "== create, exists and file paths"
assert_true !Dir.exists?(sandbox), "sandbox does not exist yet"
Dir.mkdir(sandbox)
assert_true Dir.exists?(sandbox), "sandbox exists after mkdir"
assert_true Dir.empty?(sandbox), "new sandbox is empty"

non_existent = sandbox + "/non_existent_subdir"
assert_true !Dir.exists?(non_existent), "non-existent path returns false from exists?"
assert_true !Dir.delete?(non_existent), "delete? returns false for non-existent path"

sample_file = sandbox + "/regular_file.txt"
File.write(sample_file, "contents of file")
assert_true File.exists?(sample_file), "file exists on disk"
assert_true !Dir.exists?(sample_file), "Dir.exists? returns false for a regular file"
assert_true !Dir.delete?(sample_file), "Dir.delete? returns false for a regular file"

sub_created = sandbox + "/sub_created"
Dir.mkdir(sub_created)
assert_true Dir.exists?(sub_created), "sub_created directory exists"
assert_true Dir.empty?(sub_created), "sub_created directory is empty"
puts "  create and exists behavior on directories, files, and missing paths"

puts "\n== nested creation with mkdir_p"
nested = sandbox + "/level1/level2/level3"
assert_true !Dir.exists?(nested), "nested target does not exist before mkdir_p"
Dir.mkdir_p(nested)
assert_true Dir.exists?(nested), "nested target exists after mkdir_p"
assert_true Dir.exists?(sandbox + "/level1"), "parent level1 exists"
assert_true Dir.exists?(sandbox + "/level1/level2"), "parent level2 exists"

# mkdir_p is idempotent when the target already exists
Dir.mkdir_p(nested)
assert_true Dir.exists?(nested), "nested target still exists after second mkdir_p"
puts "  nested directory hierarchies and idempotence"

puts "\n== list entries and dot entries policy"
listing_dir = sandbox + "/listing"
Dir.mkdir(listing_dir)
File.write(listing_dir + "/file_a.txt", "alpha")
File.write(listing_dir + "/file_b.txt", "beta")
Dir.mkdir(listing_dir + "/nested_dir")

# entries includes . and ..
ents = Dir.entries(listing_dir)
assert_true ents.includes?("."), "entries includes ."
assert_true ents.includes?(".."), "entries includes .."
assert_true ents.includes?("file_a.txt"), "entries includes file_a.txt"
assert_true ents.includes?("file_b.txt"), "entries includes file_b.txt"
assert_true ents.includes?("nested_dir"), "entries includes nested_dir"
assert_true ents.size == 5, "entries size is 5 including dot entries"

# children excludes . and ..
kids = Dir.children(listing_dir)
assert_true !kids.includes?("."), "children excludes ."
assert_true !kids.includes?(".."), "children excludes .."
assert_true kids.includes?("file_a.txt"), "children includes file_a.txt"
assert_true kids.includes?("file_b.txt"), "children includes file_b.txt"
assert_true kids.includes?("nested_dir"), "children includes nested_dir"
assert_true kids.size == 3, "children size is 3 excluding dot entries"

# iteration forms
all_count = 0
Dir.each(listing_dir) do |_|
  all_count = all_count + 1
end
assert_true all_count == 5, "Dir.each visits all entries including dot entries"

child_count = 0
Dir.each_child(listing_dir) do |_|
  child_count = child_count + 1
end
assert_true child_count == 3, "Dir.each_child visits children excluding dot entries"

# Dir instance methods, rewind and stream navigation
Dir.open(listing_dir) do |dir|
  assert_str listing_dir, dir.path, "instance path matches opened path"
  assert_true dir.to_s.includes?(listing_dir), "to_s includes the opened path"
  assert_true dir.to_s.includes?("#<Dir:"), "to_s uses the Dir inspect form"
  assert_true !dir.closed?, "opened dir instance is not closed"
  first_entry = dir.read
  assert_true first_entry != nil, "first read returns an entry"
  dir.rewind
  second_entry = dir.read
  assert_true second_entry != nil, "read after rewind returns an entry"
  if first_entry && second_entry
    assert_str first_entry, second_entry, "rewind restores stream to start"
  end
  entries_list = dir.entries
  assert_true entries_list.size == 5, "dir.entries returns 5 items"
  children_list = dir.children
  assert_true children_list.size == 3, "dir.children returns 3 items"
end

# Manual open and close
d_manual = Dir.new(listing_dir)
assert_true !d_manual.closed?, "d_manual is open"
d_manual.close
assert_true d_manual.closed?, "d_manual is closed after close call"
d_manual.close
assert_true d_manual.closed?, "d_manual remains closed after idempotent close"
puts "  entries, children, and dot entry filtering policies"

puts "\n== entries read across a collection"
# The buffer an open directory reads entries into is the stream's own
# memory. It was a block the stream kept by its address as an integer,
# which the collector does not read as a reference: a collection with the
# directory open freed it, and the next entries were written into what had
# the memory then - measured on Windows, a live String came to hold an
# entry's name, and `Dir.glob` over 4,000 files died of a memory fault.
# Strings the size of each platform's buffer, 592 bytes on Windows and 32
# KiB on Linux, are made after each collection to take that memory.
many_dir = sandbox + "/many"
Dir.mkdir(many_dir)
200.times { |i| File.write(many_dir + "/entry_#{i}.txt", "") }
small_fill = [] of String
large_fill = [] of String
seen = [] of String
reader = Dir.new(many_dir)
if first_seen = reader.read
  seen << first_seen
end
GC.collect
2000.times { small_fill << "A" * 600 }
8.times { large_fill << "B" * 32800 }
while name_seen = reader.read
  seen << name_seen
end
reader.close
entry_names = 0
seen.each { |name| entry_names = entry_names + 1 if name.starts_with?("entry_") && name.ends_with?(".txt") }
assert_true seen.size == 202 && entry_names == 200, "every entry is read across a collection: #{seen.size} names, #{entry_names} entries"

tree = sandbox + "/tree"
8.times do |i|
  Dir.mkdir_p(tree + "/d#{i}/e")
  6.times { |j| File.write(tree + "/d#{i}/e/f#{j}.txt", "") }
end
walked = 0
3.times do
  Dir.glob(tree + "/**/*.txt") do |_|
    walked = walked + 1
    if walked % 7 == 0
      GC.collect
      8.times { small_fill << "A" * 600 }
      large_fill << "B" * 32800
    end
  end
end
assert_true walked == 144, "three globs across collections find 48 files each: #{walked}"
assert_true filled(small_fill, 65_u8) == small_fill.size && filled(large_fill, 66_u8) == large_fill.size,
  "no string made with a directory open was written over: #{small_fill.size - filled(small_fill, 65_u8)} and #{large_fill.size - filled(large_fill, 66_u8)}"
puts "  a directory read and a glob walked across collections, nothing written over"

puts "\n== glob star, recursive, hidden, and no-match"
File.write(listing_dir + "/.hidden_glob", "h")
glob_txt = Dir.glob(listing_dir + "/*.txt")
assert_true glob_txt.size == 2, "Dir.glob *.txt matches two files"
assert_true glob_txt.any? { |p| p.includes?("file_a.txt") }, "glob includes file_a.txt"
assert_true glob_txt.any? { |p| p.includes?("file_b.txt") }, "glob includes file_b.txt"

glob_star = Dir.glob(listing_dir + "/*")
assert_true glob_star.any? { |p| p.includes?("file_a.txt") }, "glob * includes visible file"
assert_true glob_star.any? { |p| p.includes?("nested_dir") }, "glob * includes nested dir"
assert_true !glob_star.any? { |p| p.includes?(".hidden_glob") }, "glob * skips hidden names"

glob_deep = Dir.glob(listing_dir + "/**/*.txt")
assert_true glob_deep.size == 2, "recursive glob finds both txt files"
assert_true Dir.glob(listing_dir + "/no_such_pattern_*").empty?, "no-match glob is empty"
assert_true Dir[listing_dir + "/*.txt"].size == 2, "Dir[] is glob"
# A wildcard before the last segment, and a pattern that starts `./`:
# both answered `[]`. And a path spelled with the pattern's separator, on
# every walk: on Windows one answered `\` and the other `/`.
Dir.mkdir(listing_dir + "/nested_dir/inner")
File.write(listing_dir + "/nested_dir/inner/deep.txt", "d")
File.write(listing_dir + "/nested_dir/one.txt", "o")
middle = Dir.glob(listing_dir + "/nest*/*.txt")
assert_true middle.size == 1 && middle[0] == listing_dir + "/nested_dir/one.txt", "a wildcard in a middle segment finds nested_dir/one.txt: #{middle.inspect}"
two_down = Dir.glob(listing_dir + "/*/*/deep.txt")
assert_true two_down.size == 1 && two_down[0] == listing_dir + "/nested_dir/inner/deep.txt", "two wildcard segments find deep.txt: #{two_down.inspect}"
assert_str listing_dir + "/file_a.txt", Dir.glob(listing_dir + "/file_a.*")[0], "a match is spelled with the pattern's own separator"
here = Dir.current
Dir.cd(listing_dir)
dotted = Dir.glob("./*.txt").sorted
Dir.cd(here)
assert_true dotted == ["./file_a.txt", "./file_b.txt"], "./*.txt answers the names under ./: #{dotted.inspect}"
# A class or a brace in a middle segment, which `File.match?` reads, and
# a brace whose branches have different depths.
braced_middle = Dir.glob(listing_dir + "/{nested_dir,none}/*.txt")
assert_true braced_middle == [listing_dir + "/nested_dir/one.txt"], "a brace in a middle segment: #{braced_middle.inspect}"
classed_middle = Dir.glob(listing_dir + "/nested_[d]ir/inner/*.txt")
assert_true classed_middle == [listing_dir + "/nested_dir/inner/deep.txt"], "a class in a middle segment: #{classed_middle.inspect}"
uneven = Dir.glob(listing_dir + "/{nested_dir/inner,none}/*.txt")
assert_true uneven == [listing_dir + "/nested_dir/inner/deep.txt"], "a brace holding a separator: #{uneven.inspect}"
File.delete(listing_dir + "/nested_dir/inner/deep.txt")
File.delete(listing_dir + "/nested_dir/one.txt")
Dir.delete(listing_dir + "/nested_dir/inner")
# The pattern language is `File.match?`'s, and so is the algorithm. `?`
# took one byte, so `?.txt` missed `ü.txt`; a class and a brace were
# literal text, so `file_[ab].*` and `*.{txt,md}` answered `[]`; a `**`
# matched from inside a name, so `**/*.txt` answered `.dotted.txt` by its
# `dotted.txt`; and a `*` backtracked at every position, four times slower
# for each star - nine against one forty-character name took 30 seconds.
File.write(listing_dir + "/ü.txt", "u")
File.write(listing_dir + "/notes.md", "m")
one_char = Dir.glob(listing_dir + "/?.txt")
assert_true one_char == [listing_dir + "/ü.txt"], "? is one character, both bytes of ü: #{one_char.inspect}"
classed = Dir.glob(listing_dir + "/file_[ab].*").sorted
assert_true classed == [listing_dir + "/file_a.txt", listing_dir + "/file_b.txt"], "a class matches: #{classed.inspect}"
braced = Dir.glob(listing_dir + "/*.{txt,md}").sorted
assert_true braced == [listing_dir + "/file_a.txt", listing_dir + "/file_b.txt", listing_dir + "/notes.md", listing_dir + "/ü.txt"], "a brace matches: #{braced.inspect}"
File.write(listing_dir + "/.dotted.txt", "d")
starred_deep = Dir.glob(listing_dir + "/**/*.txt").sorted
assert_true starred_deep == [listing_dir + "/file_a.txt", listing_dir + "/file_b.txt", listing_dir + "/ü.txt"], "** and * answer no hidden name, nor the rest of one: #{starred_deep.inspect}"
dot_named = Dir.glob(listing_dir + "/.*").sorted
assert_true dot_named == [listing_dir + "/.dotted.txt", listing_dir + "/.hidden_glob"], "a segment written with a leading . answers hidden names: #{dot_named.inspect}"
File.delete(listing_dir + "/.dotted.txt")
File.write(listing_dir + "/" + "a" * 40, "")
started = Time.monotonic
starred = Dir.glob(listing_dir + "/" + "*a" * 9 + "*b")
assert_true starred.empty? && (Time.monotonic - started).total_milliseconds < 2000, "nine stars against a forty-character name answer in under 2 seconds"
File.delete(listing_dir + "/" + "a" * 40)
File.delete(listing_dir + "/ü.txt")
File.delete(listing_dir + "/notes.md")
puts "  File.match?'s language and linear time"
puts "  glob matching, hidden names, recursion, and empty results"

puts "\n== current working directory and cd"
current_before = Dir.current
Dir.cd(sub_created) do
  assert_str slashed(sub_created), slashed(Dir.current), "Dir.current inside cd block matches target"
  # A relative path expands under the directory the program is in, not
  # under the one `PWD` named when it started: `Dir.cd` left `PWD` behind,
  # and `expand_path` reads it first.
  if Program.env("PWD")
    assert_str slashed(sub_created) + "/x", slashed(File.expand_path("x")), "expand_path after Dir.cd is under the new directory"
  end
end
assert_str current_before, Dir.current, "Dir.current restored after cd block"
puts "  temporary directory change with automatic restore"

puts "\n== delete empty and non-empty directories"
# non-empty directory cannot be removed
assert_true !Dir.empty?(listing_dir), "listing_dir is not empty"
assert_true !Dir.delete?(listing_dir), "delete? returns false for non-empty directory"
assert_true Dir.exists?(listing_dir), "listing_dir remains intact"

# empty directory can be removed
empty_dir = sandbox + "/empty_for_delete"
Dir.mkdir(empty_dir)
assert_true Dir.empty?(empty_dir), "empty_dir is empty"
assert_true Dir.delete?(empty_dir), "delete? returns true for empty directory"
assert_true !Dir.exists?(empty_dir), "empty_dir is removed"

# Dir.rmdir works for empty directory
rmdir_dir = sandbox + "/empty_for_rmdir"
Dir.mkdir(rmdir_dir)
Dir.rmdir(rmdir_dir)
assert_true !Dir.exists?(rmdir_dir), "rmdir removes empty directory"

# A read-only directory is still the parent's to remove. POSIX's
# `rmdir` asks the parent for permission and Windows asks the
# directory, which refuses with ERROR_ACCESS_DENIED while it carries
# FILE_ATTRIBUTE_READONLY — the attribute `File.chmod(path, 0o444)`
# sets. Measured before the retry: a directory its owner had marked
# read-only could not be removed at all on Windows, and came off
# everywhere else.
locked_dir = sandbox + "/readonly_dir"
Dir.mkdir(locked_dir)
File.chmod(locked_dir, 0o444)
Dir.delete(locked_dir)
assert_true !Dir.exists?(locked_dir), "a read-only directory is still the parent's to remove"
puts "  deletion outcomes for empty and non-empty paths"

{% if flag?(:win32) %}
  puts "\n== windows roots, drives and the \\\\?\\ form"
  # The current drive's root, spelled three ways, is one listing - `\`
  # and `/` alone panicked, the pattern built from them naming a network
  # path.
  drive = Dir.current[0, 2]
  root_kids = Dir.children(drive + "\\")
  assert_true !root_kids.empty?, "the drive's root lists"
  assert_true Dir.children("\\").size == root_kids.size, "Dir.children(\"\\\\\") is the drive's root"
  assert_true Dir.children("/").size == root_kids.size, "Dir.children(\"/\") is the drive's root"

  # A bare drive is that drive's current directory, not its root.
  Dir.cd(sandbox) do
    here = Dir.current[0, 2]
    assert_true Dir.children(here).includes?("regular_file.txt"), "Dir.children(\"C:\") lists the current directory on C:"

    # And a drive-relative path is created there, not at the root.
    root_stray = here + "\\iyi_dir_exercise_drive_rel"
    Dir.mkdir_p(here + "iyi_dir_exercise_drive_rel\\inner")
    stray = Dir.exists?(root_stray)
    if stray
      Dir.delete?(root_stray + "\\inner")
      Dir.delete?(root_stray)
    end
    assert_true !stray, "mkdir_p(\"C:rel\\\\x\") made nothing at the drive's root"
    assert_true Dir.exists?(sandbox + "/iyi_dir_exercise_drive_rel/inner"), "mkdir_p(\"C:rel\\\\x\") made rel\\x in the current directory"
  end

  # Under `\\?\` Windows does not parse the path again, and `/` there is
  # a name's byte rather than a separator.
  prefixed = "\\\\?\\" + backslashed(sandbox) + "\\prefixed\\two\\three"
  Dir.mkdir_p(prefixed)
  assert_true Dir.exists?(sandbox + "/prefixed/two/three"), "mkdir_p makes every segment of a \\\\?\\ path"

  # The device namespace's `\\.\` names what `\\?\` names, and past 248
  # characters it was taken for a share, `\\?\UNC\.\C:\...`, which names
  # nothing: a long directory spelled with it did not exist.
  long_dir = backslashed(sandbox) + "\\" + ("d" * 60) + "\\" + ("e" * 60) + "\\" + ("f" * 60) + "\\" + ("g" * 60)
  Dir.mkdir_p("\\\\?\\" + long_dir)
  File.write("\\\\?\\" + long_dir + "\\long.txt", "deep")
  assert_true long_dir.bytesize > 248, "the long directory is past the limit: #{long_dir.bytesize}"
  assert_true Dir.exists?("\\\\.\\" + long_dir), "a long directory spelled with \\\\.\\ exists"
  assert_str "deep", File.read("\\\\.\\" + long_dir + "\\long.txt"), "a long file spelled with \\\\.\\ reads"

  # A drive's root keeps the separator that makes it the root.
  assert_str "C:\\", Dir.without_trailing_separator("C:\\"), "a drive's root keeps its separator"
  assert_str "C:\\tmp", Dir.without_trailing_separator("C:\\tmp\\"), "any other directory drops it"
  puts "  roots, bare drives, drive-relative and \\\\?\\ paths"
{% end %}

# Cleanup sandbox
clean_tree(sandbox)
Dir.delete?(sandbox)
assert_true !Dir.exists?(sandbox), "sandbox removed after exercise"

# An empty path names no directory, as POSIX `opendir("")` fails: on
# Windows it listed the current drive's root while `Dir.exists?("")` said
# false.
listed = "listed"
group do |g|
  empty = g.spawn { Dir.children(""); 0 }
  outcome = empty.value
  listed = outcome.is_a?(Panicked) ? outcome.message.to_s : "listed"
  0
end
assert_true !Dir.exists?("") && listed.includes?("Cannot open directory"), "Dir.children(\"\") is refused, not #{listed}"

puts "\nALL CHECKS PASSED"
