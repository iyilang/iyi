# Exercises `std/nil`: singleton identity, hashing, conversions, IyiIO printing,
# try semantics, NilAssertionError, and nil-safety flow typing.
#
# Run via:
#     ./bin/iyi run bench/std_nil_exercise.iyi

module bench/std_nil_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/nil

class RefSample
end

def flow_truthy_narrowing(val : String?) : String
  if val
    "present:#{val}"
  else
    "absent"
  end
end

def flow_nil_predicate(val : Int32?) : Int32
  if val.nil?
    -1
  else
    val * 2
  end
end

def flow_default_or(val : String?) : String
  val || "fallback"
end

puts "== singleton and identity"
assert_true nil.object_id == 0_u64, "object_id is 0"
assert_true nil.same?(nil), "same? with nil is true"
ref = RefSample.new
assert_true !nil.same?(ref), "same? with reference is false"
assert_true nil.clone.nil?, "clone is nil"
assert_true nil.presence.nil?, "presence is nil"
puts "  object_id, same?, clone, presence"

puts "\n== equality and hashing"
assert_true (nil == nil) == true, "nil equals nil"
assert_true nil.hash == 0, "hash is 0"
assert_true nil.hash == nil.hash, "hash is stable"
puts "  equality and zero hash"

puts "\n== conversions and string forms"
assert_str "", nil.to_s, "to_s is empty string"
assert_str "nil", nil.inspect, "inspect is 'nil'"
assert_str "value: []", "value: [#{nil}]", "interpolation uses to_s"

tmp_to_s = "/tmp/iyi_std_nil_test_to_s.txt"
tmp_inspect = "/tmp/iyi_std_nil_test_inspect.txt"

File.open(tmp_to_s, "w") do |io|
  nil.to_s(io)
end
assert_str "", File.read(tmp_to_s), "to_s(io) writes nothing"

File.open(tmp_inspect, "w") do |io|
  nil.inspect(io)
end
assert_str "nil", File.read(tmp_inspect), "inspect(io) writes 'nil'"

File.delete(tmp_to_s)
File.delete(tmp_inspect)
puts "  to_s, inspect, interpolation, and IyiIO writing"

puts "\n== control flow and try"
yielded = false
res = nil.try do
  yielded = true
  "should not run"
end
assert_true res.nil?, "try returns nil"
assert_true !yielded, "try does not yield to block"
puts "  try returns nil without yielding"

puts "\n== nil-safety flow typing"
assert_str "present:hello", flow_truthy_narrowing("hello"), "truthy present"
assert_str "absent", flow_truthy_narrowing(nil), "truthy absent"
assert_true flow_nil_predicate(21) == 42, "nil? predicate present"
assert_true flow_nil_predicate(nil) == -1, "nil? predicate absent"
assert_str "given", flow_default_or("given"), "defaulting present"
assert_str "fallback", flow_default_or(nil), "defaulting absent"
puts "  truthiness narrowing, nil? predicate, and || defaulting"

puts "\n== NilAssertionError"
err_default = NilAssertionError.new
assert_str "Nil assertion failed", err_default.message, "default error message"
err_custom = NilAssertionError.new("custom assertion error")
assert_str "custom assertion error", err_custom.message, "custom error message"
puts "  default and custom assertion error messages"

puts "\nALL CHECKS PASSED"
