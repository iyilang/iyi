# Native JSON standard library implementation for iyi.
#
# Provides:
# - `JSON.parse(string : String) : JSON::Any`
# - `JSON.build(indent = nil, &block)`
# - `JSON::Any` dynamic traversing wrapper
# - `JSON::PullParser` streaming pull parser
# - `JSON::Builder` streaming JSON serializer
# - `JSON::Error` and `JSON::ParseException`
#
# Number resolution rules:
# 1. If the number literal contains a fractional point ('.'), an exponent ('e'/'E'),
#    or is negative zero ('-0', '-0.0'), it is parsed as Float64. Negative zero
#    preserves the IEEE 754 sign bit.
# 2. If the number literal is an integer without decimal point or exponent:
#    - If it fits in signed 64-bit integer range (-9223372036854775808..9223372036854775807),
#      it is parsed as Int64.
#    - If it exceeds Int64 range, it falls back to Float64 so precision is preserved
#      to the limits of IEEE 754 without overflow panic.

module std/json

import std/text

pub class Error < Exception
  getter message : String

  def initialize(@message : String)
  end
end

pub class ParseException < Error
  getter line_number : Int32
  getter column_number : Int32

  def initialize(reason : String, @line_number : Int32, @column_number : Int32)
    super("#{reason} at line #{@line_number}, column #{@column_number}")
  end
end

def raise(error : Std::Json::Error) : NoReturn
  raise error.message
end

# Internal growable byte buffer for string accumulation
class StringBuffer
  @buffer : Pointer(UInt8)
  @capacity : Int32
  @size : Int32

  def initialize(initial_capacity : Int32 = 64)
    @capacity = initial_capacity < 16 ? 16 : initial_capacity
    @buffer = Pointer(UInt8).malloc(@capacity.to_u64)
    @size = 0
  end

  def size : Int32
    @size
  end

  def empty? : Bool
    @size == 0
  end

  def clear : Nil
    @size = 0
  end

  def append(byte : UInt8) : Nil
    ensure_capacity(@size + 1)
    @buffer[@size] = byte
    @size = @size + 1
  end

  def append(str : String) : Nil
    len = str.bytesize
    return if len == 0
    ensure_capacity(@size + len)
    (@buffer + @size).copy_from(str.to_unsafe, len)
    @size = @size + len
  end

  def append_char(char : Char) : Nil
    ord = char.ord
    append_codepoint(ord)
  end

  def append_codepoint(codepoint : Int32) : Nil
    if codepoint <= 0x7F
      append(codepoint.to_u8)
    elsif codepoint <= 0x7FF
      append((0xC0 | (codepoint >> 6)).to_u8)
      append((0x80 | (codepoint & 0x3F)).to_u8)
    elsif codepoint <= 0xFFFF
      append((0xE0 | (codepoint >> 12)).to_u8)
      append((0x80 | ((codepoint >> 6) & 0x3F)).to_u8)
      append((0x80 | (codepoint & 0x3F)).to_u8)
    else
      append((0xF0 | (codepoint >> 18)).to_u8)
      append((0x80 | ((codepoint >> 12) & 0x3F)).to_u8)
      append((0x80 | ((codepoint >> 6) & 0x3F)).to_u8)
      append((0x80 | (codepoint & 0x3F)).to_u8)
    end
  end

  def ensure_capacity(needed : Int32) : Nil
    return if needed <= @capacity
    while @capacity < needed
      @capacity = @capacity * 2
    end
    @buffer = @buffer.realloc(@capacity.to_u64)
  end

  def to_s : String
    len = @size
    ptr = @buffer
    String.new(len) do |target|
      target.copy_from(ptr, len)
    end
  end
end

pub struct Any
  alias Type = Nil | Bool | Int64 | Float64 | String | Array(Any) | Hash(String, Any)

  getter raw : Type

  def initialize(@raw : Type)
  end

  def self.new(val : Int32) : Any
    new(val.to_i64)
  end

  def as_nil : Nil
    @raw.as(Nil)
  end

  def as_nil? : Nil?
    @raw.nil? ? nil : nil
  end

  def as_bool : Bool
    @raw.as(Bool)
  end

  def as_bool? : Bool?
    case r = @raw
    when Bool then r
    else           nil
    end
  end

  def as_i : Int32
    case r = @raw
    when Int64
      if r < -2147483648_i64 || r > 2147483647_i64
        raise "integer #{r} out of Int32 range"
      end
      r.to_i32
    else
      raise "expected Int, not #{r.class}"
    end
  end

  def as_i? : Int32?
    case r = @raw
    when Int64
      if r >= -2147483648_i64 && r <= 2147483647_i64
        r.to_i32
      else
        nil
      end
    else
      nil
    end
  end

  def as_i64 : Int64
    @raw.as(Int64)
  end

  def as_i64? : Int64?
    case r = @raw
    when Int64 then r
    else            nil
    end
  end

  def as_f : Float64
    case r = @raw
    when Float64 then r
    when Int64   then r.to_f64
    else              raise "expected Float, not #{r.class}"
    end
  end

  def as_f? : Float64?
    case r = @raw
    when Float64 then r
    when Int64   then r.to_f64
    else              nil
    end
  end

  def as_s : String
    @raw.as(String)
  end

  def as_s? : String?
    case r = @raw
    when String then r
    else             nil
    end
  end

  def as_a : Array(Any)
    @raw.as(Array(Any))
  end

  def as_a? : Array(Any)?
    case r = @raw
    when Array(Any) then r
    else                 nil
    end
  end

  def as_h : Hash(String, Any)
    @raw.as(Hash(String, Any))
  end

  def as_h? : Hash(String, Any)?
    case r = @raw
    when Hash(String, Any) then r
    else                        nil
    end
  end

  def size : Int32
    case r = @raw
    when Array(Any)        then r.size
    when Hash(String, Any) then r.size
    else                        raise "expected Array or Hash for #size, not #{r.class}"
    end
  end

  def size? : Int32?
    case r = @raw
    when Array(Any)        then r.size
    when Hash(String, Any) then r.size
    else                        nil
    end
  end

  def [](index : Int32) : Any
    case r = @raw
    when Array(Any)
      actual = index < 0 ? index + r.size : index
      if actual < 0 || actual >= r.size
        raise "index out of bounds: #{index} for size #{r.size}"
      end
      r[actual]
    else
      raise "expected Array for #[](index : Int32), not #{r.class}"
    end
  end

  def []?(index : Int32) : Any?
    case r = @raw
    when Array(Any)
      actual = index < 0 ? index + r.size : index
      if actual < 0 || actual >= r.size
        nil
      else
        r[actual]
      end
    else
      nil
    end
  end

  def [](key : String) : Any
    case r = @raw
    when Hash(String, Any)
      if r.has_key?(key)
        r[key]
      else
        raise "missing hash key: #{key.inspect}"
      end
    else
      raise "expected Hash for #[](key : String), not #{r.class}"
    end
  end

  def []?(key : String) : Any?
    case r = @raw
    when Hash(String, Any)
      r.has_key?(key) ? r[key] : nil
    else
      nil
    end
  end

  def dig?(key : String) : Any?
    self[key]?
  end

  def dig?(index : Int32) : Any?
    self[index]?
  end

  def dig?(k : String, *subkeys : String | Int32) : Any?
    v = self[k]?
    return nil unless v
    v.dig?(*subkeys)
  end

  def dig?(idx : Int32, *subkeys : String | Int32) : Any?
    v = self[idx]?
    return nil unless v
    v.dig?(*subkeys)
  end

  def dig(key : String) : Any
    self[key]
  end

  def dig(index : Int32) : Any
    self[index]
  end

  def dig(k : String, *subkeys : String | Int32) : Any
    v = self[k]
    v.dig(*subkeys)
  end

  def dig(idx : Int32, *subkeys : String | Int32) : Any
    v = self[idx]
    v.dig(*subkeys)
  end

  def ==(other : Any) : Bool
    case a = @raw
    when Nil
      other.raw.nil?
    when Bool
      other.raw.is_a?(Bool) && a == other.raw.as(Bool)
    when Int64
      if other.raw.is_a?(Int64)
        a == other.raw.as(Int64)
      elsif other.raw.is_a?(Float64)
        a.to_f64 == other.raw.as(Float64)
      else
        false
      end
    when Float64
      if other.raw.is_a?(Float64)
        a == other.raw.as(Float64)
      elsif other.raw.is_a?(Int64)
        a == other.raw.as(Int64).to_f64
      else
        false
      end
    when String
      other.raw.is_a?(String) && a == other.raw.as(String)
    when Array(Any)
      if other.raw.is_a?(Array(Any))
        b = other.raw.as(Array(Any))
        return false if a.size != b.size
        i = 0
        while i < a.size
          return false unless a[i] == b[i]
          i = i + 1
        end
        true
      else
        false
      end
    when Hash(String, Any)
      if other.raw.is_a?(Hash(String, Any))
        b = other.raw.as(Hash(String, Any))
        return false if a.size != b.size
        a.each do |k, v|
          return false unless b.has_key?(k) && v == b[k]
        end
        true
      else
        false
      end
    else
      false
    end
  end

  def to_json(builder : Builder) : Nil
    if @raw.nil?
      builder.null
    elsif @raw.is_a?(Bool)
      builder.bool(@raw.as(Bool))
    elsif s = as_s?
      builder.string(s)
    elsif i = as_i64?
      builder.number(i)
    elsif f = as_f?
      builder.number(f)
    elsif a = as_a?
      builder.start_array
      idx = 0
      while idx < a.size
        a[idx].to_json(builder)
        idx = idx + 1
      end
      builder.end_array
    elsif h = as_h?
      builder.start_object
      keys = h.keys
      idx = 0
      while idx < keys.size
        k = keys[idx]
        builder.field(k)
        h[k].to_json(builder)
        idx = idx + 1
      end
      builder.end_object
    end
  end

  def to_json : String
    b = Builder.new
    to_json(b)
    b.to_s
  end

  def to_pretty_json(indent : Int32 = 2) : String
    b = Builder.new
    b.indent = indent
    to_json(b)
    b.to_s
  end

  def to_ascii_json : String
    b = Builder.new
    b.ascii_only = true
    to_json(b)
    b.to_s
  end

  def to_s : String
    to_json
  end

  def inspect : String
    to_json
  end
end

enum TokenKind
  Null
  False
  True
  Int
  Float
  String
  BeginArray
  EndArray
  BeginObject
  EndObject
  Colon
  Comma
  EOF
end

class Token
  property kind : TokenKind
  property raw_value : String
  property string_value : String
  property int_value : Int64
  property float_value : Float64
  property line_number : Int32
  property column_number : Int32

  def initialize
    @kind = TokenKind::EOF
    @raw_value = ""
    @string_value = ""
    @int_value = 0_i64
    @float_value = 0.0
    @line_number = 1
    @column_number = 1
  end
end

class Lexer
  @input : String
  @bytes : Pointer(UInt8)
  @bytesize : Int32
  @pos : Int32
  @line_number : Int32
  @column_number : Int32
  @token : Token
  @string_buffer : StringBuffer

  def initialize(@input : String)
    @bytes = @input.to_unsafe
    @bytesize = @input.bytesize
    @pos = 0
    @line_number = 1
    @column_number = 1
    @token = Token.new
    @string_buffer = StringBuffer.new(64)
  end

  def token : Token
    @token
  end

  def line_number : Int32
    @line_number
  end

  def column_number : Int32
    @column_number
  end

  private def parse_error(reason : String, line : Int32 = @line_number, col : Int32 = @column_number) : NoReturn
    raise "#{reason} at line #{line}, column #{col}"
  end

  private def current_byte : UInt8
    @pos < @bytesize ? @bytes[@pos] : 0_u8
  end

  private def advance : UInt8
    b = current_byte
    if b != 0_u8 || @pos < @bytesize
      if b == 10_u8 # '\n'
        @line_number = @line_number + 1
        @column_number = 1
      else
        # Count UTF-8 character columns: continuation bytes (0x80..0xBF) do not advance column
        if (b & 0xC0_u8) != 0x80_u8
          @column_number = @column_number + 1
        end
      end
      @pos = @pos + 1
    end
    current_byte
  end

  def skip_whitespace : Nil
    while @pos < @bytesize
      b = current_byte
      if b == 32_u8 || b == 9_u8 || b == 10_u8 || b == 13_u8 # ' ', '\t', '\n', '\r'
        advance
      else
        break
      end
    end
  end

  def next_token : Token
    skip_whitespace

    tok_line = @line_number
    tok_col = @column_number

    if @pos >= @bytesize
      @token.kind = TokenKind::EOF
      @token.line_number = tok_line
      @token.column_number = tok_col
      return @token
    end

    b = current_byte
    case b
    when 123_u8 # '{'
      advance
      set_token(TokenKind::BeginObject, tok_line, tok_col)
    when 125_u8 # '}'
      advance
      set_token(TokenKind::EndObject, tok_line, tok_col)
    when 91_u8 # '['
      advance
      set_token(TokenKind::BeginArray, tok_line, tok_col)
    when 93_u8 # ']'
      advance
      set_token(TokenKind::EndArray, tok_line, tok_col)
    when 58_u8 # ':'
      advance
      set_token(TokenKind::Colon, tok_line, tok_col)
    when 44_u8 # ','
      advance
      set_token(TokenKind::Comma, tok_line, tok_col)
    when 34_u8 # '"'
      consume_string(tok_line, tok_col)
    when 116_u8 # 't'
      consume_true(tok_line, tok_col)
    when 102_u8 # 'f'
      consume_false(tok_line, tok_col)
    when 110_u8 # 'n'
      consume_null(tok_line, tok_col)
    when 45_u8, 48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8 # '-', '0'..'9'
      consume_number(tok_line, tok_col)
    else
      # Bare identifier or unexpected character
      if (b >= 97_u8 && b <= 122_u8) || (b >= 65_u8 && b <= 90_u8) || b == 95_u8
        consume_bare_identifier(tok_line, tok_col)
      else
        ch = b.unsafe_chr
        advance
        parse_error("unexpected character '#{ch}'", tok_line, tok_col)
      end
    end

    @token
  end

  private def set_token(kind : TokenKind, line : Int32, col : Int32) : Nil
    @token.kind = kind
    @token.line_number = line
    @token.column_number = col
  end

  private def consume_bare_identifier(line : Int32, col : Int32) : NoReturn
    start = @pos
    while @pos < @bytesize
      b = current_byte
      if (b >= 97_u8 && b <= 122_u8) || (b >= 65_u8 && b <= 90_u8) || (b >= 48_u8 && b <= 57_u8) || b == 95_u8
        advance
      else
        break
      end
    end
    ident = @input[start, @pos - start]
    parse_error("bare identifier '#{ident}'", line, col)
  end

  private def consume_true(line : Int32, col : Int32) : Nil
    advance                   # 't'
    if current_byte == 114_u8 # 'r'
      advance
      if current_byte == 117_u8 # 'u'
        advance
        if current_byte == 101_u8 # 'e'
          advance
          # Ensure next byte is not alphanumeric/identifier
          b = current_byte
          if is_identifier_byte(b)
            consume_bare_identifier(line, col)
          end
          set_token(TokenKind::True, line, col)
          return
        end
      end
    end
    consume_bare_identifier(line, col)
  end

  private def consume_false(line : Int32, col : Int32) : Nil
    advance                  # 'f'
    if current_byte == 97_u8 # 'a'
      advance
      if current_byte == 108_u8 # 'l'
        advance
        if current_byte == 115_u8 # 's'
          advance
          if current_byte == 101_u8 # 'e'
            advance
            b = current_byte
            if is_identifier_byte(b)
              consume_bare_identifier(line, col)
            end
            set_token(TokenKind::False, line, col)
            return
          end
        end
      end
    end
    consume_bare_identifier(line, col)
  end

  private def consume_null(line : Int32, col : Int32) : Nil
    advance                   # 'n'
    if current_byte == 117_u8 # 'u'
      advance
      if current_byte == 108_u8 # 'l'
        advance
        if current_byte == 108_u8 # 'l'
          advance
          b = current_byte
          if is_identifier_byte(b)
            consume_bare_identifier(line, col)
          end
          set_token(TokenKind::Null, line, col)
          return
        end
      end
    end
    consume_bare_identifier(line, col)
  end

  private def is_identifier_byte(b : UInt8) : Bool
    (b >= 97_u8 && b <= 122_u8) || (b >= 65_u8 && b <= 90_u8) || (b >= 48_u8 && b <= 57_u8) || b == 95_u8
  end

  private def consume_string(line : Int32, col : Int32) : Nil
    advance # consume opening '"'
    start_pos = @pos
    has_escape = false

    # Scan forward to see if string has escapes or unescaped control chars
    while @pos < @bytesize
      b = current_byte
      if b == 34_u8 # '"'
        break
      elsif b == 92_u8 # '\\'
        has_escape = true
        break
      elsif b < 32_u8
        parse_error("unescaped control character (ASCII #{b}) in string", @line_number, @column_number)
      else
        advance
      end
    end

    if !has_escape && @pos < @bytesize && current_byte == 34_u8
      # Fast path: substring without escapes
      str_val = @input[start_pos, @pos - start_pos]
      advance # consume closing '"'
      set_token(TokenKind::String, line, col)
      @token.string_value = str_val
      return
    end

    if @pos >= @bytesize
      parse_error("unterminated string", line, col)
    end

    # Slow path: accumulate in @string_buffer
    @string_buffer.clear
    if @pos > start_pos
      # Append prefix scanned so far
      len = @pos - start_pos
      prefix_str = @input[start_pos, len]
      @string_buffer.append(prefix_str)
    end

    while @pos < @bytesize
      b = current_byte
      if b == 34_u8 # '"'
        advance
        set_token(TokenKind::String, line, col)
        @token.string_value = @string_buffer.to_s
        return
      elsif b == 92_u8 # '\\'
        esc_col = @column_number
        advance
        if @pos >= @bytesize
          parse_error("unterminated string after backslash", line, esc_col)
        end
        esc = current_byte
        case esc
        when 34_u8 # '"'
          @string_buffer.append(34_u8)
          advance
        when 92_u8 # '\\'
          @string_buffer.append(92_u8)
          advance
        when 47_u8 # '/'
          @string_buffer.append(47_u8)
          advance
        when 98_u8 # 'b'
          @string_buffer.append(8_u8)
          advance
        when 102_u8 # 'f'
          @string_buffer.append(12_u8)
          advance
        when 110_u8 # 'n'
          @string_buffer.append(10_u8)
          advance
        when 114_u8 # 'r'
          @string_buffer.append(13_u8)
          advance
        when 116_u8 # 't'
          @string_buffer.append(9_u8)
          advance
        when 117_u8 # 'u'
          u_line = @line_number
          u_col = @column_number - 1
          advance
          hex1 = read_hex4(u_line, u_col)

          if hex1 >= 0xD800 && hex1 <= 0xDBFF
            # High surrogate: must be immediately followed by '\u' and low surrogate 0xDC00..0xDFFF
            if current_byte != 92_u8 # '\'
              parse_error("lone high surrogate \\u#{hex1.to_s(16)} without low surrogate", u_line, u_col)
            end
            advance
            if current_byte != 117_u8 # 'u'
              parse_error("lone high surrogate \\u#{hex1.to_s(16)} without following \\u escape", u_line, u_col)
            end
            u2_line = @line_number
            u2_col = @column_number - 1
            advance
            hex2 = read_hex4(u2_line, u2_col)
            if hex2 < 0xDC00 || hex2 > 0xDFFF
              parse_error("invalid surrogate pair: expected low surrogate (0xDC00..0xDFFF), got \\u#{hex2.to_s(16)}", u2_line, u2_col)
            end
            codepoint = 0x10000 + ((hex1 - 0xD800) << 10) + (hex2 - 0xDC00)
            @string_buffer.append_codepoint(codepoint)
          elsif hex1 >= 0xDC00 && hex1 <= 0xDFFF
            # Lone low surrogate
            parse_error("lone low surrogate \\u#{hex1.to_s(16)} without preceding high surrogate", u_line, u_col)
          else
            @string_buffer.append_codepoint(hex1)
          end
        else
          bad_char = esc.unsafe_chr
          advance
          parse_error("invalid escape sequence '\\#{bad_char}'", line, esc_col)
        end
      elsif b < 32_u8
        parse_error("unescaped control character (ASCII #{b}) in string", @line_number, @column_number)
      else
        @string_buffer.append(b)
        advance
      end
    end

    parse_error("unterminated string", line, col)
  end

  private def read_hex4(line : Int32, col : Int32) : Int32
    val = 0
    i = 0
    while i < 4
      if @pos >= @bytesize
        parse_error("unterminated \\u escape sequence: expected 4 hexadecimal digits", line, col)
      end
      b = current_byte
      d = hex_digit_value(b)
      if d < 0
        parse_error("invalid hex digit '#{b.unsafe_chr}' in \\u escape sequence", @line_number, @column_number)
      end
      val = (val << 4) | d
      advance
      i = i + 1
    end
    val
  end

  private def hex_digit_value(b : UInt8) : Int32
    if b >= 48_u8 && b <= 57_u8 # '0'..'9'
      (b - 48_u8).to_i
    elsif b >= 97_u8 && b <= 102_u8 # 'a'..'f'
      (b - 97_u8).to_i + 10
    elsif b >= 65_u8 && b <= 70_u8 # 'A'..'F'
      (b - 65_u8).to_i + 10
    else
      -1
    end
  end

  private def consume_number(line : Int32, col : Int32) : Nil
    start_pos = @pos
    has_fraction = false
    has_exponent = false
    is_negative = false

    if current_byte == 45_u8 # '-'
      is_negative = true
      advance
      if @pos >= @bytesize
        parse_error("expected digit after minus sign in number", line, col)
      end
      b = current_byte
      if b < 48_u8 || b > 57_u8
        parse_error("expected digit after minus sign in number", @line_number, @column_number)
      end
    end

    if current_byte == 48_u8 # '0'
      advance
      if @pos < @bytesize
        next_b = current_byte
        if next_b >= 48_u8 && next_b <= 57_u8
          parse_error("leading zero not allowed in number", @line_number, @column_number)
        end
      end
    elsif current_byte >= 49_u8 && current_byte <= 57_u8 # '1'..'9'
      advance
      while @pos < @bytesize && current_byte >= 48_u8 && current_byte <= 57_u8
        advance
      end
    else
      parse_error("expected digit in number", @line_number, @column_number)
    end

    if @pos < @bytesize && current_byte == 46_u8 # '.'
      has_fraction = true
      advance
      if @pos >= @bytesize
        parse_error("expected at least one digit after decimal point", line, col)
      end
      if current_byte < 48_u8 || current_byte > 57_u8
        parse_error("expected at least one digit after decimal point", @line_number, @column_number)
      end
      while @pos < @bytesize && current_byte >= 48_u8 && current_byte <= 57_u8
        advance
      end
    end

    if @pos < @bytesize && (current_byte == 101_u8 || current_byte == 69_u8) # 'e' or 'E'
      has_exponent = true
      advance
      if @pos < @bytesize && (current_byte == 43_u8 || current_byte == 45_u8) # '+' or '-'
        advance
      end
      if @pos >= @bytesize
        parse_error("expected at least one digit in exponent", line, col)
      end
      if current_byte < 48_u8 || current_byte > 57_u8
        parse_error("expected at least one digit in exponent", @line_number, @column_number)
      end
      while @pos < @bytesize && current_byte >= 48_u8 && current_byte <= 57_u8
        advance
      end
    end

    # Check for invalid trailing characters like '0x12' or '1a'
    if @pos < @bytesize
      tail_b = current_byte
      if (tail_b >= 97_u8 && tail_b <= 122_u8) || (tail_b >= 65_u8 && tail_b <= 90_u8) || tail_b == 46_u8
        parse_error("unexpected character '#{tail_b.unsafe_chr}' in number", @line_number, @column_number)
      end
    end

    raw_num = @input[start_pos, @pos - start_pos]
    set_token(TokenKind::Int, line, col)
    @token.raw_value = raw_num

    if has_fraction || has_exponent || raw_num == "-0"
      @token.kind = TokenKind::Float
      @token.float_value = raw_num.to_f
    else
      # Integer without fraction/exponent
      val = parse_int64_safe?(raw_num)
      if val
        @token.kind = TokenKind::Int
        @token.int_value = val
      else
        # Exceeds Int64 range: fall back to Float64
        @token.kind = TokenKind::Float
        @token.float_value = raw_num.to_f
      end
    end
  end

  private def parse_int64_safe?(text : String) : Int64?
    return nil if text.empty?
    negative = false
    start = 0
    if text.starts_with?('-')
      negative = true
      start = 1
    end
    return nil if start >= text.bytesize

    if negative
      limit_div_10 = -922337203685477580_i64
      limit_mod_10 = -8_i64
      val = 0_i64
      i = start
      while i < text.bytesize
        b = text.to_unsafe[i]
        return nil if b < 48_u8 || b > 57_u8
        d = 0_i64 - (b - 48_u8).to_i64
        if val < limit_div_10 || (val == limit_div_10 && d < limit_mod_10)
          return nil # Overflow negative
        end
        val = val * 10_i64 + d
        i = i + 1
      end
      val
    else
      limit_div_10 = 922337203685477580_i64
      limit_mod_10 = 7_i64
      val = 0_i64
      i = start
      while i < text.bytesize
        b = text.to_unsafe[i]
        return nil if b < 48_u8 || b > 57_u8
        d = (b - 48_u8).to_i64
        if val > limit_div_10 || (val == limit_div_10 && d > limit_mod_10)
          return nil # Overflow positive
        end
        val = val * 10_i64 + d
        i = i + 1
      end
      val
    end
  end
end

pub struct Parser
  @lexer : Lexer
  property max_nesting : Int32
  @nesting : Int32

  def initialize(input : String)
    @lexer = Lexer.new(input)
    @max_nesting = 512
    @nesting = 0
    @lexer.next_token
  end

  private def token : Token
    @lexer.token
  end

  private def next_token : Token
    @lexer.next_token
  end

  private def parse_error(reason : String, line : Int32 = token.line_number, col : Int32 = token.column_number) : NoReturn
    raise "#{reason} at line #{line}, column #{col}"
  end

  def parse : Any
    if token.kind == TokenKind::EOF
      parse_error("empty JSON input", 1, 1)
    end
    result = parse_value
    unless token.kind == TokenKind::EOF
      parse_error("unexpected token after JSON root value")
    end
    result
  end

  private def parse_value : Any
    case token.kind
    when TokenKind::Null
      next_token
      Any.new(nil)
    when TokenKind::True
      next_token
      Any.new(true)
    when TokenKind::False
      next_token
      Any.new(false)
    when TokenKind::Int
      val = token.int_value
      next_token
      Any.new(val)
    when TokenKind::Float
      val = token.float_value
      next_token
      Any.new(val)
    when TokenKind::String
      str = token.string_value
      next_token
      Any.new(str)
    when TokenKind::BeginArray
      parse_array
    when TokenKind::BeginObject
      parse_object
    else
      parse_error("unexpected token '#{token.raw_value.empty? ? token.kind.to_s : token.raw_value}'")
    end
  end

  private def parse_array : Any
    line = token.line_number
    col = token.column_number

    @nesting = @nesting + 1
    if @nesting > @max_nesting
      parse_error("nesting depth of #{@nesting} exceeds maximum depth #{@max_nesting}", line, col)
    end

    next_token # consume '['
    ary = [] of Any

    if token.kind == TokenKind::EndArray
      next_token # consume ']'
      @nesting = @nesting - 1
      return Any.new(ary)
    end

    while true
      ary << parse_value
      case token.kind
      when TokenKind::Comma
        comma_line = token.line_number
        comma_col = token.column_number
        next_token
        if token.kind == TokenKind::EndArray
          parse_error("trailing comma in array", comma_line, comma_col)
        end
      when TokenKind::EndArray
        break
      else
        parse_error("expected ',' or ']' in array")
      end
    end

    next_token # consume ']'
    @nesting = @nesting - 1
    Any.new(ary)
  end

  private def parse_object : Any
    line = token.line_number
    col = token.column_number

    @nesting = @nesting + 1
    if @nesting > @max_nesting
      parse_error("nesting depth of #{@nesting} exceeds maximum depth #{@max_nesting}", line, col)
    end

    next_token # consume '{'
    obj = {} of String => Any

    if token.kind == TokenKind::EndObject
      next_token # consume '}'
      @nesting = @nesting - 1
      return Any.new(obj)
    end

    while true
      unless token.kind == TokenKind::String
        parse_error("expected string key in object")
      end
      key = token.string_value
      key_line = token.line_number
      key_col = token.column_number
      if obj.has_key?(key)
        parse_error("duplicate key '#{key}'", key_line, key_col)
      end

      next_token # consume key
      unless token.kind == TokenKind::Colon
        parse_error("expected ':' after object key")
      end
      next_token # consume ':'

      val = parse_value
      obj[key] = val

      case token.kind
      when TokenKind::Comma
        comma_line = token.line_number
        comma_col = token.column_number
        next_token
        if token.kind == TokenKind::EndObject
          parse_error("trailing comma in object", comma_line, comma_col)
        end
      when TokenKind::EndObject
        break
      else
        parse_error("expected ',' or '}' in object")
      end
    end

    next_token # consume '}'
    @nesting = @nesting - 1
    Any.new(obj)
  end
end

pub class PullParser
  enum Kind
    Null
    Bool
    Int
    Float
    String
    BeginArray
    EndArray
    BeginObject
    EndObject
    EOF

    def null? : ::Bool
      self == Kind::Null
    end

    def bool? : ::Bool
      self == Kind::Bool
    end

    def int? : ::Bool
      self == Kind::Int
    end

    def float? : ::Bool
      self == Kind::Float
    end

    def string? : ::Bool
      self == Kind::String
    end

    def begin_array? : ::Bool
      self == Kind::BeginArray
    end

    def end_array? : ::Bool
      self == Kind::EndArray
    end

    def begin_object? : ::Bool
      self == Kind::BeginObject
    end

    def end_object? : ::Bool
      self == Kind::EndObject
    end

    def eof? : ::Bool
      self == Kind::EOF
    end
  end
  @lexer : Lexer
  getter kind : Kind
  getter bool_value : Bool
  getter int_value : Int64
  getter float_value : Float64
  getter string_value : String
  getter raw_value : String
  property max_nesting : Int32
  @nesting : Int32
  @stack : Array(Int32) # 1 = array, 2 = object

  def initialize(input : String)
    @lexer = Lexer.new(input)
    @kind = Kind::EOF
    @bool_value = false
    @int_value = 0_i64
    @float_value = 0.0
    @string_value = ""
    @raw_value = ""
    @max_nesting = 512
    @nesting = 0
    @stack = [] of Int32
    read_next
  end

  def line_number : Int32
    @lexer.token.line_number
  end

  def column_number : Int32
    @lexer.token.column_number
  end

  private def parse_error(reason : String, line : Int32 = line_number, col : Int32 = column_number) : NoReturn
    raise "#{reason} at line #{line}, column #{col}"
  end

  def read_next : Kind
    tok = @lexer.next_token
    case tok.kind
    when TokenKind::Null
      @kind = Kind::Null
    when TokenKind::True
      @kind = Kind::Bool
      @bool_value = true
    when TokenKind::False
      @kind = Kind::Bool
      @bool_value = false
    when TokenKind::Int
      @kind = Kind::Int
      @int_value = tok.int_value
      @raw_value = tok.raw_value
    when TokenKind::Float
      @kind = Kind::Float
      @float_value = tok.float_value
      @raw_value = tok.raw_value
    when TokenKind::String
      @kind = Kind::String
      @string_value = tok.string_value
    when TokenKind::BeginArray
      @nesting = @nesting + 1
      if @nesting > @max_nesting
        parse_error("nesting depth #{@nesting} exceeds maximum depth #{@max_nesting}")
      end
      @stack << 1
      @kind = Kind::BeginArray
    when TokenKind::EndArray
      if @stack.empty? || @stack.pop != 1
        parse_error("unexpected end of array")
      end
      @nesting = @nesting - 1
      @kind = Kind::EndArray
    when TokenKind::BeginObject
      @nesting = @nesting + 1
      if @nesting > @max_nesting
        parse_error("nesting depth #{@nesting} exceeds maximum depth #{@max_nesting}")
      end
      @stack << 2
      @kind = Kind::BeginObject
    when TokenKind::EndObject
      if @stack.empty? || @stack.pop != 2
        parse_error("unexpected end of object")
      end
      @nesting = @nesting - 1
      @kind = Kind::EndObject
    when TokenKind::Comma, TokenKind::Colon
      # internal tokens: advance to next meaningful token
      return read_next
    when TokenKind::EOF
      @kind = Kind::EOF
    end
    @kind
  end

  def read_begin_array : Nil
    unless @kind == Kind::BeginArray
      parse_error("expected begin of array, got #{@kind}")
    end
    read_next
  end

  def read_end_array : Nil
    unless @kind == Kind::EndArray
      parse_error("expected end of array, got #{@kind}")
    end
    read_next
  end

  def read_begin_object : Nil
    unless @kind == Kind::BeginObject
      parse_error("expected begin of object, got #{@kind}")
    end
    read_next
  end

  def read_end_object : Nil
    unless @kind == Kind::EndObject
      parse_error("expected end of object, got #{@kind}")
    end
    read_next
  end

  def read_object_key : String
    unless @kind == Kind::String
      parse_error("expected object key string, got #{@kind}")
    end
    key = @string_value
    read_next
    key
  end

  def read_null : Nil
    unless @kind == Kind::Null
      parse_error("expected null, got #{@kind}")
    end
    read_next
    nil
  end

  def read_bool : Bool
    unless @kind == Kind::Bool
      parse_error("expected bool, got #{@kind}")
    end
    val = @bool_value
    read_next
    val
  end

  def read_int : Int64
    unless @kind == Kind::Int
      parse_error("expected int, got #{@kind}")
    end
    val = @int_value
    read_next
    val
  end

  def read_float : Float64
    case @kind
    when Kind::Float
      val = @float_value
      read_next
      val
    when Kind::Int
      val = @int_value.to_f64
      read_next
      val
    else
      parse_error("expected float, got #{@kind}")
    end
  end

  def read_string : String
    unless @kind == Kind::String
      parse_error("expected string, got #{@kind}")
    end
    val = @string_value
    read_next
    val
  end

  def read_array(& : -> Nil) : Nil
    read_begin_array
    while @kind != Kind::EndArray && @kind != Kind::EOF
      yield
    end
    read_end_array
  end

  def read_object(& : String -> Nil) : Nil
    read_begin_object
    while @kind != Kind::EndObject && @kind != Kind::EOF
      key = read_object_key
      yield key
    end
    read_end_object
  end

  def skip : Nil
    case @kind
    when Kind::Null, Kind::Bool, Kind::Int, Kind::Float, Kind::String
      read_next
    when Kind::BeginArray
      read_begin_array
      while @kind != Kind::EndArray && @kind != Kind::EOF
        skip
      end
      read_end_array
    when Kind::BeginObject
      read_begin_object
      while @kind != Kind::EndObject && @kind != Kind::EOF
        read_object_key
        skip
      end
      read_end_object
    else
      read_next
    end
  end

  def location_i64 : Tuple(Int32, Int32)
    {line_number, column_number}
  end

  def read_null? : Bool
    if @kind == Kind::Null
      read_next
      true
    else
      false
    end
  end

  def on_key(key : String, & : -> Nil) : Nil
    read_begin_object
    found = false
    while !kind.end_object?
      current_key = read_object_key
      if current_key == key
        found = true
        yield
      else
        skip
      end
    end
    read_end_object
    unless found
      parse_error("Missing JSON key: #{key}")
    end
  end

  def read_raw : String
    case @kind
    when Kind::Null
      read_next
      "null"
    when Kind::Bool
      val = @bool_value ? "true" : "false"
      read_next
      val
    when Kind::Int, Kind::Float
      val = @raw_value.empty? ? (@kind == Kind::Int ? @int_value.to_s : @float_value.to_s) : @raw_value
      read_next
      val
    when Kind::String
      val = @string_value
      read_next
      val
    else
      read_next
      ""
    end
  end

  def read_raw(builder : Builder) : Nil
    case @kind
    when Kind::Null
      read_next
      builder.null
    when Kind::Bool
      builder.bool(read_bool)
    when Kind::Int
      builder.number(read_int)
    when Kind::Float
      builder.number(read_float)
    when Kind::String
      builder.string(read_string)
    when Kind::BeginArray
      builder.array do
        read_array do
          read_raw(builder)
        end
      end
    when Kind::BeginObject
      builder.object do
        read_object do |k|
          builder.field(k) do
            read_raw(builder)
          end
        end
      end
    else
      read_next
    end
  end
end

pub class Builder
  @buffer : StringBuffer
  @indent_spaces : Int32
  @indent_str : String?
  @level : Int32
  @state_stack : Array(Int32)
  # States:
  # 0: Document root
  # 1: In array (first element)
  # 2: In array (subsequent element)
  # 3: In object (expect key, first)
  # 4: In object (expect key, subsequent)
  # 5: In object (expect value)

  property max_nesting : Int32
  property ascii_only : Bool

  def initialize(initial_capacity : Int32 = 64)
    @buffer = StringBuffer.new(initial_capacity)
    @indent_spaces = -1
    @indent_str = nil
    @level = 0
    @state_stack = [0]
    @max_nesting = 512
    @ascii_only = false
  end

  def indent=(spaces : Int32) : Nil
    @indent_spaces = spaces
    if spaces >= 0
      @indent_str = " " * spaces
    else
      @indent_str = nil
    end
  end

  def indent=(str : String) : Nil
    @indent_str = str
    @indent_spaces = str.size
  end

  def indent=(nil_val : Nil) : Nil
    @indent_spaces = -1
    @indent_str = nil
  end

  def current_state : Int32
    @state_stack.last
  end

  private def set_current_state(s : Int32) : Nil
    @state_stack[@state_stack.size - 1] = s
  end

  private def write_indent : Nil
    if indent_str = @indent_str
      @buffer.append(10_u8) # '\n'
      i = 0
      while i < @level
        @buffer.append(indent_str)
        i = i + 1
      end
    end
  end

  private def before_value : Nil
    st = current_state
    case st
    when 0 # Document
      # okay
    when 1 # In array, first element
      set_current_state(2)
      write_indent
    when 2                  # In array, subsequent element
      @buffer.append(44_u8) # ','
      write_indent
    when 5 # In object, expecting value
      set_current_state(4)
      # Value follows colon
    else
      # State mismatch
    end
  end

  def null : Nil
    before_value
    @buffer.append("null")
  end

  def bool(val : Bool) : Nil
    before_value
    @buffer.append(val ? "true" : "false")
  end

  def number(val : Int32) : Nil
    number(val.to_i64)
  end

  def number(val : Int64) : Nil
    before_value
    @buffer.append(val.to_s)
  end

  def number(val : Float64) : Nil
    before_value
    bits = IyiFloatText.bits_of(val)
    if bits == 0x8000000000000000_u64
      @buffer.append("-0.0")
    else
      @buffer.append(val.to_s)
    end
  end

  def raw(str : String) : Nil
    before_value
    @buffer.append(str)
  end

  def string(val : String) : Nil
    before_value
    write_escaped_string(val)
  end

  private def write_escaped_string(val : String) : Nil
    @buffer.append(34_u8) # '"'
    i = 0
    len = val.bytesize
    bytes = val.to_unsafe
    while i < len
      b = bytes[i]
      if b == 34_u8 # '"'
        @buffer.append(92_u8)
        @buffer.append(34_u8)
        i = i + 1
      elsif b == 92_u8 # '\\'
        @buffer.append(92_u8)
        @buffer.append(92_u8)
        i = i + 1
      elsif b == 8_u8 # '\b'
        @buffer.append(92_u8)
        @buffer.append(98_u8)
        i = i + 1
      elsif b == 12_u8 # '\f'
        @buffer.append(92_u8)
        @buffer.append(102_u8)
        i = i + 1
      elsif b == 10_u8 # '\n'
        @buffer.append(92_u8)
        @buffer.append(110_u8)
        i = i + 1
      elsif b == 13_u8 # '\r'
        @buffer.append(92_u8)
        @buffer.append(114_u8)
        i = i + 1
      elsif b == 9_u8 # '\t'
        @buffer.append(92_u8)
        @buffer.append(116_u8)
        i = i + 1
      elsif b < 32_u8
        # Control character \u00XX
        @buffer.append(92_u8)
        @buffer.append(117_u8)
        @buffer.append(48_u8)
        @buffer.append(48_u8)
        hex = "0123456789abcdef".to_unsafe
        @buffer.append(hex[(b.to_i >> 4) & 0x0F])
        @buffer.append(hex[b.to_i & 0x0F])
        i = i + 1
      elsif @ascii_only && b >= 128_u8
        # Decode UTF-8 codepoint and emit \uXXXX or surrogate pair \uXXXX\uYYYY
        if (b & 0xE0_u8) == 0xC0_u8 && i + 1 < len
          cp = ((b.to_i & 0x1F) << 6) | (bytes[i + 1].to_i & 0x3F)
          write_hex_u4(cp)
          i = i + 2
        elsif (b & 0xF0_u8) == 0xE0_u8 && i + 2 < len
          cp = ((b.to_i & 0x0F) << 12) | ((bytes[i + 1].to_i & 0x3F) << 6) | (bytes[i + 2].to_i & 0x3F)
          write_hex_u4(cp)
          i = i + 3
        elsif (b & 0xF8_u8) == 0xF0_u8 && i + 3 < len
          cp = ((b.to_i & 0x07) << 18) | ((bytes[i + 1].to_i & 0x3F) << 12) | ((bytes[i + 2].to_i & 0x3F) << 6) | (bytes[i + 3].to_i & 0x3F)
          # Surrogate pair:
          sub = cp - 0x10000
          high = 0xD800 + (sub >> 10)
          low = 0xDC00 + (sub & 0x3FF)
          write_hex_u4(high)
          write_hex_u4(low)
          i = i + 4
        else
          @buffer.append(b)
          i = i + 1
        end
      else
        @buffer.append(b)
        i = i + 1
      end
    end
    @buffer.append(34_u8) # '"'
  end

  private def write_hex_u4(val : Int32) : Nil
    @buffer.append(92_u8)  # '\'
    @buffer.append(117_u8) # 'u'
    hex = "0123456789abcdef".to_unsafe
    @buffer.append(hex[(val >> 12) & 0x0F])
    @buffer.append(hex[(val >> 8) & 0x0F])
    @buffer.append(hex[(val >> 4) & 0x0F])
    @buffer.append(hex[val & 0x0F])
  end

  def start_array : Nil
    before_value
    @buffer.append(91_u8) # '['
    @level = @level + 1
    if @level > @max_nesting
      raise "maximum nesting depth #{@max_nesting} exceeded"
    end
    @state_stack << 1 # array first
  end

  def end_array : Nil
    st = @state_stack.pop
    @level = @level - 1
    if st == 2 # non-empty
      write_indent
    end
    @buffer.append(93_u8) # ']'
  end

  def array(& : -> Nil) : Nil
    start_array
    yield
    end_array
  end

  def start_object : Nil
    before_value
    @buffer.append(123_u8) # '{'
    @level = @level + 1
    if @level > @max_nesting
      raise "maximum nesting depth #{@max_nesting} exceeded"
    end
    @state_stack << 3 # object first
  end

  def end_object : Nil
    st = @state_stack.pop
    @level = @level - 1
    if st == 4 # non-empty
      write_indent
    end
    @buffer.append(125_u8) # '}'
  end

  def object(& : -> Nil) : Nil
    start_object
    yield
    end_object
  end

  def field(name : String) : Nil
    st = current_state
    if st == 4              # subsequent field
      @buffer.append(44_u8) # ','
    end
    set_current_state(5) # expecting value
    write_indent
    write_escaped_string(name)
    @buffer.append(58_u8) # ':'
    if @indent_str
      @buffer.append(32_u8) # ' '
    end
  end

  def field(name : String, & : -> Nil) : Nil
    field(name)
    yield
  end

  def field(name : String, val : Any) : Nil
    field(name)
    val.to_json(self)
  end

  def field(name : String, val : String) : Nil
    field(name)
    string(val)
  end

  def field(name : String, val : Int32) : Nil
    field(name)
    number(val)
  end

  def field(name : String, val : Int64) : Nil
    field(name)
    number(val)
  end

  def field(name : String, val : Float64) : Nil
    field(name)
    number(val)
  end

  def field(name : String, val : Bool) : Nil
    field(name)
    bool(val)
  end

  def field(name : String, val : Nil) : Nil
    field(name)
    null
  end

  def scalar(val : Any) : Nil
    val.to_json(self)
  end

  def to_s : String
    @buffer.to_s
  end
end

pub struct JSON
  # Parses a JSON string document into a `JSON::Any`.
  def self.parse(input : String) : Any
    Parser.new(input).parse
  end

  # Builds a JSON string using `JSON::Builder`.
  def self.build(indent : String | Int32 | Nil = nil, & : Builder -> Nil) : String
    builder = Builder.new
    if indent.is_a?(Int32)
      builder.indent = indent.as(Int32)
    elsif indent.is_a?(String)
      builder.indent = indent.as(String)
    end
    yield builder
    builder.to_s
  end

  def self.to_json(ary : Array(T)) : String forall T
    build do |b|
      b.array do
        ary.each { |item| write_value(item, b) }
      end
    end
  end

  def self.to_json(h : Hash(K, V)) : String forall K, V
    build do |b|
      b.object do
        h.each do |k, v|
          b.field(k.to_s) { write_value(v, b) }
        end
      end
    end
  end

  def self.to_json(obj) : String
    build do |b|
      write_value(obj, b)
    end
  end

  def self.from_json(str : String, type : T.class) forall T
    pull = PullParser.new(str)
    read_value(pull, type)
  end

  def self.write_value(val : Nil, b : Builder) : Nil
    b.null
  end

  def self.write_value(val : Bool, b : Builder) : Nil
    b.bool(val)
  end

  def self.write_value(val : Int32 | Int64 | Int16 | Int8 | UInt32 | UInt64 | UInt16 | UInt8, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : Float32 | Float64, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : String, b : Builder) : Nil
    b.string(val)
  end

  def self.write_value(val : Symbol, b : Builder) : Nil
    b.string(val.to_s)
  end

  def self.write_value(val : Any, b : Builder) : Nil
    val.to_json(b)
  end

  def self.write_value(val : Array(T), b : Builder) : Nil forall T
    b.array do
      val.each { |e| write_value(e, b) }
    end
  end

  def self.write_value(val : Hash(K, V), b : Builder) : Nil forall K, V
    b.object do
      val.each do |k, v|
        b.field(k.to_s) { write_value(v, b) }
      end
    end
  end

  def self.write_value(val, b : Builder) : Nil
    if val.nil?
      b.null
    elsif val.is_a?(String)
      b.string(val)
    elsif val.is_a?(Int)
      b.number(val)
    elsif val.is_a?(Float)
      b.number(val)
    elsif val.is_a?(Bool)
      b.bool(val)
    else
      val.to_json(b)
    end
  end

  def self.read_value(pull : PullParser, type : Nil.class) : Nil
    pull.read_null
  end

  def self.read_value(pull : PullParser, type : Bool.class) : Bool
    pull.read_bool
  end

  def self.read_value(pull : PullParser, type : Int32.class) : Int32
    pull.read_int.to_i32
  end

  def self.read_value(pull : PullParser, type : Int64.class) : Int64
    pull.read_int
  end

  def self.read_value(pull : PullParser, type : Int16.class) : Int16
    pull.read_int.to_i16
  end

  def self.read_value(pull : PullParser, type : Int8.class) : Int8
    pull.read_int.to_i8
  end

  def self.read_value(pull : PullParser, type : UInt32.class) : UInt32
    pull.read_int.to_u32
  end

  def self.read_value(pull : PullParser, type : UInt64.class) : UInt64
    pull.read_int.to_u64
  end

  def self.read_value(pull : PullParser, type : UInt16.class) : UInt16
    pull.read_int.to_u16
  end

  def self.read_value(pull : PullParser, type : UInt8.class) : UInt8
    pull.read_int.to_u8
  end

  def self.read_value(pull : PullParser, type : Float64.class) : Float64
    pull.read_float
  end

  def self.read_value(pull : PullParser, type : Float32.class) : Float32
    pull.read_float.to_f32
  end

  def self.read_value(pull : PullParser, type : String.class) : String
    pull.read_string
  end

  def self.read_value(pull : PullParser, type : Symbol.class) : Symbol
    Symbol.new(pull.read_string)
  end

  def self.read_value(pull : PullParser, type : Any.class) : Any
    Any.new(pull)
  end

  def self.read_value(pull : PullParser, type : Array(T).class) : Array(T) forall T
    ary = [] of T
    pull.read_begin_array
    while !pull.kind.end_array?
      ary << read_value(pull, T)
    end
    pull.read_end_array
    ary
  end

  def self.read_value(pull : PullParser, type : Hash(K, V).class) : Hash(K, V) forall K, V
    h = Hash(K, V).new
    pull.read_begin_object
    while !pull.kind.end_object?
      k = pull.read_object_key
      v = read_value(pull, V)
      {% if K == String %}
        h[k] = v
      {% elsif K == Symbol %}
        h[Symbol.new(k)] = v
      {% else %}
        h[k.to_s] = v
      {% end %}
    end
    pull.read_end_object
    h
  end

  def self.read_value(pull : PullParser, type : T.class) forall T
    T.new(pull)
  end
end

pub class SerializableError < Error
  getter line_number : Int32
  getter column_number : Int32
  getter klass : String
  getter attribute : String?

  def initialize(message : String, @klass : String, @attribute : String?, @line_number : Int32, @column_number : Int32)
    msg = String.build do |io|
      io << message
      io << " for " << klass
      if attr = attribute
        io << "#" << attr
      end
      io << " at line " << line_number << ", column " << column_number
    end
    super(msg)
  end
end

pub annotation Field
end

module Serializable
  annotation Options
  end

  module Strict
    protected def on_unknown_json_attribute(pull : ::JSON::PullParser, key : String, line_number : Int32, column_number : Int32)
      raise ::JSON::SerializableError.new("Unknown JSON attribute: #{key}", self.class.to_s, key, line_number, column_number).message
    end
  end

  module Unmapped
    @[::JSON::Field(ignore: true)]
    @json_unmapped : Hash(String, ::JSON::Any)?

    def json_unmapped : Hash(String, ::JSON::Any)
      @json_unmapped ||= Hash(String, ::JSON::Any).new
    end

    protected def on_unknown_json_attribute(pull : ::JSON::PullParser, key : String, line_number : Int32, column_number : Int32)
      json_unmapped[key] = ::JSON::Any.new(pull)
    end

    protected def on_to_json(json : ::JSON::Builder)
      if unmapped = @json_unmapped
        unmapped.each do |key, value|
          json.field(key) { value.to_json(json) }
        end
      end
    end
  end

  macro use_json_discriminator(field, mapping)
    def self.from_json(input : String) : self
      pull = ::JSON::PullParser.new(input)
      new(pull)
    end

    def self.new(pull : ::JSON::PullParser) : self
      location = pull.location_i64
      discriminator_value = ""
      json = ::JSON.build do |b|
        b.start_object
        pull.read_object do |key|
          if key == {{field.id.stringify}}
            case pull.kind
            when ::JSON::PullParser::Kind::String
              discriminator_value = pull.string_value
            when ::JSON::PullParser::Kind::Int
              discriminator_value = pull.int_value.to_s
            when ::JSON::PullParser::Kind::Bool
              discriminator_value = pull.bool_value ? "true" : "false"
            else
              raise ::JSON::SerializableError.new("JSON discriminator field '{{field.id}}' has invalid type", to_s, nil, location[0], location[1]).message
            end
            b.field(key, discriminator_value)
            pull.read_next
          else
            b.field(key) { pull.read_raw(b) }
          end
        end
        b.end_object
      end

      case discriminator_value
      {% for key, type in mapping %}
        when {{key.id.stringify}}
          {{type}}.from_json(json)
      {% end %}
      else
        raise ::JSON::SerializableError.new("Unknown discriminator value #{discriminator_value.inspect} for {{field.id}}", to_s, nil, location[0], location[1]).message
      end
    end
  end

  macro included
    def self.from_json(input : String) : self
      pull = ::JSON::PullParser.new(input)
      new(pull)
    end

    def self.from_json(input : String, root : String) : self
      pull = ::JSON::PullParser.new(input)
      pull.on_key(root) do
        new(pull)
      end
    end

    def self.new(pull : ::JSON::PullParser) : self
      new_from_json_pull_parser(pull)
    end

    private def self.new_from_json_pull_parser(pull : ::JSON::PullParser) : self
      {% if @type.struct? %}
        instance = uninitialized self
      {% else %}
        instance = allocate
      {% end %}
      instance.initialize(__pull_for_json_serializable: pull)
      instance
    end

    macro inherited
      def self.new(pull : ::JSON::PullParser) : self
        new_from_json_pull_parser(pull)
      end
    end

    def initialize(*, __pull_for_json_serializable pull : ::JSON::PullParser)
      {% verbatim do %}
        {% begin %}
          {% properties = {} of Nil => Nil %}
          {% for ivar in @type.instance_vars %}
            {% ann = ivar.annotation(::JSON::Field) || ivar.annotation(JSON::Field) || ivar.annotation(Field) %}
            {% unless ann && (ann[:ignore] || ann[:ignore_deserialize]) %}
              {% non_nil_type = ivar.type %}
              {% if ivar.type.nilable? %}
                {% for t in ivar.type.union_types %}
                  {% unless t == Nil %}
                    {% non_nil_type = t %}
                  {% end %}
                {% end %}
              {% end %}
              {%
                properties[ivar.id] = {
                  key:          ((ann && ann[:key]) || ivar).id.stringify,
                  has_default:  (ann && ann[:default] != nil) || ivar.has_default_value?,
                  default:      (ann && ann[:default]) || ivar.default_value,
                  nilable:      ivar.type.nilable?,
                  non_nil_type: non_nil_type,
                  root:         ann && ann[:root],
                  converter:    ann && ann[:converter],
                  presence:     ann && ann[:presence],
                }
              %}
            {% end %}
          {% end %}

          {% for name, value in properties %}
            %var{name} = uninitialized typeof(@{{name}})
            %found{name} = false
          {% end %}

          %line = pull.line_number
          %col = pull.column_number
          begin
            pull.read_begin_object
          rescue exc : ::JSON::ParseException
            raise ::JSON::SerializableError.new(exc.message, self.class.to_s, nil, %line, %col).message
          end

          while !pull.kind.end_object?
            %key_line = pull.line_number
            %key_col = pull.column_number
            key = pull.read_object_key
            case key
            {% for name, value in properties %}
              when {{value[:key]}}
                begin
                  {% if value[:has_default] || value[:nilable] || value[:root] %}
                    if pull.read_null?
                      {% if value[:nilable] %}
                        %var{name} = nil
                        %found{name} = true
                      {% end %}
                      next
                    end
                  {% end %}

                  %var{name} =
                    {% if value[:root] %}
                      pull.on_key({{value[:root]}}) do
                        {% if value[:converter] %}
                          {{value[:converter]}}.from_json(pull)
                        {% else %}
                          ::JSON.read_value(pull, {{value[:non_nil_type]}})
                        {% end %}
                      end
                    {% elsif value[:converter] %}
                      {{value[:converter]}}.from_json(pull)
                    {% else %}
                      ::JSON.read_value(pull, {{value[:non_nil_type]}})
                    {% end %}
                  %found{name} = true
                rescue exc : ::JSON::ParseException
                  raise ::JSON::SerializableError.new(exc.message, self.class.to_s, {{value[:key]}}, %key_line, %key_col).message
                end
            {% end %}
            else
              on_unknown_json_attribute(pull, key, %key_line, %key_col)
            end
          end
          pull.read_end_object

          {% for ivar in @type.instance_vars %}
            {% ann = ivar.annotation(::JSON::Field) || ivar.annotation(JSON::Field) || ivar.annotation(Field) %}
            {% if ann && (ann[:ignore] || ann[:ignore_deserialize]) %}
              {% if ann && ann[:default] != nil %}
                @{{ivar.name.id}} = {{ann[:default]}}
              {% elsif ivar.has_default_value? %}
                @{{ivar.name.id}} = {{ivar.default_value}}
              {% elsif ivar.type.nilable? %}
                @{{ivar.name.id}} = nil
              {% end %}
            {% end %}
          {% end %}

          {% for name, value in properties %}
            if %found{name}
              @{{name}} = %var{name}
            else
              {% if value[:has_default] %}
                @{{name}} = {{value[:default]}}
              {% elsif value[:nilable] %}
                @{{name}} = nil
              {% else %}
                raise ::JSON::SerializableError.new("Missing JSON attribute: " + {{value[:key]}}, self.class.to_s, {{value[:key]}}, %line, %col).message
              {% end %}
            end

            {% if value[:presence] %}
              @{{name}}_present = %found{name}
            {% end %}
          {% end %}
        {% end %}
      {% end %}
      after_initialize
    end

    def to_json(json : ::JSON::Builder) : Nil
      {% verbatim do %}
        {% begin %}
          {% options = @type.annotation(::JSON::Serializable::Options) || @type.annotation(JSON::Serializable::Options) || @type.annotation(Options) %}
          {% emit_nulls = options && options[:emit_nulls] %}

          {% properties = {} of Nil => Nil %}
          {% for ivar in @type.instance_vars %}
            {% ann = ivar.annotation(::JSON::Field) || ivar.annotation(JSON::Field) || ivar.annotation(Field) %}
            {% unless ann && (ann[:ignore] || ann[:ignore_serialize] == true) %}
              {%
                properties[ivar.id] = {
                  key:              ((ann && ann[:key]) || ivar).id.stringify,
                  root:             ann && ann[:root],
                  converter:        ann && ann[:converter],
                  emit_null:        (ann && (ann[:emit_null] != nil) ? ann[:emit_null] : emit_nulls),
                  ignore_serialize: ann && ann[:ignore_serialize],
                }
              %}
            {% end %}
          {% end %}

          json.object do
            {% for name, value in properties %}
              _{{name}} = @{{name}}

              {% if value[:ignore_serialize] %}
                unless {{ value[:ignore_serialize] }}
              {% end %}

                {% unless value[:emit_null] %}
                  unless _{{name}}.nil?
                {% end %}

                  {% if value[:root] %}
                    json.field({{value[:key]}}) do
                      json.object do
                        json.field({{value[:root]}}) do
                          {% if value[:converter] %}
                            if val = _{{name}}
                              {{value[:converter]}}.to_json(val, json)
                            else
                              json.null
                            end
                          {% else %}
                            ::JSON.write_value(_{{name}}, json)
                          {% end %}
                        end
                      end
                    end
                  {% else %}
                    json.field({{value[:key]}}) do
                      {% if value[:converter] %}
                        if val = _{{name}}
                          {{value[:converter]}}.to_json(val, json)
                        else
                          json.null
                        end
                      {% else %}
                        ::JSON.write_value(_{{name}}, json)
                      {% end %}
                    end
                  {% end %}

                {% unless value[:emit_null] %}
                  end
                {% end %}

              {% if value[:ignore_serialize] %}
                end
              {% end %}
            {% end %}
            on_to_json(json)
          end
        {% end %}
      {% end %}
    end

    def to_json : String
      ::JSON.build do |b|
        to_json(b)
      end
    end

    def to_pretty_json(indent : String = "  ") : String
      ::JSON.build(indent: indent) do |b|
        to_json(b)
      end
    end

    def to_pretty_json(indent : Int32) : String
      ::JSON.build(indent: indent) do |b|
        to_json(b)
      end
    end

    def to_json(io : IO) : Nil
      io << to_json
    end

    def to_pretty_json(io : IO, indent : String = "  ") : Nil
      io << to_pretty_json(indent)
    end

    protected def after_initialize
    end

    protected def on_unknown_json_attribute(pull : ::JSON::PullParser, key : String, line_number : Int32, column_number : Int32)
      pull.skip
    end

    protected def on_to_json(json : ::JSON::Builder)
    end
  end
end

module ArrayConverter(T)
  def self.from_json(pull : ::JSON::PullParser) : Array(T)
    ary = [] of T
    pull.read_begin_array
    while !pull.kind.end_array?
      ary << T.new(pull)
    end
    pull.read_end_array
    ary
  end

  def self.to_json(values : Array(T), json : ::JSON::Builder) : Nil
    json.array do
      values.each { |v| v.to_json(json) }
    end
  end
end

module HashValueConverter(K, V)
  def self.from_json(pull : ::JSON::PullParser) : Hash(K, V)
    h = Hash(K, V).new
    pull.read_begin_object
    while !pull.kind.end_object?
      k = pull.read_object_key
      v = V.new(pull)
      h[k] = v
    end
    pull.read_end_object
    h
  end

  def self.to_json(values : Hash(K, V), json : ::JSON::Builder) : Nil
    json.object do
      values.each do |k, v|
        json.field(k.to_s) { v.to_json(json) }
      end
    end
  end
end

alias ::JSON = Std::Json::JSON
alias ::JSON::Any = Std::Json::Any
alias ::JSON::PullParser = Std::Json::PullParser
alias ::JSON::Builder = Std::Json::Builder
alias ::JSON::Error = Std::Json::Error
alias ::JSON::ParseException = Std::Json::ParseException
alias ::JSON::Parser = Std::Json::Parser
alias ::JSON::Serializable = Std::Json::Serializable
alias ::JSON::SerializableError = Std::Json::SerializableError
alias ::JSON::Field = Std::Json::Field
alias ::JSON::ArrayConverter = Std::Json::ArrayConverter
alias ::JSON::HashValueConverter = Std::Json::HashValueConverter
