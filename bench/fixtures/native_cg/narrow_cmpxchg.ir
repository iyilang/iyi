; iyi-ir 1
module "narrow_cmpxchg"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [7 x i8] c"%d %d\0A\00"
@cell = internal global i8 -128, align 1
@expect = internal global i8 -128, align 1

define i32 @main() {
entry:
  %v = load i8, ptr @expect, align 1
  %pair = cmpxchg ptr @cell, i8 %v, i8 42, align 1 seq_cst acquire
  %won = extractvalue { i8, i1 } %pair, 1
  %w = zext i1 %won to i32
  %after = load i8, ptr @cell, align 1
  %a = sext i8 %after to i32
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %w, i32 %a)
  ret i32 0
}
