; iyi-ir 1
source_filename = "escape_stored_global"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@destination = internal global ptr null
declare external ptr @__iyi_new(i64, i64, i64)
define internal void @global_escape() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 3, i64 2)
  store ptr %p, ptr @destination, align 8
  ret void
}
