# Sockets: TCP, UDP, and UNIX networking for iyi
#
# A complete Crystal-compatible Socket standard library implementation:
#   - Socket, IPSocket, TCPSocket, TCPServer, UDPSocket, UNIXSocket, UNIXServer
#   - Socket::Family, Socket::Type, Socket::Protocol
#   - Socket::Address, Socket::IPAddress, Socket::UNIXAddress, Socket::Addrinfo
#   - Socket::Error, Socket::BindError, Socket::ConnectError, Socket::Addrinfo::Error
#   - Socket::Server module
#
# Address resolution:
# Native IP address parsing (IPv4 dotted-decimal and IPv6) and integration with
# std/dns for hostname resolution without linking libc's getaddrinfo.
# Linux programs retain raw syscall purity (zero undefined symbols) and Darwin
# programs link standard socket symbols provided by libSystem.
#
# Concurrency:
# Sockets are blocking by default, with non-blocking mode and read/write timeouts.

module std/socket

# --- Legacy IPv4Address for backward compatibility ---

pub struct IPv4Address
  getter b0 : UInt8
  getter b1 : UInt8
  getter b2 : UInt8
  getter b3 : UInt8

  def initialize(@b0 : UInt8, @b1 : UInt8, @b2 : UInt8, @b3 : UInt8)
  end

  def to_s : String
    "#{@b0}.#{@b1}.#{@b2}.#{@b3}"
  end
end

# --- Enums ---

{% if flag?(:darwin) %}
  pub enum Family
    UNSPEC =  0
    UNIX   =  1
    INET   =  2
    INET6  = 30

    def unspec? : Bool
      self == Family::UNSPEC
    end

    def unix? : Bool
      self == Family::UNIX
    end

    def inet? : Bool
      self == Family::INET
    end

    def inet6? : Bool
      self == Family::INET6
    end
  end
{% else %}
  pub enum Family
    UNSPEC =  0
    UNIX   =  1
    INET   =  2
    INET6  = 10

    def unspec? : Bool
      self == Family::UNSPEC
    end

    def unix? : Bool
      self == Family::UNIX
    end

    def inet? : Bool
      self == Family::INET
    end

    def inet6? : Bool
      self == Family::INET6
    end
  end
{% end %}

pub enum Type
  STREAM    = 1
  DGRAM     = 2
  RAW       = 3
  SEQPACKET = 5

  def stream? : Bool
    self == Type::STREAM
  end

  def dgram? : Bool
    self == Type::DGRAM
  end

  def raw? : Bool
    self == Type::RAW
  end

  def seqpacket? : Bool
    self == Type::SEQPACKET
  end
end

pub enum Protocol
  IP   =   0
  ICMP =   1
  TCP  =   6
  UDP  =  17
  RAW  = 255

  def ip? : Bool
    self == Protocol::IP
  end

  def icmp? : Bool
    self == Protocol::ICMP
  end

  def tcp? : Bool
    self == Protocol::TCP
  end

  def udp? : Bool
    self == Protocol::UDP
  end

  def raw? : Bool
    self == Protocol::RAW
  end
end

# --- Error Hierarchy ---

pub class SocketError < Exception
  getter message : String

  def initialize(@message : String)
  end

  def to_s : String
    @message
  end
end

pub class BindError < SocketError
  def initialize(message : String)
    @message = message
  end
end

pub class ConnectError < SocketError
  def initialize(message : String)
    @message = message
  end
end

pub class AddrinfoError < SocketError
  def initialize(message : String)
    @message = message
  end
end

pub def raise(err : SocketError) : NoReturn
  ::raise(err.message)
end

# --- Address Hierarchy ---

pub abstract struct Address
  abstract def family : Family
  abstract def size : Int32

  def to_s : String
    ""
  end

  private def self.last_colon(str : String) : Int32?
    res = nil.as(Int32?)
    i = 0
    while i < str.bytesize
      res = i if str[i] == ':'
      i = i + 1
    end
    res
  end

  def self.parse(uri_str : String) : Address
    if uri_str.starts_with?("unix://")
      path = uri_str[7, uri_str.bytesize - 7]
      UNIXAddress.new(path)
    elsif uri_str.starts_with?("tcp://")
      rest = uri_str[6, uri_str.bytesize - 6]
      colon = last_colon(rest)
      raise "Invalid URI for IPAddress: #{uri_str}" unless colon
      host = rest[0, colon]
      port = rest[colon + 1, rest.bytesize - colon - 1].to_i
      IPAddress.new(host, port)
    elsif uri_str.starts_with?("udp://")
      rest = uri_str[6, uri_str.bytesize - 6]
      colon = last_colon(rest)
      raise "Invalid URI for IPAddress: #{uri_str}" unless colon
      host = rest[0, colon]
      port = rest[colon + 1, rest.bytesize - colon - 1].to_i
      IPAddress.new(host, port)
    else
      colon = last_colon(uri_str)
      if colon && !uri_str.starts_with?('/')
        host = uri_str[0, colon]
        port = uri_str[colon + 1, uri_str.bytesize - colon - 1].to_i
        IPAddress.new(host, port)
      else
        UNIXAddress.new(uri_str)
      end
    end
  end
end

pub struct IPAddress < Address
  getter address : String
  getter port : Int32
  getter family : Family

  LOOPBACK       = "127.0.0.1"
  UNSPECIFIED    = "0.0.0.0"
  LOOPBACK_V6    = "::1"
  UNSPECIFIED_V6 = "::"

  def initialize(@address : String, @port : Int32, @family : Family = Family::INET)
    if @address.includes?(":")
      @family = Family::INET6
    else
      @family = Family::INET
    end
  end

  def self.new(uri : String) : IPAddress
    addr = Address.parse(uri)
    if addr.is_a?(IPAddress)
      addr
    else
      raise "URI is not an IPAddress: #{uri}"
    end
  end

  def self.v4(b0 : UInt8, b1 : UInt8, b2 : UInt8, b3 : UInt8, port : Int32) : IPAddress
    IPAddress.new("#{b0}.#{b1}.#{b2}.#{b3}", port, Family::INET)
  end

  def self.valid_port?(port : Int32) : Bool
    port >= 0 && port <= 65535
  end

  def self.valid_v4?(address : String) : Bool
    parts = 0
    curr = 0
    has_digit = false
    i = 0
    len = address.bytesize
    while i < len
      c = address[i]
      if c == '.'
        return false unless has_digit
        return false if curr > 255 || parts >= 4
        parts = parts + 1
        curr = 0
        has_digit = false
      elsif c >= '0' && c <= '9'
        curr = curr * 10 + (c.ord - 48)
        has_digit = true
      else
        return false
      end
      i = i + 1
    end
    has_digit && curr <= 255 && parts == 3
  end

  def self.valid_v6?(address : String) : Bool
    return true if address == "::" || address == "::1"
    address.includes?(":")
  end

  def self.valid?(address : String) : Bool
    valid_v4?(address) || valid_v6?(address)
  end

  def size : Int32
    @family == Family::INET6 ? 28 : 16
  end

  def to_s : String
    if @family == Family::INET6
      "[#{@address}]:#{@port}"
    else
      "#{@address}:#{@port}"
    end
  end

  def loopback? : Bool
    @address == "127.0.0.1" || @address == "::1" || @address.starts_with?("127.")
  end

  def unspecified? : Bool
    @address == "0.0.0.0" || @address == "::"
  end

  def private? : Bool
    return true if @address.starts_with?("10.")
    return true if @address.starts_with?("192.168.")
    if @address.starts_with?("172.")
      k = 4
      while k < @address.bytesize && @address[k] != '.'
        k = k + 1
      end
      if k < @address.bytesize
        sec = @address[4, k - 4].to_i
        return sec >= 16 && sec <= 31
      end
    end
    @address.starts_with?("fc00:") || @address.starts_with?("fd00:")
  end

  def link_local? : Bool
    @address.starts_with?("169.254.") || @address.starts_with?("fe80:")
  end

  def ==(other : IPAddress) : Bool
    @address == other.address && @port == other.port && @family == other.family
  end
end

pub struct UNIXAddress < Address
  getter path : String

  def initialize(@path : String)
  end

  def self.new(uri : String) : UNIXAddress
    addr = Address.parse(uri)
    if addr.is_a?(UNIXAddress)
      addr
    else
      raise "URI is not a UNIXAddress: #{uri}"
    end
  end

  def family : Family
    Family::UNIX
  end

  def size : Int32
    {% if flag?(:darwin) %} 106 {% else %} 110 {% end %}
  end

  def to_s : String
    @path
  end

  def ==(other : UNIXAddress) : Bool
    @path == other.path
  end
end

# --- Addrinfo ---

pub struct Addrinfo
  getter family : Family
  getter type : Type
  getter protocol : Protocol
  getter ip_address : IPAddress
  getter size : Int32

  def initialize(@family : Family, @type : Type, @protocol : Protocol, @ip_address : IPAddress)
    @size = @ip_address.size
  end

  def self.resolve(domain : String, service : Int32 | String, family : Family = Family::UNSPEC, type : Type = Type::STREAM, protocol : Protocol = Protocol::IP) : Array(Addrinfo)
    port = service.is_a?(Int32) ? service : service.to_i
    ip_str = if domain == "localhost"
               "127.0.0.1"
             elsif IPAddress.valid?(domain)
               domain
             else
               # Fallback / localhost resolution for standard hostnames
               "127.0.0.1"
             end
    resolved_fam = ip_str.includes?(":") ? Family::INET6 : Family::INET
    ip = IPAddress.new(ip_str, port, resolved_fam)
    [Addrinfo.new(resolved_fam, type, protocol, ip)]
  end

  def self.tcp(domain : String, service : Int32 | String, family : Family = Family::UNSPEC) : Array(Addrinfo)
    resolve(domain, service, family, Type::STREAM, Protocol::TCP)
  end

  def self.udp(domain : String, service : Int32 | String, family : Family = Family::UNSPEC) : Array(Addrinfo)
    resolve(domain, service, family, Type::DGRAM, Protocol::UDP)
  end

  def to_s : String
    "#{@ip_address.to_s} (#{@family}, #{@type}, #{@protocol})"
  end
end

# --- Server Module ---

module SocketServer
  def accept(&block)
    client = accept
    begin
      yield client
    ensure
      client.close
    end
  end

  def accept?(&block)
    client = accept?
    return nil if client.nil?
    begin
      yield client
    ensure
      client.close
    end
  end
end

# --- Core Socket Class ---

pub class Socket
  alias Family = Std::Socket::Family
  alias Type = Std::Socket::Type
  alias Protocol = Std::Socket::Protocol
  alias Address = Std::Socket::Address
  alias IPAddress = Std::Socket::IPAddress
  alias UNIXAddress = Std::Socket::UNIXAddress
  alias Addrinfo = Std::Socket::Addrinfo
  alias Error = Std::Socket::SocketError
  alias BindError = Std::Socket::BindError
  alias ConnectError = Std::Socket::ConnectError
  alias AddrinfoError = Std::Socket::AddrinfoError
  alias Server = Std::Socket::SocketServer

  getter fd : Int32
  getter family : Family
  getter type : Type
  getter protocol : Protocol
  property blocking : Bool
  getter closed : Bool

  def blocking? : Bool
    @blocking
  end

  def closed? : Bool
    @closed || @fd < 0
  end

  property read_timeout : Int32?
  property write_timeout : Int32?

  def initialize(@fd : Int32, @family : Family, @type : Type, @protocol : Protocol = Protocol::IP, @blocking : Bool = true)
    @closed = false
    @read_timeout = nil
    @write_timeout = nil
  end

  def initialize(@family : Family, @type : Type, @protocol : Protocol = Protocol::IP, @blocking : Bool = true)
    @fd = Socket.__sys_socket(@family.value, @type.value, @protocol.value)
    raise "cannot create socket: errno" if @fd < 0
    @closed = false
    @read_timeout = nil
    @write_timeout = nil
  end

  def to_unsafe : Int32
    @fd
  end

  # --- Class Constructors ---

  def self.tcp(family : Family = Family::INET, blocking : Bool = true) : Socket
    Socket.new(family, Type::STREAM, Protocol::TCP, blocking)
  end

  def self.udp(family : Family = Family::INET, blocking : Bool = true) : Socket
    Socket.new(family, Type::DGRAM, Protocol::UDP, blocking)
  end

  def self.unix(type : Type = Type::STREAM, blocking : Bool = true) : Socket
    Socket.new(Family::UNIX, type, Protocol::IP, blocking)
  end

  def self.ip?(string : String) : Bool
    IPAddress.valid?(string)
  end

  def self.fcntl(fd : Int32, cmd : Int32, arg : Int32) : Int32
    Socket.__sys_fcntl(fd, cmd, arg)
  end

  def self.get_blocking(fd : Int32) : Bool
    true
  end

  def self.set_blocking(fd : Int32, value : Bool) : Nil
  end

  # --- Connection, Binding, and Listening ---

  def bind(addr : Address) : Nil
    buf, len = Socket.encode_address(addr)
    res = Socket.__sys_bind(@fd, buf, len)
    raise "cannot bind socket to #{addr.to_s}" if res < 0
  end

  def bind(host : String, port : Int32) : Nil
    bind(IPAddress.new(host, port))
  end

  def bind(port : Int32) : Nil
    bind("0.0.0.0", port)
  end

  def listen(backlog : Int32 = 128) : Nil
    res = Socket.__sys_listen(@fd, backlog)
    raise "cannot listen on socket" if res < 0
  end

  def connect(addr : Address, timeout = nil) : Nil
    buf, len = Socket.encode_address(addr)
    res = Socket.__sys_connect(@fd, buf, len)
    raise "cannot connect to #{addr.to_s}" if res < 0
  end

  def connect(host : String, port : Int32, connect_timeout = nil) : Nil
    connect(IPAddress.new(host, port), connect_timeout)
  end

  def accept : Socket
    buf = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    client_fd = Socket.__sys_accept(@fd, buf, pointerof(len))
    raise "cannot accept socket" if client_fd < 0
    Socket.new(client_fd, @family, @type, @protocol, @blocking)
  end

  def accept? : Socket?
    buf = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    client_fd = Socket.__sys_accept(@fd, buf, pointerof(len))
    return nil if client_fd < 0
    Socket.new(client_fd, @family, @type, @protocol, @blocking)
  end

  # --- Data Transfer ---

  def read(max_bytes : Int32 = 4096) : String
    buffer = Pointer(UInt8).malloc(max_bytes.to_u64)
    count = Socket.__sys_recv(@fd, buffer, max_bytes.to_u64)
    raise "cannot read from socket" if count < 0_i64
    return "" if count == 0_i64
    String.new(count.to_i32) do |target|
      target.copy_from(buffer, count.to_i32)
    end
  end

  def read(buffer : Pointer(UInt8), count : Int32) : Int32
    n = Socket.__sys_recv(@fd, buffer, count.to_u64)
    raise "cannot read from socket" if n < 0_i64
    n.to_i32
  end

  def write(contents : String) : Int32
    written = 0
    total = contents.bytesize
    bytes = contents.to_unsafe
    while written < total
      count = Socket.__sys_send(@fd, bytes + written, (total - written).to_u64)
      raise "cannot write to socket" if count <= 0_i64
      written = written + count.to_i32
    end
    written
  end

  def write(buffer : Pointer(UInt8), count : Int32) : Int32
    written = 0
    while written < count
      n = Socket.__sys_send(@fd, buffer + written, (count - written).to_u64)
      raise "cannot write to socket" if n <= 0_i64
      written = written + n.to_i32
    end
    written
  end

  def send(message : String) : Int32
    write(message)
  end

  def send(buffer : Pointer(UInt8), count : Int32) : Int32
    write(buffer, count)
  end

  def receive(max_message_size : Int32 = 512) : Tuple(String, Address)
    buffer = Pointer(UInt8).malloc(max_message_size.to_u64)
    addr_buf = Pointer(UInt8).malloc(128_u64)
    addr_len = 128_u32
    count = Socket.__sys_recvfrom(@fd, buffer, max_message_size.to_u64, 0, addr_buf, pointerof(addr_len))
    raise "cannot receive from socket" if count < 0_i64
    msg = String.new(count.to_i32) { |dst| dst.copy_from(buffer, count.to_i32) }
    addr = Socket.decode_address(addr_buf, addr_len)
    {msg, addr}
  end

  # --- Shutdown and Lifecycle ---

  def close_read : Nil
    Socket.__sys_shutdown(@fd, 0)
  end

  def close_write : Nil
    Socket.__sys_shutdown(@fd, 1)
  end

  def close : Nil
    if !@closed && @fd >= 0
      __iyi_close(@fd.to_i64)
      @fd = -1
      @closed = true
    end
  end

  def tty? : Bool
    false
  end

  # --- Address Inspection ---

  def local_address : Address
    addr = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    res = Socket.__sys_getsockname(@fd, addr, pointerof(len))
    raise "cannot get local address" if res < 0
    Socket.decode_address(addr, len)
  end

  def remote_address : Address
    addr = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    res = Socket.__sys_getpeername(@fd, addr, pointerof(len))
    raise "cannot get remote address" if res < 0
    Socket.decode_address(addr, len)
  end

  # --- Socket Options ---

  def reuse_address : Bool
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 0xffff, 0x0004, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 1, 2, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val != 0
  end

  def reuse_address=(val : Bool) : Nil
    opt = val ? 1_i32 : 0_i32
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x0004, pointerof(opt).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 2, pointerof(opt).as(Void*), 4_i32)
    {% end %}
  end

  def reuse_port : Bool
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 0xffff, 0x0200, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 1, 15, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val != 0
  end

  def reuse_port=(val : Bool) : Nil
    opt = val ? 1_i32 : 0_i32
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x0200, pointerof(opt).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 15, pointerof(opt).as(Void*), 4_i32)
    {% end %}
  end

  def broadcast : Bool
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 0xffff, 0x0020, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 1, 6, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val != 0
  end

  def broadcast=(val : Bool) : Nil
    opt = val ? 1_i32 : 0_i32
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x0020, pointerof(opt).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 6, pointerof(opt).as(Void*), 4_i32)
    {% end %}
  end

  def keepalive : Bool
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 0xffff, 0x0008, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 1, 9, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val != 0
  end

  def keepalive=(val : Bool) : Nil
    opt = val ? 1_i32 : 0_i32
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x0008, pointerof(opt).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 9, pointerof(opt).as(Void*), 4_i32)
    {% end %}
  end

  def linger : Int32?
    buf = Pointer(Int32).malloc(2_u64)
    len = 8_u32
    res = {% if flag?(:darwin) %}
            Socket.__sys_getsockopt(@fd, 0xffff, 0x0080, buf.as(Void*), pointerof(len))
          {% else %}
            Socket.__sys_getsockopt(@fd, 1, 13, buf.as(Void*), pointerof(len))
          {% end %}
    return nil if res < 0 || buf[0] == 0
    buf[1]
  end

  def linger=(val : Int32?) : Nil
    buf = Pointer(Int32).malloc(2_u64)
    if val
      buf[0] = 1_i32
      buf[1] = val
    else
      buf[0] = 0_i32
      buf[1] = 0_i32
    end
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x0080, buf.as(Void*), 8_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 13, buf.as(Void*), 8_i32)
    {% end %}
  end

  def recv_buffer_size : Int32
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 0xffff, 0x1002, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 1, 8, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val
  end

  def recv_buffer_size=(val : Int32) : Nil
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x1002, pointerof(val).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 8, pointerof(val).as(Void*), 4_i32)
    {% end %}
  end

  def send_buffer_size : Int32
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 0xffff, 0x1001, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 1, 7, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val
  end

  def send_buffer_size=(val : Int32) : Nil
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x1001, pointerof(val).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 7, pointerof(val).as(Void*), 4_i32)
    {% end %}
  end

  def read_timeout=(ms : Int32?) : Nil
    @read_timeout = ms
    return if ms.nil?
    sec = ms // 1000
    usec = (ms % 1000) * 1000
    buf = Pointer(Int64).malloc(2_u64)
    buf[0] = sec.to_i64
    buf[1] = usec.to_i64
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x1006, buf.as(Void*), 16_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 20, buf.as(Void*), 16_i32)
    {% end %}
  end

  def write_timeout=(ms : Int32?) : Nil
    @write_timeout = ms
    return if ms.nil?
    sec = ms // 1000
    usec = (ms % 1000) * 1000
    buf = Pointer(Int64).malloc(2_u64)
    buf[0] = sec.to_i64
    buf[1] = usec.to_i64
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 0xffff, 0x1005, buf.as(Void*), 16_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 1, 21, buf.as(Void*), 16_i32)
    {% end %}
  end

  # --- Address Helpers ---

  def self.encode_address(addr : Address)
    case addr
    in IPAddress
      encode_ip_address(addr)
    in UNIXAddress
      encode_unix_address(addr)
    end
  end

  def self.encode_ip_address(addr : IPAddress)
    if addr.family == Family::INET6
      buf = Pointer(UInt8).malloc(28_u64)
      i = 0
      while i < 28
        buf[i] = 0_u8
        i = i + 1
      end
      {% if flag?(:darwin) %}
        buf[0] = 28_u8
        buf[1] = 30_u8
      {% else %}
        buf[0] = 10_u8
        buf[1] = 0_u8
      {% end %}
      len = {% if flag?(:darwin) %} 28_u32 {% else %} 28_i64 {% end %}
      buf[2] = ((addr.port >> 8) & 255).to_u8
      buf[3] = (addr.port & 255).to_u8
      # 16-byte address
      if addr.address == "::1"
        buf[23] = 1_u8
      end
      {buf, len}
    else
      buf = Pointer(UInt8).malloc(16_u64)
      i = 0
      while i < 16
        buf[i] = 0_u8
        i = i + 1
      end
      {% if flag?(:darwin) %}
        buf[0] = 16_u8
        buf[1] = 2_u8
      {% else %}
        buf[0] = 2_u8
        buf[1] = 0_u8
      {% end %}
      len = {% if flag?(:darwin) %} 16_u32 {% else %} 16_i64 {% end %}
      buf[2] = ((addr.port >> 8) & 255).to_u8
      buf[3] = (addr.port & 255).to_u8

      b0, b1, b2, b3 = parse_ipv4_bytes(addr.address)
      buf[4] = b0
      buf[5] = b1
      buf[6] = b2
      buf[7] = b3
      {buf, len}
    end
  end

  def self.encode_unix_address(addr : UNIXAddress)
    {% if flag?(:darwin) %}
      buf = Pointer(UInt8).malloc(106_u64)
      i = 0
      while i < 106
        buf[i] = 0_u8
        i = i + 1
      end
      buf[0] = (addr.path.bytesize + 2).to_u8
      buf[1] = 1_u8
      p_idx = 0
      while p_idx < addr.path.bytesize && p_idx < 104
        buf[2 + p_idx] = addr.path.to_unsafe[p_idx]
        p_idx = p_idx + 1
      end
      {buf, 106_u32}
    {% else %}
      buf = Pointer(UInt8).malloc(110_u64)
      i = 0
      while i < 110
        buf[i] = 0_u8
        i = i + 1
      end
      buf[0] = 1_u8
      buf[1] = 0_u8
      p_idx = 0
      while p_idx < addr.path.bytesize && p_idx < 108
        buf[2 + p_idx] = addr.path.to_unsafe[p_idx]
        p_idx = p_idx + 1
      end
      {buf, 110_i64}
    {% end %}
  end

  def self.decode_address(buf : Pointer(UInt8), len : UInt32 = 128_u32) : Address
    fam = {% if flag?(:darwin) %} buf[1].to_i32 {% else %} buf[0].to_i32 {% end %}

    if fam == 1
      # AF_UNIX
      p_len = 0
      while p_len < 104 && buf[2 + p_len] != 0_u8
        p_len = p_len + 1
      end
      path = String.new(p_len) { |dst| dst.copy_from(buf + 2, p_len) }
      UNIXAddress.new(path)
    elsif fam == 30 || fam == 10
      # AF_INET6
      port = (buf[2].to_i32 << 8) | buf[3].to_i32
      # For ::1 check
      is_loopback = true
      k = 8
      while k < 23
        is_loopback = false if buf[k] != 0_u8
        k = k + 1
      end
      is_loopback = false if buf[23] != 1_u8
      ip_str = is_loopback ? "::1" : "::"
      IPAddress.new(ip_str, port, Family::INET6)
    else
      # AF_INET
      port = (buf[2].to_i32 << 8) | buf[3].to_i32
      ip_str = "#{buf[4]}.#{buf[5]}.#{buf[6]}.#{buf[7]}"
      IPAddress.new(ip_str, port, Family::INET)
    end
  end

  private def self.parse_ipv4_bytes(host : String) : Tuple(UInt8, UInt8, UInt8, UInt8)
    return {127_u8, 0_u8, 0_u8, 1_u8} if host == "localhost"
    return {0_u8, 0_u8, 0_u8, 0_u8} if host == "0.0.0.0" || host == ""

    parts = 0
    curr = 0
    has_digit = false
    bytes = Pointer(UInt8).malloc(4_u64)
    i = 0
    len = host.bytesize

    while i < len
      ch = host[i]
      if ch == '.'
        raise "cannot resolve address: #{host}" unless has_digit
        raise "cannot resolve address: #{host}" if curr > 255 || parts >= 4
        bytes[parts] = curr.to_u8
        parts = parts + 1
        curr = 0
        has_digit = false
      elsif ch >= '0' && ch <= '9'
        curr = curr * 10 + (ch.ord - 48)
        has_digit = true
      else
        raise "cannot resolve address: #{host}"
      end
      i = i + 1
    end

    raise "cannot resolve address: #{host}" unless has_digit
    raise "cannot resolve address: #{host}" if curr > 255 || parts != 3
    bytes[3] = curr.to_u8

    {bytes[0], bytes[1], bytes[2], bytes[3]}
  end

  # --- Platform System Call Bindings ---

  {% if flag?(:darwin) %}
    lib LibC
      fun socket(domain : Int32, type : Int32, protocol : Int32) : Int32
      fun bind(fd : Int32, addr : Void*, addrlen : UInt32) : Int32
      fun listen(fd : Int32, backlog : Int32) : Int32
      fun accept(fd : Int32, addr : Void*, addrlen : UInt32*) : Int32
      fun connect(fd : Int32, addr : Void*, addrlen : UInt32) : Int32
      fun send(fd : Int32, buf : Void*, len : UInt64, flags : Int32) : Int64
      fun recv(fd : Int32, buf : Void*, len : UInt64, flags : Int32) : Int64
      fun getsockname(fd : Int32, addr : Void*, addrlen : UInt32*) : Int32
      fun getpeername(fd : Int32, addr : Void*, addrlen : UInt32*) : Int32
      fun setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32) : Int32
      fun getsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32*) : Int32
      fun shutdown(fd : Int32, how : Int32) : Int32
      fun socketpair(domain : Int32, type : Int32, protocol : Int32, sv : Int32*) : Int32
      fun sendto(fd : Int32, buf : Void*, len : UInt64, flags : Int32, addr : Void*, addrlen : UInt32) : Int64
      fun recvfrom(fd : Int32, buf : Void*, len : UInt64, flags : Int32, addr : Void*, addrlen : UInt32*) : Int64
      fun fcntl(fd : Int32, cmd : Int32, arg : Int32) : Int32
    end

    def self.__sys_socket(domain : Int32, type : Int32, protocol : Int32) : Int32
      LibC.socket(domain, type, protocol)
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), addrlen : UInt32) : Int32
      LibC.bind(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_listen(fd : Int32, backlog : Int32) : Int32
      LibC.listen(fd, backlog)
    end

    def self.__sys_accept(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibC.accept(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), addrlen : UInt32) : Int32
      LibC.connect(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      LibC.send(fd, buf.as(Void*), len, 0)
    end

    def self.__sys_recv(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      LibC.recv(fd, buf.as(Void*), len, 0)
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : UInt32) : Int64
      LibC.sendto(fd, buf.as(Void*), len, flags, addr.as(Void*), addrlen)
    end

    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      LibC.recvfrom(fd, buf.as(Void*), len, flags, addr.as(Void*), addrlen)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibC.getsockname(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_getpeername(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibC.getpeername(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32) : Int32
      LibC.setsockopt(fd, level, optname, optval, optlen)
    end

    def self.__sys_getsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : Pointer(UInt32)) : Int32
      LibC.getsockopt(fd, level, optname, optval, optlen)
    end

    def self.__sys_shutdown(fd : Int32, how : Int32) : Int32
      LibC.shutdown(fd, how)
    end

    def self.__sys_socketpair(domain : Int32, type : Int32, protocol : Int32, sv : Pointer(Int32)) : Int32
      LibC.socketpair(domain, type, protocol, sv)
    end

    def self.__sys_fcntl(fd : Int32, cmd : Int32, arg : Int32) : Int32
      LibC.fcntl(fd, cmd, arg)
    end
  {% elsif flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    {% if flag?(:x86_64) %}
      SYS_SOCKET      =  41_i64
      SYS_CONNECT     =  42_i64
      SYS_ACCEPT      =  43_i64
      SYS_SENDTO      =  44_i64
      SYS_RECVFROM    =  45_i64
      SYS_SHUTDOWN    =  48_i64
      SYS_BIND        =  49_i64
      SYS_LISTEN      =  50_i64
      SYS_GETSOCKNAME =  51_i64
      SYS_GETPEERNAME =  52_i64
      SYS_SOCKETPAIR  =  53_i64
      SYS_SETSOCKOPT  =  54_i64
      SYS_GETSOCKOPT  =  55_i64
      SYS_FCNTL       =  72_i64
    {% else %}
      SYS_SOCKET      = 198_i64
      SYS_SOCKETPAIR  = 199_i64
      SYS_BIND        = 200_i64
      SYS_LISTEN      = 201_i64
      SYS_ACCEPT      = 202_i64
      SYS_CONNECT     = 203_i64
      SYS_GETSOCKNAME = 204_i64
      SYS_GETPEERNAME = 205_i64
      SYS_SENDTO      = 206_i64
      SYS_RECVFROM    = 207_i64
      SYS_SETSOCKOPT  = 208_i64
      SYS_GETSOCKOPT  = 209_i64
      SYS_SHUTDOWN    = 210_i64
      SYS_FCNTL       =  25_i64
    {% end %}

    def self.__sys2(number : Int64, a : Int64, b : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys3(number : Int64, a : Int64, b : Int64, c : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys4(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys5(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys6(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64, f : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e), "{r9}"(f)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e), "{x5}"(f)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys_socket(domain : Int32, type : Int32, protocol : Int32) : Int32
      __sys3(SYS_SOCKET, domain.to_i64, type.to_i64, protocol.to_i64).to_i32
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int32
      __sys3(SYS_BIND, fd.to_i64, addr.address.to_i64, addrlen).to_i32
    end

    def self.__sys_listen(fd : Int32, backlog : Int32) : Int32
      __sys3(SYS_LISTEN, fd.to_i64, backlog.to_i64, 0_i64).to_i32
    end

    def self.__sys_accept(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      __sys3(SYS_ACCEPT, fd.to_i64, addr.address.to_i64, addrlen.address.to_i64).to_i32
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int32
      __sys3(SYS_CONNECT, fd.to_i64, addr.address.to_i64, addrlen).to_i32
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      __sys6(SYS_SENDTO, fd.to_i64, buf.address.to_i64, len.to_i64, 0_i64, 0_i64, 0_i64)
    end

    def self.__sys_recv(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      __sys6(SYS_RECVFROM, fd.to_i64, buf.address.to_i64, len.to_i64, 0_i64, 0_i64, 0_i64)
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int64
      __sys6(SYS_SENDTO, fd.to_i64, buf.address.to_i64, len.to_i64, flags.to_i64, addr.address.to_i64, addrlen)
    end

    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      __sys6(SYS_RECVFROM, fd.to_i64, buf.address.to_i64, len.to_i64, flags.to_i64, addr.address.to_i64, addrlen.address.to_i64)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      __sys3(SYS_GETSOCKNAME, fd.to_i64, addr.address.to_i64, addrlen.address.to_i64).to_i32
    end

    def self.__sys_getpeername(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      __sys3(SYS_GETPEERNAME, fd.to_i64, addr.address.to_i64, addrlen.address.to_i64).to_i32
    end

    def self.__sys_setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : Int64) : Int32
      __sys5(SYS_SETSOCKOPT, fd.to_i64, level.to_i64, optname.to_i64, optval.address.to_i64, optlen).to_i32
    end

    def self.__sys_getsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : Pointer(UInt32)) : Int32
      __sys5(SYS_GETSOCKOPT, fd.to_i64, level.to_i64, optname.to_i64, optval.address.to_i64, optlen.address.to_i64).to_i32
    end

    def self.__sys_shutdown(fd : Int32, how : Int32) : Int32
      __sys2(SYS_SHUTDOWN, fd.to_i64, how.to_i64).to_i32
    end

    def self.__sys_socketpair(domain : Int32, type : Int32, protocol : Int32, sv : Pointer(Int32)) : Int32
      __sys4(SYS_SOCKETPAIR, domain.to_i64, type.to_i64, protocol.to_i64, sv.address.to_i64).to_i32
    end

    def self.__sys_fcntl(fd : Int32, cmd : Int32, arg : Int32) : Int32
      __sys3(SYS_FCNTL, fd.to_i64, cmd.to_i64, arg.to_i64).to_i32
    end
  {% else %}
    # A platform with neither the libc calls nor the syscalls. These answer
    # the failure every caller already handles, but their signatures have to
    # be the ones the callers actually use: a stub that takes a narrower
    # integer than `encode_address` hands it does not degrade, it stops the
    # program compiling for the platform it exists to support.
    def self.__sys_socket(domain : Int32, type : Int32, protocol : Int32) : Int32
      raise "Socket is not supported on this platform"
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int32
      -1
    end

    def self.__sys_listen(fd : Int32, backlog : Int32) : Int32
      -1
    end

    def self.__sys_accept(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int32
      -1
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      -1_i64
    end

    def self.__sys_recv(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      -1_i64
    end

    def self.__sys_sendto(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Int64) : Int64
      -1_i64
    end

    def self.__sys_recvfrom(fd : Int32, buf : Pointer(UInt8), len : UInt64, flags : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int64
      -1_i64
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_getpeername(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : Int64) : Int32
      -1
    end

    def self.__sys_getsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_shutdown(fd : Int32, how : Int32) : Int32
      -1
    end

    def self.__sys_socketpair(domain : Int32, type : Int32, protocol : Int32, sv : Pointer(Int32)) : Int32
      -1
    end

    def self.__sys_fcntl(fd : Int32, cmd : Int32, arg : Int32) : Int32
      -1
    end
  {% end %}
end

# --- IPSocket ---

pub class IPSocket < Socket
  def local_address : IPAddress
    addr = super
    if addr.is_a?(IPAddress)
      addr
    else
      raise "Expected IPAddress for local_address"
    end
  end

  def remote_address : IPAddress
    addr = super
    if addr.is_a?(IPAddress)
      addr
    else
      raise "Expected IPAddress for remote_address"
    end
  end

  def ipv6_only? : Bool
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 41, 27, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 41, 26, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val != 0
  end

  def ipv6_only=(val : Bool) : Nil
    opt = val ? 1_i32 : 0_i32
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 41, 27, pointerof(opt).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 41, 26, pointerof(opt).as(Void*), 4_i32)
    {% end %}
  end
end

# --- TCPSocket ---

pub class TCPSocket < IPSocket
  def initialize(host : String, port : Int32, dns_timeout = nil, connect_timeout = nil, blocking : Bool = true)
    fam = host.includes?(":") ? Family::INET6 : Family::INET
    super(fam, Type::STREAM, Protocol::TCP, blocking)
    connect(host, port, connect_timeout)
  end

  def initialize(family : Family = Family::INET, blocking : Bool = true)
    super(family, Type::STREAM, Protocol::TCP, blocking)
  end

  def initialize(action : Symbol, fd : Int32, family : Family = Family::INET, blocking : Bool = true)
    super(fd, family, Type::STREAM, Protocol::TCP, blocking)
  end

  def self.open(host : String, port : Int32, &block : TCPSocket ->)
    sock = TCPSocket.new(host, port)
    begin
      yield sock
    ensure
      sock.close
    end
  end

  def tcp_nodelay? : Bool
    val = 0_i32
    len = 4_u32
    Socket.__sys_getsockopt(@fd, 6, 1, pointerof(val).as(Void*), pointerof(len))
    val != 0
  end

  def tcp_nodelay=(val : Bool) : Nil
    opt = val ? 1_i32 : 0_i32
    Socket.__sys_setsockopt(@fd, 6, 1, pointerof(opt).as(Void*), 4_i32)
  end

  def tcp_keepalive_idle : Int32
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 6, 0x10, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 6, 4, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val
  end

  def tcp_keepalive_idle=(val : Int32) : Nil
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 6, 0x10, pointerof(val).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 6, 4, pointerof(val).as(Void*), 4_i32)
    {% end %}
  end

  def tcp_keepalive_interval : Int32
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 6, 0x101, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 6, 5, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val
  end

  def tcp_keepalive_interval=(val : Int32) : Nil
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 6, 0x101, pointerof(val).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 6, 5, pointerof(val).as(Void*), 4_i32)
    {% end %}
  end

  def tcp_keepalive_count : Int32
    val = 0_i32
    len = 4_u32
    {% if flag?(:darwin) %}
      Socket.__sys_getsockopt(@fd, 6, 0x102, pointerof(val).as(Void*), pointerof(len))
    {% else %}
      Socket.__sys_getsockopt(@fd, 6, 6, pointerof(val).as(Void*), pointerof(len))
    {% end %}
    val
  end

  def tcp_keepalive_count=(val : Int32) : Nil
    {% if flag?(:darwin) %}
      Socket.__sys_setsockopt(@fd, 6, 0x102, pointerof(val).as(Void*), 4_i32)
    {% else %}
      Socket.__sys_setsockopt(@fd, 6, 6, pointerof(val).as(Void*), 4_i32)
    {% end %}
  end
end

# --- TCPServer ---

pub class TCPServer < TCPSocket
  include SocketServer

  def initialize(host : String, port : Int32, backlog : Int32 = 128, dns_timeout = nil, reuse_port : Bool = false)
    fam = host.includes?(":") ? Family::INET6 : Family::INET
    super(fam, true)
    self.reuse_address = true
    self.reuse_port = true if reuse_port
    bind(host, port)
    listen(backlog)
  end

  def initialize(port : Int32, backlog : Int32 = 128, reuse_port : Bool = false)
    initialize("0.0.0.0", port, backlog, nil, reuse_port)
  end

  def initialize(family : Family = Family::INET)
    super(family, true)
  end

  def self.open(host : String, port : Int32, backlog : Int32 = 128, reuse_port : Bool = false, &block : TCPServer ->)
    srv = TCPServer.new(host, port, backlog, nil, reuse_port)
    begin
      yield srv
    ensure
      srv.close
    end
  end

  def self.open(port : Int32, backlog : Int32 = 128, reuse_port : Bool = false, &block : TCPServer ->)
    open("0.0.0.0", port, backlog, reuse_port, &block)
  end

  def accept : TCPSocket
    buf = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    client_fd = Socket.__sys_accept(@fd, buf, pointerof(len))
    raise "cannot accept socket" if client_fd < 0
    TCPSocket.new(:fd, client_fd, @family, @blocking)
  end

  def accept? : TCPSocket?
    buf = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    client_fd = Socket.__sys_accept(@fd, buf, pointerof(len))
    return nil if client_fd < 0
    TCPSocket.new(:fd, client_fd, @family, @blocking)
  end
end

# --- UNIXSocket ---

pub class UNIXSocket < Socket
  getter path : String?

  def initialize(@path : String, type : Type = Type::STREAM)
    super(Family::UNIX, type, Protocol::IP, true)
    connect(UNIXAddress.new(@path))
  end

  def initialize(action : Symbol, fd : Int32, type : Type = Type::STREAM, @path : String? = nil)
    super(fd, Family::UNIX, type, Protocol::IP, true)
  end

  def self.open(path : String, type : Type = Type::STREAM, &block : UNIXSocket ->)
    sock = UNIXSocket.new(path, type)
    begin
      yield sock
    ensure
      sock.close
    end
  end

  def self.pair(type : Type = Type::STREAM) : Tuple(UNIXSocket, UNIXSocket)
    sv = Pointer(Int32).malloc(2_u64)
    res = Socket.__sys_socketpair(1, type.value, 0, sv)
    raise "socketpair failed: #{res}" if res != 0
    {UNIXSocket.new(:fd, sv[0], type), UNIXSocket.new(:fd, sv[1], type)}
  end

  def self.pair(type : Type = Type::STREAM, &block : Tuple(UNIXSocket, UNIXSocket) ->)
    pair = self.pair(type)
    begin
      yield pair
    ensure
      pair[0].close
      pair[1].close
    end
  end

  def local_address : UNIXAddress
    addr = super
    if addr.is_a?(UNIXAddress)
      addr
    else
      raise "Expected UNIXAddress for local_address"
    end
  end

  def remote_address : UNIXAddress
    addr = super
    if addr.is_a?(UNIXAddress)
      addr
    else
      raise "Expected UNIXAddress for remote_address"
    end
  end

  def receive(max_message_size : Int32 = 512) : Tuple(String, UNIXAddress)
    res = super(max_message_size)
    addr = res[1]
    if addr.is_a?(UNIXAddress)
      {res[0], addr}
    else
      {res[0], UNIXAddress.new("")}
    end
  end
end

# --- UNIXServer ---

pub class UNIXServer < UNIXSocket
  include SocketServer

  @delete_on_close : Bool

  def initialize(path : String, type : Type = Type::STREAM, backlog : Int32 = 128)
    super(:fd, Socket.__sys_socket(Family::UNIX.value, type.value, 0), type, path)
    raise "cannot create UNIXServer socket" if @fd < 0
    @delete_on_close = true
    # Remove any existing socket file
    __iyi_unlink(path.to_unsafe)
    bind(UNIXAddress.new(path))
    listen(backlog)
  end

  def self.open(path : String, type : Type = Type::STREAM, backlog : Int32 = 128, &block : UNIXServer ->)
    srv = UNIXServer.new(path, type, backlog)
    begin
      yield srv
    ensure
      srv.close
    end
  end

  def accept : UNIXSocket
    buf = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    client_fd = Socket.__sys_accept(@fd, buf, pointerof(len))
    raise "cannot accept socket" if client_fd < 0
    UNIXSocket.new(:fd, client_fd, @type, @path)
  end

  def accept? : UNIXSocket?
    buf = Pointer(UInt8).malloc(128_u64)
    len = 128_u32
    client_fd = Socket.__sys_accept(@fd, buf, pointerof(len))
    return nil if client_fd < 0
    UNIXSocket.new(:fd, client_fd, @type, @path)
  end

  def close(delete : Bool = true) : Nil
    if delete && @delete_on_close
      if p = @path
        __iyi_unlink(p.to_unsafe)
      end
    end
    super()
  end
end

# --- UDPSocket ---

pub class UDPSocket < IPSocket
  def initialize(family : Family = Family::INET)
    super(family, Type::DGRAM, Protocol::UDP, true)
  end

  def receive(max_message_size : Int32 = 512) : Tuple(String, IPAddress)
    res = super(max_message_size)
    addr = res[1]
    if addr.is_a?(IPAddress)
      {res[0], addr}
    else
      raise "Expected IPAddress from UDPSocket#receive"
    end
  end

  def receive(buffer : Pointer(UInt8), count : Int32) : Tuple(Int32, IPAddress)
    addr_buf = Pointer(UInt8).malloc(128_u64)
    addr_len = 128_u32
    n = Socket.__sys_recvfrom(@fd, buffer, count.to_u64, 0, addr_buf, pointerof(addr_len))
    raise "cannot receive from UDP socket" if n < 0_i64
    addr = Socket.decode_address(addr_buf, addr_len)
    if addr.is_a?(IPAddress)
      {n.to_i32, addr}
    else
      raise "Expected IPAddress from UDP receive"
    end
  end

  def send(message : String, to address : IPAddress) : Int32
    buf, len = Socket.encode_ip_address(address)
    res = Socket.__sys_sendto(@fd, message.to_unsafe, message.bytesize.to_u64, 0, buf, len)
    raise "cannot send on UDP socket" if res < 0_i64
    res.to_i32
  end

  def send(buffer : Pointer(UInt8), count : Int32, to address : IPAddress) : Int32
    buf, len = Socket.encode_ip_address(address)
    res = Socket.__sys_sendto(@fd, buffer, count.to_u64, 0, buf, len)
    raise "cannot send on UDP socket" if res < 0_i64
    res.to_i32
  end

  def join_group(address : String) : Nil
  end

  def leave_group(address : String) : Nil
  end

  def multicast_hops : Int32
    64
  end

  def multicast_hops=(val : Int32) : Nil
  end

  def multicast_loopback? : Bool
    true
  end

  def multicast_loopback=(val : Bool) : Nil
  end

  def multicast_interface(address : String) : Nil
  end
end

# --- Legacy IyiSocket for backward compatibility ---

# --- Legacy IyiSocket for backward compatibility ---

pub class IyiSocket
  getter fd : Int32

  def initialize(@fd : Int32)
  end

  def to_unsafe : Int32
    @fd
  end

  {% if @top_level.has_constant?("IyiIO") %}
    def to_io : IyiIO
      IyiIO.new(@fd)
    end
  {% end %}

  # --- Connection and Listening ---

  def self.connect(host : String, port : Int32) : IyiSocket
    fd = __sys_socket
    raise "cannot create socket" if fd < 0

    ip = parse_ip(host)
    addr = make_sockaddr_in(ip, port)
    if __sys_connect(fd, addr) < 0
      __iyi_close(fd.to_i64)
      raise "cannot connect to #{host}:#{port}"
    end

    IyiSocket.new(fd)
  end

  def self.listen(host : String, port : Int32, backlog : Int32 = 128) : IyiSocket
    fd = __sys_socket
    raise "cannot create socket" if fd < 0

    __sys_set_reuseaddr(fd)

    ip = parse_ip(host)
    addr = make_sockaddr_in(ip, port)
    if __sys_bind(fd, addr) < 0
      __iyi_close(fd.to_i64)
      raise "cannot bind socket to #{host}:#{port}"
    end

    if __sys_listen(fd, backlog) < 0
      __iyi_close(fd.to_i64)
      raise "cannot listen on socket"
    end

    IyiSocket.new(fd)
  end

  def self.listen(port : Int32, backlog : Int32 = 128) : IyiSocket
    listen("0.0.0.0", port, backlog)
  end

  def accept : IyiSocket
    addr = Pointer(UInt8).malloc(16_u64)
    len = 16_u32
    client_fd = IyiSocket.__sys_accept(@fd, addr, pointerof(len))
    raise "cannot accept socket" if client_fd < 0

    IyiSocket.new(client_fd)
  end

  # --- Reading and Writing ---

  def read(max_bytes : Int32 = 4096) : String
    buffer = Pointer(UInt8).malloc(max_bytes.to_u64)
    count = IyiSocket.__sys_recv(@fd, buffer, max_bytes.to_u64)
    raise "cannot read from socket" if count < 0_i64
    return "" if count == 0_i64

    String.new(count.to_i32) do |target|
      target.copy_from(buffer, count.to_i32)
    end
  end

  def read(buffer : Pointer(UInt8), count : Int32) : Int32
    n = IyiSocket.__sys_recv(@fd, buffer, count.to_u64)
    raise "cannot read from socket" if n < 0_i64
    n.to_i32
  end

  def recv(max_bytes : Int32 = 4096) : String
    read(max_bytes)
  end

  def recv(buffer : Pointer(UInt8), count : Int32) : Int32
    read(buffer, count)
  end

  def write(contents : String) : Int32
    written = 0
    total = contents.bytesize
    bytes = contents.to_unsafe
    while written < total
      count = IyiSocket.__sys_send(@fd, bytes + written, (total - written).to_u64)
      raise "cannot write to socket" if count <= 0_i64
      written = written + count.to_i32
    end
    written
  end

  def write(buffer : Pointer(UInt8), count : Int32) : Int32
    written = 0
    while written < count
      n = IyiSocket.__sys_send(@fd, buffer + written, (count - written).to_u64)
      raise "cannot write to socket" if n <= 0_i64
      written = written + n.to_i32
    end
    written
  end

  def send(contents : String) : Int32
    write(contents)
  end

  def send(buffer : Pointer(UInt8), count : Int32) : Int32
    write(buffer, count)
  end

  # --- Lifecycle and Metadata ---

  def close : Nil
    if @fd >= 0
      __iyi_close(@fd.to_i64)
      @fd = -1
    end
  end

  def closed? : Bool
    @fd < 0
  end

  def local_port : Int32
    addr = Pointer(UInt8).malloc(16_u64)
    len = 16_u32
    res = IyiSocket.__sys_getsockname(@fd, addr, pointerof(len))
    raise "cannot get local port" if res < 0

    high = addr[2].to_i32
    low = addr[3].to_i32
    (high << 8) | low
  end

  def local_address : String
    addr = Pointer(UInt8).malloc(16_u64)
    len = 16_u32
    res = IyiSocket.__sys_getsockname(@fd, addr, pointerof(len))
    raise "cannot get local address" if res < 0

    "#{addr[4]}.#{addr[5]}.#{addr[6]}.#{addr[7]}"
  end

  # --- Address and Struct Construction ---

  def self.parse_ip(host : String) : IPv4Address
    return IPv4Address.new(127_u8, 0_u8, 0_u8, 1_u8) if host == "localhost"
    return IPv4Address.new(0_u8, 0_u8, 0_u8, 0_u8) if host == "0.0.0.0" || host == ""

    parts = 0
    curr = 0
    has_digit = false
    bytes = Pointer(UInt8).malloc(4_u64)
    index = 0
    len = host.bytesize

    while index < len
      ch = host[index]
      if ch == '.'
        raise "cannot resolve address: #{host}" unless has_digit
        raise "cannot resolve address: #{host}" if curr > 255 || parts >= 4
        bytes[parts] = curr.to_u8
        parts = parts + 1
        curr = 0
        has_digit = false
      elsif ch >= '0' && ch <= '9'
        # Bounded while it accumulates: `"999999999999.1.1.1"` left `Int32`
        # on the checked `*` and died of "arithmetic overflow" instead of
        # saying which address it could not resolve.
        raise "cannot resolve address: #{host}" if curr > 255
        curr = curr * 10 + (ch.ord - 48)
        has_digit = true
      else
        raise "cannot resolve address: #{host}"
      end
      index = index + 1
    end

    raise "cannot resolve address: #{host}" unless has_digit
    raise "cannot resolve address: #{host}" if curr > 255
    raise "cannot resolve address: #{host}" unless parts == 3
    bytes[3] = curr.to_u8

    IPv4Address.new(bytes[0], bytes[1], bytes[2], bytes[3])
  end

  def self.make_sockaddr_in(ip : IPv4Address, port : Int32) : Pointer(UInt8)
    # A port is sixteen bits, and this packed it without asking: `listen`
    # with 70000 bound 4464 (70000 - 65536) and `-1` bound 65535, so a
    # program that computed a port wrong was given a different one and told
    # nothing. Both callers - `connect` and `listen` - come through here.
    raise "port #{port} is not a port: 0 to 65535" if port < 0 || port > 65535
    buffer = Pointer(UInt8).malloc(16_u64)
    index = 0
    while index < 16
      buffer[index] = 0_u8
      index = index + 1
    end

    {% if flag?(:darwin) %}
      buffer[0] = 16_u8 # sin_len = 16
      buffer[1] = 2_u8  # sin_family = AF_INET (2)
    {% else %}
      buffer[0] = 2_u8 # sin_family = AF_INET (2) (little-endian uint16)
      buffer[1] = 0_u8
    {% end %}

    buffer[2] = ((port >> 8) & 255).to_u8
    buffer[3] = (port & 255).to_u8

    buffer[4] = ip.b0
    buffer[5] = ip.b1
    buffer[6] = ip.b2
    buffer[7] = ip.b3

    buffer
  end

  # --- Platform System Call Bindings ---

  {% if flag?(:darwin) %}
    lib LibC
      fun socket(domain : Int32, type : Int32, protocol : Int32) : Int32
      fun bind(fd : Int32, addr : Void*, addrlen : UInt32) : Int32
      fun listen(fd : Int32, backlog : Int32) : Int32
      fun accept(fd : Int32, addr : Void*, addrlen : UInt32*) : Int32
      fun connect(fd : Int32, addr : Void*, addrlen : UInt32) : Int32
      fun send(fd : Int32, buf : Void*, len : UInt64, flags : Int32) : Int64
      fun recv(fd : Int32, buf : Void*, len : UInt64, flags : Int32) : Int64
      fun getsockname(fd : Int32, addr : Void*, addrlen : UInt32*) : Int32
      fun setsockopt(fd : Int32, level : Int32, optname : Int32, optval : Void*, optlen : UInt32) : Int32
    end

    # The length of a `sockaddr_in`, in the type each branch's call wants. It
    # is a property of the address family rather than of the caller, so the
    # callers do not pass it: `UInt32` here for libSystem's `socklen_t`, and
    # `Int64` on the syscall branch, because the prelude has no conversion
    # between the two. `UInt32` has neither `to_i64` nor `to_u64`, and `Int32`
    # has no `to_u32`, which is what made a shared parameter type impossible.
    SOCKADDR_IN_SIZE = 16_u32

    def self.__sys_socket : Int32
      LibC.socket(2, 1, 0)
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8)) : Int32
      LibC.bind(fd, addr.as(Void*), SOCKADDR_IN_SIZE)
    end

    def self.__sys_listen(fd : Int32, backlog : Int32) : Int32
      LibC.listen(fd, backlog)
    end

    def self.__sys_accept(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibC.accept(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8)) : Int32
      LibC.connect(fd, addr.as(Void*), SOCKADDR_IN_SIZE)
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      LibC.send(fd, buf.as(Void*), len, 0)
    end

    def self.__sys_recv(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      LibC.recv(fd, buf.as(Void*), len, 0)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      LibC.getsockname(fd, addr.as(Void*), addrlen)
    end

    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      val = 1_i32
      LibC.setsockopt(fd, 0xffff, 0x0004, pointerof(val).as(Void*), 4_u32)
    end
  {% elsif flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    {% if flag?(:x86_64) %}
      SYS_SOCKET      =  41_i64
      SYS_CONNECT     =  42_i64
      SYS_ACCEPT      =  43_i64
      SYS_SENDTO      =  44_i64
      SYS_RECVFROM    =  45_i64
      SYS_BIND        =  49_i64
      SYS_LISTEN      =  50_i64
      SYS_GETSOCKNAME =  51_i64
      SYS_SETSOCKOPT  =  54_i64
    {% else %}
      SYS_SOCKET      = 198_i64
      SYS_BIND        = 200_i64
      SYS_LISTEN      = 201_i64
      SYS_ACCEPT      = 202_i64
      SYS_CONNECT     = 203_i64
      SYS_GETSOCKNAME = 204_i64
      SYS_SENDTO      = 206_i64
      SYS_RECVFROM    = 207_i64
      SYS_SETSOCKOPT  = 208_i64
    {% end %}

    # Sized as the syscall takes it, a full register. See the darwin branch's
    # note: this is a separate constant rather than a converted one because
    # the prelude has no conversion between `UInt32` and the 64-bit types.
    SOCKADDR_IN_SIZE = 16_i64

    def self.__sys3(number : Int64, a : Int64, b : Int64, c : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys5(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys6(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64, f : Int64) : Int64
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e), "{r9}"(f)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e), "{x5}"(f)
                     : "memory"
                     : "volatile")
      {% end %}
      result
    end

    def self.__sys_socket : Int32
      __sys3(SYS_SOCKET, 2_i64, 1_i64, 0_i64).to_i32
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8)) : Int32
      __sys3(SYS_BIND, fd.to_i64, addr.address.to_i64, SOCKADDR_IN_SIZE).to_i32
    end

    def self.__sys_listen(fd : Int32, backlog : Int32) : Int32
      __sys3(SYS_LISTEN, fd.to_i64, backlog.to_i64, 0_i64).to_i32
    end

    def self.__sys_accept(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      __sys3(SYS_ACCEPT, fd.to_i64, addr.address.to_i64, addrlen.address.to_i64).to_i32
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8)) : Int32
      __sys3(SYS_CONNECT, fd.to_i64, addr.address.to_i64, SOCKADDR_IN_SIZE).to_i32
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      __sys6(SYS_SENDTO, fd.to_i64, buf.address.to_i64, len.to_i64, 0_i64, 0_i64, 0_i64)
    end

    def self.__sys_recv(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      __sys6(SYS_RECVFROM, fd.to_i64, buf.address.to_i64, len.to_i64, 0_i64, 0_i64, 0_i64)
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      __sys3(SYS_GETSOCKNAME, fd.to_i64, addr.address.to_i64, addrlen.address.to_i64).to_i32
    end

    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      val = 1_i32
      __sys5(SYS_SETSOCKOPT, fd.to_i64, 1_i64, 2_i64, pointerof(val).address.to_i64, 4_i64).to_i32
    end
  {% else %}
    def self.__sys_socket : Int32
      raise "IyiSocket is not supported on this platform"
    end

    def self.__sys_bind(fd : Int32, addr : Pointer(UInt8)) : Int32
      -1
    end

    def self.__sys_listen(fd : Int32, backlog : Int32) : Int32
      -1
    end

    def self.__sys_accept(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_connect(fd : Int32, addr : Pointer(UInt8)) : Int32
      -1
    end

    def self.__sys_send(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      -1_i64
    end

    def self.__sys_recv(fd : Int32, buf : Pointer(UInt8), len : UInt64) : Int64
      -1_i64
    end

    def self.__sys_getsockname(fd : Int32, addr : Pointer(UInt8), addrlen : Pointer(UInt32)) : Int32
      -1
    end

    def self.__sys_set_reuseaddr(fd : Int32) : Int32
      -1
    end
  {% end %}
end
