; iyi-ir 1
source_filename = "integer_call"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i64 @get_bits()

define internal void @integer_call(i1 %run, ptr %out) {
entry:
  %bits = call i64 () @get_bits()
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %offset = add i64 %bits, 8
  store i64 %offset, ptr %out, align 8
  br label %head
done:
  ret void
}
