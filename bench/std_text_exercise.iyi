# Text processing standard library exercise.
#
#   ./bin/iyi run bench/std_text_exercise.iyi
#
# Exercises the entire Char and String surface provided by std/text:
# ASCII predicates, case conversion, integer and float parsing with failure stories,
# strip/chomp/chop, splitting and partitioning, search and index, sub and gsub,
# transformations (tr, squeeze, delete, count, center), UTF-8 decoding and
# encoding preservation, and collection joining.
#
# Every section prints a progress line and raises on mismatch.

import std/text

# 1. Char inspection and ASCII predicates
raise "char: ascii_letter lowercase" unless 'a'.ascii_letter?
raise "char: ascii_letter uppercase" unless 'Z'.ascii_letter?
raise "char: ascii_letter negative" if '5'.ascii_letter?
raise "char: ascii_number positive" unless '9'.ascii_number?
raise "char: ascii_number negative" if 'x'.ascii_number?
raise "char: ascii_lowercase positive" unless 'k'.ascii_lowercase?
raise "char: ascii_lowercase negative" if 'K'.ascii_lowercase?
raise "char: ascii_uppercase positive" unless 'M'.ascii_uppercase?
raise "char: ascii_uppercase negative" if 'm'.ascii_uppercase?
raise "char: ascii_alphanumeric letter" unless 'q'.ascii_alphanumeric?
raise "char: ascii_alphanumeric digit" unless '3'.ascii_alphanumeric?
raise "char: ascii_alphanumeric symbol" if '!'.ascii_alphanumeric?
raise "char: ascii_whitespace space" unless ' '.ascii_whitespace?
raise "char: ascii_whitespace tab" unless '\t'.ascii_whitespace?
raise "char: ascii_whitespace newline" unless '\n'.ascii_whitespace?
raise "char: ascii_whitespace non-space" if 'a'.ascii_whitespace?
raise "char: ord" unless 'A'.ord == 65
puts "    char inspection: letter, number, case, alphanumeric, whitespace, and ord verified"

# 2. Case conversion (Char and String)
raise "char: upcase" unless 'g'.upcase == 'G'
raise "char: upcase non-letter" unless '1'.upcase == '1'
raise "char: downcase" unless 'G'.downcase == 'g'
raise "char: downcase non-letter" unless '?'.downcase == '?'
raise "string: capitalize standard" unless "hello WORLD".capitalize == "Hello world"
raise "string: capitalize empty" unless "".capitalize == ""
raise "string: capitalize single" unless "a".capitalize == "A"
puts "    case conversion: char upcase, downcase, and string capitalize verified"

# 3. Conversions with failure stories (Char and String)
raise "char: to_i decimal" unless '7'.to_i == 7
raise "char: to_i? valid" unless '4'.to_i? == 4
raise "char: to_i? invalid" unless 'x'.to_i?.nil?
raise "char: to_i hex" unless 'f'.to_i(16) == 15
raise "char: to_i? hex invalid" unless 'z'.to_i?(16).nil?

raise "string: to_i base 16" unless "ff".to_i(16) == 255
raise "string: to_i base 2 negative" unless "-1010".to_i(2) == -10
raise "string: to_i base 8 plus" unless "+77".to_i(8) == 63
raise "string: to_i? invalid base" unless "89".to_i?(8).nil?
raise "string: to_i? empty" unless "".to_i?(10).nil?

raise "string: to_i64 plain" unless "9000000000".to_i64 == 9000000000_i64
raise "string: to_i64 base 16" unless "100000000".to_i64(16) == 4294967296_i64
raise "string: to_i64? invalid" unless "not_a_num".to_i64?.nil?
raise "string: to_i64? base invalid" unless "zz".to_i64?(10).nil?

raise "string: to_f? standard" unless "12.34".to_f? == 12.34
raise "string: to_f? exponent" unless "-0.5e2".to_f? == -50.0
raise "string: to_f? leading dot" unless ".5".to_f? == 0.5
raise "string: to_f? trailing dot" unless "7.".to_f? == 7.0
nan_val = "NaN".to_f?
raise "string: to_f? nan" unless nan_val && nan_val != nan_val
# A sign before NaN, as `to_f` reads it: "-NaN" and "+NaN" were nil here.
minus_nan = "-NaN".to_f?
plus_nan = "+NaN".to_f?
raise "string: to_f? signed nan" unless minus_nan && minus_nan != minus_nan && plus_nan && plus_nan != plus_nan
raise "string: to_f? invalid text" unless "bad".to_f?.nil?
raise "string: to_f? double dot" unless "1.2.3".to_f?.nil?
raise "string: to_f? double sign" unless "--5".to_f?.nil?
raise "string: to_f? empty" unless "".to_f?.nil?
puts "    base conversion: to_i, to_i64 with bases 2..36, and nilable to_f? verified"

# 4. Whitespace, strip, chomp, chop, and blank/presence
raise "string: blank? true" unless "  \t\r\n ".blank?
raise "string: blank? empty" unless "".blank?
raise "string: blank? false" if "  a  ".blank?
raise "string: presence blank" unless "   ".presence.nil?
raise "string: presence non-blank" unless "word".presence == "word"
# `\v` and `\f` are the whitespace `ascii_whitespace?` names, so `blank?`,
# `lstrip` and `rstrip` look through them too.
raise "string: blank? vertical tab and form feed" unless "\v\f".blank?
raise "string: lstrip vertical tab" unless "\v\fa\v\f".lstrip.bytesize == 3
raise "string: rstrip form feed" unless "\v\fa\v\f".rstrip.bytesize == 3
raise "string: lstrip rstrip control whitespace" unless "\v\fa\v\f".lstrip.rstrip == "a"

raise "string: lstrip" unless "  hi  ".lstrip == "hi  "
raise "string: lstrip char" unless "===test===".lstrip('=') == "test==="
raise "string: lstrip chars" unless "<({[test]})>".lstrip("<({[") == "test]})>"
raise "string: rstrip" unless "  hi  ".rstrip == "  hi"
raise "string: rstrip char" unless "===test===".rstrip('=') == "===test"
raise "string: rstrip chars" unless "<({[test]})>".rstrip("]})>") == "<({[test"
raise "string: strip char" unless "---mid---".strip('-') == "mid"
raise "string: strip chars" unless "/* comment */".strip("/* ") == "comment"

raise "string: chomp crlf" unless "line\r\n".chomp == "line"
raise "string: chomp lf" unless "line\n".chomp == "line"
raise "string: chomp cr" unless "line\r".chomp == "line"
raise "string: chomp suffix" unless "file.tar.gz".chomp(".gz") == "file.tar"
raise "string: chomp non-suffix" unless "file.tar".chomp(".gz") == "file.tar"
raise "string: chop crlf" unless "line\r\n".chop == "line"
raise "string: chop char" unless "word!".chop == "word"
raise "string: chop empty" unless "".chop == ""
# The last character, not the last byte: `"hé".chop` answered `h` plus half
# of `é`, two bytes that are not a string.
raise "string: chop multibyte" unless "hé".chop == "h"
raise "string: chop multibyte, three bytes" unless "a✓".chop == "a"
raise "string: chop keeps the rest intact" unless "✓✓".chop == "✓"

raise "string: ends_with? char true" unless "hello".ends_with?('o')
raise "string: ends_with? char false" if "hello".ends_with?('h')
# A set of characters, not of bytes: `©` is C2 A9 and `é` is C3 A9, and a
# byte mask took half of `é` and left a C3 that is not a string.
raise "string: rstrip chars shares a byte" unless "xé".rstrip("©") == "xé"
raise "string: lstrip chars shares a byte" unless "éx".lstrip("Ã") == "éx"
raise "string: strip chars of other characters' bytes" unless "è".strip("é¨") == "è"
# `"\n"` is every line ending, as `chomp` reads it.
raise "string: chomp newline" unless "a\r\n".chomp("\n") == "a"
# The prelude's own three beside these: `strip` takes `\v` and `\f`, as
# `lstrip` and `rstrip` do; `chomp('\n')` takes the `\r` of a `\r\n`, or a
# lone `\r`, as `chomp("\n")` does; and `lines` keeps a last `\r` that no
# `\n` follows, as `each_line` does. Each answered otherwise.
raise "prelude: strip vertical tab and form feed" unless "\v\fa\v\f".strip == "a"
raise "prelude: chomp newline takes the cr" unless "a\r\n".chomp('\n') == "a" && "a\r".chomp('\n') == "a" && "a\n\r".chomp('\n') == "a\n"
raise "prelude: lines keeps a last cr" unless "x\ny\r".lines == ["x", "y\r"] && "x\r\n".lines == ["x"] && "\r".lines == ["\r"]
puts "    strip and chomp: blank, presence, lstrip, rstrip, strip, chomp, and chop verified"

# 5. Split, join, partition, and rpartition
sp1 = "  apple   banana   cherry  ".split
raise "string: split whitespace" unless sp1.size == 3 && sp1[0] == "apple" && sp1[1] == "banana" && sp1[2] == "cherry"

sp2 = "one two three four".split(2)
raise "string: split limit" unless sp2.size == 2 && sp2[0] == "one" && sp2[1] == "two three four"

sp3 = "a::b::c::d".split("::")
raise "string: split str" unless sp3.size == 4 && sp3[1] == "b"

sp4 = "a::b::c::d".split("::", 3)
raise "string: split str limit" unless sp4.size == 3 && sp4[2] == "c::d"

sp5 = "x,y,z,w".split(',', 2)
raise "string: split char limit" unless sp5.size == 2 && sp5[1] == "y,z,w"

# `\v` and `\f` separate words here too, as `blank?` and `strip` see them.
sp6 = "a\vb\fc d".split
raise "string: split vertical tab and form feed" unless sp6.size == 4 && sp6[1] == "b" && sp6[2] == "c"
sp7 = "abc".split("", 2)
raise "string: split empty separator limit" unless sp7.size == 2 && sp7[0] == "a" && sp7[1] == "bc"
raise "string: split empty string on empty separator" unless "".split("").size == 1

part1 = "host:port:8080".partition(":")
raise "string: partition found" unless part1[0] == "host" && part1[1] == ":" && part1[2] == "port:8080"

part2 = "nohost".partition(":")
raise "string: partition not found" unless part2[0] == "nohost" && part2[1] == "" && part2[2] == ""

part3 = "key=value".partition('=')
raise "string: partition char" unless part3[0] == "key" && part3[1] == "=" && part3[2] == "value"

rpart1 = "host:port:8080".rpartition(":")
raise "string: rpartition found" unless rpart1[0] == "host:port" && rpart1[1] == ":" && rpart1[2] == "8080"

rpart2 = "nohost".rpartition(":")
raise "string: rpartition not found" unless rpart2[0] == "" && rpart2[1] == "" && rpart2[2] == "nohost"

rpart3 = "a/b/c".rpartition('/')
raise "string: rpartition char" unless rpart3[0] == "a/b" && rpart3[1] == "/" && rpart3[2] == "c"

raise "string: self.join array" unless String.join(["a", "b", "c"], "-") == "a-b-c"
raise "string: self.join default sep" unless String.join(["a", "b", "c"]) == "abc"
raise "array: join no sep" unless ["x", "y", "z"].join == "xyz"
raise "array: join char sep" unless ["x", "y", "z"].join('/') == "x/y/z"
puts "    split and partition: split on whitespace/char/str with limits, partition, and join verified"

# 6. Search and index
raise "string: index char with offset" unless "banana".index('a', 2) == 3
raise "string: index char offset not found" unless "banana".index('b', 1).nil?
raise "string: index str" unless "banana".index("na") == 2
raise "string: index str with offset" unless "banana".index("na", 3) == 4
raise "string: index str not found" unless "banana".index("xyz").nil?

raise "string: rindex char" unless "banana".rindex('a') == 5
raise "string: rindex char offset" unless "banana".rindex('a', 4) == 3
raise "string: rindex char not found" unless "banana".rindex('z').nil?
raise "string: rindex str" unless "banana".rindex("an") == 3
raise "string: rindex str offset" unless "banana".rindex("an", 2) == 1
raise "string: rindex str not found" unless "banana".rindex("xyz").nil?
puts "    search and index: forward and reverse index on char and string with offsets verified"

# 7. Substitutions (sub and gsub)
raise "string: sub str" unless "hello world".sub("world", "there") == "hello there"
raise "string: sub char" unless "banana".sub('a', 'o') == "bonana"
raise "string: sub char to str" unless "a+b".sub('+', " plus ") == "a plus b"
raise "string: sub str block" unless "item 123 end".sub("123") { |m| "[#{m}]" } == "item [123] end"
raise "string: sub char block" unless "hello".sub('l') { |c| "L" } == "heLlo"

raise "string: gsub str" unless "banana".gsub("an", "XX") == "bXXXXa"
raise "string: gsub char" unless "banana".gsub('a', 'o') == "bonono"
raise "string: gsub char to str" unless "a,b,c".gsub(',', " and ") == "a and b and c"
raise "string: gsub str block" unless "foo bar foo".gsub("foo") { |m| m.upcase } == "FOO bar FOO"
raise "string: gsub char block" unless "hello".gsub('l') { |c| "L" } == "heLLo"
puts "    substitution: sub and gsub with string, char, and block overloads verified"

# 8. Transformations (tr, delete, squeeze, count, center)
raise "string: tr direct" unless "hello".tr("el", "ip") == "hippo"
raise "string: tr short target" unless "hello".tr("aeiou", "*") == "h*ll*"
raise "string: tr empty target" unless "hello".tr("el", "") == "ho"
# `a-z` names a run in either set, and a `-` at an end is itself.
raise "string: tr range" unless "hello".tr("a-y", "b-z") == "ifmmp"
raise "string: tr range deleted" unless "hello".tr("a-y", "") == ""
raise "string: tr leading dash" unless "a-b".tr("-a", "+x") == "x+b"
raise "string: tr trailing dash" unless "a-b".tr("b-", "y+") == "a+y"
raise "string: delete char" unless "hello world".delete('o') == "hell wrld"
raise "string: delete chars" unless "hello world".delete("aeiou") == "hll wrld"
raise "string: squeeze all" unless "yellow  moon".squeeze == "yelow mon"
raise "string: squeeze char" unless "yellow  moon".squeeze('o') == "yellow  mon"
raise "string: squeeze chars" unless "yellow  moon".squeeze(" l") == "yelow moon"
raise "string: count char" unless "banana".count('a') == 3
raise "string: count str" unless "banana".count("an") == 2
raise "string: center char pad" unless "hello".center(11, '-') == "---hello---"
raise "string: center str pad" unless "hello".center(12, "-=") == "-=-hello-=-="
# A run of a character, not of a byte: `耀` is E8 80 80.
raise "string: squeeze multi-byte run" unless "ééé".squeeze == "é"
raise "string: squeeze inside a character" unless "耀".squeeze == "耀"
puts "    transformations: tr, delete, squeeze, count, and center verified"

# 9. UTF-8 awareness and byte/character boundaries
# Multi-byte test string: "héllo" contains 2-byte UTF-8 character 'é' (\xC3\xA9).
s_utf8 = "héllo"
raise "utf8: size counts characters" unless s_utf8.size == 5
raise "utf8: bytesize counts bytes" unless s_utf8.bytesize == 6
# Indexing is byte-indexed:
raise "utf8: byte indexing byte 0" unless s_utf8[0] == 'h'
raise "utf8: byte indexing byte 1 (fragment)" unless s_utf8[1].ord == 195
raise "utf8: byte indexing byte 2 (fragment)" unless s_utf8[2].ord == 169
raise "utf8: byte indexing byte 3" unless s_utf8[3] == 'l'
raise "utf8: byte offset index" unless s_utf8.index('l') == 3

# Char encoding preservation:
c_accent = 'é'
raise "utf8: char ord" unless c_accent.ord == 233
raise "utf8: char bytesize" unless c_accent.bytesize == 2
raise "utf8: char to_s" unless c_accent.to_s == "é"
raise "utf8: char to_s bytesize" unless c_accent.to_s.bytesize == 2
raise "utf8: char to_s size" unless c_accent.to_s.size == 1

# Padding, which is asked for to line a column up, so its width is the one
# `size` reports and not the byte count: padded by bytes, `"héllo"` in a
# seven-wide column came out six characters long.
padded_right = s_utf8.ljust(7, '.')
raise "utf8: ljust width" unless padded_right.size == 7
raise "utf8: ljust bytes" unless padded_right.bytesize == 8
raise "utf8: ljust content" unless padded_right == "héllo.."
padded_left = s_utf8.rjust(7, '.')
raise "utf8: rjust width" unless padded_left.size == 7
raise "utf8: rjust content" unless padded_left == "..héllo"
# And a pad that is itself multi-byte travels whole, not as its low byte.
wide_pad = s_utf8.rjust(7, '·')
raise "utf8: wide pad width" unless wide_pad.size == 7
raise "utf8: wide pad bytes" unless wide_pad.bytesize == 10
raise "utf8: wide pad content" unless wide_pad == "··héllo"
# A width that already fits is the string, and ASCII pads as it always did.
raise "utf8: pad fits" unless s_utf8.ljust(3, '.') == "héllo"
raise "utf8: ascii pad" unless "42".rjust(5) == "   42"

# String chars decoding:
decoded_chars = s_utf8.chars
raise "utf8: chars size" unless decoded_chars.size == 5
# Characters, not bytes: a byte mask of `é` stripped the lead or tail byte
# of any character sharing one, and left invalid UTF-8 behind.
raise "string: rstrip chars keeps a character that shares a byte" unless "Ω".rstrip("é") == "Ω" && "é".rstrip("Ω") == "é"
raise "string: lstrip chars keeps a character that shares a byte" unless "Ãx".lstrip("é") == "Ãx"
raise "string: strip non-ASCII chars" unless "éxΩé".strip("é") == "xΩ" && "ééaé".lstrip("é") == "aé" && "aéé".rstrip("é") == "a"
# And squeeze compares characters: `ッ` is E3 83 83, and lost a byte.
raise "string: squeeze keeps a character with a repeated byte" unless "ッ".squeeze == "ッ" && "キャッシュ".squeeze == "キャッシュ"
raise "string: squeeze a run of a multi-byte character" unless "ççaa".squeeze == "ça"
# And split("", limit) reads its limit.
raise "string: split empty with a limit" unless "abc".split("", 2) == ["a", "bc"] && "ğüş".split("", 2) == ["ğ", "üş"] && "abc".split("") == ["a", "b", "c"]
raise "utf8: chars[0]" unless decoded_chars[0] == 'h'
raise "utf8: chars[1]" unless decoded_chars[1] == 'é'
raise "utf8: chars[2]" unless decoded_chars[2] == 'l'
raise "utf8: chars[3]" unless decoded_chars[3] == 'l'
raise "utf8: chars[4]" unless decoded_chars[4] == 'o'

# String each_char decoding:
char_count = 0
s_utf8.each_char do |c|
  char_count = char_count + 1
end
raise "utf8: each_char count" unless char_count == 5
# A byte that starts no well-formed sequence is one character to `size` and
# to `each_char`, as the other library reads it and as the compiler counts
# a literal: built from a literal's bytes, `"\x80"` answered `size` 0, and
# `"\xC3a"` was two to `size` and one to `each_char`.
invalid_counts = ["\x80", "\xC3a", "\xE2\x82", "\xE2\x82a", "\xED\xA0\x80", "\xF0\x9F\x98", "\xF0\x9F\x98a", "\xC0\x80", "a\xF4\x90\x80\x80"].map do |text|
  built = text * 1
  yielded = [] of Int32
  built.each_char { |c| yielded << c.ord }
  "#{text.size}/#{built.size}/#{yielded.size}"
end
raise "utf8: an invalid byte is one character (#{invalid_counts.join(" ")})" unless invalid_counts.join(" ") == "1/1/1 2/2/2 2/2/2 3/3/3 3/3/3 3/3/3 4/4/4 2/2/2 5/5/5"
# And what it yields for that byte is U+FFFD, as the other library's reader
# does, not the byte read as a code point.
invalid_points = [] of Int32
("\xC3a" * 1).each_char { |c| invalid_points << c.ord }
raise "utf8: an invalid byte is yielded as U+FFFD" unless invalid_points == [0xFFFD, 97]

# Byte iteration:
b_list = s_utf8.bytes
raise "utf8: bytes count" unless b_list.size == 6
raise "utf8: bytes values" unless b_list[0] == 104_u8 && b_list[1] == 195_u8 && b_list[2] == 169_u8

byte_count = 0
s_utf8.each_byte do |b|
  byte_count = byte_count + 1
end
raise "utf8: each_byte count" unless byte_count == 6

# Line iteration:
lines_seen = [] of String
"first\nsecond\r\nthird".each_line do |line|
  lines_seen << line
end
raise "utf8: each_line" unless lines_seen.size == 3 && lines_seen[1] == "second"

# UTF-8 reverse preserves multi-byte characters intact:
reversed = s_utf8.reverse
raise "utf8: reverse content" unless reversed == "olléh"
raise "utf8: reverse size" unless reversed.size == 5
raise "utf8: reverse bytesize" unless reversed.bytesize == 6
# A `\r` with no newline after it is text.
cr_lines = [] of String
"a\r\nb\r".each_line { |l| cr_lines << l }
raise "utf8: each_line final cr" unless cr_lines.size == 2 && cr_lines[0] == "a" && cr_lines[1] == "b\r"
puts "    utf8 awareness: multi-byte characters, byte indexing, chars decoding, and reverse verified"

# A `Char` above ASCII is more than one byte, and this family narrowed it to
# one through a checked convert: ten methods panicked with "arithmetic
# overflow" on a question about text, and `center` and `tr` answered wrongly
# rather than panicking.
raise "utf8: lstrip char" unless "☃a☃".lstrip('☃') == "a☃"
raise "utf8: rstrip char" unless "☃a☃".rstrip('☃') == "☃a"
raise "utf8: ends_with char" unless "a☃".ends_with?('☃')
raise "utf8: split char" unless "a☃b".split('☃', 0).size == 2
raise "utf8: index char" unless "a☃b".index('☃', 0) == 1
raise "utf8: rindex char" unless "a☃b".rindex('☃') == 1
raise "utf8: delete char" unless "a☃b".delete('☃') == "ab"
raise "utf8: squeeze char" unless "a☃☃b".squeeze('☃') == "a☃b"
raise "utf8: count char" unless "a☃b☃".count('☃') == 2
raise "utf8: tr char" unless "a☃b".tr("☃", "x") == "axb"
# The block forms were the two the fix missed: narrowed to one byte,
# `'☃'` panicked with "arithmetic overflow" and `'é'` matched nothing.
raise "utf8: sub char block" unless "a☃b☃".sub('☃') { |c| "x" } == "axb☃"
raise "utf8: sub char block two bytes" unless "héllo".sub('é') { |c| "[#{c}]" } == "h[é]llo"
raise "utf8: gsub char block" unless "a☃b☃".gsub('☃') { |c| "x" } == "axbx"
raise "utf8: gsub char block two bytes" unless "aÿbÿ".gsub('ÿ') { |c| "<#{c}>" } == "a<ÿ>b<ÿ>"
raise "utf8: tr range to one" unless "abc".tr("a-c", "é") == "ééé"
raise "utf8: center width" unless "héllo".center(9, '.').size == 9
raise "utf8: center content" unless "héllo".center(9, '.') == "..héllo.."
raise "utf8: center multi-byte pad" unless "héllo".center(9, "·").size == 9
# And the ASCII the same methods have always answered
raise "utf8: ascii lstrip" unless "xxhi".lstrip('x') == "hi"
raise "utf8: ascii tr" unless "abc".tr("ab", "x") == "xxc"
raise "utf8: ascii center" unless "hello".center(12, "-=") == "-=-hello-=-="
puts "    the char family: strip, search, delete, squeeze, count, tr and center verified"

# A byte that begins no character is one U+FFFD and never takes the bytes
# after it: C3 41 was the one character U+00C1, a quote after a C3 was
# swallowed, E2 82 was `size` 1 and two characters, and 80 61 62 split in
# two lost its `a`.
lead_a = String.new(2) { |b| b[0] = 0xC3_u8; b[1] = 0x41_u8 }
quoted = String.new(5) { |b| b[0] = 0x61_u8; b[1] = 0xC3_u8; b[2] = 0x22_u8; b[3] = 0x62_u8; b[4] = 0x22_u8 }
cut = String.new(2) { |b| b[0] = 0xE2_u8; b[1] = 0x82_u8 }
stray = String.new(3) { |b| b[0] = 0x80_u8; b[1] = 0x61_u8; b[2] = 0x62_u8 }
past = String.new(4) { |b| b[0] = 0xF4_u8; b[1] = 0x90_u8; b[2] = 0x80_u8; b[3] = 0x80_u8 }
overlong = String.new(5) { |b| b[0] = 0xC0_u8; b[1] = 0x80_u8; b[2] = 0xED_u8; b[3] = 0xA0_u8; b[4] = 0x80_u8 }
raise "utf8: a lead byte without its continuation is one U+FFFD" unless lead_a.chars == ['\uFFFD', 'A'] && lead_a.size == 2
raise "utf8: a quote after a lead byte is a quote" unless quoted.chars == ['a', '\uFFFD', '"', 'b', '"'] && quoted.size == 5
raise "utf8: size counts what each_char yields" unless cut.size == 2 && cut.chars == ['\uFFFD', '\uFFFD'] && stray.size == 3 && stray.chars == ['\uFFFD', 'a', 'b']
raise "utf8: past U+10FFFF, overlong and surrogate bytes are U+FFFD each" unless past.chars == ['\uFFFD', '\uFFFD', '\uFFFD', '\uFFFD'] && overlong.size == 5 && overlong.chars.all? { |c| c == '\uFFFD' }
raise "utf8: delete writes U+FFFD for a byte that begins no character" unless lead_a.delete("z") == "\uFFFDA" && quoted.delete("b") == "a\uFFFD\"\""
raise "utf8: tr and squeeze write U+FFFD for it too" unless lead_a.tr("é", "e") == "\uFFFDA" && lead_a.squeeze("z") == "\uFFFDA" && lead_a.squeeze == "\uFFFDA" && past.squeeze == "\uFFFD"
raise "utf8: split empty after a byte that begins no character" unless stray.split("", 2) == ["\uFFFD", "ab"] && lead_a.split("") == ["\uFFFD", "A"]
puts "    a byte that begins no character is one U+FFFD in size, chars, delete, tr, squeeze and split"

raise "string: to_u64 max" unless "18446744073709551615".to_u64 == 18446744073709551615_u64
raise "string: to_u64 past max" unless "18446744073709551616".to_u64?.nil?
raise "string: to_u64 base 16" unless "ff".to_u64(16) == 255_u64
raise "string: to_u64 refuses a sign" unless "-1".to_u64?.nil?
raise "string: range" unless "hello"[1..3] == "ell" && "hello"[1...3] == "el"
raise "string: range from the back" unless "hello"[-3..-1] == "llo" && "hello"[0..-2] == "hell"
raise "string: backwards range is empty" unless "hello"[3..1] == ""
puts "    to_u64 and a range of a string verified"

built = String.build { |io| io << "aé€" << '🎉' }
raise "utf8: a built string counts its code points when asked" unless built.size == 4
raise "utf8: a built string's count stays what it was" unless built.size == 4 && built.bytesize == 10
puts "    a built string counts its characters when asked, once"

# An empty search matches before every character and at the end, as `sub`
# matches it at the start: `"abc".gsub("", "-")` answered `"abc"`.
raise "string: gsub empty at every character" unless "abc".gsub("", "-") == "-a-b-c-" && "".gsub("", "-") == "-" && "é".gsub("", "-") == "-é-"
raise "string: gsub empty block" unless "ab".gsub("") { |m| "<#{m}>" } == "<>a<>b<>"
unpaired = String.new(2) { |b| b[0] = 0xC3_u8; b[1] = 0x41_u8 }
raise "string: gsub empty keeps a byte that begins no character" unless unpaired.gsub("", "-").bytes == [0x2D_u8, 0xC3_u8, 0x2D_u8, 0x41_u8, 0x2D_u8]
puts "    gsub with an empty search writes the replacement before every character and at the end"

# Whitespace is the other library's `Char#whitespace?`: above ASCII the
# Zs, Zl and Zp characters, decoded, and not U+0085 or a stray byte. The
# prelude's `strip` and these three read bytes as ASCII and kept them all.
raise "prelude: strip unicode whitespace" unless "\u3000\u00A0b\u2028\u00A0\u3000".strip == "b" && " \u0085x\u0085".strip.bytesize == 5 && "a \x80".strip.bytesize == 3 && "xà\u00A0".strip == "xà"
raise "string: unicode whitespace" unless "\u2000\u3000".blank? && "\u3000a\u202F".lstrip == "a\u202F" && "\u3000a\u202F".rstrip == "\u3000a" && !"\u0085".blank?
puts "    whitespace above ASCII: strip, lstrip, rstrip and blank? take Zs, Zl and Zp"

puts "all std/text checks passed"
