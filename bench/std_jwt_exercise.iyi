# Exercises `std/jwt`.
#
# Run via:
#     ./bin/iyi run bench/std_jwt_exercise.iyi
#
# RFC 7515's appendix A, RFC 7520's JWS examples (the JOSE cookbook), RFC
# 8037's Ed25519 example, RFC 7638's thumbprint and RFC 7517's JWK Sets,
# each as the RFC writes it; tokens PyJWT 2.10.1 wrote with the same keys;
# the same keys as PEM, written by Python's cryptography 46; the attacks
# and the claims at their edges. The keys are the RFCs' own, besides one
# P-384 key, a 1024-bit RSA key and an X25519 key cryptography drew once.

module bench/std_jwt_exercise

import std/jwt::{JWT, JWS, JWK, JWTAlgorithm, JWTError}
import std/json::{JSON, Any}
import std/crypto::{HMAC}
import std/digest::{SHA256}
import std/base64::{Base64}
import std/time::{Time}
import std/x509::{X509, Certificate}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def bytes(text : String) : Array(UInt8)
  Array(UInt8).new(text.bytesize) { |i| text.to_unsafe[i] }
end

def text(data : Array(UInt8)) : String
  String.new(data.size) { |buf| buf.copy_from(data.to_unsafe, data.size) }
end

def b64(data : String | Array(UInt8)) : String
  Base64.urlsafe_encode(data.is_a?(String) ? data : text(data)).split('=')[0]
end

# What a decode answered, as one string: the claims as JSON, or the
# error's sentence after "error: ".
def said(answer : JWT | JWTError) : String
  answer.is_a?(JWTError) ? "error: " + answer.message : JSON.to_json(answer.claims)
end

def said(answer : Array(UInt8) | JWTError) : String
  answer.is_a?(JWTError) ? "error: " + answer.message : text(answer)
end

def said(answer : JWK | JWTError) : String
  answer.is_a?(JWTError) ? "error: " + answer.message : answer.to_json
end

def key(json : String) : JWK
  JWK.parse(json).or_panic
end

def pem(text : String) : JWK
  JWK.from_pem(text).or_panic
end

# A token made by hand: *header* and *payload* as given, MACed under
# *secret* with HMAC-SHA256 - what an attacker holding a secret writes.
def forge(header : String, payload : String, secret : String) : String
  input = "#{b64(header)}.#{b64(payload)}"
  "#{input}.#{b64(HMAC.digest(SHA256, secret, input))}"
end

def said_set(answer : Array(JWK) | JWTError) : String
  answer.is_a?(JWTError) ? "error: " + answer.message : answer.map(&.to_json).join(",")
end

# *text* with its first *old* turned into *replacement*.
def replace(text : String, old : String, replacement : String) : String
  at = text.byte_index(old) || raise "no #{old} in #{text}"
  rest = text.bytesize - at - old.bytesize
  String.new(at) { |b| b.copy_from(text.to_unsafe, at) } + replacement +
    String.new(rest) { |b| b.copy_from(text.to_unsafe + at + old.bytesize, rest) }
end

# *text* up to *marker*.
def before(text : String, marker : String) : String
  at = text.byte_index(marker) || text.bytesize
  String.new(at) { |b| b.copy_from(text.to_unsafe, at) }
end

# A JWK member's bytes, and the JWK with a member's bytes changed.
def member(json : String, name : String) : Array(UInt8)
  bytes(Base64.decode(JSON.parse(json)[name].as_s))
end

def with_member(json : String, name : String, value : Array(UInt8)) : String
  replace(json, "\"#{name}\":\"#{JSON.parse(json)[name].as_s}\"", "\"#{name}\":\"#{b64(value)}\"")
end

# A base64url text whose last character is the next one up: the same
# bytes where that character has spare bits, with one of them set.
def bend(part : String) : String
  alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  last = alphabet.byte_index(part[part.size - 1].to_s) || 0
  part[0, part.size - 1] + alphabet[last + 1].to_s
end

# *claims* signed under HS256 and decoded at *now* with the rest.
def at(claims : String, now : Int64, leeway : Int64 = 0_i64, audience : String | Array(String) | Nil = nil, issuer : String | Array(String) | Nil = nil,
       subject : String? = nil, required : Array(String) = [] of String) : String
  k = JWK.secret(Array(UInt8).new(32, 1_u8))
  said(JWT.decode(JWS.sign("{\"alg\":\"HS256\"}", claims, k, JWTAlgorithm::HS256), k, [JWTAlgorithm::HS256], now, leeway, audience, issuer, subject, required))
end

