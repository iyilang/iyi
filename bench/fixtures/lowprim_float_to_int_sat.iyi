  x.sat_u64
end

def f64_sat_u128(x : Float64) : UInt128
  x.sat_u128
end

f32_sat_i8(1.5_f32)
f32_sat_i16(1.5_f32)
f32_sat_i32(1.5_f32)
f32_sat_i64(1.5_f32)
f32_sat_i128(1.5_f32)
