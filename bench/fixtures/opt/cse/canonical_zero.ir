; iyi-ir 1
source_filename = "canonical_zero"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i128 @canonical_zero(i32 %x) {
entry:
  %wide = zext i32 %x to i128
  %a = add i128 %wide, 0
  %b = add i128 %wide, zeroinitializer
  %out = xor i128 %a, %b
  ret i128 %out
}
