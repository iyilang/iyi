; iyi-ir 1
module "fp_result_call"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal double @first() {
entry:
  ret double 0x4012000000000000
}

define internal i64 @second() {
entry:
  ret i64 7
}

define internal i64 @result() {
entry:
  %x = call double () @first()
  %other = call i64 () @second()
  %value = fptosi double %x to i64
  %sum = add i64 %value, %other
  ret i64 %sum
}

define i32 @main() {
entry:
  %r = call i64 () @result()
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i64 %r)
  ret i32 0
}
