lib LibC
  fun exit(status : Int32) : NoReturn
end

def once(value : Int32, &)
  yield value
end

def capture_pair : Int32
  value = 50
  first = once(7) do |value|
    -> { value }
  end
  second = once(9) do |value|
    -> { value }
  end
  first.call &+ second.call &+ value
end

LibC.exit(capture_pair &- 66)
