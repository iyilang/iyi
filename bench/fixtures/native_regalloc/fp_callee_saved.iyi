module fp_callee_saved
import std/float

def leaf(x : Float64) : Float64
  (x + 10.0) * 2.0
end

def inner(x : Float64) : Float64
  hold = x + 1.0
  other = leaf(x)
  hold + other
end

def probe(n : Int64) : Int64
  base = n.to_f64
  live = base * 1.5
  if n < 0_i64
    return (live + inner(base)).to_i64
  end
  i = 0_i64
  sum = 0.0
  while i < n
    sum = sum + inner(i.to_f64)
    i = i + 1_i64
  end
  (live + sum).to_i64
end

puts "#{probe(-2_i64)}"
puts "#{probe(0_i64)}"
puts "#{probe(4_i64)}"
