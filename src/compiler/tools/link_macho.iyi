# The driver for the native Mach-O executable gate (bench/native_link_exercise.sh).
#
# `link_macho hello OUT` writes a hand-built arm64 program: its `_main` stores a
# string address, calls `_write(1, msg, len)` and `_exit(7)` through imports from
# libSystem, and every word and relocation of it is written here by hand.
#
# `link_macho link OUT IDENT [-framework NAME]... OBJ...` reads each Mach-O arm64
# object with the native reader, links them with the native linker, and writes
# the executable to OUT. IDENT is the code signature's identifier. It prints one
# `LINKED OUT BYTES` line. It exits non-zero on any read or link error.
#
# `link_macho elf-hello ARCH OUT` writes a static Linux ELF for x86_64 or
# aarch64. Its entry calls a local syscall helper and addresses a rodata string
# through linker relocations, writes the string, then exits with status 7.

module compiler/tools/link_macho

import compiler/native/obj/object::{ObjectFile, ObjFormat, ObjError, Section, SectionKind, Symbol, SymbolKind, SymbolBinding, Reloc, RelocKind}
import compiler/native/obj/macho::{read_object}
import compiler/native/amd64/encode::{XForm, encode_form, mov_imm, lea, with_mem, mem_rip_sym, call_sym, ret}
import compiler/native/amd64/regs::{rax, rdi, rsi, rdx}
import compiler/native/link/link::{link, LinkOptions, LinkedImage, LinkError}
import compiler/platform/target::{Target}
import std/slice::{Slice, Bytes}

module LinkMachoTool
  HELLO_TEXT = "hello from the iyi Mach-O linker\n"
  ELF_HELLO_TEXT = "hello from the iyi ELF linker\n"

  # The hand-built program. Each word is an arm64 instruction; the relocations
  # name the ones that take an address or call an import.
  def self.hello_object(target : Target) : ObjectFile
    msg = HELLO_TEXT
    msg_len = msg.bytesize.to_i64
    words = [] of Int64
    words << 0xd2800020_i64
    words << 0x90000001_i64
    words << 0x91000021_i64
    words << (0xd2800002_i64 | msg_len.unsafe_shl(5_i64))
    words << 0x94000000_i64
    words << 0xd28000e0_i64
    words << 0x94000000_i64
    words << 0xd4200000_i64
    text = Slice(UInt8).new(words.size * 4)
    text.fill(0_u8)
    k = 0
    while k < words.size
      b = 0
      while b < 4
        text[k * 4 + b] = (words[k].unsafe_shr(b.to_i64 * 8_i64) & 0xff_i64).to_u8
        b = b + 1
      end
      k = k + 1
    end
    text_relocs = [] of Reloc
    text_relocs << Reloc.new(4_i64, RelocKind::A64AdrpPage21, 1, 0_i64)
    text_relocs << Reloc.new(8_i64, RelocKind::A64AddLo12, 1, 0_i64)
    text_relocs << Reloc.new(16_i64, RelocKind::A64Call26, 2, 0_i64)
    text_relocs << Reloc.new(24_i64, RelocKind::A64Call26, 3, 0_i64)

    rodata = Slice(UInt8).new(msg.bytesize)
    i = 0
    while i < msg.bytesize
      rodata[i] = msg.byte_at(i)
      i = i + 1
    end

    obj = ObjectFile.new(ObjFormat::MachO, target, "iyi-native")
    obj.sections << Section.new(".text", SectionKind::Text, 4, text, words.size.to_i64 * 4_i64, text_relocs, 0_i64)
    obj.sections << Section.new(".rodata", SectionKind::ReadOnly, 1, rodata, msg_len, [] of Reloc, 0_i64)
    obj.symbols << Symbol.new("main", SymbolKind::Func, SymbolBinding::Global, 0, 0_i64, words.size.to_i64 * 4_i64)
    obj.symbols << Symbol.new("msg", SymbolKind::Object, SymbolBinding::Local, 1, 0_i64, msg_len)
    obj.symbols << Symbol.new("write", SymbolKind::Undefined, SymbolBinding::Global)
    obj.symbols << Symbol.new("exit", SymbolKind::Undefined, SymbolBinding::Global)
    obj
  end
  # Encoded x86 relocations are relative to their instruction; the object
  # section records offsets relative to the beginning of its text instead.
  def self.append_x86(text : Array(UInt8), relocs : Array(Reloc), form : XForm) : Nil
    encoded = encode_form(form)
    offset = text.size.to_i64
    encoded.bytes.each do |byte|
      text << byte
    end
    encoded.relocs.each do |reloc|
      relocs << Reloc.new(offset + reloc.offset, reloc.kind, reloc.symbol, reloc.addend)
    end
  end

  def self.elf_object(target : Target, text : Slice(UInt8), relocs : Array(Reloc), helper_at : Int64) : ObjectFile
    msg = ELF_HELLO_TEXT
    rodata = Slice(UInt8).new(msg.bytesize)
    i = 0
    while i < msg.bytesize
      rodata[i] = msg.byte_at(i)
      i = i + 1
    end
    obj = ObjectFile.new(ObjFormat::Elf, target, "iyi-native")
    obj.sections << Section.new(".text", SectionKind::Text, 16, text, text.size.to_i64, relocs, 0_i64)
    obj.sections << Section.new(".rodata", SectionKind::ReadOnly, 1, rodata, msg.bytesize.to_i64, [] of Reloc, 0_i64)
    obj.symbols << Symbol.new("_start", SymbolKind::Func, SymbolBinding::Global, 0, 0_i64, helper_at)
    obj.symbols << Symbol.new("msg", SymbolKind::Object, SymbolBinding::Local, 1, 0_i64, msg.bytesize.to_i64)
    obj.symbols << Symbol.new("write_syscall", SymbolKind::Func, SymbolBinding::Local, 0, helper_at, text.size.to_i64 - helper_at)
    obj
  end

  def self.elf_x86_object(target : Target) : ObjectFile
    code = [] of UInt8
    relocs = [] of Reloc
    append_x86(code, relocs, mov_imm(32, rax, 1_i64)) # write
    append_x86(code, relocs, mov_imm(32, rdi, 1_i64)) # stdout
    append_x86(code, relocs, with_mem(lea(rsi, 0), mem_rip_sym(RelocKind::PcRel32, 1, 0_i64)))
    append_x86(code, relocs, mov_imm(32, rdx, ELF_HELLO_TEXT.bytesize.to_i64))
    append_x86(code, relocs, call_sym(2))
    append_x86(code, relocs, mov_imm(32, rax, 60_i64)) # exit
    append_x86(code, relocs, mov_imm(32, rdi, 7_i64))
    code << 0x0f_u8
    code << 0x05_u8 # syscall
    helper_at = code.size.to_i64
    code << 0x0f_u8
    code << 0x05_u8 # syscall
    append_x86(code, relocs, ret)
    text = Slice(UInt8).new(code.size)
    i = 0
    while i < code.size
      text[i] = code[i]
      i = i + 1
    end
    elf_object(target, text, relocs, helper_at)
  end

  def self.elf_arm_object(target : Target) : ObjectFile
    words = [] of Int64
    words << 0xd2800020_i64 # mov x0, #1
    words << 0x90000001_i64 # adrp x1, msg
    words << 0x91000021_i64 # add x1, x1, :lo12:msg
    words << (0xd2800002_i64 | ELF_HELLO_TEXT.bytesize.to_i64.unsafe_shl(5_i64))
    words << 0xd2800808_i64 # mov x8, #64 (write)
    words << 0x94000000_i64 # bl write_syscall
    words << 0xd28000e0_i64 # mov x0, #7
    words << 0xd2800ba8_i64 # mov x8, #93 (exit)
    words << 0xd4000001_i64 # svc #0
    words << 0xd4200000_i64 # brk #0 if exit returns
    helper_at = words.size.to_i64 * 4_i64
    words << 0xd4000001_i64 # svc #0
    words << 0xd65f03c0_i64 # ret
    text = Slice(UInt8).new(words.size * 4)
    i = 0
    while i < words.size
      b = 0
      while b < 4
        text[i * 4 + b] = (words[i].unsafe_shr(b.to_i64 * 8_i64) & 0xff_i64).to_u8
        b = b + 1
      end
      i = i + 1
    end
    relocs = [] of Reloc
    relocs << Reloc.new(4_i64, RelocKind::A64AdrpPage21, 1, 0_i64)
    relocs << Reloc.new(8_i64, RelocKind::A64AddLo12, 1, 0_i64)
    relocs << Reloc.new(20_i64, RelocKind::A64Call26, 2, 0_i64)
    elf_object(target, text, relocs, helper_at)
  end

  def self.run_elf_hello(arch : String, dest : String) : Nil
    unless arch == "x86_64" || arch == "aarch64"
      raise "elf-hello: unsupported architecture #{arch}"
    end
    target = Target.new("#{arch}-unknown-linux-gnu")
    obj = arch == "x86_64" ? elf_x86_object(target) : elf_arm_object(target)
    result = link([obj], LinkOptions.new("elf-hello", "_start", [] of String))
    if result.is_a?(LinkError)
      raise "elf-hello: #{result.message}"
    end
    image = result.as(LinkedImage)
    write_bytes(dest, image.executable)
    print "LINKED #{dest} #{image.executable.size}\n"
  end


  def self.write_bytes(path : String, bytes : Bytes) : Nil
    File.write(path, String.new(bytes))
  end

  def self.read_file(path : String, target : Target) : ObjectFile
    result = read_object(Slice(UInt8).of(File.read(path)), target)
    if result.is_a?(ObjError)
      raise "#{path}: #{result.message}"
    end
    result.as(ObjectFile)
  end

  def self.run_hello(dest : String) : Nil
    target = Target.new("aarch64-apple-darwin")
    obj = hello_object(target)
    result = link([obj], LinkOptions.new("hello", "main", [] of String))
    if result.is_a?(LinkError)
      raise "hello: #{result.message}"
    end
    image = result.as(LinkedImage)
    write_bytes(dest, image.executable)
    print "LINKED #{dest} #{image.executable.size}\n"
  end

  def self.run_link(args : Array(String)) : Nil
    dest = args[0]
    ident = args[1]
    frameworks = [] of String
    inputs = [] of String
    i = 2
    while i < args.size
      if args[i] == "-framework"
        frameworks << args[i + 1]
        i = i + 2
      else
        inputs << args[i]
        i = i + 1
      end
    end
    target = Target.new("aarch64-apple-darwin")
    objects = [] of ObjectFile
    inputs.each do |path|
      objects << read_file(path, target)
    end
    result = link(objects, LinkOptions.new(ident, "main", frameworks))
    if result.is_a?(LinkError)
      raise "link of #{dest}: #{result.message}"
    end
    image = result.as(LinkedImage)
    write_bytes(dest, image.executable)
    print "LINKED #{dest} #{image.executable.size}\n"
  end

  def self.run : Nil
    args = Program.args
    if args.size == 2 && args[0] == "hello"
      run_hello(args[1])
      return
    end
    if args.size == 3 && args[0] == "elf-hello"
      run_elf_hello(args[1], args[2])
      return
    end
    if args.size >= 4 && args[0] == "link"
      rest = [] of String
      i = 1
      while i < args.size
        rest << args[i]
        i = i + 1
      end
      run_link(rest)
      return
    end
    raise "usage: link_macho hello OUT | link_macho elf-hello ARCH OUT | link_macho link OUT IDENT [-framework NAME]... OBJ..."
  end
end

LinkMachoTool.run
