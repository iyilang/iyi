; iyi-ir 1
source_filename = "variable_gep_load_forward"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @variable_gep_load_forward(ptr %p, i64 %index) {
entry:
  %a = getelementptr [8 x i64], ptr %p, i64 0, i64 %index
  %first = load i64, ptr %a, align 8
  %sum = add i64 %first, %first
  ret i64 %sum
}
