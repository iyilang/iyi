; reject: expected `}`
; A typed personality must include its value before the function body.
source_filename = "personality.iyi"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"

declare i32 @personality(...)

define i32 @work() personality ptr {
entry:
  ret i32 0
}
