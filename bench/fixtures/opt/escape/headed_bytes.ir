; iyi-ir 1
source_filename = "escape_headed_bytes"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @headed_bytes(i64 %tid) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 %tid, i64 3)
  %value = load i64, ptr %p, align 8
  ret i64 %value
}
