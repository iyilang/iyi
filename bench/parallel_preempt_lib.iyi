# Preemption inside the prelude's library, std, and recursion: SPEC.md
# III.4.13, part 9.
#
#   ./bin/iyi run --release bench/parallel_preempt_lib.iyi -- sort fib
#   ./bin/iyi run --release bench/parallel_preempt_lib.iyi -- cost
#
# Each healthy ordering step queues a short task before its long call and
# reports whether it ran inside or after the call. Runtime lock contention
# can refuse a turn, so that ordering is informational. Every ordering step
# uses one worker. Copy-only hooks hold each target until its short task is
# queued, then distinguish an eligible decision from a turn with no check
# for the library loops, recursion, and standard-library calls.
#
#   sort    `Array#sort_in_place` of 6,000,000 `Int64`s
#   copy    `Slice#copy_from` of 192 MB, a million bytes a turn; long
#           enough to tell only in a plain build, whose copy is a loop of
#           bytes rather than a `memcpy`
#   rehash  the insert that grows a `Hash(Int32, Int32)` of 8,388,608
#           entries
#   join    `Array(String)#join` of 12,000,000 strings
#   regex   `Regex#find` over 24 MB that the pattern never matches
#   json    `JSON.parse` of a 24 MB array of numbers
#   bcrypt  `Bcrypt.hash` at cost 12
#           the forced standard-library pairs use smaller inputs and cost 4
#   fib     a naive recursive Fibonacci of 40, with no loop in it; the
#           forced checked and @[NoPreempt] pair uses Fibonacci of 30
#   cost    not run unless named: what the checks cost the library's own
#           work - a sort, copies long and short, hash inserts, a JSON
#           parse, a join and a recursion - best of seven inside a parallel
#           task, printed as times to compare against a build from before
#           the library checked, and held to no bound here
#
# With no step named every step but `cost` runs, ordering is reported, and
# timing is omitted. bench/parallel_exercise.sh runs it, and broken copies,
# each caught by the step that names it.
#
# With partitions in the runtime (`-Dheap_partitions`) the call's task
# allocates in its unit's own partition, which its worker collects on the
# task's stack, stopping no other thread and giving the worker up at no
# check (heap22 design, section 4.1): the join's 12,000,000-string input
# made one such collection take the worker for about 150 ms, which the
# short task waited out, where the global collection that stood for it
# stopped the main thread's clock too. So there a short task waits only
# for preemption and for local collections: the time the runtime spent in
# local collections (`IyiHeap.local_ns`) between the spawn and the short
# task's start is taken off its wait. On one worker only the call's
# partition collects then; a collection under way at the spawn is taken
# off whole, the part before the spawn too.

@[Unsafe("copies bytes between slices through their to_unsafe pointers in a loop the preemption check must reach")]
module bench/parallel_preempt_lib

import std/slice::{Slice}
import std/regex::{Regex}
import std/json::{JSON}
import std/password::{Bcrypt}

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  {% unless flag?(:run_end_copy) %}
    # one ending: begin
    # The run's one ending, for every catch, watchdog and setup failure, on
    # any thread and under any lock. The first caller to claim the word
    # writes its line and ends the process with its status; every later
    # caller writes nothing and yields until that end.
    #
    # Its bounds. One write goes out only when lead, what and tail total at
    # most 512 bytes; a longer line goes out piece by piece (lead, what, tail),
    # each piece in as many writes as the kernel takes. The claim and the
    # write take no lock. The exit is not lock-free on Windows: __iyi_exit
    # first runs __iyi_hold_runtime_for_exit, a bounded spin of up to
    # 10,000,000 try_locks of IyiRuntimeLock that parks while a stop is
    # requested, so a caller that held that lock while a stop waited on its
    # own thread would leave the claimant parked there. No call site does
    # that: every caller runs on a scheduler, worker or monitor path, never
    # in collector code. Nothing between the claim and the exit is a
    # preemption point, because the block is @[NoPreempt]. On Darwin the exit
    # is the raw SYS_exit call, so no libSystem code runs after the write. The
    # libSystem-teardown explanation of the old hang was tested and ruled out
    # (a raw write then LibC.exit ended with status 76 and one line), so the
    # raw call is a choice, not a fix.
    #
    # Each copy of this block is held to bench/parallel_exercise.iyi's, and
    # bench/parallel_exercise.sh appends it to each runtime copy it runs
    # (-Drun_end_copy), so a hook and its fixture claim one word.
    class RunEnd
      @[UnsafeReach("the run's claim: atomically set once, reset only for the ending-hook setup probe")]
      @@claimed : UInt64 = 0_u64

      def self.claim : Bool
        Pointer(Atomic(UInt64)).new(pointerof(@@claimed).address).value.compare_and_set(0_u64, 1_u64)[1]
      end

      {% if flag?(:ending_hook) %}
        # Only before the racers start, after the cross-layer claim probe.
        def self.reset_for_test : Nil
          Pointer(Atomic(UInt64)).new(pointerof(@@claimed).address).value.set(0_u64)
        end
      {% end %}

      {% if flag?(:ending_unclaimed) %}
        # The planted mutant's count of writers, read by every caller's wait.
        @[UnsafeReach("the mutant's count of writers: atomics only")]
        @@written : UInt64 = 0_u64

        def self.arrive : UInt64
          Pointer(Atomic(UInt64)).new(pointerof(@@written).address).value.add(1_u64)
        end

        def self.written : UInt64
          Pointer(Atomic(UInt64)).new(pointerof(@@written).address).value.get
        end
      {% end %}
    end

    @[NoInline]
    @[NoPreempt]
    def run_end_write(fd : Int32, lead : String, what : String = "", tail : String = "") : Nil
      size = lead.bytesize + what.bytesize + tail.bytesize
      line = uninitialized UInt8[512]
      base = pointerof(line).as(UInt8*)
      at = 0
      piece = 0
      while piece < 3
        text = piece == 0 ? lead : (piece == 1 ? what : tail)
        from = text.to_unsafe
        count = text.bytesize
        if size <= 512
          i = 0
          while i < count
            (base + at + i).value = from[i]
            i = i + 1
          end
          at = at + count
          from = base
          count = piece == 2 ? at : 0
        end
        done = 0
        while done < count
          wrote = __iyi_write(fd, (from + done).as(Void*), (count - done).to_u64)
          break if wrote <= 0_i64
          done = done + wrote.to_i32
        end
        piece = piece + 1
      end
    end

    @[NoInline]
    @[NoPreempt]
    def end_run(status : Int32, fd : Int32, lead : String, what : String = "", tail : String = "") : NoReturn
      {% if flag?(:ending_unclaimed) %}
        # The planted mutant takes no claim: every caller writes its line, then
        # waits until all five have written, so the first to exit ends the run
        # with five lines.
        run_end_write(fd, lead, what, tail)
        RunEnd.arrive
        started = __iyi_monotonic_ns
        while RunEnd.written < 5_u64
          if __iyi_monotonic_ns - started >= 10_000_000_000_i64
            stuck = "FAIL: ending: setup: the unclaimed writers did not finish in 10000 ms\n"
            __iyi_write(1, stuck.to_unsafe.as(Void*), stuck.bytesize.to_u64)
            __iyi_exit(76)
          end
          IyiThread.spin_pause
        end
      {% else %}
        unless RunEnd.claim
          while true
            IyiThread.yield_cpu
          end
        end
        run_end_write(fd, lead, what, tail)
      {% end %}
      {% if flag?(:darwin) %}
        asm("svc #0x80" :: "{x16}"(1_i64), "{x0}"(status.to_i64) : "memory" : "volatile")
        while true
        end
      {% else %}
        __iyi_exit(status)
      {% end %}
    end
    # one ending: end
  {% end %}

  def fail(message : String) : Nil
    end_run(1, 1, "FAIL: ", message, "\n")
  end

  def setup_exit(message : String) : Nil
    end_run(76, 1, "FAIL: ", message, "\n")
  end

  def elapsed_ms(since : Int64) : Int64
    (__iyi_monotonic_ns - since) // 1000000_i64
  end

  def fib(n : Int32) : Int64
    n < 2 ? n.to_i64 : fib(n - 1) + fib(n - 2)
  end

  # The same recursion, never preempted.
  @[NoPreempt]
  def fib_np(n : Int32) : Int64
    n < 2 ? n.to_i64 : fib_np(n - 1) + fib_np(n - 2)
  end

  {% if flag?(:recursion_force) %}
    def forced_fib(n : Int32) : Int64
      IyiWorkers.force_turn(5_u64)
      return fib(n) if IyiWorkers.force_turn_result != 0_u64
      n < 2 ? n.to_i64 : forced_fib(n - 1) + forced_fib(n - 2)
    end

    @[NoPreempt]
    def forced_fib_np(n : Int32) : Int64
      IyiWorkers.force_turn(5_u64)
      return fib_np(n) if IyiWorkers.force_turn_result != 0_u64
      n < 2 ? n.to_i64 : forced_fib_np(n - 1) + forced_fib_np(n - 2)
    end
  {% end %}

  def long_fib(n : Int32) : Int64
    {% if flag?(:recursion_force) && flag?(:preempt_off) %}
      forced_fib_np(n)
    {% elsif flag?(:recursion_force) %}
      forced_fib(n)
    {% else %}
      fib(n)
    {% end %}
  end

  # A shift that turns the other way for a negative count through its
  # twin: a call cycle, so each has a check at its entry. Inlined into
  # `mix` with constant counts, the branches fold away and the calls that
  # stand for those checks until optimisation is done sit side by side.
  # The pass took the instruction after the first call to be the second,
  # erased by then, and put a check on it: a use of freed memory, which
  # crashed the compiler on bench/std_http_latency.iyi in --release
  # (MD5's compress had 64 such pairs) and built this file by luck. Built
  # in --release by bench/parallel_exercise.sh, and `mix`'s answer held
  # after the steps.
  def shift_left(x : UInt64, n : Int32) : UInt64
    n < 0 ? shift_right(x, 0 - n) : x.unsafe_shl(n.to_u64)
  end

  def shift_right(x : UInt64, n : Int32) : UInt64
    n < 0 ? shift_left(x, 0 - n) : x.unsafe_shr(n.to_u64)
  end

  def mix(h : UInt64) : UInt64
    shift_left(h, 3) ^ shift_right(h, 5) ^ shift_left(h, 7) ^ shift_right(h, 11)
  end

  # `Pointer#copy_from`, a function of its own in the release build's IR,
  # which bench/parallel_exercise.sh's `copy_checks` reads: a copy of one
  # run or less passes no check, and on darwin calls no accessor. The cost
  # step calls it with long counts and short ones, so neither is folded in.
  @[NoInline]
  def copy_bytes(to : Pointer(UInt8), from : Pointer(UInt8), count : Int32) : Nil
    to.copy_from(from, count)
  end

  # A xorshift walk's values, the same every run.
  def scrambled(count : Int32, seed : UInt64) : Array(Int64)
    x = seed
    Array(Int64).new(count) do
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      (x & 0xFFFFFFFFFFFF_u64).to_i64
    end
  end

  # When the step's one call started and how long it took: `Share` by its
  # atomic fields, and a class, so the task and the step read one copy.
  class Clock
    @started : Atomic(Int64)
    @took : Atomic(Int64)
    @holding : Atomic(Int64)
    @queued : Atomic(Int64)
    @worker : Atomic(UInt64)
    @force_key : UInt64

    def initialize(force_key : UInt64)
      @started = Atomic(Int64).new(0_i64)
      @took = Atomic(Int64).new(-1_i64)
      @holding = Atomic(Int64).new(0_i64)
      @queued = Atomic(Int64).new(0_i64)
      @force_key = force_key
      @worker = Atomic(UInt64).new(0_u64)
    end

    @[NoPreempt]
    def start : Int64
      state = IyiScheduler.state
      setup_exit("library: not armed: the worker has no preemption word") if state.preempt_word == 0_u64
      @worker.set(state.object_id)
      @holding.set(1_i64)
      started = __iyi_monotonic_ns
      while @queued.get == 0_i64 || (@force_key == 0_u64 && Pointer(Atomic(UInt64)).new(state.preempt_word).value.get == 0_u64)
        IyiThread.spin_pause
        if elapsed_ms(started) >= 20000_i64
          end_run(76, 1, "FAIL: library: progress hang: the clock start signal or preemption word did not arrive\n")
        end
      end
      {% if flag?(:libruntime_force) || flag?(:recursion_force) || flag?(:stdcall_force) %}
        IyiWorkers.force_turn_arm(IyiScheduler.current.object_id, @force_key) if @force_key != 0_u64
      {% end %}
      {% if flag?(:stdcall_force) %}
        IyiWorkers.force_turn(@force_key, 0_u64, 0_u64, true) if @force_key != 0_u64
      {% end %}
      t = __iyi_monotonic_ns
      @started.set(t)
      t
    end

    @[NoPreempt]
    def stop(since : Int64) : Nil
      {% if flag?(:stdcall_force) %}
        IyiWorkers.force_turn(@force_key, 0_u64, 0_u64, true) if @force_key != 0_u64
      {% end %}
      @took.set(elapsed_ms(since))
    end

    def started? : Bool
      @started.get != 0_i64
    end

    def took : Int64
      @took.get
    end

    def holding? : Bool
      @holding.get != 0_i64
    end

    def queued : Nil
      @queued.set(1_i64)
    end

    def worker : UInt64
      @worker.get
    end
  end

  # The runtime-copy mutant makes the same whole calls as the control, but
  # compiles them without checks. The return values keep each call observable.
  struct RegexCall
    def initialize(@pattern : Regex, @text : String)
    end

    def run_call : Int64
      @pattern.find(@text).nil? ? 0_i64 : 1_i64
    end
  end

  struct JsonCall
    def initialize(@text : String)
    end

    def run_call : Int64
      JSON.parse(@text).as_a.size.to_i64
    end
  end

  struct BcryptCall
    def initialize(@cost : Int32)
    end

    def run_call : Int64
      Bcrypt.hash("correct horse battery staple", @cost).bytesize.to_i64
    end
  end

  def library_call(call : T) : Int64 forall T
    {% if flag?(:std_unchecked) %}
      IyiWorkers.force_runtime_call(call)
    {% else %}
      call.run_call
    {% end %}
  end

  # The step's input, made before the clock starts, and then the one call;
  # what the call answered, so an optimised build keeps it.
  def run_op(name : String, clock : Clock) : Int64
    case name
    when "sort"
      values = scrambled(6_000_000, 88172645463325252_u64)
      t = clock.start
      values.sort_in_place
      clock.stop(t)
      values[0] &+ values[values.size - 1]
    when "copy"
      size = 192 * 1024 * 1024
      source = Slice(UInt8).new(size, 7_u8)
      target = Slice(UInt8).new(size, 0_u8)
      t = clock.start
      target.copy_from(source)
      clock.stop(t)
      target[size - 1].to_i64
    when "rehash"
      # Each key is its index times an odd number, which no two indexes
      # share: the table is full at 8,388,608, and the next key grows it.
      table = Hash(Int32, Int32).new
      i = 0
      while i < 8_388_608
        table[i &* 1640531527] = i
        i = i + 1
      end
      t = clock.start
      table[i &* 1640531527] = i
      clock.stop(t)
      table.size.to_i64
    when "join"
      words = ["iyi", "parallel", "task", "worker", "quantum", "check", "loop", "fib"]
      parts = Array(String).new(12_000_000) { |i| words[i & 7] }
      t = clock.start
      joined = parts.join(",")
      clock.stop(t)
      joined.bytesize.to_i64
    when "regex"
      {% if flag?(:stdcall_force) %}
        text = "abcabcabcabcabcabcabcabc" * 1_000
      {% else %}
        text = "abcabcabcabcabcabcabcabc" * 1_000_000
      {% end %}
      pattern = Regex.new("a[bc]*d")
      t = clock.start
      found = library_call(RegexCall.new(pattern, text))
      clock.stop(t)
      found
    when "json"
      {% if flag?(:stdcall_force) %}
        text = "[" + "1234567,8901234," * 1_500 + "0]"
      {% else %}
        text = "[" + "1234567,8901234," * 1_500_000 + "0]"
      {% end %}
      t = clock.start
      size = library_call(JsonCall.new(text))
      clock.stop(t)
      size
    when "bcrypt"
      {% if flag?(:stdcall_force) %}
        cost = 4
      {% else %}
        cost = 12
      {% end %}
      t = clock.start
      size = library_call(BcryptCall.new(cost))
      clock.stop(t)
      size
    else
      t = clock.start
      {% if flag?(:recursion_force) %}
        answer = long_fib(30)
      {% else %}
        answer = long_fib(40)
      {% end %}
      clock.stop(t)
      answer
    end
  end


  def step(name : String, quiet : Bool) : Nil
    setup_exit("#{name}: runs on a pool of one, and this one has #{IyiWorkers.count} workers") if IyiWorkers.count != 1
    {% if flag?(:libruntime_force) %}
      force_key = case name
                  when "sort"   then 1_u64
                  when "copy"   then 2_u64
                  when "rehash" then 3_u64
                  when "join"   then 4_u64
                  else               0_u64
                  end
    {% elsif flag?(:recursion_force) %}
      force_key = name == "fib" ? 5_u64 : 0_u64
    {% elsif flag?(:stdcall_force) %}
      force_key = case name
                  when "regex"  then 7_u64
                  when "json"   then 8_u64
                  when "bcrypt" then 9_u64
                  else               0_u64
                  end
    {% else %}
      force_key = 0_u64
    {% end %}
    forced = force_key != 0_u64
    clock = Clock.new(force_key)
    waited = Atomic(Int64).new(-1_i64)
    witness = Atomic(Int64).new(0_i64)
    {% if flag?(:heap_partitions) %}
      collected = Atomic(Int64).new(0_i64)
    {% end %}
    answer = Atomic(Int64).new(0_i64)
    preempts = IyiWorkers.preempts
    group do |g|
      g.spawn(unit: :new) do
        answer.set(run_op(name, clock))
        0
      end
      started = __iyi_monotonic_ns
      until clock.holding?
        sleep(1)
        if elapsed_ms(started) >= 20000_i64
          end_run(76, 1, "FAIL: ", name, ": progress hang: the operation did not reach its checkpoint\n")
        end
      end
      {% if flag?(:libruntime_force) || flag?(:recursion_force) || flag?(:stdcall_force) %}
        if forced
          # No candidate can consume an earlier check before the target holds.
          clock.queued
          started = __iyi_monotonic_ns
          until IyiWorkers.force_turn_ready?
            if elapsed_ms(started) >= 10000_i64
              end_run(76, 1, "FAIL: ", name, ": progress hang: the copy hook did not hold the target's first turn\n")
            end
            sleep(1)
          end
        end
      {% end %}
      asked = __iyi_monotonic_ns
      {% if flag?(:heap_partitions) %}
        local_before = IyiHeap.local_ns
      {% end %}
      g.spawn(unit: :new) do
        witness.set(!clock.started? ? 3_i64 : (clock.took >= 0_i64 ? 2_i64 : (IyiScheduler.state.object_id != clock.worker ? 4_i64 : 1_i64)))
        waited.set(elapsed_ms(asked))
        {% if flag?(:heap_partitions) %}
          collected.set(((IyiHeap.local_ns - local_before) // 1000000_u64).to_i64)
        {% end %}
        0
      end
      {% if flag?(:libruntime_force) || flag?(:recursion_force) || flag?(:stdcall_force) %}
        if forced
          IyiWorkers.force_turn_release
          started = __iyi_monotonic_ns
          while clock.took < 0_i64 || witness.get == 0_i64
            if IyiWorkers.force_turn_slow_active?
              started = __iyi_monotonic_ns
            elsif elapsed_ms(started) >= 70000_i64
              if IyiWorkers.force_turn_outer_claim?
                end_run(76, 1, "FAIL: ", name, ": progress hang: the call and queued task did not finish\n")
              end
              started = __iyi_monotonic_ns
            end
            sleep(1)
          end
        else
          clock.queued
        end
      {% else %}
        clock.queued
      {% end %}
    end
    {% if flag?(:heap_partitions) %}
      local_ms = collected.get
      ms = waited.get - local_ms
    {% else %}
      ms = waited.get
    {% end %}
    # A forced control must not pass because its library call was a no-op.
    if name == "regex"
      fail("regex: the search answered #{answer.get}, expected 0") if answer.get != 0_i64
    elsif name == "json"
      {% if flag?(:stdcall_force) %}
        expected = 3001_i64
      {% else %}
        expected = 3_000_001_i64
      {% end %}
      fail("json: the parsed array has #{answer.get} elements, expected #{expected}") if answer.get != expected
    elsif name == "bcrypt"
      fail("bcrypt: the hash has #{answer.get} bytes, expected 60") if answer.get != 60_i64
    end
    {% if flag?(:libruntime_force) || flag?(:recursion_force) || flag?(:stdcall_force) %}
      if forced
        result = IyiWorkers.force_turn_result
        setup_exit("#{name}: not armed: the forced turn reached no decision before the call ended") if result == 0_u64
        if result == 2_u64
          if name == "fib"
            fail("fib: the recursion entered a call with its worker's word raised and kept its worker")
          else
            {% if flag?(:stdcall_force) %}
              fail("#{name}: the library call returned with its worker's word raised and kept its worker")
            {% else %}
              fail("#{name}: the library's loop turned with its worker's word raised and kept its worker")
            {% end %}
          end
        end
        setup_exit("#{name}: not armed: the forced turn returned an unknown result") unless result == 1_u64
        setup_exit("#{name}: not armed: the queued task did not run inside the call on its worker at the eligible decision") unless witness.get == 1_i64
        if name == "fib"
          puts "fib: the recursion gave its worker up at the call after its word was raised"
        else
          {% if flag?(:stdcall_force) %}
            puts "#{name}: the library call gave its worker up after its word was raised"
          {% else %}
            puts "#{name}: the library's loop gave its worker up at the turn after its word was raised"
          {% end %}
        end
      end
    {% end %}
    if !forced
      if witness.get == 1_i64
        puts "#{name}: the short task ran inside the call; ordering is informational"
      elsif witness.get == 2_i64
        puts "#{name}: the short task ran after the call; ordering is informational"
      else
        setup_exit("#{name}: not armed: the short task did not run on the call's worker")
      end
    end
    if name == "fib"
      {% if flag?(:recursion_force) %}
        fail("fib: the preempted recursion answered #{answer.get}, and 30's is 832040") if answer.get != 832040_i64
      {% else %}
        fail("fib: the preempted recursion answered #{answer.get}, and 40's is 102334155") if answer.get != 102334155_i64
      {% end %}
    end
    given = IyiWorkers.preempts - preempts
    when_ran = witness.get == 1_i64 ? "inside it" : "after it"
    {% if flag?(:heap_partitions) %}
      puts "#{name}: a short task queued before a #{clock.took} ms call ran #{when_ran} #{ms} ms after its spawn beyond #{local_ms} ms of local collections (#{given} preemptions)" unless quiet
    {% else %}
      puts "#{name}: a short task queued before a #{clock.took} ms call ran #{when_ran} #{ms} ms after its spawn (#{given} preemptions)" unless quiet
    {% end %}
  end

  # ── cost ─────────────────────────────────────────────────────────────
  # Best of seven of each workload inside a parallel task, in ms; the
  # answers are summed and printed, so nothing is optimised away.
  def best_of(name : String, & : -> Int64) : Int64
    best = 9223372036854775807_i64
    answer = 0_i64
    7.times do
      t = __iyi_monotonic_ns
      answer = answer &+ yield
      took = __iyi_monotonic_ns - t
      best = took if took < best
    end
    puts "cost: #{name}: #{best // 1000_i64} us (answers #{answer})"
    best
  end

  def cost : Nil
    group do |g|
      g.spawn(unit: :new) do
        values = scrambled(1_000_000, 88172645463325252_u64)
        best_of("sort of 1,000,000 Int64") do
          copy = values.dup
          copy.sort_in_place
          copy[0] &+ copy[999_999]
        end
        big = Slice(UInt8).new(16 * 1024 * 1024, 7_u8)
        into = Slice(UInt8).new(16 * 1024 * 1024, 0_u8)
        best_of("64 copies of 16 MB") do
          64.times { copy_bytes(into.to_unsafe, big.to_unsafe, into.size) }
          into[123].to_i64
        end
        best_of("1,000,000 copies of 1 to 8 bytes") do
          1_000_000.times { |i| copy_bytes(into.to_unsafe + (i & 1023).to_i64, big.to_unsafe, (i & 7) + 1) }
          into[1000].to_i64
        end
        best_of("1,000,000 appends of 7 bytes") do
          built = String.build do |io|
            1_000_000.times { io << "abcdefg" }
          end
          built.bytesize.to_i64
        end
        best_of("1,000,000 hash inserts") do
          table = Hash(Int64, Int64).new
          i = 0_i64
          while i < 1_000_000_i64
            table[i &* 2654435761_i64] = i
            i = i + 1
          end
          table.size.to_i64
        end
        doc = "[" + "{\"id\":1234567,\"name\":\"iyi\",\"ok\":true,\"v\":[1,2,3]}," * 50_000 + "0]"
        best_of("JSON.parse of 2.4 MB") { JSON.parse(doc).as_a.size.to_i64 }
        words = ["iyi", "parallel", "task", "worker", "quantum", "check", "loop", "fib"]
        parts = Array(String).new(1_000_000) { |i| words[i & 7] }
        best_of("join of 1,000,000 strings") { parts.join(",").bytesize.to_i64 }
        best_of("fib(32)") { fib(32) }
        best_of("fib(32), its @[NoPreempt] twin") { fib_np(32) }
        0
      end
    end
  end

  STEPS = ["sort", "copy", "rehash", "join", "regex", "json", "bcrypt", "fib"]

  workers = 1
  chosen = [] of String
  Program.args.each do |argument|
    if argument.starts_with?("--workers=")
      workers = argument[10, argument.size - 10].to_i
    else
      fail("no step named #{argument}") unless STEPS.includes?(argument) || argument == "cost"
      chosen << argument
    end
  end
  quiet = chosen.empty?
  chosen = STEPS if quiet
  IyiWorkers.count = workers
  chosen.each do |name|
    if name == "cost"
      cost
    else
      step(name, quiet)
    end
  end
  mixed = Atomic(Int64).new(0_i64)
  group do |g|
    g.spawn(unit: :new) do
      h = 7_u64
      100.times { h = mix(h) &+ 1_u64 }
      mixed.set(h.unsafe_to_i64)
      0
    end
  end
  # What a plain build and a release one both answered on Linux.
  fail("mix: the cycle's answer is #{mixed.get}, where plain and release builds gave 170835095431268661") if mixed.get != 170835095431268661_i64
  puts "library preemption: every property held"
{% else %}
  puts "library preemption: no pool on this target, nothing to hold"
{% end %}
