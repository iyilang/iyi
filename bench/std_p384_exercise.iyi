# Exercises std/p384: ECDSA signatures and ECDH made on P-384 in constant
# time.
#
# With no argument: RFC 6979's own P-384 key and its signatures of
# "sample" and "test" under SHA-256, SHA-384 and SHA-512, byte for byte;
# the keys 1 and n - 1, whose public keys are G and -G; every hash signed
# and checked by std/ecdsa, and a signature of another message or under
# another key refused; digests signed as they are, held to Python's
# signatures of them; the private keys that are not one refused; NIST's
# CAVP vectors for ECDH, key pairs and public key validation; and the
# points that are not P-384's refused. The modes the gate script drives:
#   oracle FILE      each line `hash d message`, d and the message in hex:
#                    the public key's x and y and the DER signature, in hex,
#                    for Python's cryptography to make again;
#   digest FILE      each line `hash d digest`: the DER signature of the
#                    digest as it is (`sign_digest`), or `refused`;
#   ecdh FILE        each line `d peer-point`: the shared x and the key's
#                    own public point, or `refused`;
#   keys DIR         each file named in DIR/list read as PKCS #8 (`.p8`) or
#                    SEC 1 (`.sec1`): its public key's x and y, or why not;
#   wycheproof FILE  each line `tcId result private public shared` (`-` for
#                    an empty field): every `valid` case's shared x as
#                    `shared`, every `invalid` one refused, the `acceptable`
#                    ones counted by what they got;
#   time             medians of keygen, ECDH and signing, printed, never
#                    checked (a machine's speed is not a property of the
#                    module).

import std/p384::{P384PrivateKey}
import std/ecdsa::{EcdsaHash, EcdsaError, EcdsaPublicKey}
import std/file::{File}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.downcase.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32
    lo = p[i * 2 + 1].to_i32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def hex(bytes : Array(UInt8)) : String
  String.build { |io| bytes.each { |x| io << "0123456789abcdef"[x.to_i32 >> 4] << "0123456789abcdef"[x.to_i32 & 15] } }
end

def hash_named(name : String) : EcdsaHash
  case name
  when "sha256" then EcdsaHash::SHA256
  when "sha384" then EcdsaHash::SHA384
  else               EcdsaHash::SHA512
  end
end

def refused(answer : P384PrivateKey | EcdsaError, phrase : String, label : String) : Nil
  raise "ASSERTION FAILED: #{label}: accepted" unless answer.is_a?(EcdsaError)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

def refused_point(answer : Array(UInt8) | EcdsaError, phrase : String, label : String) : Nil
  raise "ASSERTION FAILED: #{label}: accepted" unless answer.is_a?(EcdsaError)
  check answer.message.includes?(phrase), "#{label}: refused with #{answer.message.inspect}, not #{phrase.inspect}"
end

# The nanoseconds *work* took, the median of *runs* runs of it.
def median_ns(runs : Int32, &work : -> Nil) : Int64
  took = [] of Int64
  runs.times do
    started = __iyi_monotonic_ns
    work.call
    took << __iyi_monotonic_ns - started
  end
  took.sorted[runs // 2]
end

