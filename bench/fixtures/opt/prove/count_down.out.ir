; iyi-ir 1
source_filename = "count_down"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @count_down(ptr %too_high, ptr %too_low) {
entry:
  br label %head
head:
  %i = phi i32 [ 10, label %entry ], [ %next, label %body ]
  %more = icmp sgt i32 %i, 0
  br i1 %more, label %body, label %done
body:
  store i1 false, ptr %too_high, align 1
  store i1 false, ptr %too_low, align 1
  %next = sub i32 %i, 1
  br label %head
done:
  ret void
}
