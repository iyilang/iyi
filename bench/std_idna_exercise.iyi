# Exercises `std/idna`: Punycode (RFC 3492) and host names to and from
# their ASCII form (IDNA2008, RFC 5891 and 5892). The comparisons with
# Python's codecs and the `idna` package are bench/std_idna_exercise.sh's.
#
# Run via:
#     ./bin/iyi run bench/std_idna_exercise.iyi

module bench/std_idna_exercise

import std/idna::{Punycode, PunycodeError, IDNA, IdnaError, IdnaProperty}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def text_of(points : Array(Int32)) : String
  String.build { |io| points.each { |point| io << point.unsafe_chr } }
end

def decoded(text : String, msg : String) : String
  value = Punycode.decode(text)
  raise "ASSERTION FAILED: #{msg}: refused with #{value.message.inspect}" if value.is_a?(PunycodeError)
  value
end

def refused(value : String | PunycodeError, phrase : String, msg : String) : Nil
  if value.is_a?(PunycodeError)
    raise "ASSERTION FAILED: #{msg}\n  expected #{phrase.inspect}\n  got      #{value.message.inspect}" unless value.message == phrase
  else
    raise "ASSERTION FAILED: #{msg}: accepted as #{value.inspect}"
  end
end

def ascii(name : String, expected : String, msg : String) : Nil
  value = IDNA.to_ascii(name)
  raise "ASSERTION FAILED: #{msg}: refused with #{value.message.inspect}" if value.is_a?(IdnaError)
  assert_str expected, value, msg
end

def unicode(name : String, expected : String, msg : String) : Nil
  value = IDNA.to_unicode(name)
  raise "ASSERTION FAILED: #{msg}: refused with #{value.message.inspect}" if value.is_a?(IdnaError)
  assert_str expected, value, msg
end

def refused_name(name : String, phrase : String, msg : String) : Nil
  [IDNA.to_ascii(name), IDNA.to_unicode(name)].each do |value|
    if value.is_a?(IdnaError)
      raise "ASSERTION FAILED: #{msg}\n  expected #{phrase.inspect}\n  got      #{value.message.inspect}" unless value.message == phrase
    else
      raise "ASSERTION FAILED: #{msg}: accepted as #{value.inspect}"
    end
  end
end

# The RFC's encodings with the case flags of their extended part dropped:
# sample I writes one digit upper-case to say what case the letter it
# encodes was, which section 7.1 marks and an encoder need not write.
def flags_dropped(text : String) : String
  last = -1
  i = 0
  while i < text.bytesize
    last = i if text.to_unsafe[i] == 45_u8
    i = i + 1
  end
  last < 0 ? text.downcase : text[0, last + 1] + text[last + 1, text.bytesize - last - 1].downcase
end

