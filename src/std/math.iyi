    0x3ff5200000000000_u64, 0xbfd1c898c1699800_u64, 0xbd1fafbc68e75404_u64,
    0x3ff5000000000000_u64, 0xbfd1675cababa800_u64, 0x3d1f1fc63382a8f0_u64,
    0x3ff4e00000000000_u64, 0xbfd1058bf9ae4800_u64, 0xbd26a8c4fd055a66_u64,
    0x3ff4c00000000000_u64, 0xbfd0a324e2739000_u64, 0xbd0c6bee7ef4030e_u64,
