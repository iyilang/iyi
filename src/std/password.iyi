end

# A password's bytes and their count, whether it came as a `String` or an
# `Array(UInt8)`.
struct PasswordBytes
  def self.of(data : String | Array(UInt8)) : {Pointer(UInt8), Int32}
    if data.is_a?(String)
      {data.to_unsafe, data.bytesize}
    else
      {data.to_unsafe, data.size}
    end
  end
end
