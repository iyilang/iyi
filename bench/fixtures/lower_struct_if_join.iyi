struct Point
  def initialize(@x : Int32, @y : Int32)
  end

  def sum : Int32
    @x &+ @y
  end
end

def join_values(flag : Bool) : Int32
  point = if flag
            Point.new(3, 4)
          else
            Point.new(8, 9)
          end
  pair = if flag
           {5, 6}
         else
           {1, 2}
         end
  point.sum &+ pair[0] &+ pair[1]
end

join_values(true)
