# std/io: byte streams beyond the standard ones.
#
# The prelude's `IyiIO` reads and writes a descriptor. This module adds to
# it, on top of its public `read_bytes`/`write` only: `read_byte`,
# `write_byte`, `read_char`, `lines`, `each_line`, `<<` and `IyiIO.copy`.
# Positioning (`seek`, `pos`, `rewind`) is not offered on a descriptor
# stream: the prelude has no seek intrinsic and its read buffer would make
# a kernel offset a lie.
#
# `Memory` is an `IyiIO` over a byte buffer in memory: it grows as it is
# written, reads from a cursor that `pos=`, `rewind` and `clear` move, and
# `to_s` gives back everything written. Anything that takes an `IyiIO`
# takes a `Memory`.
#
# `Sized` reads at most a given number of bytes from another `IyiIO`;
# `Delimited` reads up to (and consumes) a byte delimiter, leaving the
# inner stream just past it; `MultiWriter` writes to several `IyiIO`s at
# once. All three are `IyiIO`s themselves: a reader refuses writes, the
# writer refuses reads, each with a sentence.
#
# `Hexdump` prints bytes sixteen to a line, as `hexdump -C` does: an
# eight-digit hex offset, the bytes in two groups of eight, the printable
# ASCII between bars.
#
# `ByteFormat::LittleEndian` / `BigEndian` encode and decode Int32, Int64,
# UInt64 and UInt8 into bytes, into a pointer or an `IyiIO`, through
# unsigned byte arithmetic: every value, negative or not, round-trips.
# `SystemEndian` follows the target; `NetworkEndian` is big-endian.
#
# Refused: a negative count or limit, a position past the buffer, reading
# a closed stream, writing a reader, reading a writer, malformed UTF-8 in
# `read_char`, and a decode that runs out of bytes.

module std/io

class ::IyiIO
  # The next byte, or nil at the end.
  def read_byte : UInt8?
    chunk = read_bytes(1)
    return nil if chunk.bytesize == 0
    chunk.to_unsafe[0]
  end

  def write_byte(byte : UInt8) : Nil
    b = byte
    write(pointerof(b), 1)
  end

  # The next UTF-8 code point, or nil at the end. A lead byte that is not
  # one, a continuation byte that is not one, or a sequence the stream ends
  # inside is refused.
  def read_char : Char?
    lead = read_byte
    return nil unless lead
    return lead.unsafe_chr if lead < 128_u8

    if (lead & 0xe0_u8) == 0xc0_u8
      code = (lead.to_i32 & 0x1f)
      needed = 1
    elsif (lead & 0xf0_u8) == 0xe0_u8
      code = (lead.to_i32 & 0x0f)
      needed = 2
    elsif (lead & 0xf8_u8) == 0xf0_u8
      code = (lead.to_i32 & 0x07)
      needed = 3
    else
      raise "malformed UTF-8: byte #{lead} cannot begin a character"
    end

    while needed > 0
      follow = read_byte
      raise "truncated UTF-8: the stream ended inside a character starting with byte #{lead}" unless follow
      raise "malformed UTF-8: byte #{follow} cannot continue a character starting with byte #{lead}" if (follow & 0xc0_u8) != 0x80_u8
      code = (code << 6) | (follow.to_i32 & 0x3f)
      needed = needed - 1
    end
    code.unsafe_chr
  end

  # Every remaining line, `chomp` dropping the line ends.
  def lines(chomp : Bool = false) : Array(String)
    result = [] of String
    while line = read_line(chomp)
      result << line
    end
    result
  end

  def each_line(chomp : Bool = false, &block : String -> Nil) : Nil
    while line = read_line(chomp)
      yield line
    end
  end

  # Everything left in `source` (at most `limit` bytes) written to
  # `target`, which is flushed; answers the number of bytes moved.
  def self.copy(source : IyiIO, target : IyiIO, limit : Int32? = nil) : Int64
    raise "negative limit: #{limit}" if limit && limit < 0
    total = 0_i64
    while true
      want = 4096
      if limit
        left = limit - total.to_i32
        break if left <= 0
        want = left if left < want
      end
      chunk = source.read_bytes(want)
      break if chunk.bytesize == 0
      target.write(chunk)
      total = total + chunk.bytesize.to_i64
    end
    target.flush
    total
  end

  def <<(value) : self
    print(value)
    self
  end
end

# An `IyiIO` over bytes in memory. Writes land at the cursor and grow the
# buffer; reads advance the cursor; `to_s` is the whole buffer.
pub class Memory < IyiIO
  @buffer : Pointer(UInt8)
  @capacity : Int32
  @bytesize : Int32
  @pos : Int32
  @shut : Bool

  def initialize(capacity : Int32 = 64)
    raise "negative capacity: #{capacity}" if capacity < 0
    super(-1_i64, 16, false)
    @capacity = capacity < 16 ? 16 : capacity
    @buffer = Pointer(UInt8).malloc(@capacity.to_u64)
    @bytesize = 0
    @pos = 0
    @shut = false
  end

  # A buffer holding a copy of `text`'s bytes, the cursor at its start.
  def initialize(text : String)
    super(-1_i64, 16, false)
    len = text.bytesize
    @capacity = len < 16 ? 16 : len
    @buffer = Pointer(UInt8).malloc(@capacity.to_u64)
    @buffer.copy_from(text.to_unsafe, len)
    @bytesize = len
    @pos = 0
    @shut = false
  end

  # Bytes held, written or given.
  def size : Int32
    @bytesize
  end

  def empty? : Bool
    @bytesize == 0
  end

  # The cursor, in bytes from the start.
  def pos : Int32
    @pos
  end

  def pos=(position : Int32) : Nil
    raise "position #{position} out of range for #{@bytesize} bytes" if position < 0 || position > @bytesize
    @pos = position
  end

  def rewind : Nil
    @pos = 0
  end

  # Forgets every byte; the cursor returns to the start.
  def clear : Nil
    @bytesize = 0
    @pos = 0
  end

  def closed? : Bool
    @shut
  end

  def close : Nil
    @shut = true
  end

  def eof? : Bool
    @shut || @pos >= @bytesize
  end

  def flush : Nil
  end

  def to_s : String
    String.new(@bytesize) do |target|
      target.copy_from(@buffer, @bytesize)
    end
  end

  def read_byte : UInt8?
    raise "cannot read from closed IO" if @shut
    return nil if @pos >= @bytesize
    b = @buffer[@pos]
    @pos = @pos + 1
    b
  end

  def read_bytes(count : Int32) : String
    raise "cannot read from closed IO" if @shut
    raise "negative count: #{count}" if count < 0
    avail = @bytesize - @pos
    take = count < avail ? count : avail
    start = @pos
    @pos = @pos + take
    String.new(take) do |target|
      target.copy_from(@buffer + start, take)
    end
  end

  def read_all : String
    read_bytes(@bytesize - @pos)
  end

  def read_line(chomp : Bool = false) : String?
    raise "cannot read from closed IO" if @shut
    return nil if @pos >= @bytesize

    start = @pos
    stop = @bytesize
    i = start
    while i < @bytesize
      if @buffer[i] == 10_u8
        stop = i + 1
        break
      end
      i = i + 1
    end
    @pos = stop

    len = stop - start
    if chomp
      len = len - 1 if len > 0 && @buffer[start + len - 1] == 10_u8
      len = len - 1 if len > 0 && @buffer[start + len - 1] == 13_u8
    end
    String.new(len) do |target|
      target.copy_from(@buffer + start, len)
    end
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to closed IO" if @shut
    return if count <= 0

    needed = @pos + count
    if needed > @capacity
      grown = @capacity * 2
      while grown < needed
        grown = grown * 2
      end
      @buffer = @buffer.realloc(grown.to_u64)
      @capacity = grown
    end

    (@buffer + @pos).copy_from(bytes, count)
    @pos = needed
    @bytesize = needed if needed > @bytesize
  end
end

# A reader built on `read_byte` alone; `Sized` and `Delimited` supply the
# byte and refuse writes.
abstract class Reader < IyiIO
  def initialize
    super(-1_i64, 16, false)
  end

  abstract def read_byte : UInt8?

  def flush : Nil
  end

  def close : Nil
  end

  def read_bytes(count : Int32) : String
    raise "negative count: #{count}" if count < 0
    buffer = Pointer(UInt8).malloc(count.to_u64)
    filled = 0
    while filled < count
      b = read_byte
      break unless b
      buffer[filled] = b
      filled = filled + 1
    end
    String.new(filled) do |target|
      target.copy_from(buffer, filled)
    end
  end

  def read_all : String
    capacity = 256
    buffer = Pointer(UInt8).malloc(capacity.to_u64)
    filled = 0
    while b = read_byte
      if filled == capacity
        capacity = capacity * 2
        buffer = buffer.realloc(capacity.to_u64)
      end
      buffer[filled] = b
      filled = filled + 1
    end
    String.new(filled) do |target|
      target.copy_from(buffer, filled)
    end
  end

  def read_line(chomp : Bool = false) : String?
    capacity = 256
    buffer = Pointer(UInt8).malloc(capacity.to_u64)
    filled = 0
    while b = read_byte
      if filled == capacity
        capacity = capacity * 2
        buffer = buffer.realloc(capacity.to_u64)
      end
      buffer[filled] = b
      filled = filled + 1
      break if b == 10_u8
    end
    return nil if filled == 0

    len = filled
    if chomp
      len = len - 1 if len > 0 && buffer[len - 1] == 10_u8
      len = len - 1 if len > 0 && buffer[len - 1] == 13_u8
    end
    String.new(len) do |target|
      target.copy_from(buffer, len)
    end
  end
end

# At most `limit` bytes of another stream.
pub class Sized < Reader
  @io : IyiIO
  @remaining : Int32

  def initialize(@io : IyiIO, limit : Int32)
    raise "negative limit: #{limit}" if limit < 0
    super()
    @remaining = limit
  end

  # Bytes the limit still allows, whether or not the stream has them.
  def remaining : Int32
    @remaining
  end

  def eof? : Bool
    @remaining == 0 || @io.eof?
  end

  def read_byte : UInt8?
    return nil if @remaining == 0
    b = @io.read_byte
    @remaining = @remaining - 1 if b
    b
  end

  def read_bytes(count : Int32) : String
    raise "negative count: #{count}" if count < 0
    take = count < @remaining ? count : @remaining
    chunk = @io.read_bytes(take)
    @remaining = @remaining - chunk.bytesize
    chunk
  end

  def read_all : String
    read_bytes(@remaining)
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to a Sized reader"
  end
end

# Another stream up to a delimiter. The delimiter is consumed and not
# answered; the inner stream is left just past it. Without a delimiter
# the whole rest of the stream is answered.
pub class Delimited < Reader
  @io : IyiIO
  @delimiter : String
  @matched : Int32
  @finished : Bool
  @out : Pointer(UInt8)
  @out_pos : Int32
  @out_len : Int32

  def initialize(@io : IyiIO, @delimiter : String)
    raise "empty delimiter" if @delimiter.bytesize == 0
    super()
    @matched = 0
    @finished = false
    @out = Pointer(UInt8).malloc((@delimiter.bytesize + 1).to_u64)
    @out_pos = 0
    @out_len = 0
  end

  def delimiter : String
    @delimiter
  end

  def eof? : Bool
    return false if @out_pos < @out_len
    return true if @finished
    return false if @matched > 0
    @io.eof?
  end

  def read_byte : UInt8?
    while true
      if @out_pos < @out_len
        b = @out[@out_pos]
        @out_pos = @out_pos + 1
        return b
      end
      return nil if @finished

      @out_pos = 0
      @out_len = 0
      b = @io.read_byte
      if b
        feed(b)
      else
        # The stream ended holding a prefix of the delimiter: those bytes
        # were content after all.
        @finished = true
        held = @matched
        @matched = 0
        i = 0
        while i < held
          @out[i] = @delimiter.to_unsafe[i]
          i = i + 1
        end
        @out_len = held
      end
    end
  end

  # One byte from the inner stream against the delimiter: matched bytes
  # are held back; on a mismatch the first held byte is content and the
  # rest, then `b`, are matched again from the start.
  private def feed(b : UInt8) : Nil
    pattern = @delimiter.to_unsafe
    if b == pattern[@matched]
      @matched = @matched + 1
      if @matched == @delimiter.bytesize
        @finished = true
        @matched = 0
      end
    elsif @matched == 0
      @out[@out_len] = b
      @out_len = @out_len + 1
    else
      held = @matched
      @matched = 0
      @out[@out_len] = pattern[0]
      @out_len = @out_len + 1
      i = 1
      while i < held
        feed(pattern[i])
        i = i + 1
      end
      feed(b)
    end
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to a Delimited reader"
  end
end

# One stream written to several. `close` closes this writer, not the
# streams behind it.
pub class MultiWriter < IyiIO
  @writers : Array(IyiIO)
  @shut : Bool

  def initialize(@writers : Array(IyiIO))
    super(-1_i64, 16, false)
    @shut = false
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to closed IO" if @shut
    return if count <= 0
    @writers.each do |writer|
      writer.write(bytes, count)
    end
  end

  def flush : Nil
    @writers.each do |writer|
      writer.flush
    end
  end

  def close : Nil
    flush
    @shut = true
  end

  def closed? : Bool
    @shut
  end

  def eof? : Bool
    true
  end

  def read_byte : UInt8?
    raise "cannot read from a MultiWriter"
  end

  def read_bytes(count : Int32) : String
    raise "cannot read from a MultiWriter"
  end

  def read_all : String
    raise "cannot read from a MultiWriter"
  end

  def read_line(chomp : Bool = false) : String?
    raise "cannot read from a MultiWriter"
  end
end

# Bytes printed sixteen to a line, `hexdump -C` style, on an `IyiIO`.
pub class Hexdump
  HEX = "0123456789abcdef"

  @out : IyiIO

  def initialize(@out : IyiIO)
  end

  def dump(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "negative count: #{count}" if count < 0
    line = Pointer(UInt8).malloc(80_u64)
    hex = HEX.to_unsafe
    offset = 0
    while offset < count
      chunk = count - offset
      chunk = 16 if chunk > 16

      value = offset
      i = 7
      while i >= 0
        line[i] = hex[value & 0x0f]
        value = value >> 4
        i = i - 1
      end
      line[8] = 32_u8
      line[9] = 32_u8

      at = 10
      i = 0
      while i < 16
        if i == 8
          line[at] = 32_u8
          at = at + 1
        end
        if i < chunk
          b = bytes[offset + i]
          line[at] = hex[(b.to_i32 >> 4) & 0x0f]
          line[at + 1] = hex[b.to_i32 & 0x0f]
        else
          line[at] = 32_u8
          line[at + 1] = 32_u8
        end
        line[at + 2] = 32_u8
        at = at + 3
        i = i + 1
      end

      line[at] = 32_u8
      line[at + 1] = 124_u8
      at = at + 2
      i = 0
      while i < chunk
        b = bytes[offset + i]
        line[at] = (b >= 32_u8 && b <= 126_u8) ? b : 46_u8
        at = at + 1
        i = i + 1
      end
      line[at] = 124_u8
      line[at + 1] = 10_u8
      @out.write(line, at + 2)

      offset = offset + chunk
    end
    @out.flush
  end

  def dump(text : String) : Nil
    dump(text.to_unsafe, text.bytesize)
  end

  # Everything left in `source`.
  def dump(source : IyiIO) : Nil
    dump(source.read_all)
  end
end

pub struct ByteFormat
  # Two's complement by arithmetic, so a negative value never meets an
  # unsigned conversion: the bit pattern of a signed integer as a UInt64
  # and back.
  struct Bits
    def self.of_int64(value : Int64) : UInt64
      return value.to_u64 if value >= 0_i64
      0xFFFFFFFFFFFFFFFF_u64 - (-(value + 1_i64)).to_u64
    end

    def self.to_int64(bits : UInt64) : Int64
      return bits.to_i64 if bits < 0x8000000000000000_u64
      -((0xFFFFFFFFFFFFFFFF_u64 - bits).to_i64) - 1_i64
    end

    def self.of_int32(value : Int32) : UInt64
      return value.to_u64 if value >= 0
      0x100000000_u64 - (-(value.to_i64)).to_u64
    end

    def self.to_int32(bits : UInt64) : Int32
      return bits.to_i32 if bits < 0x80000000_u64
      (bits.to_i64 - 0x100000000_i64).to_i32
    end

    # The low `count` bytes of `bits`, least significant first.
    def self.put_little(bits : UInt64, buffer : Pointer(UInt8), count : Int32) : Nil
      i = 0
      while i < count
        buffer[i] = (bits & 0xff_u64).to_u8
        bits = bits.unsafe_shr(8_u64)
        i = i + 1
      end
    end

    def self.put_big(bits : UInt64, buffer : Pointer(UInt8), count : Int32) : Nil
      i = count - 1
      while i >= 0
        buffer[i] = (bits & 0xff_u64).to_u8
        bits = bits.unsafe_shr(8_u64)
        i = i - 1
      end
    end

    def self.get_little(buffer : Pointer(UInt8), count : Int32) : UInt64
      bits = 0_u64
      i = count - 1
      while i >= 0
        bits = bits.unsafe_shl(8_u64) | buffer[i].to_u64
        i = i - 1
      end
      bits
    end

    def self.get_big(buffer : Pointer(UInt8), count : Int32) : UInt64
      bits = 0_u64
      i = 0
      while i < count
        bits = bits.unsafe_shl(8_u64) | buffer[i].to_u64
        i = i + 1
      end
      bits
    end

    # `count` bytes out of `io`, or a refusal naming the shortfall.
    def self.take(io : IyiIO, count : Int32) : String
      chunk = io.read_bytes(count)
      raise "unexpected end of input: needed #{count} bytes, got #{chunk.bytesize}" if chunk.bytesize < count
      chunk
    end
  end

  pub struct LittleEndian
    def self.encode(value : Int32, buffer : Pointer(UInt8)) : Nil
      Bits.put_little(Bits.of_int32(value), buffer, 4)
    end

    def self.encode(value : Int64, buffer : Pointer(UInt8)) : Nil
      Bits.put_little(Bits.of_int64(value), buffer, 8)
    end

    def self.encode(value : UInt64, buffer : Pointer(UInt8)) : Nil
      Bits.put_little(value, buffer, 8)
    end

    def self.encode(value : UInt8, buffer : Pointer(UInt8)) : Nil
      buffer[0] = value
    end

    def self.encode(value : Int32, io : IyiIO) : Nil
      buffer = Pointer(UInt8).malloc(4_u64)
      encode(value, buffer)
      io.write(buffer, 4)
    end

    def self.encode(value : Int64, io : IyiIO) : Nil
      buffer = Pointer(UInt8).malloc(8_u64)
      encode(value, buffer)
      io.write(buffer, 8)
    end

    def self.encode(value : UInt64, io : IyiIO) : Nil
      buffer = Pointer(UInt8).malloc(8_u64)
      encode(value, buffer)
      io.write(buffer, 8)
    end

    def self.encode(value : UInt8, io : IyiIO) : Nil
      io.write_byte(value)
    end

    def self.decode_int32(buffer : Pointer(UInt8)) : Int32
      Bits.to_int32(Bits.get_little(buffer, 4))
    end

    def self.decode_int64(buffer : Pointer(UInt8)) : Int64
      Bits.to_int64(Bits.get_little(buffer, 8))
    end

    def self.decode_uint64(buffer : Pointer(UInt8)) : UInt64
      Bits.get_little(buffer, 8)
    end

    def self.decode_uint8(buffer : Pointer(UInt8)) : UInt8
      buffer[0]
    end

    def self.decode_int32(io : IyiIO) : Int32
      decode_int32(Bits.take(io, 4).to_unsafe)
    end

    def self.decode_int64(io : IyiIO) : Int64
      decode_int64(Bits.take(io, 8).to_unsafe)
    end

    def self.decode_uint64(io : IyiIO) : UInt64
      decode_uint64(Bits.take(io, 8).to_unsafe)
    end

    def self.decode_uint8(io : IyiIO) : UInt8
      Bits.take(io, 1).to_unsafe[0]
    end
  end

  pub struct BigEndian
    def self.encode(value : Int32, buffer : Pointer(UInt8)) : Nil
      Bits.put_big(Bits.of_int32(value), buffer, 4)
    end

    def self.encode(value : Int64, buffer : Pointer(UInt8)) : Nil
      Bits.put_big(Bits.of_int64(value), buffer, 8)
    end

    def self.encode(value : UInt64, buffer : Pointer(UInt8)) : Nil
      Bits.put_big(value, buffer, 8)
    end

    def self.encode(value : UInt8, buffer : Pointer(UInt8)) : Nil
      buffer[0] = value
    end

    def self.encode(value : Int32, io : IyiIO) : Nil
      buffer = Pointer(UInt8).malloc(4_u64)
      encode(value, buffer)
      io.write(buffer, 4)
    end

    def self.encode(value : Int64, io : IyiIO) : Nil
      buffer = Pointer(UInt8).malloc(8_u64)
      encode(value, buffer)
      io.write(buffer, 8)
    end

    def self.encode(value : UInt64, io : IyiIO) : Nil
      buffer = Pointer(UInt8).malloc(8_u64)
      encode(value, buffer)
      io.write(buffer, 8)
    end

    def self.encode(value : UInt8, io : IyiIO) : Nil
      io.write_byte(value)
    end

    def self.decode_int32(buffer : Pointer(UInt8)) : Int32
      Bits.to_int32(Bits.get_big(buffer, 4))
    end

    def self.decode_int64(buffer : Pointer(UInt8)) : Int64
      Bits.to_int64(Bits.get_big(buffer, 8))
    end

    def self.decode_uint64(buffer : Pointer(UInt8)) : UInt64
      Bits.get_big(buffer, 8)
    end

    def self.decode_uint8(buffer : Pointer(UInt8)) : UInt8
      buffer[0]
    end

    def self.decode_int32(io : IyiIO) : Int32
      decode_int32(Bits.take(io, 4).to_unsafe)
    end

    def self.decode_int64(io : IyiIO) : Int64
      decode_int64(Bits.take(io, 8).to_unsafe)
    end

    def self.decode_uint64(io : IyiIO) : UInt64
      decode_uint64(Bits.take(io, 8).to_unsafe)
    end

    def self.decode_uint8(io : IyiIO) : UInt8
      Bits.take(io, 1).to_unsafe[0]
    end
  end

  # Every architecture the compiler initialises a machine for (x86_64,
  # aarch64, arm, i386, wasm32) stores its low byte first; a big-endian
  # target arriving takes the other branch.
  {% if flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) || flag?(:i386) || flag?(:wasm32) %}
    pub alias SystemEndian = LittleEndian
  {% else %}
    pub alias SystemEndian = BigEndian
  {% end %}

  pub alias NetworkEndian = BigEndian
end
