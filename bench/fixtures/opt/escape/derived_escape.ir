; iyi-ir 1
source_filename = "escape_derived_escape"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal void @derived(ptr %heap) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 16, i64 1, i64 2)
  %inside = getelementptr i8, ptr %p, i64 8
  store ptr %inside, ptr %heap, align 8
  ret void
}
