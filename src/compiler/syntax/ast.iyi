pub class FunDef < ASTNode
  property name : String
  property args : Array(Arg)
  property return_type : ASTNode?
  property body : ASTNode?
  property real_name : String?

  def initialize(@name : String, @args : Array(Arg) = [] of Arg, @return_type : ASTNode? = nil, body : ASTNode? = nil, @real_name : String? = nil)
    @body = body
  end

  def clone_without_location : self
    cloned_args = @args.map { |a| a.clone.as(Arg) }
    FunDef.new(@name, cloned_args, clone_node(@return_type), clone_node(@body), @real_name)
  end

  def accept_children(visitor) : Nil
    @args.each { |a| a.accept(visitor) }
    if rt = @return_type
      rt.accept(visitor)
    end
    if b = @body
      b.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@args == other.args) && (@return_type == other.return_type) && (@body == other.body) && (@real_name == other.real_name)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@args)
    h = 31 &* h &+ hash_val(@return_type)
    h = 31 &* h &+ hash_val(@body)
    h = 31 &* h &+ hash_val(@real_name)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "fun " << @name
    if rn = @real_name
      sb << " = " << rn
    end
    if @args.size > 0
      sb << "("
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        @args[i].to_s(sb)
        i = i + 1
      end
      sb << ")"
    end
    if rt = @return_type
      sb << " : "
      rt.to_s(sb)
    end
    if b = @body
      sb << "
  "
      b.to_s(sb)
      sb << "
end"
    end
  end
end

