# Files — the missing piece between a demonstration and a tool.
#
#   ./bin/iyi run samples/iyi/files.iyi
#
# Writes a file, reads it back, checks `exists?`, then deletes it and proves it
# is gone. The path is next to the process and named so it is obvious.

module samples/files

dir = Program.args[0]?
path = dir ? "#{dir}/iyi-files-sample.txt" : "iyi-files-sample.txt"
missing = dir ? "#{dir}/iyi-files-sample-missing.txt" : "iyi-files-sample-missing.txt"
File.write(path, "hello from iyi\n")
puts File.read(path)
puts File.exists?(path)
puts File.exists?(missing)
File.delete(path)
puts File.exists?(path)
