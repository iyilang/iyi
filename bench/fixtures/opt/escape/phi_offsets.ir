; iyi-ir 1
source_filename = "escape_phi_offsets"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @phi_offsets(i1 %choose) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 16, i64 4, i64 2)
  %right = getelementptr i8, ptr %p, i64 8
  br i1 %choose, label %left, label %right_block
left:
  br label %join
right_block:
  br label %join
join:
  %choice = phi ptr [ %p, label %left ], [ %right, label %right_block ]
  %v = load i64, ptr %choice, align 8
  ret i64 %v
}
