# Environment configuration
/Makefile.local
/Makefile.win.local
.env
.env.*
.envrc
.envrc.*

# Build artifacts
*.o
*.ll
*.s
*.obj
*.dwo
*.dwarf
*.pdb
*.exe
/.build/
/docs/
/man/

# Spec artifacts
/spec/manual/dwarf/

# CI
/coverage/
/tmp/
/.junit/

# Devenv

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Python bytecode from bench helpers
__pycache__/
*.pyc

# The VS Code extension's build products; the source is three files.
/editors/vscode/node_modules/
/editors/vscode/*.vsix

# Editor-local configuration: a serverPath is one machine's, not the tree's.
/.vscode/

# What a sample that depends on a shard produces. `shard.yml` and `shard.lock`
# are the sample; `lib/` is what `shards install` fetches, `mods/` is what
# `crystal tool bind` writes, and the rest is a build. Ignored rather than
# committed because `bench/identity_floor.py` reads every file that is tracked
# *or* untracked-and-not-ignored, and a shard's own source is not iyi's to
# answer for.
/samples/crystal/kemal/lib/
/samples/crystal/kemal/mods/
/samples/crystal/kemal/app
/samples/crystal/kemal/app_artifact
/samples/crystal/kemal/app_artifact.iyi
/samples/crystal/kemal/*.log

# The compiler's local cache when IYI_CACHE_DIR is unset.
/.iyi/
