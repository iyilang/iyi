; iyi-ir 1
source_filename = "tls_slot"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@tls = external thread_local(localexec) global i64

declare external void @callee()

define internal ptr @tls_slot() {
entry:
  %slot = alloca ptr, align 8
  %local = threadlocaladdr ptr @tls
  store ptr %local, ptr %slot, align 8
  call void () @callee()
  %value = load ptr, ptr %slot, align 8
  ret ptr %value
}
