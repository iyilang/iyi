# ENV: hash-like accessor for process environment variables.
#
# Provides retrieval, modification, deletion, iteration, and inspection
# of environment variables without external C libraries.
#
# The environment this reaches is the platform's own. On Linux, darwin and
# wasm that is the `environ` table. On Windows it is the Win32 block —
# `GetEnvironmentVariableW`, `SetEnvironmentVariableW`,
# `GetEnvironmentStringsW` — because the CRT's `_environ` table this module
# used to rebuild there is an ANSI copy of it that nobody else reads: a
# value read through it came back folded into the process's code page
# (`değer-日本` as `deger-??`, 13 bytes down to 8), and a value written
# through it never reached the block a child process inherits.

module std/env

pub struct ENV
  # POSIX names are non-empty, '=', and NUL-free; a value is a C string.
  private def self.check_key(key : String) : Nil
    raise "ENV key is empty" if key.empty?
    ptr = key.to_unsafe
    i = 0
    n = key.bytesize
    while i < n
      b = ptr[i]
      raise "ENV key contains a null byte" if b == 0_u8
      raise "ENV key contains '='" if b == 61_u8
      i = i + 1
    end
  end

  private def self.check_value(value : String) : Nil
    ptr = value.to_unsafe
    i = 0
    n = value.bytesize
    while i < n
      raise "ENV value contains a null byte" if ptr[i] == 0_u8
      i = i + 1
    end
  end

  def self.[](key : String) : String
    val = self[key]?
    if val
      val
    else
      raise "Missing ENV key: #{key}"
    end
  end

  def self.[]?(key : String) : String?
    check_key(key)
    {% if flag?(:wasm32) %}
      nil
    {% elsif flag?(:win32) %}
      # One name out of Windows' own block. Nil is also the answer for a
      # name that is not UTF-8, because there is no such variable in a
      # block whose names are UTF-16.
      __iyi_win_env_get(key.to_unsafe, key.bytesize)
    {% else %}
      ptr = __iyi_environ
      return nil if ptr.address == 0_u64

      k_len = key.bytesize
      k_ptr = key.to_unsafe
      index = 0
      while (entry = ptr[index]).address != 0_u64
        offset = 0
        while offset < k_len && entry[offset] == k_ptr[offset]
          offset = offset + 1
        end
        if offset == k_len && entry[k_len] == 61_u8 # '='
          v_start = entry + (k_len + 1)
          v_len = 0
          while v_start[v_len] != 0_u8
            v_len = v_len + 1
          end
          return String.new(v_len) do |target|
            target.copy_from(v_start, v_len)
          end
        end
        index = index + 1
      end
      nil
    {% end %}
  end

  def self.[]=(key : String, value : String?) : String?
    check_key(key)
    if value.nil?
      delete(key)
      nil
    else
      v_str = value
      check_value(v_str)
      {% if flag?(:wasm32) %}
        # noop on wasm
      {% elsif flag?(:win32) %}
        # The write goes to the platform, not to a table of iyi's own: a
        # table only this module reads is an environment the OS, every
        # Windows call and every child process disagree with, and measured,
        # that is exactly what happened — after `ENV["X"] = …` the CRT
        # table carried the variable and `GetEnvironmentStringsW` did not.
        #
        # False is a name or a value that is not UTF-8. `check_key` and
        # `check_value` above have already passed, so nothing else is left
        # for the conversion to refuse.
        unless __iyi_win_env_set(key.to_unsafe, key.bytesize, v_str.to_unsafe, v_str.bytesize)
          raise "ENV key or value is not valid UTF-8"
        end
      {% else %}
        k_len = key.bytesize
        v_len = v_str.bytesize
        entry_len = k_len + 1 + v_len
        buf = Pointer(UInt8).malloc((entry_len + 1).to_u64)
        buf.copy_from(key.to_unsafe, k_len)
        buf[k_len] = 61_u8 # '='
        (buf + (k_len + 1)).copy_from(v_str.to_unsafe, v_len)
        buf[entry_len] = 0_u8

        ptr = __iyi_environ
        if ptr.address == 0_u64
          new_ptr = Pointer(UInt8*).malloc(2_u64)
          new_ptr[0] = buf
          new_ptr[1] = Pointer(UInt8).new(0_u64)
          __iyi_set_environ(new_ptr)
        else
          k_ptr = key.to_unsafe
          index = 0
          found_idx = -1
          while (entry = ptr[index]).address != 0_u64
            if found_idx == -1
              offset = 0
              while offset < k_len && entry[offset] == k_ptr[offset]
                offset = offset + 1
              end
              if offset == k_len && entry[k_len] == 61_u8
                found_idx = index
              end
            end
            index = index + 1
          end

          if found_idx != -1
            ptr[found_idx] = buf
          else
            new_ptr = Pointer(UInt8*).malloc((index + 2).to_u64)
            i = 0
            while i < index
              new_ptr[i] = ptr[i]
              i = i + 1
            end
            new_ptr[index] = buf
            new_ptr[index + 1] = Pointer(UInt8).new(0_u64)
            __iyi_set_environ(new_ptr)
          end
        end
      {% end %}
      v_str
    end
  end

  def self.has_key?(key : String) : Bool
    self[key]? != nil
  end

  def self.fetch(key : String) : String
    self[key]
  end

  def self.fetch(key : String, default : T) : String | T forall T
    val = self[key]?
    if val
      val
    else
      default
    end
  end

  def self.fetch(key : String, &block : String -> T) : String | T forall T
    val = self[key]?
    if val
      val
    else
      yield key
    end
  end

  def self.delete(key : String) : String?
    check_key(key)
    old_val = self[key]?
    return nil if old_val.nil?

    {% if flag?(:wasm32) %}
      nil
    {% elsif flag?(:win32) %}
      # A null value is how Win32 spells a deletion; there is no second
      # call for it. The lookup above already converted this name, so a
      # refusal here is the platform's own and is not swallowed.
      unless __iyi_win_env_unset(key.to_unsafe, key.bytesize)
        raise "Cannot delete ENV key #{key}: Windows refused the write"
      end
      old_val
    {% else %}
      ptr = __iyi_environ
      return nil if ptr.address == 0_u64

      k_len = key.bytesize
      k_ptr = key.to_unsafe
      index = 0
      found_idx = -1
      while (entry = ptr[index]).address != 0_u64
        if found_idx == -1
          offset = 0
          while offset < k_len && entry[offset] == k_ptr[offset]
            offset = offset + 1
          end
          if offset == k_len && entry[k_len] == 61_u8
            found_idx = index
          end
        end
        index = index + 1
      end

      if found_idx != -1
        i = found_idx
        while i < index
          ptr[i] = ptr[i + 1]
          i = i + 1
        end
      end
      old_val
    {% end %}
  end

  def self.clear : Nil
    keys.each do |k|
      delete(k)
    end
  end

  def self.each(&block : String, String -> Nil) : Nil
    {% if flag?(:wasm32) %}
      return
    {% elsif flag?(:win32) %}
      # Windows' own block: NUL-terminated `NAME=VALUE` strings one after
      # another, ending in a second NUL, freed with
      # `FreeEnvironmentStringsW`. It is the enumeration that agrees with
      # what `GetEnvironmentVariableW` answers and with what a child
      # process is handed; the CRT's `_environ` is an ANSI copy, and
      # walking that folded every non-ASCII value into the code page.
      block = LibIyiEnv.GetEnvironmentStringsW
      return if block.address == 0_u64

      index = 0
      while block[index] != 0_u16
        len = 0
        eq = -1
        while block[index + len] != 0_u16
          eq = len if eq == -1 && block[index + len] == 61_u16 # '='
          len = len + 1
        end

        # An entry whose name is empty is `cmd.exe`'s and not a variable:
        # `=C:` and the other per-drive current directories, and
        # `=ExitCode`. No program set them and none can set them.
        if eq > 0
          k = __iyi_win_env_text(block + index, eq)
          v = __iyi_win_env_text(block + (index + eq + 1), len - eq - 1)
          # A name or a value Windows holds that is not convertible — a
          # lone surrogate — is skipped rather than yielded half-converted.
          if k && v
            yield k, v
          end
        end
        index = index + len + 1
      end
      LibIyiEnv.FreeEnvironmentStringsW(block)
    {% else %}
      ptr = __iyi_environ
      return if ptr.address == 0_u64

      index = 0
      while (entry = ptr[index]).address != 0_u64
        len = 0
        eq_pos = -1
        while entry[len] != 0_u8
          if eq_pos == -1 && entry[len] == 61_u8 # '='
            eq_pos = len
          end
          len = len + 1
        end

        if eq_pos > 0
          k = String.new(eq_pos) { |t| t.copy_from(entry, eq_pos) }
          v_len = len - eq_pos - 1
          v = String.new(v_len) { |t| t.copy_from(entry + (eq_pos + 1), v_len) }
          yield k, v
        end
        index = index + 1
      end
    {% end %}
  end

  def self.each_key(&block : String -> Nil) : Nil
    each do |k, _|
      yield k
    end
  end

  def self.each_value(&block : String -> Nil) : Nil
    each do |_, v|
      yield v
    end
  end

  def self.keys : Array(String)
    res = [] of String
    each do |k, _|
      res << k
    end
    res
  end

  def self.values : Array(String)
    res = [] of String
    each do |_, v|
      res << v
    end
    res
  end

  def self.to_h : Hash(String, String)
    res = {} of String => String
    each do |k, v|
      res[k] = v
    end
    res
  end

  def self.empty? : Bool
    size == 0
  end

  def self.size : Int32
    count = 0
    each do |_, _|
      count = count + 1
    end
    count
  end
end

# Reopen top-level ENV module alias
module ::ENV
  def self.[](key : String) : String
    Std::Env::ENV[key]
  end

  def self.[]?(key : String) : String?
    Std::Env::ENV[key]?
  end

  def self.[]=(key : String, value : String?) : String?
    Std::Env::ENV[key] = value
  end

  def self.has_key?(key : String) : Bool
    Std::Env::ENV.has_key?(key)
  end

  def self.fetch(key : String) : String
    Std::Env::ENV.fetch(key)
  end

  def self.fetch(key : String, default : T) : String | T forall T
    Std::Env::ENV.fetch(key, default)
  end

  def self.fetch(key : String, &block : String -> T) : String | T forall T
    Std::Env::ENV.fetch(key, &block)
  end

  def self.delete(key : String) : String?
    Std::Env::ENV.delete(key)
  end

  def self.clear : Nil
    Std::Env::ENV.clear
  end

  def self.keys : Array(String)
    Std::Env::ENV.keys
  end

  def self.values : Array(String)
    Std::Env::ENV.values
  end

  def self.to_h : Hash(String, String)
    Std::Env::ENV.to_h
  end

  def self.each(&block : String, String -> Nil) : Nil
    Std::Env::ENV.each(&block)
  end

  def self.each_key(&block : String -> Nil) : Nil
    Std::Env::ENV.each_key(&block)
  end

  def self.each_value(&block : String -> Nil) : Nil
    Std::Env::ENV.each_value(&block)
  end

  def self.size : Int32
    Std::Env::ENV.size
  end

  def self.empty? : Bool
    Std::Env::ENV.empty?
  end
end
