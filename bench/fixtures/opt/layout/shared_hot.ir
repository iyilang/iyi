; iyi-ir 1
source_filename = "shared_hot"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @shared_hot(i1 %condition, i1 %again) {
entry:
  %unlikely = intrinsic llvm.expect.i1(i1 %condition, i1 false)
  br i1 %unlikely, label %shared, label %fork
shared:
  br label %exit
exit:
  ret i32 7
fork:
  br i1 %again, label %shared, label %exit
}
