class Answer
  getter code : Int32

  def initialize(@code : Int32)
  end
end

class Entry
  getter name : String
  getter value : Answer?

  def initialize(@name : String, @value : Answer?)
  end
end

records = [[Entry.new("Elem", Answer.new(7))]]
records.each do |answers|
  ["Elem"].each do |name|
    answer : Answer? = nil
    answers.each { |item| answer = item.value if item.name == name }
    if answer.nil?
      puts "missing"
      exit 1
    end
    puts answer.as(Answer).code
  end
end

mapped = [1].map do |unused|
  found : Int32? = nil
  [4].each { |value| found = value }
  found || 0
end
puts mapped[0]
