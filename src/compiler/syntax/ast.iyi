pub class Asm < ASTNode
  property text : String
  property outputs : Array(AsmOperand)?
  property inputs : Array(AsmOperand)?
  property clobbers : Array(String)?
  property volatile : Bool
  property alignstack : Bool
  property intel : Bool
  property can_throw : Bool

  def initialize(
    @text : String,
    @outputs : Array(AsmOperand)? = nil,
    @inputs : Array(AsmOperand)? = nil,
    @clobbers : Array(String)? = nil,
    @volatile : Bool = false,
    @alignstack : Bool = false,
    @intel : Bool = false,
    @can_throw : Bool = false,
  )
  end

  def clone_without_location : self
    if o = @outputs
      cloned_outputs = o.map { |x| x.clone.as(AsmOperand) }
    else
      cloned_outputs = nil
    end
    if i = @inputs
      cloned_inputs = i.map { |x| x.clone.as(AsmOperand) }
    else
      cloned_inputs = nil
    end
    Asm.new(
      @text,
      cloned_outputs,
      cloned_inputs,
      clone_opt_strings(@clobbers),
      @volatile,
      @alignstack,
      @intel,
      @can_throw
    )
  end

  def accept_children(visitor) : Nil
    if outs = @outputs
      outs.each { |o| o.accept(visitor) }
    end
    if ins = @inputs
      ins.each { |i| i.accept(visitor) }
    end
  end

  def ==(other : self) : Bool
    (@text == other.text) && (@outputs == other.outputs) && (@inputs == other.inputs) && (@clobbers == other.clobbers) && (@volatile == other.volatile) && (@alignstack == other.alignstack) && (@intel == other.intel) && (@can_throw == other.can_throw)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@text)
    h = 31 &* h &+ hash_val(@outputs)
    h = 31 &* h &+ hash_val(@inputs)
    h = 31 &* h &+ hash_val(@clobbers)
    h = 31 &* h &+ hash_val(@volatile)
    h = 31 &* h &+ hash_val(@alignstack)
    h = 31 &* h &+ hash_val(@intel)
    h = 31 &* h &+ hash_val(@can_throw)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "asm(" << @text.inspect
    if @outputs || @inputs || @clobbers
      sb << " : "
      if outs = @outputs
        i = 0
        while i < outs.size
          sb << ", " if i > 0
          outs[i].to_s(sb)
          i = i + 1
        end
      end
      if @inputs || @clobbers
        sb << " : "
        if ins = @inputs
          j = 0
          while j < ins.size
            sb << ", " if j > 0
            ins[j].to_s(sb)
            j = j + 1
          end
        end
        if clobs = @clobbers
          sb << " : "
          k = 0
          while k < clobs.size
            sb << ", " if k > 0
            sb << clobs[k].inspect
            k = k + 1
          end
        end
      end
    end
    sb << ")"
  end
end
