; iyi-ir 1
source_filename = "counter_overflow"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @counter_overflow(i32 %n, ptr %negative_out) {
entry:
  br label %head
head:
  %i = phi i32 [ 0, label %entry ], [ %next, label %latch ]
  %more = icmp slt i32 %i, %n
  br i1 %more, label %body, label %done
body:
  store i1 false, ptr %negative_out, align 1
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %i, i32 1)
  %next = extractvalue { i32, i1 } %pair, 0
  %expected = intrinsic llvm.expect.i1(i1 false, i1 false)
  br i1 %expected, label %failed, label %latch
failed:
  unreachable
latch:
  br label %head
done:
  ret void
}
