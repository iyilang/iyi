# Exercises `std/gc`: the program's window onto iyi's own collector.
#
# Proves:
#   * `malloc` and `realloc` hand out zeroed heap words, `malloc_atomic`
#     words it does not promise to clear; `realloc` keeps the bytes; `free`
#     hands a chunk back so `is_heap_ptr` stops answering true for it.
#   * `is_heap_ptr` answers true for a chunk's start and its interior, and
#     false for null, a stack address and a freed chunk.
#   * `stats` moves the way the collector does: `bytes_since_collection`
#     climbs with allocation and is zero right after `collect`; `collections`
#     counts every collection; the sweep after garbage reports bytes freed;
#     `mapped_bytes` is at least one arena, and stays at or above the first
#     arena's 16 MiB floor: a class's empty arenas go back once nobody has
#     refilled it for three collections and a second (`IyiMark.class_idle?`),
#     so the figure can fall below an earlier reading; the check stands under
#     134 ms into the run on Linux.
#   * `disable` holds the trigger through allocation that would have
#     collected; `enable` lets it run again; `collect` works while disabled.
#   * `stats` and `is_heap_ptr` take the runtime lock: held by another
#     thread, it holds each back until it is let go.
#   * `stats` reads whole lists beside threads that allocate: two seconds
#     of it while three threads allocate end without a fault.
#   * `is_heap_ptr` answers beside threads whose large chunks come and go:
#     two seconds of it end without a fault, every answer right.
#
# bench/std_gc_exercise.sh drives it, builds once with -Dgc_none to require
# the compile-time refusal, and breaks copies of the module and the runtime to
# prove the checks can fail. With -Dstats_force or -Dis_heap_force, only the
# forced block below runs (see there).
#
#     ./bin/iyi run bench/std_gc_exercise.iyi

@[Unsafe("it exercises std/gc's raw API: memory from GC.malloc read and written through pointers, heap and stack addresses asked about, null freed")]
module bench/std_gc_exercise

import std/gc::{GC}

def check(cond : Bool, what : String) : Nil
  raise "ASSERTION FAILED: #{what}" unless cond
end

# Enough garbage to cross the trigger's budget several times over.
def churn(rounds : Int32) : Int32
  kept = 0
  i = 0
  while i < rounds
    s = "garbage #{i} " * 8
    kept += s.bytesize
    i += 1
  end
  kept
end

# A failure proof's program, in a copy only: `-Dstats_force` or `-Dis_heap_force`
# runs this block alone. It arms one large chunk and starts a second thread that
# frees it while the walk holds at the chunk (see the proof in
# bench/std_gc_exercise.sh). The copy's own calls live here, so this block does
# not build against the real runtime.
{% if flag?(:stats_force) || flag?(:is_heap_force) %}
victim = GC.malloc(2_000_000)
IyiHeap.forced_arm(victim.address)
freer = IyiThread.start do
  IyiHeap.forced_started_set
  IyiHeap.forced_wait_held
  IyiHeap.forced_acked_set
  GC.free(Pointer(Void).new(IyiHeap.forced_victim))
  nil
end
IyiHeap.forced_wait_started
{% if flag?(:stats_force) %}
GC.stats
{% else %}
check(GC.is_heap_ptr(victim), "a large chunk is a heap pointer")
{% end %}
freer.join
check(IyiHeap.forced_walked == 1_u64, "the walk reached the armed chunk once (#{IyiHeap.forced_walked})")
check(IyiHeap.forced_waited?, "the freeing thread waited for the runtime lock")
puts "the armed chunk was walked and read whole"
exit 0
{% end %}

# Whether the block answered while another thread held the runtime lock.
# The holder takes the lock, the block runs here, and the holder lets go
# once the block has answered or a second has passed: a verb that takes
# the lock waits the second out and answers after it, one that walks
# without the lock answers inside it. The block must not allocate, as an
# allocation can wait for the lock too, and that wait is not the verb's.
def answered_while_held(& : -> _) : Bool
  held = Atomic(Int32).new(0)
  asking = Atomic(Int32).new(0)
  answered = Atomic(Int32).new(0)
  early = Atomic(Int32).new(0)
  holder = IyiThread.start do
    IyiHeap.lock
    held.set(1)
    while asking.get == 0
    end
    since = __iyi_monotonic_ns
    while answered.get == 0 && __iyi_monotonic_ns - since < 1_000_000_000_i64
    end
    early.set(answered.get)
    IyiHeap.unlock
    nil
  end
  while held.get == 0
  end
  asking.set(1)
  yield
  answered.set(1)
  holder.join
  early.get != 0
end

# ---------------------------------------------------------------------------
puts "== raw words"
p = GC.malloc(64)
check(p.address != 0_u64, "malloc answers a word")
bytes = p.as(Pointer(UInt8))
zeroed = true
i = 0
while i < 64
  zeroed = false if bytes[i] != 0_u8
  i += 1
end
check(zeroed, "malloc zeroes the chunk")
i = 0
while i < 64
  bytes[i] = (i + 1).to_u8
  i += 1
end
q = GC.realloc(p, 4096)
check(q.address != 0_u64, "realloc answers a word")
qb = q.as(Pointer(UInt8))
kept = true
i = 0
while i < 64
  kept = false if qb[i] != (i + 1).to_u8
  i += 1
end
check(kept, "realloc keeps the first 64 bytes")
check(qb[4095] == 0_u8, "realloc zeroes the new tail")
a = GC.malloc_atomic(32)
check(a.address != 0_u64, "malloc_atomic answers a word")
check(GC.malloc(0).address != 0_u64, "malloc(0) still answers a word")
puts "  malloc and realloc answer zeroed words, malloc_atomic a word; realloc keeps the bytes"

# ---------------------------------------------------------------------------
puts "== heap pointers"
check(GC.is_heap_ptr(q), "a chunk's start is a heap pointer")
check(GC.is_heap_ptr(Pointer(Void).new(q.address + 100_u64)), "a byte inside the chunk is a heap pointer")
check(!GC.is_heap_ptr(Pointer(Void).new(0_u64)), "null is not")
local = 7
check(!GC.is_heap_ptr(pointerof(local).as(Void*)), "a stack address is not")
check(GC.is_heap_ptr(a), "an atomic chunk is, before free")
GC.free(a)
check(!GC.is_heap_ptr(a), "a freed chunk is not")
GC.free(Pointer(Void).new(0_u64))
big = GC.malloc(1_000_000)
check(GC.is_heap_ptr(big), "a large mapping is a heap pointer")
GC.free(big)
check(!GC.is_heap_ptr(big), "a freed large mapping is not")
puts "  start and interior answer true; null, the stack and a freed chunk answer false"

# ---------------------------------------------------------------------------
puts "== stats move with the collector"
s0 = GC.stats
check(s0.mapped_bytes >= 16_777_216_u64, "at least one arena is mapped (#{s0.mapped_bytes})")
c0 = s0.collections
churn(300_000)
s1 = GC.stats
check(s1.collections > c0, "churn crossed the trigger: collections #{c0} -> #{s1.collections}")
check(s1.mapped_bytes >= 16_777_216_u64, "mapped_bytes stays at the first arena's floor (#{s1.mapped_bytes})")
churn(1_000)
check(GC.stats.bytes_since_collection > 0_u64, "bytes_since_collection climbs after allocation")
c1 = GC.stats.collections
GC.collect
s2 = GC.stats
check(s2.collections == c1 + 1_u64, "collect counts one collection (#{c1} -> #{s2.collections})")
check(s2.bytes_since_collection == 0_u64, "bytes_since_collection is zero right after collect")
check(s2.bytes_freed_by_last_sweep > 0_u64, "the sweep after churn freed bytes (#{s2.bytes_freed_by_last_sweep})")
check(s2.bytes_kept_by_last_sweep > 0_u64, "the sweep kept the live program (#{s2.bytes_kept_by_last_sweep})")
check(s2.to_s.includes?("collections=#{s2.collections}"), "to_s names the fields")
puts "  #{s2.to_s}"
puts "  bytes_since_collection climbs and resets, collections count, the sweep reports freed and kept"

# ---------------------------------------------------------------------------
puts "== disable holds the trigger"
GC.disable
c2 = GC.stats.collections
churn(300_000)
check(GC.stats.collections == c2, "no collection ran while disabled (#{c2} -> #{GC.stats.collections})")
check(GC.stats.bytes_since_collection > 0_u64, "allocation still counted while disabled")
GC.collect
check(GC.stats.collections == c2 + 1_u64, "collect runs while disabled")
GC.enable
c3 = GC.stats.collections
churn(300_000)
check(GC.stats.collections > c3, "the trigger runs again after enable (#{c3} -> #{GC.stats.collections})")
puts "  disabled: 300k allocations, no collection; collect still runs; enabled: the trigger runs again"

puts "== a string built in a reused chunk ends in a NUL"
# A string's chunk is atomic, so the collector hands it back uncleared,
# and the byte after its last is what makes `to_unsafe` a C string - the
# form `std/process` and `std/debug` hand the platform a path in. Longer
# strings fill the chunks first; after the collection that frees them,
# every string built in their place has to end in a NUL of its own.
unterminated = 0
round = 0
while round < 20
  longer = [] of String
  2000.times { |i| longer << "y" * 21 }
  longer = [] of String
  GC.collect
  20.times do
    built = String.build { |io| io << "a-path-" << "built.txt" }
    unterminated = unterminated + 1 if built.to_unsafe[built.bytesize] != 0_u8
  end
  round = round + 1
end
check(unterminated == 0, "#{unterminated} of 400 strings built in reused chunks had no terminator")
puts "  400 strings built where longer ones were freed, each a C string"

# ---------------------------------------------------------------------------
puts "== stats and is_heap_ptr wait for the runtime lock"
# Both walk lists another thread's `free` or sweep unlinks and unmaps under
# the runtime lock, so both walk under it. Held by another thread, it holds
# them back until it is let go, and a copy that walks without it answers
# inside the hold: every run, on every system. The races below meet
# another thread's unmap only as the machine arranges it, and then the
# unlocked walk faults or answers wrong, so they could not name that copy.
mapped = 0_u64
check(!answered_while_held { mapped = GC.stats.mapped_bytes }, "stats answered while another thread held the runtime lock")
check(mapped >= 16_777_216_u64, "stats after the hold counts the arenas (#{mapped})")
inside = Pointer(UInt8).malloc(2_000_000_u64)
found = false
check(!answered_while_held { found = GC.is_heap_ptr((inside + 1_000_000_i64).as(Void*)) }, "is_heap_ptr answered while another thread held the runtime lock")
check(found, "is_heap_ptr after the hold finds a large chunk's interior")
puts "  each waited for a thread holding the runtime lock, and answered after it let go"

# ---------------------------------------------------------------------------
puts "== stats beside threads that allocate"
# `stats` walks the arena and large-mapping lists under the runtime lock.
# Walked without it, a collection another thread's allocation started
# stopped the walk on a mapping, unlinked and unmapped it, and the walk's
# next read faulted: three threads allocating - a 3 MB chunk and a small
# array a turn, so collections are frequent and mappings come and go -
# beside two seconds of `stats` died of a memory fault in 100 runs of 100
# on Windows 11 and 99 of 100 on Linux, idle and on four busy cores, and
# passed the hundredth there. That copy fails at the hold above now; this
# is the walk under the lock beside unmaps.
stop = Atomic(Int32).new(0)
allocators = [] of IyiThread
3.times do
  allocators << IyiThread.start do
    while stop.get == 0
      Pointer(UInt8).malloc(3_000_000_u64)[0] = 1_u8
      Array(Int32).new(50) { |k| k }
    end
    nil
  end
end
started = __iyi_monotonic_ns
while __iyi_monotonic_ns - started < 2_000_000_000_i64
  check(GC.stats.mapped_bytes >= 16_777_216_u64, "stats beside allocating threads counts the arenas")
end
stop.set(1)
allocators.each(&.join)
puts "  two seconds of stats beside three allocating threads, every read whole"

puts "== is_heap_ptr beside threads whose large chunks come and go"
# A word in no arena walks the large-mapping list, which a `free` or a
# sweep on another thread unlinks and unmaps under the runtime lock.
# Walked without it, two seconds of `is_heap_ptr` beside three threads
# that each malloc 3 MB, grow it to 5 MB and drop it died of a memory
# fault in 200 runs of 200 on Windows 11 and 187 of 200 on Linux, idle
# and on four busy cores, where it also answered wrong once and passed
# 12 times; a Windows CI runner's answered wrong (job 136250482652).
# That copy fails at the hold above now.
quit = Atomic(Int32).new(0)
mappers = [] of IyiThread
3.times do
  mappers << IyiThread.start do
    while quit.get == 0
      grown = Pointer(UInt8).malloc(3_000_000_u64).realloc(5_000_000_u64)
      grown[4_999_999] = 2_u8
      Array(Int32).new(50) { |k| k }
    end
    nil
  end
end
mine = Pointer(UInt8).malloc(2_000_000_u64)
on_stack = 12345_u64
wrong = 0
started = __iyi_monotonic_ns
while __iyi_monotonic_ns - started < 2_000_000_000_i64
  wrong += 1 if GC.is_heap_ptr(pointerof(on_stack).as(Void*))
  wrong += 1 unless GC.is_heap_ptr((mine + 1_000_000_i64).as(Void*))
end
quit.set(1)
mappers.each(&.join)
check(wrong == 0, "is_heap_ptr beside large chunks coming and going answered #{wrong} wrong")
puts "  two seconds of is_heap_ptr beside three threads mapping large chunks, every answer right"

puts "ALL CHECKS PASSED"
