    0x3c77893b4d91cd9d_u64, 0x3fefe7c1819e90d8_u64, 0x3c5305c14160cc89_u64, 0x3feff3c22b8f71f1_u64,
  ] of UInt64

  def self.exp(value : Float64) : Float64
    bits = IyiFloatText.bits_of(value)
    abstop = (bits.unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    # Outside 2^-54 <= |x| < 512: tiny, the ends of the range, or large.
    if abstop < 0x3c9_i64 || abstop >= 0x408_i64
      return 1.0 + value if abstop < 0x3c9_i64
      if abstop >= 0x409_i64
        return 0.0 if bits == 0xfff0000000000000_u64
        return 1.0 + value if abstop >= 0x7ff_i64
        return bits.unsafe_shr(63_u64) != 0_u64 ? 0.0 : 1.0 / 0.0
      end
      # 512 <= |x| < 1024: the scale may leave the exponent's range.
      abstop = 0_i64
    end
    z = EXP_INVLN2N * value
    kd = z + EXP_SHIFT
    ki = IyiFloatText.bits_of(kd)
    kd = kd - EXP_SHIFT
    r = value + kd * EXP_NEGLN2HI + kd * EXP_NEGLN2LO
    table = EXP_TAB.to_unsafe
    idx = ((ki & 127_u64) &* 2_u64).to_i32
    top = ki.unsafe_shl(45_u64)
    tail = IyiFloatText.from_bits(table[idx])
    sbits = table[idx + 1] &+ top
    r2 = r * r
    tmp = tail + r + r2 * (EXP_C2 + r * EXP_C3) + r2 * r2 * (EXP_C4 + r * EXP_C5)
    return exp_special(tmp, sbits, ki) if abstop == 0_i64
    scale = IyiFloatText.from_bits(sbits)
    scale + scale * tmp
  end

  # The scale for 512 <= |x| < 1024, whose exponent may have overflowed by
  # up to 460: taken back into range, the product made there, and scaled
  # out again - by 2^1009 when k > 0, by 2^-1022 when k < 0, where a result
  # in the subnormals is rounded once to its precision before the scaling
  # rather than twice.
  private def self.exp_special(tmp : Float64, sbits : UInt64, ki : UInt64) : Float64
    if ki & 0x80000000_u64 == 0_u64
      scale = IyiFloatText.from_bits(sbits &- 0x3f10000000000000_u64)
      return 5.486124068793689e+303 * (scale + scale * tmp)
    end
    scale = IyiFloatText.from_bits(sbits &+ 0x3fe0000000000000_u64)
    y = scale + scale * tmp
    if y < 1.0
      lo = scale - y + scale * tmp
      hi = 1.0 + y
      lo = 1.0 - hi + y + lo
      y = (hi + lo) - 1.0
      y = 0.0 if y == 0.0
    end
    2.2250738585072014e-308 * y
  end

  def self.exp(value : Float32) : Float32
    exp(value.to_f64).to_f32
  end

  def self.exp(value : T) : Float64 forall T
    exp(value.to_f64)
  end

  # 2^value as glibc computes it - Arm's optimized-routines exp2, glibc's
  # since 2.28, on `exp`'s table: value = k/128 + r, 2^(k/128) from the
  # table and 2^r by a degree-5 polynomial, under 0.52 ulp, and a whole
  # value exact. The `exp(frac * log 2)` this replaces answered differently
  # from glibc's for about one argument in eight. Unfused, as `exp`.
  private EXP2_SHIFT =      52776558133248.0
  private EXP2_C1    =   0.69314718055994529
  private EXP2_C2    =   0.24022650695909065
  private EXP2_C3    =    0.0555041086686087
  private EXP2_C4    = 0.0096181319757210545
  private EXP2_C5    = 0.0013332074570119598

  def self.exp2(value : Float64) : Float64
    bits = IyiFloatText.bits_of(value)
    abstop = (bits.unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    if abstop < 0x3c9_i64 || abstop >= 0x408_i64
      return 1.0 + value if abstop < 0x3c9_i64
      if abstop >= 0x409_i64
        return 0.0 if bits == 0xfff0000000000000_u64
        return 1.0 + value if abstop >= 0x7ff_i64
        return 1.0 / 0.0 if bits.unsafe_shr(63_u64) == 0_u64
        return 0.0 if bits >= 0xc090cc0000000000_u64
      end
      # |value| > 928: the scale may leave the exponent's range.
      abstop = 0_i64 if bits &* 2_u64 > 0x811a000000000000_u64
    end
    kd = value + EXP2_SHIFT
    ki = IyiFloatText.bits_of(kd)
    kd = kd - EXP2_SHIFT
    r = value - kd
    table = EXP_TAB.to_unsafe
    idx = ((ki & 127_u64) &* 2_u64).to_i32
    top = ki.unsafe_shl(45_u64)
    tail = IyiFloatText.from_bits(table[idx])
    sbits = table[idx + 1] &+ top
    r2 = r * r
    tmp = tail + r * EXP2_C1 + r2 * (EXP2_C2 + r * EXP2_C3) + r2 * r2 * (EXP2_C4 + r * EXP2_C5)
    if abstop == 0_i64
      if ki & 0x80000000_u64 == 0_u64
        scale = IyiFloatText.from_bits(sbits &- 0x0010000000000000_u64)
        return 2.0 * (scale + scale * tmp)
      end
      return exp_special(tmp, sbits, ki)
    end
    scale = IyiFloatText.from_bits(sbits)
    scale + scale * tmp
  end

  def self.exp2(value : Float32) : Float32
    exp2(value.to_f64).to_f32
  end

  def self.exp2(value : T) : Float64 forall T
    exp2(value.to_f64)
  end

  # fdlibm's words: the high 32 bits of a double, and the double with them
  # replaced, the low half kept.
  private def self.high_word(x : Float64) : Int64
    IyiFloatText.bits_of(x).unsafe_shr(32_u64).unsafe_to_i64
  end

  private def self.with_high_word(x : Float64, high : Int64) : Float64
    IyiFloatText.from_bits((high.unsafe_to_u64 & 0xffffffff_u64).unsafe_shl(32_u64) | (IyiFloatText.bits_of(x) & 0xffffffff_u64))
  end

  # expm1 as glibc computes it - fdlibm's `s_expm1.c`, which glibc carries
  # (Sun's notice is at `log10`): x = k ln2 + r with a correction for the
  # rounding of r, exp(r) - 1 by a rational function on [0, 0.3466], and
  # the scaling back by k in the exponent's word. A series near zero and
  # Kahan's (u - 1) x / log(u) elsewhere, which this replaces, answered
  # differently from glibc's for about one argument in seven.
  private EXPM1_O_THRESHOLD =  7.09782712893383973096e+02
  private EXPM1_LN2_HI      =  6.93147180369123816490e-01
  private EXPM1_LN2_LO      =  1.90821492927058770002e-10
  private EXPM1_INVLN2      =  1.44269504088896338700e+00
  private EXPM1_Q1          = -3.33333333333331316428e-02
  private EXPM1_Q2          =  1.58730158725481460165e-03
  private EXPM1_Q3          = -7.93650757867487942473e-05
  private EXPM1_Q4          =  4.00821782732936239552e-06
  private EXPM1_Q5          = -2.01099218183624371326e-07

  def self.expm1(value : Float64) : Float64
    x = value
    hx = high_word(x) & 0xffffffff_i64
    negative = hx & 0x80000000_i64 != 0_i64
    hx = hx & 0x7fffffff_i64
    if hx >= 0x4043687a_i64
      # |x| >= 56 ln2.
      if hx >= 0x40862e42_i64
        if hx >= 0x7ff00000_i64
          return x + x if IyiFloatText.bits_of(x) & 0x000fffffffffffff_u64 != 0_u64
          return negative ? -1.0 : x
        end
        return 1.0e+300 * 1.0e+300 if x > EXPM1_O_THRESHOLD
      end
      return 1.0e-300 - 1.0 if negative
    end
    c = 0.0
    k = 0
    if hx > 0x3fd62e42_i64
      # |x| > ln2 / 2: reduced.
      hi = 0.0
      lo = 0.0
      if hx < 0x3ff0a2b2_i64
        if negative
          hi = x + EXPM1_LN2_HI
          lo = EXPM1_LN2_LO * -1.0
          k = -1
        else
          hi = x - EXPM1_LN2_HI
          lo = EXPM1_LN2_LO
          k = 1
        end
      else
        k = (EXPM1_INVLN2 * x + (negative ? -0.5 : 0.5)).unsafe_to_i32
        t = k.to_f64
        hi = x - t * EXPM1_LN2_HI
        lo = t * EXPM1_LN2_LO
      end
      x = hi - lo
      c = (hi - x) - lo
    elsif hx < 0x3c900000_i64
      # |x| < 2^-54: x itself.
      return x
    end
    hfx = 0.5 * x
    hxs = x * hfx
    r1 = 1.0 + hxs * EXPM1_Q1
    h2 = hxs * hxs
    r2 = EXPM1_Q2 + hxs * EXPM1_Q3
    h4 = h2 * h2
    r3 = EXPM1_Q4 + hxs * EXPM1_Q5
    rr = r1 + h2 * r2 + h4 * r3
    t = 3.0 - rr * hfx
    e = hxs * ((rr - t) / (6.0 - x * t))
    return x - (x * e - hxs) if k == 0
    e = x * (e - c) - c
    e = e - hxs
    return 0.5 * (x - e) - 0.5 if k == -1
    if k == 1
      return x < -0.25 ? -2.0 * (e - (x + 0.5)) : 1.0 + 2.0 * (x - e)
    end
    if k <= -2 || k > 56
      y = 1.0 - (e - x)
      y = with_high_word(y, high_word(y) + (k.to_i64 << 20))
      return y - 1.0
    end
    if k < 20
      t = with_high_word(1.0, 0x3ff00000_i64 - (0x200000_i64 >> k))
      y = t - (e - x)
    else
      t = with_high_word(1.0, (0x3ff_i64 - k) << 20)
      y = x - (e + t)
      y = y + 1.0
    end
    with_high_word(y, high_word(y) + (k.to_i64 << 20))
  end

  def self.expm1(value : Float32) : Float32
    expm1(value.to_f64).to_f32
  end

  def self.expm1(value : T) : Float64 forall T
    expm1(value.to_f64)
  end

  # log as glibc computes it - Arm's optimized-routines log, glibc's since
  # 2.28 - under 0.52 ulp: near 1 a degree-12 polynomial in x - 1 with the
  # square taken in two parts; elsewhere x = 2^k z, z by a 128-entry table
  # to within 1/256 of a point c whose log is known to 2^-97, and a
  # degree-6 polynomial for the rest. The table's second pair is c split in
  # two, so that z - c is exact without a fused multiply-add - glibc's
  # build without FMA, unfused on every target, as `exp`'s. The series in
  # (m - 1)/(m + 1) this replaces answered differently from glibc's for
  # about one argument in a hundred. Arm's notice is at `exp`; the tables
  # and coefficients are `math/log_data.c`'s for N = 128, orders 6 and 12.
  private LOG_LN2HI =    0.69314718055989033
  private LOG_LN2LO = 5.4979230187083712e-14
  private LOG_A0    =   -0.50000000000000011
  private LOG_A1    =    0.33333333331825593
  private LOG_A2    =   -0.24999999996229549
  private LOG_A3    =    0.20000304511814496
  private LOG_A4    =   -0.16667054827627667
  private LOG_B0    =                   -0.5
  private LOG_B1    =     0.3333333333333352
  private LOG_B2    =   -0.24999999999998432
  private LOG_B3    =    0.19999999999320328
  private LOG_B4    =   -0.16666666669929706
  private LOG_B5    =    0.14285715076560868
  private LOG_B6    =   -0.12499997863982555
  private LOG_B7    =    0.11110712032936046
  private LOG_B8    =   -0.10000486757818193
  private LOG_B9    =   0.091819940061954666
  private LOG_B10   =  -0.083283630622893415

