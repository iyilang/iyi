@[Unsafe("the fixture declares the checked float conversion primitives")]
require "./runtime"

struct Float32
  @[Primitive(:convert)]
  def chk_i8 : Int8
  end

  @[Primitive(:convert)]
  def chk_i16 : Int16
  end

  @[Primitive(:convert)]
  def chk_i32 : Int32
  end

  @[Primitive(:convert)]
  def chk_i64 : Int64
  end

  @[Primitive(:convert)]
