# Levenshtein distance methods for iyi.
#
# Provides edit distance calculation and fuzzy string matching.

module std/levenshtein

import std/text

module ::Levenshtein
  # Computes the Levenshtein distance between two strings.
  def self.distance(string1 : String, string2 : String) : Int32
    return 0 if string1 == string2

    s_size = string1.size
    t_size = string2.size

    return t_size if s_size == 0
    return s_size if t_size == 0

    if t_size > s_size
      string1, string2 = string2, string1
      t_size, s_size = s_size, t_size
    end

    costs = Array(Int32).new(t_size + 1) { |i| i }
    last_cost = 0

    if string1.bytesize == string1.size && string2.bytesize == string2.size
      s = string1.to_unsafe
      t = string2.to_unsafe

      i = 0
      while i < s_size
        last_cost = i + 1
        j = 0
        while j < t_size
          sub_cost = s[i] == t[j] ? 0 : 1
          cost = last_cost + 1
          c2 = costs[j + 1] + 1
          cost = c2 if c2 < cost
          c3 = costs[j] + sub_cost
          cost = c3 if c3 < cost

          costs[j] = last_cost
          last_cost = cost
          j = j + 1
        end
        costs[t_size] = last_cost
        i = i + 1
      end

      last_cost
    else
      chars1 = string1.chars
      chars2 = string2.chars

      i = 0
      while i < s_size
        last_cost = i + 1
        c1 = chars1[i]
        j = 0
        while j < t_size
          sub_cost = c1 == chars2[j] ? 0 : 1
          cost = last_cost + 1
          c2 = costs[j + 1] + 1
          cost = c2 if c2 < cost
          c3 = costs[j] + sub_cost
          cost = c3 if c3 < cost

          costs[j] = last_cost
          last_cost = cost
          j = j + 1
        end
        costs[t_size] = last_cost
        i = i + 1
      end

      last_cost
    end
  end

  # Optimal string alignment: Levenshtein plus an adjacent transposition as
  # one edit. `cuont` for `count` is two edits by `distance` and one here.
  def self.osa_distance(string1 : String, string2 : String) : Int32
    return 0 if string1 == string2

    a = string1.chars
    b = string2.chars
    a_size = a.size
    b_size = b.size
    return b_size if a_size == 0
    return a_size if b_size == 0

    width = b_size + 1
    two_back = Array(Int32).new(width) { |j| 0 }
    previous = Array(Int32).new(width) { |j| j }
    current = Array(Int32).new(width) { |j| 0 }

    i = 0
    while i < a_size
      char1 = a[i]
      current[0] = i + 1
      j = 0
      while j < b_size
        char2 = b[j]
        cost = char1 == char2 ? 0 : 1
        best = previous[j + 1] + 1
        c_ins = current[j] + 1
        best = c_ins if c_ins < best
        c_sub = previous[j] + cost
        best = c_sub if c_sub < best
        if i > 0 && j > 0 && char1 == b[j - 1] && a[i - 1] == char2
          c_tr = two_back[j - 1] + 1
          best = c_tr if c_tr < best
        end
        current[j + 1] = best
        j = j + 1
      end
      tmp = two_back
      two_back = previous
      previous = current
      current = tmp
      i = i + 1
    end

    previous[b_size]
  end

  struct Entry
    getter value : String
    getter distance : Int32

    def initialize(@value : String, @distance : Int32)
    end
  end

  # Finds the closest string to a given string amongst candidates.
  class Finder
    getter target : String
    getter tolerance : Int32
    @best_entry : Entry?

    def initialize(@target : String, tolerance : Int32? = nil)
      @tolerance = tolerance || ((@target.size + 4) // 5)
      @best_entry = nil
    end

    def test(name : String, value : String = name) : Nil
      dist = Levenshtein.osa_distance(@target, name)
      if dist <= @tolerance
        if best = @best_entry
          if dist < best.distance
            @best_entry = Entry.new(value, dist)
          end
        else
          @best_entry = Entry.new(value, dist)
        end
      end
    end

    def best_match : String?
      if entry = @best_entry
        entry.value
      else
        nil
      end
    end

    def self.find(name : String, tolerance : Int32? = nil, &block : Finder -> Nil) : String?
      finder = new(name, tolerance)
      yield finder
      finder.best_match
    end

    def self.find(name : String, all_names, tolerance : Int32? = nil) : String?
      find(name, tolerance) do |similar|
        all_names.each do |a_name|
          similar.test(a_name)
        end
      end
    end
  end

  def self.find(name : String, tolerance : Int32? = nil, &block : Finder -> Nil) : String?
    Finder.find(name, tolerance) do |finder|
      yield finder
    end
  end

  def self.find(name : String, all_names, tolerance : Int32? = nil) : String?
    Finder.find(name, all_names, tolerance)
  end
end
