# Exercises `std/hpke`.
#
# Run via:
#     ./bin/iyi run bench/std_hpke_exercise.iyi [-- VECTORS.json]
#
# With no argument: seven of RFC 9180's test vectors, embedded below, then
# three known answers for the suites the RFC has no vectors for, round trips
# in every suite and mode, the refusals of section 7.1.4, failed opens and
# the nonce limit - no file, network or Python. With VECTORS.json, RFC
# 9180's vectors in the shape bench/std_hpke_exercise.sh cuts them
# (bench/std_hpke_fixture has the vendored subset), every vector is checked
# first. The other modes the gate drives:
#   oracle   reads lines from standard input, answers a line each:
#              k KEM IKM                    -> SK PK
#              p KEM PK                     -> ok | refused: why
#              s KEM KDF AEAD PKR INFO IKME PSK PSKID SKS CTX L MESSAGES
#                                           -> ENC EXPORT CIPHERTEXTS | refused: why
#              o KEM KDF AEAD SKR ENC INFO PSK PSKID PKS CTX L MESSAGES
#                                           -> EXPORT PLAINTEXTS | refused: why
#            the ids decimal, everything else hex, `-` for an empty field
#            or no key; MESSAGES is AAD.PT (or AAD.CT) pairs joined by
#            commas, sealed or opened in order in one context, and
#            CIPHERTEXTS and PLAINTEXTS are joined the same way;
#   cost     what single-shot and in-context seal and open of 1 KiB take.

module bench/std_hpke_exercise

import std/int
import std/hpke::{HpkeSuite, HpkeKem, HpkeKdf, HpkeAead, HpkeMode, HpkePrivateKey, HpkePublicKey, HpkeError, HpkeSender, HpkeRecipient}
import std/aead::{AesGcm, ChaCha20Poly1305}
import std/digest::{SHA256, SHAKE256}
import std/json::{JSON, Any}
import std/file::{File}

def check(cond : Bool, label : String) : Nil
  raise "ASSERTION FAILED: #{label}" unless cond
end

def b(hex : String) : Array(UInt8)
  p = hex.to_unsafe
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hi = p[i * 2].to_i32 | 32
    lo = p[i * 2 + 1].to_i32 | 32
    hi = hi >= 97 ? hi - 87 : hi - 48
    lo = lo >= 97 ? lo - 87 : lo - 48
    (hi * 16 + lo).to_u8
  end
end

def hex(bytes : Array(UInt8)) : String
  digits = "0123456789abcdef".to_unsafe
  String.new(bytes.size * 2) do |buf|
    i = 0
    while i < bytes.size
      buf[i * 2] = digits[bytes[i] >> 4]
      buf[i * 2 + 1] = digits[bytes[i] & 15_u8]
      i = i + 1
    end
  end
end

def bytes_of(s : String) : Array(UInt8)
  p = s.to_unsafe
  Array(UInt8).new(s.bytesize) { |i| p[i] }
end

def hex(s : String) : String
  hex(bytes_of(s))
end

# A deterministic stream of test bytes: SHAKE256 of a label.
def drawn(label : String, count : Int32) : Array(UInt8)
  SHAKE256.new.update(label).read(count)
end

# 2^96 - 1, the sequence a context refuses to seal or open at.
LAST = 1_u128.unsafe_shl(96) &- 1_u128

MODES = ["base", "psk", "auth", "auth_psk"]
KEMS  = [HpkeKem::X25519Sha256, HpkeKem::P256Sha256, HpkeKem::P384Sha384]
KDFS  = [HpkeKdf::HkdfSha256, HpkeKdf::HkdfSha384, HpkeKdf::HkdfSha512]
AEADS = [HpkeAead::Aes128Gcm, HpkeAead::Aes256Gcm, HpkeAead::ChaCha20Poly1305, HpkeAead::ExportOnly]

def id4(n : Int32) : String
  "0x" + n.to_s(16).rjust(4, '0')
end

# SerializePrivateKey of a vector's sk: the RFC's vectors print an X25519
# key as DeriveKeyPair made it, and section 7.1.2 clamps it when it is
# serialised.
def serialised(kem : HpkeKem, sk : String) : String
  return sk unless kem == HpkeKem::X25519Sha256
  k = b(sk)
  k[0] = k[0] & 248_u8
  k[31] = (k[31] & 127_u8) | 64_u8
  hex(k)
end

# The nonce of section 5.2's ComputeNonce, worked here from the vector's
# base nonce, for a sequence number no vector reaches.
def nonce_at(base : Array(UInt8), seq : UInt128) : Array(UInt8)
  Array(UInt8).new(12) { |i| base[i] ^ seq.unsafe_shr((11 - i) * 8).unsafe_to_u8 }
end

def aead_seal(aead : HpkeAead, key : Array(UInt8), nonce : Array(UInt8), pt : Array(UInt8), aad : String) : String
  case aead
  when HpkeAead::ChaCha20Poly1305 then ChaCha20Poly1305.new(key).seal(nonce, pt, aad)
  else                                 AesGcm.new(key).seal(nonce, pt, aad)
  end
end

def opened?(got : String | HpkeError, want : Array(UInt8)) : Bool
  got.is_a?(String) && bytes_of(got) == want
end

def refused?(got, phrase : String) : Bool
  got.is_a?(HpkeError) && got.message.includes?(phrase)
end

def optional(c : Any, field : String) : Array(UInt8) | Nil
  value = c.as_h[field]?
  value.nil? ? nil : b(value.as_s)
end

# One of RFC 9180's vectors, in the shape bench/std_hpke_exercise.sh cuts
# them: the key pairs DeriveKeyPair makes of ikmR, ikmE and ikmS, read
# back from their serialisations; Encap or AuthEncap with the vector's
# ephemeral, and Decap; the contexts at both ends, sealing all `count`
# encryptions in order (each listed one compared, all of them by the
# SHA-256 of their ciphertexts) and opening each; a recipient that skips
# to each listed one; the vector's key and base nonce at sequence 2^96 - 2
# and the refusal at 2^96 - 1; the single-shot functions of section 6; and
# every export, at both ends. Answers the encryptions and exports checked.
def run_vector(c : Any, label : String) : {Int32, Int32}
  found = HpkeSuite.from_ids(c["kem_id"].as_i, c["kdf_id"].as_i, c["aead_id"].as_i)
  check found.is_a?(HpkeSuite), "#{label}: the suite"
  suite = found.as(HpkeSuite)
  kem = suite.kem
  mode = c["mode"].as_i
  info = b(c["info"].as_s)
  ikm_e = b(c["ikmE"].as_s)
  psk = optional(c, "psk")
  psk_id = optional(c, "psk_id")
  check (mode == 1 || mode == 3) == !psk.nil?, "#{label}: a psk exactly in the psk modes"

  key_r = HpkePrivateKey.derive(kem, b(c["ikmR"].as_s))
  check hex(key_r.bytes) == serialised(kem, c["skRm"].as_s), "#{label}: skRm from ikmR"
  check hex(key_r.public_key.bytes) == c["pkRm"].as_s, "#{label}: pkRm from ikmR"
  key_e = HpkePrivateKey.derive(kem, ikm_e)
  check hex(key_e.bytes) == serialised(kem, c["skEm"].as_s), "#{label}: skEm from ikmE"
  check hex(key_e.public_key.bytes) == c["pkEm"].as_s, "#{label}: pkEm from ikmE"
  read_r = HpkePrivateKey.from_bytes(kem, b(c["skRm"].as_s))
  check read_r.is_a?(HpkePrivateKey) && read_r.public_key.bytes == key_r.public_key.bytes, "#{label}: skRm read back"
  read_r = read_r.as(HpkePrivateKey)
  public_r = HpkePublicKey.from_bytes(kem, b(c["pkRm"].as_s))
  check public_r.is_a?(HpkePublicKey), "#{label}: pkRm read back"
  public_r = public_r.as(HpkePublicKey)

  sender_key = nil.as(HpkePrivateKey | Nil)
  sender_public = nil.as(HpkePublicKey | Nil)
  if mode >= 2
    key_s = HpkePrivateKey.derive(kem, b(c["ikmS"].as_s))
    check hex(key_s.bytes) == serialised(kem, c["skSm"].as_s), "#{label}: skSm from ikmS"
    check hex(key_s.public_key.bytes) == c["pkSm"].as_s, "#{label}: pkSm from ikmS"
    sender_key = key_s
    sender_public = HpkePublicKey.from_bytes(kem, b(c["pkSm"].as_s)).as(HpkePublicKey)
  end

  sent = kem.encapsulate(public_r, ikm_e, sender_key)
  check !sent.is_a?(HpkeError), "#{label}: the encapsulation refused"
  sent = sent.as({Array(UInt8), Array(UInt8)})
  check hex(sent[0]) == c["enc"].as_s, "#{label}: the encapsulation"
  check hex(sent[1]) == c["shared_secret"].as_s, "#{label}: the encapsulation's shared secret"
  secret = kem.decapsulate(read_r, b(c["enc"].as_s), sender_public)
  check secret.is_a?(Array(UInt8)) && hex(secret) == c["shared_secret"].as_s, "#{label}: the decapsulated shared secret"

  sender = suite.sender(public_r, info, ikm_e, psk, psk_id, sender_key).as(HpkeSender)
  check hex(sender.enc) == c["enc"].as_s, "#{label}: the sender's enc"
  check sender.mode.value == mode, "#{label}: the sender's mode"
  recipient = suite.recipient(read_r, sender.enc, info, psk, psk_id, sender_public).as(HpkeRecipient)
  check recipient.mode.value == mode, "#{label}: the recipient's mode"

  count = c["count"].as_i
  listed = c["encryptions"].as_a
  if count > 0
    pt = b(listed[0]["pt"].as_s)
    digest = SHA256.new
    at = 0
    i = 0
    while i < count
      aad = "Count-#{i}"
      sealed = sender.seal(pt, aad)
      check sealed.is_a?(String), "#{label}: encryption #{i} refused"
      sealed = sealed.as(String)
      digest.update(sealed)
      if at < listed.size && listed[at]["seq"].as_i == i
        check listed[at]["aad"].as_s == hex(aad) && b(listed[at]["pt"].as_s) == pt, "#{label}: encryption #{i}'s aad and plaintext"
        check hex(sealed) == listed[at]["ct"].as_s, "#{label}: encryption #{i}"
        at = at + 1
      end
      check opened?(recipient.open(sealed, aad), pt), "#{label}: encryption #{i} opened"
      i = i + 1
    end
    check at == listed.size, "#{label}: every listed encryption reached"
    check hex(digest.final) == c["ciphertexts_sha256"].as_s, "#{label}: all #{count} encryptions, by the SHA-256 of their ciphertexts"
    check sender.sequence == count.to_u128 && recipient.sequence == count.to_u128, "#{label}: both sequences at #{count}"

    skipper = suite.recipient(read_r, sender.enc, info, psk, psk_id, sender_public).as(HpkeRecipient)
    listed.each do |e|
      seq = e["seq"].as_i
      skipper.advance_to(seq.to_u128)
      check opened?(skipper.open(b(e["ct"].as_s), "Count-#{seq}"), pt), "#{label}: encryption #{seq} opened after skipping to it"
    end

    # Sequence 2^96 - 2 is the last a context seals at; the vector's key
    # and base nonce give its ciphertext through std/aead directly.
    late = suite.sender(public_r, info, ikm_e, psk, psk_id, sender_key).as(HpkeSender)
    late.advance_to(LAST &- 1_u128)
    last = late.seal(pt, "late")
    want = aead_seal(suite.aead, b(c["key"].as_s), nonce_at(b(c["base_nonce"].as_s), LAST &- 1_u128), pt, "late")
    check last.is_a?(String) && last == want, "#{label}: the key and base nonce, at sequence 2^96 - 2"
    check refused?(late.seal(pt, "late"), "nonces are spent"), "#{label}: sealing at sequence 2^96 - 1 refused"
    late_r = suite.recipient(read_r, sender.enc, info, psk, psk_id, sender_public).as(HpkeRecipient)
    late_r.advance_to(LAST &- 1_u128)
    check opened?(late_r.open(want, "late"), pt), "#{label}: opened at sequence 2^96 - 2"
    check refused?(late_r.open(want, "late"), "nonces are spent"), "#{label}: opening at sequence 2^96 - 1 refused"

    one = suite.seal(public_r, info, "Count-0", pt, ikm_e, psk, psk_id, sender_key)
    check one.is_a?(Tuple) && hex(one[0]) == c["enc"].as_s && hex(one[1]) == listed[0]["ct"].as_s, "#{label}: single-shot seal"
    check opened?(suite.open(read_r, b(c["enc"].as_s), info, "Count-0", b(listed[0]["ct"].as_s), psk, psk_id, sender_public), pt), "#{label}: single-shot open"
  end

  exports = c["exports"].as_a
  exports.each_with_index do |e, k|
    context = b(e["exporter_context"].as_s)
    length = e["L"].as_i
    want = e["exported_value"].as_s
    check hex(sender.export(context, length)) == want, "#{label}: export #{k}"
    check hex(recipient.export(context, length)) == want, "#{label}: export #{k} at the recipient"
    shot = suite.send_export(public_r, info, context, length, ikm_e, psk, psk_id, sender_key)
    check shot.is_a?(Tuple) && hex(shot[0]) == c["enc"].as_s && hex(shot[1]) == want, "#{label}: single-shot export #{k}"
    got = suite.receive_export(read_r, b(c["enc"].as_s), info, context, length, psk, psk_id, sender_public)
    check got.is_a?(Array(UInt8)) && hex(got) == want, "#{label}: single-shot export #{k} received"
  end
  {count, exports.size}
end

def run_vectors(vectors : Any, prefix : String) : Nil
  total = 0
  sealed = 0
  exported = 0
  modes = [0, 0, 0, 0]
  vectors.as_a.each_with_index do |c, n|
    label = "#{prefix} #{n} (#{MODES[c["mode"].as_i]}, kem #{id4(c["kem_id"].as_i)}, kdf #{id4(c["kdf_id"].as_i)}, aead #{id4(c["aead_id"].as_i)})"
    got = run_vector(c, label)
    sealed = sealed + got[0]
    exported = exported + got[1]
    modes[c["mode"].as_i] = modes[c["mode"].as_i] + 1
    total = total + 1
  end
  puts "  #{total} vectors (#{modes[0]} base, #{modes[1]} psk, #{modes[2]} auth, #{modes[3]} auth_psk): #{sealed} encryptions sealed and opened, #{exported} exports"
end

# A context's messages: AAD.PT pairs, comma-joined, hex.
def messages(field : String) : Array({Array(UInt8), Array(UInt8)})
  return [] of {Array(UInt8), Array(UInt8)} if field == "-"
  field.split(',').map do |pair|
    parts = pair.split('.')
    {b(parts[0]), parts.size > 1 ? b(parts[1]) : [] of UInt8}
  end
end

def kem_of(id : String) : HpkeKem
  kem = HpkeKem.from_value?(id.to_i)
  raise "no KEM #{id}" if kem.nil?
  kem
end

def field(s : String) : Array(UInt8) | Nil
  s == "-" ? nil : b(s)
end

def bytes_or_empty(s : String) : Array(UInt8)
  s == "-" ? [] of UInt8 : b(s)
end

def oracle_seal(w : Array(String)) : String
  suite = HpkeSuite.from_ids(w[1].to_i, w[2].to_i, w[3].to_i)
  return "refused: #{suite.message}" if suite.is_a?(HpkeError)
  kem = suite.kem
  public_r = HpkePublicKey.from_bytes(kem, b(w[4]))
  return "refused: #{public_r.message}" if public_r.is_a?(HpkeError)
  sender_key = nil.as(HpkePrivateKey | Nil)
  if w[9] != "-"
    got = HpkePrivateKey.from_bytes(kem, b(w[9]))
    return "refused: #{got.message}" if got.is_a?(HpkeError)
    sender_key = got
  end
  sender = suite.sender(public_r, bytes_or_empty(w[5]), b(w[6]), field(w[7]), field(w[8]), sender_key)
  return "refused: #{sender.message}" if sender.is_a?(HpkeError)
  exported = sender.export(bytes_or_empty(w[10]), w[11].to_i)
  sealed = messages(w[12]).map do |m|
    got = sender.seal(m[1], m[0])
    return "refused: #{got.message}" if got.is_a?(HpkeError)
    hex(got)
  end
  "#{hex(sender.enc)} #{hex(exported)} #{sealed.empty? ? "-" : sealed.join(",")}"
end

def oracle_open(w : Array(String)) : String
  suite = HpkeSuite.from_ids(w[1].to_i, w[2].to_i, w[3].to_i)
  return "refused: #{suite.message}" if suite.is_a?(HpkeError)
  kem = suite.kem
  key = HpkePrivateKey.from_bytes(kem, b(w[4]))
  return "refused: #{key.message}" if key.is_a?(HpkeError)
  sender_public = nil.as(HpkePublicKey | Nil)
  if w[9] != "-"
    got = HpkePublicKey.from_bytes(kem, b(w[9]))
    return "refused: #{got.message}" if got.is_a?(HpkeError)
    sender_public = got
  end
  recipient = suite.recipient(key, b(w[5]), bytes_or_empty(w[6]), field(w[7]), field(w[8]), sender_public)
  return "refused: #{recipient.message}" if recipient.is_a?(HpkeError)
  exported = recipient.export(bytes_or_empty(w[10]), w[11].to_i)
  opened = messages(w[12]).map_with_index do |m, i|
    got = recipient.open(m[1], m[0])
    return "refused: message #{i}: #{got.message}" if got.is_a?(HpkeError)
    got.empty? ? "-" : hex(got)
  end
  "#{hex(exported)} #{opened.empty? ? "-" : opened.join(",")}"
end

args = Program.args

if args.size > 0 && args[0] == "oracle"
  while line = STDIN.gets
    w = line.strip.split(' ')
    next if w.empty? || w[0].empty?
    case w[0]
    when "k"
      key = HpkePrivateKey.derive(kem_of(w[1]), b(w[2]))
      puts "#{hex(key.bytes)} #{hex(key.public_key.bytes)}"
    when "p"
      got = HpkePublicKey.from_bytes(kem_of(w[1]), b(w[2]))
      puts got.is_a?(HpkeError) ? "refused: #{got.message}" : "ok"
    when "s"
      puts oracle_seal(w)
    when "o"
      puts oracle_open(w)
    else
      puts "refused: no such request #{w[0]}"
    end
    STDOUT.flush
  end
  exit 0
end

# The fastest of five runs of 200, in nanoseconds a call.
def best_of(& : -> _) : Int64
  fastest = 0_i64
  5.times do |k|
    t0 = IyiMark.now_ns
    200.times { yield }
    took = (IyiMark.now_ns - t0).to_i64
    fastest = took if k == 0 || took < fastest
  end
  fastest // 200
end

def micro(ns : Int64) : String
  "#{ns // 1000}.#{(ns % 1000) // 100}"
end

if args.size > 0 && args[0] == "cost"
  suite = HpkeSuite.new(HpkeKem::X25519Sha256, HpkeKdf::HkdfSha256, HpkeAead::Aes128Gcm)
  key = HpkePrivateKey.derive(suite.kem, drawn("cost key", 32))
  public = key.public_key
  randomness = drawn("cost randomness", 32)
  message = drawn("cost message", 1024)
  info = "cost info"
  shot = suite.seal(public, info, "", message, randomness).as(Tuple)
  ok = true
  seal_one = best_of { suite.seal(public, info, "", message, randomness) }
  open_one = best_of { ok = ok && opened?(suite.open(key, shot[0], info, "", shot[1]), message) }
  sender = suite.sender(public, info, randomness).as(HpkeSender)
  sealed = Array(String).new(1000) { |_| sender.seal(message).as(String) }
  sender = suite.sender(public, info, randomness).as(HpkeSender)
  seal_ctx = best_of { sender.seal(message) }
  recipients = Array(HpkeRecipient).new(5) { |_| suite.recipient(key, shot[0], info).as(HpkeRecipient) }
  run = -1
  fastest = 0_i64
  5.times do |k|
    r = recipients[k]
    t0 = IyiMark.now_ns
    200.times { |i| ok = ok && opened?(r.open(sealed[i]), message) }
    took = (IyiMark.now_ns - t0).to_i64
    fastest = took if k == 0 || took < fastest
  end
  open_ctx = fastest // 200
  raise "the timed opens did not agree" unless ok
  puts "iyi: #{suite}, a 1 KiB message: single-shot seal #{micro(seal_one)} us, open #{micro(open_one)} us; in a context, seal #{micro(seal_ctx)} us, open #{micro(open_ctx)} us"
  exit 0
end

# Seven of RFC 9180's vectors, cut from
# bench/std_hpke_fixture/rfc9180_vectors.json as the gate cuts them (its
# vectors 0, 3, 9, 12, 18, 34 and 54): every mode, both KEMs, both KDFs,
# every AEAD, export-only among them.
