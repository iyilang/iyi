# Exercises `std/http`.
#
# Run via:
#     ./bin/iyi run bench/std_http_exercise.iyi

module bench/std_http_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/http::{HTTP, Response, Request, Server}
import std/socket::{IyiSocket, SocketError}
import std/gc::{GC}

# The server side of one connection: the request text, headers and the
# body `Content-Length` promises, read until both have arrived.
def read_request(conn : IyiSocket) : String | Cancelled | SocketError
  buf = ""
  while true
    if split = HTTP.find_headers_end(buf)
      need = 0
      HTTP.split_crlf(buf[0, split]).each do |line|
        colon = line.index(':')
        next unless colon
        if HTTP.same_name?(line[0, colon], "Content-Length")
          need = line[colon + 1, line.bytesize - colon - 1].strip.to_i
        end
      end
      break if buf.bytesize - split - 4 >= need
    end
    chunk = conn.read(4096)!
    break if chunk.bytesize == 0
    buf = buf + chunk
  end
  buf
end

# One response off a raw socket: the head, then the body its length
# promises (the server always writes one), without reading past it.
def read_response(c : IyiSocket) : String
  buf = ""
  while true
    if split = HTTP.find_headers_end(buf)
      need = 0
      HTTP.split_crlf(buf[0, split]).each do |line|
        colon = line.index(':')
        next unless colon
        if HTTP.same_name?(line[0, colon], "Content-Length")
          need = line[colon + 1, line.bytesize - colon - 1].strip.to_i
        end
      end
      have = buf.bytesize - split - 4
      return buf if have >= need
    end
    chunk = c.read(4096).or_panic
    raise "the server closed mid-response" if chunk.bytesize == 0
    buf = buf + chunk
  end
end

# The request line: what comes before the first CRLF.
def first_line(req : String) : String
  p = req.to_unsafe
  i = 0
  while i + 1 < req.bytesize
    return req[0, i] if p[i] == 13_u8 && p[i + 1] == 10_u8
    i = i + 1
  end
  req
end

# `text` as chunks of eight bytes, sizes in hexadecimal, a zero chunk last.
def chunked(text : String) : String
  out = ""
  i = 0
  while i < text.bytesize
    n = text.bytesize - i
    n = 8 if n > 8
    out = out + n.to_s + "\r\n" + text[i, n] + "\r\n"
    i = i + n
  end
  out + "0\r\n\r\n"
end

puts "== request"
req = HTTP.format_request("GET", "/", "127.0.0.1")
assert_true req.starts_with?("GET / HTTP/1.1\r\n"), "method line"
assert_true req.includes?("Host: 127.0.0.1\r\n"), "host"
assert_true req.includes?("Connection: close\r\n"), "connection close"
assert_true !req.includes?("Content-Length"), "a GET with no body has no length"
assert_true req.ends_with?("\r\n\r\n"), "an empty body ends the request at the blank line"
puts "  GET request text"

req = HTTP.format_request("POST", "/items", "127.0.0.1:8080", "{\"a\":1}", {"Content-Type" => "application/json", "X-Token" => "abc"})
assert_true req.starts_with?("POST /items HTTP/1.1\r\nHost: 127.0.0.1:8080\r\n"), "host with a port"
assert_true req.includes?("Content-Type: application/json\r\n"), "a caller's header"
assert_true req.includes?("X-Token: abc\r\n"), "a second caller's header"
assert_true req.includes?("Content-Length: 7\r\n"), "the body's length"
assert_true req.ends_with?("\r\n\r\n{\"a\":1}"), "the body after the blank line"
puts "  POST with headers and a body"

req = HTTP.format_request("POST", "/items", "127.0.0.1")
assert_true req.includes?("Content-Length: 0\r\n"), "a POST with nothing to say still says so"
req = HTTP.format_request("DELETE", "/items/1", "127.0.0.1")
assert_true !req.includes?("Content-Length"), "a DELETE with no body has no length"
puts "  Content-Length follows the method and the body"

puts "\n== response"
resp = HTTP.parse_response("HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nhi!\n")
assert_true resp.status == 200, "status"
assert_str "OK", resp.reason, "reason"
assert_str "hi!\n", resp.body, "body"
assert_str "4", resp.headers["Content-Length"], "length header"
assert_true resp.success?, "2xx is success"
puts "  status, headers, body"

resp = HTTP.parse_response("HTTP/1.1 200 OK\r\ncontent-length:  3 \r\nx-kind: lower\r\n\r\nabcdef")
assert_str "abc", resp.body, "a lowercase content-length still bounds the body"
assert_str "3", resp.header("Content-Length") || "", "a header by any case"
assert_str "lower", resp.header("X-KIND") || "", "a header asked for in another case"
assert_true resp.header("X-Missing").nil?, "a header that is not there is nil"
puts "  header names are read without regard to case, and trimmed"

resp = HTTP.parse_response("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n4;ext=1\r\ndefg\r\n0\r\nX-Trailer: t\r\n\r\n")
assert_str "abcdefg", resp.body, "a chunked body arrives joined"
puts "  a chunked body is joined, extensions and trailers dropped"

resp = HTTP.parse_response("HTTP/1.1 200 OK\r\nContent-Length: 99\r\n\r\n", true)
assert_str "", resp.body, "a HEAD answer has the headers of a body it does not carry"
assert_str "99", resp.header("Content-Length") || "", "and the length is still readable"
resp = HTTP.parse_response("HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n")
assert_true resp.status == 204 && resp.body == "", "a 204 has no body whatever the headers say"
resp = HTTP.parse_response("HTTP/1.1 404 Not Found\r\n\r\n")
assert_true !resp.success?, "a 404 is not success"
assert_str "Not Found", resp.reason, "reason with a space"
resp = HTTP.parse_response("HTTP/1.0 500\r\n\r\n")
assert_true resp.status == 500 && resp.reason == "", "a status line with no reason"
puts "  HEAD, 204 and a status with no reason"

# A body short of its Content-Length is a connection that ended early, as
# a chunked body cut inside a chunk is: it was a whole 200 with the part
# that came, a cut-off download read as a good one.
short = "answered"
group do |g|
  cut = g.spawn { HTTP.parse_response("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\npartial"); 0 }
  outcome = cut.value
  short = outcome.is_a?(Panicked) ? outcome.message.to_s : "answered"
  0
end
assert_str "HTTP: the body ended after 7 of its 100 bytes", short, "a short body is refused"
puts "  a body short of its Content-Length is refused"
# A repeated header is one list, in any case; two different lengths are a
# message nobody can read the same way twice, and a length is digits.
cookies = HTTP.parse_response("HTTP/1.1 200 OK\r\nSet-Cookie: a=1\r\nset-cookie: b=2\r\nContent-Length: 2\r\n\r\nok")
assert_str "a=1, b=2", cookies.header("Set-Cookie") || "", "a repeated header keeps every value"
clash = Server.parse_request("POST / HTTP/1.1\r\nContent-Length: 3\r\ncontent-length: 10\r\n\r\nabc")
assert_true clash.request.nil? && (clash.error || "").starts_with?("conflicting Content-Length"), "two different lengths are refused: #{clash.error.inspect}"
signed = Server.parse_request("POST / HTTP/1.1\r\nContent-Length: +3\r\n\r\nabc")
assert_true signed.request.nil? && (signed.error || "").starts_with?("Content-Length is not a number"), "a signed length is refused: #{signed.error.inspect}"
twice = Server.parse_request("POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc")
twice_body = (twice_request = twice.request) ? twice_request.body : "refused"
assert_str "abc", twice_body, "the same length twice is one length"
puts "  a repeated header is one list; two lengths, or a signed one, are refused"

puts "\n== over a socket"
# The server runs on a thread, and a thread's block may capture only what
# is Share (III.4.4): the listener's descriptor is a number, and what the
# server read comes back inside the answer it writes, so nothing mutable
# is shared.
listener = IyiSocket.listen(0)
port = listener.local_port
fd = listener.to_unsafe
server = IyiThread.start do
  l = IyiSocket.new(fd)
  i = 0
  while i < 5
    conn = l.accept.or_panic
    saw = read_request(conn).or_panic
    line = first_line(saw)
    reply = if i == 0
              "HTTP/1.1 200 OK\r\ncontent-length: #{saw.bytesize}\r\n\r\n" + saw
            elsif i == 1
              "HTTP/1.1 201 Created\r\nTransfer-Encoding: chunked\r\n\r\n" + chunked(saw)
            elsif i == 2
              "HTTP/1.1 200 OK\r\nContent-Length: 99\r\nX-Request-Line: #{line}\r\n\r\n"
            elsif i == 3
              "HTTP/1.1 200 OK\r\nContent-Length: #{saw.bytesize}\r\n\r\n" + saw
            else
              has_length = saw.includes?("Content-Length") ? "yes" : "no"
              "HTTP/1.1 204 No Content\r\nX-Request-Line: #{line}\r\nX-Request-Has-Length: #{has_length}\r\n\r\n"
            end
    conn.write(reply)
    conn.close
    i = i + 1
  end
  nil
end

base = "http://127.0.0.1:#{port}"
r = HTTP.get("#{base}/items?x=1").or_panic
assert_true r.status == 200, "GET status"
assert_true r.body.starts_with?("GET /items?x=1 HTTP/1.1\r\n"), "GET line with the query"
assert_true r.body.includes?("Host: 127.0.0.1:#{port}\r\n"), "Host names the port when it is not 80"
assert_true !r.body.includes?("Content-Length"), "GET carried no length"
assert_str r.body.bytesize.to_s, r.header("Content-Length") || "", "GET length by any case"
r = HTTP.post("#{base}/items", "{\"a\":1}", {"Content-Type" => "application/json"}).or_panic
assert_true r.status == 201, "POST status"
assert_true r.body.starts_with?("POST /items HTTP/1.1\r\n"), "POST line, through a chunked answer"
assert_true r.body.includes?("Content-Type: application/json\r\n"), "POST carried the caller's header"
assert_true r.body.includes?("Content-Length: 7\r\n"), "POST carried the body's length"
assert_true r.body.ends_with?("\r\n\r\n{\"a\":1}"), "POST carried the body"
r = HTTP.head("#{base}/items").or_panic
assert_true r.status == 200, "HEAD status"
assert_str "", r.body, "HEAD body"
assert_str "99", r.header("Content-Length") || "", "HEAD length"
assert_str "HEAD /items HTTP/1.1", r.header("X-Request-Line") || "", "HEAD line"
r = HTTP.put("#{base}/items/1", "v=2", {"X-Token" => "abc"}).or_panic
assert_true r.status == 200, "PUT status"
assert_true r.body.starts_with?("PUT /items/1 HTTP/1.1\r\n"), "PUT line"
assert_true r.body.includes?("X-Token: abc\r\n") && r.body.ends_with?("Content-Length: 3\r\n\r\nv=2"), "PUT carried the header and the body"
r = HTTP.delete("#{base}/items/9").or_panic
assert_true r.status == 204 && r.success?, "DELETE status"
assert_str "", r.body, "DELETE body"
assert_str "DELETE /items/9 HTTP/1.1", r.header("X-Request-Line") || "", "DELETE line"
assert_str "no", r.header("X-Request-Has-Length") || "", "DELETE carried no length"
server.join
listener.close
puts "  get, post, head, put, delete: five verbs, five connections, and what the server read is what each wrote"

# An IPv6 literal's Host line keeps the URL's brackets: without them it
# was `Host: ::1:<port>`, which no server can split into host and port.
v6 = IyiSocket.listen("::1", 0)
v6_port = v6.local_port
v6_fd = v6.to_unsafe
v6_server = IyiThread.start do
  l = IyiSocket.new(v6_fd)
  conn = l.accept.or_panic
  saw = read_request(conn).or_panic
  conn.write("HTTP/1.1 200 OK\r\nContent-Length: #{saw.bytesize}\r\n\r\n" + saw)
  conn.close
  nil
end
r = HTTP.get("http://[::1]:#{v6_port}/six").or_panic
assert_true r.body.includes?("Host: [::1]:#{v6_port}\r\n"), "an IPv6 Host keeps its brackets: #{r.body.inspect}"
v6_server.join
v6.close
puts "  an IPv6 literal's Host line keeps its brackets"

puts "\n== the server, from a raw socket"
# What the server does with the wire: keep-alive across requests, a
# chunked request body, HEAD, a request that is not HTTP, and `Connection:
# close`. The client here is a bare socket so every byte is ours.
listener = IyiSocket.listen(0)
sport = listener.local_port
seen_paths = [] of String
group do |g|
  g.spawn do
    Server.serve(listener) do |req|
      seen_paths << req.method + " " + req.path
      if req.path == "/echo"
        Response.new(200, req.body, {"X-Query" => req.query || "-", "X-Agent" => req.header("user-agent") || "-"})
      elsif req.path == "/nothing"
        Response.new(204)
      elsif req.path == "/size"
        Response.new(200, req.body.bytesize.to_s)
      elsif req.path == "/stop"
        listener.close
        Response.new(200, "bye")
      else
        Response.new(404, "no #{req.path}\n")
      end
    end
    0
  end
  g.spawn do
    c = IyiSocket.connect("127.0.0.1", sport).or_panic
    # Two requests on one connection, the second chunked, then a HEAD.
    c.write("POST /echo?a=1 HTTP/1.1\r\nHost: x\r\nUser-Agent: raw\r\nContent-Length: 5\r\n\r\nhello").or_panic
    r1 = HTTP.parse_response(read_response(c))
    assert_true r1.status == 200 && r1.body == "hello", "first request on the connection"
    assert_str "a=1", r1.header("X-Query") || "", "the query reached the block"
    assert_str "raw", r1.header("X-Agent") || "", "a header reached the block by any case"
    assert_str "keep-alive", r1.header("Connection") || "", "HTTP/1.1 keeps the connection"
    c.write("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n").or_panic
    r2 = HTTP.parse_response(read_response(c))
    assert_str "abcde", r2.body, "a chunked request body arrives joined"
    c.write("HEAD /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n").or_panic
    r3 = HTTP.parse_response(read_response(c), true)
    assert_true r3.status == 200 && r3.body == "", "HEAD carries no body"
    c.write("GET /nothing HTTP/1.1\r\nHost: x\r\n\r\n").or_panic
    r4 = HTTP.parse_response(read_response(c))
    assert_true r4.status == 204 && r4.reason == "No Content", "a 204 with the status's own reason"
    c.write("GET /missing HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n").or_panic
    r5 = HTTP.parse_response(read_response(c))
    assert_true r5.status == 404 && r5.body == "no /missing\n", "a 404 from the block"
    assert_str "close", r5.header("Connection") || "", "the server honours Connection: close"
    assert_str "", c.read(16).or_panic, "and closes after it"
    c.close
    # A request that is not HTTP is answered 400 and the connection closed.
    bad = IyiSocket.connect("127.0.0.1", sport).or_panic
    bad.write("this is not http\r\n\r\n").or_panic
    r6 = HTTP.parse_response(read_response(bad))
    assert_true r6.status == 400, "not HTTP is 400"
    assert_true r6.body.starts_with?("not an HTTP/1 request"), "and says why: #{r6.body.inspect}"
    assert_str "", bad.read(16).or_panic, "and the connection is closed"
    bad.close
    # A chunk size that is not one is a 400 too: it was a panic in the
    # server's task, and the client was answered nothing.
    chunky = IyiSocket.connect("127.0.0.1", sport).or_panic
    chunky.write("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nabc\r\n0\r\n\r\n").or_panic
    r6b = HTTP.parse_response(read_response(chunky))
    assert_true r6b.status == 400 && r6b.body.starts_with?("not a chunk size"), "a bad chunk size is 400 and says why: #{r6b.status} #{r6b.body.inspect}"
    chunky.close
    # HTTP/1.0 closes by default.
    old = IyiSocket.connect("127.0.0.1", sport).or_panic
    old.write("GET /nothing HTTP/1.0\r\n\r\n").or_panic
    r7 = HTTP.parse_response(read_response(old))
    assert_true r7.status == 204, "HTTP/1.0 is served"
    assert_str "", old.read(16).or_panic, "and closed after one request"
    old.close
    # The client half of this module against the server half.
    r8 = HTTP.post("http://127.0.0.1:#{sport}/echo?z=9", "via client", {"User-Agent" => "iyi"}).or_panic
    assert_true r8.status == 200 && r8.body == "via client" && r8.header("X-Query") == "z=9", "HTTP.post against Server.serve"
    # A small request on a kept-alive connection costs the server what it
    # reads, not the size of the read it asks for: the socket's read took
    # a heap buffer of the whole 64 KB per call, and the server a 64 KB
    # builder per request, 130 KB of garbage per request and a collection
    # every few dozen of them.
    lean = IyiSocket.connect("127.0.0.1", sport).or_panic
    ask = "GET /nothing HTTP/1.1\r\nHost: x\r\n\r\n"
    lean.write(ask).or_panic
    answer_size = read_response(lean).bytesize
    scratch = Pointer(UInt8).malloc(4096_u64)
    GC.disable
    lean_before = GC.stats.bytes_since_collection
    200.times do
      lean.write(ask).or_panic
      got = 0
      while got < answer_size
        got = got + lean.read(scratch, 4096).or_panic.as(Int32)
      end
    end
    lean_bytes = (GC.stats.bytes_since_collection - lean_before) // 200_u64
    GC.enable
    lean.close
    assert_true lean_bytes < 8192_u64, "a kept-alive request allocates #{lean_bytes} bytes, under 8 KB"
    # A client that asks to be told before it sends its body is told:
    # without the `100 Continue`, curl waits a second before every upload
    # past a megabyte.
    ex = IyiSocket.connect("127.0.0.1", sport).or_panic
    ex.write("POST /echo HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 4\r\n\r\n").or_panic
    told = ex.read(64).or_panic
    assert_str "HTTP/1.1 100 Continue\r\n\r\n", told, "Expect: 100-continue is answered before the body"
    ex.write("body").or_panic
    r11 = HTTP.parse_response(read_response(ex))
    assert_true r11.status == 200 && r11.body == "body", "and the body sent after it arrives"
    ex.close
    # A body of many reads. The server added each read to what came before
    # and parsed it all again - a copy of the body so far per read - and a
    # 20 MB upload took 1.9 s where Go's server takes 30 ms. It reads until
    # the Content-Length is here and parses once.
    upload = "u" * 24000000
    upload_started = __iyi_monotonic_ns
    r10 = HTTP.post("http://127.0.0.1:#{sport}/echo", upload).or_panic
    upload_ms = (__iyi_monotonic_ns - upload_started) // 1000000_i64
    assert_true r10.status == 200 && r10.body == upload, "a 24 MB upload echoed whole (#{r10.body.bytesize} bytes)"
    assert_true upload_ms < 4000, "a 24 MB upload is read, not re-read: it took #{upload_ms} ms"
    # The same for a chunked body, which is decoded as it arrives: it was
    # added to what came before and parsed again after every read, and
    # 16 MB in 64 KB chunks took 8.8 s where this takes a tenth of one.
    framed = String::Builder.new(16900000)
    framed << "POST /size HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n"
    piece = "c" * 65536
    256.times { framed << "10000\r\n" << piece << "\r\n" }
    framed << "0\r\n\r\n"
    chunked_started = __iyi_monotonic_ns
    up = IyiSocket.connect("127.0.0.1", sport).or_panic
    up.write(framed.to_s).or_panic
    r12 = HTTP.parse_response(read_response(up))
    chunked_ms = (__iyi_monotonic_ns - chunked_started) // 1000000_i64
    up.close
    assert_true r12.status == 200 && r12.body == "16777216", "a 16 MB chunked upload arrived whole (#{r12.body} bytes)"
    assert_true chunked_ms < 4000, "a 16 MB chunked upload is decoded as it arrives: it took #{chunked_ms} ms"
    r9 = HTTP.get("http://127.0.0.1:#{sport}/stop").or_panic
    assert_str "bye", r9.body, "the block closed the listener"
    0
  end
end
assert_true seen_paths.size == 212, "the block ran 212 times (the 400 never reached it), not #{seen_paths.size}"
assert_str "POST /echo", seen_paths[0], "the first request's line"
assert_str "HEAD /echo", seen_paths[2], "the HEAD's"
puts "  keep-alive, chunked, HEAD, 204, 404, 400, Connection: close, HTTP/1.0, 201 lean requests, 100-continue, a 24 MB upload, a 16 MB chunked one, and the client against it"

puts "\n== a burst of connections"
# Twenty connections waiting, each with its request written, when the
# server starts: its accept loop takes them one after another without
# waiting, and each must get a task of its own. The tasks held the loop's
# variable and not its value, which the next accept overwrote before they
# ran: connections that came together were read by several tasks - "two
# fibers reading one fd" - and the rest by none, their clients waiting for
# an answer that never came.
burst_listener = IyiSocket.listen(0)
burst_port = burst_listener.local_port
burst = [] of IyiSocket
20.times do |i|
  b = IyiSocket.connect("127.0.0.1", burst_port).or_panic
  b.write("GET /burst?n=#{i} HTTP/1.1\r\nHost: x\r\n\r\n").or_panic
  b.read_timeout_ms = 10000
  burst << b
end
group do |g|
  g.spawn do
    Server.serve(burst_listener) { |req| Response.new(200, req.query || "-") }
    0
  end
  g.spawn do
    burst.each_with_index do |b, i|
      rb = HTTP.parse_response(read_response(b))
      assert_str "n=#{i}", rb.body, "connection #{i} of a burst answered its own request"
      b.close
    end
    burst_listener.close
    0
  end
end
puts "  twenty connections that arrived together, each answered its own request"

puts "\nALL CHECKS PASSED"
