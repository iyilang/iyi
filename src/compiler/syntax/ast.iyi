    end
  end

  def ==(other : self) : Bool
    @whens == other.whens && @else == other.else
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    31 &* (31 &* 17 &+ @whens.hash) &+ hash_val(@else)
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "select
"
    @whens.each do |w|
      w.to_s(sb)
      sb << "
"
    end
    if e = @else
      sb << "else
  "
      e.to_s(sb)
      sb << "
"
    end
    sb << "end"
  end
end

pub class Rescue < ASTNode
  property body : ASTNode
  property types : Array(ASTNode)?
  property name : String?

  def initialize(body : ASTNode? = nil, @types : Array(ASTNode)? = nil, @name : String? = nil)
    @body = body || Nop.new
  end

  def clone_without_location : self
    cloned_types = clone_opt_nodes(@types)
    Rescue.new(@body.clone, cloned_types, @name)
  end

  def accept_children(visitor) : Nil
    if t = @types
      t.each { |ty| ty.accept(visitor) }
    end
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    (@body == other.body) && (@types == other.types) && (@name == other.name)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@body)
    h = 31 &* h &+ hash_val(@types)
    h = 31 &* h &+ hash_val(@name)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "rescue "
    if n = @name
      sb << n << " : "
    end
    if t = @types
      i = 0
      while i < t.size
        sb << " | " if i > 0
        t[i].to_s(sb)
        i = i + 1
      end
    end
    sb << "
  "
    @body.to_s(sb)
  end
end

pub class ExceptionHandler < ASTNode
  property body : ASTNode
  property rescues : Array(Rescue)?
  property else : ASTNode?
  property ensure : ASTNode?
  property suffix : Bool

  def initialize(body : ASTNode? = nil, @rescues : Array(Rescue)? = nil, @else : ASTNode? = nil, @ensure : ASTNode? = nil, @suffix : Bool = false)
    @body = body || Nop.new
  end

  def clone_without_location : self
    if r = @rescues
      cloned_rescues = r.map { |x| x.clone.as(Rescue) }
    else
      cloned_rescues = nil
    end
    ExceptionHandler.new(@body.clone, cloned_rescues, clone_node(@else), clone_node(@ensure), @suffix)
  end

  def accept_children(visitor) : Nil
    @body.accept(visitor)
    if r = @rescues
      r.each { |x| x.accept(visitor) }
    end
    if e = @else
      e.accept(visitor)
    end
    if ens = @ensure
      ens.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    @body == other.body && @rescues == other.rescues && @else == other.else && @ensure == other.ensure && @suffix == other.suffix
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @body.hash
    h = 31 &* h &+ hash_val(@rescues)
    h = 31 &* h &+ hash_val(@else)
    h = 31 &* h &+ hash_val(@ensure)
    h = 31 &* h &+ (@suffix ? 1 : 0)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "begin
  "
    @body.to_s(sb)
    sb << "
"
    if r = @rescues
      r.each do |res|
        res.to_s(sb)
        sb << "
"
      end
    end
    if el = @else
      sb << "else
  "
      el.to_s(sb)
      sb << "
"
    end
    if ens = @ensure
      sb << "ensure
  "
      ens.to_s(sb)
      sb << "
"
    end
    sb << "end"
  end
end

