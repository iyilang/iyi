# Exercises `std/regex`.
#
# Run via:
#     ./bin/iyi run bench/std_regex_exercise.iyi

module bench/std_regex_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/regex::{Regex}

# The pieces of `line` between bytes equal to `sep`; an empty line is one
# empty piece, which is what a one-element list reads as.
def fields(line : String, sep : UInt8) : Array(String)
  out = [] of String
  p = line.to_unsafe
  start = 0
  i = 0
  while i < line.bytesize
    if p[i] == sep
      out << line[start, i - start]
      start = i + 1
    end
    i = i + 1
  end
  out << line[start, line.bytesize - start]
  out
end

# A newline travels through the fixture as byte 29, one record per line.
def unescape(s : String) : String
  p = s.to_unsafe
  String.new(s.bytesize) do |dst|
    i = 0
    while i < s.bytesize
      dst[i] = p[i] == 29_u8 ? 10_u8 : p[i]
      i = i + 1
    end
  end
end

def unescape(list : Array(String)) : Array(String)
  out = [] of String
  list.each { |s| out << unescape(s) }
  out
end

puts "== match"
rx = Regex.compile("a+")
assert_true rx.match?("aaa"), "whole"
assert_true !rx.match?("baa"), "not whole"
assert_str "aaa", rx.find("xxaaayy") || "", "find"
assert_true rx.scan("a1aa2aaa").size == 3, "scan three"
assert_true Regex.compile(",").split("a,b,c").size == 3, "split"
assert_str "xoy", Regex.compile("a+").replace("xaaay", "o"), "replace"
assert_str "dog", Regex.compile("cat|dog").find("the dog") || "", "alt"
assert_str "12", Regex.compile("[0-9]+").find("ab12cd") || "", "class"
assert_true Regex.compile("^ab").match?("ab"), "anchor yes"
assert_true (Regex.compile("^ab").find("xab") || "") == "", "anchor no"
assert_true Regex.compile("a*").match?(""), "star empty"
assert_true Regex.compile("a.c").match?("abc"), "dot"
assert_str "12", Regex.compile("\\d+").find("ab12cd") || "", "digits"
assert_str "hi", Regex.compile("\\w+").find("!hi!") || "", "word"
assert_true Regex.compile("^a$").match?("a"), "exact a"
assert_true !Regex.compile("^a$").match?("aa"), "not aa"
puts "  NFA: find, scan, split, class, anchors"

puts "\n== leftmost-first"
assert_str "a", Regex.compile("a|ab").find("ab") || "", "the first alternative wins, not the longest"
assert_str "Xb", Regex.compile("a|ab").replace("ab", "X"), "and replace agrees"
assert_str "ab", Regex.compile("ab|a").find("ab") || "", "unless it is written second"
assert_str "aaa", Regex.compile("a*").find("aaa") || "", "greedy takes all"
assert_str "", Regex.compile("a*?").find("aaa") || "", "lazy takes none"
assert_str "aaab", Regex.compile("a+?b").find("aaab") || "", "lazy still reaches the b"
assert_str "aa", Regex.compile("a{2,3}?").find("aaa") || "", "a lazy count takes the minimum"
# A loop whose body matched empty ends there, the empty branch keeping its
# place: pcre2, Python and Go all answer the empty match.
assert_str "", Regex.compile("(|a)*").find("aa") || "nil", "a star whose body matched empty stops"
assert_str "ab", Regex.compile("(?:\\S*|\\s){2,}").find("ab\ncd") || "", "and so does a count's loop"
# RE2's `x{n,}` is n - 1 copies and `x+`, so `x{1,}` answers as `x+` does.
assert_str Regex.compile("(?:\\S*|\\s)+").find("ab\ncd") || "", Regex.compile("(?:\\S*|\\s){1,}").find("ab\ncd") || "", "x{1,} is x+"
puts "  a|ab answers a; greedy and lazy quantifiers; a loop around an empty match"

puts "\n== an empty match costs no text"
assert_true Regex.compile("x*").split("abc") == ["", "a", "b", "c", ""], "split on x* keeps every byte"
assert_str "-a-b-c-", Regex.compile("x*").replace("abc", "-"), "replace x* writes between bytes"
assert_str "!ab", Regex.compile("^").replace("ab", "!"), "^ replaces at the front only"
assert_true Regex.compile("b*").split("abc") == ["", "a", "", "c", ""], "an empty match after a full one"
assert_str "-a--c-", Regex.compile("b*").replace("abc", "-"), "and replace sees both"
assert_true Regex.compile("x*").scan("axb") == ["", "x", "", ""], "scan lists the empty matches too"
puts "  split, replace and scan over x* and b*"

puts "\n== the syntax the header lists"
assert_str "foo", Regex.compile("\\bfoo\\b").find("a foo b") || "", "word boundary"
assert_true Regex.compile("\\bfoo\\b").find("bfoob").nil?, "no boundary inside a word"
assert_str "b", Regex.compile("\\Bb").find("ab b") || "", "not a boundary"
assert_str "aa", Regex.compile("a{2}").find("aaa") || "", "a{2}"
assert_true Regex.compile("a{2}").find("a{2}").nil?, "a{2} is not the text a{2}"
assert_str "aaaa", Regex.compile("a{2,}").find("aaaa") || "", "a{2,}"
assert_str "aaa", Regex.compile("a{1,3}").find("aaaaa") || "", "a{1,3}"
assert_str "b", Regex.compile("a{0}b").find("aab") || "", "a{0}"
assert_str "a{", Regex.compile("a{").find("a{") || "", "a { that is not a count is itself"
assert_str "A", Regex.compile("\\x41").find("A") || "", "\\x41"
assert_str "hello", Regex.compile("[\\w]+").find("hello world") || "", "\\w inside a class"
assert_str "123", Regex.compile("[\\d]+").find("ab123") || "", "\\d inside a class"
assert_str "  ", Regex.compile("[\\s]+").find("a  b") || "", "\\s inside a class"
assert_str "d", Regex.compile("[^a-c\\s]+").find("abc d\tefg") || "", "a negated class with \\s"
assert_str "-a", Regex.compile("[a\\-z]+").find("x-a") || "", "an escaped dash"
assert_str "abab", Regex.compile("(?:ab)+").find("xababy") || "", "a non-capturing group"
assert_str "abab", Regex.compile("(?<pair>ab)+").find("xababy") || "", "a named group"
assert_str "", Regex.compile("").find("abc") || "", "the empty pattern matches nothing at all"
assert_true Regex.compile("()").split("ab") == ["", "a", "b", ""], "an empty group"
assert_str "", Regex.compile("a|").find("b") || "", "an empty alternative"
assert_str "a", Regex.compile("a\\z").find("ba") || "", "\\z"
assert_str "a", Regex.compile("\\Aa").find("ab") || "", "\\A"
assert_str "é", Regex.compile("é").find("café") || "", "a literal past ASCII matches its own bytes"
assert_true Regex.compile("[0-\\x34]").find("x").nil?, "a range ending in an escape, on the fast path"
assert_true !Regex.compile("[0-\\x34]").match?("A"), "and it stops at its end"
assert_str "\n", Regex.compile("\\012").find("a\nb") || "", "\\0 takes up to two more octal digits"
assert_str "a_b", Regex.compile("a\\_b").find("xa_b") || "", "\\_ is the underscore"
puts "  \\b \\B \\A \\z \\xHH \\0oo \\_, counts, classes with \\d \\w \\s, groups, empties"

puts "\n== linear time"
long = "a" * 1000000
assert_true Regex.compile("(a|b)*c").find(long).nil?, "a million bytes with no c"
assert_true Regex.compile("a*c").find(long).nil?, "and again with a*c"
assert_str long, Regex.compile("\\w+").find(long) || "", "a million-byte word"
assert_true Regex.compile("(a*)*b").scan(long + "b").size == 1, "nested stars over a million bytes"
puts "  a million bytes, four patterns, one pass each"

# The closure of a state was walked by recursion, a frame per split, and
# an alternation chains a split per word: searched in a task, whose stack
# is 256 KiB, 890 words overflowed it in a plain build (1,700 with
# --release) and the panic ended the process; on the main stack, 35,000
# did (66,000).
puts "\n== a long alternation, in a task and on the main stack"

def words(n : Int32) : String
  String.build do |io|
    i = 0
    while i < n
      io << "|" if i > 0
      io << "w" << i
      i = i + 1
    end
  end
end

in_task = ""
group do |g|
  attempt = g.spawn do
    first = Regex.compile("(?:#{words(5000)})").find("x w71 y") || "nil"
    bounded = Regex.compile("\\b(?:#{words(5000)})\\b").find("x w71 y") || "nil"
    "#{first} #{bounded}"
  end
  outcome = attempt.value
  in_task = outcome.is_a?(Panicked) ? outcome.message.to_s : outcome
  0
end
assert_str "w7 w71", in_task, "5,000 words in a task: the first written wins, and \\b holds it to a word"
assert_str "w69999", Regex.compile("\\b(?:#{words(70000)})\\b").find("x w69999 y") || "", "70,000 words on the main stack"
puts "  5,000 words in a task, leftmost-first, and 70,000 on the main stack"

args = Program.args
if args.size > 0
  puts "\n== against Python's re"
  text = File.read(args[0])
  lines = [] of String
  start = 0
  i = 0
  p = text.to_unsafe
  while i < text.bytesize
    if p[i] == 10_u8
      lines << text[start, i - start]
      start = i + 1
    end
    i = i + 1
  end
  cases = 0
  lines.each do |line|
    f = fields(line, 30_u8)
    next unless f.size == 6
    rx = Regex.compile(unescape(f[0]))
    subject = unescape(f[1])
    label = "/#{f[0]}/ on #{subject.inspect}"
    found = rx.find(subject)
    assert_str unescape(f[2]), found.nil? ? "<nil>" : found, "#{label}: find"
    want_scan = f[3] == "<none>" ? [] of String : unescape(fields(f[3], 31_u8))
    assert_true rx.scan(subject) == want_scan, "#{label}: scan #{rx.scan(subject).inspect} vs #{want_scan.inspect}"
    want_split = unescape(fields(f[4], 31_u8))
    assert_true rx.split(subject) == want_split, "#{label}: split #{rx.split(subject).inspect} vs #{want_split.inspect}"
    assert_str unescape(f[5]), rx.replace(subject, "<>"), "#{label}: replace"
    cases = cases + 1
  end
  assert_true cases > 2000, "the fixture had #{cases} cases"
  puts "  #{cases} pattern/subject pairs: find, scan, split and replace agree"
end

# What compiling *pattern* in a task is refused with, or "compiled".
def refusal(pattern : String) : String
  said = "compiled"
  group do |g|
    attempt = g.spawn { Regex.compile(pattern).find("") || "" }
    outcome = attempt.value
    said = outcome.message.to_s if outcome.is_a?(Panicked)
    0
  end
  said
end

# A group is five frames of the parser, and a task's stack is 256 KiB:
# under a cap of 1000, a task compiling 213 nested groups in a plain build
# overflowed it and the panic ended the process. The deepest nesting the
# cap allows, alternatives and counts among it, compiles in a task.
puts "\n== the deepest nesting, compiled in a task"
deepest = ""
group do |g|
  attempt = g.spawn { Regex.compile("(?:b|" * 100 + "a" + "){1}" * 10 + ")" * 90).find("xay") || "nil" }
  outcome = attempt.value
  deepest = outcome.is_a?(Panicked) ? outcome.message.to_s : outcome
  0
end
assert_str "a", deepest, "100 nested groups compile in a task"
too_deep = refusal("(" * 101 + "a" + ")" * 101)
assert_true too_deep.includes?("regex: groups nested past 100"), "101 are refused, not #{too_deep.inspect}"
puts "  100 nested groups compile in a task, and 101 are refused"

puts "\n== the text side"
bd = Regex.compile("B|D")
assert_str("a(x)c(x)e", "aBcDe".gsub(bd, "(x)"), "String#gsub with a pattern")
assert_str("abcde", "aBcDe".gsub(bd) { |m| m.downcase }, "String#gsub with a block")
assert_str("a(c|g)ce", "aBcDe".gsub(bd, {"B" => "(c|g)"}), "String#gsub with a table drops a match it has no entry for")
assert_str("x-yb-z", Regex.compile("a+").replace("xaaybaz", "-"), "replace")
assert_str("x2yb1z", Regex.compile("a+").replace("xaaybaz") { |m| m.size.to_s }, "replace with a block")
assert_true "aBc".matches?(bd), "matches? finds a pattern inside the text"
assert_true !"abc".matches?(bd), "matches? without one"
puts "  gsub, replace with a block and matches? hold"

# The literal is `Regex.compile` of its text, compiled once for the program:
# `/x/` in a loop is one constant, not a compile per pass.
puts "\n== a regex literal"
assert_true /a+b/.match?("aab"), "a literal matches as Regex.compile does"
assert_true !/a+b/.match?("aabc"), "and refuses as it does"
assert_true /b[0-9]+/.scan("ab1 ab22 x") == ["b1", "b22"], "scan through a literal"
assert_str "a/b", /a\/b/.find("xa/by") || "", "an escaped slash is the slash"
assert_str "1.25", /\d+\.\d+/.find("v 1.25 x") || "", "an escape reaches the engine as written"
assert_true /\n/.scan("a\nb\n").size == 2, "a line break"
seen = 0
3.times { seen = seen + /x/.scan("xx").size }
assert_true seen == 6, "a literal in a loop"
pat = "c+"
assert_str "ccd", /#{pat}d/.find("xccd") || "", "an interpolated literal"
assert_str "[cgt]gggtaaa|tttaccc[acg]", /[cgt]gggtaaa|tttaccc[acg]/.source, "a literal answers its source"
assert_str "c+d", /#{pat}d/.source, "and an interpolated one the text it was compiled from"
puts "  match, scan, escapes, a loop, an interpolation and the source"

# Refused for what they are: `(?P=n)` was "not a group name", `\k<n>` an
# "unknown escape", and `(?1)` and `(?#..)` "inline flags".
puts "\n== a refusal names its reason"
["(?P=n)", "(?<n>a)\\k<n>", "(?<n>a)\\k{n}", "(?<n>a)\\k'n'", "(a)\\g<1>", "(a)\\g{1}", "(a)\\g1"].each do |pattern|
  said = refusal(pattern)
  assert_true said.includes?("regex: backreferences are refused"), "/#{pattern}/ is a backreference, not #{said.inspect}"
end
["(?1)", "(?+1)", "(?-1)", "(?&n)", "(?P>n)", "(?R)"].each do |pattern|
  said = refusal(pattern)
  assert_true said.includes?("regex: recursion is refused"), "/#{pattern}/ is recursion, not #{said.inspect}"
end
comment = refusal("a(?#note)")
assert_true comment.includes?("regex: comments are refused"), "(?#note) is a comment, not #{comment.inspect}"
assert_true refusal("(?-i)a").includes?("regex: inline flags are refused"), "(?-i) is still a flag"
assert_true refusal("\\kx").includes?("regex: unknown escape '\\k'"), "and \\k alone an unknown escape"
puts "  backreferences, recursion and comments, each by name"

# RE2's ASCII classes, by name inside a class. Read as bytes,
# `[[:digit:]]+` found ":]]" in "[[:digit:]]x 5".
puts "\n== POSIX classes"

def bytes(lo : Int32, hi : Int32) : String
  String.new(hi - lo + 1) do |dst|
    c = lo
    while c <= hi
      dst[c - lo] = c.to_u8
      c = c + 1
    end
  end
end

ascii = bytes(0, 127)
upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
lower = "abcdefghijklmnopqrstuvwxyz"
{
  "alnum" => "0123456789" + upper + lower, "alpha" => upper + lower, "ascii" => ascii,
  "blank" => "\t ", "cntrl" => bytes(0, 31) + bytes(127, 127), "digit" => "0123456789",
  "graph" => bytes(33, 126), "lower" => lower, "print" => bytes(32, 126),
  "punct" => "!\"\#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", "space" => bytes(9, 13) + " ",
  "upper" => upper, "word" => "0123456789" + upper + "_" + lower,
  "xdigit" => "0123456789ABCDEFabcdef",
}.each do |name, members|
  assert_str members, Regex.compile("[[:#{name}:]]").scan(ascii).join, "[:#{name}:] over ASCII"
  assert_true Regex.compile("[[:^#{name}:]]").scan(ascii).join.bytesize == 128 - members.bytesize, "[:^#{name}:] is the rest"
end
assert_str "5", Regex.compile("[[:digit:]]+").find("[[:digit:]]x 5") || "", "[[:digit:]] is a digit"
assert_str "12-3", Regex.compile("[[:digit:]-]+").find("ab12-3c") || "", "a class beside a byte"
assert_str "é", Regex.compile("[[:^ascii:]]+").find("café") || "", "a negation takes the bytes past ASCII, as \\D does"
assert_str "[:a", Regex.compile("[[:a]+").find("x[:a") || "", "a [: with no :] is the byte ["
unknown = refusal("[[:foo:]]")
assert_true unknown.includes?("regex: unknown class '[:foo:]'"), "a name RE2 does not have is refused, not #{unknown.inspect}"
puts "  the 14 classes RE2 names and their negations"

puts "\nALL CHECKS PASSED"
