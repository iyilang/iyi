  ] of UInt64

  def self.pow(base : Float64, exp : Float64) : Float64
    ix = IyiFloatText.bits_of(base)
    iy = IyiFloatText.bits_of(exp)
    topx = ix.unsafe_shr(52_u64).to_i64
    topy = iy.unsafe_shr(52_u64).to_i64
    sign_bias = 0_u64
    ytop = topy & 0x7ff_i64
    if topx == 0_i64 || topx >= 0x7ff_i64 || ytop < 0x3be_i64 || ytop >= 0x43e_i64
      # x subnormal, zero, infinite, NaN or negative; or |y| < 2^-65,
      # |y| >= 2^63 or y NaN.
      if pow_zero_inf_nan?(iy)
        return 1.0 if iy &* 2_u64 == 0_u64
        return 1.0 if ix == 0x3ff0000000000000_u64
        return base + exp if ix &* 2_u64 > 0xffe0000000000000_u64 || iy &* 2_u64 > 0xffe0000000000000_u64
        return 1.0 if ix &* 2_u64 == 0x7fe0000000000000_u64
        return 0.0 if (ix &* 2_u64 < 0x7fe0000000000000_u64) == (iy.unsafe_shr(63_u64) == 0_u64)
        return exp * exp
      end
      if pow_zero_inf_nan?(ix)
        x2 = base * base
        x2 = x2 * -1.0 if ix.unsafe_shr(63_u64) != 0_u64 && pow_check_int(iy) == 1
        return iy.unsafe_shr(63_u64) != 0_u64 ? 1.0 / x2 : x2
      end
      # Finite, nonzero x and y from here.
      if ix.unsafe_shr(63_u64) != 0_u64
        yint = pow_check_int(iy)
        return (base - base) / (base - base) if yint == 0
        sign_bias = 0x40000_u64 if yint == 1
        ix = ix & 0x7fffffffffffffff_u64
        topx = topx & 0x7ff_i64
      end
      if ytop < 0x3be_i64 || ytop >= 0x43e_i64
        return 1.0 if ix == 0x3ff0000000000000_u64
        if ytop < 0x3be_i64
          # |y| < 2^-65: x^y ~= 1 + y log(x).
          return ix > 0x3ff0000000000000_u64 ? 1.0 + exp : 1.0 - exp
        end
        return (ix > 0x3ff0000000000000_u64) == (topy < 0x800_i64) ? 1.0 / 0.0 : 0.0
      end
      if topx == 0_i64
        # A subnormal x, normalised so that its exponent is negative.
        ix = IyiFloatText.bits_of(base * 4503599627370496.0) & 0x7fffffffffffffff_u64
        ix = ix &- 0x0340000000000000_u64
      end
    end
    hi, lo = pow_log(ix)
    yhi = IyiFloatText.from_bits(iy & 0xfffffffff8000000_u64)
    ylo = exp - yhi
    lhi = IyiFloatText.from_bits(IyiFloatText.bits_of(hi) & 0xfffffffff8000000_u64)
    llo = hi - lhi + lo
    ehi = yhi * lhi
    elo = ylo * lhi + exp * llo
    pow_exp(ehi, elo, sign_bias)
  end

  # 0, an infinity or NaN, from the bits: 2i - 1 wraps for either zero.
  private def self.pow_zero_inf_nan?(i : UInt64) : Bool
    (i &* 2_u64) &- 1_u64 >= 0xffe0000000000000_u64 &- 1_u64
  end

  # 0 when the finite, nonzero y is not an integer, 1 when it is odd, 2
  # when it is even.
  private def self.pow_check_int(iy : UInt64) : Int32
    e = (iy.unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    return 0 if e < 0x3ff_i64
    return 2 if e > 0x3ff_i64 + 52_i64
    bit = 1_u64.unsafe_shl((0x3ff_i64 + 52_i64 - e).to_u64)
    return 0 if iy & (bit &- 1_u64) != 0_u64
    return 1 if iy & bit != 0_u64
    2
  end

  # log(x) for the bits `ix` of a positive normal x (or a subnormal one
  # normalised with its exponent below zero), as a double and a tail with
  # about 15 more bits.
  private def self.pow_log(ix : UInt64) : {Float64, Float64}
    tmp = ix &- 0x3fe6955500000000_u64
    i = (tmp.unsafe_shr(45_u64) & 127_u64).to_i32
    k = tmp.unsafe_to_i64 >> 52
    iz = ix &- (tmp & 0xfff0000000000000_u64)
    z = IyiFloatText.from_bits(iz)
    kd = k.to_f64
    table = POW_LOG_TAB.to_unsafe
    invc = IyiFloatText.from_bits(table[i * 3])
    logc = IyiFloatText.from_bits(table[i * 3 + 1])
    logctail = IyiFloatText.from_bits(table[i * 3 + 2])
    # z split so that rhi, rlo and rhi * rhi are exact.
    zhi = IyiFloatText.from_bits((iz &+ 0x80000000_u64) & 0xffffffff00000000_u64)
    zlo = z - zhi
    rhi = zhi * invc - 1.0
    rlo = zlo * invc
    r = rhi + rlo
    t1 = kd * POW_LN2HI + logc
    t2 = t1 + r
    lo1 = kd * POW_LN2LO + logctail
    lo2 = t1 - t2 + r
    ar = POW_A0 * r
    ar2 = r * ar
    ar3 = r * ar2
    arhi = POW_A0 * rhi
    arhi2 = rhi * arhi
    hi = t2 + arhi2
    lo3 = rlo * (ar + arhi)
    lo4 = t2 - hi + arhi2
    p = ar3 * (POW_A1 + r * POW_A2 + ar2 * (POW_A3 + r * POW_A4 + ar2 * (POW_A5 + r * POW_A6)))
    lo = lo1 + lo2 + lo3 + lo4 + p
    y = hi + lo
    {y, hi - y + lo}
  end

  # sign * exp(x + tail), `exp` with the tail folded in and the sign
  # carried in the scale's bits.
  private def self.pow_exp(x : Float64, tail_in : Float64, sign_bias : UInt64) : Float64
    abstop = (IyiFloatText.bits_of(x).unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    if abstop < 0x3c9_i64 || abstop >= 0x408_i64
      if abstop < 0x3c9_i64
        one = 1.0 + x
        return sign_bias != 0_u64 ? one * -1.0 : one
      end
      if abstop >= 0x409_i64
        negative = sign_bias != 0_u64
        if IyiFloatText.bits_of(x).unsafe_shr(63_u64) != 0_u64
          return negative ? -0.0 : 0.0
        end
        return negative ? (1.0 / 0.0) * -1.0 : 1.0 / 0.0
      end
      abstop = 0_i64
    end
    z = EXP_INVLN2N * x
    kd = z + EXP_SHIFT
    ki = IyiFloatText.bits_of(kd)
    kd = kd - EXP_SHIFT
    r = x + kd * EXP_NEGLN2HI + kd * EXP_NEGLN2LO
    r = r + tail_in
    table = EXP_TAB.to_unsafe
    idx = ((ki & 127_u64) &* 2_u64).to_i32
    top = (ki &+ sign_bias).unsafe_shl(45_u64)
    tail = IyiFloatText.from_bits(table[idx])
    sbits = table[idx + 1] &+ top
    r2 = r * r
    tmp = tail + r + r2 * (EXP_C2 + r * EXP_C3) + r2 * r2 * (EXP_C4 + r * EXP_C5)
    return pow_special(tmp, sbits, ki) if abstop == 0_i64
    scale = IyiFloatText.from_bits(sbits)
    scale + scale * tmp
  end

  # `exp_special` for pow: the scale may be negative, and a zero keeps its
  # sign.
  private def self.pow_special(tmp : Float64, sbits : UInt64, ki : UInt64) : Float64
    if ki & 0x80000000_u64 == 0_u64
      scale = IyiFloatText.from_bits(sbits &- 0x3f10000000000000_u64)
      return (scale + scale * tmp) * 5.486124068793689e+303
    end
    sbits = sbits &+ 0x3fe0000000000000_u64
    scale = IyiFloatText.from_bits(sbits)
    y = scale + scale * tmp
    if y.abs < 1.0
      one = y < 0.0 ? -1.0 : 1.0
      lo = scale - y + scale * tmp
      hi = one + y
      lo = one - hi + y + lo
      y = (hi + lo) - one
      y = IyiFloatText.from_bits(sbits & 0x8000000000000000_u64) if y == 0.0
    end
    2.2250738585072014e-308 * y
  end

  def self.pow(base : Float32, exp : Float32) : Float32
    pow(base.to_f64, exp.to_f64).to_f32
  end

  def self.pow(base : T, exp : U) : Float64 forall T, U
    pow(base.to_f64, exp.to_f64)
  end

  def self.copysign(mag : Float64, sgn : Float64) : Float64
    LibLLVMMath.copysign_f64(mag, sgn)
  end

  def self.copysign(mag : Float32, sgn : Float32) : Float32
    LibLLVMMath.copysign_f32(mag, sgn)
  end

  # a * b + c rounded once, as IEEE 754 defines it and as the other
  # library's `Math.fma` answers through libm. The instruction where the
  # processor has one: every aarch64 processor (`fmadd`, LLVM's intrinsic),
  # and an x86_64 one with FMA3 and an operating system that saves its
  # registers, asked once by `cpuid` and `xgetbv` as `Float64#floor` asks
  # for `roundsd`. Elsewhere musl's `fma` (MIT; Copyright 2005-2020 Rich
  # Felker, et al.), in iyi: the significands as integers, their product's
  # 128 bits exact, the sum aligned with a sticky bit, one rounding at the
  # conversion back. This was Dekker's product and two more additions,
  # which round each, and answered the neighbour of the fused result for
  # arguments that cancel.
  def self.fma(a : Float64, b : Float64, c : Float64) : Float64
    {% if flag?(:aarch64) %}
      LibLLVMMath.fma_f64(a, b, c)
    {% else %}
      {% if flag?(:x86_64) %}
        return IyiRounding.fma(a, b, c) if IyiRounding.fuses?
      {% end %}
      soft_fma(a, b, c)
    {% end %}
  end

  # The single's: the instruction where there is one, and otherwise
  # musl's `fmaf` - the product of two singles is exact in a double and
  # the sum rounds once there, which is right unless that double sits on
  # a single's halfway point or among the subnormals; then the sum's
  # rounding error, which is exact, sends it to the odd neighbour, which
  # the conversion to a single cannot then misround.
  def self.fma(a : Float32, b : Float32, c : Float32) : Float32
    {% if flag?(:aarch64) %}
      LibLLVMMath.fma_f32(a, b, c)
    {% else %}
      {% if flag?(:x86_64) %}
        return IyiRounding.fma(a, b, c) if IyiRounding.fuses?
      {% end %}
      soft_fmaf(a, b, c)
    {% end %}
  end

  def self.fma(a : T, b : U, c : V) : Float64 forall T, U, V
    fma(a.to_f64, b.to_f64, c.to_f64)
  end

  # An exponent that stands for zero, an infinity or NaN once `fma_parts`
  # has taken the bias and the significand's width off it.
  private FMA_SPECIAL = 0x7ff - 0x3ff - 52 - 1

  # musl's `normalize`: the significand with its hidden bit, shifted left
  # one so the product has room, the exponent that goes with it, and the
  # sign. A subnormal is scaled into the normal range first; a zero comes
  # out one past FMA_SPECIAL, an infinity or NaN at it.
  private def self.fma_parts(x : Float64) : {UInt64, Int32, Bool}
    ix = IyiFloatText.bits_of(x)
    e = ix.unsafe_shr(52_u64).unsafe_to_i32
    sign = e & 0x800 != 0
    e = e & 0x7ff
    if e == 0
      ix = IyiFloatText.bits_of(x * 9223372036854775808.0)
      e = (ix.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
      e = e != 0 ? e - 63 : 0x800
    end
    ix = ((ix & 0xfffffffffffff_u64) | 0x10000000000000_u64).unsafe_shl(1_u64)
    {ix, e - (0x3ff + 52 + 1), sign}
  end

  # The 128-bit product of two significands of 54 bits, as its high and
  # low words, from 32-bit halves: the middle sum cannot carry out.
  private def self.fma_wide(x : UInt64, y : UInt64) : {UInt64, UInt64}
    xlo = x & 0xffffffff_u64
    xhi = x.unsafe_shr(32_u64)
    ylo = y & 0xffffffff_u64
    yhi = y.unsafe_shr(32_u64)
    t1 = xlo &* ylo
    t2 = xlo &* yhi &+ xhi &* ylo
    t3 = xhi &* yhi
    lo = t1 &+ t2.unsafe_shl(32_u64)
    {t3 &+ t2.unsafe_shr(32_u64) &+ (t1 > lo ? 1_u64 : 0_u64), lo}
  end

  # Whether any of the bits a shift would drop is set: the sticky bit.
  private def self.fma_sticky(bits : UInt64) : UInt64
    bits != 0_u64 ? 1_u64 : 0_u64
  end

  # The software arm's common case, Boldo and Melquiond's emulation (2008):
  # the product exactly as ph + pl by Veltkamp's split and Dekker's
  # product, z added to ph exactly as th + tl, tl + pl rounded to odd -
  # the neighbour whose last bit is set, when the sum is inexact - and one
  # rounding to nearest of th and that. Their theorem makes it the fused
  # result when nothing underflows or overflows, so it is taken only with
  # every exponent well inside the range and a result that is not tiny or
  # zero; everything else is musl's, below. Three to four times as fast as musl's
  # on the processor without FMA, where CORE-MATH's functions make a
  # dozen calls apiece.
  private def self.soft_fma(x : Float64, y : Float64, z : Float64) : Float64
    ex = (IyiFloatText.bits_of(x).unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
    ey = (IyiFloatText.bits_of(y).unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
    ez = (IyiFloatText.bits_of(z).unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
    # |x|, |y| in (2^-900, 2^500), |z| in (2^-900, 2^900), |x y| past 2^-900.
    if ex > 123 && ex < 1523 && ey > 123 && ey < 1523 && ez > 123 && ez < 1923 && ex + ey > 2046 - 900
      ph = x * y
      tx = x * 134217729.0
      xh = tx - (tx - x)
      xl = x - xh
      ty = y * 134217729.0
      yh = ty - (ty - y)
      yl = y - yh
      pl = ((xh * yh - ph) + xh * yl + xl * yh) + xl * yl
      th = z + ph
      bp = th - z
      tl = (z - (th - bp)) + (ph - bp)
      v = tl + pl
      bv = v - tl
      err = (tl - (v - bv)) + (pl - bv)
      if err != 0.0
        bits = IyiFloatText.bits_of(v)
        if bits & 1_u64 == 0_u64
          # Toward err: away from zero when they share a sign.
          bits = (err > 0.0) == (v > 0.0) ? bits &+ 1_u64 : bits &- 1_u64
          v = IyiFloatText.from_bits(bits)
        end
      end
      r = th + v
      return r if r.abs > 1.0e-280
    end
    musl_fma(x, y, z)
  end

  private def self.musl_fma(x : Float64, y : Float64, z : Float64) : Float64
    mx, ex, sx = fma_parts(x)
    my, ey, sy = fma_parts(y)
    mz, ez, sz = fma_parts(z)
    return x * y + z if ex >= FMA_SPECIAL || ey >= FMA_SPECIAL
    if ez >= FMA_SPECIAL
      return x * y if ez > FMA_SPECIAL
      return z
    end
    rhi, rlo = fma_wide(mx, my)
    # The exponents aligned: z shifted up by as much of the gap as keeps
    # it in 128 bits, the product down by the rest with a sticky bit.
    e = ex + ey
    d = ez - e
    zhi = 0_u64
    zlo = 0_u64
    if d > 0
      if d < 64
        zlo = mz.unsafe_shl(d.to_u64)
        zhi = mz.unsafe_shr((64 - d).to_u64)
      else
        zhi = mz
        e = ez - 64
        d = d - 64
        if d >= 64
          rlo = 1_u64
          rhi = 0_u64
        elsif d > 0
          rlo = rhi.unsafe_shl((64 - d).to_u64) | rlo.unsafe_shr(d.to_u64) | fma_sticky(rlo.unsafe_shl((64 - d).to_u64))
          rhi = rhi.unsafe_shr(d.to_u64)
        end
      end
    else
      d = 0 - d
      if d == 0
        zlo = mz
      elsif d < 64
        zlo = mz.unsafe_shr(d.to_u64) | fma_sticky(mz.unsafe_shl((64 - d).to_u64))
      else
        zlo = 1_u64
      end
    end
    sign = sx != sy
    nonzero = true
    if sign == sz
      rlo = rlo &+ zlo
      rhi = rhi &+ zhi &+ (rlo < zlo ? 1_u64 : 0_u64)
    else
      before = rlo
      rlo = rlo &- zlo
      rhi = rhi &- zhi &- (before < rlo ? 1_u64 : 0_u64)
      if rhi.unsafe_shr(63_u64) != 0_u64
        rlo = 0_u64 &- rlo
        rhi = 0_u64 &- rhi &- fma_sticky(rlo)
        sign = !sign
      end
      nonzero = rhi != 0_u64
    end
    # The top 63 bits of the sum in rhi, its last bit sticky.
    if nonzero
      e = e + 64
      d = rhi.leading_zeros_count - 1
      rhi = rhi.unsafe_shl(d.to_u64) | rlo.unsafe_shr((64 - d).to_u64) | fma_sticky(rlo.unsafe_shl(d.to_u64))
    elsif rlo != 0_u64
      d = rlo.leading_zeros_count - 1
      rhi = d < 0 ? rlo.unsafe_shr(1_u64) | (rlo & 1_u64) : rlo.unsafe_shl(d.to_u64)
    else
      # An exact zero, whose sign is the product's and z's to settle.
      return x * y + z
    end
    e = e - d
    i = rhi.unsafe_to_i64
    i = 0_i64 &- i if sign
    r = i.to_f64
    if e < -1022 - 62
      # Subnormal before rounding: the conversion must be the only
      # rounding, so the bits the scaling would drop are folded into one.
      if e == -1022 - 63
        top = sign ? -9223372036854775808.0 : 9223372036854775808.0
        return sign ? -2.2250738585072014e-308 : 2.2250738585072014e-308 if r == top
        if rhi.unsafe_shl(53_u64) != 0_u64
          i = (rhi.unsafe_shr(1_u64) | (rhi & 1_u64) | 0x4000000000000000_u64).unsafe_to_i64
          i = 0_i64 &- i if sign
          r = 2.0 * i.to_f64 - top
        end
      else
        i = (rhi.unsafe_shr(10_u64) | fma_sticky(rhi.unsafe_shl(54_u64))).unsafe_shl(10_u64).unsafe_to_i64
        i = 0_i64 &- i if sign
        r = i.to_f64
      end
    end
    ldexp(r, e)
  end

  private def self.soft_fmaf(x : Float32, y : Float32, z : Float32) : Float32
    xy = x.to_f64 * y.to_f64
    wide = z.to_f64
    r = xy + wide
    bits = IyiFloatText.bits_of(r)
    e = bits.unsafe_shr(52_u64) & 0x7ff_u64
    halfway = bits & 0x1fffffff_u64 == 0x10000000_u64
    tiny = e <= 0x3ff_u64 - 126_u64 && e >= 0x3ff_u64 - 149_u64
    return r.to_f32 if !halfway && !tiny
    if e != 0x7ff_u64
      s = bits.unsafe_shr(63_u64)
      t = (s == 1_u64) == (xy < wide) ? xy - r + wide : wide - r + xy
      if t != 0.0
        bits = bits &- (s ^ (t < 0.0 ? 1_u64 : 0_u64))
        bits = bits | 1_u64
      end
    end
    IyiFloatText.from_bits(bits).to_f32
  end

  # The smaller, with the number when one side is NaN, and -0.0 over 0.0.
  def self.min(a : Float64, b : Float64) : Float64
    return b if a != a
    return a if b != b
    return a if a < b
    return b if b < a
    copysign(1.0, a) < 0.0 ? a : b
  end

  def self.min(a : Float32, b : Float32) : Float32
    return b if a != a
    return a if b != b
    return a if a < b
    return b if b < a
    copysign(1.0_f32, a) < 0.0_f32 ? a : b
  end

  # The larger, with the number when one side is NaN, and 0.0 over -0.0.
  def self.max(a : Float64, b : Float64) : Float64
    return b if a != a
    return a if b != b
    return a if a > b
    return b if b > a
    copysign(1.0, a) < 0.0 ? b : a
  end

  def self.max(a : Float32, b : Float32) : Float32
    return b if a != a
    return a if b != b
    return a if a > b
    return b if b > a
    copysign(1.0_f32, a) < 0.0_f32 ? b : a
  end

