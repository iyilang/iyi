# A PCG-32 generator, and a handful of random values from it - the same
# stream, draw for draw, as the other library's `Random.new(seed)`, so a
# program seeded there and ported here prints the same numbers.
#
# `Random.new(seed, sequence = 0)` is deterministic: the seed is PCG's
# initial state and the sequence picks one of 2^63 streams, as
# `Random::PCG32.new(initstate, initseq)` does. `Random.new` seeds from
# eight bytes of the platform's own entropy: `/dev/urandom` on unix,
# `RtlGenRandom` on Windows, which has no such device. wasm32 has neither
# and seeds from the clocks. Neither is a lock: this is shuffle-the-deck
# randomness, not a secret.
#
# `next_u` is the raw 32 bits. `rand`/`next_float` is in `[0, 1]`, 53
# bits from two draws. `rand(n)` is an `Int32` in `0...n`, a draw past the
# largest multiple of `n` thrown away so that no value is likelier than
# another. A non-positive bound is `empty range`. `Array#shuffle`,
# `Array#sample` and `sample(n)` take a generator, and use a fresh one
# when handed none; they land here so a program that never asks for a
# random number does not carry one. Each makes the other library's
# choices in the other library's order.

module std/random

import std/int
import std/time
using std/time::{Time}

{% if flag?(:win32) %}
  # The entropy source Windows offers a program that only wants bytes.
  # `RtlGenRandom` lives in advapi32.dll, which ships with the machine, and is
  # exported under its ordinal alias `SystemFunction036` — the name the import
  # library carries, so that is the name to bind. Upstream Crystal names the
  # same call in `src/crystal/system/win32/random.cr`, and naming a second
  # source (a bcrypt/CNG provider, opened and closed for eight bytes) would
  # leave the repo with two answers to one question. advapi32 is not the
  # prelude's kernel32, so this `lib` has to ask for it.
  #
  # A BOOLEAN is one byte at this ABI and a ULong is 32 bits, declared as the
  # integers they are.
  @[Link("advapi32")]
  lib LibAdvapi32
    fun RtlGenRandom = SystemFunction036(buffer : Void*, length : UInt32) : UInt8
  end
{% end %}

pub class Random
  @state : UInt64
  @inc : UInt64

  # The stream came from the seed, and one seed was one stream: the other
  # library takes the stream apart from the seed, zero unless asked, and
  # the same seed gave two different sequences in the two libraries.
  def initialize(seed : UInt64, sequence : UInt64 = 0_u64)
    @inc = (sequence << 1) | 1_u64
    @state = 0_u64
    next_u
    @state = @state &+ seed
    next_u
  end

  def self.new(seed : Int32, sequence : UInt64 = 0_u64) : Random
    new(seed.to_u64, sequence)
  end

  def self.new(seed : Int64, sequence : UInt64 = 0_u64) : Random
    new(seed.to_u64, sequence)
  end

  def self.new : Random
    new(entropy, entropy)
  end

  def next_u : UInt32
    old = @state
    @state = old &* 6364136223846793005_u64 &+ @inc
    mixed = ((old >> 18) ^ old) >> 27
    xorshifted = (mixed & 4294967295_u64).to_u32
    rot = (old >> 59).to_i32
    if rot == 0
      xorshifted
    else
      (xorshifted >> rot) | (xorshifted << (32 - rot))
    end
  end

  # 2^53 values, the high draw first: two 32-bit draws make the integer,
  # and it is divided by 2^53 - 1, so both ends can come out.
  def next_float : Float64
    high = next_u.to_u64
    low = next_u.to_u64
    ((high << 32) | low).unsafe_mod(9007199254740992_u64).to_f64 / 9007199254740991.0
  end

  def rand : Float64
    next_float
  end

  def rand(n : Int32) : Int32
    raise "empty range: #{n}" if n <= 0
    bound = n.to_u32
    limit = 0_u32 &- (0_u32 &- bound).unsafe_mod(bound)
    while true
      result = next_u
      return result.unsafe_mod(bound).to_i32 if result < limit || limit == 0_u32
    end
  end

  def next_bool : Bool
    (next_u & 1_u32) == 1_u32
  end

  private def self.entropy : UInt64
    {% if flag?(:wasm32) %}
      Time.utc.to_unix.to_u64 ^ Time.monotonic.total_nanoseconds.to_u64
    {% elsif flag?(:win32) %}
      # Eight bytes into a heap cell, then out little-endian, the same shape
      # the `/dev/urandom` arm reads: one call, no device to open or close.
      p = Pointer(UInt8).malloc(8_u64)
      if LibAdvapi32.RtlGenRandom(p.as(Void*), 8_u32) == 0_u8
        raise "Random: RtlGenRandom answered no bytes"
      end
      v = 0_u64
      i = 0
      while i < 8
        v = v | (p[i].to_u64 << (i * 8))
        i = i + 1
      end
      v
    {% else %}
      io = ::File.open("/dev/urandom")
      bytes = io.read_bytes(8)
      io.close
      raise "Random: /dev/urandom answered #{bytes.bytesize} bytes, not 8" if bytes.bytesize != 8
      p = bytes.to_unsafe
      v = 0_u64
      i = 0
      while i < 8
        v = v | (p[i].to_u64 << (i * 8))
        i = i + 1
      end
      v
    {% end %}
  end
end

class ::Array(T)
  # Fisher-Yates from the back, `rand(i + 1)` a step: the other library's
  # `shuffle!`, so a seeded generator puts the elements where it would.
  def shuffle_in_place(random : Std::Random::Random? = nil) : Array(T)
    rng = random || Std::Random::Random.new
    i = @size - 1
    while i > 0
      j = rng.rand(i + 1)
      tmp = @buffer[i]
      @buffer[i] = @buffer[j]
      @buffer[j] = tmp
      i = i - 1
    end
    self
  end

  def shuffle(random : Std::Random::Random? = nil) : Array(T)
    dup.shuffle_in_place(random)
  end

  def sample(random : Std::Random::Random? = nil) : T
    raise "sample of an empty array" if empty?
    rng = random || Std::Random::Random.new
    self[rng.rand(@size)]
  end

  # *n* distinct elements. One is `sample` in a list; more are a reservoir
  # (each element past the first *n* replaces a slot with probability
  # n/(i+1)) shuffled at the end - both as the other library does it.
  def sample(n : Int32, random : Std::Random::Random? = nil) : Array(T)
    raise "sample of a negative count: #{n}" if n < 0
    picked = Array(T).new(n)
    return picked if n == 0
    rng = random || Std::Random::Random.new
    if n == 1
      picked << sample(rng) unless empty?
      return picked
    end
    i = 0
    while i < @size
      if i < n
        picked << @buffer[i]
      else
        j = rng.rand(i + 1)
        picked[j] = @buffer[i] if j < n
      end
      i = i + 1
    end
    picked.shuffle_in_place(rng)
  end
end
