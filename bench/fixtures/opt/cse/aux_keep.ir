; iyi-ir 1
source_filename = "aux_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @aux_keep(ptr %out) {
entry:
  %slot = alloca [2 x i64], align 8
  %a = getelementptr [2 x i64], ptr %slot, i64 0, i64 1
  %b = getelementptr inbounds [2 x i64], ptr %slot, i64 0, i64 1
  %scalar = getelementptr i64, ptr %slot, i64 0
  %aggregate = getelementptr [2 x i64], ptr %slot, i64 0
  store ptr %a, ptr %out, align 8
  store ptr %b, ptr %out, align 8
  store ptr %scalar, ptr %out, align 8
  store ptr %aggregate, ptr %out, align 8
  ret void
}
