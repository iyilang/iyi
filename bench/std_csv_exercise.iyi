# Exercises `std/csv`.
#
# Run via:
#     ./bin/iyi run bench/std_csv_exercise.iyi

module bench/std_csv_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/csv::{CSV}

puts "== parse"
rows = CSV.parse("a,b\n1,2\n")
assert_true rows.size == 2, "two rows"
assert_str "a", rows[0][0], "first field"
assert_str "2", rows[1][1], "last field"
quoted = CSV.parse("\"a,b\",c\n")
assert_str "a,b", quoted[0][0], "quoted comma"
assert_str "c", quoted[0][1], "after quoted"
built = CSV.build(quoted)
assert_true built.includes?("a,b"), "build keeps comma field"
puts "  rows, quotes, build"

# A byte order mark, which Excel writes into every "CSV UTF-8" file, is not
# the first field's: `row[0] == "id"` was false.
assert_str "id", CSV.parse("\uFEFFid,name\r\n1,a\r\n")[0][0], "a header behind a byte order mark"
puts "  a byte order mark"

# A lone CR ends a row, as in Crystal's: it was dropped, and `a\rb` read as
# `ab`. And a row that is one empty field survives: `""` was no row, and
# `CSV.build([["a"], [""]])` wrote `a\n`, which read back as one row.
lone = CSV.parse("a\rb,c\n")
assert_true lone.size == 2 && lone[0] == ["a"] && lone[1] == ["b", "c"], "a lone CR ends a row"
assert_true CSV.parse("\"\"") == [[""]], "a quoted empty field alone is a row"
assert_true CSV.parse("a\n\"\"") == [["a"], [""]], "and as the last row"
[[["a"], [""]], [[""]], [["x", ""], [""], ["y"]]].each do |table|
  assert_true CSV.parse(CSV.build(table)) == table, "#{table} reads back from what build wrote"
end
puts "  a lone CR, and a row of one empty field"

# A UTF-16 document (Windows PowerShell 5.1's `Out-File` and `>`) is
# refused by its byte order mark; it read as fields with a NUL between
# every two letters, and no error.
said = "parsed"
group do |g|
  attempt = g.spawn { CSV.parse("\xFF\xFE\"\0N\0\"\0\r\0\n\0") }
  outcome = attempt.value
  said = outcome.message.to_s if outcome.is_a?(Panicked)
  0
end
assert_true said.includes?("UTF-16"), "a UTF-16 document is refused, not #{said.inspect}"
puts "  a UTF-16 document is refused"

puts "\nALL CHECKS PASSED"
