# The prelude's collections at their edges - SPEC.md, "0.1.0", item 3.
#
#     bash bench/collections_exercise.sh
#
# `Array`, `Hash` and `Set` are three of the six things a program gets, and
# what a program does to them at the edges is what this file is: a key
# written twice, a table grown past its first capacity, a key deleted and
# the rest still findable, keys that all hash to one slot, an array appended
# to itself, an empty receiver asked for its first element.
#
# The one defect this file was written for: `a.concat(a)` walked *other*'s
# size while `<<` grew it, so it never reached the end - it grew the buffer
# until the capacity arithmetic overflowed and `[1, 2].concat(itself)` died
# of "arithmetic overflow".
#
# The sections at the end are 0.18's: the spans of an array and the
# questions a table answers beyond `[]` and `each`, each at its edges - an
# empty receiver, negative and out-of-range ends, endless and beginless
# ranges - and a table's equality, which is its pairs in any order.
#
# The panics belong to the driver, because a panicking program has no next
# line to assert on.
module main

def assert_true(condition : Bool, msg : String) : Nil
  raise "assert failed: #{msg}" unless condition
end

def assert_int(actual : Int32, expected : Int32, msg : String) : Nil
  raise "assert failed: #{msg} (#{actual} != #{expected})" unless actual == expected
end

def assert_str(actual : String, expected : String, msg : String) : Nil
  raise "assert failed: #{msg} (#{actual} != #{expected})" unless actual == expected
end

# ---- Hash: one key, one entry, whatever it is written with
counts = {} of String => Int32
counts["a"] = 1
counts["a"] = 2
assert_int(counts.size, 1, "hash: a key written twice is one entry")
assert_int(counts["a"]? || 0, 2, "hash: the second write is the value")

# Past the first capacity, which is where a table rebuilds its index
wide = {} of Int32 => Int32
i = 0
while i < 64
  wide[i] = i * 10
  i = i + 1
end
assert_int(wide.size, 64, "hash: sixty-four keys are sixty-four entries")
missed = 0
i = 0
while i < 64
  missed = missed + 1 if wide[i]? != i * 10
  i = i + 1
end
assert_int(missed, 0, "hash: every key survives the growth")

# A delete has to remove its own and leave the keys that probed past it
i = 0
while i < 64
  wide.delete(i) if i % 2 == 0
  i = i + 1
end
assert_int(wide.size, 32, "hash: deletes leave half")
gone = 0
kept = 0
i = 0
while i < 64
  if i % 2 == 0
    gone = gone + 1 if wide[i]? == nil
  else
    kept = kept + 1 if wide[i]? == i * 10
  end
  i = i + 1
end
assert_int(gone, 32, "hash: the deleted are gone")
assert_int(kept, 32, "hash: the rest are findable")

walked = 0
wide.each { |key, value| walked = walked + 1 }
assert_int(walked, wide.size, "hash: each counts what size says")
assert_int(wide.keys.size, wide.size, "hash: keys is as long as size")
assert_int(wide.values.size, wide.size, "hash: values is as long as size")

# Emptied and used again
i = 0
while i < 64
  wide.delete(i)
  i = i + 1
end
assert_true(wide.empty?, "hash: emptied")
assert_int(wide.size, 0, "hash: empty size")
wide[7] = 70
assert_int(wide[7]? || 0, 70, "hash: refilled after emptying")

# A key nobody put in
absent = {} of String => Int32
absent["x"] = 1
assert_true(absent.delete("y") == nil, "hash: deleting a missing key is nil")
assert_int(absent.size, 1, "hash: a missing delete removes nothing")
assert_true(absent.has_key?("x"), "hash: the survivor is still there")

# A first key in braces of its own is spaced off, as a tuple's first member
# is and the other library's hash is: `{{1, 2} => 3}` reads as a macro.
assert_str({ {1, 2} => { {3, 4} => 5 } }.inspect, "{ {1, 2} => { {3, 4} => 5 } }", "hash: a first key in braces is spaced off")
assert_str({1 => { {2 => 3} => 5 }}.inspect, "{1 => { {2 => 3} => 5 }}", "hash: and only the hash whose first key it is")

# Keys that share one slot by construction: equal by their number, hashed
# to one constant, so every key lands in the same slot and the comparison
# is what finds it. (Arrays did this by accident, hashing to their type's
# id, until an array hashed its elements.)
struct Crowded
  getter n : Int32

  def initialize(@n : Int32)
  end

  def ==(other : Crowded) : Bool
    @n == other.n
  end

  def hash : Int32
    7
  end
end

crowded = {} of Crowded => Int32
i = 0
while i < 16
  crowded[Crowded.new(i)] = i
  i = i + 1
end
wrong = 0
i = 0
while i < 16
  wrong = wrong + 1 if crowded[Crowded.new(i)]? != i
  i = i + 1
end
assert_int(wrong, 0, "hash: colliding keys are all findable")
crowded.delete(Crowded.new(8))
assert_true(crowded[Crowded.new(8)]? == nil, "hash: one of the crowd deleted")
assert_int(crowded[Crowded.new(9)]? || -1, 9, "hash: its neighbour survives")
assert_int(crowded[Crowded.new(7)]? || -1, 7, "hash: and the one before it")

# The order `each` promises, which is the order they went in
order = {} of String => Int32
order["z"] = 1
order["a"] = 2
order["m"] = 3
names = order.keys
assert_str(names[0], "z", "hash: first in, first out")
assert_str(names[1], "a", "hash: second")
assert_str(names[2], "m", "hash: third")

# ---- Set
members = Set(Int32).new
members.add(1)
members.add(2)
members.add(1)
assert_int(members.size, 2, "set: the same value once")
assert_true(members.delete(1), "set: delete says it was there")
assert_true(members.delete(1) == false, "set: and says when it was not")
assert_int(members.size, 1, "set: size after a delete")
assert_true(members.includes?(2), "set: the other one is still in")
walked = 0
members.each { |value| walked = walked + 1 }
assert_int(walked, members.size, "set: each counts what size says")
assert_int(members.to_a.size, members.size, "set: to_a is as long as size")

others = Set(Int32).new
others.add(2)
others.add(3)
assert_int((members - others).size, 0, "set: difference removes what is shared")
assert_int((others - members).size, 1, "set: and keeps what is not")
assert_int(Set(Int32).new.size, 0, "set: an empty one is empty")

# ---- Array
three = [1, 2, 3]
assert_int(three[-1], 3, "array: the last through a negative index")
assert_int(three[-3], 1, "array: the first through a negative index")
assert_true(three[-4]? == nil, "array: past the start is nil")
assert_true(three[3]? == nil, "array: past the end is nil")
assert_int(three.first(2).size, 2, "array: first n")
assert_int(three.first(9).size, 3, "array: first n past the end is all of it")
assert_int([3, 1, 3, 2, 1].uniq.size, 3, "array: uniq")
assert_int([1, 2, 3].reversed[0], 3, "array: reversed")
assert_int([3, 1, 2].sorted[0], 1, "array: sorted")
# The in-place twin of that, which only had the block form.
in_place = ["c", "a", "b"]
assert_true(in_place.sort_in_place.object_id == in_place.object_id && in_place == ["a", "b", "c"], "array: sort_in_place without a block")
assert_int([1, 2].concat([3]).size, 3, "array: concat")
# `delete` takes every equal element and answers the last, or nil, as the
# other library's: it took the first alone and answered true, so the same
# call left `[2, 1, 3, 1]` here and `[2, 3]` there.
repeated = [1, 2, 1, 3, 1]
assert_true(repeated.delete(1) == 1 && repeated == [2, 3], "array: delete takes every equal element")
assert_true(repeated.delete(9).nil? && repeated == [2, 3], "array: delete of a missing value is nil")

# The defect: an array appended to itself is a doubling, not a loop.
doubling = [1, 2]
doubling.concat(doubling)
assert_int(doubling.size, 4, "array: concat with itself doubles")
assert_int(doubling[2], 1, "array: and copies what was there")
assert_int(doubling[3], 2, "array: including the last of it")

# An empty array answers the questions that have answers
nothing = [] of Int32
assert_int(nothing.size, 0, "array: empty size")
assert_true(nothing.empty?, "array: empty?")
assert_true(nothing.last? == nil, "array: empty last? is nil")
assert_str(nothing.join, "", "array: empty join is empty")
assert_int(nothing.sorted.size, 0, "array: empty sorted")
assert_int(nothing.uniq.size, 0, "array: empty uniq")
assert_int(nothing.count { |value| true }, 0, "array: empty count")
assert_true(nothing.index(1) == nil, "array: empty index is nil")

# Growth through `<<`, which is the other half of the buffer's arithmetic
grown = [] of Int32
i = 0
while i < 1000
  grown << i
  i = i + 1
end
assert_int(grown.size, 1000, "array: a thousand appends")
assert_int(grown[999], 999, "array: the last one is there")
assert_int(grown[0], 0, "array: and the first")
i = 0
while i < 500
  grown.pop
  i = i + 1
end
assert_int(grown.size, 500, "array: five hundred pops")
assert_int(grown[499], 499, "array: the new last")

# ---- Range, whose walk used to step past its own end
# `value <= @end` meant the last step left the type on the checked `+`, so a
# range ending at the type's maximum panicked at the value it was asked to
# yield last.
assert_int((2147483645..2147483647).to_a.size, 3, "range: up to the type's maximum")
assert_int((2147483645..2147483647).to_a[2], 2147483647, "range: and the maximum is in it")
assert_int((1..3).to_a.size, 3, "range: inclusive counts both ends")
assert_int((1...3).to_a.size, 2, "range: exclusive drops the end")
assert_int((3..1).to_a.size, 0, "range: backwards is empty")
assert_int((5..5).to_a.size, 1, "range: one value")
assert_int((5...5).to_a.size, 0, "range: no values")
assert_int((1..4).sum, 10, "range: sum")

# The forms a port writes first: a filled array, two joined, a table
# with a default - a value, or a block that may store what it answers -
# and a table's pairs as an array to sort.
filled = Array.new(4, 7)
assert_int(filled.size, 4, "array: filled has the size asked")
assert_int(filled[3], 7, "array: filled with the value")
joined = [1, 2] + [3]
assert_int(joined.size, 3, "array: + joins")
assert_int(joined[2], 3, "array: + keeps the order")
counts = Hash(String, Int32).new(0)
assert_int(counts["z"], 0, "hash: a default answers a missing key")
counts["a"] = counts["a"] + 1
counts["a"] = counts["a"] + 1
assert_int(counts["a"], 2, "hash: a default counts")
assert_int(counts.size, 1, "hash: a default is not stored")
squares = Hash(Int32, Int32).new { |table, n| table[n] = n * n }
assert_int(squares[6], 36, "hash: a default block answers")
assert_int(squares.size, 1, "hash: and may store")
pairs = counts.to_a
assert_int(pairs.size, 1, "hash: to_a has a pair per entry")
assert_str(pairs[0][0], "a", "hash: to_a keeps the key")

# A sort is a merge sort, and a large array is where that shows: 100,000
# elements with 50 distinct keys, sorted with a block that counts its calls.
# An insertion sort - what the prelude had, written for five elements -
# makes about n*n/4 comparisons here, 2.5 billion, and never answered for
# three million; a merge sort about n*log2(n), 1.7 million. The order must
# be ascending and, for equal keys, the order the elements came in.
class Keyed
  getter key : Int32
  getter seq : Int32

  def initialize(@key : Int32, @seq : Int32)
  end
end

class Tally
  @@calls = 0_i64

  # Past the bound the sort is not a merge sort, and waiting out the rest
  # of an insertion sort's billions is a minute; the check fails here.
  def self.bump : Nil
    @@calls = @@calls + 1
    raise "assert failed: array: a sort of 100,000 made #{@@calls} comparisons, past n*log2(n)" if @@calls > 3000000_i64
  end

  def self.calls : Int64
    @@calls
  end
end

keyed = [] of Keyed
seed = 7
index = 0
while index < 100000
  seed = (seed * 1103 + 12345) % 1000003
  keyed << Keyed.new(seed % 50, index)
  index = index + 1
end
ordered = keyed.sorted do |a, b|
  Tally.bump
  a.key < b.key ? -1 : (a.key > b.key ? 1 : 0)
end
out_of_order = 0
index = 1
while index < ordered.size
  before = ordered[index - 1]
  after = ordered[index]
  out_of_order = out_of_order + 1 if before.key > after.key || (before.key == after.key && before.seq > after.seq)
  index = index + 1
end
assert_int(ordered.size, 100000, "array: a sort keeps every element")
assert_int(out_of_order, 0, "array: a sort is ascending and keeps equal elements in order")
by_key = keyed.sorted_by { |k| k.key }
assert_int(by_key[0].seq, ordered[0].seq, "array: sorted_by keeps equal keys in order")
assert_int(by_key[99999].seq, ordered[99999].seq, "array: sorted_by agrees with sorted")

# `sorted` and `sorted_by` ask one question a step: is the right one
# smaller. They asked `<` and then `==` - or `<` both ways - and a string
# sort paid for two comparisons of every pair it did not find in order.
# An element that counts what it is asked: no `==` at all, and the key
# sort asks `<` exactly as often as the element sort, on the same order.
struct Asked
  getter value : Int32

  def initialize(@value : Int32)
  end

  def <(other : Asked) : Bool
    AskedCount.less = AskedCount.less + 1
    @value < other.value
  end

  def ==(other : Asked) : Bool
    AskedCount.equal = AskedCount.equal + 1
    @value == other.value
  end
end

class AskedCount
  @@less = 0
  @@equal = 0

  def self.less : Int32
    @@less
  end

  def self.less=(count : Int32) : Int32
    @@less = count
  end

  def self.equal : Int32
    @@equal
  end

  def self.equal=(count : Int32) : Int32
    @@equal = count
  end
end

asked = (0...5000).map { |i| Asked.new((i * 7919) % 5003) }
asked_sorted = asked.sorted
element_questions = AskedCount.less
assert_int(AskedCount.equal, 0, "array: sorted asks one question a step, never ==")
AskedCount.less = 0
asked_by = asked.sorted_by { |x| x }
assert_int(AskedCount.less, element_questions, "array: sorted_by asks < as often as sorted")
assert_true(asked_sorted[0].value == 0 && asked_by[4999].value == asked_sorted[4999].value, "array: the one-question sorts agree")

# `!` in a sort's block returns from the def around it, as in `each`'s:
# the sort runs the block before it answers. `sorted` and `sorted_by`
# captured their block to hand it on, and `!` in a captured one was refused
# as "kept and called later, maybe by a task".
class BadKey
end

impl Error for BadKey
  def message : String
    "a negative key"
  end
end

def key_of(x : Int32) : Int32 | BadKey
  x < 0 ? BadKey.new : x
end

def by_checked_key(xs : Array(Int32)) : Array(Int32) | BadKey
  xs.sorted_by { |x| key_of(x)! }.sorted { |a, b| key_of(b)! < key_of(a)! ? 1 : 0 }
end

checked = by_checked_key([3, 1, 2])
assert_true(checked.is_a?(Array(Int32)) && checked == [1, 2, 3], "array: `!` in sorted_by's and sorted's blocks")
assert_true(by_checked_key([3, -1, 2]).is_a?(BadKey), "array: `!` in a sort's block returns the error")

# Every key type the prelude has spreads its keys: a type without a `hash`
# of its own hashes to its type id, so all its keys share one slot and a
# table of them is a list searched from the front - two million `Int64`
# inserts did not finish in two minutes that way. A thousand distinct keys
# of each type have a thousand distinct hashes (the bytes and characters
# as many as there are).
def spread(hashes : Array(Int32)) : Int32
  seen = {} of Int32 => Bool
  hashes.each { |h| seen[h] = true }
  seen.size
end

assert_int(spread((0...1000).map { |i| (i.to_i64 * 4294967296_i64 + i.to_i64).hash }), 1000, "hash: Int64 keys spread")
assert_int(spread((0...1000).map { |i| (i.to_u64 * 4294967296_u64).hash }), 1000, "hash: UInt64 keys spread")
assert_int(spread((0...256).map { |i| i.to_u8.hash }), 256, "hash: UInt8 keys spread")
assert_int(spread((0...128).map { |i| i.chr.hash }), 128, "hash: Char keys spread")
assert_int(spread((0...1000).map { |i| (i * 0.25).hash }), 1000, "hash: Float64 keys spread")
assert_true(0.0.hash == (-0.0).hash, "hash: 0.0 and -0.0 are one key")

# A tuple of small numbers spreads too - the grid point, the commonest
# tuple key there is. `a * 31 + b` gave a 300 by 300 grid 9,599 hashes
# for 90,000 points, and a table probing a slot at a time turns runs of
# equal hashes into one: a 1,000 by 1,000 grid had not filled in ten
# minutes. Every point its own hash, and a grid table fills and answers.
grid_hashes = [] of Int32
300.times { |x| 300.times { |y| grid_hashes << {x, y}.hash } }
assert_int(spread(grid_hashes), 90000, "hash: a 300 by 300 grid of tuples spreads")
grid = {} of {Int32, Int32} => Int32
300.times { |x| 300.times { |y| grid[{x, y}] = x * y } }
assert_true(grid[{299, 17}]? == 5083 && grid.size == 90000, "hash: a grid table fills and answers")

# And an array: it writes `==`, so `Reference#hash` gave every array its
# type's id and every array key one slot - 40,000 took 1.2 s to insert.
pair_hashes = [] of Int32
300.times { |x| 300.times { |y| pair_hashes << [x, y].hash } }
assert_int(spread(pair_hashes), 90000, "hash: a 300 by 300 grid of arrays spreads")
assert_true([1, 2].hash == [1, 2].hash && [1, 2] == [1, 2], "hash: equal arrays hash alike")

# Distinct hashes that share their low bits are not one slot either: an
# Int's hash is itself, the table took the slot from the low bits as they
# were, and keys that were multiples of 65536 made one run of probes -
# 20,000 of them took a second to insert, where consecutive keys take a
# millisecond. The hash is mixed before its bits pick the slot.
shared_started = __iyi_monotonic_ns
shared = {} of Int32 => Int32
20000.times { |k| shared[k &* 65536] = k }
shared_ms = (__iyi_monotonic_ns - shared_started) // 1000000
assert_true(shared.size == 20000 && shared[19999 &* 65536]? == 19999, "hash: multiples of 65536 all kept")
assert_true(shared_ms < 250, "hash: 20,000 keys that share their low bits insert in #{shared_ms} ms, not a second")

# The oldest key taken and deleted until none is left, the queue a table in
# insertion order makes: `each` started at entry 0 and stepped over every
# key deleted before it, 40,000 of them 197 ms optimised and quadratic.
def oldest(table : Hash(Int32, Int32)) : Int32
  table.each { |key, value| return key }
  -1
end

queue = {} of Int32 => Int32
40000.times { |k| queue[k] = k }
queue_started = __iyi_monotonic_ns
popped = 0
while queue.size > 0
  popped = popped + 1 if queue.delete(oldest(queue)) == popped
end
queue_ms = (__iyi_monotonic_ns - queue_started) // 1000000
assert_int(popped, 40000, "hash: the oldest key is taken in order")
assert_true(queue_ms < 50, "hash: 40,000 oldest keys taken in #{queue_ms} ms, past 50")

# A class instance is itself, and a set of them finds each one: `Object#==`
# answered false, so an instance did not equal itself and a `Set` never
# found what was added to it. A class that says what equal means keeps
# finding equal instances by it.
class Visit
  def initialize(@id : Int32)
  end
end

class Named
  getter name : String

  def initialize(@name : String)
  end

  def ==(other : Named) : Bool
    name == other.name
  end
end

here = Visit.new(1)
twin = Visit.new(1)
assert_true(here == here, "reference: an instance equals itself")
assert_true(here != twin, "reference: two instances are two")
visits = Set(Visit).new
all_visits = (0...20000).map { |i| Visit.new(i) }
all_visits.each { |v| visits.add(v) }
assert_int(visits.size, 20000, "reference: a set holds each instance once")
assert_true(all_visits.all? { |v| visits.includes?(v) }, "reference: a set finds every instance added")
assert_true(!visits.includes?(twin), "reference: and not one it was not given")
spread_visits = spread(all_visits.first(1000).map { |v| v.hash })
assert_true(spread_visits > 900, "reference: instances hash apart (#{spread_visits} of 1000)")
names = {} of Named => Int32
names[Named.new("a")] = 1
assert_int(names[Named.new("a")]? || 0, 1, "reference: a class's own == finds an equal key")

# A queue drains from the front, and a drain is linear: `shift` moved every
# element down, so 300,000 of them was 45 billion moves. Order holds across
# a shift and a push after it.
queue = [1, 2, 3, 4, 5]
assert_int(queue.shift, 1, "array: shift answers the first")
queue << 6
assert_int(queue.size, 5, "array: a push after a shift keeps the rest")
assert_int(queue[0], 2, "array: the second is first after a shift")
assert_int(queue[4], 6, "array: and the push is last")
drained = [] of Int32
while item = queue.shift?
  drained << item
end
assert_int(drained.size, 5, "array: shift? drains every element")
assert_int(drained[4], 6, "array: in order")
long_queue = [] of Int32
300000.times { |i| long_queue << i }
drained_sum = 0_i64
while item = long_queue.shift?
  drained_sum = drained_sum + item
end
assert_true(drained_sum == 44999850000_i64, "array: a queue of 300,000 drains, in order")

# A deletion costs one entry: it closed the gap and rebuilt the index, the
# whole table per deletion, and emptying a set of 20,000 took 0.95 s. Half of
# 50,000 are deleted, the rest are found, and the order holds.
large = Set(Int32).new
50000.times { |i| large.add(i) }
50000.times { |i| large.delete(i) if i % 2 == 0 }
assert_int(large.size, 25000, "set: twenty-five thousand deletes leave half")
assert_true(large.includes?(49999) && !large.includes?(49998), "set: the right half")
first_left = 0
large.each { |v| first_left = v if first_left == 0 }
assert_int(first_left, 1, "set: in the order they went in")
50000.times { |i| large.add(i) if i % 2 == 0 }
assert_int(large.size, 50000, "set: and a deleted key comes back")

# ---- Printed as the literal that spells it
#
# A string or character inspects with the other library's escapes, so an
# element's quotes are not the collection's: `["a\", \"b"]` printed as two
# strings, a tab inside a value as a tab, and `'\''` as `'''`.
assert_str(["a\", \"b"].inspect, "[\"a\\\", \\\"b\"]", "inspect: a quote inside a string is escaped")
assert_str({"k" => "a\tb\\\#{x}"}.inspect, "{\"k\" => \"a\\tb\\\\\\\#{x}\"}", "inspect: a tab, a backslash and an interpolation are escaped")
assert_str(['\'', '\0', '"', 'é'].inspect, "['\\'', '\\0', '\"', 'é']", "inspect: a character's quote and NUL are escaped")
assert_str(["\u0000\e\u007F\u00A0\u200B\u{E0001}\xFF"].inspect, "[\"\\u0000\\e\\u007F\\u00A0\\u200B\\u{E0001}\\xFF\"]", "inspect: what is not printable is hex")

# ---- A NaN key, placed where `<=>` places it
#
# `max_by` and `min_by` read the keys with `<`, which is false both ways
# against NaN, so `[1.0, NaN, 0.5].max_by` was 1.0 and `[NaN, 1.0].min_by`
# NaN, where `max` and std/enumerable's `max_by` put NaN above every number.
nan = 0.0 / 0.0
assert_str([1.0, nan, 0.5].max_by { |v| v }.to_s, "NaN", "array: max_by of a NaN key is the NaN")
assert_str([nan, 1.0].min_by { |v| v }.to_s, "1.0", "array: min_by passes over a NaN key")
assert_str([nan, 1.0].max_by { |v| v }.to_s, "NaN", "array: a NaN key first stays the largest")

# ---- Array: a span by start and count, and by range
#
# Every form a port writes for part of an array, at the edges: a start of
# exactly `size` is the empty tail and one past it is refused (`[]?` nil),
# either end may be negative, an end past the last stops at it, and a range
# may leave either end off. The refusals themselves are the driver's.
five = [1, 2, 3, 4, 5]
assert_str(five[1, 2].inspect, "[2, 3]", "array: two from the second")
assert_str(five[-2, 9].inspect, "[4, 5]", "array: a count past the end stops at it")
assert_str(five[0, 0].inspect, "[]", "array: a count of zero is empty")
assert_str(five[5, 2]?.inspect, "[]", "array: a start at the end is the empty tail, for []? too")
assert_str(five[5, 2].inspect, "[]", "array: a start at the end is the empty tail")
assert_true(five[6, 1]?.nil? && five[-6, 1]?.nil?, "array: a start outside is nil")
assert_str(five[1..3].inspect, "[2, 3, 4]", "array: an inclusive range keeps its end")
assert_str(five[1...3].inspect, "[2, 3]", "array: an exclusive range drops its end")
assert_str(five[3..].inspect, "[4, 5]", "array: an endless range runs to the end")
assert_str(five[..1].inspect, "[1, 2]", "array: a beginless range starts at the start")
assert_str(five[...1].inspect, "[1]", "array: and an exclusive one drops its end")
assert_str(five[-3..-2].inspect, "[3, 4]", "array: negative ends count from the end")
assert_str(five[2...-1].inspect, "[3, 4]", "array: up to the last, not including it")
assert_str(five[0..2147483647].inspect, "[1, 2, 3, 4, 5]", "array: an end at the type's maximum is all of it")
assert_str(five[4..1].inspect, "[]", "array: a backwards range is empty")
assert_str(five[0..-9].inspect, "[]", "array: an end before the start is empty")
assert_str(five[5..]?.inspect, "[]", "array: a range starting at the end is empty")
assert_true(five[6..]?.nil? && five[-9..]?.nil?, "array: a range starting outside is nil")
assert_str(([] of Int32)[0..].inspect, "[]", "array: an empty array's whole range")
part = five[1, 2]
part[0] = 99
assert_int(five[1], 2, "array: a span is a copy")

# Setting a span: one value or several where the span was, the array
# growing or shrinking by the difference; a start of `size` appends, and an
# array set into itself is read before it moves.
spliced = [1, 2, 3, 4, 5]
spliced[1, 2] = 9
assert_str(spliced.inspect, "[1, 9, 4, 5]", "array: a span set to one value")
spliced[0..1] = [7, 7, 7]
assert_str(spliced.inspect, "[7, 7, 7, 4, 5]", "array: a span set longer opens the gap")
spliced[0, 3] = [8]
assert_str(spliced.inspect, "[8, 4, 5]", "array: a span set shorter closes the gap")
spliced[3, 0] = 6
assert_str(spliced.inspect, "[8, 4, 5, 6]", "array: a span at the end appends")
spliced[1...1] = 0
assert_str(spliced.inspect, "[8, 0, 4, 5, 6]", "array: an empty range inserts")
spliced[-2..] = [] of Int32
assert_str(spliced.inspect, "[8, 0, 4]", "array: a span set to nothing removes it")
spliced[1, 0] = spliced
assert_str(spliced.inspect, "[8, 8, 0, 4, 0, 4]", "array: a span set from itself reads a copy")
assert_str([5, 6, 7, 8].truncate(1, 2).inspect, "[6, 7]", "array: truncate keeps the span")
assert_str([5, 6, 7, 8].truncate(-2..).inspect, "[7, 8]", "array: truncate keeps a range")
cut = [5, 6, 7, 8]
cut.truncate(1..2)
cut << 9
assert_str(cut.inspect, "[6, 7, 9]", "array: truncate in place, and room after it")

# ---- Array: push, unshift, pop?, first?, last(n)
pushed = [1]
assert_true(pushed.push(2).push(3, 4).object_id == pushed.object_id, "array: push answers the array")
assert_str(pushed.inspect, "[1, 2, 3, 4]", "array: push one and several")
many = [] of Int32
many.push(1, 2, 3, 4, 5, 6, 7, 8, 9)
assert_str(many.inspect, "[1, 2, 3, 4, 5, 6, 7, 8, 9]", "array: nine pushed at once past the first capacity")
pushed.unshift(0)
pushed.unshift(-2, -1)
assert_str(pushed.inspect, "[-2, -1, 0, 1, 2, 3, 4]", "array: unshift one and several, in the order written")
front = [1, 2, 3]
front.shift
front.unshift(9)
assert_str(front.inspect, "[9, 2, 3]", "array: unshift after a shift")
assert_true([1, 2].pop? == 2 && ([] of Int32).pop?.nil?, "array: pop? answers the last, and nil")
stack = [1, 2, 3]
popped_order = [] of Int32
while item = stack.pop?
  popped_order << item
end
assert_str(popped_order.inspect, "[3, 2, 1]", "array: pop? drains from the top")
assert_true([7, 8].first? == 7 && ([] of Int32).first?.nil?, "array: first? answers the first, and nil")
assert_str([1, 2, 3].last(2).inspect, "[2, 3]", "array: last n")
assert_true([1, 2, 3].last(9).size == 3 && [1, 2, 3].last(0).empty?, "array: last n past the start is all of it, and zero is none")

# ---- Array: flatten, transpose
assert_str([[1, 2], [3]].flatten.inspect, "[1, 2, 3]", "array: flatten one level")
deep = [[1, [2, [3]]], [[[4]]]].flatten
assert_str(deep.inspect, "[1, 2, 3, 4]", "array: flatten goes all the way down")
assert_str(typeof(deep).to_s, "Array(Int32)", "array: flatten's element type is the innermost")
assert_str([1, [2], [[3]]].flatten.inspect, "[1, 2, 3]", "array: flatten a mix of depths")
assert_true(([] of Array(Int32)).flatten.empty?, "array: flatten nothing")
assert_str([[1, 2], [3, 4], [5, 6]].transpose.inspect, "[[1, 3, 5], [2, 4, 6]]", "array: transpose")
assert_true(([] of Array(Int32)).transpose.empty? && [[] of Int32, [] of Int32].transpose.empty?, "array: transpose of nothing")

# ---- Array: -, &, |, * and uniq by a key
assert_str(([1, 1, 2, 3] - [2]).inspect, "[1, 1, 3]", "array: - keeps duplicates and order")
long_odd = (0...40).to_a - (0...40).select { |x| x % 2 == 0 }
assert_true(long_odd.size == 20 && long_odd[0] == 1 && long_odd[19] == 39, "array: - against a long array")
assert_true((([] of Int32) - [1]).empty? && ([1, 2] - ([] of Int32)) == [1, 2], "array: - with an empty side")
assert_str(([3, 1, 1, 2, 3] & [1, 3, 9]).inspect, "[3, 1]", "array: & keeps each once, in this order")
assert_true(([1, 2] & ([] of Int32)).empty?, "array: & with nothing")
assert_str(([1, 2, 2] | [2, 3, 1]).inspect, "[1, 2, 3]", "array: | keeps each once")
either = [1, 2] | ["a"]
assert_str(either.inspect + " " + typeof(either).to_s, "[1, 2, \"a\"] Array(Int32 | String)", "array: | widens the element type")
assert_str(([1, 2] * 3).inspect, "[1, 2, 1, 2, 1, 2]", "array: * repeats")
assert_true(([1, 2] * 0).empty? && (([] of Int32) * 5).empty?, "array: * zero times, and of nothing")
assert_str(["a", "B", "b", "A", "c"].uniq { |s| s.downcase }.inspect, "[\"a\", \"B\", \"c\"]", "array: uniq by a key keeps the first of each")

# ---- Hash: fetch, dig
table = {"a" => 1, "b" => 2, "c" => 3}
assert_int(table.fetch("a", 0), 1, "hash: fetch answers the value")
assert_str(table.fetch("z", "none").to_s, "none", "hash: fetch answers the default for a missing key")
assert_int(table.fetch("zz") { |key| key.size }, 2, "hash: fetch with a block answers for the missing key")
assert_int(Hash(String, Int32).new(5).fetch("x", 0), 0, "hash: fetch's default, not the table's")
nested = {"x" => {"y" => {"z" => 7}}}
assert_int(nested.dig("x", "y", "z"), 7, "hash: dig goes down")
assert_true(nested.dig?("x", "y", "z") == 7, "hash: dig? goes down")
assert_true(nested.dig?("x", "q", "z").nil? && nested.dig?("w").nil?, "hash: dig? of a missing key is nil")
assert_true({"n" => 1}.dig?("n", "deeper").nil?, "hash: dig? past a value that is not a table is nil")

# ---- Hash: merge, update, transform
merged = table.merge({"c" => 30, "d" => 4})
assert_str(merged.inspect, "{\"a\" => 1, \"b\" => 2, \"c\" => 30, \"d\" => 4}", "hash: merge, the second value wins")
assert_int(table["c"], 3, "hash: merge leaves the receiver alone")
assert_str(table.merge({"c" => 30}) { |key, mine, theirs| mine + theirs }.inspect, "{\"a\" => 1, \"b\" => 2, \"c\" => 33}", "hash: merge with a block")
wider = table.merge({1 => "one"})
assert_str(typeof(wider).to_s, "Hash(Int32 | String, Int32 | String)", "hash: merge widens both types")
merged_here = table.dup
merged_here.merge_in_place({"a" => 100, "e" => 5})
merged_here.merge_in_place({"b" => 5}) { |key, mine, theirs| mine * theirs }
assert_str(merged_here.inspect, "{\"a\" => 100, \"b\" => 10, \"c\" => 3, \"e\" => 5}", "hash: merge_in_place")
assert_int(merged_here.update("a") { |v| v + 1 }, 100, "hash: update answers the old value")
assert_int(merged_here["a"], 101, "hash: update stores the new one")
defaulted = Hash(String, Int32).new(10)
assert_int(defaulted.update("u") { |v| v + 1 }, 10, "hash: update of a missing key starts from the default")
assert_int(defaulted["u"], 11, "hash: and stores it")
assert_str(table.transform_values { |v| v.to_s }.inspect, "{\"a\" => \"1\", \"b\" => \"2\", \"c\" => \"3\"}", "hash: transform_values")
assert_str(table.transform_values { |v, k| k + v.to_s }.inspect, "{\"a\" => \"a1\", \"b\" => \"b2\", \"c\" => \"c3\"}", "hash: transform_values with the key")
assert_str(table.transform_keys { |k| k.upcase }.inspect, "{\"A\" => 1, \"B\" => 2, \"C\" => 3}", "hash: transform_keys")
assert_str(table.transform_keys { |k| 0 }.inspect, "{0 => 3}", "hash: keys that become one keep the later value")
doubled = table.dup
doubled.delete("a")
doubled.transform_values_in_place { |v| v * 2 }
assert_str(doubled.inspect, "{\"b\" => 4, \"c\" => 6}", "hash: transform_values_in_place")

# ---- Hash: select, reject, and the walks
assert_str(table.select { |k, v| v > 1 }.inspect, "{\"b\" => 2, \"c\" => 3}", "hash: select")
assert_str(table.reject { |k, v| v > 1 }.inspect, "{\"a\" => 1}", "hash: reject")
kept_pairs = table.dup
kept_pairs.select_in_place { |k, v| v != 2 }
assert_str(kept_pairs.inspect, "{\"a\" => 1, \"c\" => 3}", "hash: select_in_place keeps")
kept_pairs.reject_in_place { |k, v| true }
assert_true(kept_pairs.empty?, "hash: reject_in_place of everything empties it")
kept_pairs["new"] = 1
assert_str(kept_pairs.inspect, "{\"new\" => 1}", "hash: and it fills again")
walked_keys = ""
table.each_key { |k| walked_keys = walked_keys + k }
walked_values = 0
table.each_value { |v| walked_values = walked_values * 10 + v }
assert_true(walked_keys == "abc" && walked_values == 123, "hash: each_key and each_value in order")
assert_true(table.has_value?(2) && !table.has_value?(9), "hash: has_value?")
assert_true(table.key_for(2) == "b" && table.key_for?(9).nil?, "hash: key_for")
assert_str({"a" => 1, "b" => 1}.invert.inspect, "{1 => \"b\"}", "hash: invert keeps the later key")
holes = {"a" => 1, "b" => nil, "c" => 3}
assert_str(holes.compact.inspect + " " + typeof(holes.compact).to_s, "{\"a\" => 1, \"c\" => 3} Hash(String, Int32)", "hash: compact keeps the values")
assert_int(table.count { |k, v| v % 2 == 1 }, 2, "hash: count")
assert_true(table.any? { |k, v| v > 2 } && !table.all? { |k, v| v > 2 } && table.all? { |k, v| v > 0 }, "hash: any? and all?")
assert_true(table.sum { |k, v| v } == 6 && ({} of String => Int32).sum { |k, v| v } == 0, "hash: sum, and zero for none")
assert_str(table.map { |k, v| k * v }.inspect, "[\"a\", \"bb\", \"ccc\"]", "hash: map is an array")
assert_true(table.to_h.object_id == table.object_id, "hash: to_h is the table")
assert_str(table.sorted_by { |k, v| -v }.inspect, "[{\"c\", 3}, {\"b\", 2}, {\"a\", 1}]", "hash: sorted_by")

# ---- Hash: first, shift, values_at, put_if_absent, delete with a block
assert_true(table.first_key? == "a" && table.first_value? == 1, "hash: first_key? and first_value?")
assert_true(({} of String => Int32).first_key?.nil? && ({} of String => Int32).first_value?.nil?, "hash: and nil when empty")
trimmed = table.dup
trimmed.delete("a")
assert_true(trimmed.first_key? == "b" && trimmed.first_key == "b" && trimmed.first_value == 2, "hash: first_key? after a delete")
shifted = table.dup
assert_str(shifted.shift.inspect, "{\"a\", 1}", "hash: shift answers the oldest")
assert_int(shifted.size, 2, "hash: shift takes the oldest out")
drained_pairs = [] of String
while pair = shifted.shift?
  drained_pairs << pair[0]
end
assert_true(drained_pairs == ["b", "c"] && shifted.empty?, "hash: shift? drains in order, then nil")
assert_str(table.values_at("c", "a").inspect, "[3, 1]", "hash: values_at in the order asked")
absent_once = {} of String => Int32
assert_int(absent_once.put_if_absent("k", 1), 1, "hash: put_if_absent writes a missing key")
assert_int(absent_once.put_if_absent("k", 2), 1, "hash: put_if_absent keeps what is there")
asked_for = 0
absent_once.put_if_absent("k") { |key| asked_for = asked_for + 1; 3 }
assert_int(asked_for, 0, "hash: put_if_absent's block is not called for a key that is there")
assert_int(absent_once.delete("zz") { |key| -1 }, -1, "hash: delete with a block answers for a missing key")
assert_int(absent_once.delete("k") { |key| -1 }, 1, "hash: delete with a block answers the value")
assert_true(absent_once.empty?, "hash: and it is gone")

# ---- Hash: clear, dup
emptied = table.dup
emptied.clear
assert_true(emptied.empty? && emptied.inspect == "{}" && emptied["a"]?.nil?, "hash: clear empties")
emptied["r"] = 1
assert_str(emptied.inspect, "{\"r\" => 1}", "hash: and it fills again")
copied = table.dup
copied["a"] = 50
copied["z"] = 26
assert_true(table["a"] == 1 && !table.has_key?("z") && copied.size == 4, "hash: dup is a table of its own")
with_default = Hash(String, Int32).new(7)
assert_int(with_default.dup["missing"], 7, "hash: dup keeps the default")
cleared_default = Hash(String, Int32).new(7)
cleared_default["a"] = 1
cleared_default.clear
assert_int(cleared_default["a"], 7, "hash: clear keeps the default")

# ---- Hash: equality is the pairs, in any order, and hashing follows it
#
# `==` was `Reference#==`, identity: `{"a" => 1} == {"a" => 1}` was false,
# and a table was no use as a key. Two tables are equal when they hold the
# same pairs, as the other library's are, whatever order they went in.
forward = {"a" => 1, "b" => 2}
backward = {"b" => 2, "a" => 1}
assert_true(forward == backward, "hash: equal pairs in another order are equal")
assert_true(forward != {"a" => 1, "b" => 3}, "hash: a different value is unequal")
assert_true(forward != {"a" => 1, "c" => 2}, "hash: a different key is unequal")
assert_true(forward != {"a" => 1}, "hash: a different size is unequal")
assert_true(({} of String => Int32) == ({} of String => Int32), "hash: two empty tables are equal")
with_gone = {"x" => 0, "a" => 1, "b" => 2}
with_gone.delete("x")
assert_true(with_gone == forward, "hash: a table with a deletion equals one without")
assert_true(forward.hash == backward.hash && forward.hash == with_gone.hash, "hash: equal tables hash alike")
table_keys = {forward => "found"}
assert_true(table_keys[backward]? == "found", "hash: a table is found as a key by an equal one")
table_hashes = (0...1000).map { |i| {i => i, i + 1 => 0}.hash }
assert_true(spread(table_hashes) > 990, "hash: a thousand tables hash apart")

puts "all collection checks passed"
