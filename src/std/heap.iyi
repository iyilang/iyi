# A binary heap over `Comparable`.
#
# `push` and `pop` keep the smallest element at the root, so
# `Heap(Int32)` is a min-heap. Empty `pop` / `peek` is
# `pop of an empty heap`. The order is the trait's `<=>`, the same
# three-way `Enumerable#sorted` reads.

module std/heap

import std/traits::{Comparable}

pub class Heap(T)
  @items : Array(T)

  def initialize
    @items = [] of T
  end

  def size : Int32
    @items.size
  end

  def empty? : Bool
    @items.empty?
  end

  def push(value : T) : Nil where T : Comparable
    @items << value
    sift_up(@items.size - 1)
  end

  def peek : T where T : Comparable
    raise "peek of an empty heap" if empty?
    @items[0]
  end

  def pop : T where T : Comparable
    raise "pop of an empty heap" if empty?
    n = @items.size
    top = @items[0]
    last = @items[n - 1]
    @items.pop
    if @items.size > 0
      @items[0] = last
      sift_down(0)
    end
    top
  end

  private def sift_up(i : Int32) : Nil
    while i > 0
      p = (i - 1) // 2
      break unless (@items[i] <=> @items[p]) < 0
      tmp = @items[i]
      @items[i] = @items[p]
      @items[p] = tmp
      i = p
    end
  end

  private def sift_down(i : Int32) : Nil
    n = @items.size
    while true
      left = i * 2 + 1
      right = left + 1
      smallest = i
      smallest = left if left < n && (@items[left] <=> @items[smallest]) < 0
      smallest = right if right < n && (@items[right] <=> @items[smallest]) < 0
      break if smallest == i
      tmp = @items[i]
      @items[i] = @items[smallest]
      @items[smallest] = tmp
      i = smallest
    end
  end
end
