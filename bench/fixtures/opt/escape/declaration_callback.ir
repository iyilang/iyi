; iyi-ir 1
source_filename = "escape_declaration_callback"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal ptr @__iyi_new(i64 %size, i64 %type_id, i64 %flags) {
entry:
  ret ptr null
}
declare external void @library_visit(ptr, i64)
define internal i64 @callback(i64 %n) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 1, i64 2)
  call void (ptr, i64) @library_visit(ptr @callback, i64 %n)
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
