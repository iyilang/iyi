; iyi-ir 1
source_filename = "escape_select_out_of_bounds"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @select_out_of_bounds(i1 %choose) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 16, i64 4, i64 2)
  %right = getelementptr i8, ptr %p, i64 12
  %choice = select i1 %choose, ptr %p, ptr %right
  %v = load i64, ptr %choice, align 1
  ret i64 %v
}
