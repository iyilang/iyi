; iyi-ir 1
source_filename = "escape_nested_i1_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @nested_i1() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 16, i64 7, i64 2)
  %outside = getelementptr [2 x i64], ptr %p, i32 0, i1 true
  %v = load i64, ptr %outside, align 8
  ret i64 %v
}
