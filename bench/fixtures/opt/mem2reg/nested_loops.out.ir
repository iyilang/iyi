; iyi-ir 1
source_filename = "nested_loops"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @nested_loops(i1 %outer_cond, i1 %inner_cond) {
entry:
  br label %outer
outer:
  %0 = phi i64 [ 0, label %entry ], [ %1, label %after_inner ]
  br i1 %outer_cond, label %inner, label %done
inner:
  %1 = phi i64 [ %0, label %outer ], [ %next, label %body ]
  br i1 %inner_cond, label %body, label %after_inner
body:
  %next = add i64 %1, 1
  br label %inner
after_inner:
  br label %outer
done:
  ret i64 %0
}
