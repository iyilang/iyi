lib LibC
  fun exit(status : Int32) : NoReturn
end

abstract class Node
  def accept(v : Visitor) : Int32
    v.visit(self)
  end
end

class A < Node
end

class B < Node
end

class Visitor
  def visit(n : Node) : Int32
    1
  end

  def visit(n : A) : Int32
    8
  end
end

def make(flag : Bool) : Node
  flag ? A.new : B.new
end

v = Visitor.new
LibC.exit(make(true).accept(v) &+ make(false).accept(v))
