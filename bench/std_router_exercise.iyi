# Exercises `std/router`.
#
# Run via:
#     ./bin/iyi run bench/std_router_exercise.iyi

module bench/std_router_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/router::{Router, Pattern, RouterError}
import std/http::{HTTP, Request, Response, Server}
import std/socket::{IyiSocket}

# What `work` answers, or "refused: <why>" when it panics: run as a task,
# whose value catches the panic.
def answer(&work : -> String) : String
  said = "no answer"
  group do |g|
    task = g.spawn { work.call }
    case got = task.value
    in Panicked
      said = "refused: " + got.message
    in String
      said = got
    end
    0
  end
  said
end

# A handler that answers with its pattern and the wildcards it was handed,
# sorted by name: `GET /users/{id}|id=42`.
def add(router : Router, pattern : String) : Nil
  router.handle(pattern) do |_, params|
    names = params.keys.sorted
    Response.new(200, pattern + "|" + names.map { |name| name + "=" + params[name] }.join(","))
  end
end

def router_of(patterns : Array(String)) : Router
  router = Router.new
  patterns.each { |pattern| add(router, pattern) }
  router
end

# A router's answer in one line: the handler's body for a 200, the
# `Location` of a 301, the `Allow` of a 405, the status otherwise. The
# gate's Go program writes Go's `ServeMux`'s answers the same way.
def describe(router : Router, method : String, host : String, target : String) : String
  path = target
  query = nil.as(String?)
  if q = target.index('?')
    path = target[0, q]
    query = target[q + 1, target.bytesize - q - 1]
  end
  got = router.call(Request.new(method, path, query, {"Host" => host}, ""))
  case got.status
  when 200 then got.body
  when 301 then "301 " + (got.header("Location") || "")
  when 405 then "405 " + (got.header("Allow") || "")
  else          got.status.to_s
  end
end

# The routing tables. Each request is method, host, target, and the
