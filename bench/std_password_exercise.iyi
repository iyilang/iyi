# Exercises `std/password`.
#
# Run via:
#     ./bin/iyi run bench/std_password_exercise.iyi

module bench/std_password_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def hex(bytes : Array(UInt8)) : String
  digits = "0123456789abcdef"
  text = ""
  bytes.each do |b|
    text = text + digits[b.to_i32 >> 4].to_s + digits[b.to_i32 & 15].to_s
  end
  text
end

import std/password::{Scrypt, Bcrypt}

# RFC 7914 §12's first three vectors; the fourth (n = 2^20) needs a
# gibibyte, and is the gate's refusal of a default memory limit instead.
# Case 1's r = 1 makes BlockMix's two halves one block each, so the order
# they are written in shows only from case 2 on.
puts "== scrypt"
assert_str "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906", hex(Scrypt.derive("", "", 16, 1, 1, 64)), "rfc 7914 case 1 (n = 16, r = 1, p = 1)"
assert_str "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640", hex(Scrypt.derive("password", "NaCl", 1024, 8, 16, 64)), "rfc 7914 case 2 (n = 1024, r = 8, p = 16)"
assert_str "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887", hex(Scrypt.derive("pleaseletmein", "SodiumChloride", 16384, 8, 1, 64)), "rfc 7914 case 3 (n = 16384, r = 8, p = 1)"
# Case 3 asks 128 * 8 * 1 + 128 * 8 * (16384 + 2) bytes; at exactly that
# limit it is accepted.
assert_str "7023bdcb3afd7348461c06cd81fd38eb", hex(Scrypt.derive("pleaseletmein", "SodiumChloride", 16384, 8, 1, 16, 16_780_288_i64)), "a limit of exactly the memory asked"
assert_str hex(Scrypt.derive("password", "NaCl", 1024, 8, 16, 64))[0, 20], hex(Scrypt.derive([112_u8, 97_u8, 115_u8, 115_u8, 119_u8, 111_u8, 114_u8, 100_u8], [78_u8, 97_u8, 67_u8, 108_u8], 1024, 8, 16, 10)), "bytes for a string, and a shorter key a prefix"
assert_true hex(Scrypt.derive("", "", 16, 1, 1, 1)).size == 2, "one byte"
puts "  RFC 7914 cases 1 to 3"

# What the module itself must get right, before the vectors: a hash made
# here, read back here, and refused when its salt or cost is not the one
# it was made under. A Blowfish with a wrong table word still agrees with
# itself, and fails at the vectors below; one that ignores its salt or its
# cost fails here.
puts "\n== bcrypt"
made = Bcrypt.hash("correct horse battery staple", 4)
assert_true made.size == 60 && made[0, 7] == "$2b$04$", "the modular format: #{made}"
assert_true Bcrypt.verify("correct horse battery staple", made), "a hash verifies its password"
assert_true !Bcrypt.verify("correct horse battery stapler", made), "and not another"
again = Bcrypt.hash("correct horse battery staple", 4)
assert_true again != made && again[7, 22] != made[7, 22] && Bcrypt.verify("correct horse battery staple", again), "two hashes of one password, two salts"
assert_true !Bcrypt.verify("correct horse battery staple", made[0, 7] + again[7, 22] + made[29, 31]), "a hash given another salt does not verify"
assert_true !Bcrypt.verify("correct horse battery staple", "$2b$05$" + made[7, 53]), "a hash relabelled with another cost does not verify"
assert_true Bcrypt.verify("correct horse battery staple", "$2y$" + made[4, 56]) && Bcrypt.verify("correct horse battery staple", "$2a$" + made[4, 56]), "$2y$ and $2a$ read as $2b$"
assert_true Bcrypt.hash("x")[0, 7] == "$2b$11$", "the default cost is 11"
assert_true Bcrypt.verify([104_u8, 105_u8], Bcrypt.hash("hi", 4)), "bytes for a string"
# The key is the password and its NUL, cut to 72 bytes: the 72nd byte
# counts, the 73rd does not, and nothing after a NUL does.
seventy_two = "0123456789" * 7 + "ab"
long = Bcrypt.hash(seventy_two, 4)
assert_true Bcrypt.verify(seventy_two + "and the rest is ignored", long), "a password's 73rd byte onwards changes nothing"
assert_true !Bcrypt.verify(seventy_two[0, 71] + "c", long), "its 72nd byte does"
assert_true !Bcrypt.verify(seventy_two[0, 71], long), "nor is it the 71 before it"
assert_true Bcrypt.verify("a", Bcrypt.hash("a\0b", 4)), "a NUL ends the password, as in OpenBSD's"
# A stored hash is data: whatever it is, it does not verify.
assert_true !Bcrypt.verify("", ""), "an empty hash"
assert_true !Bcrypt.verify("correct horse battery staple", made[0, 59]), "a hash one character short"
assert_true !Bcrypt.verify("correct horse battery staple", "$2c$" + made[4, 56]), "a minor letter bcrypt never had"
assert_true !Bcrypt.verify("", "$2b$03$" + made[7, 53]) && !Bcrypt.verify("", "$2b$32$" + made[7, 53]) && !Bcrypt.verify("", "$2b$1x$" + made[7, 53]), "a cost outside 4 to 31, or not a number"
assert_true !Bcrypt.verify("correct horse battery staple", made[0, 7] + "!" + made[8, 52]), "a salt character outside the alphabet"
puts "  hash, verify, the 72-byte key and malformed hashes"

# The vectors jBCrypt and Python's `bcrypt` test against, made with
# OpenBSD's bcrypt: four passwords and the empty one at costs 6 to 12.
puts "\n== bcrypt vectors"
[
  {"", "$2a$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s."},
  {"", "$2a$08$HqWuK6/Ng6sg9gQzbLrgb.Tl.ZHfXLhvt/SgVyWhQqgqcZ7ZuUtye"},
  {"", "$2a$10$k1wbIrmNyFAPwPVPSVa/zecw2BCEnBwVS2GbrmgzxFUOqW9dk4TCW"},
  {"", "$2a$12$k42ZFHFWqBp3vWli.nIn8uYyIkbvYRvodzbfbK18SSsY.CsIQPlxO"},
  {"a", "$2a$06$m0CrhHm10qJ3lXRY.5zDGO3rS2KdeeWLuGmsfGlMfOxih58VYVfxe"},
  {"a", "$2a$08$cfcvVd2aQ8CMvoMpP2EBfeodLEkkFJ9umNEfPD18.hUF62qqlC/V."},
  {"a", "$2a$10$k87L/MF28Q673VKh8/cPi.SUl7MU/rWuSiIDDFayrKk/1tBsSQu4u"},
  {"a", "$2a$12$8NJH3LsPrANStV6XtBakCez0cKHXVxmvxIlcz785vxAIZrihHZpeS"},
  {"abc", "$2a$06$If6bvum7DFjUnE9p2uDeDu0YHzrHM6tf.iqN8.yx.jNN1ILEf7h0i"},
  {"abc", "$2a$08$Ro0CUfOqk6cXEKf3dyaM7OhSCvnwM9s4wIX9JeLapehKK5YdLxKcm"},
  {"abc", "$2a$10$WvvTPHKwdBJ3uk0Z37EMR.hLA2W6N9AEBhEgrAOljy2Ae5MtaSIUi"},
  {"abc", "$2a$12$EXRkfkdmXn2gzds2SSitu.MW9.gAVqa9eLS1//RYtYCmB1eLHg.9q"},
  {"abcdefghijklmnopqrstuvwxyz", "$2a$06$.rCVZVOThsIa97pEDOxvGuRRgzG64bvtJ0938xuqzv18d3ZpQhstC"},
  {"abcdefghijklmnopqrstuvwxyz", "$2a$08$aTsUwsyowQuzRrDqFflhgekJ8d9/7Z3GV3UcgvzQW3J5zMyrTvlz."},
  {"abcdefghijklmnopqrstuvwxyz", "$2a$10$fVH8e28OQRj9tqiDXs1e1uxpsjN0c7II7YPKXua2NAKYvM6iQk7dq"},
  {"abcdefghijklmnopqrstuvwxyz", "$2a$12$D4G5f18o7aMMfwasBL7GpuQWuP3pkrZrOAnqP.bmezbMng.QwJ/pG"},
  {"~!@#$%^&*()      ~!@#$%^&*()PNBFRD", "$2a$06$fPIsBO8qRqkjj273rfaOI.HtSV9jLDpTbZn782DC6/t7qT67P6FfO"},
  {"~!@#$%^&*()      ~!@#$%^&*()PNBFRD", "$2a$08$Eq2r4G/76Wv39MzSX262huzPz612MZiYHVUJe/OcOql2jo4.9UxTW"},
  {"~!@#$%^&*()      ~!@#$%^&*()PNBFRD", "$2a$10$LgfYWkbzEvQ4JakH7rOvHe0y8pHKF9OaFgwUZ2q7W2FFZmZzJYlfS"},
  {"~!@#$%^&*()      ~!@#$%^&*()PNBFRD", "$2a$12$WApznUOJfkEGSmYRfnkrPOr466oFDCaj4b6HY3EXGvfxm43seyhgC"},
].each do |vector|
  password, stored = vector
  assert_true Bcrypt.verify(password, stored), "bcrypt vector #{password.inspect} at cost #{stored[4, 2]}"
  # Read again as $2b$, and against another password, at the cheapest
  # cost only: a cost-12 hash is a few hundred milliseconds each time.
  if stored[4, 2] == "06"
    assert_true Bcrypt.verify(password, "$2b$" + stored[4, 56]), "bcrypt vector #{password.inspect} at cost 06, as $2b$"
    assert_true !Bcrypt.verify(password + "x", stored), "bcrypt vector #{password.inspect} at cost 06, another password"
  end
end
puts "  20 vectors, costs 6 to 12"

puts "\nALL CHECKS PASSED"
