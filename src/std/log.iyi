# Levelled logging with named sources.
#
# `Log.info "started"` writes an `Entry` — source, severity, message and
# the UTC instant it was made — through the root logger's backend.
# `Log.for("db.pool")` answers the logger for that source: a child of
# `db`, which is a child of the root, and the same object every time the
# name is asked for. A logger with no level or backend of its own uses
# its parent's, so `Log.setup(level, backend)` reconfigures the root in
# place and every logger already handed out follows it; a child given
# its own `level=` or `backend=` keeps that until it is set back to nil.
#
# Severities in order: Trace, Debug, Info, Notice, Warn, Error, Fatal, and
# None to silence a logger. An entry below the logger's level is dropped
# before its message is built, so `log.debug { expensive }` costs nothing
# when Debug is off. The default level is Info.
#
# Backends: `IOBackend` writes each entry to an IO through a `Formatter`
# (`DefaultFormatter`: `2024-02-29T15:30:45.123456Z INFO - source: message`,
# and `... INFO - message` at the root, the source and its `: ` left
# off); `MemoryBackend` keeps the entries for a test to read back. A
# `Backend` of your own is a class with `write(entry)` and `close`.
#
# Logging is synchronous: the entry is written before the call returns,
# in the calling thread, with no queue between.
#
# **Data.** An entry carries keys and values besides its message, from
# three places, each over the one before:
#
#     Log.with_context(request_id: id) do      # every entry in this task
#       db = Log.for("db").bind(pool: "main")  # every entry of a logger
#       db.info("query", rows: 3)              # one entry
#     end
#
# `with_context` holds for the block, in the task that runs it and in the
# tasks it starts, which find their starter's context while it is open -
# where the other library's new fiber starts with none. `DefaultFormatter`
# writes the data after the message, `... - db: query -- request_id=7
# pool=main rows=3`, a value with a space, quote or `=` in it quoted.
#
# `Log.setup_from_env` sets the root's level from `LOG_LEVEL`.

module std/log

import std/time::{Time}
import std/tuple
import std/mutex::{Mutex}

pub enum Severity
  Trace  = 0
  Debug  = 1
  Info   = 2
  Notice = 3
  Warn   = 4
  Error  = 5
  Fatal  = 6
  None   = 7

  def label : String
    case value
    when 0 then "TRACE"
    when 1 then "DEBUG"
    when 2 then "INFO"
    when 3 then "NOTICE"
    when 4 then "WARN"
    when 5 then "ERROR"
    when 6 then "FATAL"
    else        "NONE"
    end
  end

  # The severity named by *name*, case-insensitively, or nil: what a
  # `LOG_LEVEL` variable holds.
  def self.parse?(name : String) : Severity?
    case name.downcase
    when "trace"  then Trace
    when "debug"  then Debug
    when "info"   then Info
    when "notice" then Notice
    when "warn"   then Warn
    when "error"  then Error
    when "fatal"  then Fatal
    when "none"   then None
    else               nil
    end
  end

  def self.parse(name : String) : Severity
    parse?(name) || raise "not a severity: #{name.inspect}"
  end

  def to_s : String
    label
  end

  def <(other : Severity) : Bool
    value < other.value
  end

  def <=(other : Severity) : Bool
    value <= other.value
  end

  def >=(other : Severity) : Bool
    value >= other.value
  end

  def >(other : Severity) : Bool
    value > other.value
  end
end

pub struct Entry
  getter source : String
  getter severity : Severity
  getter message : String
  getter timestamp : Time
  # The task's context, the logger's bound data and the call's own, in
  # that order, a later key's value over an earlier's.
  getter data : Hash(String, String)

  def initialize(@source : String, @severity : Severity, @message : String, @timestamp : Time = Time.utc, @data : Hash(String, String) = {} of String => String)
  end
end

# Keys and values, the newest first: immutable, so a task's context can sit
# in the table every thread reads.
pub class Metadata
  getter key : String
  getter value : String
  getter rest : Metadata?

  def initialize(@key : String, @value : String, @rest : Metadata?)
  end

  # Into *into*, the oldest first, so a later key's value replaces an
  # earlier one's.
  def merge_into(into : Hash(String, String)) : Nil
    if older = @rest
      older.merge_into(into)
    end
    into[@key] = @value
  end

  def to_h : Hash(String, String)
    found = {} of String => String
    merge_into(found)
    found
  end
end

pub abstract class Formatter
  abstract def format(entry : Entry) : String

  def format(entry : Entry, io : IO) : Nil
    io.write(format(entry))
    io.write("\n")
  end
end

pub class DefaultFormatter < Formatter
  def format(entry : Entry) : String
    head = "#{entry.timestamp.to_rfc3339(6)} #{entry.severity.label}"
    text = entry.source.empty? ? "#{head} - #{entry.message}" : "#{head} - #{entry.source}: #{entry.message}"
    return text if entry.data.empty?
    pairs = [] of String
    entry.data.each { |key, value| pairs << "#{key}=#{quoted(value)}" }
    "#{text} -- #{pairs.join(" ")}"
  end

  # A value as it is, unless a reader could not tell where it ends.
  private def quoted(value : String) : String
    plain = !value.empty? && !value.includes?(" ") && !value.includes?("\"") && !value.includes?("=") && !value.includes?("\n")
    plain ? value : value.inspect
  end
end

pub abstract class Backend
  abstract def write(entry : Entry) : Nil
  abstract def close : Nil
end

pub class IOBackend < Backend
  property formatter : Formatter
  getter io : IO

  def initialize(@io : IO, @formatter : Formatter = DefaultFormatter.new)
  end

  def write(entry : Entry) : Nil
    @formatter.format(entry, @io)
    @io.flush
  end

  def close : Nil
    @io.flush
  end
end

pub class MemoryBackend < Backend
  property formatter : Formatter
  getter entries : Array(Entry)

  def initialize(@formatter : Formatter = DefaultFormatter.new)
    @entries = [] of Entry
  end

  def write(entry : Entry) : Nil
    @entries << entry
  end

  def close : Nil
  end

  # The entries as the formatter would have written them.
  def output : Array(String)
    @entries.map { |e| @formatter.format(e) }
  end

  def clear : Nil
    @entries = [] of Entry
  end
end

pub class Logger
  getter source : String
  @level : Severity?
  @backend : Backend?
  @parent : Logger?
  @children : Hash(String, Logger)
  # What `bind` gave this logger, on every entry it and its children write.
  @bound : Metadata?

  def initialize(@source : String, level : Severity? = nil, backend : Backend? = nil, parent : Logger? = nil, bound : Metadata? = nil)
    @level = level
    @backend = backend
    @parent = parent
    @children = Hash(String, Logger).new
    @bound = bound
  end

  # A logger for the same source, its level and backend this one's, whose
  # entries all carry *data*: a request's id, a connection's peer.
  def bind(**data) : Logger
    node = @bound
    data.each { |key, value| node = Metadata.new(key.to_s, value.to_s, node) }
    Logger.new(@source, nil, nil, self, node)
  end

  # This logger's own level, or the nearest ancestor's; Info at a root
  # never given one.
  def level : Severity
    if l = @level
      l
    elsif p = @parent
      p.level
    else
      Severity::Info
    end
  end

  # nil hands the decision back to the parent.
  def level=(lvl : Severity?) : Nil
    @level = lvl
  end

  def own_level : Severity?
    @level
  end

  # This logger's own backend, or the nearest ancestor's; nil silences.
  def backend : Backend?
    if b = @backend
      b
    elsif p = @parent
      p.backend
    else
      nil
    end
  end

  def backend=(b : Backend?) : Nil
    @backend = b
  end

  def own_backend : Backend?
    @backend
  end

  # The logger for *child_name* under this one, created on first ask;
  # `"a.b"` is the child `b` of the child `a`.
  def for(child_name : String) : Logger
    return self if child_name.empty?

    parts = child_name.split('.')
    current = self
    parts.each do |part|
      current = current.get_or_create_child(part)
    end
    current
  end

  protected def get_or_create_child(name : String) : Logger
    if child = @children[name]?
      return child
    end

    # Only the root drops the dot: a child named "" under it has an empty
    # source too, and `Log.for(".a")` answered "a", the source of another
    # logger.
    child_source = @parent.nil? && @source.empty? ? name : "#{@source}.#{name}"
    child = Logger.new(child_source, nil, nil, self)
    @children[name] = child
    child
  end

  # None is a level and not a severity: an entry logged at None was
  # written by a logger set to None, the one level meant to write nothing.
  def log(severity : Severity, message : String, **data) : Nil
    return if severity < level || severity == Severity::None
    if b = backend
      b.write(Entry.new(@source, severity, message, Time.utc, entry_data(data)))
    end
  end

  def log(severity : Severity, **data, &block : -> String) : Nil
    return if severity < level || severity == Severity::None
    if b = backend
      b.write(Entry.new(@source, severity, block.call, Time.utc, entry_data(data)))
    end
  end

  private def entry_data(data) : Hash(String, String)
    found = Log.context
    bound_into(found)
    data.each { |key, value| found[key.to_s] = value.to_s }
    found
  end

  # The data `bind` gave this logger and its parents, the root's first.
  protected def bound_into(found : Hash(String, String)) : Nil
    if parent = @parent
      parent.bound_into(found)
    end
    if node = @bound
      node.merge_into(found)
    end
  end

  def trace(message : String, **data) : Nil
    log(Severity::Trace, message, **data)
  end

  def trace(**data, &b : -> String) : Nil
    log(Severity::Trace, **data, &b)
  end

  def debug(message : String, **data) : Nil
    log(Severity::Debug, message, **data)
  end

  def debug(**data, &b : -> String) : Nil
    log(Severity::Debug, **data, &b)
  end

  def info(message : String, **data) : Nil
    log(Severity::Info, message, **data)
  end

  def info(**data, &b : -> String) : Nil
    log(Severity::Info, **data, &b)
  end

  def notice(message : String, **data) : Nil
    log(Severity::Notice, message, **data)
  end

  def notice(**data, &b : -> String) : Nil
    log(Severity::Notice, **data, &b)
  end

  def warn(message : String, **data) : Nil
    log(Severity::Warn, message, **data)
  end

  def warn(**data, &b : -> String) : Nil
    log(Severity::Warn, **data, &b)
  end

  def error(message : String, **data) : Nil
    log(Severity::Error, message, **data)
  end

  def error(**data, &b : -> String) : Nil
    log(Severity::Error, **data, &b)
  end

  def fatal(message : String, **data) : Nil
    log(Severity::Fatal, message, **data)
  end

  def fatal(**data, &b : -> String) : Nil
    log(Severity::Fatal, **data, &b)
  end

  def trace? : Bool
    level <= Severity::Trace
  end

  def debug? : Bool
    level <= Severity::Debug
  end

  def info? : Bool
    level <= Severity::Info
  end

  def notice? : Bool
    level <= Severity::Notice
  end

  def warn? : Bool
    level <= Severity::Warn
  end

  def error? : Bool
    level <= Severity::Error
  end

  def fatal? : Bool
    level <= Severity::Fatal
  end
end

# The root logger and the calls that go straight to it.
pub class Log
  @@root : Logger?

  def self.root : Logger
    if r = @@root
      r
    else
      logger = Logger.new("", Severity::Info, IOBackend.new(STDOUT))
      @@root = logger
      logger
    end
  end

  # Reconfigures the root in place, so loggers obtained earlier follow.
  def self.setup(level : Severity = Severity::Info, backend : Backend = IOBackend.new(STDOUT)) : Logger
    r = root
    r.level = level
    r.backend = backend
    r
  end

  # `setup`, the level read from *variable* - a severity's name, any case
  # - or *default_level* when it is unset or empty. A name that is no
  # severity is refused, the severities named.
  def self.setup_from_env(default_level : Severity = Severity::Info, backend : Backend = IOBackend.new(STDOUT), variable : String = "LOG_LEVEL") : Logger
    level = default_level
    if name = Program.env(variable)
      unless name.strip.empty?
        level = Severity.parse?(name.strip) || raise "Log.setup_from_env: #{variable}=#{name} is no severity (trace, debug, info, notice, warn, error, fatal or none)"
      end
    end
    setup(level, backend)
  end

  def self.for(source : String) : Logger
    root.for(source)
  end

  # Every task's open contexts, by the task's fiber; how many are open, so
  # a program that opens none never looks.
  @@contexts : Mutex(Hash(UInt64, Metadata)) = Mutex.new { {} of UInt64 => Metadata }
  @@open : Atomic(UInt64) = Atomic(UInt64).new(0_u64)

  # Runs the block with *data* on every entry logged in this task and in
  # the tasks it starts, over the context already open, and answers the
  # block's answer. The context before it is back when the block ends,
  # panic or not.
  def self.with_context(**data, &block : -> R) : R forall R
    id = IyiScheduler.current.object_id
    own = context_of(id)
    node = context_node
    data.each { |key, value| node = Metadata.new(key.to_s, value.to_s, node) }
    @@open.add(1_u64)
    store(id, node)
    defer restore(id, own)
    block.call
  end

  # The data this task's open contexts give an entry, the outermost first.
  def self.context : Hash(String, String)
    found = {} of String => String
    return found if @@open.get == 0_u64
    if node = context_node
      node.merge_into(found)
    end
    found
  end

  # The innermost context open for this task: its own, or the nearest
  # starter's, up the groups that started it.
  private def self.context_node : Metadata?
    fiber = IyiScheduler.current
    while true
      if node = context_of(fiber.object_id)
        return node
      end
      group = fiber.group
      return nil unless group
      fiber = group.owner
    end
  end

  # The table's blocks never park, so a wait for it is another thread's
  # moment, and a cancelled task, which a wait answers Cancelled, asks
  # again.
  private def self.context_of(id : UInt64) : Metadata?
    while true
      found = @@contexts.get { |table| table[id]? }
      return found unless found.is_a?(Cancelled)
    end
  end

  private def self.store(id : UInt64, node : Metadata?) : Nil
    while true
      done = @@contexts.lock do |table|
        if node
          table[id] = node
        else
          table.delete(id)
        end
      end
      return unless done.is_a?(Cancelled)
    end
  end

  private def self.restore(id : UInt64, own : Metadata?) : Nil
    store(id, own)
    @@open.sub(1_u64)
  end

  def self.level : Severity
    root.level
  end

  def self.level=(level : Severity) : Nil
    root.level = level
  end

  def self.backend : Backend?
    root.backend
  end

  def self.backend=(backend : Backend?) : Nil
    root.backend = backend
  end

  def self.trace(msg : String, **data) : Nil
    root.trace(msg, **data)
  end

  def self.trace(**data, &b : -> String) : Nil
    root.trace(**data, &b)
  end

  def self.debug(msg : String, **data) : Nil
    root.debug(msg, **data)
  end

  def self.debug(**data, &b : -> String) : Nil
    root.debug(**data, &b)
  end

  def self.info(msg : String, **data) : Nil
    root.info(msg, **data)
  end

  def self.info(**data, &b : -> String) : Nil
    root.info(**data, &b)
  end

  def self.notice(msg : String, **data) : Nil
    root.notice(msg, **data)
  end

  def self.notice(**data, &b : -> String) : Nil
    root.notice(**data, &b)
  end

  def self.warn(msg : String, **data) : Nil
    root.warn(msg, **data)
  end

  def self.warn(**data, &b : -> String) : Nil
    root.warn(**data, &b)
  end

  def self.error(msg : String, **data) : Nil
    root.error(msg, **data)
  end

  def self.error(**data, &b : -> String) : Nil
    root.error(**data, &b)
  end

  def self.fatal(msg : String, **data) : Nil
    root.fatal(msg, **data)
  end

  def self.fatal(**data, &b : -> String) : Nil
    root.fatal(**data, &b)
  end
end
