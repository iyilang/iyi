lib LibC
  fun exit(status : Int32) : NoReturn
end

def pick(value : Int32, amount : Int64) : Int64
  amount
end

def pick(value : Bool, amount : Int64) : Int64
  amount
end

def either(flag : Bool) : Int32 | Bool
  flag ? 3 : false
end

first = pick(either(true), 7_i32)
second = pick(either(false), 7_i32)
LibC.exit(first == 7_i64 && second == 7_i64 ? 7 : 1)
