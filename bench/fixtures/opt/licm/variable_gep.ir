; iyi-ir 1
source_filename = "variable_gep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @variable_gep(i1 %run, ptr %base, i64 %index, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %element = getelementptr [2 x i64], ptr %base, i64 0, i64 %index
  store ptr %element, ptr %out, align 8
  br label %head
done:
  ret void
}
