; iyi-ir 1
source_filename = "poison_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @poison_keep(i1 %run, ptr %out) {
entry:
  br label %head
head:
  br i1 %run, label %body, label %done
body:
  %unknown = add i64 undef, 1
  %bad = add i64 poison, 1
  %chosen = freeze i64 %bad
  store i64 %unknown, ptr %out, align 8
  store i64 %chosen, ptr %out, align 8
  br label %head
done:
  ret void
}
