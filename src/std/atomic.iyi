# iyi: the weaker atomic verbs, and the bitwise ones, on the prelude's
# `Atomic(T)`.
#
# The prelude's `Atomic(T)` has six verbs and one ordering, sequentially
# consistent, with no parameter to weaken it; it records that a weaker
# spelling arrives "as its own verb rather than a parameter, so a call site
# says what it means". This module is those verbs. Each name carries its
# ordering as a suffix — `add_relaxed`, `get_acquire`, `set_release`,
# `swap_acq_rel`, `compare_and_set_acq_rel` — so the ordering is a constant
# the compiler emits as that one instruction, never a runtime branch, and a
# reader of the call site does not have to look up an argument.
#
# The suffixes: `_relaxed` is atomic and nothing more (LLVM's monotonic);
# `_acquire` is a load nothing after it may move before; `_release` is a
# store nothing before it may move after; `_acq_rel` is both, for a
# read-modify-write. A load has no release half and a store no acquire
# half, so `get` has two weaker spellings and `set` two; the
# read-modify-writes have four. `compare_and_set_*` names the success
# ordering; the failure ordering is the strongest a failed exchange can
# carry (acquire under `_acquire`/`_acq_rel`, relaxed otherwise).
#
# The bitwise verbs `and`, `nand`, `xor`, `max`, `min` are sequentially
# consistent like the prelude's, and answer what the word held before.
# Bitwise or is spelled `bitwise_or`: `.or` is iyi's recovery keyword
# (`expr.or { fallback }`) and cannot be a method name. `max`/`min` pick
# the signed or unsigned instruction from `T` at compile time.
#
# `Atomic.fence` is a full fence; `fence_acquire`, `fence_release` and
# `fence_acq_rel` are the weaker ones. There is no relaxed fence: LLVM
# has none and neither does the hardware.
#
# `T` is what the prelude admits: Int32, Int64, UInt8 or UInt64. There is
# no `Atomic(Bool)` and no flag type here; the prelude refuses the
# instantiation, and a flag is a `UInt8` word with `swap`.

module std/atomic

struct ::Atomic(T)
  # The one instruction the prelude's `IyiAtomic` does not declare: a
  # fence. `ordering` must be a symbol literal at the call site; the
  # public verbs below are the only callers.
  @[Primitive(:fence)]
  private def self.fence_with(ordering : Symbol, singlethread : Bool) : Nil
  end

  # A full fence: nothing crosses it in either direction.
  def self.fence : Nil
    fence_with(:sequentially_consistent, false)
  end

  # Nothing after this fence moves before it.
  def self.fence_acquire : Nil
    fence_with(:acquire, false)
  end

  # Nothing before this fence moves after it.
  def self.fence_release : Nil
    fence_with(:release, false)
  end

  # Both halves, without the total order of `fence`.
  def self.fence_acq_rel : Nil
    fence_with(:acquire_release, false)
  end

  # The word, read once, atomic and nothing more.
  def get_relaxed : T
    IyiAtomic.load(pointerof(@value), :monotonic, false)
  end

  # The word, read once; nothing after the read moves before it.
  def get_acquire : T
    IyiAtomic.load(pointerof(@value), :acquire, false)
  end

  # The word, written once, atomic and nothing more.
  def set_relaxed(value : T) : Nil
    IyiAtomic.store(pointerof(@value), value, :monotonic, false)
  end

  # The word, written once; nothing before the write moves after it.
  def set_release(value : T) : Nil
    IyiAtomic.store(pointerof(@value), value, :release, false)
  end

  # `add`, `sub` and `swap` at each of the four weaker orderings; every one
  # answers what the word held before, as the prelude's do.
  {% for suffix, ordering in {relaxed: :monotonic, acquire: :acquire, release: :release, acq_rel: :acquire_release} %}
    def add_{{suffix}}(value : T) : T
      IyiAtomic.rmw(:add, pointerof(@value), value, {{ordering}}, false)
    end

    def sub_{{suffix}}(value : T) : T
      IyiAtomic.rmw(:sub, pointerof(@value), value, {{ordering}}, false)
    end

    def swap_{{suffix}}(value : T) : T
      IyiAtomic.rmw(:xchg, pointerof(@value), value, {{ordering}}, false)
    end
  {% end %}

  # `compare_and_set` at each weaker ordering: if the word holds
  # `expected` it now holds `desired`; answers what the word held and
  # whether the exchange happened.
  def compare_and_set_relaxed(expected : T, desired : T) : Tuple(T, Bool)
    IyiAtomic.cmpxchg(pointerof(@value), expected, desired, :monotonic, :monotonic)
  end

  def compare_and_set_acquire(expected : T, desired : T) : Tuple(T, Bool)
    IyiAtomic.cmpxchg(pointerof(@value), expected, desired, :acquire, :acquire)
  end

  def compare_and_set_release(expected : T, desired : T) : Tuple(T, Bool)
    IyiAtomic.cmpxchg(pointerof(@value), expected, desired, :release, :monotonic)
  end

  def compare_and_set_acq_rel(expected : T, desired : T) : Tuple(T, Bool)
    IyiAtomic.cmpxchg(pointerof(@value), expected, desired, :acquire_release, :acquire)
  end

  # `word &= value`; answers what the word held before.
  def and(value : T) : T
    IyiAtomic.rmw(:and, pointerof(@value), value, :sequentially_consistent, false)
  end

  # `word = ~(word & value)`; answers what the word held before.
  def nand(value : T) : T
    IyiAtomic.rmw(:nand, pointerof(@value), value, :sequentially_consistent, false)
  end

  # `word |= value`; answers what the word held before.
  def bitwise_or(value : T) : T
    IyiAtomic.rmw(:or, pointerof(@value), value, :sequentially_consistent, false)
  end

  # `word ^= value`; answers what the word held before.
  def xor(value : T) : T
    IyiAtomic.rmw(:xor, pointerof(@value), value, :sequentially_consistent, false)
  end

  # `word = max(word, value)`, signed or unsigned as `T` is; answers what
  # the word held before.
  def max(value : T) : T
    {% if T == UInt8 || T == UInt64 %}
      IyiAtomic.rmw(:umax, pointerof(@value), value, :sequentially_consistent, false)
    {% else %}
      IyiAtomic.rmw(:max, pointerof(@value), value, :sequentially_consistent, false)
    {% end %}
  end

  # `word = min(word, value)`, signed or unsigned as `T` is; answers what
  # the word held before.
  def min(value : T) : T
    {% if T == UInt8 || T == UInt64 %}
      IyiAtomic.rmw(:umin, pointerof(@value), value, :sequentially_consistent, false)
    {% else %}
      IyiAtomic.rmw(:min, pointerof(@value), value, :sequentially_consistent, false)
    {% end %}
  end
end
