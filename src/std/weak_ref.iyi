# Weak Reference class that allows a referenced object to be inspected
# without preventing it from being garbage-collected where supported.

module std/weak_ref

import std/gc

pub class WeakRef(T)
  @target : UInt64

  def initialize(target : T)
    {% raise "Cannot create a WeakRef of a module" if T.module? %}
    ptr = target.as(Void*)
    if GC.is_heap_ptr(ptr)
      @target = ptr.address
    else
      @target = 0_u64
    end
  end

  # Returns the referenced object or Nil if it has been collected.
  def value : T?
    if @target == 0_u64
      nil
    elsif !GC.is_heap_ptr(Pointer(Void).new(@target))
      @target = 0_u64
      nil
    else
      Pointer(Void).new(@target).as(T?)
    end
  end
end
