module compiler/ir/opt/effects

import compiler/ir/inst::{Op, Inst, MemAux, CallAux, IntrinsicAux, AsmAux, Ordering, terminator_op?}
import compiler/ir/function::{Function, Global}
import compiler/ir/intrinsics::{IntrinsicId}
import compiler/ir/module::{Module}

pub def returns_twice_call?(inst : Inst) : Bool
  return false unless inst.op == Op::Call || inst.op == Op::Invoke
  if inst.aux.is_a?(CallAux)
    return true if inst.aux.as(CallAux).fn_attrs.any? { |attr| attr.name == "returns_twice" }
  end
  return false if inst.args.empty? || !inst.args[0].is_a?(Function)
  inst.args[0].as(Function).attrs.any? { |attr| attr.name == "returns_twice" }
end

pub def function_returns_twice?(fn : Function) : Bool
  fn.blocks.each do |block|
    block.insts.each { |inst| return true if returns_twice_call?(inst) }
  end
  false
end

def ordered_memory?(i : Inst) : Bool
  return false unless i.aux.is_a?(MemAux)
  aux = i.aux.as(MemAux)
  aux.volatile || aux.ordering != Ordering::NotAtomic
end

def effectful_intrinsic?(id : IntrinsicId) : Bool
  case id
  when IntrinsicId::Memcpy, IntrinsicId::Memmove, IntrinsicId::Memset,
       IntrinsicId::Trap, IntrinsicId::DebugTrap, IntrinsicId::Assume,
       IntrinsicId::Stacksave, IntrinsicId::Stackrestore, IntrinsicId::VaStart,
       IntrinsicId::VaEnd, IntrinsicId::Readcyclecounter, IntrinsicId::AArch64Hint,
       IntrinsicId::X86Sse2Pause, IntrinsicId::WasmMemoryGrowI32
    true
  else
    false
  end
end

pub def marking_flag_load?(i : Inst) : Bool
  return false unless i.op == Op::Load && !i.args.empty?
  ptr = i.args[0]
  return ptr.as(Global).name == "__iyi_marking" if ptr.is_a?(Global)
  if ptr.is_a?(Inst)
    addr = ptr.as(Inst)
    if addr.op == Op::GlobalAddr && !addr.args.empty? && addr.args[0].is_a?(Global)
      return addr.args[0].as(Global).name == "__iyi_marking"
    end
  end
  false
end

pub def has_side_effects?(i : Inst) : Bool
  return true if i.op == Op::Store # mutation M2: stores have side effects
  return true if terminator_op?(i.op)
  case i.op
  when Op::Load
    ordered_memory?(i)
  when Op::Fence, Op::CmpXchg, Op::AtomicRmw, Op::VaArg, Op::Call,
       Op::LandingPad, Op::CatchPad, Op::CleanupPad
    true
  when Op::Intrinsic
    return true unless i.aux.is_a?(IntrinsicAux)
    effectful_intrinsic?(i.aux.as(IntrinsicAux).id)
  else
    false
  end
end

pub def reads_memory?(i : Inst) : Bool
  case i.op
  when Op::Load, Op::Fence, Op::CmpXchg, Op::AtomicRmw, Op::VaArg, Op::Call, Op::Invoke
    true
  when Op::Intrinsic
    return true unless i.aux.is_a?(IntrinsicAux)
    case i.aux.as(IntrinsicAux).id
    when IntrinsicId::Memcpy, IntrinsicId::Memmove, IntrinsicId::Stacksave,
         IntrinsicId::Stackrestore, IntrinsicId::VaStart, IntrinsicId::VaEnd,
         IntrinsicId::WasmMemoryGrowI32, IntrinsicId::Frameaddress, IntrinsicId::Returnaddress
      true
    else
      false
    end
  else
    false
  end
end

pub def writes_memory?(i : Inst) : Bool
  case i.op
  when Op::Store, Op::Fence, Op::CmpXchg, Op::AtomicRmw, Op::VaArg, Op::Call, Op::Invoke
    true
  when Op::Intrinsic
    return true unless i.aux.is_a?(IntrinsicAux)
    case i.aux.as(IntrinsicAux).id
    when IntrinsicId::Memcpy, IntrinsicId::Memmove, IntrinsicId::Memset,
         IntrinsicId::Stackrestore, IntrinsicId::VaStart, IntrinsicId::VaEnd,
         IntrinsicId::WasmMemoryGrowI32
      true
    else
      false
    end
  else
    false
  end
end

pub def opaque?(i : Inst) : Bool
  case i.op
  when Op::Load
    ordered_memory?(i) || marking_flag_load?(i)
  when Op::Store
    ordered_memory?(i)
  when Op::Fence, Op::CmpXchg, Op::AtomicRmw, Op::VaArg, Op::Call, Op::Invoke,
       Op::ThreadLocalAddr, Op::ThreadPointer, Op::LandingPad, Op::CatchPad, Op::CleanupPad
    true
  when Op::Intrinsic
    return true unless i.aux.is_a?(IntrinsicAux)
    id = i.aux.as(IntrinsicAux).id
    effectful_intrinsic?(id) || id == IntrinsicId::Frameaddress || id == IntrinsicId::Returnaddress
  else
    false
  end
end

pub def pure?(i : Inst) : Bool
  return false if i.op == Op::Alloca || i.op == Op::Freeze || i.op == Op::Phi
  !has_side_effects?(i) && !reads_memory?(i) && !writes_memory?(i) && !opaque?(i)
end

pub def runtime_entry?(f : Function) : Bool
  case f.name
  when "__iyi_new", "__iyi_malloc64", "__iyi_malloc_atomic64", "__iyi_realloc64",
       "__iyi_write_barrier_begin", "__iyi_write_barrier"
    true
  else
    false
  end
end

# Bytes that continue an identifier. A name next to one of them is part of a
# longer symbol. A name next to `@`, `+`, `,`, `.` or a bracket is whole.
pub def identifier_byte?(b : UInt8) : Bool
  (b >= 48_u8 && b <= 57_u8) || (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8) || b == 95_u8
end

# Whether *form* occurs in an assembly template as a whole symbol.
def whole_symbol_in?(text : String, form : String) : Bool
  return false if form.bytesize == 0
  start = 0
  while true
    at = text.byte_index(form, start)
    break unless at
    after = at + form.bytesize
    before_ok = at == 0 || !identifier_byte?(text.byte_at(at - 1))
    after_ok = after >= text.bytesize || !identifier_byte?(text.byte_at(after))
    return true if before_ok && after_ok
    start = at + 1
  end
  false
end

# The functions an inline-assembly template names as a whole symbol, either as
# the name or with Mach-O's leading underscore. `___iyi_fiber_main@PAGE` names
# `___iyi_fiber_main` and not `main`.
pub def asm_named_functions(mod : Module) : Hash(Function, Bool)
  templates = [] of String
  mod.functions.each do |fn|
    fn.blocks.each do |block|
      block.insts.each do |inst|
        assembly = nil.as(AsmAux?)
        if inst.aux.is_a?(AsmAux)
          assembly = inst.aux.as(AsmAux)
        elsif !inst.args.empty? && inst.args[0].is_a?(Inst)
          target = inst.args[0].as(Inst)
          assembly = target.aux.as(AsmAux) if target.aux.is_a?(AsmAux)
        end
        if inline_asm = assembly
          templates << inline_asm.template
        end
      end
    end
  end
  named = Hash(Function, Bool).new
  mod.functions.each do |fn|
    k = 0
    while k < templates.size && !named.has_key?(fn)
      if whole_symbol_in?(templates[k], fn.name) || whole_symbol_in?(templates[k], "_" + fn.name)
        named[fn] = true
      end
      k = k + 1
    end
  end
  named
end
