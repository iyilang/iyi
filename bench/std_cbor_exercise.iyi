[{"17", 23_i64}, {"1818", 24_i64}, {"18ff", 255_i64}, {"190100", 256_i64}, {"19ffff", 65535_i64}, {"1a00010000", 65536_i64},
 {"1affffffff", 4294967295_i64}, {"1b0000000100000000", 4294967296_i64}, {"1b7fffffffffffffff", 9223372036854775807_i64},
 {"37", -24_i64}, {"3818", -25_i64}, {"38ff", -256_i64}, {"390100", -257_i64}, {"39ffff", -65536_i64}, {"3a00010000", -65537_i64},
 {"3affffffff", -4294967296_i64}, {"3b0000000100000000", -4294967297_i64}, {"3b7fffffffffffffff", -9223372036854775807_i64 - 1_i64}].each do |pair|
  assert_str(pair[0], hex(CBOR.encode(Any.new(pair[1]))), "the integer #{pair[1]} encodes in its shortest head")
  assert_true(decoded(unhex(pair[0]), "an integer at an edge").as_i == pair[1], "#{pair[0]} decodes to #{pair[1]}")
end
assert_true(Any.new(CBORBignum.new(true, [] of UInt8)) == decoded(unhex("20"), "-1"), "a negative bignum of magnitude 0 is -1")
[{"c240", "0", "00"}, {"c24101", "1", "01"}, {"c243000001", "1", "01"}, {"c340", "-1", "20"}, {"c34100", "-1", "20"},
 {"c248ffffffffffffffff", "18446744073709551615", "1bffffffffffffffff"}, {"c348ffffffffffffffff", "-18446744073709551616", "3bffffffffffffffff"},
 {"c2487fffffffffffffff", "9223372036854775807", "1b7fffffffffffffff"}, {"c3487fffffffffffffff", "-9223372036854775808", "3b7fffffffffffffff"},
 {"c24a00010000000000000000", "18446744073709551616", "c249010000000000000000"}, {"c25f4101420000ff", "65536", "1a00010000"},
 {"c3581e" + "ff" * 30, "-1766847064778384329583297500742918515827483896875618958121606201292619776", "c3581e" + "ff" * 30}].each do |example|
  v = decoded(unhex(example[0]), "a bignum")
  assert_str(example[1], v.to_s, "the bignum #{example[0]} is the integer #{example[1]}")
  assert_str(example[2], hex(CBOR.encode(v)), "the integer #{example[1]} encodes in its preferred form")
  assert_true(v == decoded(unhex(example[2]), "the preferred form") && v.hash == decoded(unhex(example[2]), "the preferred form").hash, "a bignum equals the integer of its value: #{example[0]}")
  puts "VARIANT #{example[0]}\t#{example[2]}\t#{example[1]}"
end
big = decoded(unhex("c249010000000000000000"), "2^64")
assert_true(big.as_i?.nil? && big.as_u64?.nil? && big.as_big.magnitude.size == 9 && !big.as_big.negative?, "2^64 is past Int64 and UInt64")
assert_true(decoded(unhex("1bffffffffffffffff"), "2^64 - 1").as_u64 == 18446744073709551615_u64, "2^64 - 1 is a UInt64")
assert_true(decoded(unhex("3bffffffffffffffff"), "-2^64").as_big.negative? && decoded(unhex("20"), "-1").as_u64?.nil?, "a negative integer is no UInt64")
assert_str("the integer 18446744073709551616 does not fit an Int64", panic_of(-> { big.as_i.to_s }), "as_i of a bignum is refused by name")
assert_true(Any.new(CBORBignum.new(false, [0_u8, 0_u8, 5_u8])).raw.is_a?(Int64), "a bignum in the Int64 range is held as an Int64")
puts "  every width's edge in its shortest head, both signs; bignums with leading zeros, chunked or fitting 64 bits read as the integers they are"

puts "== floats, every width"
[{1.0, "f93c00"}, {5.5, "f94580"}, {5555.5, "fa45ad9c00"}, {1000000.5, "fa49742408"}, {65504.0, "f97bff"}, {65505.0, "fa477fe100"},
 {65520.0, "fa477ff000"}, {f64(0x3E70000000000000_u64), "f90001"}, {f64(0x3E60000000000000_u64), "fa33000000"},
 {f64(0x3F10000000000000_u64), "f90400"}, {f64(0x36A0000000000000_u64), "fa00000001"}, {f64(0x3690000000000000_u64), "fb3690000000000000"},
 {f64(0x3810000000000000_u64), "fa00800000"}, {f64(0x380FFFFFC0000000_u64), "fa007fffff"}, {f64(0x380FFFFFE0000000_u64), "fb380fffffe0000000"}, {f64(0x47EFFFFFE0000000_u64), "fa7f7fffff"},
 {f64(0x47EFFFFFF0000000_u64), "fb47effffff0000000"}, {f64(0x0000000000000001_u64), "fb0000000000000001"}, {-2.0, "f9c000"},
 {f64(0x7FF4000000000000_u64), "f97d00"}, {f64(0x7FF0000000000001_u64), "fb7ff0000000000001"}, {f64(0x7FF8000020000000_u64), "fa7fc00001"},
 {f64(0xFFF8000000000000_u64), "f9fe00"}, {f64(0x7FF8000000000001_u64), "fb7ff8000000000001"}, {f64(0x7FF0040000000000_u64), "f97c01"},
 {f64(0x7FF0000020000000_u64), "fa7f800001"}].each do |pair|
  bits = IyiFloatText.bits_of(pair[0])
  assert_str(pair[1], hex(CBOR.encode(Any.new(pair[0]))), "the float with bits #{bits.to_s(16)} encodes in the shortest width that holds it")
  back = decoded(unhex(pair[1]), "a float")
  assert_true(IyiFloatText.bits_of(back.as_f) == bits, "#{pair[1]} decodes to the same 64 bits, payload and sign")
  puts "CORPUS #{pair[1]}\t#{back}"
end
assert_true(Any.new(0.0) != Any.new(-0.0) && Any.new(0.0 / 0.0) == decoded(unhex("fb7ff8000000000000"), "NaN"), "0.0 and -0.0 are two values; NaN is the NaN with its bits")
assert_true(Any.new(f64(0x7FF4000000000000_u64)) != Any.new(0.0 / 0.0), "NaNs with other payloads are other values")
assert_true(Any.new(1) != Any.new(1.0) && Any.new(1).as_f == 1.0, "1 and 1.0 are two values; as_f widens the integer")
puts "  section 4.1's examples, every width's edges and subnormals, NaN payloads kept and shortened only when what they drop is zero"

puts "== deterministic encoding"
