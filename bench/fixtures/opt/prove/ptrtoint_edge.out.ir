; iyi-ir 1
source_filename = "ptrtoint_edge"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @ptrtoint_edge(ptr %p) {
entry:
  %raw = ptrtoint ptr %p to i64
  %below = icmp slt i64 %raw, 0
  br i1 %below, label %yes, label %no
yes:
  ret i1 false
no:
  ret i1 false
}
