; iyi-ir 1
module "fixed_staging"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @staged(i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8, i64 %a9, i64 %a10, i64 %a11) {
entry:
  %pair = call { i64, i64 } (i64, i64) asm sideeffect "mov $0, $2; mov $1, $3", "=r,=r,{x10},{x11}"(i64 %a10, i64 %a11)
  %left = extractvalue { i64, i64 } %pair, 0
  %right = extractvalue { i64, i64 } %pair, 1
  %r = add i64 %left, %right
  ret i64 %r
}

define i32 @main() {
entry:
  %r = call i64 (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) @staged(i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 8, i64 9, i64 11, i64 23)
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i64 %r)
  ret i32 0
}
