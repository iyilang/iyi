; iyi-ir 1
source_filename = "wide_integer_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @wide_integer_keep(i128 %x) {
entry:
  %value = and i128 %x, 7
  %test = icmp slt i128 %value, 8
  ret i1 %test
}
