; iyi-ir 1
source_filename = "overflow_flag_unused"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @overflow_flag_unused(i32 %a, i32 %b) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %a, i32 %b)
  %value = extractvalue { i32, i1 } %pair, 0
  ret i32 %value
}
