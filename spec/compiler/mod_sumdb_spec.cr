require "spec"
require "json"
require "file/tempfile"
require "file_utils"
require "../../src/compiler/iyi/mod/sumdb/client"

# Apache-2.0 Wycheproof vectors copied unmodified from C2SP/wycheproof
# 65ca494727a52944c204441c860b039e6786b99b, testvectors_v1/ed25519_test.json.
# Go fixtures are generated by fixtures/sumdb/generator with x/mod v0.29.0.
private def fixture_json(text : String, name : String) : JSON::Any
  raise "sumdb fixture #{name} contains CR bytes; check Git line-ending settings" if text.includes?('\r')
  JSON.parse(text)
end

private def golden : JSON::Any
  fixture_json(File.read(File.join(__DIR__, "fixtures/sumdb/golden.json")), "golden.json")
end

private def wycheproof : JSON::Any
  fixture_json(File.read(File.join(__DIR__, "fixtures/sumdb/wycheproof_ed25519.json")), "wycheproof_ed25519.json")
end

private def proof(value : JSON::Any) : Array(Bytes)
  value.as_a.map { |hash| Base64.decode(hash.as_s) }
end

private def keys(data : JSON::Any) : Array(Iyi::Mod::SumDB::Verifier)
  [Iyi::Mod::SumDB::Verifier.new(data["verifier"].as_s)]
end

private def with_cache(&block : String ->)
  root = File.tempname("sumdb-spec", nil)
  dir = File.join(root, "cache space", "checkpoint-\u00e9")
  Dir.mkdir_p(dir)
  begin
    yield File.join(dir, "latest")
  ensure
    FileUtils.rm_rf(root)
  end
end

describe Iyi::Mod::SumDB do
  it "refuses a CRLF-mangled fixture before parsing" do
    raw = File.read(File.join(__DIR__, "fixtures/sumdb/golden.json"))
    fixture_json(raw, "golden.json")["go_module"].as_s.should eq "golang.org/x/mod v0.29.0"
    expect_raises(Exception, /sumdb fixture golden.json contains CR bytes/) do
      fixture_json(raw.gsub("\n", "\r\n"), "golden.json")
    end
  end

  it "hashes SHA-512 vectors across a block boundary" do
    Crystal::Digest::SHA512.hexdigest("abc").should eq "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    digest = Crystal::Digest::SHA512.new
    digest.update("a" * 127)
    digest.update("a")
    digest.hexfinal.should eq "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321"
  end

  describe Iyi::Mod::SumDB::Ed25519 do
    it "verifies the RFC 8032 Ed25519 test vectors including the 1023-byte message" do
      found = [] of Int64
      wycheproof["testGroups"].as_a.each do |group|
        key = group["publicKey"]["pk"].as_s.hexbytes
        group["tests"].as_a.each do |test|
          id = test["tcId"].as_i64
          next unless id.in?({80_i64, 81_i64, 82_i64, 83_i64})
          Iyi::Mod::SumDB::Ed25519.verify(key, test["msg"].as_s.hexbytes, test["sig"].as_s.hexbytes).should be_true
          found << id
        end
      end
      found.sort.should eq [80_i64, 81_i64, 82_i64, 83_i64]
      public_key = "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf".hexbytes
      message = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f".hexbytes
      signature = "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704".hexbytes
      Iyi::Mod::SumDB::Ed25519.verify(public_key, message, signature).should be_true
      signature[0] ^= 1
      Iyi::Mod::SumDB::Ed25519.verify(public_key, message, signature).should be_false
    end

    it "accepts every valid and refuses every invalid Wycheproof Ed25519 vector" do
      valid = 0
      invalid = 0
      acceptable = 0
      wycheproof["testGroups"].as_a.each do |group|
        key = group["publicKey"]["pk"].as_s.hexbytes
        group["tests"].as_a.each do |test|
          result = test["result"].as_s
          actual = Iyi::Mod::SumDB::Ed25519.verify(key, test["msg"].as_s.hexbytes, test["sig"].as_s.hexbytes)
          if result == "acceptable"
            if test["flags"].as_a.any? { |flag| flag.as_s == "SmallOrderPublicKey" }
              raise "Wycheproof tcId #{test["tcId"]}: accepted a small-order key" if actual
            end
            acceptable += 1
            next
          end
          expected = result == "valid"
          unless actual == expected
            raise "Wycheproof tcId #{test["tcId"]}: expected #{result}, got #{actual}"
          end
          if expected
            valid += 1
          else
            invalid += 1
          end
        end
      end
      valid.should eq 117
      invalid.should eq 64
      acceptable.should eq 29
    end

    it "rejects non-canonical point and scalar encodings and small-order keys" do
      p = "edffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f".hexbytes
      zero_signature = Bytes.new(64, 0_u8)
      Iyi::Mod::SumDB::Ed25519.verify(p, Bytes.empty, zero_signature).should be_false
      identity = Bytes.new(32, 0_u8)
      identity[0] = 1_u8
      Iyi::Mod::SumDB::Ed25519.verify(identity, Bytes.empty, zero_signature).should be_false
      valid_key = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a".hexbytes
      order = "edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010".hexbytes
      zero_signature[32, 32].copy_from(order)
      Iyi::Mod::SumDB::Ed25519.verify(valid_key, Bytes.empty, zero_signature).should be_false
    end
  end

  describe "signed notes" do
    it "verifies the C2SP example and rejects a changed text or unknown key" do
      key = Iyi::Mod::SumDB::Verifier.new("example.com/foo+530d903a+AekyeRrm56hApGFkyQR4ZCbV54Id2LKaANYcrnKv3U2k")
      text = "This is an example message.\n"
      signed = text + "\n\u2014 example.com/foo Uw2QOkn8srV1yJGh2VYRlL1Tnagv1YEq6TfXppzi2ONncAlTgK7Ztg1ERYNZXsYjOBH3mFXmRKuwHjG1Yu72IneyaQM=\n"
      Iyi::Mod::SumDB::Note.open(signed, [key]).should eq text
      expect_raises(Iyi::Mod::SumDB::Error, /signed note contains CR; expected LF/) do
        Iyi::Mod::SumDB::Note.open(signed.gsub("\n", "\r\n"), [key])
      end
      expect_raises(Iyi::Mod::SumDB::Error, /invalid signature/) do
        Iyi::Mod::SumDB::Note.open(signed.sub("example message", "altered message"), [key])
      end
      expect_raises(Iyi::Mod::SumDB::Error, /no trusted signature/) do
        Iyi::Mod::SumDB::Note.open(signed, [] of Iyi::Mod::SumDB::Verifier)
      end
      expect_raises(Iyi::Mod::SumDB::Error, /base64/) do
        Iyi::Mod::SumDB::Note.open(signed.sub("IneyaQM=", "IneyaQN="), [key])
      end
      expect_raises(Iyi::Mod::SumDB::Error, /ambiguous verifier/) do
        Iyi::Mod::SumDB::Note.open(signed, [key, key])
      end
    end

    it "reads every Go-signed checkpoint and rejects an origin mismatch" do
      data = golden
      data["checkpoints"].as_h.each do |size, note|
        cp = Iyi::Mod::SumDB::Checkpoint.open(note.as_s, keys(data), "sum.iyi.dev")
        cp.size.should eq size.to_i64
        cp.root.should eq Base64.decode(data["roots"][size].as_s)
      end
      expect_raises(Iyi::Mod::SumDB::Error, /no trusted signature/) do
        Iyi::Mod::SumDB::Checkpoint.open(data["checkpoints"]["513"].as_s, keys(data), "different.example")
      end
      expect_raises(Iyi::Mod::SumDB::Error, /origin/) do
        Iyi::Mod::SumDB::Checkpoint.open(data["foreign_origin"].as_s, keys(data), "sum.iyi.dev")
      end
    end
  end

  describe "RFC 6962 proofs" do
    it "checks Go inclusion and consistency proofs across tile boundaries" do
      data = golden
      data["record_proofs"].as_h.each do |size, cases|
        cases.as_h.each do |index, nodes|
          result = Iyi::Mod::SumDB::TLog.check_inclusion(size.to_i64, index.to_i64,
            data["records"][index].as_s.to_slice, Base64.decode(data["roots"][size].as_s), proof(nodes))
          raise "Go inclusion failed at #{size}, #{index}" unless result
        end
      end
      data["tree_proofs"].as_h.each do |new_size, cases|
        cases.as_h.each do |old_size, nodes|
          result = Iyi::Mod::SumDB::TLog.check_consistency(old_size.to_i64, Base64.decode(data["roots"][old_size].as_s),
            new_size.to_i64, Base64.decode(data["roots"][new_size].as_s), proof(nodes))
          raise "Go consistency failed at #{old_size}, #{new_size}" unless result
        end
      end
      empty = Iyi::Mod::SumDB::TLog.empty
      no_proof = [] of Bytes
      Iyi::Mod::SumDB::TLog.check_consistency(0_i64, empty, 0_i64, empty, no_proof).should be_true
      Iyi::Mod::SumDB::TLog.check_consistency(0_i64, empty, 0_i64, Bytes.new(32, 0_u8), no_proof).should be_false
    end

    it "verifies complete Go tiles, refusing even an altered unused tile hash" do
      data = golden
      root = Base64.decode(data["roots"]["513"].as_s)
      tile_data = data["tiles"]["513"]
      tiles = Iyi::Mod::SumDB::TLog::Tiles.new(513_i64, root) { |path| Base64.decode(tile_data[path].as_s) }
      tiles.verify_record(260_i64, data["records"]["260"].as_s.to_slice)
      tiles.verify_consistency(257_i64, Base64.decode(data["roots"]["257"].as_s))
      corrupted = Iyi::Mod::SumDB::TLog::Tiles.new(513_i64, root) do |path|
        bytes = Base64.decode(tile_data[path].as_s)
        bytes[4 * 32] ^= 1_u8 if path == "tile/8/0/001"
        bytes
      end
      expect_raises(Iyi::Mod::SumDB::Error, /inconsistent tile/) do
        corrupted.verify_record(260_i64, data["records"]["260"].as_s.to_slice)
      end
      expect_raises(Iyi::Mod::SumDB::Error, /record inclusion/) do
        tiles.verify_record(260_i64, data["records"]["260"].as_s.sub("pack0260", "pack0261").to_slice)
      end
    end

    it "reads level-two and grouped Go tile paths in a large tree" do
      data = golden
      tile_data = data["tiles"]["256003"]
      requested = [] of String
      tiles = Iyi::Mod::SumDB::TLog::Tiles.new(256003_i64, Base64.decode(data["roots"]["256003"].as_s)) do |path|
        requested << path
        Base64.decode(tile_data[path].as_s)
      end
      tiles.verify_record(256002_i64, data["records"]["256002"].as_s.to_slice)
      requested.should contain("tile/8/0/x001/000.p/3")
      requested.should contain("tile/8/2/000.p/3")
    end

    it "keeps tile indices above 32 bits and splits the largest signed size" do
      Iyi::Mod::SumDB::TLog.split(Int64::MAX).should eq(1_i64 << 62)
      size = (1_i64 << 40) + 3
      paths = [] of String
      tiles = Iyi::Mod::SumDB::TLog::Tiles.new(size, Bytes.new(32)) do |path|
        paths << path
        raise Iyi::Mod::SumDB::Error.new("tile path captured")
      end
      expect_raises(Iyi::Mod::SumDB::Error, /tile path captured/) do
        tiles.verify_record(size - 1, Bytes.empty)
      end
      paths.should eq ["tile/8/0/x004/x294/x967/296.p/3"]
    end
  end

  describe "client checkpoint cache" do
    it "verifies the lookup, persists the checkpoint, and refuses a signed fork" do
      data = golden
      with_cache do |path|
        cache = Iyi::Mod::SumDB::Cache.new(path, keys(data), "sum.iyi.dev")
        client = Iyi::Mod::SumDB::Client.new(cache, keys(data), "sum.iyi.dev")
        tile_data = data["tiles"]["513"]
        expected = Iyi::Mod::SumDB::Record.parse(data["records"]["260"].as_s)
        expect_raises(Iyi::Mod::SumDB::Error, /record contains CR; expected LF/) do
          Iyi::Mod::SumDB::Record.parse(expected.text.gsub("\n", "\r\n"))
        end
        expect_raises(Iyi::Mod::SumDB::Error, /lookup contains CR; expected LF/) do
          client.verify_lookup(data["lookup"].as_s.gsub("\n", "\r\n"), expected.path, expected.version, expected.archive_hash) { |tile| Base64.decode(tile_data[tile].as_s) }
        end
        record = client.verify_lookup(data["lookup"].as_s, expected.path, expected.version, expected.archive_hash) do |tile|
          Base64.decode(tile_data[tile].as_s)
        end
        record.text.should eq expected.text
        Iyi::Mod::SumDB::Cache.new(path, keys(data), "sum.iyi.dev").latest.not_nil!.size.should eq 513
        expect_raises(Iyi::Mod::SumDB::Error, /wrong record/) do
          client.verify_lookup(data["lookup"].as_s, "example.test/wrong", expected.version, expected.archive_hash) { |tile| Base64.decode(tile_data[tile].as_s) }
        end
        expect_raises(Iyi::Mod::SumDB::Error, /forked checkpoint/) do
          cache.observe(data["fork"].as_s) { |tile| Base64.decode(tile_data[tile].as_s) }
        end
        cache.latest.not_nil!.root.should eq Base64.decode(data["roots"]["513"].as_s)
      end
    end

    it "advances persisted state only after consistency verification" do
      data = golden
      with_cache do |path|
        cache = Iyi::Mod::SumDB::Cache.new(path, keys(data), "sum.iyi.dev")
        cache.observe(data["checkpoints"]["257"].as_s) { |tile| Base64.decode(data["tiles"]["257"][tile].as_s) }
        File.read(path).should eq data["checkpoints"]["257"].as_s
        {% if flag?(:unix) %}
          (File.info(path).permissions.to_i & 0o077).should eq 0
        {% end %}
        second = Iyi::Mod::SumDB::Cache.new(path, keys(data), "sum.iyi.dev")
        second.observe(data["checkpoints"]["513"].as_s) { |tile| Base64.decode(data["tiles"]["513"][tile].as_s) }
        File.read(path).should eq data["checkpoints"]["513"].as_s
        retained = cache.observe(data["checkpoints"]["300"].as_s) { |tile| Base64.decode(data["tiles"]["513"][tile].as_s) }
        retained.size.should eq 513
        old = Iyi::Mod::SumDB::Record.parse(data["records"]["256"].as_s)
        client = Iyi::Mod::SumDB::Client.new(cache, keys(data), "sum.iyi.dev")
        checked = client.verify_lookup(data["old_lookup"].as_s, old.path, old.version, old.archive_hash) do |tile|
          value = data["tiles"]["257"].as_h[tile]? || data["tiles"]["513"].as_h[tile]
          Base64.decode(value.as_s)
        end
        checked.text.should eq old.text
        expect_raises(Iyi::Mod::SumDB::Error, /forked checkpoint/) do
          cache.observe(data["old_fork"].as_s) { |tile| Base64.decode(data["tiles"]["513"][tile].as_s) }
        end
        cache.latest.not_nil!.size.should eq 513
      end
    end
  end
end
