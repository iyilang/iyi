# Exercises `std/ini`: INI.parse of top-level keys and sections.
#
# Run via:
#     ./bin/iyi run bench/std_ini_exercise.iyi

module bench/std_ini_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/ini::{INI}

puts "== parse"
doc = INI.parse("k=v\n[s]\na=b\n")
assert_str "v", doc[""]["k"], "top"
assert_str "b", doc["s"]["a"], "section"
built = INI.build(doc)
assert_true built.includes?("k=v"), "build top"
assert_true built.includes?("[s]"), "build section"
puts "  parse and build"

puts "\n== leading whitespace"
# ASCII whitespace before a line, as the other library skips it: `\v` and
# `\f` were read as the start of a key, so the header after one was refused
# (`expected declaration at line 1, column 5`) and a line of `\f` was no
# blank line.
spaced = INI.parse("\v[s]\n\fk = v\n\f\n")
assert_true spaced.size == 1, "one section, #{spaced.size}"
assert_str "v", spaced["s"]["k"], "a key after a form feed"
puts "  vertical tab, form feed"

puts "\nALL CHECKS PASSED"
