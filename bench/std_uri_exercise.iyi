# Exercises `std/uri`: RFC 3986 parse of scheme, host and path.
#
# Run via:
#     ./bin/iyi run bench/std_uri_exercise.iyi

module bench/std_uri_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/uri::{URI, Params}

puts "== hash"
# URIs hash as they compare. Without a `hash` of its own a URI hashed to its
# type: these two hashed alike, and a table of 16,000 URI keys took 11.3 s
# to fill where the same texts as String keys took 4 ms. A bound, not a
# benchmark: twenty times the texts' time and 200 ms over.
assert_true URI.parse("http://a/").hash != URI.parse("https://b:8/x?y#z").hash, "two URIs hash apart"
assert_true URI.parse("http://u:p@h:8/x?y#z").hash == URI.parse("http://u:p@h:8/x?y#z").hash, "equal URIs hash alike"
texts = (0...16000).map { |i| "http://h/p#{i}" }
uris = texts.map { |text| URI.parse(text) }
started = __iyi_monotonic_ns
by_uri = {} of URI => Int32
uris.each_with_index { |uri, i| by_uri[uri] = i }
keyed_ns = __iyi_monotonic_ns - started
started = __iyi_monotonic_ns
by_text = {} of String => Int32
texts.each_with_index { |text, i| by_text[text] = i }
texted_ns = __iyi_monotonic_ns - started
assert_true by_uri.size == 16000 && by_uri[URI.parse("http://h/p4321")]? == 4321, "a table of URIs fills and answers"
assert_true keyed_ns <= texted_ns * 20 + 200_000_000_i64, "hash table: 16000 URI keys took #{keyed_ns // 1000000} ms where String keys took #{texted_ns // 1000000} ms"
puts "  URIs hash as they compare; 16,000 keys within twenty times their texts' time and 200 ms"

puts "\n== parse"
u = URI.parse("https://ex.com/a")
assert_str "https", u.scheme.to_s, "scheme"
assert_true u.host == "ex.com", "host"
assert_str "/a", u.path, "path"
puts "  https://ex.com/a"

# A relative path whose first segment holds a colon - a Windows path - is
# written behind `./` (RFC 3986 section 4.2), so it reads back as a path
# and not as a scheme: `C:/Users/x` came back with the scheme `C`.
drive = URI.parse("./C:/Users/x").normalize
assert_str "./C:/Users/x", drive.to_s, "a drive path is written behind ./"
again = URI.parse(drive.to_s)
assert_true again.scheme.nil? && again.path == "./C:/Users/x", "and reads back as a path"
assert_str "./a:b", URI.new(path: "a:b").to_s, "a colon in the first segment"
assert_str "a/b:c", URI.new(path: "a/b:c").to_s, "a colon past the first segment needs nothing"
assert_str "file:C:/x", URI.new(scheme: "file", path: "C:/x").to_s, "nor a path behind a scheme"
puts "  a colon in a relative path's first segment"

# Userinfo may hold the sub-delims (RFC 3986 section 3.2.1), and a URI
# that holds them is written back as it was: `user;type=a` came back
# `user%3Btype%3Da`, which section 2.2 counts a different URI. A `:` and an
# `@` inside a user or a password are still encoded.
["http://user;type=a@h/", "ftp://u:p!$&'()*+,;=@h/x", "http://a%20b:p%3Aw@h/", "http://%40x@h/"].each do |text|
  assert_str text, URI.parse(text).to_s, "#{text} round-trips"
end
puts "  userinfo keeps its sub-delims"

puts "\n== refuse"
assert_true URI.parse?("https://ex.com/a b").nil?, "space refused"
puts "  a space in the reference is refused"

puts "\n== form parameters"
form = Params.parse("a=100%&b=%zz&c=%4&d=%41+b&%&e")
assert_str "100%", form["a"], "a trailing % is itself"
assert_str "%zz", form["b"], "a % without hex digits is itself"
assert_str "%4", form["c"], "a % with one hex digit is itself"
assert_str "A b", form["d"], "an escape and a plus are decoded"
assert_str "", form["%"], "a lone % is a key"
assert_str "", form["e"], "a key with no value"
puts "  a malformed escape in a query is read, not refused"

puts "\n== encode"
assert_str "peter+%2B+paul", URI.encode("peter + paul", space_to_plus: true), "a '+' is %2B once a space is '+'"
assert_str " +", URI.decode(URI.encode(" +", space_to_plus: true), plus_to_space: true), "encode with space_to_plus is undone by decode"
puts "  a literal + is encoded when + stands for a space"

puts "\nALL CHECKS PASSED"
