# Flag parsing, written in iyi.
#
# `on("--name VALUE", "help") { |v| ... }` and `on("-h", "help") { }`
# register flags; `--name=VALUE` is Crystal's spelling of the first and
# means the same. `parse` walks `Program.args` (or the array given),
# calls the blocks, and answers the leftover operands. Short flags group
# as they do in every Unix tool: `-vo out` is `-v -o out`, and `-oout` is
# `-o out`.
#
# What the person typed wrong is the program's to answer, the way
# Crystal's `OptionParser` has it: `invalid_option { |flag| ... }` is
# handed an unknown flag and a value given to a flag that takes none,
# `missing_option { |flag| ... }` a flag that takes a value and is last,
# and parsing goes on after either. With no handler set they panic -
# `unknown flag: --x`, `flag --x takes no value`, `flag --name needs a
# value` - which is a bug report where a usage line was wanted, so a
# program reading its own command line sets both.

module std/option_parser

pub class OptionParser
  @long : Hash(String, {Bool, (String -> Nil)})
  @short : Hash(String, {Bool, (String -> Nil)})
  @help : Array(String)
  @invalid : (String -> Nil)?
  @missing : (String -> Nil)?

  def initialize
    @long = {} of String => {Bool, (String -> Nil)}
    @short = {} of String => {Bool, (String -> Nil)}
    @help = [] of String
    @invalid = nil
    @missing = nil
  end

  def invalid_option(&block : String -> Nil) : Nil
    @invalid = block
  end

  def missing_option(&block : String -> Nil) : Nil
    @missing = block
  end

  private def invalid(flag : String, sentence : String) : Nil
    handler = @invalid
    raise sentence unless handler
    handler.call(flag)
  end

  private def missing(flag : String) : Nil
    handler = @missing
    raise "flag #{flag} needs a value" unless handler
    handler.call(flag)
  end

  def on(flag : String, description : String, &block : String -> Nil) : Nil
    @help << "  #{flag}  #{description}"
    # A value is named after a space or after `=`. `--name=NAME` was a
    # flag called `--name=NAME`, which no argument matched: every
    # `--name=x` was "unknown flag: --name".
    cut = flag.bytesize
    at = 0
    while at < flag.bytesize
      byte = flag.to_unsafe[at]
      if byte == 32_u8 || byte == 61_u8
        cut = at
        break
      end
      at = at + 1
    end
    takes = cut < flag.bytesize
    name = flag[0, cut]
    if name.starts_with?("--") && name.bytesize > 2
      @long[name] = {takes, block}
    elsif name.starts_with?("-") && !name.starts_with?("--") && name.bytesize > 1 && name.bytesize == 1 + char_width(name, 1)
      @short[name] = {takes, block}
    else
      # `--` alone is the end of the flags, which `parse` answers itself;
      # registered, it could never be reached.
      raise "option: not a flag: #{flag}"
    end
  end

  def parse : Array(String)
    parse(Program.args)
  end

  def parse(args : Array(String)) : Array(String)
    rest = [] of String
    i = 0
    n = args.size
    while i < n
      a = args[i]
      if a == "--"
        i = i + 1
        while i < n
          rest << args[i]
          i = i + 1
        end
        break
      elsif a.starts_with?("--")
        eq = a.index('=')
        if eq
          name = a[0, eq]
          val = a[eq + 1, a.bytesize - eq - 1]
          spec = @long[name]?
          if !spec
            invalid(name, "unknown flag: #{name}")
          elsif !spec[0]
            invalid(name, "flag #{name} takes no value")
          else
            spec[1].call(val)
          end
        else
          spec = @long[a]?
          if !spec
            invalid(a, "unknown flag: #{a}")
          elsif spec[0]
            i = i + 1
            if i >= n
              missing(a)
            else
              spec[1].call(args[i])
            end
          else
            spec[1].call("")
          end
        end
      elsif a.starts_with?("-") && a.bytesize >= 2 && a != "-"
        # A group: each flag in turn, until one takes a value, which is the
        # rest of the argument or, with nothing left, the next one. Only
        # the first was read, and the rest dropped in silence: `-vo out`
        # set `-v` and left `out` an operand, and `-vz` never said `-z` was
        # unknown. A flag is a character, not a byte: `-é` was `-\xC3`.
        at = 1
        while at < a.bytesize
          width = char_width(a, at)
          name = "-" + a[at, width]
          at = at + width
          spec = @short[name]?
          if !spec
            invalid(name, "unknown flag: #{name}")
          elsif spec[0]
            if at < a.bytesize
              spec[1].call(a[at, a.bytesize - at])
            else
              i = i + 1
              if i >= n
                missing(name)
              else
                spec[1].call(args[i])
              end
            end
            break
          elsif at < a.bytesize && a.to_unsafe[at] == 61_u8
            # `-q=1`: a value given to a switch, as `--flag=x` is.
            invalid(name, "flag #{name} takes no value")
            break
          else
            spec[1].call("")
          end
        end
      else
        rest << a
      end
      i = i + 1
    end
    rest
  end

  # The bytes of the UTF-8 character that starts at *at*.
  private def char_width(text : String, at : Int32) : Int32
    lead = text.to_unsafe[at]
    width = lead < 0x80_u8 ? 1 : (lead >= 0xF0_u8 ? 4 : (lead >= 0xE0_u8 ? 3 : 2))
    width < text.bytesize - at ? width : text.bytesize - at
  end

  def help : String
    lines = ["options:"]
    @help.each { |h| lines << h }
    lines.join("\n")
  end
end
