pub class CStructOrUnionDef < ASTNode
  property name : String
  property body : ASTNode
  property union : Bool

  def initialize(@name : String, body : ASTNode? = nil, @union : Bool = false)
    @body = body || Nop.new
  end

  def clone_without_location : self
