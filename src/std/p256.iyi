# ECDSA signatures made on P-256 (FIPS 186-5, SEC 1, RFC 6979), written in
# iyi, in constant time.
#
#     import std/p256::{P256PrivateKey}
#     import std/ecdsa::{EcdsaHash, EcdsaError}
#
#     key = P256PrivateKey.from_pkcs8(der).or_panic     # or from_sec1, from_bytes
#     signature = key.sign(EcdsaHash::SHA256, message)  # DER Ecdsa-Sig-Value
#     key.public_key.verify(EcdsaHash::SHA256, message, signature)  # true
#
# std/ecdsa checks signatures on std/big's arithmetic, which takes as long
# as its numbers make it: fine for public values, and a leak for a private
# key, whose bits would show in how long each signature takes. This module
# is the other half for P-256 alone, the curve a TLS server's certificate
# is most often on and the one browsers take.
#
# Constant time, the way std/curve25519 is: nothing branches on a secret
# and no memory index depends on one. Numbers modulo p (the field) and
# modulo n (the group's order) are four 64-bit limbs in Montgomery form,
# products taken in `UInt128`, the final subtraction chosen by a mask. The
# points are projective, added and doubled by the complete formulas of
# Renes, Costello and Batina (2016, algorithms 4 and 6 for a = -3), which
# have no case to branch on - not the identity, not a point added to
# itself. [k]P runs 64 windows of four bits, each four doublings and one
# addition of a table entry read whole: all sixteen entries are read and
# the one wanted kept by masks. Inversion is Fermat's, x^(m - 2), whose
# exponent is public and fixed.
#
# The nonce is RFC 6979's: HMAC over the hash the signature names, from
# the private key and the message's hash, so one key and one message give
# one signature and no random source is trusted with the key. Where the
# RFC loops - a candidate k of n or more, an r or s of zero, each about
# 2^-32 likely - the loop shows that it ran again, and nothing else.
#
# A private key is 32 bytes, d in [1, n - 1]: `from_bytes`, or read from
# what OpenSSL and others write - PKCS #8's OneAsymmetricKey (RFC 5958,
# RFC 5480's id-ecPublicKey with prime256v1) or SEC 1's ECPrivateKey (RFC
# 5915), whose public key, when it carries one, must be d's.
#
# Pure computation: std/digest, std/crypto's HMAC, std/asn1, and std/ecdsa
# for the public key and its checking.

module std/p256

import std/int
import std/digest::{SHA256, SHA384, SHA512}
import std/crypto::{HMAC}
import std/asn1::{Der, DerValue, DerTag, Asn1Error}
import std/ecdsa::{EcdsaPublicKey, EcdsaCurve, EcdsaHash, EcdsaError}

# A P-256 private key, and the public key that goes with it.
pub struct P256PrivateKey
  getter public_key : EcdsaPublicKey
  @d : P256Num

  def initialize(@d : P256Num, @public_key : EcdsaPublicKey)
  end

  # The key whose d is *bytes*, 32 big-endian, or why it is not one: not
  # 32 bytes, or not in [1, n - 1].
  def self.from_bytes(bytes : String | Array(UInt8)) : P256PrivateKey | EcdsaError
    raw = bytes.is_a?(String) ? Array(UInt8).new(bytes.bytesize) { |i| bytes.to_unsafe[i] } : bytes
    return EcdsaError.new("a P-256 private key is 32 bytes, not #{raw.size}") unless raw.size == 32
    d = P256Num.from_bytes(raw, 0)
    unless P256Num.below?(d, P256Num.n) && !d.zero?
      return EcdsaError.new("a P-256 private key is a number from 1 to n - 1")
    end
    point = P256Point.base_mult(d).encoded
    public = EcdsaPublicKey.from_point(EcdsaCurve::P256, point)
    return public if public.is_a?(EcdsaError)
    P256PrivateKey.new(d, public)
  end

  # A PKCS #8 OneAsymmetricKey (RFC 5958) holding a P-256 key: version 0 or
  # 1, the algorithm id-ecPublicKey with prime256v1, and an ECPrivateKey
  # inside the privateKey OCTET STRING.
  def self.from_pkcs8(der : Array(UInt8)) : P256PrivateKey | EcdsaError
    top = Der.parse(der)
    return EcdsaError.new("the private key: #{top.message}") if top.is_a?(Asn1Error)
    fields = top.sequence
    return EcdsaError.new("the private key: #{fields.message}") if fields.is_a?(Asn1Error)
    return EcdsaError.new("the private key: a OneAsymmetricKey of #{fields.size} values") if fields.size < 3
    version = fields[0].integer
    return EcdsaError.new("the private key: version #{version}, not 0 or 1") unless version == 0_i64 || version == 1_i64
    algorithm = fields[1].sequence
    return EcdsaError.new("the private key: an AlgorithmIdentifier that is not a SEQUENCE") if algorithm.is_a?(Asn1Error) || algorithm.empty?
    kind = algorithm[0].oid
    return EcdsaError.new("the private key is for #{kind.is_a?(String) ? kind : "no OID"}, not id-ecPublicKey (1.2.840.10045.2.1)") unless kind == "1.2.840.10045.2.1"
    return EcdsaError.new("the private key: an id-ecPublicKey with no named curve") unless algorithm.size == 2
    curve = algorithm[1].oid
    return EcdsaError.new("the private key is on #{curve.is_a?(String) ? curve : "no named curve"}, not prime256v1 (1.2.840.10045.3.1.7)") unless curve == P256Point::CURVE_OID
    inner = fields[2].octet_string
    return EcdsaError.new("the private key: #{inner.message}") if inner.is_a?(Asn1Error)
    from_sec1(inner)
  end

  # SEC 1's ECPrivateKey (RFC 5915): version 1, the 32-byte private key,
  # then optionally the curve ([0], which must be prime256v1) and the
  # public key ([1], which must be the private key's).
  def self.from_sec1(der : Array(UInt8)) : P256PrivateKey | EcdsaError
    top = Der.parse(der)
    return EcdsaError.new("the private key: #{top.message}") if top.is_a?(Asn1Error)
    fields = top.sequence
    return EcdsaError.new("the private key: #{fields.message}") if fields.is_a?(Asn1Error)
    return EcdsaError.new("the private key: an ECPrivateKey of #{fields.size} values") if fields.size < 2
    return EcdsaError.new("the private key: an ECPrivateKey whose version is not 1") unless fields[0].integer == 1_i64
    secret = fields[1].octet_string
    return EcdsaError.new("the private key: #{secret.message}") if secret.is_a?(Asn1Error)
    key = from_bytes(secret)
    return key if key.is_a?(EcdsaError)
    i = 2
    while i < fields.size
      field = fields[i]
      if field.context?(0)
        named = field.explicit(0)
        oid = named.is_a?(Asn1Error) ? named : named.oid
        return EcdsaError.new("the private key names a curve that is not prime256v1") unless oid == P256Point::CURVE_OID
      elsif field.context?(1)
        bits = field.explicit(1)
        return EcdsaError.new("the private key: its public key is not a BIT STRING") if bits.is_a?(Asn1Error)
        point = bits.bit_string
        return EcdsaError.new("the private key: its public key is not a BIT STRING") if point.is_a?(Asn1Error)
        carried = EcdsaPublicKey.from_point(EcdsaCurve::P256, point)
        return EcdsaError.new("the private key: its public key is not the private key's") unless carried.is_a?(EcdsaPublicKey) && carried.x == key.public_key.x && carried.y == key.public_key.y
      else
        return EcdsaError.new("the private key: #{field.describe} where a curve or a public key belongs")
      end
      i = i + 1
    end
    key
  end

  # The signature of *message* under *hash*: the DER of Ecdsa-Sig-Value,
  # SEQUENCE { r INTEGER, s INTEGER }, as X.509 and TLS 1.3 carry it. The
  # nonce is RFC 6979's, so the same key and message sign alike.
  def sign(hash : EcdsaHash, message : String | Array(UInt8)) : Array(UInt8)
    bytes = message.is_a?(String) ? Array(UInt8).new(message.bytesize) { |i| message.to_unsafe[i] } : message
    r, s = sign_digest(hash, hash.digest(bytes))
    P256Der.signature(r.to_bytes, s.to_bytes)
  end

  # r and s for the digest *h1* of a message, RFC 6979 section 3.2 for the
  # nonce and SEC 1 section 4.1.3 for the rest.
  private def sign_digest(hash : EcdsaHash, h1 : Array(UInt8)) : {P256Num, P256Num}
    # bits2int: the hash's leftmost 256 bits; bits2octets: that mod n.
    e = P256Num.reduce_once(P256Num.from_bytes(h1, 0), P256Num.n)
    x = @d.to_bytes
    h = e.to_bytes
    size = h1.size
    v = Array(UInt8).new(size, 1_u8)
    k = Array(UInt8).new(size, 0_u8)
    k = P256Hmac.mac(hash, k, v + [0_u8] + x + h)
    v = P256Hmac.mac(hash, k, v)
    k = P256Hmac.mac(hash, k, v + [1_u8] + x + h)
    v = P256Hmac.mac(hash, k, v)
    while true
      v = P256Hmac.mac(hash, k, v)
      candidate = P256Num.from_bytes(v, 0)
      if P256Num.below?(candidate, P256Num.n) && !candidate.zero?
        r = P256Num.reduce_once(P256Point.base_mult(candidate).affine_x, P256Num.n)
        unless r.zero?
          # s = k^-1 (e + r d) mod n, in Montgomery form throughout.
          m = P256Modulus.order
          km = m.to_mont(candidate)
          rd = m.mul(m.to_mont(r), m.to_mont(@d))
          s = m.from_mont(m.mul(m.inverse(km), m.add(m.to_mont(e), rd)))
          return {r, s} unless s.zero?
        end
      end
      k = P256Hmac.mac(hash, k, v + [0_u8])
      v = P256Hmac.mac(hash, k, v)
    end
    {P256Num.zero, P256Num.zero}
  end
end

# HMAC under the hash a signature names.
struct P256Hmac
  def self.mac(hash : EcdsaHash, key : Array(UInt8), data : Array(UInt8)) : Array(UInt8)
    case hash
    when EcdsaHash::SHA256 then HMAC.digest(SHA256, key, data)
    when EcdsaHash::SHA384 then HMAC.digest(SHA384, key, data)
    else                        HMAC.digest(SHA512, key, data)
    end
  end
end

# DER's Ecdsa-Sig-Value from two 32-byte big-endian numbers.
struct P256Der
  def self.signature(r : Array(UInt8), s : Array(UInt8)) : Array(UInt8)
    body = integer(r) + integer(s)
    [0x30_u8] + length(body.size) + body
  end

  # A positive INTEGER: leading zeros dropped, one put back when the top
  # bit is set.
  private def self.integer(bytes : Array(UInt8)) : Array(UInt8)
    at = 0
    while at < bytes.size - 1 && bytes[at] == 0_u8
      at = at + 1
    end
    value = bytes[at, bytes.size - at]
    value = [0_u8] + value if value[0] >= 0x80_u8
    [0x02_u8] + length(value.size) + value
  end

  private def self.length(size : Int32) : Array(UInt8)
    size < 128 ? [size.to_u8] : [0x81_u8, size.to_u8]
  end
end

# A number below 2^256 as four 64-bit limbs, least significant first.
struct P256Num
  getter l0 : UInt64
  getter l1 : UInt64
  getter l2 : UInt64
  getter l3 : UInt64

  def initialize(@l0 : UInt64, @l1 : UInt64, @l2 : UInt64, @l3 : UInt64)
  end

  def self.zero : P256Num
    new(0_u64, 0_u64, 0_u64, 0_u64)
  end

  # The field's prime p = 2^256 - 2^224 + 2^192 + 2^96 - 1.
  def self.p : P256Num
    new(0xffffffffffffffff_u64, 0x00000000ffffffff_u64, 0x0000000000000000_u64, 0xffffffff00000001_u64)
  end

  # The group's order n.
  def self.n : P256Num
    new(0xf3b9cac2fc632551_u64, 0xbce6faada7179e84_u64, 0xffffffffffffffff_u64, 0xffffffff00000000_u64)
  end

  # 32 big-endian bytes of *bytes* from *at*.
  def self.from_bytes(bytes : Array(UInt8), at : Int32) : P256Num
    new(word(bytes, at + 24), word(bytes, at + 16), word(bytes, at + 8), word(bytes, at))
  end

  private def self.word(bytes : Array(UInt8), at : Int32) : UInt64
    w = 0_u64
    i = 0
    while i < 8
      w = w.unsafe_shl(8) | bytes[at + i].to_u64
      i = i + 1
    end
    w
  end

  def to_bytes : Array(UInt8)
    bytes = Array(UInt8).new(32, 0_u8)
    put(bytes, 0, @l3)
    put(bytes, 8, @l2)
    put(bytes, 16, @l1)
    put(bytes, 24, @l0)
    bytes
  end

  private def put(bytes : Array(UInt8), at : Int32, w : UInt64) : Nil
    i = 0
    while i < 8
      bytes[at + i] = (w.unsafe_shr(56 - 8 * i) & 0xff_u64).to_u8
      i = i + 1
    end
  end

  # Whether every limb is zero, read without a branch per limb.
  def zero? : Bool
    (@l0 | @l1 | @l2 | @l3) == 0_u64
  end

  # Whether *a* < *m*: the borrow out of a - m.
  def self.below?(a : P256Num, m : P256Num) : Bool
    _, borrow = sub_raw(a, m)
    borrow == 1_u64
  end

  # *a* minus *m* when *a* is not below it: a number below 2m taken below m.
  def self.reduce_once(a : P256Num, m : P256Num) : P256Num
    d, borrow = sub_raw(a, m)
    choose(borrow, a, d)
  end

  # *a* when *bit* is 1, *b* when it is 0, by a mask.
  def self.choose(bit : UInt64, a : P256Num, b : P256Num) : P256Num
    mask = 0_u64 &- bit
    new((a.l0 & mask) | (b.l0 & ~mask), (a.l1 & mask) | (b.l1 & ~mask),
      (a.l2 & mask) | (b.l2 & ~mask), (a.l3 & mask) | (b.l3 & ~mask))
  end

  # a - b and the borrow out of it, 0 or 1.
  def self.sub_raw(a : P256Num, b : P256Num) : {P256Num, UInt64}
    d0 = a.l0 &- b.l0
    c = borrow_of(a.l0, b.l0, 0_u64)
    d1 = a.l1 &- b.l1 &- c
    c = borrow_of(a.l1, b.l1, c)
    d2 = a.l2 &- b.l2 &- c
    c = borrow_of(a.l2, b.l2, c)
    d3 = a.l3 &- b.l3 &- c
    c = borrow_of(a.l3, b.l3, c)
    {new(d0, d1, d2, d3), c}
  end

  # The borrow out of x - y - c, computed without a comparison: the top
  # bit of (~x & y) | (~(x ^ y) & (x - y - c)) (Hacker's Delight 2-13).
  def self.borrow_of(x : UInt64, y : UInt64, c : UInt64) : UInt64
    d = x &- y &- c
    ((~x & y) | (~(x ^ y) & d)).unsafe_shr(63)
  end
end

# Arithmetic modulo p or n in Montgomery form (R = 2^256): a number a is
# held as a R mod m. Every operation runs the same steps whatever its
# operands.
struct P256Modulus
  getter m : P256Num
  # -m^-1 mod 2^64, R mod m and R^2 mod m.
  getter inv : UInt64
  getter one : P256Num
  getter r2 : P256Num

  def initialize(@m : P256Num, @inv : UInt64, @one : P256Num, @r2 : P256Num)
  end

  def self.field : P256Modulus
    new(P256Num.p, 0x0000000000000001_u64,
      P256Num.new(0x0000000000000001_u64, 0xffffffff00000000_u64, 0xffffffffffffffff_u64, 0x00000000fffffffe_u64),
      P256Num.new(0x0000000000000003_u64, 0xfffffffbffffffff_u64, 0xfffffffffffffffe_u64, 0x00000004fffffffd_u64))
  end

  def self.order : P256Modulus
    new(P256Num.n, 0xccd1c8aaee00bc4f_u64,
      P256Num.new(0x0c46353d039cdaaf_u64, 0x4319055258e8617b_u64, 0x0000000000000000_u64, 0x00000000ffffffff_u64),
      P256Num.new(0x83244c95be79eea2_u64, 0x4699799c49bd6fa6_u64, 0x2845b2392b6bec59_u64, 0x66e12d94f3d95620_u64))
  end

  # a b R^-1 mod m, by coarsely integrated operand scanning (CIOS): four
  # rounds of a times one limb of b, each followed by one limb's reduction.
  def mul(a : P256Num, b : P256Num) : P256Num
    t0 = 0_u64
    t1 = 0_u64
    t2 = 0_u64
    t3 = 0_u64
    t4 = 0_u64
    t0, t1, t2, t3, t4 = round(a, b.l0, t0, t1, t2, t3, t4)
    t0, t1, t2, t3, t4 = round(a, b.l1, t0, t1, t2, t3, t4)
    t0, t1, t2, t3, t4 = round(a, b.l2, t0, t1, t2, t3, t4)
    t0, t1, t2, t3, t4 = round(a, b.l3, t0, t1, t2, t3, t4)
    # t < 2m: m once more, taken when t4 carries or t - m does not borrow.
    d, borrow = P256Num.sub_raw(P256Num.new(t0, t1, t2, t3), @m)
    keep = t4 | (borrow ^ 1_u64)
    P256Num.choose(keep & 1_u64, d, P256Num.new(t0, t1, t2, t3))
  end

  private def round(a : P256Num, bi : UInt64, t0 : UInt64, t1 : UInt64, t2 : UInt64, t3 : UInt64, t4 : UInt64) : {UInt64, UInt64, UInt64, UInt64, UInt64}
    w = a.l0.to_u128 &* bi.to_u128 &+ t0.to_u128
    t0 = w.unsafe_to_u64
    w = a.l1.to_u128 &* bi.to_u128 &+ t1.to_u128 &+ w.unsafe_shr(64)
    t1 = w.unsafe_to_u64
    w = a.l2.to_u128 &* bi.to_u128 &+ t2.to_u128 &+ w.unsafe_shr(64)
    t2 = w.unsafe_to_u64
    w = a.l3.to_u128 &* bi.to_u128 &+ t3.to_u128 &+ w.unsafe_shr(64)
    t3 = w.unsafe_to_u64
    w = t4.to_u128 &+ w.unsafe_shr(64)
    t4 = w.unsafe_to_u64
    t5 = w.unsafe_shr(64).unsafe_to_u64
    q = t0 &* @inv
    w = q.to_u128 &* @m.l0.to_u128 &+ t0.to_u128
    w = q.to_u128 &* @m.l1.to_u128 &+ t1.to_u128 &+ w.unsafe_shr(64)
    r0 = w.unsafe_to_u64
    w = q.to_u128 &* @m.l2.to_u128 &+ t2.to_u128 &+ w.unsafe_shr(64)
    r1 = w.unsafe_to_u64
    w = q.to_u128 &* @m.l3.to_u128 &+ t3.to_u128 &+ w.unsafe_shr(64)
    r2 = w.unsafe_to_u64
    w = t4.to_u128 &+ w.unsafe_shr(64)
    r3 = w.unsafe_to_u64
    r4 = t5 &+ w.unsafe_shr(64).unsafe_to_u64
    {r0, r1, r2, r3, r4}
  end

  def square(a : P256Num) : P256Num
    mul(a, a)
  end

  # (a + b) mod m.
  def add(a : P256Num, b : P256Num) : P256Num
    w = a.l0.to_u128 &+ b.l0.to_u128
    s0 = w.unsafe_to_u64
    w = a.l1.to_u128 &+ b.l1.to_u128 &+ w.unsafe_shr(64)
    s1 = w.unsafe_to_u64
    w = a.l2.to_u128 &+ b.l2.to_u128 &+ w.unsafe_shr(64)
    s2 = w.unsafe_to_u64
    w = a.l3.to_u128 &+ b.l3.to_u128 &+ w.unsafe_shr(64)
    s3 = w.unsafe_to_u64
    carry = w.unsafe_shr(64).unsafe_to_u64
    sum = P256Num.new(s0, s1, s2, s3)
    d, borrow = P256Num.sub_raw(sum, @m)
    P256Num.choose((carry | (borrow ^ 1_u64)) & 1_u64, d, sum)
  end

  # (a - b) mod m: m added back by a mask when a - b borrows.
  def sub(a : P256Num, b : P256Num) : P256Num
    d, borrow = P256Num.sub_raw(a, b)
    mask = 0_u64 &- borrow
    w = d.l0.to_u128 &+ (@m.l0 & mask).to_u128
    r0 = w.unsafe_to_u64
    w = d.l1.to_u128 &+ (@m.l1 & mask).to_u128 &+ w.unsafe_shr(64)
    r1 = w.unsafe_to_u64
    w = d.l2.to_u128 &+ (@m.l2 & mask).to_u128 &+ w.unsafe_shr(64)
    r2 = w.unsafe_to_u64
    w = d.l3.to_u128 &+ (@m.l3 & mask).to_u128 &+ w.unsafe_shr(64)
    r3 = w.unsafe_to_u64
    P256Num.new(r0, r1, r2, r3)
  end

  def to_mont(a : P256Num) : P256Num
    mul(a, @r2)
  end

  def from_mont(a : P256Num) : P256Num
    mul(a, P256Num.new(1_u64, 0_u64, 0_u64, 0_u64))
  end

  # a^-1 for *a* in Montgomery form, as a^(m - 2): the exponent's bits are
  # m's, public, so the squarings and multiplications run in one order for
  # every a.
  def inverse(a : P256Num) : P256Num
    e = P256Num.sub_raw(@m, P256Num.new(2_u64, 0_u64, 0_u64, 0_u64))[0]
    result = @one
    i = 255
    while i >= 0
      result = square(result)
      word = i >= 192 ? e.l3 : (i >= 128 ? e.l2 : (i >= 64 ? e.l1 : e.l0))
      result = mul(result, a) if word.unsafe_shr(i & 63) & 1_u64 == 1_u64
      i = i - 1
    end
    result
  end
end

# A point of P-256, y^2 = x^3 - 3x + b, in projective coordinates
# (X : Y : Z), x = X/Z and y = Y/Z, each in the field's Montgomery form.
# The identity is (0 : 1 : 0).
struct P256Point
  CURVE_OID = "1.2.840.10045.3.1.7"

  getter x : P256Num
  getter y : P256Num
  getter z : P256Num

  def initialize(@x : P256Num, @y : P256Num, @z : P256Num)
  end

  def self.identity : P256Point
    new(P256Num.zero, P256Modulus.field.one, P256Num.zero)
  end

  # The base point G.
  def self.base : P256Point
    new(P256Num.new(0x79e730d418a9143c_u64, 0x75ba95fc5fedb601_u64, 0x79fb732b77622510_u64, 0x18905f76a53755c6_u64),
      P256Num.new(0xddf25357ce95560a_u64, 0x8b4ab8e4ba19e45c_u64, 0xd2e88688dd21f325_u64, 0x8571ff1825885d85_u64),
      P256Modulus.field.one)
  end

  # b, in Montgomery form.
  def self.b : P256Num
    P256Num.new(0xd89cdf6229c4bddf_u64, 0xacf005cd78843090_u64, 0xe5a220abf7212ed6_u64, 0xdc30061d04874834_u64)
  end

  # P + Q, algorithm 4 of Renes, Costello and Batina: complete, so the
  # identity and P + P need no case of their own.
  def +(q : P256Point) : P256Point
    f = P256Modulus.field
    b = P256Point.b
    t0 = f.mul(@x, q.x)
    t1 = f.mul(@y, q.y)
    t2 = f.mul(@z, q.z)
    t3 = f.add(@x, @y)
    t4 = f.add(q.x, q.y)
    t3 = f.mul(t3, t4)
    t4 = f.add(t0, t1)
    t3 = f.sub(t3, t4)
    t4 = f.add(@y, @z)
    x3 = f.add(q.y, q.z)
    t4 = f.mul(t4, x3)
    x3 = f.add(t1, t2)
    t4 = f.sub(t4, x3)
    x3 = f.add(@x, @z)
    y3 = f.add(q.x, q.z)
    x3 = f.mul(x3, y3)
    y3 = f.add(t0, t2)
    y3 = f.sub(x3, y3)
    z3 = f.mul(b, t2)
    x3 = f.sub(y3, z3)
    z3 = f.add(x3, x3)
    x3 = f.add(x3, z3)
    z3 = f.sub(t1, x3)
    x3 = f.add(t1, x3)
    y3 = f.mul(b, y3)
    t1 = f.add(t2, t2)
    t2 = f.add(t1, t2)
    y3 = f.sub(y3, t2)
    y3 = f.sub(y3, t0)
    t1 = f.add(y3, y3)
    y3 = f.add(t1, y3)
    t1 = f.add(t0, t0)
    t0 = f.add(t1, t0)
    t0 = f.sub(t0, t2)
    t1 = f.mul(t4, y3)
    t2 = f.mul(t0, y3)
    y3 = f.mul(x3, z3)
    y3 = f.add(y3, t2)
    x3 = f.mul(t3, x3)
    x3 = f.sub(x3, t1)
    z3 = f.mul(t4, z3)
    t1 = f.mul(t3, t0)
    z3 = f.add(z3, t1)
    P256Point.new(x3, y3, z3)
  end

  # 2P, algorithm 6 of Renes, Costello and Batina.
  def double : P256Point
    f = P256Modulus.field
    b = P256Point.b
    t0 = f.square(@x)
    t1 = f.square(@y)
    t2 = f.square(@z)
    t3 = f.mul(@x, @y)
    t3 = f.add(t3, t3)
    z3 = f.mul(@x, @z)
    z3 = f.add(z3, z3)
    y3 = f.mul(b, t2)
    y3 = f.sub(y3, z3)
    x3 = f.add(y3, y3)
    y3 = f.add(x3, y3)
    x3 = f.sub(t1, y3)
    y3 = f.add(t1, y3)
    y3 = f.mul(x3, y3)
    x3 = f.mul(x3, t3)
    t3 = f.add(t2, t2)
    t2 = f.add(t2, t3)
    z3 = f.mul(b, z3)
    z3 = f.sub(z3, t2)
    z3 = f.sub(z3, t0)
    t3 = f.add(z3, z3)
    z3 = f.add(z3, t3)
    t3 = f.add(t0, t0)
    t0 = f.add(t3, t0)
    t0 = f.sub(t0, t2)
    t0 = f.mul(t0, z3)
    y3 = f.add(y3, t0)
    t0 = f.mul(@y, @z)
    t0 = f.add(t0, t0)
    z3 = f.mul(t0, z3)
    x3 = f.sub(x3, z3)
    z3 = f.mul(t0, t1)
    z3 = f.add(z3, z3)
    z3 = f.add(z3, z3)
    P256Point.new(x3, y3, z3)
  end

  # [k]G for a secret k below n: 64 windows of four bits from the top,
  # each four doublings and one addition of a table entry read whole.
  def self.base_mult(k : P256Num) : P256Point
    table = Array(P256Point).new(16, P256Point.identity)
    g = P256Point.base
    i = 1
    while i < 16
      table[i] = table[i - 1] + g
      i = i + 1
    end
    acc = P256Point.identity
    w = 63
    while w >= 0
      acc = acc.double.double.double.double
      limb = w >= 48 ? k.l3 : (w >= 32 ? k.l2 : (w >= 16 ? k.l1 : k.l0))
      digit = limb.unsafe_shr((w & 15) * 4) & 15_u64
      acc = acc + lookup(table, digit)
      w = w - 1
    end
    acc
  end

  # table[digit], every entry read and the one wanted kept by masks.
  private def self.lookup(table : Array(P256Point), digit : UInt64) : P256Point
    x = P256Num.zero
    y = P256Num.zero
    z = P256Num.zero
    i = 0
    while i < 16
      bit = ((i.to_u64 ^ digit) &- 1_u64).unsafe_shr(63)
      entry = table[i]
      x = P256Num.choose(bit, entry.x, x)
      y = P256Num.choose(bit, entry.y, y)
      z = P256Num.choose(bit, entry.z, z)
      i = i + 1
    end
    P256Point.new(x, y, z)
  end

  # x / Z, out of Montgomery form.
  def affine_x : P256Num
    f = P256Modulus.field
    f.from_mont(f.mul(@x, f.inverse(@z)))
  end

  # The uncompressed encoding: 0x04, then x and y, 32 bytes each.
  def encoded : Array(UInt8)
    f = P256Modulus.field
    zinv = f.inverse(@z)
    [4_u8] + f.from_mont(f.mul(@x, zinv)).to_bytes + f.from_mont(f.mul(@y, zinv)).to_bytes
  end
end
