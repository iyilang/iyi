module std/complex

import std/math::{Math}
import std/float
import std/int

pub struct Complex
  getter real : Float64
  getter imag : Float64

  def initialize(real : ::Number, imag : ::Number = 0)
    @real = real.to_f64
    @imag = imag.to_f64
  end

  def self.new(c : Complex) : Complex
    c
  end

  def ==(other : Complex) : ::Bool
    @real == other.real && @imag == other.imag
  end

  def ==(other : ::Number) : ::Bool
    @real == other.to_f64 && @imag == 0.0
  end

  def to_c : Complex
    self
  end

  def to_f64 : Float64
    raise "Complex number with non-zero imaginary part can't be converted to real" unless @imag == 0.0
    @real
  end

  def to_f : Float64
    to_f64
  end

  def to_i32 : Int32
    to_f64.to_i32
  end

  def to_i64 : Int64
    to_f64.to_i64
  end

  def to_f32 : Float32
    to_f64.to_f32
  end

  # The joiner is the imaginary part's sign bit and its magnitude follows,
  # as the other library prints: comparing `>= 0.0` printed `1.0 + -0.0i`
  # for a negative zero and `1.0 - NaNi` for NaN.
  def to_s : String
    joiner = @imag.nan? || Math.copysign(1.0, @imag) > 0.0 ? " + " : " - "
    @real.to_s + joiner + @imag.abs.to_s + "i"
  end

  def to_s(io : IyiIO) : ::Nil
    io.print(to_s)
  end

  def inspect : String
    "(" + to_s + ")"
  end

  def inspect(io : IyiIO) : ::Nil
    io.print(inspect)
  end

  def abs : Float64
    Math.hypot(@real, @imag)
  end

  def abs2 : Float64
    @real * @real + @imag * @imag
  end

  # The other library's cases, one by one: dividing by `abs` answered NaN
  # for an infinite part, 0 once `abs` overflowed (both parts 1.5e308),
  # and a magnitude of 1.414 for two subnormal parts, whose `abs` rounds.
  def sign : Complex
    return self if zero?
    return Complex.new(Float64::NAN, Float64::NAN) if @real.nan? || @imag.nan?
    return Complex.new(@real > 0.0 ? 1.0 : -1.0, @imag) if @real != 0.0 && @imag == 0.0
    return Complex.new(@real, @imag > 0.0 ? 1.0 : -1.0) if @real == 0.0 && @imag != 0.0
    real_inf = @real.infinite?
    imag_inf = @imag.infinite?
    if real_inf && imag_inf
      half = Math.sqrt(0.5)
      Complex.new(half * real_inf, half * imag_inf)
    elsif imag_inf
      Complex.new(Math.copysign(0.0, @real), imag_inf)
    elsif real_inf
      Complex.new(real_inf, Math.copysign(0.0, @imag))
    else
      angle = phase
      Complex.new(Math.cos(angle), Math.sin(angle))
    end
  end

  def phase : Float64
    Math.atan2(@imag, @real)
  end

  def polar : {Float64, Float64}
    {abs, phase}
  end

  # Negated, not subtracted from 0.0: `0.0 - 0.0` is `+0.0`, so the
  # conjugate of `-1 + 0i` sat above the branch cut and its log was `+pi i`.
  def conj : Complex
    Complex.new(@real, -@imag)
  end

  # `conj / abs2`, as the other library inverts, wherever `abs2` is a
  # normal float; past that it overflowed or underflowed, and the inverse
  # of 1e-170 was `Infinity + NaNi` and of 1e170 `0.0 - 0.0i`. There the
  # conjugate is scaled as the division scales it (Smith's), which keeps
  # its zeros' signs.
  def inv : Complex
    d = abs2
    return conj / d if zero? || d.nan? || (d >= Float64::MIN_POSITIVE && d <= Float64::MAX)
    if @imag.abs < @real.abs
      r = @imag / @real
      e = @real + r * @imag
      Complex.new(1.0 / e, -r / e)
    else
      r = @real / @imag
      e = @imag + r * @real
      Complex.new(r / e, -1.0 / e)
    end
  end

  def + : Complex
    self
  end

  def +(other : Complex) : Complex
    Complex.new(@real + other.real, @imag + other.imag)
  end

  def +(other : ::Number) : Complex
    Complex.new(@real + other.to_f64, @imag)
  end

  def - : Complex
    Complex.new(-@real, -@imag)
  end

  def -(other : Complex) : Complex
    Complex.new(@real - other.real, @imag - other.imag)
  end

  def -(other : ::Number) : Complex
    Complex.new(@real - other.to_f64, @imag)
  end

  def *(other : Complex) : Complex
    Complex.new(@real * other.real - @imag * other.imag, @real * other.imag + @imag * other.real)
  end

  def *(other : ::Number) : Complex
    n = other.to_f64
    Complex.new(@real * n, @imag * n)
  end

  # Smith's scaled quotient, as the other library divides: through
  # `abs2`, a divisor past 1e154 squared to infinity and gave 0, and one
  # under 1e-162 squared to 0 and panicked "Division by zero". A zero
  # divisor answers what a float quotient does, infinities and NaN.
  def /(other : Complex) : Complex
    if other.real.nan? || other.imag.nan?
      Complex.new(Float64::NAN, Float64::NAN)
    elsif other.imag.abs < other.real.abs
      r = other.imag / other.real
      d = other.real + r * other.imag
      if d.nan? || d == 0.0
        Complex.new(Float64::NAN, Float64::NAN)
      else
        Complex.new((@real + @imag * r) / d, (@imag - @real * r) / d)
      end
    elsif other.imag == 0.0
      Complex.new(@real / other.real, @imag / other.real)
    else
      r = other.real / other.imag
      d = other.imag + r * other.real
      if d.nan? || d == 0.0
        Complex.new(Float64::NAN, Float64::NAN)
      else
        Complex.new((@real * r + @imag) / d, (@imag * r - @real) / d)
      end
    end
  end

  # A zero divisor is a float quotient's infinities and NaN, not a panic.
  def /(other : ::Number) : Complex
    n = other.to_f64
    Complex.new(@real / n, @imag / n)
  end

  def clone : Complex
    self
  end

  # The parts' own hashes, the imaginary one left out when it is zero as
  # the other library does, so `Complex.new(x, 0)` hashes as `x`, which it
  # equals. `to_i64` of a part panicked "arithmetic overflow" past 2^63 or
  # at NaN and infinity, and `to_i32` of that past 2^31.
  def hash : Int32
    h = @real.hash
    return h if @imag == 0.0
    (h.to_i64.unsafe_to_u64 &* 0x100000001B3_u64 ^ @imag.hash.to_i64.unsafe_to_u64).hash
  end

  def self.zero : Complex
    new(0, 0)
  end

  def zero? : ::Bool
    @real == 0.0 && @imag == 0.0
  end

  def self.additive_identity : Complex
    zero
  end

  def self.multiplicative_identity : Complex
    new(1, 0)
  end

  def round(digits : Int32 = 0) : Complex
    Complex.new(@real.round(digits), @imag.round(digits))
  end

  # A real exponent keeps its imaginary zero: `r * sin(0.0)` was NaN once
  # `r` overflowed, so e^710 and e^Infinity were `Infinity + NaNi`.
  def exp : Complex
    r = Math.exp(@real)
    return Complex.new(r, @imag) if @imag == 0.0
    Complex.new(r * Math.cos(@imag), r * Math.sin(@imag))
  end

  def log : Complex
    Complex.new(Math.log(abs), phase)
  end

  # A part past an eighth of `Float64::MAX` is rooted a sixteenth of the
  # way down and the root doubled twice: `2.0 * (r + @real)` overflowed,
  # and the root of 1e308 + 1e308i was `Infinity + 0.0i`. A power of two
  # scales each step exactly, so the root is the one the steps would
  # answer had they not overflowed.
  def sqrt : Complex
    x = @real
    y = @imag
    scale = 1.0
    big = Float64::MAX / 8.0
    if x.abs > big || y.abs > big
      x = x / 16.0
      y = y / 16.0
      scale = 4.0
    end
    r = Math.hypot(x, y)
    re = if x >= 0.0
           0.5 * Math.sqrt(2.0 * (r + x))
         else
           y.abs / Math.sqrt(2.0 * (r - x))
         end
    im = if x <= 0.0
           0.5 * Math.sqrt(2.0 * (r - x))
         else
           y.abs / Math.sqrt(2.0 * (r + x))
         end
    # Negated: `0.0 - im` lost the sign of an imaginary part that underflowed.
    Complex.new(scale * re, scale * (y >= 0.0 ? im : -im))
  end
end

struct ::Number
  def to_c : Std::Complex::Complex
    Std::Complex::Complex.new(self, 0)
  end

  def i : Std::Complex::Complex
    Std::Complex::Complex.new(0, self)
  end

  # Spelled in full: this file's import of `Math` does not reach the
  # reopened `::Number`, so `0.5.cis` failed to compile ("undefined
  # constant Math") unless the caller had imported `Math` itself.
  def cis : Std::Complex::Complex
    val = to_f64
    Std::Complex::Complex.new(Std::Math::Math.cos(val), Std::Math::Math.sin(val))
  end

  def +(other : Std::Complex::Complex) : Std::Complex::Complex
    other + self
  end

  def -(other : Std::Complex::Complex) : Std::Complex::Complex
    Std::Complex::Complex.new(to_f64 - other.real, -other.imag)
  end

  def *(other : Std::Complex::Complex) : Std::Complex::Complex
    other * self
  end

  # Times the inverse, as the other library divides a number by a complex:
  # dividing `Complex.new(self, 0)` rounded otherwise, and panicked
  # "Division by zero" once the divisor's `abs2` underflowed to 0.
  def /(other : Std::Complex::Complex) : Std::Complex::Complex
    self * other.inv
  end

  # `1.0 == Complex.new(1, 0)` was false while the reverse was true.
  def ==(other : Std::Complex::Complex) : ::Bool
    other == self
  end
end

# e^z, log, sqrt live on Complex, not a global Math.
