# Parallel tasks that move between workers, exercised: SPEC.md III.4.13,
# the part about a started task resuming on whichever worker is free.
#
#   ./bin/iyi run bench/parallel_migrate.iyi                 # every step
#   ./bin/iyi run bench/parallel_migrate.iyi -- sockets      # some of them
#
# A task that parks on one worker and resumes on another must find what it
# had: its stack, scanned by the collector on the thread now running it;
# the thread-locals of that thread, not of the one it left; its socket's
# bytes, delivered by whichever poller or port took them; a cancel, from
# whichever thread, that finds it where it waits; and on Windows the TEB's
# stack bounds of its own stack, which a deep frame's probes read. Every
# step parks tasks over and over while they and their siblings allocate,
# so collections stop the workers while tasks are on their way between
# them, and counts the parks a task resumed from on another thread: a step
# whose tasks never moved proved nothing, and fails saying so.
#
# What a thread is, here, is read twice: by the thread-local the runtime
# keeps (`IyiScheduler.state`), and by asm, from the register the kernel
# keeps the thread's own pointer in - %fs:0 on x86-64 Linux, the TEB at
# %gs:0x30 on Windows, tpidr_el0 on aarch64 (tpidrro_el0 on darwin) -
# which no codegen of thread-locals touches. After every park the two
# must change together, and so must the thread's line and the kernel's
# thread after a loop whose back-edge check moved the task (`loops`).
# Under `-Dparallel_stale_tls` the thread-local is the one read before the
# park, as code that kept a thread-local's address across a call would
# read it, and under `-Dparallel_hoisted_tls` the line is the one read
# before the loop, as a read hoisted out of it would be; under
# `-Dparallel_closes_home` a read is made on the thread that closes its
# socket (`closes`); each step fails by name.
#
# Then the timed shapes the issue's server is made of (#145): tasks that
# park and then compute finish in about their work over the workers, when
# the thread that wakes them is outside the pool and when it is a worker;
# and a task joining a thread, or waiting on a Mutex's word, leaves its
# worker to the tasks behind it. bench/parallel_exercise.sh runs this and
# broken copies of the runtime, each caught by the check that names it.

@[Unsafe("reads the thread pointer through asm, fills an uninitialized stack pad through pointerof, and Lent trusts @[Share] to carry a socket between workers")]
module bench/parallel_migrate

import std/socket::{IyiSocket, SocketError}

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  def fail(message : String) : Nil
    print "FAIL: #{message}\n"
    __iyi_exit(1)
  end

  def elapsed_ms(since : Int64) : Int64
    (__iyi_monotonic_ns - since) // 1000000_i64
  end

  # Integer work with nothing to allocate: a xorshift walk.
  def spin(rounds : Int64, seed : UInt64) : UInt64
    x = seed | 1_u64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      i = i + 1
    end
    x
  end

  # Counts the tasks share: `Share` by their atomic fields.
  class Tally
    @count : Atomic(Int64)

    def initialize
      @count = Atomic(Int64).new(0_i64)
    end

    def add(value : Int64) : Nil
      @count.add(value)
    end

    def count : Int64
      @count.get
    end
  end

  class Node
    getter value : Int64
    getter next_node : Node?

    def initialize(@value : Int64, @next_node : Node?)
    end
  end

  struct Boom
    def initialize
    end
  end

  impl Error for Boom
    def message : String
      "boom"
    end
  end

  # The kernel's pointer for the calling thread, read by asm: what the
  # thread is, without a thread-local in between.
  def os_thread : UInt64
    tp = 0_u64
    {% if flag?(:win32) %}
      asm("movq %gs:0x30, $0" : "=r"(tp) : : : "volatile")
    {% elsif flag?(:x86_64) %}
      asm("movq %fs:0, $0" : "=r"(tp) : : : "volatile")
    {% elsif flag?(:darwin) %}
      asm("mrs $0, tpidrro_el0" : "=r"(tp) : : : "volatile")
    {% else %}
      asm("mrs $0, tpidr_el0" : "=r"(tp) : : : "volatile")
    {% end %}
    tp
  end

  # The thread-local's answer after a park: this thread's scheduler state,
  # or under `-Dparallel_stale_tls` the one read before it.
  def state_after(before : UInt64) : UInt64
    {% if flag?(:parallel_stale_tls) %}
      before
    {% else %}
      IyiScheduler.state.object_id
    {% end %}
  end

  # After a park: the thread-local and the kernel's thread changed together
  # or not at all, and true when they changed - the task moved.
  def moved?(step : String, os_before : UInt64, state_before : UInt64) : Bool
    os_now = os_thread
    state_now = state_after(state_before)
    if (os_now == os_before) != (state_now == state_before)
      puts "#{step}: the kernel's thread went #{os_before} -> #{os_now}, the scheduler state #{state_before} -> #{state_now}"
      fail("#{step}: a thread-local read after a park named another thread than the one the task resumed on")
    end
    os_now != os_before
  end

  # A list that lives only on the calling task's stack: *count* nodes whose
  # values count down from the head, values no other list or garbage in
  # the run has.
  def build(count : Int32, seed : Int64) : Node?
    head = nil.as(Node?)
    i = 0
    while i < count
      head = Node.new((seed &+ 1_i64) &* 1000003_i64 &+ i.to_i64, head)
      i = i + 1
    end
    head
  end

  # Whether the list is still the one `build` made, every value in order,
  # each read before its link is followed: a node the collector freed and
  # the heap gave to something else ends the walk there, by name, rather
  # than sending it after a link that is not one.
  def whole?(head : Node?, count : Int32, seed : Int64) : Bool
    node = head
    i = count - 1
    while i >= 0
      return false unless node.is_a?(Node)
      return false unless node.value == (seed &+ 1_i64) &* 1000003_i64 &+ i.to_i64
      node = node.next_node
      i = i - 1
    end
    node.nil?
  end

  # Garbage, so the heap fills and collections stop the workers.
  def churn(count : Int32) : Int64
    kept = 0_i64
    i = 0
    while i < count
      node = Node.new(i.to_i64, nil)
      kept = kept &+ node.value
      i = i + 1
    end
    kept
  end

  # Frames 600 bytes deep, *depth* of them, each page of them touched
  # top down as a frame's own probes touch it.
  @[NoInline]
  def fill(pad : Pointer(UInt64), words : Int32, seed : UInt64) : UInt64
    i = 0
    while i < words
      pad[i] = seed &+ i.to_u64
      i = i + 1
    end
    pad[words - 1]
  end

  def deep(depth : Int32) : UInt64
    pad = uninitialized UInt64[72]
    words = pointerof(pad).as(Pointer(UInt64))
    top = fill(words, 72, depth.to_u64)
    return top if depth == 0
    deep(depth - 1) &+ top &+ words[0]
  end

  # The step *name* under a watchdog: a task on the main thread that
  # sleeps *ms* and fails the run by name unless the step ends first.
  def watched(name : String, ms : Int32, &block : -> Nil) : Nil
    group do |w|
      w.spawn do
        waited = sleep(ms)
        fail("#{name}: still waiting after #{ms} ms") unless waited.is_a?(Cancelled)
        0
      end
      block.call
      w.cancel_children
    end
  end

  # A connected pair of sockets on the loopback, as descriptors and the
  # family, which cross into a parallel task.
  def pair(listener : IyiSocket, port : Int32) : Tuple(IyiSocket, IyiSocket)
    near = IyiSocket.connect("127.0.0.1", port, 5000)
    fail("pair: connect answered #{near}") unless near.is_a?(IyiSocket)
    far = listener.accept
    fail("pair: accept answered #{far}") unless far.is_a?(IyiSocket)
    {near, far}
  end

  # A spin with preemption off until *count* reaches *target*. The task
  # holding a worker in it keeps the worker, and the wait ends on a word
  # another task sets, never on a clock.
  @[NoInline]
  @[NoPreempt]
  def hold_until(count : Tally, target : Int64, what : String) : Nil
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    while count.count < target
      IyiThread.spin_pause
      fail("#{what}: the hold did not release in 20000 ms") if __iyi_monotonic_ns > limit
    end
  end

  # A list that only a queued task holds. Copy only (-Dintransit_force): the
  # collector's root walk counts the queued fibers whose saved stacks hold the
  # list's head word, and whether it scanned them (rings in the copy's
  # IyiRoots). Every worker is held with preemption off, so the task main
  # wakes stays queued (Runnable) while main collects. It runs first in
  # channels, so a copy that skips the stack fails here, before the rest.
  def intransit_forced : Nil
    {% if flag?(:intransit_force) %}
      workers = IyiWorkers.count
      built = Tally.new
      held = Tally.new
      stop_holders = Tally.new
      feed = Channel(Int32).new
      task = Armed.new
      group do |g|
        g.spawn(unit: :new) do
          task.note_fiber(IyiScheduler.current.object_id)
          head = build(3000, 5_i64)
          IyiRoots.force_head_set(head.as(Node).object_id)
          built.add(1_i64)
          feed.receive
          fail("channels: a queued task's list was not whole after its collection") unless whole?(head, 3000, 5_i64)
          0
        end
        wait_or_fail(built, 1_i64, "channels: progress hang: the list task did not build")
        workers.times do
          g.spawn(unit: :new) do
            held.add(1_i64)
            hold_until_or_fail(stop_holders, 1_i64, "channels: progress hang: a holder was not released")
            0
          end
        end
        wait_or_fail(held, workers.to_i64, "channels: progress hang: the holders did not start")
        feed.send(1)
        IyiMark.collect
        seen = IyiRoots.force_seen_fiber
        scanned = IyiRoots.force_scanned_fiber
        fail("channels: no collection saw a queued task's list head on its stack, so the proof did not arm") unless seen == task.fiber
        fail("channels: the collector's stack walk omitted a queued fiber's saved stack that held a list's head") unless scanned == task.fiber
        puts "channels: the collector's stack walk scanned a queued fiber's saved stack that held a list's head"
        stop_holders.add(1_i64)
      end
    {% end %}
  end

  # ── channels ─────────────────────────────────────────────────────────
  # 32 tasks, each holding a list on its own stack, park on a channel 30
  # times; the main thread sends, so each wake goes to the pool's shared
  # queue and whichever worker is free resumes it. Each round allocates.
  #
  # With partitions in the runtime (`-Dheap_partitions`) each task's
  # rounds allocate in its unit's own partition, which never feeds the
  # global trigger (heap22 design, section 4.2) and collects itself with
  # no worker stopped (section 4.1): there the main thread asks for a
  # global collection after every eighth send, while the task it just woke
  # is on its way to a worker, and the tasks' own collections must run.
  def channels(watch : Int32) : Nil
    watched("channels", watch) do
      channels_forced
      {% if flag?(:intransit_force) %}
        intransit_forced
      {% end %}
      tasks = 32
      rounds = 30
      feed = Channel(Int32).new
      moves = Tally.new
      stops = IyiThread.stops
      {% if flag?(:heap_partitions) %}
        locals = IyiHeap.local_collections
      {% end %}
      group do |g|
        tasks.times do |t|
          g.spawn(unit: :new) do
            kept = build(3000, t.to_i64)
            rounds.times do |r|
              churn(4000)
              os = os_thread
              st = IyiScheduler.state.object_id
              feed.receive
              moves.add(1_i64) if moved?("channels", os, st)
              fail("channels: task #{t}'s list was not whole after park #{r}") unless whole?(kept, 3000, t.to_i64)
            end
            0
          end
        end
        {% if flag?(:heap_partitions) %}
          (tasks * rounds).times do |i|
            feed.send(1)
            IyiMark.collect if i % 8 == 7
          end
        {% else %}
          (tasks * rounds).times { feed.send(1) }
        {% end %}
      end
      fail("channels: no collection stopped a worker while the tasks moved") if IyiThread.stops == stops
      if IyiWorkers.count > 1 && moves.count == 0_i64
        fail("channels: none of #{tasks * rounds} parks on a channel resumed on another worker")
      end
      {% if flag?(:heap_partitions) %}
        held = IyiHeap.local_collections - locals
        fail("channels: no local collection ran while #{tasks} tasks allocated in partitions of their own") if IyiWorkers.count > 1 && held == 0_u64
        puts "channels: #{tasks} tasks parked #{rounds} times each, #{moves.count} resumed on another worker, lists whole through #{held} local collections and #{IyiThread.stops - stops} stops"
      {% else %}
        puts "channels: #{tasks} tasks parked #{rounds} times each, #{moves.count} resumed on another worker, lists whole through #{IyiThread.stops - stops} stops"
      {% end %}
    end
  end

  # The move a channel task makes only by chance, made on purpose, for the
  # stale thread-local copy (`staletls`). Every worker but one is held by a
  # @[NoPreempt] task, so the next task to run takes the one left: it
  # parks, and a sibling queued behind it takes that worker when the park
  # gives it up (the sibling's start is the word that says the park
  # happened). Main then sends the wake, which queues the task while every
  # worker is busy; a holder ends, a worker takes the task, and it resumes
  # on a worker it did not park on, where the thread-local it read before
  # the park is checked. Nothing here waits on a clock.
  def channels_forced : Nil
    holders = IyiWorkers.count - 1
    held = Tally.new
    stop_holders = Tally.new
    started = Tally.new
    sibling = Tally.new
    release_sibling = Tally.new
    finished = Tally.new
    feed = Channel(Int32).new
    group do |g|
      holders.times do
        g.spawn(unit: :new) do
          held.add(1_i64)
          hold_until_or_fail(stop_holders, 1_i64, "channels: progress hang: a holder was not released")
          0
        end
      end
      wait_or_fail(held, holders.to_i64, "channels: progress hang: the holders did not start")
      g.spawn(unit: :new) do
        kept = build(3000, 9_i64)
        os = os_thread
        st = IyiScheduler.state.object_id
        started.add(1_i64)
        feed.receive
        fail("channels: not armed: the forced task resumed on the worker it parked on") unless moved?("channels", os, st)
        fail("channels: the forced task's list was not whole after its park") unless whole?(kept, 3000, 9_i64)
        puts "channels: the forced task moved to another worker and its thread-local read named that worker"
        finished.add(1_i64)
        0
      end
      wait_or_fail(started, 1_i64, "channels: progress hang: the forced task did not park")
      g.spawn(unit: :new) do
        sibling.add(1_i64)
        hold_until_or_fail(release_sibling, 1_i64, "channels: progress hang: the sibling was not released")
        0
      end
      wait_or_fail(sibling, 1_i64, "channels: progress hang: the sibling did not start")
      feed.send(1)
      stop_holders.add(1_i64)
      wait_or_fail(finished, 1_i64, "channels: progress hang: the forced task did not finish")
      release_sibling.add(1_i64)
    end
  end

  # ── sockets ──────────────────────────────────────────────────────────
  # 16 connections, a parallel task each, served for 12 requests: the
  # task reads the request, parked on its socket, computes, and hands the
  # answer to a writer - a task of its own on the same socket, which may
  # run on another worker and, on Windows, moves the socket to that
  # worker's port while the reader's next read is posted on its own.
  #
  # A read moves only when another worker takes its socket's news, which
  # a host loaded past its cores makes rarer: Linux on 12 vCPUs moved 12
  # to 92 of the 192 reads a run, and beside 12 busy loops, at a load of
  # 34, one run moved none. A run that moves none holds nothing of what a
  # move keeps, so it is run again, up to SOCKET_RUNS times; one in which
  # no read ever moves fails.
  SOCKET_RUNS = 5

  def sockets(watch : Int32) : Nil
    watched("sockets", watch) do
      conns = 16
      rounds = 12
      stops = IyiThread.stops
      runs = 0
      moved = 0_i64
      while moved == 0_i64 && runs < SOCKET_RUNS
        runs += 1
        moved = socket_run(conns, rounds)
        break if IyiWorkers.count <= 1
      end
      if IyiWorkers.count > 1 && moved == 0_i64
        fail("sockets: none of #{conns * rounds} reads parked on a socket resumed on another worker, in #{runs} runs")
      end
      again = runs > 1 ? " (run #{runs}; the #{runs - 1} before moved none)" : ""
      puts "sockets: #{conns} connections, #{rounds} requests each read and answered in order, #{moved} reads resumed on another worker#{again}, through #{IyiThread.stops - stops} stops"
    end
  end

  # One run of the sockets step: the reads that resumed on another worker.
  def socket_run(conns : Int32, rounds : Int32) : Int64
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    moves = Tally.new
    answered = Tally.new
    group do |g|
      g.spawn do
        conns.times do |c|
          client = listener.accept
          fail("sockets: accept answered #{client}") unless client.is_a?(IyiSocket)
          fd = client.fd
          family = client.family
          g.spawn(unit: :new) do
            socket = IyiSocket.new(fd, family)
            kept = build(2000, c.to_i64 + 100_i64)
            answers = Channel(Int32).new(rounds)
            group do |inner|
              inner.spawn do
                rounds.times do
                  n = answers.receive
                  fail("sockets: the writer's channel answered #{n}") unless n.is_a?(Int32)
                  wrote = socket.write("#{n}.")
                  fail("sockets: a write answered #{wrote}") unless wrote.is_a?(Int32)
                end
                0
              end
              rounds.times do |r|
                os = os_thread
                st = IyiScheduler.state.object_id
                got = socket.read(64)
                moves.add(1_i64) if moved?("sockets", os, st)
                fail("sockets: connection #{c} read #{got} where request #{r} was sent") unless got == "q#{c}.#{r};"
                churn(3000)
                spin(200000_i64, r.to_u64)
                fail("sockets: connection #{c}'s list was not whole after request #{r}") unless whole?(kept, 2000, c.to_i64 + 100_i64)
                answered.add(1_i64)
                answers.send(r)
              end
            end
            socket.close
            0
          end
        end
        0
      end
      clients = [] of IyiSocket
      conns.times do
        c = IyiSocket.connect("127.0.0.1", port, 5000)
        fail("sockets: connect answered #{c}") unless c.is_a?(IyiSocket)
        clients << c
      end
      rounds.times do |r|
        clients.each_with_index do |client, c|
          wrote = client.write("q#{c}.#{r};")
          fail("sockets: a client's write answered #{wrote}") unless wrote.is_a?(Int32)
        end
        clients.each do |client|
          got = client.read(16)
          fail("sockets: a client read #{got} where the answer to #{r} was due") unless got == "#{r}."
        end
      end
      clients.each(&.close)
    end
    listener.close
    fail("sockets: #{answered.count} of #{conns * rounds} requests answered") unless answered.count == (conns * rounds).to_i64
    moves.count
  end

  # The io waiters the registry holds, by state: each parked read is WaitingIo
  # once it has registered with its worker's poller and is on the list cancel
  # walks. Read unlocked, which is safe here: no fiber of this step ends until
  # it is cancelled, so no link changes under the walk.
  def io_waiting : Int32
    count = 0
    fiber = IyiScheduler.first_fiber
    while fiber.is_a?(IyiFiber)
      count += 1 if fiber.state == IyiFiberState::WaitingIo
      fiber = fiber.next_fiber
    end
    count
  end

  # ── cancel ───────────────────────────────────────────────────────────
  {% if flag?(:unlistedio_force) %}
  # Cancel only after every reader has switched out of its io wait, past
  # its own cancellation check. Then count the listed-owner routes.
  def switched_out?(id : UInt64, state : IyiFiberState) : Bool
    fiber = IyiScheduler.first_fiber
    while fiber.is_a?(IyiFiber)
      return fiber.state == state && !fiber.on_cpu? if fiber.object_id == id
      fiber = fiber.next_fiber
    end
    false
  end

  def cancel_io_forced : Nil
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    ends = [] of IyiSocket
    fds = [] of Int32
    families = [] of Int32
    slots = [] of Armed
    readers = 8
    answered = Tally.new
    cancelled = Tally.new
    group do |g|
      readers.times do
        p = pair(listener, port)
        ends << p[0]
        ends << p[1]
        fds << p[1].fd
        families << p[1].family
      end
      base = IyiScheduler.force_armed_count
      readers.times do |i|
        slot = Armed.new
        slots << slot
        fd = fds[i]
        family = families[i]
        g.spawn(unit: :new) do
          slot.note_fiber(IyiScheduler.current.object_id)
          outcome = IyiSocket.new(fd, family).read(16)
          cancelled.add(1_i64) if outcome.is_a?(Cancelled)
          answered.add(1_i64)
          0
        end
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiScheduler.force_armed_count < base + readers.to_u64
        sleep(1)
        fail("cancel: progress hang: the readers did not register their io waits in 10000 ms") if __iyi_monotonic_ns > limit
      end
      slots.each do |slot|
        fail("cancel: not armed: a reader was not parked in its io wait") unless fiber_in_state?(slot.fiber, IyiFiberState::WaitingIo)
      end
      slots.each do |slot|
        limit = __iyi_monotonic_ns + 10_000_000_000_i64
        while !switched_out?(slot.fiber, IyiFiberState::WaitingIo)
          sleep(1)
          fail("cancel: progress hang: a reader did not switch out of its io wait in 10000 ms") if __iyi_monotonic_ns > limit
        end
      end
      before = IyiScheduler.force_dispatched_count
      g.cancel_children
      found = IyiScheduler.force_dispatched_count - before
      fail("cancel: a cancel found no listed owner for a reader switched out of its io wait") if found < readers.to_u64
      wait_or_fail(answered, readers.to_i64, "cancel: progress hang: the cancelled readers did not answer")
      fail("cancel: a cancelled reader's read answered other than Cancelled") unless cancelled.count == readers.to_i64
      puts "cancel: a cancel found the listed owner of every reader switched out of its io wait, and each read answered Cancelled"
    end
    ends.each(&.close)
    listener.close
  end
  {% end %}

  # Tasks that moved first, then parked - on a socket nobody writes, in a
  # sleep, on a channel nobody sends on - are cancelled by a sibling's
  # failure, from whichever thread it fails on: each answers `Cancelled`.
  def cancel(watch : Int32) : Nil
    {% if flag?(:unlistedio_force) %}
      cancel_io_forced
      return
    {% end %}
    watched("cancel", watch) do
      kinds = 3
      per = 8
      listener = IyiSocket.listen("127.0.0.1", 0)
      port = listener.local_port
      ends = [] of IyiSocket
      fds = [] of Int32
      families = [] of Int32
      per.times do
        p = pair(listener, port)
        ends << p[0]
        ends << p[1]
        fds << p[1].fd
        families << p[1].family
      end
      go = Channel(Int32).new
      never = Channel(Int32).new
      parked = Tally.new
      cancelled = Tally.new
      moves = Tally.new
      began = 0_i64
      group do |g|
        (kinds * per).times do |i|
          kind = i % kinds
          fd = fds[i // kinds]
          family = families[i // kinds]
          g.spawn(unit: :new) do
            os = os_thread
            st = IyiScheduler.state.object_id
            go.receive
            moves.add(1_i64) if moved?("cancel", os, st)
            parked.add(1_i64)
            outcome = if kind == 0
                        socket = IyiSocket.new(fd, family)
                        socket.read(16)
                      elsif kind == 1
                        sleep(20000)
                      else
                        never.receive
                      end
            cancelled.add(1_i64) if outcome.is_a?(Cancelled)
            0
          end
        end
        (kinds * per).times { go.send(1) }
        while parked.count < (kinds * per).to_i64
          sleep(1)
        end
        waited = 0
        while io_waiting < per
          sleep(1)
          waited += 1
          fail("cancel: the socket reads did not park in the io wait in 10000 ms") if waited > 10000
        end
        began = __iyi_monotonic_ns
        g.spawn(unit: :new) { Boom.new }
      end
      took = elapsed_ms(began)
      ends.each(&.close)
      listener.close
      fail("cancel: #{cancelled.count} of #{kinds * per} parked tasks answered Cancelled") unless cancelled.count == (kinds * per).to_i64
      fail("cancel: a failure took #{took} ms to cancel tasks parked on other workers") if took >= 3000
      puts "cancel: #{kinds * per} tasks, #{moves.count} of them moved before they parked on a socket, a sleep or a channel, all cancelled in #{took} ms"
    end
  end

  # ── closes ───────────────────────────────────────────────────────────
  # A socket closed on another thread than the one its read parked on
  # wakes the read there: the close is the reader's poller's news, posted
  # to its thread (`IyiScheduler.wake_closed`).
  #
  # 16 sockets are each read and closed by two tasks of one parallel task.
  # The closer is woken from the main thread into the pool's shared queue
  # and whichever worker takes it first runs it, which may be the reader's
  # own: darwin's release build once had all 16 closers there (CI job
  # 121953306559), and its plain build on 3 cores, run until one crossed,
  # had none of 80 cross in five rounds of 16 (job 122696158944). A close
  # made on another thread than its reader's is the precondition the step
  # needs, so a seventeenth socket is read by a parallel task and closed
  # by the main thread, which is never a pool worker: one close each run
  # crosses by construction. 120 runs of the step crossed on a 12-core
  # Linux machine, 30 of each build held to 3 cores (`taskset -c 0-2`) and
  # 30 on all 12, the siblings 0 to 16 times of 16 and not once in two
  # release runs, one on 3 cores and one on 12; and 10 of each build on
  # macos-14's 3 cores, the siblings 8 to 15 times (job 122760384513), and
  # on windows-2025's 4, 8 to 14 times (job 122760384624).
  #
  # The main thread's close is the call a worker's is: `wake_closed` posts
  # to whichever thread's poller holds the read, from any thread, so a
  # close posted to no thread leaves that read parked in every run
  # (bench/parallel_exercise.sh's `noclose`). The main thread's close
  # alone, the 16 siblings taken out, woke its read in 5 runs of 5 on
  # Linux, and under `noclose` left it parked in 5 of 5.
  #
  # The seventeenth socket is one object, the one the main thread
  # accepted, lent to its reader (`Lent`) and closed by the main thread
  # alone: a second object for its fd would keep its own `@fd`, and the
  # read woken in it would ask the kernel for a closed descriptor's bytes,
  # or a reused one's. The 16 accepted objects whose fds the tasks close
  # are dropped open: iyi has no finalizers (prelude.iyi's sweep), so
  # nothing closes a number twice. Under `-Dparallel_closes_home` the
  # seventeenth read is a task of the main thread's own, made where its
  # close is, and the step fails by name.
  def closes(watch : Int32) : Nil
    watched("closes", watch) do
      units = 16
      listener = IyiSocket.listen("127.0.0.1", 0)
      port = listener.local_port
      ends = [] of IyiSocket
      fds = [] of Int32
      families = [] of Int32
      units.times do
        p = pair(listener, port)
        ends << p[0]
        fds << p[1].fd
        families << p[1].family
      end
      last = pair(listener, port)
      ends << last[0]
      lent = Lent.new(last[1])
      {% if flag?(:noclose_force) %}
        IyiScheduler.force_close_target(lent.socket.fd)
      {% end %}
      lent_reader = Where.new
      go = Channel(Int32).new
      waiting = Tally.new
      woken = Tally.new
      crossed = Tally.new
      main_crossed = false
      group do |g|
        units.times do |u|
          fd = fds[u]
          family = families[u]
          g.spawn(unit: :new) do
            socket = IyiSocket.new(fd, family)
            reader_on = 0_u64
            group do |inner|
              inner.spawn do
                reader_on = os_thread
                waiting.add(1_i64)
                got = socket.read(16)
                woken.add(1_i64) if got.is_a?(Cancelled)
                0
              end
              inner.spawn do
                go.receive
                crossed.add(1_i64) if os_thread != reader_on
                socket.close
                0
              end
            end
            0
          end
        end
        {% if flag?(:parallel_closes_home) %}
          # The main thread's own task: its block captures only `Share`
          # values, so a plain spawn would run on the pool (SPEC.md III.4.15).
          g.spawn(unit: :same) { lent_read(lent, lent_reader, waiting, woken) }
        {% else %}
          g.spawn(unit: :new) { lent_read(lent, lent_reader, waiting, woken) }
        {% end %}
        while waiting.count < (units + 1).to_i64
          sleep(1)
        end
        {% if flag?(:noclose_force) %}
          started = __iyi_monotonic_ns
          while !IyiScheduler.force_close_registered?
            sleep(1)
            fail("closes: the targeted reader did not complete io registration") if elapsed_ms(started) >= watch.to_i64
          end
        {% else %}
          sleep(20)
        {% end %}
        units.times { go.send(1) }
        main_crossed = os_thread != lent_reader.thread
        lent.socket.close
      end
      ends.each(&.close)
      listener.close
      fail("closes: #{woken.count} of #{units + 1} reads woke when their socket was closed") unless woken.count == (units + 1).to_i64
      fail("closes: the main thread closed a socket on the thread its reader parked on") unless main_crossed
      puts "closes: #{units + 1} reads woken by a close, the main thread's and #{units} a sibling task's, #{crossed.count} of those made on another worker"
    end
  end

  # The seventeenth socket's read, the thread it parks on noted for the
  # main thread's close to be measured against.
  def lent_read(lent : Lent, where : Where, waiting : Tally, woken : Tally) : Int32
    where.note(os_thread)
    waiting.add(1_i64)
    got = lent.socket.read(16)
    woken.add(1_i64) if got.is_a?(Cancelled)
    0
  end

  # The socket the main thread closes under a parallel task's read. Not
  # `Share` by its fields - `close` writes `@fd` - and trusted for the one
  # crossing the step makes: the main thread writes `@fd` before the call
  # that wakes the read, the post `wake_closed` makes under the scheduler's
  # lock or on Windows the closesocket whose completion ends it, the order
  # a sibling's close on another worker relies on too.
  @[Share]
  class Lent
    getter socket : IyiSocket

    def initialize(@socket : IyiSocket)
    end
  end

  # The thread a task was on, as `os_thread` reads it, for another to read:
  # `Share` by its atomic field.
  class Where
    @thread : Atomic(UInt64)

    def initialize
      @thread = Atomic(UInt64).new(0_u64)
    end

    def note(thread : UInt64) : Nil
      @thread.set(thread)
    end

    def thread : UInt64
      @thread.get
    end
  end

  # ── deep ─────────────────────────────────────────────────────────────
  # After every move, frames 120 KiB deep on the fiber's stack: on
  # Windows the pages under the committed top are committed by the
  # kernel as the probes reach the guard page, against the stack bounds
  # in the TEB of the thread now running the fiber.
  #
  # A wake moves only when another worker takes it, which a loaded host
  # makes rarer, as for the sockets: earlier gate runs here moved 19 to
  # 150 of the 160, and beside 12 busy loops (`procs_running` 17) one
  # release run moved none. A run that moves none holds nothing of what a
  # move keeps, so it is run again, up to DEEP_RUNS times; one in which
  # no wake ever moves fails.
  DEEP_RUNS = 5

  def deep_step(watch : Int32) : Nil
    watched("deep", watch) do
      tasks = 16
      rounds = 10
      runs = 0
      moved = 0_i64
      while moved == 0_i64 && runs < DEEP_RUNS
        runs += 1
        moved = deep_run(tasks, rounds)
        break if IyiWorkers.count <= 1
      end
      if IyiWorkers.count > 1 && moved == 0_i64
        fail("deep: no task resumed on another worker before its deep frames, in #{runs} runs")
      end
      again = runs > 1 ? " (run #{runs}; the #{runs - 1} before moved none)" : ""
      puts "deep: #{tasks * rounds} frames 120 KiB deep, #{moved} of them after a move#{again}"
    end
  end

  # One run of the deep step: the wakes that resumed on another worker.
  def deep_run(tasks : Int32, rounds : Int32) : Int64
    feed = Channel(Int32).new
    moves = Tally.new
    group do |g|
      tasks.times do |t|
        g.spawn(unit: :new) do
          rounds.times do |r|
            os = os_thread
            st = IyiScheduler.state.object_id
            feed.receive
            moves.add(1_i64) if moved?("deep", os, st)
            deep(200)
            churn(2000)
          end
          0
        end
      end
      (tasks * rounds).times { feed.send(1) }
    end
    moves.count
  end

  # ── loops ────────────────────────────────────────────────────────────
  # A task computing in a loop with no call in it gives its worker up at
  # the loop's back-edge (SPEC.md III.4.13, part 9), and may go on in the
  # middle of the loop on another worker. The check goes in after LLVM has
  # optimised the loop, so a thread-local read LLVM took as the same for
  # the whole function - hoisted out of a loop that stores nothing, and
  # shared with the reads before and after it - names the thread the task
  # left. aarch64 Linux read its thread pointer with `llvm.read_register`
  # until it took a volatile `mrs` (`codegen.cr#iyi_tpidr_el0`): built by
  # that compiler for aarch64-linux-gnu, release, this step loaded the line
  # once before the loop and failed at its first check under qemu-user,
  # in 2 runs of 2, where the volatile read passes.
  #
  # 16 tasks on the 4 workers each compute three loops of about 30 ms:
  # the thread's line (`IyiThread.current_line`, a thread-local) is read
  # before a loop, in every turn of it beside a xorshift walk, and right
  # after it, with the kernel's thread read by asm on either side. The
  # line after the loop and the kernel's thread changed together or not at
  # all; and of the loops that moved, some turn read the line of a thread
  # it moved to. Under `-Dparallel_hoisted_tls` the reads in and after the
  # loop are the one before it, as the hoisted code read them, and the step
  # fails by name.

  # The thread's line in or after the loop: read here, or under
  # `-Dparallel_hoisted_tls` the one read before the loop.
  def line_in_loop(before : UInt64) : UInt64
    {% if flag?(:parallel_hoisted_tls) %}
      before
    {% else %}
      IyiThread.current_line
    {% end %}
  end

  # One loop, all in one def as LLVM sees it, so the reads before, in and
  # after it are LLVM's to share: whether the task moved, the turns that
  # read another line than the one before the loop, and the walk's sum.
  @[NoInline]
  def line_loop(rounds : Int64, seed : UInt64) : Tuple(Bool, Int64, UInt64)
    os_before = os_thread
    line_before = IyiThread.current_line
    x = seed | 1_u64
    sum = 0_u64
    turned = 0_i64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      line = line_in_loop(line_before)
      turned = turned &+ (line != line_before ? 1_i64 : 0_i64)
      sum = sum &+ (line ^ x)
      i = i + 1
    end
    line_after = line_in_loop(line_before)
    os_after = os_thread
    if (os_after == os_before) != (line_after == line_before)
      puts "loops: the kernel's thread went #{os_before} -> #{os_after}, the thread's line #{line_before} -> #{line_after}"
      fail("loops: a thread-local read after a loop's back-edge check named another thread than the one the task was on")
    end
    {os_after != os_before, turned, sum}
  end

  def loops(watch : Int32) : Nil
    loops_forced(0_i64)
    watched("loops", watch) do
      t = __iyi_monotonic_ns
      x = spin(20_000_000_i64, 3_u64)
      ms = elapsed_ms(t)
      ms = ms + 1_i64 if x == 0_u64
      per_ms = 20_000_000_i64 // (ms > 0_i64 ? ms : 1_i64)
      tasks = 16
      rounds = 3
      moved = Tally.new
      turned = Tally.new
      sums = Tally.new
      preempts = IyiWorkers.preempts
      group do |g|
        tasks.times do |task|
          g.spawn(unit: :new) do
            rounds.times do |r|
              answer = line_loop(30_i64 * per_ms, (task * rounds + r + 1).to_u64)
              moved.add(1_i64) if answer[0]
              turned.add(answer[1])
              sums.add((answer[2] & 1_u64).to_i64)
            end
            0
          end
        end
      end
      given = IyiWorkers.preempts - preempts
      fail("loops: #{tasks} tasks computed #{tasks * rounds} loops of 30 ms on #{IyiWorkers.count} workers and none was preempted") if given == 0_u64
      if IyiWorkers.count > 1 && moved.count == 0_i64
        fail("loops: none of #{tasks * rounds} loops, preempted #{given} times, ended on another worker than it began on")
      end
      if moved.count > 0_i64 && turned.count == 0_i64
        fail("loops: #{moved.count} loops ended on another worker and no turn of any of them read the line of a thread it moved to")
      end
      puts "loops: #{tasks * rounds} loops of 30 ms preempted #{given} times, #{moved.count} ended on another worker than they began on, #{turned.count} turns read the line of a thread they moved to"
    end
  end

  # A loop run until *gate* is set, rather than for a count: the back-edge checks of line_loop, and the loop sets
  # *replaced* once its kernel thread is not the one it began on. Its post-loop check reads the thread-local, as
  # line_loop's does, and fails by name when the read named another thread.
  @[NoInline]
  def line_loop_live(gate : Tally, replaced : Tally, seed : UInt64) : Tuple(Bool, Int64, UInt64)
    os_before = os_thread
    line_before = IyiThread.current_line
    x = seed | 1_u64
    sum = 0_u64
    turned = 0_i64
    moved = false
    while gate.count < 1_i64
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      line = line_in_loop(line_before)
      turned = turned &+ (line != line_before ? 1_i64 : 0_i64)
      sum = sum &+ (line ^ x)
      if !moved && os_thread != os_before
        moved = true
        replaced.add(1_i64)
      end
    end
    line_after = line_in_loop(line_before)
    os_after = os_thread
    if (os_after == os_before) != (line_after == line_before)
      puts "loops: the kernel's thread went #{os_before} -> #{os_after}, the thread's line #{line_before} -> #{line_after}"
      fail("loops: a thread-local read after a loop's back-edge check named another thread than the one the task was on")
    end
    {os_after != os_before, turned, sum}
  end

  # The move a loop makes only when the monitor preempts it, made on purpose, for `hoistedtls`, and run before the
  # ordinary loops: every worker but one is held by a @[NoPreempt] task; a live loop computes on the one left; a
  # sibling queued behind it takes that worker once the monitor preempts the loop. A holder then ends, a worker takes
  # the loop, and the loop resumes on a worker it did not begin on (`replaced`). Only then is the loop let finish,
  # so its post-loop check runs there. Each wait has a named limit.
  def loops_forced(per_ms : Int64) : Nil
    holders = IyiWorkers.count - 1
    held = Tally.new
    stop_holders = Tally.new
    started = Tally.new
    sibling = Tally.new
    release_sibling = Tally.new
    replaced = Tally.new
    finished = Tally.new
    loop_gate = Tally.new
    group do |g|
      holders.times do
        g.spawn(unit: :new) do
          held.add(1_i64)
          hold_until_or_fail(stop_holders, 1_i64, "loops: progress hang: a holder was not released")
          0
        end
      end
      wait_or_fail(held, holders.to_i64, "loops: progress hang: the holders did not start")
      g.spawn(unit: :new) do
        started.add(1_i64)
        line_loop_live(loop_gate, replaced, 17_u64)
        finished.add(1_i64)
        0
      end
      wait_or_fail(started, 1_i64, "loops: progress hang: the loop did not start")
      g.spawn(unit: :new) do
        sibling.add(1_i64)
        hold_until_or_fail(release_sibling, 1_i64, "loops: progress hang: the sibling was not released")
        0
      end
      wait_or_fail(sibling, 1_i64, "loops: progress hang: the sibling did not start")
      stop_holders.add(1_i64)
      wait_or_fail(replaced, 1_i64, "loops: progress hang: the loop did not resume on another worker")
      loop_gate.add(1_i64)
      wait_or_fail(finished, 1_i64, "loops: progress hang: the loop did not finish")
      puts "loops: the forced loop resumed on another worker and its thread-local read named that worker"
      release_sibling.add(1_i64)
    end
  end

  # ── balance ──────────────────────────────────────────────────────────
  # The parked shape (#145): every task starts, and parks on a channel,
  # on one worker - the others are held by tasks that spin until all have
  # parked - and then each computes 25 ms. Woken from the main thread, a
  # task goes to the pool's shared queue; woken by a task on a worker, to
  # that worker's ring, and only a steal spreads it. Without moving, every
  # task resumes where it parked, on the one worker, at the workers' count
  # times the ideal. Held to twice the ideal, the work being each task's
  # own measured time.
  def balance_round(label : String, from_worker : Bool, per_ms : Int64) : Nil
    workers = IyiWorkers.count
    tasks = workers * 6
    gate = Channel(Int32).new
    arrived = Tally.new
    holding = Tally.new
    work = Tally.new
    grabs = IyiWorkers.grabs
    began = 0_i64
    group do |g|
      (workers - 1).times do
        g.spawn(unit: :new) do
          holding.add(1_i64)
          hold_until(arrived, tasks.to_i64, "balance: progress hang: a holder was not released")
          0
        end
      end
      while holding.count < (workers - 1).to_i64
        sleep(1)
      end
      tasks.times do |i|
        g.spawn(unit: :new) do
          arrived.add(1_i64)
          gate.receive
          t = __iyi_monotonic_ns
          x = spin(25_i64 * per_ms, (i + 1).to_u64)
          took = __iyi_monotonic_ns - t
          work.add(x == 0_u64 ? took + 1_i64 : took)
          0
        end
      end
      while arrived.count < tasks.to_i64
        sleep(1)
      end
      sleep(5)
      began = __iyi_monotonic_ns
      if from_worker
        g.spawn(unit: :new) do
          tasks.times { gate.send(1) }
          0
        end
      else
        tasks.times { gate.send(1) }
      end
    end
    wall = elapsed_ms(began)
    ideal = work.count // 1000000_i64 // workers.to_i64
    ideal = 1_i64 if ideal < 1_i64
    ratio = (wall * 100_i64 // ideal).to_f / 100.0
    took = IyiWorkers.grabs - grabs
    if wall > ideal * 2_i64
      puts "balance: #{tasks} tasks woken #{label}, #{wall} ms against #{ideal} ms of work per worker (#{ratio}x)"
      fail("balance: tasks woken #{label} exceeded the balance bound")
    end
    puts "balance: #{tasks} tasks parked on one worker, woken #{label}: #{wall} ms against an ideal #{ideal} ms (#{ratio}x), #{took} steals from a ring"
  end

  {% if flag?(:pinned_force) %}
  # Hold the target's owner until a spare resumes it; record the route that
  # ready selected before waiting for a resume.
  def balance_placement : Nil
    holders = IyiWorkers.count - 1
    gate = Channel(Int32).new
    holding = Tally.new
    holders_go = Tally.new
    owner_go = Tally.new
    target = Armed.new
    parked_on = Owner.new
    owner = Owner.new
    resumed_on = Owner.new
    group do |g|
      holders.times do
        g.spawn(unit: :new) do
          holding.add(1_i64)
          hold_until_or_fail(holders_go, 1_i64, "balance: progress hang: a holder was not released")
          0
        end
      end
      wait_or_fail(holding, holders.to_i64, "balance: progress hang: the holders did not start")
      g.spawn(unit: :new) do
        parked_on.note_worker(IyiScheduler.state.object_id)
        target.note_fiber(IyiScheduler.current.object_id)
        gate.receive
        resumed_on.note_worker(IyiScheduler.state.object_id)
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while target.fiber == 0_u64 || !parked_on_channel?(target.fiber)
        sleep(1)
        fail("balance: progress hang: the target did not park in 10000 ms") if __iyi_monotonic_ns > limit
      end
      g.spawn(unit: :new) do
        owner.note_worker(IyiScheduler.state.object_id)
        hold_until_or_fail(owner_go, 1_i64, "balance: progress hang: the owner was not released")
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while owner.worker == 0_u64
        sleep(1)
        fail("balance: progress hang: the owner did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      fail("balance: not armed: the owner did not start on the worker the target parked on") unless owner.worker == parked_on.worker
      holders_go.add(1_i64)
      IyiScheduler.force_pin_target(target.fiber)
      gate.send(1)
      route = IyiScheduler.force_pin_route
      fail("balance: a task woken from the main thread was sent back to the worker it parked on") if route == parked_on.worker
      fail("balance: a task woken from the main thread was routed neither to the pool's queue nor to the worker it parked on") unless route == 1_u64
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while resumed_on.worker == 0_u64
        sleep(1)
        fail("balance: progress hang: no spare resumed the target in 10000 ms while its worker was held") if __iyi_monotonic_ns > limit
      end
      elsewhere = resumed_on.worker != parked_on.worker
      owner_go.add(1_i64)
      fail("balance: not armed: the target resumed on the worker it parked on while the owner held it") unless elsewhere
      puts "balance: a task woken from the main thread was queued for the pool and resumed on a spare while the worker it parked on was held"
    end
  end
  {% end %}

  def balance(watch : Int32) : Nil
    watched("balance", watch) do
      {% if flag?(:pinned_force) %}
        balance_placement
      {% else %}
        # Calibrate only the timed benchmark, not the forced proof.
        t = __iyi_monotonic_ns
        x = spin(50_000_000_i64, 3_u64)
        ms = elapsed_ms(t)
        ms = ms + 1_i64 if x == 0_u64
        per_ms = 50_000_000_i64 // (ms > 0_i64 ? ms : 1_i64)
        balance_round("from the main thread", false, per_ms)
        balance_round("from a worker", true, per_ms)
      {% end %}
    end
  end

  # ── handoff ──────────────────────────────────────────────────────────
  # A task woken by a task of another unit goes into its waker's ring,
  # and the waker computes on: here a `@[NoPreempt]` loop, as the
  # runtime's own code is, which no back-edge check gives up. The worker
  # comes back for the woken task only when the loop ends, so an idle
  # worker must be called to take it then and there. Each of ten wakes
  # is timed from the send to the woken task's first statement after its
  # receive, beside a 50 ms hold: half must start within 1 ms, and none
  # may wait the hold out.
  #
  # The 1 ms is a sleeping kernel thread's wake, which Linux and Windows
  # do not owe on a machine with more runnable threads than cores: Linux
  # on 12 vCPUs at one-minute loads of 18 to 34 failed this step in 74 of
  # 80 runs, its medians 0.8 to 4.3 ms and most near 2.9, and Windows on
  # 12 vCPUs beside 12 and 24 busy loops in 32 of 80, while tmac (macOS
  # 26, 10 cores) at loads of 4 to 44 failed none of 160, at 7 to 218 us.
  # So the hand-off is also held where no clock can blur it: right after
  # its send, the waker's worker has called an idle worker for the woken
  # fiber (`handoff_last`, which only that worker writes and only its own
  # `pop` clears), and the woken task then runs on another worker. Those
  # hold on every machine; the median is judged unless
  # bench/parallel_exercise.sh passes `--loaded=`, its reading of a Linux
  # or Windows load at or past the cores, and the run then says so.
  @[NoInline]
  @[NoPreempt]
  def hold_np(ns : Int64) : Nil
    t = __iyi_monotonic_ns
    while __iyi_monotonic_ns - t < ns
      IyiThread.spin_pause
    end
  end

  # A bounded hold: the owner keeps its worker until *count* reaches *target*,
  # which another task sets. Its limit ends a hang as a named failure of the
  # rendezvous, never as a verdict on the copy.
  @[NoInline]
  @[NoPreempt]
  def hold_until_or_fail(count : Tally, target : Int64, what : String) : Nil
    limit = __iyi_monotonic_ns + 20_000_000_000_i64
    while count.count < target
      IyiThread.spin_pause
      fail("#{what}: the hold did not release in 20000 ms") if __iyi_monotonic_ns > limit
    end
  end

  # The main thread's wait for *count* to reach *target*, with the same limit.
  def wait_or_fail(count : Tally, target : Int64, what : String) : Nil
    limit = __iyi_monotonic_ns + 10_000_000_000_i64
    while count.count < target
      sleep(1)
      fail("#{what}: no progress in 10000 ms") if __iyi_monotonic_ns > limit
    end
  end

  # The fiber a forced round's sleeper parked as, set by the sleeper.
  class Armed
    @fiber : Atomic(UInt64)

    def initialize
      @fiber = Atomic(UInt64).new(0_u64)
    end

    def fiber : UInt64
      @fiber.get
    end

    def note_fiber(id : UInt64) : Nil
      @fiber.set(id)
    end
  end

  # Whether the fiber with object id *id* is parked on a channel now, read from
  # the scheduler's list of every fiber: a state, not a clock.
  def parked_on_channel?(id : UInt64) : Bool
    fiber = IyiScheduler.first_fiber
    while fiber.is_a?(IyiFiber)
      return fiber.state == IyiFiberState::WaitingCh if fiber.object_id == id
      fiber = fiber.next_fiber
    end
    false
  end

  # The forced round (`-Dnocall_force`), run first in a fresh process, so no
  # back-off is set. The sleeper parks on a channel and records its fiber; main
  # waits for that park, then lets the waker send from its own worker, which
  # holds that worker until main has read the copy's records for the sleeper.
  # The verdict is those records: the hand-off branch took the sleeper, and the
  # wake_one made on the branch's worker woke it. A missing wake_one is the
  # mutant's verdict. The claim is exact: the immediate call was made or omitted
  # at the hand-off's site; it does not say that an idle worker was rung.
  {% if flag?(:nocall_force) || flag?(:nohandoff_force) %}
  def handoff_forced : Nil
    armed = Armed.new
    gate = Channel(Int64).new(1)
    go = Tally.new
    sent = Tally.new
    release = Tally.new
    group do |g|
      g.spawn(unit: :new) do
        armed.note_fiber(IyiScheduler.current.object_id)
        gate.receive
        0
      end
      g.spawn(unit: :new) do
        hold_until_or_fail(go, 1_i64, "nocall: progress hang: the waker was not released")
        gate.send(__iyi_monotonic_ns)
        sent.add(1_i64)
        hold_until_or_fail(release, 1_i64, "nocall: progress hang: the waker's worker was not released")
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while armed.fiber == 0_u64
        sleep(1)
        fail("nocall: progress hang: the sleeper did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !parked_on_channel?(armed.fiber)
        sleep(1)
        fail("nocall: progress hang: the sleeper did not park in 10000 ms") if __iyi_monotonic_ns > limit
      end
      {% if flag?(:nohandoff_force) %}
        IyiWorkers.force_handoff_key(armed.fiber)
      {% end %}
      go.add(1_i64)
      wait_or_fail(sent, 1_i64, "nocall: progress hang: the send did not return")
      {% if flag?(:nohandoff_force) %}
        decision = IyiWorkers.force_handoff_decision
        release.add(1_i64)
        fail("handoff: not eligible: back-off was active at the target decision") if decision == 3_u64
        fail("handoff: an eligible hand-off for a parked task took no hand-off branch") if decision == 5_u64
        fail("handoff: not armed: the target was not an eligible hand-off without back-off") unless decision == 2_u64
        puts "handoff: the eligible hand-off for a parked task took its branch with no back-off"
      {% else %}
        fiber = armed.fiber
        fail("nocall: not armed: the hand-off branch did not take the parked task") unless IyiWorkers.force_branch_id == fiber
        woke = IyiWorkers.force_wake_id == fiber
        release.add(1_i64)
        fail("nocall: a hand-off for a parked task omitted its immediate wake_one call") unless woke
        puts "nocall: the hand-off for a parked task made its immediate wake_one call"
      {% end %}
    end
  end
  {% end %}

  # What a hand-off's two tasks saw: the woken fiber, the worker it ran
  # on, its waker's worker and whether that worker called for it.
  class Handed
    @fiber : Atomic(UInt64)
    @woken_on : Atomic(UInt64)
    @held_on : Atomic(UInt64)
    @called : Atomic(UInt64)

    def initialize
      @fiber = Atomic(UInt64).new(0_u64)
      @woken_on = Atomic(UInt64).new(0_u64)
      @held_on = Atomic(UInt64).new(0_u64)
      @called = Atomic(UInt64).new(0_u64)
    end

    def note_fiber(id : UInt64) : Nil
      @fiber.set(id)
    end

    def fiber : UInt64
      @fiber.get
    end

    def note_woken_on(worker : UInt64) : Nil
      @woken_on.set(worker)
    end

    def note_held_on(worker : UInt64, called : UInt64) : Nil
      @held_on.set(worker)
      @called.set(called == @fiber.get ? 1_u64 : 0_u64)
    end

    def called? : Bool
      @called.get == 1_u64
    end

    def stayed? : Bool
      @woken_on.get == @held_on.get
    end
  end

  def handoff(watch : Int32, loaded : String) : Nil
    {% if flag?(:nocall_force) || flag?(:nohandoff_force) %}
      handoff_forced
      return
    {% end %}
    watched("handoff", watch) do
      rounds = 10
      waits = [] of Int64
      uncalled = 0
      stayed = 0
      rounds.times do
        gate = Channel(Int64).new(1)
        handed = Handed.new
        sleeper = nil.as(IyiTask(Int64)?)
        group do |g|
          sleeper = g.spawn(unit: :new) do
            handed.note_fiber(IyiScheduler.current.object_id)
            sent = gate.receive
            took = sent.is_a?(Int64) ? __iyi_monotonic_ns - sent : -1_i64
            handed.note_woken_on(IyiScheduler.state.object_id)
            took
          end
          g.spawn(unit: :new) do
            limit = __iyi_monotonic_ns + 10_000_000_000_i64
            while handed.fiber == 0_u64 || !parked_on_channel?(handed.fiber)
              sleep(1)
              fail("handoff: progress hang: the sleeper did not park in 10000 ms") if __iyi_monotonic_ns > limit
            end
            gate.send(__iyi_monotonic_ns)
            st = IyiScheduler.state
            handed.note_held_on(st.object_id, st.handoff_last)
            hold_np(50_000_000_i64)
            0
          end
        end
        task = sleeper
        got = task.is_a?(IyiTask(Int64)) ? task.value : -1_i64
        waits << (got.is_a?(Int64) ? got : -1_i64)
        uncalled += 1 unless handed.called?
        stayed += 1 if handed.stayed?
      end
      fail("handoff: a woken task answered no wait: #{waits}") if waits.any? { |w| w < 0_i64 }
      {% if flag?(:nocall_force) %}
        # The forced copy's wake calls are judged by handoff_forced, keyed to the sleeper's fiber. This round's
        # placement and start-time judgements are the healthy gate's, and this copy skips them.
        puts "handoff: #{rounds} tasks woken onto a worker held 50 ms with preemption off, under the forced copy"
      {% else %}
      if uncalled > 0
        puts "handoff: #{uncalled} of #{rounds} parked tasks were handed over without an idle worker called"
        fail("handoff: a parked task was handed over without an idle worker called")
      end
      sorted = waits.sorted
      if stayed > 0
        fail("handoff: #{stayed} of #{rounds} tasks woken onto a worker held 50 ms with preemption off ran on that worker, after #{sorted.map { |w| w // 1000_i64 }} us")
      end
      median = sorted[rounds // 2]
      longest = sorted[rounds - 1]
      if longest >= 40_000_000_i64 || (loaded.empty? && median > 1_000_000_i64)
        fail("handoff: tasks woken onto a worker held 50 ms with preemption off started after #{sorted.map { |w| w // 1000_i64 }} us, while other workers were idle")
      end
      judged = loaded.empty? ? "" : "; the 1 ms median not judged, #{loaded}"
      puts "handoff: #{rounds} tasks woken onto a worker held 50 ms with preemption off, each with an idle worker called and run on another, started in #{median // 1000_i64} us at the median, #{longest // 1000_i64} us at most#{judged}"
      {% end %}
    end
  end

  # ── backstop ─────────────────────────────────────────────────────────
  # The same wake right after its waker ping-ponged with another task
  # 20,000 times: the worker took back the fiber it called for each time,
  # so its back-off calls nobody for the hand-off (`push_runnable`), and
  # the waker then holds the worker 100 ms with preemption off. The
  # monitor, seeing the worker held a tick with a fiber in its ring,
  # calls an idle worker: each of five wakes must start within 50 ms.
  def backstop(watch : Int32) : Nil
    {% if flag?(:nobackstop_force) %}
      backstop_forced
      return
    {% end %}
    watched("backstop", watch) do
      rounds = 5
      waits = [] of Int64
      rounds.times do
        gate = Channel(Int64).new(1)
        ping = Channel(Int32).new
        pong = Channel(Int32).new
        arrived = Tally.new
        sleeper = nil.as(IyiTask(Int64)?)
        group do |g|
          sleeper = g.spawn(unit: :new) do
            arrived.add(1_i64)
            sent = gate.receive
            sent.is_a?(Int64) ? __iyi_monotonic_ns - sent : -1_i64
          end
          g.spawn(unit: :new) do
            20_000.times do
              v = ping.receive
              pong.send(v.is_a?(Int32) ? v : 0)
            end
            0
          end
          g.spawn(unit: :new) do
            while arrived.count < 1_i64
              sleep(1)
            end
            sleep(5)
            20_000.times do |i|
              ping.send(i)
              pong.receive
            end
            gate.send(__iyi_monotonic_ns)
            hold_np(100_000_000_i64)
            0
          end
        end
        task = sleeper
        got = task.is_a?(IyiTask(Int64)) ? task.value : -1_i64
        waits << (got.is_a?(Int64) ? got : -1_i64)
      end
      fail("backstop: a woken task answered no wait: #{waits}") if waits.any? { |w| w < 0_i64 }
      sorted = waits.sorted
      held = waits.count { |w| w > 1_000_000_i64 }
      if sorted[rounds - 1] >= 50_000_000_i64
        fail("backstop: tasks woken after a ping-pong onto a worker held 100 ms with preemption off started after #{sorted.map { |w| w // 1000_i64 }} us")
      end
      puts "backstop: #{rounds} tasks woken after a ping-pong onto a worker held 100 ms started in #{sorted[rounds // 2] // 1000_i64} us at the median, #{sorted[rounds - 1] // 1000_i64} us at most, #{held} after more than 1 ms"
    end
  end

  # The owner's worker, as the waker noted it (its state id).
  class Owner
    @worker : Atomic(UInt64)

    def initialize
      @worker = Atomic(UInt64).new(0_u64)
    end

    def worker : UInt64
      @worker.get
    end

    def note_worker(id : UInt64) : Nil
      @worker.set(id)
    end
  end

  {% if flag?(:nobackstop_force) %}
  # Warm the lazily grown pool, hold all but the owner and a spare, and arm
  # the hand-off backoff in the copy. The target must take the skip branch;
  # the monitor must find its ring with an idle worker before it decides.
  def backstop_forced : Nil
    gate = Channel(Int64).new(1)
    go = Tally.new
    sent = Tally.new
    release = Tally.new
    parked = Tally.new
    owner = Owner.new
    sleeper = Armed.new
    warm_started = Tally.new
    warm_release = Tally.new
    group do |warm|
      IyiWorkers.count.times do
        warm.spawn(unit: :new) do
          warm_started.add(1_i64)
          hold_until_or_fail(warm_release, 1_i64, "backstop: progress hang: a warm-up worker")
          0
        end
      end
      wait_or_fail(warm_started, IyiWorkers.count.to_i64, "backstop: progress hang: the pool did not warm")
      warm_release.add(1_i64)
    end
    holders = IyiWorkers.count - 2
    group do |g|
      holders.times do
        g.spawn(unit: :new) do
          parked.add(1_i64)
          hold_until_or_fail(release, 1_i64, "backstop: progress hang: a holder")
          0
        end
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while parked.count < holders.to_i64
        sleep(1)
        fail("backstop: progress hang: the holders did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      g.spawn(unit: :new) do
        sleeper.note_fiber(IyiScheduler.current.object_id)
        gate.receive
        0
      end
      g.spawn(unit: :new) do
        owner.note_worker(IyiScheduler.state.object_id)
        hold_until_or_fail(go, 1_i64, "backstop: progress hang: the waker was not released")
        {% if flag?(:nobackstop_force) %}
          IyiWorkers.force_reset
          IyiWorkers.force_target(owner.worker, sleeper.fiber)
        {% end %}
        gate.send(__iyi_monotonic_ns)
        sent.add(1_i64)
        hold_until_or_fail(release, 1_i64, "backstop: progress hang: the waker's worker")
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while sleeper.fiber == 0_u64
        sleep(1)
        fail("backstop: progress hang: the sleeper did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !parked_on_channel?(sleeper.fiber)
        sleep(1)
        fail("backstop: progress hang: the sleeper did not park in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while owner.worker == 0_u64
        sleep(1)
        fail("backstop: progress hang: the waker did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiScheduler.waiting_threads < 1_u64
        sleep(1)
        fail("backstop: progress hang: no spare worker entered its idle wait in 10000 ms") if __iyi_monotonic_ns > limit
      end
      looks = IyiWorkers.looks
      go.add(1_i64)
      limit = __iyi_monotonic_ns + 60_000_000_000_i64
      while sent.count < 1_i64
        sleep(1)
        fail("backstop: progress hang: the send did not return in 60000 ms") if __iyi_monotonic_ns > limit
      end
      fail("backstop: not armed: the target hand-off did not skip its wake") unless IyiWorkers.force_skipped?
      worker = owner.worker
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiWorkers.force_done_id != worker
        sleep(1)
        if __iyi_monotonic_ns > limit
          fail("backstop: progress hang: no decision for held ring in 10000 ms; owner=#{owner.worker} released=#{release.count} spare_waiting=#{IyiScheduler.waiting_threads} looks=#{IyiWorkers.looks - looks} #{IyiWorkers.force_figures}")
        end
      end
      fail("backstop: not armed: the monitor found no idle spare at the target ring") unless IyiWorkers.force_idle?
      puts "backstop: figures: #{IyiWorkers.force_figures}"
      called = IyiWorkers.force_woke_done == 1_u64
      release.add(1_i64)
      fail("backstop: the monitor's stuck decision for a held ring omitted its wake_one call") unless called
      puts "backstop: the monitor's stuck decision for a held ring called wake_one"
    end
  end
  {% end %}

  # ── heldio ───────────────────────────────────────────────────────────
  # A reader parks on a socket, then a sibling holds its worker with
  # preemption off until the answer is read on another worker. Linux and
  # darwin use the reader's own poller; Windows uses a shared port, covered
  # by bench/completions_taken.iyi. Each round is run once.
  HELD_ROUNDS = 5

  # The reader and sibling publish their workers and read time atomically.
  class Held
    @reader : Atomic(UInt64)
    @read_on : Atomic(UInt64)
    @holding : Atomic(Int64)
    @read_at : Atomic(Int64)

    def initialize
      @reader = Atomic(UInt64).new(0_u64)
      @read_on = Atomic(UInt64).new(0_u64)
      @holding = Atomic(Int64).new(0_i64)
      @read_at = Atomic(Int64).new(0_i64)
    end

    def reader : UInt64
      @reader.get
    end

    def note_reader(id : UInt64) : Nil
      @reader.set(id)
    end

    def read_on : UInt64
      @read_on.get
    end

    def note_read_on(id : UInt64) : Nil
      @read_on.set(id)
    end

    def holding : Int64
      @holding.get
    end

    def note_holding(how : Int64) : Nil
      @holding.set(how)
    end

    def read_at : Int64
      @read_at.get
    end

    def note_read_at(ns : Int64) : Nil
      @read_at.set(ns)
    end

  end

  # One round: the nanoseconds from the send to the read while the reader's
  # worker is held. A sibling that starts elsewhere fails by name.
  def held_round(listener : IyiSocket, port : Int32, number : Int32) : Int64
    near, far = pair(listener, port)
    far_fd = far.fd
    family = far.family
    marks = Held.new
    sent_at = 0_i64
    parked = Tally.new
    release = Tally.new
    owner_go = Tally.new
    group do |g|
      # The other workers are held, with preemption off, until the sibling
      # sits on the reader's worker: nothing can steal it there, so no round is
      # run again. The holders are let go before the write, so the answer is
      # woken by the runtime, not by a holder.
      holders = IyiWorkers.count - 1
      holders.times do
        g.spawn(unit: :new) do
          parked.add(1_i64)
          hold_until(release, 1_i64, "heldio: progress hang: a holder was not released")
          0
        end
      end
      waited = 0
      while parked.count < holders.to_i64
        sleep(1)
        waited = waited + 1
        fail("heldio: round #{number}'s holders did not start in 10000 ms") if waited > 10000
      end
      g.spawn(unit: :new) do
        group do |inner|
          # Onto this worker's own queue, which it takes from next once the
          # read below parks; no other worker is free to take it.
          inner.spawn(unit: :new) do
            if IyiScheduler.state.object_id == marks.reader
              marks.note_holding(1_i64)
              hold_until_or_fail(owner_go, 1_i64, "heldio: progress hang: the reader's worker was not released")
            else
              marks.note_holding(2_i64)
            end
            0
          end
          marks.note_reader(IyiScheduler.state.object_id)
          got = IyiSocket.new(far_fd, family).read(1)
          marks.note_read_at(__iyi_monotonic_ns)
          marks.note_read_on(IyiScheduler.state.object_id)
          fail("heldio: round #{number}'s read answered #{got.inspect}") unless got == "x"
        end
        0
      end
      waited = 0
      while marks.holding == 0_i64
        sleep(1)
        waited = waited + 1
        fail("heldio: round #{number}'s sibling did not start in 10000 ms") if waited > 10000
      end
      fail("heldio: round #{number}'s sibling did not hold its reader's worker") unless marks.holding == 1_i64
      release.add(1_i64)
      sent_at = __iyi_monotonic_ns
      wrote = near.write("x")
      fail("heldio: round #{number}'s write answered #{wrote}") unless wrote.is_a?(Int32)
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while marks.read_on == 0_u64
        sleep(1)
        fail("heldio: progress hang: round #{number}'s answer was not read in 10000 ms") if __iyi_monotonic_ns > limit
      end
      fail("heldio: round #{number}'s answer was read on the worker that held") if marks.read_on == marks.reader
      owner_go.add(1_i64)
    end
    near.close
    far.close
    marks.read_at - sent_at
  end

  # Whether the fiber with object id *id* is in *state* now, read from the scheduler's list of every fiber.
  def fiber_in_state?(id : UInt64, state : IyiFiberState) : Bool
    fiber = IyiScheduler.first_fiber
    while fiber.is_a?(IyiFiber)
      return fiber.state == state if fiber.object_id == id
      fiber = fiber.next_fiber
    end
    false
  end

  {% if flag?(:noheldio_force) %}
  # The forced round (`-Dnoheldio_force`), first in its step. Holders keep every worker but the
  # one left, so the reader parks on that worker and its sibling, queued behind it, holds that
  # worker on a release word. Main confirms the read is registered (the reader is WaitingIo), the
  # sibling holds the reader's worker, and an idle spare waits (the holders are let go). Then the
  # answer is sent. The verdict is the monitor's decision for that poller after the send: news
  # found, and the wake that rings an idle worker made or omitted. A read on another worker must
  # come before the owner is released. Waits are on states and sequence words, with named hang limits.
  def heldio_forced : Nil
    listener = IyiSocket.listen("127.0.0.1", 0)
    port = listener.local_port
    near, far = pair(listener, port)
    far_fd = far.fd
    family = far.family
    marks = Held.new
    reader = Armed.new
    owner = Owner.new
    holders = IyiWorkers.count - 1
    parked = Tally.new
    holders_go = Tally.new
    owner_go = Tally.new
    group do |g|
      holders.times do
        g.spawn(unit: :new) do
          parked.add(1_i64)
          hold_until_or_fail(holders_go, 1_i64, "heldio: progress hang: a holder was not released")
          0
        end
      end
      wait_or_fail(parked, holders.to_i64, "heldio: progress hang: the holders did not start")
      g.spawn(unit: :new) do
        reader.note_fiber(IyiScheduler.current.object_id)
        group do |inner|
          inner.spawn(unit: :new) do
            owner.note_worker(IyiScheduler.state.object_id)
            hold_until_or_fail(owner_go, 1_i64, "heldio: progress hang: the sibling was not released")
            0
          end
          marks.note_reader(IyiScheduler.state.object_id)
          got = IyiSocket.new(far_fd, family).read(1)
          marks.note_read_at(__iyi_monotonic_ns)
          marks.note_read_on(IyiScheduler.state.object_id)
          fail("heldio: progress hang: the read answered #{got.inspect}") unless got == "x"
        end
        0
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while reader.fiber == 0_u64
        sleep(1)
        fail("heldio: progress hang: the reader did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while !fiber_in_state?(reader.fiber, IyiFiberState::WaitingIo)
        sleep(1)
        fail("heldio: progress hang: the read did not register in 10000 ms") if __iyi_monotonic_ns > limit
      end
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while owner.worker == 0_u64
        sleep(1)
        fail("heldio: progress hang: the sibling did not start in 10000 ms") if __iyi_monotonic_ns > limit
      end
      fail("heldio: not armed: the sibling did not start on its reader's worker") unless owner.worker == marks.reader
      IyiWorkers.force_io_target(owner.worker)
      holders_go.add(1_i64)
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiScheduler.waiting_threads < 1_u64
        sleep(1)
        fail("heldio: progress hang: no idle spare waited in 10000 ms") if __iyi_monotonic_ns > limit
      end
      sequence = IyiWorkers.force_seq
      wrote = near.write("x")
      fail("heldio: progress hang: the send answered #{wrote}") unless wrote.is_a?(Int32)
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while IyiWorkers.force_seq == sequence
        sleep(1)
        fail("heldio: progress hang: the monitor made no decision after the send in 10000 ms") if __iyi_monotonic_ns > limit
      end
      worker = owner.worker
      woke = IyiWorkers.force_done_id == worker && IyiWorkers.force_woke_done == 1_u64
      fail("heldio: the monitor's held-io decision for a reader's poller omitted the wake that rings an idle worker") unless woke
      limit = __iyi_monotonic_ns + 10_000_000_000_i64
      while marks.read_on == 0_u64
        sleep(1)
        fail("heldio: progress hang: the answer was not read in 10000 ms") if __iyi_monotonic_ns > limit
      end
      read_elsewhere = marks.read_on != worker
      owner_go.add(1_i64)
      fail("heldio: not armed: the answer was read on the worker that holds the reader") unless read_elsewhere
      puts "heldio: the answer sent to a reader parked on a held worker was read on another worker before the hold ended"
    end
    near.close
    far.close
    listener.close
  end
  {% end %}

  def heldio(watch : Int32) : Nil
    {% if flag?(:noheldio_force) %}
      heldio_forced
      return
    {% end %}
    watched("heldio", watch) do
      {% if flag?(:win32) %}
        puts "heldio: Windows' one port is any worker's to take from (bench/completions_taken.iyi holds it)"
      {% else %}
        listener = IyiSocket.listen("127.0.0.1", 0)
        port = listener.local_port
        took = [] of Int64
        HELD_ROUNDS.times do |round|
          took << held_round(listener, port, round + 1)
        end
        listener.close
        sorted = took.sorted
        puts "heldio: #{HELD_ROUNDS} answers sent while their reader's worker was held were read on another worker in #{sorted.map { |w| w // 1000_i64 }} us (#{HELD_ROUNDS} rounds)"
      {% end %}
    end
  end

  # ── join ─────────────────────────────────────────────────────────────
  # A task joining a thread parks: the task it spawned, asleep on the same
  # worker, wakes on time while the thread runs 400 ms. A join held in the
  # kernel held the worker, its sleepers and its unit with it.
  def join(watch : Int32) : Nil
    watched("join", watch) do
      answer = 0_i64
      group do |g|
        task = g.spawn(unit: :new) do
          started = __iyi_monotonic_ns
          child_at = -1_i64
          group do |inner|
            inner.spawn do
              sleep(20)
              child_at = elapsed_ms(started)
              0
            end
            thread = IyiThread.start do
              {% if flag?(:kerneljoin_force) %}
                wait_started = __iyi_monotonic_ns
                while IyiThread.force_join_decision == 0_u64
                  IyiThread.spin_pause
                  raise "join: progress hang: join did not record its decision" if elapsed_ms(wait_started) >= 10000_i64
                end
              {% end %}
              began = __iyi_monotonic_ns
              while __iyi_monotonic_ns - began < 400_000_000_i64
                IyiThread.spin_pause
              end
            end
            {% if flag?(:kerneljoin_force) %}
              IyiThread.force_join_key(thread)
            {% end %}
            thread.join
          end
          child_at
        end
        got = task.value
        fail("join: the joining task answered no Int64 result") unless got.is_a?(Int64)
        answer = got
      end
      fail("join: the child recorded no wake") if answer < 0_i64
      {% if flag?(:kerneljoin_force) %}
        decision = IyiThread.force_join_decision
        puts "join: the child's wake was #{answer} ms"
        fail("join: the join of a running thread entered the kernel's join without parking") if decision == 2_u64
        fail("join: not armed: the target join did not record its park path") unless decision == 1_u64
        puts "join: the join of a running thread took its park path"
      {% else %}
        if answer >= 300_i64
          puts "join: the child's measured wake was #{answer} ms"
          fail("join: the child's measured wake was outside the allowed range")
        end
      {% end %}
      puts "join: a task joining a 400 ms thread left its worker to its child, which woke #{answer} ms in"
    end
  end

  STEPS = ["channels", "sockets", "cancel", "closes", "deep", "loops", "balance", "handoff", "backstop", "heldio", "join"]

  watch = 60000
  loaded = ""
  chosen = [] of String
  Program.args.each do |argument|
    if argument.starts_with?("--watch=")
      watch = argument[8, argument.size - 8].to_i
    elsif argument.starts_with?("--loaded=")
      loaded = argument[9, argument.size - 9]
    else
      fail("no step named #{argument}") unless STEPS.includes?(argument)
      chosen << argument
    end
  end
  chosen = STEPS if chosen.empty?
  IyiWorkers.count = 4
  chosen.each do |name|
    case name
    when "channels" then channels(watch)
    when "sockets"  then sockets(watch)
    when "cancel"   then cancel(watch)
    when "closes"   then closes(watch)
    when "deep"     then deep_step(watch)
    when "loops"    then loops(watch)
    when "balance"  then balance(watch)
    when "handoff"  then handoff(watch, loaded)
    when "backstop" then backstop(watch)
    when "heldio"   then heldio(watch)
    when "join"     then join(watch)
    end
  end
  puts "parallel migration: every property held on #{IyiWorkers.count} workers"
{% else %}
  puts "parallel migration: no pool on this target, nothing to hold"
{% end %}
