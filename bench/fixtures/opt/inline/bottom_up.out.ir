; iyi-ir 1
source_filename = "bottom_up"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i64 @front(i64 %x) {
entry:
  br label %entry1
entry1:
  br label %entry12
entry12:
  %0 = sub i64 %x, 3
  br label %inline.cont
inline.cont:
  %1 = phi i64 [ %0, label %entry12 ]
  %2 = add i64 %1, 1
  %3 = add i64 %2, 2
  br label %inline.cont3
inline.cont3:
  %4 = phi i64 [ %3, label %inline.cont ]
  %z1 = add i64 %4, 1
  %z2 = add i64 %z1, 1
  %z3 = add i64 %z2, 1
  %z4 = add i64 %z3, 1
  %z5 = add i64 %z4, 1
  %z6 = add i64 %z5, 1
  %z7 = add i64 %z6, 1
  %z8 = add i64 %z7, 1
  %z9 = add i64 %z8, 1
  %z10 = add i64 %z9, 1
  %z11 = add i64 %z10, 1
  %z12 = add i64 %z11, 1
  %z13 = add i64 %z12, 1
  %z14 = add i64 %z13, 1
  ret i64 %z14
}
define internal i64 @middle(i64 %x) {
entry:
  br label %entry1
entry1:
  %0 = sub i64 %x, 3
  br label %inline.cont
inline.cont:
  %1 = phi i64 [ %0, label %entry1 ]
  %m1 = add i64 %1, 1
  %m2 = add i64 %m1, 2
  ret i64 %m2
}
define internal i64 @last(i64 %x) {
entry:
  %v = sub i64 %x, 3
  ret i64 %v
}
