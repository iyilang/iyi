# Exercises `std/float`: Float32 arithmetic and constants.
#
# Run via:
#     ./bin/iyi run bench/std_float_exercise.iyi

module bench/std_float_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/float

puts "== arithmetic"
assert_true 1.5_f32 + 1.5_f32 == 3.0_f32, "add"
assert_true 4.0_f32 / 2.0_f32 == 2.0_f32, "div"
assert_true (-1.5_f32).abs == 1.5_f32, "abs"
puts "  Float32 + / abs"

puts "\n== constants"
assert_true Float32::MAX > 1.0_f32, "max"
assert_true Float32::MIN < 0.0_f32, "min"
puts "  MAX, MIN"

puts "\nALL CHECKS PASSED"
