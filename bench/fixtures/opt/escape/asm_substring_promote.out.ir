; iyi-ir 1
source_filename = "escape_asm_substring"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal ptr @__iyi_new(i64 %size, i64 %tid, i64 %flags) {
entry:
  ret ptr null
}

define internal i64 @leaf(i64 %n) {
entry:
  %0 = alloca [8 x i8], align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 8, i1 false)
  store i64 %n, ptr %0, align 8
  %v = load i64, ptr %0, align 8
  ret i64 %v
}

define external i32 @main() {
entry:
  call void () asm sideeffect "adrp x0, ___iyi_fiber_main@PAGE", ""()
  ret i32 0
}

