puts "== a generated corpus round-tripped"
rng = Rng.new(0x9E3779B97F4A7C15_u64)
encodings = [] of Array(UInt8)
corpus = 0
variants = 0
1500.times do |n|
  v = generate(rng, 0)
  bytes = CBOR.encode(v)
  back = CBOR.decode(bytes)
  # The notation of what the bytes decode to, keys in the encoding's
  # order, which is what Python's decoder sees.
  puts "CORPUS #{hex(bytes)}\t#{back.is_a?(CBORError) ? v : back}"
  raise "ASSERTION FAILED: the corpus round-trips value #{n}: refused with #{back.message}\n  #{v}" if back.is_a?(CBORError)
  assert_true(back == v && back.hash == v.hash, "the corpus round-trips value #{n}: #{v}")
  assert_str(hex(bytes), hex(CBOR.encode(back)), "re-encoding value #{n} is stable")
  assert_true(CBOR.deterministic?(bytes), "the encoding of value #{n} is deterministic: #{hex(bytes)}")
  encodings << bytes
  corpus = corpus + 1
  3.times do
    w = [] of UInt8
    variant(w, v, rng)
    read = CBOR.decode(w)
    raise "ASSERTION FAILED: variant of value #{n} decodes: #{read.message}\n  #{hex(w)}" if read.is_a?(CBORError)
    puts "VARIANT #{hex(w)}\t#{hex(bytes)}\t#{read}"
    assert_true(read == v, "a variant of value #{n} reads to the same value: #{hex(w)}")
    assert_str(hex(bytes), hex(CBOR.encode(read)), "a variant of value #{n} encodes to the deterministic bytes")
    assert_true(CBOR.deterministic?(w) == (w == bytes), "deterministic? answers whether a variant of value #{n} is the deterministic bytes: #{hex(w)}")
    encodings << w
    variants = variants + 1
  end
end
puts "  #{corpus} values encoded, decoded equal and encoded again to the same bytes; #{variants} other serializations of them read to the same values and encoded to the deterministic bytes"

puts "== random and mutated bytes, decoded in a task"
fuzz = panic_of(-> {
  frng = Rng.new(0xD1B54A32D192ED03_u64)
  taken = 0
  refused_count = 0
  20000.times do |n|
    input = [] of UInt8
    pick = frng.below(4)
    if pick == 0
      input = Array(UInt8).new(frng.below(12)) { frng.byte }
    else
      input = encodings[frng.below(encodings.size)].dup
      edits = 1 + frng.below(3)
      edits.times do
        what = frng.below(4)
        at = input.empty? ? 0 : frng.below(input.size)
        if what == 0 && !input.empty?
          input[at] = frng.byte
        elsif what == 1
          input = input[0, at] + [frng.byte] + input[at, input.size - at]
        elsif what == 2 && !input.empty?
          input = input[0, at] + input[at + 1, input.size - at - 1]
        else
          input = input[0, at]
        end
      end
    end
    answer = CBOR.decode(input)
    if answer.is_a?(CBORError)
      refused_count = refused_count + 1
      raise "ASSERTION FAILED: deterministic? of refused bytes" if CBOR.deterministic?(input)
      puts "FUZZ #{hex(input)}\t0"
    else
      taken = taken + 1
      again = CBOR.encode(answer)
      raise "ASSERTION FAILED: fuzzed input #{n} re-encodes to an item that decodes equal: #{hex(input)}" unless decoded(again, "a fuzzed re-encoding") == answer
      det = CBOR.deterministic?(input)
      raise "ASSERTION FAILED: deterministic? of fuzzed input #{n} is whether it is its own encoding: #{hex(input)}" unless det == (again == input)
      puts "FUZZ #{hex(input)}\t1\t#{answer}\t#{det ? 1 : 0}"
    end
  end
  "#{taken} decoded, #{refused_count} refused"
})
assert_true(fuzz.ends_with?("refused") && !fuzz.includes?("ASSERTION"), "fuzzed bytes are decoded or refused, never a panic: #{fuzz}")
puts "  20000 inputs, three in four of them corpus encodings with bytes changed, cut or added: #{fuzz}, none a panic"

puts "== nesting, DEPTH_LIMIT and declared lengths"
assert_true(CBOR::DEPTH_LIMIT == 64, "the items below are DEPTH_LIMIT deep")
deep_array = unhex("81" * 64 + "00")
deep_tag = unhex("c1" * 64 + "00")
deep_value = unhex("a100" * 64 + "00")
deep_key = unhex("a1" * 64 + "00" + "00" * 64)
deep_mixed = unhex("81a1c1" * 21 + "81" + "00" + "00" * 21)
said = panic_of(-> {
  checked = 0
  [deep_array, deep_tag, deep_value, deep_key, deep_mixed].each do |bytes|
    v = decoded(bytes, "an item DEPTH_LIMIT deep")
    raise "ASSERTION FAILED: a deep item encodes to its bytes" unless CBOR.encode(v) == bytes
    w = decoded(CBOR.encode(v), "a deep item's encoding")
    raise "ASSERTION FAILED: a deep item reads back equal" unless v == w && v.hash == w.hash
    raise "ASSERTION FAILED: a deep item has a notation" if v.to_s.empty?
    checked = checked + 1
  end
  "#{checked} read"
})
assert_str("5 read", said, "five items DEPTH_LIMIT deep decoded, encoded, compared, hashed and written as notation in a task")
refused("81" * 65 + "00", "a value nested 65 levels deep, past the 64 this decoder reads at byte 64")
refused("c1" * 65 + "00", "a value nested 65 levels deep, past the 64 this decoder reads at byte 64")
refused("a1" * 65 + "00" + "00" * 65, "a value nested 65 levels deep, past the 64 this decoder reads at byte 64")
refused("9f" * 65 + "ff" * 65, "a value nested 65 levels deep, past the 64 this decoder reads at byte 64")
said = panic_of(-> {
  answer = CBOR.decode(Array(UInt8).new(100000, 0x81_u8))
  answer.is_a?(CBORError) ? answer.message : "accepted"
})
assert_str("a value nested 65 levels deep, past the 64 this decoder reads at byte 64", said, "100,000 nested arrays refused in a task, not a stack overflow")
too_deep = Any.new(0)
65.times { too_deep = Any.new([too_deep]) }
assert_str("CBOR.encode: a value nested past the 64 levels a decoder reads back", panic_of(-> { CBOR.encode(too_deep).size.to_s }), "a value too deep to read back is not encoded")
refused("9b00000000ffffffff", "an array of 4294967295 items, where 0 bytes are left at byte 0")
refused("9bffffffffffffffff00", "an array of 18446744073709551615 items, where 1 byte is left at byte 0")
refused("bbffffffffffffffff0000", "a map of 18446744073709551615 pairs, where 2 bytes are left at byte 0")
refused("9a0001000001", "an array of 65536 items, where 1 byte is left at byte 0")
refused("82815bffffffffffffffff", "a byte string of 18446744073709551615 bytes, where 0 are left at byte 2")
assert_str("[[1, 2], 3]", decoded(unhex("8282010203"), "counts that use every byte").to_s, "a count equal to the bytes left is read")
puts "  64 levels of arrays, tags, maps in values and in keys and all three mixed, in a task; 65 refused, and 100,000; counts and lengths past the bytes left refused before anything is made of them"

puts "== diagnostic notation"
[{"5fff", "''_"}, {"7fff", "\"\"_"}, {"5f40ff", "(_ h'')"}, {"7f60ff", "(_ \"\")"}, {"bfff", "{_ }"}, {"9f80ff", "[_ []]"},
 {"781e00011f7f225c080c0a0d092fc280e280a8efbbbff09f9880616263646566", "\"\\u0000\\u0001\\u001f\\u007f\\\"\\\\\\b\\f\\n\\r\\t/\\u0080\\u2028\\ufeff\\ud83d\\ude00abcdef\""},
 {"d9d9f7c074323031332d30332d32315432303a30343a30305a", "55799(0(\"2013-03-21T20:04:00Z\"))"}, {"e0", "simple(0)"}, {"f3", "simple(19)"}, {"f820", "simple(32)"},
 {"a1810102", "{[1]: 2}"}, {"a1a1010202", "{{1: 2}: 2}"}, {"fb4415af1d78b58c40", "100000000000000000000.0"}, {"fb444b1ae4d6e2ef50", "1.0e+21"},
 {"fa358637bd", "9.999999974752427e-7"}, {"fb3eb0c6f7a0b5ed8d", "0.000001"}, {"fb3e7ad7f29abcaf48", "1.0e-7"}, {"fb405edd2f1a9fbe77", "123.456"},
 {"fb0000000000000001", "5.0e-324"}, {"fb7fefffffffffffff", "1.7976931348623157e+308"}, {"fb3fb999999999999a", "0.1"}, {"fbc3e0000000000001", "-9223372036854778000.0"},
 {"f97d00", "NaN"}, {"fbfff8000000000001", "NaN"}, {"1b7fffffffffffffff", "9223372036854775807"}, {"c1c1c100", "1(1(1(0)))"}].each do |example|
  next if example[1].empty?
  v = decoded(unhex(example[0]), "a notation example")
  assert_str(example[1], v.to_s, "the notation of #{example[0]}")
  assert_str(example[1], v.inspect, "inspect is the notation of #{example[0]}")
  puts "VARIANT #{example[0]}\t#{hex(CBOR.encode(v))}\t#{example[1]}"
end
assert_str("[\"a\", h'00ff', -1.5, null, undefined, true]", Any.new([Any.new("a"), Any.new([0_u8, 255_u8]), Any.new(-1.5), Any.new(nil), Any.undefined, Any.new(true)]).to_s, "the notation of a value made in the program")
assert_str("\"\\ufffd\\ufffd\"", Any.new(String.new(2) { |p| p[0] = 0xC0_u8; p[1] = 0xFF_u8 }).to_s, "a string that is not UTF-8, which only a program makes, has U+FFFD for each bad byte")
puts "  empty and chunked indefinite strings, every escape, tags, simple values, keys of any kind, and floats on each side of ECMAScript's switch to an exponent"

puts "== Any"
doc = decoded(unhex("a46161830102036162a1616301626964d82040f5f4"), "a document")
assert_true(doc["a"][1].as_i == 2_i64 && doc["b"]["c"].as_i == 1_i64 && doc[Any.new(true)].as_bool == false, "[] walks maps by text or any key and arrays by index")
assert_true(doc["id"].as_tag.number == 32_u64 && doc["id"].as_tag.value.as_bytes.empty?, "a tag and what it encloses")
assert_true(doc["zz"]?.nil? && doc["a"][7]?.nil? && doc["a"]["x"]?.nil?, "[]? answers nil for what is not there")
assert_true(doc.size == 4 && doc["a"].size == 3 && decoded(unhex("62c3bc"), "ü").size == 2, "size counts pairs, items and bytes")
assert_str("expected a text string, not an array", panic_of(-> { doc["a"].as_s }), "as_s of an array is refused by name")
assert_str("no such key \"q\"", panic_of(-> { doc["q"].to_s }), "a missing key is refused by name")
assert_true(decoded(unhex("9f01ff"), "indefinite").indefinite? && !decoded(unhex("8101"), "definite").indefinite?, "indefinite? says how an item was written")
assert_true(decoded(unhex("9f01ff"), "indefinite") == decoded(unhex("8101"), "definite"), "and is no part of the value")
assert_true(decoded(unhex("5f41014102ff"), "chunks").chunks == [1, 1], "chunks are the chunk sizes")
assert_true(decoded(unhex("f7"), "undefined").undefined? && decoded(unhex("f6"), "null").null? && decoded(unhex("f0"), "simple").as_simple.value == 16_u8, "undefined, null and simple values")
map_hash = decoded(unhex("a2010203f4"), "a map").hash
assert_true(map_hash == decoded(unhex("a203f40102"), "the same map").hash && decoded(unhex("a2010203f4"), "a map") == decoded(unhex("a203f40102"), "the same map"), "a map equals and hashes as the same pairs in another order")
assert_true(CBOR.decode(text_bytes("\x83\x01\x02\x03")).as(Any).as_a.size == 3 && CBOR.decode?(text_bytes("\xff")).nil?, "decode and decode? read a String's bytes too")
assert_true(CBOR.decode("\x83\x01\x02\x03").as(Any).as_a.size == 3 && CBOR.deterministic?("\x83\x01\x02\x03"), "a String of bytes is decoded as they are")
puts "  walking, kinds, refusals by name, equality and hashing"

puts "== derive cbor_serializable"
rec = Record.new("rec \"one\"", [0_u8, 1_u8, 255_u8], ["a", "b c", ""], {"w" => 1.5, "x y" => -0.0}, -9223372036854775807_i64, 255_u8, 9223372036854775807_u64, 0.1, true, nil,
  Inner.new(1, "in"), [Inner.new(2, nil), Inner.new(3, "three")], Inner.new(4, "maybe"), [[1, 2], [] of Int32, [3]])
bytes = rec.to_cbor
back = Record.from_cbor(bytes)
assert_str(rec.to_json, back.to_json, "a record reads back from its CBOR")
assert_str(rec.to_yaml, back.to_yaml, "and the same record's YAML is unchanged by the trip")
assert_str(rec.to_toml, back.to_toml, "and its TOML")
assert_true(CBOR.deterministic?(bytes), "a record's CBOR is deterministic")
assert_true(decoded(bytes, "a record")["blob"].as_bytes == [0_u8, 1_u8, 255_u8] && decoded(bytes, "a record")["note"].null?, "bytes are a byte string, a nil field null")
puts "DERIVE #{rec.to_json}\t#{hex(bytes)}"
rec2 = Record.new("two", [] of UInt8, [] of String, {} of String => Float64, 0_i64, 0_u8, 0_u64, -1.0e300, false, "a\nnote",
  Inner.new(-1, nil), [] of Inner, nil, [] of Array(Int32))
bytes2 = rec2.to_cbor
assert_str(rec2.to_json, Record.from_cbor(bytes2).to_json, "a record of empties reads back")
puts "DERIVE #{rec2.to_json}\t#{hex(bytes2)}"
keyed = {Any.new([Any.new(1)]) => 1_i64, Any.new(2.5) => 2_i64, Any.new(nil) => 3_i64}
wide = Wide.new(18446744073709551615_u64, {7 => "seven", -1 => "minus"}, keyed, decoded(unhex("c11a514b67b0"), "a tag"))
wide_back = Wide.from_cbor(wide.to_cbor)
assert_true(wide_back.top == 18446744073709551615_u64 && wide_back.by_id[-1] == "minus" && wide_back.keyed == keyed && wide_back.extra.as_tag.number == 1_u64, "a UInt64 past Int64, integer and item keys and an Any read back")
assert_str("{\"top\": 18446744073709551615, \"by_id\": {7: \"seven\", -1: \"minus\"}, \"extra\": 1(1363896240), \"keyed\": {[1]: 1, null: 3, 2.5: 2}}", decoded(wide.to_cbor, "wide").to_s, "map keys in deterministic order: the bytes of their encodings")
spot = Spot.from_cbor(CBOR.encode(map_of([{Any.new("x"), Any.new(2)}, {Any.new("name"), Any.new("s")}, {Any.new("unknown"), ints([1])}])))
assert_true(spot.x == 2.0 && spot.name == "s" && spot.note.nil?, "an integer widens to a Float64 field, a missing nilable key is nil, an unknown key is passed over")
spot2 = Spot.from_cbor(unhex("a36178f93c00646e616d656173646e6f7465f6"))
assert_true(spot2.note.nil? && spot2.x == 1.0, "null in a nilable field is nil")
assert_true(decoded(spot.to_cbor, "spot")["note"].null?, "a nil field is written as null")
defaults = panic_of(-> {
  missing = Listener.from_cbor(CBOR.to_cbor({"name" => "web"}))
  "#{missing.port} #{missing.host}"
})
assert_str("8080 localhost", defaults, "missing keys keep their defaults")
listener = Listener.from_cbor(CBOR.encode(map_of([{Any.new("name"), Any.new("web")}, {Any.new("port"), Any.new(9090)}, {Any.new("host"), Any.new("example.com")}])))
assert_true(listener.port == 9090 && listener.host == "example.com", "present keys win over defaults")
assert_str("{\"x\":5,\"label\":\"five\"}", Inner.new(5, "five").to_json, "std/json's derive beside it")
assert_str("x: 5\nlabel: five\n", Inner.new(5, "five").to_yaml, "std/yaml's derive beside it")
assert_str("x = 5\nlabel = \"five\"\n", Inner.new(5, "five").to_toml, "std/toml's derive beside it")
assert_str("a2617805656c6162656c6466697665", hex(Inner.new(5, "five").to_cbor), "this derive")
assert_true(CBOR.from_cbor(CBOR.to_cbor({"a" => [1, 2]}), Hash(String, Array(Int32)))["a"] == [1, 2], "from_cbor into a hash of arrays")
assert_true(CBOR.from_cbor(CBOR.to_cbor({1 => [0_u8, 7_u8]}), Hash(Int32, Array(UInt8)))[1] == [0_u8, 7_u8], "from_cbor into a hash of byte strings under integer keys")
assert_str("integer 4294967296 out of Int32 range", panic_of(-> { CBOR.from_cbor(CBOR.to_cbor({"a" => 4294967296_i64}), Hash(String, Int32)).to_s }), "an integer past Int32 is refused")
assert_str("the integer -1 does not fit a UInt64", panic_of(-> { CBOR.from_cbor(CBOR.to_cbor(-1), UInt64).to_s }), "a negative integer is no UInt64")
puts "  records written and read back, beside std/json's, std/yaml's and std/toml's derives"

puts "ALL CHECKS PASSED"
