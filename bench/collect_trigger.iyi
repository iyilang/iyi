# The allocation-pressure trigger, exercised rather than asserted. Every
# earlier collector gate calls `IyiMark.collect` by hand; this is the one
# where nobody does, because a collector a program has to call is a verb,
# and the claim under test is that the default build is a collector.
#
#   ./bin/iyi run bench/collect_trigger.iyi
#
# The budget arithmetic is stated where it is checked: the first collection
# comes after a MiB of allocation, and after each one the budget is twice
# what survived, floored at a MiB — so churn against a small live set
# collects often, churn against a big one collects rarely, and a program
# that never crosses a MiB never collects at all. Every check below is that
# sentence, measured.
#
# Everything here needs the collector's allocator, the default on POSIX.
# Built with `-Dgc_none` or `-Dgc_boehm` the program says so in
# one line and exits 0.
#
# Not under `samples/`: the sample count is a gated number, and samples are
# explanations rather than torture tests.

{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin) || (flag?(:win32) && flag?(:x86_64))) %}
  def count(value : UInt64) : String
    value.to_i64.to_s
  end

  # The rooted survivor: a class variable is a global, so what this holds
  # lives through every collection the churn triggers.
  class Held
    @@keep : UInt64 = 0_u64

    def self.keep : UInt64
      @@keep
    end

    def self.keep=(value : UInt64) : Nil
      @@keep = value
    end
  end

  # The scheduler's state and its running fiber, each XOR'd with the key,
  # taken in a frame of their own so no raw pointer to either is left in
  # the frame that churns: the spill slots and registers this frame used
  # are the churn's next.
  @[NoInline]
  def scheduler_marks(key : UInt64) : Tuple(UInt64, UInt64)
    {IyiScheduler.state.object_id ^ key, IyiScheduler.current.object_id ^ key}
  end

  def churn(bytes : UInt64) : Nil
    burned = 0_u64
    while burned < bytes
      block = Pointer(UInt8).malloc(64_u64)
      block.value = 1_u8
      burned = burned + 64_u64
    end
  end

  def arena_count : UInt64
    arenas = 0_u64
    arena = IyiHeap.first_arena
    while arena != 0
      arenas = arenas + 1_u64
      arena = IyiHeap.arena_next(arena)
    end
    arenas
  end

  # The scavenge step's 64 MiB chain, built in its own frame so no local
  # holding a node outlives the build — a register still naming the last
  # node would root the whole chain through the conservative scan, and a
  # spike that cannot die measures nothing. The head lands in the global
  # and nowhere else.
  @[NoInline]
  def build_spike(nodes : UInt64) : Nil
    head = 0_u64
    built = 0_u64
    while built < nodes
      node = Pointer(Pointer(Void)).malloc(2048_u64)
      Pointer(UInt64).new(node.address).value = head
      head = node.address
      built = built + 1_u64
    end
    Held.keep = head
  end

  # Builds the spike, collects with it rooted, reads the root back and the
  # arena count, and drops the root: `[peak, arenas_released before]`.
  # Read the root back, for the reason the sweep exercise gives: a global
  # written and never read is a store the back end may legally drop, and
  # it did - the release build on darwin collected the whole chain here, so
  # the spike's arenas were gone before `peak` was read and the scavenge
  # measured nothing.
  @[NoInline]
  def spike_peak : Tuple(UInt64, UInt64)
    build_spike(4096_u64)
    IyiMark.collect
    raise "scavenge: the spike's root was lost" if Held.keep == 0_u64
    peak = arena_count
    raise "scavenge: 64 MiB live built only #{count(peak)} arenas" if peak < 4_u64
    released_before = IyiMark.arenas_released
    Held.keep = 0_u64
    {peak, released_before}
  end

  puts "== the trigger, the default allocator"

  # 1. Below the budget, nothing runs. A quarter MiB of garbage is a quarter
  # of the floor, and a collector that fires under its own stated budget is
  # spending pauses nobody bought.
  churn(262144_u64)
  if IyiMark.collections != 0
    raise "quiet: #{count(IyiMark.collections)} collections ran under a #{count(IyiMark.budget)}-byte budget"
  end
  puts "    quiet: a quarter MiB of churn ran no collection under the #{count(IyiMark.budget)}-byte budget"

  # 2. Churn, and nobody calls collect. A rooted object with a pattern in it,
  # then 64 MiB of garbage: the collections have to come from the trigger,
  # the heap has to stay bounded, and the survivor has to keep its bytes.
  #
  # Bounded is measured against the arenas this program had before it churned,
  # not against a number written here. 64 MiB of garbage through a heap that
  # reclaims should need a couple of arenas beyond whatever the program was
  # already holding, and the claim is about the churn rather than about the
  # baseline. This read `> 8` until the prelude grew an IO layer, whose stdin,
  # stdout and stderr buffers are live for the life of every program: nine
  # arenas then failed a check that meant to be about garbage, and raising the
  # constant would have bought green by making the check weaker every time the
  # prelude grows. A delta cannot be defeated that way.
  before_churn = arena_count
  survivor = Pointer(UInt8).malloc(96_u64)
  Held.keep = survivor.address
  index = 0_u64
  while index < 96_u64
    (survivor + index.to_i64).value = 0x3C_u8
    index = index + 1_u64
  end
  churn(67108864_u64)
  IyiMark.settle
  first_wave = IyiMark.collections
  raise "trigger: 64 MiB of churn ran no collection, so nothing triggers" if first_wave == 0
  arenas = arena_count
  if arenas > before_churn + 2_u64
    raise "bounded: #{count(arenas)} arenas mapped after churn against #{count(before_churn)} before it, so the memory is not coming back"
  end
  raise "survivor: the root was lost after #{count(first_wave)} triggered collections" if Held.keep != survivor.address
  index = 0_u64
  while index < 96_u64
    if (survivor + index.to_i64).value != 0x3C_u8
      raise "survivor: byte #{count(index)} is #{count((survivor + index.to_i64).value.to_u64)} rather than 60 after #{count(first_wave)} triggered collections"
    end
    index = index + 1_u64
  end
  puts "    trigger: 64 MiB of churn ran #{count(first_wave)} collections by itself, #{count(arenas)} arenas mapped, the rooted survivor intact"

  # 3. The budget breathes. Root four more MiB of live data and churn the
  # same 64 MiB again: what survived doubled into the budget, so the same
  # garbage buys fewer collections. The factor-two margin keeps the check
  # about the mechanism rather than about rounding.
  ballast = Pointer(UInt8).malloc(4194304_u64)
  ballast.value = 9_u8
  IyiMark.collect
  after_reset = IyiMark.collections
  churn(67108864_u64)
  IyiMark.settle
  second_wave = IyiMark.collections - after_reset
  if second_wave * 2_u64 >= first_wave
    raise "budget: #{count(second_wave)} collections against a 4 MiB live set, #{count(first_wave)} against none, so the budget is not growing with what survives"
  end
  (ballast + 4194303_i64).value = 9_u8
  puts "    budget: the same churn ran #{count(second_wave)} collections with 4 MiB live where it ran #{count(first_wave)} with none, budget now #{count(IyiMark.budget)} bytes"

  # 3b. The scheduler's own state lives through the churn. The run queue,
  # the lists and the poller sit on one object a `@[ThreadLocal]` names,
  # and a TLS block is not in the image's data the root walk scans; what
  # roots the object is the global list every state is linked on when it
  # is made. Both addresses are kept XOR'd with a key, in a frame of their
  # own, so nothing on this stack roots the object and the check measures
  # the list: a state the sweep reclaimed carries the free flag, and the
  # driver's proof unlinks the list and reads exactly that.
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
    marks = scheduler_marks(0x5A5A5A5A5A5A5A5A_u64)
    # One collection, then the sweep's own word before anything allocates:
    # a chunk it reclaimed carries FREE_FLAG until the allocator hands it
    # out again, and nothing between the sweep and this read can — so the
    # flag, not the contents, says whether the state was collected out
    # from under its thread-local, on every platform's allocation pattern
    # alike (read after a churn, the chunk was somebody else's on darwin
    # and the read was a fault instead of a name).
    IyiMark.collect
    state_word = IyiMark.flags(marks[0] ^ 0x5A5A5A5A5A5A5A5A_u64)
    if state_word & IyiHeap::FREE_FLAG != 0
      # Named and left by the exit syscall, not raised: a panic's own path
      # reaches for the scheduler's state, which is the object just found
      # freed, and would fault before or after the name depending on the
      # platform's allocation pattern.
      puts "iyi: panic: scheduler state: after a collection the object the thread-local names is on a free list, collected out from under it"
      __iyi_exit(1)
    end
    before_state = IyiMark.collections
    churn(67108864_u64)
    IyiMark.settle
    state_wave = IyiMark.collections - before_state
    after = scheduler_marks(0x5A5A5A5A5A5A5A5A_u64)
    raise "scheduler state: the churn beside it triggered nothing" if state_wave == 0
    raise "scheduler state: the thread-local names a different object after #{count(state_wave)} collections" if after[0] != marks[0]
    raise "scheduler state: the running fiber it names is not the main fiber it held before the churn" if after[1] != marks[1]
    puts "    scheduler's state: the object its thread-local names lived through #{count(state_wave + 1_u64)} collections, rooted by the global list"
  {% end %}

  # 3c. The sweep is the allocator's and the helpers', not the pause's.
  # Every triggered collection above marked and returned; the arenas it
  # left behind were swept by the allocations that needed their chunks,
  # or by the helpers' round beside them (GC_DESIGN.md Stage 8). What a
  # pause still sweeps is what neither got to before the next trigger,
  # and all three numbers are printed; the program's own time must have
  # begun at least one arena per collection, or the sweep is not lazy at
  # all — the driver's proof removes the allocator's sweep and this
  # check names it.
  IyiMark.settle
  swept_lazily = IyiMark.swept_by_allocator
  swept_beside = IyiMark.swept_by_helpers
  in_pauses = IyiMark.debt_paid_in_pause
  raise "lazy: #{count(IyiMark.collections)} collections and the allocator swept #{count(swept_lazily)} arenas, the helpers #{count(swept_beside)}, so the sweep is not lazy" if swept_lazily + swept_beside < IyiMark.collections
  puts "    lazy: the allocator began #{count(swept_lazily)} arenas on its own time, the helpers #{count(swept_beside)} beside it, pauses finished #{count(in_pauses)} left over, across #{count(IyiMark.collections)} collections"

  # 4. Pressure on a program that spawns. A fiber holds the only reference
  # to an allocation in its own parked frame while the main fiber's churn
  # triggers collections; the object has to live through them, which is the
  # fiber-stack root walk carrying its weight under the trigger rather than
  # under the root exercise's hand-run walk.
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
    ready = Channel(Int32).new
    release = Channel(Int32).new
    verdict = Channel(Int32).new
    before_fibers = IyiMark.collections
    group do |g|
      g.spawn do
        keep = Pointer(UInt8).malloc(80_u64)
        index = 0_u64
        while index < 80_u64
          (keep + index.to_i64).value = 0x7B_u8
          index = index + 1_u64
        end
        ready.send(1)
        release.receive
        bad = 0
        index = 0_u64
        while index < 80_u64
          bad = 1 if (keep + index.to_i64).value != 0x7B_u8
          index = index + 1_u64
        end
        verdict.send(bad)
        0
      end
      ready.receive
      # Twice the budget that stands, whatever the last mark left it at:
      # one crossing is certain, and one collection is what the fiber's
      # reference has to live through.
      churn(IyiMark.budget * 2_u64)
      release.send(1)
      answer = verdict.receive
      raise "fiber: a parked fiber's only reference was collected under pressure" if answer != 0
    end
    IyiMark.settle
    fiber_wave = IyiMark.collections - before_fibers
    raise "fiber: the churn beside a parked fiber triggered nothing" if fiber_wave == 0
    puts "    fiber: #{count(fiber_wave)} collections triggered beside a parked fiber, its 80 bytes intact"
  {% end %}

  # 5. The memory goes back to the kernel, and the pauses have numbers. A
  # 64 MiB chain of top-class chunks is held live in a global — the arenas
  # it forces into existence cannot be reclaimed while it stands — then the
  # root is dropped and one collection runs. Every chunk in those arenas is
  # garbage now, so the sweep hands the mappings back: the arena count
  # falls to at most the cushion (one warm arena per class the program
  # touched), and `arenas_released` says the kernel got them. A collector
  # that reclaims chunks but never mappings has a high-water heap, which is
  # the defect this step exists to refuse. The pause line is reported
  # rather than asserted: a budget would be a number this file made up,
  # and the honest claim today is that the numbers exist and are measured.
  #
  # The peak is read and the root dropped inside a frame of its own, for
  # the reason `build_spike` is one: reading the root back loads the head
  # into a register, and the scan is conservative. Read here, in this
  # frame, a --release build on Windows - whose convention has the callee
  # keep more registers than SysV's, rsi and rdi among them - found none
  # of the spike's arenas dead, five runs of five; read in a frame that
  # returns, it releases them every time.
  peak_and_before = spike_peak
  peak = peak_and_before[0]
  released_before = peak_and_before[1]
  # A small churn between the drop and the collections scrubs whatever
  # register or stack slot still names a spike node, the same laundering
  # the mark exercise's garbage step relies on.
  churn(65536_u64)
  IyiMark.collect
  IyiMark.collect
  settled = arena_count
  released = IyiMark.arenas_released - released_before
  if released == 0
    raise "scavenge: #{count(peak)} arenas at the peak and none went back to the kernel"
  end
  if settled + 2_u64 > peak
    raise "scavenge: #{count(settled)} arenas still mapped after the spike's #{count(peak)}, so the heap is high-water"
  end
  puts "    scavenge: #{count(peak)} arenas at the peak, #{count(released)} released to the kernel, #{count(settled)} still mapped"
  puts "    pauses: last #{count(IyiMark.pause_last_ns)} ns, max #{count(IyiMark.pause_max_ns)} ns, #{count(IyiMark.pause_total_ns)} ns across #{count(IyiMark.collections)} collections"

  puts "    all trigger checks passed"
{% else %}
  puts "    the trigger needs the collector's allocator (the default on linux-x86_64, linux-aarch64 and darwin); this build deselected it, nothing to exercise here"
{% end %}
