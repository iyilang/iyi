  private def self.tan_clz(x : UInt64) : UInt64
    return 64_u64 if x == 0_u64
    n = 0_u64
    v = x
    if v.unsafe_shr(32_u64) == 0_u64
      n = n &+ 32_u64
      v = v.unsafe_shl(32_u64)
    end
    if v.unsafe_shr(48_u64) == 0_u64
      n = n &+ 16_u64
      v = v.unsafe_shl(16_u64)
    end
    if v.unsafe_shr(56_u64) == 0_u64
      n = n &+ 8_u64
      v = v.unsafe_shl(8_u64)
    end
    if v.unsafe_shr(60_u64) == 0_u64
      n = n &+ 4_u64
      v = v.unsafe_shl(4_u64)
    end
    if v.unsafe_shr(62_u64) == 0_u64
      n = n &+ 2_u64
      v = v.unsafe_shl(2_u64)
    end
    n = n &+ 1_u64 if v.unsafe_shr(63_u64) == 0_u64
    n
  end

  # (hi, lo) << n and >> n for 0 <= n < 128.
  private def self.tan_shl(hi : UInt64, lo : UInt64, n : UInt64) : {UInt64, UInt64}
    return {hi, lo} if n == 0_u64
    return {lo.unsafe_shl(n &- 64_u64), 0_u64} if n >= 64_u64
    {hi.unsafe_shl(n) | lo.unsafe_shr(64_u64 &- n), lo.unsafe_shl(n)}
  end

  private def self.tan_shr(hi : UInt64, lo : UInt64, n : UInt64) : {UInt64, UInt64}
    return {hi, lo} if n == 0_u64
    return {0_u64, hi.unsafe_shr(n &- 64_u64)} if n >= 64_u64
    {hi.unsafe_shr(n), lo.unsafe_shr(n) | hi.unsafe_shl(64_u64 &- n)}
  end

  private def self.tan_sub128(ah : UInt64, al : UInt64, bh : UInt64, bl : UInt64) : {UInt64, UInt64}
    {ah &- bh &- (al < bl ? 1_u64 : 0_u64), al &- bl}
  end

  private def self.tan_dint(table : Pointer(UInt64), i : Int64) : {UInt64, UInt64, Int64, UInt64}
    k = i.unsafe_to_i32 * 4
    {table[k], table[k + 1], table[k + 2].unsafe_to_i64, table[k + 3]}
  end

  # cmp_dint_abs
  private def self.tan_cmp_abs(a : {UInt64, UInt64, Int64, UInt64}, b : {UInt64, UInt64, Int64, UInt64}) : Int32
    if a[0] == 0_u64
      return b[0] == 0_u64 ? 0 : -1
    end
    return 1 if b[0] == 0_u64
    return 1 if a[2] > b[2]
    return -1 if a[2] < b[2]
    return 1 if a[0] > b[0] || (a[0] == b[0] && a[1] > b[1])
    return -1 if a[0] < b[0] || (a[0] == b[0] && a[1] < b[1])
    0
  end

  # add_dint
  private def self.tan_add(a0 : {UInt64, UInt64, Int64, UInt64}, b0 : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    return b0 if (a0[0] | a0[1]) == 0_u64
    a = a0
    b = b0
    c = tan_cmp_abs(a0, b0)
    if c == 0
      return {0_u64, 0_u64, -1076_i64, 0_u64} if (a0[3] ^ b0[3]) != 0_u64
      return {a0[0], a0[1], a0[2] &+ 1_i64, a0[3]}
    end
    if c < 0
      a = b0
      b = a0
    end
    ah, al, ae, asg = a
    bh, bl, be, bsg = b
    k = (ae &- be).unsafe_to_u64
    sh = bh
    sl = bl
    if k > 0_u64
      if k < 128_u64
        sh, sl = tan_shr(bh, bl, k)
      else
        sh = 0_u64
        sl = 0_u64
      end
    end
    rex = ae
    if (asg ^ bsg) != 0_u64
      ch, cl = tan_sub128(ah, al, sh, sl)
      ex = ch != 0_u64 ? tan_clz(ch) : 64_u64 &+ tan_clz(cl)
      if ex > 0_u64
        xh, xl = tan_shl(ah, al, ex)
        if k == 1_u64
          yh, yl = tan_shl(bh, bl, ex &- 1_u64)
        else
          yh, yl = tan_shl(sh, sl, ex)
        end
        ch, cl = tan_sub128(xh, xl, yh, yl)
        rex = rex &- ex.unsafe_to_i64
        ex = tan_clz(ch)
      end
      ch, cl = tan_shl(ch, cl, ex)
      rex = rex &- ex.unsafe_to_i64
      {ch, cl, rex, asg}
    else
      cl = al &+ sl
      ch = ah &+ sh &+ (cl < al ? 1_u64 : 0_u64)
      if ch < ah || (ch == ah && cl < al)
        cl = cl.unsafe_shr(1_u64) | ch.unsafe_shl(63_u64)
        ch = 0x8000000000000000_u64 | ch.unsafe_shr(1_u64)
        rex = rex &+ 1_i64
      end
      {ch, cl, rex, asg}
    end
  end

  # mul_dint
  private def self.tan_mul(a : {UInt64, UInt64, Int64, UInt64}, b : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    m1h, m1l = trig_mul64(a[0], b[1])
    m2h, m2l = trig_mul64(a[1], b[0])
    rh, rl = trig_mul64(a[0], b[0])
    s = m1h &+ m2h
    rh = rh &+ (s < m1h ? 1_u64 : 0_u64)
    rl = rl &+ s
    rh = rh &+ (rl < s ? 1_u64 : 0_u64)
    ex = rh.unsafe_shr(63_u64)
    if ex == 0_u64
      rh, rl = tan_shl(rh, rl, 1_u64)
    end
    {rh, rl, a[2] &+ b[2] &+ ex.unsafe_to_i64 &- 1_i64, a[3] ^ b[3]}
  end

  # mul_dint_21
  private def self.tan_mul21(a : {UInt64, UInt64, Int64, UInt64}, b : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    rh, rl = trig_mul64(a[0], b[0])
    lh, ll = trig_mul64(a[1], b[0])
    rl = rl &+ lh
    rh = rh &+ (rl < lh ? 1_u64 : 0_u64)
    ex = rh.unsafe_shr(63_u64)
    if ex == 0_u64
      rh, rl = tan_shl(rh, rl, 1_u64)
    end
    {rh, rl, a[2] &+ b[2] &+ ex.unsafe_to_i64 &- 1_i64, a[3] ^ b[3]}
  end

  # One Newton step of inv_dint on t: e = 2^127 - h*t; e = t * (e >> sh);
  # t += e >> (64 + back).
  private def self.tan_newton(h : UInt64, t : UInt64, sh : UInt64, back : UInt64) : UInt64
    ph, pl = trig_mul64(h, t)
    eh, el = tan_sub128(0x8000000000000000_u64, 0_u64, ph, pl)
    eh, el = tan_shr(eh, el, sh)
    qh, ql = trig_mul64(t, el)
    qh = qh &+ t &* eh
    t &+ qh.unsafe_shr(back)
  end

  # inv_dint
  private def self.tan_inv(a : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    h = a[0]
    t = TAN_TINV.to_unsafe[(h.unsafe_shr(55_u64) & 0xff_u64).unsafe_to_i32]
    t = tan_newton(h, t, 55_u64, 8_u64)
    t = tan_newton(h, t, 47_u64, 16_u64)
    t = tan_newton(h, t, 31_u64, 32_u64)
    r = {t, 0_u64, 1_i64 &- a[2], 1_u64}
    q = tan_mul21(a, r)
    r = {t, 0_u64, 1_i64 &- a[2], 0_u64}
    q = tan_add({0x8000000000000000_u64, 0_u64, 1_i64, 0_u64}, q)
    q = tan_mul(r, q)
    tan_add(r, q)
  end

  # dint_fromd
  private def self.tan_fromd(b : Float64) : {UInt64, UInt64, Int64, UInt64}
    bits = IyiFloatText.bits_of(b)
    e = bits.unsafe_shr(52_u64) & 0x7ff_u64
    m = (bits & 0x000fffffffffffff_u64) &+ (e != 0_u64 ? 0x0010000000000000_u64 : 0_u64)
    ex = e.unsafe_to_i64 &- 0x3fe_i64
    t = tan_clz(m)
    ex = ex &- (t > 11_u64 ? t &- 12_u64 : 0_u64).unsafe_to_i64
    {m.unsafe_shl(t), 0_u64, ex, b < 0.0 ? 1_u64 : 0_u64}
  end

  # dint_tod, round to nearest, for results in the normal range.
  private def self.tan_tod(a : {UInt64, UInt64, Int64, UInt64}) : Float64
    hi = a[0]
    r = IyiFloatText.from_bits(hi.unsafe_shr(11_u64) | 0x3ff0000000000000_u64 | a[3].unsafe_shl(63_u64))
    rd = 0.0
    rd = rd + 1.1102230246251565e-16 if (hi.unsafe_shr(10_u64) & 1_u64) != 0_u64
    rd = rd + 5.551115123125783e-17 if (hi & 0x3ff_u64) != 0_u64 || a[1] != 0_u64
    rd = rd * -1.0 if a[3] != 0_u64
    r = r + rd
    r * IyiFloatText.from_bits((((a[2] &+ 1022_i64).unsafe_to_u64) & 0x7ff_u64).unsafe_shl(52_u64))
  end

  # evalPS
  private def self.tan_eval_ps(x : {UInt64, UInt64, Int64, UInt64}, x2 : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    ps = TAN_PS.to_unsafe
    y = tan_mul21(x2, tan_dint(ps, 5_i64))
    y = tan_add(y, tan_dint(ps, 4_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(ps, 3_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(ps, 2_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(ps, 1_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(ps, 0_i64))
    tan_mul(y, x)
  end

  # evalPC
  private def self.tan_eval_pc(x2 : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    pc = TAN_PC.to_unsafe
    y = tan_mul21(x2, tan_dint(pc, 5_i64))
    y = tan_add(y, tan_dint(pc, 4_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(pc, 3_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(pc, 2_i64))
    y = tan_mul(y, x2)
    y = tan_add(y, tan_dint(pc, 1_i64))
    y = tan_mul(y, x2)
    tan_add(y, tan_dint(pc, 0_i64))
  end

  # normalize
  private def self.tan_normalize(hi : UInt64, lo : UInt64, ex : Int64) : {UInt64, UInt64, Int64}
    if hi != 0_u64
      cnt = tan_clz(hi)
      return {hi.unsafe_shl(cnt) | lo.unsafe_shr(64_u64 &- cnt), lo.unsafe_shl(cnt), ex &- cnt.unsafe_to_i64} if cnt != 0_u64
      return {hi, lo, ex}
    end
    return {hi, lo, ex} if lo == 0_u64
    cnt = tan_clz(lo)
    {lo.unsafe_shl(cnt), 0_u64, ex &- 64_i64 &- cnt.unsafe_to_i64}
  end

  # reduce: X/(2pi) mod 1
  private def self.tan_reduce(x : {UInt64, UInt64, Int64, UInt64}) : {UInt64, UInt64, Int64, UInt64}
    tt = TAN_T.to_unsafe
    xh = x[0]
    e = x[2]
    if e <= 1_i64
      uh, ul = trig_mul64(xh, tt[1])
      tiny = ul
      lo = uh
      uh, ul = trig_mul64(xh, tt[0])
      lo = lo &+ ul
      hi = uh &+ (lo < ul ? 1_u64 : 0_u64)
      hi, lo, ex = tan_normalize(hi, lo, e)
      d = e &- ex
      lo = lo | tiny.unsafe_shr((64_i64 &- d).unsafe_to_u64) if d != 0_i64
      return {hi, lo, ex, x[3]}
    end
    i = e < 127_i64 ? 0_i64 : (e - 127_i64 + 64_i64 - 1_i64) // 64_i64
    uh, ul = trig_mul64(xh, tt[(i + 3).unsafe_to_i32])
    c0 = ul
    c1 = uh
    uh, ul = trig_mul64(xh, tt[(i + 2).unsafe_to_i32])
    c1 = c1 &+ ul
    c2 = uh &+ (c1 < ul ? 1_u64 : 0_u64)
    uh, ul = trig_mul64(xh, tt[(i + 1).unsafe_to_i32])
    c2 = c2 &+ ul
    c3 = uh &+ (c2 < ul ? 1_u64 : 0_u64)
    uh, ul = trig_mul64(xh, tt[i.unsafe_to_i32])
    c3 = c3 &+ ul
    c4 = uh &+ (c3 < ul ? 1_u64 : 0_u64)
    f = e - 64_i64 * i
    hi = 0_u64
    lo = 0_u64
    tiny = 0_u64
    if f < 64_i64
      fu = f.unsafe_to_u64
      hi = c4.unsafe_shl(fu) | c3.unsafe_shr(64_u64 &- fu)
      lo = c3.unsafe_shl(fu) | c2.unsafe_shr(64_u64 &- fu)
      tiny = c2.unsafe_shl(fu) | c1.unsafe_shr(64_u64 &- fu)
    elsif f == 64_i64
      hi = c3
      lo = c2
      tiny = c1
    else
      g = (f - 64_i64).unsafe_to_u64
      uh, ul = trig_mul64(xh, tt[(i + 4).unsafe_to_i32])
      c0 = c0 &+ uh
      carry = c0 < uh
      c1 = c1 &+ 1_u64 if carry
      c2 = c2 &+ 1_u64 if carry && c1 == 0_u64
      c3 = c3 &+ 1_u64 if carry && c1 == 0_u64 && c2 == 0_u64
      hi = c3.unsafe_shl(g) | c2.unsafe_shr(64_u64 &- g)
      lo = c2.unsafe_shl(g) | c1.unsafe_shr(64_u64 &- g)
      tiny = c1.unsafe_shl(g) | c0.unsafe_shr(64_u64 &- g)
    end
    hi, lo, ex = tan_normalize(hi, lo, 0_i64)
    lo = lo | tiny.unsafe_shr((64_i64 &+ ex).unsafe_to_u64) if ex < 0_i64
    {hi, lo, ex, x[3]}
  end

  # reduce2: X = i/2^11 + X'
  private def self.tan_reduce2(x : {UInt64, UInt64, Int64, UInt64}) : {Int64, {UInt64, UInt64, Int64, UInt64}}
    return {0_i64, x} if x[2] <= -11_i64
    sh = (53_i64 &- x[2]).unsafe_to_u64
    i = x[0].unsafe_shr(sh).unsafe_to_i64
    hi, lo, ex = tan_normalize(x[0] & (1_u64.unsafe_shl(sh) &- 1_u64), x[1], x[2])
    {i, {hi, lo, ex, x[3]}}
  end

  # set_dd: h + l = c1/2^64 + c0/2^128, truncated
  private def self.tan_set_dd(c1_in : UInt64, c0_in : UInt64) : {Float64, Float64}
    c1 = c1_in
    c0 = c0_in
    if c1 != 0_u64
      e = tan_clz(c1)
      if e != 0_u64
        c1 = c1.unsafe_shl(e) | c0.unsafe_shr(64_u64 &- e)
        c0 = c0.unsafe_shl(e)
      end
      f = 0x3fe_u64 &- e
      h = IyiFloatText.from_bits(f.unsafe_shl(52_u64) | c1.unsafe_shl(1_u64).unsafe_shr(12_u64))
      c0 = c1.unsafe_shl(53_u64) | c0.unsafe_shr(11_u64)
      return {h, 0.0} if c0 == 0_u64
      g = tan_clz(c0)
      c0 = c0.unsafe_shl(g) if g != 0_u64
      {h, IyiFloatText.from_bits((f &- 53_u64 &- g).unsafe_shl(52_u64) | c0.unsafe_shl(1_u64).unsafe_shr(12_u64))}
    elsif c0 != 0_u64
      e = tan_clz(c0)
      f = 0x3fe_u64 &- 64_u64 &- e
      c0 = e == 63_u64 ? 0_u64 : c0.unsafe_shl(e &+ 1_u64)
      h = IyiFloatText.from_bits(f.unsafe_shl(52_u64) | c0.unsafe_shr(12_u64))
      c0 = c0.unsafe_shl(52_u64)
      return {h, 0.0} if c0 == 0_u64
      g = tan_clz(c0)
      c0 = g == 63_u64 ? 0_u64 : c0.unsafe_shl(g &+ 1_u64)
      {h, IyiFloatText.from_bits((f &- 64_u64 &- g).unsafe_shl(52_u64) | c0.unsafe_shr(12_u64))}
    else
      {0.0, 0.0}
    end
  end

  # reduce_fast: i/2^11 + h + l approximates frac(x/(2pi)), x > 2^-27
  private def self.tan_reduce_fast(x : Float64) : {Int64, Float64, Float64}
    h = 0.0
    l = 0.0
    if x <= 6.283185307179585
      h = 0.15915494309189535 * x
      l = fma(0.15915494309189535, x, h * -1.0)
      l = fma(-9.839338337591243e-18, x, l)
    else
      tt = TAN_T.to_unsafe
      bits = IyiFloatText.bits_of(x)
      e = (bits.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i64
      m = 0x0010000000000000_u64 | (bits & 0x000fffffffffffff_u64)
      c0 = 0_u64
      c1 = 0_u64
      c2 = 0_u64
      if e <= 1074_i64
        vh, vl = trig_mul64(m, tt[2])
        uh, ul = trig_mul64(m, tt[1])
        c0 = ul &+ vh
        c1 = uh &+ (c0 < ul ? 1_u64 : 0_u64)
        uh, ul = trig_mul64(m, tt[0])
        c1 = c1 &+ ul
        c2 = uh &+ (c1 < ul ? 1_u64 : 0_u64)
        e = 1075_i64 - e
      else
        i = (e - 1138_i64 + 63_i64) // 64_i64
        vh, vl = trig_mul64(m, tt[(i + 3).unsafe_to_i32])
        uh, ul = trig_mul64(m, tt[(i + 2).unsafe_to_i32])
        c0 = ul &+ vh
        c1 = uh &+ (c0 < ul ? 1_u64 : 0_u64)
        uh, ul = trig_mul64(m, tt[(i + 1).unsafe_to_i32])
        c1 = c1 &+ ul
        c2 = uh &+ (c1 < ul ? 1_u64 : 0_u64)
        uh, ul = trig_mul64(m, tt[i.unsafe_to_i32])
        c2 = c2 &+ ul
        e = 1139_i64 + i * 64_i64 - e
      end
      if e == 64_i64
        c0 = c1
        c1 = c2
      else
        eu = e.unsafe_to_u64
        c0 = c1.unsafe_shl(64_u64 &- eu) | c0.unsafe_shr(eu)
        c1 = c2.unsafe_shl(64_u64 &- eu) | c1.unsafe_shr(eu)
      end
      h, l = tan_set_dd(c1, c0)
    end
    i = (h * 2048.0).floor
    h = fma(i, -0.00048828125, h)
    {i.unsafe_to_i64, h, l}
  end

  # s_mul: a * (bh + bl)
  private def self.tan_s_mul(a : Float64, bh : Float64, bl : Float64) : {Float64, Float64}
    hi = a * bh
    lo = fma(a, bh, hi * -1.0)
    {hi, fma(a, bl, lo)}
  end

  # evalPSfast: sin2pi(xh + xl), uh + ul ~ (xh + xl)^2
  private def self.tan_eval_ps_fast(xh : Float64, xl : Float64, uh : Float64, ul : Float64) : {Float64, Float64}
    h = -76.77083125858339
    h = fma(h, uh, 81.60524929831949)
    h = fma(h, uh, -41.34170224039976)
    h, l = tan_s_mul(h, uh, ul)
    s = 6.283185307179586 + h
    t = h - (s - 6.283185307179586)
    l = l + (2.4492937487389357e-16 + t)
    ph = s * xh
    pl = fma(s, xh, ph * -1.0)
    pl = fma(l, xh, pl)
    {ph, fma(s, xl, pl)}
  end

  # evalPCfast: cos2pi(xh + xl), uh + ul ~ (xh + xl)^2
  private def self.tan_eval_pc_fast(uh : Float64, ul : Float64) : {Float64, Float64}
    h = -85.41188646817469
    h = fma(h, uh, 64.93939400729349)
    h = fma(h, uh, -19.739208802178716)
    h, l = tan_s_mul(h, uh, ul)
    s = 1.0 + h
    t = h - (s - 1.0)
    {s, l + (-1.0396311785461432e-23 + t)}
  end

  # fast_div: (bh + bl) / (ah + al)
  private def self.tan_fast_div(bh : Float64, bl : Float64, ah : Float64, al : Float64) : {Float64, Float64}
    y = 1.0 / ah
    h = bh * y
    eh = fma(ah, h * -1.0, bh)
    el = fma(al, h * -1.0, bl)
    {h, y * (eh + el)}
  end

  # tan_fast: {h, l, err} with |h + l - tan(x)| < err, |x| > 2^-27
  private def self.tan_fast(x : Float64) : {Float64, Float64, Float64}
    neg = x < 0.0 ? 1_i64 : 0_i64
    is_tan = 1_i64
    absx = neg != 0_i64 ? x * -1.0 : x
    i, h, l = tan_reduce_fast(absx)
    i = i & 0x3ff_i64
    is_tan = is_tan ^ i.unsafe_shr(9_i64)
    neg = neg ^ i.unsafe_shr(9_i64)
    i = i & 0x1ff_i64
    if (i & 0x100_i64) != 0_i64
      is_tan = is_tan == 0_i64 ? 1_i64 : 0_i64
      i = 0x1ff_i64 - i
      h = 0.00048828125 - h
      l = l * -1.0
    end
    return {h, l, 1.0} if i == 0_i64 && h < 7.275957614183426e-12
    sc = TAN_SC.to_unsafe
    h = h - IyiFloatText.from_bits(sc[i.unsafe_to_i32 * 3])
    s = h + l
    l = l - (s - h)
    h = s
    uh = h * h
    ul = fma(h, h, uh * -1.0)
    ul = fma(h + h, l, ul)
    sh, sl = tan_eval_ps_fast(h, l, uh, ul)
    ch, cl = tan_eval_pc_fast(uh, ul)
    si = IyiFloatText.from_bits(sc[i.unsafe_to_i32 * 3 + 1])
    ci = IyiFloatText.from_bits(sc[i.unsafe_to_i32 * 3 + 2])
    sh0, sl0 = tan_s_mul(ci, sh, sl)
    ch0, cl0 = tan_s_mul(si, ch, cl)
    h1 = ch0 + sh0
    l1 = sh0 - (h1 - ch0)
    l1 = l1 + (sl0 + cl0)
    ch, cl = tan_s_mul(ci, ch, cl)
    sh, sl = tan_s_mul(si, sh, sl)
    h2 = ch + sh * -1.0
    l2 = sh * -1.0 - (h2 - ch)
    l2 = l2 + (cl - sl)
    if is_tan != 0_i64
      h, l = tan_fast_div(h1, l1, h2, l2)
    else
      h, l = tan_fast_div(h2, l2, h1, l1)
    end
    if neg != 0_i64
      h = h * -1.0
      l = l * -1.0
    end
    {h, l, h * 1.4928955695357043e-20}
  end

  # tan_accurate: |x| > 2^-27, finite
  private def self.tan_accurate(x : Float64) : Float64
    absx = x > 0.0 ? x : x * -1.0
    xd = tan_reduce(tan_fromd(absx))
    is_tan = true
    neg = x < 0.0
    i, xd = tan_reduce2(xd)
    i = i & 0x3ff_i64
    if (i & 0x200_i64) != 0_i64
      is_tan = false
      neg = !neg
      i = i & 0x1ff_i64
    end
    if (i & 0x100_i64) != 0_i64
      is_tan = !is_tan
      xd = tan_add({0x8000000000000000_u64, 0_u64, -10_i64, 0_u64}, {xd[0], xd[1], xd[2], 1_u64})
      i = 0x1ff_i64 - i
    end
    x2 = tan_mul(xd, xd)
    u = tan_eval_pc(x2)
    v = tan_eval_ps(xd, x2)
    si = tan_dint(TAN_S.to_unsafe, i)
    ci = tan_dint(TAN_C.to_unsafe, i)
    sn = tan_add(tan_mul(si, u), tan_mul(ci, v))
    u = tan_mul(ci, u)
    v = tan_mul(si, v)
    cs = tan_add(u, {v[0], v[1], v[2], 1_u64 &- v[3]})
    u = is_tan ? tan_mul(tan_inv(cs), sn) : tan_mul(tan_inv(sn), cs)
    lo0 = u[1] &- 86_u64
    hi0 = u[0] &- (lo0 > u[1] ? 1_u64 : 0_u64)
    lo1 = u[1] &+ 86_u64
    hi1 = u[0] &+ (lo1 < u[1] ? 1_u64 : 0_u64)
    if hi0.unsafe_shr(10_u64) != hi1.unsafe_shr(10_u64)
      ax = x.abs
      if ax == 4.470348358154178e-07
        return x > 0.0 ? 4.4703483581544753e-07 + 2.6469779601696883e-23 : 4.4703483581544753e-07 * -1.0 - 2.6469779601696883e-23
      end
      if ax == 8.940696716307641e-07
        return x > 0.0 ? 8.940696716310023e-07 + -7.828575563803332e-45 : 8.940696716310023e-07 * -1.0 - -7.828575563803332e-45
      end
    end
    u = {u[0], u[1], u[2], 1_u64 &- u[3]} if neg
    tan_tod(u)
  end

  def self.tan(value : Float64) : Float64
    x = value
    bits = IyiFloatText.bits_of(x)
    if (bits.unsafe_shr(52_u64) & 0x7ff_u64) == 0x7ff_u64
      return x - x if bits.unsafe_shl(1_u64) == 0xffe0000000000000_u64
      return x + x
    end
    if (bits & 0x7fffffffffffffff_u64) <= 0x3e4d12ed0af1a27e_u64
      return x if x == 0.0
      return fma(x, 5.551115123125783e-17, x)
    end
    h, l, err = tan_fast(x)
    left = h + (l - err)
    right = h + (l + err)
    return left if left == right
    tan_accurate(x)
  end

  def self.tan(value : Float32) : Float32
    tan(value.to_f64).to_f32
  end

  def self.tan(value : T) : Float64 forall T
    tan(value.to_f64)
  end

  def self.sqrt(value : Float64) : Float64
    LibLLVMMath.sqrt_f64(value)
  end

  def self.sqrt(value : Float32) : Float32
    LibLLVMMath.sqrt_f32(value)
  end

  def self.sqrt(value : T) : Float64 forall T
    sqrt(value.to_f64)
  end

  # hypot and cbrt: CORE-MATH's correctly rounded cr_hypot and cr_cbrt
  # (hypot.c and cbrt.c at revision b1a4badf6765), ported operation for
  # operation. hypot.c: Copyright (c) 2022-2026 Alexei Sibidanov; cbrt.c:
  # Copyright (c) 2021-2022 Alexei Sibidanov; MIT licence. Round to nearest
  # only: the directed-rounding branches of as_hypot_denorm, as_hypot_hard
  # and cr_cbrt (and cbrt's rm > 0 worst-case list) are left out, as are
  # the exception-flag save/restore and underflow/overflow triggers, which
  # change no value; the u128 square in as_hypot_hard is trig_mul64's
  # {hi, lo}. Tables hold cbrt.c's doubles as bits in their order.

  private CBRT_ESCALE = [
    0x3ff0000000000000_u64, 0x3ff428a2f98d728b_u64, 0x3ff965fea53d6e3d_u64,
  ]
  private CBRT_C = [
    0x3fe1b0babccfef9c_u64, 0x3fe2c9a3e94d1da5_u64, 0xbfc4dc30b1a1ddba_u64, 0x3f97a8d3e4ec9b07_u64,
  ]
  private CBRT_RSC = [
    0x3ff0000000000000_u64, 0xbff0000000000000_u64, 0x3fe0000000000000_u64, 0xbfe0000000000000_u64, 0x3fd0000000000000_u64, 0xbfd0000000000000_u64,
  ]

  # as_hypot_denorm: x = a * 2^-1074 >= y = b * 2^-1074 > 0, both subnormal.
  private def self.hypot_denorm(a : UInt64, b : UInt64) : Float64
    af = a.unsafe_to_i64.to_f64
    bf = b.unsafe_to_i64.to_f64
    a = a.unsafe_shl(1_u64)
    b = b.unsafe_shl(1_u64)
    rm = sqrt(af * af + bf * bf).to_u64
    tm = rm.unsafe_shl(1_u64).unsafe_to_i64
    d = ((a &* a) &+ (b &* b) &- (tm.unsafe_to_u64 &* tm.unsafe_to_u64)).unsafe_to_i64
    while d > 2_i64 * tm
      d = d - (2_i64 * tm + 1_i64)
      tm = tm + 1_i64
    end
    while d < 0_i64
      d = d + (2_i64 * tm - 1_i64)
      tm = tm - 1_i64
    end
    rb = tm & 1_i64
    rm = tm.unsafe_to_u64.unsafe_shr(1_u64)
    rm = rm + rb.unsafe_to_u64 if d != 0_i64
    IyiFloatText.from_bits(rm)
  end

  # as_hypot_hard: x^2 + y^2 exactly in 64 bits, refined integer square root.
  private def self.hypot_hard(x : Float64, y : Float64) : Float64
    xu = IyiFloatText.bits_of(x)
    yu = IyiFloatText.bits_of(y)
    bm = (xu & 0x000fffffffffffff_u64) | 0x0010000000000000_u64
    lm = (yu & 0x000fffffffffffff_u64) | 0x0010000000000000_u64
    be = xu.unsafe_shr(52_u64).unsafe_to_i32
    le = yu.unsafe_shr(52_u64).unsafe_to_i32
    ri = IyiFloatText.bits_of(sqrt(x * x + y * y))
    bs = 2
    rm = ri & 0x000fffffffffffff_u64
    re = ri.unsafe_shr(52_u64).unsafe_to_i32 - 0x3ff
    rm = rm | 0x0010000000000000_u64
    i = 0
    while i < 3
      if rm == 0x0010000000000000_u64
        rm = 0x001fffffffffffff_u64
        re = re - 1
      else
        rm = rm - 1_u64
      end
      i = i + 1
    end
    bm = bm.unsafe_shl(bs.unsafe_to_u64)
    m2 = bm &* bm
    de = be - le
    ls = bs - de
    if ls >= 0
      lm = lm.unsafe_shl(ls.unsafe_to_u64)
      m2 = m2 &+ lm &* lm
    else
      hi, lo = trig_mul64(lm, lm)
      s = (ls * -2).unsafe_to_u64
      m2 = m2 &+ (lo.unsafe_shr(s) | hi.unsafe_shl(64_u64 - s))
      m2 = m2 | 1_u64 if lo.unsafe_shl(64_u64 - s) != 0_u64
    end
    k = (bs + re).unsafe_to_u64
    d = 0_i64
    while true
      rm = rm + (rm >= 0x0020000000000000_u64 ? 2_u64 : 1_u64)
      tm = rm.unsafe_shl(k)
      d = (m2 &- tm &* tm).unsafe_to_i64
      break unless d > 0_i64
    end
    if d != 0_i64
      # rounding to nearest (the directed-rounding branch is left out)
      tm = rm.unsafe_shl(k) &- 1_u64.unsafe_shl(k - (rm <= 0x0020000000000000_u64 ? 1_u64 : 0_u64))
      d = (m2 &- tm &* tm).unsafe_to_i64
      if d != 0_i64
        rm = rm - 1_u64 if d < 0_i64
      else
        rm = rm - (rm & 1_u64.unsafe_shl(1_u64 - (rm <= 0x0020000000000000_u64 ? 1_u64 : 0_u64)))
      end
    end
    if rm >= 0x0020000000000000_u64
      rm = rm.unsafe_shr(1_u64)
      re = re + 1
    end
    e = (be - 1 + re).unsafe_to_i64
    IyiFloatText.from_bits(e.unsafe_to_u64.unsafe_shl(52_u64) &+ rm)
  end

  def self.cbrt(value : Float64) : Float64
    x = value
    hx = IyiFloatText.bits_of(x)
    mant = hx & 0x000fffffffffffff_u64
    sign = hx.unsafe_shr(63_u64)
    e = (hx.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_u32
    if ((e &+ 1_u32) & 0x7ff_u32) < 2_u32
      ix = hx & 0x7fffffffffffffff_u64
      return x + x if e == 0x7ff_u32 || ix == 0_u64
      nz = ix.leading_zeros_count - 11
      mant = mant.unsafe_shl(nz.unsafe_to_u64)
      mant = mant & 0x000fffffffffffff_u64
      e = e &- (nz - 1).unsafe_to_u32
    end
    e = e &+ 3072_u32
    cvt1 = mant | 0x3ff0000000000000_u64
    cvt5 = cvt1
    et = e // 3_u32
    it = e % 3_u32
    cvt5 = cvt5 &+ it.unsafe_to_u64.unsafe_shl(52_u64)
    cvt5 = cvt5 | sign.unsafe_shl(63_u64)
    zz = IyiFloatText.from_bits(cvt5)
    isc = CBRT_ESCALE[it.unsafe_to_i32] | sign.unsafe_shl(63_u64)
    z = IyiFloatText.from_bits(cvt1)
    r = 1.0 / z
    rr = r * IyiFloatText.from_bits(CBRT_RSC[(it.unsafe_to_u64.unsafe_shl(1_u64) | sign).unsafe_to_i32])
    z2 = z * z
    c0 = IyiFloatText.from_bits(CBRT_C[0]) + z * IyiFloatText.from_bits(CBRT_C[1])
    c2 = IyiFloatText.from_bits(CBRT_C[2]) + z * IyiFloatText.from_bits(CBRT_C[3])
    y = c0 + z2 * c2
    y2 = y * y
    h = y2 * (y * r) - 1.0
    y = y - (h * y) * (0.3333333333333333 - 0.2222222222222222 * h)
    y = y * IyiFloatText.from_bits(isc)
    y2 = y * y
    y2l = fma(y, y, y2 * -1.0)
    y3 = y2 * y
    y3l = fma(y, y2, y3 * -1.0) + y * y2l
    h = ((y3 - zz) + y3l) * rr
    dy = h * (y * 0.3333333333333333)
    y1 = y - dy
    dy = (y - y1) - dy
    # rounding to nearest: off[rm] is off[0] = 2^-53
    ady = dy.abs
    ady0 = (ady - 1.1102230246251565e-16).abs
    ady1 = (ady - (2.220446049250313e-16 + 1.1102230246251565e-16)).abs
    if ady0 < 2.6469779601696886e-23 || ady1 < 2.6469779601696886e-23
      y2 = y1 * y1
      y2l = fma(y1, y1, y2 * -1.0)
      y3 = y2 * y1
      y3l = fma(y1, y2, y3 * -1.0) + y1 * y2l
      h = ((y3 - zz) + y3l) * rr
      dy = h * (y1 * 0.3333333333333333)
      y = y1 - dy
      dy = (y1 - y) - dy
      y1 = y
      ady = dy.abs
      ady0 = (ady - 1.1102230246251565e-16).abs
      ady1 = (ady - (2.220446049250313e-16 + 1.1102230246251565e-16)).abs
      if ady0 < 3.1554436208840472e-30 || ady1 < 3.1554436208840472e-30
        azz = zz.abs
        y1 = copysign(1.4758508835342132, zz) if azz == 3.2146036897957497
        y1 = copysign(1.86925759992312, zz) if azz == 6.531417795099968
        # the rm > 0 worst-case list is for directed roundings only
      end
    end
    cvt3 = IyiFloatText.bits_of(y1) &+ (et.unsafe_to_u64 &- 1365_u64).unsafe_shl(52_u64)
    m0 = cvt3.unsafe_shl(30_u64)
    m1 = m0 >= 0x8000000000000000_u64 ? 0xffffffffffffffff_u64 : 0_u64
    if (m0 ^ m1) <= 0x40000000_u64
      cvt4 = (IyiFloatText.bits_of(y1) &+ 0x8000_u64) & 0xffffffffffff0000_u64
      if ((IyiFloatText.from_bits(cvt4) - y1) - dy).abs < 8.673617379884035e-19 || zz.abs == 1.0
        cvt3 = (cvt3 &+ 0x8000_u64) & 0xffffffffffff0000_u64
      end
    end
    IyiFloatText.from_bits(cvt3)
  end

  def self.cbrt(value : Float32) : Float32
    cbrt(value.to_f64).to_f32
  end

  def self.cbrt(value : T) : Float64 forall T
    cbrt(value.to_f64)
  end

  # exp as glibc computes it on Linux - Arm's optimized-routines exp, which
  # glibc has carried since 2.28 - so a program's `Math.exp` is the other
  # library's to the last bit: fdlibm's, which this was, differed from it
  # for one argument in ten over a million drawn from +-700, and a result
  # printed in full differed with it. Exactly glibc's build without FMA;
  # on a processor with FMA glibc picks a fused build of the same source,
  # which answers differently in the last bit for about 7 arguments in
  # 10,000 - glibc against itself - and this, unfused on every target,
  # answers the same everywhere. x = k ln2/128 + r, |r| <= ln2/256,
  # the reduction by adding 1.5 * 2^52 as glibc's x86_64 build does; then
  # 2^(k/128) from a table of 128 pairs, as the scale's bits and a
  # correction, and exp(r) - 1 by a degree-5 polynomial. No division, where
  # fdlibm had one, and under 0.51 ulp. The table and the coefficients are
  # `math/exp_data.c`'s for N = 128, order 5, taken from its text rather
  # than retyped. Arm's code is MIT OR Apache-2.0 WITH LLVM-exception, used
  # here under MIT:
  #
  #   Copyright (c) 2018-2025 Arm Limited
  #
  #   Permission is hereby granted, free of charge, to any person obtaining
  #   a copy of this software and associated documentation files (the
  #   "Software"), to deal in the Software without restriction, including
  #   without limitation the rights to use, copy, modify, merge, publish,
  #   distribute, sublicense, and/or sell copies of the Software, and to
  #   permit persons to whom the Software is furnished to do so, subject to
  #   the following conditions: The above copyright notice and this
  #   permission notice shall be included in all copies or substantial
  #   portions of the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT
  #   WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO
  #   THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
  #   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
  #   LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
  #   OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
  #   WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
  private EXP_INVLN2N  =       184.6649652337873
  private EXP_NEGLN2HI =   -0.005415212348111709
  private EXP_NEGLN2LO = -1.2864023111638346e-14
  private EXP_SHIFT    =      6755399441055744.0
  private EXP_C2       =     0.49999999999996786
  private EXP_C3       =     0.16666666666665886
  private EXP_C4       =      0.0416666808410674
  private EXP_C5       =    0.008333335853059549

  # tab[2k] is T[k]'s bits and tab[2k + 1] H[k]'s less (k << 52) / 128,
  # where 2^(k/128) ~= H[k] * (1 + T[k]).
  private EXP_TAB = [
    0x0_u64, 0x3ff0000000000000_u64, 0x3c9b3b4f1a88bf6e_u64, 0x3feff63da9fb3335_u64,
