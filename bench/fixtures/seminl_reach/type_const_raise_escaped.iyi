REC_HEAP        = 1376_u64
CLASSES         =       67
PARTITION_BYTES = 2048_u64
TAKEN           =      176

macro emit_escaped_raise
  class EscapedRaise
    REC_HEAP        = 1376_u64
    CLASSES         =       67
    PARTITION_BYTES = 2048_u64
    TAKEN           =       10

    \{% if TAKEN * 8 < REC_HEAP || (TAKEN + CLASSES) * 8 > PARTITION_BYTES %}
      \{% raise "escaped type guard caught invalid layout" %}
    \{% end %}
  end
end

emit_escaped_raise
