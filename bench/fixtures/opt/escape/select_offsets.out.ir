; iyi-ir 1
source_filename = "escape_select_offsets"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @select_offsets(i1 %choose) {
entry:
  %0 = alloca [16 x i8], align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 16, i1 false)
  %right = getelementptr i8, ptr %0, i64 8
  %choice = select i1 %choose, ptr %0, ptr %right
  %v = load i64, ptr %choice, align 8
  ret i64 %v
}
