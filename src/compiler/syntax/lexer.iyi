module compiler/syntax/lexer

pub import std/text
pub import compiler/foundation/location
pub import compiler/foundation/errors
pub import compiler/foundation/enums
pub import compiler/foundation/string_pool
pub import compiler/syntax/token
using compiler/foundation/location::{Location}
using compiler/foundation/errors::{SyntaxException}
using compiler/foundation/string_pool::{StringPool}
using compiler/syntax/token::{Token, TokenKind, Keyword, NumberKind, DelimiterKind, DelimiterState, MacroState, MacroKeywordState}

pub class Lexer
  property doc_enabled : Bool
  property comments_enabled : Bool
  property count_whitespace : Bool
  property wants_raw : Bool
  property slash_is_regex : Bool
  property wants_def_or_macro_name : Bool
  property wants_regex : Bool
  property wants_symbol : Bool
  property comment_is_doc : Bool
  property iyi : Bool

  def doc_enabled? : Bool
    @doc_enabled
  end

  def comments_enabled? : Bool
    @comments_enabled
  end

  def count_whitespace? : Bool
    @count_whitespace
  end

  def wants_raw? : Bool
    @wants_raw
  end

  def slash_is_regex? : Bool
    @slash_is_regex
  end

  def wants_def_or_macro_name? : Bool
    @wants_def_or_macro_name
  end

  def wants_regex? : Bool
    @wants_regex
  end

  def wants_symbol? : Bool
    @wants_symbol
  end

  def comment_is_doc? : Bool
    @comment_is_doc
  end

  def iyi? : Bool
    @iyi
  end

  getter token : Token
  property line_number : Int32
  property column_number : Int32
  property filename : String
  getter source : String

  @pos : Int32
  @temp_token : Token
  @string_pool : StringPool
  @macro_curly_count : Int32

  @stacked : Bool
  @stacked_filename : String
  @stacked_line_number : Int32
  @stacked_column_number : Int32

  def initialize(source : String, filename : String = "", string_pool : StringPool? = nil)
    # Strip UTF-8 BOM if present (0xEF, 0xBB, 0xBF)
    if source.bytesize >= 3 && source.to_unsafe[0] == 0xEF_u8 && source.to_unsafe[1] == 0xBB_u8 && source.to_unsafe[2] == 0xBF_u8
      @source = source[3, source.bytesize - 3]
    else
      @source = source
    end

    @filename = filename
    @iyi = filename.empty? || filename.ends_with?(".iyi")
    @pos = 0
    @line_number = 1
    @column_number = 1

    @token = Token.new
    @temp_token = Token.new
    @string_pool = string_pool || StringPool.new

    @wants_regex = true
    @slash_is_regex = true
    @wants_def_or_macro_name = false
    @wants_symbol = true
    @wants_raw = false
    @comments_enabled = false
    @doc_enabled = false
    @comment_is_doc = true
    @count_whitespace = false
    @macro_curly_count = 0

    @stacked = false
    @stacked_filename = ""
    @stacked_line_number = 1
    @stacked_column_number = 1
  end

  def current_pos : Int32
    @pos
  end

  def current_pos=(pos : Int32)
    @pos = pos
  end

  # Decodes UTF-8 character at current @pos
  def current_char : Char
    return '\0' if @pos >= @source.bytesize

    ptr = @source.to_unsafe + @pos
    b0 = ptr[0].to_i
    if (b0 & 0x80) == 0
      b0.unsafe_chr
    elsif (b0 & 0xE0) == 0xC0 && @pos + 1 < @source.bytesize
      b1 = ptr[1].to_i
      (((b0 & 0x1F) << 6) | (b1 & 0x3F)).unsafe_chr
    elsif (b0 & 0xF0) == 0xE0 && @pos + 2 < @source.bytesize
      b1 = ptr[1].to_i
      b2 = ptr[2].to_i
      (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)).unsafe_chr
    elsif (b0 & 0xF8) == 0xF0 && @pos + 3 < @source.bytesize
      b1 = ptr[1].to_i
      b2 = ptr[2].to_i
      b3 = ptr[3].to_i
      (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)).unsafe_chr
    else
      b0.unsafe_chr
    end
  end

  private def next_codepoint_bytes(p : Int32) : Int32
    return 1 if p >= @source.bytesize
    b0 = @source.to_unsafe[p].to_i
    if (b0 & 0x80) == 0
      1
    elsif (b0 & 0xE0) == 0xC0
      2
    elsif (b0 & 0xF0) == 0xE0
      3
    elsif (b0 & 0xF8) == 0xF0
      4
    else
      1
    end
  end

  def peek_next_char : Char
    return '\0' if @pos >= @source.bytesize
    next_p = @pos + next_codepoint_bytes(@pos)
    return '\0' if next_p >= @source.bytesize

    ptr = @source.to_unsafe + next_p
    b0 = ptr[0].to_i
    if (b0 & 0x80) == 0
      b0.unsafe_chr
    elsif (b0 & 0xE0) == 0xC0 && next_p + 1 < @source.bytesize
      b1 = ptr[1].to_i
      (((b0 & 0x1F) << 6) | (b1 & 0x3F)).unsafe_chr
    elsif (b0 & 0xF0) == 0xE0 && next_p + 2 < @source.bytesize
      b1 = ptr[1].to_i
      b2 = ptr[2].to_i
      (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)).unsafe_chr
    elsif (b0 & 0xF8) == 0xF0 && next_p + 3 < @source.bytesize
      b1 = ptr[1].to_i
      b2 = ptr[2].to_i
      b3 = ptr[3].to_i
      (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)).unsafe_chr
    else
      b0.unsafe_chr
    end
  end

  def next_char_no_column_increment : Char
    if @pos < @source.bytesize
      @pos = @pos + next_codepoint_bytes(@pos)
    end
    current_char
  end

  def next_char : Char
    incr_column_number(1)
    next_char_no_column_increment
  end

  def next_char(token_type : TokenKind) : Char
    next_char
    @token.type = token_type
    current_char
  end

  def next_char_check_line : Char
    ch = next_char_no_column_increment
    if ch == '\n'
      incr_line_number(1)
    else
      incr_column_number(1)
    end
    ch
  end

  def incr_column_number(d : Int32 = 1)
    @column_number = @column_number + d
    if @stacked
      @stacked_column_number = @stacked_column_number + d
    end
  end

  def incr_line_number(column_number : Int32 = 1)
    @line_number = @line_number + 1
    @column_number = column_number
    if @stacked
      @stacked_line_number = @stacked_line_number + 1
      @stacked_column_number = column_number
    end
  end

  def string_range(start_pos : Int32) : String
    string_range(start_pos, current_pos)
  end

  def string_range(start_pos : Int32, end_pos : Int32) : String
    count = end_pos - start_pos
    return "" if count <= 0
    @source[start_pos, count]
  end

  def string_range_from_pool(start_pos : Int32) : String
    string_range_from_pool(start_pos, current_pos)
  end

  def string_range_from_pool(start_pos : Int32, end_pos : Int32) : String
    @string_pool.get(string_range(start_pos, end_pos))
  end

  def set_token_raw_from_start(start_pos : Int32)
    @token.start = start_pos
    if @wants_raw
      @token.raw = string_range(start_pos, current_pos)
    end
  end

  def reset_token
    @token.value = ""
    @token.keyword = nil
    @token.line_number = @line_number
    @token.column_number = @column_number
    @token.filename = @filename
    @token.passed_backslash_newline = false
    @token.invalid_escape = false
    @token.doc = nil
    @token.raw = ""
    @token.start = @pos
  end

  # Character sequence helpers
  def char_sequence?(c1 : Char) : Bool
    next_char == c1
  end

  def char_sequence?(c1 : Char, c2 : Char) : Bool
    next_char == c1 && next_char == c2
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char, c4 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3 && next_char == c4
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char, c4 : Char, c5 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3 && next_char == c4 && next_char == c5
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char, c4 : Char, c5 : Char, c6 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3 && next_char == c4 && next_char == c5 && next_char == c6
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char, c4 : Char, c5 : Char, c6 : Char, c7 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3 && next_char == c4 && next_char == c5 && next_char == c6 && next_char == c7
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char, c4 : Char, c5 : Char, c6 : Char, c7 : Char, c8 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3 && next_char == c4 && next_char == c5 && next_char == c6 && next_char == c7 && next_char == c8
  end

  def char_sequence?(c1 : Char, c2 : Char, c3 : Char, c4 : Char, c5 : Char, c6 : Char, c7 : Char, c8 : Char, c9 : Char) : Bool
    next_char == c1 && next_char == c2 && next_char == c3 && next_char == c4 && next_char == c5 && next_char == c6 && next_char == c7 && next_char == c8 && next_char == c9
  end

  def self.ident_start?(char : Char) : Bool
    char.ascii_letter? || char == '_' || char.ord > 0x9F
  end

  def self.ident_part?(char : Char) : Bool
    ident_start?(char) || char.ascii_number?
  end

  def ident_part_or_end?(char : Char) : Bool
    Lexer.ident_part?(char) || char == '?' || char == '!'
  end

  def peek_not_ident_part_or_end_next_char : Bool
    if !ident_part_or_end?(peek_next_char) && peek_next_char != ':'
      next_char
      true
    else
      false
    end
  end

  def closing_char(char : Char = current_char) : Char
    case char
    when '(' then ')'
    when '[' then ']'
    when '{' then '}'
    when '<' then '>'
    else          char
    end
  end

  def check_ident_or_keyword(keyword : Keyword, start_pos : Int32) : Token
    if ident_part_or_end?(peek_next_char) && !(@iyi && peek_next_char == '!')
      scan_ident(start_pos)
    else
      next_char(TokenKind::IDENT)
      @token.value = keyword.to_s
      @token.keyword = keyword
      set_token_raw_from_start(start_pos)
      @token
    end
  end

  def scan_ident(start_pos : Int32) : Token
    while Lexer.ident_part?(current_char)
      next_char
    end
    if (current_char == '?' || current_char == '!') && peek_next_char != '='
      unless @iyi && current_char == '!'
        next_char
      end
    end
    @token.type = TokenKind::IDENT
    @token.value = string_range_from_pool(start_pos)
    @token.keyword = nil
    set_token_raw_from_start(start_pos)
    @token
  end

  def raise_syntax_error(msg : String, line : Int32 = @line_number, col : Int32 = @column_number) : NoReturn
    ex = SyntaxException.new(msg, line, col, @filename)
    raise ex.to_s
  end

  def unknown_token : NoReturn
    char = current_char
    raise_syntax_error("unknown token: '#{char}'")
  end

  def next_token : Token
    # Check previous token for doc comment status:
    if @token.type == TokenKind::NEWLINE || @token.type == TokenKind::EOF
      @comment_is_doc = true
    elsif @token.type != TokenKind::SPACE
      @comment_is_doc = false
    end

    reset_token

    # Handle comments
    while current_char == '#'
      start_pos = current_pos
      if @comments_enabled
        return consume_comment(start_pos)
      elsif @doc_enabled && @comment_is_doc
        consume_doc
      else
        skip_comment
      end
    end
    start_pos = current_pos
    reset_regex_flags = true

    case ch = current_char
    when '\0'
      @token.type = TokenKind::EOF
    when ' ', '\t'
      consume_whitespace
      reset_regex_flags = false
    when '\\'
      case next_char
      when '\r', '\n'
        handle_slash_r_slash_n_or_slash_n
        next_char
        incr_line_number(1)
        @token.passed_backslash_newline = true
        consume_whitespace
        reset_regex_flags = false
      else
        unknown_token
      end
    when '\n'
      next_char(TokenKind::NEWLINE)
      incr_line_number(1)
      reset_regex_flags = false
      consume_newlines
    when '\r'
      if next_char == '\n'
        next_char(TokenKind::NEWLINE)
        incr_line_number(1)
        reset_regex_flags = false
        consume_newlines
      else
        raise_syntax_error("expected '\\n' after '\\r'")
      end
    when '='
      case next_char
      when '='
        case next_char
        when '='
          next_char(TokenKind::OP_EQ_EQ_EQ)
        else
          @token.type = TokenKind::OP_EQ_EQ
        end
      when '>'
        next_char(TokenKind::OP_EQ_GT)
      when '~'
        next_char(TokenKind::OP_EQ_TILDE)
      else
        @token.type = TokenKind::OP_EQ
      end
    when '!'
      case next_char
      when '='
        next_char(TokenKind::OP_BANG_EQ)
      when '~'
        next_char(TokenKind::OP_BANG_TILDE)
      else
        @token.type = TokenKind::OP_BANG
      end
    when '<'
      case next_char
      when '='
        case next_char
        when '>'
          next_char(TokenKind::OP_LT_EQ_GT)
        else
          @token.type = TokenKind::OP_LT_EQ
        end
      when '<'
        case next_char
        when '='
          next_char(TokenKind::OP_LT_LT_EQ)
        when '-'
          consume_heredoc_start(start_pos)
        else
          @token.type = TokenKind::OP_LT_LT
        end
      else
        @token.type = TokenKind::OP_LT
      end
    when '>'
      case next_char
      when '='
        next_char(TokenKind::OP_GT_EQ)
      when '>'
        case next_char
        when '='
          next_char(TokenKind::OP_GT_GT_EQ)
        else
          @token.type = TokenKind::OP_GT_GT
        end
      else
        @token.type = TokenKind::OP_GT
      end
    when '+'
      @token.start = start_pos
      case next_char
      when '='
        next_char(TokenKind::OP_PLUS_EQ)
      when '0'..'9'
        scan_number(start_pos)
      when '+'
        raise_syntax_error("postfix increment is not supported, use `exp += 1`")
      else
        @token.type = TokenKind::OP_PLUS
      end
    when '-'
      @token.start = start_pos
      case next_char
      when '='
        next_char(TokenKind::OP_MINUS_EQ)
      when '>'
        next_char(TokenKind::OP_MINUS_GT)
      when '0'..'9'
        scan_number(start_pos, negative: true)
      when '-'
        raise_syntax_error("postfix decrement is not supported, use `exp -= 1`")
      else
        @token.type = TokenKind::OP_MINUS
      end
    when '*'
      case next_char
      when '='
        next_char(TokenKind::OP_STAR_EQ)
      when '*'
        case next_char
        when '='
          next_char(TokenKind::OP_STAR_STAR_EQ)
        else
          @token.type = TokenKind::OP_STAR_STAR
        end
      else
        @token.type = TokenKind::OP_STAR
      end
    when '/'
      char = next_char
      if (@wants_def_or_macro_name || !@slash_is_regex) && char == '/'
        case next_char
        when '='
          next_char(TokenKind::OP_SLASH_SLASH_EQ)
        else
          @token.type = TokenKind::OP_SLASH_SLASH
        end
      elsif !@slash_is_regex && char == '='
        next_char(TokenKind::OP_SLASH_EQ)
      elsif @wants_def_or_macro_name
        @token.type = TokenKind::OP_SLASH
      elsif @slash_is_regex
        delimited_pair(DelimiterKind::REGEX, "/", "/", start_pos)
      elsif char.ascii_whitespace? || char == '\0'
        @token.type = TokenKind::OP_SLASH
      elsif @wants_regex
        delimited_pair(DelimiterKind::REGEX, "/", "/", start_pos)
      else
        @token.type = TokenKind::OP_SLASH
      end
    when '%'
      if @wants_def_or_macro_name
        next_char(TokenKind::OP_PERCENT)
      else
        del_state = lookahead { delimiter_state_for_percent_literal }
        if del_state
          @token.delimiter_state = del_state
          if del_state.kind == DelimiterKind::SYMBOL_ARRAY
            @token.type = TokenKind::SYMBOL_ARRAY_START
          elsif del_state.kind == DelimiterKind::STRING_ARRAY
            @token.type = TokenKind::STRING_ARRAY_START
          else
            @token.type = TokenKind::DELIMITER_START
          end
          next_char
          set_token_raw_from_start(start_pos)
        else
          case next_char
          when '='
            next_char(TokenKind::OP_PERCENT_EQ)
          when '}'
            next_char(TokenKind::OP_PERCENT_RCURLY)
          else
            @token.type = TokenKind::OP_PERCENT
          end
        end
      end
    when '(' then next_char(TokenKind::OP_LPAREN)
    when ')' then next_char(TokenKind::OP_RPAREN)
    when '{'
      case next_char
      when '%'
        next_char(TokenKind::OP_LCURLY_PERCENT)
      when '{'
        next_char(TokenKind::OP_LCURLY_LCURLY)
      else
        @token.type = TokenKind::OP_LCURLY
      end
    when '}' then next_char(TokenKind::OP_RCURLY)
    when '['
      case next_char
      when ']'
        case next_char
        when '='
          next_char(TokenKind::OP_LSQUARE_RSQUARE_EQ)
        when '?'
          next_char(TokenKind::OP_LSQUARE_RSQUARE_QUESTION)
        else
          @token.type = TokenKind::OP_LSQUARE_RSQUARE
        end
      else
        @token.type = TokenKind::OP_LSQUARE
      end
    when ']' then next_char(TokenKind::OP_RSQUARE)
    when ',' then next_char(TokenKind::OP_COMMA)
    when '?' then next_char(TokenKind::OP_QUESTION)
    when ';'
      reset_regex_flags = false
      next_char(TokenKind::OP_SEMICOLON)
    when ':'
      if next_char == ':'
        next_char(TokenKind::OP_COLON_COLON)
      elsif @wants_symbol
        consume_symbol
      else
        @token.type = TokenKind::OP_COLON
      end
    when '~'
      next_char(TokenKind::OP_TILDE)
    when '.'
      line = @line_number
      col = @column_number
      case next_char
      when '.'
        case next_char
        when '.'
          next_char(TokenKind::OP_PERIOD_PERIOD_PERIOD)
        else
          @token.type = TokenKind::OP_PERIOD_PERIOD
        end
      when '0'..'9'
        raise_syntax_error(".1 style number literal is not supported, put 0 before dot", line, col)
      else
        @token.type = TokenKind::OP_PERIOD
      end
    when '&'
      case next_char
      when '&'
        case next_char
        when '='
          next_char(TokenKind::OP_AMP_AMP_EQ)
        else
          @token.type = TokenKind::OP_AMP_AMP
        end
      when '='
        next_char(TokenKind::OP_AMP_EQ)
      when '+'
        case next_char
        when '='
          next_char(TokenKind::OP_AMP_PLUS_EQ)
        else
          @token.type = TokenKind::OP_AMP_PLUS
        end
      when '-'
        if peek_next_char == '>'
          @token.type = TokenKind::OP_AMP
        else
          case next_char
          when '='
            next_char(TokenKind::OP_AMP_MINUS_EQ)
          else
            @token.type = TokenKind::OP_AMP_MINUS
          end
        end
      when '*'
        case next_char
        when '*'
          next_char(TokenKind::OP_AMP_STAR_STAR)
        when '='
          next_char(TokenKind::OP_AMP_STAR_EQ)
        else
          @token.type = TokenKind::OP_AMP_STAR
        end
      else
        @token.type = TokenKind::OP_AMP
      end
    when '|'
      case next_char
      when '|'
        case next_char
        when '='
          next_char(TokenKind::OP_BAR_BAR_EQ)
        else
          @token.type = TokenKind::OP_BAR_BAR
        end
      when '='
        next_char(TokenKind::OP_BAR_EQ)
      else
        @token.type = TokenKind::OP_BAR
      end
    when '^'
      case next_char
      when '='
        next_char(TokenKind::OP_CARET_EQ)
      else
        @token.type = TokenKind::OP_CARET
      end
    when '\''
      scan_char_literal(start_pos)
    when '`'
      if @wants_def_or_macro_name
        next_char(TokenKind::OP_GRAVE)
      else
        next_char
        delimited_pair(DelimiterKind::COMMAND, "`", "`", start_pos)
      end
    when '"'
      next_char
      delimited_pair(DelimiterKind::STRING, "\"", "\"", start_pos)
    when '0'..'9'
      scan_number(start_pos)
    when '@'
      case next_char
      when '['
        next_char(TokenKind::OP_AT_LSQUARE)
      when '@'
        next_char
        consume_variable(TokenKind::CLASS_VAR, start_pos)
      else
        consume_variable(TokenKind::INSTANCE_VAR, start_pos)
      end
    when '$'
      case next_char
      when '~'
        next_char(TokenKind::OP_DOLLAR_TILDE)
      when '?'
        next_char(TokenKind::OP_DOLLAR_QUESTION)
      when '0'..'9'
        m_start = current_pos
        if current_char == '0'
          next_char
        else
          while current_char.ascii_number?
            next_char
          end
          if current_char == '?'
            next_char
          end
        end
        @token.type = TokenKind::GLOBAL_MATCH_DATA_INDEX
        @token.value = string_range_from_pool(m_start)
      else
        consume_variable(TokenKind::GLOBAL, start_pos)
      end
    when 'a'
      case next_char
      when 'b'
        if char_sequence?('s', 't', 'r', 'a', 'c', 't')
          return check_ident_or_keyword(Keyword::ABSTRACT, start_pos)
        end
      when 'l'
        if next_char == 'i'
          case next_char
          when 'a'
            if next_char == 's'
              return check_ident_or_keyword(Keyword::ALIAS, start_pos)
            end
          when 'g'
            if char_sequence?('n', 'o', 'f')
              return check_ident_or_keyword(Keyword::ALIGNOF, start_pos)
            end
          end
        end
      when 's'
        case peek_next_char
        when 'm'
          next_char
          return check_ident_or_keyword(Keyword::ASM, start_pos)
        when '?'
          next_char
          next_char(TokenKind::IDENT)
          @token.value = "as?"
          @token.keyword = Keyword::AS_QUESTION
          set_token_raw_from_start(start_pos)
          return @token
        else
          return check_ident_or_keyword(Keyword::AS, start_pos)
        end
      when 'n'
        if char_sequence?('n', 'o', 't', 'a', 't', 'i', 'o', 'n')
          return check_ident_or_keyword(Keyword::ANNOTATION, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'b'
      case next_char
      when 'e'
        if char_sequence?('g', 'i', 'n')
          return check_ident_or_keyword(Keyword::BEGIN, start_pos)
        end
      when 'r'
        if char_sequence?('e', 'a', 'k')
          return check_ident_or_keyword(Keyword::BREAK, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'c'
      case next_char
      when 'a'
        if char_sequence?('s', 'e')
          return check_ident_or_keyword(Keyword::CASE, start_pos)
        end
      when 'l'
        if char_sequence?('a', 's', 's')
          return check_ident_or_keyword(Keyword::CLASS, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'd'
      case next_char
      when 'e'
        if next_char == 'f'
          return check_ident_or_keyword(Keyword::DEF, start_pos)
        end
      when 'o'
        return check_ident_or_keyword(Keyword::DO, start_pos)
      end
      scan_ident(start_pos)
    when 'e'
      case next_char
      when 'l'
        case next_char
        when 's'
          case next_char
          when 'e' then return check_ident_or_keyword(Keyword::ELSE, start_pos)
          when 'i'
            if next_char == 'f'
              return check_ident_or_keyword(Keyword::ELSIF, start_pos)
            end
          end
        end
      when 'n'
        case next_char
        when 'd'
          return check_ident_or_keyword(Keyword::END, start_pos)
        when 's'
          if char_sequence?('u', 'r', 'e')
            return check_ident_or_keyword(Keyword::ENSURE, start_pos)
          end
        when 'u'
          if next_char == 'm'
            return check_ident_or_keyword(Keyword::ENUM, start_pos)
          end
        end
      when 'x'
        if char_sequence?('t', 'e', 'n', 'd')
          return check_ident_or_keyword(Keyword::EXTEND, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'f'
      case next_char
      when 'a'
        if char_sequence?('l', 's', 'e')
          return check_ident_or_keyword(Keyword::FALSE, start_pos)
        end
      when 'o'
        if next_char == 'r'
          return check_ident_or_keyword(Keyword::FOR, start_pos)
        end
      when 'u'
        if next_char == 'n'
          return check_ident_or_keyword(Keyword::FUN, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'i'
      case next_char
      when 'f'
        return check_ident_or_keyword(Keyword::IF, start_pos)
      when 'm'
        case next_char
        when 'p'
          case next_char
          when 'l'
            return check_ident_or_keyword(Keyword::IMPL, start_pos)
          when 'o'
            if char_sequence?('r', 't')
              return check_ident_or_keyword(Keyword::IMPORT, start_pos)
            end
          end
        end
      when 'n'
        if ident_part_or_end?(peek_next_char)
          case next_char
          when 'c'
            if char_sequence?('l', 'u', 'd', 'e')
              return check_ident_or_keyword(Keyword::INCLUDE, start_pos)
            end
          when 's'
            if char_sequence?('t', 'a', 'n', 'c', 'e', '_')
              case next_char
              when 's'
                if char_sequence?('i', 'z', 'e', 'o', 'f')
                  return check_ident_or_keyword(Keyword::INSTANCE_SIZEOF, start_pos)
                end
              when 'a'
                if char_sequence?('l', 'i', 'g', 'n', 'o', 'f')
                  return check_ident_or_keyword(Keyword::INSTANCE_ALIGNOF, start_pos)
                end
              end
            end
          end
        else
          next_char(TokenKind::IDENT)
          @token.value = "in"
          @token.keyword = Keyword::IN
          set_token_raw_from_start(start_pos)
          return @token
        end
      when 's'
        if char_sequence?('_', 'a', '?')
          return check_ident_or_keyword(Keyword::IS_A_QUESTION, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'l'
      case next_char
      when 'i'
        if next_char == 'b'
          return check_ident_or_keyword(Keyword::LIB, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'm'
      case next_char
      when 'a'
        if char_sequence?('c', 'r', 'o')
          return check_ident_or_keyword(Keyword::MACRO, start_pos)
        end
      when 'o'
        case next_char
        when 'd'
          if char_sequence?('u', 'l', 'e')
            return check_ident_or_keyword(Keyword::MODULE, start_pos)
          end
        end
      end
      scan_ident(start_pos)
    when 'n'
      case next_char
      when 'e'
        if char_sequence?('x', 't')
          return check_ident_or_keyword(Keyword::NEXT, start_pos)
        end
      when 'i'
        case next_char
        when 'l'
          if peek_next_char == '?'
            next_char
            return check_ident_or_keyword(Keyword::NIL_QUESTION, start_pos)
          else
            return check_ident_or_keyword(Keyword::NIL, start_pos)
          end
        end
      end
      scan_ident(start_pos)
    when 'o'
      case next_char
      when 'f'
        if peek_next_char == 'f'
          next_char
          if char_sequence?('s', 'e', 't', 'o', 'f')
            return check_ident_or_keyword(Keyword::OFFSETOF, start_pos)
          end
        else
          return check_ident_or_keyword(Keyword::OF, start_pos)
        end
      when 'u'
        if next_char == 't'
          return check_ident_or_keyword(Keyword::OUT, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'p'
      case next_char
      when 'o'
        if char_sequence?('i', 'n', 't', 'e', 'r', 'o', 'f')
          return check_ident_or_keyword(Keyword::POINTEROF, start_pos)
        end
      when 'u'
        if char_sequence?('b')
          return check_ident_or_keyword(Keyword::PUB, start_pos)
        end
      when 'r'
        case next_char
        when 'i'
          if char_sequence?('v', 'a', 't', 'e')
            return check_ident_or_keyword(Keyword::PRIVATE, start_pos)
          end
        when 'o'
          if char_sequence?('t', 'e', 'c', 't', 'e', 'd')
            return check_ident_or_keyword(Keyword::PROTECTED, start_pos)
          end
        end
      end
      scan_ident(start_pos)
    when 'r'
      case next_char
      when 'e'
        case next_char
        when 's'
          case next_char
          when 'c'
            if char_sequence?('u', 'e')
              return check_ident_or_keyword(Keyword::RESCUE, start_pos)
            end
          when 'p'
            if char_sequence?('o', 'n', 'd', 's', '_', 't', 'o', '?')
              return check_ident_or_keyword(Keyword::RESPONDS_TO_QUESTION, start_pos)
            end
          end
        when 't'
          if char_sequence?('u', 'r', 'n')
            return check_ident_or_keyword(Keyword::RETURN, start_pos)
          end
        when 'q'
          if char_sequence?('u', 'i', 'r', 'e')
            return check_ident_or_keyword(Keyword::REQUIRE, start_pos)
          end
        end
      end
      scan_ident(start_pos)
    when 's'
      case next_char
      when 'e'
        if next_char == 'l'
          case next_char
          when 'e'
            if char_sequence?('c', 't')
              return check_ident_or_keyword(Keyword::SELECT, start_pos)
            end
          when 'f'
            return check_ident_or_keyword(Keyword::SELF, start_pos)
          end
        end
      when 'i'
        if char_sequence?('z', 'e', 'o', 'f')
          return check_ident_or_keyword(Keyword::SIZEOF, start_pos)
        end
      when 't'
        if char_sequence?('r', 'u', 'c', 't')
          return check_ident_or_keyword(Keyword::STRUCT, start_pos)
        end
      when 'u'
        if char_sequence?('p', 'e', 'r')
          return check_ident_or_keyword(Keyword::SUPER, start_pos)
        end
      end
      scan_ident(start_pos)
    when 't'
      case next_char
      when 'h'
        if char_sequence?('e', 'n')
          return check_ident_or_keyword(Keyword::THEN, start_pos)
        end
      when 'r'
        case next_char
        when 'u'
          if char_sequence?('e')
            return check_ident_or_keyword(Keyword::TRUE, start_pos)
          end
        when 'a'
          if char_sequence?('i', 't')
            return check_ident_or_keyword(Keyword::TRAIT, start_pos)
          end
        end
      when 'y'
        if char_sequence?('p', 'e')
          if peek_next_char == 'o'
            next_char
            if next_char == 'f'
              return check_ident_or_keyword(Keyword::TYPEOF, start_pos)
            end
          else
            return check_ident_or_keyword(Keyword::TYPE, start_pos)
          end
        end
      end
      scan_ident(start_pos)
    when 'u'
      case next_char
      when 'n'
        case next_char
        when 'i'
          case next_char
          when 'o'
            if next_char == 'n'
              return check_ident_or_keyword(Keyword::UNION, start_pos)
            end
          when 'n'
            if char_sequence?('i', 't', 'i', 'a', 'l', 'i', 'z', 'e', 'd')
              return check_ident_or_keyword(Keyword::UNINITIALIZED, start_pos)
            end
          end
        when 'l'
          if char_sequence?('e', 's', 's')
            return check_ident_or_keyword(Keyword::UNLESS, start_pos)
          end
        when 't'
          if char_sequence?('i', 'l')
            return check_ident_or_keyword(Keyword::UNTIL, start_pos)
          end
        end
      when 's'
        if char_sequence?('i', 'n', 'g')
          return check_ident_or_keyword(Keyword::USING, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'v'
      if char_sequence?('e', 'r', 'b', 'a', 't', 'i', 'm')
        return check_ident_or_keyword(Keyword::VERBATIM, start_pos)
      end
      scan_ident(start_pos)
    when 'w'
      case next_char
      when 'h'
        case next_char
        when 'e'
          if next_char == 'n'
            return check_ident_or_keyword(Keyword::WHEN, start_pos)
          end
        when 'i'
          if char_sequence?('l', 'e')
            return check_ident_or_keyword(Keyword::WHILE, start_pos)
          end
        end
      when 'i'
        if char_sequence?('t', 'h')
          return check_ident_or_keyword(Keyword::WITH, start_pos)
        end
      end
      scan_ident(start_pos)
    when 'y'
      if char_sequence?('i', 'e', 'l', 'd')
        return check_ident_or_keyword(Keyword::YIELD, start_pos)
      end
      scan_ident(start_pos)
    when '_'
      case next_char
      when '_'
        case next_char
        when 'D'
          if char_sequence?('I', 'R', '_', '_') && !ident_part_or_end?(peek_next_char)
            next_char(TokenKind::MAGIC_DIR)
            set_token_raw_from_start(start_pos)
            return @token
          end
        when 'E'
          if char_sequence?('N', 'D', '_', 'L', 'I', 'N', 'E', '_', '_') && !ident_part_or_end?(peek_next_char)
            next_char(TokenKind::MAGIC_END_LINE)
            set_token_raw_from_start(start_pos)
            return @token
          end
        when 'F'
          if char_sequence?('I', 'L', 'E', '_', '_') && !ident_part_or_end?(peek_next_char)
            next_char(TokenKind::MAGIC_FILE)
            set_token_raw_from_start(start_pos)
            return @token
          end
        when 'L'
          if char_sequence?('I', 'N', 'E', '_', '_') && !ident_part_or_end?(peek_next_char)
            next_char(TokenKind::MAGIC_LINE)
            set_token_raw_from_start(start_pos)
            return @token
          end
        end
      else
        unless Lexer.ident_part?(current_char)
          @token.type = TokenKind::UNDERSCORE
          set_token_raw_from_start(start_pos)
          return @token
        end
      end
      scan_ident(start_pos)
    else
      if ch.ascii_uppercase?
        while Lexer.ident_part?(next_char)
        end
        @token.type = TokenKind::CONST
        @token.value = string_range_from_pool(start_pos)
      elsif Lexer.ident_start?(ch)
        next_char
        scan_ident(start_pos)
      else
        unknown_token
      end
    end

    if reset_regex_flags
      @wants_regex = true
      @slash_is_regex = false
    end

    set_token_raw_from_start(start_pos)
    @token
  end

  private def consume_whitespace
    while true
      case current_char
      when ' ', '\t'
        next_char
      when '\\'
        case next_char
        when '\r', '\n'
          handle_slash_r_slash_n_or_slash_n
          next_char
          incr_line_number(1)
          @token.passed_backslash_newline = true
        else
          unknown_token
        end
      else
        break
      end
    end
    @token.type = TokenKind::SPACE
  end

  private def consume_newlines
    while true
      if current_char == '\n'
        next_char
        incr_line_number(1)
      elsif current_char == '\r' && peek_next_char == '\n'
        next_char
        next_char
        incr_line_number(1)
      else
        break
      end
    end
  end

  private def handle_slash_r_slash_n_or_slash_n : Bool
    if current_char == '\r' && peek_next_char == '\n'
      next_char
      true
    else
      false
    end
  end

  private def skip_comment
    while current_char != '\n' && current_char != '\0'
      next_char_no_column_increment
    end
  end

  private def consume_comment(start_pos : Int32) : Token
    skip_comment
    @token.type = TokenKind::COMMENT
    @token.value = string_range(start_pos)
    set_token_raw_from_start(start_pos)
    @token
  end

  private def consume_doc
    # In doc mode, collect comment lines
    start_pos = current_pos
    skip_comment
    line_doc = string_range(start_pos)
    if existing = @token.doc
      @token.doc = existing + "\n" + line_doc
    else
      @token.doc = line_doc
    end
  end

  private def consume_variable(kind : TokenKind, start_pos : Int32)
    if Lexer.ident_start?(current_char)
      while Lexer.ident_part?(next_char)
      end
      @token.type = kind
      @token.value = string_range_from_pool(start_pos)
    else
      unknown_token
    end
  end

  private def scan_char_literal(start_pos : Int32)
    line = @line_number
    col = @column_number
    @token.type = TokenKind::CHAR
    char1 = next_char
    case char1
    when '\\'
      char2 = next_char
      case char2
      when '\\' then @token.value = "\\"
      when '\'' then @token.value = "'"
      when 'a'  then @token.value = "\a"
      when 'b'  then @token.value = "\b"
      when 'e'  then @token.value = "\e"
      when 'f'  then @token.value = "\f"
      when 'n'  then @token.value = "\n"
      when 'r'  then @token.value = "\r"
      when 't'  then @token.value = "\t"
      when 'v'  then @token.value = "\v"
      when 'u'
        cp = consume_char_unicode_escape
        @token.value = cp.unsafe_chr.to_s
      when '0' then @token.value = "\0"
      when '\0'
        raise_syntax_error("unterminated char literal", line, col)
      else
        raise_syntax_error("invalid char escape sequence '\\#{char2}'", line, col)
      end
    when '\''
      raise_syntax_error("invalid empty char literal (did you mean '\\''?)", line, col)
    when '\0'
      raise_syntax_error("unterminated char literal", line, col)
    else
      @token.value = char1.to_s
    end

    if next_char != '\''
      raise_syntax_error("unterminated char literal, use double quotes for strings", line, col)
    end
    next_char
    set_token_raw_from_start(start_pos)
  end

  private def consume_char_unicode_escape : Int32
    if peek_next_char == '{'
      next_char
      next_char
      val = 0
      while current_char != '}'
        if current_char == '\0'
          raise_syntax_error("unterminated unicode escape")
        end
        d = hex_value(current_char)
        if d < 0
          raise_syntax_error("expected hexadecimal character in unicode escape")
        end
        val = (val << 4) | d
        next_char
      end
      val
    else
      val = 0
      i = 0
      while i < 4
        next_char
        d = hex_value(current_char)
        if d < 0
          raise_syntax_error("expected hexadecimal character in unicode escape")
        end
        val = (val << 4) | d
        i = i + 1
      end
      val
    end
  end

  private def consume_string_hex_escape : UInt8
    d1 = hex_value(next_char)
    d2 = hex_value(next_char)
    if d1 < 0 || d2 < 0
      raise_syntax_error("expected hexadecimal character in escape sequence")
    end
    ((d1 << 4) | d2).to_u8
  end

  private def consume_string_unicode_escape : String
    cp = consume_char_unicode_escape
    cp.unsafe_chr.to_s
  end

  private def consume_octal_escape(first_digit : Char) : UInt8
    val = first_digit.ord - 48
    count = 1
    while count < 3 && peek_next_char >= '0' && peek_next_char <= '7'
      next_char
      val = (val << 3) | (current_char.ord - 48)
      count = count + 1
    end
    val.to_u8
  end

  private def hex_value(ch : Char) : Int32
    if ch >= '0' && ch <= '9'
      ch.ord - 48
    elsif ch >= 'a' && ch <= 'f'
      ch.ord - 97 + 10
    elsif ch >= 'A' && ch <= 'F'
      ch.ord - 65 + 10
    else
      -1
    end
  end

  private def char_to_digit(ch : Char) : Int32
    if ch >= '0' && ch <= '9'
      ch.ord - 48
    elsif ch >= 'a' && ch <= 'z'
      ch.ord - 97 + 10
    elsif ch >= 'A' && ch <= 'Z'
      ch.ord - 65 + 10
    else
      -1
    end
  end

  private def scan_number(start_pos : Int32, negative : Bool = false)
    @token.type = TokenKind::NUMBER
    base = 10
    number_size = 0
    suffix_size = 0
    is_decimal = false
    is_e_notation = false
    has_underscores = false
    last_is_underscore = false
    pos_after_prefix = start_pos
    pos_before_exponent = -1

    if current_char == '0'
      case peek_next_char
      when 'b' then base = 2
      when 'o' then base = 8
      when 'x' then base = 16
      when '0'..'9'
        raise_syntax_error("octal constants should be prefixed with 0o")
      when '_'
        next_char
        next_char
        if current_char >= '0' && current_char <= '9'
          raise_syntax_error("octal constants should be prefixed with 0o")
        end
        has_underscores = true
        last_is_underscore = true
      end

      unless base == 10
        next_char # skip 0
        next_char # skip prefix (b, o, x)
        pos_after_prefix = current_pos
        if current_char == '_'
          raise_syntax_error("unexpected '_' in number")
        end
        d = char_to_digit(current_char)
        if d < 0 || d >= base
          raise_syntax_error("numeric literal without digits")
        end
      end
    end

    # Consume number digits
    while true
      while true
        d = char_to_digit(current_char)
        break if d < 0 || d >= base
        number_size = number_size + 1 unless number_size == 0 && current_char == '0'
        next_char
        last_is_underscore = false
      end

      if pos_before_exponent >= 0 && current_pos <= pos_before_exponent
        raise_syntax_error("invalid decimal number exponent")
      end

      case ch = current_char
      when '_'
        if last_is_underscore
          raise_syntax_error("consecutive underscores in numbers aren't allowed")
        end
        has_underscores = true
        last_is_underscore = true
      when '.'
        if last_is_underscore
          raise_syntax_error("unexpected '_' in number")
        end
        if is_decimal || base != 10 || !(peek_next_char >= '0' && peek_next_char <= '9')
          break
        end
        is_decimal = true
      when 'e', 'E'
        last_is_underscore = false
        if is_e_notation || base != 10
          break
        end
        is_e_notation = true
        is_decimal = true
        if peek_next_char == '+' || peek_next_char == '-'
          next_char
        end
        if peek_next_char == '_'
          raise_syntax_error("unexpected '_' in number")
        end
        pos_before_exponent = current_pos + 1
      when 'i', 'u', 'f'
        if ch == 'f' && base != 10
          if base == 2
            raise_syntax_error("binary float literal is not supported")
          elsif base == 8
            raise_syntax_error("octal float literal is not supported")
          end
          break
        end
        before_suffix_pos = current_pos
        @token.number_kind = consume_number_suffix
        next_char
        suffix_size = current_pos - before_suffix_pos
        if last_is_underscore
          suffix_size = suffix_size + 1
        end
        break
      else
        if last_is_underscore
          raise_syntax_error("trailing '_' in number")
        end
        break
      end

      next_char
    end

    set_token_raw_from_start(start_pos)
    pos_before_suffix = current_pos - suffix_size
    raw_num = string_range(pos_after_prefix, pos_before_suffix)

    if base == 10
      if has_underscores
        raw_num = strip_underscores(raw_num)
      end
      @token.value = raw_num
    else
      # Convert base 2, 8, 16 to base 10 string
      dec_val = convert_base_to_decimal_string(raw_num, base)
      first_b = @source[start_pos].to_s
      if first_b == "+" || first_b == "-"
        dec_val = first_b + dec_val
      end
      @token.value = dec_val
      raw_num = dec_val
      number_size = dec_val.bytesize
    end

    if is_decimal
      if suffix_size == 0
        @token.number_kind = NumberKind::F64
      end
      unless @token.number_kind.float?
        raise_syntax_error("Invalid suffix #{@token.number_kind.to_s} for decimal number")
      end
      return
    end

    # Integer magnitude and suffix checks
    if suffix_size == 0
      @token.number_kind = determine_default_integer_kind(raw_num, negative)
    else
      check_integer_fits_in_kind(raw_num, @token.number_kind, negative)
    end
  end

  private def strip_underscores(s : String) : String
    res = ""
    i = 0
    while i < s.bytesize
      ch = s[i]
      if ch != '_'
        res = res + ch.to_s
      end
      i = i + 1
    end
    res
  end

  private def convert_base_to_decimal_string(s : String, base : Int32) : String
    val = 0_u64
    i = 0
    while i < s.bytesize
      ch = s[i]
      if ch != '_'
        d = char_to_digit(ch)
        val = val * base.to_u64 + d.to_u64
      end
      i = i + 1
    end
    val.to_s
  end

  private def determine_default_integer_kind(s : String, negative : Bool) : NumberKind
    # Number of digits:
    num_str = s.starts_with?("-") || s.starts_with?("+") ? s[1, s.bytesize - 1] : s
    sz = num_str.bytesize

    if sz < 10
      NumberKind::I32
    elsif sz == 10
      if fits_in_i32?(num_str, negative)
        NumberKind::I32
      else
        NumberKind::I64
      end
    elsif sz < 19
      NumberKind::I64
    elsif sz == 19
      if fits_in_i64?(num_str, negative)
        NumberKind::I64
      elsif negative
        NumberKind::I128
      else
        NumberKind::U64
      end
    elsif sz == 20
      if negative
        NumberKind::I128
      elsif fits_in_u64?(num_str)
        NumberKind::U64
      else
        NumberKind::I128
      end
    else
      NumberKind::I128
    end
  end

  private def fits_in_i32?(s : String, negative : Bool) : Bool
    max_str = negative ? "2147483648" : "2147483647"
    compare_numeric_strings(s, max_str) <= 0
  end

  private def fits_in_i64?(s : String, negative : Bool) : Bool
    max_str = negative ? "9223372036854775808" : "9223372036854775807"
    compare_numeric_strings(s, max_str) <= 0
  end

  private def fits_in_u64?(s : String) : Bool
    compare_numeric_strings(s, "18446744073709551615") <= 0
  end

  private def compare_numeric_strings(a : String, b : String) : Int32
    if a.bytesize < b.bytesize
      -1
    elsif a.bytesize > b.bytesize
      1
    else
      i = 0
      while i < a.bytesize
        ca = a[i]
        cb = b[i]
        if ca < cb
          return -1
        elsif ca > cb
          return 1
        end
        i = i + 1
      end
      0
    end
  end

  private def check_integer_fits_in_kind(s : String, kind : NumberKind, negative : Bool)
    num_str = s.starts_with?("-") || s.starts_with?("+") ? s[1, s.bytesize - 1] : s
    fits = case kind
           when NumberKind::I8
             compare_numeric_strings(num_str, negative ? "128" : "127") <= 0
           when NumberKind::U8
             !negative && compare_numeric_strings(num_str, "255") <= 0
           when NumberKind::I16
             compare_numeric_strings(num_str, negative ? "32768" : "32767") <= 0
           when NumberKind::U16
             !negative && compare_numeric_strings(num_str, "65535") <= 0
           when NumberKind::I32
             fits_in_i32?(num_str, negative)
           when NumberKind::U32
             !negative && compare_numeric_strings(num_str, "4294967295") <= 0
           when NumberKind::I64
             fits_in_i64?(num_str, negative)
           when NumberKind::U64
             !negative && fits_in_u64?(num_str)
           when NumberKind::I128, NumberKind::U128
             true
           else
             true
           end

    unless fits
      raise_syntax_error("#{s} doesn't fit in an #{kind.to_s}")
    end
  end

  private def consume_number_suffix : NumberKind
    case current_char
    when 'i'
      case next_char
      when '8' then return NumberKind::I8
      when '1'
        case next_char
        when '2'
          if next_char == '8'
            return NumberKind::I128
          end
        when '6'
          return NumberKind::I16
        end
      when '3'
        if next_char == '2'
          return NumberKind::I32
        end
      when '6'
        if next_char == '4'
          return NumberKind::I64
        end
      end
      raise_syntax_error("invalid int suffix")
    when 'u'
      case next_char
      when '8' then return NumberKind::U8
      when '1'
        case next_char
        when '2'
          if next_char == '8'
            return NumberKind::U128
          end
        when '6'
          return NumberKind::U16
        end
      when '3'
        if next_char == '2'
          return NumberKind::U32
        end
      when '6'
        if next_char == '4'
          return NumberKind::U64
        end
      end
      raise_syntax_error("invalid uint suffix")
    when 'f'
      case next_char
      when '3'
        if next_char == '2'
          return NumberKind::F32
        end
      when '6'
        if next_char == '4'
          return NumberKind::F64
        end
      end
      raise_syntax_error("invalid float suffix")
    end
    raise_syntax_error("invalid number suffix")
  end

  private def consume_symbol
    case current_char
    when ':'
      next_char(TokenKind::OP_COLON_COLON)
    when '+' then next_char_and_symbol("+")
    when '-' then next_char_and_symbol("-")
    when '*'
      if next_char == '*'
        next_char_and_symbol("**")
      else
        symbol("*")
      end
    when '/'
      case next_char
      when '/' then next_char_and_symbol("//")
      else          symbol("/")
      end
    when '='
      case next_char
      when '='
        if next_char == '='
          next_char_and_symbol("===")
        else
          symbol("==")
        end
      when '~' then next_char_and_symbol("=~")
      else          unknown_token
      end
    when '!'
      case next_char
      when '=' then next_char_and_symbol("!=")
      when '~' then next_char_and_symbol("!~")
      else          symbol("!")
      end
    when '<'
      case next_char
      when '='
        if next_char == '>'
          next_char_and_symbol("<=>")
        else
          symbol("<=")
        end
      when '<' then next_char_and_symbol("<<")
      else          symbol("<")
      end
    when '>'
      case next_char
      when '=' then next_char_and_symbol(">=")
      when '>' then next_char_and_symbol(">>")
      else          symbol(">")
      end
    when '&'
      case next_char
      when '+' then next_char_and_symbol("&+")
      when '-' then next_char_and_symbol("&--")
      when '*'
        case next_char
        when '*' then next_char_and_symbol("&**")
        else          symbol("&*")
        end
      else symbol("&")
      end
    when '|' then next_char_and_symbol("|")
    when '^' then next_char_and_symbol("^")
    when '~' then next_char_and_symbol("~")
    when '%' then next_char_and_symbol("%")
    when '['
      if next_char == ']'
        case next_char
        when '=' then next_char_and_symbol("[]=")
        when '?' then next_char_and_symbol("[]?")
        else          symbol("[]")
        end
      else
        unknown_token
      end
    when '"'
      scan_quoted_symbol
    else
      if Lexer.ident_start?(current_char)
        sym_start = current_pos
        while Lexer.ident_part?(next_char)
        end
        if current_char == '?' || ((current_char == '!' || current_char == '=') && peek_next_char != '=')
          next_char
        end
        @token.type = TokenKind::SYMBOL
        @token.value = string_range_from_pool(sym_start)
        set_token_raw_from_start(sym_start - 1)
      else
        @token.type = TokenKind::OP_COLON
      end
    end
  end

  private def next_char_and_symbol(s : String)
    next_char
    symbol(s)
  end

  private def symbol(s : String)
    @token.type = TokenKind::SYMBOL
    @token.value = s
  end

  private def scan_quoted_symbol
    line = @line_number
    col = @column_number
    sym_start = current_pos + 1
    res = ""
    while true
      char = next_char
      case char
      when '\\'
        case next_char
        when 'a' then res = res + "\a"
        when 'b' then res = res + "\b"
        when 'n' then res = res + "\n"
        when 'r' then res = res + "\r"
        when 't' then res = res + "\t"
        when 'v' then res = res + "\v"
        when 'f' then res = res + "\f"
        when 'e' then res = res + "\e"
        when 'x'
          b = consume_string_hex_escape
          res = res + b.unsafe_chr.to_s
        when 'u'
          res = res + consume_string_unicode_escape
        when '0'..'7'
          b = consume_octal_escape(current_char)
          res = res + b.unsafe_chr.to_s
        when '\n'
          incr_line_number(1)
          res = res + "\n"
        when '\0'
          raise_syntax_error("unterminated quoted symbol", line, col)
        else
          res = res + current_char.to_s
        end
      when '"'
        break
      when '\0'
        raise_syntax_error("unterminated quoted symbol", line, col)
      else
        res = res + char.to_s
      end
    end

    @token.type = TokenKind::SYMBOL
    @token.value = res
    next_char
    set_token_raw_from_start(sym_start - 2)
  end

  private def delimited_pair(kind : DelimiterKind, nest : String, the_end : String, start_pos : Int32, allow_escapes : Bool = true)
    @token.type = TokenKind::DELIMITER_START
    @token.delimiter_state = DelimiterState.new(kind, nest, the_end, 0, 0, allow_escapes)
    set_token_raw_from_start(start_pos)
  end

  def delimiter_state_for_percent_literal : DelimiterState?
    char = next_char
    del_kind = case char
               when 'i'                     then DelimiterKind::SYMBOL_ARRAY
               when 'r'                     then DelimiterKind::REGEX
               when 'w', 'W'                then DelimiterKind::STRING_ARRAY
               when 'x'                     then DelimiterKind::COMMAND
               when 'q', 'Q'                then DelimiterKind::STRING
               when '(', '[', '{', '<', '|' then DelimiterKind::STRING
               else                              return nil
               end

    has_open = char == '(' || char == '<' || char == '[' || char == '{' || char == '|'
    unless has_open
      n_ch = next_char
      unless n_ch == '(' || n_ch == '<' || n_ch == '[' || n_ch == '{' || n_ch == '|'
        return nil
      end
    end

    open_c = current_char.to_s
    close_c = closing_char(current_char).to_s
    escapes = !(char == 'q' || char == 'w' || char == 'i')
    DelimiterState.new(del_kind, open_c, close_c, 0, 0, escapes)
  end

  def lookahead(&block : -> DelimiterState?) : DelimiterState?
    old_pos = @pos
    old_line = @line_number
    old_column = @column_number
    res = yield
    if res.nil?
      @pos = old_pos
      @line_number = old_line
      @column_number = old_column
    end
    res
  end

  private def consume_heredoc_start(start_pos : Int32)
    has_single_quote = false
    found_closing_single_quote = false

    if next_char == '\''
      has_single_quote = true
      next_char
    end

    unless Lexer.ident_start?(current_char)
      raise_syntax_error("heredoc identifier starts with invalid character")
    end

    start_here = current_pos
    end_here = 0

    while true
      char = next_char
      case char
      when '\r'
        if peek_next_char == '\n'
          end_here = current_pos
          next_char
          break
        else
          raise_syntax_error("expecting '\\n' after '\\r'")
        end
      when '\n'
        end_here = current_pos
        break
      when '\0'
        raise_syntax_error("Unexpected EOF on heredoc identifier")
      when '\''
        if has_single_quote
          found_closing_single_quote = true
          end_here = current_pos
          char = next_char
          if char == '\0'
            raise_syntax_error("Unexpected EOF on heredoc identifier")
          end
          break
        end
      else
        if Lexer.ident_part?(char)
          # valid identifier char
        else
          end_here = current_pos
          break
        end
      end
    end

    if has_single_quote && !found_closing_single_quote
      raise_syntax_error("expecting closing single quote")
    end

    here = string_range(start_here, end_here)
    delimited_pair(DelimiterKind::HEREDOC, here, here, start_pos, allow_escapes: !has_single_quote)
  end

  def next_string_token(delimiter_state : DelimiterState) : Token
    reset_token
    @token.line_number = @line_number
    @token.delimiter_state = delimiter_state

    start_pos = current_pos
    str_end = delimiter_state.the_end
    str_nest = delimiter_state.nest
    open_count = delimiter_state.open_count

    case ch = current_char
    when '\0'
      raise_unterminated_quoted(delimiter_state)
    when str_end[0]
      # Check if multi-char delimiter (heredoc)
      if str_end.bytesize > 1
        if matches_string?(str_end)
          advance_bytes(str_end.bytesize)
          if open_count == 0
            @token.type = delimiter_state.kind.array? ? TokenKind::STRING_ARRAY_END : TokenKind::DELIMITER_END
          else
            @token.type = TokenKind::STRING
            @token.value = str_end
            @token.delimiter_state = delimiter_state.with_open_count_delta(-1)
          end
          set_token_raw_from_start(start_pos)
          return @token
        end
      else
        next_char
        if open_count == 0
          @token.type = delimiter_state.kind.array? ? TokenKind::STRING_ARRAY_END : TokenKind::DELIMITER_END
        else
          @token.type = TokenKind::STRING
          @token.value = str_end
          @token.delimiter_state = delimiter_state.with_open_count_delta(-1)
        end
        set_token_raw_from_start(start_pos)
        return @token
      end
    end

    if str_nest.bytesize == 1 && ch == str_nest[0] && str_nest != str_end
      next_char(TokenKind::STRING)
      @token.value = str_nest
      @token.delimiter_state = delimiter_state.with_open_count_delta(1)
      set_token_raw_from_start(start_pos)
      return @token
    end

    case ch
    when '\\'
      if delimiter_state.allow_escapes
        if delimiter_state.kind == DelimiterKind::REGEX
          char = next_char
          if char == '\0'
            raise_unterminated_quoted(delimiter_state)
          end
          next_char(TokenKind::STRING)
          if char == '/' || char.ascii_whitespace?
            @token.value = char.to_s
          else
            @token.value = "\\" + char.to_s
          end
        else
          case char = next_char
          when '\\'
            string_token_escape_value("\\")
          when str_end[0]
            string_token_escape_value(str_end)
          when str_nest[0]
            string_token_escape_value(str_nest)
          when '#'
            string_token_escape_value("#")
          when 'a'
            string_token_escape_value("\a")
          when 'b'
            string_token_escape_value("\b")
          when 'n'
            string_token_escape_value("\n")
          when 'r'
            string_token_escape_value("\r")
          when 't'
            string_token_escape_value("\t")
          when 'v'
            string_token_escape_value("\v")
          when 'f'
            string_token_escape_value("\f")
          when 'e'
            string_token_escape_value("\e")
          when 'x'
            b = consume_string_hex_escape
            next_char(TokenKind::STRING)
            @token.value = b.unsafe_chr.to_s
          when 'u'
            u = consume_string_unicode_escape
            next_char(TokenKind::STRING)
            @token.value = u
          when '0'..'7'
            b = consume_octal_escape(current_char)
            next_char(TokenKind::STRING)
            @token.value = b.unsafe_chr.to_s
          when '\r', '\n'
            handle_slash_r_slash_n_or_slash_n
            incr_line_number(1)
            @token.line_number = @line_number
            # Skip whitespace until next non-whitespace char
            while true
              char = next_char
              case char
              when '\0'
                raise_unterminated_quoted(delimiter_state)
              when '\n'
                incr_line_number(1)
                @token.line_number = @line_number
              else
                if char.ascii_whitespace?
                  # continue
                else
                  break
                end
              end
            end
            return next_string_token(delimiter_state)
          when '\0'
            raise_unterminated_quoted(delimiter_state)
          else
            @token.type = TokenKind::STRING
            @token.value = current_char.to_s
            unless delimiter_state.kind.array? && char.ascii_whitespace?
              @token.invalid_escape = true
            end
            next_char
          end
        end
      elsif delimiter_state.kind.array?
        case char = next_char
        when '\\', ' ', '\t', '\r', '\n', str_end[0], str_nest[0]
          string_token_escape_value(char.to_s)
        else
          next_char
          @token.type = TokenKind::STRING
          @token.value = string_range(start_pos)
          @token.invalid_escape = true
        end
      else
        @token.type = TokenKind::STRING
        @token.value = current_char.to_s
        next_char
      end
    when '#'
      if delimiter_state.allow_escapes
        if peek_next_char == '{'
          next_char
          next_char(TokenKind::INTERPOLATION_START)
        else
          next_char(TokenKind::STRING)
          @token.value = "#"
        end
      else
        next_char(TokenKind::STRING)
        @token.value = "#"
      end
    when '\r', '\n'
      is_slash_r = handle_slash_r_slash_n_or_slash_n
      next_char
      incr_line_number(1)
      @token.line_number = @line_number
      @token.column_number = @column_number

      if delimiter_state.kind == DelimiterKind::HEREDOC
        if check_heredoc_end(delimiter_state)
          # heredoc ended
        else
          next_string_token_noescape(delimiter_state)
          @token.value = string_range(start_pos)
        end
      elsif delimiter_state.kind.array?
        @token.type = TokenKind::SPACE
      else
        @token.type = TokenKind::STRING
        @token.value = is_slash_r ? "\r\n" : "\n"
      end
    else
      if delimiter_state.kind.array?
        if ch.ascii_whitespace?
          while current_char.ascii_whitespace?
            if current_char == '\n'
              incr_line_number(1)
            end
            next_char
          end
          @token.line_number = @line_number
          @token.column_number = @column_number
          @token.type = TokenKind::SPACE
        else
          next_string_array_token_noescape(delimiter_state)
          @token.value = string_range(start_pos)
        end
      else
        next_string_token_noescape(delimiter_state)
        @token.value = string_range(start_pos)
      end
    end

    set_token_raw_from_start(start_pos)
    @token
  end

  private def string_token_escape_value(val : String)
    next_char(TokenKind::STRING)
    @token.value = val
  end

  private def matches_string?(s : String) : Bool
    return false if @pos + s.bytesize > @source.bytesize
    i = 0
    ptr = @source.to_unsafe + @pos
    s_ptr = s.to_unsafe
    while i < s.bytesize
      return false if ptr[i] != s_ptr[i]
      i = i + 1
    end
    true
  end

  private def advance_bytes(n : Int32)
    i = 0
    while i < n
      next_char
      i = i + 1
    end
  end

  def next_string_token_noescape(delimiter_state : DelimiterState)
    str_end = delimiter_state.the_end
    str_nest = delimiter_state.nest

    while current_char != '\0' && current_char != '\\' && current_char != '#' && current_char != '\n' && current_char != '\r'
      if str_end.bytesize == 1 && current_char == str_end[0]
        break
      elsif str_nest.bytesize == 1 && current_char == str_nest[0]
        break
      elsif str_end.bytesize > 1 && matches_string?(str_end)
        break
      end
      next_char
    end
    @token.type = TokenKind::STRING
  end

  def next_string_array_token_noescape(delimiter_state : DelimiterState)
    str_end = delimiter_state.the_end
    str_nest = delimiter_state.nest

    while current_char != '\0' && current_char != '\\' && current_char != '#' && !current_char.ascii_whitespace?
      if str_end.bytesize == 1 && current_char == str_end[0]
        break
      elsif str_nest.bytesize == 1 && current_char == str_nest[0]
        break
      elsif str_end.bytesize > 1 && matches_string?(str_end)
        break
      end
      next_char
    end
    @token.type = TokenKind::STRING
  end

  private def check_heredoc_end(delimiter_state : DelimiterState) : Bool
    # Skip leading whitespace on line
    save_pos = @pos
    save_col = @column_number
    while current_char == ' ' || current_char == '\t'
      next_char
    end
    str_end = delimiter_state.the_end
    if matches_string?(str_end)
      advance_bytes(str_end.bytesize)
      if current_char == '\n' || current_char == '\r' || current_char == '\0'
        @token.type = TokenKind::DELIMITER_END
        return true
      end
    end
    @pos = save_pos
    @column_number = save_col
    false
  end

  def skip_macro_whitespace : Nil
    while current_char.ascii_whitespace?
      if current_char == '\n'
        incr_line_number(1)
      end
      next_char
    end
  end

  def check_macro_skip_whitespace : Bool
    if current_char == '\\' && peek_next_char.ascii_whitespace?
      next_char
      true
    else
      false
    end
  end

  def lookahead_macro_keyword(&block : -> MacroKeywordState?) : MacroKeywordState?
    old_pos = @pos
    old_line = @line_number
    old_column = @column_number
    res = yield
    if res.nil?
      @pos = old_pos
      @line_number = old_line
      @column_number = old_column
    end
    res
  end

  def macro_starts_with_keyword?(beginning_of_line : Bool) : MacroKeywordState?
    case current_char
    when 'a'
      case next_char
      when 'b'
        if char_sequence?('s', 't', 'r', 'a', 'c', 't') && next_char.ascii_whitespace?
          case next_char
          when 'd'
            if char_sequence?('e', 'f') && peek_not_ident_part_or_end_next_char
              return MacroKeywordState::AbstractDef
            end
          when 'c'
            if char_sequence?('l', 'a', 's', 's') && peek_not_ident_part_or_end_next_char
              return MacroKeywordState::Other
            end
          when 's'
            if char_sequence?('t', 'r', 'u', 'c', 't') && peek_not_ident_part_or_end_next_char
              return MacroKeywordState::Other
            end
          end
        end
      when 'n'
        if char_sequence?('n', 'o', 't', 'a', 't', 'i', 'o', 'n') && peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      end
    when 'b'
      if char_sequence?('e', 'g', 'i', 'n') && peek_not_ident_part_or_end_next_char
        return MacroKeywordState::Other
      end
    when 'c'
      case next_char
      when 'a'
        if char_sequence?('s', 'e') && peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      when 'l'
        if char_sequence?('a', 's', 's') && peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      end
    when 'd'
      case next_char
      when 'o'
        if peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      when 'e'
        if next_char == 'f' && peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      end
    when 'f'
      if char_sequence?('u', 'n') && peek_not_ident_part_or_end_next_char
        return MacroKeywordState::Other
      end
    when 'i'
      if beginning_of_line && next_char == 'f' && peek_not_ident_part_or_end_next_char
        return MacroKeywordState::Other
      end
    when 'l'
      if char_sequence?('i', 'b') && peek_not_ident_part_or_end_next_char
        return MacroKeywordState::Other
      end
    when 'm'
      case next_char
      when 'a'
        if char_sequence?('c', 'r', 'o') && peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      when 'o'
        if char_sequence?('d', 'u', 'l', 'e') && peek_not_ident_part_or_end_next_char
          return MacroKeywordState::Other
        end
      end
    when 's'
      case next_char
      when 'e'
        if char_sequence?('l', 'e', 'c', 't') && !ident_part_or_end?(peek_next_char)
          next_char
          return MacroKeywordState::Other
        end
      when 't'
        if char_sequence?('r', 'u', 'c', 't') && !ident_part_or_end?(peek_next_char)
          next_char
          return MacroKeywordState::Other
        end
      end
    when 'u'
      if next_char == 'n'
        case next_char
        when 'i'
          if char_sequence?('o', 'n') && peek_not_ident_part_or_end_next_char
            return MacroKeywordState::Other
          end
        when 'l'
          if beginning_of_line && char_sequence?('e', 's', 's') && peek_not_ident_part_or_end_next_char
            return MacroKeywordState::Other
          end
        when 't'
          if beginning_of_line && char_sequence?('i', 'l') && peek_not_ident_part_or_end_next_char
            return MacroKeywordState::Other
          end
        end
      end
    when 'w'
      if beginning_of_line && char_sequence?('h', 'i', 'l', 'e') && peek_not_ident_part_or_end_next_char
        return MacroKeywordState::Other
      end
    end
    nil
  end

  def next_macro_token(macro_state : MacroState, skip_whitespace : Bool = false) : Token
    reset_token
    nest = macro_state.nest
    control_nest = macro_state.control_nest
    whitespace = macro_state.whitespace
    delimiter_state = macro_state.delimiter_state
    beginning_of_line = macro_state.beginning_of_line
    comment = macro_state.comment
    yields = false

    if skip_whitespace
      skip_macro_whitespace
    end

    @token.line_number = @line_number
    @token.column_number = @column_number
    start_pos = current_pos

    if current_char == '\0'
      @token.type = TokenKind::EOF
      return @token
    end

    if current_char == '\\' && peek_next_char == '{'
      beginning_of_line = false
      next_char
      start_pos = current_pos
      if next_char == '%'
        char = next_char_check_line
        while char.ascii_whitespace?
          char = next_char_check_line
        end

        case char
        when 'e'
          if char_sequence?('n', 'd') && !ident_part_or_end?(peek_next_char)
            next_char
            nest = nest - 1
          end
        when 'f'
          if char_sequence?('o', 'r') && !ident_part_or_end?(peek_next_char)
            next_char
            nest = nest + 1
          end
        when 'i'
          if next_char == 'f' && !ident_part_or_end?(peek_next_char)
            next_char
            nest = nest + 1
          end
        when 'u'
          if char_sequence?('n', 'l', 'e', 's', 's') && !ident_part_or_end?(peek_next_char)
            next_char
            nest = nest + 1
          end
        end
      end

      @token.type = TokenKind::MACRO_LITERAL
      @token.value = string_range(start_pos)
      @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
      set_token_raw_from_start(start_pos)
      return @token
    end

    if current_char == '\\' && peek_next_char == '%'
      beginning_of_line = false
      next_char
      next_char(TokenKind::MACRO_LITERAL)
      @token.value = "%"
      @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
      @token.raw = "%"
      return @token
    end

    if current_char == '{'
      next_char
      case current_char
      when '{'
        beginning_of_line = false
        next_char(TokenKind::MACRO_EXPRESSION_START)
        @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
        return @token
      when '%'
        beginning_of_line = false
        next_char(TokenKind::MACRO_CONTROL_START)
        @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
        return @token
      end
    end

    if comment || (delimiter_state.nil? && current_char == '#')
      comment = true
      char = current_char
      if current_char == '#'
        char = next_char
      end
      while true
        case char
        when '\n'
          comment = false
          beginning_of_line = true
          whitespace = true
          next_char
          incr_line_number(1)
          @token.line_number = @line_number
          @token.column_number = @column_number
          break
        when '{'
          break
        when '\\'
          if peek_next_char == '{'
            break
          else
            char = next_char
          end
        when '\0'
          raise_syntax_error("unterminated macro")
        else
          char = next_char
        end
      end
      @token.type = TokenKind::MACRO_LITERAL
      @token.value = string_range(start_pos)
      @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
      set_token_raw_from_start(start_pos)
      return @token
    end

    if delimiter_state.nil? && current_char == '%' && Lexer.ident_start?(peek_next_char) && lookahead { delimiter_state_for_percent_literal }.nil?
      char = next_char
      m_start = current_pos
      while Lexer.ident_part?(char)
        char = next_char
      end
      beginning_of_line = false
      @token.type = TokenKind::MACRO_VAR
      @token.value = string_range_from_pool(m_start)
      @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
      return @token
    end

    if delimiter_state.nil? && current_char == 'e'
      if next_char == 'n'
        beginning_of_line = false
        case next_char
        when 'd'
          if whitespace && !ident_part_or_end?(peek_next_char) && peek_next_char != ':'
            if nest == 0 && control_nest == 0
              next_char(TokenKind::MACRO_END)
              @token.macro_state = MacroState.default
              return @token
            else
              nest = nest - 1
              whitespace = current_char.ascii_whitespace?
              next_char
            end
          end
        when 'u'
          if whitespace && next_char == 'm' && !ident_part_or_end?(next_char)
            char = current_char
            nest = nest + 1
            whitespace = true
          end
        end
      else
        whitespace = false
        beginning_of_line = false
      end
    end

    char = current_char
    until char == '{' || char == '\0' ||
          (char == '\\' && (peek_next_char == '{' || peek_next_char == '%')) ||
          (whitespace && delimiter_state.nil? && char == 'e')
      case char
      when '\n'
        incr_line_number(1)
        whitespace = true
        beginning_of_line = true
        char = next_char
        next
      when '\\'
        char = next_char
        if ds = delimiter_state
          if (ds.the_end.bytesize == 1 && ds.the_end.byte_at(0) == char.ord) || ds.the_end == char.to_s
            char = next_char
          elsif char == '\\'
            char = next_char
          end
          whitespace = false
        else
          whitespace = false
        end
        next
      when '\'', '"'
        if ds = delimiter_state
          if (ds.the_end.bytesize == 1 && ds.the_end.byte_at(0) == char.ord) || ds.the_end == char.to_s
            delimiter_state = nil
          end
        else
          delimiter_state = DelimiterState.new(DelimiterKind::STRING, char.to_s, char.to_s)
        end
        whitespace = false
      when '%'
        whitespace = false
        if delimiter_state.nil?
          del_state = lookahead { delimiter_state_for_percent_literal }
          if del_state
            delimiter_state = del_state
          elsif Lexer.ident_start?(peek_next_char)
            break
          end
        end
      when '#'
        if delimiter_state
          whitespace = false
        else
          break
        end
      when '}'
        if ds = delimiter_state
          if ds.the_end == "}"
            if ds.open_count == 0
              delimiter_state = nil
            else
              delimiter_state = ds.with_open_count_delta(-1)
            end
          end
        end
      else
        if ds = delimiter_state
          if (ds.the_end.bytesize == 1 && ds.the_end.byte_at(0) == char.ord) || ds.the_end == char.to_s
            if ds.open_count == 0
              delimiter_state = nil
            else
              delimiter_state = ds.with_open_count_delta(-1)
            end
          elsif (ds.nest.bytesize == 1 && ds.nest.byte_at(0) == char.ord) || ds.nest == char.to_s
            delimiter_state = ds.with_open_count_delta(1)
          end
        elsif whitespace
          kw = lookahead_macro_keyword { macro_starts_with_keyword?(beginning_of_line) }
          if kw
            char = current_char
            if kw != MacroKeywordState::AbstractDef
              nest = nest + 1
            end
            beginning_of_line = false
            next
          end
        end

        if char == '=' && peek_next_char.ascii_whitespace?
          whitespace = false
          beginning_of_line = true
        else
          whitespace = char.ascii_whitespace? || char == ';' || char == '(' || char == '[' || char == '{'
          if beginning_of_line && !whitespace
            beginning_of_line = false
          end
        end
      end
      char = next_char
    end

    @token.type = TokenKind::MACRO_LITERAL
    @token.value = string_range(start_pos)
    @token.macro_state = MacroState.new(whitespace, nest, control_nest, delimiter_state, beginning_of_line, yields, comment, nil)
    set_token_raw_from_start(start_pos)

    @token
  end

  def next_token_skip_space : Token
    next_token
    skip_space
  end

  def skip_space : Token
    while @token.type == TokenKind::SPACE
      next_token
    end
    @token
  end

  def next_token_skip_space_or_newline : Token
    next_token
    skip_space_or_newline
  end

  def skip_space_or_newline : Token
    while @token.type == TokenKind::SPACE || @token.type == TokenKind::NEWLINE
      next_token
    end
    @token
  end

  def next_token_skip_statement_end : Token
    next_token
    skip_statement_end
  end

  def skip_statement_end : Token
    while @token.type == TokenKind::SPACE || @token.type == TokenKind::NEWLINE || @token.type == TokenKind::OP_SEMICOLON
      next_token
    end
    @token
  end

  def next_token_never_a_symbol : Token
    @wants_symbol = false
    t = next_token
    @wants_symbol = true
    t
  end

  private def raise_unterminated_quoted(state : DelimiterState) : NoReturn
    case state.kind
    when DelimiterKind::COMMAND
      raise_syntax_error("Unterminated command")
    when DelimiterKind::REGEX
      raise_syntax_error("Unterminated regular expression")
    when DelimiterKind::HEREDOC
      raise_syntax_error("Unterminated heredoc")
    else
      raise_syntax_error("Unterminated string literal")
    end
  end
end
