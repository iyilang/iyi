; iyi-ir 1
source_filename = "cold_cycle"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external void @raise_error()

define internal void @cold_cycle(i1 %choice, i1 %repeat) {
entry:
  br i1 %choice, label %spin, label %fatal_b
spin:
  br i1 %repeat, label %spin, label %fatal_a
fatal_a:
  call void () @raise_error()
  unreachable
fatal_b:
  call void () @raise_error()
  unreachable
}
