# `Deque`, a double-ended queue over a ring buffer.
#
# A `Deque(T)` adds and removes at both ends in amortised O(1) (`push`,
# `pop`, `shift`, `unshift`), is indexable (`[]`, `[]=`, negative indices
# count from the end), rotates in O(min(n, size - n)), and inserts or
# deletes in the middle by moving the shorter side.
#
# How it is built:
#   * One contiguous `Pointer(T)` of `@capacity` slots; `@start` is the slot
#     of logical element 0, and the elements wrap around the end of the
#     buffer when they reach it.
#   * A push into a full buffer doubles it; if the elements were wrapped at
#     that moment, the shorter of the two runs is moved so the logical order
#     is contiguous again.
#   * A slot vacated by `pop`, `shift`, `delete_at` or `clear` is zeroed, so
#     an object the deque no longer holds is not kept alive by it.
#
# What comes from the traits: `impl Indexable` supplies `[]`, `[]?`,
# `first`, `first?`, `last`, `last?`, `each`, `to_a`, `index`, `join` and
# the rest; `impl IndexableMutable` supplies `swap`, `fill`, `update` and
# `reverse_in_place`; `impl Enumerable` supplies `map`, `select`, `sum` and
# the rest. Only what a ring buffer can do better is written here, and the
# names match `Array`'s: `rotate_in_place` moves this deque, `rotated`
# answers a copy.
#
# What is refused, in the prelude's words: `pop`/`shift`/`first`/`last` of
# an empty deque (`pop of an empty deque`; the `?` forms answer nil), an
# index past the end (`index 5 out of range for 3 elements`), a negative
# count (`negative count: -1`), a negative size or capacity.

module std/deque

import std/indexable::{Indexable, IndexableMutable}
import std/enumerable::{Enumerable}

pub class Deque(T)
  @buffer : Pointer(T)
  @capacity : Int32
  @size : Int32
  @start : Int32

  # An empty deque; the first push allocates.
  def initialize
    @start = 0
    @size = 0
    @capacity = 0
    @buffer = Pointer(T).new(0_u64)
  end

  # An empty deque with room for initial_capacity elements before it grows.
  def initialize(initial_capacity : Int32)
    raise "negative capacity" if initial_capacity < 0
    @start = 0
    @size = 0
    @capacity = initial_capacity
    @buffer = initial_capacity == 0 ? Pointer(T).new(0_u64) : Pointer(T).malloc(initial_capacity.to_u64)
  end

  # size copies of value.
  def initialize(size : Int32, value : T)
    raise "negative size" if size < 0
    @start = 0
    @size = size
    @capacity = size
    @buffer = size == 0 ? Pointer(T).new(0_u64) : Pointer(T).malloc(size.to_u64)
    i = 0
    while i < size
      @buffer[i] = value
      i = i + 1
    end
  end

  # size elements, each what the block answers for its index.
  def self.new(size : Int32, & : Int32 -> T) : Deque(T)
    raise "negative size" if size < 0
    deq = Deque(T).new(size)
    i = 0
    while i < size
      deq.push(yield i)
      i = i + 1
    end
    deq
  end

  # The array's elements, in its order.
  def self.new(items : Array(T)) : Deque(T)
    deq = Deque(T).new(items.size)
    items.each { |x| deq.push(x) }
    deq
  end

  def size : Int32
    @size
  end

  # Slots allocated, live or not.
  def capacity : Int32
    @capacity
  end

  # The element at a logical index, no bounds check; `Indexable#[]` does
  # the checking.
  def unsafe_fetch(index : Int32) : T
    @buffer[slot_of(index)]
  end

  def []=(index : Int32, value : T) : T
    asked = index
    index = @size + index if index < 0
    raise "index #{asked} out of range for #{@size} elements" if index < 0 || index >= @size
    @buffer[slot_of(index)] = value
  end

  # Appends value; answers the deque.
  def push(value : T) : Deque(T)
    ensure_capacity_for(1)
    @buffer[slot_of(@size)] = value
    @size = @size + 1
    self
  end

  def <<(value : T) : Deque(T)
    push(value)
  end

  # Removes and answers the last element.
  def pop : T
    raise "pop of an empty deque" if @size == 0
    @size = @size - 1
    slot = slot_of(@size)
    value = @buffer[slot]
    clear_slot(slot)
    value
  end

  def pop? : T?
    @size == 0 ? nil : pop
  end

  # Removes the last n elements, or all of them when there are fewer.
  def pop(n : Int32) : Nil
    raise "negative count: #{n}" if n < 0
    count = n > @size ? @size : n
    i = 0
    while i < count
      pop
      i = i + 1
    end
  end

  # Prepends value; answers the deque.
  def unshift(value : T) : Deque(T)
    ensure_capacity_for(1)
    @start = @start - 1
    @start = @start + @capacity if @start < 0
    @buffer[@start] = value
    @size = @size + 1
    self
  end

  # Removes and answers the first element.
  def shift : T
    raise "shift of an empty deque" if @size == 0
    value = @buffer[@start]
    clear_slot(@start)
    @size = @size - 1
    @start = @start + 1
    @start = @start - @capacity if @start >= @capacity
    value
  end

  def shift? : T?
    @size == 0 ? nil : shift
  end

  # Removes the first n elements, or all of them when there are fewer.
  def shift(n : Int32) : Nil
    raise "negative count: #{n}" if n < 0
    count = n > @size ? @size : n
    i = 0
    while i < count
      shift
      i = i + 1
    end
  end

  # Rotates in place so that the element at position n comes first; a
  # negative n rotates the other way. A full buffer only moves `@start`;
  # otherwise the shorter end is walked around.
  def rotate_in_place(n : Int32 = 1) : Deque(T)
    return self if @size <= 1
    steps = n % @size
    steps = steps + @size if steps < 0
    return self if steps == 0

    if @size == @capacity
      @start = (@start + steps) % @capacity
    elsif steps <= @size // 2
      i = 0
      while i < steps
        push(shift)
        i = i + 1
      end
    else
      rem = @size - steps
      i = 0
      while i < rem
        unshift(pop)
        i = i + 1
      end
    end
    self
  end

  # A copy rotated by n, this deque untouched.
  def rotated(n : Int32 = 1) : Deque(T)
    copy = dup
    copy.rotate_in_place(n)
    copy
  end

  # Inserts value before index; `size` appends, `-1` appends too (the
  # position after the last). The shorter side moves.
  def insert(index : Int32, value : T) : Deque(T)
    asked = index
    index = @size + 1 + index if index < 0
    raise "index #{asked} out of range for #{@size} elements" if index < 0 || index > @size
    return unshift(value) if index == 0
    return push(value) if index == @size

    ensure_capacity_for(1)
    rindex = slot_of(index)

    if index > @size // 2
      # Elements from index to the end move one slot right.
      dst = slot_of(@size)
      loop do
        src = dst - 1
        src = src + @capacity if src < 0
        @buffer[dst] = @buffer[src]
        break if src == rindex
        dst = src
      end
    else
      # Elements before index move one slot left.
      @start = @start - 1
      @start = @start + @capacity if @start < 0
      rindex = rindex - 1
      rindex = rindex + @capacity if rindex < 0
      dst = @start
      loop do
        src = dst + 1
        src = src - @capacity if src >= @capacity
        @buffer[dst] = @buffer[src]
        break if src == rindex
        dst = src
      end
    end

    @buffer[rindex] = value
    @size = @size + 1
    self
  end

  # Removes and answers the element at index; the shorter side closes
  # the gap.
  def delete_at(index : Int32) : T
    asked = index
    index = @size + index if index < 0
    raise "index #{asked} out of range for #{@size} elements" if index < 0 || index >= @size
    return shift if index == 0
    return pop if index == @size - 1

    rindex = slot_of(index)
    value = @buffer[rindex]

    if index > @size // 2
      # Elements after index move one slot left; the last slot is vacated.
      dst = rindex
      finish = slot_of(@size - 1)
      loop do
        src = dst + 1
        src = src - @capacity if src >= @capacity
        @buffer[dst] = @buffer[src]
        break if src == finish
        dst = src
      end
      clear_slot(finish)
    else
      # Elements before index move one slot right; the first slot is vacated.
      dst = rindex
      finish = @start
      @start = @start + 1
      @start = @start - @capacity if @start >= @capacity
      loop do
        src = dst - 1
        src = src + @capacity if src < 0
        @buffer[dst] = @buffer[src]
        break if src == finish
        dst = src
      end
      clear_slot(finish)
    end

    @size = @size - 1
    value
  end

  # Appends every element of other; answers the deque.
  def concat(other : Deque(T)) : Deque(T)
    i = 0
    while i < other.size
      push(other.unsafe_fetch(i))
      i = i + 1
    end
    self
  end

  def concat(items : Array(T)) : Deque(T)
    items.each { |x| push(x) }
    self
  end

  # A new deque: this one's elements, then other's.
  def +(other : Deque(T)) : Deque(T)
    copy = dup
    copy.concat(other)
    copy
  end

  # Forgets every element; the capacity stays.
  def clear : Deque(T)
    while @size > 0
      pop
    end
    @start = 0
    self
  end

  # A copy with the same elements, contiguous from slot 0.
  def dup : Deque(T)
    copy = Deque(T).new(@size)
    i = 0
    while i < @size
      copy.push(unsafe_fetch(i))
      i = i + 1
    end
    copy
  end

  # The same elements in the same order.
  def ==(other : Deque(T)) : Bool
    return false unless @size == other.size
    i = 0
    while i < @size
      return false unless unsafe_fetch(i) == other.unsafe_fetch(i)
      i = i + 1
    end
    true
  end

  # `Deque{1, 2, 3}`, elements inspected.
  def to_s : String
    parts = [] of String
    each { |value| parts << value.inspect }
    "Deque{" + parts.join(", ") + "}"
  end

  def inspect : String
    to_s
  end

  # The buffer slot of a logical index.
  private def slot_of(index : Int32) : Int32
    slot = @start + index
    slot = slot - @capacity if slot >= @capacity
    slot
  end

  # Zeroes a slot the deque no longer holds, so a reference that was there
  # is no longer reachable through this buffer.
  private def clear_slot(slot : Int32) : Nil
    bytes = Pointer(UInt8).new(@buffer.address + slot.to_u64 * sizeof(T).to_u64)
    i = 0
    while i < sizeof(T)
      bytes[i] = 0_u8
      i = i + 1
    end
  end

  private def ensure_capacity_for(count : Int32) : Nil
    return if @size + count <= @capacity
    new_cap = @capacity == 0 ? 4 : @capacity * 2
    while new_cap < @size + count
      new_cap = new_cap * 2
    end
    resize_to(new_cap)
  end

  # Doubles the buffer. If the elements were wrapped, the shorter of the
  # two runs is moved so the logical order is contiguous again.
  private def resize_to(new_cap : Int32) : Nil
    old_cap = @capacity
    @capacity = new_cap
    if old_cap == 0
      @buffer = Pointer(T).malloc(new_cap.to_u64)
      return
    end

    @buffer = @buffer.realloc(new_cap.to_u64)
    finish = @start + @size
    return if finish <= old_cap

    wrapped_count = finish - old_cap
    head_count = old_cap - @start
    if head_count >= wrapped_count
      # The wrapped tail follows the head at old_cap.
      i = 0
      while i < wrapped_count
        @buffer[old_cap + i] = @buffer[i]
        clear_slot(i)
        i = i + 1
      end
    else
      # The head moves to the end of the new buffer, just before the tail.
      new_start = new_cap - head_count
      i = 0
      while i < head_count
        @buffer[new_start + i] = @buffer[@start + i]
        clear_slot(@start + i)
        i = i + 1
      end
      @start = new_start
    end
  end
end

impl Indexable for Deque(T) forall T
  type Elem = T
end

impl IndexableMutable for Deque(T) forall T
  type Elem = T

  def unsafe_put(index : Int32, value : T) : T
    @buffer[slot_of(index)] = value
  end
end

impl Enumerable for Deque(T) forall T
  type Elem = T
end
