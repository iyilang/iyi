# Exercises SPEC.md III.4 concurrency runtime on Windows x86_64, Linux, and Darwin.
#
# Properties asserted:
# 1. Genuine task interleaving across channels in a group (ping-pong order).
# 2. Overlapping waits (anti-sequential clock).
# 3. Cancellation reaching a task blocked in sleep.
# 4. Error unwrap `!` draining a cancelled task through later waits.
# 5. Poller: a read parks the fiber, and another fiber wakes it by writing.
# 6. Cancellation reaching a task blocked in IO (CancelIoEx on Windows).
# 7. Channel close waking parked receivers with ChannelClosed.
# 8. Task joining and value propagation via task.value.
# 9. Deferred join on early return out of group block.
# 10. Rendezvous send parking until received, and receiver completing send.
# 11. FIFO order of parked rendezvous sends.
# 12. Cancelled rendezvous send dying undelivered.
# 13. Channel close failing parked senders.
# 14. Select taking ready arm, parked send arm winning, select with else.
# 15. Typed group returning tuple on success and error on failure.
# 16. Dynamic group keeping general form.

def read_teb_tls_slot : UInt64
  slot = uninitialized UInt64
  {% if flag?(:win32) && flag?(:x86_64) %}
    asm("movq %gs:0x58, $0" : "=r"(slot) ::: "volatile")
  {% else %}
    slot = 0_u64
  {% end %}
  slot
end

def log_msg(msg : String) : Nil
  __iyi_write(1, msg.to_unsafe.as(Void*), msg.size.to_u64)
end

def fail(message : String) : Nil
  log_msg("FAIL: " + message + "\n")
  __iyi_exit(1)
end

def elapsed_ms(since : Int64) : Int64
  (__iyi_monotonic_ns - since) // 1000000_i64
end

{% if flag?(:darwin) %}
  lib LibC
    fun pipe(fds : Int32*) : Int32
  end

  def make_pipe : Pointer(Int64)
    raw_fds = Pointer(UInt8).malloc(8_u64).as(Pointer(Int32))
    fail("pipe failed") if LibC.pipe(raw_fds) < 0
    fds = Pointer(UInt8).malloc(16_u64).as(Pointer(Int64))
    fds[0] = raw_fds[0].to_i64
    fds[1] = raw_fds[1].to_i64
    fds
  end
{% elsif flag?(:win32) %}
  # The prelude's `LibC` carries only the wide `CreateFileW` now: a path a
  # program hands iyi is UTF-8, and Windows' narrow entry points cannot
  # take it. A pipe name is this exercise's own ASCII literal, so it
  # declares the narrow call it wants instead of widening one.
  lib LibC
    fun CreateFileA(name : UInt8*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
  end

  def make_pipe : Pointer(Int64)
    pipe_name = "\\\\.\\pipe\\iyi_runtime_pipe_#{__iyi_monotonic_ns}".to_unsafe
    h_read = LibC.CreateNamedPipeA(pipe_name, 0x40000001_i32, 0_i32, 1_i32, 4096_i32, 4096_i32, 0_i32, Pointer(Void).new(0_u64))
    fail("CreateNamedPipeA failed") if h_read.address &+ 1_u64 == 0_u64
    h_write = LibC.CreateFileA(pipe_name, 1073741824_i32, 0_i32, Pointer(Void).new(0_u64), 3_i32, 128_i32, Pointer(Void).new(0_u64))
    fail("CreateFileA for pipe failed") if h_write.address &+ 1_u64 == 0_u64
    fds = Pointer(UInt8).malloc(16_u64).as(Pointer(Int64))
    fds[0] = h_read.address.to_i64
    fds[1] = h_write.address.to_i64
    fds
  end
{% else %}
  {% if flag?(:x86_64) %}
    EX_SYS_PIPE2 = 293_i64
  {% else %}
    EX_SYS_PIPE2 = 59_i64
  {% end %}

  def make_pipe : Pointer(Int64)
    raw_fds = Pointer(UInt8).malloc(8_u64).as(Pointer(Int32))
    result = __iyi_conc_syscall3(EX_SYS_PIPE2, raw_fds.address.to_i64, 0_i64, 0_i64)
    fail("pipe2 failed") if result < 0
    fds = Pointer(UInt8).malloc(16_u64).as(Pointer(Int64))
    fds[0] = raw_fds[0].to_i64
    fds[1] = raw_fds[1].to_i64
    fds
  end
{% end %}

pub struct TaskFailed
  def initialize
  end
end

impl Error for TaskFailed
  def message : String
    "the failing task's error"
  end
end

# 1. Genuine task interleaving
slot0 = read_teb_tls_slot
log_msg("main teb_tls_slot: ")
log_msg(slot0 == 0_u64 ? "null\n" : "non-null\n")

log_msg("step 1: interleaving\n")
ping = Channel(Int32).new(1)
pong = Channel(Int32).new(1)
order = ""

group do |g|
  g.spawn do
    slot_fiber = read_teb_tls_slot
    log_msg("fiber teb_tls_slot: ")
    log_msg(slot_fiber == 0_u64 ? "null\n" : "non-null\n")

    round = 0
    while round < 3
      ping.receive
      order = order + "a"
      pong.send(1)
      round = round + 1
    end
    0
  end
  g.spawn do
    round = 0
    while round < 3
      order = order + "b"
      ping.send(1)
      pong.receive
      round = round + 1
    end
    0
  end
end

fail("interleaving: expected bababa, got #{order}") unless order == "bababa"
log_msg("interleaved: " + order + "\n")

# 2. Overlapping waits: anti-sequential clock
log_msg("step 2: overlapping sleeps\n")
started = __iyi_monotonic_ns
group do |g|
  g.spawn do
    sleep(150)
  end
  g.spawn do
    sleep(150)
  end
end
overlap = elapsed_ms(started)
fail("overlap: 2 x 150 ms took #{overlap} ms, which is sequential") if overlap >= 260
log_msg("two 150 ms sleeps in #{overlap} ms\n")

# 3. Failing task cancels sibling blocked in sleep
log_msg("step 3: sleep cancellation\n")
started = __iyi_monotonic_ns
victim_saw = ""
group do |g|
  victim = g.spawn do
    slept = sleep(10000)
    victim_saw = slept.is_a?(Cancelled) ? "cancelled" : "slept"
    slept
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
cancelled_after = elapsed_ms(started)
fail("cancellation never reached the sleeping task") unless victim_saw == "cancelled"
fail("cancellation took #{cancelled_after} ms against a 10 s sleep") if cancelled_after >= 5000
log_msg("a failing task cancelled a sibling blocked in sleep, in #{cancelled_after} ms\n")

# 4. Error unwrap `!` drains a cancelled task
log_msg("step 4: drain through !\n")

def two_naps : Nil | Cancelled
  sleep(10000)!
  sleep(10000)!
  nil
end

started = __iyi_monotonic_ns
drained = ""
group do |g|
  g.spawn do
    outcome = two_naps
    drained = outcome.is_a?(Cancelled) ? "propagated" : "finished"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("`!` did not propagate Cancelled out of the task body") unless drained == "propagated"
fail("draining a cancelled task took #{elapsed_ms(started)} ms") if elapsed_ms(started) >= 5000
log_msg("a cancelled task drained through `!`\n")

# 5. Poller: a read parks the fiber, and another fiber wakes it by writing
log_msg("step 5: poller read/write\n")
fds = make_pipe
read_fd = fds[0]
write_fd = fds[1]
io_order = ""

group do |g|
  g.spawn do
    io_order = io_order + "parked,"
    buffer = Pointer(UInt8).malloc(1_u64)
    got = iyi_read(read_fd, buffer.as(Void*), 1_u64)
    case got
    in Int64
      io_order = io_order + "read:#{buffer.value.to_i64}"
    in Cancelled
      io_order = io_order + "cancelled"
    end
    0
  end
  g.spawn do
    sleep(40)
    io_order = io_order + "wrote,"
    byte = Pointer(UInt8).malloc(1_u64)
    byte.value = 7_u8
    __iyi_write(write_fd, byte.as(Void*), 1_u64)
    0
  end
end

fail("poller: expected parked,wrote,read:7 got #{io_order}") unless io_order == "parked,wrote,read:7"
log_msg("a read parked in the poller and a sleeping writer woke it\n")

# 6. Cancellation reaching a task blocked in IO (CancelIoEx on Windows)
log_msg("step 6: IO cancellation\n")
io_pipe = make_pipe
io_read_fd = io_pipe[0]
io_victim_saw = ""
started = __iyi_monotonic_ns

group do |g|
  g.spawn do
    buf = Pointer(UInt8).malloc(1_u64)
    outcome = iyi_read(io_read_fd, buf.as(Void*), 1_u64)
    io_victim_saw = outcome.is_a?(Cancelled) ? "cancelled" : "read"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end

io_cancelled_after = elapsed_ms(started)
fail("cancellation never reached the IO-blocked task: #{io_victim_saw}") unless io_victim_saw == "cancelled"
fail("cancellation of IO took #{io_cancelled_after} ms") if io_cancelled_after >= 5000
log_msg("a failing task cancelled a sibling blocked in IO, in #{io_cancelled_after} ms\n")

# 7. Channel close waking parked receivers with ChannelClosed
log_msg("step 7: channel close\n")
late = Channel(Int32).new(1)
closed_saw = ""
group do |g|
  g.spawn do
    value = late.receive
    closed_saw = value.is_a?(ChannelClosed) ? "closed" : "value"
    0
  end
  g.spawn do
    sleep(20)
    late.close
    0
  end
end
fail("close did not wake the parked receiver with ChannelClosed") unless closed_saw == "closed"
log_msg("close woke a parked receiver with ChannelClosed\n")

# 8. task.value joins and answers what block returned
log_msg("step 8: task.value\n")
doubled = 0
group do |g|
  t = g.spawn do
    sleep(10)
    21
  end
  value = t.value
  doubled = value.is_a?(Int32) ? value * 2 : -1
end
fail("task.value answered #{doubled // 2}") unless doubled == 42
log_msg("task.value joined and answered\n")

# 9. Deferred join on early return out of group block
log_msg("step 9: deferred join\n")

def leaves_early(finished : Pointer(Int32)) : Nil
  group do |g|
    g.spawn do
      sleep(30)
      finished.value = 1
      0
    end
    return
  end
end

flag = Pointer(Int32).malloc(4_u64)
flag.value = 0
leaves_early(flag)
fail("a `return` out of the group block left its task running") unless flag.value == 1
log_msg("an early return still joined the group\n")

# 10. Rendezvous send parks until value is taken, receiver completes send
log_msg("step 10: rendezvous\n")
meet = Channel(Int32).new
meet_order = ""
group do |g|
  g.spawn do
    meet_order = meet_order + "s0,"
    meet.send(11)
    meet_order = meet_order + "s1"
    0
  end
  g.spawn do
    sleep(20)
    meet_order = meet_order + "r,"
    value = meet.receive
    value.is_a?(Int32) ? value : -1
  end
end
fail("rendezvous: expected s0,r,s1 got #{meet_order}") unless meet_order == "s0,r,s1"
log_msg("a rendezvous send parked until its value was taken\n")

meet2 = Channel(Int32).new
got2 = 0
group do |g|
  g.spawn do
    value = meet2.receive
    got2 = value.is_a?(Int32) ? value : -1
    0
  end
  g.spawn do
    sleep(20)
    meet2.send(23)
    0
  end
end
fail("rendezvous: the parked receiver got #{got2}") unless got2 == 23
log_msg("a parked receiver completed a rendezvous send\n")

# 11. FIFO order of parked rendezvous sends
log_msg("step 11: FIFO rendezvous\n")

def spawn_send(g : IyiGroup, fifo : Channel(Int32), n : Int32) : Nil
  g.spawn do
    fifo.send(n)
    0
  end
  nil
end

fifo = Channel(Int32).new
fifo_drained = ""
group do |g|
  index = 1
  while index <= 3
    spawn_send(g, fifo, index)
    index = index + 1
  end
  g.spawn do
    sleep(20)
    round = 0
    while round < 3
      value = fifo.receive
      fifo_drained = fifo_drained + (value.is_a?(Int32) ? value.to_s : "?")
      round = round + 1
    end
    0
  end
end
fail("rendezvous FIFO: expected 123, got #{fifo_drained}") unless fifo_drained == "123"
log_msg("parked sends completed in park order\n")

# 12. Cancelled rendezvous send dies undelivered
log_msg("step 12: cancelled send\n")
lonely = Channel(Int32).new
sender_saw = ""
group do |g|
  g.spawn do
    outcome = lonely.send(99)
    sender_saw = outcome.is_a?(Cancelled) ? "cancelled" : "sent"
    outcome
  end
  g.spawn do
    sleep(20)
    TaskFailed.new
  end
end
fail("a parked sender was not cancelled: #{sender_saw}") unless sender_saw == "cancelled"
lonely.close
received_late = lonely.receive
fail("a cancelled send's value was delivered anyway") if received_late.is_a?(Int32)
log_msg("a cancelled rendezvous send died undelivered\n")

# 13. Channel close failing parked senders
log_msg("step 13: closed send\n")
doomed = Channel(Int32).new
closed_send = ""
group do |g|
  g.spawn do
    outcome = doomed.send(7)
    closed_send = outcome.is_a?(ChannelClosed) ? "refused" : "other"
    0
  end
  g.spawn do
    sleep(20)
    doomed.close
    0
  end
end
fail("close did not fail the parked sender: #{closed_send}") unless closed_send == "refused"
log_msg("close failed a parked sender with ChannelClosed\n")

# 14. Select taking ready arm, parked send arm winning, select with else
log_msg("step 14: select\n")
left = Channel(Int32).new
right = Channel(String).new
picked = ""
group do |g|
  g.spawn do
    sleep(20)
    right.send("hello")
    0
  end
  g.spawn do
    select
    when n = left.receive
      picked = "left"
    when s = right.receive
      picked = s.is_a?(String) ? "right:#{s}" : "right:?"
    end
    0
  end
end
fail("select: expected right:hello, got #{picked}") unless picked == "right:hello"
log_msg("select took the arm that became ready\n")

narrow = Channel(Int32).new
sent_arm = ""
group do |g|
  g.spawn do
    select
    when narrow.send(31)
      sent_arm = "sent"
    when n = Channel(Int32).new(1).receive
      sent_arm = "impossible"
    end
    0
  end
  g.spawn do
    sleep(20)
    value = narrow.receive
    value.is_a?(Int32) ? value : -1
  end
end
fail("select: the parked send arm saw #{sent_arm}") unless sent_arm == "sent"
log_msg("a select's send arm won while parked\n")

idle = Channel(Int32).new
took_else = ""
select
when n = idle.receive
  took_else = "arm"
else
  took_else = "else"
end
fail("select else: got #{took_else}") unless took_else == "else"
log_msg("select with nothing ready took its else\n")

# 15. Typed group
log_msg("step 15: typed group\n")

def fetch_pair(fail_second : Bool) : Tuple(Int32, Int32) | TaskFailed | Cancelled | Panicked
  group do |g|
    x = g.spawn do
      slept = sleep(10)
      slept.is_a?(Cancelled) ? slept : 21
    end
    y = g.spawn do
      slept = sleep(fail_second ? 20 : 10)
      slept.is_a?(Cancelled) ? slept : (fail_second ? TaskFailed.new : 2)
    end
  end!
end

pair = fetch_pair(false)
case pair
in Tuple(Int32, Int32) then fail("typed group: got #{it[0]}, #{it[1]}") unless it[0] == 21 && it[1] == 2
in TaskFailed          then fail("typed group: failed on the success path")
in Cancelled           then fail("typed group: cancelled on the success path")
in Panicked            then fail("typed group: panicked on the success path")
end
log_msg("a typed group answered its tuple\n")

broken = fetch_pair(true)
fail("typed group: the failure did not leave as the error") unless broken.is_a?(TaskFailed)
log_msg("a typed group's first failure left as the error\n")

# 16. Dynamic group keeps general form
log_msg("step 16: dynamic group\n")
drainer = Channel(Int32).new(3)
shape = group do |g|
  index = 0
  while index < 3
    spawn_send(g, drainer, index)
    index = index + 1
  end
end
fail("a loop-spawning group grew a type") unless shape.is_a?(Nil)
round = 0
while round < 3
  drainer.receive
  round = round + 1
end
log_msg("dynamic group kept the general form\n")

log_msg("runtime exercise: every property held\n")
