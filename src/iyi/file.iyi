# Files: `read`/`write` whole, `open` as an `IyiIO`. Paths get the NUL
# the kernel wants; errors panic with the path.

class File
  # Crystal's mode strings: "r", "w", "a", each with a "+" that adds the
  # other direction, and a "b" anywhere after the letter that changes
  # nothing, as POSIX has no text mode. "a" is the kernel's append - every
  # write lands at the end whatever the position says, so two writers
  # appending to one log do not overwrite each other - and not a seek to
  # the end at open. *perm* is the mode a file the open creates gets, less
  # the umask; a file already there keeps its own. *buffer_size* stays
  # third so the callers that pass it by position keep working.
  #
  # One stream reads and writes through two buffers, so between a read and
  # a write in "r+" or "w+" move with `seek` (std/file), as C's stdio asks
  # of `fopen`'s "+" modes: a write after a read otherwise lands past the
  # read-ahead, and a read after a write misses what is still buffered.
  def self.open(path : String, mode : String = "r", buffer_size : Int32 = 4096, perm : Int32 = 0o644) : IyiIO
    flags = open_flags(mode)
    read = flags & 1 != 0
    write = flags & 2 != 0
    create = flags & 4 != 0
    truncate = flags & 8 != 0
    append = flags & 16 != 0
    fd = __iyi_open_file(c_path(path), read, write, create, truncate, append, perm)
    raise "cannot open #{path}" if fd < 0_i64
    IyiIO.new(fd, buffer_size, false)
  end

  def self.open(path : String, mode : String = "r", buffer_size : Int32 = 4096, perm : Int32 = 0o644, & : IyiIO -> Nil) : Nil
    io = open(path, mode, buffer_size, perm)
    defer io.close
    yield io
  end

  # The mode as bits: 1 read, 2 write, 4 create, 8 truncate, 16 append.
  # "b" goes after the letter, before or after the "+", once, as Crystal
  # spells it.
  private def self.open_flags(mode : String) : Int32
    case mode
    when "r", "rb"          then 1
    when "w", "wb"          then 2 | 4 | 8
    when "a", "ab"          then 2 | 4 | 16
    when "r+", "r+b", "rb+" then 1 | 2
    when "w+", "w+b", "wb+" then 1 | 2 | 4 | 8
    when "a+", "a+b", "ab+" then 1 | 2 | 4 | 16
    else
      raise "unsupported mode: #{mode} (the modes are r, w, a, r+, w+ and a+, each with an optional b)"
    end
  end

  def self.read(path : String) : String
    fd = __iyi_open_read(c_path(path))
    if fd < 0_i64
      # POSIX opens a directory and fails at the read, which is where the
      # sentence below comes from. Windows refuses the open itself, so the
      # same diagnosis is made here, or a directory read "cannot read".
      {% if flag?(:win32) %}
        attributes = __iyi_path_attributes(c_path(path))
        if attributes != -1 && attributes & 0x10 != 0 # FILE_ATTRIBUTE_DIRECTORY
          raise "cannot read #{path}: it is a directory, or the read failed"
        end
      {% end %}
      raise "cannot read #{path}"
    end
    io = IyiIO.new(fd, 4096, false)
    defer io.close
    text = io.read_all(size_of(fd))
    raise "cannot read #{path}: it is a directory, or the read failed" if io.read_failed?
    text
  end

  {% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    # The size the file says it has, for `read_all` to read into one string
    # of it; 0 or less where there is no answer - a pipe, a console, a
    # `/proc` file - and the string grows with what comes instead. Here
    # `fstat`, 5 on x86_64 and 80 on aarch64: `st_size` is the seventh word
    # of the struct on both, which is 144 bytes at most.
    @[Effect(:primitive)]; private def self.size_of(fd : Int64) : Int64
      stat = uninitialized Int64[18]
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        asm("syscall" : "={rax}"(result) : "{rax}"(5_i64), "{rdi}"(fd), "{rsi}"(pointerof(stat)) : "rcx", "r11", "memory" : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result) : "{x8}"(80_i64), "{x0}"(fd), "{x1}"(pointerof(stat)) : "memory" : "volatile")
      {% end %}
      result < 0_i64 ? -1_i64 : pointerof(stat).as(Int64*)[6]
    end
  {% elsif flag?(:win32) %}
    lib LibFile
      fun GetFileSizeEx(handle : Void*, size : Int64*) : Int32
    end

    private def self.size_of(fd : Int64) : Int64
      size = 0_i64
      LibFile.GetFileSizeEx(Pointer(Void).new(fd.to_u64), pointerof(size)) == 0 ? -1_i64 : size
    end
  {% else %}
    # No answer, darwin's included: `lseek` or `fstat` there would be a
    # libSystem symbol the floor lists in `bench/` do not name.
    private def self.size_of(fd : Int64) : Int64
      -1_i64
    end
  {% end %}

  def self.write(path : String, contents : String) : Nil
    fd = __iyi_open_write(c_path(path))
    raise "cannot write #{path}" if fd < 0_i64
    io = IyiIO.new(fd, 4096, false)
    defer io.close
    io.write(contents)
    io.flush
  end

  def self.exists?(path : String) : Bool
    {% if flag?(:wasm32) %}
      raise "File.exists? is not available on wasm32-wasi: path_open needs a preopened directory fd"
    {% elsif flag?(:win32) %}
      # Not an open: `CreateFileW` without FILE_FLAG_BACKUP_SEMANTICS
      # cannot open a directory, so opening to answer this said `false`
      # for every directory on Windows where POSIX says `true`. The
      # attributes are the question being asked, and they cost no handle;
      # INVALID_FILE_ATTRIBUTES is the DWORD -1 this file's Int32 spells.
      __iyi_path_attributes(c_path(path)) != -1
    {% else %}
      # O_PATH on Linux: no read right asked, and a FIFO's open does not wait.
      fd = {% if flag?(:linux) %} __iyi_openat(c_path(path), 0x280000, 0) {% else %} __iyi_open_read(c_path(path)) {% end %}
      __iyi_close(fd) if fd >= 0
      fd >= 0
    {% end %}
  end

  def self.delete(path : String) : Nil
    raise "cannot delete #{path}" if __iyi_unlink(c_path(path)) < 0
  end

  private def self.c_path(path : String) : UInt8*
    n = path.byte_index("\u0000") ? raise("path contains a NUL byte") : path.bytesize
    buffer = Pointer(UInt8).malloc((n + 1).to_u64)
    buffer.copy_from(path.to_unsafe, n)
    buffer[n] = 0_u8
    buffer
  end
end
