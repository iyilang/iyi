module compiler/llvm/target

import compiler/llvm/lib_llvm
import compiler/llvm/memory_buffer
using compiler/llvm/lib_llvm::{string_from_c, string_and_dispose, to_c_str}
using compiler/llvm/memory_buffer::{MemoryBuffer}

pub struct Target
  getter unwrap : LibLLVM::TargetRef

  def initialize(@unwrap : LibLLVM::TargetRef)
  end

  def to_unsafe : LibLLVM::TargetRef
    @unwrap
  end

  def self.init_native_target : Nil
    {% if flag?(:aarch64) %}
      init_aarch64
    {% elsif flag?(:i386) || flag?(:x86_64) %}
      init_x86
    {% elsif flag?(:arm) %}
      init_arm
    {% elsif flag?(:wasm32) %}
      init_webassembly
    {% elsif flag?(:riscv32) || flag?(:riscv64) %}
      init_riscv
    {% else %}
      init_aarch64
      init_x86
    {% end %}
  end

  def self.init_all_targets : Nil
    init_aarch64
    init_x86
    init_arm
    init_webassembly
    init_riscv
    init_mips
    init_powerpc
    init_bpf
  end

  def self.init_aarch64 : Nil
    LibLLVM.initialize_aarch64_target_info
    LibLLVM.initialize_aarch64_target
    LibLLVM.initialize_aarch64_target_mc
    LibLLVM.initialize_aarch64_asm_printer
    LibLLVM.initialize_aarch64_asm_parser
  end

  def self.init_x86 : Nil
    LibLLVM.initialize_x86_target_info
    LibLLVM.initialize_x86_target
    LibLLVM.initialize_x86_target_mc
    LibLLVM.initialize_x86_asm_printer
    LibLLVM.initialize_x86_asm_parser
  end

  def self.init_arm : Nil
    LibLLVM.initialize_arm_target_info
    LibLLVM.initialize_arm_target
    LibLLVM.initialize_arm_target_mc
    LibLLVM.initialize_arm_asm_printer
    LibLLVM.initialize_arm_asm_parser
  end

  def self.init_webassembly : Nil
    LibLLVM.initialize_webassembly_target_info
    LibLLVM.initialize_webassembly_target
    LibLLVM.initialize_webassembly_target_mc
    LibLLVM.initialize_webassembly_asm_printer
    LibLLVM.initialize_webassembly_asm_parser
  end

  def self.init_riscv : Nil
    LibLLVM.initialize_riscv_target_info
    LibLLVM.initialize_riscv_target
    LibLLVM.initialize_riscv_target_mc
    LibLLVM.initialize_riscv_asm_printer
    LibLLVM.initialize_riscv_asm_parser
  end

  def self.init_mips : Nil
    LibLLVM.initialize_mips_target_info
    LibLLVM.initialize_mips_target
    LibLLVM.initialize_mips_target_mc
    LibLLVM.initialize_mips_asm_printer
    LibLLVM.initialize_mips_asm_parser
  end

  def self.init_powerpc : Nil
    LibLLVM.initialize_powerpc_target_info
    LibLLVM.initialize_powerpc_target
    LibLLVM.initialize_powerpc_target_mc
    LibLLVM.initialize_powerpc_asm_printer
    LibLLVM.initialize_powerpc_asm_parser
  end

  def self.init_bpf : Nil
    LibLLVM.initialize_bpf_target_info
    LibLLVM.initialize_bpf_target
    LibLLVM.initialize_bpf_target_mc
    LibLLVM.initialize_bpf_asm_printer
    LibLLVM.initialize_bpf_asm_parser
  end

  def self.init_target(name : String) : Bool
    case name.downcase
    when "aarch64", "arm64"
      init_aarch64
      true
    when "x86", "x86_64", "x86-64", "i386", "i686"
      init_x86
      true
    when "arm"
      init_arm
      true
    when "webassembly", "wasm", "wasm32"
      init_webassembly
      true
    when "riscv", "riscv32", "riscv64"
      init_riscv
      true
    when "mips"
      init_mips
      true
    when "powerpc", "ppc", "ppc64"
      init_powerpc
      true
    when "bpf"
      init_bpf
      true
    else
      false
    end
  end

  def self.each(& : Target -> Nil) : Nil
    target = LibLLVM.get_first_target
    while target.address != 0
      yield Target.new(target)
      target = LibLLVM.get_next_target(target)
    end
  end

  def self.first? : Target?
    target = LibLLVM.get_first_target
    if target.address != 0
      Target.new(target)
    else
      nil
    end
  end

  def self.first : Target
    target = first?
    if target
      target
    else
      raise "No LLVM targets available (did you forget to initialize targets?)"
    end
  end

  def self.from_triple(triple : String) : Target
    target_ref = Pointer(Void).new(0_u64)
    err_msg = Pointer(UInt8).new(0_u64)
    rc = LibLLVM.get_target_from_triple(to_c_str(triple), pointerof(target_ref), pointerof(err_msg))
    if rc != 0
      err = string_and_dispose(err_msg)
      raise "Could not find target for triple '#{triple}': #{err}"
    end
    Target.new(target_ref)
  end

  def self.default_target_triple : String
    ptr = LibLLVM.get_default_target_triple
    string_and_dispose(ptr)
  end

  def self.normalize_triple(triple : String) : String
    ptr = LibLLVM.normalize_target_triple(to_c_str(triple))
    string_and_dispose(ptr)
  end

  def self.host_cpu_name : String
    ptr = LibLLVM.get_host_cpu_name
    string_and_dispose(ptr)
  end

  def name : String
    ptr = LibLLVM.get_target_name(@unwrap)
    string_from_c(ptr)
  end

  def description : String
    ptr = LibLLVM.get_target_description(@unwrap)
    string_from_c(ptr)
  end

  def create_target_machine(triple : String,
                            cpu : String = "",
                            features : String = "",
                            opt_level : LibLLVM::CodeGenOptLevel = LibLLVM::CodeGenOptLevel::Default,
                            reloc : LibLLVM::RelocMode = LibLLVM::RelocMode::PIC,
                            code_model : LibLLVM::CodeModel = LibLLVM::CodeModel::Default) : TargetMachine
    tm = LibLLVM.create_target_machine(@unwrap, to_c_str(triple), to_c_str(cpu), to_c_str(features),
      opt_level, reloc, code_model)
    if tm.address == 0
      raise "Could not create target machine for triple '#{triple}'"
    end
    TargetMachine.new(tm)
  end
end

pub class TargetData
  getter unwrap : LibLLVM::TargetDataRef

  def initialize(@unwrap : LibLLVM::TargetDataRef)
    @disposed = false
  end

  def to_unsafe : LibLLVM::TargetDataRef
    @unwrap
  end

  def size_of_type_in_bits(type_ref : LibLLVM::TypeRef) : UInt64
    LibLLVM.size_of_type_in_bits(@unwrap, type_ref)
  end

  def abi_size_of_type(type_ref : LibLLVM::TypeRef) : UInt64
    LibLLVM.abi_size_of_type(@unwrap, type_ref)
  end

  def abi_alignment_of_type(type_ref : LibLLVM::TypeRef) : Int32
    LibLLVM.abi_alignment_of_type(@unwrap, type_ref)
  end

  def offset_of_element(struct_type_ref : LibLLVM::TypeRef, element : Int32) : UInt64
    LibLLVM.offset_of_element(@unwrap, struct_type_ref, element)
  end

  def to_s : String
    ptr = LibLLVM.copy_string_rep_of_target_data(@unwrap)
    string_and_dispose(ptr)
  end

  def dispose : Nil
    if !@disposed && @unwrap.address != 0
      LibLLVM.dispose_target_data(@unwrap)
      @disposed = true
    end
  end
end

pub class TargetMachine
  getter unwrap : LibLLVM::TargetMachineRef

  def initialize(@unwrap : LibLLVM::TargetMachineRef)
    @disposed = false
  end

  def to_unsafe : LibLLVM::TargetMachineRef
    @unwrap
  end

  def target : Target
    t = LibLLVM.get_target_machine_target(@unwrap)
    if t.address == 0
      raise "TargetMachine has no associated target"
    end
    Target.new(t)
  end

  def triple : String
    ptr = LibLLVM.get_target_machine_triple(@unwrap)
    string_and_dispose(ptr)
  end

  def cpu : String
    ptr = LibLLVM.get_target_machine_cpu(@unwrap)
    string_and_dispose(ptr)
  end

  def data_layout : TargetData
    dl = LibLLVM.create_target_data_layout(@unwrap)
    if dl.address == 0
      raise "Could not create target data layout from target machine"
    end
    TargetData.new(dl)
  end

  def emit_to_file(mod_ref : LibLLVM::ModuleRef, filename : String, file_type : LibLLVM::CodeGenFileType) : Nil
    err_msg = Pointer(UInt8).new(0_u64)
    rc = LibLLVM.target_machine_emit_to_file(@unwrap, mod_ref, to_c_str(filename), file_type, pointerof(err_msg))
    if rc != 0
      err = string_and_dispose(err_msg)
      raise "TargetMachine emit to file '#{filename}' failed: #{err}"
    end
  end

  def emit_obj_to_file(mod_ref : LibLLVM::ModuleRef, filename : String) : Nil
    emit_to_file(mod_ref, filename, LibLLVM::CodeGenFileType::ObjectFile)
  end

  def emit_asm_to_file(mod_ref : LibLLVM::ModuleRef, filename : String) : Nil
    emit_to_file(mod_ref, filename, LibLLVM::CodeGenFileType::AssemblyFile)
  end

  def emit_to_memory_buffer(mod_ref : LibLLVM::ModuleRef, file_type : LibLLVM::CodeGenFileType) : MemoryBuffer
    err_msg = Pointer(UInt8).new(0_u64)
    out_buf = Pointer(Void).new(0_u64)
    rc = LibLLVM.target_machine_emit_to_memory_buffer(@unwrap, mod_ref, file_type, pointerof(err_msg), pointerof(out_buf))
    if rc != 0
      err = string_and_dispose(err_msg)
      raise "TargetMachine emit to memory buffer failed: #{err}"
    end
    MemoryBuffer.new(out_buf)
  end

  def dispose : Nil
    if !@disposed && @unwrap.address != 0
      LibLLVM.dispose_target_machine(@unwrap)
      @disposed = true
    end
  end
end
