; iyi-ir 1
source_filename = "escape_mixed_candidates"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @mixed(i1 %choose) {
entry:
  %a = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 1, i64 2)
  %b = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 1, i64 2)
  %selected = select i1 %choose, ptr %a, ptr %b
  %v = load i64, ptr %selected, align 8
  ret i64 %v
}
