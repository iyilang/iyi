# Flag parsing, written in iyi.
#
# `on("--name VALUE", "help") { |v| ... }` and `on("-h", "help") { }`
# register flags, and `on("--color [WHEN]", "help")` one whose value may
# be left out. `parse` walks `Program.args` (or the array given),
# calls the blocks, and answers the leftover operands.
#
#     op = OptionParser.new
#     op.banner = "usage: tool [options] COMMAND"
#     op.on("-v", "--verbose", "say more") { verbose = true }
#     op.on("-n NAME", "--name=NAME", "who") { |v| name = v }
#     op.separator("commands:")
#     op.on("deploy", "ship it") do
#       op.on("-f", "--force", "even if dirty") { force = true }
#     end
#     puts op   # the banner, then a line for each flag and command
#
# A pair, `-v` and `--verbose`, is one flag spelled two ways; a value
# either spelling states, `-n NAME` or `--name=NAME`, both take.
#
# A command is a name with no dash, and is one only as the first operand:
# `tool deploy -f` runs `deploy`'s block, which registers what follows it
# - its flags, and the commands below it, which replace the ones beside
# it. Flags registered before the command still apply after it, where the
# other library forgets them; a name after an operand is an operand.
#
# What the person typed wrong is the program's to answer, the way
# Crystal's `OptionParser` has it: `invalid_option { |flag| ... }` is
# handed an unknown flag and a value given to a flag that takes none,
# `missing_option { |flag| ... }` a flag that takes a value and is last,
# and parsing goes on after either. With no handler set they panic -
# `unknown flag: --x`, `flag --x takes no value`, `flag --name needs a
# value` - which is a bug report where a usage line was wanted, so a
# program reading its own command line sets both.

module std/option_parser

pub class OptionParser
  # What a flag does with the argument after it: `--name VALUE` needs one,
  # `--color [WHEN]` takes one unless it is missing or is a flag itself,
  # and `--verbose` takes none.
  enum Value
    None
    Required
    Optional
  end

  @long : Hash(String, {Value, (String -> Nil)})
  @short : Hash(String, {Value, (String -> Nil)})
  # The help's lines, each marked when it is a command's, which a command
  # matched takes away with the commands beside it.
  @help : Array({String, Bool})
  @commands : Hash(String, (String -> Nil))
  @banner : String?
  @invalid : (String -> Nil)?
  @missing : (String -> Nil)?

  def initialize
    @long = {} of String => {Value, (String -> Nil)}
    @short = {} of String => {Value, (String -> Nil)}
    @help = [] of {String, Bool}
    @commands = {} of String => (String -> Nil)
    @banner = nil
    @invalid = nil
    @missing = nil
  end

  # The help's first line, "options:" until it is set.
  def banner=(text : String) : Nil
    @banner = text
  end

  def banner : String?
    @banner
  end

  # A line of its own in the help, between the flags and commands
  # registered before it and after it.
  def separator(text : String) : Nil
    @help << {text, false}
  end

  def invalid_option(&block : String -> Nil) : Nil
    @invalid = block
  end

  def missing_option(&block : String -> Nil) : Nil
    @missing = block
  end

  private def invalid(flag : String, sentence : String) : Nil
    handler = @invalid
    raise sentence unless handler
    handler.call(flag)
  end

  private def missing(flag : String) : Nil
    handler = @missing
    raise "flag #{flag} needs a value" unless handler
    handler.call(flag)
  end

  # A value is taken by `--name VALUE`, `--name=VALUE`, `-n VALUE` and
  # `-nVALUE`, the four spellings the other library reads. Only the space
  # form was: `--name=VALUE` was stored under the key `--name=VALUE`, which
  # no argument ever looks up, and `-nVALUE` refused itself as not a flag.
  # A short flag is one character, not one byte: `-é` was refused too.
  #
  # A bracketed value, `--color [WHEN]`, `-c [WHEN]` or `-c[WHEN]`, may be
  # left out, as the other library reads the brackets. It was a required
  # value: `--color` last panicked "flag --color needs a value", and
  # `--color -v` handed `-v` to `--color` instead of running it.
  def on(flag : String, description : String, &block : String -> Nil) : Nil
    unless flag.starts_with?("-")
      raise "option: not a flag or a command: #{flag}" if flag.empty? || flag.includes?(" ")
      @commands[flag] = block
      @help << {"  #{flag}  #{description}", true}
      return
    end
    name, takes = spelled(flag)
    @help << {"  #{flag}  #{description}", false}
    store(name, takes, block)
  end

  # One flag spelled two ways, `-v` and `--verbose`: the value either
  # states, both take.
  def on(short : String, long : String, description : String, &block : String -> Nil) : Nil
    first, first_takes = spelled(short)
    second, second_takes = spelled(long)
    if !first_takes.none? && !second_takes.none? && first_takes != second_takes
      raise "option: #{short} and #{long} differ on the value: one needs it, the other may leave it out"
    end
    takes = first_takes.none? ? second_takes : first_takes
    @help << {"  #{short}, #{long}  #{description}", false}
    store(first, takes, block)
    store(second, takes, block)
  end

  # The name *flag* is looked up by, and what it does with a value.
  private def spelled(flag : String) : {String, Value}
    name = flag.split(' ')[0]
    takes = flag.includes?(" ") ? Value::Required : Value::None
    takes = Value::Optional if bracketed?(flag[name.bytesize, flag.bytesize - name.bytesize].strip)
    if name.starts_with?("--")
      eq = name.index('=')
      if eq
        takes = Value::Required
        name = name[0, eq]
      end
    elsif name.starts_with?("-") && name.bytesize >= 2
      at = char_end(name, 1)
      if at < name.bytesize
        takes = bracketed?(name[at, name.bytesize - at]) ? Value::Optional : Value::Required
        name = name[0, at]
      end
    else
      raise "option: not a flag: #{flag}"
    end
    {name, takes}
  end

  private def store(name : String, takes : Value, block : String -> Nil) : Nil
    if name.starts_with?("--")
      @long[name] = {takes, block}
    else
      @short[name] = {takes, block}
    end
  end

  # `[WHEN]`: a name in brackets, the way a usage line marks what may be
  # left out.
  private def bracketed?(text : String) : Bool
    text.bytesize >= 3 && text.starts_with?("[") && text.ends_with?("]")
  end

  # Whether *arg* is a flag this parser knows, which an optional value
  # never takes as its own, as the other library leaves it to run.
  private def known?(arg : String) : Bool
    @long.has_key?(arg) || @short.has_key?(arg)
  end

  # Where the character starting at byte *at* ends: a short flag is `-`
  # and one character, and cutting it at two bytes handed `invalid_option`
  # half of an `é`.
  private def char_end(s : String, at : Int32) : Int32
    b = s.to_unsafe[at]
    width = b < 0xC0_u8 ? 1 : (b < 0xE0_u8 ? 2 : (b < 0xF0_u8 ? 3 : 4))
    e = at + width
    e > s.bytesize ? s.bytesize : e
  end

  def parse : Array(String)
    parse(Program.args)
  end

  def parse(args : Array(String)) : Array(String)
    rest = [] of String
    i = 0
    n = args.size
    while i < n
      a = args[i]
      if a == "--"
        i = i + 1
        while i < n
          rest << args[i]
          i = i + 1
        end
        break
      elsif a.starts_with?("--")
        eq = a.index('=')
        if eq
          name = a[0, eq]
          val = a[eq + 1, a.bytesize - eq - 1]
          spec = @long[name]?
          if !spec
            invalid(name, "unknown flag: #{name}")
          elsif spec[0].none?
            invalid(name, "flag #{name} takes no value")
          else
            spec[1].call(val)
          end
        else
          spec = @long[a]?
          if !spec
            invalid(a, "unknown flag: #{a}")
          elsif spec[0].none?
            spec[1].call("")
          elsif i + 1 < n && (spec[0].required? || !known?(args[i + 1]))
            i = i + 1
            spec[1].call(args[i])
          elsif spec[0].required?
            missing(a)
          else
            spec[1].call("")
          end
        end
      elsif a.starts_with?("-") && a.bytesize >= 2 && a != "-"
        at = char_end(a, 1)
        name = a[0, at]
        spec = @short[name]?
        if !spec
          invalid(name, "unknown flag: #{name}")
        elsif !spec[0].none?
          if a.bytesize > at
            spec[1].call(a[at, a.bytesize - at])
          elsif i + 1 < n && (spec[0].required? || !known?(args[i + 1]))
            i = i + 1
            spec[1].call(args[i])
          elsif spec[0].required?
            missing(name)
          else
            spec[1].call("")
          end
        elsif a.bytesize == at
          spec[1].call("")
        elsif bundle?(a)
          run_bundle(a)
        else
          invalid(name, "flag #{name} takes no value")
        end
      else
        command = rest.empty? ? @commands[a]? : nil
        if command
          # The level below is the block's to register: the commands beside
          # this one, and their lines in the help, are gone.
          @commands.clear
          @help = @help.reject { |entry| entry[1] }
          command.call(a)
        else
          rest << a
        end
      end
      i = i + 1
    end
    rest
  end

  # `-vq` is `-v -q`, and `-vp8080` is `-v -p 8080`: every character up to
  # the first flag that takes a value is a flag, and what follows that one
  # is its value, the reading the other library gives. Only the first
  # character was read and the rest dropped, so `-vq` never ran `-q` and
  # `-vx`, with no `-x`, passed as `-v`. A bundle with a character that is
  # no flag runs none of it: it is `-v` handed a value it does not take.
  private def bundle?(a : String) : Bool
    pos = 1
    while pos < a.bytesize
      e = char_end(a, pos)
      spec = @short["-" + a[pos, e - pos]]?
      return false unless spec
      return true unless spec[0].none?
      pos = e
    end
    true
  end

  private def run_bundle(a : String) : Nil
    pos = 1
    while pos < a.bytesize
      e = char_end(a, pos)
      spec = @short["-" + a[pos, e - pos]]?
      if spec
        unless spec[0].none?
          spec[1].call(a[e, a.bytesize - e])
          return
        end
        spec[1].call("")
      end
      pos = e
    end
  end

  def help : String
    lines = [@banner || "options:"]
    @help.each { |entry| lines << entry[0] }
    lines.join("\n")
  end

  def to_s : String
    help
  end
end
