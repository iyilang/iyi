pub class Return < ControlExpression
  property from_propagate : Bool = false

  def initialize(exp : ASTNode? = nil)
    super(exp)
    @from_propagate = false
  end

  def clone_without_location : self
    ret = Return.new(clone_node(@exp))
    ret.from_propagate = @from_propagate
    ret
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "return"
    if e = @exp
      sb << " "
      e.to_s(sb)
    end
  end
end

