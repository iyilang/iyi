SAMPLES.each do |sample|
  text = text_of(sample[1])
  assert_str flags_dropped(sample[2]), Punycode.encode(text), "rfc 3492 sample #{sample[0]} encodes"
  assert_str text, decoded(sample[2], "rfc 3492 sample #{sample[0]} decodes"), "rfc 3492 sample #{sample[0]} decodes"
end
assert_str "bcher-kva", Punycode.encode("bücher"), "bücher encodes"
assert_str "abc-", Punycode.encode("abc"), "an all-basic string ends with its delimiter"
assert_str "", Punycode.encode(""), "the empty string encodes to nothing"
assert_str "", decoded("", "nothing decodes"), "nothing decodes to the empty string"
assert_str "bücher", decoded("bcher-KVA", "digits in either case"), "digits are read in either case"
puts "  section 7.1's #{SAMPLES.size} samples encode and decode; digits in either case"

puts "\n== punycode refusals"
refused Punycode.decode("bücher"), "Punycode: byte 1 is 0xC3, which is not ASCII", "a byte that is not ASCII"
refused Punycode.decode("abc-d!e"), "Punycode: '!' at byte 5 is not a base-36 digit", "a byte that is not a digit"
refused Punycode.decode("-abc"), "Punycode: '-' at byte 0 is not a base-36 digit", "a delimiter that delimits nothing"
refused Punycode.decode("a-9"), "Punycode: the input ends inside a number", "input that ends inside a number"
refused Punycode.decode("99999999999999999999"), "Punycode: the number at byte 17 overflows", "overflow"
refused Punycode.decode("dn32h"), "Punycode: the number ending at byte 4 is code point U+12DE83, past U+10FFFF", "a code point past U+10FFFF"
refused Punycode.decode("ib9b"), "Punycode: the number ending at byte 3 is U+D800, a surrogate, which UTF-8 does not hold", "a surrogate"
assert_str "\u{10FFFF}", decoded("dn32g", "U+10FFFF decodes"), "U+10FFFF, the last code point, decodes"
puts "  not ASCII, not a digit, cut short, overflow, past U+10FFFF and a surrogate are refused"

puts "\n== punycode round trips"
# A fixed pseudo-random walk over ASCII, Latin, CJK and the astral planes.
seed = 20261015_i64
cases = 0
400.times do |n|
  points = [] of Int32
  (n % 40).times do
    seed = (seed &* 6364136223846793005_i64 &+ 1442695040888963407_i64) & 0x7FFFFFFFFFFFFFFF_i64
    pick = (seed >> 33).to_i32
    point = case pick % 4
            when 0 then 32 + pick % 95
            when 1 then 0xA0 + pick % 0x500
            when 2 then 0x4E00 + pick % 0x5000
            else        0x10000 + pick % 0xFFFF0
            end
    points << point
  end
  text = text_of(points)
  assert_str text, decoded(Punycode.encode(text), "round trip #{n}"), "round trip #{n}"
  cases = cases + 1
end
# A delta past 32 bits: U+10FFFF after 3,000 basic code points is
# (0x10FFFF - 128) * 3001, about 3.3 billion, in one number.
long = "a" * 3000 + "\u{10FFFF}"
assert_str long, decoded(Punycode.encode(long), "a delta past 32 bits"), "a delta past 32 bits round-trips"
puts "  #{cases} strings and one whose delta is past 32 bits read back"

puts "\n== to_ascii"
ascii "bücher.example", "xn--bcher-kva.example", "bücher"
ascii "münchen.de", "xn--mnchen-3ya.de", "münchen"
