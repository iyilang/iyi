# Tasks across cores, exercised: SPEC.md III.4.13, built.
#
#   ./bin/iyi run bench/parallel_exercise.iyi                  # every property
#   ./bin/iyi run bench/parallel_exercise.iyi wake cancel      # some of them
#   ./bin/iyi run bench/parallel_exercise.iyi speed W T N      # one timing
#   ./bin/iyi run bench/parallel_exercise.iyi capacity K       # worker holds
#   ./bin/iyi run bench/parallel_exercise.iyi ending           # simultaneous endings
#
# Every claim the pool makes, run rather than asserted: parallel tasks
# start on worker threads and not on the thread that spawned them, on more
# than one of them, and resume on a worker - not always the one they
# parked on - across every park; a thousand of them run exactly once
# each; workers that run out steal what another worker's tasks spawned;
# values cross threads through channels exactly once and in each sender's
# order; a cancel reaches a task asleep or parked on a channel on another
# thread, and a task still waiting in the pool starts cancelled; a panic
# stops at the task's boundary on whatever thread it ran; collections stop
# workers with live lists on their fibers' stacks and free nothing of
# them; the typed group answers a tuple of parallel tasks; and wakes that
# race across workers - selects parked on two channels, cancels landing
# as tasks park, turns handed through `park_on` - are neither lost nor
# doubled.
#
# Property steps run under a watchdog: a task on the main thread that sleeps
# and fails the run by name if the step has not finished. The ending scenario
# instead makes five callers reach the same deadline together.
#
# `capacity K` holds K non-preemptible tasks on distinct workers together.
# `-Dplacement_withhold_arrival` makes each placement task reach its deadline.
# `speed W T N` reports wall time and sampled at-once occupancy only.
# OPEN: the former 3000 ms cancellation bounds are measurements, not
# correctness guarantees; forced cancellation copies hold the outcomes.

@[Unsafe("allocates raw blocks through Pointer.malloc in tasks, and Turns trusts @[Share] to hand its word's pointerof address to park_on and wake_on")]
{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  {% unless flag?(:run_end_copy) %}
    # one ending: begin
    # The run's one ending, for every catch, watchdog and setup failure, on
    # any thread and under any lock. The first caller to claim the word
    # writes its line and ends the process with its status; every later
    # caller writes nothing and yields until that end.
    #
    # Its bounds. One write goes out only when lead, what and tail total at
    # most 512 bytes; a longer line goes out piece by piece (lead, what, tail),
    # each piece in as many writes as the kernel takes. The claim and the
    # write take no lock. The exit is not lock-free on Windows: __iyi_exit
    # first runs __iyi_hold_runtime_for_exit, a bounded spin of up to
    # 10,000,000 try_locks of IyiRuntimeLock that parks while a stop is
    # requested, so a caller that held that lock while a stop waited on its
    # own thread would leave the claimant parked there. No call site does
    # that: every caller runs on a scheduler, worker or monitor path, never
    # in collector code. Nothing between the claim and the exit is a
    # preemption point, because the block is @[NoPreempt]. On Darwin the exit
    # is the raw SYS_exit call, so no libSystem code runs after the write. The
    # libSystem-teardown explanation of the old hang was tested and ruled out
    # (a raw write then LibC.exit ended with status 76 and one line), so the
    # raw call is a choice, not a fix.
    #
    # Each copy of this block is held to bench/parallel_exercise.iyi's, and
    # bench/parallel_exercise.sh appends it to each runtime copy it runs
    # (-Drun_end_copy), so a hook and its fixture claim one word.
    class RunEnd
      @[UnsafeReach("the run's claim: atomically set once, reset only for the ending-hook setup probe")]
      @@claimed : UInt64 = 0_u64

      def self.claim : Bool
        Pointer(Atomic(UInt64)).new(pointerof(@@claimed).address).value.compare_and_set(0_u64, 1_u64)[1]
      end

      {% if flag?(:ending_hook) %}
        # Only before the racers start, after the cross-layer claim probe.
        def self.reset_for_test : Nil
          Pointer(Atomic(UInt64)).new(pointerof(@@claimed).address).value.set(0_u64)
        end
      {% end %}

      {% if flag?(:ending_unclaimed) %}
        # The planted mutant's count of writers, read by every caller's wait.
        @[UnsafeReach("the mutant's count of writers: atomics only")]
        @@written : UInt64 = 0_u64

        def self.arrive : UInt64
          Pointer(Atomic(UInt64)).new(pointerof(@@written).address).value.add(1_u64)
        end

        def self.written : UInt64
          Pointer(Atomic(UInt64)).new(pointerof(@@written).address).value.get
        end
      {% end %}
    end

    @[NoInline]
    @[NoPreempt]
    def run_end_write(fd : Int32, lead : String, what : String = "", tail : String = "") : Nil
      size = lead.bytesize + what.bytesize + tail.bytesize
      line = uninitialized UInt8[512]
      base = pointerof(line).as(UInt8*)
      at = 0
      piece = 0
      while piece < 3
        text = piece == 0 ? lead : (piece == 1 ? what : tail)
        from = text.to_unsafe
        count = text.bytesize
        if size <= 512
          i = 0
          while i < count
            (base + at + i).value = from[i]
            i = i + 1
          end
          at = at + count
          from = base
          count = piece == 2 ? at : 0
        end
        done = 0
        while done < count
          wrote = __iyi_write(fd, (from + done).as(Void*), (count - done).to_u64)
          break if wrote <= 0_i64
          done = done + wrote.to_i32
        end
        piece = piece + 1
      end
    end

    @[NoInline]
    @[NoPreempt]
    def end_run(status : Int32, fd : Int32, lead : String, what : String = "", tail : String = "") : NoReturn
      {% if flag?(:ending_unclaimed) %}
        # The planted mutant takes no claim: every caller writes its line, then
        # waits until all five have written, so the first to exit ends the run
        # with five lines.
        run_end_write(fd, lead, what, tail)
        RunEnd.arrive
        started = __iyi_monotonic_ns
        while RunEnd.written < 5_u64
          if __iyi_monotonic_ns - started >= 10_000_000_000_i64
            stuck = "FAIL: ending: setup: the unclaimed writers did not finish in 10000 ms\n"
            __iyi_write(1, stuck.to_unsafe.as(Void*), stuck.bytesize.to_u64)
            __iyi_exit(76)
          end
          IyiThread.spin_pause
        end
      {% else %}
        unless RunEnd.claim
          while true
            IyiThread.yield_cpu
          end
        end
        run_end_write(fd, lead, what, tail)
      {% end %}
      {% if flag?(:darwin) %}
        asm("svc #0x80" :: "{x16}"(1_i64), "{x0}"(status.to_i64) : "memory" : "volatile")
        while true
        end
      {% else %}
        __iyi_exit(status)
      {% end %}
    end
    # one ending: end
  {% end %}

  def fail(message : String) : Nil
    end_run(1, 1, "FAIL: ", message, "\n")
  end

  def progress_hang(message : String) : NoReturn
    end_run(76, 1, "FAIL: ", message, "\n")
  end

  def elapsed_ms(since : Int64) : Int64
    (__iyi_monotonic_ns - since) // 1000000_i64
  end

  # The thread a task is on: its scheduler state, one per thread.
  def thread_here : UInt64
    IyiScheduler.state.object_id
  end

  # Integer work with nothing to allocate and nothing the optimiser can
  # fold away: a xorshift walk whose end the caller prints.
  def spin(rounds : Int64, seed : UInt64) : UInt64
    x = seed | 1_u64
    i = 0_i64
    while i < rounds
      x = x ^ x.unsafe_shl(13_u64)
      x = x ^ x.unsafe_shr(7_u64)
      x = x ^ x.unsafe_shl(17_u64)
      i = i + 1
    end
    x
  end

  # Counts the tasks share, each an atomic: `Share` by its fields, so a
  # parallel block may capture one (SPEC.md III.4.4).
  class Tally
    @count : Atomic(Int64)
    @sum : Atomic(Int64)

    def initialize
      @count = Atomic(Int64).new(0_i64)
      @sum = Atomic(Int64).new(0_i64)
    end

    def add(value : Int64) : Nil
      @count.add(1_i64)
      @sum.add(value)
    end

    def count : Int64
      @count.get
    end

    def sum : Int64
      @sum.get
    end
  end

  # The count the race step adds to from every task at once. Under
  # `-Dparallel_plain_add` the add is a load and a store: tasks that run
  # at the same instant on two cores lose each other's adds, which no
  # schedule of one thread can do - nothing parks between the two.
  class Racer
    @hits : Atomic(Int64)

    def initialize
      @hits = Atomic(Int64).new(0_i64)
    end

    def bump : Nil
      {% if flag?(:parallel_plain_add) %}
        @hits.set(@hits.get + 1_i64)
      {% else %}
        @hits.add(1_i64)
      {% end %}
    end

    # The add as a plain add tears it: the count is read, and the read plus one
    # stored. `race_forced` puts another task's add between the two; the atomic
    # add is one step, so it has no gap there to be put in.
    def read_count : Int64
      {% if flag?(:parallel_plain_add) %}
        @hits.get
      {% else %}
        0_i64
      {% end %}
    end

    def store_count(seen : Int64) : Nil
      {% if flag?(:parallel_plain_add) %}
        @hits.set(seen + 1_i64)
      {% else %}
        @hits.add(1_i64)
      {% end %}
    end

    def hits : Int64
      @hits.get
    end
  end

  # A node a list is built of, for the collector's step.
  class Node
    getter value : Int64
    getter next_node : Node?

    def initialize(@value : Int64, @next_node : Node?)
    end
  end

  struct Boom
    def initialize
    end
  end

  impl Error for Boom
    def message : String
      "boom"
    end
  end

  # The step *name* run under a watchdog on the main thread: a task that
  # sleeps *ms* and fails the run by name unless the step ends first.
  def watched(name : String, ms : Int32, &block : -> Nil) : Nil
    {% if flag?(:copy_hook_watchdog) %}
      # The withheld-event control exercises the copy hook's own watchdog.
      # Its enclosing process timeout remains the outer safety net.
      block.call
    {% else %}
      group do |w|
        w.spawn(unit: :same) do
          waited = sleep(ms)
          progress_hang("#{name}: progress hang: still waiting after #{ms} ms") unless waited.is_a?(Cancelled)
          0
        end
        block.call
        w.cancel_children
      end
    {% end %}
  end

  # Each task publishes its arrival inside a NoPreempt hold and waits for
  # the main thread's release. Once all have arrived, each occupies a
  # distinct worker: none can give its worker to another arriving task.
  # The watchdog remains on the main thread even while every worker is held.
  def hold_workers(workers : Int32, watch : Int32, name : String) : Nil
    arrived = Tally.new
    release = Tally.new
    watched(name, watch) do
      group do |g|
        workers.times do
          g.spawn(unit: :new) do
            hold_for(arrived, release)
            0
          end
        end
        started = __iyi_monotonic_ns
        while arrived.count < workers.to_i64
          sleep(1)
          progress_hang("#{name}: progress hang: not all #{workers} workers reached the hold within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
        end
        release.add(1_i64)
      end
    end
  end

  # Start all workers before a step that needs each to have been launched.
  def fill_pool(watch : Int32) : Nil
    hold_workers(IyiWorkers.count, watch, "fill pool")
  end

  def capacity(workers : Int32) : Nil
    IyiWorkers.count = workers
    IyiWorkers.start
    actual = IyiWorkers.count
    fail("capacity: the pool started #{actual} worker, expected #{workers}") unless actual == workers
    hold_workers(workers, 60000, "capacity")
    puts "capacity: #{workers} workers held tasks together"
  end

  # ── speed ────────────────────────────────────────────────────────────
  # The rounds a timed task computes between two looks at its thread and
  # the clock: about a tenth of a millisecond of the walk.
  SPEED_LOOK_ROUNDS = 65536_i64

  # `spin` in pieces, each followed by a look at the thread the task is on
  # and the clock. Answers the walk's end and the task's stretches, three
  # words each - the thread, the first look and the last look on it - a
  # stretch ending where a look finds the task on another thread.
  def spin_traced(rounds : Int64, seed : UInt64) : Tuple(UInt64, Array(UInt64))
    stretches = [] of UInt64
    x = seed
    on = thread_here
    from = __iyi_monotonic_ns
    last = from
    done = 0_i64
    while done < rounds
      piece = rounds - done
      piece = SPEED_LOOK_ROUNDS if piece > SPEED_LOOK_ROUNDS
      x = spin(piece, x)
      done = done + piece
      here = thread_here
      now = __iyi_monotonic_ns
      if here != on
        stretches << on << from.to_u64 << last.to_u64
        on = here
        from = now
      end
      last = now
    end
    stretches << on << from.to_u64 << last.to_u64
    {x, stretches}
  end

  # How many threads held a timed task at once, in hundredths, on average
  # over the run from *started* to *ended*: each thread's stretches laid
  # on a grid of 100 us cells, a cell held when a stretch covers it, the
  # held cells of every thread summed over the run's cells. A thread
  # holding a task holds it whether or not the kernel has it on a core,
  # so a loaded host does not lower this; a pool that runs its tasks on
  # one thread at a time cannot raise it past 100.
  def held_at_once(stretches : Array(UInt64), started : Int64, ended : Int64) : Int64
    cell = 100_000_i64
    cells = (ended - started) // cell + 1_i64
    threads = [] of UInt64
    i = 0
    while i < stretches.size
      threads << stretches[i] unless threads.includes?(stretches[i])
      i = i + 3
    end
    held = 0_i64
    threads.each do |thread|
      grid = Array(Bool).new(cells.to_i32, false)
      j = 0
      while j < stretches.size
        if stretches[j] == thread
          first = (stretches[j + 1].to_i64 - started) // cell
          last = (stretches[j + 2].to_i64 - started) // cell
          first = 0_i64 if first < 0_i64
          last = cells - 1_i64 if last >= cells
          c = first
          while c <= last
            grid[c.to_i32] = true
            c = c + 1_i64
          end
        end
        j = j + 3
      end
      grid.each { |covered| held = held + 1_i64 if covered }
    end
    held * 100_i64 // cells
  end

  def speed(workers : Int32, tasks : Int32, rounds : Int64) : Nil
    IyiWorkers.count = workers
    started = __iyi_monotonic_ns
    total = 0_u64
    stretches = [] of UInt64
    group do |g|
      handles = [] of IyiTask(Tuple(UInt64, Array(UInt64)))
      tasks.times do |i|
        handles << g.spawn(unit: :new) { spin_traced(rounds, (i + 1).to_u64) }
      end
      handles.each do |handle|
        answer = handle.value
        fail("a timed task answered #{answer}") unless answer.is_a?(Tuple(UInt64, Array(UInt64)))
        total = total ^ answer[0]
        stretches.concat(answer[1])
      end
    end
    ended = __iyi_monotonic_ns
    puts "workers=#{workers} tasks=#{tasks} rounds=#{rounds} wall_ms=#{(ended - started) // 1000000_i64} at_once=#{held_at_once(stretches, started, ended)} checksum=#{total}"
  end

  # ── the properties ───────────────────────────────────────────────────

  # Placement: parallel tasks run on the pool, not on the spawning thread,
  # on more than one worker, and never on the spawning thread after a park
  # either - a sleep and a channel handoff from the main thread - though
  # they may resume on another worker (bench/parallel_migrate.iyi holds
  # what a move keeps).
  #
  # Each task records its worker inside a non-preemptible hold until a
  # second task has arrived, so the first two must be on distinct workers.
  # The deadline is a progress failure, not a placement verdict.
  @[NoInline]
  @[NoPreempt]
  def placement_first(arrived : Tally) : UInt64
    first = thread_here
    {% unless flag?(:placement_withhold_arrival) %}
      arrived.add(1_i64)
    {% end %}
    held = __iyi_monotonic_ns
    while arrived.count < 2_i64
      progress_hang("placement: progress hang: a parallel task held its worker for 10000 ms and no second task started") if elapsed_ms(held) >= 10000_i64
      IyiThread.spin_pause
    end
    first
  end

  def placement(watch : Int32) : Nil
    watched("placement", watch) do
      main_thread = thread_here
      pings = Channel(Int32).new
      arrived = Tally.new
      seen = [] of UInt64
      moved = 0
      group do |g|
        handles = [] of IyiTask(Tuple(UInt64, UInt64, UInt64))
        16.times do |i|
          task = g.spawn(unit: :new) do
            first = placement_first(arrived)
            spin(2_000_000_i64, (i + 1).to_u64)
            sleep(2)
            second = thread_here
            pings.receive
            {first, second, thread_here}
          end
          handles << task
        end
        16.times { pings.send(1) }
        handles.each do |handle|
          ids = handle.value
          fail("placement: a parallel task answered #{ids}") unless ids.is_a?(Tuple(UInt64, UInt64, UInt64))
          fail("placement: a parallel task ran on the thread that spawned it") if ids[0] == main_thread
          fail("placement: a parallel task resumed on the thread that spawned it: #{ids[0]}, #{ids[1]}, #{ids[2]}") if ids[1] == main_thread || ids[2] == main_thread
          moved = moved + 1 unless ids[0] == ids[1] && ids[1] == ids[2]
          seen << ids[0] unless seen.includes?(ids[0])
        end
      end
      fail("placement: 16 parallel tasks all ran on one worker of #{IyiWorkers.count}") if seen.size < 2
      puts "placement: 16 parallel tasks on #{seen.size} of #{IyiWorkers.count} workers, none on the spawning thread, #{moved} resumed on another worker across a sleep and a channel"
    end
  end

  # Exactly once: a thousand tasks, each counted once, each answering its
  # own index through `value`.
  def exactly_once(watch : Int32) : Nil
    watched("exactly once", watch) do
      tally = Tally.new
      answered = 0_i64
      group do |g|
        handles = [] of IyiTask(Int64)
        1000.times do |i|
          task = g.spawn(unit: :new) do
            tally.add(i.to_i64)
            i.to_i64
          end
          handles << task
        end
        handles.each do |handle|
          value = handle.value
          fail("exactly once: a task answered #{value}") unless value.is_a?(Int64)
          answered = answered + value
        end
      end
      fail("exactly once: #{tally.count} runs of 1000 tasks") unless tally.count == 1000_i64
      fail("exactly once: the tasks summed #{tally.sum}, not 499500") unless tally.sum == 499500_i64
      fail("exactly once: the handles answered #{answered}, not 499500") unless answered == 499500_i64
      puts "exactly once: 1000 parallel tasks ran 1000 times and answered 499500"
    end
  end

  # The race: every task adds to one count at once. Atomic adds lose
  # nothing; the plain copy (`-Dparallel_plain_add`) loses adds only if
  # two tasks really ran at the same instant.
  def race(watch : Int32) : Nil
    watched("race", watch) do
      racer = Racer.new
      tasks = 8
      rounds = 2_000_000
      group do |g|
        tasks.times do
          g.spawn(unit: :new) do
            n = 0
            while n < rounds
              racer.bump
              n = n + 1
            end
            0
          end
        end
      end
      want = tasks.to_i64 * rounds.to_i64
      fail("race: increments lost: #{want - racer.hits} of #{want}, so tasks ran at the same instant and the add was not atomic") unless racer.hits == want
      puts "race: #{tasks} tasks added #{want} times to one atomic and lost none"
    end
  end

  # The race forced: one task reads the count and holds its read until the
  # other task's add has stored, then stores the read plus one. A plain add
  # loses the other's add that way every time; the atomic add is one step and
  # keeps both. Each task waits on a count the other sets, and the watch names
  # a wait that never ends.
  def race_forced(watch : Int32) : Nil
    watched("race", watch) do
      racer = Racer.new
      looked = Tally.new
      stored = Tally.new
      group do |g|
        g.spawn(unit: :new) do
          seen = racer.read_count
          looked.add(1_i64)
          started = __iyi_monotonic_ns
          while stored.count == 0_i64
            IyiThread.spin_pause
            progress_hang("race: progress hang: the other task's add never stored within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
          end
          racer.store_count(seen)
          0
        end
        g.spawn(unit: :new) do
          started = __iyi_monotonic_ns
          while looked.count == 0_i64
            IyiThread.spin_pause
            progress_hang("race: progress hang: the first task never read the count within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
          end
          racer.bump
          stored.add(1_i64)
          0
        end
      end
      want = 2_i64
      unless racer.hits == want
        puts "race: lost #{want - racer.hits} of #{want} increments"
        fail("race: a task stored the count it read before another task's add landed")
      end
      puts "race: two tasks added to one count with one add put between another's read and store, and lost none"
    end
  end

  # Values cross threads through channels exactly once and in each
  # sender's order: producers on the pool, the consumer on the main
  # thread; then a pipeline through a parallel stage, in order; then
  # several parallel consumers of one channel, each value taken once.
  def channels(watch : Int32) : Nil
    watched("channels", watch) do
      producers = 6
      per = 20000
      fan = Channel(Tuple(Int32, Int32)).new(64)
      expected = Array(Int32).new(producers, 0)
      group do |g|
        producers.times do |p|
          g.spawn(unit: :new) do
            i = 0
            while i < per
              fan.send({p, i})
              i = i + 1
            end
            0
          end
        end
        (producers * per).times do
          got = fan.receive
          fail("channels: a fan-in receive answered #{got}") unless got.is_a?(Tuple(Int32, Int32))
          who = got[0]
          fail("channels: producer #{who} sent #{got[1]} where #{expected[who]} was next") unless got[1] == expected[who]
          expected[who] = expected[who] + 1
        end
      end
      expected.each_with_index do |count, who|
        fail("channels: producer #{who} delivered #{count} of #{per}") unless count == per
      end

      jobs = Channel(Int64).new
      results = Channel(Int64).new
      group do |g|
        g.spawn(unit: :new) do
          while true
            job = jobs.receive
            break unless job.is_a?(Int64)
            results.send(job * job)
          end
          0
        end
        n = 0_i64
        while n < 5000_i64
          jobs.send(n)
          answer = results.receive
          fail("channels: the stage answered #{answer} for #{n}") unless answer == n * n
          n = n + 1_i64
        end
        jobs.close
      end

      work = Channel(Int64).new(32)
      tally = Tally.new
      group do |g|
        4.times do
          g.spawn(unit: :new) do
            while true
              item = work.receive
              break unless item.is_a?(Int64)
              tally.add(item)
            end
            0
          end
        end
        n = 0_i64
        while n < 40000_i64
          work.send(n)
          n = n + 1_i64
        end
        work.close
      end
      fail("channels: 4 consumers took #{tally.count} of 40000 values") unless tally.count == 40000_i64
      fail("channels: 4 consumers summed #{tally.sum}") unless tally.sum == 799980000_i64
      puts "channels: #{producers * per} values from #{producers} parallel senders in each one's order, 5000 through a parallel stage in order, 40000 taken once each by 4 parallel receivers"
    end
  end

  # One task's claims on places as std/http's pooled `serve` holds them:
  # a send claims one and parks while all are held, a `take_now` frees it.
  def claim_places(places : Channel(Int32), served : Tally, rounds : Int32) : Int32
    n = 0
    while n < rounds
      places.send(0)
      served.add(1_i64)
      places.take_now
      n = n + 1
    end
    0
  end

  # `Channel#take_now` and `#put_now` from every worker at once, which
  # take the scheduler's lock themselves (they were `select`'s lock-held
  # halves, and std/http called them from workers with no lock). First
  # places as the pooled `serve` holds them: a send claims one of two and
  # parks while both are held, a `take_now` frees one and wakes the oldest
  # claimant wherever it waits - eight parallel tasks and the main thread
  # claiming beside them, so the wakes cross to a thread outside the pool
  # as well. Then values `put_now` from six workers into one buffer, taken
  # on the main thread, which parks whenever it is empty and is woken by
  # whichever producer puts next: each value once, in each producer's
  # order. A task's panic is read off its handle and named here.
  def now_halves(watch : Int32) : Nil
    watched("now", watch) do
      places = Channel(Int32).new(2)
      served = Tally.new
      rounds = 2000
      group do |g|
        handles = [] of IyiTask(Int32)
        8.times do
          handles << g.spawn(unit: :new) { claim_places(places, served, rounds) }
        end
        handles << g.spawn { claim_places(places, served, rounds) }
        handles.each do |handle|
          answer = handle.value
          fail("now: a task claiming places answered #{answer.is_a?(Panicked) ? answer.text : answer}") unless answer == 0
        end
      end
      fail("now: #{served.count} of #{9 * rounds} places claimed and freed") unless served.count == 9_i64 * rounds
      fail("now: a place is still held after every claim was freed") if places.receive_ready?

      producers = 6
      per = 20000
      fan = Channel(Tuple(Int32, Int32)).new(producers * per)
      expected = Array(Int32).new(producers, 0)
      group do |g|
        handles = [] of IyiTask(Int32)
        producers.times do |p|
          handles << g.spawn(unit: :new) do
            i = 0
            while i < per
              fan.put_now({p, i})
              i = i + 1
            end
            0
          end
        end
        (producers * per).times do
          got = fan.receive
          fail("now: a receive of what put_now sent answered #{got}") unless got.is_a?(Tuple(Int32, Int32))
          who = got[0]
          fail("now: producer #{who} put #{got[1]} where #{expected[who]} was next") unless got[1] == expected[who]
          expected[who] = expected[who] + 1
        end
        handles.each do |handle|
          answer = handle.value
          fail("now: a producer answered #{answer.is_a?(Panicked) ? answer.text : answer}") unless answer == 0
        end
      end
      fail("now: values left in the channel after #{producers * per} were taken") if fan.receive_ready?
      puts "now: #{9 * rounds} places claimed and freed with take_now from 8 workers and the main thread, #{producers * per} values put_now from #{producers} workers taken once each in each one's order"
    end
  end

  # Two workers take from one channel. The copy-only hook holds the first
  # inside shift_item until the second either observes its lock held or
  # stores the count without that lock.
  def now_forced(watch : Int32) : Nil
    watched("now", watch) do
      places = Channel(Int32).new(2)
      places.send(0)
      places.send(1)
      {% if flag?(:now_force) %}
        IyiScheduler.force_now_arm(places.lock_address)
      {% end %}
      group do |g|
        g.spawn(unit: :new) do
          places.take_now
          0
        end
        {% if flag?(:now_force) %}
          started = __iyi_monotonic_ns
          while !IyiScheduler.force_now_entered?
            sleep(1)
            progress_hang("now: progress hang: the first take did not reach its held count") if elapsed_ms(started) >= watch.to_i64
          end
        {% end %}
        g.spawn(unit: :new) do
          places.take_now
          0
        end
      end
      fail("now: a place is still held after both takes") if places.receive_ready?
      puts "now: two takes from one full channel on two workers left no place held"
    end
  end

  # Entered and released by atomic words entirely inside a NoPreempt hold,
  # so each arrival holds its worker until the cue has been published.
  @[NoInline]
  @[NoPreempt]
  def hold_for(begun : Tally, cue : Tally) : Nil
    begun.add(1_i64)
    while cue.count == 0_i64
      IyiThread.spin_pause
    end
  end

  # A cancel reaches a task on another thread: asleep, parked on a
  # channel, and still waiting in the pool to start. The pool is filled
  # first: with it grown to the work instead, a copy that delivers no
  # cancel to another thread passed the step.
  #
  # The failure comes only once each task waits where the step says, and
  # the main thread looks before it cues it: the sleeper listed in a
  # worker's sleep heap (`IyiFiber#listed_on`), the waiter parked on its
  # channel, and the local task asleep on this thread - `unit: :same`, as
  # a plain spawn of a block that captures nothing is a parallel task now
  # (SPEC.md III.4.15). The failing task holds its worker from before the
  # sleeper is spawned (`hold_for`), so that heap is another thread's. Both
  # sleeps are then ended only by a cancel posted to the thread that holds
  # them (`post_cancel`). With a 100 ms sleep for the cue instead, a copy
  # that posts nothing passed in 19 runs of 20 beside 12 busy loops on
  # Linux's 12 vCPUs: the plain spawn ran on the pool, and in most runs the
  # sleeper, it and the failing task were on one worker, whose cancel ends
  # its own sleeps without a post.
  def cancel(watch : Int32) : Nil
    progress_hang("cancel: setup: watch must leave room for the sleeping tasks") if watch <= 0 || watch > 2_147_473_647
    fill_pool(watch)
    watched("cancel", watch) do
      never = Channel(Int32).new
      begun = Tally.new
      cue = Tally.new
      owner = Tally.new
      local_started = Tally.new
      failed = Tally.new
      slept = 0
      parked = 0
      pinned = 0
      group do |g|
        g.spawn(unit: :new) do
          hold_for(begun, cue)
          if owner.sum.to_u64 == thread_here
            fail("cancel: the sleeper went to sleep on the worker the failing task held")
          end
          failed.add(__iyi_monotonic_ns)
          Boom.new
        end
        while begun.count == 0_i64
          sleep(1)
        end
        sleep_ms = watch + 10_000
        sleeper = g.spawn(unit: :new) do
          sleep_started = __iyi_monotonic_ns
          result = sleep(sleep_ms)
          unless result.is_a?(Cancelled)
            progress_hang("cancel: progress hang: the remote sleep expired before cancellation") if elapsed_ms(sleep_started) >= sleep_ms.to_i64
            fail("cancel: the remote sleep returned before its deadline without cancellation")
          end
          1
        end
        waiter = g.spawn(unit: :new) { never.receive.is_a?(Cancelled) ? 1 : 0 }
        local = g.spawn(unit: :same) do
          local_started.add(1_i64)
          sleep_started = __iyi_monotonic_ns
          result = sleep(sleep_ms)
          unless result.is_a?(Cancelled)
            progress_hang("cancel: progress hang: the local sleep expired before cancellation") if elapsed_ms(sleep_started) >= sleep_ms.to_i64
            fail("cancel: the local sleep returned before its deadline without cancellation")
          end
          1
        end
        started = __iyi_monotonic_ns
        # The channel's locked readiness checks its receiver's atomic wake
        # word. The same-thread child can publish local_started and return
        # control here only by entering its sleep.
        while sleeper.fiber.listed_on == 0_u64 || !never.send_ready? || local_started.count == 0_i64
          sleep(1)
          progress_hang("cancel: progress hang: the siblings did not park") if elapsed_ms(started) >= watch.to_i64
        end
        {% if flag?(:undelivered_force) %}
          IyiScheduler.force_post_target(sleeper.fiber)
        {% end %}
        owner.add(sleeper.fiber.listed_on.to_i64)
        cue.add(1_i64)
        got = sleeper.value
        slept = got.is_a?(Int32) ? got : -1
        got = waiter.value
        parked = got.is_a?(Int32) ? got : -1
        got = local.value
        pinned = got.is_a?(Int32) ? got : -1
      end
      took = elapsed_ms(failed.sum)
      fail("cancel: a task asleep on another thread was not cancelled") unless slept == 1
      fail("cancel: a task parked on a channel on another thread was not cancelled") unless parked == 1
      fail("cancel: a task on the spawning thread was not cancelled by a parallel failure") unless pinned == 1

      # More tasks than workers are spawned before the failure. Every
      # sibling must answer Cancelled, whether it started or is still in
      # the pool. cancel_unstarted holds every worker to prove the latter.
      started = __iyi_monotonic_ns
      waited = Tally.new
      go = Channel(Int32).new
      group do |g|
        g.spawn(unit: :new) do
          go.receive
          Boom.new
        end
        (IyiWorkers.count * 8).times do
          g.spawn(unit: :new) do
            waited.add(1_i64) unless never.receive.is_a?(Cancelled)
            0
          end
        end
        go.send(1)
      end
      queued = elapsed_ms(started)
      fail("cancel: #{waited.count} sibling tasks ran uncancelled") if waited.count > 0
      puts "cancel: a failure on the pool cancelled a sleeper and a channel waiter on other threads, a task on this one, and #{IyiWorkers.count * 8} siblings"
      puts "measure: cancel: cross-thread #{took} ms, siblings #{queued} ms; former 3000 ms bounds OPEN and informational"
    end
  end

  # The unstarted tasks a cancel must reach. Four NoPreempt holders occupy
  # every worker (the pool is four: `IyiWorkers.count = 4` in main), so the
  # 32 children spawned after them never start: each has no home and waits in
  # the pool. The group's cancel must flag them while they wait. The holders
  # are released after the cancel. Their flags are read before release, so
  # the verdict does not depend on a child starting or sleeping.
  def cancel_unstarted(watch : Int32) : Nil
    watched("cancel", watch) do
      begun = Tally.new
      cue = Tally.new
      missed = 0_i64
      children = IyiWorkers.count * 8
      group do |g|
        IyiWorkers.count.times do
          g.spawn(unit: :new) do
            hold_for(begun, cue)
            0
          end
        end
        started = __iyi_monotonic_ns
        while begun.count < IyiWorkers.count.to_i64
          sleep(1)
          progress_hang("cancel: progress hang: the holders did not take every worker within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
        end
        handles = [] of IyiTask(Int32)
        children.times do
          child = g.spawn(unit: :new) { 0 }
          handles << child
        end
        handles.each do |child|
          fail("cancel: a pool child started before cancellation") unless child.fiber.home.is_a?(Nil)
        end
        g.cancel_children
        handles.each do |child|
          missed = missed + 1_i64 unless child.fiber.cancelled
        end
        cue.add(1_i64)
      end
      fail("cancel: #{missed} tasks waiting in the pool ran uncancelled") if missed > 0
      puts "cancel: #{children} tasks waiting in the pool were cancelled before any started"
    end
  end

  # A panic stops at the task's boundary, on whatever thread it ran: the
  # handle answers `Panicked`, its siblings finish.
  def panics(watch : Int32) : Nil
    watched("panics", watch) do
      fine = 0
      text = ""
      group do |g|
        bad = g.spawn(unit: :new) do
          raise "parallel boom"
        end
        good = g.spawn(unit: :new) { 2 }
        answer = bad.value
        text = answer.is_a?(Panicked) ? answer.text : "not a panic: #{answer}"
        other = good.value
        fine = other.is_a?(Int32) ? other : -1
      end
      fail("panics: a panicking parallel task answered #{text}") unless text == "parallel boom"
      fail("panics: its sibling answered #{fine}") unless fine == 2
      puts "panics: a parallel task's panic arrived as Panicked(\"#{text}\") and its sibling finished"
    end
  end

  # The duplicate-steal copy starts all four workers before arming the
  # victim. The first thief waits after unlocking the scheduler, so another
  # already-started worker must be available to make the second look.
  {% if flag?(:duplicate_force) %}
    @[NoInline]
    @[NoPreempt]
    def steal_prime(ready : Tally, release : Tally) : Nil
      ready.add(1_i64)
      limit = __iyi_monotonic_ns + 20_000_000_000_i64
      while release.count == 0_i64
        IyiThread.spin_pause
        if __iyi_monotonic_ns > limit
          end_run(76, 1, "FAIL: steal: progress hang: a worker was not released after pool startup\n")
        end
      end
    end
  {% end %}

  # Keep the spawner on its worker from arming through the first child's
  # arrival. A different worker must therefore have taken that child.
  @[NoInline]
  @[NoPreempt]
  def steal_spawn(tally : Tally, elsewhere : Tally) : Int64
    home = thread_here
    {% if flag?(:duplicate_force) %}
      IyiWorkers.force_dup_arm(IyiScheduler.state)
    {% end %}
    group do |inner|
      64.times do |i|
        inner.spawn(unit: :new) do
          spin(1_000_000_i64, (i + 7).to_u64)
          elsewhere.add(1_i64) unless thread_here == home
          tally.add(1_i64)
          0
        end
      end
      started = __iyi_monotonic_ns
      while elsewhere.count == 0_i64
        IyiThread.spin_pause
        if elapsed_ms(started) >= 20_000_i64
          end_run(76, 1, "FAIL: steal: progress hang: no child ran on another worker while the spawner held its worker\n")
        end
      end
      elapsed_ms(started)
    end
  end

  # Each child starts once. In the forced copy, the first thief stays in
  # take_queued after unlocking until another worker looks at this victim.
  def steal(watch : Int32) : Nil
    watched("steal", watch) do
      {% if flag?(:duplicate_force) %}
        ready = Tally.new
        release = Tally.new
        group do |priming|
          IyiWorkers.count.times do
            priming.spawn(unit: :new) do
              steal_prime(ready, release)
              0
            end
          end
          started = __iyi_monotonic_ns
          while ready.count < IyiWorkers.count.to_i64
            sleep(1)
            if elapsed_ms(started) >= 10_000_i64
              end_run(76, 1, "FAIL: steal: progress hang: not every worker started for the second look\n")
            end
          end
          release.add(1_i64)
        end
      {% end %}
      before = IyiWorkers.steals
      tally = Tally.new
      elsewhere = Tally.new
      waited_ms = 0_i64
      group do |g|
        spawner = g.spawn(unit: :new) do
          steal_spawn(tally, elsewhere)
        end
        answer = spawner.value
        waited_ms = answer.is_a?(Int64) ? answer : -1_i64
      end
      {% if flag?(:duplicate_force) %}
        progress_hang("steal: not armed: no second worker looked at the targeted victim") if IyiWorkers.force_dup_seconds == 0_u64
        fail("steal: the second steal found the first task still in its victim's queue") if IyiWorkers.force_dup_stale != 0_u64
        puts "steal: a second steal found the task the first took gone from its victim's queue"
      {% end %}
      stolen = IyiWorkers.steals - before
      fail("steal: #{tally.count} of 64 children ran") unless tally.count == 64_i64
      if IyiWorkers.count > 1
        fail("steal: no worker took a task another worker's task had spawned") if stolen == 0_u64
      end
      puts "steal: 64 tasks one parallel task spawned ran once each, #{elsewhere.count} on other workers, #{stolen} stolen, the first after #{waited_ms} ms"
    end
  end

  # The forced copy targets the joining fiber and its home. Its worker waits
  # until that home is idle, then the copy records the post and ring decision.
  def home_wake(watch : Int32) : Nil
    watched("home", watch) do
      {% if flag?(:lostwake_force) %}
        IyiScheduler.force_home_arm(IyiScheduler.state, IyiScheduler.current)
      {% end %}
      group do |g|
        g.spawn(unit: :new) do
          {% if flag?(:lostwake_force) %}
            started = __iyi_monotonic_ns
            while !IyiScheduler.force_idle_seen?
              IyiThread.spin_pause
              progress_hang("home: progress hang: the main thread never went idle within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
            end
          {% end %}
          0
        end
      end
      {% if flag?(:lostwake_force) %}
        progress_hang("home: not armed: the targeted post and ring decision did not complete") unless IyiScheduler.force_home_completed?
        # A later post of the same root must not reopen the completed proof.
        IyiScheduler.force_home_post(IyiScheduler.state, IyiScheduler.current)
        IyiScheduler.force_home_done(IyiScheduler.state, IyiScheduler.current)
      {% end %}
      puts "home: a task finished on a worker and woke the main thread it was joined by"
    end
  end

  # Keep each list on its fiber's stack through an explicit global stop
  # and, with partitions, an explicit collection of its own partition.
  # Whether the allocation load alone triggers a local collection is not judged
  # here: this gate builds without -Dheap_partitions. It is proved by
  # bench/heap_local.iyi's inflight_check, which heap_local.sh runs with partitions
  # on each platform (heap22, darwin-heap22 and windows-heap22, on master pushes,
  # nightly and dispatch): 200,000 objects allocated on a pool unit with
  # collect_every_park off and no park, and partition_collections must advance.
  def collector(watch : Int32) : Nil
    watched("collector", watch) do
      stops = IyiThread.stops
      built = Channel(Int64).new
      go = Channel(Int64).new
      {% if flag?(:heap_partitions) %}
        locals = IyiHeap.local_collections
        own = 0_i64
        held = 0_u64
      {% end %}
      group do |g|
        handles = [] of IyiTask(Int64)
        8.times do |t|
          task = g.spawn(unit: :new) do
            head = nil.as(Node?)
            want = 0_i64
            i = 0_i64
            while i < 150000_i64
              value = i &* (t.to_i64 + 3_i64)
              head = Node.new(value, head)
              want = want &+ value
              i = i + 1_i64
            end
            garbage = 0_u64
            quarter = IyiMark.budget // 4_u64
            while garbage < quarter
              Pointer(UInt8).malloc(64_u64).value = 1_u8
              garbage = garbage + 64_u64
            end
            sleep(1)
            {% if flag?(:heap_partitions) %}
              built.send(IyiScheduler.current.alloc != 0_u64 ? 1_i64 : 0_i64)
            {% else %}
              built.send(0_i64)
            {% end %}
            go.receive
            {% if flag?(:heap_partitions) %}
              record = IyiScheduler.current.alloc
              if record != 0_u64
                before_local = IyiHeap.partition_collections(record)
                IyiHeap.collect_local(record)
                progress_hang("collector: not armed: a local collection did not finish") if IyiHeap.partition_collections(record) == before_local
              end
              built.send(record != 0_u64 ? 1_i64 : 0_i64)
              go.receive
            {% end %}
            have = 0_i64
            node = head
            while node.is_a?(Node)
              have = have &+ node.value
              node = node.next_node
            end
            have == want ? 0_i64 : want - have
          end
          handles << task
        end
        8.times do
          answer = built.receive
          {% if flag?(:heap_partitions) %}
            own = own &+ answer if answer.is_a?(Int64)
          {% end %}
        end
        {% if flag?(:heap_partitions) %}
          held = IyiHeap.local_collections - locals
          puts "measure: collector: #{held} local collections under allocation; automatic trigger is OPEN and informational"
        {% end %}
        IyiMark.collect
        8.times { go.send(1_i64) }
        {% if flag?(:heap_partitions) %}
          8.times { built.receive }
          held = IyiHeap.local_collections - locals
          fail("collector: #{own} of 8 parallel tasks built their lists in partitions of their own, and no local collection ran") if own != 0_i64 && held == 0_u64
          8.times { go.send(1_i64) }
        {% end %}
        handles.each_with_index do |handle, t|
          lost = handle.value
          fail("collector: task #{t}'s list lost #{lost} by checksum") unless lost == 0_i64
        end
      end
      {% if flag?(:heap_partitions) %}
        fail("collector: no collection stopped a thread while 8 parallel tasks held their lists, #{IyiThread.program_threads} threads registered") if IyiThread.stops == stops
        puts "collector: 8 parallel tasks kept lists of 150000 nodes, #{own} in partitions of their own, through #{held} local collections and #{IyiThread.stops - stops} stops, #{IyiThread.program_threads} threads registered"
      {% else %}
        fail("collector: no collection stopped a thread while 8 parallel tasks allocated, #{IyiThread.program_threads} threads registered under a #{IyiMark.budget}-byte budget") if IyiThread.stops == stops
        puts "collector: 8 parallel tasks kept lists of 150000 nodes through #{IyiThread.stops - stops} stops, #{IyiThread.program_threads} threads registered under a #{IyiMark.budget}-byte budget"
      {% end %}
    end
  end

  # The typed group (III.4.9) answers parallel tasks' tuple.
  def typed : Tuple(Int32, String) | Panicked
    group do |g|
      a = g.spawn(unit: :new) { 6 * 7 }
      b = g.spawn(unit: :new) { "parallel" }
    end!
  end

  def typed_step(watch : Int32) : Nil
    watched("typed", watch) do
      answer = typed
      fail("typed: the group answered #{answer}") unless answer.is_a?(Tuple(Int32, String)) && answer[0] == 42 && answer[1] == "parallel"
      puts "typed: group ... end! answered #{answer} from two parallel tasks"
    end
  end

  # Turns two tasks take on one word, for the wakes step: `park_on` and
  # `wake_on` take its address, which only atomics reach, as std/mutex's
  # word is.
  @[Share(owns: true)]
  class Turns
    @word : Atomic(UInt64)

    def initialize
      @word = Atomic(UInt64).new(0_u64)
    end

    def word : Pointer(Atomic(UInt64))
      pointerof(@word)
    end
  end

  # Receives from either channel until one is closed, with a timeout arm
  # beside them, so three wakers race for each park: a send on *a*, a
  # send on *b*, the deadline.
  def select_both(a : Channel(Int64), b : Channel(Int64), got : Tally) : Int32
    while true
      closed = false
      select
      when x = a.receive
        if x.is_a?(Int64)
          got.add(x)
        else
          closed = true
        end
      when y = b.receive
        if y.is_a?(Int64)
          got.add(y)
        else
          closed = true
        end
      when timeout(1)
        closed = false
      end
      return 0 if closed
    end
    0
  end

  def send_run(channel : Channel(Int64), first : Int64, count : Int64) : Int32
    i = 0_i64
    while i < count
      return 1 unless channel.send(first + i).nil?
      i = i + 1_i64
    end
    0
  end

  # A child parked on a channel nobody sends on, cancelled the moment it
  # has started, so the cancel lands as it parks; *ended* counts it if
  # its receive answered `Cancelled`.
  def cancel_as_parked(ended : Tally) : Nil
    started = Tally.new
    never = Channel(Int32).new
    group do |inner|
      inner.spawn(unit: :new) do
        started.add(1_i64)
        ended.add(1_i64) if never.receive.is_a?(Cancelled)
        0
      end
      while started.count == 0_i64
        IyiThread.spin_pause
      end
      inner.cancel_children
    end
  end

  # The parked side of the turns: odd turns are its own, and it parks on
  # the word whenever the turn is not.
  def parked_turns(turns : Turns, rounds : Int64) : Int32
    word = turns.word
    done = 0_i64
    while done < rounds
      seen = word.value.get
      if seen % 2_u64 == 0_u64
        IyiScheduler.park_on(word, seen, false)
        next
      end
      word.value.set(seen + 1_u64)
      IyiScheduler.wake_on(word, 1)
      done = done + 1_i64
    end
    0
  end

  {% if flag?(:lostword_force) %}
  def lost_word_decision(watch : Int32) : Nil
    started = __iyi_monotonic_ns
    while IyiScheduler.forced_link == 0_u64
      IyiThread.spin_pause
      progress_hang("wakes, words: progress hang: the forced waiter recorded no link in #{watch} ms") if elapsed_ms(started) >= watch.to_i64
    end
    if IyiScheduler.forced_link == 2_u64
      fail("wakes, words: the forced first wake was lost before its waiter linked")
    end
    progress_hang("wakes, words: not armed: the first wake did not claim the linked waiter") unless IyiScheduler.forced_scan == 2_u64
    puts "wakes, words: the forced first wake claimed the waiter that linked before its scan"
  end
  {% end %}

  # The other side, on the main thread, which is no worker: it never
  # parks, but looks at the word until its turn comes, so it takes the
  # turn the moment the parked side hands it over - while that side looks
  # at the word again and parks - and its wake lands between a park's
  # look and its link as often as a race can make it. The main thread's
  # watchdog cannot run while it looks, so it names a turn that never
  # comes itself. The copy that looks outside the lock is not left to that
  # race: under -Dlostword_force its parked side waits in the window until
  # this side's first wake has passed, so the first turn is handed over
  # only once the parked side is there (bench/parallel_exercise.sh,
  # lostword). Unforced, the race was caught in 10 runs of 10 on Linux
  # x86_64, and in two of nine Namespace macOS jobs 5 runs of 5 each
  # handed every turn (134616549649, 134738824347).
  def spun_turns(turns : Turns, rounds : Int64, watch : Int32) : Nil
    word = turns.word
    done = 0_i64
    {% if flag?(:lostword_force) %}
      # Held until the parked side is in its window, which the copy's
      # `force_lost_wake_on` arranges: the first turn is handed over only
      # then. If the parked side never gets there, the watch names it.
      waited_since = __iyi_monotonic_ns
      while !IyiScheduler.forced_in_window?
        IyiThread.spin_pause
        progress_hang("wakes, words: progress hang: the parked side never reached its park in #{watch} ms") if elapsed_ms(waited_since) >= watch.to_i64
      end
    {% end %}
    while done < rounds
      seen = word.value.get
      if seen % 2_u64 == 1_u64
        started = __iyi_monotonic_ns
        while word.value.get == seen
          IyiThread.spin_pause
          if elapsed_ms(started) >= watch.to_i64
            puts "wakes, words: turn #{seen + 1_u64} was not taken in #{watch} ms"
            # A deadline is a progress failure, never the mutant verdict.
            progress_hang("wakes, words: progress hang: an unexpected turn was not taken")
          end
        end
        next
      end
      word.value.set(seen + 1_u64)
      IyiScheduler.wake_on(word, 1)
      {% if flag?(:lostword_force) %}
        lost_word_decision(watch) if done == 0_i64
      {% end %}
      done = done + 1_i64
    end
  end

  # The copy's window, forced: `force_window_hold` holds a parked task between
  # its look at its word and its wait, until the program lets it go. The main
  # thread cancels the task while it is held there, and only a cancel that
  # claims the park can end it. Built only under -Dlostcancel_force.
  def cancel_in_window(ended : Tally, watch : Int32) : Nil
    {% if flag?(:lostcancel_force) %}
      never = Channel(Int32).new
      group do |inner|
        task = inner.spawn(unit: :new) do
          IyiScheduler.force_window_arm(IyiScheduler.current)
          ended.add(1_i64) if never.receive.is_a?(Cancelled)
          0
        end
        started = __iyi_monotonic_ns
        while !IyiScheduler.force_window_held?
          sleep(1)
          progress_hang("wakes, cancels: progress hang: the task never reached its park's window within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
        end
        inner.cancel_children
        progress_hang("wakes, cancels: not armed: the targeted cancellation did not set its flag") unless task.fiber.cancelled
        IyiScheduler.force_window_release
        started = __iyi_monotonic_ns
        while IyiScheduler.force_window_result == 0_u64
          sleep(1)
          {% unless flag?(:copy_hook_watchdog) %}
            progress_hang("wakes, cancels: progress hang: the targeted suspend decision did not complete") if elapsed_ms(started) >= watch.to_i64
          {% end %}
        end
        fail("wakes, cancels: the targeted suspend omitted the cancelled claim") if IyiScheduler.force_window_result == 2_u64
        puts "wakes, cancels: the targeted suspend claimed its cancellation"
      end
    {% end %}
  end

  # Wakes that race, now that each channel and each list `park_on` waits
  # in has a lock of its own and a parked fiber's wake goes to whichever
  # waker claims it (`IyiFiber#claim`). Selects parked on two channels
  # and a deadline at once, sent to from four workers: each value
  # arrives exactly once. Cancels landing as tasks park on a channel:
  # each task ends cancelled, which a cancel between the park's look at
  # its flag and its wake word does only if the park looks again
  # (`IyiScheduler.suspend`). Tasks handing turns through a word with
  # `park_on` and `wake_on`: every turn is taken, which a wake between
  # the look at the word and the link in its list does only if the look
  # is under the list's lock. A lost wake is a hang the watchdogs name;
  # bench/parallel_exercise.sh breaks each of the three, and runs each
  # copy's own part alone (`--only=`): beside 12 busy loops at a load of
  # 45 the cancels outran a 5000 ms watch in the copy that breaks the
  # words, so the words were never reached.
  def wakes(watch : Int32, parts : Array(String)) : Nil
    per = 20000_i64
    want = 0_i64
    got = Tally.new
    if parts.includes?("selects")
      watched("wakes, selects", watch) do
        a = Channel(Int64).new
        b = Channel(Int64).new
        group do |g|
          2.times { g.spawn(unit: :new) { select_both(a, b, got) } }
          senders = [] of IyiTask(Int32)
          4.times do |k|
            channel = k % 2 == 0 ? a : b
            first = k.to_i64 * per
            senders << g.spawn(unit: :new) { send_run(channel, first, per) }
          end
          senders.each do |sender|
            answer = sender.value
            fail("wakes: a sender answered #{answer.is_a?(Panicked) ? answer.text : answer}") unless answer == 0
          end
          a.close
          b.close
        end
        want = 4_i64 * per * (4_i64 * per - 1_i64) // 2_i64
        fail("wakes: selects over two channels received #{got.count} of #{4_i64 * per} values sent, summing #{got.sum} for #{want}") unless got.count == 4_i64 * per && got.sum == want
      end
    end

    # A select with two arms and no timeout parks on both channels; the main
    # thread hands it a value once it is parked, and closes the channel. A
    # value handed to a parked select is the select's: the sender marks the
    # receiver's node handed, and a select woken without that mark takes no
    # arm and parks again, so the value is lost.
    if parts.includes?("handed")
      watched("wakes, selects", watch) do
        a = Channel(Int64).new
        b = Channel(Int64).new
        group do |g|
          chooser = g.spawn(unit: :new) do
            taken = -3_i64
            select
            when x = a.receive
              taken = x.is_a?(Int64) ? x : -1_i64
            when y = b.receive
              taken = y.is_a?(Int64) ? y : -2_i64
            end
            taken
          end
          started = __iyi_monotonic_ns
          # The unbuffered channel can accept a send only when the select's
          # receiver node is linked and its atomic wake word is current.
          while !a.send_ready? || !b.send_ready?
            sleep(1)
            progress_hang("wakes, selects: progress hang: the select did not park on its two channels within #{watch} ms") if elapsed_ms(started) >= watch.to_i64
          end
          a.send(42_i64)
          a.close
          handed_answer = chooser.value
          unless handed_answer == 42_i64
            puts "wakes, selects: the select answered #{handed_answer}"
            fail("wakes, selects: a value handed to a parked select was not received")
          end
        end
      end
    end

    # Half the workers spin waiting for their child to start, so the
    # other half are there to start it: four spinners on four workers
    # left each child to wait for a preemption.
    tasks = IyiWorkers.count // 2 < 1 ? 1 : IyiWorkers.count // 2
    rounds = 2000
    ended = Tally.new
    if parts.includes?("cancels")
      watched("wakes, cancels", watch) do
        {% if flag?(:lostcancel_force) %}
          cancel_in_window(ended, watch)
          fail("wakes: #{ended.count} of 1 tasks cancelled in their park's window answered Cancelled") unless ended.count == 1_i64
        {% else %}
          group do |g|
            tasks.times do
              g.spawn(unit: :new) do
                round = 0
                while round < rounds
                  cancel_as_parked(ended)
                  round = round + 1
                end
                0
              end
            end
          end
          fail("wakes: #{ended.count} of #{tasks * rounds} tasks cancelled as they parked answered Cancelled") unless ended.count == tasks.to_i64 * rounds
        {% end %}
      end
    end

    turns_each = 20000_i64
    if parts.includes?("words")
      turns = Turns.new
      {% if flag?(:lostword_force) %}
        IyiScheduler.force_lost_wake_on(turns.word)
      {% end %}
      group do |g|
        parker = g.spawn(unit: :new) { parked_turns(turns, turns_each) }
        spun_turns(turns, turns_each, watch)
        answer = parker.value
        fail("wakes: the parked side answered #{answer.is_a?(Panicked) ? answer.text : answer}") unless answer == 0
      end
    end
    puts "wakes: #{got.count} values through selects over two channels and a deadline, each once; #{ended.count} tasks cancelled as they parked; #{parts.includes?("words") ? turns_each * 2_i64 : 0_i64} turns handed through park_on and wake_on"
  end

  # The sentence every ending prints after the `FAIL: ` that end_run writes.
  def ending_what : String
    "ending: progress hang: five watchdogs reached one deadline together"
  end

  # Every participant reaches the claim boundary before any may proceed.
  @[NoInline]
  @[NoPreempt]
  def ending_wait_all(reached : Tally) : Nil
    reached.add(1_i64)
    started = __iyi_monotonic_ns
    while reached.count < 5_i64
      end_run(76, 1, "FAIL: ending: setup: all five racers did not reach the ending in 10000 ms\n") if __iyi_monotonic_ns - started >= 10_000_000_000_i64
      IyiThread.spin_pause
    end
  end

  # kind 0 takes its list lock, 1 the scheduler lock, 2 the runtime lock, 3 nothing:
  # in turn, the runtime's own lock order, so no runtime thread is caught between two.
  @[NoInline]
  @[NoPreempt]
  def ending_racer(kind : Int32, ready : Tally, go : Tally, armed : Tally, fire : Tally, reached : Tally) : Nil
    ready.add(1_i64)
    while go.count == 0_i64 || armed.count < kind.to_i64
      IyiThread.spin_pause
    end
    if kind == 0
      IyiScheduler.lists_lock(IyiScheduler.state)
    elsif kind == 1
      IyiSchedLock.lock
    elsif kind == 2
      IyiRuntimeLock.lock
    end
    armed.add(1_i64)
    while fire.count == 0_i64
      IyiThread.spin_pause
    end
    ending_wait_all(reached)
    {% if flag?(:ending_hook) %}
      IyiScheduler.force_end_now if kind == 1
    {% end %}
    end_run(76, 1, "FAIL: ", ending_what, "\n")
  end

  @[NoInline]
  @[NoPreempt]
  def ending_fire(go : Tally, armed : Tally, fire : Tally, reached : Tally) : Nil
    go.add(1_i64)
    since = __iyi_monotonic_ns
    while armed.count < 4_i64
      end_run(76, 1, "FAIL: ending: not armed: the four racers did not take their locks in 10000 ms\n") if __iyi_monotonic_ns - since >= 10_000_000_000_i64
      IyiThread.spin_pause
    end
    fire.add(1_i64)
    ending_wait_all(reached)
    end_run(76, 1, "FAIL: ", ending_what, "\n")
  end

  def ending_race : Nil
    {% if flag?(:ending_hook) %}
      hook_claimed = IyiScheduler.force_end_claim
      fixture_claimed = RunEnd.claim
      IyiScheduler.force_end_reset
      RunEnd.reset_for_test
      unless hook_claimed && !fixture_claimed
        end_run(76, 1, "FAIL: ending: setup: the runtime hook and fixture did not share one ending claim\n")
      end
    {% end %}
    ready = Tally.new
    go = Tally.new
    armed = Tally.new
    fire = Tally.new
    reached = Tally.new
    group do |g|
      4.times do |kind|
        g.spawn(unit: :new) do
          ending_racer(kind, ready, go, armed, fire, reached)
          0
        end
      end
      started = __iyi_monotonic_ns
      while ready.count < 4_i64
        sleep(1)
        end_run(76, 1, "FAIL: ending: setup: the four racers did not take the four workers in 20000 ms\n") if elapsed_ms(started) >= 20000_i64
      end
      ending_fire(go, armed, fire, reached)
    end
  end

  STEPS = ["placement", "exactly_once", "race", "race_forced", "channels", "now", "now_forced", "cancel", "cancel_unstarted", "panics", "steal", "home", "collector", "typed", "wakes"]

  arguments = Program.args
  if !arguments.empty? && arguments[0] == "capacity"
    progress_hang("capacity: setup: expected one positive worker count") unless arguments.size == 2
    workers = arguments[1].to_i?
    progress_hang("capacity: setup: worker count must be a positive integer") unless workers.is_a?(Int32) && workers > 0
    capacity(workers)
  elsif arguments.size == 4 && arguments[0] == "speed"
    workers = arguments[1].to_i?
    tasks = arguments[2].to_i?
    rounds = arguments[3].to_i?
    progress_hang("speed: setup: workers, tasks and rounds must be positive integers") unless workers.is_a?(Int32) && workers > 0 && tasks.is_a?(Int32) && tasks > 0 && rounds.is_a?(Int32) && rounds > 0
    speed(workers, tasks, rounds.to_i64)
  elsif arguments.size == 1 && arguments[0] == "ending"
    IyiWorkers.count = 4
    ending_race
  else
    watch = 60000
    parts = ["selects", "handed", "cancels", "words"]
    chosen = [] of String
    arguments.each do |argument|
      if argument.starts_with?("--watch=")
        value = argument[8, argument.size - 8].to_i?
        progress_hang("setup: watch must be a positive integer") unless value.is_a?(Int32) && value > 0
        watch = value
      elsif argument.starts_with?("--only=")
        parts = [argument[7, argument.size - 7]]
        progress_hang("wakes: setup: no part named #{parts[0]}") unless ["selects", "handed", "cancels", "words"].includes?(parts[0])
      else
        progress_hang("setup: no step named #{argument}") unless STEPS.includes?(argument)
        chosen << argument
      end
    end
    chosen = STEPS if chosen.empty?
    IyiWorkers.count = 4
    chosen.each do |name|
      case name
      when "placement"    then placement(watch)
      when "exactly_once" then exactly_once(watch)
      when "race"         then race(watch)
      when "channels"     then channels(watch)
      when "now"          then now_halves(watch)
      when "cancel"       then cancel(watch)
      when "panics"       then panics(watch)
      when "steal"        then steal(watch)
      when "collector"    then collector(watch)
      when "typed"        then typed_step(watch)
      when "wakes"        then wakes(watch, parts)
      when "race_forced"      then race_forced(watch)
      when "now_forced"       then now_forced(watch)
      when "cancel_unstarted" then cancel_unstarted(watch)
      when "home"             then home_wake(watch)
      end
    end
    puts "parallel exercise: every property held on #{IyiWorkers.count} workers"
  end
{% else %}
  puts "parallel exercise: no pool on this target, nothing to hold"
{% end %}
