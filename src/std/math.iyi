    0x3bc50783487e6b5c_u64, 0xb85b77efed0f9c1f_u64, 0xbaae306ec8cf7c02_u64, 0x3745d2601f85289a_u64,
  ]

  # as_lgamma_asym_accurate, x >= 48, >= 14.5, below
  private LGAMMA_ASYMACC_C48 = [
    0x3fdacfe390c97d69_u64, 0x3c73494bc9001766_u64, 0x3fb5555555555555_u64, 0x3c555555554133c7_u64,
    0xbf66c16c16c16c17_u64, 0x3bff4c03199d8517_u64, 0x3f4a01a01a01a016_u64, 0x3bdfb315e77b4883_u64,
    0xbf4381381380c1b0_u64, 0xbbec4cc418316ed1_u64, 0x3f4b951e22dd8dfc_u64, 0x3bee8da392824ecf_u64,
    0xbf5f6a875bb1ab7b_u64, 0x3bf27c5fcbab6b5d_u64, 0x3f7a0a6926f49920_u64, 0xbc01f355cbf82229_u64,
  ]

  private LGAMMA_ASYMACC_C14 = [
    0x3fdacfe390c97d69_u64, 0x3c73494bc9007f28_u64, 0x3fb5555555555555_u64, 0x3c55555554ad7655_u64,
    0xbf66c16c16c16c17_u64, 0x3bff4b73ea546bd4_u64, 0x3f4a01a01a01a01a_u64, 0xbbe464e31b1a609a_u64,
    0xbf43813813813692_u64, 0x3bd63676fd3c851e_u64, 0x3f4b951e2b143b5e_u64, 0x3becfe48021143d1_u64,
    0xbf5f6ab0d459cadb_u64, 0x3bf770df5ee0beea_u64, 0x3f7a41a211f4e098_u64, 0xbc0e00b3c1619519_u64,
    0xbf9e41f97ad4634d_u64, 0x3c305ffdbc72560f_u64, 0x3fc6f15ef2b47719_u64, 0xbc65665cba69dbaa_u64,
    0xbff5762c9f49fe25_u64, 0x3c9afeff5294ad13_u64, 0x4022ea102098f818_u64, 0x3cc609db97f1bc89_u64,
  ]

  private LGAMMA_ASYMACC_C0 = [
    0x3fdacfe390c97d69_u64, 0x3c73494bce9b5c50_u64, 0x3fb5555555555555_u64, 0x3c555551a0d18a1d_u64,
    0xbf66c16c16c16c17_u64, 0x3c007171d4a61bb9_u64, 0x3f4a01a01a01a008_u64, 0xbbe49af39145d6e0_u64,
    0xbf438138138124cc_u64, 0xbbdb8f71068f5292_u64, 0x3f4b951e2b09b070_u64, 0xbbd3c8a4c099ae72_u64,
    0xbf5f6ab0d4de4a5c_u64, 0xbbefbb4ed542d17e_u64, 0x3f7a41a384fafd09_u64, 0x3bf1510cc5dec148_u64,
    0xbf9e4277d1a2b2e4_u64, 0x3c233cdd66b223e7_u64, 0x3fc6fdf731005805_u64, 0xbc6a5a3066922140_u64,
    0xbff641de6a9b2f1c_u64, 0x3c727cfac68728a3_u64, 0x402aa463d5553a9f_u64, 0x3cbaeba9a5b525f3_u64,
    0xc06312d3aa56b6a2_u64, 0xbcf2b2c4e643e5b9_u64, 0x409f3e8a4cd3d268_u64, 0xbd2ec8b086b0215e_u64,
    0xc0dba9362f228307_u64, 0x3d7b8ecae7dba56f_u64, 0x4118ed4df00421e4_u64, 0x3dbc620cd11f44a5_u64,
    0xc155af889993596d_u64, 0xbdf23a78dbbfe515_u64, 0x4191789aff6ddc93_u64, 0x3e2fe7e161d8bdb1_u64,
    0xc1c94353def0e5f8_u64, 0xbe664a798491c211_u64, 0x41fffb9253861b9c_u64, 0xbe8469d6acfea485_u64,
    0xc23159c1244c9ee4_u64, 0xbecf7491d4abcc7b_u64, 0x425f991ba9776c6a_u64, 0x3eccf2c83cfe2e55_u64,
    0xc28795f45ae3fa72_u64, 0xbf2a777148d59de4_u64, 0x42ac05845a910b48_u64, 0x3f4433e08525d4bd_u64,
    0xc2c96c399c145d71_u64, 0x3f4d495c9370dc8a_u64, 0x42e083bb9c79529b_u64, 0xbf71640e2de8cf9c_u64,
    0xc2eb53232e707f4b_u64, 0x3f76d239acd71b5c_u64, 0x42e59bad61bd81d5_u64, 0x3f80e3f2ea42a0e0_u64,
  ]

  # Double-double building blocks of glibc's dbl-64/ddcoremath.h (CORE-MATH).
  # Each returns the pair its C namesake returns through a pointer.
  private def self.gamma_at(c : Pointer(UInt64), k : Int32) : Float64
    IyiFloatText.from_bits(c[k])
  end

  private def self.gamma_fasttwosum(x : Float64, y : Float64) : {Float64, Float64}
    s = x + y
    z = s - x
    {s, y - z}
  end

  private def self.gamma_twosum(x : Float64, y : Float64) : {Float64, Float64}
    x.abs > y.abs ? gamma_fasttwosum(x, y) : gamma_fasttwosum(y, x)
  end

  private def self.gamma_fastsum(xh : Float64, xl : Float64, yh : Float64, yl : Float64) : {Float64, Float64}
    sh, sl = gamma_fasttwosum(xh, yh)
    {sh, (xl + yl) + sl}
  end

  private def self.gamma_sumdd(xh : Float64, xl : Float64, yh : Float64, yl : Float64) : {Float64, Float64}
    sh, sl = xh.abs > yh.abs ? gamma_fasttwosum(xh, yh) : gamma_fasttwosum(yh, xh)
    {sh, (xl + yl) + sl}
  end

  private def self.gamma_muldd2(xh : Float64, xl : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahhh = ch * xh
    {ahhh, (ch * xl + cl * xh) + fma(ch, xh, ahhh * -1.0)}
  end

  private def self.gamma_muldd3(xh : Float64, xl : Float64, yh : Float64, yl : Float64) : {Float64, Float64}
    ch = xh * yh
    cl1 = fma(xh, yh, ch * -1.0)
    tl0 = xl * yl
    tl1 = tl0 + xh * yl
    cl2 = tl1 + xl * yh
    gamma_fasttwosum(ch, cl1 + cl2)
  end

  private def self.gamma_mulddd2(x : Float64, ch : Float64, cl : Float64) : {Float64, Float64}
    ahhh = ch * x
    {ahhh, cl * x + fma(ch, x, ahhh * -1.0)}
  end

  # The polynomials read rows {hi, lo} of a table from row `row` on.
  private def self.gamma_polyddd(x : Float64, n : Int32, c : Pointer(UInt64), row : Int32, l : Float64) : {Float64, Float64}
    i = n - 1
    ch, cl = gamma_fasttwosum(gamma_at(c, 2 * (row + i)), l)
    cl = cl + gamma_at(c, 2 * (row + i) + 1)
    while i > 0
      i = i - 1
      ch, cl = gamma_mulddd2(x, ch, cl)
      ch, cl = gamma_sumdd(gamma_at(c, 2 * (row + i)), gamma_at(c, 2 * (row + i) + 1), ch, cl)
    end
    {ch, cl}
  end

  private def self.gamma_polydddfst(x : Float64, n : Int32, c : Pointer(UInt64), row : Int32, l : Float64) : {Float64, Float64}
    i = n - 1
    ch, cl = gamma_fasttwosum(gamma_at(c, 2 * (row + i)), l)
    cl = cl + gamma_at(c, 2 * (row + i) + 1)
    while i > 0
      i = i - 1
      ch, cl = gamma_mulddd2(x, ch, cl)
      ch, cl = gamma_fastsum(gamma_at(c, 2 * (row + i)), gamma_at(c, 2 * (row + i) + 1), ch, cl)
    end
    {ch, cl}
  end

  private def self.gamma_polydd2(xh : Float64, xl : Float64, n : Int32, c : Pointer(UInt64), row : Int32, l : Float64) : {Float64, Float64}
    i = n - 1
    ch, cl = gamma_fasttwosum(gamma_at(c, 2 * (row + i)), l)
    cl = cl + gamma_at(c, 2 * (row + i) + 1)
    while i > 0
      i = i - 1
      ch, cl = gamma_muldd2(xh, xl, ch, cl)
      ch, cl = gamma_fastsum(gamma_at(c, 2 * (row + i)), gamma_at(c, 2 * (row + i) + 1), ch, cl)
    end
    {ch, cl}
  end

  private def self.gamma_polyd(x : Float64, n : Int32, c : Pointer(UInt64), row : Int32) : Float64
    i = n - 1
    ch = gamma_at(c, 2 * (row + i))
    while i > 0
      i = i - 1
      ch = gamma_at(c, 2 * (row + i)) + x * ch
    end
    ch
  end

  # roundeven_finite: a tie to the even integer, the sign kept.
  private def self.gamma_roundeven(x : Float64) : Float64
    x.round
  end

  # Binary search of the exceptions {x, hi, lo}: hi + lo where x is one.
  private def self.gamma_database(db : Pointer(UInt64), count : Int32, x : Float64, f : Float64) : Float64
    a = 0
    b = count - 1
    m = (a + b) // 2
    while a <= b
      v = gamma_at(db, 3 * m)
      if v < x
        a = m + 1
      elsif v == x
        return gamma_at(db, 3 * m + 1) + gamma_at(db, 3 * m + 2)
      else
        b = m - 1
      end
      m = (a + b) // 2
    end
    f
  end

  # as_logd: log(x) as a double-double for x > 0, subnormals included (the
  # e_lgamma_r.c copy; e_gamma_r.c's differs only by lacking that case).
  private def self.gamma_logd(x : Float64) : {Float64, Float64}
    t = IyiFloatText.bits_of(x)
    ex = t.unsafe_shr(52_u64).unsafe_to_i32
    if ex == 0
      k = t.leading_zeros_count
      t = t.unsafe_shl((k - 11).unsafe_to_u64)
      ex = ex - (k - 12)
    end
    e = ex - 0x3ff
    t = t & 0x000fffffffffffff_u64
    ed = e.to_f64
    b = GAMMA_LOG_B.to_unsafe
    i = t.unsafe_shr(47_u64).unsafe_to_i32
    d = (t & 0x00007fffffffffff_u64).unsafe_to_i64
    j = (t &+ b[2 * i].unsafe_to_u64.unsafe_shl(33_u64) &+ (b[2 * i + 1] &* d.unsafe_shr(16_i64)).unsafe_to_u64).unsafe_shr(42_u64)
    t = t | 0x3ff0000000000000_u64
    i1 = j.unsafe_shr(5_u64).unsafe_to_i32
    i2 = (j & 0x1f_u64).unsafe_to_i32
    r = gamma_at(GAMMA_LOG_R1.to_unsafe, i1) * gamma_at(GAMMA_LOG_R2.to_unsafe, i2)
    tf = IyiFloatText.from_bits(t)
    o = r * tf
    dxl = fma(r, tf, o * -1.0)
    dxh = o - 1.0
    c = GAMMA_LOG_C.to_unsafe
    dx = fma(r, tf, -1.0)
    dx2 = dx * dx
    f = dx2 * ((gamma_at(c, 0) + dx * gamma_at(c, 1)) + dx2 * (gamma_at(c, 2) + dx * gamma_at(c, 3)))
    l1 = GAMMA_LOG_L1.to_unsafe
    l2 = GAMMA_LOG_L2.to_unsafe
    lt = (gamma_at(l1, 2 * i1 + 1) + gamma_at(l2, 2 * i2 + 1)) + ed * 0.6931471805437468
    lh = lt + dxh
    ll = (lt - lh) + dxh
    ll = ll + (((gamma_at(l1, 2 * i1) + gamma_at(l2, 2 * i2)) + 1.619851018665656e-11 * ed) + dxl)
    ll = ll + f
    {lh, ll}
  end

  # as_sinpid (e_gamma_r.c) and as_sinpipid (e_lgamma_r.c): sin(pi x) and
  # sin(pi x)/pi for x in [0, 1] from a table of 65 {lo, hi}; the latter
  # has its own expansion around 0 and 1 (`near`).
  private def self.gamma_sinpi(x : Float64, st : Pointer(UInt64), near : Bool) : {Float64, Float64}
    ax = (x - 0.5).abs
    sx = ax * 128.0
    ix = gamma_roundeven(sx)
    ky = ix.unsafe_to_i32
    kx = 64 - ky
    if near && kx < 2
      nc = LGAMMA_SINPI_NEAR.to_unsafe
      z = 0.5 - ax
      z2 = z * z
      z2l = fma(z, z, z2 * -1.0)
      fl = z2 * (gamma_at(nc, 2) + z2 * (gamma_at(nc, 3) + z2 * gamma_at(nc, 4)))
      fh, fl = gamma_fasttwosum(gamma_at(nc, 0), fl)
      fl = fl + gamma_at(nc, 1)
      fh, fl = gamma_muldd2(z2, z2l, fh, fl)
      fh, fl = gamma_mulddd2(z, fh, fl)
      fh, e = gamma_fasttwosum(z, fh)
      return {fh, fl + e}
    end
    d = ix - sx
    d2 = d * d
    sh = gamma_at(st, 2 * kx + 1)
    sl = gamma_at(st, 2 * kx)
    ch = gamma_at(st, 2 * ky + 1)
    cl = gamma_at(st, 2 * ky)
    c = GAMMA_SINPI_C.to_unsafe
    s = GAMMA_SINPI_S.to_unsafe
    pp = d2 * (gamma_at(c, 1) + d2 * (gamma_at(c, 2) + d2 * gamma_at(c, 3)))
    qq = d2 * (gamma_at(s, 1) + d2 * (gamma_at(s, 2) + d2 * gamma_at(s, 3)))
    qh, ql = gamma_fasttwosum(gamma_at(s, 0), qq)
    ql = ql + 9.567540887362087e-19
    ch, cl = gamma_muldd2(qh, ql, ch, cl)
    th, tl = gamma_fasttwosum(gamma_at(c, 0), pp)
    tl = tl + -1.912015617779642e-20
    th, tl = gamma_mulddd2(d, th, tl)
    ph, pl = gamma_muldd2(th, tl, sh, sl)
    ch, cl = gamma_fastsum(ch, cl, ph, pl)
    ch, cl = gamma_mulddd2(d, ch, cl)
    gamma_fastsum(sh, sl, ch, cl)
  end

  # e_gamma_r.c: split so that ulp(xh) = 2^-25.
  private def self.tgamma_splt(x : Float64) : {Float64, Float64}
    xh = (x + 201326592.0) - 201326592.0
    {xh, x - xh}
  end

  private def self.tgamma_sprod(x : Float64, x0 : Float64, x1 : Float64, x2 : Float64) : {Float64, Float64, Float64}
    z0 = x * x0
    z0l = fma(x, x0, z0 * -1.0)
    z1 = x * x1
    z2 = x * x2 + fma(x, x1, z1 * -1.0)
    z0, e = tgamma_splt(z0)
    e, z0l = gamma_fasttwosum(e, z0l)
    l1, e = gamma_twosum(e, z1)
    {z0, l1, e + z0l + z2}
  end

  private def self.tgamma_poly3(d : Float64, imax : Int32, ch : Pointer(UInt64), choff : Int32, jmax : Int32, cl : Pointer(UInt64), clrow : Int32) : {Float64, Float64}
    t0 = 1.0
    t1 = 0.0
    t2 = 0.0
    s0 = gamma_at(ch, choff)
    s1 = 0.0
    s2 = 0.0
    i = 1
    while i < imax
      t0, t1, t2 = tgamma_sprod(d, t0, t1, t2)
      c = gamma_at(ch, choff + i)
      s0 = s0 + t0 * c
      fh, fl = gamma_mulddd2(c, t1, t2)
      s1, s2 = gamma_sumdd(s1, s2, fh, fl)
      i = i + 1
    end
    fh, fl = gamma_polyddd(d, jmax, cl, clrow, 0.0)
    s1, s2 = gamma_sumdd(s1, s2, fh, fl)
    s0, s1 = gamma_fasttwosum(s0, s1)
    s1, s2 = gamma_fasttwosum(s1, s2)
    {s0, s1}
  end

  private def self.tgamma_accurate(x : Float64) : Float64
    if x.abs < 0.25
      c = TGAMMA_ACC_C.to_unsafe
      x2 = x * x
      x4 = x2 * x2
      c0 = gamma_at(c, 0) + x * gamma_at(c, 1) + x2 * (gamma_at(c, 2) + x * gamma_at(c, 3))
      c4 = gamma_at(c, 4) + x * gamma_at(c, 5) + x2 * (gamma_at(c, 6) + x * gamma_at(c, 7))
      c0 = c0 + x4 * c4
      ch, cl = gamma_polyddd(x, 28, TGAMMA_ACC_CC.to_unsafe, 0, x * c0)
      fh = 1.0 / x
      dh = fma(fh, x * -1.0, 1.0)
      fl = dh * fh
      fll = fma(fl, x * -1.0, dh) * fh
      fl, fll = gamma_sumdd(fl, fll, ch, cl)
      fl, fll = gamma_twosum(fl, fll)
      fh, fl = gamma_fasttwosum(fh, fl)
      fl, fll = gamma_fasttwosum(fl, fll)
      et = gamma_fasttwosum(fh, 2.0 * fl)[1]
      if et == 0.0
        if copysign(1.0, fl) * copysign(1.0, fll) > 0.0
          fl = fl * (1.0 + 8.881784197001252e-16)
        else
          fl = fl * (1.0 - 8.881784197001252e-16)
        end
      end
      return fh + fl
    end

    ix = x.floor
    d = 2.0 * (x - (ix + 0.5))
    i = ix.unsafe_to_i32
    reg = TGAMMA_ACC_REG.to_unsafe
    r = 0
    while r < 8 && !(i > reg[7 * r + 4])
      r = r + 1
    end
    fh, fl = tgamma_poly3(d, reg[7 * r + 1], TGAMMA_ACC_CH.to_unsafe, reg[7 * r], reg[7 * r + 3], TGAMMA_ACC_CL.to_unsafe, reg[7 * r + 2])
    jm = reg[7 * r + 5] - i
    eoff = reg[7 * r + 6]

    wh = 1.0
    wl = 0.0
    if jm > 0
      xph = x
      xpl = 0.0
      wh = xph
      j = jm - 1
      while j != 0
        if xph.abs > 1.0
          xph, l = gamma_fasttwosum(xph, 1.0)
        else
          xph, l = gamma_fasttwosum(1.0, xph)
        end
        xpl = xpl + l
        xph, xpl = gamma_fasttwosum(xph, xpl)
        wh, wl = gamma_muldd3(xph, xpl, wh, wl)
        if wh.abs > 8.580997075163262e+155
          wh = wh * 3.054936363499605e-151
          wl = wl * 3.054936363499605e-151
          eoff = eoff - 500
        end
        j = j - 1
      end
    elsif jm < 0
      xph = x - 1.0
      xpl = 0.0
      wh = xph
      j = -1 - jm
      while j != 0
        xph, l = gamma_fasttwosum(xph, -1.0)
        xpl = xpl + l
        xph, xpl = gamma_fasttwosum(xph, xpl)
        wh, wl = gamma_muldd3(xph, xpl, wh, wl)
        j = j - 1
      end
    end

    if jm > 0
      rh = 1.0 / wh
      rl = (fma(rh, wh * -1.0, 1.0) - wl * rh) * rh
      fh, fl = gamma_muldd3(fh, fl, rh, rl)
    elsif jm < 0
      fh, fl = gamma_muldd3(fh, fl, wh, wl)
    end

    # zero in round-to-nearest, as in the C
    crr = 0.0
    if jm <= 0
      crr = ((5.551115123125783e-17 + 6.162975822039155e-33) - 5.551115123125783e-17) + ((1.1102230246251565e-16 - 6.162975822039155e-33) - 1.1102230246251565e-16)
      fl = fl + fh * (jm.to_f64 * crr)
    else
      op = 1.1102230246251565e-16 - 6.162975822039155e-33
      om = -1.1102230246251565e-16 + 6.162975822039155e-33
      crr = 1.1102230246251565e-16 - op if op == om * -1.0
      fl = fl - fh * ((jm - 5).to_f64 * crr * 1.04)
    end

    eps = 1.8488927466117464e-31 * fh
    ub = fh + (fl + eps)
    lb = fh + (fl - eps)
    res = IyiFloatText.bits_of(fh + fl)
    re = (res.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i64
    if re + eoff.to_i64 <= 0_i64
      # subnormal result
      res = res &- (eoff.to_i64 + re - 1_i64).unsafe_to_u64.unsafe_shl(52_u64)
      res = res & 0xfff0000000000000_u64
      fh, l = gamma_fasttwosum(IyiFloatText.from_bits(res), fh)
      fl = fl + l
      res = IyiFloatText.bits_of(fh + fl)
      res = res & 0x800fffffffffffff_u64
      return IyiFloatText.from_bits(res)
    end
    res = res &+ eoff.to_i64.unsafe_to_u64.unsafe_shl(52_u64)
    return gamma_database(TGAMMA_DB.to_unsafe, 57, x, IyiFloatText.from_bits(res)) if ub != lb
    IyiFloatText.from_bits(res)
  end

  # as_expd: exp(x + l) as (hi, lo) * 2^e.
  private def self.tgamma_expd(x : Float64, l : Float64) : {Float64, Float64, Int32}
    xh, xl = gamma_muldd2(x, l, 1477.3197218702985, 2.0843800310713378e-14)
    ix = gamma_roundeven(xh)
    xh, xl = gamma_fasttwosum(xh - ix, xl)
    k = ix.unsafe_to_i32
    i0 = k.unsafe_shr(5) & 31
    i1 = k & 31
    e = k.unsafe_shr(10)
    e0 = TGAMMA_E0.to_unsafe
    e1 = TGAMMA_E1.to_unsafe
    rh, rl = gamma_muldd2(gamma_at(e0, 2 * i0 + 1), gamma_at(e0, 2 * i0), gamma_at(e1, 2 * i1 + 1), gamma_at(e1, 2 * i1))
    c = TGAMMA_EXP_C.to_unsafe
    fl = xh * gamma_polyd(xh, 4, c, 1)
    fh, fl = gamma_polydd2(xh, xl, 1, c, 0, fl)
    fh, fl = gamma_muldd2(xh, xl, fh, fl)
    fh, el = gamma_fasttwosum(1.0, fh)
    fl = fl + el
    rh, rl = gamma_muldd2(rh, rl, fh, fl)
    {rh, rl, e}
  end

  # as_lgamma_asym: Stirling's lgamma(xh + xl) for xh > 3.
  private def self.tgamma_lgamma_asym(xh : Float64, xl : Float64) : {Float64, Float64}
    zh = 1.0 / xh
    dz = xl * zh
    zl = (fma(zh, xh * -1.0, 1.0) - dz) * zh
    lh, ll = gamma_logd(xh)
    ll = ll + dz
    lh, ll = gamma_muldd2(xh - 0.5, xl, lh - 1.0, ll)
    z2h, z2l = gamma_muldd2(zh, zl, zh, zl)
    x2 = z2h * z2h
    fh = 0.0
    fl = 0.0
    if xh > 11.5
      c = TGAMMA_ASYM_C1.to_unsafe
      lh, ll = gamma_fastsum(lh, ll, gamma_at(c, 0), gamma_at(c, 1))
      # q = c + 2
      q0 = gamma_at(c, 4) + z2h * gamma_at(c, 6)
      q2 = gamma_at(c, 8) + z2h * gamma_at(c, 10)
      q4 = gamma_at(c, 12) + z2h * gamma_at(c, 14)
      fl = z2h * (q0 + x2 * (q2 + x2 * q4))
      fh, fl = gamma_polydd2(z2h, z2l, 1, c, 1, fl)
    else
      c = TGAMMA_ASYM_C2.to_unsafe
      lh, ll = gamma_fastsum(lh, ll, gamma_at(c, 0), gamma_at(c, 1))
      x4 = x2 * x2
      # q = c + 3
      q0 = gamma_at(c, 6) + z2h * gamma_at(c, 8)
      q2 = gamma_at(c, 10) + z2h * gamma_at(c, 12)
      q4 = gamma_at(c, 14) + z2h * gamma_at(c, 16)
      q6 = gamma_at(c, 18) + z2h * gamma_at(c, 20)
      q8 = gamma_at(c, 22) + z2h * gamma_at(c, 24)
      q4 = q4 + x2 * (q6 + x2 * q8)
      q0 = q0 + x2 * q2
      q0 = q0 + x4 * q4
      fl = z2h * q0
      fh, fl = gamma_polydd2(z2h, z2l, 2, c, 1, fl)
    end
    fh, fl = gamma_muldd2(zh, zl, fh, fl)
    gamma_fastsum(lh, ll, fh, fl)
  end

  # __ieee754_gamma_r as w_tgamma_compat.c answers it: signgam is always 0
  # and the domain errors are its k_standard NAN.
  private def self.tgamma_core(x : Float64) : Float64
    t = IyiFloatText.bits_of(x)
    ax = t.unsafe_shl(1_u64)
    if ax >= 0xffe0000000000000_u64
      if ax == 0xffe0000000000000_u64
        # -inf: the wrapper's (w_tgamma_compat.c) domain error, NAN
        return IyiFloatText.from_bits(0x7ff8000000000000_u64) if t.unsafe_shr(63_u64) != 0_u64
        return x
      end
      return x + x
    end
    z = x
    if x.abs < 0.25
      if ax < 0x71e0000000000000_u64
        # |x| < 2^-112
        return 1.7976931348623157e+308 + 9.9792015476736e+291 if x == 5.562684646268003e-309
        r = 1.0 / x
        return r if x == 0.0
        r = r - 0.5 if fma(r, x, -1.0) == 0.0
        return r
      end
      c = TGAMMA_SMALL_C.to_unsafe
      x2 = x * x
      x4 = x2 * x2
      x8 = x4 * x4
      c0 = gamma_at(c, 0) + x * gamma_at(c, 1) + x2 * (gamma_at(c, 2) + x * gamma_at(c, 3))
      c4 = gamma_at(c, 4) + x * gamma_at(c, 5) + x2 * (gamma_at(c, 6) + x * gamma_at(c, 7))
      c8 = gamma_at(c, 8) + x * gamma_at(c, 9) + x2 * (gamma_at(c, 10) + x * gamma_at(c, 11))
      c12 = gamma_at(c, 12) + x * gamma_at(c, 13) + x2 * (gamma_at(c, 14) + x * gamma_at(c, 15))
      c0 = c0 + x4 * c4
      c8 = c8 + x4 * c12
      ch, cl = gamma_polyddd(x, 5, TGAMMA_SMALL_CC.to_unsafe, 0, x * (c0 + x8 * c8))
      fh = 1.0 / z
      fl = fma(fh, z * -1.0, 1.0) * fh
      fh, fl = gamma_fastsum(fh, fl, ch, cl)
      eps = fh * (3.5e-19 + (x2 * x4) * 4.0e-15)
      ub = fh + (fl + eps)
      lb = fh + (fl - eps)
      return tgamma_accurate(x) if ub != lb
      return ub
    end

    return 1.7415152243978685e+308 + 1.7415152243978685e+308 if x >= 171.62437695630274

    fx = x.floor
    if fx == x
      # an integer: 0 is above; a negative one is the wrapper's domain error, NAN
      return 1.0 / 0.0 if x == 0.0
      return IyiFloatText.from_bits(0x7ff8000000000000_u64) if x < 0.0
      k = fx.unsafe_to_i64
      t0h = 1.0
      t0l = 0.0
      x0 = 1.0
      i = 1_i64
      while i < k
        t0h, t0l = gamma_mulddd2(x0, t0h, t0l)
        i = i + 1_i64
        x0 = x0 + 1.0
      end
      return t0h + t0l
    end

    if x <= -184.0
      # |gamma(x)| < 2^-1078: the zero of gamma's sign
      k = fx.unsafe_to_i64
      return 2.2250738585072014e-308 * ((k & 1_i64) == 0_i64 ? 2.2250738585072014e-308 : -2.2250738585072014e-308)
    end

    if x < -3.0
      lh, ll = gamma_fasttwosum(x * -1.0, 1.0)
      lh, ll = tgamma_lgamma_asym(lh, ll)
      lh, ll, e = tgamma_expd(lh, ll)
      ix = x.floor
      dx = x - ix
      ip = ix.unsafe_to_i32
      sh, sl = gamma_sinpi(dx, TGAMMA_ST.to_unsafe, false)
      lh, ll = gamma_muldd2(sh, sl, lh, ll)
      pih = 3.141592653589793
      pil = 1.2246467991473532e-16
      rcp = 1.0 / lh
      rh = rcp * pih
      rl = rcp * (pil - ll * rh - fma(rh, lh, pih * -1.0))
      if (ip & 1) != 0
        rh = rh * -1.0
        rl = rl * -1.0
      end
      eps = rh * (6.5e-21 - x * 1.46e-22)
      th = 0_u64
      if ip >= -170
        ub = rh + (rl + eps)
        lb = rh + (rl - eps)
        return tgamma_accurate(x) if ub != lb
        th = IyiFloatText.bits_of(ub) &- e.to_i64.unsafe_to_u64.unsafe_shl(52_u64)
      else
        th = IyiFloatText.bits_of(rh)
        re = (th.unsafe_shr(52_u64) & 0x7ff_u64).unsafe_to_i32
        if re - e <= 0
          # subnormal result
          th = th &+ (e - re + 1).to_i64.unsafe_to_u64.unsafe_shl(52_u64)
          th = th & 0xfff0000000000000_u64
          rh, l = gamma_fasttwosum(IyiFloatText.from_bits(th), rh)
          rl = rl + l
          ub = rh + (rl + eps)
          lb = rh + (rl - eps)
          return tgamma_accurate(x) if ub != lb
          th = IyiFloatText.bits_of(ub) & 0x800fffffffffffff_u64
          return IyiFloatText.from_bits(th)
        end
        ub = rh + (rl + eps)
        lb = rh + (rl - eps)
        return tgamma_accurate(x) if ub != lb
        th = IyiFloatText.bits_of(ub) &- e.to_i64.unsafe_to_u64.unsafe_shl(52_u64)
      end
      return IyiFloatText.from_bits(th)
    end

    if x > 4.0
      lh, ll = tgamma_lgamma_asym(x, 0.0)
      lh, ll, e = tgamma_expd(lh, ll)
      eps = lh * (2.0e-21 + x * 1.5e-22)
      ub = lh + (ll + eps)
      lb = lh + (ll - eps)
      return tgamma_accurate(x) if ub != lb
      return IyiFloatText.from_bits(IyiFloatText.bits_of(ub) &+ e.to_i64.unsafe_to_u64.unsafe_shl(52_u64))
    end

    # -3 < x < 4: gamma(x + i) / (x (x + 1) ... ) around 3.5
    c = TGAMMA_MID_C.to_unsafe
    m = z - 3.5
    i = gamma_roundeven(m)
    d = z - (i + 3.5)
    d2 = d * d
    d4 = d2 * d2
    fl = d * ((gamma_at(c, 10) + d * gamma_at(c, 11)) + d2 * (gamma_at(c, 12) + d * gamma_at(c, 13)) + d4 * ((gamma_at(c, 14) + d * gamma_at(c, 15)) + d2 * (gamma_at(c, 16) + d * gamma_at(c, 17))))
    fh, fl = gamma_polyddd(d, 10, TGAMMA_MID_CC.to_unsafe, 0, fl)
    jm = i.abs.unsafe_to_i32
    wh = 1.0
    wl = 0.0
    xph = z
    xpl = 0.0
    if jm != 0
      wh = xph
      j = jm - 1
      while j != 0
        if xph.abs > 1.0
          xph, l = gamma_fasttwosum(xph, 1.0)
        else
          xph, l = gamma_fasttwosum(1.0, xph)
        end
        xpl = xpl + l
        wh, wl = gamma_muldd2(xph, xpl, wh, wl)
        j = j - 1
      end
    end
    rh = 1.0 / wh
    rl = (fma(rh, wh * -1.0, 1.0) - wl * rh) * rh
    fh, fl = gamma_muldd2(rh, rl, fh, fl)
    eps = fh * 1.0e-21
    ub = fh + (fl + eps)
    lb = fh + (fl - eps)
    return tgamma_accurate(x) if ub != lb
    ub
  end

  # as_logd_accurate: log(x) as a triple-double.
  private def self.lgamma_logd_accurate(x : Float64) : {Float64, Float64, Float64}
    t = IyiFloatText.bits_of(x)
    ex = t.unsafe_shr(52_u64).unsafe_to_i32
    if ex == 0
      k = t.leading_zeros_count
      t = t.unsafe_shl((k - 11).unsafe_to_u64)
      ex = ex - (k - 12)
    end
    e = ex - 0x3ff
    t = t & 0x000fffffffffffff_u64
    ed = e.to_f64
    b = GAMMA_LOG_B.to_unsafe
    i = t.unsafe_shr(47_u64).unsafe_to_i32
    d = (t & 0x00007fffffffffff_u64).unsafe_to_i64
    j = (t &+ b[2 * i].unsafe_to_u64.unsafe_shl(33_u64) &+ (b[2 * i + 1] &* d.unsafe_shr(16_i64)).unsafe_to_u64).unsafe_shr(42_u64)
    t = t | 0x3ff0000000000000_u64
    i1 = j.unsafe_shr(5_u64).unsafe_to_i32
    i2 = (j & 0x1f_u64).unsafe_to_i32
    r = gamma_at(GAMMA_LOG_R1.to_unsafe, i1) * gamma_at(GAMMA_LOG_R2.to_unsafe, i2)
    tf = IyiFloatText.from_bits(t)
    o = r * tf
    dxl = fma(r, tf, o * -1.0)
    dxh = o - 1.0
    c = LGAMMA_LOGACC_C.to_unsafe
    dxh, dxl = gamma_fasttwosum(dxh, dxl)
    fl = dxh * (gamma_at(c, 12) + dxh * (gamma_at(c, 14) + dxh * gamma_at(c, 16)))
    fh, fl = gamma_polydd2(dxh, dxl, 6, c, 0, fl)
    fh, fl = gamma_muldd2(dxh, dxl, fh, fl)
    h1 = LGAMMA_LOGACC_H1.to_unsafe
    h2 = LGAMMA_LOGACC_H2.to_unsafe
    s2 = gamma_at(h1, 3 * i1 + 2) + gamma_at(h2, 3 * i2 + 2)
    s1 = gamma_at(h1, 3 * i1 + 1) + gamma_at(h2, 3 * i2 + 1)
    s0 = gamma_at(h1, 3 * i1) + gamma_at(h2, 3 * i2)
    l0 = 0.6931471805598903 * ed
    l1 = 5.49792301870721e-14 * ed
    l2 = 1.1612227229362532e-26 * ed
    l0 = l0 + s2
    l1, l2 = gamma_sumdd(l1, l2, s1, s0)
    l1, l2 = gamma_sumdd(l1, l2, fh, fl)
    l0, l1 = gamma_fasttwosum(l0, l1)
    l1, l2 = gamma_fasttwosum(l1, l2)
    {l0, l1, l2}
  end

  # as_sinpipid_accurate: sin(pi x)/pi, x in [0, 1].
  private def self.lgamma_sinpipid_accurate(x : Float64) : {Float64, Float64}
    x = (x - 0.5).abs * 128.0
    ix = gamma_roundeven(x)
    d = ix - x
    ky = ix.unsafe_to_i32
    kx = 64 - ky
    st = LGAMMA_STPI.to_unsafe
    sh = gamma_at(st, 2 * kx + 1)
    sl = gamma_at(st, 2 * kx)
    ch = gamma_at(st, 2 * ky + 1)
    cl = gamma_at(st, 2 * ky)
    d2h = d * d
    d2l = fma(d, d, d2h * -1.0)
    ph, pl = gamma_polydd2(d2h, d2l, 5, LGAMMA_SINPIACC_C.to_unsafe, 0, 0.0)
    qh, ql = gamma_polydd2(d2h, d2l, 6, LGAMMA_SINPIACC_S.to_unsafe, 0, 0.0)
    ph, pl = gamma_mulddd2(d, ph, pl)
    ph, pl = gamma_muldd2(sh, sl, ph, pl)
    qh, ql = gamma_muldd2(ch, cl, qh, ql)
    ch, cl = gamma_fastsum(qh, ql, ph, pl)
    ch, cl = gamma_mulddd2(d, ch, cl)
    gamma_fastsum(sh, sl, ch, cl)
  end

  # as_lgamma_asym_accurate: Stirling's lgamma(xh + xl) as a triple-double.
  private def self.lgamma_asym_accurate(xh : Float64, xl : Float64) : {Float64, Float64, Float64}
    l0, l1, l2 = lgamma_logd_accurate(xh)
    l0x = 0.0
    l1x = 0.0
    l2x = 0.0
    if xh < 1.329227995784916e+36
      zh = 1.0 / xh
      dz = xl * zh
      zl = (fma(zh, xh * -1.0, 1.0) - dz) * zh
      if xl != 0.0
        dl1, dl2 = gamma_mulddd2(xl, zh, fma(zh, xh * -1.0, 1.0) * zh)
        dl2 = dl2 - dl1 * dl1 / 2.0
        l1, l2 = gamma_sumdd(l1, l2, dl1, dl2)
      end
      wh = xh - 0.5
      wl = xl
      if IyiFloatText.bits_of(xh).unsafe_shr(52_u64) > 0x432_u64
        wh = xh
        wl = xl - 0.5
      end
      l0 = l0 - 1.0
      l0x = l0 * wh
      l0xl = fma(l0, wh, l0x * -1.0)
      l1x = l1 * wh
      l1xl = fma(l1, wh, l1x * -1.0)
      l2x = l2 * wh
      l1x, l2x = gamma_sumdd(l1x, l2x, l0xl, l1xl)
      l1x, l2x = gamma_sumdd(l1x, l2x, l0 * wl, l1 * wl)
      z2h, z2l = gamma_muldd2(zh, zl, zh, zl)
      fh = 0.0
      fl = 0.0
      if xh >= 48.0
        c = LGAMMA_ASYMACC_C48.to_unsafe
        l1x, l2x = gamma_sumdd(l1x, l2x, gamma_at(c, 0), gamma_at(c, 1))
        fh, fl = gamma_polydd2(z2h, z2l, 7, c, 1, 0.0)
      elsif xh >= 14.5
        c = LGAMMA_ASYMACC_C14.to_unsafe
        l1x, l2x = gamma_sumdd(l1x, l2x, gamma_at(c, 0), gamma_at(c, 1))
        fh, fl = gamma_polydd2(z2h, z2l, 11, c, 1, 0.0)
      else
        c = LGAMMA_ASYMACC_C0.to_unsafe
        l1x, l2x = gamma_sumdd(l1x, l2x, gamma_at(c, 0), gamma_at(c, 1))
        fh, fl = gamma_polydd2(z2h, z2l, 27, c, 1, 0.0)
      end
      fh, fl = gamma_muldd2(zh, zl, fh, fl)
      l1x, l2x = gamma_sumdd(l1x, l2x, fh, fl)
      l0x, l1x = gamma_fasttwosum(l0x, l1x)
      l1x, l2x = gamma_fasttwosum(l1x, l2x)
    else
      wl = xl - 0.5
      l0 = l0 - 1.0
      l0x = l0 * xh
      l0xl = fma(l0, xh, l0x * -1.0)
      l1x = l1 * xh
      l1xl = fma(l1, xh, l1x * -1.0)
      l2x = l2 * xh
      l1x, l2x = gamma_sumdd(l1x, l2x, l0xl, l1xl)
      l1x, l2x = gamma_sumdd(l1x, l2x, l0 * wl, l1 * wl)
    end
    {l0x, l1x, l2x}
  end

  # lgamma(1 + t) or lgamma(2 + t) and friends around a whole argument:
  # the t * c0(t) product plus the logarithms of the steps.
  private def self.lgamma_add_log(fh : Float64, fl : Float64, fll : Float64, x : Float64) : {Float64, Float64, Float64}
    lh, ll, lll = lgamma_logd_accurate(x)
    fl, fll = gamma_sumdd(fl, fll, ll, lll)
    fh, lh = gamma_twosum(fh, lh)
    fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
    {fh, fl, fll}
  end

  private def self.lgamma_accurate(x : Float64) : Float64
    c0t = LGAMMA_ACC_C0.to_unsafe
    bt = LGAMMA_ACC_B.to_unsafe
    sx = x
    fh = 0.0
    fl = 0.0
    fll = 0.0
    x = x.abs
    if x < 7.888609052210118e-31
      lh, ll, lll = lgamma_logd_accurate(x)
      fh = lh * -1.0
      fl = ll * -1.0
      fll = lll * -1.0
      fh, fl = gamma_fasttwosum(fh, fl)
      fl, fll = gamma_fasttwosum(fl, fll)
      e = gamma_fasttwosum(fh, 2.0 * fl)[1]
      if e == 0.0 && 1.0 + 5.551115123125783e-17 == 1.0 - 5.551115123125783e-17
        fl = fl * (1.0 + copysign(2.220446049250313e-16, fl) * copysign(1.0, fll))
      end
    elsif x < 0.25
      fh, fl = gamma_polydddfst(sx, 34, c0t, 0, fl)
      fh, fl = gamma_mulddd2(sx, fh, fl)
      lh, ll, lll = lgamma_logd_accurate(x)
      fh, fl = gamma_sumdd(fh, fl, ll * -1.0, lll * -1.0)
      fh, fll = gamma_twosum(lh * -1.0, fh)
      fl, fll = gamma_twosum(fll, fl)
      e = gamma_fasttwosum(fh, 2.0 * fl)[1]
      if e == 0.0 && 1.0 + 5.551115123125783e-17 == 1.0 - 5.551115123125783e-17
        fl = fl * (1.0 + copysign(2.220446049250313e-16, fl) * copysign(1.0, fll))
      end
    else
      if (x - 0.5).abs < 0.25
        fh, fl = gamma_polydddfst(x - 0.5, 30, bt, 0, fl)
        if sx > 0.0
          lh, ll, lll = lgamma_logd_accurate(x)
          fl, fll = gamma_sumdd(fl, 0.0, ll * -1.0, lll * -1.0)
          fh, lh = gamma_twosum(fh, lh * -1.0)
          fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
        end
      elsif (x - 2.5).abs < 0.25
        fh, fl = gamma_polydddfst(x - 2.5, 30, bt, 0, fl)
        lh, ll, lll = lgamma_logd_accurate(x - 1.0)
        fl, fll = gamma_sumdd(fl, 0.0, ll, lll)
        fh, lh = gamma_twosum(fh, lh)
        fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
        if sx < 0.0
          fh, fl, fll = lgamma_add_log(fh, fl, fll, x)
        end
      elsif (x - 3.5).abs < 0.25
        l2h, l2l, l2ll = lgamma_logd_accurate(x - 2.0)
        l1h, l1l, l1ll = lgamma_logd_accurate(x - 1.0)
        l1l, l1ll = gamma_sumdd(l1l, l1ll, l2l, l2ll)
        l1h, l2h = gamma_fasttwosum(l1h, l2h)
        l1l, l1ll = gamma_sumdd(l1l, l1ll, l2h, 0.0)
        fh, fl = gamma_polydddfst(x - 3.5, 30, bt, 0, fl)
        fl, fll = gamma_sumdd(fl, 0.0, l1l, l1ll)
        fh, l1h = gamma_twosum(fh, l1h)
        fl, fll = gamma_sumdd(fl, fll, l1h, 0.0)
        if sx < 0.0
          fh, fl, fll = lgamma_add_log(fh, fl, fll, x)
        end
      elsif (x - 1.0).abs < 0.25
        fh, fl = gamma_polydddfst(x - 1.0, 34, c0t, 0, fl)
        fh, fl = gamma_mulddd2(x - 1.0, fh, fl)
        if sx < 0.0
          lh, ll, lll = lgamma_logd_accurate(x)
          fl, fll = gamma_sumdd(fl, 0.0, ll, lll)
          fh, lh = gamma_twosum(fh, lh)
          fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
        end
      elsif (x - 1.5).abs < 0.25
        fh, fl = gamma_polydddfst(x - 1.5, 30, bt, 0, fl)
        if sx < 0.0
          lh, ll, lll = lgamma_logd_accurate(x)
          fl, fll = gamma_sumdd(fl, 0.0, ll, lll)
          fh, lh = gamma_twosum(fh, lh)
          fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
        end
      elsif (x - 2.0).abs < 0.25
        lh, ll, lll = lgamma_logd_accurate(x - 1.0)
        fh, fl = gamma_polydddfst(x - 2.0, 34, c0t, 0, fl)
        fh, fl = gamma_mulddd2(x - 2.0, fh, fl)
        fl, fll = gamma_sumdd(fl, 0.0, ll, lll)
        fh, lh = gamma_twosum(fh, lh)
        fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
        if sx < 0.0
          fh, fl, fll = lgamma_add_log(fh, fl, fll, x)
        end
      elsif (x - 3.0).abs < 0.25
        l2h, l2l, l2ll = lgamma_logd_accurate(x - 2.0)
        l1h, l1l, l1ll = lgamma_logd_accurate(x - 1.0)
        l1l, l1ll = gamma_sumdd(l1l, l1ll, l2l, l2ll)
        l1h, l2h = gamma_fasttwosum(l1h, l2h)
        l1l, l1ll = gamma_sumdd(l1l, l1ll, l2h, 0.0)
        fh, fl = gamma_polydddfst(x - 3.0, 34, c0t, 0, fl)
        fh, fl = gamma_mulddd2(x - 3.0, fh, fl)
        fl, fll = gamma_sumdd(fl, 0.0, l1l, l1ll)
        fh, l1h = gamma_twosum(fh, l1h)
        fl, fll = gamma_sumdd(fl, fll, l1h, 0.0)
        if sx < 0.0
          fh, fl, fll = lgamma_add_log(fh, fl, fll, x)
        end
      else
        # x > 3.75
        if sx < 0.0
          x, fl = gamma_fasttwosum(x, 1.0)
        end
        fh, fl, fll = lgamma_asym_accurate(x, fl)
      end
      if sx < 0.0
        phi = sx < -0.5 ? sx - sx.floor : sx * -1.0
        sh, sl = lgamma_sinpipid_accurate(phi)
        lh, ll, lll = lgamma_logd_accurate(sh)
        ll = ll + (sl / sh + lll)
        fl, fll = gamma_sumdd(fl, fll, ll, 0.0)
        fh, lh = gamma_twosum(fh, lh)
        fl, fll = gamma_sumdd(fl, fll, lh, 0.0)
        fh = fh * -1.0
        fl = fl * -1.0
        fll = fll * -1.0
      end
      fh, fl = gamma_fasttwosum(fh, fl)
      fl, fll = gamma_fasttwosum(fl, fll)
      fh, fl = gamma_fasttwosum(fh, fl)
      fl, fll = gamma_fasttwosum(fl, fll)
      e = gamma_fasttwosum(fh, 2.0 * fl)[1]
      if e == 0.0
        fl = fl * (1.0 + copysign(1.4901161193847656e-08, fl) * copysign(1.4901161193847656e-08, fll))
      end
    end

    # the negative zeros of lgamma between -2 and -10.5
    if fh.abs < 0.375
      reg = LGAMMA_ROOT_REG.to_unsafe
      bnd = LGAMMA_ROOT_BND.to_unsafe
      x0 = LGAMMA_ROOT_X0.to_unsafe
      ct = LGAMMA_ROOT_C.to_unsafe
      r = 0
      while r < 17
        if fh.abs < gamma_at(bnd, 4 * r) && sx > gamma_at(bnd, 4 * r + 1) && sx < gamma_at(bnd, 4 * r + 2)
          sc = gamma_at(bnd, 4 * r + 3)
          zh, zl = gamma_fasttwosum(gamma_at(x0, 3 * r) + sx, gamma_at(x0, 3 * r + 1))
          zl = zl + gamma_at(x0, 3 * r + 2)
          sh = zh * sc
          sl = zl * sc
          row = reg[3 * r]
          n = reg[3 * r + 1]
          k = reg[3 * r + 2]
          fl = sh * gamma_polyd(sh, k, ct, row + n - k)
          fh, fl = gamma_polydd2(sh, sl, n - k, ct, row, fl)
          fh, fl = gamma_muldd2(zh, zl, fh, fl)
          break
        end
        r = r + 1
      end
    end

    ft = (IyiFloatText.bits_of(fl) &+ 2_u64) & 0x00000000ffffffff_u64
    return gamma_database(LGAMMA_DB.to_unsafe, 19, sx, fh + fl) if ft <= 2_u64
    fh + fl
  end

  # __ieee754_lgamma_r (its sign dropped).
  private def self.lgamma_core(x : Float64) : Float64
    ubrd = LGAMMA_UBRD.to_unsafe
    offs = LGAMMA_OFFS.to_unsafe
    t = IyiFloatText.bits_of(x)
    nx = t.unsafe_shl(1_u64)
    if nx >= 0xfeaea9b24f16a34c_u64
      # |x| >= 0x1.006df1bfac84ep+1015
      return 1.7976931348623155e+308 - 4.9896007738368e+291 if t == 0x7f5754d9278b51a6_u64
      return 1.7976931348623157e+308 - 4.9896007738368e+291 if t == 0x7f5754d9278b51a7_u64
      if nx >= 0xffe0000000000000_u64
        return x.abs if nx == 0xffe0000000000000_u64
        return x + x
      end
      return 1.0 / 0.0 if t.unsafe_shr(63_u64) != 0_u64
      return 1.7415152243978685e+308 * 1.7415152243978685e+308
    end
    fx = x.floor
    if fx == x
      return 1.0 / 0.0 if x <= 0.0
      return 0.0 if x == 1.0 || x == 2.0
    end
    au = nx.unsafe_shr(38_u64)
    fh = 0.0
    fl = 0.0
    eps = 0.0
    if au < ubrd[0]
      # |x| < 0.5
      lh, ll = gamma_logd(x.abs)
      if au < 0x1da0000_u64
        # |x| < 0x1p-75
        fh = lh * -1.0
        fl = ll * -1.0
        eps = 1.5e-22
      elsif au < 0x1fd0000_u64
        # |x| < 0.03125
        q = LGAMMA_SMALL_Q.to_unsafe
        z = x
        z2 = z * z
        z4 = z2 * z2
        q0 = gamma_at(q, 0) + z * gamma_at(q, 1)
        q2 = gamma_at(q, 2) + z * gamma_at(q, 3)
        q4 = gamma_at(q, 4) + z * gamma_at(q, 5)
        q6 = gamma_at(q, 6) + z * gamma_at(q, 7)
        fl = z * ((q0 + z2 * q2) + z4 * (q4 + z2 * q6))
        fh, fl = gamma_polydddfst(z, 4, LGAMMA_SMALL_C0.to_unsafe, 0, fl)
        fh, fl = gamma_mulddd2(x, fh, fl)
        fh, fl = gamma_sumdd(lh * -1.0, ll * -1.0, fh, fl)
        eps = 1.5e-22
      else
        # 1 + x in [0.5, 0.96875] or [1.03125, 1.5]: the piecewise fit
        tf, xl = gamma_fasttwosum(1.0, x)
        au = IyiFloatText.bits_of(tf).unsafe_shr(37_u64)
        j = lgamma_piece(au)
        z = (tf - gamma_at(offs, j)) + xl
        fh, fl = lgamma_piece_poly(z, j)
        if j == 4
          # the zero at 1
          z = x * -1.0
          fh, fl = gamma_mulddd2(z, fh, fl)
        end
        eps = fh.abs * 8.3e-20
        fh, fl = gamma_sumdd(lh * -1.0, ll * -1.0, fh, fl)
        eps = eps + lh.abs * 5.0e-22
      end
    else
      ax = x.abs
      if au >= ubrd[19]
        # |x| >= 8.29541: Stirling
        lh, ll = gamma_logd(ax)
        lh = lh - 1.0
        if au >= 0x2198000_u64
          # x >= 0x1p52
          lh, ll = gamma_fasttwosum(lh, ll) if au >= 0x3fabaa6_u64
          hlh = lh * 0.5
          lh, ll = gamma_mulddd2(ax, lh, ll)
          ll = ll - hlh
        else
          lh, ll = gamma_mulddd2(ax - 0.5, lh, ll)
        end
        c = LGAMMA_ASYM_C.to_unsafe
        q = LGAMMA_ASYM_Q.to_unsafe
        lh, ll = gamma_fastsum(lh, ll, gamma_at(c, 0), gamma_at(c, 1))
        if ax < 1.2676506002282294e+30
          zh = 1.0 / ax
          zl = fma(zh, ax * -1.0, 1.0) * zh
          z2h = zh * zh
          z4h = z2h * z2h
          q0 = gamma_at(q, 0) + z2h * gamma_at(q, 1)
          q2 = gamma_at(q, 2) + z2h * gamma_at(q, 3)
          q4 = gamma_at(q, 4)
          fl = z2h * (q0 + z4h * (q2 + z4h * q4))
          fh, fl = gamma_fasttwosum(gamma_at(c, 2), fl)
          fl = fl + gamma_at(c, 3)
          fh, fl = gamma_muldd2(fh, fl, zh, zl)
        end
        fh, fl = gamma_fastsum(lh, ll, fh, fl)
        eps = fh.abs * 4.5e-20
      else
        # |x| in [0.5, 8.29541]
        j = lgamma_piece(au)
        z = ax - gamma_at(offs, j)
        fh, fl = lgamma_piece_poly(z, j)
        if j == 4
          # the zero at 1
          z = 1.0 - ax
          fh, fl = gamma_mulddd2(z, fh, fl)
        end
        if j == 10
          # the zero at 2
          z = ax - 2.0
          fh, fl = gamma_mulddd2(z, fh, fl)
        end
        eps = fh.abs * 8.3e-20 + 1.0e-24
      end
      if t.unsafe_shr(63_u64) != 0_u64
        # x < 0: the reflection formula
        sh, sl = gamma_sinpi(x - fx, LGAMMA_STPI.to_unsafe, true)
        sh, sl = gamma_mulddd2(x * -1.0, sh, sl)
        lh, ll = gamma_logd(sh)
        ll = ll + sl / sh
        fh, fl = gamma_sumdd(fh, fl, lh, ll)
        fh = fh * -1.0
        fl = fl * -1.0
        eps = eps + lh.abs * 4.0e-22
      end
    end
    ub = fh + (fl + eps)
    lb = fh + (fl - eps)
    return lgamma_accurate(x) if ub != lb
    ub
  end

  # The piece of [0.5, 8.29541] that holds the top bits `au`.
  private def self.lgamma_piece(au : UInt64) : Int32
    ubrd = LGAMMA_UBRD.to_unsafe
    ou = (au &- ubrd[0]) & 0xffffffff_u64
    j = ((0x157ced865_u64 &- ((ou &* 0x150d_u64) & 0xffffffff_u64)) &* ou &+ 0x128000000000_u64).unsafe_shr(45_u64).unsafe_to_i32
    j = j - 1 if au < ubrd[j]
    j
  end

  private def self.lgamma_piece_poly(z : Float64, j : Int32) : {Float64, Float64}
    q = LGAMMA_CL.to_unsafe
    b = 8 * j
    z2 = z * z
    z4 = z2 * z2
    q0 = gamma_at(q, b) + z * gamma_at(q, b + 1)
    q2 = gamma_at(q, b + 2) + z * gamma_at(q, b + 3)
    q4 = gamma_at(q, b + 4) + z * gamma_at(q, b + 5)
    q6 = gamma_at(q, b + 6) + z * gamma_at(q, b + 7)
    fl = z * ((q0 + z2 * q2) + z4 * (q4 + z2 * q6))
    gamma_polydddfst(z, 5, LGAMMA_CH.to_unsafe, 5 * j, fl)
  end

  # The Bessel functions as glibc 2.43 computes them - fdlibm's `e_j0.c`,
  # `e_j1.c` and `e_jn.c`, which glibc carries (Sun's notice is at `log10`),
  # behind x86-64's default wrappers `w_j0_compat.c`, `w_j1_compat.c` and
  # `w_jn_compat.c` in their _POSIX_ mode: they pass the __ieee754 answer
  # through except that y0, y1 and yn of x < 0 are k_standard's NAN (the
  # positive quiet NaN, where __ieee754 gives the default -NaN). Below 2 a
  # rational function in x^2 (and log for y), above it Hankel's asymptotic
  # form with P and Q from rational functions in 1/x^2 on four pieces, the
  # phase from sin and cos of x itself with the cancelling combination
  # recomputed from cos(2x). jn recurs forward from j0 and j1 when n <= x
  # and otherwise backward from a continued fraction, yn forward from y0
  # and y1.
