# HTTPS records (RFC 9460) in std/http's client, exercised end to end: an
# `HTTPClient` with `use_https_records` set, a name server and a TLS
# server in this program, and the server's ECH configuration (RFC 9849)
# carried to the client by the records (RFC 9848).
#
#   ./bin/iyi run bench/std_http_https_records.iyi
#
# The name server answers on 127.0.0.1 over UDP, and the same answers come
# through an encrypted upstream written here, as std/secure_dns's DNS over
# TLS and over HTTPS would bring them: A records of 127.0.0.1, and the
# HTTPS records each check sets. The TLS server holds ECH keys and the
# certificates of inner.test, the name asked for, and public.test, the
# configs' public_name; for each request it answers what it saw - which
# listener it is, whether it opened the encrypted ClientHello, the name
# inside and the one outside, the protocol ALPN chose, whether the
# handshake resumed, and the protocols the ClientHello offered in their
# order - and a check also reads what the name server was asked and how
# many connections the client made. Each line is one check, its
# properties alone - no port, no time - and one that is not what it
# should be is followed by "FAIL <check>: <found>, not <wanted>"; the run
# ends "ALL CHECKS PASSED" or exits 1. CI runs it so, as it runs every
# bench program, and bench/std_http_exercise.sh with its broken copies
# of std/http, and of what std/http takes from std/tls.

module bench/std_http_https_records

import std/http::{HTTPClient, HTTPError, Response}
import std/socket::{DnsUpstream, IyiSocket, Resolver, SocketError}
import std/tls::{TlsConfig, TlsEchKey, TlsError, TlsIdentity, TlsServer, TlsServerConfig}
import std/dns::{DnsError, DnsMessage, DnsRecord}
import std/udp::{UdpSocket}
import std/x509::{Certificate}
import std/slice::{Bytes}

# bench/std_tls_exercise.iyi's ECH test PKI: a root, inner.test's leaf and
# public.test's, Ed25519, valid from 2025 to 9999. The keys guard nothing
# but these tests.
ROOT_PEM = "-----BEGIN CERTIFICATE-----\n" \
           "MIIBIDCB06ADAgECAgEBMAUGAytlcDAXMRUwEwYDVQQDDAxpeWkgZWNoIHJvb3Qw\n" \
           "IBcNMjUwMTAxMDAwMDAwWhgPOTk5OTEyMzEyMzU5NTlaMBcxFTATBgNVBAMMDGl5\n" \
           "aSBlY2ggcm9vdDAqMAUGAytlcAMhAFnMfRomzt6UPuRZ5V84J1LXLKo6RYPOjVos\n" \
           "GQ0wBI69o0IwQDAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwIBBjAdBgNV\n" \
           "HQ4EFgQUEktj5/adOiJBSqL70oBmzM3aIPswBQYDK2VwA0EAm8Yp75Kd3u2ltgfy\n" \
           "3RI6YGCCoZvMz/Tt3TN1dP5smr9LH2L9UvPWnBfS+mMyB0UFJuvoRrAwEVHUbZvD\n" \
           "HmxjBA==\n" \
           "-----END CERTIFICATE-----\n"
