  end

  def accept_children(visitor) : Nil
    @conds.each { |c| c.accept(visitor) }
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    (@conds == other.conds) && (@body == other.body) && (@exhaustive == other.exhaustive)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@conds)
    h = 31 &* h &+ hash_val(@body)
    h = 31 &* h &+ hash_val(@exhaustive)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "when "
    i = 0
    while i < @conds.size
      sb << ", " if i > 0
      @conds[i].to_s(sb)
      i = i + 1
    end
    sb << "
  "
    @body.to_s(sb)
  end
end

pub class Case < ASTNode
  property cond : ASTNode?
  property whens : Array(When)
  property else : ASTNode?
  property exhaustive : Bool

  def initialize(@cond : ASTNode? = nil, @whens : Array(When) = [] of When, @else : ASTNode? = nil, @exhaustive : Bool = false)
  end

  def clone_without_location : self
    cloned_whens = @whens.map { |w| w.clone.as(When) }
    Case.new(clone_node(@cond), cloned_whens, clone_node(@else), @exhaustive)
  end

  def accept_children(visitor) : Nil
    if c = @cond
      c.accept(visitor)
    end
    @whens.each { |w| w.accept(visitor) }
    if e = @else
      e.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    @cond == other.cond && @whens == other.whens && @else == other.else && @exhaustive == other.exhaustive
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@cond)
    h = 31 &* h &+ @whens.hash
    h = 31 &* h &+ hash_val(@else)
    h = 31 &* h &+ (@exhaustive ? 1 : 0)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "case"
    if c = @cond
      sb << " "
      c.to_s(sb)
    end
    sb << "
"
    @whens.each do |w|
      w.to_s(sb)
      sb << "
"
    end
    if e = @else
      sb << "else
  "
      e.to_s(sb)
      sb << "
"
    end
    sb << "end"
  end
end

pub class Select < ASTNode
  property whens : Array(When)
  property else : ASTNode?

  def initialize(@whens : Array(When) = [] of When, @else : ASTNode? = nil)
  end

  def clone_without_location : self
