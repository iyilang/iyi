; iyi-ir 1
source_filename = "always_runtime_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @__iyi_new(i64 %x) [alwaysinline] {
entry:
  ret i64 %x
}
define external i64 @caller(i64 %x) {
entry:
  %r = call i64 (i64) @__iyi_new(i64 %x)
  ret i64 %r
}
