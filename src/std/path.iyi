# File system paths, read lexically: nothing here touches the file
# system. A `Path` is a name and a kind, POSIX (`/` separates) or
# Windows (`\` and `/` both separate); `Path.new` takes the kind the
# program was built for, `Path.posix` and `Path.windows` name one.
#
# The anchor of a path is its drive and root: `/` on POSIX; on Windows a
# drive letter (`C:`, `C:\`), a UNC share (`\\server\share`, `\\server\share\`)
# or a bare root (`\`). A Windows path is absolute only with both a drive
# and a root, so `C:foo` (drive-relative) and `\foo` (rooted) are not.
# DOS device paths (`\\.\`, `\\?\`) are not recognised: they read as UNC
# shares named `.` and `?`. Windows names compare case-insensitively.
#
# Lexical operations: `basename`, `dirname`, `extension`, `stem`,
# `parent`, `parents`, `parts`, `join` and `/`, `normalize` (`.` and `..`
# folded, repeated separators collapsed, a trailing one dropped),
# `relative_to?` and `relative_to` (nil, or a panic, when the paths have
# different anchors or the base climbs through `..` — where that leads
# cannot be known without the file system), `sibling`, `to_posix` and
# `to_windows` (the kind changes and, for `to_posix`, `\` becomes `/`;
# `to_windows` keeps the name, since Windows reads `/` as a separator).
#
# `expand(base, home:)` makes the path absolute under *base*, which is
# `Program.env("PWD")` when not given — the prelude has no way to ask
# the kernel for the working directory, so a program whose `PWD` is
# unset or stale passes its own base; with no base at all `expand`
# panics rather than guess. `home: true` reads a leading `~` from
# `HOME`, or from `USERPROFILE` on Windows, which is where that platform
# keeps it.

module std/path

import std/traits
using std/traits::{Comparable}

pub struct Path
  pub enum Kind : UInt8
    POSIX   = 0
    WINDOWS = 1

    def self.native : Kind
      {% if flag?(:win32) %}
        Kind::WINDOWS
      {% else %}
        Kind::POSIX
      {% end %}
    end

    def posix? : Bool
      value == 0_u8
    end

    def windows? : Bool
      value == 1_u8
    end
  end

  getter name : String
  getter kind : Kind

  def initialize(@name : String = "", @kind : Kind = Kind.native)
  end

  def self.new(path : Path) : Path
    path
  end

  def self.[](name : String = "") : Path
    Path.new(name)
  end

  def self.[](first : String | Path, second : String | Path) : Path
    Path.new(first.to_s).join(second)
  end

  def self.[](first : String | Path, second : String | Path, third : String | Path) : Path
    Path.new(first.to_s).join(second).join(third)
  end

  def self.[](parts : Array(String)) : Path
    Path.new("").join(parts)
  end

  def self.posix(name : String = "") : Path
    Path.new(name, Kind::POSIX)
  end

  def self.windows(name : String = "") : Path
    Path.new(name, Kind::WINDOWS)
  end

  def posix? : Bool
    @kind.posix?
  end

  def windows? : Bool
    @kind.windows?
  end

  def native? : Bool
    @kind == Kind.native
  end

  def empty? : Bool
    @name.empty?
  end

  def to_s : String
    @name
  end

  def to_s(io : IO) : Nil
    io.write(@name)
  end

  def inspect : String
    "Path[" + @name.inspect + "]"
  end

  def inspect(io : IO) : Nil
    io.write(inspect)
  end

  def to_posix : Path
    return self if posix?
    len = @name.bytesize
    ptr = @name.to_unsafe
    str = String.new(len) do |buf|
      i = 0
      while i < len
        b = ptr[i]
        buf[i] = b == 92_u8 ? 47_u8 : b
        i = i + 1
      end
    end
    Path.new(str, Kind::POSIX)
  end

  def to_windows : Path
    return self if windows?
    Path.new(@name, Kind::WINDOWS)
  end

  def to_native : Path
    Kind.native.windows? ? to_windows : to_posix
  end

  def to_kind(kind : Kind) : Path
    kind.windows? ? to_windows : to_posix
  end

  private def separator : String
    posix? ? "/" : "\\"
  end

  private def sep?(b : UInt8) : Bool
    b == 47_u8 || (windows? && b == 92_u8)
  end

  # Bytes of the drive and of the anchor (drive plus root); 0 where there
  # is none. A root without a drive (`/`, `\foo`) is anchor 1, drive 0.
  private def anchor_indices : Tuple(Int32, Int32)
    len = @name.bytesize
    return {0, 0} if len == 0
    ptr = @name.to_unsafe
    b0 = ptr[0]

    unless windows?
      return b0 == 47_u8 ? {0, 1} : {0, 0}
    end

    letter = (b0 >= 65_u8 && b0 <= 90_u8) || (b0 >= 97_u8 && b0 <= 122_u8)
    if letter && len >= 2 && ptr[1] == 58_u8 # "C:"
      return len >= 3 && sep?(ptr[2]) ? {2, 3} : {2, 2}
    end

    return {0, 0} unless sep?(b0)
    if len >= 5 && sep?(ptr[1]) && !sep?(ptr[2])
      # "\\server\share": a host run, a separator, a share run
      i = 2
      while i < len && !sep?(ptr[i])
        i = i + 1
      end
      if i + 1 < len && !sep?(ptr[i + 1])
        i = i + 1
        while i < len && !sep?(ptr[i])
          i = i + 1
        end
        share_end = i
        while i < len && sep?(ptr[i])
          i = i + 1
        end
        return {share_end, i}
      end
    end
    {0, 1}
  end

  def drive : String?
    drive_end, _ = anchor_indices
    drive_end > 0 ? @name[0, drive_end] : nil
  end

  def root : String?
    drive_end, anchor_end = anchor_indices
    anchor_end > drive_end ? @name[drive_end, anchor_end - drive_end] : nil
  end

  def anchor : String?
    _, anchor_end = anchor_indices
    anchor_end > 0 ? @name[0, anchor_end] : nil
  end

  def absolute? : Bool
    drive_end, anchor_end = anchor_indices
    posix? ? anchor_end > 0 : (drive_end > 0 && anchor_end > drive_end)
  end

  def relative? : Bool
    !absolute?
  end

  def ends_with_separator? : Bool
    len = @name.bytesize
    len > 0 && sep?(@name.to_unsafe[len - 1])
  end

  # The last byte that is not a trailing separator, plus one; the anchor
  # keeps its own separator.
  private def trimmed_end : Int32
    _, anchor_end = anchor_indices
    last = @name.bytesize
    while last > anchor_end && sep?(@name.to_unsafe[last - 1])
      last = last - 1
    end
    last
  end

  # The last component; the anchor, or the empty name, is its own. A
  # *suffix* found at the end is left off.
  def basename(suffix : String? = nil) : String
    _, anchor_end = anchor_indices
    last = trimmed_end
    return @name[0, anchor_end] if last <= anchor_end

    ptr = @name.to_unsafe
    first = last
    while first > anchor_end && !sep?(ptr[first - 1])
      first = first - 1
    end

    base_len = last - first
    if suffix && !suffix.empty? && base_len > suffix.bytesize
      s_len = suffix.bytesize
      s_ptr = suffix.to_unsafe
      k = 0
      while k < s_len && ptr[first + base_len - s_len + k] == s_ptr[k]
        k = k + 1
      end
      base_len = base_len - s_len if k == s_len
    end

    @name[first, base_len]
  end

  # Everything before the last component: `"."` for a bare name, the
  # anchor for a single component under it.
  def dirname : String
    return "." if @name.empty?
    _, anchor_end = anchor_indices
    last = trimmed_end
    return @name[0, anchor_end] if last <= anchor_end

    ptr = @name.to_unsafe
    while last > anchor_end && !sep?(ptr[last - 1])
      last = last - 1
    end
    while last > anchor_end && sep?(ptr[last - 1])
      last = last - 1
    end
    return "." if last == 0
    @name[0, last]
  end

  def parent : Path
    Path.new(dirname, @kind)
  end

  # Every ancestor, the outermost first: `"a/b/c"` has `"."`, `"a"`,
  # `"a/b"`; `"/a/b"` has `"/"`, `"/a"`.
  def parents : Array(Path)
    res = [] of Path
    return res if @name.empty?
    all = parts
    _, anchor_end = anchor_indices
    if anchor_end == 0 && all.first != "."
      res << Path.new(".", @kind)
    end
    i = 1
    while i < all.size
      res << Path.new(build_name(all, i), @kind)
      i = i + 1
    end
    res
  end

  def each_parent(&block : Path -> Nil) : Nil
    parents.each do |p|
      yield p
    end
  end

  # The last `.suffix` of the basename, with its dot; none for a name
  # that starts with its only dot (`.bashrc`) or ends with one (`foo.`).
  def extension : String
    base = basename
    len = base.bytesize
    ptr = base.to_unsafe
    i = len - 1
    while i > 0 && ptr[i] != 46_u8
      i = i - 1
    end
    return "" if i <= 0 || i == len - 1
    base[i, len - i]
  end

  def stem : String
    basename(extension)
  end

  # The anchor, if any, then each non-empty component.
  def parts : Array(String)
    res = [] of String
    len = @name.bytesize
    return res if len == 0
    ptr = @name.to_unsafe
    _, anchor_end = anchor_indices
    res << @name[0, anchor_end] if anchor_end > 0

    i = anchor_end
    while i < len
      while i < len && sep?(ptr[i])
        i = i + 1
      end
      start = i
      while i < len && !sep?(ptr[i])
        i = i + 1
      end
      res << @name[start, i - start] if i > start
    end
    res
  end

  def each_part(&block : String -> Nil) : Nil
    parts.each do |p|
      yield p
    end
  end

  # The name spelled by the first *count* entries of a `parts` array.
  private def build_name(list : Array(String), count : Int32) : String
    _, anchor_end = anchor_indices
    res = ""
    i = 0
    while i < count
      if i == 0
        res = list[0]
      elsif i == 1 && anchor_end > 0 && (list[0].bytesize == 2 || sep?(list[0].to_unsafe[list[0].bytesize - 1]))
        # under a root, or right after a bare drive letter (`C:a`)
        res = res + list[1]
      else
        res = res + separator + list[i]
      end
      i = i + 1
    end
    res
  end

  # `self` with *part* under it; a *part* with an anchor of its own is
  # the answer by itself, and an empty one changes nothing.
  def join(part : String) : Path
    return self if part.empty?
    p = Path.new(part, @kind)
    return p if p.anchor
    return p if @name.empty?

    if ends_with_separator?
      Path.new(@name + part, @kind)
    else
      Path.new(@name + separator + part, @kind)
    end
  end

  def join(part : Path) : Path
    join(part.name)
  end

  def join(first : String | Path, second : String | Path) : Path
    join(first).join(second)
  end

  def join(first : String | Path, second : String | Path, third : String | Path) : Path
    join(first).join(second).join(third)
  end

  def join(parts : Array(String)) : Path
    curr = self
    parts.each do |p|
      curr = curr.join(p)
    end
    curr
  end

  def /(part : String | Path) : Path
    join(part)
  end

  # `.` dropped, `..` folded into the component before it (kept at the
  # front of a relative path, dropped under a root), separators collapsed.
  def normalize : Path
    return Path.new(".", @kind) if @name.empty?
    _, anchor_end = anchor_indices
    rooted = root != nil
    all = parts
    norm = [] of String
    norm << all[0] if anchor_end > 0

    i = anchor_end > 0 ? 1 : 0
    while i < all.size
      seg = all[i]
      if seg == "."
      elsif seg == ".."
        if norm.size > (anchor_end > 0 ? 1 : 0) && norm.last != ".."
          norm.pop
        elsif !rooted
          norm << ".."
        end
      else
        norm << seg
      end
      i = i + 1
    end

    return Path.new(".", @kind) if norm.empty?
    Path.new(build_name(norm, norm.size), @kind)
  end

  # The path that reaches `self` from *base*, or nil where none can be
  # spelled: different anchors, or a *base* that climbs through `..`.
  def relative_to?(base : Path | String) : Path?
    base_path = base.is_a?(Path) ? base : Path.new(base, @kind)
    target = normalize
    base_norm = base_path.to_kind(@kind).normalize

    t_anchor = target.anchor || ""
    b_anchor = base_norm.anchor || ""
    return nil if compare_names(t_anchor, b_anchor) != 0

    t_parts = target.parts
    b_parts = base_norm.parts
    t_parts = [] of String if t_parts == ["."]
    b_parts = [] of String if b_parts == ["."]
    t_parts.shift if !t_anchor.empty?
    b_parts.shift if !b_anchor.empty?

    common = 0
    min_len = t_parts.size < b_parts.size ? t_parts.size : b_parts.size
    while common < min_len && compare_names(t_parts[common], b_parts[common]) == 0
      common = common + 1
    end

    res = [] of String
    u = common
    while u < b_parts.size
      return nil if b_parts[u] == ".."
      res << ".."
      u = u + 1
    end
    d = common
    while d < t_parts.size
      res << t_parts[d]
      d = d + 1
    end

    return Path.new(".", @kind) if res.empty?
    Path.new(res.join(separator), @kind)
  end

  def relative_to(base : Path | String) : Path
    relative_to?(base) || raise "no relative path from #{base.to_s.inspect} to #{@name.inspect}"
  end

  # Absolute and normalized, under *base* when relative. *base* is
  # `Program.env("PWD")` when not given, and a relative path with neither
  # is refused. `home: true` reads a leading `~` from the home directory
  # the platform names (see `home_directory`).
  def expand(base : Path | String | Nil = nil, home : Bool = false) : Path
    name_str = @name
    if home && (name_str == "~" || name_str.starts_with?("~/") || (windows? && name_str.starts_with?("~\\")))
      home_dir = home_directory || raise "cannot expand #{@name.inspect}: HOME is not set"
      name_str = name_str == "~" ? home_dir : home_dir + name_str[1, name_str.bytesize - 1]
    end

    p = Path.new(name_str, @kind)
    return p.normalize if p.absolute?

    base_dir = if base.is_a?(Path)
                 base.to_kind(@kind)
               elsif base.is_a?(String)
                 Path.new(base, @kind)
               else
                 pwd = Program.env("PWD") || raise "cannot expand #{@name.inspect}: no base given and PWD is not set"
                 Path.new(pwd, @kind)
               end
    raise "cannot expand #{@name.inspect}: base #{base_dir.name.inspect} is not absolute" unless base_dir.absolute?
    base_dir.join(p).normalize
  end

  # Windows shells do not set `HOME`: the home directory there is named
  # `USERPROFILE`, and `HOME` shows up only under a POSIX-shaped shell
  # such as MSYS or a CI runner. So win32 asks both, its own name first;
  # every other platform asks `HOME` alone.
  private def home_directory : String | Nil
    {% if flag?(:win32) %}
      profile = Program.env("USERPROFILE")
      return profile if profile && !profile.empty?
      Program.env("HOME")
    {% else %}
      Program.env("HOME")
    {% end %}
  end

  def sibling(name : String | Path) : Path
    parent.join(name)
  end

  # Byte order; Windows names fold ASCII case.
  private def compare_names(a : String, b : String) : Int32
    windows? ? Path.compare_strings_ci(a, b) : Path.compare_strings(a, b)
  end

  def <=>(other : Path) : Int32
    r = if windows? || other.windows?
          Path.compare_strings_ci(@name, other.name)
        else
          Path.compare_strings(@name, other.name)
        end
    return r if r != 0
    @kind.value == other.kind.value ? 0 : (@kind.value < other.kind.value ? -1 : 1)
  end

  def ==(other : Path) : Bool
    (self <=> other) == 0
  end

  def hash : Int32
    (windows? ? @name.downcase : @name).hash &* 31 &+ @kind.value.to_i32
  end

  def self.compare_strings(s1 : String, s2 : String) : Int32
    len1 = s1.bytesize
    len2 = s2.bytesize
    min_len = len1 < len2 ? len1 : len2
    p1 = s1.to_unsafe
    p2 = s2.to_unsafe
    i = 0
    while i < min_len
      b1 = p1[i]
      b2 = p2[i]
      return b1 < b2 ? -1 : 1 if b1 != b2
      i = i + 1
    end
    len1 == len2 ? 0 : (len1 < len2 ? -1 : 1)
  end

  def self.compare_strings_ci(s1 : String, s2 : String) : Int32
    len1 = s1.bytesize
    len2 = s2.bytesize
    min_len = len1 < len2 ? len1 : len2
    p1 = s1.to_unsafe
    p2 = s2.to_unsafe
    i = 0
    while i < min_len
      b1 = p1[i]
      b2 = p2[i]
      b1 = b1 + 32_u8 if b1 >= 65_u8 && b1 <= 90_u8
      b2 = b2 + 32_u8 if b2 >= 65_u8 && b2 <= 90_u8
      return b1 < b2 ? -1 : 1 if b1 != b2
      i = i + 1
    end
    len1 == len2 ? 0 : (len1 < len2 ? -1 : 1)
  end
end

impl Comparable for Path
  def <=>(other : self) : Int32
    self <=> other
  end
end
