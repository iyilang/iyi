; iyi-ir 1
; expect: dominance
module "dominance_diamond"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
define internal iyicc i32 @f(i1 %c, i1 %d) {
entry:
  br i1 %c, label %outer_a, label %outer_b
outer_a:
  br i1 %d, label %inner_a, label %inner_b
inner_a:
  %x = add i32 1, 2
  br label %inner_join
inner_b:
  br label %inner_join
inner_join:
  %y = add i32 %x, 3
  br label %outer_join
outer_b:
  br label %outer_join
outer_join:
  ret i32 0
}
