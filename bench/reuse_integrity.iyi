# What the collector hands out is nobody's: a chunk given to one object is
# not given to a second while the first is alive. Exercised the way a
# program meets it, with the trigger on — a table of fresh strings built
# and dropped round after round — and checked by content, which no
# bookkeeping can fake: every key still spells its value, and a constant
# built before any of it still holds what it was built with.
#
# And what it hands out is new: a field the constructor never sets reads
# nil, however many objects lived on the chunk's page before. Under the
# arena a class instance with a pointer in it is not cleared by codegen —
# the allocator's clearing entry is trusted to hand the chunk back zero —
# and a chunk carved from a run the sweep released is zero only if the
# release made it so.
#
#   ./bin/iyi run bench/reuse_integrity.iyi
#   bash bench/reuse_integrity.sh        (default and --release)
#
# Both halves of the first check failed together, from one cause: a run
# of dead chunks whose pages went back to the kernel kept its lowest chunk
# on the free list, and when that chunk's head sat in the last sixteen
# bytes below the released page, the release zeroed the slot word the
# list reads. The pop stamped the arena's slot 0 as the new object — the
# arena's oldest, the constant's buffer — and left the chunk free for the
# next sweep to list again under its owner. Keys came back as other keys'
# bytes, and a ported n-body read a planet's `x` as a free-list link
# (`close_run`).
#
# The second failed on Windows, where a release was `MEM_RESET`: advice
# that the bytes may be dropped, which until memory is short they are
# not. 14,474,737 of 24,000,000 fresh objects read their unset field as
# a stale word, and a list whose tail was one looped back into itself.
# darwin's release was `MADV_FREE_REUSABLE`, advice of the same kind, and
# the check did not run there; the release lays a fresh mapping over the
# run now, and it runs on all three.

module bench/reuse_integrity

import std/mutex::{Mutex}

class Body
  getter x : Float64
  getter y : Float64
  getter mass : Float64

  def initialize(@x : Float64, @y : Float64, @mass : Float64)
  end
end

# Built at startup, before the first collection, and read at the end: the
# oldest objects in their arenas.
BODIES = [
  Body.new(0.5, 1.5, 2.5),
  Body.new(4.841431442464721, -1.1603200440274284, 0.0009547919384243266),
  Body.new(8.34336671824458, 4.124798564124305, 0.0002858859806661308),
  Body.new(12.894369562139131, -15.111151401698631, 0.00004366244043351563),
  Body.new(15.379697114850917, -25.919314609987964, 0.00005151389020466115),
]

WANT = [0.5, 4.841431442464721, 8.34336671824458, 12.894369562139131, 15.379697114850917]

# Each key comes with a small array of its digits, dropped at once: the
# spread of size classes the round dies in is what makes released runs in
# more than one class, and the straddler's defect shows only where such a
# run meets a listed chunk. `Int32#to_s` built that array itself until it
# wrote its digits straight into the string, and with it gone the proof
# below caught its defect in 1 run of 20; with the array here, 16.
def spelled_wrong(table : Hash(String, Int32)) : Int32
  wrong = 0
  table.each { |key, value| wrong = wrong + 1 if key != value.to_s }
  wrong
end

# Every key is read twice: when its round ends, and again two collections
# later. A chunk the pop handed out under slot 0's entry (the straddler's
# defect) keeps the free flag and the epoch parity of its last life, the
# first sweep after the pop leaves it, and the second lists it again -
# its link and its slot written over the key that lives in it. A
# collection called by hand sweeps the whole heap in its pause, so after
# two of them that sweep has reached every chunk the round was handed.
# Read only when its round ended, most of those keys were dropped before
# that sweep reached their chunks: on Linux a run handed out 9 to 25 chunks
# under slot 0's entry, and the read saw 0 to 2 of them. Read again two
# collections on, the sweep has reached every one. An unforced run had 7
# to 21 keys wrong that way on Linux, 3 to 12 on darwin and 5 to 24 on
# Windows.
def round_of(size : Int32) : Tuple(Int32, Int32)
  table = {} of String => Int32
  i = 0
  while i < size
    digits = [] of Int32
    n = i
    while n > 0 || digits.empty?
      digits << n % 10
      n = n // 10
    end
    table[i.to_s] = i + digits.size - digits.size
    i = i + 1
  end
  wrong = spelled_wrong(table)
  {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
    IyiMark.collect
    IyiMark.collect
    {wrong, spelled_wrong(table)}
  {% else %}
    {wrong, 0}
  {% end %}
end

wrong = 0
late = 0
rounds = 60
round = 0
while round < rounds
  spelled = round_of(20000 + round * 1000)
  wrong = wrong + spelled[0]
  late = late + spelled[1]
  round = round + 1
end

bodies_wrong = 0
BODIES.each_with_index { |body, index| bodies_wrong = bodies_wrong + 1 if body.x != WANT[index] }

{% if flag?(:straddler_force) %}
  puts "reuse integrity: the straddle check met #{IyiMark.straddle_met} released boundaries, armed #{IyiMark.straddle_armed} nonzero slots there, #{IyiMark.straddle_damaged} zeroed by a release"
  raise "reuse integrity: a release zeroed a listed chunk slot word at a released boundary, #{IyiMark.straddle_damaged} time(s)" if IyiMark.straddle_damaged != 0
{% end %}
if wrong != 0 || late != 0 || bodies_wrong != 0
  raise "reuse integrity: #{wrong} key(s) no longer spelled their value as their round ended and #{late} two collections later, and #{bodies_wrong} of #{BODIES.size} startup bodies changed, after #{rounds} rounds"
end
puts "reuse integrity: #{rounds} rounds, every key spells its value, the startup constant intact"

# ── A fresh object on a released page ─────────────────────────────────
#
# Pairs of words filled with a pattern, held until all of them exist and
# then dropped at once but for one in 4,096 — a death far past the
# sweep's warm budget, spread so that no arena is wholly dead and goes
# back as a mapping: what the sweep does with it is release runs of pages
# cold. Then links of the same size, whose `next` nobody sets, held until
# the carve has taken those runs up again. The fill runs on a kernel
# thread of its own, joined before the collections, so that no register
# or frame of the main thread can name the dropped array. It ran in a
# task on the main thread, and on Linux 6 runs in 400 ended "the carve
# took up no released page": it took up warm pages only, and in each of
# those runs the last collection before the check had freed 28 to 32 MiB:
# the array's final buffer had outlived the first. On its own thread, 0
# runs in 400.
{% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
  class Pair
    def initialize(@a : UInt64, @b : UInt64)
    end
  end

  class Chain
    getter value : UInt64
    getter next : Chain?

    def initialize(@value : UInt64)
    end
  end

  # The pairs kept past the fill: appended to by the filler thread and
  # read by nothing, they hold one in 4,096 alive after that thread ends.
  # Behind a `Mutex`, which is `Share`, so the thread reaches them with
  # nothing to claim; they were a class variable under a `@[SafeReach]`
  # nothing proved, which the compiler now refuses (SPEC.md III.4.4).
  KEPT = Mutex.new { [] of Pair }

  def fill(count : Int32) : Nil
    all = [] of Pair
    word = 0x0000123456780000_u64
    n = 0
    while n < count
      pair = Pair.new(word, word)
      all << pair
      KEPT.lock { |kept| kept << pair } if n % 4096 == 0
      n = n + 1
    end
  end

  def fresh(count : Int32, kept : UInt64) : Tuple(Int32, Int32)
    held = [] of Chain
    stale = 0
    on_kept = 0
    n = 0
    while n < count
      link = Chain.new(n.to_u64)
      unless link.next.nil?
        stale = stale + 1
        on_kept = on_kept + 1 if kept != 0_u64 && (link.object_id & (0_u64 &- IyiHeap::PAGE)) == kept
      end
      held << link
      n = n + 1
    end
    {stale, on_kept}
  end

  # The class-idle test the wait polls. The idle-never control forces it false
  # at build time (`-Didle_never_force`), so its watchdog is the only exit.
  def class_idle_now(chunk : UInt64) : Bool
    {% if flag?(:idle_never_force) %}
      false
    {% else %}
      IyiMark.class_idle?(chunk)
    {% end %}
  end

  # The class the fresh objects are carved from. A pair and a link are both
  # two words, so the pairs the filler drops and the links the check takes
  # share one class, whose chunk size is read from a link's own address.
  born = 6_000_000
  link = Chain.new(0_u64)
  chunk = IyiHeap.arena_chunk(IyiHeap.arena_of(link.object_id))

  filler = IyiThread.start do
    fill(4_000_000)
    nil
  end
  filler.join
  {% if flag?(:advice_force) %}
    IyiHeap.advice_arm(chunk)
  {% end %}
  IyiMark.collect

  # Until the class is idle by the runtime's own definition (three
  # collections and a second with no use of it, `IyiMark.class_idle?`), its
  # free pages keep warm room, and the carve may find nothing but warm pages.
  # The wait is for that event alone. Its 60-second watchdog is not a verdict:
  # a class that never goes idle is a named setup failure with status 76.
  began = __iyi_monotonic_ns
  while !class_idle_now(chunk)
    if (__iyi_monotonic_ns - began) // 1000000_i64 > 60000_i64
      print "FAIL: reuse integrity: the size class of the fresh objects did not go idle within 60 seconds\n"
      __iyi_exit(76)
    end
    IyiMark.collect
  end
  IyiMark.settle

  reopened = IyiHeap.pages_reopened
  rewarmed = IyiHeap.pages_rewarmed
  {% if flag?(:advice_force) %}
    kept = IyiHeap.advice_kept
    if kept == 0_u64
      print "FAIL: reuse integrity: the copy kept no cold page intact, so the fresh objects proved nothing\n"
      __iyi_exit(76)
    end
  {% else %}
    kept = 0_u64
  {% end %}
  result = fresh(born, kept)
  stale = result[0]
  on_kept = result[1]
  # Cold pages the carve took up, as against warm ones: a warm page was
  # never released, and a check that met none proved nothing.
  cold = (IyiHeap.pages_reopened - reopened) - (IyiHeap.pages_rewarmed - rewarmed)
  if cold == 0_u64
    print "FAIL: reuse integrity: the carve took up no released page, so the fresh objects proved nothing\n"
    __iyi_exit(76)
  end
  raise "reuse integrity: #{stale} of #{born} fresh objects read a field their constructor never set as something other than nil, on #{cold.to_i64} released pages taken up again, #{on_kept} of the stale objects on the cold page whose release the copy skipped" if stale != 0
  puts "reuse integrity: #{born} fresh objects on #{cold.to_i64} released pages taken up again, every unset field nil"
{% else %}
  puts "reuse integrity: the fresh-object check does not run on this target"
{% end %}
