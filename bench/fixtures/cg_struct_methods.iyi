struct Vector2
  @x : Int32
  @y : Int32

  def initialize(x : Int32, y : Int32)
    @x = x
    @y = y
  end

  def x : Int32
    @x
  end

  def y : Int32
    @y
  end

  def length_sq : Int32
    (@x &* @x) &+ (@y &* @y)
  end

  def dot(other : Vector2) : Int32
    (@x &* other.x) &+ (@y &* other.y)
  end

  def add(other : Vector2) : Vector2
    Vector2.new(@x &+ other.x, @y &+ other.y)
  end
end

fun vec_len_sq(x : Int32, y : Int32) : Int32
  v = Vector2.new(x, y)
  v.length_sq
end

fun vec_dot(x1 : Int32, y1 : Int32, x2 : Int32, y2 : Int32) : Int32
  v1 = Vector2.new(x1, y1)
  v2 = Vector2.new(x2, y2)
  v1.dot(v2)
end

fun vec_add_and_len(x1 : Int32, y1 : Int32, x2 : Int32, y2 : Int32) : Int32
  v1 = Vector2.new(x1, y1)
  v2 = Vector2.new(x2, y2)
  v3 = v1.add(v2)
  v3.length_sq
end
