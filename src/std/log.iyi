# Levelled logging with named sources.
#
# `Log.info "started"` writes an `Entry` — source, severity, message and
# the UTC instant it was made — through the root logger's backend.
# `Log.for("db.pool")` answers the logger for that source: a child of
# `db`, which is a child of the root, and the same object every time the
# name is asked for. A logger with no level or backend of its own uses
# its parent's, so `Log.setup(level, backend)` reconfigures the root in
# place and every logger already handed out follows it; a child given
# its own `level=` or `backend=` keeps that until it is set back to nil.
#
# Severities in order: Trace, Debug, Info, Notice, Warn, Error, Fatal, and
# None to silence a logger. An entry below the logger's level is dropped
# before its message is built, so `log.debug { expensive }` costs nothing
# when Debug is off. The default level is Info.
#
# Backends: `IOBackend` writes each entry to an IO through a `Formatter`
# (`DefaultFormatter`: `2024-02-29T15:30:45.123456Z INFO - source: message`,
# the source and its ` - ` omitted at the root); `MemoryBackend` keeps
# the entries for a test to read back. A `Backend` of your own is a
# class with `write(entry)` and `close`.
#
# Logging is synchronous: the entry is written before the call returns,
# in the calling thread, with no queue between.

module std/log

import std/time
using std/time::{Time}

pub enum Severity
  Trace  = 0
  Debug  = 1
  Info   = 2
  Notice = 3
  Warn   = 4
  Error  = 5
  Fatal  = 6
  None   = 7

  def label : String
    case value
    when 0 then "TRACE"
    when 1 then "DEBUG"
    when 2 then "INFO"
    when 3 then "NOTICE"
    when 4 then "WARN"
    when 5 then "ERROR"
    when 6 then "FATAL"
    else        "NONE"
    end
  end

  # The severity named by *name*, case-insensitively, or nil: what a
  # `LOG_LEVEL` variable holds.
  def self.parse?(name : String) : Severity?
    case name.downcase
    when "trace"  then Trace
    when "debug"  then Debug
    when "info"   then Info
    when "notice" then Notice
    when "warn"   then Warn
    when "error"  then Error
    when "fatal"  then Fatal
    when "none"   then None
    else               nil
    end
  end

  def self.parse(name : String) : Severity
    parse?(name) || raise "not a severity: #{name.inspect}"
  end

  def to_s : String
    label
  end

  def <(other : Severity) : Bool
    value < other.value
  end

  def <=(other : Severity) : Bool
    value <= other.value
  end

  def >=(other : Severity) : Bool
    value >= other.value
  end

  def >(other : Severity) : Bool
    value > other.value
  end
end

pub struct Entry
  getter source : String
  getter severity : Severity
  getter message : String
  getter timestamp : Time

  def initialize(@source : String, @severity : Severity, @message : String, @timestamp : Time = Time.utc)
  end
end

pub abstract class Formatter
  abstract def format(entry : Entry) : String

  def format(entry : Entry, io : IO) : Nil
    io.write(format(entry))
    io.write("\n")
  end
end

pub class DefaultFormatter < Formatter
  def format(entry : Entry) : String
    head = "#{entry.timestamp.to_rfc3339(6)} #{entry.severity.label}"
    if entry.source.empty?
      "#{head} - #{entry.message}"
    else
      "#{head} - #{entry.source}: #{entry.message}"
    end
  end
end

pub abstract class Backend
  abstract def write(entry : Entry) : Nil
  abstract def close : Nil
end

pub class IOBackend < Backend
  property formatter : Formatter
  getter io : IO

  def initialize(@io : IO, @formatter : Formatter = DefaultFormatter.new)
  end

  def write(entry : Entry) : Nil
    @formatter.format(entry, @io)
    @io.flush
  end

  def close : Nil
    @io.flush
  end
end

pub class MemoryBackend < Backend
  property formatter : Formatter
  getter entries : Array(Entry)

  def initialize(@formatter : Formatter = DefaultFormatter.new)
    @entries = [] of Entry
  end

  def write(entry : Entry) : Nil
    @entries << entry
  end

  def close : Nil
  end

  # The entries as the formatter would have written them.
  def output : Array(String)
    @entries.map { |e| @formatter.format(e) }
  end

  def clear : Nil
    @entries = [] of Entry
  end
end

pub class Logger
  getter source : String
  @level : Severity?
  @backend : Backend?
  @parent : Logger?
  @children : Hash(String, Logger)

  def initialize(@source : String, level : Severity? = nil, backend : Backend? = nil, parent : Logger? = nil)
    @level = level
    @backend = backend
    @parent = parent
    @children = Hash(String, Logger).new
  end

  # This logger's own level, or the nearest ancestor's; Info at a root
  # never given one.
  def level : Severity
    if l = @level
      l
    elsif p = @parent
      p.level
    else
      Severity::Info
    end
  end

  # nil hands the decision back to the parent.
  def level=(lvl : Severity?) : Nil
    @level = lvl
  end

  def own_level : Severity?
    @level
  end

  # This logger's own backend, or the nearest ancestor's; nil silences.
  def backend : Backend?
    if b = @backend
      b
    elsif p = @parent
      p.backend
    else
      nil
    end
  end

  def backend=(b : Backend?) : Nil
    @backend = b
  end

  def own_backend : Backend?
    @backend
  end

  # The logger for *child_name* under this one, created on first ask;
  # `"a.b"` is the child `b` of the child `a`.
  def for(child_name : String) : Logger
    return self if child_name.empty?

    parts = child_name.split('.')
    current = self
    parts.each do |part|
      current = current.get_or_create_child(part)
    end
    current
  end

  protected def get_or_create_child(name : String) : Logger
    if child = @children[name]?
      return child
    end

    child_source = @source.empty? ? name : "#{@source}.#{name}"
    child = Logger.new(child_source, nil, nil, self)
    @children[name] = child
    child
  end

  def log(severity : Severity, message : String) : Nil
    return if severity < level
    if b = backend
      b.write(Entry.new(@source, severity, message))
    end
  end

  def log(severity : Severity, &block : -> String) : Nil
    return if severity < level
    if b = backend
      b.write(Entry.new(@source, severity, block.call))
    end
  end

  def trace(message : String) : Nil
    log(Severity::Trace, message)
  end

  def trace(&b : -> String) : Nil
    log(Severity::Trace, &b)
  end

  def debug(message : String) : Nil
    log(Severity::Debug, message)
  end

  def debug(&b : -> String) : Nil
    log(Severity::Debug, &b)
  end

  def info(message : String) : Nil
    log(Severity::Info, message)
  end

  def info(&b : -> String) : Nil
    log(Severity::Info, &b)
  end

  def notice(message : String) : Nil
    log(Severity::Notice, message)
  end

  def notice(&b : -> String) : Nil
    log(Severity::Notice, &b)
  end

  def warn(message : String) : Nil
    log(Severity::Warn, message)
  end

  def warn(&b : -> String) : Nil
    log(Severity::Warn, &b)
  end

  def error(message : String) : Nil
    log(Severity::Error, message)
  end

  def error(&b : -> String) : Nil
    log(Severity::Error, &b)
  end

  def fatal(message : String) : Nil
    log(Severity::Fatal, message)
  end

  def fatal(&b : -> String) : Nil
    log(Severity::Fatal, &b)
  end

  def trace? : Bool
    level <= Severity::Trace
  end

  def debug? : Bool
    level <= Severity::Debug
  end

  def info? : Bool
    level <= Severity::Info
  end

  def notice? : Bool
    level <= Severity::Notice
  end

  def warn? : Bool
    level <= Severity::Warn
  end

  def error? : Bool
    level <= Severity::Error
  end

  def fatal? : Bool
    level <= Severity::Fatal
  end
end

# The root logger and the calls that go straight to it.
pub class Log
  @@root : Logger?

  def self.root : Logger
    if r = @@root
      r
    else
      logger = Logger.new("", Severity::Info, IOBackend.new(STDOUT))
      @@root = logger
      logger
    end
  end

  # Reconfigures the root in place, so loggers obtained earlier follow.
  def self.setup(level : Severity = Severity::Info, backend : Backend = IOBackend.new(STDOUT)) : Logger
    r = root
    r.level = level
    r.backend = backend
    r
  end

  def self.for(source : String) : Logger
    root.for(source)
  end

  def self.level : Severity
    root.level
  end

  def self.level=(level : Severity) : Nil
    root.level = level
  end

  def self.backend : Backend?
    root.backend
  end

  def self.backend=(backend : Backend?) : Nil
    root.backend = backend
  end

  def self.trace(msg : String) : Nil
    root.trace(msg)
  end

  def self.trace(&b : -> String) : Nil
    root.trace(&b)
  end

  def self.debug(msg : String) : Nil
    root.debug(msg)
  end

  def self.debug(&b : -> String) : Nil
    root.debug(&b)
  end

  def self.info(msg : String) : Nil
    root.info(msg)
  end

  def self.info(&b : -> String) : Nil
    root.info(&b)
  end

  def self.notice(msg : String) : Nil
    root.notice(msg)
  end

  def self.notice(&b : -> String) : Nil
    root.notice(&b)
  end

  def self.warn(msg : String) : Nil
    root.warn(msg)
  end

  def self.warn(&b : -> String) : Nil
    root.warn(&b)
  end

  def self.error(msg : String) : Nil
    root.error(msg)
  end

  def self.error(&b : -> String) : Nil
    root.error(&b)
  end

  def self.fatal(msg : String) : Nil
    root.fatal(msg)
  end

  def self.fatal(&b : -> String) : Nil
    root.fatal(&b)
  end
end
