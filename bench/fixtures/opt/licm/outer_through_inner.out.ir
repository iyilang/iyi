; iyi-ir 1
source_filename = "outer_through_inner"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @outer_through_inner(i1 %outer_run, i1 %choose, i1 %inner_run, i32 %a, i32 %b, ptr %out) {
entry:
  %value = mul i32 %a, %b
  br label %outer
outer:
  br i1 %outer_run, label %setup, label %done
setup:
  br i1 %choose, label %inner, label %other
other:
  br label %inner
inner:
  br i1 %inner_run, label %body, label %after_inner
body:
  store i32 %value, ptr %out, align 4
  br label %inner
after_inner:
  br label %outer
done:
  ret void
}
