lib LibC
  fun exit(status : Int32) : NoReturn
end

enum Vis : UInt8
  Hidden = 7

  def ==(other : Vis) : Bool
    value == other.value
  end
end

def use(value : Vis, flag : Bool) : Int32
  x = 1
  if flag
    x = value
  end
  if x.is_a?(Vis)
    7
  else
    1
  end
end

LibC.exit(use(Vis::Hidden, true))
