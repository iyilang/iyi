; iyi-ir 1
; reject: unknown intrinsic llvm.fptoui.sat.i32
source_filename = "fptoui_sat_missing_suffix"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
define internal iyicc i32 @f(float %a) {
entry:
  %r = intrinsic llvm.fptoui.sat.i32(float %a)
  ret i32 0
}
