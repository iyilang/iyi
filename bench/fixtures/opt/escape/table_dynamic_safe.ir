; iyi-ir 1
source_filename = "escape_table_dynamic_safe"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Record = type { i64, ptr }
@"__iyi_gc_layouts:table" = internal constant [7 x i64] [ i64 1, i64 10, i64 16, i64 16, i64 1, i64 0, i64 8 ]
@__iyi_gc_layouts = internal constant ptr @"__iyi_gc_layouts:table"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @dynamic_safe(i64 %tid, ptr %heap) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%Record, ptr null, i32 1) to i64), i64 %tid, i64 0)
  %field = getelementptr %Record, ptr %p, i64 0, i32 1
  store ptr %heap, ptr %field, align 8
  %v = load i64, ptr %p, align 8
  ret i64 %v
}
