# XML for iyi: a well-formedness parser, a document tree, and a serializer.
#
# `parse` reads an XML 1.0 document - declaration, comments, processing
# instructions, an internal DTD subset with entity declarations, elements,
# attributes, namespaces, text, CDATA, character and entity references - into a
# `Document` of `Node`s. `parse?` answers nil where `parse` panics. A node can
# be walked (`children`, `parent`, `root`), searched (`find`, `find_all`),
# located (`path`), edited (`add_child`, `set_attribute`, `text=`) and written
# back out (`to_xml`, `inner_xml`). `escape`, `escape_attribute` and `unescape`
# are the character-reference rules on their own.
#
# Bytes are UTF-8 and stay as they are: text is copied by the run, never
# decoded and re-encoded, so a document with "café" or an emoji reads and
# writes the same bytes. Line ends are normalised (`\r\n` and `\r` become
# `\n`) and attribute values have their literal tabs and newlines replaced by
# spaces, as XML 1.0 says. The serializer writes what a document reads back
# as: `&amp; &lt; &gt;` and `&#13;` in text, `&quot;` and `&#9; &#10; &#13;` in
# attribute values as well, `]]>` inside CDATA as the end of one section and
# the start of the next (and a carriage return in it as `&#13;` between two),
# namespace declarations before attributes, an empty element as `<a/>`, and a
# newline after the declaration and after every top-level node; a document
# declared US-ASCII has every other character in its text and attribute
# values written as a decimal reference. A comment or a processing
# instruction has no such escape, so `--` in a comment, a comment ending in
# `-`, and `?>` in a processing instruction are refused when the node is made
# or its text set.
#
# What it refuses, each with the line and column:
#   * an undeclared entity (`&bogus;`), an unterminated one (`&amp` without
#     the `;`), and a character reference that is not an XML character
#     (surrogates, U+0000 and the other C0 controls, anything past U+10FFFF);
#   * `--` inside a comment and `]]>` in text; a control character (other than
#     tab, newline and carriage return) anywhere; a byte that is not UTF-8, a
#     character that is not an XML character (U+FFFE, U+FFFF, an encoded
#     surrogate), and in a document declared US-ASCII any byte past 0x7F;
#   * an XML declaration without its version first, or with `version`,
#     `encoding`, `standalone` out of that order or twice, or a version that
#     is not digits, a dot and digits;
#   * a raw `<` in an attribute value, an attribute given twice - by one
#     spelling or through two prefixes bound to the same uri - a namespace
#     prefix nobody declared, a code point a name cannot hold (XML 1.0, fifth
#     edition: `<a×b/>`, `<·a/>`), a name with a colon first, last or twice
#     or a local part that cannot start a name, a colon in an entity name or a
#     processing instruction target, a declaration of the `xmlns` prefix or
#     of `xml` to another uri, the `xml` or `xmlns` uri bound to any other
#     prefix or to the default namespace, an unquoted value, a second root
#     element, a closing tag that does not match, an unclosed anything;
#   * an external DTD subset or entity (`SYSTEM`/`PUBLIC`) - there is no
#     file or network access here, so there is no XXE;
#   * more than `max_entity_expansions` entity expansions (1,000 by default),
#     an entity that expands more than ten levels deep, or expansions that
#     copy more than 100 times the document's size (8 MiB at least), which
#     is what a "billion laughs" or a quadratic-blowup document is;
#   * elements nested deeper than `max_depth` (256 by default);
#   * an entity whose replacement text holds a `<` - markup where the
#     reference is in content, an error where it is in an attribute value -
#     or, in content, `]]>`;
#   * markup inside an entity's replacement text, a parameter entity
#     reference, and an encoding other than UTF-8 or US-ASCII: each is named
#     as unsupported rather than read as something else.
#
# `unescape` follows the same reference rules as the parser: the five
# predefined entities and valid character references are decoded, everything
# else is refused with the same sentence. The DTD is read for its entities and
# not kept: `to_xml` writes no DOCTYPE, and entity references come out as the
# text they stood for.

module std/xml

pub enum NodeType
  Element
  Text
  CData
  Comment
  ProcessingInstruction
  Document

  def cdata? : Bool
    self == NodeType::CData
  end

  def pi? : Bool
    self == NodeType::ProcessingInstruction
  end
end

# The namespace the `xml:` prefix is bound to without a declaration.
XML_NAMESPACE = "http://www.w3.org/XML/1998/namespace"
# The namespace the `xmlns` prefix is bound to; nothing may be bound to it.
XMLNS_NAMESPACE = "http://www.w3.org/2000/xmlns/"

pub struct Namespace
  getter prefix : String
  getter uri : String

  def initialize(@prefix : String, @uri : String)
  end

  def default? : Bool
    @prefix.empty?
  end

  # With *ascii*, a character past U+007F in the uri is written as a
  # character reference, for a document declared US-ASCII.
  def to_s(ascii : Bool = false) : String
    if @prefix.empty?
      "xmlns=\"#{Std::Xml.escape_attribute(@uri, ascii)}\""
    else
      "xmlns:#{@prefix}=\"#{Std::Xml.escape_attribute(@uri, ascii)}\""
    end
  end
end

pub struct Attribute
  getter name : String
  getter value : String
  getter prefix : String
  getter local_name : String
  # The namespace the prefix was bound to; "" for an unprefixed attribute,
  # which has no namespace, not even the default one.
  getter namespace_uri : String

  def initialize(@name : String, @value : String, @namespace_uri : String = "")
    @prefix = ""
    @local_name = @name
    colon = @name.index(':')
    if !colon.nil? && colon > 0
      @prefix = @name[0, colon]
      @local_name = @name[colon + 1, @name.bytesize - colon - 1]
    end
  end

  # With *ascii*, as `Namespace#to_s`.
  def to_s(ascii : Bool = false) : String
    "#{@name}=\"#{Std::Xml.escape_attribute(@value, ascii)}\""
  end
end

pub class Node
  @@next_id : Int32 = 0
  getter id : Int32
  property node_type : NodeType
  property name : String
  property prefix : String
  property local_name : String
  property attributes : Array(Attribute)
  property children : Array(Node)
  property parent : Node?
  property namespaces : Array(Namespace)
  @content : String

  def ==(other : Node) : Bool
    @id == other.id
  end

  def initialize(@node_type : NodeType, @name : String = "", @content : String = "")
    @@next_id = @@next_id + 1
    @id = @@next_id
    @prefix = ""
    @local_name = @name
    colon = @name.index(':')
    if !colon.nil? && colon > 0
      @prefix = @name[0, colon]
      @local_name = @name[colon + 1, @name.bytesize - colon - 1]
    end
    @attributes = [] of Attribute
    @children = [] of Node
    @parent = nil
    @namespaces = [] of Namespace
    check_content(@content)
  end

  # A comment or a processing instruction has no escape, so content that
  # would close it early is refused where it is given rather than written out
  # as something the parser reads differently.
  private def check_content(value : String) : Nil
    if @node_type.comment?
      raise "'--' is not allowed inside a comment" if value.includes?("--")
      raise "a comment cannot end with '-'" if value.ends_with?("-")
    elsif @node_type.pi?
      raise "'?>' is not allowed inside a processing instruction" if value.includes?("?>")
    end
  end

  def self.new_element(name : String) : Node
    Node.new(NodeType::Element, name: name)
  end

  def self.new_text(content : String) : Node
    Node.new(NodeType::Text, content: content)
  end

  def self.new_cdata(content : String) : Node
    Node.new(NodeType::CData, content: content)
  end

  def self.new_comment(content : String) : Node
    Node.new(NodeType::Comment, content: content)
  end

  def self.new_pi(target : String, content : String) : Node
    Node.new(NodeType::ProcessingInstruction, name: target, content: content)
  end

  def text : String
    content
  end

  # For a text, CDATA, comment or PI node, its own text; for an element, its
  # children are replaced by one text node with *value*.
  def text=(value : String) : Nil
    if @node_type.element?
      i = 0
      while i < @children.size
        @children[i].parent = nil
        i = i + 1
      end
      @children = [] of Node
      add_child(Node.new_text(value))
    elsif @node_type.document?
      raise "a document has no text of its own: set the root element's"
    else
      check_content(value)
      @content = value
    end
  end

  # A text, CDATA, comment or PI node's own text; for an element or a
  # document, the text and CDATA of every descendant, joined.
  def content : String
    return @content unless @node_type.element? || @node_type.document?
    parts = [] of String
    collect_text_into(parts)
    parts.join("")
  end

  protected def collect_text_into(parts : Array(String)) : Nil
    if @node_type.text? || @node_type.cdata?
      parts << @content
    else
      i = 0
      while i < @children.size
        @children[i].collect_text_into(parts)
        i = i + 1
      end
    end
  end

  # The namespace this element's name is in: the one its prefix is bound to,
  # or the default namespace in scope, or nil.
  def namespace : Namespace?
    return resolve_namespace_prefix(@prefix) unless @prefix.empty?
    resolve_default_namespace
  end

  def namespace_uri : String
    ns = namespace
    ns.nil? ? "" : ns.uri
  end

  def resolve_namespace_prefix(prefix : String) : Namespace?
    return Namespace.new("xml", XML_NAMESPACE) if prefix == "xml"
    i = 0
    while i < @namespaces.size
      return @namespaces[i] if @namespaces[i].prefix == prefix
      i = i + 1
    end
    if !(p = @parent).nil?
      return p.resolve_namespace_prefix(prefix)
    end
    nil
  end

  # `xmlns=""` undeclares the default namespace, so a declaration with an
  # empty uri answers nil rather than being passed over.
  def resolve_default_namespace : Namespace?
    i = 0
    while i < @namespaces.size
      if @namespaces[i].default?
        return @namespaces[i].uri.empty? ? nil : @namespaces[i]
      end
      i = i + 1
    end
    if !(p = @parent).nil?
      return p.resolve_default_namespace
    end
    nil
  end

  # The root element of the tree this node is in.
  def root : Node
    curr = self
    while !(p = curr.parent).nil?
      curr = p
    end
    if curr.node_type.document?
      el = curr.first_element_child
      return el unless el.nil?
    end
    curr
  end

  def add_child(child : Node) : Node
    child.parent = self
    @children << child
    child
  end

  def first_child : Node?
    @children.empty? ? nil : @children[0]
  end

  def last_child : Node?
    @children.empty? ? nil : @children[@children.size - 1]
  end

  def first_element_child : Node?
    i = 0
    while i < @children.size
      return @children[i] if @children[i].node_type.element?
      i = i + 1
    end
    nil
  end

  def element_children : Array(Node)
    res = [] of Node
    i = 0
    while i < @children.size
      res << @children[i] if @children[i].node_type.element?
      i = i + 1
    end
    res
  end

  # The value of the attribute with exactly this name (`"x:attr"` is not
  # `"attr"`), or nil.
  def attribute(name : String) : String?
    i = 0
    while i < @attributes.size
      return @attributes[i].value if @attributes[i].name == name
      i = i + 1
    end
    nil
  end

  def [](name : String) : String
    val = attribute(name)
    raise "missing attribute: '#{name}'" if val.nil?
    val
  end

  def []?(name : String) : String?
    attribute(name)
  end

  def has_attribute?(name : String) : Bool
    !attribute(name).nil?
  end

  # Sets or replaces the attribute; a prefixed name takes the namespace its
  # prefix is bound to here, "" where none is declared.
  def set_attribute(name : String, value : String) : Attribute
    attr = Attribute.new(name, value)
    if !attr.prefix.empty?
      ns = resolve_namespace_prefix(attr.prefix)
      attr = Attribute.new(name, value, ns.nil? ? "" : ns.uri)
    end
    i = 0
    while i < @attributes.size
      if @attributes[i].name == name
        @attributes[i] = attr
        return attr
      end
      i = i + 1
    end
    @attributes << attr
    attr
  end

  # The first descendant element whose name or local name is *name*.
  def find(name : String) : Node?
    i = 0
    while i < @children.size
      child = @children[i]
      if child.node_type.element?
        return child if child.name == name || child.local_name == name
        nested = child.find(name)
        return nested unless nested.nil?
      end
      i = i + 1
    end
    nil
  end

  # Every descendant element whose name or local name is *name*, in document
  # order.
  def find_all(name : String) : Array(Node)
    res = [] of Node
    collect_find_all(name, res)
    res
  end

  protected def collect_find_all(name : String, res : Array(Node)) : Nil
    i = 0
    while i < @children.size
      child = @children[i]
      if child.node_type.element?
        res << child if child.name == name || child.local_name == name
        child.collect_find_all(name, res)
      end
      i = i + 1
    end
  end

  # Where this element is, as `/root/item[2]/name[1]`: each step counts
  # same-named element siblings from 1.
  def path : String
    p = @parent
    if p.nil?
      return @node_type.element? ? "/#{@name}" : "/"
    end
    return "/#{@name}" if p.node_type.document?

    index = 1
    i = 0
    while i < p.children.size
      sib = p.children[i]
      break if sib == self
      index = index + 1 if sib.node_type.element? && sib.name == @name
      i = i + 1
    end

    parent_path = p.path
    if parent_path == "/"
      "/#{@name}[#{index}]"
    else
      "#{parent_path}/#{@name}[#{index}]"
    end
  end

  def to_s : String
    to_xml
  end

  def to_xml : String
    buf = [] of String
    serialize_node(buf)
    buf.join("")
  end

  def inner_xml : String
    buf = [] of String
    i = 0
    while i < @children.size
      @children[i].serialize_node(buf)
      i = i + 1
    end
    buf.join("")
  end

  # With *ascii* (a document declared US-ASCII), a character past U+007F in
  # text or an attribute value is written as a character reference: written
  # as its UTF-8 bytes, it made a document no other parser reads.
  protected def serialize_node(buf : Array(String), ascii : Bool = false) : Nil
    if @node_type.element?
      buf << "<"
      buf << @name
      ns_i = 0
      while ns_i < @namespaces.size
        buf << " "
        buf << @namespaces[ns_i].to_s(ascii)
        ns_i = ns_i + 1
      end
      attr_i = 0
      while attr_i < @attributes.size
        buf << " "
        buf << @attributes[attr_i].to_s(ascii)
        attr_i = attr_i + 1
      end
      if @children.empty?
        buf << "/>"
      else
        buf << ">"
        c_i = 0
        while c_i < @children.size
          @children[c_i].serialize_node(buf, ascii)
          c_i = c_i + 1
        end
        buf << "</"
        buf << @name
        buf << ">"
      end
    elsif @node_type.text?
      buf << Std::Xml.escape(@content, ascii)
    elsif @node_type.cdata?
      buf << "<![CDATA["
      serialize_cdata_body(buf)
      buf << "]]>"
    elsif @node_type.comment?
      buf << "<!--"
      buf << @content
      buf << "-->"
    elsif @node_type.pi?
      buf << "<?"
      buf << @name
      if !@content.empty?
        buf << " "
        buf << @content
      end
      buf << "?>"
    else
      c_i = 0
      while c_i < @children.size
        @children[c_i].serialize_node(buf, ascii)
        buf << "\n"
        c_i = c_i + 1
      end
    end
  end

  # A CDATA section has no escape either, so `]]>` in its content is written
  # as two sections, `...]]` and `>...`, which read back as the one run. A
  # carriage return is written between two sections as `&#13;`: kept raw in
  # the section, it read back as a newline.
  private def serialize_cdata_body(buf : Array(String)) : Nil
    if !@content.includes?("]]>") && !@content.includes?("\r")
      buf << @content
      return
    end
    ptr = @content.to_unsafe
    len = @content.bytesize
    run_start = 0
    i = 0
    while i < len
      if i + 2 < len && ptr[i] == 93_u8 && ptr[i + 1] == 93_u8 && ptr[i + 2] == 62_u8
        buf << @content[run_start, i + 2 - run_start]
        buf << "]]><![CDATA["
        run_start = i + 2
        i = i + 2
      elsif ptr[i] == 13_u8
        buf << @content[run_start, i - run_start]
        buf << "]]>&#13;<![CDATA["
        run_start = i + 1
        i = i + 1
      else
        i = i + 1
      end
    end
    buf << @content[run_start, len - run_start]
  end
end

pub class Document < Node
  property version : String
  property encoding : String
  property standalone : Bool?

  def initialize(@version : String = "1.0", @encoding : String = "UTF-8", @standalone : Bool? = nil)
    super(NodeType::Document, name: "#document")
  end

  def root : Node
    el = first_element_child
    raise "document has no root element" if el.nil?
    el
  end

  def root? : Node?
    first_element_child
  end

  def to_xml : String
    buf = [] of String
    buf << "<?xml version=\""
    buf << @version
    buf << "\""
    if !@encoding.empty?
      buf << " encoding=\""
      buf << @encoding
      buf << "\""
    end
    if !@standalone.nil?
      buf << " standalone=\""
      buf << (@standalone ? "yes" : "no")
      buf << "\""
    end
    buf << "?>\n"
    lowered = @encoding.downcase
    serialize_node(buf, lowered == "us-ascii" || lowered == "ascii")
    buf.join("")
  end
end

# The parser keeps the first thing that went wrong in `error` and, once
# something has, runs its cursor to the end so every loop above it unwinds:
# `parse?` then answers nil and `parse` panics with that sentence.
pub class Parser
  @input : String
  @len : Int32
  @pos : Int32
  @line : Int32
  @col : Int32
  @max_depth : Int32
  @depth : Int32
  @entities : Hash(String, String)
  @expansions : Int32
  @max_expansions : Int32
  # Bytes of replacement text copied so far, and how many a document may
  # have: 100 times its own size, and never less than 8 MiB.
  @expanded_bytes : Int64
  @max_expanded_bytes : Int64
  @error : String
  @bad_at : Int32
  @bad_message : String

  def initialize(input : String, @max_depth : Int32 = 256, @max_expansions : Int32 = 1000)
    @input = Parser.normalize_line_ends(input)
    @len = @input.bytesize
    @pos = 0
    @line = 1
    @col = 1
    @depth = 0
    @entities = Hash(String, String).new
    @expansions = 0
    @expanded_bytes = 0_i64
    @max_expanded_bytes = @len.to_i64 * 100
    @max_expanded_bytes = 8_i64 * 1024 * 1024 if @max_expanded_bytes < 8_i64 * 1024 * 1024
    @error = ""
    bad = Parser.first_bad_character(@input, 0, false)
    @bad_at = bad[0]
    @bad_message = bad[1]
  end

  # The sentence the last parse failed with, or "" when it did not.
  def error : String
    @error
  end

  def parse? : Document?
    doc = parse_document
    @error.empty? ? doc : nil
  end

  def parse : Document
    doc = parse_document
    raise @error unless @error.empty?
    doc
  end

  # `\r\n` and a lone `\r` both mean `\n` (XML 1.0, 2.11).
  protected def self.normalize_line_ends(input : String) : String
    return input unless input.includes?("\r")
    ptr = input.to_unsafe
    len = input.bytesize
    bytes = [] of UInt8
    i = 0
    while i < len
      b = ptr[i]
      if b == 13_u8
        bytes << 10_u8
        i = i + 1 if i + 1 < len && ptr[i + 1] == 10_u8
      else
        bytes << b
      end
      i = i + 1
    end
    String.new(bytes.size) { |buffer| buffer.copy_from(bytes.to_unsafe, bytes.size) }
  end

  # -- the cursor ----------------------------------------------------------

  private def failed? : Bool
    !@error.empty?
  end

  private def fail(message : String) : Nil
    fail_at(@line, @col, message)
  end

  private def fail_at(line : Int32, col : Int32, message : String) : Nil
    return unless @error.empty?
    @error = "#{message} at line #{line}, column #{col}"
    @pos = @len
  end

  private def byte_at(i : Int32) : UInt8
    @input.to_unsafe[i]
  end

  # One byte on; a column is a character, so a continuation byte is not one.
  # Every byte the parser reads passes here, so the first one that is not
  # part of an XML character is refused where it stands, in document order.
  private def step : Nil
    if @pos == @bad_at
      fail(@bad_message)
      return
    end
    b = @input.to_unsafe[@pos]
    @pos = @pos + 1
    if b == 10_u8
      @line = @line + 1
      @col = 1
    elsif (b & 192_u8) != 128_u8
      @col = @col + 1
    end
  end

  # Where the first byte at or after *from* that does not begin an XML
  # character is, with the sentence it is refused with; -1 and "" when there
  # is none. Only a C0 control is caught where the text is read, so without
  # this a byte that is not UTF-8, an encoded surrogate, U+FFFE and U+FFFF
  # were read and written back, while their character references were
  # refused. With *ascii*, any byte past 0x7F is one.
  protected def self.first_bad_character(input : String, from : Int32, ascii : Bool) : Tuple(Int32, String)
    ptr = input.to_unsafe
    len = input.bytesize
    i = from
    while i < len
      b = ptr[i]
      if b < 128_u8
        i = i + 1
        next
      end
      byte = "0x" + Parser.hex4(b.to_i32)[2, 2]
      return {i, "byte #{byte} is not US-ASCII, the declared encoding"} if ascii
      n = b >= 0xF5_u8 ? 0 : (b >= 0xF0_u8 ? 4 : (b >= 0xE0_u8 ? 3 : (b >= 0xC2_u8 ? 2 : 0)))
      return {i, "byte #{byte} is not UTF-8"} if n == 0 || i + n > len
      cp = (b & (n == 2 ? 0x1F_u8 : (n == 3 ? 0x0F_u8 : 0x07_u8))).to_i32
      k = 1
      while k < n
        c = ptr[i + k]
        return {i, "byte #{byte} is not UTF-8"} if (c & 0xC0_u8) != 0x80_u8
        cp = (cp << 6) | (c & 0x3F_u8).to_i32
        k = k + 1
      end
      overlong = (n == 3 && cp < 0x800) || (n == 4 && cp < 0x10000)
      return {i, "byte #{byte} is not UTF-8"} if overlong || cp > 0x10FFFF
      return {i, "character U+#{Parser.hex4(cp)} is not an XML character"} unless xml_char?(cp)
      i = i + n
    end
    {-1, ""}
  end

  private def skip_whitespace : Bool
    skipped = false
    while @pos < @len
      b = byte_at(@pos)
      break unless b == 32_u8 || b == 9_u8 || b == 10_u8
      step
      skipped = true
    end
    skipped
  end

  private def match?(literal : String) : Bool
    n = literal.bytesize
    return false if @pos + n > @len
    ptr = @input.to_unsafe + @pos
    lit = literal.to_unsafe
    i = 0
    while i < n
      return false if ptr[i] != lit[i]
      i = i + 1
    end
    true
  end

  private def consume(literal : String) : Bool
    return false unless match?(literal)
    i = 0
    while i < literal.bytesize
      step
      i = i + 1
    end
    true
  end

  private def slice_from(from : Int32) : String
    @input[from, @pos - from]
  end

  private def control?(b : UInt8) : Bool
    b < 32_u8 && b != 9_u8 && b != 10_u8
  end

  private def fail_control(b : UInt8) : Nil
    fail("control character U+#{Parser.hex4(b.to_i32)} is not allowed")
  end

  # One or more digits, a dot, then digits: the version numbers the other
  # library reads (`1.0`, `1.1`, `1.`).
  protected def self.version_number?(value : String) : Bool
    ptr = value.to_unsafe
    len = value.bytesize
    i = 0
    while i < len && ptr[i] >= 48_u8 && ptr[i] <= 57_u8
      i = i + 1
    end
    return false if i == 0 || i >= len || ptr[i] != 46_u8
    i = i + 1
    while i < len && ptr[i] >= 48_u8 && ptr[i] <= 57_u8
      i = i + 1
    end
    i == len
  end

  protected def self.hex4(value : Int32) : String
    digits = value.to_s(16).upcase
    while digits.bytesize < 4
      digits = "0" + digits
    end
    digits
  end

  # -- the document --------------------------------------------------------

  private def parse_document : Document
    doc = Document.new
    # A UTF-16 file opens with its byte order mark, FF FE or FE FF - what
    # Windows PowerShell 5.1's `Out-File`, `>` and `Export-Clixml` write -
    # and was read as UTF-8 until the first `<`: "text outside the root
    # element at line 1, column 1", about a document that has none.
    if @len >= 2 && ((byte_at(0) == 0xFF_u8 && byte_at(1) == 0xFE_u8) || (byte_at(0) == 0xFE_u8 && byte_at(1) == 0xFF_u8))
      fail_at(1, 1, "encoding 'UTF-16' is not supported: the input is read as UTF-8")
      return doc
    end
    @pos = 3 if match?("\u{FEFF}")
    if match?("<?xml") && @pos + 5 < @len && whitespace_byte?(byte_at(@pos + 5))
      parse_xml_declaration(doc)
    end

    has_root = false
    seen_doctype = false
    while @pos < @len
      skip_whitespace
      break if @pos >= @len
      if match?("<!--")
        doc.add_child(parse_comment)
      elsif match?("<?")
        doc.add_child(parse_pi)
      elsif match?("<!DOCTYPE")
        if has_root
          fail("DOCTYPE must come before the root element")
        elsif seen_doctype
          fail("a second DOCTYPE")
        else
          seen_doctype = true
          parse_doctype
        end
      elsif match?("<![CDATA[")
        fail("CDATA is only allowed inside an element")
      elsif match?("</")
        fail("closing tag outside the root element")
      elsif match?("<")
        if has_root
          fail("a second root element")
        else
          doc.add_child(parse_element(doc))
          has_root = true
        end
      else
        fail("text outside the root element")
      end
    end

    fail("document has no root element") if !has_root && !failed?
    doc
  end

  private def whitespace_byte?(b : UInt8) : Bool
    b == 32_u8 || b == 9_u8 || b == 10_u8
  end

  # The declaration is `version`, then `encoding`, then `standalone`, the
  # first required and each at most once (XML 1.0, production [23]): taking
  # any of them in any order, or none, read `<?xml ?>` and
  # `<?xml standalone="yes" version="1.0"?>` as declarations.
  private def parse_xml_declaration(doc : Document) : Nil
    start_line = @line
    start_col = @col
    consume("<?xml")
    doc.encoding = ""
    stage = 0 # 1 after version, 2 after encoding, 3 after standalone
    while @pos < @len
      had_space = skip_whitespace
      if consume("?>")
        fail_at(start_line, start_col, "the XML declaration has no version") if stage == 0
        return
      end
      if !had_space
        fail("expected whitespace in the XML declaration")
        return
      end
      attr_line = @line
      attr_col = @col
      attr_name = parse_name
      return if failed?
      skip_whitespace
      if !consume("=")
        fail("expected '=' after '#{attr_name}' in the XML declaration")
        return
      end
      skip_whitespace
      attr_val = parse_quoted_literal
      return if failed?
      in_place = (attr_name == "version" && stage == 0) || (attr_name == "encoding" && stage == 1) ||
                 (attr_name == "standalone" && (stage == 1 || stage == 2))
      if !in_place && (attr_name == "version" || attr_name == "encoding" || attr_name == "standalone")
        fail_at(attr_line, attr_col, "'#{attr_name}' is out of place in the XML declaration: it is version, encoding, standalone, each once")
        return
      end
      if attr_name == "version"
        # Digits, a dot, digits: `1.0`, `1.1`; any text was taken, a control
        # character or a `<` included.
        if !Parser.version_number?(attr_val)
          fail_at(attr_line, attr_col, "version '#{attr_val}' is not a version number")
          return
        end
        doc.version = attr_val
        stage = 1
      elsif attr_name == "encoding"
        lowered = attr_val.downcase
        if lowered != "utf-8" && lowered != "utf8" && lowered != "us-ascii" && lowered != "ascii"
          fail_at(start_line, start_col, "encoding '#{attr_val}' is not supported: the input is read as UTF-8")
          return
        end
        doc.encoding = attr_val
        stage = 2
        # A US-ASCII document has no byte past 0x7F: one is refused where it
        # stands rather than read as UTF-8.
        if lowered == "us-ascii" || lowered == "ascii"
          bad = Parser.first_bad_character(@input, @pos, true)
          if bad[0] >= 0 && (@bad_at < 0 || bad[0] < @bad_at)
            @bad_at = bad[0]
            @bad_message = bad[1]
          end
        end
      elsif attr_name == "standalone"
        if attr_val == "yes"
          doc.standalone = true
        elsif attr_val == "no"
          doc.standalone = false
        else
          fail("standalone must be 'yes' or 'no', not '#{attr_val}'")
          return
        end
        stage = 3
      else
        fail("'#{attr_name}' is not an XML declaration attribute")
        return
      end
    end
    fail_at(start_line, start_col, "unclosed XML declaration")
  end

  # -- the DTD -------------------------------------------------------------

  private def parse_doctype : Nil
    start_line = @line
    start_col = @col
    consume("<!DOCTYPE")
    # `<!DOCTYPEa>` is no DOCTYPE: the name follows whitespace.
    if !skip_whitespace
      fail("expected whitespace after <!DOCTYPE")
      return
    end
    parse_name
    return if failed?
    skip_whitespace
    if match?("SYSTEM") || match?("PUBLIC")
      fail("external DTD subset refused: no SYSTEM or PUBLIC identifier is read")
      return
    end
    if consume("[")
      parse_internal_subset
      return if failed?
      if !consume("]")
        fail_at(start_line, start_col, "unclosed DOCTYPE internal subset")
        return
      end
      skip_whitespace
    end
    fail_at(start_line, start_col, "unclosed DOCTYPE") unless consume(">")
  end

  private def parse_internal_subset : Nil
    while @pos < @len
      skip_whitespace
      return if match?("]")
      if match?("<!ENTITY")
        parse_entity_decl
      elsif match?("<!--")
        parse_comment
      elsif match?("<?")
        parse_pi
      elsif match?("<!ELEMENT") || match?("<!ATTLIST") || match?("<!NOTATION")
        skip_declaration
      elsif match?("%")
        fail("parameter entity references are not supported")
      else
        fail("unexpected text in the DOCTYPE internal subset")
      end
      return if failed?
    end
  end

  # A declaration that is not used: skipped to its `>`, quotes respected.
  # A `<` outside quotes means the `>` is missing - the skip ran on through
  # the next declaration and lost it - and a control character is refused
  # here as everywhere else; both were skipped over.
  private def skip_declaration : Nil
    start_line = @line
    start_col = @col
    step
    while @pos < @len
      b = byte_at(@pos)
      if b == 62_u8
        step
        return
      elsif b == 60_u8
        break
      elsif b == 34_u8 || b == 39_u8
        step
        while @pos < @len && byte_at(@pos) != b
          if control?(byte_at(@pos))
            fail_control(byte_at(@pos))
            return
          end
          step
        end
        step if @pos < @len
      elsif control?(b)
        fail_control(b)
        return
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed declaration in the DOCTYPE internal subset")
  end

  private def parse_entity_decl : Nil
    start_line = @line
    start_col = @col
    consume("<!ENTITY")
    if !skip_whitespace
      fail("expected whitespace after <!ENTITY")
      return
    end
    parameter = consume("%")
    # `<!ENTITY % p ...>`: the space after the `%` is not optional.
    if parameter && !skip_whitespace
      fail("expected whitespace after '%' in <!ENTITY")
      return
    end
    name_line = @line
    name_col = @col
    name = parse_name
    return if failed?
    # Namespaces in XML, section 7: no entity name holds a colon.
    if name.includes?(":")
      fail_at(name_line, name_col, "entity name '#{name}' cannot hold a colon")
      return
    end
    if !skip_whitespace
      fail("expected whitespace after the entity name '#{name}'")
      return
    end
    if match?("SYSTEM") || match?("PUBLIC")
      fail("external entity '#{name}' refused: no SYSTEM or PUBLIC identifier is read")
      return
    end
    value = parse_entity_value(name)
    return if failed?
    @entities[name] = value if !parameter && !@entities.has_key?(name)
    skip_whitespace
    fail_at(start_line, start_col, "unclosed entity declaration for '#{name}'") unless consume(">")
  end

  # The literal in quotes: character references are decoded now, a general
  # entity reference is checked and kept for the moment it is used.
  private def parse_entity_value(entity : String) : String
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("entity value must be quoted")
      return ""
    end
    step
    parts = [] of String
    run_start = @pos
    while @pos < @len
      b = byte_at(@pos)
      if b == quote
        parts << slice_from(run_start)
        step
        return parts.join("")
      elsif b == 60_u8
        fail("markup inside the value of entity '#{entity}' is not supported")
        return ""
      elsif b == 37_u8
        # A `%` here starts a parameter entity reference, which the internal
        # subset does not allow inside a declaration; it was kept as text.
        fail("parameter entity references are not supported")
        return ""
      elsif b == 38_u8
        parts << slice_from(run_start)
        parts << parse_reference(0, true)
        return "" if failed?
        run_start = @pos
      elsif control?(b)
        fail_control(b)
        return ""
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed entity value")
    ""
  end

  # -- comments, PIs, CDATA ------------------------------------------------

  private def parse_comment : Node
    start_line = @line
    start_col = @col
    consume("<!--")
    run_start = @pos
    while @pos < @len
      if match?("-->")
        body = slice_from(run_start)
        consume("-->")
        return Node.new_comment(body)
      elsif match?("--")
        fail("'--' is not allowed inside a comment")
        return Node.new_comment("")
      end
      b = byte_at(@pos)
      if control?(b)
        fail_control(b)
        return Node.new_comment("")
      end
      step
    end
    fail_at(start_line, start_col, "unclosed comment")
    Node.new_comment("")
  end

  private def parse_pi : Node
    start_line = @line
    start_col = @col
    consume("<?")
    target = parse_name
    return Node.new_pi("", "") if failed?
    if target.downcase == "xml"
      fail_at(start_line, start_col, "processing instruction target '#{target}' is reserved")
      return Node.new_pi("", "")
    end
    # Namespaces in XML, section 7: no processing instruction target holds
    # a colon.
    if target.includes?(":")
      fail_at(start_line, start_col, "processing instruction target '#{target}' cannot hold a colon")
      return Node.new_pi("", "")
    end
    return Node.new_pi(target, "") if consume("?>")
    if !skip_whitespace
      fail("expected whitespace after the processing instruction target '#{target}'")
      return Node.new_pi("", "")
    end
    run_start = @pos
    while @pos < @len
      if match?("?>")
        body = slice_from(run_start)
        consume("?>")
        return Node.new_pi(target, body)
      end
      b = byte_at(@pos)
      if control?(b)
        fail_control(b)
        return Node.new_pi("", "")
      end
      step
    end
    fail_at(start_line, start_col, "unclosed processing instruction")
    Node.new_pi("", "")
  end

  private def parse_cdata : Node
    start_line = @line
    start_col = @col
    consume("<![CDATA[")
    run_start = @pos
    while @pos < @len
      if match?("]]>")
        body = slice_from(run_start)
        consume("]]>")
        return Node.new_cdata(body)
      end
      b = byte_at(@pos)
      if control?(b)
        fail_control(b)
        return Node.new_cdata("")
      end
      step
    end
    fail_at(start_line, start_col, "unclosed CDATA section")
    Node.new_cdata("")
  end

  # -- elements ------------------------------------------------------------

  private def parse_element(parent : Node) : Node
    start_line = @line
    start_col = @col
    step
    elem = Node.new_element("")
    @depth = @depth + 1
    if @depth > @max_depth
      fail_at(start_line, start_col, "elements nested deeper than #{@max_depth}")
      return elem
    end

    name = parse_name
    return elem if failed?
    return elem unless qualified_name?(name, start_line, start_col)
    elem = Node.new_element(name)
    elem.parent = parent

    seen = Hash(String, Bool).new
    raw_names = [] of String
    raw_values = [] of String
    raw_lines = [] of Int32
    raw_cols = [] of Int32
    self_closing = false
    closed = false
    while @pos < @len
      had_space = skip_whitespace
      if consume("/>")
        self_closing = true
        closed = true
        break
      elsif consume(">")
        closed = true
        break
      end
      if !had_space
        fail("expected whitespace before the next attribute of <#{name}>")
        return elem
      end
      attr_line = @line
      attr_col = @col
      attr_name = parse_name
      return elem if failed?
      return elem unless qualified_name?(attr_name, attr_line, attr_col)
      if seen.has_key?(attr_name)
        fail_at(attr_line, attr_col, "attribute '#{attr_name}' given twice on <#{name}>")
        return elem
      end
      seen[attr_name] = true
      skip_whitespace
      if !consume("=")
        fail("expected '=' after the attribute name '#{attr_name}'")
        return elem
      end
      skip_whitespace
      attr_val = parse_attribute_value
      return elem if failed?
      # The uris of the `xml` and `xmlns` prefixes are theirs alone: no other
      # prefix and not the default namespace may be bound to either
      # (Namespaces in XML, 3). Only the `xml` uri on a prefix was refused.
      if attr_name == "xmlns"
        if attr_val == XML_NAMESPACE || attr_val == XMLNS_NAMESPACE
          fail_at(attr_line, attr_col, "the default namespace cannot be bound to the uri of the '#{attr_val == XML_NAMESPACE ? "xml" : "xmlns"}' prefix")
          return elem
        end
        elem.namespaces << Namespace.new("", attr_val)
      elsif attr_name.starts_with?("xmlns:")
        ns_prefix = attr_name[6, attr_name.bytesize - 6]
        if attr_val.empty?
          fail_at(attr_line, attr_col, "namespace prefix '#{ns_prefix}' cannot be bound to an empty uri")
          return elem
        elsif ns_prefix == "xmlns"
          fail_at(attr_line, attr_col, "namespace prefix 'xmlns' is reserved and cannot be declared")
          return elem
        elsif ns_prefix == "xml" && attr_val != XML_NAMESPACE
          fail_at(attr_line, attr_col, "namespace prefix 'xml' cannot be bound to a uri other than '#{XML_NAMESPACE}'")
          return elem
        elsif ns_prefix != "xml" && attr_val == XML_NAMESPACE
          fail_at(attr_line, attr_col, "namespace prefix '#{ns_prefix}' cannot be bound to the uri of the 'xml' prefix")
          return elem
        elsif attr_val == XMLNS_NAMESPACE
          fail_at(attr_line, attr_col, "namespace prefix '#{ns_prefix}' cannot be bound to the uri of the 'xmlns' prefix")
          return elem
        end
        elem.namespaces << Namespace.new(ns_prefix, attr_val)
      else
        raw_names << attr_name
        raw_values << attr_val
        raw_lines << attr_line
        raw_cols << attr_col
      end
    end
    if !closed
      fail_at(start_line, start_col, "unclosed start tag <#{name}>")
      return elem
    end

    if !elem.prefix.empty? && elem.resolve_namespace_prefix(elem.prefix).nil?
      fail_at(start_line, start_col, "namespace prefix '#{elem.prefix}' of <#{name}> is not declared")
      return elem
    end
    # Two spellings of one attribute - the same local name through two
    # prefixes bound to the same uri - are a duplicate as much as one
    # spelling twice.
    expanded = Hash(String, String).new
    i = 0
    while i < raw_names.size
      attr = Attribute.new(raw_names[i], raw_values[i])
      if !attr.prefix.empty?
        ns = elem.resolve_namespace_prefix(attr.prefix)
        if ns.nil?
          fail_at(start_line, start_col, "namespace prefix '#{attr.prefix}' of attribute '#{attr.name}' on <#{name}> is not declared")
          return elem
        end
        attr = Attribute.new(raw_names[i], raw_values[i], ns.uri)
        key = "#{ns.uri}\n#{attr.local_name}"
        first = expanded[key]?
        if !first.nil?
          fail_at(raw_lines[i], raw_cols[i], "attribute '#{attr.local_name}' in namespace '#{ns.uri}' given twice on <#{name}>, as '#{first}' and '#{attr.name}'")
          return elem
        end
        expanded[key] = attr.name
      end
      elem.attributes << attr
      i = i + 1
    end

    if self_closing
      @depth = @depth - 1
      return elem
    end

    parts = [] of String
    run_start = @pos
    while @pos < @len
      b = byte_at(@pos)
      if b == 60_u8
        parts << slice_from(run_start)
        flush_text(elem, parts)
        parts = [] of String
        if match?("</")
          end_line = @line
          end_col = @col
          consume("</")
          closing = parse_name
          return elem if failed?
          skip_whitespace
          if !consume(">")
            fail("expected '>' to end the closing tag </#{closing}>")
            return elem
          end
          if closing != name
            fail_at(end_line, end_col, "mismatched closing tag: expected </#{name}>, got </#{closing}>")
            return elem
          end
          @depth = @depth - 1
          return elem
        elsif match?("<!--")
          elem.add_child(parse_comment)
        elsif match?("<![CDATA[")
          elem.add_child(parse_cdata)
        elsif match?("<?")
          elem.add_child(parse_pi)
        else
          elem.add_child(parse_element(elem))
        end
        return elem if failed?
        run_start = @pos
      elsif b == 38_u8
        parts << slice_from(run_start)
        parts << parse_reference(0)
        return elem if failed?
        run_start = @pos
      elsif b == 93_u8 && match?("]]>")
        fail("']]>' is not allowed in text")
        return elem
      elsif control?(b)
        fail_control(b)
        return elem
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed element <#{name}>")
    elem
  end

  private def flush_text(elem : Node, parts : Array(String)) : Nil
    return if parts.empty?
    text = parts.join("")
    elem.add_child(Node.new_text(text)) unless text.empty?
  end

  # A quoted value with references decoded and a literal tab or newline
  # read as a space (attribute-value normalisation, XML 1.0 3.3.3).
  private def parse_attribute_value : String
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("attribute value must be quoted")
      return ""
    end
    step
    parts = [] of String
    run_start = @pos
    while @pos < @len
      b = byte_at(@pos)
      if b == quote
        parts << slice_from(run_start)
        step
        return parts.join("")
      elsif b == 60_u8
        fail("raw '<' is not allowed in an attribute value")
        return ""
      elsif b == 38_u8
        parts << slice_from(run_start)
        parts << parse_reference(0, false, true)
        return "" if failed?
        run_start = @pos
      elsif b == 9_u8 || b == 10_u8
        parts << slice_from(run_start)
        parts << " "
        step
        run_start = @pos
      elsif control?(b)
        fail_control(b)
        return ""
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed attribute value")
    ""
  end

  # A quoted value taken as written: the XML declaration's.
  private def parse_quoted_literal : String
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("expected a quoted value")
      return ""
    end
    step
    run_start = @pos
    while @pos < @len
      if byte_at(@pos) == quote
        value = slice_from(run_start)
        step
        return value
      end
      step
    end
    fail_at(start_line, start_col, "unclosed quote")
    ""
  end

  # -- references ----------------------------------------------------------

  # At an `&`: the text the reference stands for. With *keep_names*, an
  # entity reference is checked for shape and answered as written (`&name;`),
  # which is what an entity's own value keeps until it is used. With
  # *in_attribute*, the reference stands in an attribute value.
  private def parse_reference(depth : Int32, keep_names : Bool = false, in_attribute : Bool = false) : String
    ref_line = @line
    ref_col = @col
    ref_start = @pos
    step
    while @pos < @len && byte_at(@pos) != 59_u8 && !reference_stop?(byte_at(@pos))
      step
    end
    if @pos >= @len || byte_at(@pos) != 59_u8
      kind = @pos > ref_start + 1 && byte_at(ref_start + 1) == 35_u8 ? "character" : "entity"
      fail_at(ref_line, ref_col, "unterminated #{kind} reference #{slice_from(ref_start)}: expected ';'")
      return ""
    end
    ref = @input[ref_start + 1, @pos - ref_start - 1]
    step
    if ref.empty?
      fail_at(ref_line, ref_col, "empty entity reference")
      return ""
    end
    if ref.starts_with?("#")
      cp = char_ref_value(ref)
      if cp < 0
        fail_at(ref_line, ref_col, "invalid character reference '&#{ref};'")
        return ""
      elsif !xml_char?(cp)
        fail_at(ref_line, ref_col, "character reference &#{ref}; is not an XML character")
        return ""
      end
      return cp.unsafe_chr.to_s
    end
    # `&a]b;` and `&0;` are no references: kept as written in an entity's
    # value, they were accepted wherever that entity went unused.
    if !Parser.name_shaped?(ref)
      fail_at(ref_line, ref_col, "'&#{ref};' is not a reference: '#{ref}' is not a name")
      return ""
    end
    return slice_from(ref_start) if keep_names
    expand_entity(ref, ref_line, ref_col, depth, in_attribute)
  end

  private def expand_entity(name : String, line : Int32, col : Int32, depth : Int32, in_attribute : Bool) : String
    return "<" if name == "lt"
    return ">" if name == "gt"
    return "&" if name == "amp"
    return "'" if name == "apos"
    return "\"" if name == "quot"
    value = @entities[name]?
    if value.nil?
      fail_at(line, col, "undefined entity reference &#{name};")
      return ""
    end
    if depth >= 10
      fail_at(line, col, "entity &#{name}; expands more than 10 levels deep")
      return ""
    end
    @expansions = @expansions + 1
    if @expansions > @max_expansions
      fail_at(line, col, "entity expansion limit of #{@max_expansions} exceeded at &#{name};")
      return ""
    end
    # Counting expansions alone let one large entity used a thousand times
    # make a thousand times the document: 1 MB of input read as 1 GB of text.
    @expanded_bytes = @expanded_bytes + value.bytesize
    if @expanded_bytes > @max_expanded_bytes
      fail_at(line, col, "entity expansion past #{@max_expanded_bytes} bytes at &#{name};")
      return ""
    end
    # The replacement text is read where the reference stands, and it was
    # read as plain text everywhere. In an attribute value a `<` in it is an
    # error (XML 1.0, "No < in Attribute Values") and its tabs and line ends
    # are spaces (3.3.3); in content a `<` is markup, which is not supported,
    # and `]]>` is refused as it is in text.
    if value.includes?("<")
      if in_attribute
        fail_at(line, col, "entity &#{name}; holds a '<', which an attribute value cannot")
      else
        fail_at(line, col, "markup inside the value of entity '#{name}' is not supported")
      end
      return ""
    end
    if !in_attribute && value.includes?("]]>")
      fail_at(line, col, "']]>' is not allowed in text, nor in the value of entity '#{name}'")
      return ""
    end
    return (in_attribute ? Parser.attribute_spaces(value) : value) unless value.includes?("&")

    # The replacement text is read as content: a character reference is
    # decoded, an entity reference expanded a level deeper.
    ptr = value.to_unsafe
    len = value.bytesize
    parts = [] of String
    run_start = 0
    i = 0
    while i < len
      if ptr[i] == 38_u8
        literal = value[run_start, i - run_start]
        parts << (in_attribute ? Parser.attribute_spaces(literal) : literal)
        semi = i + 1
        while semi < len && ptr[semi] != 59_u8 && !reference_stop?(ptr[semi])
          semi = semi + 1
        end
        if semi >= len || ptr[semi] != 59_u8
          fail_at(line, col, "unterminated reference #{value[i, semi - i]} in the value of entity '#{name}': expected ';'")
          return ""
        end
        ref = value[i + 1, semi - i - 1]
        if ref.empty?
          fail_at(line, col, "empty entity reference in the value of entity '#{name}'")
          return ""
        elsif ref.starts_with?("#")
          cp = char_ref_value(ref)
          if cp < 0
            fail_at(line, col, "invalid character reference '&#{ref};' in the value of entity '#{name}'")
            return ""
          elsif !xml_char?(cp)
            fail_at(line, col, "character reference &#{ref}; in the value of entity '#{name}' is not an XML character")
            return ""
          end
          parts << cp.unsafe_chr.to_s
        else
          parts << expand_entity(ref, line, col, depth + 1, in_attribute)
          return "" if failed?
        end
        i = semi + 1
        run_start = i
      else
        i = i + 1
      end
    end
    literal = value[run_start, len - run_start]
    parts << (in_attribute ? Parser.attribute_spaces(literal) : literal)
    parts.join("")
  end

  # An entity's replacement text in an attribute value: a tab, newline or
  # carriage return in it is a space, as one written in the value is. One
  # that a character reference in the replacement text names is not.
  protected def self.attribute_spaces(text : String) : String
    ptr = text.to_unsafe
    len = text.bytesize
    i = 0
    while i < len && ptr[i] != 9_u8 && ptr[i] != 10_u8 && ptr[i] != 13_u8
      i = i + 1
    end
    return text if i == len
    String.new(len) do |buffer|
      buffer.copy_from(ptr, len)
      while i < len
        b = ptr[i]
        buffer[i] = 32_u8 if b == 9_u8 || b == 10_u8 || b == 13_u8
        i = i + 1
      end
    end
  end

  # -- names ---------------------------------------------------------------

  private def parse_name : String
    name = parse_name?
    return name unless name.nil?
    if @pos >= @len
      fail("expected a name, found the end of the input")
    else
      fail("expected a name, found #{found_here}")
    end
    ""
  end

  # The character at the cursor, for a sentence: `'x'`, or its code point
  # (`U+00B7`) where it does not print as itself.
  private def found_here : String
    cp = code_point_at(@input.to_unsafe, @len, @pos)
    cp >= 32 && cp < 127 ? "'#{cp.unsafe_chr}'" : "U+#{Parser.hex4(cp)}"
  end

  # An element or attribute name is `local` or `prefix:local`, with neither
  # part empty (Namespaces in XML, productions [7] and [8]): a colon first,
  # last, or twice is refused with the name's line and column, and so is a
  # local part that does not start as a name does (`p:-a`, `p:1`), which was
  # taken.
  private def qualified_name?(name : String, line : Int32, col : Int32) : Bool
    ptr = name.to_unsafe
    len = name.bytesize
    colons = 0
    colon_at = 0
    i = 0
    while i < len
      if ptr[i] == 58_u8
        colons = colons + 1
        colon_at = i
      end
      i = i + 1
    end
    return true if colons == 0
    if colons == 1 && ptr[0] != 58_u8 && ptr[len - 1] != 58_u8 && Parser.name_start?(code_point_at(ptr, len, colon_at + 1))
      return true
    end
    fail_at(line, col, "'#{name}' is not a qualified name: a name is 'local' or 'prefix:local'")
    false
  end

  # XML 1.0 (fifth edition), production [4]: the characters that start a
  # name, by code point. Any byte past 0x7F was taken as starting and
  # continuing one, so `<a×b/>` read as an element named "a×b", a no-break
  # space after a name became part of it, and `<·a/>` was an element.
  protected def self.name_start?(cp : Int32) : Bool
    return (cp >= 97 && cp <= 122) || (cp >= 65 && cp <= 90) || cp == 95 || cp == 58 if cp < 0xC0
    return cp != 0xD7 && cp != 0xF7 if cp <= 0x2FF
    return cp != 0x37E if cp >= 0x370 && cp <= 0x1FFF
    (cp >= 0x200C && cp <= 0x200D) || (cp >= 0x2070 && cp <= 0x218F) || (cp >= 0x2C00 && cp <= 0x2FEF) ||
      (cp >= 0x3001 && cp <= 0xD7FF) || (cp >= 0xF900 && cp <= 0xFDCF) || (cp >= 0xFDF0 && cp <= 0xFFFD) ||
      (cp >= 0x10000 && cp <= 0xEFFFF)
  end

  # Production [4a]: digits, `-`, `.`, U+00B7, the combining marks
  # U+0300-036F and U+203F-2040 continue a name without starting one.
  protected def self.name_char?(cp : Int32) : Bool
    return true if name_start?(cp)
    (cp >= 48 && cp <= 57) || cp == 45 || cp == 46 || cp == 0xB7 || (cp >= 0x300 && cp <= 0x36F) || cp == 0x203F || cp == 0x2040
  end

  # Whether all of *text* is one name.
  protected def self.name_shaped?(text : String) : Bool
    ptr = text.to_unsafe
    len = text.bytesize
    return false if len == 0
    i = 0
    while i < len
      cp = code_point_at(ptr, len, i)
      return false unless i == 0 ? name_start?(cp) : name_char?(cp)
      i = i + utf8_width(ptr[i])
    end
    true
  end

  # A name, or with *token* a name token (production [7]), which any
  # character that continues a name may start.
  private def parse_name?(token : Bool = false) : String?
    ptr = @input.to_unsafe
    start = @pos
    while @pos < @len
      cp = code_point_at(ptr, @len, @pos)
      break unless @pos == start && !token ? Parser.name_start?(cp) : Parser.name_char?(cp)
      width = utf8_width(ptr[@pos])
      while width > 0 && !failed?
        step
        width = width - 1
      end
    end
    # A byte that is not part of a character ends the name where it stands
    # and is refused there for what it is, as it was when it was read as
    # part of the name.
    if @pos == @bad_at
      step
      return nil
    end
    return nil if failed? || @pos == start
    slice_from(start)
  end
end

# -- the module's functions --------------------------------------------------

pub def parse(xml : String, max_depth : Int32 = 256, max_entity_expansions : Int32 = 1000) : Document
  Parser.new(xml, max_depth: max_depth, max_expansions: max_entity_expansions).parse
end

pub def parse?(xml : String, max_depth : Int32 = 256, max_entity_expansions : Int32 = 1000) : Document?
  Parser.new(xml, max_depth: max_depth, max_expansions: max_entity_expansions).parse?
end

# Whether *cp* is a character XML 1.0 allows in a document (production [2]).
pub def xml_char?(cp : Int32) : Bool
  return true if cp == 9 || cp == 10 || cp == 13
  return true if cp >= 0x20 && cp <= 0xD7FF
  return true if cp >= 0xE000 && cp <= 0xFFFD
  cp >= 0x10000 && cp <= 0x10FFFF
end

# The code point the UTF-8 character at byte *i* of *ptr* (*len* bytes)
# encodes, or -1 where the bytes there are not one; the parser refuses
# those where its cursor reaches them.
def code_point_at(ptr : Pointer(UInt8), len : Int32, i : Int32) : Int32
  b = ptr[i]
  return b.to_i32 if b < 0x80_u8
  n = utf8_width(b)
  return -1 if b < 0xC2_u8 || i + n > len
  cp = (b & (n == 2 ? 0x1F_u8 : (n == 3 ? 0x0F_u8 : 0x07_u8))).to_i32
  k = 1
  while k < n
    c = ptr[i + k]
    return -1 if (c & 0xC0_u8) != 0x80_u8
    cp = (cp << 6) | (c & 0x3F_u8).to_i32
    k = k + 1
  end
  cp
end

# How many bytes the UTF-8 character that starts with *b* takes.
def utf8_width(b : UInt8) : Int32
  b < 0x80_u8 ? 1 : (b >= 0xF0_u8 ? 4 : (b >= 0xE0_u8 ? 3 : 2))
end

# *text* as character data: `&`, `<`, `>` and `\r` become references,
# every other byte is copied as it is. With *ascii*, a character past U+007F
# becomes a decimal reference as well, for a document declared US-ASCII.
pub def escape(text : String, ascii : Bool = false) : String
  escape_bytes(text, false, ascii)
end

# *text* for inside a double-quoted attribute value: `"` and a literal tab
# or newline become references as well, so the value reads back unchanged.
# *ascii* is as for `escape`.
pub def escape_attribute(text : String, ascii : Bool = false) : String
  escape_bytes(text, true, ascii)
end

def escape_bytes(text : String, attribute : Bool, ascii : Bool) : String
  ptr = text.to_unsafe
  len = text.bytesize
  parts = [] of String
  run_start = 0
  i = 0
  while i < len
    b = ptr[i]
    if ascii && b >= 128_u8
      width = b >= 0xF0_u8 ? 4 : (b >= 0xE0_u8 ? 3 : (b >= 0xC0_u8 ? 2 : 1))
      width = len - i if i + width > len
      cp = width == 1 ? b.to_i32 : (b & (width == 2 ? 0x1F_u8 : (width == 3 ? 0x0F_u8 : 0x07_u8))).to_i32
      k = 1
      while k < width
        cp = (cp << 6) | (ptr[i + k] & 0x3F_u8).to_i32
        k = k + 1
      end
      parts << text[run_start, i - run_start] if i > run_start
      parts << "&##{cp};"
      i = i + width
      run_start = i
      next
    end
    replacement = if b == 38_u8
                    "&amp;"
                  elsif b == 60_u8
                    "&lt;"
                  elsif b == 62_u8
                    "&gt;"
                  elsif b == 13_u8
                    "&#13;"
                  elsif attribute && b == 34_u8
                    "&quot;"
                  elsif attribute && b == 9_u8
                    "&#9;"
                  elsif attribute && b == 10_u8
                    "&#10;"
                  else
                    ""
                  end
    if !replacement.empty?
      parts << text[run_start, i - run_start] if i > run_start
      parts << replacement
      run_start = i + 1
    end
    i = i + 1
  end
  return text if run_start == 0
  parts << text[run_start, len - run_start] if len > run_start
  parts.join("")
end

# The five predefined entities and character references decoded, the same
# way and with the same refusals as inside a document; nil where `unescape`
# panics.
pub def unescape?(text : String) : String?
  result = unescape_or_error(text)
  result[1].empty? ? result[0] : nil
end

pub def unescape(text : String) : String
  result = unescape_or_error(text)
  raise result[1] unless result[1].empty?
  result[0]
end

# The decoded text and "", or "" and the sentence it was refused with.
def unescape_or_error(text : String) : Tuple(String, String)
  return {text, ""} unless text.includes?("&")
  ptr = text.to_unsafe
  len = text.bytesize
  parts = [] of String
  run_start = 0
  line = 1
  col = 1
  i = 0
  while i < len
    b = ptr[i]
    if b == 38_u8
      parts << text[run_start, i - run_start]
      semi = i + 1
      while semi < len && ptr[semi] != 59_u8 && !reference_stop?(ptr[semi])
        semi = semi + 1
      end
      if semi >= len || ptr[semi] != 59_u8
        kind = semi > i + 1 && ptr[i + 1] == 35_u8 ? "character" : "entity"
        return {"", "unterminated #{kind} reference #{text[i, semi - i]}: expected ';' at line #{line}, column #{col}"}
      end
      ref = text[i + 1, semi - i - 1]
      if ref.empty?
        return {"", "empty entity reference at line #{line}, column #{col}"}
      elsif ref.starts_with?("#")
        cp = char_ref_value(ref)
        return {"", "invalid character reference '&#{ref};' at line #{line}, column #{col}"} if cp < 0
        return {"", "character reference &#{ref}; is not an XML character at line #{line}, column #{col}"} unless xml_char?(cp)
        parts << cp.unsafe_chr.to_s
      elsif ref == "lt"
        parts << "<"
      elsif ref == "gt"
        parts << ">"
      elsif ref == "amp"
        parts << "&"
      elsif ref == "apos"
        parts << "'"
      elsif ref == "quot"
        parts << "\""
      else
        return {"", "undefined entity reference &#{ref}; at line #{line}, column #{col}"}
      end
      col = col + (semi - i + 1)
      i = semi + 1
      run_start = i
    else
      if b == 10_u8
        line = line + 1
        col = 1
      elsif (b & 192_u8) != 128_u8
        col = col + 1
      end
      i = i + 1
    end
  end
  parts << text[run_start, len - run_start]
  {parts.join(""), ""}
end

# A byte that cannot be part of a reference, so a reference reaching one
# without its `;` is unterminated.
def reference_stop?(b : UInt8) : Bool
  b == 32_u8 || b == 9_u8 || b == 10_u8 || b == 13_u8 || b == 60_u8 || b == 62_u8 || b == 38_u8 || b == 34_u8 || b == 39_u8
end

# The code point a character reference names, given the text between its
# `&` and `;` (`#65`, `#x41`); -1 where that is not digits. Accumulation
# stops past U+10FFFF, so a long reference is merely too large.
def char_ref_value(ref : String) : Int32
  ptr = ref.to_unsafe
  len = ref.bytesize
  i = 1
  hex = i < len && ptr[i] == 120_u8
  i = i + 1 if hex
  return -1 if i >= len
  cp = 0
  while i < len
    d = digit_value(ptr[i], hex)
    return -1 if d < 0
    cp = cp * (hex ? 16 : 10) + d if cp <= 0x10FFFF
    i = i + 1
  end
  cp
end

def digit_value(b : UInt8, hex : Bool) : Int32
  return (b - 48_u8).to_i32 if b >= 48_u8 && b <= 57_u8
  return -1 unless hex
  return (b - 65_u8).to_i32 + 10 if b >= 65_u8 && b <= 70_u8
  return (b - 97_u8).to_i32 + 10 if b >= 97_u8 && b <= 102_u8
  -1
end
