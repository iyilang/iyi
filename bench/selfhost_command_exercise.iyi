# Dumps what the ported command driver decides for a corpus of argument
# vectors: the command it selects, the exit code, and the text it prints.
#
# Compared against the shipped driver in bench/selfhost_command_exercise.sh.

import compiler/command/driver

using compiler/command/driver::{CommandDriver, CommandResult, Exit}

module BenchSelfhostCommandExercise
  def self.corpus : Array(Array(String))
    vectors = [] of Array(String)

    # Help & version vectors
    vectors << [] of String
    vectors << ["--help"]
    vectors << ["-h"]
    vectors << ["help"]
    vectors << ["h"]
    vectors << ["he"]
    vectors << ["hel"]
    vectors << ["--version"]
    vectors << ["-v"]
    vectors << ["version"]
    vectors << ["v"]
    vectors << ["ve"]
    vectors << ["ver"]

    # Init subcommand
    vectors << ["init", "--help"]

    # Build prefix, usage and option parsing
    vectors << ["b"]
    vectors << ["bu"]
    vectors << ["bui"]
    vectors << ["buil"]
    vectors << ["build"]
    vectors << ["build", "--help"]
    vectors << ["build", "-h"]
    vectors << ["build", "--release"]
    vectors << ["build", "--invalid-option"]
    vectors << ["build", "-O", "invalid"]
    vectors << ["build", "--threads", "not_a_num"]
    vectors << ["build", "--frame-pointers", "invalid"]
    vectors << ["build", "--x86-asm-syntax", "invalid"]
    vectors << ["build", "--emit", "invalid"]
    vectors << ["build", "--mcmodel", "invalid"]
    vectors << ["build", "--warnings", "invalid"]
    vectors << ["build", "-f", "invalid"]

    # Deps
    vectors << ["deps"]
    vectors << ["d"]
    vectors << ["de"]
    vectors << ["dep"]

    # Env
    vectors << ["env", "--help"]

    # Eval
    vectors << ["eval", "--help"]

    # Run
    vectors << ["run"]
    vectors << ["run", "--help"]

    # Spec
    vectors << ["spec", "--help"]

    # Doc
    vectors << ["doc"]
    vectors << ["doc", "--help"]
    vectors << ["doc", "-h"]
    vectors << ["doc", "nonexistent.iyi"]
    vectors << ["doc", "nonexistent.iyimod"]

    # Test
    vectors << ["test", "--help"]
    vectors << ["test", "-h"]
    vectors << ["test", "--timeout", "not_a_num"]
    vectors << ["test", "--timeout"]
    vectors << ["test", "--affected"]

    # Vet
    vectors << ["vet", "--help"]
    vectors << ["vet", "-h"]

    # Check
    vectors << ["check", "--help"]
    vectors << ["check", "-h"]

    # Fix
    vectors << ["fix"]
    vectors << ["fix", "--help"]
    vectors << ["fix", "-h"]

    # Bind
    vectors << ["bind", "--help"]
    vectors << ["bind", "--mods"]
    vectors << ["bind", "--lib"]

    # Migrate
    vectors << ["migrate"]
    vectors << ["migrate", "--help"]
    vectors << ["migrate", "--out"]

    # LSP / MCP
    vectors << ["lsp", "--help"]
    vectors << ["mcp", "--help"]

    # Tool
    vectors << ["t"]
    vectors << ["to"]
    vectors << ["too"]
    vectors << ["tool"]
    vectors << ["tool", "--help"]
    vectors << ["tool", "-h"]
    vectors << ["tool", "c"]
    vectors << ["tool", "context", "--help"]
    vectors << ["tool", "format", "--help"]
    vectors << ["tool", "e"]
    vectors << ["tool", "expand", "--help"]
    vectors << ["tool", "bind", "--help"]
    vectors << ["tool", "h"]
    vectors << ["tool", "hierarchy", "--help"]
    vectors << ["tool", "d"]
    vectors << ["tool", "dependencies", "--help"]
    vectors << ["tool", "i"]
    vectors << ["tool", "implementations", "--help"]
    vectors << ["tool", "t"]
    vectors << ["tool", "types", "--help"]
    vectors << ["tool", "u"]
    vectors << ["tool", "unreachable", "--help"]
    vectors << ["tool", "m"]
    vectors << ["tool", "macro_code_coverage", "--help"]
    vectors << ["tool", "unknown_tool"]

    # Clear cache
    vectors << ["clear_cache", "--help"]

    # Daemon
    vectors << ["daemon", "--help"]
    vectors << ["daemon", "unknown_sub"]

    # Mod
    vectors << ["m"]
    vectors << ["mo"]
    vectors << ["mod"]
    vectors << ["mod", "--help"]
    vectors << ["mod", "-h"]
    vectors << ["mod", "dump", "--help"]
    vectors << ["mod", "diff", "--help"]
    vectors << ["mod", "context", "--help"]
    vectors << ["mod", "unknown_sub"]

    # Unknown commands & missing file
    vectors << ["te"]
    vectors << ["bi"]
    vectors << ["da"]
    vectors << ["mi"]
    vectors << ["unknown_command"]
    vectors << ["missing.cr"]

    # Options the parser must refuse. Nothing above reached the abort that
    # names an invalid flag, so the exit code it chooses was unobserved and a
    # mutation flipping it to success changed nothing anyone could see.
    vectors << ["build", "--bogus-flag", "main.iyi"]
    vectors << ["build", "-Z"]
    vectors << ["run", "--not-an-option", "main.iyi"]
    vectors << ["check", "--nope"]
    # `init` has its own option parser, and it is the first one in the file:
    # a proof that patches one occurrence patches this one, so something has
    # to reach it or that proof is about code nothing runs.
    #
    # Only forms that stop at the decision belong here. `init app NAME DIR`
    # scaffolds a real directory, so running it under this gate would have the
    # oracle write files into the checkout.
    vectors << ["init", "--bogus-flag"]
    # `clear_cache` owns the first of the six identical invalid-option aborts,
    # so a proof patching one occurrence patches that one and needs a vector
    # that reaches it.
    vectors << ["clear_cache", "--bogus-flag"]
    vectors << ["env", "--bogus-flag"]

    vectors
  end

  def self.run
    CommandDriver.program_name = "crystal"
    CommandDriver.version_description = "Crystal 1.22.0-dev\n\nThe compiler was not built in release mode.\n\nLLVM: 22.1.8\nDefault target: aarch64-apple-darwin25.5.0\n"

    corpus.each_with_index do |argv, idx|
      driver = CommandDriver.new(argv)
      driver.run
      puts "=== VECTOR #{idx}: #{argv.inspect} ==="
      print driver.format_result
    end
  end
end

BenchSelfhostCommandExercise.run
