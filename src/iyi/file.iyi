# Files: `read`/`write` whole, `open` as an `IyiIO`. Paths get the NUL
# the kernel wants; errors panic with the path.

class File
  def self.open(path : String, mode : String = "r", buffer_size : Int32 = 4096) : IyiIO
    fd = if mode == "r"
           __iyi_open_read(c_path(path))
         elsif mode == "w"
           __iyi_open_write(c_path(path))
         else
           raise "unsupported mode: #{mode}"
         end
    raise "cannot open #{path}" if fd < 0_i64
    IyiIO.new(fd, buffer_size, false)
  end

  def self.open(path : String, mode : String = "r", buffer_size : Int32 = 4096, & : IyiIO -> Nil) : Nil
    io = open(path, mode, buffer_size)
    defer io.close
    yield io
  end

  def self.read(path : String) : String
    fd = __iyi_open_read(c_path(path))
    raise "cannot read #{path}" if fd < 0_i64
    io = IyiIO.new(fd, 4096, false)
    defer io.close
    text = io.read_all
    raise "cannot read #{path}: it is a directory, or the read failed" if io.read_failed?
    text
  end

  def self.write(path : String, contents : String) : Nil
    fd = __iyi_open_write(c_path(path))
    raise "cannot write #{path}" if fd < 0_i64
    io = IyiIO.new(fd, 4096, false)
    defer io.close
    io.write(contents)
    io.flush
  end

  def self.exists?(path : String) : Bool
    {% if flag?(:wasm32) %}
      raise "File.exists? is not available on wasm32-wasi: path_open needs a preopened directory fd"
    {% else %}
      fd = __iyi_open_read(c_path(path))
      return false if fd < 0
      __iyi_close(fd)
      true
    {% end %}
  end

  def self.delete(path : String) : Nil
    raise "cannot delete #{path}" if __iyi_unlink(c_path(path)) < 0
  end

  private def self.c_path(path : String) : UInt8*
    n = path.bytesize
    buffer = Pointer(UInt8).malloc((n + 1).to_u64)
    buffer.copy_from(path.to_unsafe, n)
    buffer[n] = 0_u8
    buffer
  end
end
