; iyi-ir 1
source_filename = "escape_pointer_compare"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i1 @pointer_compare() {
entry:
  %0 = alloca [8 x i8], align 16
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 8, i1 false)
  %test = icmp eq ptr %0, null
  ret i1 %test
}
