# The set algebra the prelude's `Set(T)` does not have.
#
# The prelude's `Set(T)` (src/iyi/set.iyi) answers "have I seen this":
# `add`, `includes?`, `delete`, `each`, `to_a`, `-`, `size`, `empty?`.
# This module reopens that one type rather than defining a second one, so
# `[1, 2].to_set | other` works on the set the prelude hands out, and a
# program has one `Set`. It adds:
#
#   * union `|` (and `+`, the same thing), intersection `&`, symmetric
#     difference `^`; `-` is the prelude's;
#   * the relations `subset_of?`, `proper_subset_of?`, `superset_of?`,
#     `proper_superset_of?`, `disjoint?`, `intersects?`;
#   * `==` by membership (the prelude's `Object#==` is identity), and a
#     `hash` that agrees with it, so a set can be a hash key;
#   * `<<`, `concat`, `dup`.
#
# Every operator answers a new set, in this set's order first; nothing
# here moves the receiver except `<<` and `concat`, which say so.
#
# `impl Enumerable for Set(T)` lives in std/enumerable beside `Array`'s —
# the module that owns the trait is the one R-3 lets say it — so with
# `import std/enumerable` a set also has `map`, `select`, `sum`, `min`,
# `max`, `to_a` and the rest. This module imports it, so a caller of
# std/set gets both.

module std/set

import std/enumerable
using std/enumerable::{Enumerable}

class ::Set(T)
  # Adds value and answers the set, for chaining: `set << 1 << 2`.
  def <<(value : T) : Set(T)
    add(value)
    self
  end

  # Adds every element of other; answers the set.
  def concat(other : Set(T)) : Set(T)
    other.each { |v| add(v) }
    self
  end

  # A copy with the same elements in the same order.
  def dup : Set(T)
    copy = Set(T).new
    each { |v| copy.add(v) }
    copy
  end

  # Union: everything in either, this set's elements first.
  def |(other : Set(T)) : Set(T)
    result = dup
    other.each { |v| result.add(v) }
    result
  end

  # `+` is union: two sets added are one set.
  def +(other : Set(T)) : Set(T)
    self | other
  end

  # Intersection: what is in both, in this set's order.
  def &(other : Set(T)) : Set(T)
    result = Set(T).new
    each { |v| result.add(v) if other.includes?(v) }
    result
  end

  # Symmetric difference: what is in exactly one of the two.
  def ^(other : Set(T)) : Set(T)
    result = Set(T).new
    each { |v| result.add(v) unless other.includes?(v) }
    other.each { |v| result.add(v) unless includes?(v) }
    result
  end

  # Every element of this set is in other. The empty set is a subset of
  # every set, itself included.
  def subset_of?(other : Set(T)) : Bool
    return false if size > other.size
    each { |v| return false unless other.includes?(v) }
    true
  end

  # A subset that is not the same set.
  def proper_subset_of?(other : Set(T)) : Bool
    size < other.size && subset_of?(other)
  end

  def superset_of?(other : Set(T)) : Bool
    other.subset_of?(self)
  end

  def proper_superset_of?(other : Set(T)) : Bool
    other.proper_subset_of?(self)
  end

  # No element in common; two empty sets are disjoint.
  def disjoint?(other : Set(T)) : Bool
    each { |v| return false if other.includes?(v) }
    true
  end

  # At least one element in common.
  def intersects?(other : Set(T)) : Bool
    !disjoint?(other)
  end

  # The same members, in any order.
  def ==(other : Set(T)) : Bool
    size == other.size && subset_of?(other)
  end

  # Equal sets hash alike: the members' hashes are combined with a
  # wrapping sum, which does not care about order the way the sets do
  # not. A hash is a number modulo the word, so the arithmetic wraps.
  def hash : Int32
    h = 0
    each { |v| h = h &+ v.hash }
    h
  end
end
