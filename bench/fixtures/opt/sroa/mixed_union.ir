; iyi-ir 1
source_filename = "mixed_union"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @mixed_union(i32 %tag, ptr %p) {
entry:
  %slot = alloca { i32, [1 x i64] }, align 8
  %tag_ptr = getelementptr { i32, [1 x i64] }, ptr %slot, i64 0, i32 0
  %area = getelementptr { i32, [1 x i64] }, ptr %slot, i64 0, i32 1
  store i32 %tag, ptr %tag_ptr, align 4
  store i64 1, ptr %area, align 8
  store ptr %p, ptr %area, align 8
  %read_tag = load i32, ptr %tag_ptr, align 4
  ret i32 %read_tag
}
