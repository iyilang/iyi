; iyi-ir 1
module "narrow_switch"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [7 x i8] c"%d %d\0A\00"
@val = internal global i8 200, align 1

define internal i32 @sparse(i8 %v) {
entry:
  switch i8 %v, label %d [ i8 200, label %hit ]
hit:
  ret i32 1
d:
  ret i32 0
}
define internal i32 @dense(i8 %v) {
entry:
  switch i8 %v, label %d [ i8 198, label %hit, i8 199, label %hit, i8 200, label %hit, i8 201, label %hit, i8 202, label %hit, i8 203, label %hit ]
hit:
  ret i32 1
d:
  ret i32 0
}
define i32 @main() {
entry:
  %v = load i8, ptr @val, align 1
  %a = call i32 (i8) @sparse(i8 %v)
  %b = call i32 (i8) @dense(i8 %v)
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a, i32 %b)
  ret i32 0
}
