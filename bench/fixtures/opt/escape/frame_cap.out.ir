; iyi-ir 1
source_filename = "escape_frame_cap"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal void @frame_cap() {
entry:
  %0 = alloca [512 x i8], align 16
  %1 = alloca [512 x i8], align 16
  %2 = alloca [512 x i8], align 16
  %3 = alloca [512 x i8], align 16
  br label %body
body:
  intrinsic llvm.memset.p0.i64(ptr %0, i8 0, i64 512, i1 false)
  intrinsic llvm.memset.p0.i64(ptr %1, i8 0, i64 512, i1 false)
  intrinsic llvm.memset.p0.i64(ptr %2, i8 0, i64 512, i1 false)
  intrinsic llvm.memset.p0.i64(ptr %3, i8 0, i64 512, i1 false)
  %p4 = call ptr (i64, i64, i64) @__iyi_new(i64 512, i64 1, i64 2) ["iyi-escape"="frame-cap"]
  ret void
}
