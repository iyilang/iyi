    0x3c8a64a931d185ee_u64, 0x3fefd0765b6e4540_u64, 0xbc8e37bae43be3ed_u64, 0x3fefdbfdad9cbe14_u64,
    0x3c77893b4d91cd9d_u64, 0x3fefe7c1819e90d8_u64, 0x3c5305c14160cc89_u64, 0x3feff3c22b8f71f1_u64,
  ] of UInt64

  def self.exp(value : Float64) : Float64
    bits = IyiFloatText.bits_of(value)
    abstop = (bits.unsafe_shr(52_u64) & 0x7ff_u64).to_i64
    # Outside 2^-54 <= |x| < 512: tiny, the ends of the range, or large.
    if abstop < 0x3c9_i64 || abstop >= 0x408_i64
      return 1.0 + value if abstop < 0x3c9_i64
      if abstop >= 0x409_i64
        return 0.0 if bits == 0xfff0000000000000_u64
        return 1.0 + value if abstop >= 0x7ff_i64
        return bits.unsafe_shr(63_u64) != 0_u64 ? 0.0 : 1.0 / 0.0
      end
      # 512 <= |x| < 1024: the scale may leave the exponent's range.
      abstop = 0_i64
    end
    z = EXP_INVLN2N * value
    kd = z + EXP_SHIFT
    ki = IyiFloatText.bits_of(kd)
    kd = kd - EXP_SHIFT
    r = value + kd * EXP_NEGLN2HI + kd * EXP_NEGLN2LO
    table = EXP_TAB.to_unsafe
    idx = ((ki & 127_u64) &* 2_u64).to_i32
    top = ki.unsafe_shl(45_u64)
    tail = IyiFloatText.from_bits(table[idx])
    sbits = table[idx + 1] &+ top
    r2 = r * r
    tmp = tail + r + r2 * (EXP_C2 + r * EXP_C3) + r2 * r2 * (EXP_C4 + r * EXP_C5)
    return exp_special(tmp, sbits, ki) if abstop == 0_i64
    scale = IyiFloatText.from_bits(sbits)
    scale + scale * tmp
  end

  # The scale for 512 <= |x| < 1024, whose exponent may have overflowed by
  # up to 460: taken back into range, the product made there, and scaled
  # out again - by 2^1009 when k > 0, by 2^-1022 when k < 0, where a result
  # in the subnormals is rounded once to its precision before the scaling
  # rather than twice.
  private def self.exp_special(tmp : Float64, sbits : UInt64, ki : UInt64) : Float64
    if ki & 0x80000000_u64 == 0_u64
      scale = IyiFloatText.from_bits(sbits &- 0x3f10000000000000_u64)
      return 5.486124068793689e+303 * (scale + scale * tmp)
    end
    scale = IyiFloatText.from_bits(sbits &+ 0x3fe0000000000000_u64)
    y = scale + scale * tmp
    if y < 1.0
      lo = scale - y + scale * tmp
      hi = 1.0 + y
      lo = 1.0 - hi + y + lo
      y = (hi + lo) - 1.0
      y = 0.0 if y == 0.0
    end
    2.2250738585072014e-308 * y
  end

  def self.exp(value : Float32) : Float32
    exp(value.to_f64).to_f32
  end

  def self.exp(value : T) : Float64 forall T
    exp(value.to_f64)
  end

  # 2^value: the whole part of `value` is an exact scaling, only the
  # fraction goes through `exp`, so every integer power of two is exact and
  # 2^1024 is the infinity it should be.
  def self.exp2(value : Float64) : Float64
    return 0.0 / 0.0 if value != value
    return 1.0 / 0.0 if value >= 1024.0
    return 0.0 if value < -1075.0
    whole = value.floor
    frac = value - whole
    ldexp(frac == 0.0 ? 1.0 : exp(frac * LOG2), whole.to_i32)
  end

  def self.exp2(value : Float32) : Float32
    exp2(value.to_f64).to_f32
  end

  def self.exp2(value : T) : Float64 forall T
    exp2(value.to_f64)
  end

  # exp(value) - 1 without the cancellation: a series near zero, and for
  # the rest of |value| < 1 Kahan's (u - 1) * value / log(u) with u =
  # exp(value), whose rounding of u cancels between the two factors.
  def self.expm1(value : Float64) : Float64
    return value if value == 0.0 || value != value
    if value.abs < 1.0e-4
      x = value
      return x + x * x * (1.0 / 2.0 + x * (1.0 / 6.0 + x * (1.0 / 24.0 + x * (1.0 / 120.0 + x * (1.0 / 720.0 + x * (1.0 / 5040.0))))))
    end
    return exp(value) - 1.0 if value.abs >= 1.0
    u = exp(value)
    return value if u == 1.0
    (u - 1.0) * value / log(u)
  end

  def self.expm1(value : Float32) : Float32
    expm1(value.to_f64).to_f32
  end

  def self.expm1(value : T) : Float64 forall T
    expm1(value.to_f64)
  end

  private SQRT2_INV = 0.7071067811865475244

  # log of a mantissa in [sqrt(1/2), sqrt(2)), by the series in
  # (m - 1) / (m + 1).
  private def self.log_mantissa(m : Float64) : Float64
    z = (m - 1.0) / (m + 1.0)
    z2 = z * z
    s = 0.0
    j = 9
    while j >= 0
      s = s * z2 + 1.0 / (2 * j + 1).to_f64
      j = j - 1
    end
    2.0 * z * s
  end

  def self.log(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value < 0.0
    return 0.0 - (1.0 / 0.0) if value == 0.0
    return 1.0 / 0.0 if value == 2.0 * value
    return 0.0 if value == 1.0

    m, k = frexp(value)
    if m < SQRT2_INV
      m = m * 2.0
      k = k - 1
    end
    ln_m = log_mantissa(m)
    k_f = k.to_f64
    k_f * LN2_HI + (k_f * LN2_LO + ln_m)
  end

  def self.log(value : Float32) : Float32
    log(value.to_f64).to_f32
  end

  def self.log(value : T) : Float64 forall T
    log(value.to_f64)
  end

  def self.log(value : Float64, base : Float64) : Float64
    log(value) / log(base)
  end

  def self.log(value : T, base : U) : Float64 forall T, U
    log(value.to_f64, base.to_f64)
  end

  # The binary exponent is the answer's whole part outright, so a power of
  # two answers its exponent exactly.
  def self.log2(value : Float64) : Float64
    return log(value) if value != value || value <= 0.0 || value == 2.0 * value
    m, k = frexp(value)
    if m < SQRT2_INV
      m = m * 2.0
      k = k - 1
    end
    k.to_f64 + log_mantissa(m) * INV_LN2
  end

  def self.log2(value : Float32) : Float32
    log2(value.to_f64).to_f32
  end

  def self.log2(value : T) : Float64 forall T
    log2(value.to_f64)
  end

  # log(value) / log(10), and when the answer is within rounding of a whole
  # number n whose 10^n is `value` itself, exactly n: log10(1000.0) is 3.0.
  def self.log10(value : Float64) : Float64
    res = log(value) / LOG10
    return res if res != res || res == 2.0 * res
    n = res.round
    return res if n == res || (res - n).abs > 1.0e-9 || n < -323.0 || n > 308.0
    ten_to(n.to_i32) == value ? n : res
  end

  def self.log10(value : Float32) : Float32
    log10(value.to_f64).to_f32
  end

  def self.log10(value : T) : Float64 forall T
    log10(value.to_f64)
  end

  # log(1 + value) without the cancellation: a series near zero, and past
  # it Kahan's log(u) * value / (u - 1) with u = 1 + value.
  def self.log1p(value : Float64) : Float64
    return value if value == 0.0 || value != value
    return 0.0 / 0.0 if value < -1.0
    return 0.0 - (1.0 / 0.0) if value == -1.0
    if value.abs < 1.0e-4
      x = value
      return x - x * x * (1.0 / 2.0 - x * (1.0 / 3.0 - x * (1.0 / 4.0 - x * (1.0 / 5.0 - x * (1.0 / 6.0 - x * (1.0 / 7.0))))))
    end
    u = 1.0 + value
    return value if u == 1.0
    return log(u) if u == 2.0 * u
    log(u) * value / (u - 1.0)
  end

  def self.log1p(value : Float32) : Float32
    log1p(value.to_f64).to_f32
  end

  def self.log1p(value : T) : Float64 forall T
    log1p(value.to_f64)
  end

  # The product of two double-doubles, rounded to a double-double. Once
  # the high part has overflowed or underflowed it is answered as it is:
  # the low part of an infinity or a zero means nothing.
  private def self.dd_mul(ah : Float64, al : Float64, bh : Float64, bl : Float64) : {Float64, Float64}
    p = ah * bh
    return {p, 0.0} if p == 2.0 * p
    pe = prod_err(ah, bh, p) + (ah * bl + al * bh)
    s = p + pe
    {s, pe - (s - p)}
  end

  private TWO_500     =  3.273390607896142e150
  private TWO_NEG_500 = 3.054936363499605e-151

  # A double-double kept within 2^-500..2^500 in magnitude, the power of
  # two taken out of it added to `scale`: the product of two such never
  # overflows or underflows.
  private def self.rescale(h : Float64, l : Float64, scale : Int32) : {Float64, Float64, Int32}
    a = h.abs
    return {h, l, scale} if a == 0.0 || (a < TWO_500 && a > TWO_NEG_500)
    m, k = frexp(h)
    {m, ldexp(l, 0 - k), scale + k}
  end

  # base^e for e >= 1 by repeated squaring in double-double, answered as
  # hi + lo times 2^scale, so that the answer is the correctly rounded
  # power in all but the rarest ties: 2^1023 and 10^300 come out as the
  # literals do, and 2^-1074 is reached from the same product. Past a
  # scale of 4000 either way the answer is an infinity or a zero, and the
  # remaining bits of e could only take it further.
  private def self.pow_whole(base : Float64, e : Int64) : {Float64, Float64, Int32}
    hi = 1.0
    lo = 0.0
    scale = 0
    bh, bl, bscale = rescale(base, 0.0, 0)
    while true
      if (e & 1_i64) != 0_i64
        hi, lo = dd_mul(hi, lo, bh, bl)
        hi, lo, scale = rescale(hi, lo, scale + bscale)
        return {hi, lo, scale} if scale > 4000 || scale < -4000
      end
      e = e >> 1
      break if e == 0_i64
      bh, bl = dd_mul(bh, bl, bh, bl)
      bh, bl, bscale = rescale(bh, bl, bscale * 2)
      return {hi, lo, scale + bscale} if bscale > 4000 || bscale < -4000
    end
    {hi, lo, scale}
  end

  # 1 / (hi + lo), refined once from the rounded 1 / hi.
  private def self.dd_recip(hi : Float64, lo : Float64) : Float64
    q = 1.0 / hi
    return q if hi == 2.0 * hi || q == 2.0 * q
    qh = q * hi
    q + q * (((1.0 - qh) - prod_err(q, hi, qh)) - q * lo)
  end

  # base^e for a whole e of either sign, from `pow_whole`.
  private def self.pow_signed(base : Float64, e : Int64) : Float64
    hi, lo, scale = pow_whole(base, e < 0_i64 ? 0_i64 - e : e)
    e > 0_i64 ? ldexp(hi, scale) : ldexp(dd_recip(hi, lo), 0 - scale)
  end

  # The double nearest 10^n.
  private def self.ten_to(n : Int32) : Float64
    return 1.0 if n == 0
    pow_signed(10.0, n.to_i64)
  end

  def self.pow(base : Float64, exp : Float64) : Float64
    return 1.0 if exp == 0.0 || base == 1.0
    return 0.0 / 0.0 if base != base || exp != exp

    abs_base = base.abs
    # An infinite exponent, or one so large that no base other than 1 keeps
    # the answer finite and nonzero: past 2^63 the exponent is an even
    # whole number, so the base's sign does not matter either.
    if exp.abs >= 9223372036854775808.0
      return 1.0 if abs_base == 1.0
      grows = (abs_base > 1.0) == (exp > 0.0)
      return grows ? 1.0 / 0.0 : 0.0
    end

    int_exp = exp.to_i64
    is_int = int_exp.to_f64 == exp
    odd = is_int && (int_exp & 1_i64) != 0_i64

    if base == 0.0
      if exp < 0.0
        return odd ? copysign(1.0 / 0.0, base) : 1.0 / 0.0
      end
      return odd ? base : 0.0
    end
    if abs_base == 2.0 * abs_base
      if exp < 0.0
        return odd && base < 0.0 ? copysign(0.0, base) : 0.0
      end
      return odd && base < 0.0 ? base : 1.0 / 0.0
    end
    if base < 0.0
      return 0.0 / 0.0 unless is_int
      pos_res = pow(abs_base, exp)
      return odd ? 0.0 - pos_res : pos_res
    end

    return base if exp == 1.0
    return pow_signed(base, int_exp) if is_int

    # A fractional exponent: the whole part by squaring, the fraction by
    # exp(f * log(base)), where only the small f amplifies the error of the
    # logarithm. A half is a square root.
    frac = exp - int_exp.to_f64
    part = frac.abs == 0.5 ? sqrt(base) : exp(frac.abs * log(base))
    part = 1.0 / part if frac < 0.0
    return part if int_exp == 0_i64
    hi, lo, scale = pow_whole(base, int_exp < 0_i64 ? 0_i64 - int_exp : int_exp)
    ldexp((int_exp > 0_i64 ? hi : dd_recip(hi, lo)) * part, int_exp > 0_i64 ? scale : 0 - scale)
  end

  def self.pow(base : Float32, exp : Float32) : Float32
    pow(base.to_f64, exp.to_f64).to_f32
  end

  def self.pow(base : T, exp : U) : Float64 forall T, U
    pow(base.to_f64, exp.to_f64)
  end

  def self.copysign(mag : Float64, sgn : Float64) : Float64
    LibLLVMMath.copysign_f64(mag, sgn)
  end

  def self.copysign(mag : Float32, sgn : Float32) : Float32
    LibLLVMMath.copysign_f32(mag, sgn)
  end

  # a * b + c with the product taken exactly: its rounding error is
  # recovered by Dekker's split and folded into the sum, so `fma(1e16,
  # 1e16, -1e32)` is the digits a plain `a * b + c` throws away. The last
  # two additions can each round, which a hardware fma would not; that is
  # the width of the difference, and it is rare.
  def self.fma(a : Float64, b : Float64, c : Float64) : Float64
    p = a * b
    return p + c if p != p || p == 2.0 * p || c != c || c == 2.0 * c
    e = prod_err(a, b, p)
    s = p + c
    bb = s - p
    t = (p - (s - bb)) + (c - bb)
    s + (t + e)
  end

  # In double, where the product of two singles is exact.
  def self.fma(a : Float32, b : Float32, c : Float32) : Float32
    (a.to_f64 * b.to_f64 + c.to_f64).to_f32
  end

  # The rounding error of `p = a * b`: the exact product is `p + err`.
  # Veltkamp's split at 2^27 + 1, Dekker's product; a factor past 2^996
  # would overflow the split, so it is brought down by 2^-64 and the
  # error taken back up.
  private def self.prod_err(a : Float64, b : Float64, p : Float64) : Float64
    return 0.0 if p != p || p == 2.0 * p || p == 0.0
    scale = 1.0
    if a.abs > 6.7e299 || b.abs > 6.7e299
      a = a * 5.421010862427522e-20
      b = b * 5.421010862427522e-20
      p = p * 5.421010862427522e-20 * 5.421010862427522e-20
      scale = 1.8446744073709552e19 * 1.8446744073709552e19
    end
    ta = a * 134217729.0
    ah = ta - (ta - a)
    al = a - ah
    tb = b * 134217729.0
    bh = tb - (tb - b)
    bl = b - bh
    (((ah * bh - p) + ah * bl + al * bh) + al * bl) * scale
  end

  # The smaller, with the number when one side is NaN, and -0.0 over 0.0.
  def self.min(a : Float64, b : Float64) : Float64
    return b if a != a
    return a if b != b
    return a if a < b
    return b if b < a
    copysign(1.0, a) < 0.0 ? a : b
  end

  def self.min(a : Float32, b : Float32) : Float32
    return b if a != a
    return a if b != b
    return a if a < b
    return b if b < a
    copysign(1.0_f32, a) < 0.0_f32 ? a : b
  end

  # The larger, with the number when one side is NaN, and 0.0 over -0.0.
  def self.max(a : Float64, b : Float64) : Float64
    return b if a != a
    return a if b != b
    return a if a > b
    return b if b > a
    copysign(1.0, a) < 0.0 ? b : a
  end

  def self.max(a : Float32, b : Float32) : Float32
    return b if a != a
    return a if b != b
    return a if a > b
    return b if b > a
    copysign(1.0_f32, a) < 0.0_f32 ? b : a
  end

  # atan of a value in [0, 1]: the angle is halved until it is small, then
  # a series, then doubled back.
  private def self.atan_unit(val : Float64) : Float64
    reductions = 0
    while val > 0.125
      val = val / (1.0 + sqrt(1.0 + val * val))
      reductions = reductions + 1
    end

    v2 = val * val
    s = 1.0 / 19.0
    s = s * v2 - 1.0 / 17.0
    s = s * v2 + 1.0 / 15.0
    s = s * v2 - 1.0 / 13.0
    s = s * v2 + 1.0 / 11.0
    s = s * v2 - 1.0 / 9.0
    s = s * v2 + 1.0 / 7.0
    s = s * v2 - 1.0 / 5.0
    s = s * v2 + 1.0 / 3.0
    res = val - v2 * val * s

    while reductions > 0
      res = res * 2.0
      reductions = reductions - 1
    end
    res
  end

  def self.atan(value : Float64) : Float64
    return value if value == 0.0 || value != value
    val = value.abs
    res = val > 1.0 ? HALF_PI - atan_unit(1.0 / val) : atan_unit(val)
    value < 0.0 ? 0.0 - res : res
  end

  def self.atan(value : Float32) : Float32
    atan(value.to_f64).to_f32
  end

  def self.atan(value : T) : Float64 forall T
    atan(value.to_f64)
  end

  # The angle of (x, y), with the zeros' and infinities' signs read the
  # way C's atan2 reads them: atan2(0.0, -0.0) is pi, atan2(-0.0, -1.0) is
  # -pi, atan2(inf, inf) is pi/4.
  def self.atan2(y : Float64, x : Float64) : Float64
    return 0.0 / 0.0 if x != x || y != y
    y_neg = copysign(1.0, y) < 0.0
    x_neg = copysign(1.0, x) < 0.0
    if y == 0.0
      return x_neg ? copysign(PI, y) : y
    end
    if x == 0.0
      return copysign(HALF_PI, y)
    end
    if y == 2.0 * y
      if x == 2.0 * x
        return copysign(x_neg ? 3.0 * QUARTER_PI : QUARTER_PI, y)
      end
      return copysign(HALF_PI, y)
    end
    if x == 2.0 * x
      return x_neg ? copysign(PI, y) : copysign(0.0, y)
    end
    return atan(y / x) if x > 0.0
    y_neg ? atan(y / x) - PI : atan(y / x) + PI
  end

  def self.atan2(y : Float32, x : Float32) : Float32
    atan2(y.to_f64, x.to_f64).to_f32
  end

  def self.atan2(y : T, x : U) : Float64 forall T, U
    atan2(y.to_f64, x.to_f64)
  end

  def self.asin(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value.abs > 1.0
    return value if value == 0.0
    return copysign(HALF_PI, value) if value.abs == 1.0
    atan2(value, sqrt((1.0 - value) * (1.0 + value)))
  end

  def self.asin(value : Float32) : Float32
    asin(value.to_f64).to_f32
  end

  def self.asin(value : T) : Float64 forall T
    asin(value.to_f64)
  end

  def self.acos(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value.abs > 1.0
    return 0.0 if value == 1.0
    return PI if value == -1.0
    2.0 * atan(sqrt((1.0 - value) / (1.0 + value)))
  end

  def self.acos(value : Float32) : Float32
    acos(value.to_f64).to_f32
  end

  def self.acos(value : T) : Float64 forall T
    acos(value.to_f64)
  end

  # exp(v) / 2 for v >= 709, where exp itself would overflow but the
  # hyperbolic function has not yet: exp(v - log 2), with the high part of
  # log 2 subtracted exactly (v's last bit is 2^-43, LN2_HI's 2^-33) and
  # the low part applied as the factor exp(-LN2_LO).
  private def self.half_exp(v : Float64) : Float64
    exp(v - LN2_HI) * (1.0 - LN2_LO)
  end

  def self.sinh(value : Float64) : Float64
    return value if value == 0.0 || value != value || value == 2.0 * value
    v = value.abs
    res = 0.0
    if v < 1.0e-4
      v2 = v * v
      res = v + v * v2 * (1.0 / 6.0 + v2 * (1.0 / 120.0 + v2 * (1.0 / 5040.0)))
    elsif v >= 709.0
      res = half_exp(v)
    else
      t = expm1(v)
      res = 0.5 * (t + t / (t + 1.0))
    end
    value < 0.0 ? 0.0 - res : res
  end

  def self.sinh(value : Float32) : Float32
    sinh(value.to_f64).to_f32
  end

  def self.sinh(value : T) : Float64 forall T
    sinh(value.to_f64)
  end

  def self.cosh(value : Float64) : Float64
    return 0.0 / 0.0 if value != value
    v = value.abs
    return half_exp(v) if v >= 709.0
    e = exp(v)
    0.5 * (e + 1.0 / e)
  end

  def self.cosh(value : Float32) : Float32
    cosh(value.to_f64).to_f32
  end

  def self.cosh(value : T) : Float64 forall T
    cosh(value.to_f64)
  end

  def self.tanh(value : Float64) : Float64
    return value if value == 0.0 || value != value
    v = value.abs
    res = 0.0
    if v < 1.0e-4
      v2 = v * v
      res = v - v * v2 * (1.0 / 3.0 - v2 * (2.0 / 15.0 - v2 * (17.0 / 315.0)))
    elsif v >= 22.0
      res = 1.0
    else
      t = expm1(2.0 * v)
      res = t / (t + 2.0)
    end
    value < 0.0 ? 0.0 - res : res
  end

  def self.tanh(value : Float32) : Float32
    tanh(value.to_f64).to_f32
  end

  def self.tanh(value : T) : Float64 forall T
    tanh(value.to_f64)
  end

  def self.asinh(value : Float64) : Float64
    return value if value == 0.0 || value != value || value == 2.0 * value
    v = value.abs
    res = 0.0
    if v < 1.0e-4
      v2 = v * v
      res = v - v * v2 * (1.0 / 6.0 - v2 * (3.0 / 40.0 - v2 * (5.0 / 112.0)))
    elsif v > 1.0e8
      res = log(v) + LOG2
    else
      res = log1p(v + v * v / (1.0 + sqrt(1.0 + v * v)))
    end
    value < 0.0 ? 0.0 - res : res
  end

  def self.asinh(value : Float32) : Float32
    asinh(value.to_f64).to_f32
  end

  def self.asinh(value : T) : Float64 forall T
    asinh(value.to_f64)
  end

  def self.acosh(value : Float64) : Float64
    return 0.0 / 0.0 if value != value || value < 1.0
    return 0.0 if value == 1.0
    return value if value == 2.0 * value
    return log(value) + LOG2 if value > 1.0e8
    t = value - 1.0
    log1p(t + sqrt(t * (t + 2.0)))
  end

  def self.acosh(value : Float32) : Float32
    acosh(value.to_f64).to_f32
  end

  def self.acosh(value : T) : Float64 forall T
    acosh(value.to_f64)
  end

  def self.atanh(value : Float64) : Float64
    return value if value == 0.0 || value != value
    v = value.abs
    return 0.0 / 0.0 if v > 1.0
    res = 0.0
    if v == 1.0
      res = 1.0 / 0.0
    elsif v < 1.0e-4
      v2 = v * v
      res = v + v * v2 * (1.0 / 3.0 + v2 * (1.0 / 5.0 + v2 * (1.0 / 7.0)))
    else
      res = 0.5 * log1p(2.0 * v / (1.0 - v))
    end
    value < 0.0 ? 0.0 - res : res
  end

  def self.atanh(value : Float32) : Float32
    atanh(value.to_f64).to_f32
  end

  def self.atanh(value : T) : Float64 forall T
    atanh(value.to_f64)
  end

  # sqrt(x^2 + y^2) scaled by the larger magnitude, so that neither square
  # overflows or underflows on its own.
  def self.hypot(x : Float64, y : Float64) : Float64
    a = x.abs
    b = y.abs
    return 1.0 / 0.0 if a == 2.0 * a && a > 0.0 || b == 2.0 * b && b > 0.0
    return 0.0 / 0.0 if a != a || b != b
    if b > a
      t = a
      a = b
      b = t
    end
    return a if b == 0.0
    r = b / a
    a * sqrt(1.0 + r * r)
  end

  def self.hypot(x : Float32, y : Float32) : Float32
    hypot(x.to_f64, y.to_f64).to_f32
  end

  def self.hypot(x : T, y : U) : Float64 forall T, U
    hypot(x.to_f64, y.to_f64)
  end

  private EXP_MASK  = 0x7FF0000000000000_u64
  private REST_MASK = 0x800FFFFFFFFFFFFF_u64
  private TWO_54    =    18014398509481984.0

  # value * 2^exponent, with one rounding: the exponent field is rewritten
  # outright, and a result that lands among the subnormals is scaled down
  # from a normal one in a single step.
  def self.ldexp(value : Float64, exponent : Int32) : Float64
    return value if value == 0.0 || exponent == 0 || value != value || value == 2.0 * value
    m, e = frexp(value)
    step = exponent > 2200 ? 2200 : (exponent < -2200 ? -2200 : exponent)
    e = e + step
    return copysign(1.0 / 0.0, value) if e > 1024
    return copysign(0.0, value) if e < -1075
    rest = IyiFloatText.bits_of(m) & REST_MASK
    if e >= -1021
      IyiFloatText.from_bits(rest | (e + 1022).to_i64.to_u64.unsafe_shl(52_u64))
    else
      IyiFloatText.from_bits(rest | (e + 1076).to_i64.to_u64.unsafe_shl(52_u64)) / TWO_54
    end
  end

  # value as m * 2^e with m in [0.5, 1) (or 0, NaN or an infinity as it
  # came, with 0), read from the bits: a subnormal is first scaled up by
  # 2^54 so that it has an exponent field of its own.
  def self.frexp(value : Float64) : {Float64, Int32}
    return {value, 0} if value == 0.0 || value != value || value == 2.0 * value
    bits = IyiFloatText.bits_of(value)
    adjust = 0
    if (bits & EXP_MASK) == 0_u64
      bits = IyiFloatText.bits_of(value * TWO_54)
      adjust = -54
    end
    biased = (bits & EXP_MASK).unsafe_shr(52_u64).to_i64.to_i32
    m = IyiFloatText.from_bits((bits & REST_MASK) | 0x3FE0000000000000_u64)
    {m, biased - 1022 + adjust}
  end

  private TWO_OVER_SQRT_PI = 1.12837916709551257390
  private ONE_OVER_SQRT_PI = 0.56418958354775628695

  # exp(-x^2) with x^2 taken to double precision and a half, so the
  # rounding of the square does not reach the answer for large x.
  private def self.exp_neg_square(x : Float64) : Float64
    x2 = x * x
    x2e = prod_err(x, x, x2)
    exp(0.0 - x2) * (1.0 - x2e)
  end

  # erfc(x) for x >= 1 by its continued fraction (Lentz's evaluation).
  private def self.erfc_fraction(x : Float64) : Float64
    f = x
    c = x
    d = 0.0
    n = 1
    while n <= 1000
      a = n.to_f64 * 0.5
      d = x + a * d
      d = 1.0e-300 if d == 0.0
      c = x + a / c
      c = 1.0e-300 if c == 0.0
      d = 1.0 / d
      delta = c * d
      f = f * delta
      break if (delta - 1.0).abs < 1.0e-16
      n = n + 1
    end
    exp_neg_square(x) * ONE_OVER_SQRT_PI / f
  end

  # The error function: an alternating series below 1, a series of
  # positive terms times exp(-x^2) up to 2.5, and 1 - erfc past it.
  def self.erf(value : Float64) : Float64
    return value if value == 0.0 || value != value
    x = value.abs
    res = 0.0
    if x < 1.0
      x2 = x * x
      term = x
      sum = x
      n = 1
      while true
        term = 0.0 - term * x2 / n.to_f64
        t = term / (2 * n + 1).to_f64
        sum = sum + t
        break if t.abs < 1.0e-17 * sum
        n = n + 1
      end
      res = TWO_OVER_SQRT_PI * sum
    elsif x < 2.5
      x2 = x * x
      term = x
      sum = x
      n = 1
      while true
        term = term * 2.0 * x2 / (2 * n + 1).to_f64
        sum = sum + term
        break if term < 1.0e-17 * sum
        n = n + 1
      end
      res = TWO_OVER_SQRT_PI * exp_neg_square(x) * sum
    elsif x < 6.0
      res = 1.0 - erfc_fraction(x)
    else
      res = 1.0
    end
    value < 0.0 ? 0.0 - res : res
  end

  # 1 - erf(value), kept accurate where erf is close to 1: from 1 up it is
  # the continued fraction, and erfc(10) is 2.09e-45 rather than 0.
  def self.erfc(value : Float64) : Float64
    return 0.0 / 0.0 if value != value
    return 2.0 - erfc(0.0 - value) if value < 0.0
    return 1.0 - erf(value) if value < 1.0
    return 0.0 if value > 27.5
    erfc_fraction(value)
  end

  def self.gamma(value : Float64) : Float64
    tgamma(value)
  end

  private HALF_LOG_TAU = 0.91893853320467274178

  # log|gamma(value)|: Stirling's series from 15 up, the logarithm of
  # gamma below it, and the reflection formula for negative arguments; the
  # poles at the non-positive whole numbers answer +infinity.
  def self.lgamma(value : Float64) : Float64
    return value if value != value
    return 1.0 / 0.0 if value == 2.0 * value
    return 1.0 / 0.0 if value <= 0.0 && value == value.floor
    if value < 0.0
      s = sin(PI * value).abs
      return log(PI / s) - lgamma(1.0 - value)
    end
    return log(tgamma(value).abs) if value < 15.0
    v = value
    iv = 1.0 / v
    iv2 = iv * iv
    series = iv * (1.0 / 12.0 - iv2 * (1.0 / 360.0 - iv2 * (1.0 / 1260.0 - iv2 * (1.0 / 1680.0 - iv2 * (1.0 / 1188.0 - iv2 * (691.0 / 360360.0))))))
    (v - 0.5) * log(v) - v + HALF_LOG_TAU + series
  end

  # gamma: a whole argument up to 171 is its factorial, taken exactly as
  # far as the double allows; the poles answer NaN, past 171.62 the answer
  # is infinite, and the rest is Lanczos's approximation with Godfrey's
  # g = 607/128 and fifteen terms (good to a few 1e-16), reflected for
  # arguments below a half.
  def self.tgamma(value : Float64) : Float64
    return value if value != value
    return value if value == 2.0 * value && value > 0.0
    return 0.0 / 0.0 if value == 2.0 * value
    return 0.0 / 0.0 if value <= 0.0 && value == value.floor
    return 1.0 / 0.0 if value > 171.7
    if value == value.floor
      res = 1.0
      k = 2.0
      while k < value
        res = res * k
        k = k + 1.0
      end
      return res
    end
    if value < 0.5
      PI / (sin(PI * value) * tgamma(1.0 - value))
    else
      v = value
      ser = 0.99999999999999709182
      ser = ser + 57.156235665862923517 / (v + 1.0)
      ser = ser - 59.597960355475491248 / (v + 2.0)
      ser = ser + 14.136097974741747174 / (v + 3.0)
      ser = ser - 0.49191381609762019978 / (v + 4.0)
      ser = ser + 0.33994649984811888699e-4 / (v + 5.0)
      ser = ser + 0.46523628927048575665e-4 / (v + 6.0)
      ser = ser - 0.98374475304879564677e-4 / (v + 7.0)
      ser = ser + 0.15808870322491248884e-3 / (v + 8.0)
      ser = ser - 0.21026444172410488319e-3 / (v + 9.0)
      ser = ser + 0.21743961811521264320e-3 / (v + 10.0)
      ser = ser - 0.16431810653676389022e-3 / (v + 11.0)
      ser = ser + 0.84418223983852743293e-4 / (v + 12.0)
      ser = ser - 0.26190838401581408670e-4 / (v + 13.0)
      ser = ser + 0.36899182659531622704e-5 / (v + 14.0)
      t = v + 5.2421875
      # t^(v + 0.5) alone overflows before gamma does; the halves do not.
      half = pow(t, 0.5 * (v + 0.5)) * exp(-0.5 * t)
      sqrt(TAU) * ser / v * half * half
    end
  end

  def self.besselj0(value : Float64) : Float64
    # Series expansion for small/medium values
    x = value.abs
    if x < 5.0
      term = 1.0
      sum = 1.0
      k = 1
      while k <= 25
        term = term * (0.0 - x * x / (4.0 * k.to_f64 * k.to_f64))
        sum = sum + term
        break if term.abs < 1.0e-15
        k = k + 1
      end
      sum
    else
      # Asymptotic expansion
      sqrt(2.0 / (PI * x)) * cos(x - PI / 4.0)
    end
  end

  def self.besselj1(value : Float64) : Float64
    x = value.abs
    if x < 5.0
      term = x / 2.0
      sum = term
      k = 1
      while k <= 25
        term = term * (0.0 - x * x / (4.0 * k.to_f64 * (k.to_f64 + 1.0)))
        sum = sum + term
        break if term.abs < 1.0e-15
        k = k + 1
      end
      value < 0.0 ? 0.0 - sum : sum
    else
      res = sqrt(2.0 / (PI * x)) * cos(x - 3.0 * PI / 4.0)
      value < 0.0 ? 0.0 - res : res
    end
  end

  # Euclid on the non-positive side, where every magnitude fits, the
  # type's minimum included: gcd(-2147483648, 6) is 2. Only gcd(minimum,
  # 0), whose answer does not fit, overflows.
  def self.gcd(a : ::Int, b : ::Int) : ::Int
    x = a > 0 ? -a : a
    y = b > 0 ? -b : b
    while y != 0
      t = y
      y = x % y
      x = t
    end
    -x
  end

  def self.lcm(a : ::Int, b : ::Int) : ::Int
    return (a - a) if a == 0 || b == 0
    (a.abs // gcd(a, b)) * b.abs
  end
end
