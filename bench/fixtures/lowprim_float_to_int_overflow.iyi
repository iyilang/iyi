lib LibC
  fun exit(status : Int32) : NoReturn
end

fun __crystal_raise_overflow : NoReturn
  LibC.exit(99)
end

struct Float64
  @[Primitive(:convert)]
  def chk_i32 : Int32
  end
end

def quotient(a : Float64, b : Float64) : Float64
  a / b
end

def checked(x : Float64) : Int32
  x.chk_i32
end

LibC.exit(checked(quotient(0.0, 0.0)))
