; iyi-ir 1
source_filename = "keep_atomic"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal void @keep_atomic(ptr %p) {
entry:
  %value = load i64, ptr %p, align 8 atomic acquire
  fence seq_cst
  ret void
}
