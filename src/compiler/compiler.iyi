# The top-level compiler pipeline orchestrator in pure iyi.
#
# Coordinates the full end-to-end compilation chain:
# 1. Resolve: recursive import graph traversal, cycle detection, topological order
# 2. Parse: AST parsing of root and all dependencies (performed during resolve)
# 3. Normalise: AST transformations via Normalizer
# 4. Semantic: declaration extraction, type registration, semantic analysis
# 5. Codegen: LLVM code generation across all modules
# 6. Emit: native object file emission
# 7. Link: platform linker command construction and execution

module compiler/compiler

import compiler/syntax/parser
import compiler/syntax/ast
import compiler/semantic/normalizer
import compiler/semantic/top_level
import compiler/semantic/main_visitor
import compiler/llvm
import compiler/codegen/codegen
import compiler/platform/target
import compiler/platform/linker
import compiler/loader
import compiler/syntax/token
import compiler/macros/interpreter
import compiler/macros/methods

using compiler/syntax/parser::{Parser}
using compiler/syntax/token::{NumberKind}
using compiler/syntax/ast::{ASTNode, Annotation, Nop, Expressions, ClassDef, ModuleDef, FunDef, Def, LibDef, Arg, EnumDef, Assign, Path, NumberLiteral, ImportDecl, Require, Call, VisibilityModifier, MacroIf, MacroFor, MacroExpression, Alias, ImplDef}
using compiler/macros/interpreter::{MacroInterpreter}
using compiler/macros/methods::{MacroMethods}
using compiler/semantic/normalizer::{Normalizer, NormalizerProgram}
using compiler/semantic/top_level::{SemanticProgram, TopLevelVisitor}
using compiler/semantic/main_visitor::{MainVisitor}
using compiler/llvm/context::{Context}
using compiler/llvm/module::{Module}
using compiler/codegen/codegen::{append_entry_point, compile_declarations_to_module, register_primitive_operators}
using compiler/platform/linker::{Linker}
using compiler/loader::{Loader, ModuleInfo, IyiPath}

alias LLVMTarget = ::Compiler::Llvm::Target::Target
alias PlatformTarget = ::Compiler::Platform::Target::Target

lib LibC
  fun system(cmd : UInt8*) : Int32
  fun exit(status : Int32) : NoReturn
end

# Configuration options for the compiler pipeline.
pub struct CompilerConfig
  property output_filename : String
  property emit_obj_only : Bool
  property obj_output_filename : String?
  property verbose : Bool
  property target_triple : String?
  property probe_phase : Bool
  property single_file : Bool

  def initialize(
    @output_filename : String = "a.out",
    @emit_obj_only : Bool = false,
    @obj_output_filename : String? = nil,
    @verbose : Bool = false,
    @target_triple : String? = nil,
    @probe_phase : Bool = false,
    @single_file : Bool = false,
  )
  end
end

# Result metadata returned after a successful compilation.
pub class CompileResult
  property output_filename : String
  property object_filename : String
  property resolved_modules : Array(ModuleInfo)

  def initialize(
    @output_filename : String,
    @object_filename : String,
    @resolved_modules : Array(ModuleInfo),
  )
  end
end

# The compiler pipeline orchestrator.
pub class Compiler
  property config : CompilerConfig
  property loader : Loader

  def initialize(@config : CompilerConfig = CompilerConfig.new, @loader : Loader = Loader.new)
  end

  def compile(root_filename : String) : CompileResult
    # 1. Resolve: discover all dependencies, detect cycles, produce topological order
    resolved_modules = begin
      if @config.single_file
        @loader.resolve_single(root_filename)
      else
        @loader.resolve(root_filename)
      end
    rescue ex
      if @config.probe_phase
        puts "parse: fail: #{ex.to_s}"
        puts "reached: none"
        return CompileResult.new(@config.output_filename, "", [] of ModuleInfo)
      else
        raise ex.to_s
      end
    end
    if @config.probe_phase
      puts "[phase] parse: pass"
      STDOUT.flush
    end

    # 3. Normalise: run normalizer over each resolved module's AST
    norm_prog = NormalizerProgram.new
    normalizer = Normalizer.new(norm_prog)
    resolved_modules.each do |mod_info|
      mod_info.ast = mod_info.ast.transform(normalizer)
    end
    # 4. Semantic: extract declarations in topological order and type-check
    prog = SemanticProgram.new
    register_primitive_operators(prog)

    classes = [] of ClassDef
    funs = [] of FunDef
    defs = Hash(String, Def).new
    libs = [] of LibDef
    top_level = [] of ASTNode

    resolved_modules.each do |mod_info|
      Compiler.extract_declarations(mod_info.ast, classes, funs, defs, libs, top_level)
    end
    if top_level.empty? && funs.none? { |f| f.name == "main" }
      top_level << Nop.new
    end
    append_entry_point(funs, top_level)
    if funs.none? { |f| f.name == "__crystal_raise" }
      Compiler.append_raise_runtime(classes, funs, defs, libs, top_level)
    end

    # Register funs in program
    funs.each do |fd|
      cloned_args = fd.args.map { |a| a.clone.as(Arg) }
      d = Def.new(fd.name, cloned_args, fd.body, nil, nil, fd.return_type)
      prog.add_def(d)
    end

    begin
      tl = TopLevelVisitor.new(prog)
      tl.declare_types(classes)
      classes.each do |cd|
        cd.accept(tl)
      end
      tl.finish

      mv = MainVisitor.new(prog)
      funs.each do |fd|
        ret_type = if rt = fd.return_type
                     prog.lookup_type_node(rt, prog)
                   else
                     prog.int32_type
                   end
        mv.set_type(fd, ret_type)
      end
    rescue ex
      if @config.probe_phase
        puts "semantic: fail: #{ex.to_s}"
        puts "reached: parse"
        return CompileResult.new(@config.output_filename, "", resolved_modules)
      else
        raise ex.to_s
      end
    end

    if @config.probe_phase
      puts "[phase] semantic: pass"
      STDOUT.flush
    end

    # 5. Codegen: create LLVM context, module, target machine, and compile
    ctx = Context.new
    mod_name = Compiler.module_name_from_path(root_filename)
    mod = Module.new(mod_name, ctx)

    LLVMTarget.init_native_target
    LLVMTarget.init_all_targets
    triple = @config.target_triple || LLVMTarget.default_target_triple
    mod.target = triple
    native_target = LLVMTarget.from_triple(triple)
    tm = native_target.create_target_machine(
      triple, "", "",
      LibLLVM::CodeGenOptLevel::Default,
      LibLLVM::RelocMode::PIC,
      LibLLVM::CodeModel::Default
    )
    mod.data_layout = tm.data_layout

    roots = resolved_modules.map { |mi| mi.ast.as(ASTNode) }
    begin
      compile_declarations_to_module(classes, funs, defs, libs, root_filename, ctx, mod, prog, mv, roots)
    rescue ex
      if @config.probe_phase
        puts "codegen: fail: #{ex.to_s}"
        puts "reached: semantic"
        return CompileResult.new(@config.output_filename, "", resolved_modules)
      else
        raise ex.to_s
      end
    end

    if @config.probe_phase
      puts "[phase] codegen: pass"
      STDOUT.flush
    end
    # 6. Emit: write native object file
    File.write("/tmp/whole_prelude.ll", mod.to_s)
    is_valid, verify_err = mod.verify_safely
    if !is_valid
      STDERR.puts "VERIFY FAILED:\n#{verify_err}"
    else
      STDERR.puts "VERIFY PASSED"
    end
    obj_path = @config.obj_output_filename || (@config.output_filename + ".o")
    begin
      tm.emit_obj_to_file(mod.to_unsafe, obj_path)
    rescue ex
      if @config.probe_phase
        puts "object: fail: #{ex.to_s}"
        puts "reached: codegen"
        return CompileResult.new(@config.output_filename, "", resolved_modules)
      else
        raise ex.to_s
      end
    end

    if @config.probe_phase
      puts "[phase] object: pass"
      STDOUT.flush
    end

    if @config.emit_obj_only
      if @config.verbose
        puts "Emitted object file: #{obj_path}"
      end
      if @config.probe_phase
        puts "reached: object"
      end
      return CompileResult.new(@config.output_filename, obj_path, resolved_modules)
    end

    # 7. Link: construct platform linker command and link binary
    plat_target = PlatformTarget.new(triple)
    link_result = Linker.linker_command(plat_target, [obj_path], @config.output_filename)

    cmd_template = link_result.cmd
    quoted_objs = if objs = link_result.objects
                    Linker.quote_posix(objs)
                  else
                    Linker.quote_posix([obj_path])
                  end

    final_cmd = Compiler.substitute_placeholder(cmd_template, "\"${@}\"", quoted_objs)
    status = LibC.system(final_cmd.to_unsafe)
    if @config.probe_phase
      if status == 0
        puts "[phase] link: pass"
        puts "reached: link"
      else
        puts "link: fail: platform linker returned #{status}"
        puts "reached: object"
      end
      if @config.obj_output_filename.nil? && File.exists?(obj_path)
        File.delete(obj_path)
      end
      return CompileResult.new(@config.output_filename, obj_path, resolved_modules)
    end

    unless status == 0
      STDERR.puts "Error: linking failed with exit code #{status}"
      LibC.exit(status)
    end
    # Clean up temporary object file if not explicitly requested
    if @config.obj_output_filename.nil? && File.exists?(obj_path)
      File.delete(obj_path)
    end

    CompileResult.new(@config.output_filename, obj_path, resolved_modules)
  end

  # --- Helper utilities ---

  def self.last_index_of(s : String, char : Char) : Int32?
    i = s.size - 1
    while i >= 0
      return i if s[i] == char
      i = i - 1
    end
    nil
  end

  def self.module_name_from_path(fn : String) : String
    idx = last_index_of(fn, '/')
    base = if i = idx
             fn[i + 1, fn.size - i - 1]
           else
             fn
           end
    if base.ends_with?(".iyi")
      base[0, base.size - 4]
    else
      base
    end
  end

  def self.find_sub(s : String, sub : String) : Int32?
    return nil if sub.size > s.size
    limit = s.size - sub.size
    i = 0
    while i <= limit
      matched = true
      j = 0
      while j < sub.size
        if s.to_unsafe[i + j] != sub.to_unsafe[j]
          matched = false
          break
        end
        j = j + 1
      end
      return i if matched
      i = i + 1
    end
    nil
  end

  def self.substitute_placeholder(cmd : String, placeholder : String, replacement : String) : String
    if idx = find_sub(cmd, placeholder)
      prefix = cmd[0, idx]
      suffix_start = idx + placeholder.size
      suffix = cmd[suffix_start, cmd.size - suffix_start]
      prefix + replacement + suffix
    else
      cmd
    end
  end

  pub def self.extract_declarations(
    node : ASTNode,
    classes : Array(ClassDef),
    funs : Array(FunDef),
    defs : Hash(String, Def),
    libs : Array(LibDef),
    top_level : Array(ASTNode) = [] of ASTNode,
  ) : Nil
    if node.is_a?(Expressions)
      node.as(Expressions).expressions.each do |e|
        extract_declarations(e, classes, funs, defs, libs, top_level)
      end
    elsif node.is_a?(ClassDef)
      classes << node.as(ClassDef)
    elsif node.is_a?(ModuleDef)
      md = node.as(ModuleDef)
      classes << ClassDef.new(md.name, md.body, nil, md.type_vars, false, false)
    elsif node.is_a?(FunDef)
      funs << node.as(FunDef)
    elsif node.is_a?(Def)
      defs[node.as(Def).name] = node.as(Def)
    elsif node.is_a?(LibDef)
      libs << node.as(LibDef)
    elsif node.is_a?(EnumDef)
      ed = node.as(EnumDef)
      enum_name = ed.name.to_s
      cdef = ClassDef.new(Path.new(enum_name), nil, nil, nil, true)
      body_nodes = [] of ASTNode
      val = 0
      ed.members.each do |m|
        if m.is_a?(Assign)
          a = m.as(Assign)
          m_name = a.target.to_s
          if a.value.is_a?(NumberLiteral)
            val = a.value.as(NumberLiteral).value.to_i
          end
          body_nodes << Assign.new(Path.new(m_name), NumberLiteral.new(val.to_s, NumberKind::I32))
          body_nodes << Assign.new(Path.new("#{enum_name}::#{m_name}"), NumberLiteral.new(val.to_s, NumberKind::I32))
        elsif m.is_a?(Path)
          m_name = m.as(Path).to_s
          body_nodes << Assign.new(Path.new(m_name), NumberLiteral.new(val.to_s, NumberKind::I32))
          body_nodes << Assign.new(Path.new("#{enum_name}::#{m_name}"), NumberLiteral.new(val.to_s, NumberKind::I32))
        end
        val = val + 1
      end
      cdef.body = Expressions.new(body_nodes)
      classes << cdef
    elsif node.is_a?(VisibilityModifier)
      extract_declarations(node.as(VisibilityModifier).exp, classes, funs, defs, libs, top_level)
    elsif node.is_a?(MacroIf)
      mif = node.as(MacroIf)
      interp = MacroInterpreter.new
      cond_val = interp.evaluate(mif.cond)
      branch = MacroMethods.truthy?(cond_val) ? mif.then : mif.else
      extract_declarations(branch, classes, funs, defs, libs, top_level)
    elsif node.is_a?(Alias) || node.is_a?(ImplDef) || node.is_a?(MacroFor) || node.is_a?(MacroExpression)
      # Declarations or compile-time constructs, not top-level runtime code
    elsif node.is_a?(ImportDecl) || node.is_a?(Require)
      # Module loader directives
    elsif node.is_a?(Call) && node.as(Call).name == "require"
      # Module loader directives
    elsif !node.is_a?(Annotation) && !node.is_a?(Nop)
      top_level << node
    end
  end

  def self.append_raise_runtime(
    classes : Array(ClassDef),
    funs : Array(FunDef),
    defs : Hash(String, Def),
    libs : Array(LibDef),
    top_level : Array(ASTNode),
  ) : Nil
    rt_source = %(
lib LibC
  fun exit(status : Int32) : NoReturn
  fun malloc(size : UInt64) : Void*
end

lib LibUnwind
  fun raise_exception = _Unwind_RaiseException(ex : Void*) : Int32
  fun get_region_start = _Unwind_GetRegionStart(context : Void*) : UInt64
  fun get_ip = _Unwind_GetIP(context : Void*) : UInt64
  fun get_language_specific_data = _Unwind_GetLanguageSpecificData(context : Void*) : UInt8*
  fun set_gr = _Unwind_SetGR(context : Void*, index : Int32, value : UInt64) : Void
  fun set_ip = _Unwind_SetIP(context : Void*, value : UInt64) : Void
end

fun __crystal_get_exception(ex : Void*) : UInt64
  p64 = ex.as(Pointer(UInt64))
  p64[4]
end

@[Raises]
fun __crystal_raise(ex : Void*) : NoReturn
  buf = LibC.malloc(48_u64)
  p64 = buf.as(Pointer(UInt64))
  p64[0] = 0x4352590000000000_u64
  p64[1] = 0_u64
  p64[2] = 0_u64
  p64[3] = 0_u64
  p64[4] = ex.address

  p32 = buf.as(Pointer(Int32))
  ex_p32 = ex.as(Pointer(Int32))
  tid = ex_p32[0]
  p32[10] = tid

  LibUnwind.raise_exception(buf)
  LibC.exit(1)
end

fun __crystal_personality(version : Int32, actions : Int32, exception_class : UInt64, exception_object : Void*, context : Void*) : Int32
  start = LibUnwind.get_region_start(context)
  ip = LibUnwind.get_ip(context)
  lsd = LibUnwind.get_language_specific_data(context)
  if lsd.address == 0_u64
    return 8
  end

  throw_offset = (ip &- 1_u64) &- start
  p = lsd
  lp_start_encoding = p[0]
  p = p + 1_i64
  if lp_start_encoding != 0xff_u8
    LibC.exit(1)
  end

  ttype_encoding = p[0]
  p = p + 1_i64
  if ttype_encoding != 0xff_u8
    shift = 0
    while true
      b = p[0]
      p = p + 1_i64
      break if (b & 0x80_u8) == 0_u8
      shift = shift &+ 7
    end
  end

  cs_encoding = p[0]
  p = p + 1_i64

  cs_table_length = 0_u64
  shift = 0
  while true
    b = p[0]
    p = p + 1_i64
    cs_table_length = cs_table_length | ((b & 0x7f_u8).to_u64.unsafe_shl(shift))
    break if (b & 0x80_u8) == 0_u8
    shift = shift &+ 7
  end

  cs_table_end = p + cs_table_length.to_i64

  while p.address < cs_table_end.address
    cs_offset = 0_u64
    cs_length = 0_u64
    cs_addr = 0_u64
    action = 0_u64

    if cs_encoding == 3_u8
      p32_cs = p.as(Pointer(UInt32))
      cs_offset = p32_cs[0].to_u64
      cs_length = p32_cs[1].to_u64
      cs_addr = p32_cs[2].to_u64
      p = p + 12_i64
    else
      shift = 0
      while true
        b = p[0]; p = p + 1_i64
        cs_offset = cs_offset | ((b & 0x7f_u8).to_u64.unsafe_shl(shift))
        break if (b & 0x80_u8) == 0_u8; shift = shift &+ 7
      end
      shift = 0
      while true
        b = p[0]; p = p + 1_i64
        cs_length = cs_length | ((b & 0x7f_u8).to_u64.unsafe_shl(shift))
        break if (b & 0x80_u8) == 0_u8; shift = shift &+ 7
      end
      shift = 0
      while true
        b = p[0]; p = p + 1_i64
        cs_addr = cs_addr | ((b & 0x7f_u8).to_u64.unsafe_shl(shift))
        break if (b & 0x80_u8) == 0_u8; shift = shift &+ 7
      end
    end

    shift = 0
    while true
      b = p[0]; p = p + 1_i64
      action = action | ((b & 0x7f_u8).to_u64.unsafe_shl(shift))
      break if (b & 0x80_u8) == 0_u8; shift = shift &+ 7
    end

    if cs_addr != 0_u64 && cs_offset <= throw_offset && throw_offset <= (cs_offset &+ cs_length)
      if (actions & 1) != 0
        return 6
      end
      if (actions & 4) != 0
        unwind_ip = start &+ cs_addr
        obj_p32 = exception_object.as(Pointer(Int32))
        tid = obj_p32[10].to_u64
        LibUnwind.set_gr(context, 0, exception_object.address)
        LibUnwind.set_gr(context, 1, tid)
        LibUnwind.set_ip(context, unwind_ip)
        return 7
      end
    end
  end

  8
end
)
    rt_ast = Parser.new(rt_source, "runtime").parse
    Compiler.extract_declarations(rt_ast, classes, funs, defs, libs, top_level)
  end
end
