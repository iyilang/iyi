lib LibC
  fun putchar(value : Int32) : Int32
  fun exit(status : Int32) : NoReturn
end

def mark(value : Int32) : Int32
  LibC.putchar(value)
  value
end

def combine(a : Int32 = 97, b : Int32 = 98) : Int32
  a &- b
end

v = 0
i = 0
while i < 2
  i = i &+ combine(b: mark(97), a: mark(98))
  v = true
end
LibC.exit(i)
