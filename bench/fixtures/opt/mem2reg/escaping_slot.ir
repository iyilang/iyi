; iyi-ir 1
source_filename = "escaping_slot"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external void @consume(ptr)

define internal void @escaping_slot() {
entry:
  %slot = alloca i64, align 8
  call void (ptr) @consume(ptr %slot)
  ret void
}
