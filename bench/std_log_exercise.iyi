# Exercises `std/log`: MemoryBackend records Log.info.
#
# Run via:
#     ./bin/iyi run bench/std_log_exercise.iyi

module bench/std_log_exercise

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

import std/log::{Log, MemoryBackend, Severity, DefaultFormatter, Entry}

puts "== info"
mem = MemoryBackend.new
Log.setup(Severity::Info, mem)
Log.info "hello"
assert_true mem.entries.size == 1, "one entry"
assert_str "hello", mem.entries[0].message, "message"
puts "  MemoryBackend saw the info line"

puts "\n== child"
child = Log.for("db.pool")
assert_str "db.pool", child.source, "source"
puts "  Log.for keeps the dotted source"

puts "\n== none"
# None silences: a logger set to it wrote an entry logged at None, and a
# logger at any level wrote one. And the root's line keeps its " - ".
quiet = MemoryBackend.new
Log.setup(Severity::None, quiet)
hushed = Log.for("hushed")
hushed.log(Severity::None, "hush")
hushed.fatal "hush"
Log.setup(Severity::Trace, quiet)
hushed.log(Severity::None, "hush")
assert_true quiet.entries.empty?, "nothing is written at None, nor to a logger set to it (#{quiet.entries.size} were)"
root_line = DefaultFormatter.new.format(Entry.new("", Severity::Info, "up"))
assert_true root_line.ends_with?(" INFO - up"), "the root's line: #{root_line}"
puts "  None writes nothing"

puts "\nALL CHECKS PASSED"
