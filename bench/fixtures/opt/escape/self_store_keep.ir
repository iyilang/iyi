; iyi-ir 1
source_filename = "escape_self_store_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Node = type { i64, ptr }
declare external ptr @__iyi_new(i64, i64, i64)
define internal ptr @self_store() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%Node, ptr null, i32 1) to i64), i64 10, i64 0)
  %next = getelementptr %Node, ptr %p, i64 0, i32 1
  store ptr %p, ptr %next, align 8
  %back = load ptr, ptr %next, align 8
  ret ptr %back
}
