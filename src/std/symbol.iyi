module std/symbol

struct ::Symbol
  # Compares symbol with other based on string ordering.
  def <=>(other : Symbol) : Int32
    s1 = to_s
    s2 = other.to_s
    return 0 if s1 == s2
    s1 < s2 ? -1 : 1
  end

  def <(other : Symbol) : ::Bool
    (self <=> other) < 0
  end

  def <=(other : Symbol) : ::Bool
    (self <=> other) <= 0
  end

  def >(other : Symbol) : ::Bool
    (self <=> other) > 0
  end

  def >=(other : Symbol) : ::Bool
    (self <=> other) >= 0
  end

  def inspect : String
    val = to_s
    if Symbol.needs_quotes?(val)
      ":\"" + Symbol.escape_quoted_body(val) + "\""
    else
      ":" + val
    end
  end

  def inspect(io : IyiIO) : ::Nil
    io.print(inspect)
  end

  def to_s(io : IyiIO) : ::Nil
    io.print(to_s)
  end

  def clone : Symbol
    self
  end

  # True when *string* cannot be written as an unquoted symbol literal.
  # Identifiers may end in `?` or `!` (SPEC.md III.1.7 exempts symbol
  # literals from the identifier bang ban). Operators in the list below
  # are also unquoted.
  def self.needs_quotes?(string : String) : ::Bool
    case string
    when "+", "-", "*", "&+", "&-", "&*", "/", "//", "==", "<", "<=", ">", ">=", "!", "!=", "=~", "!~"
      false
    when "&", "|", "^", "~", "**", "&**", ">>", "<<", "%", "[]", "<=>", "===", "[]?", "[]="
      false
    when "_"
      false
    else
      return true if string.empty?

      last = string.bytesize
      last_byte = string.to_unsafe[last - 1]
      # one trailing `!` or `?` is part of the identifier, not a reason to quote
      if last_byte == 33_u8 || last_byte == 63_u8
        last = last - 1
        return true if last == 0
      end

      first_byte = string.to_unsafe[0]
      # letter or '_'
      is_start = (first_byte >= 97_u8 && first_byte <= 122_u8) || (first_byte >= 65_u8 && first_byte <= 90_u8) || first_byte == 95_u8
      return true unless is_start

      index = 1
      while index < last
        byte = string.to_unsafe[index]
        is_alpha = (byte >= 97_u8 && byte <= 122_u8) || (byte >= 65_u8 && byte <= 90_u8) || (byte >= 48_u8 && byte <= 57_u8) || byte == 95_u8
        return true unless is_alpha
        index = index + 1
      end
      false
    end
  end

  def self.needs_quotes_for_named_argument?(string : String) : ::Bool
    return true if string.empty? || string == "_"

    first_byte = string.to_unsafe[0]
    # starts with digit 0..9 (48..57)
    return true if first_byte >= 48_u8 && first_byte <= 57_u8

    index = 0
    while index < string.bytesize
      byte = string.to_unsafe[index]
      # ascii alphanumeric or '_'
      is_alpha = (byte >= 97_u8 && byte <= 122_u8) || (byte >= 65_u8 && byte <= 90_u8) || (byte >= 48_u8 && byte <= 57_u8) || byte == 95_u8
      return true unless is_alpha
      index = index + 1
    end
    false
  end

  def self.quote_for_named_argument(string : String) : String
    if needs_quotes_for_named_argument?(string)
      "\"" + escape_quoted_body(string) + "\""
    else
      string
    end
  end

  def self.quote_for_named_argument(io : IyiIO, string : String) : ::Nil
    io << quote_for_named_argument(string)
  end

  # Body of a double-quoted inspect/named-arg form: quotes, backslashes
  # and the ASCII controls that would break the literal are escaped.
  def self.escape_quoted_body(string : String) : String
    out = ""
    start = 0
    index = 0
    while index < string.bytesize
      byte = string.to_unsafe[index]
      repl = ""
      found = false
      if byte == 34_u8
        repl = "\\\""
        found = true
      elsif byte == 92_u8
        repl = "\\\\"
        found = true
      elsif byte == 10_u8
        repl = "\\n"
        found = true
      elsif byte == 13_u8
        repl = "\\r"
        found = true
      elsif byte == 9_u8
        repl = "\\t"
        found = true
      elsif byte == 0_u8
        repl = "\\0"
        found = true
      end
      if found
        if index > start
          out = out + string[start, index - start]
        end
        out = out + repl
        start = index + 1
      end
      index = index + 1
    end
    return string if start == 0
    if start < string.bytesize
      out = out + string[start, string.bytesize - start]
    end
    out
  end
end
