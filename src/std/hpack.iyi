# Standard HPACK: Header Compression for HTTP/2 (RFC 7541)
#
# Implements:
# - RFC 7541 61-entry Static Table (Appendix A)
# - Dynamic Table with FIFO eviction by size (Section 4)
# - N-bit prefix integer encoding and decoding for 1..8 bits (Section 5.1)
# - String literals, both raw and canonical Huffman-coded (Section 5.2)
# - Canonical Huffman table (Appendix B, 257 symbols)
# - Prefix-tree / state-machine Huffman decoder with strict padding validation:
#     * Rejects EOS symbol in stream
#     * Rejects padding longer than 7 bits
#     * Rejects padding containing 0 bits (must be all 1s)
# - Four field representations (Section 6):
#     * Indexed Header Field (6.1)
#     * Literal Header Field with Incremental Indexing (6.2.1)
#     * Literal Header Field without Indexing (6.2.2)
#     * Literal Header Field Never Indexed (6.2.3)
# - Dynamic Table Size Update (Section 6.3)
# - Security defenses:
#     * Decompression bomb protection: bounds decoded uncompressed header size & count
#     * Respects peer SETTINGS_HEADER_TABLE_SIZE limit
#     * Invalid index detection (index 0 or index > static + dynamic length)
#     * Never-indexed representation honoured on re-encode

module std/hpack

import std/traits
import std/slice
import std/text

using std/slice::{Slice, Bytes}

pub alias Bytes = Std::Slice::Bytes

# ---------------------------------------------------------------------------
# HeaderField: Ordered representation of a single header name-value pair
# ---------------------------------------------------------------------------

pub struct IndexingMode
  getter value : Int32

  def initialize(@value : Int32)
  end

  def ==(other : IndexingMode) : Bool
    @value == other.value
  end

  Incremental     = IndexingMode.new(0)
  WithoutIndexing = IndexingMode.new(1)
  NeverIndexed    = IndexingMode.new(2)
end

pub struct HeaderField
  getter name : String
  getter value : String
  getter indexing : IndexingMode

  def initialize(@name : String, @value : String, @indexing : IndexingMode = IndexingMode::Incremental)
  end

  def initialize(@name : String, @value : String, never_indexed : Bool)
    @indexing = never_indexed ? IndexingMode::NeverIndexed : IndexingMode::Incremental
  end

  def never_indexed : Bool
    @indexing == IndexingMode::NeverIndexed
  end

  def size : Int32
    # RFC 7541 Section 4.1: size = name.bytesize + value.bytesize + 32
    @name.bytesize + @value.bytesize + 32
  end

  def to_s : String
    "#{@name}: #{@value}"
  end

  def ==(other : HeaderField) : Bool
    @name == other.name && @value == other.value && @indexing == other.indexing
  end
end

# ---------------------------------------------------------------------------
# HpackError: Error type for HPACK decoding and encoding failures
# ---------------------------------------------------------------------------

pub struct HpackError
  getter message : String

  def initialize(@message : String)
  end

  def to_s : String
    @message
  end
end

impl Error for HpackError
  def message : String
    @message
  end
end

# ---------------------------------------------------------------------------
# StaticTable: RFC 7541 Appendix A 61 predefined header entries
# ---------------------------------------------------------------------------

pub class StaticTable
  ENTRIES = [
    HeaderField.new("", ""), # Index 0 is unused in HPACK
    HeaderField.new(":authority", ""),
    HeaderField.new(":method", "GET"),
    HeaderField.new(":method", "POST"),
    HeaderField.new(":path", "/"),
    HeaderField.new(":path", "/index.html"),
    HeaderField.new(":scheme", "http"),
    HeaderField.new(":scheme", "https"),
    HeaderField.new(":status", "200"),
    HeaderField.new(":status", "204"),
    HeaderField.new(":status", "206"),
    HeaderField.new(":status", "304"),
    HeaderField.new(":status", "400"),
    HeaderField.new(":status", "404"),
    HeaderField.new(":status", "500"),
    HeaderField.new("accept-charset", ""),
    HeaderField.new("accept-encoding", "gzip, deflate"),
    HeaderField.new("accept-language", ""),
    HeaderField.new("accept-ranges", ""),
    HeaderField.new("accept", ""),
    HeaderField.new("access-control-allow-origin", ""),
    HeaderField.new("age", ""),
    HeaderField.new("allow", ""),
    HeaderField.new("authorization", ""),
    HeaderField.new("cache-control", ""),
    HeaderField.new("content-disposition", ""),
    HeaderField.new("content-encoding", ""),
    HeaderField.new("content-language", ""),
    HeaderField.new("content-length", ""),
    HeaderField.new("content-location", ""),
    HeaderField.new("content-range", ""),
    HeaderField.new("content-type", ""),
    HeaderField.new("cookie", ""),
    HeaderField.new("date", ""),
    HeaderField.new("etag", ""),
    HeaderField.new("expect", ""),
    HeaderField.new("expires", ""),
    HeaderField.new("from", ""),
    HeaderField.new("host", ""),
    HeaderField.new("if-match", ""),
    HeaderField.new("if-modified-since", ""),
    HeaderField.new("if-none-match", ""),
    HeaderField.new("if-range", ""),
    HeaderField.new("if-unmodified-since", ""),
    HeaderField.new("last-modified", ""),
    HeaderField.new("link", ""),
    HeaderField.new("location", ""),
    HeaderField.new("max-forwards", ""),
    HeaderField.new("proxy-authenticate", ""),
    HeaderField.new("proxy-authorization", ""),
    HeaderField.new("range", ""),
    HeaderField.new("referer", ""),
    HeaderField.new("refresh", ""),
    HeaderField.new("retry-after", ""),
    HeaderField.new("server", ""),
    HeaderField.new("set-cookie", ""),
    HeaderField.new("strict-transport-security", ""),
    HeaderField.new("transfer-encoding", ""),
    HeaderField.new("user-agent", ""),
    HeaderField.new("vary", ""),
    HeaderField.new("via", ""),
    HeaderField.new("www-authenticate", ""),
  ]

  def self.size : Int32
    61
  end

  def self.get(index : Int32) : HeaderField?
    if index >= 1 && index <= 61
      ENTRIES[index]
    else
      nil
    end
  end

  def self.find(name : String, value : String) : Tuple(Int32, Bool)
    name_idx = 0
    i = 1
    while i <= 61
      entry = ENTRIES[i]
      if entry.name == name
        if entry.value == value
          return {i, true}
        elsif name_idx == 0
          name_idx = i
        end
      end
      i = i + 1
    end
    {name_idx, false}
  end

  def self.find_name(name : String) : Int32
    i = 1
    while i <= 61
      if ENTRIES[i].name == name
        return i
      end
      i = i + 1
    end
    0
  end
end

# ---------------------------------------------------------------------------
# DynamicTable: FIFO eviction header table bounded by octet capacity
# ---------------------------------------------------------------------------

pub class DynamicTable
  getter max_size : Int32
  getter settings_max_size : Int32
  getter size : Int32
  getter entries : Array(HeaderField)

  def initialize(@max_size : Int32 = 4096, @settings_max_size : Int32 = 4096)
    @size = 0
    @entries = [] of HeaderField
  end

  def length : Int32
    @entries.size
  end

  def empty? : Bool
    @entries.empty?
  end

  def set_max_size(new_max : Int32) : Nil | HpackError
    if new_max < 0
      return HpackError.new("Negative dynamic table size: #{new_max}")
    end
    if new_max > @settings_max_size
      return HpackError.new("Dynamic table size #{new_max} exceeds protocol limit #{@settings_max_size}")
    end
    @max_size = new_max
    evict_to_fit
    nil
  end

  def add(name : String, value : String, never_indexed : Bool = false) : Nil
    field = HeaderField.new(name, value, never_indexed)
    entry_size = field.size
    if entry_size > @max_size
      @entries = [] of HeaderField
      @size = 0
      return
    end
    while @size + entry_size > @max_size && !@entries.empty?
      removed = @entries.pop
      @size = @size - removed.size
    end
    new_entries = [field]
    i = 0
    while i < @entries.size
      new_entries << @entries[i]
      i = i + 1
    end
    @entries = new_entries
    @size = @size + entry_size
  end

  def add(field : HeaderField) : Nil
    add(field.name, field.value, field.never_indexed)
  end

  private def evict_to_fit : Nil
    while @size > @max_size && !@entries.empty?
      removed = @entries.pop
      @size = @size - removed.size
    end
  end

  def get(relative_index : Int32) : HeaderField?
    if relative_index >= 1 && relative_index <= @entries.size
      @entries[relative_index - 1]
    else
      nil
    end
  end

  def find(name : String, value : String) : Tuple(Int32, Bool)
    name_idx = 0
    i = 0
    while i < @entries.size
      entry = @entries[i]
      if entry.name == name
        if entry.value == value
          return {i + 1, true}
        elsif name_idx == 0
          name_idx = i + 1
        end
      end
      i = i + 1
    end
    {name_idx, false}
  end

  def find_name(name : String) : Int32
    i = 0
    while i < @entries.size
      if @entries[i].name == name
        return i + 1
      end
      i = i + 1
    end
    0
  end
end

# ---------------------------------------------------------------------------
# Table: Combined Static and Dynamic table indexing
# ---------------------------------------------------------------------------

pub class Table
  def self.get(dynamic_table : DynamicTable, global_index : Int32) : HeaderField?
    if global_index >= 1 && global_index <= 61
      StaticTable.get(global_index)
    elsif global_index > 61 && global_index <= 61 + dynamic_table.length
      dynamic_table.get(global_index - 61)
    else
      nil
    end
  end

  def self.find(dynamic_table : DynamicTable, name : String, value : String) : Tuple(Int32, Bool)
    s_idx, s_exact = StaticTable.find(name, value)
    return {s_idx, true} if s_exact

    d_idx, d_exact = dynamic_table.find(name, value)
    if d_exact
      return {61 + d_idx, true}
    end

    if s_idx > 0
      {s_idx, false}
    elsif d_idx > 0
      {61 + d_idx, false}
    else
      {0, false}
    end
  end

  def self.find_name(dynamic_table : DynamicTable, name : String) : Int32
    s_idx = StaticTable.find_name(name)
    return s_idx if s_idx > 0
    d_idx = dynamic_table.find_name(name)
    return 61 + d_idx if d_idx > 0
    0
  end
end

# ---------------------------------------------------------------------------
# Integer: Variable-length N-bit prefix integer codec (RFC 7541 Section 5.1)
# ---------------------------------------------------------------------------

pub class Integer
  def self.encode(val : UInt64, prefix_bits : Int32, prefix_byte : UInt8, buffer : Array(UInt8)) : Nil
    raise "prefix_bits must be between 1 and 8" if prefix_bits < 1 || prefix_bits > 8
    prefix_max = (1_u64.unsafe_shl(prefix_bits)) - 1_u64
    if val < prefix_max
      buffer << (prefix_byte | val.to_u8)
    else
      buffer << (prefix_byte | prefix_max.to_u8)
      rem = val - prefix_max
      while rem >= 128_u64
        chunk = (rem & 127_u64) | 128_u64
        buffer << chunk.to_u8
        rem = rem.unsafe_shr(7)
      end
      buffer << rem.to_u8
    end
  end

  def self.encode(val : UInt64, prefix_bits : Int32, prefix_byte : UInt8 = 0_u8) : Bytes
    buf = [] of UInt8
    encode(val, prefix_bits, prefix_byte, buf)
    Bytes.new(buf.size) { |i| buf[i] }
  end

  def self.decode(bytes : Bytes, offset : Int32, prefix_bits : Int32) : Tuple(UInt64, Int32) | HpackError
    if prefix_bits < 1 || prefix_bits > 8
      return HpackError.new("Invalid prefix_bits: #{prefix_bits}")
    end
    if offset >= bytes.size
      return HpackError.new("Unexpected EOF decoding integer")
    end
    prefix_max = (1_u64.unsafe_shl(prefix_bits)) - 1_u64
    first_byte = bytes[offset]
    val = (first_byte.to_u64) & prefix_max
    cur_offset = offset + 1
    if val < prefix_max
      return {val, cur_offset}
    end

    m = 0_i32
    loop do
      if cur_offset >= bytes.size
        return HpackError.new("Unexpected EOF decoding integer continuation")
      end
      b = bytes[cur_offset].to_u64
      cur_offset = cur_offset + 1
      if m > 63
        return HpackError.new("Integer overflow decoding HPACK integer")
      end
      val = val + ((b & 127_u64).unsafe_shl(m))
      m = m + 7
      if (b & 128_u64) == 0_u64
        break
      end
    end
    {val, cur_offset}
  end
end

pub alias IntegerCodec = Integer

