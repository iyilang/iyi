# HTTP/1.1 over `IyiSocket`, written in iyi: a client, and a server.
#
# `HTTP.get`, `head`, `post`, `put`, `delete` and the `request` under
# them speak `http://` only, to a numeric IPv4 host, an IPv6 one in
# brackets (`http://[::1]:8080/`) or `localhost` — the same addresses
# `IyiSocket` will open. TLS is not in 0.x. A
# request carries the caller's headers and body; the response's headers
# are read by name without regard to case, a field on several lines is
# one field with its values joined by ", ", interim 1xx answers are read
# past, and a chunked body arrives joined. `format_request` /
# `parse_response` are the text; `request` writes one and reads the
# other. A status line that is not HTTP is refused with the first line,
# a header with a control character in its value is refused either way,
# and one that would break the request's own lines is refused before it
# is written.
#
# `Server.serve(listener) { |request| Response }` is the other side: a
# fiber per connection under a group, each connection kept alive across
# requests until the client says `Connection: close`, closes, or sends
# something that is not HTTP (answered 400 and closed). The block gets a
# `Request` — method, path (an absolute-form target's own), query,
# headers, body, read to the length the client declared or de-chunked —
# and answers a `Response`, which is written with its length; a 1xx, 204
# or 304 is written with neither. A `HEAD` is answered without the body. The
# socket parks under the runtime, so a slow client costs one fiber; the
# listener's `close` ends `serve`. Both halves are the same module so
# what one writes the other reads, and `bench/std_http_exercise.sh`
# runs the client against the server and the server against Python's.

module std/http

import std/socket::{IyiSocket, SocketError}
import std/uri::{URI}

pub struct Response
  getter status : Int32
  getter reason : String
  getter headers : Hash(String, String)
  getter body : String

  def initialize(@status : Int32, @reason : String, @headers : Hash(String, String), @body : String)
  end

  # A response to write: the reason is the status's own, the headers the
  # caller's. `Response.new(200, "hello")` is the common shape.
  def initialize(@status : Int32, @body : String = "", @headers : Hash(String, String) = {} of String => String)
    @reason = HTTP.reason_for(@status)
  end

  # A header by name, as the server spelled it or otherwise: a field
  # name is case-insensitive (RFC 9110 §5.1), and `content-length` is as
  # common on the wire as `Content-Length`.
  def header(name : String) : String?
    @headers.each do |key, value|
      return value if HTTP.same_name?(key, name)
    end
    nil
  end

  def success? : Bool
    @status >= 200 && @status < 300
  end
end

# What a server's block is handed: one request, read whole.
pub struct Request
  getter method : String
  getter path : String
  getter query : String?
  getter headers : Hash(String, String)
  getter body : String

  def initialize(@method : String, @path : String, @query : String?, @headers : Hash(String, String), @body : String)
  end

  def header(name : String) : String?
    @headers.each do |key, value|
      return value if HTTP.same_name?(key, name)
    end
    nil
  end
end

# The pieces of one request as they came off the wire, or why not: a
# request line and headers, the body they promise, and whether the
# client asked for the connection to close after.
struct ParsedRequest
  getter request : Request?
  getter error : String?
  getter close : Bool
  getter consumed : Int32
  # For a request whose head is in and whose body is not: the bytes the
  # whole request takes, when its `Content-Length` says. 0 otherwise.
  getter wanted : Int32
  # And whether that head asked `Expect: 100-continue`: the client waits
  # to be told to send the body.
  getter expects : Bool
  # A chunked request whose head is in and whose body is not: the request
  # with an empty body, `consumed` bytes of head behind it. The server
  # reads the body as it arrives (`HTTP.read_chunked`).
  getter chunked : Request?

  def initialize(@request : Request?, @error : String?, @close : Bool, @consumed : Int32, @wanted : Int32 = 0, @expects : Bool = false, @chunked : Request? = nil)
  end
end

pub struct Server
  # A request too large to be a request: 1 MiB of headers, 64 MiB of body.
  MAX_HEAD =  1048576
  MAX_BODY = 67108864

  # Serve `listener` until it is closed. The block runs on the
  # connection's fiber, once per request; what it answers is written back.
  # The close ends a connection waiting on its client too, for its next
  # request or for the rest of one, and one that is answering ends when its
  # answer is written: a keep-alive client that sat idle kept `serve` from
  # returning for as long as it stayed, and so did one that had sent
  # what has arrived of a request so far - one byte of it was enough.
  def self.serve(listener : IyiSocket, &handler : Request -> Response) : Nil
    idle = {} of UInt64 => IyiSocket
    group do |g|
      pause = 5
      while !listener.closed?
        case client = listener.accept
        in Cancelled
          break
        in SocketError
          # The listener's own trouble - descriptors run out, most often -
          # is waited out rather than spun on: 5 ms doubling to a second,
          # as Go's server does, and the next accept that works resets it.
          sleep(pause)
          pause = pause * 2 if pause < 1000
        in IyiSocket
          pause = 5
          spawn_handler(g, client, handler, listener, idle)
        end
      end
      idle.each { |_, waiting| waiting.close }
      0
    end
  end

  # The connection's task, spawned from a method so its block holds this
  # call's `client`. Spawned from the accept loop, the block held the loop's
  # own variable, which the next accept overwrote before the task first
  # ran: connections that arrived together were served by several tasks at
  # once - "two fibers reading one fd" - and the others by none, and their
  # clients waited forever.
  #
  # The connection runs in a group of its own whose answer is read, so a
  # block that panics ends its own connection - its defers close it, and the
  # panic is printed where it happened - and nothing else, which is what
  # Go's server does. Unread, the panic reached `serve`'s group, which
  # cancelled every other connection and the accept loop and panicked "a
  # task panicked": one request whose block failed took the server down.
  private def self.spawn_handler(g : IyiGroup, client : IyiSocket, handler : Proc(Request, Response), listener : IyiSocket, idle : Hash(UInt64, IyiSocket)) : Nil
    g.spawn do
      group do |own|
        served = own.spawn do
          handle(client, handler, listener, idle)
          0
        end
        served.value
        0
      end
      0
    end
  end

  # One connection: requests until the client is done. A request that is
  # not HTTP is answered 400 and the connection closed, since the bytes
  # after it cannot be trusted to be a request either.
  #
  # Under `serve`, *listener* and *idle*: every read waits with the
  # connection in *idle*, for `serve` to close once the listener is, and
  # none starts once the listener is closed (`wait_read`).
  def self.handle(client : IyiSocket, handler : Proc(Request, Response), listener : IyiSocket? = nil, idle : Hash(UInt64, IyiSocket)? = nil) : Nil
    defer client.close
    buffer = ""
    # Where the next request starts in *buffer*: requests that came in one
    # read are parsed where they lie in what has arrived, and what is left
    # moves to the front once, before the next read. Cut off the front one
    # by one, the rest of the read was copied twice per request: 32,000
    # requests written at once cost the server 0.25 ms each, and the same
    # requests one at a time 0.06 ms.
    start = 0
    continued = false
    while true
      parsed = parse_request(buffer, start)
      if req = parsed.request
        continued = false
        start = parsed.consumed
        return unless answered?(client, handler, req, parsed.close)
        next
      end
      if reason = parsed.error
        client.write(format_response(Response.new(400, reason + "\n"), false, true))
        return
      end
      # A chunked body is decoded as it arrives. It was added to what came
      # before and the whole request parsed again after every read, a copy
      # of the body so far per read: 16 MB took 11.5 s chunked and 0.24 s
      # with a `Content-Length`.
      if head = parsed.chunked
        if !continued && parsed.expects
          return unless client.write("HTTP/1.1 100 Continue\r\n\r\n").is_a?(Int32)
        end
        continued = false
        # From where the head ends in what has arrived, each read waiting
        # where `serve` can close it.
        read = HTTP.read_chunked(buffer, parsed.consumed, MAX_BODY) { wait_read(client, listener, idle) }
        return if read.nil?
        if read.is_a?(String)
          client.write(format_response(Response.new(400, read + "\n"), false, true))
          return
        end
        body, buffer = read
        start = 0
        return unless answered?(client, handler, Request.new(head.method, head.path, head.query, head.headers, body), parsed.close)
        next
      end
      # A client that sent `Expect: 100-continue` holds its body back until
      # it is told to send it, and curl gives up waiting after a second:
      # every upload past a megabyte took a second longer than it needed.
      if parsed.expects && !continued
        continued = true
        return unless client.write("HTTP/1.1 100 Continue\r\n\r\n").is_a?(Int32)
      end
      # Not a whole request yet: read more of it, or stop at the client's
      # close.
      rest = start == 0 ? buffer : buffer[start, buffer.bytesize - start]
      wanted = parsed.wanted - start
      start = 0
      if wanted > 0
        # The head says how long the request is: read until it is all here
        # and parse once. Adding each read to what came before and parsing
        # it all again was a copy of the body so far per read: a 5 MB upload
        # took 1.1 s, 20 MB 3 s, where Go's server takes 10 and 40 ms.
        got = read_body(client, rest, wanted, listener, idle)
        return unless got
        buffer = got
      else
        text, ends = HTTP.read_head(rest, 0, MAX_HEAD) { wait_read(client, listener, idle) }
        return unless ends || text.bytesize > MAX_HEAD
        buffer = text
      end
    end
  end

  # The client's next bytes, nil when none are to come: it closed, the read
  # failed, or under `serve` the listener is closed. The connection waits
  # in *idle*, for `serve` to close when the listener closes. Only one
  # between requests did: one partway through a request - its head, its
  # body, a chunk - was waited for, and a client that had sent part of one
  # held `serve`, with what has arrived of it, until it left.
  private def self.wait_read(client : IyiSocket, listener : IyiSocket?, idle : Hash(UInt64, IyiSocket)?) : String?
    return nil if listener && listener.closed?
    idle[client.object_id] = client if idle
    got = client.read(65536)
    idle.delete(client.object_id) if idle
    return nil unless got.is_a?(String) && got.bytesize > 0
    got
  end

  # A request whose head says it is *wanted* bytes long, *rest* of them
  # here: the reads after it kept as they arrive, and joined once the last
  # is in. Nil when the client goes first. A builder of the whole declared
  # length was made before any of the body had come: a head that declared
  # 64 MB and two bytes after it cost the server 64 MB, and six such
  # connections 450 MB. What is held now is what has arrived.
  private def self.read_body(client : IyiSocket, rest : String, wanted : Int32, listener : IyiSocket?, idle : Hash(UInt64, IyiSocket)?) : String?
    pieces = [rest]
    have = rest.bytesize
    while have < wanted
      more = wait_read(client, listener, idle)
      return nil unless more
      pieces << more
      have = have + more.bytesize
    end
    String.new(have) do |whole|
      at = 0
      pieces.each do |piece|
        (whole + at.to_i64).copy_from(piece.to_unsafe, piece.bytesize)
        at = at + piece.bytesize
      end
      nil
    end
  end

  # The handler's answer to *req*, written: whether the connection goes on.
  # A client that went away before its answer is gone; its connection ends
  # here, and the server goes on.
  private def self.answered?(client : IyiSocket, handler : Proc(Request, Response), req : Request, close : Bool) : Bool
    response = handler.call(req)
    wrote = client.write(format_response(response, HTTP.same_name?(req.method, "HEAD"), close))
    wrote.is_a?(Int32) && !close
  end

  # A request at *from* in `text`, if a whole one is there. No request and
  # no error means "not yet". `consumed` and `wanted` count from the start
  # of `text`: a server parses each request where it lies in
  # what has arrived, and copies none of what follows it.
  def self.parse_request(text : String, from : Int32 = 0) : ParsedRequest
    split_at = HTTP.find_headers_end(text, from)
    unless split_at
      return ParsedRequest.new(nil, "request headers past #{MAX_HEAD} bytes", true, 0) if text.bytesize - from > MAX_HEAD
      return ParsedRequest.new(nil, nil, false, 0)
    end
    lines = HTTP.split_crlf(text[from, split_at - from])
    return ParsedRequest.new(nil, "empty request", true, 0) if lines.size == 0
    first = lines[0]
    sp1 = first.index(' ')
    return ParsedRequest.new(nil, "not a request line: #{first.inspect}", true, 0) unless sp1
    rest = first[sp1 + 1, first.bytesize - sp1 - 1]
    sp2 = rest.index(' ')
    return ParsedRequest.new(nil, "not a request line: #{first.inspect}", true, 0) unless sp2
    method = first[0, sp1]
    target = rest[0, sp2]
    version = rest[sp2 + 1, rest.bytesize - sp2 - 1]
    return ParsedRequest.new(nil, "not a method: #{method.inspect}", true, 0) unless HTTP.token?(method)
    return ParsedRequest.new(nil, "not an HTTP/1 request: #{version.inspect}", true, 0) unless version == "HTTP/1.1" || version == "HTTP/1.0"
    # A control byte in the target - a bare CR, a NUL - is not part of any
    # URI (RFC 9112 §2.2, §3.2); passed on, a query with a line break in it
    # broke the answer of a block that echoed it into a header.
    return ParsedRequest.new(nil, "not a request target: #{target.inspect}", true, 0) if target.bytesize == 0 || HTTP.control?(target)
    headers = case fields = HTTP.parse_fields(lines)
              in String
                return ParsedRequest.new(nil, fields, true, 0)
              in Hash(String, String)
                fields
              end
    # Host (RFC 9112 §3.2): an HTTP/1.1 request names one, no request names
    # two, and what it names is a host; a server answers 400 otherwise. This
    # one served a request with no Host, and handed the block two as one,
    # `Host: a` and `Host: b` read as "a, b".
    hosts = 0
    lines.each do |line|
      hosts = hosts + 1 if line.bytesize > 4 && line.to_unsafe[4] == 58_u8 && HTTP.same_name?(line[0, 4], "Host")
    end
    return ParsedRequest.new(nil, "Host on #{hosts} lines", true, 0) if hosts > 1
    return ParsedRequest.new(nil, "an HTTP/1.1 request without Host", true, 0) if hosts == 0 && version == "HTTP/1.1"
    host_name = "Host"
    headers.each do |name, value|
      next unless HTTP.same_name?(name, "Host")
      return ParsedRequest.new(nil, "not a host: #{value.inspect}", true, 0) unless HTTP.host?(value)
      host_name = name
    end
    # The absolute form (RFC 9112 §3.2.2), which a server must accept,
    # names the path after the authority: `http://h/x?q` is path `/x` and
    # query `q`, as the other library reads it, where the block was handed
    # `http://h/x` as the path.
    origin = target
    if authority = HTTP.absolute_form(target)
      p = target.to_unsafe
      after_authority = authority
      while after_authority < target.bytesize && p[after_authority] != 47_u8 && p[after_authority] != 63_u8
        after_authority = after_authority + 1
      end
      # And its authority is the host, whatever the Host line says: `GET
      # http://b/` under `Host: a` asks b. The block reads it as the Host;
      # it was handed the line's, and had no way to the target's.
      named = target[authority, after_authority - authority]
      return ParsedRequest.new(nil, "not a host: #{named.inspect}", true, 0) unless named.bytesize > 0 && HTTP.host?(named)
      headers[host_name] = named
      origin = target[after_authority, target.bytesize - after_authority]
      origin = "/" + origin if origin.bytesize == 0 || origin.starts_with?("?")
    end
    path = origin
    query = nil.as(String?)
    if q = origin.index('?')
      path = origin[0, q]
      query = origin[q + 1, origin.bytesize - q - 1]
    end
    stub = Request.new(method, path, query, headers, "")
    # `Connection` is a list of options (RFC 9110 §7.6.1), and `close`
    # among them closes (RFC 9112 §9.6): read as one value, `close, TE` and
    # two `Connection: close` lines, joined to `close, close`, kept the
    # connection open and were answered `keep-alive`.
    close = version == "HTTP/1.0"
    if conn = stub.header("Connection")
      close = HTTP.has_token?(conn, "close") || (version == "HTTP/1.0" && !HTTP.has_token?(conn, "keep-alive"))
    end
    body_start = split_at + 4
    # The body is read where it lies in what has arrived: cut off with all
    # that came after it, the rest of the read was copied per request.
    expects = version == "HTTP/1.1" && HTTP.same_name?(HTTP.trim(stub.header("Expect") || ""), "100-continue")
    if te = stub.header("Transfer-Encoding")
      return ParsedRequest.new(nil, "transfer encoding #{te.inspect} is not chunked", true, 0) unless HTTP.same_name?(HTTP.trim(te), "chunked")
      # A length beside the chunks, or chunks in HTTP/1.0, is framing that
      # a reader ahead of this one may have taken otherwise (RFC 9112 §6.1,
      # §6.3): the connection closes after the answer, where what followed
      # was read as the next request.
      close = true if stub.header("Content-Length") || version == "HTTP/1.0"
      # A body that is not chunked is a 400, as any request that is not
      # HTTP: `chunked_end` raised, and the connection's task panicked with
      # no answer, and `serve` with it once the listener closed. Its end is
      # looked for where it lies in what has arrived, too.
      case done = HTTP.chunked_end(text, body_start)
      in Nil
        return ParsedRequest.new(nil, nil, close, body_start, 0, expects, Request.new(method, path, query, headers, ""))
      in String
        return ParsedRequest.new(nil, "chunked body: #{done}", true, 0)
      in Int32
        return ParsedRequest.new(nil, "chunked body past #{MAX_BODY} bytes", true, 0) if done - body_start > MAX_BODY
        body = HTTP.decode_chunked(text[body_start, done - body_start])
        return ParsedRequest.new(Request.new(method, path, query, headers, body), nil, close, done)
      end
    end
    length = 0
    if cl = stub.header("Content-Length")
      n = HTTP.content_length(cl)
      return ParsedRequest.new(nil, "Content-Length is not a number: #{cl.inspect}", true, 0) unless n
      # A length past 2147483647 is one too, read as one past it: it was
      # answered "not a number", where it is a body too large.
      return ParsedRequest.new(nil, "body past #{MAX_BODY} bytes", true, 0) if n > MAX_BODY.to_i64
      length = n.to_i32
    end
    # Short of its length, the rest is waited for (`wanted`) - the bytes
    # it will take, not a copy of what has arrived.
    return ParsedRequest.new(nil, nil, false, 0, body_start + length, expects) if text.bytesize - body_start < length
    ParsedRequest.new(Request.new(method, path, query, headers, text[body_start, length]), nil, close, body_start + length)
  end

  # The response as it goes on the wire. `Content-Length` is the body's
  # (or the caller's, for a HEAD that describes a body it does not send),
  # `Connection` says what the connection will do next. A 1xx, 204 or 304
  # has no content (RFC 9110 §15), and writes neither a body nor a length
  # of its own (§8.6): the body was read by the client as the start of the
  # next answer, and `Content-Length: 0` on a 304 told a cache that the
  # resource had become empty.
  def self.format_response(response : Response, head : Bool, close : Bool) : String
    # A status line the client half reads as written, refused otherwise as
    # a request's lines are: `Response.new(200, "OK\r\nSet-Cookie: a=1",
    # ...)` went out with a header of its own in the reason, and 2000 as
    # `HTTP/1.1 2000 Server Error`, which `parse_response` refuses.
    raise "HTTP: not a status: #{response.status}" unless response.status >= 100 && response.status <= 999
    raise "HTTP: the reason contains a line break" if HTTP.has_break?(response.reason)
    raise "HTTP: the reason contains a control character" if HTTP.control?(response.reason)
    text = "HTTP/1.1 #{response.status} #{response.reason}\r\n"
    has_length = false
    response.headers.each do |name, value|
      raise "HTTP: not a header name: #{name.inspect}" unless HTTP.token?(name)
      raise "HTTP: header #{name} contains a line break" if HTTP.has_break?(value)
      raise "HTTP: header #{name} contains a control character" if HTTP.control?(value)
      next if HTTP.same_name?(name, "Connection")
      # The body is written whole, after its length: a caller's chunked
      # framing went out beside `Content-Length` (RFC 9112 §6.1), and a
      # caller's length was written whatever the body was, so "2" on
      # "hello" was read as "he" and "llo" began the next answer. A length
      # is the caller's only where no body follows it: a HEAD, or a 304
      # that names the length a 200 would have (RFC 9110 §8.6).
      raise "HTTP: #{name} is not written; the body goes with its length" if HTTP.same_name?(name, "Transfer-Encoding")
      if HTTP.same_name?(name, "Content-Length")
        unless head || response.status == 304
          n = HTTP.content_length(value)
          raise "HTTP: #{name} #{value.inspect} is not the body's #{response.body.bytesize} bytes" unless n && n == response.body.bytesize.to_i64
        end
        has_length = true
      end
      text = text + name + ": " + value + "\r\n"
    end
    bodiless = (response.status >= 100 && response.status < 200) || response.status == 204 || response.status == 304
    text = text + "Content-Length: #{response.body.bytesize}\r\n" unless has_length || bodiless
    text = text + (close ? "Connection: close\r\n" : "Connection: keep-alive\r\n")
    text = text + "\r\n"
    head || bodiless ? text : text + response.body
  end
end

pub struct HTTP
  # The request as it goes on the wire. `Host`, `Connection` and
  # `Content-Length` are the request's own lines; a caller's header of
  # that name is refused rather than sent twice. A body's length is
  # always written for the methods a body belongs to, so `POST` with
  # nothing to say still says `Content-Length: 0`.
  def self.format_request(method : String, path : String, host : String, body : String = "", headers : Hash(String, String) = {} of String => String) : String
    raise "HTTP: not a method: #{method.inspect}" unless token?(method)
    raise "HTTP: not a request path: #{path.inspect}" if path.bytesize == 0 || has_space_or_control?(path)
    raise "HTTP: not a host: #{host.inspect}" if host.bytesize == 0 || has_space_or_control?(host)
    req = "#{method} #{path} HTTP/1.1\r\nHost: #{host}\r\nConnection: close\r\n"
    headers.each do |name, value|
      raise "HTTP: not a header name: #{name.inspect}" unless token?(name)
      raise "HTTP: header #{name} contains a line break" if has_break?(value)
      raise "HTTP: header #{name} contains a control character" if control?(value)
      if same_name?(name, "Host") || same_name?(name, "Connection") || same_name?(name, "Content-Length")
        raise "HTTP: #{name} is the request's own header"
      end
      # A request's body goes with its length, never chunked: a caller's
      # `Transfer-Encoding: chunked` was written beside `Content-Length`,
      # a pair RFC 9112 §6.2 forbids, over a body that was not chunked, and
      # the module's own server, which reads the chunks first, took "abc"
      # for an unfinished chunk size and waited for the rest.
      raise "HTTP: #{name} is not sent; a request's body goes with its length" if same_name?(name, "Transfer-Encoding")
      req = req + name + ": " + value + "\r\n"
    end
    if body.bytesize > 0 || same_name?(method, "POST") || same_name?(method, "PUT") || same_name?(method, "PATCH")
      req = req + "Content-Length: #{body.bytesize}\r\n"
    end
    req + "\r\n" + body
  end

  # The response as it came off the wire. `head` says the request was a
  # `HEAD`, whose answer carries the headers of a body it does not send.
  # An interim answer - `100 Continue`, `103 Early Hints` - is read past to
  # the final one after it (RFC 9110 §15.2): the server here answers
  # `Expect: 100-continue` with a 100, and `HTTP.post` returned the 100.
  # A `101` switches protocols, and HTTP ends with it.
  def self.parse_response(text : String, head : Bool = false) : Response
    start = 0
    status = 0
    reason = ""
    headers = {} of String => String
    while true
      split_at = find_headers_end(text, start)
      raise "HTTP: no header terminator" unless split_at
      lines = split_crlf(text[start, split_at - start])
      raise "HTTP: empty response" if lines.size == 0
      status, reason = parse_status(lines[0])
      headers = case fields = parse_fields(lines, unfold: true)
                in String
                  raise "HTTP: " + fields
                in Hash(String, String)
                  fields
                end
      start = split_at + 4
      break unless status >= 100 && status < 200 && status != 101 && start < text.bytesize
    end
    body = text[start, text.bytesize - start]
    response = Response.new(status, reason, headers, "")
    return response if head || status == 204 || status == 304 || (status >= 100 && status < 200)
    if te = response.header("Transfer-Encoding")
      # Chunked, once and last, is the coding this client decodes (RFC 9112
      # §6.3): `gzip, chunked` and two `chunked` lines were taken for no
      # coding at all, and the chunks came back as the body of a 200,
      # framing and all.
      if refused = coding_refused(te)
        raise "HTTP: " + refused
      end
      body = decode_chunked(body)
    elsif cl = response.header("Content-Length")
      n = content_length(cl)
      raise "HTTP: Content-Length is not a number: #{cl.inspect}" unless n
      raise "HTTP: Content-Length #{cl.inspect} is past the 2147483647 bytes a string holds" if n > 2147483647_i64
      length = n.to_i32
      # Short of it is a connection that ended early, as a chunked body cut
      # inside a chunk is: it was answered as a whole 200 with the part
      # that came, a cut-off download read as a good one.
      raise "HTTP: the body ended after #{body.bytesize} of its #{length} bytes" if body.bytesize < length
      body = body[0, length] if length < body.bytesize
    end
    Response.new(status, reason, headers, body)
  end

  # Why an answer's `Transfer-Encoding` is not one this client decodes,
  # nil when it is `chunked` alone: it undoes no other coding, and chunked
  # twice is a body framed twice. An empty list element is no coding (RFC
  # 9110 §5.6.1).
  private def self.coding_refused(te : String) : String?
    chunked = 0
    te.split(',').each do |part|
      coding = trim(part)
      next if coding.bytesize == 0
      return "transfer coding #{coding.inspect} is not one this client decodes" unless same_name?(coding, "chunked")
      chunked = chunked + 1
    end
    return "Transfer-Encoding #{te.inspect} names no coding this client decodes" if chunked == 0
    return "Transfer-Encoding #{te.inspect} is chunked twice" if chunked > 1
    nil
  end

  # The field lines after the first, or why they are not fields. A name
  # repeated, in any case, is one field, its values joined in order with
  # ", " (RFC 9110 §5.3): into a Hash by name, a second line spelled the
  # same replaced the first and one spelled otherwise was an entry
  # `header` never reached, so two different `Content-Length`s were read
  # as whichever came first or last. A value with a control character in
  # it - a CR or LF that ends no line, a NUL - is refused (§5.5) rather than
  # handed to whoever reads it or echoes it into a header.
  #
  # *unfold*, for an answer: a line that begins with a blank continues the
  # field above it (obs-fold, RFC 9112 §5.2), and a user agent joins it on
  # with one space; read as a field of its own, `HTTP.get` panicked with
  # "header without a colon: \" b\"". A server may refuse one, and this
  # one does.
  def self.parse_fields(lines : Array(String), unfold : Bool = false) : Hash(String, String) | String
    lines = unfolded(lines) if unfold
    headers = {} of String => String
    # The name as it was first spelled, by its lowercase, and the values
    # after the first, joined once at the end: joining line by line copied
    # the value so far per line.
    spelled = {} of String => String
    more = {} of String => Array(String)
    i = 1
    while i < lines.size
      line = lines[i]
      i = i + 1
      next if line.bytesize == 0
      colon = line.index(':')
      return "header without a colon: #{line.inspect}" unless colon
      name = line[0, colon]
      return "not a header name: #{name.inspect}" unless token?(name)
      value = trim(line[colon + 1, line.bytesize - colon - 1])
      return "header #{name} contains a control character" if control?(value)
      key = name.downcase
      if first = spelled[key]?
        if values = more[first]?
          values << value
        else
          more[first] = [headers[first], value]
        end
      else
        spelled[key] = name
        headers[name] = value
      end
    end
    more.each do |name, values|
      headers[name] = values.join(", ")
    end
    headers
  end

  # *lines* with each field's folded lines joined onto it, one space for
  # each fold. A blank-led line right under the status line continues no
  # field, and is left for `parse_fields` to refuse.
  private def self.unfolded(lines : Array(String)) : Array(String)
    out = [] of String
    i = 0
    while i < lines.size
      line = lines[i]
      i = i + 1
      if i > 1 && i < lines.size && folded?(lines[i])
        joined = String::Builder.new
        joined << trim(line)
        while i < lines.size && folded?(lines[i])
          joined << ' ' << trim(lines[i])
          i = i + 1
        end
        line = joined.to_s
      end
      out << line
    end
    out
  end

  private def self.folded?(line : String) : Bool
    line.bytesize > 0 && (line.to_unsafe[0] == 32_u8 || line.to_unsafe[0] == 9_u8)
  end

  # A `Content-Length` as a number, or nil when it is not one. Repeated
  # lines arrive joined, and are one length only when every one says the
  # same (RFC 9112 §6.3). A length past 2147483647 is still a length, too
  # large for either side, and is read as one past it: `to_i?` answered
  # nil for it, and 3000000000 was refused as "not a number".
  def self.content_length(value : String) : Int64?
    parts = value.split(',')
    return nil if parts.size == 0
    first = trim(parts[0])
    parts.each do |part|
      return nil unless trim(part) == first
    end
    # Digits and nothing else (RFC 9110 §8.6): `to_i?` took a sign, and
    # `+2` was a length.
    return nil unless first.bytesize > 0 && digits?(first)
    p = first.to_unsafe
    n = 0_i64
    i = 0
    while i < first.bytesize
      n = n * 10_i64 + (p[i] - 48_u8).to_i64
      return 2147483648_i64 if n > 2147483647_i64
      i = i + 1
    end
    n
  end

  # A chunked body (RFC 9112 §7.1) as one string: each chunk's size line
  # is hexadecimal, extensions after `;` are ignored, and a zero-length
  # chunk ends it. What follows the last chunk is trailers, which nothing
  # here reads.
  def self.decode_chunked(text : String) : String
    p = text.to_unsafe
    n = text.bytesize
    # One builder for the body: adding each chunk to the body so far copied
    # it once per chunk.
    out = String::Builder.new
    i = 0
    while true
      line_end = find_crlf(text, i)
      raise "HTTP: chunked body ends inside a chunk size" unless line_end
      size_text = text[i, line_end - i]
      if semi = size_text.index(';')
        size_text = size_text[0, semi]
      end
      size = parse_hex(trim(size_text))
      raise "HTTP: not a chunk size: #{size_text.inspect}" unless size
      i = line_end + 2
      break if size == 0
      # `size` may be 2^31 - 1: `i + size` passed Int32's end and panicked.
      raise "HTTP: chunked body ends inside a chunk" if size > n - i
      out.write(p + i, size)
      i = i + size
      raise "HTTP: a chunk is not followed by CRLF" unless i + 1 < n && p[i] == 13_u8 && p[i + 1] == 10_u8
      i = i + 2
    end
    out.to_s
  end

  def self.find_headers_end(text : String, from : Int32 = 0) : Int32?
    p = text.to_unsafe
    n = text.bytesize
    i = from
    while i + 3 < n
      if p[i] == 13_u8 && p[i + 1] == 10_u8 && p[i + 2] == 13_u8 && p[i + 3] == 10_u8
        return i
      end
      i = i + 1
    end
    nil
  end

  def self.split_crlf(text : String) : Array(String)
    lines = [] of String
    p = text.to_unsafe
    n = text.bytesize
    start = 0
    i = 0
    while i < n
      if p[i] == 13_u8 && i + 1 < n && p[i + 1] == 10_u8
        lines << text[start, i - start]
        i = i + 2
        start = i
      else
        i = i + 1
      end
    end
    lines << text[start, n - start] if start < n
    lines
  end

  # One request, one answer, one connection, which `Connection: close`
  # asks the server to close. The answer is read as far as its framing
  # says (RFC 9112 §6.3) - its length, its last chunk, or its head alone
  # for a `HEAD`, a 1xx, 204 or 304 - and to the server's close only when it
  # has neither a length nor chunks. A head past `Server::MAX_HEAD`, the
  # megabyte the server takes of a request's, is refused. The socket parks
  # under the runtime, so a request from a task answers `Cancelled` when
  # the task is; a refused or reset connection answers `SocketError`; `!`
  # passes either up, `.or_panic` refuses it.
  def self.request(method : String, url : String, headers : Hash(String, String) = {} of String => String, body : String = "") : Response | Cancelled | SocketError
    uri = URI.parse(url)
    scheme = uri.scheme
    # In any case (RFC 3986 §3.1): `HTTP://host/` was "only http://".
    scheme = scheme.downcase if scheme
    raise "HTTP: TLS is not in 0.x; use http://" if scheme == "https"
    raise "HTTP: only http://" unless scheme == "http"
    host = uri.hostname
    raise "HTTP: missing host" unless host
    path = uri.path
    path = "/" if path.bytesize == 0
    if q = uri.query
      path = path + "?" + q
    end
    port = uri.port
    port = 80 unless port
    # An IPv6 literal in its brackets, as the URL wrote it (RFC 9110
    # §7.2): `hostname` is the address without them, and `Host: ::1:8080`
    # named no host a server can split from its port.
    named = host.includes?(":") ? "[#{host}]" : host
    host_line = port == 80 ? named : "#{named}:#{port}"
    text = format_request(method, path, host_line, body, headers)
    sock = IyiSocket.connect(host, port)!
    defer sock.close
    sock.write(text)!
    head = same_name?(method, "HEAD")
    # Read to the close, an answer the server reset after it was whole came
    # back as `SocketError`, and one from a server that held the connection
    # open waited for it: a 2-byte body took 3 s. Nothing past what its
    # framing says is read.
    failed = nil.as(Cancelled | SocketError | Nil)
    reader = -> do
      read = sock.read(65536)
      failed = read unless read.is_a?(String)
      read.is_a?(String) && read.bytesize > 0 ? read : nil
    end
    got = ""
    at = 0
    while true
      # As far as the server's limit on a request's head, and no further: a
      # head that did not end was read for as long as it came, 256 MB of one
      # field cost the client 824 MB, and one that never ended took it all.
      got, ends = read_head(got, at, Server::MAX_HEAD) { reader.call }
      if failure = failed
        return failure
      end
      raise "HTTP: response headers past #{Server::MAX_HEAD} bytes" if ends.nil? && got.bytesize - at > Server::MAX_HEAD
      # The connection ended before a head did: refused as it was, or the
      # interim answer it ended after is the answer.
      return parse_response(got, head) unless ends
      body_start = ends + 4
      final = parse_response(got[0, body_start], true)
      status = final.status
      if status >= 100 && status < 200 && status != 101
        at = body_start
        next
      end
      return final if head || status == 204 || status == 304 || status == 101
      if te = final.header("Transfer-Encoding")
        if refused = coding_refused(te)
          raise "HTTP: " + refused
        end
        read = read_chunked(got, body_start, 2147483647) { reader.call }
        if failure = failed
          return failure
        end
        raise "HTTP: chunked body ends before its last chunk" if read.nil?
        raise "HTTP: " + read if read.is_a?(String)
        body, _ = read
        return Response.new(status, final.reason, final.headers, body)
      end
      need = 9223372036854775807_i64
      if cl = final.header("Content-Length")
        n = content_length(cl)
        # Not a length, or past what a string holds: refused as it was.
        return parse_response(got, head) unless n && n <= 2147483647_i64
        need = body_start.to_i64 + n
      end
      # Into one builder, in large reads: adding each 4 KB read to the
      # answer so far copied it once per read, and a 24 MB answer took
      # minutes.
      answer = String::Builder.new
      answer << got
      while answer.bytesize.to_i64 < need
        chunk = sock.read(65536)!
        break if chunk.bytesize == 0
        answer << chunk
      end
      return parse_response(answer.to_s, head)
    end
  end

  def self.get(url : String, headers : Hash(String, String) = {} of String => String) : Response | Cancelled | SocketError
    request("GET", url, headers)
  end

  def self.head(url : String, headers : Hash(String, String) = {} of String => String) : Response | Cancelled | SocketError
    request("HEAD", url, headers)
  end

  def self.post(url : String, body : String = "", headers : Hash(String, String) = {} of String => String) : Response | Cancelled | SocketError
    request("POST", url, headers, body)
  end

  def self.put(url : String, body : String = "", headers : Hash(String, String) = {} of String => String) : Response | Cancelled | SocketError
    request("PUT", url, headers, body)
  end

  def self.delete(url : String, headers : Hash(String, String) = {} of String => String) : Response | Cancelled | SocketError
    request("DELETE", url, headers)
  end

  # Two field names for the same field: ASCII case is the only difference
  # a name may carry.
  def self.same_name?(a : String, b : String) : Bool
    return false unless a.bytesize == b.bytesize
    pa = a.to_unsafe
    pb = b.to_unsafe
    i = 0
    while i < a.bytesize
      ca = pa[i]
      cb = pb[i]
      ca = ca + 32_u8 if ca >= 65_u8 && ca <= 90_u8
      cb = cb + 32_u8 if cb >= 65_u8 && cb <= 90_u8
      return false unless ca == cb
      i = i + 1
    end
    true
  end

  # Whether a list of tokens (RFC 9110 §5.6.1), its repeated lines joined
  # with ", ", holds *token*, in any case.
  def self.has_token?(list : String, token : String) : Bool
    list.split(',').each do |part|
      return true if same_name?(trim(part), token)
    end
    false
  end

  # A token (RFC 9110 §5.6.2): what a method or a field name is made of.
  def self.token?(text : String) : Bool
    return false if text.bytesize == 0
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      c = p[i]
      letter = (c >= 65_u8 && c <= 90_u8) || (c >= 97_u8 && c <= 122_u8)
      digit = c >= 48_u8 && c <= 57_u8
      mark = c == 33_u8 || (c >= 35_u8 && c <= 39_u8) || c == 42_u8 || c == 43_u8 ||
             c == 45_u8 || c == 46_u8 || c == 94_u8 || c == 95_u8 || c == 96_u8 ||
             c == 124_u8 || c == 126_u8
      return false unless letter || digit || mark
      i = i + 1
    end
    true
  end

  def self.has_break?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      return true if p[i] == 13_u8 || p[i] == 10_u8
      i = i + 1
    end
    false
  end

  # A byte a request line may not carry: a blank, which ends its part, or
  # a control character.
  private def self.has_space_or_control?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      return true if p[i] <= 32_u8 || p[i] == 127_u8
      i = i + 1
    end
    false
  end

  # A control character other than a tab, or DEL: what a field value may
  # not hold (RFC 9110 §5.5), nor a request target or a reason phrase.
  def self.control?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      return true if (p[i] < 32_u8 && p[i] != 9_u8) || p[i] == 127_u8
      i = i + 1
    end
    false
  end

  # For a request target in absolute form (RFC 9112 §3.2.2), where its
  # authority starts: after `http://` or `https://`, in any case.
  def self.absolute_form(target : String) : Int32?
    return 7 if target.bytesize >= 7 && same_name?(target[0, 7], "http://")
    return 8 if target.bytesize >= 8 && same_name?(target[0, 8], "https://")
    nil
  end

  # A Host value - the `a` of `Host: a` - or an absolute-form target's
  # authority, made of what a host and its port are spelled with (RFC 3986
  # §3.2.2, §3.2.3): a name, an IPv4 address or an IPv6 one in brackets,
  # and digits after a colon. Empty is one too, for a target with no
  # authority (RFC 9112 §3.2). A blank, a `/`, an `@` - the bytes another
  # host or a path begins with - are not.
  def self.host?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      c = p[i]
      letter = (c >= 65_u8 && c <= 90_u8) || (c >= 97_u8 && c <= 122_u8)
      digit = c >= 48_u8 && c <= 57_u8
      # ! $ % & ' ( ) * + , - . : ; = [ ] _ ~
      mark = c == 33_u8 || (c >= 36_u8 && c <= 46_u8) || c == 58_u8 || c == 59_u8 ||
             c == 61_u8 || c == 91_u8 || c == 93_u8 || c == 95_u8 || c == 126_u8
      return false unless letter || digit || mark
      i = i + 1
    end
    true
  end

  private def self.find_crlf(text : String, from : Int32) : Int32?
    p = text.to_unsafe
    n = text.bytesize
    i = from
    while i + 1 < n
      return i if p[i] == 13_u8 && p[i + 1] == 10_u8
      i = i + 1
    end
    nil
  end

  private def self.parse_hex(text : String) : Int32?
    return nil if text.bytesize == 0
    p = text.to_unsafe
    value = 0
    i = 0
    while i < text.bytesize
      c = p[i]
      digit = if c >= 48_u8 && c <= 57_u8
                (c - 48_u8).to_i32
              elsif c >= 97_u8 && c <= 102_u8
                (c - 87_u8).to_i32
              elsif c >= 65_u8 && c <= 70_u8
                (c - 55_u8).to_i32
              else
                return nil
              end
      return nil if value > 0x7FFFFFF
      value = value * 16 + digit
      i = i + 1
    end
    value
  end

  private def self.parse_status(line : String) : {Int32, String}
    # HTTP/1.1 200 OK: the version is `HTTP/` DIGIT "." DIGIT and the
    # status three digits from 100 (RFC 9112 §2.3, §4). Read by `to_i?`, a
    # sign was a digit, so `+20` and `-99` were statuses, and so were 000
    # to 099; `HTTP/x` was a version, and a reason could hold a bare CR.
    raise "HTTP: not a status line: #{line}" unless line.starts_with?("HTTP/")
    sp1 = line.index(' ')
    raise "HTTP: not a status line: #{line}" unless sp1 && sp1 == 8 && digits?(line[5, 1]) && line.to_unsafe[6] == 46_u8 && digits?(line[7, 1])
    rest = line[sp1 + 1, line.bytesize - sp1 - 1]
    sp2 = rest.index(' ')
    code_text = sp2 ? rest[0, sp2] : rest
    code = code_text.to_i?
    raise "HTTP: not a status line: #{line}" unless code && code_text.bytesize == 3 && digits?(code_text) && code >= 100
    reason = sp2 ? rest[sp2 + 1, rest.bytesize - sp2 - 1] : ""
    raise "HTTP: not a status line: #{line}" if control?(reason)
    {code, reason}
  end

  private def self.digits?(text : String) : Bool
    p = text.to_unsafe
    i = 0
    while i < text.bytesize
      return false unless p[i] >= 48_u8 && p[i] <= 57_u8
      i = i + 1
    end
    true
  end

  # The reason phrase a status carries (RFC 9110 §15), for a response the
  # server writes; a status this table does not know gets its class's.
  def self.reason_for(status : Int32) : String
    case status
    when 200 then "OK"
    when 201 then "Created"
    when 202 then "Accepted"
    when 204 then "No Content"
    when 301 then "Moved Permanently"
    when 302 then "Found"
    when 304 then "Not Modified"
    when 400 then "Bad Request"
    when 401 then "Unauthorized"
    when 403 then "Forbidden"
    when 404 then "Not Found"
    when 405 then "Method Not Allowed"
    when 408 then "Request Timeout"
    when 413 then "Content Too Large"
    when 500 then "Internal Server Error"
    when 501 then "Not Implemented"
    when 503 then "Service Unavailable"
    else
      if status < 200
        "Informational"
      elsif status < 300
        "Success"
      elsif status < 400
        "Redirection"
      elsif status < 500
        "Client Error"
      else
        "Server Error"
      end
    end
  end

  # A head as it arrives: *held*, then what *client* reads after it, until
  # a blank line at or after *from* ends a head, or more than *limit*
  # bytes after *from* hold none. The text, and where its head ends - nil
  # when *client* ran out first. Each read is searched once, with the three
  # bytes before it where a blank line may have begun, and kept in one
  # builder; a first read that holds a whole head is the text as it came.
  # Adding each read to the head so far and searching all of
  # what has arrived again cost the server 8.8 s for a 1 MB head that came
  # 128 bytes at a time, and 0.06 s for the same head in one piece.
  def self.read_head(held : String, from : Int32, limit : Int32, &client : -> String?) : {String, Int32?}
    if found = find_headers_end(held, from)
      return {held, found}
    end
    size = held.bytesize
    edge = size - from > 3 ? held[size - 3, 3] : held[from, size - from]
    text = nil.as(String::Builder?)
    while size - from <= limit
      chunk = read_more(client)
      break unless chunk
      found = nil.as(Int32?)
      if edge.bytesize > 0
        probe = edge + chunk[0, chunk.bytesize < 3 ? chunk.bytesize : 3]
        if at = find_headers_end(probe)
          found = size - edge.bytesize + at
        end
      end
      if found.nil?
        if at = find_headers_end(chunk)
          found = size + at
        end
      end
      return {chunk, found} if found && size == 0
      built = text
      unless built
        built = String::Builder.new(size + chunk.bytesize)
        built << held
        text = built
      end
      built << chunk
      size = size + chunk.bytesize
      return {built.to_s, found} if found
      tail = chunk.bytesize >= 3 ? chunk : edge + chunk
      edge = tail.bytesize > 3 ? tail[tail.bytesize - 3, 3] : tail
    end
    if built = text
      return {built.to_s, nil}
    end
    {held, nil}
  end

  # A chunked body as it arrives, from *from* in *held* and then what
  # *client* reads: the body and what came after it, the reason it is not
  # one, or nil when the connection ended first. Each read is decoded into
  # the body once; only an unfinished size line is carried to the next.
  def self.read_chunked(held : String, from : Int32, limit : Int32, &client : -> String?) : {String, String} | String | Nil
    body = String::Builder.new
    data = held
    pos = from
    total = 0
    while true
      line_end = find_crlf(data, pos)
      while line_end.nil?
        return "a chunk size line past 4096 bytes" if data.bytesize - pos > 4096
        more = read_more(client)
        return nil unless more
        data = data[pos, data.bytesize - pos] + more
        pos = 0
        line_end = find_crlf(data, pos)
      end
      size_text = data[pos, line_end - pos]
      if semi = size_text.index(';')
        size_text = size_text[0, semi]
      end
      size = parse_hex(trim(size_text))
      unless size
        return "not a chunk size: #{size_text.inspect}"
      end
      pos = line_end + 2
      if size == 0
        # Trailers, then a blank line.
        while true
          t_end = find_crlf(data, pos)
          while t_end.nil?
            return "trailers past 4096 bytes" if data.bytesize - pos > 4096
            more = read_more(client)
            return nil unless more
            data = data[pos, data.bytesize - pos] + more
            pos = 0
            t_end = find_crlf(data, pos)
          end
          if t_end == pos
            pos = pos + 2
            return {body.to_s, data[pos, data.bytesize - pos]}
          end
          pos = t_end + 2
        end
      end
      return "chunked body past #{limit} bytes" if size > limit - total
      total = total + size
      remaining = size
      while remaining > 0
        if pos == data.bytesize
          more = read_more(client)
          return nil unless more
          data = more
          pos = 0
        end
        take = data.bytesize - pos
        take = remaining if take > remaining
        body.write(data.to_unsafe + pos, take)
        pos = pos + take
        remaining = remaining - take
      end
      while data.bytesize - pos < 2
        more = read_more(client)
        return nil unless more
        data = data[pos, data.bytesize - pos] + more
        pos = 0
      end
      return "a chunk is not followed by CRLF" unless data.to_unsafe[pos] == 13_u8 && data.to_unsafe[pos + 1] == 10_u8
      pos = pos + 2
    end
  end

  # The next of what has arrived, for `read_head` and `read_chunked`: what
  # the caller's *client* reads, nil when none is to come. The server's
  # waits where `serve` can close it, the client's keeps the socket's
  # failure to answer with.
  private def self.read_more(client : Proc(String?)) : String?
    client.call
  end

  # Where a chunked body that starts at *from* ends in `text` — the byte
  # after the last chunk's terminating CRLF (trailers included) — nil when
  # it has not all arrived, or why it is not a chunked body. What
  # `decode_chunked` will then read whole.
  def self.chunked_end(text : String, from : Int32 = 0) : Int32 | String | Nil
    p = text.to_unsafe
    n = text.bytesize
    i = from
    while true
      line_end = find_crlf(text, i)
      return nil unless line_end
      size_text = text[i, line_end - i]
      if semi = size_text.index(';')
        size_text = size_text[0, semi]
      end
      size = parse_hex(trim(size_text))
      return "not a chunk size: #{size_text.inspect}" unless size
      i = line_end + 2
      if size == 0
        # Trailers, then a blank line.
        while true
          t_end = find_crlf(text, i)
          return nil unless t_end
          return t_end + 2 if t_end == i
          i = t_end + 2
        end
      end
      # `size` may be 2^31 - 1: `i + size + 2` passed Int32's end and
      # panicked.
      return nil if size > n - i - 2
      i = i + size
      return "a chunk is not followed by CRLF" unless p[i] == 13_u8 && p[i + 1] == 10_u8
      i = i + 2
    end
  end

  # Without the blanks at either end (RFC 9112 §5.1: field values are
  # trimmed of the whitespace around them).
  def self.trim(s : String) : String
    p = s.to_unsafe
    first = 0
    last = s.bytesize
    while first < last && (p[first] == 32_u8 || p[first] == 9_u8)
      first = first + 1
    end
    while last > first && (p[last - 1] == 32_u8 || p[last - 1] == 9_u8)
      last = last - 1
    end
    s[first, last - first]
  end
end
