; iyi-ir 1
source_filename = "fold_divrem"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @signed_divide() {
entry:
  %v = sdiv i32 -7, 2
  ret i32 %v
}

define internal i32 @signed_remainder() {
entry:
  %v = srem i32 -7, 2
  ret i32 %v
}

define internal i32 @unsigned_divide() {
entry:
  %v = udiv i32 -1, 2
  ret i32 %v
}

define internal i32 @unsigned_remainder() {
entry:
  %v = urem i32 -1, 2
  ret i32 %v
}
