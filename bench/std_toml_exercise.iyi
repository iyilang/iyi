# The redefinition rules' edges that are allowed.
VALID_EDGES = [
  "a.b = 1\n[a.c]\n",
  "[a.b.c]\n[a]\nb.d = 1\n",
  "[a.b]\n[a]\n",
  "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple.texture]\nsmooth = true\n",
  "[[a]]\n[a.b]\nc = 1\n[[a]]\n[a.b]\nc = 2\n",
  "[[a]]\nb.c = 1\n[[a]]\nb.c = 2\n",
  "[a]\nb.c = 1\nb.d = 2\n",
  "x = {a.b = 1, a.c = 2}\n",
  "[x.y.z.w]\n[x]\n",
  "a = [[1, 2], [\"a\", 1.5], [{b = 1}], []]\n",
  "[[a.b]]\n[[a.b]]\n[a]\nc = 1\n",
  "\"a.b\" = 1\na.b = 2\n",
  "a.'b' = 1\n'a'.\"c\" = 2\n",
  "[ a . b ]\n[ \"a\" . c ]\n",
  "[[ a ]]\n[[ a ]]\n",
]

# Every refusal, with its sentence. Python's tomllib refuses each too.
REFUSALS = [
  {"key = # INVALID\n", "'#' cannot start a value at line 1, column 7"},
  {"first = \"Tom\" last = \"Preston-Werner\" # INVALID\n", "'l' after the end of a statement, where the line should end at line 1, column 15"},
  {"= \"no key name\"  # INVALID\n", "'=' cannot start a key at line 1, column 1"},
  {"name = \"Tom\"\nname = \"Pradyun\"\n", "the key name is defined twice at line 2, column 1"},
  {"spelling = \"favorite\"\n\"spelling\" = \"favourite\"\n", "the key spelling is defined twice at line 2, column 1"},
  {"fruit.apple = 1\nfruit.apple.smooth = true\n", "fruit.apple is an integer, not a table at line 2, column 7"},
  {"str5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"\n", "'.' after the end of a statement, where the line should end at line 1, column 46"},
  {"apos15 = '''Here are fifteen apostrophes: ''''''''''''''''''\n", "18 apostrophes closing a multi-line literal string, where five is the most at line 1, column 43"},
  {"invalid_float_1 = .7\n", "'.' cannot start a value at line 1, column 19"},
  {"invalid_float_2 = 7.\n", "7. needs a digit after its '.' at line 1, column 19"},
  {"invalid_float_3 = 3.e+20\n", "3.e+20 needs a digit after its '.' at line 1, column 19"},
  {"[fruit]\napple = \"red\"\n\n[fruit]\norange = \"orange\"\n", "the table [fruit] is declared twice at line 4, column 2"},
  {"[fruit]\napple = \"red\"\n\n[fruit.apple]\ntexture = \"smooth\"\n", "fruit.apple is a string, not a table at line 4, column 8"},
  {"[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple]\n", "[fruit.apple] declares a table dotted keys made at line 5, column 8"},
  {"[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple.taste]\n", "[fruit.apple.taste] declares a table dotted keys made at line 5, column 14"},
  {"[product]\ntype = { name = \"Nail\" }\ntype.edible = false\n", "the inline table product.type is closed: no header or dotted key adds to it at line 3, column 1"},
  {"[product]\ntype.name = \"Nail\"\ntype = { edible = false }\n", "the key product.type is defined twice at line 3, column 1"},
  {"[fruit.physical]\ncolor = \"red\"\nshape = \"round\"\n\n[[fruit]]\nname = \"apple\"\n", "[[fruit]] names the table fruit, not an array of tables at line 5, column 3"},
  {"fruits = []\n\n[[fruits]]\n", "the array fruits was written as a value, which no header or dotted key adds to at line 3, column 3"},
  {"[[fruits]]\nname = \"apple\"\n\n[[fruits.varieties]]\nname = \"red delicious\"\n\n[fruits.varieties]\nname = \"granny smith\"\n", "[fruits.varieties] names an array of tables, which [[fruits.varieties]] adds to at line 7, column 9"},
  {"[[fruits]]\n[fruits.physical]\ncolor = \"red\"\n\n[[fruits.physical]]\ncolor = \"green\"\n", "[[fruits.physical]] names the table fruits.physical, not an array of tables at line 5, column 10"},
  {"\uFEFFa = 1\n", "a byte order mark, which a TOML document does not start with at line 1, column 1"},
  {"a = 1 # bell \u0007\n", "the control character U+0007 in a comment at line 1, column 14"},
  {"# del \u007F\n", "the control character U+007F in a comment at line 1, column 7"},
  {"a = 1\r", "a carriage return not followed by a line feed at line 1, column 6"},
  {"a = 1\rb = 2\n", "a carriage return not followed by a line feed at line 1, column 6"},
  {"a = \"x\u0000y\"\n", "the control character U+0000 in a string, where it must be escaped at line 1, column 7"},
  {"a = \"x\u007Fy\"\n", "the control character U+007F in a string, where it must be escaped at line 1, column 7"},
  {"a = 'x\u001Fy'\n", "the control character U+001F in a literal string, which cannot hold it at line 1, column 7"},
  {"a = \"\"\"x\u000Cy\"\"\"\n", "the control character U+000C in a string, where it must be escaped at line 1, column 9"},
  {"a = '''x\u000By'''\n", "the control character U+000B in a literal string, which cannot hold it at line 1, column 9"},
  {"a = \"\"\"x\ry\"\"\"\n", "a carriage return not followed by a line feed at line 1, column 9"},
  {"a = \"no end\n", "a line break in a single-line string at line 1, column 12"},
  {"a = \"line\nbreak\"\n", "a line break in a single-line string at line 1, column 10"},
  {"a = 'no end\n", "a line break in a single-line string at line 1, column 12"},
  {"a = \"\"\"no end\n", "a multi-line string that does not close at line 1, column 5"},
  {"a = '''no end\n", "a multi-line string that does not close at line 1, column 5"},
  {"a = \"\\e\"\n", "\\e is not an escape TOML has at line 1, column 6"},
  {"a = \"\\x41\"\n", "\\x is not an escape TOML has at line 1, column 6"},
  {"a = \"\\a\"\n", "\\a is not an escape TOML has at line 1, column 6"},
  {"a = \"\\ \"\n", "'\\' followed by ' ' is not an escape TOML has at line 1, column 6"},
  {"a = \"\\uD800\"\n", "\\uD800 is not a Unicode scalar value at line 1, column 6"},
  {"a = \"\\UDFFF0000\"\n", "\\UDFFF0000 is not a Unicode scalar value at line 1, column 6"},
  {"a = \"\\U00110000\"\n", "\\U00110000 is not a Unicode scalar value at line 1, column 6"},
  {"a = \"\\u12\"\n", "\\u takes 4 hexadecimal digits at line 1, column 6"},
  {"a = \"\\u12G4\"\n", "\\u takes 4 hexadecimal digits at line 1, column 6"},
  {"a = \"\"\"x\\ y\"\"\"\n", "'\\' followed by ' ' is not an escape TOML has at line 1, column 9"},
  {"a = \"\"\"x\"\"\"\"\"\"\n", "6 quotes closing a multi-line string, where five is the most at line 1, column 9"},
  {"a = '''x''''''\n", "6 apostrophes closing a multi-line literal string, where five is the most at line 1, column 9"},
  {"\"\"\"a\"\"\" = 1\n", "a multi-line string cannot be a key at line 1, column 1"},
  {"'''a''' = 1\n", "a multi-line string cannot be a key at line 1, column 1"},
  {"a b = 1\n", "'b' after the key a, where '=' should be at line 1, column 3"},
  {"a.b. = 1\n", "'=' cannot start a key at line 1, column 6"},
  {".a = 1\n", "'.' cannot start a key at line 1, column 1"},
  {"a..b = 1\n", "'.' cannot start a key at line 1, column 3"},
  {"a = 1 = 2\n", "'=' after the end of a statement, where the line should end at line 1, column 7"},
  {"a\n= 1\n", "a line break after the key a, where '=' should be at line 1, column 2"},
  {"a =\n1\n", "a line break cannot start a value at line 1, column 4"},
  {"é = 1\n", "'é' cannot start a key at line 1, column 1"},
  {"a = \n", "a line break cannot start a value at line 1, column 5"},
  {"a\n", "a line break after the key a, where '=' should be at line 1, column 2"},
  {"[a]b = 1\n", "'b' after the end of a statement, where the line should end at line 1, column 4"},
  {"a = 01\n", "01 has a leading zero, which only 0 may at line 1, column 5"},
  {"a = -01\n", "-01 has a leading zero, which only 0 may at line 1, column 5"},
  {"a = +00\n", "+00 has a leading zero, which only 0 may at line 1, column 5"},
  {"a = 0_1\n", "0_1 has a leading zero, which only 0 may at line 1, column 5"},
  {"a = 1__0\n", "1__0 is not a number at line 1, column 5"},
  {"a = 1_\n", "1_ is not a number at line 1, column 5"},
  {"a = _1\n", "'_' cannot start a value at line 1, column 5"},
  {"a = +0x1\n", "a sign before +0x1, which only a decimal number may have at line 1, column 5"},
  {"a = -0b1\n", "a sign before -0b1, which only a decimal number may have at line 1, column 5"},
  {"a = 0X1F\n", "0X1F is not a number at line 1, column 5"},
  {"a = 0O7\n", "0O7 is not a number at line 1, column 5"},
  {"a = 0B1\n", "0B1 is not a number at line 1, column 5"},
  {"a = 0x\n", "0x is not a number at line 1, column 5"},
  {"a = 0x_1\n", "0x_1 is not a number at line 1, column 5"},
  {"a = 0o8\n", "0o8 is not a number at line 1, column 5"},
  {"a = 0b2\n", "0b2 is not a number at line 1, column 5"},
  {"a = 0xG\n", "0xG is not a number at line 1, column 5"},
  {"a = 1 2\n", "'2' after the end of a statement, where the line should end at line 1, column 7"},
  {"a = 0x1.5\n", "0x1.5 is not a number at line 1, column 5"},
  {"a = 12a\n", "12a is not a number at line 1, column 5"},
  {"a = ++1\n", "++1 is not a number at line 1, column 5"},
  {"a = 1.\n", "1. needs a digit after its '.' at line 1, column 5"},
  {"a = .1\n", "'.' cannot start a value at line 1, column 5"},
  {"a = 1.e5\n", "1.e5 needs a digit after its '.' at line 1, column 5"},
  {"a = 1e\n", "1e needs digits in its exponent at line 1, column 5"},
  {"a = 1e+\n", "1e+ needs digits in its exponent at line 1, column 5"},
  {"a = 1e_5\n", "1e_5 needs digits in its exponent at line 1, column 5"},
  {"a = 1._5\n", "1._5 needs a digit after its '.' at line 1, column 5"},
  {"a = 1.5_\n", "1.5_ needs a digit after its '.' at line 1, column 5"},
  {"a = 01.5\n", "01.5 has a leading zero, which only 0 may at line 1, column 5"},
  {"a = 1.5.5\n", "1.5.5 is not a number at line 1, column 5"},
  {"a = infinity\n", "infinity is not a number at line 1, column 5"},
  {"a = Inf\n", "'I' cannot start a value at line 1, column 5"},
  {"a = NaN\n", "'N' cannot start a value at line 1, column 5"},
  {"a = 1e5.5\n", "1e5.5 is not a number at line 1, column 5"},
  {"a = -+1.0\n", "-+1.0 is not a number at line 1, column 5"},
  {"a = 1,5\n", "',' after the end of a statement, where the line should end at line 1, column 6"},
  {"a = True\n", "'T' cannot start a value at line 1, column 5"},
  {"a = truee\n", "'e' after the end of a statement, where the line should end at line 1, column 9"},
  {"a = fals\n", "'f' cannot start a value at line 1, column 5"},
  {"a = t\n", "'t' cannot start a value at line 1, column 5"},
  {"a = 2001-02-29\n", "the day 29 is not in 2001-02, which has 28 days at line 1, column 5"},
  {"a = 1979-13-01\n", "the month 13 is not 1 to 12 at line 1, column 5"},
  {"a = 1979-00-01\n", "the month 0 is not 1 to 12 at line 1, column 5"},
  {"a = 1979-04-31\n", "the day 31 is not in 1979-04, which has 30 days at line 1, column 5"},
  {"a = 1979-05-00\n", "the day 0 is not in 1979-05, which has 31 days at line 1, column 5"},
  {"a = 1979-05-27T24:00:00\n", "the hour 24 is not 0 to 23 at line 1, column 5"},
  {"a = 1979-05-27T23:60:00\n", "the minute 60 is not 0 to 59 at line 1, column 5"},
  {"a = 1979-05-27T23:59:60Z\n", "the second 60 is not 0 to 59 at line 1, column 5"},
  {"a = 1979-05-27T07:32Z\n", "a time without its seconds, which TOML 1.0 does not allow at line 1, column 16"},
  {"a = 07:32\n", "a time without its seconds, which TOML 1.0 does not allow at line 1, column 5"},
  {"a = 1979-5-27\n", "a date is written YYYY-MM-DD at line 1, column 5"},
  {"a = 1979-05-7\n", "a date is written YYYY-MM-DD at line 1, column 5"},
  {"a = 79-05-27\n", "79-05-27 is not a number at line 1, column 5"},
  {"a = 1979-05-27T\n", "a time is written HH:MM:SS at line 1, column 16"},
  {"a = 1979-05-27T7:32:00\n", "a time is written HH:MM:SS at line 1, column 16"},
  {"a = 1979-05-27T07:32:00.\n", "a '.' in a time with no digit after it at line 1, column 24"},
  {"a = 1979-05-27T07:32:00+24:00\n", "the offset hour 24 is not 0 to 23 at line 1, column 24"},
  {"a = 1979-05-27T07:32:00+07:60\n", "the offset minute 60 is not 0 to 59 at line 1, column 24"},
  {"a = 1979-05-27T07:32:00+0700\n", "an offset is written +HH:MM or -HH:MM at line 1, column 24"},
  {"a = 1979-05-27T07:32:00+07\n", "an offset is written +HH:MM or -HH:MM at line 1, column 24"},
  {"a = 07:32:00Z\n", "'Z' after the end of a statement, where the line should end at line 1, column 13"},
  {"a = 07:32:00+01:00\n", "'+' after the end of a statement, where the line should end at line 1, column 13"},
  {"a = 1979-05-27 07:32\n", "a time without its seconds, which TOML 1.0 does not allow at line 1, column 16"},
  {"a = 1979-05-27x\n", "'x' after the end of a statement, where the line should end at line 1, column 15"},
  {"a = 1979-05-27T07:32:00ZZ\n", "'Z' after the end of a statement, where the line should end at line 1, column 25"},
  {"a = 25:00:00\n", "the hour 25 is not 0 to 23 at line 1, column 5"},
  {"a = [1, 2\n", "an array that does not close at line 1, column 5"},
  {"a = [1 2]\n", "'2' between the items of an array, where ',' or ']' should be at line 1, column 8"},
  {"a = [,]\n", "',' cannot start a value at line 1, column 6"},
  {"a = [1,,2]\n", "',' cannot start a value at line 1, column 8"},
  {"a = [1 # c ]\n", "an array that does not close at line 1, column 5"},
  {"a = [\n1\n2]\n", "'2' between the items of an array, where ',' or ']' should be at line 3, column 1"},
  {"a = ]\n", "']' cannot start a value at line 1, column 5"},
  {"a = {b = 1\n", "a line break in an inline table, which stays on one line at line 1, column 11"},
  {"a = {b = 1,}\n", "a comma after the last pair of an inline table at line 1, column 12"},
  {"a = {b = 1\n}\n", "a line break in an inline table, which stays on one line at line 1, column 11"},
  {"a = {\nb = 1}\n", "a line break in an inline table, which stays on one line at line 1, column 6"},
  {"a = {b = 1 c = 2}\n", "'c' between the pairs of an inline table, where ',' or '}' should be at line 1, column 12"},
  {"a = {b}\n", "'}' after the key b, where '=' should be at line 1, column 7"},
  {"a = {b = 1, b = 2}\n", "the key b is defined twice at line 1, column 13"},
  {"a = {b.c = 1, b = 2}\n", "the key b is defined twice at line 1, column 15"},
  {"a = {b = {}, b.c = 1}\n", "the inline table b is closed: no header or dotted key adds to it at line 1, column 14"},
  {"a = {b = 1 # c\n}\n", "'#' between the pairs of an inline table, where ',' or '}' should be at line 1, column 12"},
  {"a = {,}\n", "',' cannot start a key at line 1, column 6"},
  {"a = {b = 1}\na.c = 2\n", "the inline table a is closed: no header or dotted key adds to it at line 2, column 1"},
  {"a = {b = 1}\n[a]\n", "the inline table a is closed: no header or dotted key adds to it at line 2, column 2"},
  {"a = {b = 1}\n[a.c]\n", "the inline table a is closed: no header or dotted key adds to it at line 2, column 2"},
  {"a = {b = {c = 1}}\n[a.b.d]\n", "the inline table a is closed: no header or dotted key adds to it at line 2, column 2"},
  {"a = [{b = 1}]\n[[a]]\n", "the array a was written as a value, which no header or dotted key adds to at line 2, column 3"},
  {"a = [{b = 1}]\n[a.c]\n", "the array a was written as a value, which no header or dotted key adds to at line 2, column 2"},
  {"[a\n", "a line break where the header's ] should be at line 1, column 3"},
  {"[a]]\n", "']' after the end of a statement, where the line should end at line 1, column 4"},
  {"[[a]\n", "']' where the header's ]] should be at line 1, column 4"},
  {"[ [a]]\n", "'[' cannot start a key at line 1, column 3"},
  {"[]\n", "']' cannot start a key at line 1, column 2"},
  {"[a.]\n", "']' cannot start a key at line 1, column 4"},
  {"[a b]\n", "'b' where the header's ] should be at line 1, column 4"},
  {"[a] b = 1\n", "'b' after the end of a statement, where the line should end at line 1, column 5"},
  {"[a]\n[a]\n", "the table [a] is declared twice at line 2, column 2"},
  {"[a]\nb = 1\n[a]\n", "the table [a] is declared twice at line 3, column 2"},
  {"[a.b]\n[a]\n[a.b]\n", "the table [a.b] is declared twice at line 3, column 4"},
  {"[a]\nb = 1\n[a.b]\n", "a.b is an integer, not a table at line 3, column 4"},
  {"a = 1\n[a]\n", "a is an integer, not a table at line 2, column 2"},
  {"a = 1\n[a.b]\n", "a is an integer, not a table at line 2, column 2"},
  {"a = []\n[a.b]\n", "the array a was written as a value, which no header or dotted key adds to at line 2, column 2"},
  {"[[a]]\n[a]\n", "[a] names an array of tables, which [[a]] adds to at line 2, column 2"},
  {"[a]\n[[a]]\n", "[[a]] names the table a, not an array of tables at line 2, column 3"},
  {"[a.b]\n[[a]]\n", "[[a]] names the table a, not an array of tables at line 2, column 3"},
  {"a.b = 1\n[a]\n", "[a] declares a table dotted keys made at line 2, column 2"},
  {"a.b.c = 1\n[a.b]\n", "[a.b] declares a table dotted keys made at line 2, column 4"},
  {"[a.b.c]\nz = 9\n[a]\nb.c.t = 9\n", "dotted keys add to the table a.b.c, which a [a.b.c] header declared at line 4, column 3"},
  {"[a.b.c.d]\nz = 9\n[a]\nb.c.d.k.t = 9\n", "dotted keys add to the table a.b.c.d, which a [a.b.c.d] header declared at line 4, column 5"},
  {"[a]\nb.c = 1\n[x]\n[a]\n", "the table [a] is declared twice at line 4, column 2"},
  {"[a.b.c]\n[a]\nb.d = 1\n[a.b]\n", "[a.b] declares a table dotted keys made at line 4, column 4"},
  {"[a]\nb.c = 1\n[a.b]\n", "[a.b] declares a table dotted keys made at line 3, column 4"},
  {"a.b = 1\na.b.c = 2\n", "a.b is an integer, not a table at line 2, column 3"},
  {"a.b = 1\na = 2\n", "the key a is defined twice at line 2, column 1"},
  {"a = 1\na.b = 2\n", "a is an integer, not a table at line 2, column 1"},
  {"[[a]]\nb = 1\n[a]\n", "[a] names an array of tables, which [[a]] adds to at line 3, column 2"},
  {"[[a.b]]\n[a]\nb.c = 1\n", "a.b is an array of tables, which dotted keys do not add to at line 3, column 1"},
  {"[a]\nb = [1]\n[[a.b]]\n", "the array a.b was written as a value, which no header or dotted key adds to at line 3, column 5"},
  {"[[a]]\n[[a.b]]\n[a.b]\n", "[a.b] names an array of tables, which [[a.b]] adds to at line 3, column 4"},
  {"[a]\n[a.b]\nc=1\n[a]\nb.d = 1\n", "the table [a] is declared twice at line 4, column 2"},
]

# Derived types. `Inner` and `Record` derive std/json's and std/yaml's
# too, which is how a type that is all three spells it, and what lets the
# corpus hand Python the same value as JSON.
struct Inner
  getter x : Int32
  getter label : String?

  def initialize(@x : Int32, @label : String?)
  end

  derive serializable, yaml_serializable, toml_serializable
end

struct Record
  getter name : String
  getter tags : Array(String)
  getter weights : Hash(String, Float64)
  getter count : Int64
  getter small : UInt8
  getter big : UInt64
  getter ratio : Float64
  getter flag : Bool
  getter note : String?
  getter inner : Inner
  getter inners : Array(Inner)
  getter maybe : Inner?
  getter matrix : Array(Array(Int32))

  def initialize(@name : String, @tags : Array(String), @weights : Hash(String, Float64), @count : Int64, @small : UInt8, @big : UInt64, @ratio : Float64, @flag : Bool, @note : String?, @inner : Inner, @inners : Array(Inner), @maybe : Inner?, @matrix : Array(Array(Int32)))
  end

  derive serializable, yaml_serializable, toml_serializable
end

struct Stamped
  getter at : TOMLDateTime
  getter days : Array(TOMLDateTime)
  getter extra : Any
  getter by_name : Hash(String, Inner)

  def initialize(@at : TOMLDateTime, @days : Array(TOMLDateTime), @extra : Any, @by_name : Hash(String, Inner))
  end

  derive toml_serializable
end

struct Spot
  getter x : Float64
  getter name : String
  getter note : String?

  derive toml_serializable
end

# Fields with defaults, as the json and yaml exercises' `Listener` has them.
struct Listener
  @port : Int32 = 8080
  @host : String? = "localhost"
  getter port
  getter host
  getter name : String

  derive toml_serializable
end

# Python's tomllib reads each of these first, before any check below can
# stop the program, so a broken copy's differences reach the comparison.
puts "== the spec's own examples"
SPEC_EXAMPLES.each_with_index { |text, i| corpus(text, "spec example #{i + 1}") }
puts "  #{SPEC_EXAMPLES.size} examples from toml.io/en/v1.0.0 read"

puts "== the corpus of every construct"
VALID.each_with_index { |text, i| corpus(text, "corpus document #{i + 1}") }
VALID_EDGES.each_with_index { |text, i| corpus(text, "allowed redefinition edge #{i + 1}") }
puts "  #{VALID.size} documents and #{VALID_EDGES.size} allowed edges read"

puts "== scalars, strings and keys"
doc = reads("a = 1\nb = \"x\"\nc = 1.5\nd = true\n", "scalars")
assert_true(doc["a"].as_i == 1_i64, "an integer")
assert_str("x", doc["b"].as_s, "a string")
assert_true(doc["c"].as_f == 1.5, "a float")
assert_true(doc["d"].as_bool, "a boolean")
assert_true(doc["a"].as_f == 1.0, "an integer widens to a float")
assert_true(doc["c"].as_i?.nil?, "a float is not an integer")
assert_true(Any.new(1) != Any.new(1.0), "1 and 1.0 are different values")
doc = reads(VALID[0], "bare keys")
assert_true(doc["1234"].as_i == 4_i64, "a bare key of digits is a string key")
assert_true(doc["-_-"].as_i == 5_i64, "a bare key of dashes and underscores")
doc = reads(VALID[1], "quoted keys")
assert_true(doc["127.0.0.1"].as_i == 1_i64, "a quoted key with dots is one key")
assert_true(doc["ʎǝʞ"].as_i == 3_i64, "a non-ASCII quoted key")
assert_true(doc["quoted \"value\""].as_i == 5_i64, "a literal key with quotes")
assert_true(doc[""].as_i == 6_i64, "the empty quoted key")
doc = reads(VALID[3], "dotted keys")
assert_true(doc.dig("a", "b", "c").as_i == 1_i64, "a dotted key makes tables")
assert_true(doc.dig("a", "b", "d").as_i == 2_i64, "blanks around the dots")
assert_true(doc.dig("a", "b.c").as_i == 3_i64, "a quoted part with a dot")
assert_true(doc.dig("a", "e").as_i == 4_i64, "a literal part")
assert_true(doc.dig("a", "f").as_i == 5_i64, "an escaped part is the same key as its text")
assert_true(reads(VALID[4], "3.14159")["3"]["14159"].as_s == "pi", "3.14159 is two keys")
assert_true(reads(VALID[5], "escaped key")["\n\té😀"].as_i == 1_i64, "escapes in a key")
assert_str("\b\t\n\f\r\"\\", reads(VALID[8], "escapes")["a"].as_s, "the seven short escapes")
assert_str("\u0000\u001F\u007F\u0080\uFFFF\u{10FFFF}A", reads(VALID[9], "unicode escapes")["a"].as_s, "\\u and \\U escapes")
assert_str("tab\there", reads(VALID[10], "raw tab")["a"].as_s, "a raw tab in a basic string")
assert_str("Roses are red\nViolets are blue", reads(VALID[12], "multi-line")["a"].as_s, "the break after the opening quotes is dropped")
assert_str("CRLF\nlines\n", reads(VALID[13], "CRLF")["a"].as_s, "CRLF inside a multi-line string reads as LF")
assert_str("The quick brown fox jumps over the lazy dog.", reads(VALID[14], "backslash")["a"].as_s, "a line-ending backslash")
assert_str("The quick brown fox jumps over the lazy dog.", reads(VALID[15], "backslash 2")["a"].as_s, "line-ending backslashes up to the closing quotes")
assert_str("xy", reads(VALID[16], "backslash blanks")["a"].as_s, "blanks between a line-ending backslash and the break")
assert_str("xy", reads(VALID[17], "backslash tab CRLF")["a"].as_s, "a tab and a CRLF after a line-ending backslash")
assert_str("Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\".", reads(VALID[20], "fifteen")["a"].as_s, "escaped quotes break up a run")
assert_str("\"This,\" she said, \"is just a pointless statement.\"", reads(VALID[21], "quotes at the ends")["a"].as_s, "a quote just inside each delimiter")
assert_str("\"\"x\"\"", reads(VALID[22], "five quotes")["a"].as_s, "two quotes just inside five")
assert_str("\nkeeps the second line break", reads(VALID[23], "second break")["a"].as_s, "only the first break is dropped")
doc = reads(VALID[26], "literal strings")
assert_str("C:\\Users\\nodejs\\templates", doc["winpath"].as_s, "a literal string keeps backslashes")
assert_str("<\\i\\c*\\s*>", doc["regex"].as_s, "a literal regex")
doc = reads(VALID[28], "literal quotes")
assert_str("'That,' she said, 'is still pointless.'", doc["str"].as_s, "an apostrophe just inside each delimiter")
assert_str("x\ny", reads(VALID[29], "literal CRLF")["a"].as_s, "CRLF inside a multi-line literal string reads as LF")
assert_str("''x''", reads(VALID[31], "literal five")["a"].as_s, "two apostrophes just inside five")
doc = reads(VALID[33], "empty strings")
assert_true(doc["a"].as_s.empty? && doc["b"].as_s.empty? && doc["c"].as_s.empty? && doc["d"].as_s.empty?, "four empty strings")
doc = reads(VALID[34], "hash in a string")
assert_str("#not a comment", doc["a"].as_s, "a '#' inside a string")
puts "  keys bare, quoted and dotted; the four string forms and their escapes"

doc = reads(VALID[35], "integers")
assert_true(doc["int1"].as_i == 99_i64 && doc["int4"].as_i == -17_i64 && doc["int5"].as_i == 0_i64 && doc["int6"].as_i == 0_i64, "signed integers")
doc = reads(VALID[36], "underscores")
assert_true(doc["int6"].as_i == 5349221_i64 && doc["int7"].as_i == 5349221_i64, "underscores between digits")
doc = reads(VALID[37], "radixes")
assert_true(doc["hex1"].as_i == 3735928559_i64 && doc["hex3"].as_i == 3735928559_i64 && doc["hex4"].as_i == 255_i64, "hexadecimal")
assert_true(doc["oct1"].as_i == 342391_i64 && doc["oct2"].as_i == 493_i64, "octal")
assert_true(doc["bin1"].as_i == 214_i64 && doc["bin2"].as_i == 1_i64, "binary")
doc = reads(VALID[38], "limits")
assert_true(doc["max"].as_i == 9223372036854775807_i64, "the largest integer")
assert_true(doc["min"].as_i == -9223372036854775807_i64 - 1_i64, "the smallest integer")
assert_true(doc["hexmax"].as_i == 9223372036854775807_i64 && doc["octmax"].as_i == 9223372036854775807_i64 && doc["binmax"].as_i == 9223372036854775807_i64, "the largest in each radix")
doc = reads(VALID[39], "floats")
assert_true(doc["flt1"].as_f == 1.0 && doc["flt3"].as_f == -0.01 && doc["flt4"].as_f == 5e+22 && doc["flt6"].as_f == -2e-2, "fractions and exponents")
assert_true(doc["flt8"].as_f == 224617.445991228, "underscores in a float")
doc = reads(VALID[40], "special floats")
assert_true(doc["sf1"].as_f > 1.7976931348623157e308 && doc["sf3"].as_f < -1.7976931348623157e308, "inf and -inf")
assert_true(doc["sf4"].as_f != doc["sf4"].as_f && doc["sf6"].as_f != doc["sf6"].as_f, "nan and -nan")
doc = reads(VALID[41], "float edges")
assert_true(IyiFloatText.bits_of(doc["b"].as_f) == 0x8000000000000000_u64, "-0.0 keeps its sign")
assert_true(doc["f"].as_f > 1.7976931348623157e308, "1e400 is infinite, as Python's float reads it")
assert_true(doc["g"].as_f == 5.0e-324, "the smallest subnormal")
assert_true(doc["k"].as_f == 10.01e10, "underscores in every part of a float")
doc = reads(VALID[42], "rounding")
assert_true(doc["a"].as_f == 9007199254740992.0, "2^53 + 1 rounds to even")
assert_true(doc["b"].as_f == 1.0, "a halfway case rounds to even, down")
puts "  integers in four radixes to the Int64 limits; floats correctly rounded, inf and nan"

puts "== dates and times"
doc = reads(VALID[44], "offset date-times")
odt = doc["odt1"].as_datetime
assert_true(odt.offset? && odt.year == 1979 && odt.month == 5 && odt.day == 27 && odt.hour == 7 && odt.minute == 32 && odt.second == 0 && odt.offset_minutes == 0, "1979-05-27T07:32:00Z")
assert_true(doc["odt2"].as_datetime.offset_minutes == -420, "-07:00 is -420 minutes")
assert_true(doc["odt3"].as_datetime.nanosecond == 999999000, "a fraction to the nanosecond")
assert_true(doc["odt4"].as_datetime == odt, "a space between date and time")
assert_true(odt.unix_seconds == 296638320_i64, "1979-05-27T07:32:00Z is 296638320 seconds after the epoch")
assert_true(doc["odt2"].as_datetime.unix_seconds == odt.unix_seconds, "00:32-07:00 is the same instant as 07:32Z")
assert_true(doc["odt2"].as_datetime != odt, "but a different value: the offset is kept")
assert_str("1979-05-27T00:32:00.999999-07:00", doc["odt3"].as_datetime.to_s, "to_s writes RFC 3339")
doc = reads(VALID[45], "offset spellings")
assert_true(doc["odt5"].as_datetime == odt, "lower-case t and z")
assert_true(doc["odt6"].as_datetime == odt && doc["odt7"].as_datetime == odt, "+00:00 and -00:00 are Z")
assert_str("2000-02-29T23:59:59.123456789+23:59", doc["odt8"].as_datetime.to_s, "nine fraction digits and the largest offset")
assert_true(doc["odt9"].as_datetime.unix_seconds == -62135510460_i64, "0001-01-01T00:00:00-23:59 before the epoch")
doc = reads(VALID[46], "local date-times")
assert_true(doc["ldt1"].as_datetime.local_date_time?, "a local date-time")
assert_str("1979-05-27T07:32:00.5", doc["ldt3"].as_datetime.to_s, "a fraction's trailing zeros are not written")
assert_true(doc["ldt4"].as_datetime.nanosecond == 999999999, "digits past the ninth are dropped, not rounded")
doc = reads(VALID[47], "local dates")
assert_true(doc["ld1"].as_datetime.local_date? && doc["ld2"].as_datetime.day == 29, "a local date, 2000-02-29 among them")
assert_str("1979-05-27", doc["ld1"].as_datetime.to_s, "a local date written")
doc = reads(VALID[48], "local times")
assert_true(doc["lt1"].as_datetime.local_time? && doc["lt2"].as_datetime.nanosecond == 999999000, "local times")
assert_str("00:00:00.0000001", doc["lt4"].as_datetime.to_s, "a local time with a seventh fraction digit")
assert_str("an offset date-time", odt.kind_name, "the kind's name")
assert_str("a local time", doc["lt1"].kind_name, "a local time's kind name through Any")
assert_true(TOMLDateTime.local_date(1979, 5, 27) == reads(VALID[47], "again")["ld1"].as_datetime, "a built date equals a read one")
assert_true(TOMLDateTime.offset_date_time(1979, 5, 27, 0, 32, 0, 0, -420).hash == reads(VALID[44], "again")["odt2"].as_datetime.hash, "equal values hash the same")
assert_true(TOMLDateTime.problem(TOMLDateTime::LOCAL_DATE, 2024, 2, 29, 0, 0, 0, 0, 0).nil?, "2024-02-29 is a date")
assert_str("the day 29 is not in 1900-02, which has 28 days", TOMLDateTime.problem(TOMLDateTime::LOCAL_DATE, 1900, 2, 29, 0, 0, 0, 0, 0) || "", "1900 is not a leap year")
assert_str("TOMLDateTime: the day 30 is not in 2023-02, which has 28 days", panic_of(-> { TOMLDateTime.local_date(2023, 2, 30).to_s }), "a constructor refuses a day that is not")
assert_str("TOMLDateTime: a local date names no instant; only an offset date-time has unix seconds", panic_of(-> { TOMLDateTime.local_date(2023, 2, 3).unix_seconds.to_s }), "a local date has no unix seconds")
puts "  four kinds kept apart, offsets kept, fractions to the nanosecond, instants counted"

puts "== tables, arrays of tables, inline tables"
doc = reads(VALID[52], "multi-line arrays")
assert_true(doc["integers3"].size == 2, "a trailing comma and a comment in an array")
doc = reads(VALID[53], "empty arrays")
assert_true(doc["a"].size == 0 && doc["b"][0].size == 0 && doc["c"][1][0].size == 0, "empty and nested empty arrays")
doc = reads(VALID[56], "mixed array")
assert_true(doc["a"].size == 7 && doc["a"][4].as_datetime.local_date? && doc["a"][6]["x"].as_i == 1_i64, "an array of every kind, as TOML 1.0 allows")
doc = reads(VALID[57], "inline tables")
assert_str("Preston-Werner", doc.dig("name", "last").as_s, "an inline table")
assert_str("pug", doc.dig("animal", "type", "name").as_s, "a dotted key inside an inline table")
doc = reads(VALID[59], "array in an inline table")
assert_true(doc.dig("a", "x").size == 3, "an array may break lines inside an inline table")
doc = reads(VALID[66], "super-table after")
assert_true(doc.dig("x", "y", "z", "w").size == 0, "a table declared after its sub-table")
doc = reads(VALID[69], "dotted keys make tables")
assert_true(doc.dig("fruit", "apple", "taste", "sweet").as_bool, "dotted keys make nested tables")
doc = reads(VALID[70], "header into a dotted table")
assert_true(doc.dig("fruit", "apple", "texture", "smooth").as_bool && doc.dig("fruit", "apple", "color").as_s == "red", "a header may add a sub-table to a table dotted keys made")
doc = reads(VALID[80], "arrays of tables")
assert_true(doc["products"].size == 3 && doc["products"][1].size == 0 && doc["products"][2]["color"].as_s == "gray", "[[products]] three times, the middle one empty")
doc = reads(VALID[81], "nested arrays of tables")
assert_true(doc["fruits"].size == 2 && doc["fruits"][0]["varieties"].size == 2 && doc["fruits"][1]["varieties"][0]["name"].as_s == "plantain", "sub-arrays belong to the latest entry")
assert_str("round", doc.dig("fruits", 0, "physical", "shape").as_s, "a sub-table of an array entry")
doc = reads(VALID_EDGES[4], "a sub-table per entry")
assert_true(doc.dig("a", 0, "b", "c").as_i == 1_i64 && doc.dig("a", 1, "b", "c").as_i == 2_i64, "each [[a]] entry has a [a.b] of its own")
doc = reads(VALID_EDGES[1], "dotted keys into an implicit table")
assert_true(doc.dig("a", "b", "d").as_i == 1_i64 && doc.dig("a", "b", "c").size == 0, "dotted keys add to a table a header made on the way")
doc = reads(VALID_EDGES[11], "a quoted dot")
assert_true(doc["a.b"].as_i == 1_i64 && doc.dig("a", "b").as_i == 2_i64, "\"a.b\" and a.b are different keys")
assert_true(reads("", "the empty document").size == 0, "the empty document is an empty table")
assert_true(reads("a = 1", "no final break")["a"].as_i == 1_i64, "a document need not end in a line break")
assert_true(reads("a = 1\r\n[b]\r\nc = 2\r\n", "CRLF")["b"]["c"].as_i == 2_i64, "CRLF line endings")
assert_true(doc.dig?("a", "x", "y").nil? && doc.dig?("nope").nil? && !doc.dig?("a", "b").nil?, "dig? answers nil where nothing is")
assert_true(reads("a = [1]", "index")["a"][5]?.nil?, "[]? past the end of an array is nil")
puts "  headers, dotted keys, inline tables and arrays of tables build the tables they say"

puts "== what the reader refuses"
REFUSALS.each { |pair| refused(pair[0], pair[1]) }
refused("a = \"\xFF\"\n", "the byte 0xFF, which is not UTF-8 at line 1, column 6")
refused("a = \"\xC0\xAF\"\n", "the byte 0xC0, which is not UTF-8 at line 1, column 6")
refused("a = \"\xED\xA0\x80\"\n", "the byte 0xED followed by 0xA0, which is not UTF-8 at line 1, column 6")
refused("a = \"\xF4\x90\x80\x80\"\n", "the byte 0xF4 followed by 0x90, which is not UTF-8 at line 1, column 6")
refused("a = \"\xE2\x82\"", "the byte 0xE2 followed by 0x22, which is not UTF-8 at line 1, column 6")
refused("a = \"\xE2\x82", "a UTF-8 sequence cut short by the end of the document at line 1, column 6")
refused("a = \"\"\"\nok\nbad\u0001\"\"\"\n", "the control character U+0001 in a string, where it must be escaped at line 3, column 4")
refused("a = '''\r\nx\r\ny\ry'''\n", "a carriage return not followed by a line feed at line 3, column 2")
refused("[a]\nb = \"é€😀\" c\n", "'c' after the end of a statement, where the line should end at line 2, column 11")
refused("a = 1\n\"é\" = 1\n\"\\u00e9\" = 2\n", "the key \"é\" is defined twice at line 3, column 1")
own_refusal("a = 9223372036854775808\n", "9223372036854775808 is outside -9223372036854775808 to 9223372036854775807, the TOML integers at line 1, column 5")
own_refusal("a = -9223372036854775809\n", "-9223372036854775809 is outside -9223372036854775808 to 9223372036854775807, the TOML integers at line 1, column 5")
own_refusal("a = 0x8000000000000000\n", "0x8000000000000000 is past 9223372036854775807, the largest TOML integer at line 1, column 5")
own_refusal("a = 0o1000000000000000000000\n", "0o1000000000000000000000 is past 9223372036854775807, the largest TOML integer at line 1, column 5")
own_refusal("a = 0b" + "1" * 64 + "\n", "0b#{"1" * 64} is past 9223372036854775807, the largest TOML integer at line 1, column 5")
own_refusal("a = 99999999999999999999999\n", "99999999999999999999999 is outside -9223372036854775808 to 9223372036854775807, the TOML integers at line 1, column 5")
error = TOML.parse("a = 1\nb = 01\n")
assert_true(error.is_a?(TOMLError) && error.line == 2 && error.column == 5 && error.reason == "01 has a leading zero, which only 0 may", "a TOMLError's line, column and reason")
puts "  #{REFUSALS.size + 10} refusals, each with its line and column; 6 integers past Int64 refused here alone"

puts "== the redefinition rules"
refused("[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple]\n", "[fruit.apple] declares a table dotted keys made at line 5, column 8")
refused("[a.b.c]\nz = 9\n[a]\nb.c.t = 9\n", "dotted keys add to the table a.b.c, which a [a.b.c] header declared at line 4, column 3")
refused("[a]\nb.c = 1\n[x]\n[a]\n", "the table [a] is declared twice at line 4, column 2")
refused("[a]\nb.c = 1\n[x]\n[a.b.d]\nz = 1\n[a]\n", "the table [a] is declared twice at line 6, column 2")
refused("[a.b]\nc.d = 1\n[a]\nb.c.e = 2\n", "dotted keys add to the table a.b, which a [a.b] header declared at line 4, column 1")
refused("[x]\na.b = 1\n[y]\n[x]\n", "the table [x] is declared twice at line 4, column 2")
refused("[x]\na.b = 1\n[x.a.c]\n[x.a]\n", "[x.a] declares a table dotted keys made at line 4, column 4")
refused("a.b = 1\n[c]\n[a.b.d]\n", "a.b is an integer, not a table at line 3, column 4")
refused("t = {a.b = 1, a.b.c = 2}\n", "a.b is an integer, not a table at line 1, column 17")
refused("t = {a = [1], a.b = 2}\n", "the array a was written as a value, which no header or dotted key adds to at line 1, column 15")
refused("[[t]]\na = {}\n[t.a.b]\n", "the inline table t.a is closed: no header or dotted key adds to it at line 3, column 4")
refused("[x.y]\n[x]\n[x]\n", "the table [x] is declared twice at line 3, column 2")
refused("[x.y.z]\n[x]\ny.w = 1\n[x.y]\n", "[x.y] declares a table dotted keys made at line 4, column 4")
doc = reads("[x]\na.b = 1\n[x.a.c]\nd = 1\n", "a header into a dotted table under another header")
assert_true(doc.dig("x", "a", "c", "d").as_i == 1_i64, "[x.a.c] adds to the table dotted keys made under [x]")
doc = reads("a.b.c = 1\na.b.d = 2\na.e = 3\n", "dotted keys share their tables")
assert_true(doc.dig("a", "b").size == 2 && doc.dig("a", "e").as_i == 3_i64, "dotted keys in one section extend each other's tables")
puts "  a table once, a key once, headers and dotted keys kept to their own tables"

puts "== the redefinition rules, fuzzed"
# Documents of two to six statements - `[k]`, `[[k]]` and `k = v` - over
# keys of one to three parts from three names, with values that are
# scalars, inline tables (with and without dotted keys inside) and static
# arrays: every collision of headers, arrays of tables, dotted keys and
# closed values the rules speak of, many times over. Python reads each
# and must accept and refuse exactly what this reader does.
fuzz = Rng.new(0xF022_u64)
fuzz_keys = ["a", "b", "c"]
fuzz_values = ["1", "{}", "{x = 1}", "[]", "[{x = 1}]", "{b.c = 1}"]
accepted = 0
20000.times do
  out = String::Builder.new
  (2 + fuzz.below(5)).times do
    path = (1..(1 + fuzz.below(3))).map { fuzz_keys[fuzz.below(3)] }.join(".")
    r = fuzz.below(4)
    if r == 0
      out << "[" << path << "]\n"
    elsif r == 1
      out << "[[" << path << "]]\n"
    else
      out << path << " = " << fuzz_values[fuzz.below(fuzz_values.size)] << "\n"
    end
  end
  text = out.to_s
  verdict = TOML.parse(text).is_a?(TOMLError) ? 0 : 1
  accepted = accepted + verdict
  puts "FUZZ #{hex(text)}\t#{verdict}"
end
assert_true(accepted > 5000 && accepted < 15000, "the fuzz both accepts and refuses: #{accepted} of 20000 read")
puts "  20000 documents, #{accepted} read and the rest refused"

puts "== random documents in random syntax"
rng = Rng.new(0x70B1_5EED_2026_1017_u64)
documents = 0
bytes = 0
256.times do |n|
  tree = Any.new(gen_table(rng, 0, 1))
  scribe = Scribe.new(rng)
  scribe.section(tree.as_h, [] of String)
  text = scribe.text
  got = TOML.parse(text)
  if got.is_a?(TOMLError)
    raise "ASSERTION FAILED: random document #{n} refused: #{got.message}\n#{text}"
  end
  assert_true(got == tree, "random document #{n} reads to the value it was written from\n#{text}\n#{got.inspect}\n#{tree.inspect}")
  puts "CORPUS #{hex(text)}\t#{canon(tree)}"
  round_trip(tree, "random document #{n}")
  documents = documents + 1
  bytes = bytes + text.bytesize
end
puts "  #{documents} documents, #{bytes} bytes, each read to the value it was written from and dumped back"

puts "== dump round trip"
(SPEC_EXAMPLES + VALID + VALID_EDGES).each_with_index do |text, i|
  round_trip(reads(text, "corpus #{i + 1}"), "corpus #{i + 1}")
end
special = Hash(String, Any).new
special[""] = Any.new("empty key")
special["a b"] = Any.new("\"quoted\" \\ \u0000\u001F\u007F\b\t\n\f\r é 😀 \uFEFF")
special["nan"] = Any.new(0.0 / 0.0)
special["neg"] = Any.new(-1.0 / 0.0)
special["zero"] = Any.new(-0.0)
special["deep"] = Any.new([Any.new([Any.new(Hash(String, Any).new)])])
special["tables"] = Any.new([Any.new(Hash(String, Any).new), Any.new(Hash(String, Any).new)])
special["mixed"] = Any.new([Any.new(Hash(String, Any).new), Any.new(1)])
inner = Hash(String, Any).new
inner["x.y"] = Any.new(TOMLDateTime.offset_date_time(1979, 5, 27, 7, 32, 0, 1, -1439))
special["t"] = Any.new(inner)
dumped = round_trip(Any.new(special), "the special values")
assert_true(dumped.includes?("\"\" = \"empty key\"") && dumped.includes?("nan = nan") && dumped.includes?("neg = -inf") && dumped.includes?("zero = -0.0"), "the empty key, nan, -inf and -0.0 written\n#{dumped}")
assert_true(dumped.includes?("\"a b\" = \"\\\"quoted\\\" \\\\ \\u0000\\u001F\\u007F\\b\\t\\n\\f\\r é 😀 \uFEFF\""), "a string with every control escaped\n#{dumped}")
assert_true(dumped.includes?("[[tables]]") && dumped.includes?("mixed = [{}, 1]") && dumped.includes?("[t]\n\"x.y\" = 1979-05-27T07:32:00.000000001-23:59"), "arrays of tables under headers, mixed arrays inline, quoted keys\n#{dumped}")
assert_str("x = 1\n", TOML.dump(reads("x = 1", "one")), "a one-pair document")
assert_str("", TOML.dump(reads("", "none")), "the empty document")
assert_str("{ a = [1, \"b\", 1.5, true, 07:32:00] }", reads("a = [1, 'b', 1.5, true, 07:32:00]", "inspect").inspect, "inspect writes TOML inline")
assert_str("TOML.dump: a document is a table, not an integer", panic_of(-> { TOML.dump(Any.new(1)) }), "a non-table cannot be a document")
puts "  every document above and the random ones written back to the same value"

puts "== nesting and DEPTH_LIMIT"
deep_array = "a = " + "[" * 64 + "]" * 64 + "\n"
deep_inline = "a = " + "{b = " * 63 + "1" + "}" * 63 + "\n"
deep_dotted = "x." * 63 + "y = 1\n"
deep_header = "[" + (["h"] * 64).join(".") + "]\n"
deep_mixed = "a = " + "[{b = " * 31 + "[1]" + "}]" * 31 + "\n"
said = panic_of(-> {
  checked = 0
  [deep_array, deep_inline, deep_dotted, deep_header, deep_mixed].each do |text|
    v = reads(text, "a document DEPTH_LIMIT deep")
    w = reads(TOML.dump(v), "a deep document's dump")
    raise "ASSERTION FAILED: a deep document's dump reads back equal" unless v == w && v.hash == w.hash
    raise "ASSERTION FAILED: a deep document inspects" if v.inspect.empty?
    checked = checked + 1
  end
  "#{checked} read"
})
assert_str("5 read", said, "five documents DEPTH_LIMIT deep read, compared, hashed, dumped and inspected in a task")
beyond_limit("a = " + "[" * 65 + "]" * 65 + "\n", "a value 65 levels deep, past the 64 this reader nests at line 1, column 69")
beyond_limit("x." * 64 + "y = 1\n", "a value 65 levels deep, past the 64 this reader nests at line 1, column 133")
beyond_limit("[" + (["h"] * 65).join(".") + "]\n", "a header 65 keys deep, past the 64 levels this reader nests at line 1, column 1")
beyond_limit(deep_header + "b = 1\n", "a value 65 levels deep, past the 64 this reader nests at line 2, column 5")
beyond_limit("a = " + "{b = " * 64 + "1" + "}" * 64 + "\n", "a value 65 levels deep, past the 64 this reader nests at line 1, column 325")
said = panic_of(-> {
  text = "a = " + "[" * 100000 + "]" * 100000 + "\n"
  answer = TOML.parse(text)
  answer.is_a?(TOMLError) ? answer.reason : "accepted"
})
assert_str("a value 65 levels deep, past the 64 this reader nests", said, "100,000 nested arrays refused in a task, not a stack overflow")
puts "  64 levels read, compared, hashed, dumped and inspected in a task; 65 refused"

puts "== derive toml_serializable"
rec = Record.new("rec \"one\"", ["a", "b c", ""], {"w" => 1.5, "x y" => -0.0}, -9223372036854775807_i64, 255_u8, 9223372036854775807_u64, 0.1, true, nil,
  Inner.new(1, "in"), [Inner.new(2, nil), Inner.new(3, "three")], Inner.new(4, "maybe"), [[1, 2], [] of Int32, [3]])
text = rec.to_toml
back = Record.from_toml(text)
assert_str(rec.to_json, back.to_json, "a record reads back from its TOML")
assert_str(rec.to_yaml, back.to_yaml, "and the same record's YAML is unchanged by the trip")
assert_true(!text.includes?("note"), "a nil field is left out\n#{text}")
assert_true(text.includes?("[[inners]]") && text.includes?("[inner]") && text.includes?("[maybe]"), "derived fields under headers\n#{text}")
puts "DERIVE #{rec.to_json}\t#{hex(text)}"
rec2 = Record.new("two", [] of String, {} of String => Float64, 0_i64, 0_u8, 0_u64, -1.0e300, false, "a\nnote",
  Inner.new(-1, nil), [] of Inner, nil, [] of Array(Int32))
text2 = rec2.to_toml
assert_str(rec2.to_json, Record.from_toml(text2).to_json, "a record of empties reads back")
puts "DERIVE #{rec2.to_json}\t#{hex(text2)}"
stamped = Stamped.new(TOMLDateTime.offset_date_time(1979, 5, 27, 7, 32, 0, 0, 60), [TOMLDateTime.local_date(2000, 2, 29), TOMLDateTime.local_time(7, 32, 0, 500000000)],
  reads("x = [1, {y = 'z'}]", "an Any field"), {"k" => Inner.new(9, "nine")})
stamped_back = Stamped.from_toml(stamped.to_toml)
assert_true(stamped_back.at == stamped.at && stamped_back.days == stamped.days && stamped_back.extra == stamped.extra && stamped_back.by_name["k"].x == 9, "dates, an Any and a hash of derived values read back")
spot = Spot.from_toml("x = 2\nname = \"s\"\nunknown = [1]\n")
assert_true(spot.x == 2.0 && spot.name == "s" && spot.note.nil?, "an integer widens to a Float64 field, a missing nilable key is nil, an unknown key is passed over")
assert_str("x = 2.0\nname = \"s\"\n", spot.to_toml, "a nil field is not written")
defaults = panic_of(-> {
  missing = Listener.from_toml("name = \"web\"\n")
  "#{missing.port} #{missing.host}"
})
assert_str("8080 localhost", defaults, "missing keys keep their defaults")
listener = Listener.from_toml("name = \"web\"\nport = 9090\nhost = \"example.com\"\n")
assert_true(listener.port == 9090 && listener.host == "example.com", "present keys win over defaults")
assert_str("{\"x\":5,\"label\":\"five\"}", Inner.new(5, "five").to_json, "std/json's derive beside it")
assert_str("x: 5\nlabel: five\n", Inner.new(5, "five").to_yaml, "std/yaml's derive beside it")
assert_str("x = 5\nlabel = \"five\"\n", Inner.new(5, "five").to_toml, "this derive")
assert_true(TOML.from_toml("a = [1, 2]\n", Hash(String, Array(Int32)))["a"] == [1, 2], "from_toml into a hash of arrays")
assert_str("a = [1, 2]\n", TOML.to_toml({"a" => [1, 2]}), "to_toml of a hash")
assert_str("integer 4294967296 out of Int32 range", panic_of(-> { Spot.from_toml("x = 1.0\nname = \"n\"\n").to_toml + TOML.from_toml("a = 4294967296", Hash(String, Int32)).to_s }), "an integer past Int32 is refused")
puts "  records written and read back, beside std/json's and std/yaml's derives"

puts "ALL CHECKS PASSED"
