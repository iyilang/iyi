# One construct the body typing could not type or refused, as the pipeline's
# refusal table reads it. `file` is nil and `line` and `column` are 0 when the
# node has no location. `def_name` is the def whose body was being typed, named
# `Owner#name` inside a type and `name` at top level; nil outside any def.
pub class Refusal
  getter reason : String
  getter file : String?
  getter line : Int32
  getter column : Int32
  getter def_name : String?
  getter node : ASTNode

  def initialize(@reason : String, @file : String?, @line : Int32, @column : Int32, @def_name : String?, @node : ASTNode)
  end
end

# One instantiation whose body typing started with every parameter typed: the
# instantiated clone of the def (`definition`, the value `call_target_defs` holds),
# the receiver (`self_type`, nil at top level) and one argument type per parameter,
# in declaration order. `definition` is the name because `def` is a keyword.
pub class TypedInstance
  getter definition : Def
  getter self_type : Type?
  getter arg_types : Array(Type)

  def initialize(@definition : Def, @self_type : Type?, @arg_types : Array(Type))
  end
end

pub class DispatchTarget
  getter receiver : Type
  getter definition : Def
  getter return_type : Type
  getter arg_types : Array(Type)?

  def initialize(@receiver : Type, @definition : Def, @return_type : Type, @arg_types : Array(Type)? = nil)
  end
end

pub class CallExpansion
  getter target : Def
  getter arguments : Array(ASTNode)

  def initialize(@target : Def, @arguments : Array(ASTNode))
  end
end

# A cached yielded block's caller storage, referenced entry types and flow writes.
# Storage identity keeps a retyped block from reusing writes into an old owner.
pub class BlockFlow
  getter storage : Hash(String, Type)
  getter names : Array(String)
  getter entry : Hash(String, Type)
  getter delta : Hash(String, Type)

  def initialize(@storage : Hash(String, Type), @names : Array(String), @entry : Hash(String, Type), @delta : Hash(String, Type))
  end
end

# One cached instantiation (hosted DefInstance, Call#instantiate): the typed clone of a def
# whose body typing finished, and the type that body evaluates to. A call with the same key takes
# both, so the body is not typed again and the call site records the clone the lowering reads.
# A written block's caller flow must also match before its instance can be reused.
pub class DefInstance
  getter definition : Def
  getter return_type : Type?
  getter block_flow : BlockFlow?

  def initialize(@definition : Def, @return_type : Type?, @block_flow : BlockFlow? = nil)
  end
end

# Instances created while a loop is settling share this ledger across visitors.
pub class SpeculativeEntry
  getter key : String
  getter instance : TypedInstance
  property window_end : Int32
  property dirty : Bool

  def initialize(@key : String, @instance : TypedInstance, @window_end : Int32, @dirty : Bool = false)
  end
end

# A currently instantiated body. The cache entry is installed before the body
# is visited, so a hit on one of these entries identifies a recursive cycle.
pub class RecursiveFrame
  getter key : String?
  getter stack_key : String
  getter definition : Def
  property cyclic : Bool = false
  property estimating : Bool = false
  property estimate : Type? = nil

  def initialize(@key : String?, @definition : Def, @stack_key : String)
  end
end

# Types and call bindings from a speculative body must not survive a re-visit.
pub class RecursiveClear < Visitor
  def initialize(@visitor : MainVisitor)
  end

  def visit_any(node : ASTNode) : Bool
    @visitor.node_types.delete(node)
    @visitor.untyped_reasons.delete(node)
    @visitor.call_target_defs.delete(node)
    @visitor.call_dispatch_targets.delete(node)
    @visitor.call_arguments.delete(node)
    @visitor.call_receivers.delete(node)
    @visitor.lib_call_targets.delete(node)
    if @visitor.reused_expansion?(node)
      if expanded = @visitor.expansions[node]?
        expanded.accept(self)
      end
    end
    true
  end
end

# Locals a written block can read or write, including nested blocks and macro
# expansions. Receiverless calls can represent local reads after expansion.
pub class BlockNames < Visitor
  getter names : Array(String)

  def initialize(@visitor : MainVisitor)
    @names = [] of String
    @seen = Set(String).new
  end

  def add(name : String) : Nil
    unless @seen.includes?(name)
      @seen.add(name)
      @names << name
    end
    nil
  end

  def visit_any(node : ASTNode) : Bool
    return false if node.is_a?(Def) || node.is_a?(FunDef) || node.is_a?(ClassDef) || node.is_a?(ModuleDef) || node.is_a?(LibDef) || node.is_a?(Macro) || node.is_a?(TraitDef) || node.is_a?(ImplDef) || node.is_a?(EnumDef)
    if expanded = @visitor.expansions[node]?
      expanded.accept(self)
      return false
    end
    if node.is_a?(ProcLiteral)
      # A proc's embedded Def is a closure body, unlike an ordinary method.
      node.as(ProcLiteral).def.body.accept(self)
      return false
    elsif node.is_a?(Var)
      add(node.as(Var).name)
    elsif node.is_a?(Call)
      call = node.as(Call)
      add(call.name) if call.obj.nil?
      if macro_expansion = call.expanded
        macro_expansion.accept(self)
        return false
      end
    end
    true
  end
end

pub class SpeculationLedger
  property depth : Int32 = 0
  property taint : Int32 = 0
  getter entries : Array(SpeculativeEntry) = [] of SpeculativeEntry
  getter dirty_keys : Hash(String, Bool) = Hash(String, Bool).new
  getter recursive_frames : Array(RecursiveFrame) = [] of RecursiveFrame
  getter recursive_cache_writes : Array(String) = [] of String
end

# The def a block is written in, and the return values of its body (hosted: a `return` in a
# block leaves the def the block is written in). Lowering reads var_owners to keep lexical slots separate.
pub class BlockOwner
  getter def_node : Def?
  getter return_types : Array(Type?)?
  # iyi: what a `yield` written in the block's body runs: the block of the def the block is
  # written in, with that def's block context and self. Without them the body's own `yield`
  # found the block it sits in and the typing never ended.
  getter call_block : Block?
  getter context_vars : Hash(String, Type)?
  getter yield_nodes : Array(Yield)?
  getter scope : Type?
  getter writer_type : ModuleType?
  getter var_owners : Hash(String, LocalStorage)?
  getter untyped_locals : Hash(String, String)?
  getter jump_proc : Def?
  # Storage belongs to the block, including writes from its nested blocks.
  getter local_storage : LocalStorage
  # Break flow joins the caller only after every yield has been typed.
  getter exits : Array(Hash(String, Type))

  def initialize(@def_node : Def?, @return_types : Array(Type?)?, @call_block : Block? = nil, @context_vars : Hash(String, Type)? = nil, @yield_nodes : Array(Yield)? = nil, @scope : Type? = nil, @writer_type : ModuleType? = nil, @var_owners : Hash(String, LocalStorage)? = nil, @untyped_locals : Hash(String, String)? = nil, @jump_proc : Def? = nil)
    @local_storage = LocalStorage.new(Hash(String, Type).new, Set(String).new, Set(String).new)
    @exits = [] of Hash(String, Type)
  end
end

pub class LocalStorage
  getter unions : Hash(String, Type)
  getter nil_candidates : Set(String)
  getter nil_resets : Set(String)

  def initialize(@unions : Hash(String, Type), @nil_candidates : Set(String), @nil_resets : Set(String))
  end
end

# Port of src/compiler/iyi/semantic/filters.cr: TypeFilters maps each variable
# name to its positive (then) and negative (else) TypeFilterSpec.
pub class TypeFilters
  getter pos : Hash(String, TypeFilterSpec)
  getter neg : Hash(String, TypeFilterSpec)

  def initialize(@pos : Hash(String, TypeFilterSpec) = Hash(String, TypeFilterSpec).new, @neg : Hash(String, TypeFilterSpec) = Hash(String, TypeFilterSpec).new)
  end

  def self.single(name : String, spec : TypeFilterSpec) : TypeFilters
    f = TypeFilters.new
    f.pos[name] = spec
    f.neg[name] = TypeFilter.negate(spec)
    f
  end

  def self.truthy(name : String) : TypeFilters
    single(name, TypeFilterSpec.new("truthy"))
  end

  def self.and_spec(s1 : TypeFilterSpec?, s2 : TypeFilterSpec?) : TypeFilterSpec?
    if a = s1
      if b = s2
        return a if a == b
        return TypeFilterSpec.new("and", nil, "", a, b)
      end
      return a
    end
    s2
  end

  def self.or_spec(s1 : TypeFilterSpec?, s2 : TypeFilterSpec?) : TypeFilterSpec?
    if a = s1
      if b = s2
        return a if a == b
        return TypeFilterSpec.new("or", nil, "", a, b)
      end
    end
    nil
  end

  def self.and_filters(f1 : TypeFilters?, f2 : TypeFilters?) : TypeFilters?
    return nil if f1.nil? && f2.nil?
    nf = TypeFilters.new
    common_keys(f1, f2).each do |name|
      p1 = f1 ? f1.as(TypeFilters).pos[name]? : nil
      p2 = f2 ? f2.as(TypeFilters).pos[name]? : nil
      if pf = and_spec(p1, p2)
        nf.pos[name] = pf
      end
      n1 = f1 ? f1.as(TypeFilters).neg[name]? : nil
      n2 = f2 ? f2.as(TypeFilters).neg[name]? : nil
      if negf = or_spec(n1, n2)
        nf.neg[name] = negf
      end
    end
    nf
  end

  def self.or_filters(f1 : TypeFilters?, f2 : TypeFilters?) : TypeFilters?
    return nil if f1.nil? && f2.nil?
    nf = TypeFilters.new
    common_keys(f1, f2).each do |name|
      p1 = f1 ? f1.as(TypeFilters).pos[name]? : nil
      p2 = f2 ? f2.as(TypeFilters).pos[name]? : nil
      if pf = or_spec(p1, p2)
        nf.pos[name] = pf
      end
      n1 = f1 ? f1.as(TypeFilters).neg[name]? : nil
      n2 = f2 ? f2.as(TypeFilters).neg[name]? : nil
      if negf = and_spec(n1, n2)
        nf.neg[name] = negf
      end
    end
    nf
  end

  def self.invert(f : TypeFilters?) : TypeFilters?
    return nil if f.nil?
    filters = f.as(TypeFilters)
    TypeFilters.new(filters.neg.dup, filters.pos.dup)
  end

  def self.assign_var(filters : TypeFilters?, name : String) : TypeFilters
    return truthy(name) if filters.nil?
    spec = TypeFilterSpec.new("truthy")
    nf = filters.as(TypeFilters).dup
    if pf = and_spec(nf.pos[name]?, spec)
      nf.pos[name] = pf
    end
    if negf = and_spec(nf.neg[name]?, TypeFilter.negate(spec))
      nf.neg[name] = negf
    end
    nf
  end

  def dup : TypeFilters
    TypeFilters.new(@pos.dup, @neg.dup)
  end

  def self.common_keys(f1 : TypeFilters?, f2 : TypeFilters?) : Array(String)
    keys = [] of String
    if a = f1
      a.pos.each_key { |k| keys << k unless keys.includes?(k) }
      a.neg.each_key { |k| keys << k unless keys.includes?(k) }
    end
    if b = f2
      b.pos.each_key { |k| keys << k unless keys.includes?(k) }
      b.neg.each_key { |k| keys << k unless keys.includes?(k) }
    end
    keys
  end
end

# iyi: two modes. Strict (the default) raises on the first construct it cannot
# type, as the port always did, and every existing gate relies on that. Total
# (`total = true`, the typed dump's mode) records the reason on the node that
# cannot be typed and goes on, so one unsupported construct costs its own nodes
# and not the file. A node with no type is never printed as typed, so it never
# counts as matched.
pub class MainVisitor < TypeNodeHost
  property program : SemanticProgram
  property current_type : ModuleType
  property scope : Type?
  property vars : Hash(String, Type)
  # Only while typing a generic module's initializer: module parameters may
  # differ from the allocating class's own parameters.
  property initializer_type_vars : Hash(String, Type)? = nil
  property node_types : NodeMap(Type)
  property untyped_reasons : NodeMap(String)
  property call_target_defs : NodeMap(Def)
  property call_dispatch_targets : NodeMap(Array(DispatchTarget))
  property call_arguments : NodeMap(Array(ASTNode))
  property current_def : Def?
  property super_barrier : String? = nil
  property current_call_block : Block?
  property current_block_context_vars : Hash(String, Type)?
  property current_yield_nodes : Array(Yield)?
  property total : Bool = false
  property in_type_args : Int32 = 0
  # The depth of branches being typed that the type filters left unreachable (a branch whose condition narrowed a
  # variable to nothing). The hosted pass types them too, with what depends on the narrowed variable left without a
  # type, and never reports that: an untyped node there is no error. So nothing in them raises or is recorded.
  property dead_depth : Int32 = 0
  # Raised by visit(If) when nothing after it can run: the typing narrowed the variable of one branch away, and the
  # other ends the flow. The list the `if` stands in types the rest of its statements as an unreachable branch.
  property flow_dead : Bool = false
  # The instantiations whose body typing is in progress, by key (receiver, def
  # name, argument types). A key typed again is a recursive call: it takes the
  # declared return type, or is refused. Shared with a fun body's visitor.
  property typing_stack : Array(String)
  # Every refusal recorded, in order (see Refusal). Shared with a fun body's visitor.
  property refusals : Array(Refusal)
  # Optional live event stream for a probe that may be interrupted.
  property refusal_stream : IyiIO? = nil
  property speculation : SpeculationLedger
  # Every instantiation whose body typing started with all its parameters typed,
  # in order (see TypedInstance). Shared with a fun body's visitor.
  property typed_instances : Array(TypedInstance)
  # Every finished instantiation by its key (see def_instance_key). Shared with a fun body's visitor.
  property def_instances : Hash(String, DefInstance)
  # Per-concrete-type initializers, shared by every visitor typing this program.
  property instance_var_initializer_lists : Hash(UInt64, Array(InstanceVarInitializer))

  # The values the body being typed returns (`return`), and the values a `break` (of the call
  # whose block it is) and a `next` (of that block) carry while they are collected. nil where
  # none is collected; a nil entry is a value with no type.
  property return_types : Array(Type?)? = nil
  property break_types : Array(Type?)? = nil
  property next_types : Array(Type?)? = nil
  # The break values of each block's call, and the def and return list each block is written in.
  property block_breaks : NodeMap(Array(Type?)) = NodeMap(Array(Type?)).new
  property block_owners : NodeMap(BlockOwner) = NodeMap(BlockOwner).new
  # Jump boundaries are AST identities, not the value-collection stacks.
  property jump_block_calls : NodeMap(Call) = NodeMap(Call).new
  property jump_block : Block? = nil
  # A yielded next joins the call's entry flow; breaks wait until the call ends.
  # Scratch block typing leaves both unset.
  property jump_block_context : Hash(String, Type)? = nil
  property jump_block_exits : Array(Hash(String, Type))? = nil
  # A captured block's `next` returns from its proc when no inner jump boundary applies.
  # Keep this separate from current_def, which carries the writer's lookup bindings.
  property jump_proc : Def? = nil
  property jump_whiles : Array(While) = [] of While
  property block_may_repeat : Bool = false
  # The record of each call on a lib (see visit_lib_call): the fun, the result type and the
  # arguments the lowering passes.
  property lib_call_targets : NodeMap(LibCallTarget) = NodeMap(LibCallTarget).new
  # The expanded tree of each literal the hosted pass keeps (node.expanded).
  # Lowering reads this map the same way it reads lib_call_targets. The typed
  # dump prints nothing from it.
  property expansions : NodeMap(ASTNode) = NodeMap(ASTNode).new
  # The constant each path names in its lexical scope (hosted Path#target_const,
  # main_visitor.cr:235). Lowering reads this binding instead of resolving it again.
  property target_consts : NodeMap(Const) = NodeMap(Const).new
  property call_receivers : NodeMap(Type) = NodeMap(Type).new
  property type_filters : TypeFilters? = nil
  property needs_type_filters : Int32 = 0
  property unreachable : Bool = false
  # A filter can leave a variable no type, making its guarded branch impossible.
  property narrowed_out : Bool = false
  property while_break_vars : Array(Array(Hash(String, Type))) = [] of Array(Hash(String, Type))
  property while_next_vars : Array(Array(Hash(String, Type))) = [] of Array(Hash(String, Type))
  # Assignment types visible from each enclosing handler's ensure.
  property handler_vars : Array(Hash(String, Type)) = [] of Hash(String, Type)
  property handler_writes : Array(Set(String)) = [] of Set(String)
  property handler_inside_ensure : Bool = false
  property handler_inside_defer : Bool = false
  property handler_direct_exit : Bool = false

  def handler_defer_exit(node : ASTNode, keyword : String) : Bool
    refuse(node, "`#{keyword}` can't leave a `defer`\n\nA `defer` runs while its scope is already being left, by a return, by `!`, or by a panic, so its cleanup has no answer of its own to give and nowhere to jump to. Let it run to its end, and answer from the scope. See SPEC.md III.1.4.")
  end

  def handler_assign(name : String, type : Type) : Nil
    @handler_writes.each { |writes| writes.add(name) }
    unless @handler_vars.empty?
      vars = @handler_vars.last
      if old = vars[name]?
        vars[name] = @program.type_merge(old, type)
      else
        vars[name] = type
      end
    end
    nil
  end

  def needs_type_filters? : Bool
    @needs_type_filters > 0
  end

  def visit_any(node : ASTNode) : Bool
    @unreachable = false
    true
  end

  def type_args_depth : Int32
    @in_type_args
  end

  # The analysed signature of each fun, keyed by its FunDef node: argument types
  # in declared order and the declared return type. The lowering reads them.
  property fun_arg_types_by_node : NodeMap(Array(Type)) = NodeMap(Array(Type)).new
  property matched_call_args : NodeMap(Array(Type)) = NodeMap(Array(Type)).new
  property fun_return_types_by_node : NodeMap(Type) = NodeMap(Type).new

  def record_fun_signature(node : FunDef, arg_types : Array(Type), return_type : Type?) : Nil
    @fun_arg_types_by_node[node] = arg_types
    if rt = return_type
      @fun_return_types_by_node[node] = rt
    end
    nil
  end

  def fun_arg_types(node : FunDef) : Array(Type)?
    @fun_arg_types_by_node[node]?
  end

  def fun_return_type(node : FunDef) : Type?
    @fun_return_types_by_node[node]?
  end

  # The union of the types each variable of the body being typed is assigned, keyed
  # by name; `def_var_unions` keeps it per instantiated def (the lowering's storage type).
  property var_unions : Hash(String, Type)
  property def_var_unions : NodeMap(Hash(String, Type))
  property nil_candidates : Set(String)
  property nil_resets : Set(String)
  property def_nil_resets : NodeMap(Set(String))
  property var_owners : Hash(String, LocalStorage)
  # The free variables of each instantiated def as its call's arguments bound them (hosted
  # MatchContext free_vars), kept per def: a macro site in the body names them (def_inline_bindings).
  property def_free_types : NodeMap(Hash(String, Type))
  # The locals of the body being typed whose value has no type, by name, with the
  # reason their reads are reported with. Saved and restored per body.
  property untyped_locals : Hash(String, String)
  property fun_inline_file : String?
  @literal_expander : LiteralExpander

  def initialize(@program : SemanticProgram, @speculation : SpeculationLedger = SpeculationLedger.new)
    @program.resolve_deferred_class_vars
    @literal_expander = LiteralExpander.new(@program.normalizer)
    # The generated `new` methods are completed before any body is typed: the
    # declarations pass has recorded the expansions, and this consumes them (idempotent).
    define_new_methods(@program)
    @current_type = @program
    @scope = nil
    @vars = Hash(String, Type).new
    @node_types = NodeMap(Type).new
    @untyped_reasons = NodeMap(String).new
    @call_target_defs = NodeMap(Def).new
    @call_dispatch_targets = NodeMap(Array(DispatchTarget)).new
    @call_arguments = NodeMap(Array(ASTNode)).new
    @var_unions = Hash(String, Type).new
    @def_var_unions = NodeMap(Hash(String, Type)).new
    @nil_candidates = Set(String).new
    @nil_resets = Set(String).new
    @def_nil_resets = NodeMap(Set(String)).new
    @var_owners = Hash(String, LocalStorage).new
    @def_free_types = NodeMap(Hash(String, Type)).new
    @untyped_locals = Hash(String, String).new
    @current_def = nil
    @fun_inline_file = nil
    @current_call_block = nil
    @current_block_context_vars = nil
    @current_yield_nodes = nil
    @typing_stack = [] of String
    @refusals = [] of Refusal
    @typed_instances = [] of TypedInstance
    @def_instances = Hash(String, DefInstance).new
    @instance_var_initializer_lists = Hash(UInt64, Array(InstanceVarInitializer)).new
  end

  def set_type(node : ASTNode, type : Type) : Type
    if type.is_a?(UnresolvedType)
      untyped(node, "undefined constant #{type.name}")
      return type
    end
    @node_types[node] = type
    type
  end

  def type_of?(node : ASTNode) : Type?
    @node_types[node]?
  end

  def type_of(node : ASTNode) : Type
    if t = @node_types[node]?
      t
    else
      raise("BUG: node has no type: #{node.to_s}")
    end
  end

  # The type of a node a visit has already visited. Strict mode raises when it
  # has none: the reason the node was refused when there is one, else a BUG. Total
  # mode returns nil and the caller leaves its own node untyped. So does a branch the
  # type filters made unreachable: what depends on the variable they narrowed away has
  # no type, and the branch is never run.
  def child_type(node : ASTNode) : Type?
    if t = @node_types[node]?
      return t
    end
    unless @total || @speculation.depth > 0 || @dead_depth > 0
      if reason = @untyped_reasons[node]?
        raise(reason)
      end
      raise("BUG: node has no type: #{node.to_s}")
    end
    nil
  end

  # The reason a node could not be typed. Total mode records it and returns
  # false, so a visit can end with `return untyped(node, "...")`. An unreachable
  # branch records nothing: what it cannot type is not a refusal.
  def untyped(node : ASTNode, reason : String) : Bool
    @untyped_reasons[node] = reason
    record_refusal(node, reason) if @dead_depth == 0
    false
  end

  # A construct the port refuses. Strict mode raises the message (the program's
  # error, as before); total mode records it on the node. An unreachable branch
  # answers false and records nothing.
  def refuse(node : ASTNode, message : String) : Bool
    if @dead_depth > 0
      @untyped_reasons[node] = message
      return false
    end
    record_refusal(node, message)
    raise(message) unless @total || @speculation.depth > 0
    @untyped_reasons[node] = message
    false
  end

  # Appends one Refusal for `node`: the reason, the node's file, line and column
  # (0 when it has no location), and the def whose body was being typed, named
  # `Owner#name` inside a type and `name` at top level.
  def record_refusal(node : ASTNode, reason : String) : Nil
    file : String? = nil
    line = 0
    column = 0
    if loc = node.location
      file = loc.filename
      line = loc.line_number
      column = loc.column_number
    end
    def_name : String? = nil
    if cd = @current_def
      def_name = cd.name
      if owner = @scope
        unless owner.is_a?(SemanticProgram)
          def_name = "#{owner.full_name}##{cd.name}"
        end
      end
    end
    if stream = @refusal_stream
      site = "#{file || "<no location>"}:#{line}:#{column}"
      stream.puts("record\t#{@refusals.size}\t#{site.inspect}\t#{(def_name || "<top level>").inspect}\t#{reason.inspect}\t#{@speculation.depth}\t#{@speculation.recursive_frames.size}\t#{node.node_id}")
      stream.flush
    end
    @refusals << Refusal.new(reason, file, line, column, def_name, node)
    @speculation.taint = @speculation.taint + 1
    nil
  end

  # A speculative pass can discard refusals it emitted. The log records the
  # same truncation so a reader can reconstruct the live refusal list.
  def truncate_refusals(mark : Int32) : Nil
    if stream = @refusal_stream
      stream.puts("rollback\t#{mark}")
      stream.flush
    end
    @refusals.truncate(0, mark)
    nil
  end

  # The type a declared type names, or nil when it names none. A declared type never
  # raises here (the trunk's lookup raises on an unresolved name): the caller records
  # the refusal on its node. Generic receivers bind their type parameters as lookup_under does.
  def lookup_declared?(node : ASTNode, owner : Type?) : Type?
    if @current_def.nil?
      if bindings = @initializer_type_vars
        found = ArgRestriction.lookup_free(type_node_system(@program), @current_type, node, owner, bindings)
        return found.as(Type) unless found.is_a?(LookupError)
      end
    end
    if instance = current_module_instance(owner)
      found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, instance)
      return found.as(Type) unless found.is_a?(LookupError)
    end
    if receiver_instance(owner).nil?
      return @program.lookup_type_node?(node, @current_type)
    end
    found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, owner)
    return found.as(Type) unless found.is_a?(LookupError)
    nil
  end

  # The name a declared type is refused by: the base of a generic.
  def declared_base_name(node : ASTNode) : String
    if node.is_a?(Generic)
      return node.as(Generic).name.to_s
    end
    node.to_s
  end

  def untyped_reason?(node : ASTNode) : String?
    @untyped_reasons[node]?
  end

  def target_def?(call : Call) : Def?
    @call_target_defs[call]?
  end

  # Nil when the path names a type rather than a constant.
  def target_const?(path : Path) : Const?
    @target_consts[path]?
  end

  def call_receiver?(call : Call) : Type?
    @call_receivers[call]?
  end

  def dispatch_targets?(call : Call) : Array(DispatchTarget)?
    @call_dispatch_targets[call]?
  end

  # The lib call record of a call on a lib (see visit_lib_call), keyed by the call node: the fun,
  # the argument nodes, and the literal and out information the lowering needs. Nil for any other call.
  def lib_call_target?(call : Call) : LibCallTarget?
    @lib_call_targets[call]?
  end

  # The generic instance a body or signature is typed under: the receiver, or the
  # instance a metaclass stands for (`Pointer(UInt64).new` binds `T` to UInt64).
  def receiver_instance(owner : Type?) : GenericInstanceType?
    o : Type? = owner
    if o.is_a?(MetaclassType)
      o = o.as(MetaclassType).instance_type
    end
    if o.is_a?(GenericInstanceType)
      return o.as(GenericInstanceType)
    end
    nil
  end

  # Hosted type_lookup.cr:189-208 reads an associated answer from the
  # receiver's instantiated trait ancestor.
  def trait_instance(owner : Type, trait_type : Type, seen : Set(String)) : GenericTraitInstanceType?
    current = owner
    current = current.as(VirtualType).base_type if current.is_a?(VirtualType)
    current = current.as(MetaclassType).instance_type if current.is_a?(MetaclassType)
    return nil if seen.includes?(current.full_name)
    seen.add(current.full_name)
    if current.is_a?(GenericTraitInstanceType) && current.as(GenericTraitInstanceType).generic_type == trait_type
      return current.as(GenericTraitInstanceType)
    end
    parents = if current.is_a?(GenericInstanceType)
                current.as(GenericInstanceType).parents
              elsif current.is_a?(ModuleType)
                current.as(ModuleType).parents
              else
                [] of Type
              end
    parents.each do |parent|
      if found = trait_instance(parent, trait_type, seen)
        return found
      end
    end
    nil
  end

  def current_trait_instance(owner : Type?) : GenericTraitInstanceType?
    return nil if owner.nil?
    if cd = @current_def
      if defining = @program.def_owner(cd)
        if defining.is_a?(GenericTraitType)
          return trait_instance(owner.as(Type), defining, Set(String).new)
        end
      end
    end
    nil
  end

  # A method written in an included generic module binds that module's
  # parameters, even when the receiver is a different generic class.
  def included_module_instance(owner : Type, wanted : Type, seen : Set(UInt64)) : GenericModuleInstanceType?
    current = owner
    current = current.as(VirtualType).base_type if current.is_a?(VirtualType)
    current = current.as(MetaclassType).instance_type if current.is_a?(MetaclassType)
    return nil if seen.includes?(current.object_id)
    seen.add(current.object_id)
    if current.is_a?(GenericModuleInstanceType)
      instance = current.as(GenericModuleInstanceType)
      return instance if instance.generic_type.object_id == wanted.object_id
    end
    parents = if current.is_a?(GenericInstanceType)
                current.as(GenericInstanceType).parents
              elsif current.is_a?(ModuleType)
                current.as(ModuleType).parents
              else
                [] of Type
              end
    parents.each do |parent|
      if found = included_module_instance(parent, wanted, seen)
        return found
      end
    end
    nil
  end

  def current_module_instance(owner : Type?) : GenericModuleInstanceType?
    return nil if owner.nil?
    if cd = @current_def
      if defining = @program.def_owner(cd)
        if defining.is_a?(GenericModuleType)
          return included_module_instance(owner.as(Type), defining, Set(UInt64).new)
        end
      end
    end
    nil
  end

  # The type a type node names under `owner`. A generic instance binds its type
  # parameter names to its type arguments (`T` is UInt64 in Pointer(UInt64)), and a
  # generic written with those names (`Pointer(T)`) is instantiated, as the hosted
  # MatchContext does. Anything else is the lexical lookup from the current type.
  def lookup_under(node : ASTNode, owner : Type?) : Type
    # Hosted type_lookup.cr:49,430-447 resolves Self against the receiver's
    # instance type, including when the method itself runs on its metaclass.
    if node.is_a?(Self)
      if o = owner
        return o.as(MetaclassType).instance_type if o.is_a?(MetaclassType)
        return o.as(Type) unless o.is_a?(SemanticProgram)
      end
    end
    if @current_def.nil?
      if bindings = @initializer_type_vars
        found = ArgRestriction.lookup_free(type_node_system(@program), @current_type, node, owner, bindings)
        return found.as(Type) unless found.is_a?(LookupError)
      end
    end
    if instance = current_trait_instance(owner)
      found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, instance)
      return found.as(Type) unless found.is_a?(LookupError)
    end
    if cd = @current_def
      if bound = @def_free_types[cd]?
        found = ArgRestriction.lookup_free(type_node_system(@program), @current_type, node, owner, bound)
        return found.as(Type) unless found.is_a?(LookupError)
      end
    end
    if instance = current_module_instance(owner)
      found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, instance)
      return found.as(Type) unless found.is_a?(LookupError)
    end
    if instance = receiver_instance(owner)
      found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, instance)
      return found.as(Type) unless found.is_a?(LookupError)
    end
    if quiet = @program.lookup_type_node?(node, @current_type)
      return TypeQueries.virtual_type(quiet)
    end
    TypeQueries.virtual_type(@program.lookup_type_node(node, @current_type))
  end

  # iyi: a class variable that is replaced keeps the @[ThreadLocal] flag of the one it replaces
  # (hosted types.cr 1265: var.thread_local = class_var.thread_local?).
  def replace_class_var(mod_type : ModuleType, name : String, mv : MetaTypeVar) : Nil
    if old = mod_type.class_vars[name]?
      mv.thread_local = old.thread_local
    end
    mod_type.class_vars[name] = mv
    nil
  end

  def type_from_literal_kind(kind : NumberKind) : Type
    case kind
    when NumberKind::I8   then @program.types["Int8"]
    when NumberKind::I16  then @program.types["Int16"]
    when NumberKind::I32  then @program.int32_type
    when NumberKind::I64  then @program.types["Int64"]
    when NumberKind::I128 then @program.types["Int128"]
    when NumberKind::U8   then @program.types["UInt8"]
    when NumberKind::U16  then @program.types["UInt16"]
    when NumberKind::U32  then @program.types["UInt32"]
    when NumberKind::U64  then @program.types["UInt64"]
    when NumberKind::U128 then @program.types["UInt128"]
    when NumberKind::F32  then @program.types["Float32"]
    when NumberKind::F64  then @program.types["Float64"]
    else
      @program.int32_type
    end
  end

  def visit(node : NilLiteral) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Macro) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # iyi: the `module` header the parser leaves as the file's first statement. The
  # hosted tree has no such node (its parser makes the ModuleDef alone, parser.cr
  # 349-402), so the header is typed nothing, recorded nothing, and not walked.
  def visit(node : ModuleHeader) : Bool
    false
  end

  # iyi: an argument of a def, block or enum member. The hosted pass skips it
  # (semantic_visitor.cr: "Arg nodes are also used for Enum constants"): it is
  # neither typed nor walked.
  def visit(node : Arg) : Bool
    false
  end

  # iyi: declarations the hosted base visitor types as nil without walking them
  # (semantic_visitor.cr 1861-1911).
  def visit(node : ImportDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : UsingDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Extend) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Include) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # The declarations pass has already loaded the required file.
  def visit(node : Require) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Alias) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : AnnotationDef) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : LibDef) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : AssocTypeDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # Impl declarations are already registered; only their body is visited here.
  def visit(node : ImplDef) : Bool
    node.body.accept(self)
    set_type(node, @program.nil_type)
    false
  end

  # iyi: the visibility modifier types what it modifies and is nil itself. A call
  # with no expansion is refused, as the hosted pass refuses it.
  def visit(node : VisibilityModifier) : Bool
    exp = node.exp
    exp.accept(self)
    if exp.is_a?(Call) && exp.expanded.nil?
      return refuse(node, "can't apply visibility modifier")
    end
    set_type(node, @program.nil_type)
    false
  end

  # Hosted semantic_visitor.cr:1943-1961 and 2202-2226 expand a site wherever
  # it is visited, retain the expansion and type the site from that tree.
  def visit(node : MacroIf) : Bool
    if saved = InlineMacroLedger.sites(node).first?
      if reason = saved.reason
        return refuse(node, "macro control expansion: #{reason}")
      end
    end
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        if reason = InlineMacroLedger.sites.last.reason
          return untyped(node, "macro control expansion: #{reason}")
        end
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroFor) : Bool
    if saved = InlineMacroLedger.sites(node).first?
      if reason = saved.reason
        return refuse(node, "macro control expansion: #{reason}")
      end
    end
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        if reason = InlineMacroLedger.sites.last.reason
          return untyped(node, "macro control expansion: #{reason}")
        end
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroExpression) : Bool
    if saved = InlineMacroLedger.sites(node).first?
      if reason = saved.reason
        return refuse(node, "macro control expansion: #{reason}")
      end
    end
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        if reason = InlineMacroLedger.sites.last.reason
          return untyped(node, "macro control expansion: #{reason}")
        end
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroVerbatim) : Bool
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        if reason = InlineMacroLedger.sites.last.reason
          return untyped(node, "macro control expansion: #{reason}")
        end
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroLiteral) : Bool
    false
  end

  # Literal trees are reused across loop passes, yields and recursive retyping.
  def reused_expansion?(node : ASTNode) : Bool
    node.is_a?(ArrayLiteral) || node.is_a?(HashLiteral) || node.is_a?(RangeLiteral) || node.is_a?(StringInterpolation) || node.is_a?(And) || node.is_a?(Or) || node.is_a?(Case) || node.is_a?(Select) || node.is_a?(MultiAssign)
  end

  # Expand once per node, as hosted does in its single visit. Retyping walks
  # the same tree without allocating new temporaries or rewriting literals.
  def expand_literal(node : ASTNode) : Bool
    tree = @expansions[node]?
    if tree.nil?
      tree = node.transform(@literal_expander)
      @expansions[node] = tree
    end
    tree.accept(self)
    if et = child_type(tree)
      set_type(node, et)
    end
    false
  end

  def visit(node : ArrayLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : HashLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : RangeLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : StringInterpolation) : Bool
    expand_literal(node)
  end

  def visit(node : And) : Bool
    expand_literal(node)
  end

  def visit(node : Or) : Bool
    expand_literal(node)
  end

  def visit(node : Case) : Bool
    expand_literal(node)
  end

  def visit(node : Select) : Bool
    expand_literal(node)
  end

  # A multiple assignment is expanded before it is typed, as the hosted pass does
  # (main_visitor.cr 3736): its targets are assigned from temporaries.
  def visit(node : MultiAssign) : Bool
    expand_literal(node)
  end

  # iyi: an annotation is a sibling of the def it annotates, not an expression.
  # The hosted pass does not type or walk it, so neither does the port; the
  # primitive name is read from the Annotation by the lowering (S2d owns that).
  def visit(node : Annotation) : Bool
    false
  end

  # Returns the local variable name if `exp` is a local variable read or
  # assignment to one (hosted MainVisitor#get_expression_var).
  def expression_var_name(exp : ASTNode) : String?
    if exp.is_a?(Var)
      return exp.as(Var).name
    elsif exp.is_a?(Assign)
      t = exp.as(Assign).target
      return t.as(Var).name if t.is_a?(Var)
    elsif exp.is_a?(Expressions)
      exps = exp.as(Expressions).expressions
      return expression_var_name(exps[0]) if exps.size == 1
    elsif exp.is_a?(Call)
      c = exp.as(Call)
      if c.obj.nil? && c.args.empty? && c.block.nil? && @vars.has_key?(c.name)
        return c.name
      end
    end
    nil
  end

  # iyi: `x.is_a?(T)` and `x.nil?` are Bool and record a SimpleTypeFilter
  # when the enclosing condition requests type filters (hosted main_visitor.cr 2251-2284).
  def visit(node : IsA) : Bool
    node.obj.accept(self)
    @in_type_args = @in_type_args + 1
    saved_ntf = @needs_type_filters
    @needs_type_filters = 0
    node.const.accept(self)
    @needs_type_filters = saved_ntf
    @in_type_args = @in_type_args - 1
    set_type(node, @program.bool_type)
    @type_filters = nil
    if node.const.is_a?(Path)
      if resolved = @program.lookup_type_path?(node.const.as(Path), @current_type)
        if resolved.const?
          comparison = Call.new(node.const.clone, "===", [node.obj.clone] of ASTNode)
          comparison.accept(self)
          @expansions[node] = comparison
          return false
        end
      end
    end
    if needs_type_filters?
      is_const = false
      if node.const.is_a?(Path)
        if pt = @program.lookup_type_path?(node.const.as(Path), @current_type)
          is_const = true if pt.const?
        end
      end
      unless is_const
        if vname = expression_var_name(node.obj)
          if target = child_type(node.const)
            @type_filters = TypeFilters.single(vname, TypeFilterSpec.new("is_a", target))
          end
        end
      end
    end
    false
  end

  # iyi: `!x` is Bool and inverts its operand's type filters (hosted main_visitor.cr 3757).
  def visit(node : Not) : Bool
    @type_filters = nil
    node.exp.accept(self)
    set_type(node, @program.bool_type)
    if needs_type_filters?
      @type_filters = TypeFilters.invert(@type_filters)
    end
    false
  end

  # iyi: `break` and `next` never complete, so they are NoReturn. The value they carry is typed
  # first (the hosted pass binds it): a `break` to the call whose block is being typed, a `next`
  # to the block or captured proc (see visit(Yield) and call_result).
  def visit(node : Break) : Bool
    if @handler_direct_exit
      return handler_defer_exit(node, "break") if @handler_inside_defer
      return refuse(node, "can't use break inside ensure")
    end
    value_t : Type? = @program.nil_type
    if e = node.exp
      e.accept(self)
      value_t = child_type(e)
    end
    if target = @jump_whiles.last?
      node.target = target
    elsif block = @jump_block
      node.target = @jump_block_calls[block]?
      if exits = @jump_block_exits
        exits << @vars.dup
      end
    elsif @jump_proc
      return refuse(node, "can't break from captured block, try using `next`.")
    end
    if bts = @break_types
      bts << value_t
    elsif !@while_break_vars.empty?
      @while_break_vars.last << @vars.dup
    end
    @unreachable = true
    set_type(node, @program.no_return_type)
    false
  end

  def visit(node : Next) : Bool
    if @handler_direct_exit
      return handler_defer_exit(node, "next") if @handler_inside_defer
      return refuse(node, "can't use next inside ensure")
    end
    value_t : Type? = @program.nil_type
    if e = node.exp
      e.accept(self)
      value_t = child_type(e)
    end
    if target = @jump_whiles.last?
      node.target = target
      @while_next_vars.last << @vars.dup unless @while_next_vars.empty?
    elsif block = @jump_block
      node.target = block
      if ctx = @jump_block_context
        merge_block_exit(ctx, @vars, block)
      end
    elsif proc_def = @jump_proc
      node.target = proc_def
    end
    if nts = @next_types
      nts << value_t
    end
    @unreachable = true
    set_type(node, @program.no_return_type)
    false
  end

  # iyi: the body of a `@[Primitive(:name)]` def (hosted main_visitor.cr
  # 2842-2851). It has the def's declared return type. `pre_initialize` and the
  # by-name cases are not ported here; a primitive with no return type is
  # recorded untyped with its name.
  def visit(node : Primitive) : Bool
    if node.name == "tuple_indexer_known_index" && !node.tuple_range
      if sc = @scope
        instance : Type = sc
        meta = false
        if sc.is_a?(MetaclassType)
          instance = sc.as(MetaclassType).instance_type
          meta = true
        end
        if instance.is_a?(TupleInstanceType)
          members = instance.as(TupleInstanceType).tuple_types
          if node.tuple_index >= 0 && node.tuple_index < members.size
            result = members[node.tuple_index]
            set_type(node, meta ? type_node_metaclass(result).as(Type) : result)
            return false
          end
        elsif instance.is_a?(NamedTupleInstanceType)
          entries = instance.as(NamedTupleInstanceType).entries
          if node.tuple_index >= 0 && node.tuple_index < entries.size
            result = entries[node.tuple_index].type
            set_type(node, meta ? type_node_metaclass(result).as(Type) : result)
            return false
          end
        end
      end
      return refuse(node, "unsupported TupleIndexer scope")
    end
    if node.name == "allocate"
      if sc = @scope
        if sc.is_a?(MetaclassType)
          instance = sc.as(MetaclassType).instance_type
          if instance.is_a?(NonGenericClassType) || instance.is_a?(GenericClassInstanceType)
            prepare_allocation_initializers(instance)
          end
        end
      end
    end
    if cd = @current_def
      if primitive_type = @program.primitive_return_type(cd)
        set_type(node, primitive_type)
        return false
      end
      if rt = cd.return_type
        set_type(node, lookup_under(rt, @scope))
        return false
      end
    end
    if node.name == "allocate" || node.name == "pointer_malloc" || node.name == "pointer_new"
      if sc = @scope
        # Hosted main_visitor.cr:2899-2945 types a virtual allocation as its
        # instance type, or NoReturn for an abstract virtual base.
        if node.name == "allocate" && sc.is_a?(VirtualMetaclassType)
          instance = sc.as(VirtualMetaclassType).instance_type
          set_type(node, instance.abstract? ? @program.no_return_type : instance)
          return false
        end
        if sc.is_a?(MetaclassType)
          instance = sc.as(MetaclassType).instance_type
          if node.name == "pointer_malloc" && instance.is_a?(GenericClassType)
            return refuse(node, "can't malloc pointer without type, use Pointer(Type).malloc(size)")
          end
          if node.name == "pointer_new" && instance.is_a?(GenericClassType)
            return refuse(node, "can't create pointer without type, use Pointer(Type).new(address)")
          end
          set_type(node, instance)
          return false
        end
      end
    end
    if node.name == "pointer_set"
      if pst = pointer_set_type
        set_type(node, pst)
        return false
      end
    end

    if node.name == "class"
      if sc = @scope
        if sc.is_a?(VirtualType)
          set_type(node, sc.as(VirtualType).metaclass)
          return false
        end
        if sc.is_a?(ModuleType)
          set_type(node, sc.as(ModuleType).metaclass)
          return false
        end
      end
    end
    untyped(node, "primitive #{node.name} without a declared return type")
    false
  end

  # Hosted visit_pointer_set (main_visitor.cr 3023-3035): a Void element types
  # the primitive as Nil; otherwise the type is the def's `value` argument.
  # A Pointer instance that is not a PointerInstanceType still has that argument.
  def pointer_set_type : Type?
    element = pointer_element(@scope)
    if element && element.is_a?(VoidType)
      return @program.nil_type
    end
    if vt = @vars["value"]?
      return vt
    end
    element
  end

  def pointer_element(scope : Type?) : Type?
    return nil if scope.nil?
    sc : Type = scope.as(Type)
    if sc.is_a?(MetaclassType)
      sc = sc.as(MetaclassType).instance_type
    end
    if sc.is_a?(PointerInstanceType)
      return sc.as(PointerInstanceType).element_type
    end
    if sc.is_a?(GenericClassInstanceType)
      inst = sc.as(GenericClassInstanceType)
      base = inst.generic_type
      if base.is_a?(GenericClassType) && base.as(GenericClassType).name == "Pointer"
        args = inst.type_args
        return args[0] if args.size == 1
      end
    end
    nil
  end

  # `obj.responds_to?(:name)` is typed Bool. Its value depends on the obj's type and is
  # decided by the lowering, not here (the hosted typer sets only the type).
  def visit(node : RespondsTo) : Bool
    obj = node.obj
    obj.accept(self)
    set_type(node, @program.bool_type)
    false
  end

  # iyi: a node of a kind this visitor does not type yet. The walk goes on into
  # its children, so the children are typed; the node itself is recorded.
  def visit(node : ASTNode) : Bool
    untyped(node, "unsupported node: #{node_class_name(node)}")
    true
  end

  def expand_macro(node : Call) : Bool
    if exp = node.expanded
      exp.accept(self)
      if et = child_type(exp)
        set_type(node, et)
      end
      return true
    end

    if node.obj.nil?
      lookup_type = @scope || @current_type
      if a_macro = lookup_type.is_a?(ModuleType) ? lookup_type.as(ModuleType).lookup_call_macro?(node) : nil
        engine = MacroEngine.new(@program.normalizer.macro_flags)
        expanded_ast = engine.expand_or_failure(a_macro, node, @program.normalizer)
        if expanded_ast.is_a?(MacroFailure)
          refuse(node, expanded_ast.message)
          return true
        end
        node.expanded = expanded_ast
        expanded_ast.accept(self)
        if et = child_type(expanded_ast)
          set_type(node, et)
        end
        return true
      end
    end

    false
  end

  def visit(node : BoolLiteral) : Bool
    set_type(node, @program.bool_type)
    false
  end

  def visit(node : CharLiteral) : Bool
    set_type(node, @program.char_type)
    false
  end

  def visit(node : StringLiteral) : Bool
    set_type(node, @program.string_type)
    false
  end

  # An unexpanded default still types here. A call expands the default to a literal
  # first and types that literal through its ordinary visitor.
  def visit(node : MagicConstant) : Bool
    if node.name == TokenKind::MAGIC_LINE || node.name == TokenKind::MAGIC_END_LINE
      set_type(node, @program.int32_type)
    else
      set_type(node, @program.string_type)
    end
    false
  end

  def visit(node : SymbolLiteral) : Bool
    set_type(node, @program.symbol_type)
    false
  end

  def visit(node : NumberLiteral) : Bool
    set_type(node, type_from_literal_kind(node.kind))
    false
  end

  def visit(node : Nop) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Var) : Bool
    if t = @vars[node.name]?
      set_type(node, t)
      observe_nil_if_read(node.name, t)
      if needs_type_filters?
        @type_filters = TypeFilters.truthy(node.name)
      end
      return false
    end
    if reason = @untyped_locals[node.name]?
      if reason == narrowed_out_reason(node.name)
        @node_types.delete(node)
        @untyped_reasons[node] = reason
        return false
      end
      return untyped(node, reason)
    end

    if node.name == "self"
      if sc = @scope
        set_type(node, sc)
        return false
      else
        return refuse(node, "there's no self in this scope")
      end
    end

    rec_type : Type = @scope || @current_type
    if rec_type.is_a?(VirtualType) || rec_type.is_a?(UnionType)
      call = Call.new(nil, node.name).at(node)
      @expansions[node] = call
      call.accept(self)
      if ret_type = child_type(call)
        set_type(node, ret_type)
      end
      return false
    end
    all_defs = [] of Def
    visited = Set(String).new
    collect_candidate_defs(rec_type, node.name, all_defs, visited)
    collect_scope_defs(rec_type, node.name, all_defs, visited) if all_defs.empty?
    zero_arg = all_defs.find { |d| d.args.empty? || (d.args.first.default_value != nil) }
    if zero_arg
      call = Call.new(nil, node.name).at(node)
      @call_target_defs[call] = zero_arg
      if ret_type = type_method_body(zero_arg, rec_type, [] of ASTNode, nil, node)
        set_type(node, ret_type)
      end
      return false
    end

    scope_name = if sc = @scope
                   sc.full_name
                 else
                   "top-level"
                 end
    refuse(node, "undefined local variable or method '#{node.name}' for #{scope_name}")
  end

  def visit(node : InstanceVar) : Bool
    if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
      return refuse(node, "can't use instance variables at the top level")
    end
    target_scope = @scope || @current_type
    target_type = if target_scope.is_a?(MetaclassType)
                    target_scope.as(MetaclassType).instance_type
                  else
                    target_scope
                  end
    target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
    if target_type.is_a?(ModuleType)
      if ivar = target_type.as(ModuleType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    if target_type.is_a?(GenericClassInstanceType)
      if ivar = target_type.as(GenericClassInstanceType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    refuse(node, "can't infer the type of instance variable '#{node.name}' of #{target_type.full_name}")
  end

  def visit(node : ClassVar) : Bool
    if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
      return refuse(node, "can't use class variables at the top level")
    end
    target_scope = @scope || @current_type
    target_type = if target_scope.is_a?(MetaclassType)
                    target_scope.as(MetaclassType).instance_type
                  else
                    target_scope
                  end
    target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
    if target_type.is_a?(ModuleType)
      if cvar = target_type.as(ModuleType).lookup_class_var?(node.name)
        set_type(node, cvar.type)
        return false
      end
    end
    refuse(node, "undefined class variable '#{node.name}' for #{target_type.full_name}")
  end

  # Class-body initializers run with self set to the owner's metaclass.
  # Assignments inside methods retain the method's existing scope.
  def type_class_var_initializer(value : ASTNode) : Nil
    old_scope = @scope
    if old_scope.nil? && @current_def.nil? && !@current_type.is_a?(SemanticProgram)
      @scope = @current_type.metaclass
    end
    value.accept(self)
    @scope = old_scope
    nil
  end

  # Initializer expressions have fresh locals and class-method self, not the
  # locals of the surrounding type body.
  def type_instance_var_initializer(value : ASTNode, owner : ModuleType) : Nil
    old_scope = @scope
    old_vars = @vars
    @scope = owner.metaclass
    @vars = Hash(String, Type).new
    value.accept(self)
    @scope = old_scope
    @vars = old_vars
    nil
  end

  def instance_vars_initializers_of?(type : Type) : Array(InstanceVarInitializer)?
    @instance_var_initializer_lists[type.object_id]?
  end

  # The registry holds only declarations owned by each link in this chain.
  # The hosted late-generic path can copy a non-generic ancestor's defaults and
  # execute them twice; allocations here execute each declaration once.
  def allocation_initializer_chain(real : Type) : Array(Type)
    chain = [] of Type
    current : Type? = real
    while current
      type = current.as(Type)
      if type.is_a?(NonGenericClassType)
        chain << type
        current = type.as(NonGenericClassType).superclass
      elsif type.is_a?(GenericClassInstanceType)
        chain << type
        current = type.as(GenericClassInstanceType).superclass
      else
        break
      end
    end
    chain.reversed
  end

  # Class parents include their superclass. Only modules belong to this link;
  # superclass initializers are handled by the chain itself.
  def collect_initializer_modules(type : Type, owners : Set(UInt64), bindings : Hash(UInt64, GenericModuleInstanceType), seen : Set(UInt64)) : Nil
    return if seen.includes?(type.object_id)
    seen.add(type.object_id)
    if type.is_a?(GenericModuleInstanceType)
      instance = type.as(GenericModuleInstanceType)
      owners.add(instance.generic_type.object_id)
      bindings[instance.generic_type.object_id] = instance unless bindings[instance.generic_type.object_id]?
      instance.parents.each { |parent| collect_initializer_modules(parent, owners, bindings, seen) }
    elsif type.is_a?(NonGenericModuleType) || type.is_a?(GenericModuleType) || type.is_a?(TraitType)
      mod = type.as(ModuleType)
      owners.add(mod.object_id)
      mod.parents.each { |parent| collect_initializer_modules(parent, owners, bindings, seen) }
    end
    nil
  end

  def prepare_allocation_initializers(real : Type) : Nil
    allocation_initializer_chain(real).each do |type|
      next if @instance_var_initializer_lists[type.object_id]?
      entries = [] of InstanceVarInitializer
      # Install even an empty list before typing: an initializer may allocate its
      # own type, and the lowerer must distinguish prepared-empty from missing.
      @instance_var_initializer_lists[type.object_id] = entries
      owners = Set(UInt64).new
      bindings = Hash(UInt64, GenericModuleInstanceType).new
      seen = Set(UInt64).new
      if type.is_a?(GenericClassInstanceType)
        instance = type.as(GenericClassInstanceType)
        owners.add(instance.generic_type.object_id)
        instance.parents.each { |parent| collect_initializer_modules(parent, owners, bindings, seen) }
        instance.included_modules.each { |parent| collect_initializer_modules(parent, owners, bindings, seen) }
        meta = instance.metaclass
      else
        cls = type.as(NonGenericClassType)
        owners.add(cls.object_id)
        cls.parents.each { |parent| collect_initializer_modules(parent, owners, bindings, seen) }
        meta = cls.metaclass
      end
      @program.instance_var_initializers.each do |entry|
        next unless owners.includes?(entry.owner.object_id)
        generic = entry.owner.is_a?(GenericClassType) || entry.owner.is_a?(GenericModuleType)
        value = generic ? entry.value.clone : entry.value
        if generic || type_of?(value).nil?
          inner = sub_visitor(Hash(String, Type).new).as(MainVisitor)
          inner.scope = meta
          inner.current_type = entry.owner
          if binding = bindings[entry.owner.object_id]?
            inner.initializer_type_vars = binding.type_vars
          end
          value.accept(inner)
        end
        ivar = if type.is_a?(GenericClassInstanceType)
                 type.as(GenericClassInstanceType).lookup_instance_var?(entry.name)
               else
                 type.as(NonGenericClassType).lookup_instance_var?(entry.name)
               end
        raise "BUG: #{type.full_name} has no instance variable #{entry.name}" if ivar.nil?
        if val_type = type_of?(value)
          declared = ivar.as(MetaTypeVar).type
          unless val_type.subtype_of?(declared)
            refuse(value, "instance variable '#{entry.name}' of #{type.full_name} must be #{declared.full_name}, not (#{declared.full_name} | #{val_type.full_name})")
          end
        end
        entries << InstanceVarInitializer.new(entry.owner, entry.name, value)
      end
    end
    nil
  end

  def visit(node : Assign) : Bool
    # iyi: a constant whose value is one macro node is typed where a read of it types the value (visit(Path) expands
    # the site, see splice_const_value). The declaration is not walked as an expression: the macro refusal would
    # belong to no def.
    if node.target.is_a?(Path) && (node.value.is_a?(MacroIf) || node.value.is_a?(MacroFor) || node.value.is_a?(MacroExpression))
      return false
    end
    if node.target.is_a?(InstanceVar) && @current_def.nil? && @scope.nil? && !@current_type.is_a?(SemanticProgram)
      if @current_type.is_a?(GenericClassType) || @current_type.is_a?(GenericModuleType)
        set_type(node, @program.nil_type)
        return false
      end
      type_instance_var_initializer(node.value, @current_type)
    elsif node.target.is_a?(ClassVar)
      type_class_var_initializer(node.value)
    else
      node.value.accept(self)
    end
    value_type_filters = @type_filters
    @type_filters = nil
    vt = child_type(node.value)
    if vt.nil?
      # The local is declared; its reads report why its value has no type.
      if node.target.is_a?(Var)
        name = node.target.as(Var).name
        @untyped_locals[name] = "the value of '#{name}' cannot be typed"
      end
      return false
    end
    val_type = vt.as(Type)
    if node.target.is_a?(Var)
      @untyped_locals.delete(node.target.as(Var).name)
    end

    if node.target.is_a?(Var)
      v = node.target.as(Var)
      # The target and the later reads take the type of this assignment: the
      # oracle prints flow types (bench/fixtures/sem_bodies_union.iyi). The
      # variable's storage type is the union over the body's assignments, kept
      # apart in `def_var_unions` for the lowering.
      @vars[v.name] = val_type
      handler_assign(v.name, val_type)
      set_type(v, val_type)
      set_type(node, val_type)
      if needs_type_filters?
        @type_filters = TypeFilters.assign_var(value_type_filters, v.name)
      end
      merge_var_union(v.name, val_type)
    elsif node.target.is_a?(InstanceVar)
      ivar_node = node.target.as(InstanceVar)
      if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
        return refuse(node, "can't use instance variables at the top level")
      end
      target_scope = @scope || @current_type
      target_type = if target_scope.is_a?(MetaclassType)
                      target_scope.as(MetaclassType).instance_type
                    else
                      target_scope
                    end
      target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
      if target_type.is_a?(ModuleType)
        mod_type = target_type.as(ModuleType)
        if ivar = mod_type.lookup_instance_var?(ivar_node.name)
          unless val_type.subtype_of?(ivar.type)
            return refuse(node, "instance variable '#{ivar_node.name}' of #{mod_type.full_name} must be #{ivar.type.full_name}, not (#{ivar.type.full_name} | #{val_type.full_name})")
          end
          set_type(ivar_node, ivar.type)
        else
          ivar = MetaTypeVar.new(ivar_node.name, val_type, node.value)
          mod_type.instance_vars[ivar_node.name] = ivar
          set_type(ivar_node, val_type)
        end
        set_type(node, val_type)
      elsif target_type.is_a?(GenericClassInstanceType)
        gen_type = target_type.as(GenericClassInstanceType)
        if ivar = gen_type.lookup_instance_var?(ivar_node.name)
          unless val_type.subtype_of?(ivar.type)
            return refuse(node, "instance variable '#{ivar_node.name}' of #{gen_type.full_name} must be #{ivar.type.full_name}, not (#{ivar.type.full_name} | #{val_type.full_name})")
          end
          set_type(ivar_node, ivar.type)
        else
          gen_type.instance_vars[ivar_node.name] = MetaTypeVar.new(ivar_node.name, val_type, node.value)
          set_type(ivar_node, val_type)
        end
        set_type(node, val_type)
      else
        return refuse(node, "can't use instance variables in #{target_type.full_name}")
      end
    elsif node.target.is_a?(ClassVar)
      cvar_node = node.target.as(ClassVar)
      if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
        return refuse(node, "can't use class variables at the top level")
      end
      target_scope = @scope || @current_type
      target_type = if target_scope.is_a?(MetaclassType)
                      target_scope.as(MetaclassType).instance_type
                    else
                      target_scope
                    end
      target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
      if target_type.is_a?(ModuleType)
        mod_type = target_type.as(ModuleType)
        if cvar = mod_type.lookup_class_var?(cvar_node.name)
          unless val_type.subtype_of?(cvar.type) || (cvar.type.is_a?(UnionType) && TypeRestrictions.matches_restriction?(@program, val_type, cvar.type))
            return refuse(node, "type mismatch for class variable '#{cvar_node.name}': expected #{cvar.type.full_name}, got #{val_type.full_name}")
          end
          set_type(cvar_node, cvar.type)
        else
          cvar = MetaTypeVar.new(cvar_node.name, val_type, node.value)
          replace_class_var(mod_type, cvar_node.name, cvar)
          set_type(cvar_node, val_type)
        end
        set_type(node, val_type)
      else
        return refuse(node, "can't use class variables in #{target_type.full_name}")
      end
    elsif node.target.is_a?(Path)
      p = node.target.as(Path)
      set_type(p, val_type)
      # Hosted main_visitor.cr:1084-1087: the assignment itself is Nil.
      set_type(node, @program.nil_type)
    else
      set_type(node, val_type)
    end
    false
  end

  # A local's storage includes the types written to it.
  def merge_var_union(name : String, type : Type) : Nil
    # A yielded block writes captured locals in the caller's storage, not the
    # callee being typed (hosted codegen.cr:2562-2583, call.cr block context).
    unions = @var_unions
    if owner = @var_owners[name]?
      unions = owner.unions
    end
    if previous = unions[name]?
      unions[name] = @program.type_merge(previous, type)
    else
      unions[name] = type
    end
    nil
  end

  def merge_nil_if_read(name : String) : Nil
    @nil_candidates.add(name)
    nil
  end

  def storage_owner(name : String) : LocalStorage?
    @var_owners[name]?
  end

  def observe_nil_if_read(name : String, flow : Type) : Nil
    return unless flow.nilable?
    if owner = storage_owner(name)
      unions = owner.unions
      candidates = owner.nil_candidates
      resets = owner.nil_resets
    else
      unions = @var_unions
      candidates = @nil_candidates
      resets = @nil_resets
    end
    if stored = unions[name]?
      unless stored.nilable?
        unions[name] = @program.type_merge(stored, @program.nil_type)
      end
    end
    resets.add(name) if candidates.includes?(name)
    nil
  end

  def visit(node : TypeDeclaration) : Bool
    # Declarations must resolve generic arguments even before any expression
    # has caused the lazy type system to be installed.
    type_node_system(@program)
    decl_found = lookup_declared?(node.declared_type, @scope)
    if decl_found.nil?
      return refuse(node, "undefined constant #{declared_base_name(node.declared_type)}")
    end
    decl_type = decl_found.as(Type)
    val = node.value
    if node.var.is_a?(InstanceVar) && @current_def.nil? && @scope.nil? &&
       (@current_type.is_a?(GenericClassType) || @current_type.is_a?(GenericModuleType))
      val = nil
    end
    if val
      if node.var.is_a?(InstanceVar) && @current_def.nil? && @scope.nil? && !@current_type.is_a?(SemanticProgram)
        type_instance_var_initializer(val, @current_type)
      elsif node.var.is_a?(ClassVar)
        type_class_var_initializer(val)
      else
        val.accept(self)
      end
      vt = child_type(val)
      return false if vt.nil?
      val_type = vt.as(Type)
      proc_compatible = val_type.is_a?(ProcInstanceType) && decl_type.is_a?(ProcInstanceType) &&
                        TypeIntersect.compatible_proc?(val_type.as(ProcInstanceType), decl_type.as(ProcInstanceType))
      class_var_union = node.var.is_a?(ClassVar) && decl_type.is_a?(UnionType) &&
                        TypeRestrictions.matches_restriction?(@program, val_type, decl_type)
      unless val_type.subtype_of?(decl_type) || proc_compatible || class_var_union
        if node.var.is_a?(InstanceVar)
          target_scope = @scope || @current_type
          target_type = if target_scope.is_a?(MetaclassType)
                          target_scope.as(MetaclassType).instance_type
                        else
                          target_scope
                        end
          return refuse(node, "instance variable '#{node.var.as(InstanceVar).name}' of #{target_type.full_name} must be #{decl_type.full_name}, not (#{decl_type.full_name} | #{val_type.full_name})")
        end
        return refuse(node, "expected type #{decl_type.full_name}, got #{val_type.full_name}")
      end
      if node.var.is_a?(Var)
        v = node.var.as(Var)
        stored = proc_compatible ? decl_type : val_type
        @vars[v.name] = stored
        # The declaration node keeps its written type; flow and storage start
        # at the initializer's type, as hosted type_assign does.
        set_type(v, decl_type)
        merge_var_union(v.name, stored) unless stored.is_a?(NoReturnType)
      elsif node.var.is_a?(InstanceVar)
        ivar_node = node.var.as(InstanceVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can only declare instance variables of a non-generic class, not a main (<Program>)")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          # Hosted type_declaration_processor.cr resolves the written field once,
          # including its virtual type; visiting its initializer must retain it.
          ivar = mod_type.instance_vars[ivar_node.name]?
          if ivar.nil?
            ivar = MetaTypeVar.new(ivar_node.name, decl_type, val)
            mod_type.instance_vars[ivar_node.name] = ivar
          end
          set_type(ivar_node, ivar.as(MetaTypeVar).type)
        end
      elsif node.var.is_a?(ClassVar)
        cvar_node = node.var.as(ClassVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can't use class variables at the top level")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          replace_class_var(mod_type, cvar_node.name, MetaTypeVar.new(cvar_node.name, decl_type, val))
          set_type(cvar_node, decl_type)
        end
      end
      set_type(node, val_type)
    else
      if node.var.is_a?(Var)
        v = node.var.as(Var)
        @vars[v.name] = decl_type
        set_type(v, decl_type)
        merge_var_union(v.name, decl_type)
      elsif node.var.is_a?(InstanceVar)
        ivar_node = node.var.as(InstanceVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can only declare instance variables of a non-generic class, not a main (<Program>)")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          # Preserve the declaration pass's virtualized field type and metadata.
          ivar = mod_type.instance_vars[ivar_node.name]?
          if ivar.nil?
            ivar = MetaTypeVar.new(ivar_node.name, decl_type, nil)
            mod_type.instance_vars[ivar_node.name] = ivar
          end
          set_type(ivar_node, ivar.as(MetaTypeVar).type)
        end
      elsif node.var.is_a?(ClassVar)
        cvar_node = node.var.as(ClassVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can't use class variables at the top level")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        target_type = target_type.as(VirtualType).base_type if target_type.is_a?(VirtualType)
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          replace_class_var(mod_type, cvar_node.name, MetaTypeVar.new(cvar_node.name, decl_type, nil))
          set_type(cvar_node, decl_type)
        end
      end
      set_type(node, decl_type)
    end
    false
  end

  def visit(node : Path) : Bool
    if @current_def.nil? && !node.global && node.names.size == 1
      if bindings = @initializer_type_vars
        if bound = bindings[node.names.first]?
          if @in_type_args == 0
            if meta = type_node_metaclass(bound)
              set_type(node, meta)
            else
              return refuse(node, "expected a type with a metaclass, not #{bound.full_name}")
            end
          else
            set_type(node, bound)
          end
          return false
        end
      end
    end
    if !node.global && node.names.size == 1
      if cd = @current_def
        if free = @def_free_types[cd]?
          if bound = free[node.names.first]?
            if @in_type_args == 0 && bound.is_a?(ModuleType)
              set_type(node, bound.as(ModuleType).metaclass)
            else
              set_type(node, bound)
            end
            return false
          end
        end
      end
    end
    if !node.global && node.names.size == 1
      if instance = current_module_instance(@scope)
        if bound = instance.type_vars[node.names.first]?
          if @in_type_args == 0
            if meta = type_node_metaclass(bound)
              set_type(node, meta)
            else
              return refuse(node, "expected a type with a metaclass, not #{bound.full_name}")
            end
          else
            set_type(node, bound)
          end
          return false
        end
      end
    end
    if !node.global && node.names.size == 1
      if trait_parent = current_trait_instance(@scope)
        if bound = trait_parent.type_vars[node.names.first]?
          if @in_type_args == 0
            if meta = type_node_metaclass(bound)
              set_type(node, meta)
            else
              return refuse(node, "expected a type with a metaclass, not #{bound.full_name}")
            end
          else
            set_type(node, bound)
          end
          return false
        end
      end
    end
    if inst = receiver_instance(@scope)
      path = node
      if !path.global && path.names.size == 1
        if bound = inst.type_vars[path.names.first]?
          # A type parameter in an expression names the bound type's metaclass, as a
          # type name does (`T.new`), except inside a type argument.
          if @in_type_args == 0 && bound.is_a?(ModuleType)
            set_type(node, bound.as(ModuleType).metaclass)
          else
            set_type(node, bound)
          end
          return false
        end
      end
    end
    t = @program.lookup_type_path(node, @current_type)
    # Hosted main_visitor.cr:237-248 types a simple alias as its underlying type.
    t = @program.remove_alias(t) if t.is_a?(AliasType)
    if t.const?
      c = t.as(Const)
      c.used = true
      @target_consts[node] = c
      if enum_type = c.enum_value_type
        set_type(c.value, enum_type)
        set_type(node, enum_type)
      elsif predefined_type = predefined_const_type(c)
        set_type(c.value, predefined_type)
        set_type(node, predefined_type)
      elsif c_type = type_of?(c.value)
        set_type(node, c_type)
      else
        # Hosted main_visitor.cr:205-214 types the initializer in its owner's
        # lexical scope with fresh locals, not in the scope of the reader.
        saved_imports = @program.current_imports
        saved_import_defs = @program.current_import_defs
        inner = sub_visitor(Hash(String, Type).new).as(MainVisitor)
        inner.current_type = c.namespace || @program
        inner.scope = nil
        enter_file_scope(c.value)
        inner.splice_const_value(c)
        c.value.accept(inner)
        @program.current_imports = saved_imports
        @program.current_import_defs = saved_import_defs
        if c_type = child_type(c.value)
          set_type(node, c_type)
        end
      end
    elsif t.is_a?(ModuleType) && @in_type_args == 0 && !t.is_a?(LibType)
      set_type(node, t.as(ModuleType).metaclass)
    else
      set_type(node, t)
    end
    false
  end

  # The type of ARGC_UNSAFE and ARGV_UNSAFE, the program's own constants (hosted program.cr 1461-1462: a Primitive of
  # Int32, and one of UInt8**). Their value here is the placeholder the declarations dump prints; the lowering stores
  # argc and argv into their globals directly, so a read of either is typed from this.
  def predefined_const_type(c : Const) : Type?
    predefined = @program.predefined_const(c.name)
    return nil if predefined.nil? || predefined.as(Const).object_id != c.object_id
    if c.name == "ARGC_UNSAFE"
      return @program.int32_type
    end
    ts = type_node_system(@program)
    ts.pointer_of(ts.pointer_of(@program.types["UInt8"]))
  end

  # An inline macro site (`{% if %}`, `{% for %}`, `{{ }}`) written in the body of the def being typed
  # is expanded in place, as the declarations pass expands one at the top level and in a type body
  # (inline_macros.iyi). The scope is the receiver's type and the file is the one the def is written in.
  # Outside a def (top level, a fun body) nothing is spliced here.
  def def_inline_scope_name : String
    if scope = @scope
      # Hosted macros/interpreter.cr:735-737 exposes the instance type of a
      # metaclass and strips virtuality from @type.
      return TypeQueries.instance_type(scope).devirtualize.full_name
    end
    ""
  end

  def def_inline_file : String
    if cd = @current_def
      if loc = cd.location
        return loc.filename
      end
    end
    @fun_inline_file || ""
  end

  # Whether a body is spliced here: a def being typed, or a fun body (see visit(FunDef)).
  def in_inline_body? : Bool
    !@current_def.nil? || !@fun_inline_file.nil?
  end

  # The names a site in the body being typed sees before that body's first statement: the def's
  # arguments, and every local typed so far. Hosted seeds the expansion's parser with the visitor's
  # variables (semantic_visitor.cr expand_macro: local_vars from @vars), so a site in a loop's or a
  # branch's body knows the locals the enclosing bodies declared before it (inline_macros.iyi adds
  # the ones this body declares before the site).
  def def_inline_locals : Array(String)
    names = [] of String
    if cd = @current_def
      cd.args.each { |arg| names << arg.name }
      if ba = cd.block_arg
        names << ba.name
      end
    end
    @vars.keys.each { |name| names << name unless names.includes?(name) }
    names
  end

  # The type parameters a macro site in the def being typed sees (macro_bindings.iyi): the receiver's
  # and the def's own free variables. The def is the one whose body the site is written in, so a site in
  # a block's body sees its writer's, not the yielding def's.
  def def_inline_bindings : Array(MacroFreeBinding)
    free = Hash(String, Type).new
    if cd = @current_def
      if bound = @def_free_types[cd]?
        free = bound
      end
    end
    MacroBindings.of(@scope, free)
  end

  # Whether a node is an inline macro site the splice expands.
  def inline_site?(node : ASTNode) : Bool
    node.is_a?(MacroIf) || node.is_a?(MacroFor) || node.is_a?(MacroExpression)
  end

  # Every Expressions of every def body passes here, so the names and bindings are built only for a
  # body that holds a site: a body with none is left as it is.
  def splice_def_inline_sites(node : Expressions) : Nil
    return nil if @current_def.nil?
    return nil unless node.expressions.any? { |exp| inline_site?(exp) }
    node.expressions = splice_inline_sites(node.expressions, def_inline_scope_name, def_inline_file, false, @program.normalizer, def_inline_locals, def_inline_bindings, MacroBindings.facts(@scope), true)
    nil
  end

  def splice_def_body(node : ASTNode) : ASTNode
    return node if @current_def.nil?
    return node unless inline_site?(node)
    splice_body_node(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, def_inline_locals, def_inline_bindings, MacroBindings.facts(@scope), true)
  end

  # An inline macro site that is the whole value of a constant (`CHANNEL_WAIT = {% if ... %}512{% else %}2048{% end %}`)
  # is expanded where the constant is typed, as the hosted pass expands a macro where an expression is expected
  # (semantic_visitor.cr 1943-1956). The declared value keeps the site: the declarations dump prints it as written.
  def splice_const_value(c : Const) : Nil
    value = c.value
    return nil unless value.is_a?(MacroIf) || value.is_a?(MacroFor) || value.is_a?(MacroExpression)
    scope_name = ""
    if ns = c.namespace
      scope_name = ns.full_name
    end
    file = ""
    if locs = c.locations
      if first_loc = locs.first?
        file = first_loc.filename
      end
    end
    spliced = splice_body_node(value, scope_name, file, c.namespace.is_a?(LibType), @program.normalizer)
    if spliced.is_a?(Expressions)
      only = spliced.as(Expressions).expressions
      spliced = only[0] if only.size == 1
    end
    c.value = spliced
    nil
  end

  def visit(node : Expressions) : Bool
    splice_def_inline_sites(node)
    if node.expressions.empty?
      set_type(node, @program.nil_type)
    else
      # The type of an expression list is the type of its last expression. An
      # expression the port cannot type leaves the list untyped too.
      last_type : Type? = nil
      i = 0
      while i < node.expressions.size
        probe = node.expressions[i]
        break unless probe.is_a?(If) && probe.as(If).iyi_definition_probe
        saved_vars = @vars
        saved_ntf = @needs_type_filters
        @vars = @vars.dup
        @needs_type_filters = 0
        probe.accept(self)
        @vars = saved_vars
        @needs_type_filters = saved_ntf
        i += 1
      end
      if i > 0
        @var_unions.keys.each { |name| @var_unions.delete(name) if name.starts_with?("__iyi_dt_") }
        @untyped_locals.keys.each { |name| @untyped_locals.delete(name) if name.starts_with?("__iyi_dt_") }
        @nil_candidates.to_a.each { |name| @nil_candidates.delete(name) if name.starts_with?("__iyi_dt_") }
        @nil_resets.to_a.each { |name| @nil_resets.delete(name) if name.starts_with?("__iyi_dt_") }
      end
      # What follows an `if` whose one branch ends the flow and whose other the filters left unreachable is dead
      # (`if type.is_a?(A); return; end` with `type` already an A): the hosted pass types it, with the variable the
      # filter narrowed away left without a type, and reports nothing. visit(If) raises `flow_dead`; the rest of
      # this list is typed as an unreachable branch is.
      @flow_dead = false
      dead_here = false
      while i < node.expressions.size
        if @flow_dead && !dead_here
          @dead_depth = @dead_depth + 1
          dead_here = true
        end
        @flow_dead = false
        exp = node.expressions[i]
        # iyi: an annotation sits beside the def it annotates and is neither typed
        # nor walked (the hosted pass does not), so it does not end the list's type.
        unless exp.is_a?(Annotation)
          # Code outside a def reads its own file's imports (SPEC.md R-2b).
          # declare_unit restores the prior table, so none is in force at the root.
          outer_imports = @program.current_imports
          outer_import_defs = @program.current_import_defs
          enter_file_scope(exp) if @current_def.nil?
          if i == node.expressions.size - 1
            exp.accept(self)
            last_type = child_type(exp)
          else
            saved_ntf = @needs_type_filters
            @needs_type_filters = 0
            exp.accept(self)
            @needs_type_filters = saved_ntf
          end
          @program.current_imports = outer_imports
          @program.current_import_defs = outer_import_defs
        end
        i = i + 1
      end
      @dead_depth = @dead_depth - 1 if dead_here
      @flow_dead = false
      # A dead tail may contain an intentionally untyped narrowed-out read.
      # It contributes no value to the return merge (hosted call.cr:697-714).
      last_type = @program.no_return_type if dead_here && last_type.nil?
      if lt = last_type
        set_type(node, lt)
      end
    end
    false
  end

  # The type where two branches meet. A branch that never completes (NoReturn) adds
  # nothing, as the hosted merge drops it; the other branch's type is the result.
  def merge_flow(a : Type, b : Type) : Type
    return b if a.is_a?(NoReturnType)
    return a if b.is_a?(NoReturnType)
    @program.type_merge(a, b)
  end

  def narrowed_out_reason(name : String) : String
    "variable '#{name}' cannot be typed"
  end

  # Applies a TypeFilters map to @vars for the current branch.
  def filter_vars(filters : TypeFilters?) : Nil
    return nil if filters.nil?
    filters.as(TypeFilters).pos.each do |name, spec|
      if existing = @vars[name]?
        if narrowed = TypeFilter.apply(@program, spec, existing)
          @vars[name] = narrowed
        else
          @vars.delete(name)
          @untyped_locals[name] = narrowed_out_reason(name)
          @narrowed_out = true
        end
      end
    end
    nil
  end

  # The hosted pass refuses rescue and else in iyi; only the ensure path is
  # needed here. The handler's value is its body, never the ensure's value.
  def visit(node : ExceptionHandler) : Bool
    if node.rescues || node.else
      return refuse(node, "iyi has no exceptions to rescue: an error is a value the caller handles (SPEC.md III.1), and a panic is caught at a task boundary (III.1.4), never here - this `rescue` would not run. Return the error, or read the task's `value`")
    end
    if @program.iyi_prelude? && !node.iyi_defer?
      if loc = node.location
        if loc.filename.ends_with?(".iyi") && node.ensure
          return refuse(node, "iyi has no `ensure`: a panic unwinds by registry and skips it (SPEC.md III.1.4). Write `defer`, which runs on return, on `!` and on a panic")
        end
      end
    end

    before_body = @vars.dup
    handler_vars = @vars.dup
    @handler_vars << handler_vars
    node.body.accept(self)
    after_body = @vars.dup
    body_unreachable = @unreachable
    @handler_vars.pop
    unless @handler_vars.empty?
      outer = @handler_vars.last
      handler_vars.each do |name, type|
        if old = outer[name]?
          outer[name] = @program.type_merge(old, type)
        else
          outer[name] = type
        end
      end
    end

    if cleanup = node.ensure
      handler_vars.each do |name, type|
        unless before_body.has_key?(name)
          handler_vars[name] = @program.type_merge(type, @program.nil_type)
          merge_nil_if_read(name)
        end
      end
      @vars = handler_vars
      writes = Set(String).new
      @handler_writes << writes
      @unreachable = false
      old_handler_inside_ensure = @handler_inside_ensure
      old_handler_inside_defer = @handler_inside_defer
      old_handler_direct_exit = @handler_direct_exit
      @handler_inside_ensure = true
      @handler_inside_defer = @handler_inside_defer || node.iyi_defer?
      @handler_direct_exit = true
      cleanup.accept(self)
      @handler_inside_ensure = old_handler_inside_ensure
      @handler_inside_defer = old_handler_inside_defer
      @handler_direct_exit = old_handler_direct_exit
      cleanup_unreachable = @unreachable
      @handler_writes.pop
      after_cleanup = @vars
      @vars = after_body
      writes.each do |name|
        if type = after_cleanup[name]?
          @vars[name] = type
        end
      end
      @unreachable = body_unreachable || cleanup_unreachable
    end
    if type = child_type(node.body)
      set_type(node, type)
    end
    false
  end

  # Merges @vars after an `if`'s two branches (hosted MainVisitor#merge_if_vars).
  def merge_if_vars(cond_vars : Hash(String, Type), then_vars : Hash(String, Type), else_vars : Hash(String, Type), then_untyped : Hash(String, String), else_untyped : Hash(String, String), then_unreachable : Bool, else_unreachable : Bool) : Nil
    merged_vars = Hash(String, Type).new
    merged_untyped = Hash(String, String).new
    keys = [] of String
    then_vars.each_key { |k| keys << k unless keys.includes?(k) }
    else_vars.each_key { |k| keys << k unless keys.includes?(k) }
    cond_vars.each_key { |k| keys << k unless keys.includes?(k) }
    keys.each do |name|
      then_var = then_vars[name]?
      else_var = else_vars[name]?
      cond_var = cond_vars[name]?
      if then_var && else_var
        if then_unreachable && else_unreachable
          merged_vars[name] = merge_flow(then_var, else_var)
        elsif then_unreachable
          merged_vars[name] = else_var
        elsif else_unreachable
          merged_vars[name] = then_var
        elsif then_var == else_var
          merged_vars[name] = then_var
        else
          merged_vars[name] = @program.type_merge(then_var, else_var)
        end
      elsif then_var
        if then_unreachable
          if cond_var && !else_unreachable
            # Narrowed to empty in else; keep nothing here
          elsif cond_var
            merged_vars[name] = cond_var
          end
        else
          if cond_var
            merged_vars[name] = then_var
          elsif else_unreachable
            merged_vars[name] = then_var
          else
            merged_vars[name] = @program.type_merge(then_var, @program.nil_type)
            merge_nil_if_read(name)
          end
        end
      elsif else_var
        if else_unreachable
          if cond_var && !then_unreachable
            # Narrowed to empty in then
          elsif cond_var
            merged_vars[name] = cond_var
          end
        else
          if cond_var
            merged_vars[name] = else_var
          elsif then_unreachable
            merged_vars[name] = else_var
          else
            merged_vars[name] = @program.type_merge(else_var, @program.nil_type)
            merge_nil_if_read(name)
          end
        end
      end
      unless merged_vars.has_key?(name)
        if reason = (else_unreachable ? then_untyped[name]? : (then_unreachable ? else_untyped[name]? : (then_untyped[name]? || else_untyped[name]?)))
          merged_untyped[name] = reason
        end
      end
    end
    @vars = merged_vars
    @untyped_locals = merged_untyped
    nil
  end

  def visit(node : If) : Bool
    @type_filters = nil
    @needs_type_filters = @needs_type_filters + 1
    node.cond.accept(self)
    @needs_type_filters = @needs_type_filters - 1

    cond_vars = @vars
    cond_untyped = @untyped_locals
    cond_type_filters = @type_filters

    @vars = cond_vars.dup
    @untyped_locals = cond_untyped.dup
    @type_filters = nil
    @unreachable = false
    @narrowed_out = false
    filter_vars(cond_type_filters)
    then_dead = @narrowed_out
    node.then = splice_def_body(node.then)
    @dead_depth = @dead_depth + 1 if then_dead
    node.then.accept(self)
    @dead_depth = @dead_depth - 1 if then_dead
    then_vars = @vars
    then_untyped = @untyped_locals
    then_type_filters = @type_filters
    then_unreachable = @unreachable

    @vars = cond_vars.dup
    @untyped_locals = cond_untyped.dup
    @type_filters = nil
    @unreachable = false
    @narrowed_out = false
    filter_vars(TypeFilters.invert(cond_type_filters))
    else_dead = @narrowed_out
    node.else = splice_def_body(node.else)
    @dead_depth = @dead_depth + 1 if else_dead
    node.else.accept(self)
    @dead_depth = @dead_depth - 1 if else_dead
    else_vars = @vars
    else_untyped = @untyped_locals
    else_type_filters = @type_filters
    else_unreachable = @unreachable

    merge_if_vars(cond_vars, then_vars, else_vars, then_untyped, else_untyped, then_unreachable, else_unreachable)

    @type_filters = nil
    if needs_type_filters?
      if node.from_and
        and_filters = TypeFilters.and_filters(cond_type_filters, then_type_filters)
        then_vars.each_key do |name|
          next if cond_vars.has_key?(name)
          and_filters = TypeFilters.and_filters(and_filters, TypeFilters.truthy(name))
        end
        @type_filters = and_filters
      elsif node.from_or
        @type_filters = TypeFilters.or_filters(cond_type_filters, else_type_filters)
      end
    end

    @unreachable = then_unreachable && else_unreachable
    @flow_dead = (then_unreachable && else_dead) || (else_unreachable && then_dead) || (then_dead && else_dead)

    then_type = then_dead ? type_of?(node.then) : child_type(node.then)
    else_type = else_dead ? type_of?(node.else) : child_type(node.else)
    speculative = @speculation.depth > 0
    if then_type && else_type
      merged = merge_flow(then_type, else_type)
      set_type(node, merged)
    elsif then_type && (else_unreachable || else_dead || speculative)
      set_type(node, then_type)
    elsif else_type && (then_unreachable || then_dead || speculative)
      set_type(node, else_type)
    end
    false
  end

  def endless_while_cond?(cond : ASTNode) : Bool
    c = cond
    while c.is_a?(Expressions)
      exps = c.as(Expressions).expressions
      return false unless exps.size == 1
      c = exps[0]
    end
    c.is_a?(BoolLiteral) && c.as(BoolLiteral).value
  end

  def merge_while_vars(endless : Bool, before_cond_vars : Hash(String, Type), after_cond_vars : Hash(String, Type), body_vars : Hash(String, Type), break_vars_list : Array(Hash(String, Type))) : Nil
    after_while = Hash(String, Type).new
    if endless
      if !break_vars_list.empty?
        keys = [] of String
        break_vars_list.each do |bv|
          bv.each_key { |k| keys << k unless keys.includes?(k) }
        end
        keys.each do |name|
          merged : Type? = nil
          all_have = true
          break_vars_list.each do |bv|
            if bt = bv[name]?
              merged = merged ? @program.type_merge(merged.as(Type), bt) : bt
            else
              all_have = false
            end
          end
          if mt = merged
            unless all_have || before_cond_vars.has_key?(name)
              mt = @program.type_merge(mt, @program.nil_type)
              merge_nil_if_read(name)
            end
            after_while[name] = mt
          end
        end
      else
        # No `break` leaves the loop. The hosted pass still types what follows it, with each variable as the
        # loop's body leaves it (`merge_while_vars` binds the variable after the loop to its type at the end of the
        # body); a variable first written inside the loop can be read before it was, so it is nilable.
        body_vars.each do |name, body_type|
          if before_cond_vars.has_key?(name)
            after_while[name] = body_type
          else
            after_while[name] = @program.type_merge(body_type, @program.nil_type)
            merge_nil_if_read(name)
          end
        end
      end
    else
      keys = [] of String
      before_cond_vars.each_key { |k| keys << k unless keys.includes?(k) }
      after_cond_vars.each_key { |k| keys << k unless keys.includes?(k) }
      body_vars.each_key { |k| keys << k unless keys.includes?(k) }
      keys.each do |name|
        bcv = before_cond_vars[name]?
        acv = after_cond_vars[name]?
        wv = body_vars[name]?
        if acv && bcv != acv
          after_while[name] = acv
        elsif bcv && wv
          after_while[name] = bcv == wv ? bcv : @program.type_merge(bcv, wv)
        elsif bcv
          after_while[name] = bcv
        elsif wv
          merged_new = @program.type_merge(wv, @program.nil_type)
          after_while[name] = merged_new
          merge_nil_if_read(name)
        end
      end
      break_vars_list.each do |bv|
        bv.each do |name, bt|
          if existing = after_while[name]?
            after_while[name] = @program.type_merge(existing, bt) unless existing == bt
          else
            after_while[name] = @program.type_merge(bt, @program.nil_type)
            merge_nil_if_read(name)
          end
        end
      end
    end
    @vars = after_while
    nil
  end

  # Discard dirty instances and their descendants without replacing the shared array.
  def discard_loop_pass(entry_mark : Int32, refusal_mark : Int32) : Nil
    entries = @speculation.entries
    if entries.size == entry_mark
      truncate_refusals(refusal_mark)
      return nil
    end
    removed = Hash(UInt64, Bool).new
    i = entry_mark
    through = entry_mark
    while i < entries.size
      entry = entries[i]
      if entry.dirty && entry.window_end > through
        through = entry.window_end
      end
      if i < through
        @def_instances.delete(entry.key)
        @speculation.dirty_keys.delete(entry.key)
        removed[entry.instance.object_id] = true
      end
      i = i + 1
    end
    unless removed.empty?
      read_index = 0
      kept = 0
      while read_index < @typed_instances.size
        instance = @typed_instances[read_index]
        unless removed[instance.object_id]?
          @typed_instances[kept] = instance if kept != read_index
          kept = kept + 1
        end
        read_index = read_index + 1
      end
      @typed_instances.truncate(0, kept)
    end
    entries.truncate(0, entry_mark)
    truncate_refusals(refusal_mark)
    nil
  end

  def visit(node : While) : Bool
    before_cond_vars_copy = @vars.dup
    before_cond_untyped = @untyped_locals.dup
    old_break_types = @break_types
    old_next_types = @next_types
    old_while_unreachable = @unreachable
    @break_types = nil
    @next_types = nil
    node.body = splice_def_body(node.body)

    cond_type_filters : TypeFilters? = nil
    after_cond_vars = before_cond_vars_copy
    body_vars = before_cond_vars_copy
    break_vars_list = [] of Hash(String, Type)

    pass = 0
    settled = false
    settled_refusal : String? = nil
    while pass < 32
      pass = pass + 1
      refusal_mark = @refusals.size
      entry_mark = @speculation.entries.size
      @speculation.depth = @speculation.depth + 1
      pass_start_vars = @vars.dup
      @type_filters = nil
      @needs_type_filters = @needs_type_filters + 1
      node.cond.accept(self)
      @needs_type_filters = @needs_type_filters - 1
      cond_type_filters = @type_filters
      after_cond_vars = @vars.dup

      filter_vars(cond_type_filters)
      @type_filters = nil
      @unreachable = false
      @while_break_vars.push([] of Hash(String, Type))
      @while_next_vars.push([] of Hash(String, Type))
      @jump_whiles << node
      old_handler_direct_exit = @handler_direct_exit
      @handler_direct_exit = false
      node.body.accept(self)
      @jump_whiles.pop
      @handler_direct_exit = old_handler_direct_exit
      body_vars = @vars
      break_vars_list = @while_break_vars.pop
      next_states = @while_next_vars.pop
      @speculation.depth = @speculation.depth - 1

      changed = false
      next_vars = Hash(String, Type).new
      pass_start_vars.each do |name, start_t|
        if end_t = body_vars[name]?
          if end_t != start_t
            merged_t = @program.type_merge(start_t, end_t)
            if merged_t != start_t
              changed = true
            end
            next_vars[name] = merged_t
          else
            next_vars[name] = start_t
          end
        else
          next_vars[name] = start_t
        end
      end
      # Next carries its own flow back to the loop head (hosted bind_vars).
      next_states.each do |state|
        state.each do |name, next_t|
          if head_t = next_vars[name]?
            if head_t != next_t
              merged_head = @program.type_merge(head_t, next_t)
              if merged_head != head_t
                changed = true
                next_vars[name] = merged_head
              end
            end
          end
        end
      end
      unless changed
        settled = true
        if @speculation.depth == 0
          if !@total && @refusals.size > refusal_mark
            settled_refusal = @refusals[refusal_mark].reason
          end
          @speculation.entries.each { |entry| @speculation.dirty_keys.delete(entry.key) }
          @speculation.entries.truncate(0, 0)
        end
        break
      end
      discard_loop_pass(entry_mark, refusal_mark)
      @vars = next_vars
      @untyped_locals = before_cond_untyped.dup
    end

    @break_types = old_break_types
    @next_types = old_next_types
    @type_filters = nil
    @unreachable = old_while_unreachable
    unless settled
      @vars = before_cond_vars_copy
      @untyped_locals = before_cond_untyped
      return refuse(node, "the types of this loop's variables did not settle after 32 passes")
    end
    if reason = settled_refusal
      raise(reason)
    end

    endless_while = endless_while_cond?(node.cond)
    merge_while_vars(endless_while, before_cond_vars_copy, after_cond_vars, body_vars, break_vars_list)

    if break_vars_list.empty?
      if endless_while
        set_type(node, @program.no_return_type)
        @unreachable = true
        return false
      end
      filter_vars(TypeFilters.invert(cond_type_filters))
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Until) : Bool
    node.cond.accept(self)
    # As in a while: a `break` or `next` in the loop is not the block's.
    old_break_types = @break_types
    old_next_types = @next_types
    @break_types = nil
    @next_types = nil
    node.body.accept(self)
    @break_types = old_break_types
    @next_types = old_next_types
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Return) : Bool
    if @handler_inside_defer || (@current_def && @current_def.as(Def).iyi_defer?)
      return handler_defer_exit(node, node.from_propagate ? "!" : "return")
    end
    return refuse(node, "can't return from ensure") if @handler_inside_ensure
    if @jump_proc
      if node.from_propagate
        return refuse(node, "`!` can't propagate out of a block that runs as a proc\n\n`!` in a block returns from the method the block is written in (SPEC.md III.1.2), and this block is captured: it is kept and called later, maybe by a task, after that method may have returned. Answer the error as the block's value, `next` it, and read it where the value arrives, through `task.value` or the typed group; or handle it here.")
      end
      return refuse(node, "can't return from captured block, use next")
    end
    value_t : Type? = @program.nil_type
    if exp = node.exp
      exp.accept(self)
      value_t = child_type(exp)
      if value_t.nil?
        # An untyped value makes the def's type untyped (see type_method_body).
        if rts = @return_types
          rts << nil
        end
        @unreachable = true
        return false
      end
      if cd = @current_def
        if rt = cd.return_type
          expected_ret = return_contract(rt, @scope, cd)
          unless return_fits?(value_t.as(Type), expected_ret)
            @unreachable = true
            return refuse(node, "type mismatch for return type: expected #{expected_ret.full_name}, got #{value_t.as(Type).full_name}")
          end
        end
      end
    end
    node.target = @current_def
    if rts = @return_types
      rts << value_t
    end
    @unreachable = true
    set_type(node, @program.no_return_type)
    false
  end

  def visit(node : ClassDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    # Unit assembly uses ClassDef wrappers for module headers. Hosted
    # semantic_visitor.cr:1811-1828 visits either resolved module body.
    if t && t.is_a?(ModuleType)
      old_type = @current_type
      @current_type = t.as(ModuleType)
      node.body.accept(self)
      @current_type = old_type

      cls = t.as(ModuleType)
      cls.class_vars.each_value do |cvar|
        if cvar.initializer.nil? && !cvar.type.nilable?
          return refuse(node, "class variable '#{cvar.name}' of #{cls.full_name} is not nilable (it's #{cvar.type.full_name}) so it must have an initializer")
        end
      end
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : ModuleDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(ModuleType)
      old_type = @current_type
      @current_type = t.as(ModuleType)
      node.body.accept(self)
      @current_type = old_type

      mod = t.as(ModuleType)
      mod.class_vars.each_value do |cvar|
        if cvar.initializer.nil? && !cvar.type.nilable?
          return refuse(node, "class variable '#{cvar.name}' of #{mod.full_name} is not nilable (it's #{cvar.type.full_name}) so it must have an initializer")
        end
      end
    end
    set_type(node, @program.nil_type)
    false
  end

  # A trait's body is typed in the trait's own type (hosted semantic_visitor.cr 1849-1856).
  def visit(node : TraitDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(TraitType)
      old_type = @current_type
      @current_type = t.as(TraitType)
      node.body.accept(self)
      @current_type = old_type
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Def) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Yield) : Bool
    if yn = @current_yield_nodes
      yn << node
    end
    node.exps.each do |exp|
      exp.accept(self)
    end

    if blk = @current_call_block
      old_vars = @vars
      old_scope = @scope
      blk_vars = if ctx = @current_block_context_vars
                   ctx.dup
                 else
                   @vars.dup
                 end

      i = 0
      while i < blk.args.size
        b_arg = blk.args[i]
        if i < node.exps.size
          if arg_t = child_type(node.exps[i])
            current_arg_t = type_of?(b_arg)
            new_arg_t = if cat = current_arg_t
                          @program.type_merge(cat, arg_t)
                        else
                          arg_t
                        end
            blk_vars[b_arg.name] = new_arg_t
            set_type(b_arg, new_arg_t)
          end
        end
        i = i + 1
      end
      @vars = blk_vars

      # The block's `break`s bind to the call that owns it, its `next`s to the block, and a `return`
      # leaves the def the block is written in (hosted Break, Next, Return).
      old_break_types = @break_types
      old_next_types = @next_types
      old_return_types = @return_types
      old_def_node = @current_def
      old_jump_proc = @jump_proc
      @break_types = @block_breaks[blk]?
      @next_types = [] of Type?
      callee_block = @current_call_block
      callee_context_vars = @current_block_context_vars
      callee_yield_nodes = @current_yield_nodes
      callee_type = @current_type
      callee_var_owners = @var_owners
      callee_var_unions = @var_unions
      callee_nil_candidates = @nil_candidates
      callee_nil_resets = @nil_resets
      callee_untyped_locals = @untyped_locals
      if owner = @block_owners[blk]?
        if writer_untyped = owner.untyped_locals
          @untyped_locals = writer_untyped.dup
          blk.args.each { |arg| @untyped_locals.delete(arg.name) }
        end
        if routed = owner.var_owners
          @var_owners = routed.dup
          # Block parameters shadow the caller even when their names coincide.
          blk.args.each { |arg| @var_owners.delete(arg.name) }
        end
        @var_unions = owner.local_storage.unions
        @nil_candidates = owner.local_storage.nil_candidates
        @nil_resets = owner.local_storage.nil_resets
        blk.args.each do |arg|
          if arg_type = type_of?(arg)
            merge_var_union(arg.name, arg_type)
          end
        end
        @current_def = owner.def_node
        @jump_proc = owner.jump_proc
        @return_types = owner.return_types
        @current_call_block = owner.call_block
        @current_block_context_vars = owner.context_vars
        @current_yield_nodes = owner.yield_nodes
        if writer_scope = owner.scope
          @scope = writer_scope
        end
        if writer_type = owner.writer_type
          @current_type = writer_type
        end
      else
        @jump_proc = nil
        @return_types = nil
        @current_call_block = nil
        @current_block_context_vars = nil
        @current_yield_nodes = nil
      end

      callee_imports = @program.current_imports
      callee_import_defs = @program.current_import_defs
      old_yield_type_filters = @type_filters
      old_yield_needs_filters = @needs_type_filters
      old_yield_unreachable = @unreachable
      @type_filters = nil
      @needs_type_filters = 0
      @unreachable = false
      enter_file_scope(blk)
      saved_jump_block = @jump_block
      saved_jump_block_context = @jump_block_context
      saved_jump_block_exits = @jump_block_exits
      saved_jump_whiles = @jump_whiles
      saved_block_may_repeat = @block_may_repeat
      @block_may_repeat = @block_may_repeat || !saved_jump_whiles.empty?
      @jump_block = blk
      @jump_block_context = callee_context_vars
      @jump_block_exits = if exit_owner = @block_owners[blk]?
                            exit_owner.exits
                          else
                            nil
                          end
      @jump_whiles = [] of While
      old_handler_direct_exit = @handler_direct_exit
      @handler_direct_exit = false
      saved_super_barrier = @super_barrier
      @super_barrier = "a block"
      entry_untyped_locals = @untyped_locals.dup
      blk.body.accept(self)
      # A yield in a loop can observe writes made by earlier invocations of
      # the block. Revisit the block with those captured values merged into
      # its entry flow, like hosted's loop-carried variable bindings.
      if @block_may_repeat
        if ctx = callee_context_vars
          ctx.each do |name, before|
            if after = @vars[name]?
              blk_vars[name] = @program.type_merge(before, after)
            end
          end
          blk.args.each do |arg|
            if arg_type = type_of?(arg)
              blk_vars[arg.name] = arg_type
            end
          end
          @vars = blk_vars
          @untyped_locals = entry_untyped_locals.dup
          blk_vars.each_key { |name| @untyped_locals.delete(name) }
          blk.body.accept(self)
        end
      end
      @block_may_repeat = saved_block_may_repeat
      @super_barrier = saved_super_barrier
      @current_type = callee_type
      @var_owners = callee_var_owners
      @var_unions = callee_var_unions
      @nil_candidates = callee_nil_candidates
      @nil_resets = callee_nil_resets
      @untyped_locals = callee_untyped_locals
      @jump_block = saved_jump_block
      @jump_block_context = saved_jump_block_context
      @jump_block_exits = saved_jump_block_exits
      @jump_whiles = saved_jump_whiles
      @handler_direct_exit = old_handler_direct_exit
      @type_filters = old_yield_type_filters
      @needs_type_filters = old_yield_needs_filters
      @unreachable = old_yield_unreachable
      @program.current_imports = callee_imports
      @program.current_import_defs = callee_import_defs
      @current_call_block = callee_block
      @current_block_context_vars = callee_context_vars
      @current_yield_nodes = callee_yield_nodes
      @scope = old_scope
      blk_type = merge_jump_values(child_type(blk.body), @next_types)
      if bt = blk_type
        set_type(blk, bt)
        set_type(node, bt)
      end

      if ctx = @current_block_context_vars
        ctx.keys.each do |k|
          # Block arguments own their slots (hosted call.cr: undef_vars); only
          # writes to captured names flow back to the caller.
          shadowed = false
          blk.args.each { |arg| shadowed = true if arg.name == k }
          next if shadowed
          if new_v = @vars[k]?
            ctx[k] = @program.type_merge(ctx[k], new_v)
          end
        end
      end

      @break_types = old_break_types
      @next_types = old_next_types
      @return_types = old_return_types
      @current_def = old_def_node
      @jump_proc = old_jump_proc
      @vars = old_vars
      @scope = old_scope

      if bt = blk_type
        if cd = @current_def
          if ba = cd.block_arg
            if r = ba.restriction
              if r.is_a?(ProcNotation)
                pn = r.as(ProcNotation)
                if out_node = pn.output
                  # `& : T -> _` leaves the block's result free (hosted: an Underscore output matches any type).
                  unless out_node.is_a?(Underscore)
                    # Hosted call.cr 1489-1493 restricts the block's result in the
                    # callee's match context. bind_yield_block_output bound an output
                    # variable before the body where it could; each yield is checked
                    # against that binding, and a variable still unbound binds here.
                    if free_names = cd.free_vars
                      if FreeBindings.mentions?(out_node, free_names)
                        bound = @def_free_types[cd]? || Hash(String, Type).new
                        unless FreeBindings.bind(out_node, bt, free_names, bound)
                          return refuse(node, "expected block to return #{out_node}, not #{bt.full_name}")
                        end
                        @def_free_types[cd] = bound
                      end
                    end
                    expected_ret = lookup_under(out_node, @scope)
                    # hosted call.cr 1433 and void_return_type?: a declared Nil or void output accepts any block value.
                    unless expected_ret.nil_type? || expected_ret.is_a?(VoidType) || bt.subtype_of?(expected_ret)
                      return refuse(node, "expected block to return #{expected_ret.full_name}, not #{bt.full_name}")
                    end
                  end
                end
              end
            end
          end
        end
      end
    else
      set_type(node, @program.nil_type)
    end
    false
  end

  def visit(node : Block) : Bool
    saved_super_barrier = @super_barrier
    @super_barrier = "a block"
    node.body.accept(self)
    @super_barrier = saved_super_barrier
    if bt = child_type(node.body)
      set_type(node, bt)
    end
    false
  end

  # The type a parameter's restriction names for a call on *rec_type*. A generic instance
  # (or its metaclass) binds its type parameters, so `v : T` on Box(Int32) is Int32 and
  # `Pointer(T)` is that pointer, as the hosted MatchContext binds them.
  # A splat restriction (`*T`) is not a type node: lookup_type_node would raise
  # "expected type, got *T". Nil here, so total mode records a refusal instead of aborting.
  def restriction_type(restriction : ASTNode, rec_type : Type) : Type?
    if restriction.is_a?(Splat)
      return nil
    end
    # A union restriction (`String | Path`, `T | Nil`) is each member, bound
    # the way a single name is, then merged. lookup_bound did not instantiate a
    # union node, so a call whose argument is one member was refused
    # "expected type, got String | Path".
    if restriction.is_a?(Union)
      return union_restriction_type(restriction.as(Union), rec_type)
    end
    owner = rec_type
    if owner.is_a?(MetaclassType)
      owner = owner.as(MetaclassType).instance_type
    end
    found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, restriction, owner)
    return found.as(Type) unless found.is_a?(LookupError)
    nil
  end

  # Each member of a union restriction, bound under the receiver, merged. A
  # member the quiet lookup misses is a total-mode placeholder, so a call still
  # matches the member it does have. Strict mode leaves the refusal.
  def union_restriction_type(node : Union, rec_type : Type) : Type?
    members = [] of Type
    i = 0
    while i < node.types.size
      member = restriction_type(node.types[i], rec_type)
      if member.nil? && @program.total_mode
        member = @program.lookup_type_node(node.types[i], @current_type)
      end
      return nil if member.nil?
      members << member.as(Type)
      i = i + 1
    end
    @program.type_merge(members)
  end

  def collect_candidate_defs(rec_type : Type, name : String, result : Array(Def), visited : Set(String)) : Nil
    return if visited.includes?(rec_type.full_name)
    visited.add(rec_type.full_name)
    if rec_type.is_a?(VirtualType)
      collect_candidate_defs(rec_type.as(VirtualType).base_type, name, result, visited)
      return
    end

    if rec_type.is_a?(ModuleType)
      mod = rec_type.as(ModuleType)
      if list = mod.defs[name]?
        list.each { |d| result << d }
      end
      mod.parents.each do |p|
        collect_candidate_defs(p, name, result, visited)
      end
    elsif rec_type.is_a?(GenericInstanceType)
      # A generic instance's defs are its generic type's (Box(Int32) has Box(T)'s initialize).
      collect_candidate_defs(rec_type.as(GenericInstanceType).generic_type, name, result, visited)
    end
  end

  # iyi: what a call with no receiver finds when the type it is written in has no such def: the
  # defs its file imported by name (`import a/b::{parse}`), then the program's own (hosted
  # Call#lookup_matches: `lookup_matches_in_type(program)` after the scope).
  def collect_scope_defs(rec_type : Type, name : String, result : Array(Def), visited : Set(String)) : Nil
    # The hosted call lookup walks lexical unit owners before imported and top-level defs.
    lexical : Type? = @current_type
    while lexical
      current = lexical.as(Type)
      break unless current.is_a?(ModuleType)
      mod = current.as(ModuleType)
      if mod.iyi_unit
        collect_candidate_defs(mod, name, result, Set(String).new)
        break unless result.empty?
      end
      break if mod.is_a?(SemanticProgram)
      lexical = mod.namespace
    end
    return nil unless result.empty?
    if imported = @program.current_import_defs[name]?
      imported.each { |d| result << d }
    end
    if result.empty? && !rec_type.is_a?(SemanticProgram)
      collect_candidate_defs(@program, name, result, visited)
    end
    nil
  end

  def format_method_display_name(rec_type : Type, name : String) : String
    if rec_type.is_a?(SemanticProgram)
      name
    elsif rec_type.is_a?(MetaclassType)
      "#{rec_type.as(MetaclassType).instance_type.full_name}.#{name}"
    else
      "#{rec_type.full_name}##{name}"
    end
  end

  def format_overload_signature(rec_type : Type, d : Def) : String
    args_strs = d.args.map do |arg|
      s = arg.name
      if r = arg.restriction
        s = "#{s} : #{r.to_s}"
      end
      if dv = arg.default_value
        s = "#{s} = #{dv.to_s}"
      end
      s
    end
    method_name = format_method_display_name(rec_type, d.name)
    "#{method_name}(#{args_strs.join(", ")})"
  end

  # Hosted Def#min_max_args_sizes counts positional arguments only.
  def min_max_args_sizes(d : Def) : Tuple(Int32, Int32)
    max_size = d.args.size
    default_index = -1
    i = 0
    while i < d.args.size
      if !d.args[i].default_value.nil?
        default_index = i
        break
      end
      i = i + 1
    end
    min_size = default_index >= 0 ? default_index : max_size
    if splat_index = d.splat_index
      min_size = splat_index
      if default_index >= 0 && default_index < splat_index
        min_size = default_index
      end
      splat = d.args[splat_index]
      if splat.name.empty?
        max_size = splat_index
      else
        if restriction = splat.restriction
          if !restriction.is_a?(Splat) && !(default_index >= 0 && default_index < splat_index)
            min_size = min_size + 1
          end
        end
        max_size = 2147483647
      end
    end
    {min_size, max_size}
  end

  def min_args_count(d : Def) : Int32
    min_max_args_sizes(d)[0]
  end

  def number_literal_matches_type?(literal : NumberLiteral, target_type : Type) : Bool
    t_name = target_type.full_name
    if t_name == "Number" || t_name == "Value" || t_name == "Object"
      return true
    end

    if target_type.is_a?(UnionType)
      return target_type.as(UnionType).union_types.any? { |ut| number_literal_matches_type?(literal, ut) }
    end

    val = literal.value.to_i?
    return false if val.nil?
    v = val.as(Int32)
    case t_name
    when "Int8"
      v >= -128 && v <= 127
    when "UInt8"
      v >= 0 && v <= 255
    when "Int16"
      v >= -32768 && v <= 32767
    when "UInt16"
      v >= 0 && v <= 65535
    when "Int32"
      true
    when "UInt32"
      v >= 0
    when "Int64", "UInt64", "Int128", "UInt128"
      v >= 0 || t_name.starts_with?("Int")
    when "Float32", "Float64"
      true
    else
      false
    end
  end

  # A splat restriction (`*T`) is not a type node, so the candidate check refuses
  # it. The calls lane binds that splat from the argument types. One match is the
  # def; several matches are not collapsed to the first (the calls lane answers
  # that as not ported). Nil leaves the refusal in place.
  def match_splat_with_calls(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call) : Def?
    arg_types = [] of Type
    i = 0
    while i < args.size
      t = child_type(args[i])
      return nil if t.nil?
      arg_types << t.as(Type)
      i = i + 1
    end
    block_present = false
    if call_node.block
      block_present = true
    end
    signature = CallSignature.new(name, arg_types, nil, block_present)
    target = CallRecalculation.recalculate_signature(rec_type, type_node_system(@program), signature, false, args, call_node.iyi_synthetic)
    return nil if target.error
    target.definition
  end

  def pinned_allows?(pinned : Array(Def)?, candidate : Def) : Bool
    return true if pinned.nil?
    pinned.each do |definition|
      return true if definition.object_id == candidate.object_id
    end
    false
  end

  def trace_arg_dispatch(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call, found : Matches, shortcut : Def?) : Nil
    return nil unless ENV["IYI_ARGDISPATCH_TRACE"]? == "1"
    interesting = false
    args.each do |arg|
      if arg_type = child_type(arg)
        if arg_type.is_a?(UnionType) || arg_type.is_a?(VirtualType) || arg_type.is_a?(NonGenericModuleType) || arg_type.is_a?(TraitType)
          interesting = true
        end
      end
    end
    return nil unless interesting
    location = call_node.location
    site = location.nil? ? "<generated>:0" : "#{location.as(Location).filename}:#{location.as(Location).line_number}"
    first_diff = false
    unless found.matches.empty?
      first_diff = shortcut.nil? || shortcut.as(Def).object_id != found.matches[0].definition.object_id
    end
    shortcut_name = shortcut.nil? ? "<none>" : format_overload_signature(rec_type, shortcut.as(Def))
    arm_names = [] of String
    found.matches.each do |match|
      arm_names << "#{match.defining.full_name}##{match.definition.name}(#{match.arg_types.map(&.full_name).join(",")})"
    end
    STDERR.puts "argdispatch #{site} #{name} arms=#{found.matches.size} first-diff=#{first_diff} shortcut=#{shortcut_name} targets=#{arm_names.join(";")}"
    nil
  end

  # Hosted method_lookup.cr:71-108 and 217-243: retain a separate level for
  # each owner so cover and module stopping happen at the same boundaries.
  # A generic instance metaclass can have the same printed name as its
  # generic metaclass parent; both levels still need to be visited.
  def collect_arm_levels(type : Type, name : String, walk : ArmWalk, levels : Array(Type), visited : Set(UInt64)) : Nil
    actual = type
    actual = actual.as(VirtualType).base_type if actual.is_a?(VirtualType)
    declaring = actual.is_a?(GenericInstanceType) ? actual.as(GenericInstanceType).generic_type : actual
    return nil unless declaring.is_a?(ModuleType)
    mod = declaring.as(ModuleType)
    return nil if visited.includes?(actual.object_id)
    visited.add(actual.object_id)
    levels << actual
    return nil unless MethodLookup.walks_parents?(mod, name)
    parents = actual.is_a?(GenericInstanceType) ? actual.as(GenericInstanceType).parents : mod.parents
    if walk == ArmWalk::Modules
      parents.each do |parent|
        break unless parent.is_a?(NonGenericModuleType) || parent.is_a?(GenericModuleType) || parent.is_a?(GenericModuleInstanceType) || parent.is_a?(GenericTraitInstanceType) || parent.is_a?(TraitType)
        collect_arm_levels(parent, name, walk, levels, visited)
      end
    else
      parents.each { |parent| collect_arm_levels(parent, name, walk, levels, visited) }
    end
    nil
  end

  def lookup_call_arms(lookup_in : Type, owner : Type, name : String, args : Array(ASTNode), call_node : Call, walk : ArmWalk, infer_class_vars : Bool = false) : Matches
    arg_types = [] of Type
    args.each do |arg|
      found = child_type(arg)
      return Matches.new([] of Match, false, "argument has no analysed type") if found.nil?
      arg_types << found.as(Type)
    end
    indexer = CallRecalculation.check_tuple_indexer(lookup_in, name, args, type_node_system(@program), @current_type)
    if indexer.is_a?(String)
      return Matches.new([] of Match, false, indexer.as(String))
    end
    if indexer.is_a?(Def)
      definition = indexer.as(Def)
      defining = @program.def_owner(definition) || @current_type
      return Matches.new([Match.new(definition, arg_types, owner, defining, true)], true)
    end
    named_types : Array(NamedArgumentType)? = nil
    if named = call_node.named_args
      collected = [] of NamedArgumentType
      named.each do |arg|
        found = child_type(arg.value)
        return Matches.new([] of Match, false, "named argument has no analysed type") if found.nil?
        collected << NamedArgumentType.new(arg.name, found.as(Type))
      end
      named_types = collected
    end
    signature = CallSignature.new(name, arg_types, named_types, !call_node.block.nil?)
    signature.infer_class_vars = infer_class_vars
    levels = [] of Type
    collect_arm_levels(lookup_in, name, walk, levels, Set(UInt64).new)
    if call_node.obj.nil?
      has_candidates = false
      levels.each do |level|
        declaring = level.is_a?(GenericInstanceType) ? level.as(GenericInstanceType).generic_type : level
        if declaring.is_a?(ModuleType) && MethodLookup.own_defs(declaring.as(ModuleType), name)
          has_candidates = true
        end
      end
      unless has_candidates
        scoped = [] of Def
        collect_scope_defs(lookup_in, name, scoped, Set(String).new)
        unless scoped.empty?
          if scope_owner = @program.def_owner(scoped[0])
            owner = scope_owner
            levels << scope_owner
          end
        end
      end
    end
    found = lookup_arm_levels(levels, owner, name, args, call_node, walk, signature)
    return found if found.error || !found.empty?
    named_nodes = [] of ASTNode
    named_arg_types = [] of Type
    if named = call_node.named_args
      named.each do |arg|
        named_nodes << arg.value
        named_arg_types << type_of(arg.value)
      end
    end
    unless NumericAutocast.any?(args, arg_types) || NumericAutocast.any?(named_nodes, named_arg_types)
      return found
    end
    signature.autocast_nodes = args
    signature.named_autocast_nodes = named_nodes
    widened = lookup_arm_levels(levels, owner, name, args, call_node, walk, signature)
    signature.autocast_nodes = nil
    signature.named_autocast_nodes = nil
    if widened.matches.size > 1
      if error = arm_autocast_ambiguity(widened.matches, args, named_nodes)
        return Matches.new([] of Match, false, error)
      end
    end
    if widened.error.nil? && !widened.matches.empty?
      cover = arm_autocast_cover(signature, widened.matches, args, named_nodes)
      return Matches.new(widened.matches, cover)
    end
    widened
  end

  def arm_autocast_ambiguity(matches : Array(Match), args : Array(ASTNode), named_nodes : Array(ASTNode)) : String?
    i = 0
    while i < args.size
      names = [] of String
      matches.each do |match|
        if i < match.declared.size
          text = match.declared[i].to_s
          names << text unless names.includes?(text)
        end
      end
      if names.size > 1 && NumericAutocast.supports?(args[i], type_of(args[i]))
        value = args[i].is_a?(NumberLiteral) ? args[i].as(NumberLiteral).value : "0"
        return NumericAutocast.ambiguity(value, names)
      end
      i += 1
    end
    i = 0
    while i < named_nodes.size
      names = [] of String
      matches.each do |match|
        if i < match.named_arg_types.size
          text = match.named_arg_types[i].type.to_s
          names << text unless names.includes?(text)
        end
      end
      if names.size > 1 && NumericAutocast.supports?(named_nodes[i], type_of(named_nodes[i]))
        value = named_nodes[i].is_a?(NumberLiteral) ? named_nodes[i].as(NumberLiteral).value : "0"
        return NumericAutocast.ambiguity(value, names)
      end
      i += 1
    end
    nil
  end

  def arm_autocast_cover(signature : CallSignature, matches : Array(Match), args : Array(ASTNode), named_nodes : Array(ASTNode)) : Bool
    types = [] of Type
    i = 0
    while i < signature.arg_types.size
      type = signature.arg_types[i]
      if i < args.size && i < matches[0].arg_types.size && NumericAutocast.supports?(args[i], type)
        type = matches[0].arg_types[i]
      end
      types << type
      i += 1
    end
    named_types : Array(NamedArgumentType)? = nil
    if named = signature.named_args
      collected = [] of NamedArgumentType
      i = 0
      while i < named.size
        type = named[i].type
        if i < named_nodes.size && i < matches[0].named_arg_types.size && NumericAutocast.supports?(named_nodes[i], type)
          type = matches[0].named_arg_types[i].type
        end
        collected << NamedArgumentType.new(named[i].name, type)
        i += 1
      end
      named_types = collected
    end
    CallCover.all?(CallSignature.new(signature.name, types, named_types, signature.block), matches)
  end

  def lookup_arm_levels(levels : Array(Type), owner : Type, name : String, args : Array(ASTNode), call_node : Call, walk : ArmWalk, signature : CallSignature) : Matches
    matches = [] of Match
    first_error : String? = nil
    levels.each do |level|
      declaring = level.is_a?(GenericInstanceType) ? level.as(GenericInstanceType).generic_type : level
      next unless declaring.is_a?(ModuleType)
      mod = declaring.as(ModuleType)
      defs = MethodLookup.own_defs(mod, name)
      next if defs.nil?
      ordered = defs.as(Array(Def))
      level_start = matches.size
      ordered.each do |definition|
        next if definition.abstract && !owner.is_a?(TraitType)
        next unless CallMatch.yields?(definition) == !call_node.block.nil?
        if call_node.named_args.nil? && definition.splat_index.nil?
          next if args.size < min_args_count(definition) || args.size > definition.args.size
        end
        old_imports = @program.current_imports
        old_defs = @program.current_import_defs
        old_type = @current_type
        defining = @program.def_owner(definition) || mod
        @current_type = defining
        enter_file_scope(definition)
        match_owner = owner
        match_owner = level if level.is_a?(GenericTraitInstanceType) || level.is_a?(GenericModuleInstanceType)
        if owner.is_a?(MetaclassType)
          instance = owner.as(MetaclassType).instance_type
          match_owner = instance if instance.is_a?(GenericInstanceType)
        end
        attempt = CallMatch.attempt(type_node_system(@program), signature, definition, match_owner, defining)
        @current_type = old_type
        @program.current_imports = old_imports
        @program.current_import_defs = old_defs
        if error = attempt.error
          first_error = error if first_error.nil?
        elsif match = attempt.match
          arm = match
          if match_owner != owner
            arm = Match.new(match.definition, match.arg_types, owner, match.defining, match.exact, match.named_arg_types, match.declared, match.bound)
          end
          matches << arm
          return Matches.new(matches, true) if arm.exact && signature.autocast_nodes.nil?
        end
      end
      if signature.autocast_nodes && matches.size > level_start
        return Matches.new(matches, true)
      end
      return Matches.new(matches, CallCover.all?(signature, matches)) if walk == ArmWalk::Modules && matches.size > level_start
      return Matches.new(matches, true) if signature.autocast_nodes.nil? && CallCover.all?(signature, matches)
    end
    return Matches.new(matches, false, first_error) if matches.empty? && first_error
    Matches.new(matches, CallCover.all?(signature, matches))
  end

  # The overload a call resolves to, or nil when it cannot: strict mode raises
  # the error, total mode records it on the call and returns nil.
  def lookup_method_matching(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call, pinned : Array(Def)? = nil, infer_class_vars : Bool = false) : Def?
    result = lookup_method_matching_impl(rec_type, name, args, call_node, pinned, infer_class_vars)
    if ENV["IYI_ARGDISPATCH_TRACE"]? == "1"
      found = lookup_call_arms(rec_type, rec_type, name, args, call_node, ArmWalk::Parents)
      trace_arg_dispatch(rec_type, name, args, call_node, found, result)
    end
    result
  end

  def lookup_method_matching_impl(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call, pinned : Array(Def)? = nil, infer_class_vars : Bool = false) : Def?
    i = 0
    while i < args.size
      return nil if child_type(args[i]).nil?
      i = i + 1
    end

    candidates = [] of Def
    # What the shared matcher looks the call up in: the receiver, or for a call with no receiver that found its defs
    # in the scope (a top-level generic helper called from a method), the owner of those defs. The matcher finds
    # defs through the type it is given, so it never saw the scope's.
    match_receiver = rec_type
    if pinned
      candidates = pinned.dup
    else
      indexer = CallRecalculation.check_tuple_indexer(rec_type, name, args, type_node_system(@program), @current_type)
      return indexer.as(Def) if indexer.is_a?(Def)
      return refuse_call(call_node, indexer) if indexer.is_a?(String)
      visited = Set(String).new
      collect_candidate_defs(rec_type, name, candidates, visited)
      if candidates.empty? && call_node.obj.nil?
        collect_scope_defs(rec_type, name, candidates, visited)
        if scope_owner = (candidates.empty? ? nil : @program.def_owner(candidates.first))
          match_receiver = scope_owner
        end
      end
    end
    # Hosted method_lookup.cr:253-256: a call with a block matches only a def
    # that yields, and a call without one matches only a def that does not.
    # Array(T).new(size) is the generated initialize new; Array(T).new(size) { }
    # is the yielding overload. Matching the other leaves the receiver untyped.
    wants_block = !call_node.block.nil?
    write_at = 0
    read_at = 0
    while read_at < candidates.size
      keep = CallMatch.yields?(candidates[read_at]) == wants_block
      if keep
        candidates[write_at] = candidates[read_at]
        write_at += 1
      end
      read_at += 1
    end
    while candidates.size > write_at
      candidates.pop
    end

    if candidates.empty?
      unless pinned.nil?
        return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name}")
      end
      if obj_node = call_node.obj
        obj_t = type_of(obj_node)
        if obj_t.is_a?(UnionType)
          return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name} (compile-time type is #{obj_t.full_name})")
        else
          return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name}")
        end
      else
        scope_name = if rec_type.is_a?(SemanticProgram)
                       "top-level"
                     else
                       rec_type.full_name
                     end
        return refuse_call(call_node, "undefined local variable or method '#{name}' for #{scope_name}")
      end
    end
    # The calls matcher binds splat restrictions as tuples, including an empty
    # argument list; the ordinary positional overload loop cannot resolve *T.
    if candidates.any? { |d| !d.splat_index.nil? }
      if splat_match = match_splat_with_calls(match_receiver, name, args, call_node)
        return splat_match if pinned_allows?(pinned, splat_match)
      end
    end

    # 1. Filter by argument count
    count_matches = [] of Def
    candidates.each do |d|
      min_a, max_a = min_max_args_sizes(d)
      # The variadic matcher above handles expanded named splats; the ordinary
      # positional matcher below indexes d.args and cannot consume their tail.
      if args.size >= min_a && args.size <= max_a && args.size <= d.args.size
        count_matches << d
      end
    end

    if count_matches.empty?
      if rescued = match_splat_with_calls(match_receiver, name, args, call_node)
        return rescued if pinned_allows?(pinned, rescued)
      end
      overload_lines = candidates.map { |d| " - #{format_overload_signature(rec_type, d)}" }
      overloads_str = "Overloads are:\n#{overload_lines.join("\n")}"
      method_disp = format_method_display_name(rec_type, name)
      expected_str = if candidates.size == 1
                       candidates.first.args.size.to_s
                     else
                       min_all = candidates.map { |d| min_args_count(d) }.min
                       max_all = candidates.map { |d| d.args.size }.max
                       min_all == max_all ? min_all.to_s : "#{min_all}..#{max_all}"
                     end
      return refuse_call(call_node, "wrong number of arguments for '#{method_disp}' (given #{args.size}, expected #{expected_str})\n#{overloads_str}")
    end

    # 2. Check exact / subtype argument matches. A restriction that is not a type
    # node (a splat `*T`) does not match this candidate. If no candidate matches,
    # that failure is a refusal naming the restriction, not a raise: total mode
    # records it and goes on. The calls integration binds the splat; this only
    # stops the abort.
    exact_matches = [] of Def
    unresolved_restriction : String? = nil
    count_matches.each do |d|
      # The restriction is written in the def's file, not the caller's: `Path`
      # in `File.chmod(path : String | Path)` is that file's import.
      old_imports = @program.current_imports
      old_import_defs = @program.current_import_defs
      old_candidate_type = @current_type
      if owner = @program.def_owner(d)
        @current_type = owner
      end
      enter_file_scope(d, true)
      all_args_match = true
      i = 0
      while i < args.size
        arg_type = type_of(args[i])
        param = d.args[i]
        if r = param.restriction
          expected = restriction_type(r, rec_type)
          if expected.nil?
            all_args_match = false
            unresolved_restriction = "expected type, got #{r.to_s}"
            break
          end
          unless arg_type.subtype_of?(expected.as(Type))
            all_args_match = false
            break
          end
        end
        i = i + 1
      end
      @current_type = old_candidate_type
      @program.current_imports = old_imports
      @program.current_import_defs = old_import_defs
      if all_args_match
        exact_matches << d
      end
    end

    if exact_matches.size > 0
      # Hosted lookup stops at the first exact match in declaration order.
      # Re-ranking here changes a forward-declared overload after the fact.
      selected = exact_matches.first
      @matched_call_args.delete(call_node)
      return selected
    end

    # The shared matcher handles splats, free variables and numeric widening
    # for both number literals and typed integers.
    arg_types = [] of Type
    args.each { |arg| arg_types << type_of(arg) }
    signature = CallSignature.new(name, arg_types, nil, call_node.block != nil)
    signature.infer_class_vars = infer_class_vars
    widened = CallRecalculation.recalculate_signature(match_receiver, type_node_system(@program), signature, false, args, call_node.iyi_synthetic)
    if widened.error.nil? && widened.definition && pinned_allows?(pinned, widened.definition.as(Def))
      @matched_call_args[call_node] = widened.arg_types
      return widened.definition
    end
    if message = widened.error
      if message.starts_with?("ambiguous call")
        return refuse_call(call_node, message)
      end
    end
    if ur = unresolved_restriction
      return refuse_call(call_node, ur)
    end

    # 4. Error reporting for no matching overload
    refuse_uncovered_with_defs(call_node, rec_type, name, args, count_matches)
  end

  def refuse_uncovered(call_node : Call, rec_type : Type, name : String, args : Array(ASTNode)) : Nil
    candidates = [] of Def
    visited = Set(String).new
    diagnostic_type = rec_type
    collect_candidate_defs(rec_type, name, candidates, visited)
    if candidates.empty? && call_node.obj.nil?
      collect_scope_defs(rec_type, name, candidates, visited)
      if owner = (candidates.empty? ? nil : @program.def_owner(candidates.first))
        diagnostic_type = owner
      end
    end
    # Preserve the unfiltered overloads for arity diagnostics. An empty
    # count_matches means the arguments have the wrong count, not that their
    # types failed to match. The hosted error excludes overloads with a
    # different block arity before listing the expected sizes.
    named = call_node.named_args
    if named.nil? || named.empty?
      compatible = candidates.select { |d| CallMatch.yields?(d) == !call_node.block.nil? }
      method_name = format_method_display_name(diagnostic_type, name)
      if wrong = CallError.wrong_number_for(method_name, args.size, compatible, candidates.size)
        refuse_call(call_node, wrong)
        return nil
      end
    end
    if candidates.empty? && (obj_node = call_node.obj)
      # Hosted call.cr raise_matches_not_found: a name no def of the receiver or its ancestors carries is
      # `undefined method`, not `no overload matches` (the same text lookup_method_matching_impl gives).
      obj_t = type_of?(obj_node)
      if obj_t.is_a?(UnionType)
        refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name} (compile-time type is #{obj_t.full_name})")
      else
        refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name}")
      end
      return nil
    end
    count_matches = [] of Def
    candidates.each do |definition|
      if args.size >= min_args_count(definition) && args.size <= definition.args.size
        count_matches << definition
      end
    end
    refuse_uncovered_with_defs(call_node, rec_type, name, args, count_matches)
    nil
  end

  def refuse_uncovered_with_defs(call_node : Call, rec_type : Type, name : String, args : Array(ASTNode), count_matches : Array(Def)) : Nil
    # Hosted call_error.cr:993-1005 formats types after argument typing. A
    # refused port child can lack one; retain the overload refusal and name the
    # source expression instead of raising while constructing its diagnostic.
    missing_type = false
    args.each do |arg|
      if type_of?(arg).nil?
        missing_type = true
        break
      end
    end
    if missing_type
      arg_types_strs = [] of String
      args.each do |arg|
        if arg_type = type_of?(arg)
          arg_types_strs << arg_type.full_name
        else
          arg_types_strs << arg.to_s
        end
      end
      method_disp = format_method_display_name(rec_type, name)
      overload_lines = count_matches.map { |d| " - #{format_overload_signature(rec_type, d)}" }
      plural = args.size > 1 ? "s" : ""
      refuse_call(call_node, "no overload matches '#{method_disp}' with type#{plural} #{arg_types_strs.join(", ")}\n\nOverloads are:\n#{overload_lines.join("\n")}")
      return nil
    end
    all_same_mismatch = true
    mismatch_idx = -1
    count_matches.each do |d|
      # Hosted compute_call_error_reason leaves splat restrictions out of
      # argument-type diagnostics and falls back to no-overload when none of
      # the non-splat overloads supplies a mismatch.
      next if d.splat_index
      first_mismatch = -1
      i = 0
      while i < args.size
        arg_t = type_of(args[i])
        param = d.args[i]
        if r = param.restriction
          exp_t = lookup_restriction_in_file(r, rec_type, d)
          unless arg_t.subtype_of?(exp_t)
            first_mismatch = i
            break
          end
        end
        i = i + 1
      end
      if mismatch_idx == -1
        mismatch_idx = first_mismatch
      elsif mismatch_idx != first_mismatch
        all_same_mismatch = false
      end
    end

    method_disp = format_method_display_name(rec_type, name)
    overload_lines = count_matches.map { |d| " - #{format_overload_signature(rec_type, d)}" }
    overloads_str = "Overloads are:\n#{overload_lines.join("\n")}"

    if all_same_mismatch && mismatch_idx != -1
      expected_types_list = [] of String
      count_matches.each do |d|
        next if d.splat_index
        param = d.args[mismatch_idx]
        if r = param.restriction
          exp_t = lookup_restriction_in_file(r, rec_type, d)
          expected_types_list << exp_t.full_name
        end
      end
      uniq_exp = [] of String
      expected_types_list.each do |en|
        uniq_exp << en unless uniq_exp.includes?(en)
      end
      expected_types_str = uniq_exp.join(" or ")
      actual_type_str = type_of(args[mismatch_idx]).full_name
      refuse_call(call_node, "expected argument ##{mismatch_idx + 1} to '#{method_disp}' to be #{expected_types_str}, not #{actual_type_str}\n\n#{overloads_str}")
    else
      arg_types_strs = args.map { |a| type_of(a).full_name }
      plural = (args.size > 1) ? "s" : ""
      refuse_call(call_node, "no overload matches '#{method_disp}' with type#{plural} #{arg_types_strs.join(", ")}\n\n#{overloads_str}")
    end
  end

  # Overload diagnostics resolve restrictions in the same file and owner as
  # matching, even when the caller is a generated definition probe.
  def lookup_restriction_in_file(node : ASTNode, receiver : Type, definition : Def) : Type
    old_imports = @program.current_imports
    old_import_defs = @program.current_import_defs
    old_type = @current_type
    if owner = @program.def_owner(definition)
      @current_type = owner
    end
    enter_file_scope(definition, true)
    result = lookup_under(node, receiver)
    @current_type = old_type
    @program.current_imports = old_imports
    @program.current_import_defs = old_import_defs
    result
  end

  # A call the port cannot resolve: strict mode raises, total mode records the
  # reason on the call and answers nil.
  def refuse_call(call_node : Call, message : String) : Nil
    refuse(call_node, message)
    nil
  end

  # Written blocks and blocks run by yielding defs keep their node identity.
  # A captured forwarded proc is identified by its component types instead.
  def instance_key(rec_type : Type, target_def : Def, args : Array(ASTNode), block : Block?, call_node : Call?) : String
    parts = [] of String
    args.each do |a|
      if at = child_type(a)
        parts << at.full_name
      else
        parts << "?"
      end
    end
    key = "#{rec_type.full_name}##{target_def.name}(#{parts.join(",")})"
    restrictions = [] of String
    target_def.args.each do |param|
      if restriction = param.restriction
        text = restriction.as(ASTNode).to_s
        restrictions << "#{text.bytesize}:#{text}"
      else
        restrictions << "0:"
      end
    end
    key = key + "|signature(" + restrictions.join(",") + ")"
    if index = target_def.splat_index
      key = key + "|splat=#{index}"
    end
    key = key + "|double-splat" unless target_def.double_splat.nil?
    key = key + "|block-arg" unless target_def.block_arg.nil?
    if owner = @program.def_owner(target_def)
      key = key + "^#{owner.full_name}"
    end
    if blk = block
      key = key + block_key(target_def, blk, call_node)
    end
    key
  end

  # Hosted DefInstanceKey includes named argument names and types in written
  # order (call.cr:623-630) and a captured block's type. The original def, not
  # its per-call wrapper, is the cache identity.
  def def_instance_key(origin : Def, rec_type : Type, call_node : Call) : String?
    block = call_node.block
    return nil if block && origin.block_arg.nil?
    parts = [] of String
    i = 0
    while i < call_node.args.size
      at = child_type(call_node.args[i])
      return nil if at.nil?
      parts << at.full_name
      i = i + 1
    end
    key_owner = rec_type
    if owner = @program.def_owner(origin)
      key_owner = owner if owner.iyi_unit
    end
    key = "#{origin.node_id}|#{key_owner.full_name}(#{parts.join(",")})"
    if named = call_node.named_args
      entries = [] of String
      j = 0
      while j < named.size
        named_type = child_type(named[j].value)
        return nil if named_type.nil?
        arg_name = named[j].name
        text = named_type.full_name
        entries << "#{arg_name.bytesize}:#{arg_name}=#{text.bytesize}:#{text}"
        j = j + 1
      end
      key = key + "|named(" + entries.join(",") + ")"
    end
    if blk = block
      key = key + block_key(origin, blk, call_node)
    end
    key
  end

  # A call wraps &proc in a fresh Block on each visit. A capturing def uses the
  # proc's type, but written blocks and blocks run by yielding defs need their
  # own node because their bodies are typed in that instance.
  def block_key(callee : Def, block : Block, call_node : Call?) : String
    if callee.uses_block_arg?
      if call = call_node
        if forwarded = call.block_arg
          if literal = block.fun_literal
            if literal.node_id == forwarded.node_id
              if proc_type = child_type(forwarded)
                if proc_type.is_a?(ProcInstanceType)
                  parts = [] of String
                  proc_type.as(ProcInstanceType).arg_types.each do |arg_type|
                    text = arg_type.full_name
                    parts << "#{text.bytesize}:#{text}"
                  end
                  text = proc_type.as(ProcInstanceType).return_type.full_name
                  parts << "#{text.bytesize}:#{text}"
                  return "&proc(" + parts.join(",") + ")"
                end
              end
            end
          end
        end
      end
    end
    "&#{block.node_id}"
  end

  # Reuse a written block only for the caller flow and storage it was typed for,
  # then merge its recorded writes into the caller's current flow.
  def cached_instance(key : String?) : DefInstance?
    if k = key
      if instance = @def_instances[k]?
        @speculation.recursive_frames.each do |frame|
          if frame.key == k && frame.definition.return_type.nil?
            unless frame.cyclic
              frame.cyclic = true
              @speculation.depth = @speculation.depth + 1
            end
            return DefInstance.new(instance.definition, nil) unless frame.estimating
            break
          end
        end
        if flow = instance.block_flow
          return nil unless block_flow_holds?(flow)
        end
        if @speculation.dirty_keys[k]?
          @speculation.taint = @speculation.taint + 1
        end
        if flow = instance.block_flow
          replay_block_flow(flow)
        end
        return instance
      end
    end
    nil
  end

  def block_flow_holds?(flow : BlockFlow) : Bool
    return false unless flow.storage.object_id == @var_unions.object_id
    block_entry_holds?(flow)
  end

  def block_entry_holds?(flow : BlockFlow) : Bool
    flow.names.each do |name|
      recorded = flow.entry[name]?
      if now = @vars[name]?
        return false if recorded.nil?
        return false if now != recorded.as(Type)
      else
        return false unless recorded.nil?
      end
    end
    true
  end

  # Apply the same merge as fresh body typing, using only the recorded changes.
  def replay_block_flow(flow : BlockFlow) : Nil
    flow.delta.each do |name, written|
      if now = @vars[name]?
        @vars[name] = @program.type_merge(now, written) if now != written
      end
    end
    nil
  end

  def capture_block_flow(blk : Block, caller_vars : Hash(String, Type), storage : Hash(String, Type), ctx : Hash(String, Type)) : BlockFlow
    walk = BlockNames.new(self)
    blk.body.accept(walk)
    entry = Hash(String, Type).new
    walk.names.each do |name|
      if t = caller_vars[name]?
        entry[name] = t
      end
    end
    delta = Hash(String, Type).new
    ctx.each do |name, left|
      if before = caller_vars[name]?
        delta[name] = left if before != left
      end
    end
    BlockFlow.new(storage, walk.names, entry, delta)
  end

  # Only captured names leave a yielded block; its arguments own their slots.
  def merge_block_exit(flow : Hash(String, Type), state : Hash(String, Type), blk : Block) : Nil
    flow.each do |name, before|
      shadowed = false
      blk.args.each { |arg| shadowed = true if arg.name == name }
      next if shadowed
      if left = state[name]?
        flow[name] = @program.type_merge(before, left) unless before == left
      end
    end
    nil
  end

  # Caches a finished instance, including one with a refused body and a declared
  # return type. Its recorded refusals remain attached to the cached definition.
  def remember_def_instance(key : String?, definition : Def, return_type : Type?, block_flow : BlockFlow? = nil) : Nil
    if k = key
      unless @speculation.recursive_frames.empty? || @def_instances.has_key?(k)
        @speculation.recursive_cache_writes << k
      end
      @def_instances[k] = DefInstance.new(definition, return_type, block_flow)
    end
    nil
  end

  # A recursive call or an over-deep instantiation is refused at the call site, or
  # at the def's body when there is no site.
  def refuse_recursion(site : ASTNode?, target_def : Def, message : String) : Type?
    anchor : ASTNode = target_def.body.as(ASTNode)
    if s = site
      anchor = s
    end
    refuse(anchor, message)
    nil
  end

  # The type a body evaluates to with `args` bound to its parameters, or nil when
  # the body or an argument cannot be typed. `site` is the node that reports a
  # return-type mismatch.
  # `cache_key` (see def_instance_key) caches the finished instance; nil caches nothing.
  def type_method_body(target_def : Def, rec_type : Type, args : Array(ASTNode), block : Block?, site : ASTNode? = nil, cache_key : String? = nil, call_node : Call? = nil) : Type?
    old_imports = @program.current_imports
    old_import_defs = @program.current_import_defs
    enter_file_scope(target_def)
    old_current_type = @current_type
    body_receiver = rec_type
    lookup_owner : Type = rec_type
    if owner = @program.def_owner(target_def)
      if owner.iyi_unit
        body_receiver = owner
        lookup_owner = owner
      else
        lookup_owner = body_lookup_owner(owner, rec_type)
      end
    end
    enter_owner_scope(lookup_owner)
    entry_mark = @speculation.entries.size
    taint_mark = @speculation.taint
    result = type_method_body_in_file(target_def, body_receiver, args, block, site, cache_key, old_current_type, call_node)
    # A failed inference must not leave the recursive seed in the cache.
    if result.nil? && target_def.return_type.nil?
      if abandoned = cache_key
        @def_instances.delete(abandoned)
        @speculation.dirty_keys.delete(abandoned)
      end
    end
    if k = cache_key
      entries = @speculation.entries
      if entries.size > entry_mark && entries[entry_mark].key == k
        entry = entries[entry_mark]
        entry.window_end = entries.size
        if @speculation.taint > taint_mark
          entry.dirty = true
          @speculation.dirty_keys[k] = true
        end
      end
    end
    @current_type = old_current_type
    @program.current_imports = old_imports
    @program.current_import_defs = old_import_defs
    result
  end

  # Non-generic bodies resolve names from their defining type, separately from dynamic self
  # (hosted call.cr: path_lookup). Parameterized owners still need the receiver's bindings;
  # resolving their instantiated ancestor or trait scope is not implemented here.
  def body_lookup_owner(owner : ModuleType, rec_type : Type) : Type
    declared : Type = owner
    if declared.is_a?(MetaclassType)
      declared = declared.as(MetaclassType).instance_type
    end
    return rec_type if declared.is_a?(SemanticProgram) || declared.is_a?(LibType)
    return owner if declared.is_a?(NonGenericClassType) || declared.is_a?(NonGenericModuleType)
    rec_type
  end

  # Enter the chosen lexical scope. Dynamic self remains the receiver in @scope.
  # A generic instance contributes its generic type; a metaclass names its instance type.
  def enter_owner_scope(rec_type : Type) : Nil
    owner : Type = rec_type
    if owner.is_a?(MetaclassType)
      owner = owner.as(MetaclassType).instance_type
    end
    if owner.is_a?(GenericInstanceType)
      owner = owner.as(GenericInstanceType).generic_type
    end
    if owner.is_a?(ModuleType)
      @current_type = owner.as(ModuleType)
    end
    nil
  end

  # iyi: the names a node's file imported become the names in scope (SPEC.md R-2b). A node with
  # no location (a generated def) keeps the scope it is typed from.
  def enter_file_scope(node : ASTNode, required : Bool = false) : Nil
    if loc = node.location
      filename = normalize_path(loc.filename)
      imports = @program.file_imports[loc.filename]? || @program.file_imports[filename]?
      defs = @program.file_import_defs[loc.filename]? || @program.file_import_defs[filename]?
      if required && (imports.nil? || defs.nil?)
        raise("missing import table for #{loc.filename}")
      end
      @program.current_imports = imports || Hash(String, Type).new
      @program.current_import_defs = defs || Hash(String, Array(Def)).new
    end
    nil
  end

  # Return annotations belong to the callee's match context, not the caller's.
  def lookup_def_return(node : ASTNode, owner : Type?, definition : Def) : Type
    saved_def = @current_def
    @current_def = definition
    result = lookup_under(node, owner)
    @current_def = saved_def
    result
  end

  # Hosted return annotations remove aliases and read Void as Nil (call.cr 840-843).
  # Install the type system before resolving an alias of a generic.
  def return_contract(node : ASTNode, owner : Type?, definition : Def) : Type
    type_node_system(@program)
    declared = @program.remove_alias(lookup_def_return(node, owner, definition))
    return @program.nil_type if declared.is_a?(VoidType)
    declared
  end

  def type_method_body_in_file(target_def : Def, rec_type : Type, args : Array(ASTNode), block : Block?, site : ASTNode?, cache_key : String?, writer_type : ModuleType, call_node : Call?) : Type?
    # Hosted call.cr binds the match's free variables from the call arguments,
    # including for primitive and recursive definitions with no body to visit.
    call_arg_types = [] of Type
    args.each_with_index do |call_arg, index|
      call_arg_type = child_type(call_arg)
      if call_node
        if matched = @matched_call_args[call_node]?
          call_arg_type = matched[index] if index < matched.size
        end
      end
      call_arg_types << call_arg_type.as(Type) unless call_arg_type.nil?
    end
    if call_arg_types.size == args.size
      if free_types = FreeBindings.of_def(target_def, call_arg_types, type_node_system(@program))
        @def_free_types[target_def] = free_types unless free_types.empty?
      end
    end
    # A captured block is typed in its writer before the callee body. Its output
    # binds the match context used by the callee's body and return annotation
    # (hosted call.cr 1259-1293, 1336-1432).
    captured_block_type : Type? = nil
    if target_def.uses_block_arg?
      if blk = block
        if ba = target_def.block_arg
          if restriction = ba.restriction
            if restriction.is_a?(ProcNotation)
              notation = restriction.as(ProcNotation)
              input_types = [] of Type
              if inputs = notation.inputs
                inputs.each { |input| input_types << lookup_def_return(input, rec_type, target_def) }
              end
              if existing = blk.fun_literal
                captured_block_type = child_type(existing)
                # Hosted call.cr:1424-1432 restricts every typed ProcLiteral's
                # result against the block output, including a reused literal.
                if captured_block_type.is_a?(ProcInstanceType)
                  if output = notation.output
                    if free_names = target_def.free_vars
                      bound = @def_free_types[target_def]? || Hash(String, Type).new
                      unless FreeBindings.bind(output, captured_block_type.as(ProcInstanceType).return_type, free_names, bound)
                        refuse(blk, "expected block to return #{output}, not #{captured_block_type.as(ProcInstanceType).return_type.full_name}")
                        return nil
                      end
                      @def_free_types[target_def] = bound unless bound.empty?
                    end
                  end
                end
                # Hosted call.cr:1370-1372,1427-1440,1525-1541 checks
                # a forwarded proc's parameters and binds its output.
                if forwarded_call = call_node
                  if forwarded_call.block_arg && captured_block_type.is_a?(ProcInstanceType)
                    proc_type = captured_block_type.as(ProcInstanceType)
                    if proc_type.arg_types.size != input_types.size
                      refuse(blk, "wrong number of block argument's parameters (given #{proc_type.arg_types.size}, expected #{input_types.size})")
                      return nil
                    end
                    input_types.each_with_index do |input, index|
                      actual = proc_type.arg_types[index]
                      unless actual.full_name == input.full_name
                        refuse(blk, "expected block argument's parameter ##{index + 1} to be #{input.full_name}, not #{actual.full_name}")
                        return nil
                      end
                    end
                    if output = notation.output
                      unless output.is_a?(Underscore)
                        expected = lookup_def_return(output, rec_type, target_def)
                        unless return_fits?(proc_type.return_type, expected)
                          refuse(blk, "expected block to return #{expected.full_name}, not #{proc_type.return_type.full_name}")
                          return nil
                        end
                      end
                    end
                  end
                end
              else
                saved_vars = @vars
                saved_type = @current_type
                saved_imports = @program.current_imports
                saved_import_defs = @program.current_import_defs
                @vars = @vars.dup
                blk.args.each_with_index do |arg, index|
                  if index < input_types.size
                    @vars[arg.name] = input_types[index]
                    set_type(arg, input_types[index])
                  end
                end
                @current_type = writer_type
                enter_file_scope(blk)
                saved_super_barrier = @super_barrier
                @super_barrier = "a captured block"
                literal_args = [] of Arg
                input_types.each_with_index do |input_type, index|
                  name = index < blk.args.size ? blk.args[index].name : "__arg#{index}"
                  literal_arg = Arg.new(name)
                  set_type(literal_arg, input_type)
                  literal_args << literal_arg
                end
                literal_def = Def.new("->", literal_args, blk.body).at(blk)
                literal_def.captured_block = true
                saved_proc = @jump_proc
                saved_proc_block = @jump_block
                saved_proc_var_unions = @var_unions
                saved_proc_nil_candidates = @nil_candidates
                saved_proc_nil_resets = @nil_resets
                saved_proc_whiles = @jump_whiles
                saved_proc_next_types = @next_types
                saved_proc_break_types = @break_types
                saved_proc_return_types = @return_types
                saved_proc_while_break_vars = @while_break_vars
                saved_proc_while_next_vars = @while_next_vars
                saved_proc_unreachable = @unreachable
                saved_proc_type_filters = @type_filters
                saved_proc_needs_type_filters = @needs_type_filters
                saved_proc_handler_direct_exit = @handler_direct_exit
                saved_proc_handler_inside_ensure = @handler_inside_ensure
                saved_proc_handler_inside_defer = @handler_inside_defer
                proc_nexts = [] of Type?
                @jump_proc = literal_def
                @jump_block = nil
                @var_unions = Hash(String, Type).new
                @nil_candidates = Set(String).new
                @nil_resets = Set(String).new
                @jump_whiles = [] of While
                @next_types = proc_nexts
                @break_types = nil
                @return_types = nil
                @while_break_vars = [] of Array(Hash(String, Type))
                @while_next_vars = [] of Array(Hash(String, Type))
                @unreachable = false
                @type_filters = nil
                @needs_type_filters = 0
                @handler_direct_exit = false
                @handler_inside_ensure = false
                @handler_inside_defer = false
                blk.body.accept(self)
                @super_barrier = saved_super_barrier
                block_type = merge_jump_values(child_type(blk.body), proc_nexts)
                @jump_proc = saved_proc
                @jump_block = saved_proc_block
                @var_unions = saved_proc_var_unions
                @nil_candidates = saved_proc_nil_candidates
                @nil_resets = saved_proc_nil_resets
                @jump_whiles = saved_proc_whiles
                @next_types = saved_proc_next_types
                @break_types = saved_proc_break_types
                @return_types = saved_proc_return_types
                @while_break_vars = saved_proc_while_break_vars
                @while_next_vars = saved_proc_while_next_vars
                @unreachable = saved_proc_unreachable
                @type_filters = saved_proc_type_filters
                @needs_type_filters = saved_proc_needs_type_filters
                @handler_direct_exit = saved_proc_handler_direct_exit
                @handler_inside_ensure = saved_proc_handler_inside_ensure
                @handler_inside_defer = saved_proc_handler_inside_defer
                @vars = saved_vars
                @current_type = saved_type
                @program.current_imports = saved_imports
                @program.current_import_defs = saved_import_defs
                if bt = block_type
                  resolved_output : Type? = nil
                  if (output = notation.output) && !output.is_a?(Underscore)
                    free_output = false
                    if output.is_a?(Path)
                      if free_names = target_def.free_vars
                        names = output.as(Path).names
                        free_output = names.size == 1 && free_names.includes?(names[0])
                      end
                    end
                    if free_output
                      # Hosted call.cr 1442-1446 leaves this Block unbound;
                      # fix_missing_types.cr 66-75 later makes it NoReturn.
                      # The result is the literal's Proc return type, not the Block type.
                      set_type(blk, @program.no_return_type)
                    else
                      resolved_output = lookup_def_return(output, rec_type, target_def)
                      set_type(blk, resolved_output.as(Type))
                    end
                    if free_names = target_def.free_vars
                      bound = @def_free_types[target_def]? || Hash(String, Type).new
                      if FreeBindings.bind(output, bt, free_names, bound)
                        @def_free_types[target_def] = bound unless bound.empty?
                      end
                    end
                  else
                    # Hosted call.cr:1424-1446 leaves a captured wildcard or
                    # absent output unbound; FixMissingTypes:66-75 gives the
                    # Block NoReturn, while the Proc keeps its body's type.
                    set_type(blk, @program.no_return_type)
                  end
                  result_type = resolved_output || bt
                  literal = ProcLiteral.new(literal_def)
                  if call = call_node
                    literal.at(call)
                  end
                  captured_block_type = ProcInstanceType.new(@program, input_types, result_type)
                  set_type(literal_def, result_type)
                  set_type(literal, captured_block_type.as(Type))
                  blk.fun_literal = literal
                end
              end
            end
          end
        end
      end
    end
    return nil unless bind_yield_block_output(target_def, rec_type, block, writer_type, site, call_node)
    body = target_def.body
    if body.nil? || body.is_a?(MacroLiteral)
      if rt = target_def.return_type
        return return_contract(rt, rec_type, target_def)
      else
        return @program.nil_type
      end
    end

    # A requirement supplies a return contract. Keep its absent implementation out
    # of the typed-instance cache and the lowering probes.
    if target_def.abstract
      if rt = target_def.return_type
        return return_contract(rt, rec_type, target_def)
      end
      anchor : ASTNode = target_def.body.as(ASTNode)
      if s = site
        anchor = s
      elsif c = call_node
        anchor = c
      end
      refuse(anchor, "cannot resolve the call to abstract def '#{target_def.name}': it declares no return type, and dispatch to its implementers is not ported")
      return nil
    end

    # Recursive spellings share the active definition and its current estimate.
    # The depth bounds instantiations whose argument types keep growing.
    key = instance_key(rec_type, target_def, args, block, call_node)
    if @typing_stack.includes?(key)
      active : RecursiveFrame? = nil
      @speculation.recursive_frames.each do |frame|
        if frame.stack_key == key
          active = frame
          break
        end
      end
      if active.nil?
        return refuse_recursion(site, target_def, "a recursive call reached '#{target_def.name}' before its frame")
      end
      frame = active.as(RecursiveFrame)
      if call = call_node
        @call_target_defs[call] = frame.definition
      end
      if rt = target_def.return_type
        return return_contract(rt, rec_type, target_def)
      end
      unless frame.cyclic
        frame.cyclic = true
        @speculation.depth = @speculation.depth + 1
      end
      return frame.estimating ? frame.estimate : nil
    end
    if @typing_stack.size >= 256
      return refuse_recursion(site, target_def, "instantiation depth exceeded at '#{target_def.name}'")
    end

    saved_jump_block = @jump_block
    saved_jump_proc = @jump_proc
    saved_jump_whiles = @jump_whiles
    @jump_block = nil
    @jump_proc = nil
    @jump_whiles = [] of While
    old_vars = @vars
    old_handler_vars = @handler_vars
    old_handler_writes = @handler_writes
    @handler_vars = [] of Hash(String, Type)
    @handler_writes = [] of Set(String)
    old_handler_inside_ensure = @handler_inside_ensure
    old_handler_inside_defer = @handler_inside_defer
    old_handler_direct_exit = @handler_direct_exit
    @handler_inside_ensure = false
    @handler_inside_defer = false
    @handler_direct_exit = false
    old_scope = @scope
    old_def = @current_def
    old_block_call = @current_call_block
    old_block_context_vars = @current_block_context_vars
    old_yield_nodes = @current_yield_nodes
    old_var_unions = @var_unions
    old_nil_candidates = @nil_candidates
    old_nil_resets = @nil_resets
    old_var_owners = @var_owners
    old_untyped_locals = @untyped_locals
    @untyped_locals = Hash(String, String).new
    @var_unions = Hash(String, Type).new
    @nil_candidates = Set(String).new
    @nil_resets = Set(String).new
    @var_owners = Hash(String, LocalStorage).new
    old_break_types = @break_types
    old_next_types = @next_types
    old_return_types = @return_types
    old_type_filters = @type_filters
    old_needs_type_filters = @needs_type_filters
    old_unreachable = @unreachable
    @type_filters = nil
    @needs_type_filters = 0
    @unreachable = false
    old_while_break_vars = @while_break_vars
    old_while_next_vars = @while_next_vars
    @while_break_vars = [] of Array(Hash(String, Type))
    @while_next_vars = [] of Array(Hash(String, Type))
    @break_types = nil
    @next_types = nil
    @return_types = [] of Type?

    if block
      # A yielded block also sees the names narrowed out in its writer's flow.
      @current_block_context_vars = @vars.dup
      @current_yield_nodes = [] of Yield
      if blk = block
        writer_owners = old_var_owners.dup
        writer_storage = LocalStorage.new(old_var_unions, old_nil_candidates, old_nil_resets)
        @vars.each_key { |name| writer_owners[name] = writer_storage unless writer_owners.has_key?(name) }
        @block_owners[blk] = BlockOwner.new(@current_def, old_return_types, old_block_call, old_block_context_vars, old_yield_nodes, old_scope, writer_type, writer_owners, old_untyped_locals, saved_jump_proc)
      end
    end

    new_vars = Hash(String, Type).new
    if rec_type.is_a?(MetaclassType)
      new_vars["self"] = rec_type
    elsif rec_type.is_a?(SemanticProgram)
      # No self at top-level
    else
      new_vars["self"] = rec_type
    end

    inst_args = [] of Type
    params_typed = true
    i = 0
    while i < target_def.args.size
      param = target_def.args[i]
      param_type : Type? = nil
      splat_index = target_def.splat_index
      if splat_index && i == splat_index.as(Int32)
        # Hosted call.cr binds the splat local to a tuple, including the empty tuple.
        elements = [] of Type
        suffix = target_def.args.size - i - 1
        end_index = args.size - suffix
        j = i
        while j < end_index
          if element_type = child_type(args[j])
            elements << element_type
          else
            params_typed = false
          end
          j = j + 1
        end
        param_type = tuple_type_of(@program, elements)
      elsif splat_index && i > splat_index.as(Int32)
        arg_index = args.size - (target_def.args.size - i)
        param_type = child_type(args[arg_index]) if arg_index >= 0 && arg_index < args.size
      elsif i < args.size
        param_type = child_type(args[i])
        if call_node
          if matched = @matched_call_args[call_node]?
            param_type = matched[i] if i < matched.size
          end
        end
      elsif dv = param.default_value
        dv.accept(self)
        param_type = child_type(dv)
      elsif r = param.restriction
        param_type = lookup_under(r, rec_type)
      else
        param_type = @program.nil_type
      end
      if pt = param_type
        new_vars[param.name] = pt
        inst_args << pt
        # iyi: the instantiated clone's parameter carries its type, so the lowering
        # reads the argument types from the def (hosted codegen/ast.cr 48).
        set_type(param, pt)
        if param.name.starts_with?("@") && !param.name.starts_with?("@@")
          if rec_type.is_a?(ModuleType)
            rec_type.as(ModuleType).instance_vars[param.name] = MetaTypeVar.new(param.name, pt)
          end
        end
      else
        params_typed = false
      end
      i = i + 1
    end
    if bt = captured_block_type
      if ba = target_def.block_arg
        new_vars[ba.name] = bt
        set_type(ba, bt)
      end
    end
    @vars = new_vars
    @scope = rec_type
    @current_def = target_def
    @current_call_block = block

    @typing_stack << key
    if params_typed
      self_t : Type? = nil
      unless rec_type.is_a?(SemanticProgram)
        self_t = rec_type
      end
      @typed_instances << TypedInstance.new(target_def, self_t, inst_args)
      # Hosted Call#instantiate registers the typed def before visiting its body
      # (semantic/call.cr 628-630, body at 714). A recursive call must target this
      # object, whose parameters already carry their instantiated types, not a fresh clone.
      provisional : Type = @program.no_return_type
      if declared = target_def.return_type
        provisional = return_contract(declared, rec_type, target_def)
      end
      set_type(target_def, provisional)
      remember_def_instance(cache_key, target_def, provisional)
      if k = cache_key
        if @speculation.depth > 0
          entries = @speculation.entries
          entries << SpeculativeEntry.new(k, @typed_instances.last, entries.size + 1)
        end
      end
    end
    body = splice_def_body(body.as(ASTNode))
    target_def.body = body.as(ASTNode)
    recursive_frame = RecursiveFrame.new(cache_key, target_def, key)
    @speculation.recursive_frames << recursive_frame
    recursive_cache_mark = @speculation.recursive_cache_writes.size
    recursive_instance_mark = @typed_instances.size
    recursive_entry_mark = @speculation.entries.size
    recursive_refusal_mark = @refusals.size
    recursive_start_vars = @vars.dup
    recursive_start_dead_depth = @dead_depth
    recursive_start_context = if ctx = @current_block_context_vars
                                ctx.dup
                              else
                                nil
                              end
    saved_super_barrier = @super_barrier
    @super_barrier = nil
    body.as(ASTNode).accept(self)
    @super_barrier = saved_super_barrier
    body_type = merge_jump_values(child_type(body.as(ASTNode)), @return_types)
    recursive_error : String? = nil
    if recursive_frame.cyclic
      # Hosted call.cr installs the instance before visiting its body, and
      # bindings.cr propagates the inferred type to dependent calls. Revisit
      # against growing estimates rather than retaining the seed's bindings.
      estimate = body_type
      settled = false
      commit_pass = false
      passes = 0
      committed = false
      recursive_frame.estimating = true
      while passes < 10
        passes += 1
        body.as(ASTNode).accept(RecursiveClear.new(self))
        writes = @speculation.recursive_cache_writes
        index = recursive_cache_mark
        while index < writes.size
          @def_instances.delete(writes[index])
          @speculation.dirty_keys.delete(writes[index])
          index += 1
        end
        writes.truncate(0, recursive_cache_mark)
        @typed_instances.truncate(0, recursive_instance_mark)
        @speculation.entries.truncate(0, recursive_entry_mark)
        truncate_refusals(recursive_refusal_mark)
        @vars = recursive_start_vars.dup
        @var_unions = Hash(String, Type).new
        @nil_candidates = Set(String).new
        @nil_resets = Set(String).new
        @var_owners = Hash(String, LocalStorage).new
        @untyped_locals = Hash(String, String).new
        @return_types = [] of Type?
        @type_filters = nil
        @needs_type_filters = 0
        @unreachable = false
        @flow_dead = false
        @dead_depth = recursive_start_dead_depth
        @while_break_vars = [] of Array(Hash(String, Type))
        @while_next_vars = [] of Array(Hash(String, Type))
        @jump_whiles = [] of While
        @current_block_context_vars = if ctx = recursive_start_context
                                        ctx.dup
                                      else
                                        nil
                                      end
        @current_yield_nodes = [] of Yield if block
        if blk = block
          if exit_owner = @block_owners[blk]?
            exit_owner.exits.truncate(0, 0)
          end
        end
        assumed = estimate || @program.no_return_type
        remember_def_instance(cache_key, target_def, commit_pass ? assumed : estimate)
        recursive_frame.estimate = commit_pass ? assumed : estimate
        @super_barrier = nil
        body.as(ASTNode).accept(self)
        @super_barrier = saved_super_barrier
        next_type = merge_jump_values(child_type(body.as(ASTNode)), @return_types)
        if commit_pass
          committed = true
          body_type = next_type
          unless next_type && next_type.full_name == assumed.full_name
            recursive_error = "recursive return type of '#{target_def.name}' changed in the final pass"
          end
          break
        end
        merged = if old = estimate
                   if current = next_type
                     merge_flow(old, current)
                   else
                     old
                   end
                 else
                   next_type
                 end
        if (estimate.nil? && merged.nil?) || (estimate && merged && estimate.as(Type).full_name == merged.as(Type).full_name)
          estimate = merged
          settled = true
          commit_pass = true
          @speculation.depth = @speculation.depth - 1
        else
          estimate = merged
        end
      end
      unless committed
        @speculation.depth = @speculation.depth - 1 unless settled
        recursive_error = "recursive return type of '#{target_def.name}' did not settle"
      end
    end
    @speculation.recursive_frames.pop
    if @speculation.recursive_frames.empty?
      @speculation.recursive_cache_writes.truncate(0, 0)
    end

    block_flow : BlockFlow? = nil
    if block && (ctx_vars = @current_block_context_vars)
      if blk = block
        # Break changes the after-call flow, never a later yield's entry.
        if exit_owner = @block_owners[blk]?
          exit_owner.exits.each { |state| merge_block_exit(ctx_vars, state, blk) }
        end
        if cache_key && !target_def.uses_block_arg?
          block_flow = capture_block_flow(blk, old_vars, old_var_unions, ctx_vars)
        end
      end
      ctx_vars.each do |k, new_v|
        if old_v = old_vars[k]?
          if old_v != new_v
            old_vars[k] = @program.type_merge(old_v, new_v)
          end
        end
      end
    end

    if block
      if final_blk_t = child_type(block)
        if y_nodes = @current_yield_nodes
          y_nodes.each do |ynode|
            set_type(ynode, final_blk_t)
          end
        end
      end
    end

    @break_types = old_break_types
    @next_types = old_next_types
    @return_types = old_return_types
    @vars = old_vars
    @handler_vars = old_handler_vars
    @handler_writes = old_handler_writes
    @handler_inside_ensure = old_handler_inside_ensure
    @handler_inside_defer = old_handler_inside_defer
    @handler_direct_exit = old_handler_direct_exit
    @scope = old_scope
    @current_def = old_def
    @current_call_block = old_block_call
    @current_block_context_vars = old_block_context_vars
    @current_yield_nodes = old_yield_nodes
    @def_var_unions[target_def] = @var_unions
    @def_nil_resets[target_def] = @nil_resets
    @var_unions = old_var_unions
    @nil_candidates = old_nil_candidates
    @nil_resets = old_nil_resets
    @var_owners = old_var_owners
    @untyped_locals = old_untyped_locals
    @type_filters = old_type_filters
    @needs_type_filters = old_needs_type_filters
    @unreachable = old_unreachable
    @while_break_vars = old_while_break_vars
    @while_next_vars = old_while_next_vars
    @jump_block = saved_jump_block
    @jump_proc = saved_jump_proc
    @jump_whiles = saved_jump_whiles
    @typing_stack.pop
    if error = recursive_error
      return refuse_recursion(site, target_def, error)
    end

    unless params_typed
      if call = call_node
        refuse(call, "cannot bind instantiated parameters of '#{target_def.name}'")
      elsif report_site = site
        refuse(report_site, "cannot bind instantiated parameters of '#{target_def.name}'")
      end
      return nil
    end
    bt = body_type
    # A body that cannot be typed (its refusal is recorded on the body's own nodes)
    # still leaves a call its declared return type, as the oracle types it
    # (bench/fixtures/sem_bodies_primitive_add.iyi).
    if bt.nil?
      if rt = target_def.return_type
        declared_ret = return_contract(rt, rec_type, target_def)
        set_type(target_def, declared_ret)
        remember_def_instance(cache_key, target_def, declared_ret, block_flow)
        return declared_ret
      end
      return nil
    end

    if rt = target_def.return_type
      declared_ret = return_contract(rt, rec_type, target_def)
      # A non-returning body retains an error contract, but otherwise gives the
      # def NoReturn (hosted bindings.cr Def#map_type).
      if bt.is_a?(NoReturnType) && !error_contract?(declared_ret)
        set_type(target_def, bt)
        remember_def_instance(cache_key, target_def, bt, block_flow)
        return bt
      end
      unless return_fits?(bt, declared_ret)
        mismatch = "type mismatch for return type: expected #{declared_ret.full_name}, got #{bt.full_name}"
        if s = site
          refuse(s, mismatch)
        else
          refuse(body.as(ASTNode), mismatch)
        end
        return nil
      end
      answered = retained_return(bt, declared_ret)
      set_type(target_def, answered)
      remember_def_instance(cache_key, target_def, answered, block_flow)
      answered
    else
      set_type(target_def, bt)
      remember_def_instance(cache_key, target_def, bt, block_flow)
      bt
    end
  end

  # Hosted Call#match_block_arg types a yielded block where it is written, before
  # check_return_type and the body (call.cr 583, 632-633, 697-714). Its parameters take
  # the restriction's inputs in the callee's match context (call.cr 1262-1334), so `T` is
  # the receiver's, and a free variable its output names is bound to the block's type
  # (call.cr 1472-1519). `def map(& : T -> U) : Array(U) forall U` names `U` in its
  # annotation and in `Array(U).new` before any yield. A captured block is bound above.
  # A splat input, an input naming an unbound variable, or an output this leaves unbound
  # stays with visit(Yield), which also checks every yield against this binding. False
  # after refusing a block whose type the declared output does not fit.
  def bind_yield_block_output(target_def : Def, rec_type : Type, block : Block?, writer_type : ModuleType, site : ASTNode?, call_node : Call?) : Bool
    return true if target_def.uses_block_arg?
    blk = block
    return true if blk.nil?
    ba = target_def.block_arg
    return true if ba.nil?
    restriction = ba.restriction
    return true unless restriction.is_a?(ProcNotation)
    notation = restriction.as(ProcNotation)
    output = notation.output
    return true if output.nil?
    return true if output.is_a?(Underscore)
    free = target_def.free_vars
    return true if free.nil?
    output_bound = @def_free_types[target_def]? || Hash(String, Type).new
    return true unless FreeBindings.unbound?(output, free, output_bound)
    inputs = notation.inputs || [] of ASTNode
    i = 0
    while i < inputs.size
      return true if inputs[i].is_a?(Splat) || FreeBindings.unbound?(inputs[i], free, output_bound)
      i += 1
    end
    input_types = [] of Type
    i = 0
    while i < inputs.size
      input_type = lookup_def_return(inputs[i], rec_type, target_def)
      return true if input_type.is_a?(UnresolvedType)
      input_types << input_type
      i += 1
    end
    block_type = type_block_before_body(blk, input_types, writer_type)
    return true if block_type.nil?
    anchor : ASTNode = blk
    if s = site
      anchor = s
    elsif c = call_node
      anchor = c
    end
    unless FreeBindings.bind(output, block_type, free, output_bound)
      refuse(anchor, "expected block to return #{output}, not #{block_type.full_name}")
      return false
    end
    @def_free_types[target_def] = output_bound unless output_bound.empty?
    set_type(blk, block_type)
    return true if FreeBindings.unbound?(output, free, output_bound)
    expected = lookup_def_return(output, rec_type, target_def)
    unless expected.nil_type? || expected.is_a?(VoidType) || block_type.subtype_of?(expected)
      refuse(anchor, "expected block to return #{expected.full_name}, not #{block_type.full_name}")
      return false
    end
    true
  end

  # Type the block in its writer's environment with isolated body scratch state.
  # Each yield types it again, joining parameter types with earlier typings.
  def type_block_before_body(blk : Block, input_types : Array(Type), writer_type : ModuleType) : Type?
    block_vars = @vars.dup
    blk.args.each_with_index do |arg, index|
      if index < input_types.size
        param_type = input_types[index]
        if earlier = type_of?(arg)
          param_type = @program.type_merge(earlier, param_type)
        end
        block_vars[arg.name] = param_type
        set_type(arg, param_type)
      end
    end
    saved_vars = @vars
    saved_current_type = @current_type
    saved_imports = @program.current_imports
    saved_import_defs = @program.current_import_defs
    saved_break_types = @break_types
    saved_next_types = @next_types
    saved_jump_block = @jump_block
    saved_jump_block_context = @jump_block_context
    saved_jump_block_exits = @jump_block_exits
    saved_jump_whiles = @jump_whiles
    saved_type_filters = @type_filters
    saved_needs_type_filters = @needs_type_filters
    saved_unreachable = @unreachable
    saved_direct_exit = @handler_direct_exit
    saved_handler_vars = @handler_vars
    saved_handler_writes = @handler_writes
    saved_inside_ensure = @handler_inside_ensure
    saved_inside_defer = @handler_inside_defer
    saved_var_unions = @var_unions
    saved_nil_candidates = @nil_candidates
    saved_nil_resets = @nil_resets
    saved_var_owners = @var_owners
    saved_untyped_locals = @untyped_locals
    saved_while_break_vars = @while_break_vars
    saved_while_next_vars = @while_next_vars
    @vars = block_vars
    @current_type = writer_type
    enter_file_scope(blk)
    @break_types = @block_breaks[blk]?
    @next_types = [] of Type?
    @jump_block = blk
    # Scratch typing must not join a next or break into the real call.
    @jump_block_context = nil
    @jump_block_exits = nil
    @jump_whiles = [] of While
    @type_filters = nil
    @needs_type_filters = 0
    @unreachable = false
    @handler_direct_exit = false
    @handler_vars = [] of Hash(String, Type)
    @handler_writes = [] of Set(String)
    @handler_inside_ensure = false
    @handler_inside_defer = false
    @var_unions = Hash(String, Type).new
    @nil_candidates = Set(String).new
    @nil_resets = Set(String).new
    @var_owners = Hash(String, LocalStorage).new
    @untyped_locals = Hash(String, String).new
    @while_break_vars = [] of Array(Hash(String, Type))
    @while_next_vars = [] of Array(Hash(String, Type))
    saved_super_barrier = @super_barrier
    @super_barrier = "a block"
    blk.body.accept(self)
    @super_barrier = saved_super_barrier
    answered = merge_jump_values(child_type(blk.body), @next_types)
    @vars = saved_vars
    @current_type = saved_current_type
    @program.current_imports = saved_imports
    @program.current_import_defs = saved_import_defs
    @break_types = saved_break_types
    @next_types = saved_next_types
    @jump_block = saved_jump_block
    @jump_block_context = saved_jump_block_context
    @jump_block_exits = saved_jump_block_exits
    @jump_whiles = saved_jump_whiles
    @type_filters = saved_type_filters
    @needs_type_filters = saved_needs_type_filters
    @unreachable = saved_unreachable
    @handler_direct_exit = saved_direct_exit
    @handler_vars = saved_handler_vars
    @handler_writes = saved_handler_writes
    @handler_inside_ensure = saved_inside_ensure
    @handler_inside_defer = saved_inside_defer
    @var_unions = saved_var_unions
    @nil_candidates = saved_nil_candidates
    @nil_resets = saved_nil_resets
    @var_owners = saved_var_owners
    @untyped_locals = saved_untyped_locals
    @while_break_vars = saved_while_break_vars
    @while_next_vars = saved_while_next_vars
    answered
  end

  # iyi: `out x` in a lib call declares `x` as the parameter's pointee (see declare_out). Visited
  # alone it declares nothing: the call does. An instance variable is visited for its own type;
  # `out _` has no type.
  def visit(node : Out) : Bool
    if exp = node.exp
      if exp.is_a?(InstanceVar)
        exp.accept(self)
      end
    end
    false
  end

  # A call on a lib (`LibC.name(args)`), the port of Call#recalculate_lib_call. The arguments are
  # typed by the walk in visit(Call); the lib call checks them (semantic/lib_call.iyi), answers the
  # result type, and marks the lib and the fun used. Its record is kept for the lowering.
  def visit_lib_call(node : Call, lib_type : LibType) : Bool
    args = [] of LibCallArgument
    node.args.each do |arg|
      args << LibCallArgument.new(arg, type_of?(arg), nil)
    end
    if named = node.named_args
      named.each do |na|
        args << LibCallArgument.new(na.value, type_of?(na.value), na.name)
      end
    end
    target = LibCall.recalculate(lib_type, @program, type_node_system(@program), node.name, args)
    record_lib_call(node, target)
  end

  # A call with no receiver that names a `fun` the program declares at its top level
  # (`__iyi_enter(argc, argv)`). The hosted pass adds such a fun to the program as an External
  # def and the call finds it by ordinary lookup; the port keeps it in `global_funs` and records
  # the call as a lib call, which is what the lowering emits for an External: a C call.
  def visit_global_fun_call(node : Call, lib_fun : LibFun) : Bool
    args = [] of LibCallArgument
    node.args.each do |arg|
      args << LibCallArgument.new(arg, type_of?(arg), nil)
    end
    if named = node.named_args
      named.each do |na|
        args << LibCallArgument.new(na.value, type_of?(na.value), na.name)
      end
    end
    target = LibCall.recalculate_fun(lib_fun, node.name, @program, type_node_system(@program), args)
    record_lib_call(node, target)
  end

  # The fun the program declares at its top level under *name*, or nil.
  def global_fun_named(name : String) : LibFun?
    funs = @program.global_funs
    i = 0
    while i < funs.size
      return funs[i] if funs[i].name == name
      i += 1
    end
    nil
  end

  def record_lib_call(node : Call, target : LibCallTarget) : Bool
    if msg = target.error
      return refuse(node, msg)
    end
    @lib_call_targets[node] = target
    i = 0
    while i < target.out_index.size
      out_node = target.arg_nodes[target.out_index[i]].as(Out)
      declare_out(out_node, target.out_type[i])
      i += 1
    end
    set_type(node, target.result_type.as(Type))
    @unreachable = true if target.result_type.as(Type).is_a?(NoReturnType)
    @type_filters = nil
    false
  end

  # The variable an `out` argument names takes the parameter's pointee type. As the hosted pass
  # does, a name the body already has is refused: `out` defines a variable.
  def declare_out(out_node : Out, pointee : Type) : Nil
    exp = out_node.exp
    return nil unless exp.is_a?(Var)
    name = exp.as(Var).name
    if @vars[name]?
      refuse(out_node, "variable '#{name}' is already defined, `out` must be used to define a variable, use another name")
      return nil
    end
    @vars[name] = pointee
    merge_var_union(name, pointee)
    set_type(exp, pointee)
    set_type(out_node, pointee)
    nil
  end

  # The lib call record of a call on a lib (see visit_lib_call), or nil.
  def lib_call_target(node : Call) : LibCallTarget?
    @lib_call_targets[node]?
  end

  # Hosted Type#error? checks the declared members against the builtin Error.
  # All sources in this port are iyi, so the hosted iyi_written? condition holds.
  def error_contract?(declared : Type) : Bool
    error = @program.types["Error"]?
    return false if error.nil?
    members = declared.is_a?(UnionType) ? declared.as(UnionType).union_types : [declared]
    members.any? { |m| m.implements?(error.as(Type)) }
  end

  # Hosted checks the body and explicit return values against the annotation.
  # A Nil contract discards any value; compatible procs restrict to the contract.
  def return_fits?(value : Type, contract : Type) : Bool
    resolved = @program.remove_alias(value)
    contract.nil_type? || resolved.subtype_of?(contract) || proc_contract?(resolved, contract)
  end

  # Hosted restrict_type_to_freeze_type (bindings.cr 323-344).
  def proc_contract?(value : Type, contract : Type) : Bool
    return false unless contract.is_a?(ProcInstanceType)
    members = value.is_a?(UnionType) ? value.as(UnionType).union_types : [value]
    members.all? { |m| m.is_a?(ProcInstanceType) && TypeIntersect.compatible_proc?(m.as(ProcInstanceType), contract.as(ProcInstanceType)) }
  end

  # Keep the body's own type except where hosted Def#map_type selects the contract.
  # An alias-valued body keeps its name, matching its nodes and inline getter.
  def retained_return(body : Type, contract : Type) : Type
    resolved = @program.remove_alias(body)
    return body if resolved == contract
    return contract if contract.nil_type? || error_contract?(contract) || proc_contract?(resolved, contract)
    body
  end

  # The type of a body, block or call with the values its jumps carry merged in (hosted: `return`
  # binds to the def, `next` to the block). A speculative pass merges only its typed inputs.
  def merge_jump_values(base : Type?, values : Array(Type?)?) : Type?
    vs = values
    return base if vs.nil?
    return base if vs.empty?
    speculative = @speculation.depth > 0
    return nil if base.nil? && !speculative
    result = base
    i = 0
    while i < vs.size
      if v = vs[i]
        result = (r = result) ? merge_flow(r, v) : v
      elsif !speculative
        return nil
      end
      i += 1
    end
    result
  end

  # The type of a call: its method's result, with the values its block's `break`s carry merged in.
  def call_result(node : Call, ret : Type?) : Type?
    if blk = node.block
      return merge_jump_values(ret, @block_breaks[blk]?)
    end
    ret
  end

  # `obj.@name`: the instance variable of obj's type (hosted visit_read_instance_var).
  def visit(node : ReadInstanceVar) : Bool
    node.obj.accept(self)
    ot = child_type(node.obj)
    return false if ot.nil?
    owner : Type = ot.as(Type)
    owner = owner.as(VirtualType).base_type if owner.is_a?(VirtualType)
    if owner.is_a?(ModuleType)
      if ivar = owner.as(ModuleType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    refuse(node, "undefined instance variable '#{node.name}' for #{owner.full_name}")
  end

  # Hosted codegen expands an omitted magic default at the call, not at the def.
  # The literal is this call's coordinates, typed as the literal it is.
  def materialized_magic(node : Call, magic : MagicConstant) : ASTNode
    literal = magic.expand_node(node.location, node.end_location).at(node)
    literal.accept(self)
    literal
  end

  # Preserve the written call. The expansion takes explicit values in source
  # order; only omitted magic values are materialized at the call site.
  # Generated new forwards written arguments; initialize evaluates its defaults.
  def call_expansion(node : Call, definition : Def) : CallExpansion?
    target = definition
    named = node.named_args
    if @program.generated_new?(definition) && definition.double_splat.nil? && (named || definition.splat_index || node.args.size != definition.args.size)
      target = expand_new_default_arguments(definition, node.args.size, named)
      @program.copy_def_owner(definition, target)
    elsif named || definition.splat_index || (node.args.size < definition.args.size && DefaultArguments.supported?(definition, node.args, nil))
      splat_names = [] of String
      if splat_index = definition.splat_index
        count = node.args.size - splat_index
        names = NormalizerProgram.new
        while count > 0
          splat_names << names.new_temp_var_name("$splat_")
          count -= 1
        end
      end
      expanded = DefaultArguments.expand_for_call(definition, node.args.size, named, splat_names)
      if expanded.is_a?(String)
        refuse_call(node, expanded)
        return nil
      end
      target = expanded.as(Def)
      unless target.object_id == definition.object_id
        target.at(definition)
        @program.copy_def_owner(definition, target)
      end
    end
    arguments = [] of ASTNode
    node.args.each { |arg| arguments << arg }
    if named
      named.each { |arg| arguments << arg.value }
    end
    i = arguments.size
    while i < target.args.size
      value = target.args[i].default_value
      unless value.is_a?(MagicConstant)
        refuse_call(node, "not ported: omitted non-magic argument")
        return nil
      end
      arguments << materialized_magic(node, value.as(MagicConstant))
      i += 1
    end
    CallExpansion.new(target, arguments)
  end

  def match_bound_types(match : Match) : Array(Type)
    result = match.arg_types.dup
    match.named_arg_types.each do |arg|
      result << arg.type
    end
    result
  end

  def defaults_bind_splat(definition : Def, instantiated : Def, args : Array(ASTNode)) : Nil
    if definition.splat_index && definition.free_vars
      arg_types = [] of Type
      args.each do |arg|
        if arg_type = child_type(arg)
          arg_types << arg_type
        end
      end
      if arg_types.size == args.size
        if free_types = FreeBindings.of_def(definition, arg_types, type_node_system(@program))
          target_def = instantiated
          @def_free_types[target_def] = free_types unless free_types.empty?
        end
      end
    end
  end

  def infer_constructor_receiver(node : Call, owner : Type, definition : Def) : Type?
    defining = @program.def_owner(definition)
    return nil if defining.nil?
    generic = CallMatch.inferable_generic(@program, owner, defining, definition, node.args.size)
    return nil if generic.nil?
    arg_types = [] of Type
    node.args.each do |arg|
      arg_type = child_type(arg)
      return nil if arg_type.nil?
      arg_types << arg_type.as(Type)
    end
    ts = type_node_system(@program)
    bound = FreeBindings.of_def(definition, arg_types, ts, generic.as(GenericClassType).type_vars)
    return nil if bound.nil?
    # Hosted Type#restrict(Path) binds a type variable of an uninstantiated
    # generic from the block output (restrictions.cr:917-933, call.cr:1472-1493).
    if blk = node.block
      if block_arg = definition.block_arg
        if notation = block_arg.restriction.as?(ProcNotation)
          if output = notation.output
            names = generic.as(GenericClassType).type_vars
            if FreeBindings.unbound?(output, names, bound.as(Hash(String, Type)))
              inputs = [] of Type
              input_nodes = notation.inputs || [] of ASTNode
              input_nodes.each do |input|
                return nil if input.is_a?(Splat) || FreeBindings.unbound?(input, names, bound.as(Hash(String, Type)))
                resolved = ArgRestriction.lookup_free(ts, defining.as(ModuleType), input, owner, bound.as(Hash(String, Type)))
                return nil if resolved.is_a?(LookupError)
                inputs << resolved.as(Type)
              end
              block_type = type_block_before_body(blk, inputs, @current_type)
              return nil if block_type.nil?
              return nil unless FreeBindings.bind(output, block_type.as(Type), names, bound.as(Hash(String, Type)))
              set_type(blk, block_type.as(Type))
            end
          end
        end
      end
    end
    ordered = [] of Type
    generic.as(GenericClassType).type_vars.each do |name|
      arg_type = bound.as(Hash(String, Type))[name]?
      return nil if arg_type.nil?
      ordered << arg_type.as(Type)
    end
    type_node_metaclass(ts.instantiate_type(generic.as(GenericClassType), ordered))
  end

  # Hosted call.cr:78-80,94-114: no method lookup follows an operand that never returns.
  def receives_no_return?(node : Call, rec_type : Type) : Bool
    return true if !node.obj.nil? && rec_type.is_a?(NoReturnType)
    return false if rec_type.is_a?(LibType)
    return true if node.args.any? { |arg| type_of?(arg).is_a?(NoReturnType) }
    if named = node.named_args
      return true if named.any? { |arg| type_of?(arg.value).is_a?(NoReturnType) }
    end
    false
  end

  def visit(node : Call) : Bool
    @call_arguments.delete(node)
    if block = node.block
      @jump_block_calls[block] = node
    end
    if expand_macro(node)
      return false
    end

    if !node.global && !node.has_parentheses && node.obj.nil? && node.args.empty? && node.named_args.nil? && node.block.nil? && node.block_arg.nil?
      if vt = @vars[node.name]?
        # A macro can leave a bare local name as Call syntax. Keep the resolved
        # variable read for lowering; it has no method target.
        local_read = Var.new(node.name).at(node)
        set_type(local_read, vt)
        @expansions[node] = local_read
        set_type(node, vt)
        observe_nil_if_read(node.name, vt)
        if needs_type_filters?
          @type_filters = TypeFilters.truthy(node.name)
        end
        return false
      end
    end

    saved_call_ntf = @needs_type_filters
    @needs_type_filters = 0
    rec_type : Type
    if obj = node.obj
      obj.accept(self)
      if ot = child_type(obj)
        rec_type = ot
      else
        # Total analysis still records independent argument nodes when the
        # receiver cannot be typed. The call itself remains unresolved.
        if @total || @speculation.depth > 0
          node.args.each do |arg|
            arg.accept(self)
          end
          if named = node.named_args
            named.each do |arg|
              arg.value.accept(self)
            end
          end
        end
        @needs_type_filters = saved_call_ntf
        @type_filters = nil
        return false
      end
    else
      rec_type = @scope || @current_type
    end
    node.args.each do |arg|
      arg.accept(self)
    end
    if named = node.named_args
      named.each do |arg|
        arg.value.accept(self)
      end
    end
    if receives_no_return?(node, rec_type)
      @needs_type_filters = saved_call_ntf
      @call_receivers.delete(node)
      @call_target_defs.delete(node)
      @call_dispatch_targets.delete(node)
      set_type(node, @program.no_return_type)
      @unreachable = true
      @type_filters = nil
      return false
    end
    # A narrowed-out local has no value on this path. Hosted leaves dependent
    # calls untyped rather than treating that local as a method or a bad argument.
    node.args.each do |arg|
      if arg.is_a?(Var) && type_of?(arg).nil? && @untyped_reasons[arg]? == narrowed_out_reason(arg.as(Var).name)
        @node_types.delete(node)
        @untyped_reasons[node] = narrowed_out_reason(arg.as(Var).name)
        @needs_type_filters = saved_call_ntf
        @type_filters = nil
        return false
      end
    end
    if named = node.named_args
      named.each do |arg|
        value = arg.value
        if value.is_a?(Var) && type_of?(value).nil? && @untyped_reasons[value]? == narrowed_out_reason(value.as(Var).name)
          @node_types.delete(node)
          @untyped_reasons[node] = narrowed_out_reason(value.as(Var).name)
          @needs_type_filters = saved_call_ntf
          @type_filters = nil
          return false
        end
      end
    end
    # Hosted call.cr:125-126,1055-1070 turns &proc into a block before
    # overload lookup, retaining the proc as the block's captured literal.
    if block_arg = node.block_arg
      block_arg.accept(self)
      block_type = child_type(block_arg)
      if block_type.nil?
        @needs_type_filters = saved_call_ntf
        return untyped(node, "an argument was not typed: #{block_arg}")
      end
      unless block_type.is_a?(ProcInstanceType)
        @needs_type_filters = saved_call_ntf
        return refuse(node, "expected a function type, not #{block_type.as(Type).full_name}")
      end
      vars = [] of Var
      args = [] of ASTNode
      block_type.as(ProcInstanceType).arg_types.each_with_index do |_, i|
        arg = Var.new("__arg#{i}").at(block_arg).as(Var)
        vars << arg
        args << arg.clone
      end
      body = Call.new(block_arg.clone, "call", args).at(block_arg)
      forwarded = Block.new(vars, body).at(block_arg).as(Block)
      set_type(forwarded, block_type.as(ProcInstanceType).return_type)
      forwarded.fun_literal = block_arg
      node.block = forwarded
      @jump_block_calls[forwarded] = node
    end
    @needs_type_filters = saved_call_ntf
    @call_receivers.delete(node)
    if node.obj.nil? && node.name == "super"
      return visit_super(node)
    end
    # Lib calls type `out` from the formal parameter in record_lib_call,
    # rather than from the argument walk (hosted semantic/call.cr:77-92).
    if rec_type.is_a?(LibType)
      return visit_lib_call(node, rec_type.as(LibType))
    end

    trait_receiver = false
    unless node.obj.nil?
      concrete = TypeIndirection.trait_value_type(rec_type)
      unless concrete.object_id == rec_type.object_id
        rec_type = concrete
        trait_receiver = true
      end
    end

    if node.obj.nil? && node.name != "super" && !node.expansion
      if global_fun = global_fun_named(node.name)
        own = [] of Def
        seen = Set(String).new
        collect_candidate_defs(rec_type, node.name, own, seen)
        collect_scope_defs(rec_type, node.name, own, seen) if own.empty?
        return visit_global_fun_call(node, global_fun) if own.empty?
      end
    end
    if @speculation.depth > 0 && @speculation.recursive_frames.any?(&.cyclic)
      node.args.each do |arg|
        if type_of?(arg).nil?
          @type_filters = nil
          return false
        end
      end
      if named = node.named_args
        named.each do |arg|
          if type_of?(arg.value).nil?
            @type_filters = nil
            return false
          end
        end
      end
    end
    # Total analysis must not pass an untyped child to overload matching or
    # its diagnostics, both of which require types for every argument.
    if @total
      node.args.each do |arg|
        return untyped(node, "an argument was not typed: #{arg}") if child_type(arg).nil?
      end
      if named = node.named_args
        named.each do |arg|
          return untyped(node, "an argument was not typed: #{arg.value}") if child_type(arg.value).nil?
        end
      end
    end

    infer_class_vars = node.named_args.nil? && node.block_arg.nil?
    arms : Array(Match)? = nil
    if node.expansion && node.obj.nil?
      current = @current_def
      raise "BUG: expansion call outside a def" if current.nil?
      owner = @program.def_owner(current.as(Def))
      raise "BUG: expansion call has no defining owner" if owner.nil?
      lookup_owner = body_lookup_owner(owner.as(ModuleType), rec_type)
      found = lookup_call_arms(lookup_owner, rec_type, node.name, node.args, node, ArmWalk::Parents, infer_class_vars)
      unless found.cover_all?
        if message = found.error
          refuse_call(node, message)
        else
          refuse_uncovered(node, lookup_owner, node.name, node.args)
        end
        return false
      end
      arms = found.matches
    else
      arms = receiver_dispatch_arms(node, rec_type, infer_class_vars)
    end
    return false if arms.nil?
    matches = arms.as(Array(Match))
    if matches.size > 1
      if trait_receiver
        # Distinct owners are receiver dispatch, not overloads of one receiver.
        seen_owners = Set(String).new
        matches.each do |match|
          owner_name = match.owner.full_name
          if seen_owners.includes?(owner_name)
            refuse_call(node, "not ported: an argument dispatch on a trait receiver (hosted semantic/call.cr)")
            return false
          end
          seen_owners.add(owner_name)
        end
      end
      if (node.block || node.block_arg) && dispatch_binds_shared_block_result?(matches)
        refuse_call(node, "not ported: a dispatch whose arms bind free variables from the block they share (hosted semantic/call.cr match_block_arg binds them per match from the merged block)")
        return false
      end
      if node.name == "new" && infer_class_vars && infer_constructor_receiver(node, rec_type, matches[0].definition)
        refuse_call(node, "not ported: an argument dispatch on a constructor that infers generic type variables")
        return false
      end
    end
    if matches.size > 1 || (!node.expansion && (rec_type.is_a?(UnionType) || rec_type.is_a?(VirtualType) || rec_type.is_a?(VirtualMetaclassType)))
      return dispatch_call(node, matches)
    end
    if matches.empty?
      refuse_uncovered(node, rec_type, node.name, node.args)
      return false
    end
    original_def = matches[0].definition
    @matched_call_args[node] = match_bound_types(matches[0])
    if infer_class_vars
      if receiver = infer_constructor_receiver(node, rec_type, original_def)
        rec_type = receiver
        @call_receivers[node] = receiver
      end
    end
    # A receiverless fallback to a program def is instantiated by the program,
    # not by the type that happened to call it. Methods retain the actual
    # receiver, including generic instances and inherited methods.
    instance_owner : Type = rec_type
    if node.obj.nil?
      if declared_owner = @program.def_owner(original_def)
        instance_owner = declared_owner if declared_owner.is_a?(SemanticProgram)
      end
    end
    result = instantiate_call_target(node, rec_type, instance_owner, original_def, trait_receiver)
    @matched_call_args.delete(node)
    result
  end

  # The shared block is typed incrementally, so an earlier arm could bind its
  # output variable before later arms have contributed their block input types.
  private def dispatch_binds_shared_block_result?(matches : Array(Match)) : Bool
    matches.each do |match|
      if free = match.definition.free_vars
        next if free.empty?
        if block_arg = match.definition.block_arg
          if notation = block_arg.restriction.as?(ProcNotation)
            if output = notation.output
              return true if FreeBindings.mentions?(output, free)
            end
          end
        end
      end
    end
    false
  end

  # The receiver groups follow VirtualTypeLookup: subtype-owned definitions
  # precede the base, while each subtype searches only its own modules.
  def virtual_dispatch_arms(node : Call, receiver : VirtualType, infer_class_vars : Bool, metaclass : Bool = false) : Array(Match)?
    base = receiver.base_type
    lookup_base = metaclass ? (type_node_metaclass(base) || base) : base
    virtual_owner : Type = metaclass ? receiver.metaclass : receiver
    base_matches = lookup_call_arms(lookup_base, virtual_owner, node.name, node.args, node, ArmWalk::Parents, infer_class_vars)
    trace_arg_dispatch(base, node.name, node.args, node, base_matches, nil)
    subtypes = TypeQueries.all_subclasses(base)
    if subtypes.empty?
      unless base_matches.cover_all?
        refuse_uncovered(node, receiver, node.name, node.args)
        return nil
      end
      return base_matches.matches
    end
    if !base.abstract? && !base_matches.cover_all?
      refuse_uncovered(node, receiver, node.name, node.args)
      return nil
    end
    covered = Hash(String, Bool).new
    groups = [] of Array(Match)
    i = 0
    while i < subtypes.size
      subtype = subtypes[i]
      i += 1
      next if subtype.is_a?(GenericClassType) || TypeQueries.unbound?(subtype)
      next if subtype.abstract? && TypeQueries.subclasses(subtype).empty?
      owner : Type = TypeQueries.virtual_type(subtype)
      lookup_subtype : Type = subtype
      if metaclass
        owner = type_node_metaclass(owner) || owner
        lookup_subtype = type_node_metaclass(subtype) || subtype
      end
      found = lookup_call_arms(lookup_subtype, owner, node.name, node.args, node, ArmWalk::Modules, infer_class_vars)
      # Hosted method_lookup.cr:516-524: a subtype's incompatible initializer
      # must not inherit a matching constructor from the virtual base.
      if metaclass && node.name == "new" && found.empty? && subtype.is_a?(ModuleType)
        initializers = subtype.as(ModuleType).defs["initialize"]?
        if initializers && !initializers.empty?
          refuse_uncovered(node, receiver.metaclass, node.name, node.args)
          return nil
        end
      end
      if !subtype.abstract? && !base_matches.cover_all? && !found.cover_all?
        unless virtual_superclass_covered?(subtype, base, covered)
          refuse_uncovered(node, receiver, node.name, node.args)
          return nil
        end
      end
      covered[subtype.full_name] = found.cover_all? unless found.empty?
      groups << found.matches unless found.empty?
    end
    # A receiverless call resolved entirely in the program has no dynamic
    # receiver. Subtype methods cannot override its lexical global binding.
    if node.obj.nil? && base_matches.cover_all?
      global_only = !base_matches.matches.empty?
      base_matches.matches.each { |match| global_only = false unless match.owner.is_a?(SemanticProgram) }
      return base_matches.matches if global_only
    end
    result = [] of Match
    i = groups.size
    while i > 0
      i -= 1
      groups[i].each { |match| result << match }
    end
    base_matches.matches.each { |match| result << match }
    if result.empty?
      refuse_uncovered(node, receiver, node.name, node.args)
      return nil
    end
    result
  end

  def virtual_superclass_covered?(subtype : Type, base : Type, covered : Hash(String, Bool)) : Bool
    current : Type? = nil
    if subtype.is_a?(ClassType)
      current = subtype.as(ClassType).superclass
    elsif subtype.is_a?(GenericClassInstanceType)
      current = subtype.as(GenericClassInstanceType).superclass
    end
    while parent = current
      break if parent.full_name == base.full_name
      return true if covered[parent.full_name]?
      if parent.is_a?(ClassType)
        current = parent.as(ClassType).superclass
      elsif parent.is_a?(GenericClassInstanceType)
        current = parent.as(GenericClassInstanceType).superclass
      else
        current = nil
      end
    end
    false
  end

  def receiver_dispatch_arms(node : Call, receiver : Type, infer_class_vars : Bool) : Array(Match)?
    if receiver.is_a?(VirtualType)
      return virtual_dispatch_arms(node, receiver.as(VirtualType), infer_class_vars)
    end
    if receiver.is_a?(VirtualMetaclassType)
      return virtual_dispatch_arms(node, receiver.as(VirtualMetaclassType).instance_type, infer_class_vars, true)
    end
    if receiver.is_a?(UnionType)
      result = [] of Match
      receiver.as(UnionType).union_types.each do |member|
        arms = receiver_dispatch_arms(node, member, infer_class_vars)
        return nil if arms.nil?
        arms.as(Array(Match)).each { |arm| result << arm }
      end
      return result
    end
    found = lookup_call_arms(receiver, receiver, node.name, node.args, node, ArmWalk::Parents, infer_class_vars)
    trace_arg_dispatch(receiver, node.name, node.args, node, found, nil)
    unless found.cover_all?
      if message = found.error
        refuse_call(node, message)
      else
        refuse_uncovered(node, receiver, node.name, node.args)
      end
      return nil
    end
    found.matches
  end

  def dispatch_call(node : Call, arms : Array(Match)) : Bool
    ret_types = [] of Type
    first_target_def : Def? = nil
    dispatch_targets = [] of DispatchTarget
    supplied_args = node.args
    written_count = supplied_args.size
    written_count += node.named_args.as(Array(NamedArgument)).size unless node.named_args.nil?
    expanded_args : Array(ASTNode)? = nil

    if blk = node.block
      @block_breaks[blk] = [] of Type?
    end
    i = 0
    while i < arms.size
      # Each arm sees the same written nodes; expansion only adds magic values.
      arm = arms[i]
      target_def = arm.definition
      original_def = target_def
      ut = arm.owner
      bound_types = match_bound_types(arm)
      @matched_call_args[node] = bound_types
      union_instance_owner : Type = ut
      if node.obj.nil?
        if declared_owner = @program.def_owner(target_def)
          union_instance_owner = declared_owner if declared_owner.is_a?(SemanticProgram)
        end
      end
      dkey = def_instance_key(target_def, union_instance_owner, node)
      expanded = call_expansion(node, target_def)
      if expanded.nil?
        @matched_call_args.delete(node)
        return false
      end
      target_def = expanded.as(CallExpansion).target
      arguments = expanded.as(CallExpansion).arguments
      if previous_args = expanded_args
        if previous_args.size != arguments.size
          refuse_call(node, "not ported: differing union call-site defaults")
          @matched_call_args.delete(node)
          return false
        end
        j = written_count
        while j < arguments.size
          if previous_args[j].to_s != arguments[j].to_s
            refuse_call(node, "not ported: differing union call-site defaults")
            @matched_call_args.delete(node)
            return false
          end
          j += 1
        end
      else
        expanded_args = arguments
      end
      instantiated_def : Def
      ret_t : Type? = nil
      if hit = cached_instance(dkey)
        instantiated_def = hit.definition
        ret_t = hit.return_type
      else
        instantiated_def = target_def.clone
        defaults_bind_splat(original_def, instantiated_def, supplied_args)
        @program.copy_def_owner(target_def, instantiated_def)
        @call_target_defs[node] = instantiated_def
        ret_t = type_method_body(instantiated_def, union_instance_owner, arguments, node.block, node, dkey, node)
        instantiated_def = @call_target_defs[node]? || instantiated_def
      end
      if ret_t.nil?
        @matched_call_args.delete(node)
        return false
      end
      if first_target_def.nil?
        first_target_def = instantiated_def
      end
      j = bound_types.size
      while j < arguments.size
        magic_type = child_type(arguments[j])
        raise "BUG: materialized magic argument has no type" if magic_type.nil?
        bound_types << magic_type.as(Type)
        j += 1
      end
      dispatch_targets << DispatchTarget.new(ut, instantiated_def, ret_t.as(Type), bound_types)
      ret_types << ret_t
      i = i + 1
    end
    if arguments = expanded_args
      @call_arguments[node] = arguments if node.named_args || arguments.size != node.args.size
    end
    @matched_call_args.delete(node)

    if td = first_target_def
      @call_target_defs[node] = td
    end
    @call_dispatch_targets[node] = dispatch_targets

    merged_ret = @program.type_merge(ret_types)
    if merged_call_t = call_result(node, merged_ret)
      set_type(node, merged_call_t)
      @unreachable = true if merged_call_t.is_a?(NoReturnType)
    else
      @call_arguments.delete(node)
    end
    @type_filters = nil
    false
  end

  # Hosted super starts at the lexical def owner, but retains the call's dynamic self.
  def visit_super(node : Call) : Bool
    target_def = super_target_def(node)
    return false if target_def.nil?
    scope = @scope.as(Type)
    instantiate_call_target(node, scope, scope, target_def, false)
  end

  def super_ancestors(owner : ModuleType, result : Array(Type)) : Nil
    owner.parents.each do |parent|
      result << parent
      super_ancestors(parent.as(ModuleType), result) if parent.is_a?(ModuleType)
    end
  end

  def super_declares?(owner : ModuleType, name : String) : Bool
    if definitions = owner.defs[name]?
      definitions.each do |definition|
        return true unless CallMatch.yields?(definition)
      end
    end
    false
  end

  def super_target_def(node : Call) : Def?
    scope = @scope
    return refuse_call(node, "there's no superclass in this scope") if scope.nil? || scope.is_a?(SemanticProgram)
    if barrier = @super_barrier
      return refuse_call(node, "not ported: super inside #{barrier} (hosted call.cr enclosing_def types it through the enclosing def)")
    end
    if node.block || node.block_arg
      return refuse_call(node, "not ported: super with a block (hosted call.cr lookup_super_matches, lookup_first_def with the block)")
    end
    current = @current_def
    return refuse_call(node, "can't use 'super' outside method") if current.nil?
    owner = @program.def_owner(current)
    return refuse_call(node, "not ported: super in #{current.name}, whose defining type is not recorded") if owner.nil?
    unless owner.is_a?(NonGenericClassType)
      return refuse_call(node, "not ported: super in a method of #{owner.full_name} (hosted call.cr lookup_super_matches: only a non-generic class owner is ported)")
    end
    self_base = scope.is_a?(VirtualType) ? scope.as(VirtualType).base_type : scope
    unless self_base.is_a?(NonGenericClassType)
      return refuse_call(node, "not ported: super with the self #{scope.full_name} (hosted call.cr lookup_super_matches: only a non-generic class self is ported)")
    end
    owner_module = owner.as(ModuleType)
    parents = [] of Type
    super_ancestors(owner_module, parents)
    return refuse_call(node, "there's no superclass in this scope") if parents.empty?
    lookup_in = parents.last
    parents.each do |parent|
      unless parent.is_a?(ModuleType)
        return refuse_call(node, "not ported: super through the generic ancestor #{parent.full_name} (hosted call.cr lookup_super_matches, lookup_first_def)")
      end
      if super_declares?(parent.as(ModuleType), current.name)
        lookup_in = parent
        break
      end
    end
    candidates = [] of Def
    if current.name == "initialize"
      if definitions = lookup_in.as(ModuleType).defs[current.name]?
        definitions.each { |definition| candidates << definition }
      end
    else
      collect_candidate_defs(lookup_in, current.name, candidates, Set(String).new)
    end
    dispatch_arg = false
    node.args.each do |arg|
      if arg_type = child_type(arg)
        expanded = TypeIndirection.remove_indirection(arg_type)
        dispatch_arg = true if expanded.is_a?(UnionType) || expanded.is_a?(VirtualType)
      end
    end
    if dispatch_arg
      arms = lookup_call_arms(lookup_in, scope.as(Type), current.name, node.args, node, ArmWalk::Parents)
      if arms.matches.size > 1
        return refuse_call(node, "not ported: super with an argument dispatch (hosted codegen/call.cr:473-475)")
      end
    end
    lookup_method_matching(lookup_in, current.name, node.args, node, candidates)
  end

  def instantiate_call_target(node : Call, rec_type : Type, instance_owner : Type, original_def : Def, trait_receiver : Bool) : Bool
    dkey = def_instance_key(original_def, instance_owner, node)
    expanded = call_expansion(node, original_def)
    return false if expanded.nil?
    target_def = expanded.as(CallExpansion).target
    arguments = expanded.as(CallExpansion).arguments
    @call_arguments[node] = arguments if node.named_args || arguments.size != node.args.size
    instantiated_def : Def
    body_ret : Type? = nil
    if hit = cached_instance(dkey)
      # cached_instance checked the caller and merged the block's writes.
      # The call keeps its typed clone, return type and recorded block breaks.
      instantiated_def = hit.definition
      @call_target_defs[node] = instantiated_def
      body_ret = hit.return_type
    else
      instantiated_def = target_def.clone
      defaults_bind_splat(original_def, instantiated_def, node.args)
      @program.copy_def_owner(target_def, instantiated_def)
      @call_target_defs[node] = instantiated_def
      if blk = node.block
        @block_breaks[blk] = [] of Type?
      end
      body_ret = type_method_body(instantiated_def, instance_owner, arguments, node.block, nil, dkey, node)
      instantiated_def = @call_target_defs[node]? || instantiated_def
    end
    if trait_receiver && body_ret
      @call_dispatch_targets[node] = [DispatchTarget.new(rec_type, instantiated_def, body_ret)] of DispatchTarget
    end
    ret_type = call_result(node, body_ret)
    if ret_type
      set_type(node, ret_type)
      @unreachable = true if ret_type.is_a?(NoReturnType)
    else
      @call_arguments.delete(node)
    end
    @type_filters = nil
    false
  end

  # A tuple literal is the tuple of its elements' types (hosted visit(TupleLiteral)).
  def visit(node : TupleLiteral) : Bool
    types = [] of Type
    i = 0
    while i < node.elements.size
      e = node.elements[i]
      e.accept(self)
      if et = child_type(e)
        types << et
      else
        return false
      end
      i = i + 1
    end
    set_type(node, tuple_type_of(@program, types))
    false
  end

  # A named tuple literal is the named tuple of its entries' types (hosted
  # visit(NamedTupleLiteral)).
  def visit(node : NamedTupleLiteral) : Bool
    entries = [] of NamedArgumentType
    i = 0
    while i < node.entries.size
      entry = node.entries[i]
      entry.value.accept(self)
      if et = child_type(entry.value)
        entries << NamedArgumentType.new(entry.key, et)
      else
        return false
      end
      i = i + 1
    end
    set_type(node, named_tuple_type_of(@program, entries))
    false
  end

  # --- asm: begin ---
  # Hosted visit(node : Asm) (main_visitor.cr 3605-3620). Each output is typed
  # through `pointerof` of its expression, each input expression is typed, and
  # the node is Void. The hosted compiler's other-language mode, the removed
  # interpreter, and exception typing beyond refusing `rescue` are not branches of this method.
  def visit(node : Asm) : Bool
    if outputs = node.outputs
      outputs.each do |output|
        ptrof = PointerOf.new(output.exp).at(output.exp)
        ptrof.accept(self)
      end
    end
    if inputs = node.inputs
      inputs.each do |input|
        input.exp.accept(self)
      end
    end
    if vt = @program.types["Void"]?
      set_type(node, vt)
    end
    false
  end

  # visit(Asm) returns false, as the hosted visit does, so an operand is not
  # walked from there. A walk that reaches the operand types its expression.
  def visit(node : AsmOperand) : Bool
    node.exp.accept(self)
    if et = child_type(node.exp)
      set_type(node, et)
    end
    false
  end

  # --- asm: end ---

  # --- type nodes: begin ---
  # The type-argument bracket the type-node functions use (hosted `@in_type_args`).
  def bracket_type_args(delta : Int32) : Nil
    @in_type_args = @in_type_args + delta
  end

  def visit(node : Generic) : Bool
    visit_generic(self, node)
  end

  def visit(node : Union) : Bool
    visit_union(self, node)
  end

  def visit(node : ProcNotation) : Bool
    visit_proc_notation(self, node)
  end

  def visit(node : Metaclass) : Bool
    visit_metaclass(self, node)
  end

  def visit(node : FunDef) : Bool
    file = ""
    if loc = node.location
      file = loc.filename
    end
    saved = @fun_inline_file
    @fun_inline_file = file
    typed = visit_fun_def(self, node)
    @fun_inline_file = saved
    typed
  end

  # `->(x : T) { body }` is typed `Proc(T, R)`, as the hosted pass types a ProcLiteral (main_visitor.cr
  # 1373-1433 and ProcLiteral#update, bindings.cr 604-619). Its parameters are locals of its body; R is the
  # declared return type, or else the body's type. Not ported: the closure analysis, the Proc argument
  # check, and force_nil.
  def visit(node : ProcLiteral) : Bool
    return false if type_of?(node)
    def_node = node.def
    fun_vars = @vars.dup
    arg_types = [] of Type
    i = 0
    while i < def_node.args.size
      arg = def_node.args[i]
      restriction = arg.restriction
      if restriction.nil?
        return refuse(node, "parameter '#{arg.name}' of Proc literal must have a type")
      end
      t = TypeQueries.virtual_type(lookup_under(restriction.as(ASTNode), @scope))
      set_type(restriction.as(ASTNode), t)
      set_type(arg, t)
      arg_types << t
      fun_vars[arg.name] = t
      i = i + 1
    end
    declared = proc_literal_return(def_node)
    body = def_node.body
    inner = sub_visitor(fun_vars).as(MainVisitor)
    # Unlike a fun body, the literal's body inherits its enclosing scope
    # (hosted main_visitor.cr 1416-1423).
    inner.scope = @scope
    inner.super_barrier = "a proc literal"
    # Returns from the literal or its yielded blocks belong to this proc.
    inner.return_types = [] of Type?
    old_imports = @program.current_imports
    old_import_defs = @program.current_import_defs
    enter_file_scope(node)
    body.accept(inner)
    @program.current_imports = old_imports
    @program.current_import_defs = old_import_defs
    ret = declared
    if bt = inner.merge_jump_values(inner.child_type(body), inner.return_types)
      if rt = declared
        merged = @program.type_merge(bt, rt)
        if merged != rt
          return refuse(node, "expected Proc to return #{rt.full_name} but it returned #{merged.full_name}")
        end
      else
        ret = TypeQueries.virtual_type(bt)
      end
    end
    if final = ret
      set_type(def_node, final)
      set_type(node, ProcInstanceType.new(@program, arg_types, final))
    else
      return refuse(node, "the body of the Proc literal was not typed")
    end
    false
  end

  # The declared return type of a Proc literal's def, or nil.
  def proc_literal_return(def_node : Def) : Type?
    if rt_node = def_node.return_type
      return TypeQueries.virtual_type(lookup_under(rt_node, @scope))
    end
    nil
  end

  def visit(node : Self) : Bool
    visit_self(self, node)
  end

  # A proc pointer, typed as the hosted MainVisitor#visit(ProcPointer) decides (main_visitor.cr 1462-1499): a
  # receiver-less pointer and a pointer on a path that is not a lib are expanded into a proc literal that calls
  # the target, and the pointer takes the expansion's type. Refused by name, not ported: a pointer that closes
  # over a variable (its closure is refused in cleanup_transformer.cr 2297-2330, not ported), a lib function
  # (main_visitor.cr 1501-1547), any other receiver, and the macro refusal (1474-1481).
  def visit(node : ProcPointer) : Bool
    obj = node.obj
    if obj
      obj.accept(self)
    end
    if obj.nil?
      return proc_pointer_expansion(node)
    end
    if obj.is_a?(Var) || obj.is_a?(InstanceVar) || obj.is_a?(ClassVar)
      return refuse(node, "a proc pointer that closes over a variable is not ported yet: #{node.name}")
    end
    if obj.is_a?(Path)
      owner = child_type(obj)
      return false if owner.nil?
      if owner.is_a?(LibType)
        return refuse(node, "a proc pointer to a lib function is not ported yet: #{node.name}")
      end
      return proc_pointer_expansion(node)
    end
    refuse(node, "a proc pointer on this receiver is not ported yet: #{node.name}")
  end

  # The expansion of a proc pointer (literal_expander.cr 1225-1251), visited in place of the pointer, which takes
  # its type from the expansion as the MacroIf arm does (visit(MacroIf) above).
  def proc_pointer_expansion(node : ProcPointer) : Bool
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = LiteralExpander.new(@program.normalizer).expand_proc_pointer(node)
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : PointerOf) : Bool
    exp = node.exp
    if exp.is_a?(ClassVar) || exp.is_a?(InstanceVar)
      return pointerof_variable(node, exp)
    end
    if exp.is_a?(Call)
      call = exp.as(Call)
      if call.args.empty? && call.named_args.nil? && call.block.nil? && call.block_arg.nil?
        if obj = call.obj
          obj.accept(self)
          if owner = child_type(obj)
            if owner.is_a?(LibType)
              if external = owner.as(LibType).lookup_fun(call.name)
                if external.external_var && external.primitive == "external_var_get"
                  if var_type = external.resolved_return
                    set_type(call, var_type)
                    set_type(node, type_node_system(@program).pointer_of(var_type))
                    return false
                  end
                end
              end
            end
          end
        end
      end
    end
    if exp.is_a?(Path)
      exp.accept(self)
      ct = @program.lookup_type_path?(exp.as(Path), @current_type)
      if ct
        if ct.const?
          ct.as(Const).pointer_read = true
          if et = child_type(exp)
            set_type(node, type_node_system(@program).pointer_of(et.as(Type)))
          end
          return false
        end
      end
    end
    visit_pointer_of(self, node)
  end

  # `pointerof(@x)` and `pointerof(@@x)`: a pointer to the variable's type, as the
  # hosted pass binds it (main_visitor.cr 3108-3114). The `iyi_written` mark is the
  # lowering's and is not set here.
  def pointerof_variable(node : PointerOf, exp : ASTNode) : Bool
    exp.accept(self)
    t = child_type(exp)
    return false if t.nil?
    set_type(node, type_node_system(@program).pointer_of(t.as(Type)))
    false
  end

  def visit(node : TypeOf) : Bool
    visit_type_of(self, node)
  end

  def visit(node : SizeOf) : Bool
    visit_size_of(self, node)
  end

  def visit(node : AlignOf) : Bool
    visit_align_of(self, node)
  end

  def visit(node : InstanceSizeOf) : Bool
    visit_instance_size_of(self, node)
  end

  def visit(node : InstanceAlignOf) : Bool
    visit_instance_align_of(self, node)
  end

  def visit(node : EnumDef) : Bool
    visit_enum_def(self, node)
  end

  def visit(node : UninitializedVar) : Bool
    visit_uninitialized_var(self, node)
  end

  # The visitor of a fun body: its own locals, sharing the maps lowering reads.
  def sub_visitor(vars : Hash(String, Type)) : TypeNodeHost
    inner = MainVisitor.new(@program, @speculation)
    inner.vars = vars
    inner.scope = @program
    inner.current_type = @current_type
    inner.node_types = @node_types
    inner.untyped_reasons = @untyped_reasons
    inner.call_target_defs = @call_target_defs
    inner.call_dispatch_targets = @call_dispatch_targets
    inner.call_arguments = @call_arguments
    inner.block_owners = @block_owners
    inner.lib_call_targets = @lib_call_targets
    inner.expansions = @expansions
    inner.target_consts = @target_consts
    inner.call_receivers = @call_receivers
    inner.total = @total
    inner.typing_stack = @typing_stack
    inner.refusals = @refusals
    inner.refusal_stream = @refusal_stream
    inner.typed_instances = @typed_instances
    inner.def_instances = @def_instances
    inner.instance_var_initializer_lists = @instance_var_initializer_lists
    inner.def_var_unions = @def_var_unions
    inner.def_nil_resets = @def_nil_resets
    inner.def_free_types = @def_free_types
    inner.untyped_locals = Hash(String, String).new
    inner.fun_inline_file = @fun_inline_file
    inner
  end

  def visit(node : Cast) : Bool
    visit_cast(self, node)
  end

  def visit(node : NilableCast) : Bool
    visit_nilable_cast(self, node)
  end

  # Whether the node being visited is inside a type argument.
  def in_type_args? : Bool
    @in_type_args > 0
  end

  def scope_type : Type?
    @scope
  end
  # --- type nodes: end ---
end

pub def node_class_name(node : ASTNode) : String
  if node.is_a?(Alias)
    "Alias"
  elsif node.is_a?(AlignOf)
    "AlignOf"
  elsif node.is_a?(And)
    "And"
  elsif node.is_a?(Annotation)
    "Annotation"
  elsif node.is_a?(AnnotationDef)
    "AnnotationDef"
  elsif node.is_a?(Arg)
    "Arg"
  elsif node.is_a?(ArrayLiteral)
    "ArrayLiteral"
  elsif node.is_a?(Asm)
    "Asm"
  elsif node.is_a?(AsmOperand)
    "AsmOperand"
  elsif node.is_a?(Assign)
    "Assign"
  elsif node.is_a?(AssocTypeDecl)
    "AssocTypeDecl"
  elsif node.is_a?(Block)
    "Block"
  elsif node.is_a?(BoolLiteral)
    "BoolLiteral"
  elsif node.is_a?(Break)
    "Break"
  elsif node.is_a?(CStructOrUnionDef)
    "CStructOrUnionDef"
  elsif node.is_a?(Call)
    "Call"
  elsif node.is_a?(Case)
    "Case"
  elsif node.is_a?(Cast)
    "Cast"
  elsif node.is_a?(CharLiteral)
    "CharLiteral"
  elsif node.is_a?(ClassDef)
    "ClassDef"
  elsif node.is_a?(ClassVar)
    "ClassVar"
  elsif node.is_a?(Def)
    "Def"
  elsif node.is_a?(Defer)
    "Defer"
  elsif node.is_a?(DoubleSplat)
    "DoubleSplat"
  elsif node.is_a?(EnumDef)
    "EnumDef"
  elsif node.is_a?(ExceptionHandler)
    "ExceptionHandler"
  elsif node.is_a?(Expressions)
    "Expressions"
  elsif node.is_a?(Extend)
    "Extend"
  elsif node.is_a?(ExternalVar)
    "ExternalVar"
