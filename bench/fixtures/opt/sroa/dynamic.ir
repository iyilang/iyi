; iyi-ir 1
source_filename = "dynamic"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i64 @dynamic(i64 %index) {
entry:
  %slot = alloca [2 x i64], align 8
  %element = getelementptr [2 x i64], ptr %slot, i64 0, i64 %index
  %value = load i64, ptr %element, align 8
  ret i64 %value
}
