# NamedTuple methods the prelude does not carry: dynamic key access,
# merge, clone, and conversion to Array/Hash.

module std/named_tuple

import std/tuple

struct ::NamedTuple
  # Creates a named tuple from keyword options.
  def self.new(**options : **T)
    options
  end

  # Returns the value for *key*, or panics if missing.
  def [](key : Symbol)
    fetch(key) { raise "Missing named tuple key: #{key.inspect}" }
  end

  # Returns the value for string *key*, or panics if missing.
  def [](key : String)
    fetch(key) { raise "Missing named tuple key: #{key.inspect}" }
  end

  # Returns the value for *key*, or nil if missing.
  def []?(key : Symbol)
    fetch(key, nil)
  end

  def []?(key : String)
    fetch(key, nil)
  end

  # Fetches value for *key*, returning *default_value* if missing.
  def fetch(key : Symbol, default_value)
    fetch(key) { default_value }
  end

  def fetch(key : String, default_value)
    fetch(key) { default_value }
  end

  # Fetches value for *key*, or yields to block if missing.
  def fetch(key : Symbol, &block)
    {% for k in T.keys %}
      return self[{{k.symbolize}}] if key == {{k.symbolize}}
    {% end %}
    yield key
  end

  def fetch(key : String, &block)
    {% for k in T.keys %}
      return self[{{k.symbolize}}] if key == {{k.stringify}}
    {% end %}
    yield key
  end

  # Returns true if the named tuple has the given string key.
  def has_key?(key : String) : Bool
    {% for k in T.keys %}
      return true if key == {{k.stringify}}
    {% end %}
    false
  end

  # Yields each key symbol in order.
  def each_key(& : Symbol -> Nil) : Nil
    {% for k in T.keys %}
      yield {{k.symbolize}}
    {% end %}
  end

  # Yields each key, value, and integer index.
  def each_with_index(offset : Int = 0, &) : Nil
    i = offset.to_i
    {% for k in T.keys %}
      yield {{k.symbolize}}, self[{{k.symbolize}}], i
      i += 1
    {% end %}
  end

  # Merges another named tuple with self. Entries in *other* overwrite matching keys.
  def merge(other : NamedTuple)
    merge(**other)
  end

  def merge(**other : **U) forall U
    {% begin %}
      NamedTuple.new(
        {% for k in T.keys %}
          {% unless U.keys.includes?(k) %}
            {{k.stringify}}: self[{{k.symbolize}}],
          {% end %}
        {% end %}
        {% for k in U.keys %}
          {{k.stringify}}: other[{{k.symbolize}}],
        {% end %}
      )
    {% end %}
  end

  # Merges self into other: self's values win on overlapping keys.
  def reverse_merge(other : NamedTuple)
    other.merge(self)
  end

  def reverse_merge(**other)
    reverse_merge(other)
  end

  # Deep clone of this named tuple.
  def clone
    {% if T.keys.size == 0 %}
      NamedTuple.new
    {% else %}
      NamedTuple.new(
        {% for k in T.keys %}
          {{k.stringify}}: self[{{k.symbolize}}].clone,
        {% end %}
      )
    {% end %}
  end

  # Converts this named tuple into an Array of {Symbol, Value} pairs.
  def to_a
    {% if T.keys.size == 0 %}
      [] of {Symbol, NoReturn}
    {% else %}
      [
        {% for k in T.keys %}
          { {{k.symbolize}}, self[{{k.symbolize}}] },
        {% end %}
      ]
    {% end %}
  end

  # Converts this named tuple into a Hash.
  def to_h
    {% if T.keys.size == 0 %}
      {} of Symbol => NoReturn
    {% else %}
      {
        {% for k in T.keys %}
          {{k.symbolize}} => self[{{k.symbolize}}],
        {% end %}
      }
    {% end %}
  end
end
