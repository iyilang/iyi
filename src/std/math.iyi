  private def self.atan2_row(t : Pointer(UInt64), i : Int32) : {UInt64, UInt64, UInt64, Int64, UInt64}
    {t[5 * i], t[5 * i + 1], t[5 * i + 2], t[5 * i + 3].unsafe_to_i64, t[5 * i + 4]}
  end

  # lshift / rshift: the 192-bit significand h:m:l shifted by k bits.
  private def self.atan2_shl192(h : UInt64, m : UInt64, l : UInt64, k : UInt64) : {UInt64, UInt64, UInt64}
    return {h, m, l} if k == 0_u64
    return {0_u64, 0_u64, 0_u64} if k >= 192_u64
    return {l.unsafe_shl(k &- 128_u64), 0_u64, 0_u64} if k >= 128_u64
    if k >= 64_u64
      return {m, l, 0_u64} if k == 64_u64
      k = k &- 64_u64
      return {m.unsafe_shl(k) | l.unsafe_shr(64_u64 &- k), l.unsafe_shl(k), 0_u64}
    end
    {h.unsafe_shl(k) | m.unsafe_shr(64_u64 &- k), m.unsafe_shl(k) | l.unsafe_shr(64_u64 &- k), l.unsafe_shl(k)}
  end

  private def self.atan2_shr192(h : UInt64, m : UInt64, l : UInt64, k : UInt64) : {UInt64, UInt64, UInt64}
    return {h, m, l} if k == 0_u64
    return {0_u64, 0_u64, 0_u64} if k >= 192_u64
    return {0_u64, 0_u64, h.unsafe_shr(k &- 128_u64)} if k >= 128_u64
    if k >= 64_u64
      return {0_u64, h, m} if k == 64_u64
      k = k &- 64_u64
      return {0_u64, h.unsafe_shr(k), m.unsafe_shr(k) | h.unsafe_shl(64_u64 &- k)}
    end
    {h.unsafe_shr(k), m.unsafe_shr(k) | h.unsafe_shl(64_u64 &- k), l.unsafe_shr(k) | m.unsafe_shl(64_u64 &- k)}
  end

  # a - b modulo 2^192.
  private def self.atan2_sub192(ah : UInt64, am : UInt64, al : UInt64, bh : UInt64, bm : UInt64, bl : UInt64) : {UInt64, UInt64, UInt64}
    l = al &- bl
    h, m = trig_sub128(ah, am, bh, bm)
    h, m = trig_sub128(h, m, 0_u64, l > al ? 1_u64 : 0_u64)
    {h, m, l}
  end

  # The leading zero count of a nonzero h:m:l.
  private def self.atan2_clz192(h : UInt64, m : UInt64, l : UInt64) : UInt64
    return trig_clz(h) if h != 0_u64
    return 64_u64 &+ trig_clz(m) if m != 0_u64
    128_u64 &+ trig_clz(l)
  end

  # cmp_tint_abs: -1, 0 or 1 as |a| <, = or > |b|.
  private def self.atan2_cmp_abs(ah : UInt64, am : UInt64, al : UInt64, aex : Int64, bh : UInt64, bm : UInt64, bl : UInt64, bex : Int64) : Int32
    return bh == 0_u64 ? 0 : -1 if ah == 0_u64
    return 1 if bh == 0_u64
    return aex > bex ? 1 : -1 if aex != bex
    return trig_lt128(ah, am, bh, bm) ? -1 : 1 if ah != bh || am != bm
    return 0 if al == bl
    al < bl ? -1 : 1
  end

  # mul_tint: the product, with error < 10 ulps.
  private def self.atan2_mul(ah : UInt64, am : UInt64, al : UInt64, aex : Int64, asg : UInt64, bh : UInt64, bm : UInt64, bl : UInt64, bex : Int64, bsg : UInt64) : {UInt64, UInt64, UInt64, Int64, UInt64}
    rex = aex &+ bex
    rh, rm = trig_mul64(ah, bh)
    h, rl = trig_mul64(ah, bm)
    rm = rm &+ h
    rh = rh &+ (rm < h ? 1_u64 : 0_u64)
    h, l = trig_mul64(am, bh)
    rl = rl &+ l
    cm = rl < l ? 1_u64 : 0_u64
    rm = rm &+ h
    rh = rh &+ (rm < h ? 1_u64 : 0_u64)
    sh, sl = trig_add128(0_u64, trig_mul64(ah, bl)[0], 0_u64, trig_mul64(am, bm)[0])
    sh, sl = trig_add128(sh, sl, 0_u64, trig_mul64(al, bh)[0])
    cm = cm &+ sh
    rl = rl &+ sl
    cm = cm &+ (rl < sl ? 1_u64 : 0_u64)
    rm = rm &+ cm
    rh = rh &+ (rm < cm ? 1_u64 : 0_u64)
    if rh.unsafe_shr(63_u64) == 0_u64
      rh = rh.unsafe_shl(1_u64) | rm.unsafe_shr(63_u64)
      rm = rm.unsafe_shl(1_u64) | rl.unsafe_shr(63_u64)
      rl = rl.unsafe_shl(1_u64)
      rex = rex &- 1_i64
    end
    {rh, rm, rl, rex, asg ^ bsg}
  end

  # add_tint: the sum, with error < 2 ulps.
  private def self.atan2_add(ah : UInt64, am : UInt64, al : UInt64, aex : Int64, asg : UInt64, bh : UInt64, bm : UInt64, bl : UInt64, bex : Int64, bsg : UInt64) : {UInt64, UInt64, UInt64, Int64, UInt64}
    c = atan2_cmp_abs(ah, am, al, aex, bh, bm, bl, bex)
    if c == 0
      return {0_u64, 0_u64, 0_u64, -1076_i64, 0_u64} if asg ^ bsg != 0_u64
      return {ah, am, al, aex &+ 1_i64, asg}
    end
    if c < 0
      ah, bh = bh, ah
      am, bm = bm, am
      al, bl = bl, al
      aex, bex = bex, aex
      asg, bsg = bsg, asg
    end
    sh = (aex &- bex).unsafe_to_u64
    th, tm, tl = atan2_shr192(bh, bm, bl, sh)
    if asg ^ bsg != 0_u64
      th, tm, tl = atan2_sub192(ah, am, al, th, tm, tl)
      ex = atan2_clz192(th, tm, tl)
      if ex <= 1_u64 || sh == 0_u64
        rh, rm, rl = atan2_shl192(th, tm, tl, ex)
        return {rh, rm, rl, aex &- ex.unsafe_to_i64, asg}
      end
      th, tm, tl = atan2_shl192(bh, bm, bl, ex &- sh)
      rh, rm, rl = atan2_shl192(ah, am, al, ex)
      th, tm, tl = atan2_sub192(rh, rm, rl, th, tm, tl)
      ex1 = atan2_clz192(th, tm, tl)
      rh, rm, rl = atan2_shl192(th, tm, tl, ex1)
      return {rh, rm, rl, aex &- (ex &+ ex1).unsafe_to_i64, asg}
    end
    rl = al &+ tl
    cl = rl < al ? 1_u64 : 0_u64
    rh, rm = trig_add128(ah, am, th, tm)
    ch = trig_lt128(rh, rm, ah, am) ? 1_u64 : 0_u64
    rh, rm = trig_add128(rh, rm, 0_u64, cl)
    ch = ch &+ (trig_lt128(rh, rm, 0_u64, cl) ? 1_u64 : 0_u64)
    return {rh, rm, rl, aex, asg} if ch == 0_u64
    rl = rm.unsafe_shl(63_u64) | rl.unsafe_shr(1_u64)
    rm = rh.unsafe_shl(63_u64) | rm.unsafe_shr(1_u64)
    rh = ch.unsafe_shl(63_u64) | rh.unsafe_shr(1_u64)
    {rh, rm, rl, aex &+ 1_i64, asg}
  end

  # tint_fromd: x exactly, for x not zero, infinite or NaN.
  private def self.atan2_fromd(x : Float64) : {UInt64, UInt64, UInt64, Int64, UInt64}
    u = IyiFloatText.bits_of(x)
    ax = u & 0x7fffffffffffffff_u64
    e = ax.unsafe_shr(52_u64)
    return {0x8000000000000000_u64 | ax.unsafe_shl(11_u64), 0_u64, 0_u64, e.unsafe_to_i64 &- 0x3fe_i64, u.unsafe_shr(63_u64)} if e != 0_u64
    e = trig_clz(ax)
    {ax.unsafe_shl(e), 0_u64, 0_u64, -0x3f2_i64 &- e.unsafe_to_i64, u.unsafe_shr(63_u64)}
  end

  # tint_tod: a rounded to nearest; err bounds the error on l in ulps
  # (0 for a value known to be a double, which is then truncated).
  private def self.atan2_tod(ah : UInt64, am : UInt64, al : UInt64, aex : Int64, asg : UInt64, err : UInt64, y : Float64, x : Float64) : Float64
    if aex >= 1025_i64
      return asg != 0_u64 ? -8.98846567431158e+307 - 8.98846567431158e+307 : 8.98846567431158e+307 + 8.98846567431158e+307
    end
    if aex <= -1074_i64
      tiny = IyiFloatText.from_bits(asg != 0_u64 ? 0x8000000000000001_u64 : 1_u64)
      return tiny * 0.5 if aex < -1074_i64
      return tiny * (ah == 0x8000000000000000_u64 && am == 0_u64 && al == 0_u64 ? 0.5 : 0.75)
    end
    hh = ah
    mm = am
    ll = al
    ex = aex
    low = hh & 0x7ff_u64
    if (mm == 0_u64 && (low == 0_u64 || low == 0x400_u64) && ll < err) ||
       (mm == 0xffffffffffffffff_u64 && (low == 0x3ff_u64 || low == 0x7ff_u64) && 0xffffffffffffffff_u64 &- ll < err)
      raise "Unexpected worst-case found, please report to core-math@inria.fr: atan2 y,x=#{y},#{x}"
    end
    if ex <= -1022_i64
      sh = (-1021_i64 &- ex).unsafe_to_u64
      ll = mm.unsafe_shl(64_u64 &- sh) | ll.unsafe_shr(sh) | (ll > 0_u64 ? 1_u64 : 0_u64)
      mm = hh.unsafe_shl(64_u64 &- sh) | mm.unsafe_shr(sh)
      hh = hh.unsafe_shr(sh)
      low = hh & 0x7ff_u64
      ex = ex &+ sh.unsafe_to_i64
    end
    h = hh.unsafe_shr(11_u64).to_f64
    l = 0.0
    if err != 0_u64
      if low < 0x400_u64
        l = 0.25
      elsif low > 0x400_u64
        l = 0.75
      else
        l = mm == 0_u64 && ll == 0_u64 ? 0.5 : 0.75
      end
    end
    s = asg != 0_u64 ? -1.0 : 1.0
    h = fma(l, s, s * h)
    h = h * 2.220446049250313e-16
    h * IyiFloatText.from_bits((0x3fe_i64 &+ ex).unsafe_to_u64.unsafe_shl(52_u64))
  end

  # inv_tint: 1/a with absolute error < 2^-103.9 for 1 <= r <= 2.
  private def self.atan2_inv(ah : UInt64, am : UInt64, al : UInt64, aex : Int64, asg : UInt64) : {UInt64, UInt64, UInt64, Int64, UInt64}
    a = atan2_tod(ah, am, al, aex, asg, 0_u64, 0.0, 0.0)
    subnormal = a.abs < 2.2250738585072014e-308
    a = a * 9007199254740992.0 if subnormal
    rh, rm, rl, rex, rsg = atan2_fromd(1.0 / a)
    rex = rex &+ 53_i64 if subnormal
    qh, qm, ql, qex, qsg = atan2_mul(ah, am, al, aex, asg, rh, rm, rl, rex, rsg)
    qh, qm, ql, qex, qsg = atan2_add(0x8000000000000000_u64, 0_u64, 0_u64, 1_i64, 0_u64, qh, qm, ql, qex, 1_u64 &- qsg)
    qh, qm, ql, qex, qsg = atan2_mul(rh, rm, rl, rex, rsg, qh, qm, ql, qex, qsg)
    atan2_add(rh, rm, rl, rex, rsg, qh, qm, ql, qex, qsg)
  end

  # div_tint: b/a with relative error < 2^-185.53.
  private def self.atan2_div(bh : UInt64, bm : UInt64, bl : UInt64, bex : Int64, bsg : UInt64, ah : UInt64, am : UInt64, al : UInt64, aex : Int64, asg : UInt64) : {UInt64, UInt64, UInt64, Int64, UInt64}
    yh, ym, yl, yex, ysg = atan2_inv(ah, am, al, aex, asg)
    rh, rm, rl, rex, rsg = atan2_mul(yh, ym, yl, yex, ysg, bh, bm, bl, bex, bsg)
    zh, zm, zl, zex, zsg = atan2_mul(ah, am, al, aex, asg, rh, rm, rl, rex, rsg)
    zh, zm, zl, zex, zsg = atan2_add(bh, bm, bl, bex, bsg, zh, zm, zl, zex, 1_u64 &- zsg)
    zh, zm, zl, zex, zsg = atan2_mul(yh, ym, yl, yex, ysg, zh, zm, zl, zex, zsg)
    atan2_add(rh, rm, rl, rex, rsg, zh, zm, zl, zex, zsg)
  end

  # div_tint_d: b/a for doubles.
  private def self.atan2_div_d(b : Float64, a : Float64) : {UInt64, UInt64, UInt64, Int64, UInt64}
    ah, am, al, aex, asg = atan2_fromd(a)
    bh, bm, bl, bex, bsg = atan2_fromd(b)
    atan2_div(bh, bm, bl, bex, bsg, ah, am, al, aex, asg)
  end

  # atan2_accurate: the [29,29] rational approximation of atan on [0, 1] in
  # 192-bit arithmetic, for finite nonzero y and x.
  private def self.atan2_accurate(y : Float64, x : Float64) : Float64
    t = y / x
    if t == 0.0
      return t if x > 0.0
      return y > 0.0 ? 3.141592653589793 + 1.2246467991473532e-16 : -3.141592653589793 - 1.2246467991473532e-16
    end
    corr = fma(t, x, y * -1.0)
    if corr == 0.0 && x > 0.0 && t.abs <= 1.3538603431225864e-08
      return fma(t, -5.551115123125783e-17, t) if y.abs >= 3.610388751729659e-276
      corr = fma(t * 4.056481920730334e+31, x, (y * -1.0) * 4.056481920730334e+31)
      return fma(t, -5.551115123125783e-17, t) if corr == 0.0
    end
    inv = y.abs > x.abs
    zh, zm, zl, zex, zsg = inv ? atan2_div_d(x, y) : atan2_div_d(y, x)
    if !inv && x > 0.0 && zex <= -96_i64
      zl = zl &- 2_u64
      zm = zm &- (zl < 2_u64 ? 1_u64 : 0_u64)
      zh = zh &- (zm < 1_u64 ? 1_u64 : 0_u64)
      return atan2_tod(zh, zm, zl, zex, zsg, 1_u64, y, x)
    end
    sz = zsg
    ptab = ATAN2_P.to_unsafe
    qtab = ATAN2_Q.to_unsafe
    ph, pm, pl, pex, psg = atan2_row(ptab, 29)
    qh, qm, ql, qex, qsg = atan2_row(qtab, 29)
    i = 28
    while i >= 0
      ph, pm, pl, pex, psg = atan2_mul(ph, pm, pl, pex, psg, zh, zm, zl, zex, 0_u64)
      qh, qm, ql, qex, qsg = atan2_mul(qh, qm, ql, qex, qsg, zh, zm, zl, zex, 0_u64)
      ch, cm, cl, cex, csg = atan2_row(ptab, i)
      ph, pm, pl, pex, psg = atan2_add(ph, pm, pl, pex, psg, ch, cm, cl, cex, csg)
      ch, cm, cl, cex, csg = atan2_row(qtab, i)
      qh, qm, ql, qex, qsg = atan2_add(qh, qm, ql, qex, qsg, ch, cm, cl, cex, csg)
      i -= 1
    end
    ph, pm, pl, pex, psg = atan2_mul(ph, pm, pl, pex, psg, zh, zm, zl, zex, 0_u64)
    zh, zm, zl, zex, zsg = atan2_div(ph, pm, pl, pex, psg, qh, qm, ql, qex, qsg)
    err = 662_u64
    zsg = sz
    pih, pim, pil, piex, pisg = atan2_row(ATAN2_PI.to_unsafe, 0)
    if inv
      # pi/2 - atan(x/y) or -pi/2 - atan(x/y)
      zh, zm, zl, zex, zsg = atan2_add(pih, pim, pil, piex &- 1_i64, pisg, zh, zm, zl, zex, 1_u64)
      zsg = 1_u64 if sz != 0_u64
      err = 524_u64
    end
    if x < 0.0
      # to the opposite quadrant: pi added or subtracted
      if zsg == 0_u64
        zh, zm, zl, zex, zsg = atan2_add(pih, pim, pil, piex, pisg, zh, zm, zl, zex, 1_u64)
        zsg = 1_u64
      else
        zh, zm, zl, zex, zsg = atan2_add(pih, pim, pil, piex, pisg, zh, zm, zl, zex, zsg)
      end
      err = 266_u64
    end
    atan2_tod(zh, zm, zl, zex, zsg, err, y, x)
  end

  # as_atan2_special: y or x zero, infinite or NaN.
  private def self.atan2_special(y : Float64, x : Float64) : Float64
    iy = IyiFloatText.bits_of(y)
    ix = IyiFloatText.bits_of(x)
    aiy = iy.unsafe_shl(1_u64)
    aix = ix.unsafe_shl(1_u64)
    inf = 0xffe0000000000000_u64
    if aiy >= inf || aix >= inf
      return y + x if aiy > inf || aix > inf
      if aiy == inf && aix == inf
        f = ATAN2_FINF.to_unsafe
        k = ix.unsafe_shr(63_u64).unsafe_to_i32 * 2
        return copysign(IyiFloatText.from_bits(f[k + 1]), y) + copysign(IyiFloatText.from_bits(f[k]), y)
      end
      if aix == inf
        return copysign(3.141592653589793, y) + copysign(1.2246467991473532e-16, y) if x < 0.0
        return copysign(0.0, y)
      end
      return copysign(1.5707963267948966, y) + copysign(6.123233995736766e-17, y)
    end
    if aiy == 0_u64 || aix == 0_u64
      if aiy == 0_u64 && aix == 0_u64
        return y if ix == 0_u64
        return iy == 0_u64 ? 3.141592653589793 + 1.2246467991473532e-16 : -3.141592653589793 - 1.2246467991473532e-16
      end
      if aiy == 0_u64
        return y / x if x > 0.0
        return iy.unsafe_shr(63_u64) == 0_u64 ? 3.141592653589793 + 1.2246467991473532e-16 : -3.141592653589793 - 1.2246467991473532e-16
      end
      return y > 0.0 ? 1.5707963267948966 + 6.123233995736766e-17 : -1.5707963267948966 - 6.123233995736766e-17
    end
    0.0
  end

  # The angle of (x, y), with the zeros' and infinities' signs read the
  # way C's atan2 reads them: atan2(0.0, -0.0) is pi, atan2(-0.0, -1.0) is
  # -pi, atan2(inf, inf) is pi/4.
  def self.atan2(y : Float64, x : Float64) : Float64
    iy = IyiFloatText.bits_of(y)
    ix = IyiFloatText.bits_of(x)
    aiy = iy & 0x7fffffffffffffff_u64
    return atan2_special(y, x) if aiy == 0_u64 || aiy >= 0x7ff0000000000000_u64
    aix = ix & 0x7fffffffffffffff_u64
    return atan2_special(y, x) if aix == 0_u64 || aix >= 0x7ff0000000000000_u64
    ax = IyiFloatText.from_bits(aix)
    ay = IyiFloatText.from_bits(aiy)
    xm = ax >= ay ? ax : ay
    ym = ax >= ay ? ay : ax
    sy = iy.unsafe_shr(63_u64)
    sx = ix.unsafe_shr(63_u64)
    gt = aix < aiy ? 1_u64 : 0_u64
    return atan2_accurate(y, x) if ((aix &- aiy) ^ (0_u64 &- gt)) >= 0x0350000000000000_u64
    sgn = gt ^ sx ^ sy != 0_u64 ? -1.0 : 1.0
    kw = (sx.unsafe_shl(2_u64) | sy.unsafe_shl(1_u64) | gt).unsafe_to_i32
    jt = (IyiFloatText.bits_of(ym / xm + 2.0078125).unsafe_shr(45_u64) & 127_u64).unsafe_to_i32
    f2 = ATAN2_F2.to_unsafe
    o = ATAN2_O.to_unsafe
    fh = IyiFloatText.from_bits(f2[2 * jt + 1]) * sgn
    fl = IyiFloatText.from_bits(f2[2 * jt]) * sgn
    fh = fh + IyiFloatText.from_bits(o[2 * kw])
    fl = fl + IyiFloatText.from_bits(o[2 * kw + 1])
    if xm < 1.1282464849155185e-277
      xm = xm * 8.863311460481781e+276
      ym = ym * 8.863311460481781e+276
    end
    if xm > 4.49423283715579e+307 && jt != 0
      xm = xm * 0.5
      ym = ym * 0.5
    end
    t0 = IyiFloatText.from_bits(ATAN2_T2.to_unsafe[jt])
    zn = fma(t0 * -1.0, xm, ym)
    zd = fma(t0, ym, xm)
    z = zn / zd
    b = ATAN2_B.to_unsafe
    z2 = z * z
    z = z * sgn
    dz = (z * z2) * (IyiFloatText.from_bits(b[0]) + z2 * (IyiFloatText.from_bits(b[1]) + z2 * IyiFloatText.from_bits(b[2])))
    eps = z.abs * 4.528712474471952e-16 + 8.077935669463161e-28
    rh, z = trig_fasttwosum(fh, z)
    rl = (fl + dz) + z
    lb = rh + (rl - eps)
    ub = rh + (rl + eps)
    return ub if lb == ub
    dh = ym * t0
    dl = fma(ym, t0, dh * -1.0)
    dh, e = trig_fasttwosum(xm, dh)
    rdh = 1.0 / dh
    dl = dl + e
    nh = xm * t0
    nl = fma(xm, t0, nh * -1.0)
    dt = ym - nh
    y1 = dt + nh
    if y1 == ym
      nh, nl = trig_fasttwosum(dt, nl * -1.0)
    else
      nh, nl = trig_fasttwosum(dt, (ym - y1) - nl)
    end
    zh = nh * rdh
    z2 = zh * zh
    zl = rdh * (fma(dh, zh * -1.0, nh) + (nl - (nh * rdh) * dl))
    c = ATAN2_B2.to_unsafe
    zl = zl + zh * z2 * ((IyiFloatText.from_bits(c[0]) + z2 * IyiFloatText.from_bits(c[1])) +
                         (z2 * z2) * (IyiFloatText.from_bits(c[2]) + z2 * IyiFloatText.from_bits(c[3])))
    zh = zh * sgn
    zl = zl * sgn
    eps = 1.1102230246251565e-15 * (zh.abs * z2 + 4.440892098500626e-16)
    fh, sl = trig_fasttwosum(fh, zh)
    fl = (fl + zl) + sl
    lb = fh + (fl - eps)
    ub = fh + (fl + eps)
    return ub if lb == ub
    atan2_accurate(y, x)
  end

  def self.atan2(y : Float32, x : Float32) : Float32
    atan2(y.to_f64, x.to_f64).to_f32
  end

  def self.atan2(y : T, x : U) : Float64 forall T, U
    atan2(y.to_f64, x.to_f64)
  end

  def self.asin(value : Float64) : Float64
    x = value
    bits = IyiFloatText.bits_of(x)
    ax = bits.unsafe_shl(1_u64)
    t = 0.0
    z = 0.0
    zl = 0.0
    jd = 0.0
    f0h = 0.0
    f0l = 0.0
    eps = 0.0
    if ax > 0x7fc0000000000000_u64
      off = ASIN_OFF.to_unsafe
      k = bits.unsafe_shr(63_u64).unsafe_to_i32 * 2
      f0h = IyiFloatText.from_bits(off[k])
      f0l = IyiFloatText.from_bits(off[k + 1])
      if ax >= 0x7fe0000000000000_u64
        return f0h + f0l if ax == 0x7fe0000000000000_u64
        return x + x if ax > 0xffe0000000000000_u64
        return 0.0 / 0.0
      end
      t = 2.0 - 2.0 * x.abs
      jd = invtrig_roundeven(t * 32.0)
      z = copysign(sqrt(t), x * -1.0)
      zl = fma(z, z, t * -1.0) * ((-0.5 / t) * z)
      t = 0.25 * t - jd * 0.0078125
      eps = (z * t).abs * 3.5475095083725705e-16
    else
      return fma(2.7755575615628914e-17, x, x) if ax < 0x7cae26e892247dec_u64
      t = x * x
      jd = invtrig_roundeven(t * 128.0)
      t = fma(x, x, -0.0078125 * jd)
      z = x
      eps = (z * t).abs * 3.2526065174565133e-16
    end
    lb, ub = invtrig_fast(z, zl, t, jd, f0h, f0l, eps)
    return asin_refine(x, lb) if lb != ub
    lb
  end

  def self.asin(value : Float32) : Float32
    asin(value.to_f64).to_f32
  end

  def self.asin(value : T) : Float64 forall T
    asin(value.to_f64)
  end

  def self.acos(value : Float64) : Float64
    x = value
    bits = IyiFloatText.bits_of(x)
    ax = bits.unsafe_shl(1_u64)
    t = 0.0
    z = 0.0
    zl = 0.0
    jd = 0.0
    f0h = 0.0
    f0l = 0.0
    eps = 0.0
    if ax > 0x7fc0000000000000_u64
      if bits.unsafe_shr(63_u64) != 0_u64
        f0h = 3.141592653589793
        f0l = 1.2246467991473532e-16
      end
      if ax >= 0x7fe0000000000000_u64
        return f0h + f0l if ax == 0x7fe0000000000000_u64
        return x + x if ax > 0xffe0000000000000_u64
        return 0.0 / 0.0
      end
      t = 2.0 - 2.0 * x.abs
      jd = invtrig_roundeven(t * 32.0)
      z = copysign(sqrt(t), x)
      zl = fma(z, z, t * -1.0) * ((-0.5 / t) * z)
      t = 0.25 * t - jd * 0.0078125
      eps = (z * t).abs * 3.434752482434078e-16 + 2.465190328815662e-32
    else
      f0h = 1.5707963267948966
      f0l = 6.123233995736766e-17
      if ax <= 0x7e00000000000000_u64
        v = ax <= 0x791967670d2e8fe8_u64 ? 0.0 : (x * x) * (-0.16666666666666666 * x)
        h, w = invtrig_fasttwosum(f0h, x * -1.0)
        l = v + (w + f0l)
        lb = h + (l - 1.990403348955723e-24)
        ub = h + (l + 1.990403348955723e-24)
        return acos_refine(x, lb) if lb != ub
        return lb
      end
      t = x * x
      jd = invtrig_roundeven(t * 128.0)
      t = fma(x, x, -0.0078125 * jd)
      z = x * -1.0
      eps = (z * t) * 3.3393426912553537e-16
    end
    lb, ub = invtrig_fast(z, zl, t, jd, f0h, f0l, eps)
    return acos_refine(x, lb) if lb != ub
    lb
  end

  def self.acos(value : Float32) : Float32
    acos(value.to_f64).to_f32
  end

  def self.acos(value : T) : Float64 forall T
    acos(value.to_f64)
  end

  # sinh, cosh and tanh as glibc 2.43 computes them - fdlibm's
  # `e_sinh.c`, `e_cosh.c` and `s_tanh.c` (Sun's notice is at `expm1`), on
  # the `exp` and `expm1` above, which are glibc's to the last bit, so
  # these are too. Their branches are fdlibm's, at its thresholds, read off
  # the high word: a series near zero and `half_exp` past 709 answered
  # differently in the last bit for 952 arguments of sinh in 100,000, 217
  # of cosh and 4,863 of tanh.
  def self.sinh(value : Float64) : Float64
    ix = high_word(value) & 0x7fffffff_i64
    return value + value if ix >= 0x7ff00000_i64
    h = IyiFloatText.bits_of(value).unsafe_shr(63_u64) != 0_u64 ? -0.5 : 0.5
    v = value.abs
    if ix < 0x40360000_i64
      # |x| < 2^-28: sinh(x) is x.
      return value if ix < 0x3e300000_i64
      t = expm1(v)
      return h * (2.0 * t - t * t / (t + 1.0)) if ix < 0x3ff00000_i64
      return h * (t + t / (t + 1.0))
    end
    return h * exp(v) if ix < 0x40862e42_i64
    # Up to the overflow threshold, exp of half and the product.
    if IyiFloatText.bits_of(v) <= 0x408633ce8fb9f87d_u64
      w = exp(0.5 * v)
      t = h * w
      return t * w
    end
    value * 1.0e307
  end

  def self.sinh(value : Float32) : Float32
    sinh(value.to_f64).to_f32
  end

  def self.sinh(value : T) : Float64 forall T
    sinh(value.to_f64)
  end

  def self.cosh(value : Float64) : Float64
    ix = high_word(value) & 0x7fffffff_i64
    v = value.abs
    if ix < 0x40360000_i64
      if ix < 0x3fd62e43_i64
        # |x| < 0.5 ln 2: 1 + expm1(|x|)^2 / (2 exp(|x|)), and 1 below 2^-55.
        return 1.0 if ix < 0x3c800000_i64
        t = expm1(v)
        w = 1.0 + t
        return 1.0 + (t * t) / (w + w)
      end
      t = exp(v)
      return 0.5 * t + 0.5 / t
    end
    return 0.5 * exp(v) if ix < 0x40862e42_i64
    if IyiFloatText.bits_of(v) <= 0x408633ce8fb9f87d_u64
      w = exp(0.5 * v)
      t = 0.5 * w
      return t * w
    end
    return value * value if ix >= 0x7ff00000_i64
    1.0e300 * 1.0e300
  end

  def self.cosh(value : Float32) : Float32
    cosh(value.to_f64).to_f32
  end

  def self.cosh(value : T) : Float64 forall T
    cosh(value.to_f64)
  end

  def self.tanh(value : Float64) : Float64
    bits = IyiFloatText.bits_of(value)
    negative = bits.unsafe_shr(63_u64) != 0_u64
    ix = high_word(value) & 0x7fffffff_i64
    if ix >= 0x7ff00000_i64
      # tanh(+-inf) is +-1, and NaN stays NaN.
      return negative ? 1.0 / value - 1.0 : 1.0 / value + 1.0
    end
    z = 1.0
    if ix < 0x40360000_i64
      return value if bits & 0x7fffffffffffffff_u64 == 0_u64
      return value * (1.0 + value) if ix < 0x3c800000_i64
      v = value.abs
      if ix >= 0x3ff00000_i64
        t = expm1(2.0 * v)
        z = 1.0 - 2.0 / (t + 2.0)
      else
        t = expm1(-2.0 * v)
        z = (t * -1.0) / (t + 2.0)
      end
    end
    negative ? z * -1.0 : z
  end

  def self.tanh(value : Float32) : Float32
    tanh(value.to_f64).to_f32
  end

  def self.tanh(value : T) : Float64 forall T
    tanh(value.to_f64)
  end

