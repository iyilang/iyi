# Kemal's DSL, ported from `kemal/src/kemal/dsl.cr`.
#
# The original's first line is the whole problem: "Kemal DSL is defined here
# and it's baked into global scope." `require "kemal"` injects `get`, `post`
# and `before_all` into the importing program's namespace — the same action at
# a distance as an open class, and also Kemal's entire identity. Making users
# write `kemal.get "/" do ... end` would be safe and would kill the framework.
#
# `import X::{...}` moves the decision to the consumer: the library exports
# names, and the program says which ones it wants unqualified. See
# `webapp.iyi`.
module kemal/dsl

import kemal/router::{Router, Context, IntoBody}

HTTP_METHODS = %w(get post put patch delete options head)

# One application value, in place of `Kemal::RouteHandler::INSTANCE` and the
# three singletons beside it. `router.cr:270` works around those being global
# and mutable — "may have been cleared between tests" — and nothing about
# separate compilation forced that; a clean sheet is just the moment to fix it.
APP = Router.new

{% for method in HTTP_METHODS %}
  pub def {{ method.id }}(path : String, &block : Context -> B) : Nil forall B : IntoBody
    APP.{{ method.id }}(path, &block)
  end
{% end %}

pub def before_all(path : String = "*", &block : Context -> B) : Nil forall B : IntoBody
  APP.before(path, &block)
end

pub def after_all(path : String = "*", &block : Context -> B) : Nil forall B : IntoBody
  APP.after(path, &block)
end

pub def mount(path : String, router : Router) : Nil
  APP.mount(path, router)
end

pub def app : Router
  APP
end
