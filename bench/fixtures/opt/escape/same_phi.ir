; iyi-ir 1
source_filename = "escape_same_phi"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external ptr @__iyi_new(i64, i64, i64)
define internal i64 @same_phi(i1 %choose) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 4, i64 2)
  br i1 %choose, label %left, label %right
left:
  br label %join
right:
  br label %join
join:
  %choice = phi ptr [ %p, label %left ], [ %p, label %right ]
  store i64 7, ptr %choice, align 8
  %v = load i64, ptr %choice, align 8
  ret i64 %v
}
