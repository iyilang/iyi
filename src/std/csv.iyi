# CSV, RFC 4180, written in iyi.
#
# `CSV.parse` reads a document into rows of fields. A field may be
# quoted; a quote inside a quoted field is doubled. The separator is
# a comma. Lines end at LF, CRLF or a lone CR, and a blank line is a row
# of no fields, as in the other library. `CSV.build` writes the same
# contract: a field is quoted when it holds a comma, a quote or a
# line break, a row of one empty field is written `""`, and a last row
# of no fields is ended with a line break. A quote without its pair is
# `unterminated quoted field`; text after a closing quote, and a quote in
# a field that did not open with one, are refused at their line and
# column, as the other library refuses them. A byte order mark is read
# past, and a UTF-16 document is refused by its.

module std/csv

pub struct CSV
  def self.parse(text : String) : Array(Array(String))
    rows = [] of Array(String)
    row = [] of String
    n = text.bytesize
    src = text.to_unsafe
    i = 0
    field = Pointer(UInt8).malloc((n + 1).to_u64)
    flen = 0
    quoted = false
    # The field opened with a quote: `""` is a field even with no bytes in
    # it, and a last line of just `""` was dropped as if it were nothing.
    opened = false
    # Past a byte order mark, which Excel writes into every "CSV UTF-8"
    # file: the first header field kept it, and `row[0] == "id"` was false.
    i = 3 if n >= 3 && src[0] == 0xEF_u8 && src[1] == 0xBB_u8 && src[2] == 0xBF_u8
    # UTF-16's, FF FE or FE FF - what Windows PowerShell 5.1's `Out-File`
    # and `>` write - was read as UTF-8: `"ÿþ\"Name\""` and every field
    # after it with a NUL between its letters, and no error.
    if n >= 2 && ((src[0] == 0xFF_u8 && src[1] == 0xFE_u8) || (src[0] == 0xFE_u8 && src[1] == 0xFF_u8))
      raise "CSV: the document is UTF-16, by its byte order mark, and is read as UTF-8"
    end
    while i < n
      b = src[i]
      if quoted
        if b == 34_u8 # "
          if i + 1 < n && src[i + 1] == 34_u8
            field[flen] = 34_u8
            flen = flen + 1
            i = i + 2
          else
            quoted = false
            i = i + 1
            # Only a comma, a line break or the end may follow: `"a"b,c`
            # was the field `ab`, where RFC 4180 has no such field.
            if i < n && src[i] != 44_u8 && src[i] != 10_u8 && src[i] != 13_u8
              refuse(text, i, "expecting comma, newline or end, not '#{char_at(text, i)}'")
            end
          end
        else
          field[flen] = b
          flen = flen + 1
          i = i + 1
        end
      else
        if b == 34_u8 && flen == 0
          quoted = true
          opened = true
          i = i + 1
        elsif b == 34_u8
          # A quote in a field that did not open with one: `a"b,c` was the
          # field `a"b`, a guess at what an unpaired quote meant.
          refuse(text, i, "unexpected quote")
        elsif b == 44_u8 # comma
          row << take(field, flen)
          flen = 0
          opened = false
          i = i + 1
        elsif b == 10_u8 || b == 13_u8
          # A lone CR ends the line as the other library's does: it was
          # dropped, joining the text either side of it into one field.
          # A blank line is a row of no fields there, not of one empty one.
          row << take(field, flen) if row.size > 0 || flen > 0 || opened
          flen = 0
          opened = false
          rows << row
          row = [] of String
          i = i + 1
          i = i + 1 if b == 13_u8 && i < n && src[i] == 10_u8
        else
          field[flen] = b
          flen = flen + 1
          i = i + 1
        end
      end
    end
    raise "unterminated quoted field" if quoted
    if flen > 0 || row.size > 0 || opened
      row << take(field, flen)
      rows << row
    end
    rows
  end

  # Into one builder: adding each field to the text so far copied that
  # text once per field, and 20,000 rows of five took 12.8 seconds.
  def self.build(rows : Array(Array(String))) : String
    String.build do |io|
      r = 0
      while r < rows.size
        io << '\n' if r > 0
        fields = rows[r]
        # One empty field bare is a blank line, which reads back as a row of
        # no fields, or as nothing at the end: quoted, it is the field.
        io << "\"\"" if fields.size == 1 && fields[0].empty?
        c = 0
        # A U+FEFF at the front of the text is read past as a byte order
        # mark, so a first field opening with one came back without it:
        # `[["\uFEFFid"]]` read back as `[["id"]]`. Quoted, the text opens
        # with `"` and the mark is the field's.
        if r == 0 && fields.size > 0 && fields[0].starts_with?('\uFEFF')
          io << quote(fields[0])
          c = 1
        end
        while c < fields.size
          io << ',' if c > 0
          io << escape(fields[c])
          c = c + 1
        end
        r = r + 1
      end
      # A document's last line break ends a row rather than starting one,
      # so a last row of no fields - the empty text after the last `\n` -
      # was read back as nothing: `[["a"], []]` came back `[["a"]]`, and
      # `[[]]` came back `[]`. Its line is ended.
      io << '\n' if rows.size > 0 && rows[rows.size - 1].empty?
    end
  end

  private def self.take(field : Pointer(UInt8), flen : Int32) : String
    String.new(flen) { |dst| dst.copy_from(field, flen) }
  end

  # The line and column of the byte at *at*, both counted from 1 and the
  # column in characters, as the other library counts them: worked out
  # here, on the way out, so a document that parses pays nothing for them.
  private def self.refuse(text : String, at : Int32, what : String) : NoReturn
    src = text.to_unsafe
    line = 1
    column = 1
    i = 0
    while i < at
      b = src[i]
      if b == 10_u8 || (b == 13_u8 && !(i + 1 < at && src[i + 1] == 10_u8))
        line = line + 1
        column = 1
      elsif b != 13_u8 && (b & 0xC0_u8) != 0x80_u8
        column = column + 1
      end
      i = i + 1
    end
    raise "#{what} at line #{line}, column #{column}"
  end

  # The character that starts at byte *at*, for a refusal to name.
  private def self.char_at(text : String, at : Int32) : String
    b = text.to_unsafe[at]
    len = b < 0x80_u8 ? 1 : (b < 0xE0_u8 ? 2 : (b < 0xF0_u8 ? 3 : 4))
    len = text.bytesize - at if len > text.bytesize - at
    take(text.to_unsafe + at, len)
  end

  private def self.escape(field : String) : String
    need = false
    p = field.to_unsafe
    n = field.bytesize
    i = 0
    while i < n
      b = p[i]
      if b == 44_u8 || b == 34_u8 || b == 10_u8 || b == 13_u8
        need = true
        break
      end
      i = i + 1
    end
    return field unless need
    quote(field)
  end

  # Always quoted: a field that holds a separator, or a first field that
  # opens with U+FEFF.
  private def self.quote(field : String) : String
    p = field.to_unsafe
    n = field.bytesize
    extra = 2
    i = 0
    while i < n
      extra = extra + 1 if p[i] == 34_u8
      i = i + 1
    end
    String.new(n + extra) do |dst|
      dst[0] = 34_u8
      o = 1
      i = 0
      while i < n
        dst[o] = p[i]
        o = o + 1
        if p[i] == 34_u8
          dst[o] = 34_u8
          o = o + 1
        end
        i = i + 1
      end
      dst[o] = 34_u8
    end
  end
end
