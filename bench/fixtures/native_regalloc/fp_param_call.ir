; iyi-ir 1
module "fp_param_call"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @tick() {
entry:
  ret i64 7
}

define internal i64 @parameter(double %x) {
entry:
  %other = call i64 () @tick()
  %value = fptosi double %x to i64
  %result = add i64 %value, %other
  ret i64 %result
}

define i32 @main() {
entry:
  %r = call i64 (double) @parameter(double 0x400c000000000000)
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i64 %r)
  ret i32 0
}
