# Standard YAML 1.2 Core Schema parser and emitter for iyi.
# Fully native: zero C library bindings (no libyaml, no libc).
#
# Bounded subset:
#   * Block mappings and sequences, nested and indentation-sensitive.
#     Supports sequence nested under mapping key at the same indentation level.
#   * Flow mappings `{}` and flow sequences `[]`, including nested.
#   * Plain, single-quoted (with `''` escape), and double-quoted (with standard C escapes) scalars.
#   * Block scalars: literal `|` and folded `>` with clip (default), strip `-`, and keep `+` chomping.
#   * Document separators `---` and terminators `...` supporting multi-document streams.
#   * Anchors `&a` and aliases `*a` with cycle detection and merge keys (`<<`).
#   * Tag resolution: YAML 1.2 Core Schema (null, bool, int, float, string).
#     - Norway problem: `NO`, `no`, `off`, `n`, `y` resolve to String, not Boolean.
#     - Integers: decimal (`0`, `[1-9][0-9]*`), hex (`0x...`), octal (`0o...`).
#     - `0777` (no `0o`) and `1_000` (underscores) resolve to String per 1.2 Core Schema.
#     - Sexagesimal (`22:22`) and version-like (`1.2.3`) resolve to String.
#   * Security bounds:
#     - Tabs forbidden as indentation (syntax error on leading tabs).
#     - Cyclic anchor references refused with immediate error.
#     - Billion-laughs / alias bomb protection: bounded to 1,000 alias expansions.
#     - Maximum nesting depth: bounded to 128 levels.
#   * Emitter: `YAML.dump(Any)` emits clean YAML 1.2 with minimal necessary quoting,
#     guaranteeing round-trip fidelity.
#
# Boundaries and omissions:
#   * Arbitrary user tags (`!type`) are preserved as raw strings rather than dispatched to custom constructors.
#   * Complex block mapping keys (mapping or sequence as a key via `? key : val`) are omitted.
#   * Directives (`%YAML 1.2`) at document head are skipped.

module std/yaml

import std/text

struct Line
  property line_number : Int32
  property indent : Int32
  property raw : String
  property text : String
  property has_tab : Bool
  property blank : Bool
  property comment : Bool

  def initialize(@line_number : Int32, @indent : Int32, @raw : String, @text : String, @has_tab : Bool, @blank : Bool, @comment : Bool)
  end
end

pub struct Any
  alias Type = Nil | Bool | Int64 | Float64 | String | Array(Any) | Hash(Any, Any)

  getter raw : Type

  def initialize(@raw : Type)
  end

  def initialize(value : Int32)
    @raw = value.to_i64
  end

  def null? : Bool
    @raw.is_a?(Nil)
  end

  def as_nil : Nil
    @raw.as(Nil)
  end

  def as_nil? : Nil?
    null? ? nil : nil
  end

  def as_bool : Bool
    @raw.as(Bool)
  end

  def as_bool? : Bool?
    @raw.is_a?(Bool) ? @raw.as(Bool) : nil
  end

  def as_i : Int64
    @raw.as(Int64)
  end

  def as_i? : Int64?
    @raw.is_a?(Int64) ? @raw.as(Int64) : nil
  end

  def as_i32 : Int32
    @raw.as(Int64).to_i32
  end

  def as_i32? : Int32?
    @raw.is_a?(Int64) ? @raw.as(Int64).to_i32 : nil
  end

  def as_f : Float64
    if @raw.is_a?(Float64)
      @raw.as(Float64)
    elsif @raw.is_a?(Int64)
      @raw.as(Int64).to_f64
    else
      @raw.as(Float64)
    end
  end

  def as_f? : Float64?
    if @raw.is_a?(Float64)
      @raw.as(Float64)
    elsif @raw.is_a?(Int64)
      @raw.as(Int64).to_f64
    else
      nil
    end
  end

  def as_s : String
    @raw.as(String)
  end

  def as_s? : String?
    @raw.is_a?(String) ? @raw.as(String) : nil
  end

  def as_a : Array(Any)
    @raw.as(Array(Any))
  end

  def as_a? : Array(Any)?
    @raw.is_a?(Array(Any)) ? @raw.as(Array(Any)) : nil
  end

  def as_h : Hash(Any, Any)
    @raw.as(Hash(Any, Any))
  end

  def as_h? : Hash(Any, Any)?
    @raw.is_a?(Hash(Any, Any)) ? @raw.as(Hash(Any, Any)) : nil
  end

  def [](key : String) : Any
    h = as_h
    k = Any.new(key)
    val = h[k]?
    return val unless val.nil?
    raise "YAML: key not found: #{key}"
  end

  def []?(key : String) : Any?
    h = as_h?
    return nil if h.nil?
    h[Any.new(key)]?
  end

  def [](key : Any) : Any
    h = as_h
    val = h[key]?
    return val unless val.nil?
    raise "YAML: key not found"
  end

  def []?(key : Any) : Any?
    h = as_h?
    return nil if h.nil?
    h[key]?
  end

  def [](index : Int32) : Any
    as_a[index]
  end

  def []?(index : Int32) : Any?
    arr = as_a?
    return nil if arr.nil?
    arr[index]?
  end

  def size : Int32
    if @raw.is_a?(Array(Any))
      @raw.as(Array(Any)).size
    elsif @raw.is_a?(Hash(Any, Any))
      @raw.as(Hash(Any, Any)).size
    elsif @raw.is_a?(String)
      @raw.as(String).size
    else
      0
    end
  end

  def empty? : Bool
    size == 0
  end

  def hash : Int32
    case r = @raw
    when Nil
      0
    when Bool
      r ? 1 : 2
    when Int64
      r.to_i32
    when Float64
      r.to_i.to_i32
    when String
      r.hash
    else
      42
    end
  end

  def ==(other : Any) : Bool
    @raw == other.raw
  end

  def to_s : String
    case r = @raw
    when Nil
      "null"
    when Bool
      r ? "true" : "false"
    when Int64
      r.to_s
    when Float64
      if r != r
        ".nan"
      elsif r > 1e308 && r == r * 2.0
        ".inf"
      elsif r < -1e308 && r == r * 2.0
        "-.inf"
      else
        r.to_s
      end
    when String
      r
    when Array(Any)
      "[" + r.map { |item| item.to_s }.join(", ") + "]"
    when Hash(Any, Any)
      pairs = [] of String
      r.each do |k, v|
        pairs << "#{k.to_s}: #{v.to_s}"
      end
      "{" + pairs.join(", ") + "}"
    else
      ""
    end
  end

  def inspect : String
    to_s
  end
end

pub struct YAML
  def self.node_weight(val : Any) : Int32
    case r = val.raw
    when Array(Any)
      total = 1
      r.each do |item|
        total += node_weight(item)
        return 10001 if total > 10000
      end
      total
    when Hash(Any, Any)
      total = 1
      r.each do |k, v|
        total += node_weight(k) + node_weight(v)
        return 10001 if total > 10000
      end
      total
    else
      1
    end
  end

  def self.encode_utf8(cp : Int32) : String
    if cp < 0x80
      String.new(1) { |b| b[0] = cp.to_u8 }
    elsif cp < 0x800
      String.new(2) do |b|
        b[0] = (0xC0 | (cp >> 6)).to_u8
        b[1] = (0x80 | (cp & 0x3F)).to_u8
      end
    elsif cp < 0x10000
      String.new(3) do |b|
        b[0] = (0xE0 | (cp >> 12)).to_u8
        b[1] = (0x80 | ((cp >> 6) & 0x3F)).to_u8
        b[2] = (0x80 | (cp & 0x3F)).to_u8
      end
    elsif cp <= 0x10FFFF
      String.new(4) do |b|
        b[0] = (0xF0 | (cp >> 18)).to_u8
        b[1] = (0x80 | ((cp >> 12) & 0x3F)).to_u8
        b[2] = (0x80 | ((cp >> 6) & 0x3F)).to_u8
        b[3] = (0x80 | (cp & 0x3F)).to_u8
      end
    else
      "?"
    end
  end

  def self.is_hex_int?(s : String) : Bool
    return false if s.empty?
    idx = 0
    if s[0] == '+' || s[0] == '-'
      idx += 1
    end
    return false if s.size - idx < 3
    return false unless s[idx] == '0' && (s[idx + 1] == 'x' || s[idx + 1] == 'X')
    idx += 2
    while idx < s.size
      c = s[idx]
      is_hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
      return false unless is_hex
      idx += 1
    end
    true
  end

  def self.parse_hex_int(s : String) : Int64?
    idx = 0
    neg = false
    if s[0] == '-'
      neg = true
      idx += 1
    elsif s[0] == '+'
      idx += 1
    end
    idx += 2
    hex_part = s[idx, s.size - idx]
    val = hex_part.to_i64?(16)
    return nil if val.nil?
    neg ? (0_i64 - val) : val
  end

  def self.is_oct_int?(s : String) : Bool
    return false if s.empty?
    idx = 0
    if s[0] == '+' || s[0] == '-'
      idx += 1
    end
    return false if s.size - idx < 3
    return false unless s[idx] == '0' && (s[idx + 1] == 'o' || s[idx + 1] == 'O')
    idx += 2
    while idx < s.size
      c = s[idx]
      return false unless c >= '0' && c <= '7'
      idx += 1
    end
    true
  end

  def self.parse_oct_int(s : String) : Int64?
    idx = 0
    neg = false
    if s[0] == '-'
      neg = true
      idx += 1
    elsif s[0] == '+'
      idx += 1
    end
    idx += 2
    oct_part = s[idx, s.size - idx]
    val = oct_part.to_i64?(8)
    return nil if val.nil?
    neg ? (0_i64 - val) : val
  end

  def self.is_dec_int?(s : String) : Bool
    return false if s.empty?
    idx = 0
    if s[0] == '+' || s[0] == '-'
      idx += 1
    end
    rem_size = s.size - idx
    return false if rem_size == 0
    if rem_size == 1
      return s[idx] == '0' || (s[idx] >= '1' && s[idx] <= '9')
    end
    return false unless s[idx] >= '1' && s[idx] <= '9'
    idx += 1
    while idx < s.size
      return false unless s[idx] >= '0' && s[idx] <= '9'
      idx += 1
    end
    true
  end

  def self.is_valid_float?(s : String) : Bool
    return false if s.empty?
    idx = 0
    if s[0] == '+' || s[0] == '-'
      idx += 1
    end
    rem_size = s.size - idx
    return false if rem_size == 0

    dot_count = 0
    e_count = 0
    has_digits = false

    while idx < s.size
      c = s[idx]
      if c >= '0' && c <= '9'
        has_digits = true
      elsif c == '.'
        dot_count += 1
        return false if dot_count > 1
        return false if e_count > 0
      elsif c == 'e' || c == 'E'
        e_count += 1
        return false if e_count > 1
        return false unless has_digits
        if idx + 1 < s.size && (s[idx + 1] == '+' || s[idx + 1] == '-')
          idx += 1
        end
      else
        return false
      end
      idx += 1
    end

    has_digits && (dot_count == 1 || e_count == 1)
  end

  def self.resolve_plain_scalar(s : String) : Any::Type
    return nil if s.empty?

    case s
    when "~", "null", "Null", "NULL"
      return nil
    when "true", "True", "TRUE"
      return true
    when "false", "False", "FALSE"
      return false
    when ".inf", ".Inf", ".INF", "+.inf", "+.Inf", "+.INF"
      return 1.0 / 0.0
    when "-.inf", "-.Inf", "-.INF"
      return -1.0 / 0.0
    when ".nan", ".NaN", ".NAN"
      return 0.0 / 0.0
    end

    if is_hex_int?(s)
      val = parse_hex_int(s)
      return val unless val.nil?
    end

    if is_oct_int?(s)
      val = parse_oct_int(s)
      return val unless val.nil?
    end

    if is_dec_int?(s)
      val = s.to_i64?
      return val unless val.nil?
    end

    if is_valid_float?(s)
      fval = s.to_f?
      return fval unless fval.nil?
    end

    s
  end

  def self.unquote_single(s : String) : String
    return "" if s.size < 2
    content = s[1, s.size - 2]
    result = ""
    idx = 0
    while idx < content.size
      if content[idx] == '\'' && idx + 1 < content.size && content[idx + 1] == '\''
        result = result + "'"
        idx += 2
      else
        result = result + content[idx, 1]
        idx += 1
      end
    end
    result
  end

  def self.unquote_double(s : String) : String
    return "" if s.size < 2
    content = s[1, s.size - 2]
    result = ""
    idx = 0
    sz = content.size

    while idx < sz
      c = content[idx]
      if c == '\\' && idx + 1 < sz
        next_c = content[idx + 1]
        case next_c
        when '0'
          result = result + "\0"
          idx += 2
        when 'a'
          result = result + 7.chr.to_s
          idx += 2
        when 'b'
          result = result + "\b"
          idx += 2
        when 't'
          result = result + "\t"
          idx += 2
        when 'n'
          result = result + "\n"
          idx += 2
        when 'v'
          result = result + 11.chr.to_s
          idx += 2
        when 'f'
          result = result + "\f"
          idx += 2
        when 'r'
          result = result + "\r"
          idx += 2
        when 'e'
          result = result + 27.chr.to_s
          idx += 2
        when '"'
          result = result + "\""
          idx += 2
        when '\\'
          result = result + "\\"
          idx += 2
        when '/'
          result = result + "/"
          idx += 2
        when ' '
          result = result + " "
          idx += 2
        when 'x'
          if idx + 3 < sz
            hex_str = content[idx + 2, 2]
            cp = hex_str.to_i?(16)
            if cp
              result = result + encode_utf8(cp)
              idx += 4
            else
              result = result + "\\x"
              idx += 2
            end
          else
            result = result + "\\x"
            idx += 2
          end
        when 'u'
          if idx + 5 < sz
            hex_str = content[idx + 2, 4]
            cp = hex_str.to_i?(16)
            if cp
              result = result + encode_utf8(cp)
              idx += 6
            else
              result = result + "\\u"
              idx += 2
            end
          else
            result = result + "\\u"
            idx += 2
          end
        when 'U'
          if idx + 9 < sz
            hex_str = content[idx + 2, 8]
            cp = hex_str.to_i?(16)
            if cp
              result = result + encode_utf8(cp)
              idx += 10
            else
              result = result + "\\U"
              idx += 2
            end
          else
            result = result + "\\U"
            idx += 2
          end
        else
          result = result + content[idx, 2]
          idx += 2
        end
      else
        result = result + content[idx, 1]
        idx += 1
      end
    end

    result
  end

  def self.strip_trailing_comment(s : String) : String
    in_single = false
    in_double = false
    idx = 0
    sz = s.size

    while idx < sz
      c = s[idx]
      if c == '\'' && !in_double
        in_single = !in_single
      elsif c == '"' && !in_single
        escaped = false
        if idx > 0 && s[idx - 1] == '\\'
          bs_count = 0
          back_idx = idx - 1
          while back_idx >= 0 && s[back_idx] == '\\'
            bs_count += 1
            back_idx -= 1
          end
          escaped = (bs_count % 2) != 0
        end
        in_double = !in_double unless escaped
      elsif c == '#' && !in_single && !in_double
        if idx == 0 || s[idx - 1] == ' ' || s[idx - 1] == '\t'
          return s[0, idx].rstrip
        end
      end
      idx += 1
    end

    s.rstrip
  end

  def self.find_mapping_colon(s : String) : Int32?
    in_single = false
    in_double = false
    bracket_depth = 0
    brace_depth = 0
    idx = 0
    sz = s.size

    while idx < sz
      c = s[idx]
      if c == '\'' && !in_double
        in_single = !in_single
      elsif c == '"' && !in_single
        escaped = false
        if idx > 0 && s[idx - 1] == '\\'
          bs_count = 0
          back_idx = idx - 1
          while back_idx >= 0 && s[back_idx] == '\\'
            bs_count += 1
            back_idx -= 1
          end
          escaped = (bs_count % 2) != 0
        end
        in_double = !in_double unless escaped
      elsif !in_single && !in_double
        if c == '['
          bracket_depth += 1
        elsif c == ']'
          bracket_depth -= 1 if bracket_depth > 0
        elsif c == '{'
          brace_depth += 1
        elsif c == '}'
          brace_depth -= 1 if brace_depth > 0
        elsif c == ':' && bracket_depth == 0 && brace_depth == 0
          if idx == sz - 1 || s[idx + 1] == ' ' || s[idx + 1] == '\t'
            return idx
          end
        end
      end
      idx += 1
    end

    nil
  end

  def self.split_lines(input : String) : Array(Line)
    lines = [] of Line
    line_num = 1
    start_idx = 0
    len = input.size

    while start_idx <= len
      end_idx = start_idx
      while end_idx < len && input[end_idx] != '\n' && input[end_idx] != '\r'
        end_idx += 1
      end

      raw_line = input[start_idx, end_idx - start_idx]

      if end_idx < len && input[end_idx] == '\r' && end_idx + 1 < len && input[end_idx + 1] == '\n'
        start_idx = end_idx + 2
      elsif end_idx < len
        start_idx = end_idx + 1
      else
        start_idx = len + 1
      end

      indent = 0
      has_tab = false
      blank = true
      comment = false
      idx = 0

      while idx < raw_line.size
        c = raw_line[idx]
        if c == ' '
          indent += 1 if blank
        elsif c == '\t'
          has_tab = true if blank
          indent += 1 if blank
        elsif c == '#' && blank
          blank = false
          comment = true
          break
        else
          blank = false
          break
        end
        idx += 1
      end
      text = blank ? "" : raw_line[indent, raw_line.size - indent]
      lines << Line.new(line_num, indent, raw_line, text, has_tab, blank, comment)
      line_num += 1

      break if start_idx > len
    end

    lines
  end

  def self.parse(input : String, max_aliases : Int32 = 1000, max_depth : Int32 = 128) : Any
    lines = split_lines(input)
    parser = Parser.new(lines, max_aliases: max_aliases, max_depth: max_depth)
    docs = parser.parse_all
    docs.empty? ? Any.new(nil) : docs[0]
  end

  def self.parse_all(input : String, max_aliases : Int32 = 1000, max_depth : Int32 = 128) : Array(Any)
    lines = split_lines(input)
    parser = Parser.new(lines, max_aliases: max_aliases, max_depth: max_depth)
    parser.parse_all
  end

  def self.dump(any : Any) : String
    Emitter.dump(any)
  end

  def self.dump(hash : Hash(String, Any)) : String
    h = Hash(Any, Any).new
    hash.each { |k, v| h[Any.new(k)] = v }
    Emitter.dump(Any.new(h))
  end
end

class FlowParser
  @s : String
  @pos : Int32
  @anchors : Hash(String, Any)
  @resolving_anchors : Array(String)
  @alias_count : Int32
  @max_aliases : Int32
  @depth : Int32
  @max_depth : Int32

  def initialize(@s : String, @anchors : Hash(String, Any), @resolving_anchors : Array(String), @alias_count : Int32, @max_aliases : Int32, @depth : Int32, @max_depth : Int32)
    @pos = 0
  end

  def alias_count : Int32
    @alias_count
  end

  def parse : Any
    skip_whitespace
    return Any.new(nil) if @pos >= @s.size
    parse_value
  end

  private def skip_whitespace : Nil
    while @pos < @s.size
      c = @s[@pos]
      if c == ' ' || c == '\t' || c == '\r' || c == '\n'
        @pos += 1
      elsif c == '#'
        while @pos < @s.size && @s[@pos] != '\n'
          @pos += 1
        end
      else
        break
      end
    end
  end

  private def parse_value : Any
    skip_whitespace
    return Any.new(nil) if @pos >= @s.size

    if @s[@pos] == '&'
      @pos += 1
      anchor_name = ""
      while @pos < @s.size && @s[@pos] != ' ' && @s[@pos] != '\t' && @s[@pos] != ',' && @s[@pos] != ']' && @s[@pos] != '}'
        anchor_name = anchor_name + @s[@pos, 1]
        @pos += 1
      end
      if @resolving_anchors.includes?(anchor_name)
        raise "YAML: cyclic anchor reference '&#{anchor_name}' detected"
      end
      @resolving_anchors << anchor_name
      val = parse_value
      @resolving_anchors.unsafe_set_size(@resolving_anchors.size - 1)
      @anchors[anchor_name] = val
      return val
    end

    if @s[@pos] == '*'
      @pos += 1
      alias_name = ""
      while @pos < @s.size && @s[@pos] != ' ' && @s[@pos] != '\t' && @s[@pos] != ',' && @s[@pos] != ']' && @s[@pos] != '}'
        alias_name = alias_name + @s[@pos, 1]
        @pos += 1
      end
      if @resolving_anchors.includes?(alias_name)
        raise "YAML: cyclic anchor reference '*#{alias_name}' detected"
      end
      val = @anchors[alias_name]?
      if val.nil?
        raise "YAML: unknown anchor '*#{alias_name}'"
      end
      weight = YAML.node_weight(val)
      @alias_count += weight
      if @alias_count > @max_aliases
        raise "YAML: alias expansion limit exceeded (#{@max_aliases})"
      end
      return val
    end

    c = @s[@pos]
    if c == '['
      parse_sequence
    elsif c == '{'
      parse_mapping
    elsif c == '\''
      parse_single_quote
    elsif c == '"'
      parse_double_quote
    else
      parse_plain
    end
  end

  private def parse_single_quote : Any
    start = @pos
    @pos += 1
    while @pos < @s.size
      if @s[@pos] == '\''
        if @pos + 1 < @s.size && @s[@pos + 1] == '\''
          @pos += 2
        else
          @pos += 1
          break
        end
      else
        @pos += 1
      end
    end
    raw_str = @s[start, @pos - start]
    Any.new(YAML.unquote_single(raw_str))
  end

  private def parse_double_quote : Any
    start = @pos
    @pos += 1
    while @pos < @s.size
      if @s[@pos] == '\\'
        @pos += 2
      elsif @s[@pos] == '"'
        @pos += 1
        break
      else
        @pos += 1
      end
    end
    raw_str = @s[start, @pos - start]
    Any.new(YAML.unquote_double(raw_str))
  end

  private def parse_sequence : Any
    @depth += 1
    if @depth > @max_depth
      raise "YAML: maximum depth exceeded (#{@max_depth})"
    end
    @pos += 1
    items = [] of Any

    loop do
      skip_whitespace
      break if @pos >= @s.size
      if @s[@pos] == ']'
        @pos += 1
        break
      end

      items << parse_value
      skip_whitespace
      break if @pos >= @s.size

      if @s[@pos] == ','
        @pos += 1
        skip_whitespace
        if @pos < @s.size && @s[@pos] == ']'
          @pos += 1
          break
        end
      elsif @s[@pos] == ']'
        @pos += 1
        break
      else
        raise "YAML: expected ',' or ']' in flow sequence at position #{@pos}"
      end
    end

    @depth -= 1
    Any.new(items)
  end

  private def parse_mapping : Any
    @depth += 1
    if @depth > @max_depth
      raise "YAML: maximum depth exceeded (#{@max_depth})"
    end
    @pos += 1
    map = Hash(Any, Any).new

    loop do
      skip_whitespace
      break if @pos >= @s.size
      if @s[@pos] == '}'
        @pos += 1
        break
      end

      key = parse_value
      skip_whitespace
      if @pos >= @s.size || @s[@pos] != ':'
        raise "YAML: expected ':' in flow mapping at position #{@pos}"
      end
      @pos += 1
      val = parse_value

      if key.raw == "<<"
        if val.as_h?
          val.as_h.each { |k, v| map[k] = v unless map.has_key?(k) }
        elsif val.as_a?
          val.as_a.each do |elem|
            if elem.as_h?
              elem.as_h.each { |k, v| map[k] = v unless map.has_key?(k) }
            end
          end
        else
          map[key] = val
        end
      else
        map[key] = val
      end

      skip_whitespace
      break if @pos >= @s.size
      if @s[@pos] == ','
        @pos += 1
        skip_whitespace
        if @pos < @s.size && @s[@pos] == '}'
          @pos += 1
          break
        end
      elsif @s[@pos] == '}'
        @pos += 1
        break
      else
        raise "YAML: expected ',' or '}' in flow mapping at position #{@pos}"
      end
    end

    @depth -= 1
    Any.new(map)
  end

  private def parse_plain : Any
    start = @pos
    while @pos < @s.size
      c = @s[@pos]
      if c == ',' || c == ']' || c == '}' || c == '#' || c == '\n' || c == '\r'
        break
      elsif c == ':'
        if @pos + 1 == @s.size || @s[@pos + 1] == ' ' || @s[@pos + 1] == '\t' || @s[@pos + 1] == ',' || @s[@pos + 1] == ']' || @s[@pos + 1] == '}'
          break
        end
      end
      @pos += 1
    end
    token = @s[start, @pos - start].strip
    Any.new(YAML.resolve_plain_scalar(token))
  end
end

class Parser
  @lines : Array(Line)
  @idx : Int32
  @anchors : Hash(String, Any)
  @resolving_anchors : Array(String)
  @alias_count : Int32
  @max_aliases : Int32
  @depth : Int32
  @max_depth : Int32

  def initialize(@lines : Array(Line), @max_aliases : Int32 = 1000, @max_depth : Int32 = 128)
    @idx = 0
    @anchors = Hash(String, Any).new
    @resolving_anchors = [] of String
    @alias_count = 0
    @depth = 0
  end

  def parse_all : Array(Any)
    docs = [] of Any
    skip_empty_and_comments

    while @idx < @lines.size
      line = @lines[@idx]
      if line.text.starts_with?("---")
        @idx += 1
        rest = line.text[3, line.text.size - 3].strip
        rest = YAML.strip_trailing_comment(rest)
        if !rest.empty?
          doc = parse_single_line_content(rest, line.line_number)
          docs << doc
          skip_to_next_document
          next
        end
      end

      skip_empty_and_comments
      if @idx >= @lines.size
        break
      end

      cur_line = @lines[@idx]
      if cur_line.text == "..." || cur_line.text.starts_with?("... ") || cur_line.text.starts_with?("...#")
        docs << Any.new(nil)
        @idx += 1
        skip_empty_and_comments
        next
      end

      doc = parse_node(0)
      docs << doc
      skip_to_next_document
    end

    docs
  end

  private def skip_to_next_document : Nil
    while @idx < @lines.size
      line = @lines[@idx]
      if line.text == "..." || line.text.starts_with?("... ") || line.text.starts_with?("...#")
        @idx += 1
        break
      elsif line.text == "---" || line.text.starts_with?("--- ") || line.text.starts_with?("---#")
        break
      else
        @idx += 1
      end
    end
    skip_empty_and_comments
  end

  private def skip_empty_and_comments : Nil
    while @idx < @lines.size
      line = @lines[@idx]
      if line.blank || line.comment
        @idx += 1
      else
        break
      end
    end
  end

  private def peek_non_blank_line : Line?
    i = @idx
    while i < @lines.size
      l = @lines[i]
      return l unless l.blank || l.comment
      i += 1
    end
    nil
  end

  def parse_node(current_indent : Int32) : Any
    skip_empty_and_comments
    return Any.new(nil) if @idx >= @lines.size

    line = @lines[@idx]
    if line.has_tab
      raise "YAML: tabs are forbidden as indentation in YAML at line #{line.line_number}"
    end

    if line.text == "---" || line.text.starts_with?("--- ") || line.text == "..." || line.text.starts_with?("... ")
      return Any.new(nil)
    end

    if line.text.starts_with?("- ") || line.text == "-"
      return parse_block_sequence(line.indent)
    end

    colon = YAML.find_mapping_colon(line.text)
    if !colon.nil?
      return parse_block_mapping(line.indent)
    end

    if line.text.starts_with?("[") || line.text.starts_with?("{")
      return parse_flow_node
    end

    parse_scalar_node(current_indent)
  end

  private def parse_flow_node : Any
    flow_str = ""
    start_line = @lines[@idx].line_number
    bracket_depth = 0
    brace_depth = 0

    while @idx < @lines.size
      line = @lines[@idx]
      break if line.text.starts_with?("---") || line.text.starts_with?("...")
      line_clean = YAML.strip_trailing_comment(line.text)

      in_s = false
      in_d = false
      idx = 0
      while idx < line_clean.size
        c = line_clean[idx]
        if c == '\'' && !in_d
          in_s = !in_s
        elsif c == '"' && !in_s
          in_d = !in_d
        elsif !in_s && !in_d
          if c == '['
            bracket_depth += 1
          elsif c == ']'
            bracket_depth -= 1 if bracket_depth > 0
          elsif c == '{'
            brace_depth += 1
          elsif c == '}'
            brace_depth -= 1 if brace_depth > 0
          end
        end
        idx += 1
      end

      flow_str = flow_str.empty? ? line_clean : (flow_str + " " + line_clean)
      @idx += 1

      if bracket_depth == 0 && brace_depth == 0
        break
      end
    end

    flow_parser = FlowParser.new(flow_str, @anchors, @resolving_anchors, @alias_count, @max_aliases, @depth, @max_depth)
    val = flow_parser.parse
    @alias_count = flow_parser.alias_count
    val
  end

  private def parse_single_line_content(s : String, line_num : Int32) : Any
    if s.starts_with?("[") || s.starts_with?("{")
      flow_parser = FlowParser.new(s, @anchors, @resolving_anchors, @alias_count, @max_aliases, @depth, @max_depth)
      val = flow_parser.parse
      @alias_count = flow_parser.alias_count
      return val
    end

    colon = YAML.find_mapping_colon(s)
    if colon
      key_str = s[0, colon].strip
      val_str = s[colon + 1, s.size - (colon + 1)].strip
      k = parse_scalar_value(key_str, line_num)
      v = parse_scalar_value(val_str, line_num)
      h = Hash(Any, Any).new
      h[k] = v
      return Any.new(h)
    end

    parse_scalar_value(s, line_num)
  end

  private def parse_block_sequence(indent_level : Int32) : Any
    @depth += 1
    if @depth > @max_depth
      raise "YAML: maximum depth exceeded (#{@max_depth})"
    end

    items = [] of Any

    while @idx < @lines.size
      skip_empty_and_comments
      break if @idx >= @lines.size

      line = @lines[@idx]
      if line.has_tab
        raise "YAML: tabs are forbidden as indentation in YAML at line #{line.line_number}"
      end

      if line.text.starts_with?("---") || line.text.starts_with?("...")
        break
      end

      break if line.indent < indent_level

      if line.indent == indent_level
        unless line.text.starts_with?("- ") || line.text == "-"
          break
        end

        if line.text == "-"
          rest = ""
        else
          rest = line.text[2, line.text.size - 2].strip
        end
        item_line_num = line.line_number
        content_indent = line.indent + 2
        @idx += 1

        rest = YAML.strip_trailing_comment(rest)

        if !rest.empty?
          anchor_name = ""
          if rest.starts_with?("&")
            space_idx = rest.index(' ')
            if space_idx
              anchor_name = rest[1, space_idx - 1]
              rest = rest[space_idx + 1, rest.size - (space_idx + 1)].strip
            else
              anchor_name = rest[1, rest.size - 1]
              rest = ""
            end
          end

          colon = YAML.find_mapping_colon(rest)
          if colon
            first_k = rest[0, colon].strip
            first_v = rest[colon + 1, rest.size - (colon + 1)].strip
            map = Hash(Any, Any).new
            k = parse_scalar_value(first_k, item_line_num)
            v = parse_scalar_value(first_v, item_line_num)
            map[k] = v

            while @idx < @lines.size
              skip_empty_and_comments
              break if @idx >= @lines.size
              sub_line = @lines[@idx]
              break if sub_line.text.starts_with?("---") || sub_line.text.starts_with?("...")
              break if sub_line.indent < content_indent
              break if sub_line.indent > content_indent

              sub_colon = YAML.find_mapping_colon(sub_line.text)
              break if sub_colon.nil?

              sub_k_str = sub_line.text[0, sub_colon].strip
              sub_v_str = sub_line.text[sub_colon + 1, sub_line.text.size - (sub_colon + 1)].strip
              sub_v_str = YAML.strip_trailing_comment(sub_v_str)
              @idx += 1

              sub_k = parse_scalar_value(sub_k_str, sub_line.line_number)
              if !sub_v_str.empty?
                sub_v = parse_scalar_value(sub_v_str, sub_line.line_number)
              else
                nxt = peek_non_blank_line
                if !nxt.nil? && nxt.indent > content_indent
                  sub_v = parse_node(content_indent)
                else
                  sub_v = Any.new(nil)
                end
              end

              map[sub_k] = sub_v
            end

            item_node = Any.new(map)
            if !anchor_name.empty?
              @anchors[anchor_name] = item_node
            end
            items << item_node
          elsif rest.starts_with?("|") || rest.starts_with?(">")
            val_s = parse_block_scalar(rest, indent_level)
            item_node = Any.new(val_s)
            if !anchor_name.empty?
              @anchors[anchor_name] = item_node
            end
            items << item_node
          elsif rest.starts_with?("[") || rest.starts_with?("{")
            val_f = parse_flow_string(rest)
            if !anchor_name.empty?
              @anchors[anchor_name] = val_f
            end
            items << val_f
          elsif rest.starts_with?("- ")
            nested_seq = parse_block_sequence(content_indent)
            items << nested_seq
          elsif rest.starts_with?("*")
            alias_name = rest[1, rest.size - 1].strip
            val_a = resolve_alias(alias_name, item_line_num)
            items << val_a
          else
            val_s = parse_scalar_value(rest, item_line_num)
            if !anchor_name.empty?
              @anchors[anchor_name] = val_s
            end
            items << val_s
          end
        else
          nxt = peek_non_blank_line
          if nxt.nil? || nxt.indent <= indent_level
            items << Any.new(nil)
          else
            child_node = parse_node(indent_level)
            items << child_node
          end
        end
      else
        break
      end
    end

    @depth -= 1
    Any.new(items)
  end

  private def parse_block_mapping(indent_level : Int32) : Any
    @depth += 1
    if @depth > @max_depth
      raise "YAML: maximum depth exceeded (#{@max_depth})"
    end
    map = Hash(Any, Any).new
    while @idx < @lines.size
      skip_empty_and_comments
      break if @idx >= @lines.size
      line = @lines[@idx]
      if line.has_tab
        raise "YAML: tabs are forbidden as indentation in YAML at line #{line.line_number}"
      end

      if line.text.starts_with?("---") || line.text.starts_with?("...")
        break
      end

      break if line.indent < indent_level
      break if line.indent > indent_level

      colon = YAML.find_mapping_colon(line.text)

      break if colon.nil?

      key_str = line.text[0, colon].strip
      val_str = line.text[colon + 1, line.text.size - (colon + 1)].strip
      val_str = YAML.strip_trailing_comment(val_str)
      key_line_num = line.line_number
      @idx += 1

      key_node = parse_scalar_value(key_str, key_line_num)

      anchor_name = ""
      if val_str.starts_with?("&")
        space_idx = val_str.index(' ')
        if space_idx
          anchor_name = val_str[1, space_idx - 1]
          val_str = val_str[space_idx + 1, val_str.size - (space_idx + 1)].strip
        else
          anchor_name = val_str[1, val_str.size - 1]
          val_str = ""
        end
      end

      if !anchor_name.empty?
        if @resolving_anchors.includes?(anchor_name)
          raise "YAML: cyclic anchor reference '&#{anchor_name}' detected at line #{key_line_num}"
        end
        @resolving_anchors << anchor_name
      end

      val_node : Any = Any.new(nil)

      if !val_str.empty?
        if val_str.starts_with?("|") || val_str.starts_with?(">")
          val_node = Any.new(parse_block_scalar(val_str, indent_level))
        elsif val_str.starts_with?("[") || val_str.starts_with?("{")
          val_node = parse_flow_string(val_str)
        elsif val_str.starts_with?("*")
          alias_name = val_str[1, val_str.size - 1].strip
          val_node = resolve_alias(alias_name, key_line_num)
        else
          plain_s = val_str
          while @idx < @lines.size
            nxt = @lines[@idx]
            if nxt.blank || nxt.comment
              break
            end
            if nxt.indent > indent_level && YAML.find_mapping_colon(nxt.text).nil? && !nxt.text.starts_with?("- ") && !nxt.text.starts_with?("---") && !nxt.text.starts_with?("...")
              plain_s = plain_s + " " + YAML.strip_trailing_comment(nxt.text)
              @idx += 1
            else
              break
            end
          end
          val_node = parse_scalar_value(plain_s, key_line_num)
        end
      else
        nxt = peek_non_blank_line
        if nxt.nil? || nxt.indent < indent_level
          val_node = Any.new(nil)
        elsif nxt.indent == indent_level
          if nxt.text.starts_with?("- ") || nxt.text == "-"
            val_node = parse_block_sequence(indent_level)
          else
            val_node = Any.new(nil)
          end
        else
          val_node = parse_node(indent_level)
        end
      end

      if !anchor_name.empty?
        @resolving_anchors.unsafe_set_size(@resolving_anchors.size - 1)
        @anchors[anchor_name] = val_node
      end

      if key_node.raw == "<<"
        if val_node.as_h?
          val_node.as_h.each { |k, v| map[k] = v unless map.has_key?(k) }
        elsif val_node.as_a?
          val_node.as_a.each do |elem|
            if elem.as_h?
              elem.as_h.each { |k, v| map[k] = v unless map.has_key?(k) }
            end
          end
        else
          map[key_node] = val_node
        end
      else
        map[key_node] = val_node
      end
    end

    @depth -= 1
    Any.new(map)
  end

  private def parse_scalar_node(current_indent : Int32) : Any
    line = @lines[@idx]
    @idx += 1
    str = YAML.strip_trailing_comment(line.text)

    while @idx < @lines.size
      nxt = @lines[@idx]
      break if nxt.blank || nxt.comment
      if nxt.indent > line.indent && YAML.find_mapping_colon(nxt.text).nil? && !nxt.text.starts_with?("- ")
        str = str + " " + YAML.strip_trailing_comment(nxt.text)
        @idx += 1
      else
        break
      end
    end

    parse_scalar_value(str, line.line_number)
  end

  private def parse_scalar_value(s : String, line_num : Int32) : Any
    return Any.new(nil) if s.empty?

    if s.starts_with?("&")
      space_idx = s.index(' ')
      if space_idx
        anchor_name = s[1, space_idx - 1]
        rest = s[space_idx + 1, s.size - (space_idx + 1)].strip
        val = parse_scalar_value(rest, line_num)
        @anchors[anchor_name] = val
        return val
      end
    end

    if s.starts_with?("*")
      alias_name = s[1, s.size - 1].strip
      return resolve_alias(alias_name, line_num)
    end

    if s.starts_with?("'") && s.ends_with?("'") && s.size >= 2
      return Any.new(YAML.unquote_single(s))
    elsif s.starts_with?("\"") && s.ends_with?("\"") && s.size >= 2
      return Any.new(YAML.unquote_double(s))
    end

    Any.new(YAML.resolve_plain_scalar(s))
  end

  private def resolve_alias(alias_name : String, line_num : Int32) : Any
    if @resolving_anchors.includes?(alias_name)
      raise "YAML: cyclic anchor reference '*#{alias_name}' detected at line #{line_num}"
    end
    val = @anchors[alias_name]?
    if val.nil?
      raise "YAML: unknown anchor '*#{alias_name}' at line #{line_num}"
    end
    weight = YAML.node_weight(val)
    @alias_count += weight
    if @alias_count > @max_aliases
      raise "YAML: alias expansion limit exceeded (#{@max_aliases}) at line #{line_num}"
    end
    val
  end

  private def parse_flow_string(s : String) : Any
    flow_parser = FlowParser.new(s, @anchors, @resolving_anchors, @alias_count, @max_aliases, @depth, @max_depth)
    val = flow_parser.parse
    @alias_count = flow_parser.alias_count
    val
  end

  private def parse_block_scalar(header : String, parent_indent : Int32) : String
    is_folded = header.starts_with?(">")
    chomping = 0
    explicit_indent = 0

    idx = 1
    while idx < header.size
      c = header[idx]
      if c == '-'
        chomping = 1
      elsif c == '+'
        chomping = 2
      elsif c >= '1' && c <= '9'
        explicit_indent = c.ord - '0'.ord
      end
      idx += 1
    end

    content_lines = [] of String
    content_indent = -1

    while @idx < @lines.size
      line = @lines[@idx]

      if line.blank
        if content_indent != -1
          content_lines << ""
        end
        @idx += 1
        next
      end

      if content_indent == -1
        if explicit_indent > 0
          content_indent = parent_indent + explicit_indent
        else
          content_indent = line.indent
          if content_indent <= parent_indent
            break
          end
        end
      end

      if line.indent < content_indent
        break
      end

      line_text = line.raw.size >= content_indent ? line.raw[content_indent, line.raw.size - content_indent] : ""
      content_lines << line_text
      @idx += 1
    end

    if is_folded
      result = ""
      i = 0
      while i < content_lines.size
        l = content_lines[i]
        if l.empty?
          result = result + "\n"
          i += 1
        else
          if result.empty? || result.ends_with?("\n")
            result = result + l
          else
            result = result + " " + l
          end
          if i + 1 >= content_lines.size || content_lines[i + 1].empty?
            result = result + "\n"
          end
          i += 1
        end
      end
    else
      result = content_lines.join("\n")
      result = result + "\n" unless content_lines.empty? || result.ends_with?("\n")
    end

    if chomping == 1
      while result.ends_with?("\n") || result.ends_with?("\r")
        result = result[0, result.size - 1]
      end
    elsif chomping == 0
      while result.ends_with?("\n\n")
        result = result[0, result.size - 1]
      end
    end

    result
  end
end

class Emitter
  def self.dump(any : Any) : String
    case r = any.raw
    when Nil
      "null\n"
    when Bool
      r ? "true\n" : "false\n"
    when Int64
      "#{r}\n"
    when Float64
      if r != r
        ".nan\n"
      elsif r > 1e308 && r == r * 2.0
        ".inf\n"
      elsif r < -1e308 && r == r * 2.0
        "-.inf\n"
      else
        "#{r}\n"
      end
    when String
      dump_string(r) + "\n"
    when Array(Any)
      if r.empty?
        "[]\n"
      else
        dump_array(r, 0)
      end
    when Hash(Any, Any)
      if r.empty?
        "{}\n"
      else
        dump_hash(r, 0)
      end
    else
      "null\n"
    end
  end

  private def self.needs_quotes?(s : String) : Bool
    return true if s.empty?

    case s
    when "~", "null", "Null", "NULL", "true", "True", "TRUE", "false", "False", "FALSE"
      return true
    when ".inf", ".Inf", ".INF", "+.inf", "+.Inf", "+.INF", "-.inf", "-.Inf", "-.INF", ".nan", ".NaN", ".NAN"
      return true
    end

    if YAML.is_hex_int?(s) || YAML.is_oct_int?(s) || YAML.is_dec_int?(s) || YAML.is_valid_float?(s)
      return true
    end

    return true if s.starts_with?(" ") || s.ends_with?(" ")

    c0 = s[0]
    if c0 == '-' || c0 == '?' || c0 == ':' || c0 == ',' || c0 == '[' || c0 == ']' ||
       c0 == '{' || c0 == '}' || c0 == '#' || c0 == '&' || c0 == '*' || c0 == '!' ||
       c0 == '|' || c0 == '>' || c0 == '\'' || c0 == '"' || c0 == '%' || c0 == '@' || c0 == '`'
      return true
    end

    return true if s.includes?(": ") || s.ends_with?(":") || s.includes?(" #")
    return true if s.includes?("\n") || s.includes?("\r") || s.includes?("\t") || s.includes?("\"")

    false
  end

  private def self.dump_string(s : String) : String
    if needs_quotes?(s)
      res = "\""
      idx = 0
      while idx < s.size
        c = s[idx]
        case c
        when '\n'
          res = res + "\\n"
        when '\r'
          res = res + "\\r"
        when '\t'
          res = res + "\\t"
        when '"'
          res = res + "\\\""
        when '\\'
          res = res + "\\\\"
        when '\0'
          res = res + "\\0"
        else
          res = res + s[idx, 1]
        end
        idx += 1
      end
      res + "\""
    else
      s
    end
  end

  private def self.dump_array(arr : Array(Any), indent : Int32) : String
    res = ""
    sp = " " * indent
    arr.each do |elem|
      if elem.as_h? && !elem.as_h.empty?
        first = true
        elem.as_h.each do |k, v|
          k_str = dump_string(k.to_s)
          if first
            if v.as_a? && !v.as_a.empty?
              res = res + "#{sp}- #{k_str}:\n" + dump_array(v.as_a, indent + 4)
            elsif v.as_h? && !v.as_h.empty?
              res = res + "#{sp}- #{k_str}:\n" + dump_hash(v.as_h, indent + 4)
            else
              res = res + "#{sp}- #{k_str}: #{dump_inline_value(v)}\n"
            end
            first = false
          else
            sub_sp = " " * (indent + 2)
            if v.as_a? && !v.as_a.empty?
              res = res + "#{sub_sp}#{k_str}:\n" + dump_array(v.as_a, indent + 4)
            elsif v.as_h? && !v.as_h.empty?
              res = res + "#{sub_sp}#{k_str}:\n" + dump_hash(v.as_h, indent + 4)
            else
              res = res + "#{sub_sp}#{k_str}: #{dump_inline_value(v)}\n"
            end
          end
        end
      elsif elem.as_a? && !elem.as_a.empty?
        res = res + "#{sp}-\n" + dump_array(elem.as_a, indent + 2)
      else
        res = res + "#{sp}- #{dump_inline_value(elem)}\n"
      end
    end
    res
  end

  private def self.dump_hash(h : Hash(Any, Any), indent : Int32) : String
    res = ""
    sp = " " * indent
    h.each do |k, v|
      k_str = dump_string(k.to_s)
      if v.as_a? && !v.as_a.empty?
        res = res + "#{sp}#{k_str}:\n" + dump_array(v.as_a, indent + 2)
      elsif v.as_h? && !v.as_h.empty?
        res = res + "#{sp}#{k_str}:\n" + dump_hash(v.as_h, indent + 2)
      else
        res = res + "#{sp}#{k_str}: #{dump_inline_value(v)}\n"
      end
    end
    res
  end

  private def self.dump_inline_value(v : Any) : String
    case r = v.raw
    when Nil
      "null"
    when Bool
      r ? "true" : "false"
    when Int64
      r.to_s
    when Float64
      if r != r
        ".nan"
      elsif r > 1e308 && r == r * 2.0
        ".inf"
      elsif r < -1e308 && r == r * 2.0
        "-.inf"
      else
        r.to_s
      end
    when String
      dump_string(r)
    when Array(Any)
      "[]"
    when Hash(Any, Any)
      "{}"
    else
      "null"
    end
  end
end

pub struct YAML
  def self.nodes_to_yaml(doc : Std::Yaml::Nodes::Document) : String
    root = doc.nodes.first?
    return "" unless root
    emit_node(root, 0)
  end

  private def self.emit_node(node : Std::Yaml::Nodes::Node, indent : Int32) : String
    case node
    when Std::Yaml::Nodes::Scalar
      scalar_text(node.value) + "\n"
    when Std::Yaml::Nodes::Sequence
      if node.nodes.empty?
        "[]\n"
      else
        res = ""
        sp = " " * indent
        node.nodes.each do |child|
          case child
          when Std::Yaml::Nodes::Scalar
            res = res + "#{sp}- #{scalar_text(child.value)}\n"
          when Std::Yaml::Nodes::Alias
            res = res + "#{sp}- *#{child.value}\n"
          else
            res = res + "#{sp}-\n" + emit_node(child, indent + 2)
          end
        end
        res
      end
    when Std::Yaml::Nodes::Mapping
      if node.nodes.empty?
        "{}\n"
      else
        res = ""
        sp = " " * indent
        i = 0
        while i < node.nodes.size
          k_node = node.nodes[i]
          v_node = node.nodes[i + 1]
          k_str = k_node.is_a?(Std::Yaml::Nodes::Scalar) ? scalar_text(k_node.value) : "\"?\""
          case v_node
          when Std::Yaml::Nodes::Scalar
            res = res + "#{sp}#{k_str}: #{scalar_text(v_node.value)}\n"
          when Std::Yaml::Nodes::Alias
            res = res + "#{sp}#{k_str}: *#{v_node.value}\n"
          else
            res = res + "#{sp}#{k_str}:\n" + emit_node(v_node, indent + 2)
          end
          i += 2
        end
        res
      end
    when Std::Yaml::Nodes::Alias
      "*" + node.value + "\n"
    else
      "null\n"
    end
  end

  private def self.scalar_text(s : String) : String
    r = resolve_plain_scalar(s)
    if r.nil?
      "null"
    elsif r.is_a?(Bool)
      r ? "true" : "false"
    elsif r.is_a?(Int64)
      r.to_s
    elsif r.is_a?(Float64)
      r.to_s
    else
      quote_scalar(s)
    end
  end

  private def self.quote_scalar(s : String) : String
    if s.empty? || needs_quote?(s)
      res = "\""
      idx = 0
      while idx < s.size
        c = s[idx]
        case c
        when '\n'
          res = res + "\\n"
        when '\r'
          res = res + "\\r"
        when '\t'
          res = res + "\\t"
        when '"'
          res = res + "\\\""
        when '\\'
          res = res + "\\\\"
        when '\0'
          res = res + "\\0"
        else
          res = res + s[idx, 1]
        end
        idx += 1
      end
      res + "\""
    else
      s
    end
  end

  private def self.needs_quote?(s : String) : Bool
    return true if s.empty?

    case s
    when "~", "null", "Null", "NULL", "true", "True", "TRUE", "false", "False", "FALSE"
      return true
    when ".inf", ".Inf", ".INF", "+.inf", "+.Inf", "+.INF", "-.inf", "-.Inf", "-.INF", ".nan", ".NaN", ".NAN"
      return true
    end

    if is_hex_int?(s) || is_oct_int?(s) || is_dec_int?(s) || is_valid_float?(s)
      return true
    end

    return true if s.starts_with?(" ") || s.ends_with?(" ")

    c0 = s[0]
    if c0 == '-' || c0 == '?' || c0 == ':' || c0 == ',' || c0 == '[' || c0 == ']' ||
       c0 == '{' || c0 == '}' || c0 == '#' || c0 == '&' || c0 == '*' || c0 == '!' ||
       c0 == '|' || c0 == '>' || c0 == '\'' || c0 == '"' || c0 == '%' || c0 == '@' || c0 == '`'
      return true
    end

    return true if s.includes?(": ") || s.ends_with?(":") || s.includes?(" #")
    return true if s.includes?("\n") || s.includes?("\r") || s.includes?("\t") || s.includes?("\"")

    false
  end

  def self.to_yaml(ary : Array(T)) : String forall T
    builder = Std::Yaml::Nodes::Builder.new
    builder.sequence do
      ary.each { |item| write_value(item, builder) }
    end
    nodes_to_yaml(builder.document)
  end

  def self.to_yaml(h : Hash(K, V)) : String forall K, V
    builder = Std::Yaml::Nodes::Builder.new
    builder.mapping do
      h.each do |k, v|
        builder.scalar(k.to_s)
        write_value(v, builder)
      end
    end
    nodes_to_yaml(builder.document)
  end

  def self.write_value(val : Nil, yaml : Std::Yaml::Nodes::Builder) : Nil
    yaml.scalar("null")
  end

  def self.write_value(val : Bool, yaml : Std::Yaml::Nodes::Builder) : Nil
    yaml.scalar(val ? "true" : "false")
  end

  def self.write_value(val : Int32 | Int64 | Int16 | Int8 | UInt32 | UInt64 | UInt16 | UInt8, yaml : Std::Yaml::Nodes::Builder) : Nil
    yaml.scalar(val.to_s)
  end

  def self.write_value(val : Float32 | Float64, yaml : Std::Yaml::Nodes::Builder) : Nil
    yaml.scalar(val.to_s)
  end

  def self.write_value(val : String, yaml : Std::Yaml::Nodes::Builder) : Nil
    yaml.scalar(val)
  end

  def self.write_value(val : Symbol, yaml : Std::Yaml::Nodes::Builder) : Nil
    yaml.scalar(val.to_s)
  end

  def self.write_value(val : Any, yaml : Std::Yaml::Nodes::Builder) : Nil
    case r = val.raw
    when Nil
      yaml.scalar("null")
    when Bool
      yaml.scalar(r ? "true" : "false")
    when Int64, Float64, String
      yaml.scalar(r.to_s)
    when Array(Any)
      yaml.sequence do
        r.each { |item| write_value(item, yaml) }
      end
    when Hash(Any, Any)
      yaml.mapping do
        r.each do |k, v|
          write_value(k, yaml)
          write_value(v, yaml)
        end
      end
    else
      yaml.scalar("null")
    end
  end

  def self.write_value(val : Array(T), yaml : Std::Yaml::Nodes::Builder) : Nil forall T
    yaml.sequence do
      val.each { |e| write_value(e, yaml) }
    end
  end

  def self.write_value(val : Hash(K, V), yaml : Std::Yaml::Nodes::Builder) : Nil forall K, V
    yaml.mapping do
      val.each do |k, v|
        yaml.scalar(k.to_s)
        write_value(v, yaml)
      end
    end
  end

  def self.write_value(val, yaml : Std::Yaml::Nodes::Builder) : Nil
    if val.nil?
      yaml.scalar("null")
    elsif val.is_a?(String)
      yaml.scalar(val)
    elsif val.is_a?(Int32) || val.is_a?(Int64)
      yaml.scalar(val.to_s)
    elsif val.is_a?(Float64)
      yaml.scalar(val.to_s)
    elsif val.is_a?(Bool)
      yaml.scalar(val ? "true" : "false")
    else
      val.to_yaml(yaml)
    end
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Nil.class) : Nil
    nil
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Bool.class) : Bool
    unless node.is_a?(Std::Yaml::Nodes::Scalar)
      node.raise "Expected scalar for Bool"
    end
    val = Std::Yaml::Schema::Core.parse_scalar(node)
    if val.is_a?(Bool)
      val
    else
      node.raise "Expected Bool, got #{node.value.inspect}"
    end
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Int32.class) : Int32
    unless node.is_a?(Std::Yaml::Nodes::Scalar)
      node.raise "Expected scalar for Int32"
    end
    val = Std::Yaml::Schema::Core.parse_scalar(node)
    if val.is_a?(Int64)
      val.to_i32
    else
      node.raise "Expected Int32, got #{node.value.inspect}"
    end
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Int64.class) : Int64
    unless node.is_a?(Std::Yaml::Nodes::Scalar)
      node.raise "Expected scalar for Int64"
    end
    val = Std::Yaml::Schema::Core.parse_scalar(node)
    if val.is_a?(Int64)
      val
    else
      node.raise "Expected Int64, got #{node.value.inspect}"
    end
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Float64.class) : Float64
    unless node.is_a?(Std::Yaml::Nodes::Scalar)
      node.raise "Expected scalar for Float64"
    end
    val = Std::Yaml::Schema::Core.parse_scalar(node)
    if val.is_a?(Float64)
      val
    elsif val.is_a?(Int64)
      val.to_f64
    else
      node.raise "Expected Float64, got #{node.value.inspect}"
    end
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : String.class) : String
    unless node.is_a?(Std::Yaml::Nodes::Scalar)
      node.raise "Expected scalar for String"
    end
    node.value
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Any.class) : Any
    Any.new(node.is_a?(Std::Yaml::Nodes::Scalar) ? Std::Yaml::Schema::Core.parse_scalar(node) : nil)
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Array(T).class) : Array(T) forall T
    unless node.is_a?(Std::Yaml::Nodes::Sequence)
      node.raise "Expected sequence for Array"
    end
    res = [] of T
    node.nodes.each do |child|
      res << read_value(ctx, child, T)
    end
    res
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : Hash(String, V).class) : Hash(String, V) forall V
    unless node.is_a?(Std::Yaml::Nodes::Mapping)
      node.raise "Expected mapping for Hash"
    end
    res = Hash(String, V).new
    Std::Yaml::Schema::Core.each(node) do |k_node, v_node|
      unless k_node.is_a?(Std::Yaml::Nodes::Scalar)
        k_node.raise "Expected scalar key for Hash"
      end
      k = k_node.value
      v = read_value(ctx, v_node, V)
      res[k] = v
    end
    res
  end

  def self.read_value(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node, type : T.class) : T forall T
    T.new(ctx, node)
  end
end

pub def parse(input : String, max_aliases : Int32 = 1000, max_depth : Int32 = 128) : Any
  YAML.parse(input, max_aliases: max_aliases, max_depth: max_depth)
end

pub def parse_all(input : String, max_aliases : Int32 = 1000, max_depth : Int32 = 128) : Array(Any)
  YAML.parse_all(input, max_aliases: max_aliases, max_depth: max_depth)
end

pub def dump(any : Any) : String
  YAML.dump(any)
end

pub enum ScalarStyle
  ANY
  PLAIN
  SINGLE_QUOTED
  DOUBLE_QUOTED
  LITERAL
  FOLDED
end

pub enum SequenceStyle
  ANY
  BLOCK
  FLOW
end

pub enum MappingStyle
  ANY
  BLOCK
  FLOW
end

pub enum EventKind
  NONE
  STREAM_START
  STREAM_END
  DOCUMENT_START
  DOCUMENT_END
  ALIAS
  SCALAR
  SEQUENCE_START
  SEQUENCE_END
  MAPPING_START
  MAPPING_END
end

pub annotation Field
end

module Nodes
  abstract class Node
    property tag : String?
    property anchor : String?
    property start_line : Int32
    property start_column : Int32

    def initialize
      @start_line = 0
      @start_column = 0
    end

    def location : Tuple(Int32, Int32)
      {start_line, start_column}
    end

    def raise(message : String) : NoReturn
      ::raise "YAML error: #{message} at line #{start_line}, column #{start_column}"
    end

    abstract def kind : String
  end

  class Document < Node
    @nodes : Array(Node)

    def initialize
      @nodes = [] of Node
      @start_line = 0
      @start_column = 0
    end

    def nodes : Array(Node)
      @nodes
    end

    def <<(node : Node) : Nil
      @nodes << node
    end

    def kind : String
      "document"
    end
  end

  class Scalar < Node
    property style : ScalarStyle
    property value : String

    def initialize(@value : String)
      @style = ScalarStyle::ANY
      @start_line = 0
      @start_column = 0
    end

    def kind : String
      "scalar"
    end
  end

  class Sequence < Node
    @nodes : Array(Node)
    property style : SequenceStyle

    def initialize
      @nodes = [] of Node
      @style = SequenceStyle::ANY
      @start_line = 0
      @start_column = 0
    end

    def nodes : Array(Node)
      @nodes
    end

    def <<(node : Node) : Nil
      @nodes << node
    end

    def kind : String
      "sequence"
    end
  end

  class Mapping < Node
    @nodes : Array(Node)
    property style : MappingStyle

    def initialize
      @nodes = [] of Node
      @style = MappingStyle::ANY
      @start_line = 0
      @start_column = 0
    end

    def nodes : Array(Node)
      @nodes
    end

    def <<(node : Node) : Nil
      @nodes << node
    end

    def kind : String
      "mapping"
    end
  end

  class Alias < Node
    property value : String

    def initialize(@value : String)
      @start_line = 0
      @start_column = 0
    end

    def kind : String
      "alias"
    end
  end

  class Builder
    getter document : Document
    @stack : Array(Node)

    def initialize
      @document = Document.new
      @stack = [] of Node
    end

    def mapping(reference = nil, style : MappingStyle = MappingStyle::ANY, &)
      map = Mapping.new
      map.style = style
      add_node(map)
      @stack << map
      yield
      @stack.pop
    end

    def sequence(reference = nil, style : SequenceStyle = SequenceStyle::ANY, &)
      seq = Sequence.new
      seq.style = style
      add_node(seq)
      @stack << seq
      yield
      @stack.pop
    end

    def scalar(value, style : ScalarStyle = ScalarStyle::ANY, anchor : String? = nil, tag : String? = nil)
      sc = Scalar.new(value.to_s)
      sc.style = style
      sc.anchor = anchor
      sc.tag = tag
      add_node(sc)
    end

    def add_node(node : Node) : Nil
      if @stack.empty?
        @document << node
      else
        top = @stack.last
        if top.is_a?(Mapping)
          top << node
        elsif top.is_a?(Sequence)
          top << node
        end
      end
    end
  end

  def self.parse(input : String) : Document
    any = YAML.parse(input)
    doc = Document.new
    doc << node_from_any(any)
    doc
  end

  def self.parse_all(input : String) : Array(Document)
    docs = YAML.parse_all(input)
    docs.map do |any|
      doc = Document.new
      doc << node_from_any(any)
      doc
    end
  end

  def self.node_from_any(any : Any) : Node
    case r = any.raw
    when Nil
      Scalar.new("null")
    when Bool
      Scalar.new(r ? "true" : "false")
    when Int64, Float64, String
      Scalar.new(r.to_s)
    when Array(Any)
      seq = Sequence.new
      r.each { |item| seq << node_from_any(item) }
      seq
    when Hash(Any, Any)
      map = Mapping.new
      r.each do |k, v|
        map << node_from_any(k)
        map << node_from_any(v)
      end
      map
    else
      Scalar.new("")
    end
  end

  def self.any_from_node(node : Node) : Any
    case node
    when Scalar
      Any.new(YAML.resolve_plain_scalar(node.value))
    when Sequence
      ary = [] of Any
      node.nodes.each { |c| ary << any_from_node(c) }
      Any.new(ary)
    when Mapping
      h = Hash(Any, Any).new
      i = 0
      while i < node.nodes.size
        k = any_from_node(node.nodes[i])
        v = any_from_node(node.nodes[i + 1])
        h[k] = v
        i += 2
      end
      Any.new(h)
    when Alias
      Any.new(node.value)
    else
      Any.new(nil)
    end
  end
end

module Schema
  module Core
    def self.each(node : Nodes::Mapping, &)
      i = 0
      while i < node.nodes.size
        k = node.nodes[i]
        v = node.nodes[i + 1]
        yield k, v
        i += 2
      end
    end

    def self.parse_null?(node : Nodes::Node) : Bool
      if node.is_a?(Nodes::Scalar)
        v = node.value
        v.empty? || v == "~" || v == "null" || v == "Null" || v == "NULL"
      else
        false
      end
    end

    def self.parse_scalar(node : Nodes::Scalar) : Any::Type
      YAML.resolve_plain_scalar(node.value)
    end

    def self.parse_int(node : Nodes::Scalar, type : Class) : Int64
      val = YAML.resolve_plain_scalar(node.value)
      if val.is_a?(Int64)
        val
      else
        node.raise "Expected integer, not #{node.value.inspect}"
      end
    end

    def self.reserved_string?(s : String) : Bool
      case s
      when "true", "True", "TRUE", "false", "False", "FALSE",
           "null", "Null", "NULL", "~",
           ".nan", ".NaN", ".NAN", ".inf", ".Inf", ".INF",
           "-.inf", "-.Inf", "-.INF", "+.inf", "+.Inf", "+.INF"
        true
      else
        false
      end
    end
  end

  module FailSafe
    def self.parse(input : String) : Nodes::Document
      Nodes.parse(input)
    end

    def self.parse_all(input : String) : Array(Nodes::Document)
      Nodes.parse_all(input)
    end
  end
end

pub class ParseContext
  @anchors : Hash(String, Nodes::Node)

  def initialize
    @anchors = Hash(String, Nodes::Node).new
  end

  def read_alias(node : Nodes::Node, &)
    if node.is_a?(Nodes::Alias)
      if target = @anchors[node.value]?
        yield target
      else
        node.raise "Unknown anchor: #{node.value}"
      end
    end
  end

  def record_anchor(node : Nodes::Node, value = nil)
    if anchor = node.anchor
      @anchors[anchor] = node
    end
  end
end

module Serializable
  pub annotation Options
  end

  module Strict
    protected def on_unknown_yaml_attribute(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node, key : String)
      node.raise "Unknown YAML attribute: #{key}"
    end
  end

  module Unmapped
    @[::YAML::Field(ignore: true)]
    @yaml_unmapped : Hash(String, Any)?

    def yaml_unmapped : Hash(String, Any)
      @yaml_unmapped ||= Hash(String, Any).new
    end

    protected def on_unknown_yaml_attribute(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node, key : String)
      yaml_unmapped[key] = Any.new(node.is_a?(::YAML::Nodes::Scalar) ? ::YAML::Schema::Core.parse_scalar(node) : nil)
    end

    protected def on_to_yaml(yaml : ::YAML::Nodes::Builder)
      if unmapped = @yaml_unmapped
        unmapped.each do |key, value|
          yaml.scalar(key)
          ::YAML.write_value(value, yaml)
        end
      end
    end
  end

  macro use_yaml_discriminator(field, mapping)
    def self.from_yaml(input : String) : self
      doc = ::YAML::Nodes.parse(input)
      node = doc.nodes.first? || ::YAML::Nodes::Scalar.new("")
      ctx = ::YAML::ParseContext.new
      new(ctx, node)
    end

    def self.new(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node) : self
      unless node.is_a?(::YAML::Nodes::Mapping)
        node.raise "Expected YAML mapping for discriminator"
      end
      discriminator_value = ""
      ::YAML::Schema::Core.each(node) do |k_node, v_node|
        if k_node.is_a?(::YAML::Nodes::Scalar) && k_node.value == {{field.id.stringify}}
          discriminator_value = v_node.is_a?(::YAML::Nodes::Scalar) ? v_node.value : ""
          break
        end
      end

      case discriminator_value
      {% for key, type in mapping %}
        when {{key.id.stringify}}
          {{type}}.new(ctx, node)
      {% end %}
      else
        node.raise "Unknown discriminator value #{discriminator_value.inspect} for {{field.id}}"
      end
    end
  end

  macro included
    def self.from_yaml(input : String) : self
      doc = ::YAML::Nodes.parse(input)
      node = doc.nodes.first? || ::YAML::Nodes::Scalar.new("")
      ctx = ::YAML::ParseContext.new
      new(ctx, node)
    end

    def self.new(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node) : self
      new_from_yaml_node(ctx, node)
    end

    private def self.new_from_yaml_node(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node) : self
      {% if @type.struct? %}
        instance = uninitialized self
      {% else %}
        instance = allocate
      {% end %}
      instance.initialize(__context_for_yaml_serializable: ctx, __node_for_yaml_serializable: node)
      instance
    end

    macro inherited
      def self.new(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node) : self
        new_from_yaml_node(ctx, node)
      end
    end

    def initialize(*, __context_for_yaml_serializable ctx : ::YAML::ParseContext, __node_for_yaml_serializable node : ::YAML::Nodes::Node)
      {% verbatim do %}
        {% begin %}
          {% properties = {} of Nil => Nil %}
          {% for ivar in @type.instance_vars %}
            {% ann = ivar.annotation(::YAML::Field) || ivar.annotation(YAML::Field) || ivar.annotation(Field) %}
            {% unless ann && (ann[:ignore] || ann[:ignore_deserialize]) %}
              {% non_nil_type = ivar.type %}
              {% if ivar.type.nilable? %}
                {% for t in ivar.type.union_types %}
                  {% unless t == Nil %}
                    {% non_nil_type = t %}
                  {% end %}
                {% end %}
              {% end %}
              {%
                properties[ivar.id] = {
                  key:          ((ann && ann[:key]) || ivar).id.stringify,
                  has_default:  (ann && ann[:default] != nil) || ivar.has_default_value?,
                  default:      (ann && ann[:default]) || ivar.default_value,
                  nilable:      ivar.type.nilable?,
                  non_nil_type: non_nil_type,
                  converter:    ann && ann[:converter],
                  presence:     ann && ann[:presence],
                }
              %}
            {% end %}
          {% end %}

          {% for name, value in properties %}
            %var{name} = uninitialized typeof(@{{name}})
            %found{name} = false
          {% end %}

          case node
          when ::YAML::Nodes::Mapping
            ::YAML::Schema::Core.each(node) do |k_node, v_node|
              unless k_node.is_a?(::YAML::Nodes::Scalar)
                k_node.raise "Expected scalar as key for mapping"
              end
              key = k_node.value
              case key
              {% for name, value in properties %}
                when {{value[:key]}}
                  if ::YAML::Schema::Core.parse_null?(v_node)
                    {% if value[:nilable] %}
                      %var{name} = nil
                      %found{name} = true
                    {% end %}
                    next
                  end
                  %var{name} =
                    {% if value[:converter] %}
                      {{value[:converter]}}.from_yaml(ctx, v_node)
                    {% else %}
                      ::YAML.read_value(ctx, v_node, {{value[:non_nil_type]}})
                    {% end %}
                  %found{name} = true
              {% end %}
              else
                on_unknown_yaml_attribute(ctx, v_node, key)
              end
            end
          else
            node.raise "Expected YAML mapping, not #{node.kind}"
          end

          {% for ivar in @type.instance_vars %}
            {% ann = ivar.annotation(::YAML::Field) || ivar.annotation(YAML::Field) || ivar.annotation(Field) %}
            {% if ann && (ann[:ignore] || ann[:ignore_deserialize]) %}
              {% if ann && ann[:default] != nil %}
                @{{ivar.name.id}} = {{ann[:default]}}
              {% elsif ivar.has_default_value? %}
                @{{ivar.name.id}} = {{ivar.default_value}}
              {% elsif ivar.type.nilable? %}
                @{{ivar.name.id}} = nil
              {% end %}
            {% end %}
          {% end %}

          {% for name, value in properties %}
            if %found{name}
              @{{name}} = %var{name}
            else
              {% if value[:has_default] %}
                @{{name}} = {{value[:default]}}
              {% elsif value[:nilable] %}
                @{{name}} = nil
              {% else %}
                node.raise "Missing YAML attribute: " + {{value[:key]}}
              {% end %}
            end

            {% if value[:presence] %}
              @{{name}}_present = %found{name}
            {% end %}
          {% end %}
        {% end %}
      {% end %}
      after_initialize
    end

    def to_yaml(yaml : ::YAML::Nodes::Builder) : Nil
      {% verbatim do %}
        {% begin %}
          {% options = @type.annotation(::YAML::Serializable::Options) || @type.annotation(YAML::Serializable::Options) || @type.annotation(Options) %}
          {% emit_nulls = options && options[:emit_nulls] %}

          {% properties = {} of Nil => Nil %}
          {% for ivar in @type.instance_vars %}
            {% ann = ivar.annotation(::YAML::Field) || ivar.annotation(YAML::Field) || ivar.annotation(Field) %}
            {% unless ann && (ann[:ignore] || ann[:ignore_serialize] == true) %}
              {%
                properties[ivar.id] = {
                  key:              ((ann && ann[:key]) || ivar).id.stringify,
                  converter:        ann && ann[:converter],
                  emit_null:        (ann && (ann[:emit_null] != nil) ? ann[:emit_null] : emit_nulls),
                  ignore_serialize: ann && ann[:ignore_serialize],
                }
              %}
            {% end %}
          {% end %}

          yaml.mapping do
            {% for name, value in properties %}
              _{{name}} = @{{name}}

              {% if value[:ignore_serialize] %}
                unless {{ value[:ignore_serialize] }}
              {% end %}

                {% unless value[:emit_null] %}
                  unless _{{name}}.nil?
                {% end %}

                  yaml.scalar({{value[:key]}})
                  {% if value[:converter] %}
                    if val = _{{name}}
                      {{value[:converter]}}.to_yaml(val, yaml)
                    else
                      yaml.scalar("null")
                    end
                  {% else %}
                    if _{{name}}.nil?
                      yaml.scalar("null")
                    else
                      ::YAML.write_value(_{{name}}, yaml)
                    end
                  {% end %}

                {% unless value[:emit_null] %}
                  end
                {% end %}

              {% if value[:ignore_serialize] %}
                end
              {% end %}
            {% end %}
            on_to_yaml(yaml)
          end
        {% end %}
      {% end %}
    end

    def to_yaml : String
      builder = ::YAML::Nodes::Builder.new
      to_yaml(builder)
      ::YAML.nodes_to_yaml(builder.document)
    end

    def to_yaml(io : IO) : Nil
      io << to_yaml
    end

    protected def after_initialize
    end

    protected def on_unknown_yaml_attribute(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node, key : String)
    end

    protected def on_to_yaml(yaml : ::YAML::Nodes::Builder)
    end
  end
end

module ArrayConverter(T)
  def self.from_yaml(ctx : ::YAML::ParseContext, node : ::YAML::Nodes::Node) : Array(T)
    unless node.is_a?(::YAML::Nodes::Sequence)
      node.raise "Expected YAML sequence"
    end
    ary = [] of T
    node.nodes.each do |child|
      ary << T.new(ctx, child)
    end
    ary
  end

  def self.to_yaml(values : Array(T), yaml : ::YAML::Nodes::Builder) : Nil
    yaml.sequence do
      values.each { |v| v.to_yaml(yaml) }
    end
  end
end

def Object.from_yaml(string_or_io : String)
  doc = ::YAML::Nodes.parse(string_or_io)
  node = doc.nodes.first? || ::YAML::Nodes::Scalar.new("")
  ctx = ::YAML::ParseContext.new
  new(ctx, node)
end

def Array.new(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node)
  unless node.is_a?(Std::Yaml::Nodes::Sequence)
    node.raise "Expected YAML sequence for Array"
  end
  ary = new
  node.nodes.each do |child|
    ary << T.new(ctx, child)
  end
  ary
end

def Array.from_yaml(input : String)
  doc = Std::Yaml::Nodes.parse(input)
  node = doc.nodes.first? || Std::Yaml::Nodes::Scalar.new("")
  ctx = Std::Yaml::ParseContext.new
  new(ctx, node)
end

def Hash.new(ctx : Std::Yaml::ParseContext, node : Std::Yaml::Nodes::Node)
  unless node.is_a?(Std::Yaml::Nodes::Mapping)
    node.raise "Expected YAML mapping for Hash"
  end
  h = new
  Std::Yaml::Schema::Core.each(node) do |k_node, v_node|
    unless k_node.is_a?(Std::Yaml::Nodes::Scalar)
      k_node.raise "Expected scalar key for Hash"
    end
    k = k_node.value
    v = V.new(ctx, v_node)
    h[k] = v
  end
  h
end

def Hash.from_yaml(input : String)
  doc = Std::Yaml::Nodes.parse(input)
  node = doc.nodes.first? || Std::Yaml::Nodes::Scalar.new("")
  ctx = Std::Yaml::ParseContext.new
  new(ctx, node)
end

alias ::YAML = Std::Yaml::YAML
alias ::YAML::Any = Std::Yaml::Any
alias ::YAML::Nodes = Std::Yaml::Nodes
alias ::YAML::Schema = Std::Yaml::Schema
alias ::YAML::ParseContext = Std::Yaml::ParseContext
alias ::YAML::ScalarStyle = Std::Yaml::ScalarStyle
alias ::YAML::SequenceStyle = Std::Yaml::SequenceStyle
alias ::YAML::MappingStyle = Std::Yaml::MappingStyle
alias ::YAML::EventKind = Std::Yaml::EventKind
alias ::YAML::Field = Std::Yaml::Field
alias ::YAML::Serializable = Std::Yaml::Serializable
alias ::YAML::ArrayConverter = Std::Yaml::ArrayConverter
