  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@value)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << ":" << @value
  end
end

pub class ArrayLiteral < ASTNode
  property elements : Array(ASTNode)
  property of : ASTNode?
  property name : ASTNode?

  def initialize(@elements : Array(ASTNode) = [] of ASTNode, @of : ASTNode? = nil, @name : ASTNode? = nil)
  end

  def clone_without_location : self
    ArrayLiteral.new(clone_nodes(@elements), clone_node(@of), clone_node(@name))
  end

  def accept_children(visitor) : Nil
    @elements.each { |e| e.accept(visitor) }
    if o = @of
      o.accept(visitor)
    end
    if n = @name
      n.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    @elements == other.elements && @of == other.of && @name == other.name
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @elements.hash
    h = 31 &* h &+ hash_val(@of)
    h = 31 &* h &+ hash_val(@name)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    if n = @name
      n.to_s(sb)
    end
    sb << "["
    i = 0
    while i < @elements.size
      sb << ", " if i > 0
      @elements[i].to_s(sb)
      i = i + 1
    end
    sb << "]"
    if o = @of
      sb << " of "
      o.to_s(sb)
    end
  end
end

pub class HashLiteral < ASTNode
  pub struct Entry
    property key : ASTNode
    property value : ASTNode

    def initialize(@key : ASTNode, @value : ASTNode)
    end

    def clone : Entry
      Entry.new(@key.clone, @value.clone)
    end

    def ==(other : Entry) : Bool
      @key == other.key && @value == other.value
    end

    def hash : Int32
      31 &* (31 &* 17 &+ @key.hash) &+ @value.hash
    end
  end

  property entries : Array(Entry)
  property of : Entry?
  property name : ASTNode?

  def initialize(@entries : Array(Entry) = [] of Entry, @of : Entry? = nil, @name : ASTNode? = nil)
  end

  def clone_without_location : self
    cloned_entries = @entries.map { |e| e.clone }
    cloned_of = if o = @of
                  o.clone
                else
                  nil
                end
    HashLiteral.new(cloned_entries, cloned_of, clone_node(@name))
  end

  def accept_children(visitor) : Nil
    @entries.each do |e|
      e.key.accept(visitor)
      e.value.accept(visitor)
    end
    if o = @of
      o.key.accept(visitor)
      o.value.accept(visitor)
    end
    if n = @name
      n.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    @entries == other.entries && @of == other.of && @name == other.name
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ @entries.hash
    h = 31 &* h &+ hash_val(@of)
    h = 31 &* h &+ hash_val(@name)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    if n = @name
      n.to_s(sb)
    end
    sb << "{"
    i = 0
    while i < @entries.size
      sb << ", " if i > 0
      @entries[i].key.to_s(sb)
      sb << " => "
      @entries[i].value.to_s(sb)
      i = i + 1
    end
    sb << "}"
    if o = @of
      sb << " of "
      o.key.to_s(sb)
      sb << " => "
      o.value.to_s(sb)
    end
  end
end

pub class NamedTupleLiteral < ASTNode
  pub struct Entry
    property key : String
    property value : ASTNode

    def initialize(@key : String, @value : ASTNode)
    end

    def clone : Entry
      Entry.new(@key, @value.clone)
    end

    def ==(other : Entry) : Bool
      @key == other.key && @value == other.value
    end

    def hash : Int32
      31 &* (31 &* 17 &+ @key.hash) &+ @value.hash
    end
  end

  property entries : Array(Entry)

  def initialize(@entries : Array(Entry) = [] of Entry)
  end

  def clone_without_location : self
    NamedTupleLiteral.new(@entries.map { |e| e.clone })
  end

  def accept_children(visitor) : Nil
    @entries.each { |e| e.value.accept(visitor) }
  end

  def ==(other : self) : Bool
    (@entries == other.entries)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@entries)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "{"
    i = 0
    while i < @entries.size
      sb << ", " if i > 0
      sb << @entries[i].key << ": "
      @entries[i].value.to_s(sb)
      i = i + 1
    end
    sb << "}"
  end
end

pub class RangeLiteral < ASTNode
  property from : ASTNode
  property to : ASTNode
  property exclusive : Bool

  def initialize(@from : ASTNode, @to : ASTNode, @exclusive : Bool = false)
  end

  def clone_without_location : self
    RangeLiteral.new(@from.clone, @to.clone, @exclusive)
  end

  def accept_children(visitor) : Nil
    @from.accept(visitor)
    @to.accept(visitor)
  end

  def ==(other : self) : Bool
    (@from == other.from) && (@to == other.to) && (@exclusive == other.exclusive)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@from)
    h = 31 &* h &+ hash_val(@to)
    h = 31 &* h &+ hash_val(@exclusive)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    @from.to_s(sb)
    sb << (@exclusive ? "..." : "..")
    @to.to_s(sb)
  end
end

pub class RegexLiteral < ASTNode
  property value : ASTNode
  property options : RegexOptions

  def initialize(@value : ASTNode, @options : RegexOptions = RegexOptions::None)
  end

  def clone_without_location : self
    RegexLiteral.new(@value.clone, @options)
  end

  def accept_children(visitor) : Nil
    @value.accept(visitor)
  end

  def ==(other : self) : Bool
    (@value == other.value) && (@options == other.options)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@value)
    h = 31 &* h &+ hash_val(@options)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "/"
    @value.to_s(sb)
    sb << "/"
    sb << "i" if @options.includes?(RegexOptions::IGNORE_CASE)
    sb << "m" if @options.includes?(RegexOptions::MULTILINE)
  end
end

pub class TupleLiteral < ASTNode
  property elements : Array(ASTNode)

  def initialize(@elements : Array(ASTNode) = [] of ASTNode)
