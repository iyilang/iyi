ROOT      = cert(CERT_ROOT)
OTHER_CA  = cert(CERT_OTHER_CA)
GOOD      = cert(CERT_GOOD)
REVOKED   = cert(CERT_REVOKED)
OTHER     = cert(CERT_OTHER)
MUST      = cert(CERT_MUST)
RESPONDER = cert(CERT_RESPONDER)
RSA_ROOT  = cert(CERT_RSA_ROOT)
RSA_LEAF  = cert(CERT_RSA_LEAF)
ED_ROOT   = cert(CERT_ED_ROOT)
ED_LEAF   = cert(CERT_ED_LEAF)

# GOOD_DELEGATED with the last byte of its responder's certificate - in
# that certificate's signature - flipped: the response's own signature
# still holds, the responder's does not.
def forged_responder : Array(UInt8)
  whole = b(RESP_GOOD_DELEGATED)
  inner = b(CERT_RESPONDER)
  at = 0
  while at + inner.size <= whole.size
    break if whole[at, inner.size] == inner
    at = at + 1
  end
  forged = whole.dup
  forged[at + inner.size - 1] = forged[at + inner.size - 1] ^ 0x01_u8
  forged
end

# Each response, the leaf and issuer it is asked of, and the verdict: a
# status and who signed, or a phrase the refusal holds.
CASES = [
  {"a good response from the issuer, by name", b(RESP_GOOD_DIRECT), GOOD, ROOT, "good, from the issuer"},
  {"a good response from the issuer, by key hash", b(RESP_GOOD_BYKEY), GOOD, ROOT, "good, from the issuer"},
  {"a revoked response with its reason", b(RESP_REVOKED_DIRECT), REVOKED, ROOT, "revoked at 2026-10-01 00:00:00 UTC, keyCompromise, from the issuer"},
  {"a revoked response without a reason", b(RESP_REVOKED_NOREASON), REVOKED, ROOT, "revoked at 2026-10-02 00:00:00 UTC, no reason, from the issuer"},
  {"an unknown response", b(RESP_UNKNOWN_DIRECT), GOOD, ROOT, "unknown, from the issuer"},
  {"a delegated responder with id-pkix-ocsp-nocheck", b(RESP_GOOD_DELEGATED), GOOD, ROOT, "good, from a delegated responder"},
  {"a delegated responder named by its key hash", b(RESP_GOOD_DELEGATED_BYKEY), GOOD, ROOT, "good, from a delegated responder"},
  {"a delegated responder without id-pkix-ocsp-nocheck", b(RESP_GOOD_DELEGATED_NOCHECKLESS), GOOD, ROOT, "good, from a delegated responder"},
  {"a delegated responder without id-kp-OCSPSigning", b(RESP_DELEGATED_NOEKU), GOOD, ROOT, "refused: ocsp: the responder CN=OCSP Responder No EKU is not allowed id-kp-OCSPSigning"},
  {"a delegated responder allowed only anyExtendedKeyUsage", b(RESP_DELEGATED_ANY), GOOD, ROOT, "refused: ocsp: the responder CN=OCSP Responder Any EKU is not allowed id-kp-OCSPSigning"},
  {"a delegated responder out of its time", b(RESP_DELEGATED_EXPIRED), GOOD, ROOT, "refused: ocsp: the responder CN=OCSP Responder Expired is not valid at"},
  {"a delegated responder issued by another CA", b(RESP_DELEGATED_FOREIGN), GOOD, ROOT, "refused: ocsp: the responder CN=OCSP Responder Foreign was not issued by CN=OCSP Exercise Root"},
  {"a delegated responder not allowed digitalSignature", b(RESP_DELEGATED_NOSIGN), GOOD, ROOT, "refused: ocsp: the responder CN=OCSP Responder No Sign is not allowed digitalSignature"},
  {"a delegated responder the response does not carry", b(RESP_DELEGATED_MISSING), GOOD, ROOT, "refused: ocsp: no certificate here is the responder, the name OCSP Exercise Responder"},
  {"a delegated responder whose certificate the issuer did not sign", forged_responder, GOOD, ROOT, "refused: ocsp: the responder CN=OCSP Exercise Responder: CN=OCSP Exercise Responder's signature is not CN=OCSP Exercise Root's"},
  {"a response signed by another key under the issuer's name", b(RESP_WRONG_KEY), GOOD, ROOT, "refused: ocsp: the OCSP response's signature is not CN=OCSP Exercise Root's"},
  {"a response for another certificate", b(RESP_OTHER_SERIAL), GOOD, ROOT, "refused: ocsp: no response here is for CN=good.ocsp.test, serial 1001"},
  {"a response for that other certificate, asked of it", b(RESP_OTHER_SERIAL), OTHER, ROOT, "good, from the issuer"},
  {"a response for another issuer's key under the same name", b(RESP_IMPOSTOR_ISSUER), GOOD, ROOT, "refused: ocsp: no response here is for CN=good.ocsp.test"},
  {"a response for another issuer's name", b(RESP_NAME_HASH_WRONG), GOOD, ROOT, "refused: ocsp: no response here is for CN=good.ocsp.test"},
  {"a response past its nextUpdate", b(RESP_EXPIRED), GOOD, ROOT, "refused: ocsp: a response past its nextUpdate, 2026-10-08 00:00:00 UTC"},
  {"a response whose thisUpdate is a day ahead", b(RESP_FUTURE), GOOD, ROOT, "refused: ocsp: a response whose thisUpdate, 2026-11-02 00:00:00 UTC, is past"},
  {"a response whose thisUpdate is two minutes ahead, inside the skew", b(RESP_NEAR_FUTURE), GOOD, ROOT, "good, from the issuer"},
  {"a response two minutes past its nextUpdate, inside the skew", b(RESP_JUST_PAST), GOOD, ROOT, "good, from the issuer"},
  {"a response without nextUpdate from twelve hours ago", b(RESP_NONEXT_FRESH), GOOD, ROOT, "good, from the issuer"},
  {"a response without nextUpdate from three days ago", b(RESP_NONEXT_OLD), GOOD, ROOT, "refused: ocsp: a response with no nextUpdate whose thisUpdate"},
  {"a CertID under SHA-256", b(RESP_SHA256_CERTID), GOOD, ROOT, "good, from the issuer"},
  {"a CertID under SHA-512", b(RESP_SHA512_CERTID), GOOD, ROOT, "good, from the issuer"},
  {"a response with a nonce", b(RESP_NONCE), GOOD, ROOT, "good, from the issuer"},
  {"a response signed under ECDSA with SHA-384", b(RESP_SHA384_SIGNED), GOOD, ROOT, "good, from the issuer"},
  {"a response signed under SHA-1", b(RESP_SHA1_SIGNED), GOOD, ROOT, "refused: ocsp: the OCSP response is signed under SHA-1, which is refused"},
  {"a response with a critical extension it does not understand", b(RESP_CRITICAL_EXT), GOOD, ROOT, "refused: ocsp: a critical extension 1.3.6.1.4.1.99999.1 in responseExtensions"},
  {"an RSA issuer's response", b(RESP_RSA_GOOD), RSA_LEAF, RSA_ROOT, "good, from the issuer"},
  {"an Ed25519 issuer's response", b(RESP_ED_GOOD), ED_LEAF, ED_ROOT, "good, from the issuer"},
  {"a must-staple leaf's response", b(RESP_MUST_GOOD), MUST, ROOT, "good, from the issuer"},
  {"a responder that answered tryLater", b(RESP_TRY_LATER), GOOD, ROOT, "refused: ocsp: the responder answered tryLater (3), with no response"},
  {"a responder that answered unauthorized", b(RESP_UNAUTHORIZED), GOOD, ROOT, "refused: ocsp: the responder answered unauthorized (6), with no response"},
  {"a response written by hand", b(RESP_HAND_GOOD), GOOD, ROOT, "good, from the issuer"},
  {"a ResponseData whose version is written out", b(RESP_VERSION_WRITTEN), GOOD, ROOT, "refused: ocsp: a ResponseData whose version v1 is written out"},
  {"a ResponseData of version 2", b(RESP_VERSION_2), GOOD, ROOT, "refused: ocsp: a ResponseData of version 2"},
  {"a thisUpdate in UTCTime", b(RESP_UTC_THIS_UPDATE), GOOD, ROOT, "refused: ocsp: a thisUpdate that is UTCTime, where RFC 6960 writes a GeneralizedTime"},
  {"a CertStatus of no kind", b(RESP_BAD_STATUS_TAG), GOOD, ROOT, "refused: ocsp: a CertStatus that is [3], none of good [0], revoked [1] and unknown [2]"},
  {"a revocation reason of 7", b(RESP_REASON_7), REVOKED, ROOT, "refused: ocsp: a revocation reason of 7, which CRLReason does not have"},
  {"a revoked response written by hand, superseded", b(RESP_REVOKED_HAND), REVOKED, ROOT, "revoked at 2026-10-01 00:00:00 UTC, superseded, from the issuer"},
  {"another response type", b(RESP_OTHER_TYPE), GOOD, ROOT, "refused: ocsp: a response of type 1.3.6.1.5.5.7.48.1.99, where id-pkix-ocsp-basic"},
  {"a responseStatus of 4", b(RESP_STATUS_4), GOOD, ROOT, "refused: ocsp: a responseStatus of 4, which RFC 6960 leaves unused"},
  {"tryLater with responseBytes", b(RESP_TRYLATER_WITH_BYTES), GOOD, ROOT, "refused: ocsp: a responseStatus of tryLater with responseBytes"},
  {"a CertID with a hash cut short", b(RESP_CERTID_SHORT_HASH), GOOD, ROOT, "refused: ocsp: a CertID whose hashes are 19 and 20 bytes"},
  {"a CertID under MD5", b(RESP_CERTID_MD5), GOOD, ROOT, "refused: ocsp: a CertID hashed by 1.2.840.113549.2.5"},
  {"an extension twice", b(RESP_DUP_EXT), GOOD, ROOT, "refused: ocsp: extension 1.3.6.1.5.5.7.48.1.2 twice in responseExtensions"},
  {"a ResponderID of no kind", b(RESP_RESPONDER_TAG3), GOOD, ROOT, "refused: ocsp: a ResponderID that is [3] constructed, neither byName [1] nor byKey [2]"},
  {"a responder key hash of 19 bytes", b(RESP_KEYHASH_SHORT), GOOD, ROOT, "refused: ocsp: a responder key hash of 19 bytes"},
  {"a ResponseData with no SingleResponse", b(RESP_NO_SINGLE), GOOD, ROOT, "refused: ocsp: a ResponseData with no SingleResponse"},
  {"a critical extension in a SingleResponse", b(RESP_SINGLE_CRITICAL_EXT), GOOD, ROOT, "refused: ocsp: a critical extension 1.3.6.1.4.1.99999.2 in singleExtensions"},
  {"a non-critical extension in a SingleResponse", b(RESP_SINGLE_PLAIN_EXT), GOOD, ROOT, "good, from the issuer"},
  {"a nonce that is not an OCTET STRING", b(RESP_NONCE_NOT_OCTET), GOOD, ROOT, "refused: ocsp: asn1: expected an OCTET STRING, found INTEGER"},
  {"a nextUpdate before its thisUpdate", b(RESP_NEXT_BEFORE_THIS), GOOD, ROOT, "refused: ocsp: a response whose nextUpdate, 2026-10-30 00:00:00 UTC, is before its thisUpdate"},
  {"a byte after the response", b(RESP_TRAILING), GOOD, ROOT, "refused: ocsp: asn1: 1 bytes after the value"},
  {"the leaf asked of another CA as its issuer", b(RESP_GOOD_DIRECT), GOOD, OTHER_CA, "refused: ocsp: CN=good.ocsp.test was issued by CN=OCSP Exercise Root, not CN=Other Root"},
]

args = Program.args

# judge FILE: each line `name|response|leaf|issuer|now`.
if args.size > 1 && args[0] == "judge"
  File.read(args[1]).lines.each do |line|
    next if line.strip.empty?
    f = line.strip.split('|')
    now = f[4] == "-" ? Time.utc : Time.unix(f[4].to_i.to_i64)
    puts "#{f[0]}|#{category(bytes_of(f[1]), pem_cert(f[2]), pem_cert(f[3]), now)}"
  end
  exit 0
end

# A serial number's magnitude in hex, without leading zeros: as Python's
# `format(serial, "x")` writes it.
def serial_hex(bytes : Array(UInt8)) : String
  text = hex_of(bytes)
  at = 0
  while at < text.size - 1 && text[at] == '0'
    at = at + 1
  end
  text[at, text.size - at]
end

# What a response says, one line of fields.
def dump_line(der : Array(UInt8)) : String
  response = OcspResponse.parse(der)
  if response.is_a?(OcspError)
    status = response.response_status
    return status ? "status=#{status}" : "refused"
  end
  name = response.responder_name
  key = response.responder_key_hash
  parts = ["status=0", "responder=#{name ? "name:" + hex_of(name) : "key:" + hex_of(key || [] of UInt8)}",
           "produced=#{response.produced_at.to_unix}", "sigalg=#{response.signature_algorithm}", "certs=#{response.certificates.size}"]
  nonce = response.nonce
  parts << "nonce=#{nonce ? hex_of(nonce) : "-"}"
  response.responses.each do |single|
    id = single.cert_id
    revoked = single.revocation_time
    reason = single.revocation_reason
    next_update = single.next_update
    parts << "single=#{id.hash.oid},#{hex_of(id.issuer_name_hash)},#{hex_of(id.issuer_key_hash)},#{serial_hex(id.serial)},#{single.status.word}," \
             "#{revoked ? revoked.to_unix : "-"},#{reason || "-"},#{single.this_update.to_unix},#{next_update ? next_update.to_unix : "-"}"
  end
  parts.join(";")
end

# dump FILE: each line `name|response`.
if args.size > 1 && args[0] == "dump"
  File.read(args[1]).lines.each do |line|
    next if line.strip.empty?
    f = line.strip.split('|')
    puts "#{f[0]}|#{dump_line(bytes_of(f[1]))}"
  end
  exit 0
end

# request LEAF ISSUER HASH NONCE OUT
if args.size > 5 && args[0] == "request"
  hash = args[3] == "sha256" ? OcspHash::SHA256 : OcspHash::SHA1
  nonce = args[4] == "-" ? nil : b(args[4])
  File.write(args[5], text_of(Ocsp.request(pem_cert(args[1]), pem_cert(args[2]), hash, nonce)))
  exit 0
end

# vectors DIR
if args.size > 1 && args[0] == "vectors"
  dir = args[1]
  certificates = [{"root", ROOT}, {"other-ca", OTHER_CA}, {"good", GOOD}, {"revoked", REVOKED}, {"other", OTHER}, {"must", MUST},
                  {"rsa-root", RSA_ROOT}, {"rsa-leaf", RSA_LEAF}, {"ed-root", ED_ROOT}, {"ed-leaf", ED_LEAF}]
  certificates.each { |pair| File.write("#{dir}/#{pair[0]}.der", text_of(pair[1].raw)) }
  lines = [] of String
  CASES.each_with_index do |c, i|
    File.write("#{dir}/#{i}.resp", text_of(c[1]))
    leaf = certificates.find { |pair| pair[1].raw == c[2].raw }
    issuer = certificates.find { |pair| pair[1].raw == c[3].raw }
    # A leaf asked of a CA that did not issue it is the caller's mistake,
    # which OpenSSL has no way to be told.
    next unless leaf && issuer && c[2].issuer == c[3].subject
    read = OcspResponse.parse(c[1])
    hash = read.is_a?(OcspResponse) ? read.responses[0].cert_id.hash : OcspHash::SHA1
    lines << "#{c[0]}|#{i}.resp|#{leaf[0]}|#{issuer[0]}|#{category(c[1], c[2], c[3], NOW)}|#{hash.to_s.downcase}"
  end
  File.write("#{dir}/list", lines.join("\n") + "\n")
  exit 0
end

puts "== responses judged at 2026-11-01"
CASES.each do |c|
  got = outcome(c[1], c[2], c[3])
  check got.starts_with?(c[4]), "#{c[0]}: expected #{c[4].inspect}, got #{got.inspect}"
end
puts "  #{CASES.size} responses, each judged as written here"

puts "== what a response says, read"
read = OcspResponse.parse(b(RESP_REVOKED_DIRECT)).or_panic
check read.responder_name == ROOT.subject && read.responder_key_hash.nil?, "a responder by name: its Name's DER"
check read.responses.size == 1 && read.responses[0].cert_id.serial == REVOKED.serial, "one SingleResponse, for revoked.ocsp.test"
check read.responses[0].revocation_reason == 1 && Ocsp.reason_name(1) == "keyCompromise", "the reason, keyCompromise (1)"
check read.responses[0].this_update == Time.utc(2026, 10, 31) && read.responses[0].next_update == Time.utc(2026, 11, 7), "thisUpdate and nextUpdate"
check read.signature_algorithm == "1.2.840.10045.4.3.2" && read.certificates.empty?, "ecdsa-with-SHA256, and no certificates carried"
by_key = OcspResponse.parse(b(RESP_GOOD_BYKEY)).or_panic
check by_key.responder_name.nil? && by_key.responder_key_hash == OcspHash::SHA1.digest(ROOT.public_key_bits), "a responder by key: the SHA-1 of its key"
nonced = OcspResponse.parse(b(RESP_NONCE)).or_panic
check nonced.nonce == Array(UInt8).new(16) { |i| (i + 1).to_u8 }, "the nonce, 01 to 10"
delegated = OcspResponse.parse(b(RESP_GOOD_DELEGATED)).or_panic
check delegated.certificates.size == 1 && delegated.certificates[0].raw == RESPONDER.raw, "the responder's certificate, carried"
verdict = delegated.verify(GOOD, ROOT, NOW).or_panic
check verdict.delegated && verdict.signer.subject_name == "CN=OCSP Exercise Responder" && verdict.signer.ocsp_nocheck, "signed by the responder, which carries id-pkix-ocsp-nocheck"
late = OcspResponse.parse(b(RESP_TRY_LATER))
check late.is_a?(OcspError) && late.response_status == 3, "tryLater's status, 3, on the error"
sha256 = OcspResponse.parse(b(RESP_SHA256_CERTID)).or_panic
check sha256.responses[0].cert_id.hash == OcspHash::SHA256 && sha256.responses[0].cert_id.issuer_name_hash.size == 32, "a CertID under SHA-256"
puts "  responder by name and by key, the status, reason and times, the nonce, the certificates, an unsuccessful status"

puts "== requests, as OpenSSL and Python's cryptography write them"
check Ocsp.request(GOOD, ROOT) == b(REQ_SHA1), "the request for good.ocsp.test, as `openssl ocsp -no_nonce` writes it"
check Ocsp.request(GOOD, ROOT, OcspHash::SHA256) == b(REQ_SHA256), "the request under SHA-256, as `openssl ocsp -sha256 -no_nonce` writes it"
check Ocsp.request(GOOD, ROOT, nonce: Array(UInt8).new(16) { |i| (i + 1).to_u8 }) == b(REQ_NONCE), "the request with a nonce, as Python's OCSPRequestBuilder writes it"
check OcspCertId.of(GOOD, ROOT).matches?(GOOD, ROOT) && !OcspCertId.of(GOOD, ROOT).matches?(OTHER, ROOT), "a CertID matches its own certificate and not another"
puts "  SHA-1 and SHA-256 CertIDs, a nonce"

puts "== the TLS Feature extension and id-pkix-ocsp-nocheck"
check MUST.must_staple? && MUST.tls_features == [5], "must.ocsp.test's TLS Feature: status_request (5)"
check !GOOD.must_staple? && GOOD.tls_features.nil?, "good.ocsp.test carries no TLS Feature"
check RESPONDER.ocsp_nocheck && !GOOD.ocsp_nocheck, "the responder's id-pkix-ocsp-nocheck, read"
puts "  must staple read, and nocheck"

puts "== every truncation and flipped byte refused"
[{"the issuer's response", b(RESP_GOOD_DIRECT)}, {"the delegated responder's", b(RESP_GOOD_DELEGATED)}].each do |entry|
  whole = entry[1]
  whole.size.times do |cut|
    got = outcome(whole[0, cut], GOOD, ROOT)
    check got.starts_with?("refused: "), "#{entry[0]} cut to #{cut} bytes: #{got}"
  end
  whole.size.times do |at|
    flipped = whole.dup
    flipped[at] = flipped[at] ^ 0x01_u8
    got = outcome(flipped, GOOD, ROOT)
    check got.starts_with?("refused: "), "#{entry[0]} with byte #{at} flipped: #{got}"
  end
  puts "  #{entry[0]}: #{whole.size} truncations and #{whole.size} flipped bytes, each refused"
end

puts "ALL CHECKS PASSED"
