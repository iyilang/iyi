APPENDIX_F.each do |example|
  answer = CBOR.decode(unhex(example[0]))
  raise "ASSERTION FAILED: appendix F refuses #{example[0]}: accepted as #{answer}" unless answer.is_a?(CBORError)
  assert_str(example[1], answer.message, "appendix F refuses #{example[0]}")
  assert_true(CBOR.decode?(unhex(example[0])).nil? && !CBOR.deterministic?(unhex(example[0])), "appendix F: decode? answers nil for #{example[0]}")
  puts "INVALID #{example[0]}\t0"
end
