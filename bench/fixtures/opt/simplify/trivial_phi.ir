; iyi-ir 1
source_filename = "trivial_phi"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @trivial_phi(i1 %c, i32 %x) {
entry:
  br i1 %c, label %left, label %right
left:
  br label %join
right:
  br label %join
join:
  %p = phi i32 [ %x, label %left ], [ %x, label %right ]
  ret i32 %p
}
