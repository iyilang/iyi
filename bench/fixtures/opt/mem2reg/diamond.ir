; iyi-ir 1
source_filename = "diamond"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @diamond(i1 %c, i64 %x) {
entry:
  %slot = alloca i64, align 8
  %base_slot = alloca i64, align 8
  br label %trunk
trunk:
  store i64 %x, ptr %base_slot, align 8
  br i1 %c, label %left, label %right
left:
  store i64 1, ptr %slot, align 8
  br label %join
right:
  store i64 2, ptr %slot, align 8
  br label %join
join:
  %value = load i64, ptr %slot, align 8
  %base = load i64, ptr %base_slot, align 8
  %sum = add i64 %base, %value
  ret i64 %sum
}
