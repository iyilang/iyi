# iyi: the rest of `Enum`, added to the prelude's.
#
# The prelude gives every enum its value, its name, `==` and the ordering,
# `includes?`, `|` and `&`, `values`/`names`, and the two questions that
# answer nil: `parse?` and `from_value?`. This module adds what is left:
# the conversions the value itself has (`to_i`, `to_i32`, `to_i64`, `to_u8`,
# `to_u64`, `to_f64`),
# member arithmetic (`+`/`-` an integer, `^` a member), `<=>`, `clone`,
# the `io` spellings of `to_s`/`inspect`, `each`, `valid?`, and the
# panicking halves of the two questions: `from_value` and `parse`, which
# refuse with the value or the name they were given.
#
# A `@[Flags]` enum is treated the way the prelude treats it. `each` walks
# the members `values` lists — not `None` and `All`, which the compiler
# added. `valid?` answers what `from_value?` answers: a member, or zero
# (`None`); a combination of bits is not a member, and `All` is not one
# either. Whether a combination holds a bit is `includes?`'s question.
#
# There is no `~`: the prelude gives integers no complement, so an enum
# has none to build on.

module std/enum

struct ::Enum
  def to_i : Int32
    value.to_i32
  end

  def to_i32 : Int32
    value.to_i32
  end

  def to_i64 : Int64
    value.to_i64
  end

  def to_u8 : UInt8
    value.to_u8
  end

  def to_u64 : UInt64
    value.to_u64
  end

  def to_f64 : Float64
    value.to_f64
  end

  # The member `other` places after this one; may name no member.
  def +(other : Int) : self
    self.class.new(value + other)
  end

  # The member `other` places before this one; may name no member.
  def -(other : Int) : self
    self.class.new(value - other)
  end

  # The bits in exactly one of the two.
  def ^(other : self) : self
    self.class.new(value ^ other.value)
  end

  # -1, 0 or 1 by value.
  def <=>(other : self) : Int32
    v1 = value
    v2 = other.value
    v1 < v2 ? -1 : (v1 > v2 ? 1 : 0)
  end

  def clone : self
    self
  end

  def to_s(io : IyiIO) : Nil
    io.print(to_s)
  end

  def inspect(io : IyiIO) : Nil
    io.print(inspect)
  end

  # The member numbered `val`; panics naming the value where no member is.
  def self.from_value(val : Int) : self
    from_value?(val.to_i32) || raise "no #{self} member has the value #{val}"
  end

  # Whether `val` is a member: what `from_value?` answers, as a Bool. For a
  # flags enum that is a single member or `None`; a combination and `All`
  # are not members.
  def self.valid?(val : self) : Bool
    !from_value?(val.value.to_i32).nil?
  end

  # The member named `string`, compared the lenient way `parse?` compares;
  # panics naming the text where no member is.
  def self.parse(string : String) : self
    parse?(string) || raise "no #{self} member is named #{string.inspect}"
  end

  # Every member in the order written, as `values` lists them: for a flags
  # enum, without `None` and `All`.
  def self.each(& : self -> Nil) : Nil
    values.each { |member| yield member }
  end
end
