# The standalone iyi-format program uses the ported formatter.
# bench/selfhost_formatter_exercise.sh builds and checks it.
# The hosted `iyi tool format` command continues to use the hosted formatter.

module compiler/tools/format

import compiler/tools/formatter::{Formatter}

module FormatTool
  def self.run : Nil
    args = Program.args
    if args.empty? || args[0] == "-"
      source = read_input
      if source.empty?
        return
      end
      print Formatter.format(source, "STDIN")
    else
      path = args[0]
      unless File.exists?(path)
        raise "no such file: " + path
      end
      source = File.read(path)
      if source.empty?
        return
      end
      print Formatter.format(source, path)
    end
  end
end

FormatTool.run
