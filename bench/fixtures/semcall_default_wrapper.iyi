# wrapper wrap_first(40, 3)
# wrapper wrap_second(1)
# wrapper wrap_second(1, b: 3)
# wrapper wrap_second(a: 1)
# wrapper wrap_second(b: 3, a: 1)
# wrapper wrap_yield(1) { |x| x }
