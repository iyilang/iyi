; iyi-ir 1
module "narrow_call"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
declare external i32 @__fixture_negative()
@fmt = private constant [4 x i8] c"%d\0A\00"
define i32 @main() {
entry:
  %v = call i32 () @__fixture_negative()
  %neg = icmp slt i32 %v, 0
  %n = zext i1 %neg to i32
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %n)
  ret i32 0
}
