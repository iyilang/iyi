; iyi-ir 1
source_filename = "merge_non_inbounds_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal void @__iyi_write_barrier_begin() {
entry:
  ret void
}
define internal void @__iyi_write_barrier(ptr %address, i64 %words) {
entry:
  ret void
}
define external void @first_not_inbounds(ptr %object, ptr %left, ptr %right) {
entry:
  %low = getelementptr i8, ptr %object, i64 0
  %mark1 = load i8, ptr @__iyi_marking, align 1
  %active1 = icmp ne i8 %mark1, 0
  br i1 %active1, label %begin1, label %plain1
begin1:
  call void () @__iyi_write_barrier_begin()
  br label %join1
plain1:
  br label %join1
join1:
  store ptr %left, ptr %low, align 8
  br i1 %active1, label %shade1, label %after1
shade1:
  call void (ptr, i64) @__iyi_write_barrier(ptr %low, i64 1)
  br label %after1
after1:
  %high = getelementptr inbounds i8, ptr %object, i64 8
  %mark2 = load i8, ptr @__iyi_marking, align 1
  %active2 = icmp ne i8 %mark2, 0
  br i1 %active2, label %begin2, label %plain2
begin2:
  call void () @__iyi_write_barrier_begin()
  br label %join2
plain2:
  br label %join2
join2:
  store ptr %right, ptr %high, align 8
  br i1 %active2, label %shade2, label %done
shade2:
  call void (ptr, i64) @__iyi_write_barrier(ptr %high, i64 1)
  br label %done
done:
  ret void
}
define external void @second_not_inbounds(ptr %object, ptr %left, ptr %right) {
entry:
  %low = getelementptr inbounds i8, ptr %object, i64 0
  %mark1 = load i8, ptr @__iyi_marking, align 1
  %active1 = icmp ne i8 %mark1, 0
  br i1 %active1, label %begin1, label %plain1
begin1:
  call void () @__iyi_write_barrier_begin()
  br label %join1
plain1:
  br label %join1
join1:
  store ptr %left, ptr %low, align 8
  br i1 %active1, label %shade1, label %after1
shade1:
  call void (ptr, i64) @__iyi_write_barrier(ptr %low, i64 1)
  br label %after1
after1:
  %high = getelementptr i8, ptr %object, i64 8
  %mark2 = load i8, ptr @__iyi_marking, align 1
  %active2 = icmp ne i8 %mark2, 0
  br i1 %active2, label %begin2, label %plain2
begin2:
  call void () @__iyi_write_barrier_begin()
  br label %join2
plain2:
  br label %join2
join2:
  store ptr %right, ptr %high, align 8
  br i1 %active2, label %shade2, label %done
shade2:
  call void (ptr, i64) @__iyi_write_barrier(ptr %high, i64 1)
  br label %done
done:
  ret void
}
