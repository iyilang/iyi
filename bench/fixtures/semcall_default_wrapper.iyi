def wrap_first(a : Int32, b : Int32 = 2)
  nil
end

def wrap_second(a : Int32, b = 2)
  nil
end

def wrap_magic(a : Int32, line = __LINE__)
  nil
end

def wrap_yield(a : Int32, b = 2, &)
  yield a
end

