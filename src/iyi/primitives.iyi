# What the compiler emits instructions for — SPEC.md, "0.1.0", item 3.
#
# A `@[Primitive]` method has no body on purpose: the annotation names an
# instruction the code generator writes at the call site. So this file is not
# an implementation, it is the list of machine operations iyi admits, and its
# shape is a language decision rather than a library one.
#
# **This is iyi's list, not Crystal's.** `src/primitives.cr` declares twelve
# numeric types and crosses them with each other, which is 2,580 definitions
# expanded on every build and **0.11 s of a 0.17 s front end** — measured by
# deleting the block and building again. iyi crosses five, which is 445.
#
# The five are `Int32`, `Int64`, `UInt8`, `UInt64` and `Float64`: the default
# integer, the one a byte count grows into, the byte itself, the one an address
# and a size are, and a float. `UInt16` joins them for comparison alone, for
# the reason written at the cross below: a wide character is compared on
# every Windows path. `Int8`, `Int16`, `Int128` and the unsigned middle exist
# as types and have no arithmetic, because no sample writes one — the same
# rule the rest of the prelude is built on. Writing `1_i8 + 1_i8` is an
# "undefined method" and that is the honest answer: 0.1.0 does not have
# eight-bit arithmetic rather than having it slowly.
#
# **Comparison is not refused the same way, and that is a defect this file
# cannot close.** `Object#==` answers `false` for anything no type claimed,
# which is right about two objects and a lie about two numbers: without
# `import std/int`, `1_i8 == 1_i8` is `false` rather than an error, and it
# was `92_u16 == 92_u16` answering false that hid two Windows defects for a
# week. Refusing it needs both sides' types at once, which a method body
# does not have — a guard on the receiver alone refuses `5 == nil`, where
# `false` is the correct answer, and it was measured doing exactly that to
# eleven exercises. The fix belongs in overload resolution, where the
# compiler knows both types; until then `UInt16` being in the cross is what
# the library's own callers needed, and this paragraph is the rest of the
# truth.
class Object
  @[Primitive(:class)]
  def class
  end

  # The runtime type id. `String.new` writes it into the header of a string it
  # builds, which is how a string built at run time becomes indistinguishable
  # from one codegen laid out.
  @[Primitive(:object_crystal_type_id)]
  def crystal_type_id : Int32
  end
end

# What every class instance is: a pointer to its fields, compared and
# hashed by identity unless the class says otherwise.
class Reference
  @[Primitive(:object_id)]
  def object_id : UInt64
  end
end

class Class
  @[Primitive(:class_crystal_instance_type_id)]
  def crystal_instance_type_id : Int32
  end
end

# `true` and `false`.
struct Bool
  @[Primitive(:binary)]
  def ==(other : Bool) : Bool
  end

  @[Primitive(:binary)]
  def !=(other : Bool) : Bool
  end
end

# One character - a byte, in this prelude, which reads its strings as ASCII.
struct Char
  @[Primitive(:convert)]
  def ord : Int32
  end

  {% for op in %w(== != < <= > >=) %}
    @[Primitive(:binary)]
    def {{ op.id }}(other : Char) : Bool
    end
  {% end %}
end

# A name that compares by identity: `:ok`, `:err`.
struct Symbol
  @[Primitive(:binary)]
  def ==(other : Symbol) : Bool
  end

  @[Primitive(:binary)]
  def !=(other : Symbol) : Bool
  end

  @[Primitive(:convert)]
  def to_i : Int32
  end

  @[Primitive(:symbol_to_s)]
  def to_s : String
  end
end

# A raw address: `Pointer(T).malloc(n)` is `n` elements of untyped memory,
# `[]` and `[]=` read and write them, nothing checks the bounds.
struct Pointer(T)
  @[Primitive(:pointer_malloc)]
  def self.malloc(size : UInt64)
  end

  @[Primitive(:pointer_new)]
  def self.new(address : UInt64)
  end

  @[Primitive(:pointer_get)]
  def value : T
  end

  @[Primitive(:pointer_set)]
  def value=(value : T)
  end

  @[Primitive(:pointer_address)]
  def address : UInt64
  end

  @[Primitive(:pointer_realloc)]
  def realloc(size : UInt64) : self
  end

  @[Primitive(:pointer_add)]
  def +(offset : Int64) : self
  end

  @[Primitive(:pointer_diff)]
  def -(other : self) : Int64
  end
end

# The four atomic instructions, on the word an `Atomic(T)` holds
# (`atomic.iyi` is the type; this is what it is made of). An ordering is
# a symbol the code generator reads at the call site, so a caller passes
# the literal — `:sequentially_consistent` and nothing else, which is the
# decision `atomic.iyi` records. `fence` is not here: nothing calls one.
#
# On a holder of their own rather than on `Atomic(T)`, for a reason the
# code generator has: a call on a generic instance's class passes that
# class as a first argument (`Pointer(T).malloc` reads its size from
# `call_args[1]`), and the atomic instructions take their operands from
# the front. Crystal's `Atomic::Ops` is the same shape for the same
# reason.
struct IyiAtomic
  @[Primitive(:load_atomic)]
  def self.load(pointer : Pointer(T), ordering : Symbol, volatile : Bool) : T forall T
  end

  @[Primitive(:store_atomic)]
  def self.store(pointer : Pointer(T), value : T, ordering : Symbol, volatile : Bool) : Nil forall T
  end

  # `op` is `:add`, `:sub` or `:xchg`; the instruction answers what the
  # word held before.
  @[Primitive(:atomicrmw)]
  def self.rmw(op : Symbol, pointer : Pointer(T), value : T, ordering : Symbol, singlethread : Bool) : T forall T
  end

  # What the word held, and whether it was `expected` and is now `desired`.
  @[Primitive(:cmpxchg)]
  def self.cmpxchg(pointer : Pointer(T), expected : T, desired : T, success : Symbol, failure : Symbol) : Tuple(T, Bool) forall T
  end
end

struct Proc
  @[Primitive(:proc_call)]
  @[Raises]
  def call(*args : *T) : R
  end
end

{% begin %}
  {% ints = %w(Int32 Int64 UInt8 UInt64) %}
  {% floats = %w(Float64) %}
  {% nums = %w(Int32 Int64 UInt8 UInt64 Float64) %}
  # `UInt16` compares and converts, and does not add. A wide character is
  # the one value of that width this prelude holds — Windows' every path,
  # console write and reparse point is UTF-16 — and what the code does with
  # one is compare it against a separator or a prefix byte and convert it,
  # never arithmetic. It was outside the list entirely, and the failure was
  # silent rather than loud: `Object#==` answers `false` for anything it
  # does not know, so `92_u16 == 92_u16` was *false* and two call sites
  # quietly did nothing — `__iyi_wide_rooted?` said no about every rooted
  # path, and `File.readlink` never stripped the `\??\` a reparse point
  # stores. Measured with `46_u16 == 46_u16`, which answered false, and
  # `46_u16.to_s`, which printed `UInt16`.
  {% comparables = %w(Int32 Int64 UInt8 UInt64 Float64 UInt16) %}
  {% binaries = %w(+ - *) %}

  {% for num in nums %}
    struct {{ num.id }}
      # The checked form raises on overflow — which in this prelude is a panic,
      # since `__crystal_raise_overflow` prints and exits (SPEC.md III.1.4).
      #
      # The unchecked form is the same instruction without the check, and it
      # is spelled the way `unsafe_chr` below is: `unsafe_to_u8`. Crystal
      # spells it `to_u8!`, which is not a name in iyi (SPEC.md III.1.7) —
      # those declarations were accepted only because a macro expansion was
      # reparsed by the other language's rules, and no iyi source could call
      # one, because `x.to_u8!` is `x.to_u8` with its error propagated. The
      # callers wanted the instruction: `memset`'s `value.to_u8!` is C's
      # "converted to unsigned char", and the checked form panics on 0x1ff
      # where C writes 0xff.
      {% for name, type in {
                             to_i:   Int32,
                             to_f:   Float64,
                             to_i32: Int32,
                             to_i64: Int64,
                             to_u8:  UInt8,
                             to_u64: UInt64,
                             to_f64: Float64,
                           } %}
        @[::Primitive(:convert)]
        @[Raises]
        def {{ name.id }} : {{ type }}
        end

        @[::Primitive(:unchecked_convert)]
        def unsafe_{{ name.id }} : {{ type }}
        end

      {% end %}
    end
  {% end %}

  # The comparison cross is the one `UInt16` joins, and only it: the
  # conversions above stay at five, because `std/int` declares the whole
  # tower's conversions and a prelude that also declared `UInt16#to_i32`
  # would be redefining one of them (SPEC.md R-3, which is how this split
  # announced itself).
  #
  # A wide character against a double is left out for the same reason and
  # a better one: `std/int` defines that comparison by converting, because
  # every value narrower than a double *is* a double exactly, and an
  # instruction that compares the two directly is not what it means.
  {% for num in comparables %}
    struct {{ num.id }}
      {% for num2 in comparables %}
        {% unless (num == "UInt16" && num2 == "Float64") || (num == "Float64" && num2 == "UInt16") %}
          {% for op in %w(== != < <= > >=) %}
            @[::Primitive(:binary)]
            def {{ op.id }}(other : {{ num2.id }}) : Bool
            end
          {% end %}
        {% end %}
      {% end %}
    end
  {% end %}

  {% for int in ints %}
    struct {{ int.id }}
      @[::Primitive(:unchecked_convert)]
      def unsafe_chr : Char
      end

      {% for int2 in ints %}
        {% for op in binaries %}
          @[::Primitive(:binary)]
          @[Raises]
          def {{ op.id }}(other : {{ int2.id }}) : self
          end

          @[::Primitive(:binary)]
          def &{{ op.id }}(other : {{ int2.id }}) : self
          end
        {% end %}

        {% for op in %w(| & ^ unsafe_shl unsafe_shr unsafe_div unsafe_mod) %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : {{ int2.id }}) : self
          end
        {% end %}
      {% end %}

      {% for float in floats %}
        {% for op in binaries %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : {{ float.id }}) : {{ float.id }}
          end
        {% end %}
      {% end %}
    end
  {% end %}

  {% for float in floats %}
    struct {{ float.id }}
      {% for num in nums %}
        {% for op in binaries %}
          @[::Primitive(:binary)]
          def {{ op.id }}(other : {{ num.id }}) : self
          end
        {% end %}

        @[::Primitive(:binary)]
        def fdiv(other : {{ num.id }}) : self
        end
      {% end %}

      @[::Primitive(:binary)]
      def /(other : {{ float.id }}) : {{ float.id }}
      end
    end
  {% end %}
{% end %}
