; iyi-ir 1
source_filename = "unreachable_predecessor"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @unreachable_predecessor(i1 %c) {
entry:
  br i1 %c, label %left, label %right
left:
  br label %join
right:
  br label %join
dead:
  br label %join
join:
  %0 = phi i64 [ 2, label %right ], [ 1, label %left ], [ 0, label %dead ]
  ret i64 %0
}
