pub class Macro < ASTNode
  property name : String
  property args : Array(Arg)
  property body : ASTNode
  property double_splat : Arg?
  property block_arg : Arg?
  property splat_index : Int32?

  def initialize(
    @name : String = "",
    @args : Array(Arg) = [] of Arg,
    body : ASTNode? = nil,
    @double_splat : Arg? = nil,
    @block_arg : Arg? = nil,
    @splat_index : Int32? = nil,
  )
    @body = body || Nop.new
  end

  def clone_without_location : self
    cloned_args = @args.map { |a| a.clone.as(Arg) }
    Macro.new(
      @name,
      cloned_args,
      @body.clone,
      (if ds = @double_splat
        ds.clone.as(Arg)
      else
        nil
      end),
      (if ba = @block_arg
        ba.clone.as(Arg)
      else
        nil
      end),
      @splat_index
    )
  end

  def accept_children(visitor) : Nil
    @args.each { |a| a.accept(visitor) }
    if ds = @double_splat
      ds.accept(visitor)
    end
    if ba = @block_arg
      ba.accept(visitor)
    end
    @body.accept(visitor)
  end

  def ==(other : self) : Bool
    (@name == other.name) && (@args == other.args) && (@body == other.body) && (@double_splat == other.double_splat) && (@block_arg == other.block_arg) && (@splat_index == other.splat_index)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@name)
    h = 31 &* h &+ hash_val(@args)
    h = 31 &* h &+ hash_val(@body)
    h = 31 &* h &+ hash_val(@double_splat)
    h = 31 &* h &+ hash_val(@block_arg)
    h = 31 &* h &+ hash_val(@splat_index)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "macro " << @name
    if @args.size > 0 || @double_splat || @block_arg
      sb << "("
      i = 0
      while i < @args.size
        sb << ", " if i > 0
        sb << "*" if @splat_index == i
        @args[i].to_s(sb)
        i = i + 1
      end
      if ds = @double_splat
        sb << ", " if @args.size > 0
        sb << "**"
        ds.to_s(sb)
      end
      if ba = @block_arg
        sb << ", " if @args.size > 0 || @double_splat
        sb << "&"
        ba.to_s(sb)
      end
      sb << ")"
    end
    sb << "
  "
    @body.to_s(sb)
    sb << "
end"
  end
end

