abstract class Shape
  abstract def area : Float64

  def name : String
    "shape"
  end
end

class Circle < Shape
  def area : Float64
    3.14
  end

  def radius : Float64
    1.0
  end
end

class Cylinder < Circle
  def volume : Float64
    3.14
  end
end

abstract struct BaseStruct
  abstract def id : Int64
end

struct ConcreteStruct < BaseStruct
  def id : Int64
    42_i64
  end
end
