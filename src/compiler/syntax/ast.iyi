pub class Yield < ASTNode
  property exps : Array(ASTNode)
  property scope : ASTNode?
  property has_parentheses : Bool

  def initialize(@exps : Array(ASTNode) = [] of ASTNode, @scope : ASTNode? = nil, @has_parentheses : Bool = false)
  end

  def clone_without_location : self
    Yield.new(clone_nodes(@exps), clone_node(@scope), @has_parentheses)
  end

  def accept_children(visitor) : Nil
    @exps.each { |e| e.accept(visitor) }
    if s = @scope
      s.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    (@exps == other.exps) && (@scope == other.scope) && (@has_parentheses == other.has_parentheses)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@exps)
    h = 31 &* h &+ hash_val(@scope)
    h = 31 &* h &+ hash_val(@has_parentheses)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    if s = @scope
      sb << "with "
      s.to_s(sb)
      sb << " "
    end
    sb << "yield"
    if @has_parentheses
      sb << "("
      i = 0
      while i < @exps.size
        sb << ", " if i > 0
        @exps[i].to_s(sb)
        i = i + 1
      end
      sb << ")"
    elsif @exps.size > 0
      sb << " "
      i = 0
      while i < @exps.size
        sb << ", " if i > 0
        @exps[i].to_s(sb)
        i = i + 1
      end
    end
  end
end

pub class Expressions < ASTNode
  pub enum Keyword
    None
    Paren
    Begin
  end

  property expressions : Array(ASTNode)
  property keyword : Keyword

  def initialize(@expressions : Array(ASTNode) = [] of ASTNode, @keyword : Keyword = Keyword::None)
  end

  def self.from(nodes : Array(ASTNode)) : ASTNode
    if nodes.size == 0
      Nop.new
    elsif nodes.size == 1
      nodes[0]
    else
      new(nodes)
    end
  end

  def clone_without_location : self
    Expressions.new(clone_nodes(@expressions), @keyword)
  end

  def accept_children(visitor) : Nil
    @expressions.each { |e| e.accept(visitor) }
  end

  def ==(other : self) : Bool
    (@expressions == other.expressions) && (@keyword == other.keyword)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@expressions)
    h = 31 &* h &+ hash_val(@keyword)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    case @keyword
    when Keyword::Paren
      sb << "("
      i = 0
      while i < @expressions.size
        sb << "; " if i > 0
        @expressions[i].to_s(sb)
        i = i + 1
      end
      sb << ")"
    when Keyword::Begin
      sb << "begin
"
      @expressions.each do |e|
        sb << "  "
        e.to_s(sb)
        sb << "
"
      end
      sb << "end"
    else
      i = 0
      while i < @expressions.size
        sb << "
" if i > 0
        @expressions[i].to_s(sb)
        i = i + 1
      end
    end
  end
end

pub class If < ASTNode
  property cond : ASTNode
  property then : ASTNode
  property else : ASTNode
  property ternary : Bool

  def initialize(@cond : ASTNode, a_then : ASTNode? = nil, a_else : ASTNode? = nil, @ternary : Bool = false)
    @then = a_then || Nop.new
    @else = a_else || Nop.new
  end

  def clone_without_location : self
    If.new(@cond.clone, @then.clone, @else.clone, @ternary)
  end

  def accept_children(visitor) : Nil
    @cond.accept(visitor)
    @then.accept(visitor)
    @else.accept(visitor)
  end

  def ==(other : self) : Bool
    @cond == other.cond && @then == other.then && @else == other.else && @ternary == other.ternary
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    31 &* (31 &* (31 &* (31 &* 17 &+ @cond.hash) &+ @then.hash) &+ @else.hash) &+ (@ternary ? 1 : 0)
  end

  def to_s(sb : StringBuilder) : Nil
    if @ternary
      @cond.to_s(sb)
      sb << " ? "
      @then.to_s(sb)
      sb << " : "
      @else.to_s(sb)
    else
      sb << "if "
      @cond.to_s(sb)
      sb << "
  "
      @then.to_s(sb)
      unless @else.is_a?(Nop)
        sb << "
else
  "
        @else.to_s(sb)
      end
      sb << "
end"
    end
  end
end

