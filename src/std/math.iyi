  # hi + lo = a + b, |a| >= |b| (s_erf_common.h fast_two_sum).
  private def self.erf_fast_two_sum(a : Float64, b : Float64) : {Float64, Float64}
    hi = a + b
    e = hi - a
    {hi, b - e}
  end

  # hi + lo = a + b (s_erf_common.h two_sum).
  private def self.erf_two_sum(a : Float64, b : Float64) : {Float64, Float64}
    hi = a + b
    aa = hi - b
    bb = hi - aa
    da = a - aa
    db = b - bb
    {hi, da + db}
  end

  # hi + lo = a * b exactly (s_erf_common.h a_mul).
  private def self.erf_a_mul(a : Float64, b : Float64) : {Float64, Float64}
    hi = a * b
    {hi, fma(a, b, hi * -1.0)}
  end

  # erf(z) ~ h + l for 2^-61 <= z <= 0x1.7afb48dc96626p+2, with the
  # relative error bound as third value (s_erf_common.c __cr_erf_fast).
  private def self.erf_fast(z : Float64) : {Float64, Float64, Float64}
    if z < 0.0625
      c0 = ERF_C0.to_unsafe
      z2h, z2l = erf_a_mul(z, z)
      z4 = z2h * z2h
      c9 = fma(IyiFloatText.from_bits(c0[7]), z2h, IyiFloatText.from_bits(c0[6]))
      c5 = fma(IyiFloatText.from_bits(c0[5]), z2h, IyiFloatText.from_bits(c0[4]))
      c5 = fma(c9, z4, c5)
      th, tl = erf_a_mul(z2h, c5)
      h, l = erf_fast_two_sum(IyiFloatText.from_bits(c0[2]), th)
      l = l + (tl + IyiFloatText.from_bits(c0[3]))
      h_copy = h
      th, tl = erf_a_mul(z2h, h)
      tl = tl + fma(z2h, l, IyiFloatText.from_bits(c0[1]))
      h, l = erf_fast_two_sum(IyiFloatText.from_bits(c0[0]), th)
      l = l + fma(z2l, h_copy, tl)
      h, tl = erf_a_mul(h, z)
      l = fma(l, z, tl)
      return {h, l, 2.4881592825595072e-21}
    end
    v = (16.0 * z).floor
    i = (16.0 * z).unsafe_to_i32
    z = (z - 0.03125) - 0.0625 * v
    c = ERF_C.to_unsafe + (i &- 1) &* 13
    z2 = z * z
    z4 = z2 * z2
    c9 = fma(IyiFloatText.from_bits(c[12]), z, IyiFloatText.from_bits(c[11]))
    c7 = fma(IyiFloatText.from_bits(c[10]), z, IyiFloatText.from_bits(c[9]))
    c5 = fma(IyiFloatText.from_bits(c[8]), z, IyiFloatText.from_bits(c[7]))
    c3h, c3l = erf_fast_two_sum(IyiFloatText.from_bits(c[5]), z * IyiFloatText.from_bits(c[6]))
    c7 = fma(c9, z2, c7)
    c3h, tl = erf_fast_two_sum(c3h, c5 * z2)
    c3l = c3l + tl
    c3h, tl = erf_fast_two_sum(c3h, c7 * z4)
    c3l = c3l + tl
    th, tl = erf_a_mul(z, c3h)
    c2h, c2l = erf_fast_two_sum(IyiFloatText.from_bits(c[4]), th)
    c2l = c2l + fma(z, c3l, tl)
    th, tl = erf_a_mul(z, c2h)
    h, l = erf_fast_two_sum(IyiFloatText.from_bits(c[2]), th)
    l = l + (tl + fma(z, c2l, IyiFloatText.from_bits(c[3])))
    th, tl = erf_a_mul(z, h)
    tl = fma(z, l, tl)
    h, l = erf_fast_two_sum(IyiFloatText.from_bits(c[0]), th)
    l = l + (tl + IyiFloatText.from_bits(c[1]))
    {h, l, 1.8065624578158124e-21}
  end

  # erf(z) ~ h + l for 2^-61 <= z < 1/8, consulting the table of hard
  # cases when asked (s_erf_common.c __cr_erf_accurate_tiny).
  private def self.erf_accurate_tiny(z : Float64, exceptions : Bool) : {Float64, Float64}
    if exceptions
      ex = ERF_EXCEPTIONS_TINY.to_unsafe
      i = 0
      j = ERF_EXCEPTIONS_TINY.size // 3
      while i + 1 < j
        k = (i + j) // 2
        if IyiFloatText.from_bits(ex[3 * k]) <= z
          i = k
        else
          j = k
        end
      end
      if z == IyiFloatText.from_bits(ex[3 * i])
        return {IyiFloatText.from_bits(ex[3 * i + 1]), IyiFloatText.from_bits(ex[3 * i + 2])}
      end
    end
    p = ERF_P.to_unsafe
    z2 = z * z
    h = IyiFloatText.from_bits(p[21 // 2 + 4])
    a = 19
    while a > 11
      h = fma(h, z2, IyiFloatText.from_bits(p[a // 2 + 4]))
      a -= 2
    end
    l = 0.0
    a = 11
    while a > 7
      th, tl = erf_a_mul(h, z)
      tl = fma(l, z, tl)
      h, l = erf_a_mul(th, z)
      l = fma(tl, z, l)
      h, tl = erf_fast_two_sum(IyiFloatText.from_bits(p[a // 2 + 4]), h)
      l = l + tl
      a -= 2
    end
    a = 7
    while a >= 1
      th, tl = erf_a_mul(h, z)
      tl = fma(l, z, tl)
      h, l = erf_a_mul(th, z)
      l = fma(tl, z, l)
      h, tl = erf_fast_two_sum(IyiFloatText.from_bits(p[a - 1]), h)
      l = l + (IyiFloatText.from_bits(p[a]) + tl)
      a -= 2
    end
    h, tl = erf_a_mul(h, z)
    {h, fma(l, z, tl)}
  end

  # erf(z) ~ h + l for 2^-61 <= z <= 0x1.7afb48dc96626p+2; erf consults
  # the tables of hard cases, erfc does not (s_erf.c and s_erfc.c
  # cr_erf_accurate).
  private def self.erf_accurate(z : Float64, exceptions : Bool) : {Float64, Float64}
    if exceptions
      ex = ERF_EXCEPTIONS.to_unsafe
      n = ERF_EXCEPTIONS.size // 3
      k = 0
      while k < n
        if z == IyiFloatText.from_bits(ex[3 * k])
          return {IyiFloatText.from_bits(ex[3 * k + 1]), IyiFloatText.from_bits(ex[3 * k + 2])}
        end
        k += 1
      end
    end
    return erf_accurate_tiny(z, exceptions) if z < 0.125
    v = (8.0 * z).floor
    i = (8.0 * z).unsafe_to_i32
    z = (z - 0.0625) - 0.125 * v
    p = ERF_C2.to_unsafe + (i &- 1) &* 27
    h = IyiFloatText.from_bits(p[26])
    j = 17
    while j > 10
      h = fma(h, z, IyiFloatText.from_bits(p[8 + j]))
      j -= 1
    end
    l = 0.0
    j = 10
    while j > 7
      th, tl = erf_a_mul(h, z)
      tl = fma(l, z, tl)
      h, l = erf_two_sum(IyiFloatText.from_bits(p[8 + j]), th)
      l = l + tl
      j -= 1
    end
    j = 7
    while j >= 0
      th, tl = erf_a_mul(h, z)
      tl = fma(l, z, tl)
      h, l = erf_two_sum(IyiFloatText.from_bits(p[2 * j]), th)
      l = l + (IyiFloatText.from_bits(p[2 * j + 1]) + tl)
      j -= 1
    end
    {h, l}
  end

  # a * (bh + bl) (s_erfc.c s_mul).
  private def self.erf_s_mul(a : Float64, bh : Float64, bl : Float64) : {Float64, Float64}
    hi, lo = erf_a_mul(a, bh)
    {hi, fma(a, bl, lo)}
  end

  # (ah + al) * (bh + bl) - al * bl (s_erfc.c d_mul).
  private def self.erf_d_mul(ah : Float64, al : Float64, bh : Float64, bl : Float64) : {Float64, Float64}
    hi, lo = erf_a_mul(ah, bh)
    lo = fma(ah, bl, lo)
    {hi, fma(al, bh, lo)}
  end

  # exp(zh + zl) for |zh + zl| < 2^-12.88 (s_erfc.c q_1).
  private def self.erf_q_1(zh : Float64, zl : Float64) : {Float64, Float64}
    q1 = ERF_Q1.to_unsafe
    z = zh + zl
    q = fma(IyiFloatText.from_bits(q1[4]), zh, IyiFloatText.from_bits(q1[3]))
    q = fma(q, z, IyiFloatText.from_bits(q1[2]))
    hi, lo = erf_fast_two_sum(IyiFloatText.from_bits(q1[1]), q * z)
    hi, lo = erf_d_mul(zh, zl, hi, lo)
    hi, t = erf_fast_two_sum(IyiFloatText.from_bits(q1[0]), hi)
    {hi, t + lo}
  end

  # The half-integer tie-to-even rounding of x, |x| < 2^51.
  private def self.erf_roundeven(x : Float64) : Float64
    (x + 6755399441055744.0) - 6755399441055744.0
  end

  # exp(xh + xl) for erfc's fast path (s_erfc.c exp_1).
  private def self.erf_exp_1(xh : Float64, xl : Float64) : {Float64, Float64}
    k = erf_roundeven(xh * 5909.278887481194)
    kh, kl = erf_s_mul(k, 0.0001692253858788929, 5.661735385366942e-21)
    yh, yl = erf_fast_two_sum(xh - kh, xl)
    yl = yl - kl
    kbits = k.unsafe_to_i64.unsafe_to_u64
    m = (k * 0.000244140625).floor.unsafe_to_i64 &+ 0x3ff_i64
    i2 = (kbits.unsafe_shr(6_u64) & 0x3f_u64).unsafe_to_i32
    i1 = (kbits & 0x3f_u64).unsafe_to_i32
    t1 = ERF_T1.to_unsafe
    t2 = ERF_T2.to_unsafe
    hi, lo = erf_d_mul(IyiFloatText.from_bits(t2[2 * i1]), IyiFloatText.from_bits(t2[2 * i1 + 1]),
      IyiFloatText.from_bits(t1[2 * i2]), IyiFloatText.from_bits(t1[2 * i2 + 1]))
    qh, ql = erf_q_1(yh, yl)
    hi, lo = erf_d_mul(hi, lo, qh, ql)
    df = IyiFloatText.from_bits(m.unsafe_to_u64.unsafe_shl(52_u64))
    {hi * df, lo * df}
  end

  # 2^e * (h + l) ~ exp(xh + xl) for -742 <= xh + xl <= -2.92, to 104
  # bits (s_erfc.c exp_accurate).
  private def self.erf_exp_accurate(xh : Float64, xl : Float64) : {Float64, Float64, Int32}
    e2 = ERF_ERFC_E2.to_unsafe
    k = erf_roundeven(xh * 1.4426950408889634)
    nk = k * -1.0
    yh = fma(nk, 0.6931471805599453, xh)
    th, tl = erf_two_sum(nk * 2.31904681384628e-17, xl)
    yh, yl = erf_fast_two_sum(yh, th)
    yl = fma(nk, 1.94704509238075e-31, yl + tl)
    h = IyiFloatText.from_bits(e2[19 + 8])
    i = 18
    while i >= 16
      h = fma(h, yh, IyiFloatText.from_bits(e2[i + 8]))
      i -= 1
    end
    th, tl = erf_a_mul(h, yh)
    tl = fma(h, yl, tl)
    h, l = erf_fast_two_sum(IyiFloatText.from_bits(e2[15 + 8]), th)
    l = l + tl
    i = 14
    while i >= 8
      th, tl = erf_a_mul(h, yh)
      tl = fma(h, yl, tl)
      tl = fma(l, yh, tl)
      h, l = erf_fast_two_sum(IyiFloatText.from_bits(e2[i + 8]), th)
      l = l + tl
      i -= 1
    end
    i = 7
    while i >= 0
      th, tl = erf_a_mul(h, yh)
      tl = fma(h, yl, tl)
      tl = fma(l, yh, tl)
      h, l = erf_fast_two_sum(IyiFloatText.from_bits(e2[2 * i]), th)
      l = l + (tl + IyiFloatText.from_bits(e2[2 * i + 1]))
      i -= 1
    end
    {h, l, k.unsafe_to_i32}
  end

  # erfc(x) ~ h + l for 0x1.713786d9c7c09p+1 < x < 0x1.b39dc41e48bfdp+4 by
  # the asymptotic expansion, with the error bound as third value
  # (s_erfc.c erfc_asympt_fast).
  private def self.erf_erfc_asympt_fast(x : Float64) : {Float64, Float64, Float64}
    return {0.0, 0.0, 1.0} if x >= 25.85589130550742
    uh, ul = erf_a_mul(x, x)
    eh, el = erf_exp_1(uh * -1.0, ul * -1.0)
    yh = 1.0 / x
    yl = yh * fma(x * -1.0, yh, 1.0)
    i = 0
    while yh > ERF_ERFC_ASYMPT_THRESHOLD[i]
      i += 1
    end
    p = ERF_ERFC_T.to_unsafe + i &* 13
    uh, ul = erf_a_mul(yh, yh)
    ul = fma(2.0 * yh, yl, ul)
    zh = IyiFloatText.from_bits(p[12])
    zh = fma(zh, uh, IyiFloatText.from_bits(p[11]))
    zh = fma(zh, uh, IyiFloatText.from_bits(p[10]))
    h, l = erf_s_mul(zh, uh, ul)
    zh, zl = erf_fast_two_sum(IyiFloatText.from_bits(p[9]), h)
    zl = zl + l
    j = 15
    while j >= 3
      h, l = erf_d_mul(zh, zl, uh, ul)
      zh, zl = erf_fast_two_sum(IyiFloatText.from_bits(p[(j + 1) // 2]), h)
      zl = zl + l
      j -= 2
    end
    h, l = erf_d_mul(zh, zl, uh, ul)
    zh, zl = erf_fast_two_sum(IyiFloatText.from_bits(p[0]), h)
    zl = zl + (l + IyiFloatText.from_bits(p[1]))
    uh, ul = erf_d_mul(zh, zl, yh, yl)
    h, l = erf_d_mul(uh, ul, eh, el)
    return {h, l, 6.2601028758013134e-21 * h} if h >= 3.5543726719065856e-288
    {h, l, 2.2250738585072014e-308}
  end

  private ERF_ERFC_ASYMPT_THRESHOLD = [0.114501953125, 0.16887364264604549, 0.216796875, 0.26171875, 0.3046875, 0.3466796875]

  private ERF_ERFC_ACCURATE_THRESHOLD = [0.079345703125, 0.1171875, 0.15576171875, 0.19775390625, 0.24462890625,
                                         0.2978515625, 0.3603515625, 0.43359375, 0.521484375, 0.59375]

  # erfc(x) ~ h + l for -0x1.7744f8f74e94bp+2 < x < 0x1.b39dc41e48bfdp+4,
  # with the absolute error bound as third value (s_erfc.c cr_erfc_fast).
  private def self.erf_erfc_fast(x : Float64) : {Float64, Float64, Float64}
    if x < 0.0
      h, l, err = erf_fast(x * -1.0)
      err = err * h
      h, t = erf_fast_two_sum(1.0, h)
      return {h, t + l, err + 2.465190328815662e-31}
    elsif x <= 2.8845070422535213
      h, l, err = erf_fast(x)
      err = err * h
      h, t = erf_fast_two_sum(1.0, h * -1.0)
      l = t - l
      return {h, l, err} if x >= 0.4769362762044699
      return {h, l, err + 6.162975822039155e-32}
    end
    erf_erfc_asympt_fast(x)
  end

  # erfc(x) for 0x1.b59ffb450828cp+0 < x < 0x1.b39dc41e48bfdp+4, correctly
  # rounded, subnormal results included (s_erfc.c erfc_asympt_accurate).
  private def self.erf_erfc_asympt_accurate(x : Float64) : Float64
    ex = ERF_ERFC_EXCEPTIONS.to_unsafe
    k = 0
    while k < ERF_ERFC_EXCEPTIONS.size // 3
      if x == IyiFloatText.from_bits(ex[3 * k])
        return IyiFloatText.from_bits(ex[3 * k + 1]) + IyiFloatText.from_bits(ex[3 * k + 2])
      end
      k += 1
    end
    if x == 26.560485590559058
      return fma(IyiFloatText.from_bits(1_u64), -0.25, 8.907573520005566e-309)
    end
    uh, ul = erf_a_mul(x, x)
    eh, el, e = erf_exp_accurate(uh * -1.0, ul * -1.0)
    yh = 1.0 / x
    yl = yh * fma(x * -1.0, yh, 1.0)
    i = 0
    while yh > ERF_ERFC_ACCURATE_THRESHOLD[i]
      i += 1
    end
    p = ERF_ERFC_TACC.to_unsafe + i &* 30
    uh, ul = erf_a_mul(yh, yh)
    ul = fma(2.0 * yh, yl, ul)
    zh = IyiFloatText.from_bits(p[14 + 6 + i])
    zl = 0.0
    j = 27 + 2 * i
    while j >= 13
      h, l = erf_a_mul(zh, uh)
      l = fma(zh, ul, l)
      l = fma(zl, uh, l)
      zh, zl = erf_two_sum(IyiFloatText.from_bits(p[(j - 1) // 2 + 6]), h)
      zl = zl + l
      j -= 2
    end
    j = 11
    while j >= 1
      h, l = erf_a_mul(zh, uh)
      l = fma(zh, ul, l)
      l = fma(zl, uh, l)
      zh, zl = erf_two_sum(IyiFloatText.from_bits(p[j - 1]), h)
      zl = zl + (l + IyiFloatText.from_bits(p[j]))
      j -= 2
    end
    uh, ul = erf_a_mul(zh, yh)
    ul = fma(zh, yl, ul)
    ul = fma(zl, yh, ul)
    uh, ul = erf_fast_two_sum(uh, ul)
    h, l = erf_a_mul(uh, eh)
    l = fma(uh, el, l)
    l = fma(ul, eh, l)
    res = ldexp(h + l, e)
    if res < 2.2250738585072014e-308
      corr = h - ldexp(res, 0 &- e)
      corr = corr + l
      res = res + ldexp(corr, e)
    end
    res
  end

  # erfc(x), correctly rounded, when the fast path cannot decide
  # (s_erfc.c cr_erfc_accurate).
  private def self.erf_erfc_accurate(x : Float64) : Float64
    if x < 0.0
      ex = ERF_ERFC_EXCEPTIONS_ACC.to_unsafe
      k = 0
      while k < ERF_ERFC_EXCEPTIONS_ACC.size // 3
        if x == IyiFloatText.from_bits(ex[3 * k])
          return IyiFloatText.from_bits(ex[3 * k + 1]) + IyiFloatText.from_bits(ex[3 * k + 2])
        end
        k += 1
      end
      h, l = erf_accurate(x * -1.0, false)
      h, t = erf_fast_two_sum(1.0, h)
      return h + (t + l)
    elsif x <= 1.7094723742995113
      ex = ERF_ERFC_EXCEPTIONS_ACC2.to_unsafe
      k = 0
      while k < ERF_ERFC_EXCEPTIONS_ACC2.size // 3
        if x == IyiFloatText.from_bits(ex[3 * k])
          return IyiFloatText.from_bits(ex[3 * k + 1]) + IyiFloatText.from_bits(ex[3 * k + 2])
        end
        k += 1
      end
      h, l = erf_accurate(x, false)
      h, t = erf_fast_two_sum(1.0, h * -1.0)
      return h + (t - l)
    end
    erf_erfc_asympt_accurate(x)
  end

  # The error function, correctly rounded: glibc 2.43's CORE-MATH erf
  # (s_erf.c). NaN answers NaN, ±inf answer ±1, and ±0 keep their sign.
  def self.erf(value : Float64) : Float64
    z = value.abs
    ux = IyiFloatText.bits_of(z)
    if ux > 0x4017afb48dc96626_u64
      os = copysign(1.0, value)
      return value + value if ux > 0x7ff0000000000000_u64
      return os if ux == 0x7ff0000000000000_u64
      return os - 5.551115123125783e-17 * os
    end
    if z < 4.336808689942018e-19
      return value if value == 0.0
      y = ERF_CH * value
      sx = value * 8.112963841460668e+31
      h, l = erf_a_mul(ERF_CH, sx)
      l = fma(ERF_CL, sx, l)
      l = l + (h - y * 8.112963841460668e+31)
      return fma(l, 1.232595164407831e-32, y)
    end
    h, l, err = erf_fast(z)
    sign = IyiFloatText.bits_of(value) & 0x8000000000000000_u64
    uf = IyiFloatText.from_bits(IyiFloatText.bits_of(h) ^ sign)
    vf = IyiFloatText.from_bits(IyiFloatText.bits_of(l) ^ sign)
    left = uf + fma(err, uf * -1.0, vf)
    right = uf + fma(err, uf, vf)
    return left if left == right
    h, l = erf_accurate(z, true)
    value >= 0.0 ? h + l : h * -1.0 + l * -1.0
  end

  # 1 - erf(value), correctly rounded: glibc 2.43's CORE-MATH erfc
  # (s_erfc.c). NaN answers NaN, -inf 2 and +inf 0; the answer underflows
  # to 0 from 0x1.b39dc41e48bfdp+4 (about 27.23) up.
  def self.erfc(value : Float64) : Float64
    t = IyiFloatText.bits_of(value)
    at = t & 0x7fffffffffffffff_u64
    if t >= 0x8000000000000000_u64
      if t >= 0xc017744f8f74e94b_u64
        if t >= 0xfff0000000000000_u64
          return 2.0 if t == 0xfff0000000000000_u64
          return value + value
        end
        return 2.0 - 5.551115123125783e-17
      end
      return fma(value * -1.0, 5.551115123125783e-17, 1.0) if -9.83909537680414e-17 <= value
    else
      if at >= 0x403b39dc41e48bfd_u64
        if at >= 0x7ff0000000000000_u64
          return 0.0 if at == 0x7ff0000000000000_u64
          return value + value
        end
        return 0.0
      end
      return fma(value * -1.0, 5.551115123125783e-17, 1.0) if value <= 4.91954768840207e-17
    end
    h, l, err = erf_erfc_fast(value)
    left = h + (l - err)
    right = h + (l + err)
    return left if left == right
    erf_erfc_accurate(value)
  end

  def self.gamma(value : Float64) : Float64
    tgamma(value)
  end

  private HALF_LOG_TAU = 0.91893853320467274178

  # log|gamma(value)|: Stirling's series from 15 up, the logarithm of
  # gamma below it, and the reflection formula for negative arguments; the
  # poles at the non-positive whole numbers answer +infinity.
  def self.lgamma(value : Float64) : Float64
    return value if value != value
    return 1.0 / 0.0 if value == 2.0 * value
    return 1.0 / 0.0 if value <= 0.0 && value == value.floor
    if value < 0.0
      s = sin(PI * value).abs
      return log(PI / s) - lgamma(1.0 - value)
    end
    return log(tgamma(value).abs) if value < 15.0
    v = value
    iv = 1.0 / v
    iv2 = iv * iv
    series = iv * (1.0 / 12.0 - iv2 * (1.0 / 360.0 - iv2 * (1.0 / 1260.0 - iv2 * (1.0 / 1680.0 - iv2 * (1.0 / 1188.0 - iv2 * (691.0 / 360360.0))))))
    (v - 0.5) * log(v) - v + HALF_LOG_TAU + series
  end

  # gamma: a whole argument up to 171 is its factorial, taken exactly as
  # far as the double allows; the poles answer NaN, past 171.62 the answer
  # is infinite, and the rest is Lanczos's approximation with Godfrey's
  # g = 607/128 and fifteen terms (good to a few 1e-16), reflected for
  # arguments below a half.
  def self.tgamma(value : Float64) : Float64
    return value if value != value
    return value if value == 2.0 * value && value > 0.0
    return 0.0 / 0.0 if value == 2.0 * value
    return 0.0 / 0.0 if value <= 0.0 && value == value.floor
    return 1.0 / 0.0 if value > 171.7
    if value == value.floor
      res = 1.0
      k = 2.0
      while k < value
        res = res * k
        k = k + 1.0
      end
      return res
    end
    if value < 0.5
      PI / (sin(PI * value) * tgamma(1.0 - value))
    else
      v = value
      ser = 0.99999999999999709182
      ser = ser + 57.156235665862923517 / (v + 1.0)
      ser = ser - 59.597960355475491248 / (v + 2.0)
      ser = ser + 14.136097974741747174 / (v + 3.0)
      ser = ser - 0.49191381609762019978 / (v + 4.0)
      ser = ser + 0.33994649984811888699e-4 / (v + 5.0)
      ser = ser + 0.46523628927048575665e-4 / (v + 6.0)
      ser = ser - 0.98374475304879564677e-4 / (v + 7.0)
      ser = ser + 0.15808870322491248884e-3 / (v + 8.0)
      ser = ser - 0.21026444172410488319e-3 / (v + 9.0)
      ser = ser + 0.21743961811521264320e-3 / (v + 10.0)
      ser = ser - 0.16431810653676389022e-3 / (v + 11.0)
      ser = ser + 0.84418223983852743293e-4 / (v + 12.0)
      ser = ser - 0.26190838401581408670e-4 / (v + 13.0)
      ser = ser + 0.36899182659531622704e-5 / (v + 14.0)
      t = v + 5.2421875
      # t^(v + 0.5) alone overflows before gamma does; the halves do not.
      half = pow(t, 0.5 * (v + 0.5)) * exp(-0.5 * t)
      sqrt(TAU) * ser / v * half * half
    end
  end

  def self.besselj0(value : Float64) : Float64
    # Series expansion for small/medium values
    x = value.abs
    if x < 5.0
      term = 1.0
      sum = 1.0
      k = 1
      while k <= 25
        term = term * (0.0 - x * x / (4.0 * k.to_f64 * k.to_f64))
        sum = sum + term
        break if term.abs < 1.0e-15
        k = k + 1
      end
      sum
    else
      # Asymptotic expansion
      sqrt(2.0 / (PI * x)) * cos(x - PI / 4.0)
    end
  end

  def self.besselj1(value : Float64) : Float64
    x = value.abs
    if x < 5.0
      term = x / 2.0
      sum = term
      k = 1
      while k <= 25
        term = term * (0.0 - x * x / (4.0 * k.to_f64 * (k.to_f64 + 1.0)))
        sum = sum + term
        break if term.abs < 1.0e-15
        k = k + 1
      end
      value < 0.0 ? 0.0 - sum : sum
    else
      res = sqrt(2.0 / (PI * x)) * cos(x - 3.0 * PI / 4.0)
      value < 0.0 ? 0.0 - res : res
    end
  end

  # Euclid on the non-positive side, where every magnitude fits, the
  # type's minimum included: gcd(-2147483648, 6) is 2. Only gcd(minimum,
  # 0), whose answer does not fit, overflows.
  def self.gcd(a : ::Int, b : ::Int) : ::Int
    x = a > 0 ? -a : a
    y = b > 0 ? -b : b
    while y != 0
      t = y
      y = x % y
      x = t
    end
    -x
  end

  def self.lcm(a : ::Int, b : ::Int) : ::Int
    return (a - a) if a == 0 || b == 0
    (a.abs // gcd(a, b)) * b.abs
  end
end
