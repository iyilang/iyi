pub class Recover < ASTNode
  property exp : ASTNode
  property default : ASTNode?

  def initialize(@exp : ASTNode, @default : ASTNode? = nil)
  end

  def panic? : Bool
    @default.nil?
  end

  def clone_without_location : self
    Recover.new(@exp.clone, clone_node(@default))
  end

  def accept_children(visitor) : Nil
    @exp.accept(visitor)
    if d = @default
      d.accept(visitor)
    end
  end

  def ==(other : self) : Bool
    (@exp == other.exp) && (@default == other.default)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@exp)
    h = 31 &* h &+ hash_val(@default)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    sb << "recover "
    @exp.to_s(sb)
    if d = @default
      sb << " "
      d.to_s(sb)
    end
  end
end

