# Password hashing, written in iyi: bcrypt (Provos and Mazières, USENIX
# 1999, as OpenBSD's `bcrypt.c` writes it) on its own Blowfish, and scrypt
# (RFC 7914) on std/crypto's PBKDF2-HMAC-SHA256 and a Salsa20/8 core.
#
#     import std/password::{Bcrypt, Scrypt}
#
#     stored = Bcrypt.hash(password)        # "$2b$11$..."
#     Bcrypt.verify(attempt, stored)        # true or false
#     Scrypt.derive(password, salt, 16384, 8, 1, 32)
#
# A password or a salt is a `String`, whose bytes are taken, or an
# `Array(UInt8)`; what scrypt derives is an `Array(UInt8)`.
#
# Why this is a module of its own and not part of std/crypto: a bcrypt
# hash needs a salt nobody can guess, and that is `Random::Secure`, so
# this imports std/random, and through it the clocks and the environment.
# std/crypto reaches nothing past std/int and std/digest, and a package
# that only MACs its messages should not be counted as reaching the
# operating system's entropy because the module beside HMAC hashes
# passwords (`iyi mod reach`). Scrypt takes its salt from the caller and
# needs no randomness; it is here because it is the other password hash,
# and a program looking for one looks here.
#
# For a password stored to be checked later, `Bcrypt` is the one with the
# format: the string it answers carries the cost and the salt, is the
# modular `$2b$` string OpenBSD, Crystal and Python's `bcrypt` write and
# read, and `verify` needs nothing else. `Scrypt` answers raw bytes, for a
# key or for a format of the caller's own. Both are pure iyi and keep up
# with the native code Python calls: measured on one x86_64 Linux machine,
# --release, bcrypt at cost 10 took 37 ms against Python's `bcrypt` (Rust)
# 39 ms, and scrypt at n = 16384, r = 8, p = 1 took 18 ms against
# `hashlib.scrypt`'s (OpenSSL) 23 ms; a plain build took 94 and 148.
#
# Refused with a sentence: a bcrypt cost outside 4 to 31, and scrypt
# parameters out of the RFC's range or past the caller's memory limit
# (each says which below). A stored bcrypt hash is data, and a malformed
# one answers false from `verify`.

module std/password

import std/int
import std/digest::{SHA256}
import std/crypto::{PBKDF2, Subtle}
import std/random::{Random}

# scrypt, RFC 7914: PBKDF2-HMAC-SHA256 spread into *p* blocks of `128 * r`
# bytes, each block walked through a table of *n* versions of itself
# (ROMix) by BlockMix, a chain of Salsa20/8 cores, and PBKDF2 once more
# over what comes out. The table is what makes it costly to guess at: a
# guess needs `128 * r * n` bytes of memory, or the time to recompute
# what it did not keep. RFC 7914's interactive-login figure is n = 16384,
# r = 8, p = 1, sixteen mebibytes.
#
# *max_memory* is a refusal, not a cap: the parameters ask for
# `128 * r * p + 128 * r * (n + 2)` bytes, which is how OpenSSL counts
# them, and past the limit the call panics rather than allocate. Its
# default, 32 MiB, is OpenSSL's and so Python's, so a call one library
# accepts the other accepts too. Refused with a sentence besides: an *n*
# that is not a power of two above 1, or not below 2^(16r) (RFC 7914 §2;
# OpenSSL refuses it too), an *r*, *p* or length below one, and a
# `128 * r * p` that does not fit an `Int32` (p * r of 2^24 and up).
pub struct Scrypt
  def self.derive(password : String | Array(UInt8), salt : String | Array(UInt8), n : Int32, r : Int32, p : Int32, length : Int32, max_memory : Int64 = 33_554_432_i64) : Array(UInt8)
    raise "Scrypt: n must be a power of two above 1, not #{n}" if n < 2 || (n & (n - 1)) != 0
    raise "Scrypt: r must be at least 1, not #{r}" if r < 1
    raise "Scrypt: p must be at least 1, not #{p}" if p < 1
    raise "Scrypt: the key length must be at least 1 byte, not #{length}" if length < 1
    if r < 2 && n.to_i64 >= 1_i64.unsafe_shl(16 * r)
      raise "Scrypt: n = #{n} must be below 2^(16 * r) = 2^#{16 * r}"
    end
    block = 128_i64 * r
    if block * p > 2147483647_i64
      raise "Scrypt: p * r = #{p.to_i64 * r} is past the 2^24 one derivation can hold"
    end
    memory = block * p + block * (n.to_i64 + 2_i64)
    if memory > max_memory
      raise "Scrypt: n = #{n}, r = #{r}, p = #{p} need #{memory} bytes, past the limit of #{max_memory}"
    end
    b = PBKDF2.derive(SHA256, password, salt, 1, (block * p).to_i32)
    words = 32 * r
    x = Pointer(UInt32).malloc(words.to_u64)
    y = Pointer(UInt32).malloc(words.to_u64)
    v = Pointer(UInt32).malloc(words.to_u64 * n.to_u64)
    t = Pointer(UInt32).malloc(16_u64)
    bytes = b.to_unsafe
    i = 0
    while i < p
      # The words little-endian, as the RFC reads them, whatever the
      # processor's order.
      at = bytes + (i.to_i64 * block)
      k = 0
      while k < words
        x[k] = at[k * 4].to_u32 | at[k * 4 + 1].to_u32.unsafe_shl(8) | at[k * 4 + 2].to_u32.unsafe_shl(16) | at[k * 4 + 3].to_u32.unsafe_shl(24)
        k = k + 1
      end
      ro_mix(x, y, v, t, r, n)
      k = 0
      while k < words
        w = x[k]
        at[k * 4] = (w & 255_u32).unsafe_to_u8
        at[k * 4 + 1] = (w.unsafe_shr(8) & 255_u32).unsafe_to_u8
        at[k * 4 + 2] = (w.unsafe_shr(16) & 255_u32).unsafe_to_u8
        at[k * 4 + 3] = w.unsafe_shr(24).unsafe_to_u8
        k = k + 1
      end
      i = i + 1
    end
    PBKDF2.derive(SHA256, password, b, 1, length)
  end

  # ROMix, RFC 7914 §5: *x* stored *n* times as BlockMix carries it on,
  # then *n* more steps each mixing in the version the block's own last
  # word picks. The two buffers trade places each step rather than being
  # copied, and 2n steps is an even number, so the result ends in *x*.
  private def self.ro_mix(x : Pointer(UInt32), y : Pointer(UInt32), v : Pointer(UInt32), t : Pointer(UInt32), r : Int32, n : Int32) : Nil
    words = 32 * r
    a = x
    b = y
    i = 0
    while i < n
      (v + i.to_i64 * words).copy_from(a, words)
      block_mix(a, b, t, r)
      swap = a
      a = b
      b = swap
      i = i + 1
    end
    # Integerify is the last 64-byte block's first word, little-endian;
    # its low 32 bits are all a power of two below 2^31 can use.
    last = (2 * r - 1) * 16
    mask = n - 1
    i = 0
    while i < n
      j = a[last].unsafe_to_i32 & mask
      from = v + j.to_i64 * words
      k = 0
      while k < words
        a[k] = a[k] ^ from[k]
        k = k + 1
      end
      block_mix(a, b, t, r)
      swap = a
      a = b
      b = swap
      i = i + 1
    end
  end

  # BlockMix, RFC 7914 §4: each 64-byte block XORed into the running one
  # and put through Salsa20/8; the even-numbered results go to the first
  # half of *dst* and the odd-numbered to the second.
  private def self.block_mix(src : Pointer(UInt32), dst : Pointer(UInt32), t : Pointer(UInt32), r : Int32) : Nil
    t.copy_from(src + ((2 * r - 1) * 16).to_i64, 16)
    i = 0
    while i < 2 * r
      chunk = src + (i * 16).to_i64
      k = 0
      while k < 16
        t[k] = t[k] ^ chunk[k]
        k = k + 1
      end
      salsa20_8(t)
      half = i.unsafe_shr(1)
      to = (i & 1) == 0 ? half : r + half
      (dst + (to * 16).to_i64).copy_from(t, 16)
      i = i + 1
    end
  end

  # The Salsa20 core cut to eight rounds, four double rounds, in place:
  # the sixteen words in locals, where the compiler can keep them in
  # registers, and added back to the input at the end.
  private def self.salsa20_8(b : Pointer(UInt32)) : Nil
    x0 = b[0]
    x1 = b[1]
    x2 = b[2]
    x3 = b[3]
    x4 = b[4]
    x5 = b[5]
    x6 = b[6]
    x7 = b[7]
    x8 = b[8]
    x9 = b[9]
    x10 = b[10]
    x11 = b[11]
    x12 = b[12]
    x13 = b[13]
    x14 = b[14]
    x15 = b[15]
    double_round = 0
    while double_round < 4
      # Columns.
      x4 = x4 ^ rotl(x0 &+ x12, 7)
      x8 = x8 ^ rotl(x4 &+ x0, 9)
      x12 = x12 ^ rotl(x8 &+ x4, 13)
      x0 = x0 ^ rotl(x12 &+ x8, 18)
      x9 = x9 ^ rotl(x5 &+ x1, 7)
      x13 = x13 ^ rotl(x9 &+ x5, 9)
      x1 = x1 ^ rotl(x13 &+ x9, 13)
      x5 = x5 ^ rotl(x1 &+ x13, 18)
      x14 = x14 ^ rotl(x10 &+ x6, 7)
      x2 = x2 ^ rotl(x14 &+ x10, 9)
      x6 = x6 ^ rotl(x2 &+ x14, 13)
      x10 = x10 ^ rotl(x6 &+ x2, 18)
      x3 = x3 ^ rotl(x15 &+ x11, 7)
      x7 = x7 ^ rotl(x3 &+ x15, 9)
      x11 = x11 ^ rotl(x7 &+ x3, 13)
      x15 = x15 ^ rotl(x11 &+ x7, 18)
      # Rows.
      x1 = x1 ^ rotl(x0 &+ x3, 7)
      x2 = x2 ^ rotl(x1 &+ x0, 9)
      x3 = x3 ^ rotl(x2 &+ x1, 13)
      x0 = x0 ^ rotl(x3 &+ x2, 18)
      x6 = x6 ^ rotl(x5 &+ x4, 7)
      x7 = x7 ^ rotl(x6 &+ x5, 9)
      x4 = x4 ^ rotl(x7 &+ x6, 13)
      x5 = x5 ^ rotl(x4 &+ x7, 18)
      x11 = x11 ^ rotl(x10 &+ x9, 7)
      x8 = x8 ^ rotl(x11 &+ x10, 9)
      x9 = x9 ^ rotl(x8 &+ x11, 13)
      x10 = x10 ^ rotl(x9 &+ x8, 18)
      x12 = x12 ^ rotl(x15 &+ x14, 7)
      x13 = x13 ^ rotl(x12 &+ x15, 9)
      x14 = x14 ^ rotl(x13 &+ x12, 13)
      x15 = x15 ^ rotl(x14 &+ x13, 18)
      double_round = double_round + 1
    end
    b[0] = b[0] &+ x0
    b[1] = b[1] &+ x1
    b[2] = b[2] &+ x2
    b[3] = b[3] &+ x3
    b[4] = b[4] &+ x4
    b[5] = b[5] &+ x5
    b[6] = b[6] &+ x6
    b[7] = b[7] &+ x7
    b[8] = b[8] &+ x8
    b[9] = b[9] &+ x9
    b[10] = b[10] &+ x10
    b[11] = b[11] &+ x11
    b[12] = b[12] &+ x12
    b[13] = b[13] &+ x13
    b[14] = b[14] &+ x14
    b[15] = b[15] &+ x15
  end

  private def self.rotl(x : UInt32, n : Int32) : UInt32
    x.unsafe_shl(n) | x.unsafe_shr(32 - n)
  end
end

# bcrypt, Provos and Mazières (USENIX 1999), as OpenBSD's `bcrypt.c`
# writes it and Crystal's `Crypto::Bcrypt::Password` reads it: a password
# hashed into a 60-character string that carries its own cost and salt,
#
#     $2b$11$ 22 characters of salt 31 characters of hash
#
# both in bcrypt's own base64 (`./A-Za-z0-9`, no padding). `hash` draws 16
# bytes of salt from `Random::Secure` and writes `$2b$`; `verify` reads
# `$2a$`, `$2b$` and `$2y$`, hashes the password again under the salt and
# cost it finds, and compares the two strings with
# `Subtle.constant_time_compare`, so how long a wrong guess takes does not
# say how much of it was right.
#
# The password is OpenBSD's key: its bytes up to the first NUL, cut to 72
# bytes, then a NUL, and only the first 72 bytes of that matter. So a
# password's 73rd byte onwards changes nothing, and neither does anything
# after a NUL: "a\0b" hashes as "a" does, which is what OpenBSD's C, with
# its `strlen`, does with it. OpenBSD's `$2a$` once counted the length in a
# byte and wrapped at 255 (the reason for `$2b$`); this reads `$2a$` as
# `$2b$`, so a `$2a$` hash that old code made of a password of 255 bytes or
# more does not verify here.
#
# *cost* is the log2 of the number of key-schedule passes: each one more
# doubles the time. 11 is Crystal's default and this one's; outside 4 to
# 31 `hash` panics with a sentence. A stored hash is data, and a malformed
# one, or one whose cost is outside 4 to 31, does not verify: `verify`
# answers false for it rather than ending the task.
pub struct Bcrypt
  def self.hash(password : String | Array(UInt8), cost : Int32 = 11) : String
    raise "Bcrypt: the cost must be from 4 to 31, not #{cost}" if cost < 4 || cost > 31
    Blowfish.bcrypt(password, Random::Secure.random_bytes(16), cost, 98_u8)
  end

  def self.verify(password : String | Array(UInt8), hash : String) : Bool
    return false if hash.bytesize != 60
    h = hash.to_unsafe
    return false unless h[0] == 36_u8 && h[1] == 50_u8 && h[3] == 36_u8 && h[6] == 36_u8
    minor = h[2]
    return false unless minor == 97_u8 || minor == 98_u8 || minor == 121_u8
    tens = h[4].to_i32 - 48
    ones = h[5].to_i32 - 48
    return false if tens < 0 || tens > 9 || ones < 0 || ones > 9
    cost = tens * 10 + ones
    return false if cost < 4 || cost > 31
    salt = Array(UInt8).new(16, 0_u8)
    return false unless Blowfish.decode64(h + 7_i64, salt)
    Subtle.constant_time_compare(Blowfish.bcrypt(password, salt, cost, minor), hash)
  end
end

# Blowfish's state as bcrypt keys it (EksBlowfish): the 18 P words and the
# four 256-word S-boxes in one table of 1042, P first, so a key schedule
# is one pass that enciphers and stores two words at a time from the
# start of the table to its end.
struct Blowfish
  @@initial = Pointer(UInt32).new(0_u64)

  # The 60-character string: the work of `Bcrypt.hash` and `verify`, under
  # a salt of 16 bytes and the minor letter to write after `$2`.
  def self.bcrypt(password : String | Array(UInt8), salt : Array(UInt8), cost : Int32, minor : UInt8) : String
    bytes, count = PasswordBytes.of(password)
    length = 0
    while length < count && length < 72 && bytes[length] != 0_u8
      length = length + 1
    end
    # Every pass reads 72 bytes of the key from its start, cycling through
    # the password and its NUL, so the 18 words it XORs into P are the same
    # each time and are worked out once. The salt's 16 bytes cycle the
    # same way, four words.
    cycle = length < 72 ? length + 1 : 72
    key = Pointer(UInt32).malloc(18_u64)
    i = 0
    while i < 18
      word = 0_u32
      k = 0
      while k < 4
        at = (i * 4 + k) % cycle
        byte = at < length ? bytes[at] : 0_u8
        word = word.unsafe_shl(8) | byte.to_u32
        k = k + 1
      end
      key[i] = word
      i = i + 1
    end
    salted = Pointer(UInt32).malloc(4_u64)
    i = 0
    while i < 4
      salted[i] = salt[i * 4].to_u32.unsafe_shl(24) | salt[i * 4 + 1].to_u32.unsafe_shl(16) | salt[i * 4 + 2].to_u32.unsafe_shl(8) | salt[i * 4 + 3].to_u32
      i = i + 1
    end
    st = Pointer(UInt32).malloc(1042_u64)
    st.copy_from(initial, 1042)
    # The expensive key schedule: once with the salt mixed into what is
    # enciphered, then 2^cost rounds of the key and the salt alone.
    mix(st, key, 18)
    schedule(st, salted, true)
    rounds = 1_i64.unsafe_shl(cost)
    pass = 0_i64
    while pass < rounds
      mix(st, key, 18)
      schedule(st, salted, false)
      mix(st, salted, 4)
      schedule(st, salted, false)
      pass = pass + 1_i64
    end
    # "OrpheanBeholderScryDoubt", six big-endian words, enciphered 64
    # times as three blocks; the last of its 24 bytes is not written.
    text = [0x4f727068_u32, 0x65616e42_u32, 0x65686f6c_u32, 0x64657253_u32, 0x63727944_u32, 0x6f756274_u32]
    j = 0
    while j < 64
      b = 0
      while b < 6
        l, r = encipher(st, text[b], text[b + 1])
        text[b] = l
        text[b + 1] = r
        b = b + 2
      end
      j = j + 1
    end
    sum = Array(UInt8).new(24, 0_u8)
    i = 0
    while i < 6
      sum[i * 4] = text[i].unsafe_shr(24).unsafe_to_u8
      sum[i * 4 + 1] = (text[i].unsafe_shr(16) & 255_u32).unsafe_to_u8
      sum[i * 4 + 2] = (text[i].unsafe_shr(8) & 255_u32).unsafe_to_u8
      sum[i * 4 + 3] = (text[i] & 255_u32).unsafe_to_u8
      i = i + 1
    end
    String.new(60) do |dst|
      dst[0] = 36_u8
      dst[1] = 50_u8
      dst[2] = minor
      dst[3] = 36_u8
      dst[4] = (48 + cost // 10).to_u8
      dst[5] = (48 + cost % 10).to_u8
      dst[6] = 36_u8
      encode64(salt.to_unsafe, 16, dst + 7_i64)
      encode64(sum.to_unsafe, 23, dst + 29_i64)
    end
  end

  # P XORed with *count* words cycled to its 18.
  private def self.mix(st : Pointer(UInt32), words : Pointer(UInt32), count : Int32) : Nil
    i = 0
    while i < 18
      st[i] = st[i] ^ words[i % count]
      i = i + 1
    end
  end

  # The whole table rewritten with what enciphering zeros gives, each
  # pair from the pair before; with *salted*, the salt's words XORed in
  # before each encipherment, as bcrypt's first schedule does.
  private def self.schedule(st : Pointer(UInt32), salt : Pointer(UInt32), salted : Bool) : Nil
    l = 0_u32
    r = 0_u32
    k = 0
    i = 0
    while i < 1042
      if salted
        l = l ^ salt[k]
        r = r ^ salt[k + 1]
        k = k ^ 2
      end
      l, r = encipher(st, l, r)
      st[i] = l
      st[i + 1] = r
      i = i + 2
    end
  end

  # Sixteen Feistel rounds of Blowfish under the table as it stands.
  private def self.encipher(st : Pointer(UInt32), left : UInt32, right : UInt32) : {UInt32, UInt32}
    s = st + 18_i64
    l = left ^ st[0]
    r = right
    n = 1
    while n < 17
      r = r ^ feistel(s, l) ^ st[n]
      l = l ^ feistel(s, r) ^ st[n + 1]
      n = n + 2
    end
    {r ^ st[17], l}
  end

  private def self.feistel(s : Pointer(UInt32), x : UInt32) : UInt32
    a = s[x.unsafe_shr(24).unsafe_to_i32]
    b = s[256 + (x.unsafe_shr(16) & 255_u32).unsafe_to_i32]
    c = s[512 + (x.unsafe_shr(8) & 255_u32).unsafe_to_i32]
    d = s[768 + (x & 255_u32).unsafe_to_i32]
    ((a &+ b) ^ c) &+ d
  end

  # bcrypt's base64: the usual bit order, its own alphabet, no padding.
  private def self.encode64(src : Pointer(UInt8), count : Int32, dst : Pointer(UInt8)) : Nil
    alphabet = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".to_unsafe
    i = 0
    o = 0
    while i < count
      c1 = src[i].to_i32
      i = i + 1
      dst[o] = alphabet[c1 >> 2]
      o = o + 1
      c1 = (c1 & 3) << 4
      if i >= count
        dst[o] = alphabet[c1]
        return
      end
      c2 = src[i].to_i32
      i = i + 1
      dst[o] = alphabet[c1 | (c2 >> 4)]
      o = o + 1
      c1 = (c2 & 15) << 2
      if i >= count
        dst[o] = alphabet[c1]
        return
      end
      c2 = src[i].to_i32
      i = i + 1
      dst[o] = alphabet[c1 | (c2 >> 6)]
      dst[o + 1] = alphabet[c2 & 63]
      o = o + 2
    end
  end

  # As many bytes as *dst* holds, read from bcrypt's base64 at *src*, as
  # OpenBSD reads it: the bits past the last whole byte are dropped, and a
  # character outside the alphabet answers false.
  def self.decode64(src : Pointer(UInt8), dst : Array(UInt8)) : Bool
    i = 0
    o = 0
    while o < dst.size
      c1 = value64(src[i])
      c2 = value64(src[i + 1])
      return false if c1 < 0 || c2 < 0
      dst[o] = ((c1 << 2) | ((c2 & 0x30) >> 4)).to_u8
      o = o + 1
      break if o >= dst.size
      c3 = value64(src[i + 2])
      return false if c3 < 0
      dst[o] = (((c2 & 15) << 4) | ((c3 & 0x3c) >> 2)).to_u8
      o = o + 1
      break if o >= dst.size
      c4 = value64(src[i + 3])
      return false if c4 < 0
      dst[o] = (((c3 & 3) << 6) | c4).to_u8
      o = o + 1
      i = i + 4
    end
    true
  end

  private def self.value64(c : UInt8) : Int32
    v = c.to_i32
    return v - 46 if v == 46 || v == 47
    return v - 65 + 2 if v >= 65 && v <= 90
    return v - 97 + 28 if v >= 97 && v <= 122
    return v - 48 + 54 if v >= 48 && v <= 57
    -1
  end

  # The initial P and S words, made once: the hexadecimal digits of pi's
  # fractional part, eight to a word, P's 18 then the four S-boxes.
  private def self.initial : Pointer(UInt32)
    return @@initial if @@initial.address != 0_u64
    words = [
      0x243f6a88_u32, 0x85a308d3_u32, 0x13198a2e_u32, 0x03707344_u32, 0xa4093822_u32, 0x299f31d0_u32, 0x082efa98_u32, 0xec4e6c89_u32,
      0x452821e6_u32, 0x38d01377_u32, 0xbe5466cf_u32, 0x34e90c6c_u32, 0xc0ac29b7_u32, 0xc97c50dd_u32, 0x3f84d5b5_u32, 0xb5470917_u32,
      0x9216d5d9_u32, 0x8979fb1b_u32, 0xd1310ba6_u32, 0x98dfb5ac_u32, 0x2ffd72db_u32, 0xd01adfb7_u32, 0xb8e1afed_u32, 0x6a267e96_u32,
