pub class MultiAssign < ASTNode
  property targets : Array(ASTNode)
  property values : Array(ASTNode)

  def initialize(@targets : Array(ASTNode) = [] of ASTNode, @values : Array(ASTNode) = [] of ASTNode)
  end

  def clone_without_location : self
    MultiAssign.new(clone_nodes(@targets), clone_nodes(@values))
  end

  def accept_children(visitor) : Nil
    @targets.each { |t| t.accept(visitor) }
    @values.each { |v| v.accept(visitor) }
  end

  def ==(other : self) : Bool
    (@targets == other.targets) && (@values == other.values)
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(self)
      self == other
    else
      false
    end
  end

  def hash : Int32
    h = 17
    h = 31 &* h &+ hash_val(@targets)
    h = 31 &* h &+ hash_val(@values)
    h
  end

  def to_s(sb : StringBuilder) : Nil
    i = 0
    while i < @targets.size
      sb << ", " if i > 0
      @targets[i].to_s(sb)
      i = i + 1
    end
    sb << " = "
    j = 0
    while j < @values.size
      sb << ", " if j > 0
      @values[j].to_s(sb)
      j = j + 1
    end
  end
end

