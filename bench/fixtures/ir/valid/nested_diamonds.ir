; iyi-ir 1
source_filename = "nested_diamonds"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
define internal iyicc i32 @f(i1 %c, i1 %d, i32 %v) {
entry:
  %s = add i32 %v, 1
  br i1 %c, label %outer_a, label %outer_b
outer_a:
  br i1 %d, label %inner_a, label %inner_b
inner_a:
  %x = add i32 %s, 2
  br label %inner_join
inner_b:
  %y = add i32 %s, 3
  br label %inner_join
inner_join:
  %p = phi i32 [ %x, label %inner_a ], [ %y, label %inner_b ]
  %q = add i32 %p, %s
  br label %outer_join
outer_b:
  br label %outer_join
outer_join:
  %r = phi i32 [ %q, label %inner_join ], [ %s, label %outer_b ]
  ret i32 %r
}

