; iyi-ir 1
source_filename = "atomic_clobber_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @atomic_clobber_keep(ptr %p, ptr %q) {
entry:
  %first = load i64, ptr %p, align 8
  %atomic = load i64, ptr %q, align 8 atomic acquire
  %second = load i64, ptr %p, align 8
  %sum = add i64 %first, %second
  %out = add i64 %sum, %atomic
  ret i64 %out
}
