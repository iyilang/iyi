lib LibC
  fun putchar(value : Int32) : Int32
  fun exit(status : Int32) : NoReturn
end

def mark(value : Int32) : Int32
  LibC.putchar(value)
  value
end

def combine(a : Int32 = 97, b : Int32 = 98) : Int32
  a &- b
end

def twice(&)
  yield
  yield
end

total = 0
twice { total = total &+ combine(b: mark(97), a: mark(98)) }
LibC.exit(total)
