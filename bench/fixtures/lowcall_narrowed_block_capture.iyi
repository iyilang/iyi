lib LibC
  fun exit(status : Int32) : NoReturn
end

abstract class BlockShape
end

class BlockKindA < BlockShape
end

class BlockKindB < BlockShape
end

class BlockKindC < BlockShape
end

def run_block(&)
  while true
    yield
    break
  end
end

def check_shape(other : BlockShape) : Bool
  if other.is_a?(BlockKindA)
    return true
  elsif other.is_a?(BlockKindB)
    return true
  end
  run_block do
    return true if other.is_a?(BlockKindC)
  end
  false
end

if check_shape(BlockKindA.new) && check_shape(BlockKindB.new) && check_shape(BlockKindC.new)
  LibC.exit(0)
else
  LibC.exit(1)
end
